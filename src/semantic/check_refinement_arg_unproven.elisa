# Refinement argument that is a plain UNCONSTRAINED variable — stage0 cannot prove the
# refinement and emits "refinement R on argument N of F could not be proven statically".
# This is the disjoint companion to check_refinement_arg_violated (which fires only on a
# CONSTANT argument that provably violates the predicate); this pass fires only on a
# NON-constant bare parameter reference with NO possible refinement fact.
#
# MAXIMALLY CONSERVATIVE (only ever CLOSES rows, never over-warns on a provable case): fire
# only when the argument is a bare identifier naming a parameter of the current function
# whose declared type carries NO refinement, and whose name appears in NO fact context —
# not an `is`-guard, not a `requires`/`ensures` predicate (body or signature), not an
# assignment target, and not a refinement-typed binding. Any of those means a fact MIGHT
# exist (guard-established, contract-assumed, or reassigned), so stage0 could prove it and we
# stay silent. Frame-fact-dropped cases (a guard whose fact a later `changes` invalidates)
# are conservatively MISSED here — they remain mismatched, never wrongly matched.

extend Semantic:
    private:
        def collect_idents_in_expr(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Binary(left, operator, right, line):
                        collect_idents_in_expr(left, out)
                        collect_idents_in_expr(right, out)
                    Expr.Unary(operator, operand, line):
                        collect_idents_in_expr(operand, out)
                    Expr.Paren(inner, line):
                        collect_idents_in_expr(inner, out)
                    Expr.Field(object, field, line):
                        collect_idents_in_expr(object, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            collect_idents_in_expr(argument, out)
                    Expr.Index(object, index, line):
                        collect_idents_in_expr(object, out)
                        collect_idents_in_expr(index, out)
                    Expr.IndexN(object, arguments, line):
                        collect_idents_in_expr(object, out)
                        for argument in arguments |out|:
                            collect_idents_in_expr(argument, out)
                    Expr.Comprehension(variable, iterable, condition, body, comp_line):
                        collect_idents_in_expr(iterable, out)
                        collect_idents_in_expr(condition, out)
                        collect_idents_in_expr(body, out)
                    Expr.Block(block_statements, block_value, block_captures, block_line):
                        # A `forall …: xs[k] >= 0` requires lowers to a binder Block whose value is the
                        # predicate; descend so the quantified source (`xs`) is recorded as a fact.
                        for block_statement in block_statements |out|:
                            match block_statement:
                                Stmt.VarDecl(vd_name, vd_type, vd_value, vd_line):
                                    collect_idents_in_expr(vd_value, out)
                                Stmt.Expr(stmt_expression, stmt_line):
                                    collect_idents_in_expr(stmt_expression, out)
                                _:
                                    pass
                        collect_idents_in_expr(block_value, out)
                    _:
                        pass

        # One-list spelling of expr_mentions_any_name, for the callers that have a single
        # name set. Passing the same list twice would read as a bug.
        def expr_mentions_name_in(expression: Ast::Expr, names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return expr_mentions_any_name(expression, names, names)


        # Does the expression mention any name from EITHER list? The allocation-free twin of
        # `collect_idents_in_expr` followed by a membership scan.
        #
        # That pair was the single largest source of mmap/munmap traffic in the compiler.
        # `param_is_warnable` built a temporary `darray[sview]` of every ident in a parameter's
        # type just to ask whether ONE of them was a known law or alias, and it is called once
        # per parameter from THREE separate checks (check_refinement_arg_laws,
        # check_refinement_arg_symbolic, check_precondition_violated). Every Elisa function
        # frees its auto-region on return, so each of those calls cost an mmap AND an munmap.
        # In a profile of stage1 compiling its own source it was 566 of 8692 samples — 6.5%,
        # ALL of it in the syscall pair.
        #
        # Short-circuits, so it also stops at the first hit instead of walking the whole type.
        # Traversal MUST stay in step with collect_idents_in_expr above; they are the same walk.
        def expr_mentions_any_name(expression: Ast::Expr, first: darray[sview]&, second: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name_in(first, name) or name_in(second, name)
                    Expr.Binary(left, operator, right, line):
                        true return if expr_mentions_any_name(left, first, second)
                        return expr_mentions_any_name(right, first, second)
                    Expr.Unary(operator, operand, line):
                        return expr_mentions_any_name(operand, first, second)
                    Expr.Paren(inner, line):
                        return expr_mentions_any_name(inner, first, second)
                    Expr.Field(object, field, line):
                        return expr_mentions_any_name(object, first, second)
                    Expr.Call(callee, arguments, argument_names, line):
                        return any argument in arguments where expr_mentions_any_name(argument, first, second)
                    Expr.Index(object, index, line):
                        true return if expr_mentions_any_name(object, first, second)
                        return expr_mentions_any_name(index, first, second)
                    Expr.IndexN(object, arguments, line):
                        true return if expr_mentions_any_name(object, first, second)
                        return any argument in arguments where expr_mentions_any_name(argument, first, second)
                    Expr.Comprehension(variable, iterable, condition, body, comp_line):
                        true return if expr_mentions_any_name(iterable, first, second)
                        true return if expr_mentions_any_name(condition, first, second)
                        return expr_mentions_any_name(body, first, second)
                    Expr.Block(block_statements, block_value, block_captures, block_line):
                        for block_statement in block_statements:
                            match block_statement:
                                Stmt.VarDecl(vd_name, vd_type, vd_value, vd_line):
                                    true return if expr_mentions_any_name(vd_value, first, second)
                                Stmt.Expr(stmt_expression, stmt_line):
                                    true return if expr_mentions_any_name(stmt_expression, first, second)
                                _:
                                    pass
                        return expr_mentions_any_name(block_value, first, second)
                    _:
                        return false

        # Whether an expression is a `not …` unary (through parens).
        def ur_expr_is_not(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(unary_operator, operand, unary_line):
                        return unary_operator == TokenKind.Not
                    Expr.Paren(inner, paren_line):
                        return ur_expr_is_not(inner)
                    _:
                        return false

        def ur_unwrap_paren(expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Paren(inner, paren_line): ur_unwrap_paren(inner)
                    _: expression

        # The antecedent `A` inside a `(not A)` (through parens), else Absent.
        def ur_not_operand(expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(unary_operator, operand, unary_line):
                        return operand if unary_operator == TokenKind.Not else (Ast::Expr.Absent)
                    Expr.Paren(inner, paren_line):
                        return ur_not_operand(inner)
                    _:
                        return (Ast::Expr.Absent)

        # REFINEMENT-local fact names: the lenient body facts, minus the consequent of any top-level
        # implication requires `(not A) or B` whose antecedent A is not separately (non-implication)
        # established — such a B is only conditionally true and must NOT suppress a `return B` warning.
        # (Kept separate from the shared collect_body_fact_names so check_precondition_violated, which
        # relies on the lenient collection, is unaffected.)
        def ur_refinement_fact_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                collect_body_fact_names(statements, out)
                established_direct: mutable darray[sview] = []
                for statement in statements |established_direct|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            unwrapped: Ast::Expr = ur_unwrap_paren(expression)
                            is_implication: bool = match unwrapped:
                                Expr.Binary(left, operator, right, binary_line): operator == TokenKind.Or and ur_expr_is_not(left)
                                _: false
                            collect_idents_in_expr(expression, established_direct) if not is_implication
                        _:
                            pass
                for statement in statements |out, established_direct|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            unwrapped: Ast::Expr = ur_unwrap_paren(expression)
                            match unwrapped:
                                Expr.Binary(left, operator, right, binary_line):
                                    if operator == TokenKind.Or and ur_expr_is_not(left):
                                        antecedent_established: bool = expr_mentions_name_in(ur_not_operand(left), established_direct)
                                        if not antecedent_established:
                                            consequent_idents: mutable darray[sview] = []
                                            collect_idents_in_expr(right, consequent_idents)
                                            for consequent_ident in consequent_idents |out, established_direct|:
                                                if not name_in(established_direct, consequent_ident):
                                                    strip_probe: mutable usize = 0
                                                    while strip_probe < out.count |strip_probe, consequent_ident, out|:
                                                        out[strip_probe] <- sview("", 0, 0) if out[strip_probe] == consequent_ident
                                                        strip_probe <- strip_probe + 1
                                _:
                                    pass
                        _:
                            pass

        # Names that MIGHT carry a refinement fact in this function body: `is`-guard subjects,
        # every identifier in a body contract, and assignment targets (a reassigned value is
        # unknown, so never warn on it).
        def collect_body_fact_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            collect_idents_in_expr(expression, out)
                        Stmt.Assign(target, operator, value, line):
                            out.push(ident_name_of(target))
                        Stmt.Expr(expression, line):
                            collect_fact_names_in_expr(expression, out)
                        Stmt.Return(value, line):
                            if value is returned:
                                collect_fact_names_in_expr(returned, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            collect_fact_names_in_expr(value, out)
                        Stmt.If(condition, then_body, else_body, line):
                            # ANY identifier in a guard condition (`if x >= 3 and x <= 7`,
                            # `if x is R`) may establish a fact for that name — never warn on it.
                            collect_idents_in_expr(condition, out)
                            collect_body_fact_names(then_body, out)
                            collect_body_fact_names(else_body, out)
                        Stmt.While(condition, while_body, line):
                            collect_idents_in_expr(condition, out)
                            collect_body_fact_names(while_body, out)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            collect_body_fact_names(block_body, out)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            collect_body_fact_names(for_body, out)
                        Stmt.Match(scrutinee, arms, line):
                            out.push(ident_name_of(scrutinee))
                            for arm in arms |out|:
                                collect_body_fact_names(arm.body, out)
                        _:
                            pass

        # `X is R` guard subjects anywhere in an expression carry a fact for X.
        def collect_fact_names_in_expr(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        out.push(ident_name_of(left)) if operator == TokenKind.Is
                        collect_fact_names_in_expr(left, out)
                        collect_fact_names_in_expr(right, out)
                    Expr.Unary(operator, operand, line):
                        # `&NAME` passed to a call — a mutable-ref out-param can re-establish a
                        # range/refinement fact for NAME (docs: refinement-range-via-mut-ref).
                        out.push(ident_name_of(operand)) if operator == TokenKind.Ampersand
                        collect_fact_names_in_expr(operand, out)
                    Expr.Paren(inner, line):
                        collect_fact_names_in_expr(inner, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            collect_fact_names_in_expr(argument, out)
                    _:
                        pass

        def name_in(names: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any candidate in names where candidate == name and name != ""

        # Whether a type expression names a refinement law/alias (`T is R`, `T is R[..]`).
        # The same question expr_mentions_any_name answers, and it used to be the same
        # collect-then-scan written a second time — one temporary darray per call, 415 of 8692
        # profile samples, all of it mmap/munmap.
        def type_mentions_refinement(type_expression: Ast::Expr, law_names: darray[sview]&, alias_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return expr_mentions_any_name(type_expression, law_names, alias_names)

        # Whether a parameter is safe to WARN about when passed unconstrained: it must carry
        # no refinement AND not be an unsigned integer (unsigned entails lower bounds like
        # `>= 0`, which stage0 proves from the type) AND not mention any law name (a
        # parametric refinement like `is InRange[1, 100]` still entails other refinements).
        def param_is_warnable(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                predicate: Ast::Expr = param_refinement_predicate(type_expression, law_names, law_predicates, alias_names, alias_predicates)
                has_predicate: bool = match predicate:
                    Expr.Absent: false
                    _: true
                false return if has_predicate
                # Any known law/alias name mentioned ANYWHERE in the type (including a
                # parametric refinement `is InRange[1, 100]`, which param_refinement_predicate
                # cannot fold) means the parameter is refinement-typed and may subsume the target.
                false return if expr_mentions_any_name(type_expression, law_names, alias_names)
                bare: sview = bare_type_name(type_expression)
                false return if bare in {"u8", "u16", "u32", "u64", "usize", "uintptr", "uint"}
                return true

        # Warn at `f(arg)` for a refinement param position whose argument is an unconstrained
        # refinement-free parameter of the current function.
        def unproven_arg_check_expression(expression: Ast::Expr, line: u32, param_functions: darray[sview]&, param_indices: darray[usize]&, refinement_free_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        probe: mutable usize = 0
                        while probe < param_functions.count |table, probe| -> table:
                            fires: bool = callee_name != "" and param_functions[probe] == callee_name and param_indices[probe] < arguments.count and unproven_arg_at(arguments[param_indices[probe]], refinement_free_params, fact_names)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementArgNotProven, name: callee_name, line: line, expected: "", actual: "", expected_count: (param_indices[probe] + 1).u32()}) if fires
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- unproven_arg_check_expression(argument, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- unproven_arg_check_expression(left, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        table <- unproven_arg_check_expression(right, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- unproven_arg_check_expression(inner, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                    _:
                        pass

        def unproven_arg_at(argument: Ast::Expr, refinement_free_params: darray[sview]&, fact_names: darray[sview]&) -> bool:
            can Abort.Panic:
                arg_name: sview = ident_name_of(argument)
                return arg_name != "" and name_in(refinement_free_params, arg_name) and not name_in(fact_names, arg_name)

        # Whether a parameter type is a SYMBOLIC range refinement `T is RangeLaw[A, B]` where at
        # least one bound is NOT an integer literal (`Bounded[0, xs.count]`). stage0's affine
        # prover cannot discharge symbolic bounds, so it warns for ANY refinement-free argument
        # — a guard `if i is Bounded[0, xs.count]` does not help (the count is not a static
        # fact). A refined argument (subtype) is excluded because it is not refinement-free.
        def is_symbolic_range_refinement(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Binary(base, operator, right, binary_line):
                        false return if operator != TokenKind.Is
                        match right:
                            Expr.IndexN(object, arguments, indexn_line):
                                law_name: sview = ident_name_of(object)
                                false return if law_shape(law_name, law_names, law_predicates) != "range" or arguments.count != 2
                                lo_literal: (found: bool, value: i64) = signed_int_literal(arguments[0])
                                hi_literal: (found: bool, value: i64) = signed_int_literal(arguments[1])
                                return not lo_literal.found or not hi_literal.found
                            _:
                                return false
                    _:
                        return false

        # An argument that is a refinement-free parameter, IGNORING guard/fact context (for the
        # symbolic-bound case where stage0 cannot use the guard).
        def symbolic_arg_at(argument: Ast::Expr, refinement_free_params: darray[sview]&) -> bool:
            can Abort.Panic:
                arg_name: sview = ident_name_of(argument)
                return arg_name != "" and name_in(refinement_free_params, arg_name)
