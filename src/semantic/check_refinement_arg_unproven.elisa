# Refinement argument that is a plain UNCONSTRAINED variable — stage0 cannot prove the
# refinement and emits "refinement R on argument N of F could not be proven statically".
# This is the disjoint companion to check_refinement_arg_violated (which fires only on a
# CONSTANT argument that provably violates the predicate); this pass fires only on a
# NON-constant bare parameter reference with NO possible refinement fact.
#
# MAXIMALLY CONSERVATIVE (only ever CLOSES rows, never over-warns on a provable case): fire
# only when the argument is a bare identifier naming a parameter of the current function
# whose declared type carries NO refinement, and whose name appears in NO fact context —
# not an `is`-guard, not a `requires`/`ensures` predicate (body or signature), not an
# assignment target, and not a refinement-typed binding. Any of those means a fact MIGHT
# exist (guard-established, contract-assumed, or reassigned), so stage0 could prove it and we
# stay silent. Frame-fact-dropped cases (a guard whose fact a later `changes` invalidates)
# are conservatively MISSED here — they remain mismatched, never wrongly matched.
extend Semantic:
    private:
        def collect_idents_in_expr(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Binary(left, operator, right, line):
                        collect_idents_in_expr(left, out)
                        collect_idents_in_expr(right, out)
                    Expr.Unary(operator, operand, line):
                        collect_idents_in_expr(operand, out)
                    Expr.Paren(inner, line):
                        collect_idents_in_expr(inner, out)
                    Expr.Field(object, field, line):
                        collect_idents_in_expr(object, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            collect_idents_in_expr(argument, out)
                    Expr.Index(object, index, line):
                        collect_idents_in_expr(object, out)
                        collect_idents_in_expr(index, out)
                    Expr.IndexN(object, arguments, line):
                        collect_idents_in_expr(object, out)
                        for argument in arguments |out|:
                            collect_idents_in_expr(argument, out)
                    _:
                        pass

        # Names that MIGHT carry a refinement fact in this function body: `is`-guard subjects,
        # every identifier in a body contract, and assignment targets (a reassigned value is
        # unknown, so never warn on it).
        def collect_body_fact_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            collect_idents_in_expr(expression, out)
                        Stmt.Assign(target, operator, value, line):
                            out.push(ident_name_of(target))
                        Stmt.Expr(expression, line):
                            collect_fact_names_in_expr(expression, out)
                        Stmt.Return(value, line):
                            if value is returned:
                                collect_fact_names_in_expr(returned, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            collect_fact_names_in_expr(value, out)
                        Stmt.If(condition, then_body, else_body, line):
                            # ANY identifier in a guard condition (`if x >= 3 and x <= 7`,
                            # `if x is R`) may establish a fact for that name — never warn on it.
                            collect_idents_in_expr(condition, out)
                            collect_body_fact_names(then_body, out)
                            collect_body_fact_names(else_body, out)
                        Stmt.While(condition, while_body, line):
                            collect_idents_in_expr(condition, out)
                            collect_body_fact_names(while_body, out)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            collect_body_fact_names(block_body, out)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            collect_body_fact_names(for_body, out)
                        Stmt.Match(scrutinee, arms, line):
                            out.push(ident_name_of(scrutinee))
                            for arm in arms |out|:
                                collect_body_fact_names(arm.body, out)
                        _:
                            pass

        # `X is R` guard subjects anywhere in an expression carry a fact for X.
        def collect_fact_names_in_expr(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        out.push(ident_name_of(left)) if operator == TokenKind.Is
                        collect_fact_names_in_expr(left, out)
                        collect_fact_names_in_expr(right, out)
                    Expr.Unary(operator, operand, line):
                        # `&NAME` passed to a call — a mutable-ref out-param can re-establish a
                        # range/refinement fact for NAME (docs: refinement-range-via-mut-ref).
                        out.push(ident_name_of(operand)) if operator == TokenKind.Ampersand
                        collect_fact_names_in_expr(operand, out)
                    Expr.Paren(inner, line):
                        collect_fact_names_in_expr(inner, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            collect_fact_names_in_expr(argument, out)
                    _:
                        pass

        def name_in(names: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any candidate in names where candidate == name and name != ""

        # Whether a type expression names a refinement law/alias (`T is R`, `T is R[..]`).
        def type_mentions_refinement(type_expression: Ast::Expr, law_names: darray[sview]&, alias_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                idents: mutable darray[sview] = []
                collect_idents_in_expr(type_expression, idents)
                return any ident in idents where name_in(law_names, ident) or name_in(alias_names, ident)

        # Whether a parameter is safe to WARN about when passed unconstrained: it must carry
        # no refinement AND not be an unsigned integer (unsigned entails lower bounds like
        # `>= 0`, which stage0 proves from the type) AND not mention any law name (a
        # parametric refinement like `is InRange[1, 100]` still entails other refinements).
        def param_is_warnable(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                predicate: Ast::Expr = param_refinement_predicate(type_expression, law_names, law_predicates, alias_names, alias_predicates)
                has_predicate: bool = match predicate:
                    Expr.Absent: false
                    _: true
                false return if has_predicate
                # Any known law/alias name mentioned ANYWHERE in the type (including a
                # parametric refinement `is InRange[1, 100]`, which param_refinement_predicate
                # cannot fold) means the parameter is refinement-typed and may subsume the target.
                type_idents: mutable darray[sview] = []
                collect_idents_in_expr(type_expression, type_idents)
                false return if any ident in type_idents where name_in(law_names, ident) or name_in(alias_names, ident)
                bare: sview = bare_type_name(type_expression)
                false return if bare in {"u8", "u16", "u32", "u64", "usize", "uintptr", "uint"}
                return true

        # Warn at `f(arg)` for a refinement param position whose argument is an unconstrained
        # refinement-free parameter of the current function.
        def unproven_arg_check_expression(expression: Ast::Expr, line: u32, param_functions: darray[sview]&, param_indices: darray[usize]&, refinement_free_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        probe: mutable usize = 0
                        while probe < param_functions.count |table, probe| -> table:
                            fires: bool = callee_name != "" and param_functions[probe] == callee_name and param_indices[probe] < arguments.count and unproven_arg_at(arguments[param_indices[probe]], refinement_free_params, fact_names)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementArgNotProven, name: callee_name, line: line, expected: "", actual: "", expected_count: (param_indices[probe] + 1).u32()}) if fires
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- unproven_arg_check_expression(argument, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- unproven_arg_check_expression(left, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        table <- unproven_arg_check_expression(right, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- unproven_arg_check_expression(inner, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                    _:
                        pass

        def unproven_arg_at(argument: Ast::Expr, refinement_free_params: darray[sview]&, fact_names: darray[sview]&) -> bool:
            can Abort.Panic:
                arg_name: sview = ident_name_of(argument)
                return arg_name != "" and name_in(refinement_free_params, arg_name) and not name_in(fact_names, arg_name)

        # Whether a parameter type is a SYMBOLIC range refinement `T is RangeLaw[A, B]` where at
        # least one bound is NOT an integer literal (`Bounded[0, xs.count]`). stage0's affine
        # prover cannot discharge symbolic bounds, so it warns for ANY refinement-free argument
        # — a guard `if i is Bounded[0, xs.count]` does not help (the count is not a static
        # fact). A refined argument (subtype) is excluded because it is not refinement-free.
        def is_symbolic_range_refinement(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Binary(base, operator, right, binary_line):
                        false return if operator != TokenKind.Is
                        match right:
                            Expr.IndexN(object, arguments, indexn_line):
                                law_name: sview = ident_name_of(object)
                                false return if law_shape(law_name, law_names, law_predicates) != "range" or arguments.count != 2
                                lo_literal: (found: bool, value: i64) = signed_int_literal(arguments[0])
                                hi_literal: (found: bool, value: i64) = signed_int_literal(arguments[1])
                                return not lo_literal.found or not hi_literal.found
                            _:
                                return false
                    _:
                        return false

        # An argument that is a refinement-free parameter, IGNORING guard/fact context (for the
        # symbolic-bound case where stage0 cannot use the guard).
        def symbolic_arg_at(argument: Ast::Expr, refinement_free_params: darray[sview]&) -> bool:
            can Abort.Panic:
                arg_name: sview = ident_name_of(argument)
                return arg_name != "" and name_in(refinement_free_params, arg_name)

        # Walk a refinement-return function's body: a `return <unconstrained param>` cannot
        # be proven within the return refinement's bounds.
        def unproven_return_check(statements: darray[Ast::Stmt], refinement_free_params: darray[sview]&, fact_names: darray[sview]&, function_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementReturnNotProven, name: function_name, line: line, expected: "", actual: ""}) if unproven_arg_at(returned, refinement_free_params, fact_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- unproven_return_check(then_body, refinement_free_params, fact_names, function_name, table)
                            table <- unproven_return_check(else_body, refinement_free_params, fact_names, function_name, table)
                        Stmt.While(condition, while_body, line):
                            table <- unproven_return_check(while_body, refinement_free_params, fact_names, function_name, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- unproven_return_check(block_body, refinement_free_params, fact_names, function_name, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- unproven_return_check(for_body, refinement_free_params, fact_names, function_name, table)
                        _:
                            pass

        def unproven_arg_check_statements(statements: darray[Ast::Stmt], line_context: u32, param_functions: darray[sview]&, param_indices: darray[usize]&, refinement_free_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- unproven_arg_check_expression(returned, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.Expr(expression, line):
                            table <- unproven_arg_check_expression(expression, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- unproven_arg_check_expression(value, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- unproven_arg_check_expression(value, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- unproven_arg_check_statements(then_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                            table <- unproven_arg_check_statements(else_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.While(condition, while_body, line):
                            table <- unproven_arg_check_statements(while_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- unproven_arg_check_statements(block_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- unproven_arg_check_statements(for_body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                        _:
                            pass

        # ---- Guard-interval arg proving (additive) ---------------------------------------
        # When a refinement-free param `x` is passed to a refined position inside an
        # `if x >= A and x <= B:` guard, the main pass stays silent (x is a "fact name"), but
        # stage0 still WARNS when [A,B] is not contained in the required bounds [C,D]. This
        # additive pass computes the intersected enclosing-guard interval, the required
        # self-bounds, and warns only on PROVABLE non-containment. Sound: intersected guards
        # give an interval tighter-or-equal to the true value set, so `⊄` implies stage0 also
        # cannot prove it. Args that are reassigned or named by a signature contract (facts
        # this interval reasoning cannot see) are excluded.
        def apply_bound_comparison(operator: TokenKind, value: i64, lo_ref: mutable i64&, hi_ref: mutable i64&, any_ref: mutable bool&) -> void:
            can Abort.Panic:
                lo_ref <- value if operator == TokenKind.GtEq and value > lo_ref
                lo_ref <- (value + 1) if operator == TokenKind.Gt and (value + 1) > lo_ref
                hi_ref <- value if operator == TokenKind.LtEq and value < hi_ref
                hi_ref <- (value - 1) if operator == TokenKind.Lt and (value - 1) < hi_ref
                any_ref <- true if operator == TokenKind.GtEq or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.Lt

        def flip_comparison(operator: TokenKind) -> TokenKind:
            can Abort.Panic:
                return when operator:
                    TokenKind.GtEq -> TokenKind.LtEq
                    TokenKind.Gt -> TokenKind.Lt
                    TokenKind.LtEq -> TokenKind.GtEq
                    TokenKind.Lt -> TokenKind.Gt
                    _ -> operator

        def accumulate_subject_bounds(expression: Ast::Expr, subject: sview, lo_ref: mutable i64&, hi_ref: mutable i64&, any_ref: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        accumulate_subject_bounds(inner, subject, lo_ref, hi_ref, any_ref)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.And:
                            accumulate_subject_bounds(left, subject, lo_ref, hi_ref, any_ref)
                            accumulate_subject_bounds(right, subject, lo_ref, hi_ref, any_ref)
                        else:
                            left_name: sview = ident_name_of(left)
                            right_name: sview = ident_name_of(right)
                            right_literal: (found: bool, value: i64) = signed_int_literal(right)
                            left_literal: (found: bool, value: i64) = signed_int_literal(left)
                            apply_bound_comparison(operator, right_literal.value, lo_ref, hi_ref, any_ref) if left_name == subject and left_name != "" and right_literal.found
                            apply_bound_comparison(flip_comparison(operator), left_literal.value, lo_ref, hi_ref, any_ref) if right_name == subject and right_name != "" and left_literal.found
                    _:
                        pass

        def subject_interval(expression: Ast::Expr, subject: sview) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                lo: mutable i64 = -9223372036854775807 - 1
                hi: mutable i64 = 9223372036854775807
                any_bound: mutable bool = false
                accumulate_subject_bounds(expression, subject, lo, hi, any_bound)
                return (any_bound, lo, hi)

        # The required [lo, hi] of a refined parameter type, covering BOTH `T is Bounded[C,D]`
        # (parametric range law, via return_refinement_bounds) and `T is Bounded` (no-arg law
        # whose body is `self >= C and self <= D`, via the resolved predicate). "" otherwise.
        def refined_param_bounds(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                parametric: (found: bool, lo: i64, hi: i64) = return_refinement_bounds(type_expression, law_names, law_predicates)
                parametric return if parametric.found
                match type_expression:
                    Expr.Binary(base, operator, right, binary_line):
                        (false, 0, 0) return if operator != TokenKind.Is
                        law_name: sview = param_law_name(type_expression)
                        (false, 0, 0) return if law_name == ""
                        predicate: Ast::Expr = law_predicate_by_name(law_name, law_names, law_predicates)
                        return subject_interval(predicate, "self")
                    _:
                        return (false, 0, 0)

        # Collect (function, param-index, req-lo, req-hi) for every parameter with a range
        # refinement (no-arg OR parametric) — the positions the guard-interval prover checks.
        def collect_refined_param_bounds(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, out_functions: mutable darray[sview]&, out_indices: mutable darray[usize]&, out_los: mutable darray[i64]&, out_his: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            while probe < parameters.count |probe: usize = 0, out_functions, out_indices, out_los, out_his|:
                                bounds: (found: bool, lo: i64, hi: i64) = refined_param_bounds(parameters[probe].type_expression, law_names, law_predicates)
                                out_functions.push(function_name) if bounds.found
                                out_indices.push(probe) if bounds.found
                                out_los.push(bounds.lo) if bounds.found
                                out_his.push(bounds.hi) if bounds.found
                                probe <- probe + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_refined_param_bounds(module_body, law_names, law_predicates, out_functions, out_indices, out_los, out_his)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_refined_param_bounds(scoped_body, law_names, law_predicates, out_functions, out_indices, out_los, out_his)
                        _:
                            pass

        def collect_guard_subject_names(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        collect_guard_subject_names(inner, out)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.And:
                            collect_guard_subject_names(left, out)
                            collect_guard_subject_names(right, out)
                        else:
                            left_name: sview = ident_name_of(left)
                            right_name: sview = ident_name_of(right)
                            out.push(left_name) if left_name != "" and not name_in(out, left_name)
                            out.push(right_name) if right_name != "" and not name_in(out, right_name)
                    _:
                        pass

        # The interval a `subject is Law[lo,hi]` refinement guard establishes for `subject`,
        # searching through `and`-conjunctions. Reuses return_refinement_bounds (range laws
        # only). "" otherwise.
        def is_guard_subject_interval(expression: Ast::Expr, subject: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return is_guard_subject_interval(inner, subject, law_names, law_predicates)
                    Expr.Binary(left, operator, right, binary_line):
                        left_result: (found: bool, lo: i64, hi: i64) = is_guard_subject_interval(left, subject, law_names, law_predicates) if operator == TokenKind.And else (false, 0, 0)
                        left_result return if operator == TokenKind.And and left_result.found
                        is_guard_subject_interval(right, subject, law_names, law_predicates) return if operator == TokenKind.And
                        return_refinement_bounds(expression, law_names, law_predicates) return if operator == TokenKind.Is and ident_name_of(left) == subject and subject != ""
                        return (false, 0, 0)
                    _:
                        return (false, 0, 0)

        # The combined (intersected) interval a guard condition establishes for `subject` from
        # BOTH comparison bounds (`subject >= A`) and refinement guards (`subject is Law[A,B]`).
        def combined_subject_interval(condition: Ast::Expr, subject: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                comparison: (found: bool, lo: i64, hi: i64) = subject_interval(condition, subject)
                refinement: (found: bool, lo: i64, hi: i64) = is_guard_subject_interval(condition, subject, law_names, law_predicates)
                lo: mutable i64 = -9223372036854775807 - 1
                hi: mutable i64 = 9223372036854775807
                any_bound: mutable bool = false
                lo <- comparison.lo if comparison.found and comparison.lo > lo
                hi <- comparison.hi if comparison.found and comparison.hi < hi
                any_bound <- true if comparison.found
                lo <- refinement.lo if refinement.found and refinement.lo > lo
                hi <- refinement.hi if refinement.found and refinement.hi < hi
                any_bound <- true if refinement.found
                return (any_bound, lo, hi)

        def merge_guard_condition(condition: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, names: mutable darray[sview]&, los: mutable darray[i64]&, his: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                subjects: mutable darray[sview] = []
                collect_guard_subject_names(condition, subjects)
                for subject in subjects |names, los, his|:
                    interval: (found: bool, lo: i64, hi: i64) = combined_subject_interval(condition, subject, law_names, law_predicates)
                    if interval.found:
                        existing: mutable i64 = -1
                        index: mutable usize = 0
                        while index < names.count |existing, index|:
                            existing <- index.i64() if names[index] == subject
                            index <- index + 1
                        if existing < 0:
                            names.push(subject)
                            los.push(interval.lo)
                            his.push(interval.hi)
                        else:
                            los[existing.usize()] <- interval.lo if interval.lo > los[existing.usize()]
                            his[existing.usize()] <- interval.hi if interval.hi < his[existing.usize()]

        def argument_base_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Paren(inner, paren_line):
                        return argument_base_name(inner)
                    Expr.Unary(operator, operand, unary_line):
                        return argument_base_name(operand)
                    Expr.Binary(left, operator, right, binary_line):
                        left_base: sview = argument_base_name(left)
                        return left_base if left_base != "" else argument_base_name(right)
                    _:
                        return sview("", 0, 0)

        def guard_interval_check_expression(expression: Ast::Expr, line: u32, guard_names: darray[sview]&, guard_lo: darray[i64]&, guard_hi: darray[i64]&, excluded: darray[sview]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, gi_functions: darray[sview]&, gi_indices: darray[usize]&, gi_los: darray[i64]&, gi_his: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        probe: mutable usize = 0
                        while probe < gi_functions.count |table, probe| -> table:
                            if callee_name != "" and gi_functions[probe] == callee_name and gi_indices[probe] < arguments.count:
                                argument: Ast::Expr = arguments[gi_indices[probe]]
                                base_name: sview = argument_base_name(argument)
                                actual: (found: bool, lo: i64, hi: i64) = argument_interval(argument, guard_names, guard_lo, guard_hi)
                                escapes: bool = actual.found and base_name != "" and not name_in(excluded, base_name) and (actual.lo < gi_los[probe] or actual.hi > gi_his[probe])
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementArgNotProven, name: callee_name, line: line, expected: "", actual: "", expected_count: (gi_indices[probe] + 1).u32()}) if escapes
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- guard_interval_check_expression(argument, line, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                    Expr.Paren(inner, paren_line):
                        table <- guard_interval_check_expression(inner, line, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                    _:
                        pass

        def guard_interval_check_statements(statements: darray[Ast::Stmt], guard_names: darray[sview]&, guard_lo: darray[i64]&, guard_hi: darray[i64]&, excluded: darray[sview]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, gi_functions: darray[sview]&, gi_indices: darray[usize]&, gi_los: darray[i64]&, gi_his: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- guard_interval_check_expression(returned, line, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        Stmt.Expr(expression, line):
                            table <- guard_interval_check_expression(expression, line, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- guard_interval_check_expression(value, line, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        Stmt.If(condition, then_body, else_body, line):
                            child_names: mutable darray[sview] = [existing_name for existing_name in guard_names]
                            child_lo: mutable darray[i64] = [existing_lo for existing_lo in guard_lo]
                            child_hi: mutable darray[i64] = [existing_hi for existing_hi in guard_hi]
                            merge_guard_condition(condition, law_names, law_predicates, child_names, child_lo, child_hi)
                            table <- guard_interval_check_statements(then_body, child_names, child_lo, child_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                            table <- guard_interval_check_statements(else_body, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        Stmt.While(condition, while_body, line):
                            child_names_w: mutable darray[sview] = [existing_name_w for existing_name_w in guard_names]
                            child_lo_w: mutable darray[i64] = [existing_lo_w for existing_lo_w in guard_lo]
                            child_hi_w: mutable darray[i64] = [existing_hi_w for existing_hi_w in guard_hi]
                            merge_guard_condition(condition, law_names, law_predicates, child_names_w, child_lo_w, child_hi_w)
                            table <- guard_interval_check_statements(while_body, child_names_w, child_lo_w, child_hi_w, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- guard_interval_check_statements(block_body, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- guard_interval_check_statements(for_body, guard_names, guard_lo, guard_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        _:
                            pass

        def collect_guard_excluded_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            target_name: sview = ident_name_of(target)
                            out.push(target_name) if target_name != "" and not name_in(out, target_name)
                        Stmt.Contract(kind, expression, line):
                            collect_idents_in_expr(expression, out)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_guard_excluded_names(then_body, out)
                            collect_guard_excluded_names(else_body, out)
                        Stmt.While(condition, while_body, line):
                            collect_guard_excluded_names(while_body, out)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            collect_guard_excluded_names(block_body, out)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            collect_guard_excluded_names(for_body, out)
                        _:
                            pass

        # Collect top-level integer `const NAME: T = <literal>` bindings into name/value arrays,
        # so a refinement's dependent bound spelled as a const (`InRange[0, cap128]`) resolves.
        def rau_collect_int_consts(declarations: darray[Ast::Decl], names: mutable darray[sview]&, values: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, values|:
                    match declaration:
                        Decl.Const(const_name, type_expression, value, is_mutable, const_line):
                            literal: (found: bool, value: i64) = signed_int_literal(value)
                            names.push(const_name) if literal.found and not is_mutable
                            values.push(literal.value) if literal.found and not is_mutable
                        Decl.Module(module_name, module_body, module_line):
                            rau_collect_int_consts(module_body, names, values)
                        Decl.Scoped(scoped_body, scoped_line):
                            rau_collect_int_consts(scoped_body, names, values)
                        _:
                            pass

        # Collect `type AliasName[...] = TARGET` bindings as name -> target expr. Unlike
        # collect_refine_aliases (which keeps only `where`-predicate Refinement targets), this
        # keeps the raw target so an `is Law[...]` refinement (a Binary, not a Refinement) survives.
        def rau_collect_alias_targets(declarations: darray[Ast::Decl], names: mutable darray[sview]&, targets: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, targets|:
                    match declaration:
                        Decl.Alias(alias_name, target, alias_line):
                            names.push(alias_name)
                            targets.push(target)
                        Decl.Module(module_name, module_body, module_line):
                            rau_collect_alias_targets(module_body, names, targets)
                        Decl.Scoped(scoped_body, scoped_line):
                            rau_collect_alias_targets(scoped_body, names, targets)
                        _:
                            pass

        # The `Law[...]` refinement application inside an alias TARGET, whether the target spells
        # the refinement as `BASE is Law[...]` (a Binary) or as an Expr.Refinement.
        def rau_target_law_app(target: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Binary(base, operator, right, line):
                        return right if operator == TokenKind.Is else (Ast::Expr.Absent)
                    Expr.Refinement(refine_base, predicate, refine_line):
                        return predicate
                    Expr.Paren(inner, paren_line):
                        return rau_target_law_app(inner)
                    _:
                        return (Ast::Expr.Absent)

        # Resolve an index-arg expression to an integer: a signed literal, or a bare ident that
        # names a collected int const. (found, value).
        def rau_resolve_int(expression: Ast::Expr, const_names: darray[sview]&, const_values: darray[i64]&) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                literal: (found: bool, value: i64) = signed_int_literal(expression)
                literal return if literal.found
                name: sview = ident_name_of(expression)
                if name != "":
                    probe: mutable usize = 0
                    while probe < const_names.count |probe, name, const_names, const_values|:
                        (true, const_values[probe]) return if const_names[probe] == name
                        probe <- probe + 1
                return (false, 0)

        # Bounds of a PARAMETRIC-alias-typed value `AliasName[ARG]` where the alias is a range
        # refinement `type AliasName[p] = BASE is Law[a, b]` and exactly ONE of a,b is the alias
        # parameter (a bare ident), the other an int literal. ARG (a literal or a const) is
        # substituted for the parameter, giving a concrete [lo, hi]. Ambiguous shapes (two idents,
        # non-single application, unresolvable arg) return not-found — a sound miss.
        def rau_aliased_bounds(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, const_names: darray[sview]&, const_values: darray[i64]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                alias_name: mutable sview = sview("", 0, 0)
                arg_value: mutable (found: bool, value: i64) = (false, 0)
                match type_expression:
                    Expr.Index(object, index, index_line):
                        alias_name <- ident_name_of(object)
                        arg_value <- rau_resolve_int(index, const_names, const_values)
                    Expr.IndexN(object_n, arguments_n, indexn_line):
                        alias_name <- ident_name_of(object_n) if arguments_n.count == 1
                        arg_value <- rau_resolve_int(arguments_n[0], const_names, const_values) if arguments_n.count == 1
                    _:
                        pass
                (false, 0, 0) return if alias_name == "" or not arg_value.found
                # Find the alias's target, then its `Law[...]` refinement application.
                target: mutable Ast::Expr = (Ast::Expr.Absent)
                found_alias: mutable bool = false
                aidx: mutable usize = 0
                while aidx < alias_names.count |target, found_alias, aidx, alias_name, alias_names, alias_targets|:
                    if alias_names[aidx] == alias_name and not found_alias:
                        target <- alias_targets[aidx]
                        found_alias <- true
                    aidx <- aidx + 1
                (false, 0, 0) return if not found_alias
                predicate: Ast::Expr = rau_target_law_app(target)
                # The predicate is `Law[a, b]`; substitute the sole ident arg with arg_value.
                return match predicate:
                    Expr.IndexN(law_object, law_arguments, law_line):
                        law_name: sview = ident_name_of(law_object)
                        rau_substituted_range(law_name, law_arguments, arg_value.value, const_names, const_values, law_names, law_predicates) if law_arguments.count == 2 else (false, 0, 0)
                    _:
                        (false, 0, 0)

        # Given a range law's [a, b] arg exprs, resolve each: an int literal/const stays itself, a
        # bare ident (the alias parameter) becomes `param_value`. Fire only when the law is range-
        # shaped and exactly one arg was the substituted ident (so the mapping is unambiguous).
        def rau_substituted_range(law_name: sview, law_arguments: darray[Ast::Expr], param_value: i64, const_names: darray[sview]&, const_values: darray[i64]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                (false, 0, 0) return if law_shape(law_name, law_names, law_predicates) != "range"
                lo_lit: (found: bool, value: i64) = rau_resolve_int(law_arguments[0], const_names, const_values)
                hi_lit: (found: bool, value: i64) = rau_resolve_int(law_arguments[1], const_names, const_values)
                lo_ident: sview = ident_name_of(law_arguments[0])
                hi_ident: sview = ident_name_of(law_arguments[1])
                # Exactly one arg is the substituted parameter (a bare ident that is NOT a const).
                lo_is_param: bool = not lo_lit.found and lo_ident != ""
                hi_is_param: bool = not hi_lit.found and hi_ident != ""
                (false, 0, 0) return if lo_is_param == hi_is_param
                lo: i64 = param_value if lo_is_param else lo_lit.value
                hi: i64 = param_value if hi_is_param else hi_lit.value
                return (true, lo, hi)

        def guard_interval_walk(declarations: darray[Ast::Decl], signature_contract_exprs: darray[Ast::Expr], signature_contract_lines: darray[u32], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, const_names: darray[sview]&, const_values: darray[i64]&, gi_functions: darray[sview]&, gi_indices: darray[usize]&, gi_los: darray[i64]&, gi_his: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            excluded: mutable darray[sview] = []
                            collect_guard_excluded_names(body, excluded)
                            sig_index: mutable usize = 0
                            while sig_index < signature_contract_exprs.count |excluded, sig_index|:
                                collect_idents_in_expr(signature_contract_exprs[sig_index], excluded) if signature_contract_lines[sig_index] == line
                                sig_index <- sig_index + 1
                            # Seed the interval map with each refined PARAMETER's own type bounds
                            # (`x: i64 is Bounded[3,7]` -> x in [3,7]), so an arg like `-x` gets a
                            # real interval even without a guard. Guards then INTERSECT onto this.
                            seed_names: mutable darray[sview] = []
                            seed_lo: mutable darray[i64] = []
                            seed_hi: mutable darray[i64] = []
                            while pindex < parameters.count |seed_names, seed_lo, seed_hi, pindex: usize = 0|:
                                pbounds: (found: bool, lo: i64, hi: i64) = refined_param_bounds(parameters[pindex].type_expression, law_names, law_predicates)
                                # Fallback: a parametric-alias-over-const type (`SlotIndex[cap128]`)
                                # that refined_param_bounds (literal-arg only) can't resolve.
                                aliased: (found: bool, lo: i64, hi: i64) = rau_aliased_bounds(parameters[pindex].type_expression, alias_names, alias_targets, const_names, const_values, law_names, law_predicates) if not pbounds.found else (false, 0, 0)
                                use_lo: i64 = pbounds.lo if pbounds.found else aliased.lo
                                use_hi: i64 = pbounds.hi if pbounds.found else aliased.hi
                                use_found: bool = pbounds.found or aliased.found
                                seed_names.push(parameters[pindex].name) if use_found
                                seed_lo.push(use_lo) if use_found
                                seed_hi.push(use_hi) if use_found
                                pindex <- pindex + 1
                            table <- guard_interval_check_statements(body, seed_names, seed_lo, seed_hi, excluded, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- guard_interval_walk(module_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_targets, const_names, const_values, gi_functions, gi_indices, gi_los, gi_his, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- guard_interval_walk(scoped_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_targets, const_names, const_values, gi_functions, gi_indices, gi_los, gi_his, table)
                        _:
                            pass

        # ---- Symbolic-range refinement args (additive) -----------------------------------
        # For a parameter with a SYMBOLIC range refinement (`Bounded[0, xs.count]`), stage0
        # warns for every refinement-free argument — guards do not help (the bound is not a
        # static fact). Collect those positions and fire regardless of guard/fact context.
        def collect_symbolic_range_positions(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, out_functions: mutable darray[sview]&, out_indices: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            while probe < parameters.count |probe: usize = 0, out_functions, out_indices|:
                                symbolic: bool = is_symbolic_range_refinement(parameters[probe].type_expression, law_names, law_predicates)
                                out_functions.push(function_name) if symbolic
                                out_indices.push(probe) if symbolic
                                probe <- probe + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_symbolic_range_positions(module_body, law_names, law_predicates, out_functions, out_indices)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_symbolic_range_positions(scoped_body, law_names, law_predicates, out_functions, out_indices)
                        _:
                            pass

        def symbolic_range_check_expression(expression: Ast::Expr, line: u32, sym_functions: darray[sview]&, sym_indices: darray[usize]&, refinement_free_params: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        probe: mutable usize = 0
                        while probe < sym_functions.count |table, probe| -> table:
                            fires: bool = callee_name != "" and sym_functions[probe] == callee_name and sym_indices[probe] < arguments.count and symbolic_arg_at(arguments[sym_indices[probe]], refinement_free_params)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementArgNotProven, name: callee_name, line: line, expected: "", actual: "", expected_count: (sym_indices[probe] + 1).u32()}) if fires
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- symbolic_range_check_expression(argument, line, sym_functions, sym_indices, refinement_free_params, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- symbolic_range_check_expression(left, line, sym_functions, sym_indices, refinement_free_params, table)
                        table <- symbolic_range_check_expression(right, line, sym_functions, sym_indices, refinement_free_params, table)
                    Expr.Paren(inner, paren_line):
                        table <- symbolic_range_check_expression(inner, line, sym_functions, sym_indices, refinement_free_params, table)
                    _:
                        pass

        def symbolic_range_check_statements(statements: darray[Ast::Stmt], sym_functions: darray[sview]&, sym_indices: darray[usize]&, law_names: darray[sview]&, alias_names: darray[sview]&, refinement_free_params: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |refinement_free_params, table| -> refinement_free_params, table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- symbolic_range_check_expression(returned, line, sym_functions, sym_indices, refinement_free_params, table)
                        Stmt.Expr(expression, line):
                            table <- symbolic_range_check_expression(expression, line, sym_functions, sym_indices, refinement_free_params, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # A refinement-free (non-unsigned, non-law) local is fireable too —
                            # `i: i64 = seed` passed to a symbolic-range position.
                            refinement_free_params.push(name) if not type_mentions_refinement(type_expression, law_names, alias_names) and not (bare_type_name(type_expression) in {"u8", "u16", "u32", "u64", "usize", "uintptr", "uint"}) and name != ""
                            table <- symbolic_range_check_expression(value, line, sym_functions, sym_indices, refinement_free_params, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- symbolic_range_check_expression(value, line, sym_functions, sym_indices, refinement_free_params, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- symbolic_range_check_statements(then_body, sym_functions, sym_indices, law_names, alias_names, refinement_free_params, table)
                            table <- symbolic_range_check_statements(else_body, sym_functions, sym_indices, law_names, alias_names, refinement_free_params, table)
                        Stmt.While(condition, while_body, line):
                            table <- symbolic_range_check_statements(while_body, sym_functions, sym_indices, law_names, alias_names, refinement_free_params, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- symbolic_range_check_statements(block_body, sym_functions, sym_indices, law_names, alias_names, refinement_free_params, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- symbolic_range_check_statements(for_body, sym_functions, sym_indices, law_names, alias_names, refinement_free_params, table)
                        _:
                            pass

        def symbolic_range_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, sym_functions: darray[sview]&, sym_indices: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            refinement_free_params: mutable darray[sview] = []
                            for parameter in parameters |refinement_free_params|:
                                refinement_free_params.push(parameter.name) if param_is_warnable(parameter.type_expression, law_names, law_predicates, alias_names, alias_predicates)
                            table <- symbolic_range_check_statements(body, sym_functions, sym_indices, law_names, alias_names, refinement_free_params, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- symbolic_range_walk(module_body, law_names, law_predicates, alias_names, alias_predicates, sym_functions, sym_indices, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- symbolic_range_walk(scoped_body, law_names, law_predicates, alias_names, alias_predicates, sym_functions, sym_indices, table)
                        _:
                            pass

    public:
        # Whether a law predicate is ENTAILED by `self >= 0` (so an unsigned argument satisfies it
        # from its type alone): a pure lower bound `self >= K` with K <= 0, or `self > K` with K < 0.
        # `self > 0` (StrictlyPositive), any upper bound, or a range is NOT entailed.
        def uns_nonneg_entailed(predicate: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Binary(left, operator, right, binary_line):
                        false return if ident_name_of(left) != "self"
                        bound: (found: bool, value: i64) = signed_int_literal(right)
                        false return if not bound.found
                        true return if operator == TokenKind.GtEq and bound.value <= 0
                        true return if operator == TokenKind.Gt and bound.value < 0
                        return false
                    _:
                        return false

        # Unsigned unrefined parameter names of the current function (candidates for the
        # "unsigned does not entail a strict/positive-lower law" warning).
        def uns_collect_unsigned_params(parameters: darray[Ast::ParamDecl], law_names: darray[sview]&, alias_names: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |law_names, alias_names, out|:
                    bare: sview = bare_type_name(parameter.type_expression)
                    is_unsigned: bool = bare == "u8" or bare == "u16" or bare == "u32" or bare == "u64" or bare == "usize" or bare == "uintptr" or bare == "uint"
                    if is_unsigned and not type_mentions_refinement(parameter.type_expression, law_names, alias_names):
                        out.push(parameter.name)

        def uns_check_expr(expression: Ast::Expr, line: u32, param_functions: darray[sview]&, param_indices: darray[usize]&, param_predicates: darray[Ast::Expr]&, unsigned_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        probe: mutable usize = 0
                        while probe < param_functions.count |table, probe| -> table:
                            if callee_name != "" and param_functions[probe] == callee_name and param_indices[probe] < arguments.count:
                                arg_name: sview = ident_name_of(arguments[param_indices[probe]])
                                arg_unsigned: bool = arg_name != "" and name_in(unsigned_params, arg_name) and not name_in(fact_names, arg_name)
                                fires: bool = arg_unsigned and not uns_nonneg_entailed(param_predicates[probe])
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementArgNotProven, name: callee_name, line: line, expected: "", actual: "", expected_count: (param_indices[probe] + 1).u32()}) if fires
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- uns_check_expr(argument, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- uns_check_expr(left, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        table <- uns_check_expr(right, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- uns_check_expr(inner, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                    _:
                        pass

        def uns_check_stmts(statements: darray[Ast::Stmt], param_functions: darray[sview]&, param_indices: darray[usize]&, param_predicates: darray[Ast::Expr]&, unsigned_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- uns_check_expr(expression, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- uns_check_expr(value, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- uns_check_expr(value, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Stmt.Return(value, line):
                            table <- uns_check_expr(returned, line, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- uns_check_stmts(then_body, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                            table <- uns_check_stmts(else_body, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Stmt.While(condition, while_body, line):
                            table <- uns_check_stmts(while_body, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- uns_check_stmts(for_body, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- uns_check_stmts(block_body, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- uns_check_stmts(arm.body, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        _:
                            pass

        def uns_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, alias_names: darray[sview]&, param_functions: darray[sview]&, param_indices: darray[usize]&, param_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            unsigned_params: mutable darray[sview] = []
                            uns_collect_unsigned_params(parameters, law_names, alias_names, unsigned_params)
                            fact_names: mutable darray[sview] = []
                            collect_body_fact_names(body, fact_names)
                            table <- uns_check_stmts(body, param_functions, param_indices, param_predicates, unsigned_params, fact_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- uns_walk(module_body, law_names, alias_names, param_functions, param_indices, param_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- uns_walk(scoped_body, law_names, alias_names, param_functions, param_indices, param_predicates, table)
                        _:
                            pass

        def check_refinement_arg_unproven(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, law_names, law_predicates)
                alias_names: mutable darray[sview] = []
                alias_predicates: mutable darray[Ast::Expr] = []
                collect_refine_aliases(file.top_decls, alias_names, alias_predicates)
                param_functions: mutable darray[sview] = []
                param_indices: mutable darray[usize] = []
                param_predicates: mutable darray[Ast::Expr] = []
                collect_law_params(file.top_decls, law_names, law_predicates, alias_names, alias_predicates, param_functions, param_indices, param_predicates)
                table <- unproven_arg_walk(file.top_decls, file.signature_contract_exprs, file.signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, param_functions, param_indices, table)
                gi_functions: mutable darray[sview] = []
                gi_indices: mutable darray[usize] = []
                gi_los: mutable darray[i64] = []
                gi_his: mutable darray[i64] = []
                collect_refined_param_bounds(file.top_decls, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his)
                const_names: mutable darray[sview] = []
                const_values: mutable darray[i64] = []
                rau_collect_int_consts(file.top_decls, const_names, const_values)
                alias_target_names: mutable darray[sview] = []
                alias_targets: mutable darray[Ast::Expr] = []
                rau_collect_alias_targets(file.top_decls, alias_target_names, alias_targets)
                table <- guard_interval_walk(file.top_decls, file.signature_contract_exprs, file.signature_contract_lines, law_names, law_predicates, alias_target_names, alias_targets, const_names, const_values, gi_functions, gi_indices, gi_los, gi_his, table)
                sym_functions: mutable darray[sview] = []
                sym_indices: mutable darray[usize] = []
                collect_symbolic_range_positions(file.top_decls, law_names, law_predicates, sym_functions, sym_indices)
                table <- symbolic_range_walk(file.top_decls, law_names, law_predicates, alias_names, alias_predicates, sym_functions, sym_indices, table)
                table <- uns_walk(file.top_decls, law_names, alias_names, param_functions, param_indices, param_predicates, table)

    private:
        def unproven_arg_walk(declarations: darray[Ast::Decl], signature_contract_exprs: darray[Ast::Expr], signature_contract_lines: darray[u32], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, param_functions: darray[sview]&, param_indices: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            refinement_free_params: mutable darray[sview] = []
                            for parameter in parameters |refinement_free_params|:
                                refinement_free_params.push(parameter.name) if param_is_warnable(parameter.type_expression, law_names, law_predicates, alias_names, alias_predicates)
                            fact_names: mutable darray[sview] = []
                            collect_body_fact_names(body, fact_names)
                            # Every identifier named by a signature contract of THIS function
                            # carries a potential assumed fact — never warn on it.
                            sig_index: mutable usize = 0
                            while sig_index < signature_contract_exprs.count |fact_names, sig_index|:
                                collect_idents_in_expr(signature_contract_exprs[sig_index], fact_names) if signature_contract_lines[sig_index] == line
                                sig_index <- sig_index + 1
                            table <- unproven_arg_check_statements(body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                            # A `-> T is R` refinement return whose returned value is an
                            # unconstrained parameter cannot be proven in [lo, hi] — mirror
                            # stage0's "refinement R on the return of F could not be proven".
                            refined_return: bool = match return_type:
                                present_return_type: type_mentions_refinement(present_return_type, law_names, alias_names)
                                _: false
                            table <- unproven_return_check(body, refinement_free_params, fact_names, function_name, table) if refined_return
                        Decl.Module(module_name, module_body, module_line):
                            table <- unproven_arg_walk(module_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, param_functions, param_indices, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- unproven_arg_walk(scoped_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, param_functions, param_indices, table)
                        _:
                            pass
