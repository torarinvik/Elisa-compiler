# Const-enum member value range. A `const enum E of uN/iN:` member with an explicit `= VALUE`
# initializer whose value does not fit the storage type is rejected ("const enum member E.M value
# V does not fit storage type T"). Pure syntactic: parse the storage bit-int type to its [min,max]
# window and check each variant's integer-literal value against it.
extend Semantic:
    private:
        # The [min, max] window of a bit-int storage type name (`u4`, `i8`, …). found=false for a
        # non-bit-int name or a width >= 64 (i64 cannot represent the bound).
        #
        # This is called on ARBITRARY cast-target/storage type names, not just genuine bit-int
        # ones (check_cast_constant_truncated.elisa calls it for every numeric cast), so `ok`
        # going false on the first non-digit character must stop the scan — continuing to fold
        # remaining bytes into `bits` is not just wasted work, it is unbounded: a long identifier
        # like `int_to_string_scratch` (21 bytes, leads with 'i') fed 20 more iterations of
        # `bits <- bits * 10 + garbage` with no digit ever seen again, and the repeated *10 alone
        # overflows i64 well before the loop ends — a genuine latent signed-overflow bug, always
        # present here, silently wrapping to a discarded value before stage1 checked overflow
        # (the caller only reads a valid window when found=true, and a wrapped `bits` almost
        # always failed the `bits >= 64` guard anyway, so a wrong intermediate never leaked).
        # Confirmed via the self-hosting fixpoint tracing exactly this identifier at the crash.
        def bit_int_window(type_name: sview) -> (found: bool, low: i64, high: i64):
            can Abort.Panic:
                length: usize = sview_len(type_name)
                (false, 0, 0) return if length < 2
                lead: u8 = type_name[0]
                is_unsigned: bool = lead == 117
                is_signed: bool = lead == 105
                (false, 0, 0) return if not (is_unsigned or is_signed)
                bits: mutable i64 = 0
                index: mutable usize = 1
                ok: mutable bool = true
                while index < length and ok |bits, index, ok|:
                    digit: u8 = type_name[index]
                    if digit < 48 or digit > 57:
                        ok <- false
                    else:
                        bits <- bits * 10 + (digit - 48).i64()
                        index <- index + 1
                (false, 0, 0) return if not ok or bits <= 0 or bits >= 64
                span: i64 = 1 << bits.usize() if is_unsigned else 1 << (bits - 1).usize()
                low: i64 = 0 if is_unsigned else 0 - span
                high: i64 = span - 1
                return (true, low, high)

        def check_const_enum_value_fits(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Enum(enum_name, variants, enum_is_const, enum_storage, enum_line):
                            storage_name: sview = ident_name_of(enum_storage)
                            window: (found: bool, low: i64, high: i64) = bit_int_window(storage_name) if enum_is_const else (false, 0, 0)
                            if window.found:
                                for variant in variants |table| -> table:
                                    value_literal: (found: bool, value: i64) = where_signed_literal(variant.value_expr)
                                    out_of_range: bool = value_literal.found and (value_literal.value < window.low or value_literal.value > window.high)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstEnumValueOverflow, name: variant.name, line: enum_line.line, expected: enum_name, actual: storage_name, expected_count: value_literal.value.u32()}) if out_of_range
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_const_enum_value_fits(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_const_enum_value_fits(scoped_body, table)
                        _:
                            pass
