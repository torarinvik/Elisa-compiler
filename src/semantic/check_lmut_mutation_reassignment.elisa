# An `lmut T` parameter is a LINEAR mutable value: a call that threads it (the callee declares
# the argument `lmut`, tracked in lmut_param_owner/pos) consumes the value and produces its
# successor, so the call MUST rebind the argument's name — `x <- x.step()`, `x, _ <- x.step()`,
# or a `rebind ... x = ...`. A bare statement call (`p.advance()`), a discard (`_ = bump(c)`), or
# a fresh binding that keeps only a side result (`c: i64 = advance_char(lx)`) drops the threaded
# successor — stage0 flags it (docs/120 §10). SOUND, structural subset: a threading call whose
# lmut argument is a bare Ident is a violation unless that name appears among the enclosing
# assignment's targets. UFCS `recv.m(...)` threads its RECEIVER at position 0.
extend Semantic:
    private:
        def lmut_threads_position(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                found: mutable bool = false
                while index < table.lmut_param_owner.count |found, index, callee, position, table|:
                    found <- true if table.lmut_param_owner[index] == callee and table.lmut_param_pos[index] == position
                    index <- index + 1
                return found

        # The bare-Ident name threaded by a call at an lmut position ("" when the call threads
        # nothing rebindable). Direct `f(a, b)`: an argument at an lmut position. UFCS
        # `recv.m(a)`: the receiver is position 0, the written arguments shift to 1+.
        def lmut_threaded_arg_name(expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(direct_name, direct_line):
                                position: mutable u32 = 0
                                result: mutable sview = sview("", 0, 0)
                                for argument in arguments |result, position, direct_name, table|:
                                    result <- ident_name_of(argument) if result == "" and lmut_threads_position(table, direct_name, position)
                                    position <- position + 1
                                return result
                            Expr.Field(receiver, method_name, field_line):
                                receiver_name: sview = ident_name_of(receiver)
                                receiver_name return if receiver_name != "" and lmut_threads_position(table, method_name, 0)
                            _:
                                pass
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Append the bare-Ident target names of an assignment target expression (a single
        # `Ident` or a tuple `Array` of them) to OUT.
        def lmut_collect_target_names(target: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Array(elements, array_line):
                        out.extend([ident_name_of(element) for element in elements if ident_name_of(element) != ""])
                    _:
                        pass

        # Flag a threading call in VALUE whose threaded name is NOT among `targets`. Recurses
        # through the shapes a rebind RHS can take (value-`if`, parens) so
        # `lexer <- if c: lexer.advance() else: lexer` stays accepted.
        def lmut_check_value(value: Ast::Expr, targets: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                threaded: sview = lmut_threaded_arg_name(value, table)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutMutationNotReassignment, name: threaded, line: line, expected: "", actual: "", expected_count: 1}) if threaded != "" and not (any target in targets where target == threaded)
                match value:
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- lmut_check_value(then_value, targets, line, table)
                        table <- lmut_check_value(else_value, targets, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- lmut_check_value(inner, targets, line, table)
                    _:
                        pass

        # Collect every `__lmut_rebind_claim` name recorded at `line` — see
        # check_lmut_rebind_claim.elisa's `lrc_claims_at` (same annotation, reused here).
        # `rebind_statement` (parser_stmt_control.elisa) has a SPECIAL lowering for
        # `rebind FRESH: T, recv = get recv.method()`: since the value is a bare `get` on a
        # SINGLE fresh binding, it collapses the whole rebind to a plain
        # `Stmt.VarDecl(FRESH, T, value, line)` and drops `recv` from the AST's target list
        # entirely — "the trailing claim-targets need no store" (its own comment). The
        # `recv` claim survives only in this side table, keyed by the rebind keyword's line
        # (which the parser also uses as the VarDecl's line). Without consulting it, a
        # VarDecl whose value is `recv.method()` looks exactly like an ordinary
        # non-reassigning `X: T = f()` and gets wrongly flagged — confirmed on the
        # compiler's own source (`rebind forall_iterable: Ast::Expr, parser = get
        # parser.expression()` in src/parser/parser_expr_query.elisa's quantifier_expression).
        def lmr_rebind_claims_at(annotations: darray[Ast::EnumAnnotation]&, line: u32, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.extend([annotation.name for annotation in annotations if annotation.owner == "__lmut_rebind_claim" and annotation.line == line])

        def lmut_mutation_check_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            no_targets: darray[sview] = []
                            table <- lmut_check_value(expression, no_targets, line.line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            claimed: mutable darray[sview] = []
                            lmr_rebind_claims_at(annotations, line.line, claimed)
                            table <- lmut_check_value(value, claimed, line.line, table)
                        Stmt.Assign(target, operator, value, line):
                            targets: mutable darray[sview] = []
                            lmut_collect_target_names(target, targets)
                            table <- lmut_check_value(value, targets, line.line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- lmut_mutation_check_statements(then_body, annotations, table)
                            table <- lmut_mutation_check_statements(else_body, annotations, table)
                        Stmt.While(condition, while_body, line):
                            table <- lmut_mutation_check_statements(while_body, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- lmut_mutation_check_statements(for_body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- lmut_mutation_check_statements(body, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- lmut_mutation_check_statements(arm.body, annotations, table)
                        _:
                            pass

        def lmut_mutation_walk(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- lmut_mutation_check_statements(body, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- lmut_mutation_walk(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- lmut_mutation_walk(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_lmut_mutation_reassignment(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lmut_mutation_walk(file.top_decls, file.enum_annotations, table)
