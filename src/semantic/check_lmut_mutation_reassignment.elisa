# An `lmut T` parameter is a LINEAR mutable value: a call that threads it (the callee declares
# the argument `lmut`, tracked in lmut_param_owner/pos) consumes the value and produces its
# successor, so the call MUST rebind the argument's name — `x <- x.step()`, `x, _ <- x.step()`,
# or a `rebind ... x = ...`. A bare statement call (`p.advance()`), a discard (`_ = bump(c)`), or
# a fresh binding that keeps only a side result (`c: i64 = advance_char(lx)`) drops the threaded
# successor — stage0 flags it (docs/120 §10). SOUND, structural subset: a threading call whose
# lmut argument is a bare Ident is a violation unless that name appears among the enclosing
# assignment's targets. UFCS `recv.m(...)` threads its RECEIVER at position 0.
#
# The same rule covers a mutating BUILTIN collection method (stage0 checkValueBlockMutatingBuiltinMethod
# -> checkLinearMutation): `p.items.clear()` on a darray/dict/set place rooted at an `lmut`
# PARAMETER mutates `p` in place, so it must sit under a reassignment naming the root
# (`p.items <- p.items.clear()`), or inside a `while … |p|:` loop that captures it. A `for`
# capture does not license it (stage0 pushes the capture frame for `while` only), and a plain
# field store `p.n <- …` is not a call and never reaches the rule.
extend Semantic:
    private:
        def lmut_threads_position(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                # Fully indexed tables: walk only CALLEE's owner-hash chain (every row is
                # still compared by name and position). Otherwise keep the full scan.
                if table.lmut_param_next.count == table.lmut_param_owner.count and table.lmut_param_pos.count == table.lmut_param_owner.count:
                    row: mutable u32 = lmut_param_head(table, name_hash(callee))
                    while row != SYMBOL_INDEX_ROW_NONE |row, callee, position, table|:
                        true return if table.lmut_param_owner[row.usize()] == callee and table.lmut_param_pos[row.usize()] == position
                        row <- table.lmut_param_next[row.usize()]
                    return false
                index: mutable usize = 0
                found: mutable bool = false
                while index < table.lmut_param_owner.count |found, index, callee, position, table|:
                    found <- true if table.lmut_param_owner[index] == callee and table.lmut_param_pos[index] == position
                    index <- index + 1
                return found

        # The bare-Ident name threaded by a call at an lmut position ("" when the call threads
        # nothing rebindable). Direct `f(a, b)`: an argument at an lmut position. UFCS
        # `recv.m(a)`: the receiver is position 0, the written arguments shift to 1+.
        def lmut_threaded_arg_name(expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(direct_name, direct_line):
                                position: mutable u32 = 0
                                result: mutable sview = sview("", 0, 0)
                                for argument in arguments |result, position, direct_name, table|:
                                    result <- ident_name_of(argument) if result == "" and lmut_threads_position(table, direct_name, position)
                                    position <- position + 1
                                return result
                            Expr.Field(receiver, method_name, field_line):
                                receiver_name: sview = ident_name_of(receiver)
                                receiver_name return if receiver_name != "" and lmut_threads_position(table, method_name, 0)
                            _:
                                pass
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Append the bare-Ident target names of an assignment target expression (a single
        # `Ident` or a tuple `Array` of them) to OUT.
        def lmut_collect_target_names(target: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Array(elements, array_line):
                        out.extend([ident_name_of(element) for element in elements if ident_name_of(element) != ""])
                    _:
                        pass

        # The same rooted field place (`report.cache` == `report.cache`); parentheses are
        # transparent. Only identifiers and field selections form a place here.
        def lmut_same_place(left: Ast::Expr, right: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match left:
                    Expr.Paren(left_inner, left_pos):
                        return lmut_same_place(left_inner, right)
                    Expr.Ident(left_name, left_ident_pos):
                        return ident_name_of(right) == left_name
                    Expr.Field(left_object, left_field, left_field_pos):
                        match right:
                            Expr.Paren(right_inner, right_pos):
                                return lmut_same_place(left, right_inner)
                            Expr.Field(right_object, right_field, right_field_pos):
                                return left_field == right_field and lmut_same_place(left_object, right_object)
                            _:
                                return false
                    _:
                        return false

        # The root identifier of a field place (`report.cache.slots` -> "report"), or "".
        def lmut_field_place_root(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(object, field, field_pos):
                        name: sview = ident_name_of(object)
                        name return if name != ""
                        return lmut_field_place_root(object)
                    Expr.Paren(inner, paren_pos):
                        return lmut_field_place_root(inner)
                    _:
                        return sview("", 0, 0)

        # A direct call's FIELD-PATH argument at an lmut position (`bump(report.cache)`): the
        # docs/120 §8 manifest then needs that same place as the assignment target.
        def lmut_threaded_field_arg(expression: Ast::Expr, table: SymbolTable&) -> (found: bool, place: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        direct_name: sview = ident_name_of(callee)
                        if direct_name != "":
                            for position in 0..<arguments.count:
                                if lmut_threads_position(table, direct_name, position.u32()) and lmut_field_place_root(arguments[position]) != "":
                                    return (true, arguments[position])
                    _:
                        pass
                return (false, (Ast::Expr.Invalid))

        # Flag a threading call in VALUE whose threaded name is NOT among `targets`. Recurses
        # through the shapes a rebind RHS can take (value-`if`, parens) so
        # `lexer <- if c: lexer.advance() else: lexer` stays accepted.
        def lmut_check_value(value: Ast::Expr, targets: darray[sview]&, target_place: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                threaded: sview = lmut_threaded_arg_name(value, table)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutMutationNotReassignment, name: threaded, line: line, expected: "", actual: "", expected_count: 1}) if threaded != "" and not (any target in targets where target == threaded)
                field_arg: (found: bool, place: Ast::Expr) = lmut_threaded_field_arg(value, table)
                if field_arg.found and not lmut_same_place(field_arg.place, target_place):
                    # Name the place as `root.field` when it is one selection deep.
                    field_name: mutable sview = sview("", 0, 0)
                    match field_arg.place:
                        Expr.Field(place_object, place_field, place_pos):
                            field_name <- place_field if ident_name_of(place_object) != ""
                        _:
                            pass
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutMutationNotReassignment, name: lmut_field_place_root(field_arg.place), line: line, expected: "", actual: field_name, expected_count: 1})
                match value:
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- lmut_check_value(then_value, targets, target_place, line, table)
                        table <- lmut_check_value(else_value, targets, target_place, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- lmut_check_value(inner, targets, target_place, line, table)
                    _:
                        pass

        # Collect every `__lmut_rebind_claim` name recorded at `line` — see
        # check_lmut_rebind_claim.elisa's `lrc_claims_at` (same annotation, reused here).
        # `rebind_statement` (parser_stmt_control.elisa) has a SPECIAL lowering for
        # `rebind FRESH: T, recv = get recv.method()`: since the value is a bare `get` on a
        # SINGLE fresh binding, it collapses the whole rebind to a plain
        # `Stmt.VarDecl(FRESH, T, value, line)` and drops `recv` from the AST's target list
        # entirely — "the trailing claim-targets need no store" (its own comment). The
        # `recv` claim survives only in this side table, keyed by the rebind keyword's line
        # (which the parser also uses as the VarDecl's line). Without consulting it, a
        # VarDecl whose value is `recv.method()` looks exactly like an ordinary
        # non-reassigning `X: T = f()` and gets wrongly flagged — confirmed on the
        # compiler's own source (`rebind forall_iterable: Ast::Expr, parser = get
        # parser.expression()` in src/parser/parser_expr_query.elisa's quantifier_expression).
        def lmr_rebind_claims_at(annotations: darray[Ast::EnumAnnotation]&, line: u32, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.extend([annotation.name for annotation in annotations if annotation.owner == "__lmut_rebind_claim" and annotation.line == line])

        # stage0 mutatingBuiltinCollectionMethods: the builtin darray/dict/set methods that
        # change a container's contents or layout. `pop` is a stdlib method with a real
        # `T&` self, so it is not in the set.
        def lmr_mutating_builtin(method: sview) -> bool:
            true return if method == "push" or method == "extend" or method == "reserve" or method == "resize"
            true return if method == "clear" or method == "truncate" or method == "insert" or method == "remove"
            return method == "set" or method == "put" or method == "add" or method == "get_or_insert"

        # A type spelling with its reference and mode qualifiers peeled.
        def lmr_strip_type(type_expression: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        return lmr_strip_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    Expr.Paren(inner, paren_pos):
                        return lmr_strip_type(inner)
                    _:
                        pass
                return type_expression

        def lmr_is_lmut_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        return operator == TokenKind.Lmut
                    Expr.Paren(inner, paren_pos):
                        return lmr_is_lmut_type(inner)
                    _:
                        return false

        # stage0 receiverIsBuiltinCollection: a darray (incl. `dstr`), dict or set, peeling refs.
        def lmr_is_builtin_collection(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match lmr_strip_type(type_expression):
                    Expr.Ident(name, ident_pos):
                        return name == "dstr"
                    Expr.Index(object, argument, index_pos):
                        container: sview = ident_name_of(object)
                        return container == "darray" or container == "dict" or container == "set"
                    Expr.IndexN(object_n, arguments, index_n_pos):
                        return ident_name_of(object_n) == "dict"
                    _:
                        return false

        # The declared type of a receiver place rooted at an `lmut` parameter (a field/index
        # chain), or Expr.Invalid when this pass cannot name it -- nothing fires then.
        def lmr_receiver_type(receiver: Ast::Expr, lmut_names: darray[sview]&, lmut_types: darray[Ast::Expr]&, table: SymbolTable&) -> Ast::Expr:
            can Abort.Panic:
                match receiver:
                    Expr.Ident(name, ident_pos):
                        while position < lmut_names.count |position: usize = 0|:
                            return lmut_types[position] if lmut_names[position] == name
                            position <- position + 1
                    Expr.Paren(inner, paren_pos):
                        return lmr_receiver_type(inner, lmut_names, lmut_types, table)
                    Expr.Field(object, field, field_pos):
                        owner: sview = owner_name if lmr_strip_type(lmr_receiver_type(object, lmut_names, lmut_types, table)) is Ast::Expr.Ident(owner_name, _) else ""
                        if owner != "":
                            row: i64 = struct_field_row_for_type(table, owner, field)
                            return table.private_field_types[row.usize()] if row >= 0 and row.usize() < table.private_field_types.count
                    Expr.Index(indexed, index, indexed_pos):
                        match lmr_strip_type(lmr_receiver_type(indexed, lmut_names, lmut_types, table)):
                            Expr.Index(container, element, container_pos):
                                return element if ident_name_of(container) == "darray"
                            Expr.IndexN(container_n, type_arguments, container_n_pos):
                                return type_arguments[1] if ident_name_of(container_n) == "dict" and type_arguments.count == 2
                            _:
                                pass
                    _:
                        pass
                return Ast::Expr.Invalid

        # stage0 rootIdentName over the place shapes a receiver can take.
        def lmr_place_root(place: Ast::Expr) -> sview:
            can Abort.Panic:
                match place:
                    Expr.Ident(name, ident_pos):
                        return name
                    Expr.Field(object, field, field_pos):
                        return lmr_place_root(object)
                    Expr.Index(indexed, index, index_pos):
                        return lmr_place_root(indexed)
                    Expr.Paren(inner, paren_pos):
                        return lmr_place_root(inner)
                    _:
                        return ""

        # Flag every mutating builtin call in VALUE whose receiver is a collection place rooted
        # at an `lmut` parameter that is neither a target of the enclosing reassignment nor
        # captured by an enclosing `while`. Descends the expression shapes a call can hide in;
        # value blocks and lambdas are left to their own analyses (E4 rejects the uncaptured case).
        def lmr_check_builtin_calls(value: Ast::Expr, targets: darray[sview]&, allowed: darray[sview]&, lmut_names: darray[sview]&, lmut_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if lmut_names.count == 0
                match value:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(receiver, method, method_pos):
                                root: sview = lmr_place_root(receiver)
                                if root != "" and lmr_mutating_builtin(method) and not (any target in targets where target == root) and not (any name in allowed where name == root) and lmr_is_builtin_collection(lmr_receiver_type(receiver, lmut_names, lmut_types, table)):
                                    receiver_pos: Ast::Pos = Ast::expr_pos(receiver)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutMutationNotReassignment, name: root, pos: receiver_pos, line: receiver_pos.line, expected: "", actual: "", expected_count: 1})
                                table <- lmr_check_builtin_calls(receiver, targets, allowed, lmut_names, lmut_types, table)
                            _:
                                table <- lmr_check_builtin_calls(callee, targets, allowed, lmut_names, lmut_types, table)
                        for argument in arguments |table| -> table:
                            table <- lmr_check_builtin_calls(argument, targets, allowed, lmut_names, lmut_types, table)
                    Expr.Field(object, field, field_pos):
                        table <- lmr_check_builtin_calls(object, targets, allowed, lmut_names, lmut_types, table)
                    Expr.Index(indexed, index, index_pos):
                        table <- lmr_check_builtin_calls(indexed, targets, allowed, lmut_names, lmut_types, table)
                        table <- lmr_check_builtin_calls(index, targets, allowed, lmut_names, lmut_types, table)
                    Expr.Paren(inner, paren_pos):
                        table <- lmr_check_builtin_calls(inner, targets, allowed, lmut_names, lmut_types, table)
                    Expr.If(condition, then_value, else_value, if_pos):
                        table <- lmr_check_builtin_calls(condition, targets, allowed, lmut_names, lmut_types, table)
                        table <- lmr_check_builtin_calls(then_value, targets, allowed, lmut_names, lmut_types, table)
                        table <- lmr_check_builtin_calls(else_value, targets, allowed, lmut_names, lmut_types, table)
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- lmr_check_builtin_calls(left, targets, allowed, lmut_names, lmut_types, table)
                        table <- lmr_check_builtin_calls(right, targets, allowed, lmut_names, lmut_types, table)
                    Expr.Unary(unary_operator, operand, unary_pos):
                        table <- lmr_check_builtin_calls(operand, targets, allowed, lmut_names, lmut_types, table)
                    Expr.Array(elements, array_pos):
                        for element in elements |table| -> table:
                            table <- lmr_check_builtin_calls(element, targets, allowed, lmut_names, lmut_types, table)
                    Expr.Tuple(tuple_elements, tuple_pos):
                        for tuple_element in tuple_elements |table| -> table:
                            table <- lmr_check_builtin_calls(tuple_element, targets, allowed, lmut_names, lmut_types, table)
                    _:
                        pass

        # stage0 keys the reassignment exemption on the ROOT of a single target
        # (`p.items <- …` licenses `p`) and on the bare names of a tuple target.
        def lmr_target_roots(target: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Array(elements, array_pos):
                        out.extend([ident_name_of(element) for element in elements if ident_name_of(element) != ""])
                    _:
                        root: sview = lmr_place_root(target)
                        out.push(root) if root != ""

        # Names the body declares itself: a local that shadows an `lmut` parameter is not
        # that parameter, so the rule declines on every such name.
        def lmr_collect_declared(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, pos):
                            out.push(name)
                        Stmt.For(bind, variables, iterable, for_body, pos):
                            out.extend(variables)
                            lmr_collect_declared(for_body, out)
                        Stmt.Block(kind, clause, binding, body, pos):
                            out.push(binding) if binding != ""
                            lmr_collect_declared(body, out)
                        Stmt.If(condition, then_body, else_body, pos):
                            lmr_collect_declared(then_body, out)
                            lmr_collect_declared(else_body, out)
                        Stmt.While(condition, while_body, pos):
                            lmr_collect_declared(while_body, out)
                        Stmt.Match(scrutinee, arms, pos):
                            for arm in arms |out|:
                                lmr_collect_declared(arm.body, out)
                        _:
                            pass

        # A captured-loop block (semantic_loop_view) whose loop is a `while`.
        def lmr_block_is_while(body: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                return any statement in body where statement is Ast::Stmt.While(_, _, _)

        def lmut_mutation_check_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, allowed: darray[sview]&, lmut_names: darray[sview]&, lmut_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                no_targets: darray[sview] = []
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- lmut_check_value(expression, no_targets, (Ast::Expr.Invalid), line.line, table)
                            table <- lmr_check_builtin_calls(expression, no_targets, allowed, lmut_names, lmut_types, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            claimed: mutable darray[sview] = []
                            lmr_rebind_claims_at(annotations, line.line, claimed)
                            table <- lmut_check_value(value, claimed, (Ast::Expr.Invalid), line.line, table)
                            table <- lmr_check_builtin_calls(value, claimed, allowed, lmut_names, lmut_types, table)
                        Stmt.Assign(target, operator, value, line):
                            targets: mutable darray[sview] = []
                            lmut_collect_target_names(target, targets)
                            table <- lmut_check_value(value, targets, target, line.line, table)
                            roots: mutable darray[sview] = []
                            lmr_target_roots(target, roots)
                            table <- lmr_check_builtin_calls(value, roots, allowed, lmut_names, lmut_types, table)
                        Stmt.Return(returned, line):
                            if returned is returned_value:
                                table <- lmr_check_builtin_calls(returned_value, no_targets, allowed, lmut_names, lmut_types, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- lmr_check_builtin_calls(condition, no_targets, allowed, lmut_names, lmut_types, table)
                            table <- lmut_mutation_check_statements(then_body, annotations, allowed, lmut_names, lmut_types, table)
                            table <- lmut_mutation_check_statements(else_body, annotations, allowed, lmut_names, lmut_types, table)
                        Stmt.While(condition, while_body, line):
                            table <- lmr_check_builtin_calls(condition, no_targets, allowed, lmut_names, lmut_types, table)
                            table <- lmut_mutation_check_statements(while_body, annotations, allowed, lmut_names, lmut_types, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- lmr_check_builtin_calls(iterable, no_targets, allowed, lmut_names, lmut_types, table)
                            table <- lmut_mutation_check_statements(for_body, annotations, allowed, lmut_names, lmut_types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "loop" and lmr_block_is_while(body):
                                # stage0 loopCaptureAllowed: `while … |p|:` licenses `p`.
                                widened: mutable darray[sview] = []
                                widened.extend(allowed)
                                widened.extend(clause)
                                table <- lmut_mutation_check_statements(body, annotations, widened, lmut_names, lmut_types, table)
                            else:
                                table <- lmut_mutation_check_statements(body, annotations, allowed, lmut_names, lmut_types, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- lmr_check_builtin_calls(scrutinee, no_targets, allowed, lmut_names, lmut_types, table)
                            for arm in arms |table| -> table:
                                table <- lmut_mutation_check_statements(arm.body, annotations, allowed, lmut_names, lmut_types, table)
                        _:
                            pass

        def lmut_mutation_walk(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            declared: mutable darray[sview] = []
                            lmr_collect_declared(body, declared)
                            lmut_names: mutable darray[sview] = []
                            lmut_types: mutable darray[Ast::Expr] = []
                            for parameter in parameters |lmut_names, lmut_types|:
                                if lmr_is_lmut_type(parameter.type_expression) and not (any name in declared where name == parameter.name):
                                    lmut_names.push(parameter.name)
                                    lmut_types.push(parameter.type_expression)
                            no_allowed: darray[sview] = []
                            table <- lmut_mutation_check_statements(body, annotations, no_allowed, lmut_names, lmut_types, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- lmut_mutation_walk(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- lmut_mutation_walk(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_lmut_mutation_reassignment(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Rebind claims are the only annotation rows consumed by this
                # walk. Preserve their original order and duplicate targets.
                rebind_annotations: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |rebind_annotations|:
                    rebind_annotations.push(annotation) if annotation.owner == "__lmut_rebind_claim"
                table <- lmut_mutation_walk(file.top_decls, rebind_annotations, table)
