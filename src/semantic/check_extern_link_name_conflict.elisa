# Two `@link_name(SYM)` extern declarations that bind the SAME native symbol must agree on
# their signature — otherwise the one native symbol is given two incompatible types and the
# linker silently picks one ("native symbol splitting"). stage0 flags the LATER declaration
# whose signature differs from an earlier one sharing the link_name. Matching signatures under
# a shared link_name are accepted (an intentional alias). SOUND, purely structural: the
# signature is (callable, arity, return type name, ordered param type names); any field
# differing between two same-link_name externs is a conflict.
extend Semantic:
    private:
        # The `@link_name(SYM)` argument of an extern's decorators ("" when absent).
        def extern_link_name_value(decorators: darray[Ast::Annotation], annotation_args: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                for decorator in decorators |annotation_args|:
                    annotation_args[decorator.arg_start.usize()] return if decorator.name == "link_name" and decorator.arg_count > 0 and decorator.arg_start.usize() < annotation_args.count
                return sview("", 0, 0)

        # Whether externs I and J (already known to share a link_name) have DIFFERING
        # signatures. Params are the `extern_params` slices at each param_start.
        def extern_signatures_differ(callable_i: bool, arity_i: u32, ret_i: sview, start_i: u32, callable_j: bool, arity_j: u32, ret_j: sview, start_j: u32, extern_params: darray[Ast::ExternParam]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if callable_i != callable_j or arity_i != arity_j or ret_i != ret_j
                offset: mutable u32 = 0
                differ: mutable bool = false
                while offset < arity_i |differ, offset, start_i, start_j, arity_i, extern_params|:
                    slot_i: usize = start_i.usize() + offset.usize()
                    slot_j: usize = start_j.usize() + offset.usize()
                    if slot_i < extern_params.count and slot_j < extern_params.count:
                        differ <- true if extern_params[slot_i].type_name != extern_params[slot_j].type_name
                    offset <- offset + 1
                return differ

        # Collect every `@link_name`-carrying extern into parallel signature columns.
        def collect_link_name_externs(declarations: darray[Ast::Decl], annotation_args: darray[sview]&, ln_values: mutable darray[sview]&, ex_names: mutable darray[sview]&, ex_lines: mutable darray[u32]&, ex_callable: mutable darray[bool]&, ex_arity: mutable darray[u32]&, ex_ret: mutable darray[sview]&, ex_pstart: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |annotation_args, ln_values, ex_names, ex_lines, ex_callable, ex_arity, ex_ret, ex_pstart|:
                    match declaration:
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                            link_name: sview = extern_link_name_value(decorators, annotation_args)
                            if link_name != "":
                                ln_values.push(link_name)
                                ex_names.push(extern_name)
                                ex_lines.push(extern_line)
                                ex_callable.push(callable)
                                ex_arity.push(arity)
                                ex_ret.push(return_type_name)
                                ex_pstart.push(param_start)
                        Decl.Module(module_name, module_body, module_line):
                            collect_link_name_externs(module_body, annotation_args, ln_values, ex_names, ex_lines, ex_callable, ex_arity, ex_ret, ex_pstart)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_link_name_externs(scoped_body, annotation_args, ln_values, ex_names, ex_lines, ex_callable, ex_arity, ex_ret, ex_pstart)
                        _:
                            pass

    public:
        def check_extern_link_name_conflict(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                ln_values: mutable darray[sview] = []
                ex_names: mutable darray[sview] = []
                ex_lines: mutable darray[u32] = []
                ex_callable: mutable darray[bool] = []
                ex_arity: mutable darray[u32] = []
                ex_ret: mutable darray[sview] = []
                ex_pstart: mutable darray[u32] = []
                collect_link_name_externs(file.top_decls, file.annotation_args, ln_values, ex_names, ex_lines, ex_callable, ex_arity, ex_ret, ex_pstart)
                index: mutable usize = 0
                while index < ln_values.count |index, ln_values, ex_names, ex_lines, ex_callable, ex_arity, ex_ret, ex_pstart, table| -> table:
                    earlier: mutable usize = 0
                    conflict: mutable bool = false
                    while earlier < index |conflict, earlier, index, ln_values, ex_callable, ex_arity, ex_ret, ex_pstart, table|:
                        same_symbol: bool = ln_values[earlier] == ln_values[index]
                        if same_symbol and not conflict and extern_signatures_differ(ex_callable[index], ex_arity[index], ex_ret[index], ex_pstart[index], ex_callable[earlier], ex_arity[earlier], ex_ret[earlier], ex_pstart[earlier], file.extern_params):
                            conflict <- true
                        earlier <- earlier + 1
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternLinkNameConflict, name: ex_names[index], line: ex_lines[index], expected: ln_values[index], actual: "", expected_count: 1}) if conflict
                    index <- index + 1
