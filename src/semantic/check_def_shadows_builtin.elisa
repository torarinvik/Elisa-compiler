# A `def` whose name is a builtin scalar type (f32, i32, u8, …) or an arbitrary-width bit-int
# (u7, i24) is unreachable by call: a call site `name(x)` resolves to the type cast, not to
# this function, so the function silently vanishes. Stage0 warns at the definition site. This
# is a purely syntactic name check on the declared function name — SOUND and decidable.
extend Semantic:
    private:
        def def_shadows_builtin_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FuncShadowsBuiltinType, name: function_name, line: line.line, expected: "", actual: ""}) if SemanticPrimitiveTypeName::is_builtin_scalar_type_name(function_name)
                        Decl.Module(module_name, module_body, module_line):
                            table <- def_shadows_builtin_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- def_shadows_builtin_walk(scoped_body, table)
                        _:
                            pass

        def check_def_shadows_builtin(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- def_shadows_builtin_walk(declarations, table)
