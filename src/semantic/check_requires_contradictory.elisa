# Contradictory `requires` preconditions (stage0 analyzer_contracts). When a function's
# `requires` clauses conjoin to an UNSATISFIABLE constraint over a single integer
# parameter (`requires x > 0` + `requires x < 0`), the function can never be called and
# its body vacuously proves any `ensure`. SOUND decidable subset: collect every atomic
# `VAR <cmp> CONST` (or `CONST <cmp> VAR`) across all requires clauses (splitting `and`
# conjunctions), fold each variable's atoms into an integer interval [lo, hi], and warn
# when some variable's interval is EMPTY. Exact-interval reasoning ⇒ never overfires.
extend Semantic:
    private:
        # Effectively-unbounded interval sentinels (well inside i64 so ±1 never overflows;
        # real precondition constants are tiny).
        def rc_neg_inf() -> i64:
            return 0 - 4000000000000000000

        def rc_pos_inf() -> i64:
            return 4000000000000000000

        def rc_max(a: i64, b: i64) -> i64:
            return a if a > b else b

        def rc_min(a: i64, b: i64) -> i64:
            return a if a < b else b

        # Record one `VAR cmp CONST` atom into the per-variable interval table. `flip`
        # swaps the operator sense when the source was `CONST cmp VAR`.
        def rc_apply_atom(variable: sview, operator: TokenKind, value: i64, names: mutable darray[sview]&, los: mutable darray[i64]&, his: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                slot: mutable int = -1
                probe: mutable usize = 0
                while probe < names.count |probe, slot, variable, names|:
                    slot <- probe.int() if names[probe] == variable and slot < 0
                    probe <- probe + 1
                if slot < 0:
                    names.push(variable)
                    los.push(rc_neg_inf())
                    his.push(rc_pos_inf())
                    slot <- names.count.int() - 1
                index: usize = slot.usize()
                los[index] <- rc_max(los[index], value + 1) if operator == TokenKind.Gt
                los[index] <- rc_max(los[index], value) if operator == TokenKind.GtEq
                his[index] <- rc_min(his[index], value - 1) if operator == TokenKind.Lt
                his[index] <- rc_min(his[index], value) if operator == TokenKind.LtEq
                los[index] <- rc_max(los[index], value) if operator == TokenKind.EqEq
                his[index] <- rc_min(his[index], value) if operator == TokenKind.EqEq

        # The operator with its operands swapped (`k < x` ≡ `x > k`).
        def rc_flip_operator(operator: TokenKind) -> TokenKind:
            return when operator:
                TokenKind.Gt -> TokenKind.Lt
                TokenKind.Lt -> TokenKind.Gt
                TokenKind.GtEq -> TokenKind.LtEq
                TokenKind.LtEq -> TokenKind.GtEq
                _ -> operator

        # Decompose a requires predicate into atoms, folding each into the interval table.
        def rc_collect_predicate(predicate: Ast::Expr, names: mutable darray[sview]&, los: mutable darray[i64]&, his: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, paren_line):
                        rc_collect_predicate(inner, names, los, his)
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.And:
                            rc_collect_predicate(left, names, los, his)
                            rc_collect_predicate(right, names, los, his)
                        else:
                            # `VAR cmp CONST`
                            if left is Expr.Ident(left_name, left_line):
                                right_literal: (found: bool, value: i64) = where_signed_literal(right)
                                rc_apply_atom(left_name, operator, right_literal.value, names, los, his) if right_literal.found
                            # `CONST cmp VAR`
                            if right is Expr.Ident(right_name, right_line):
                                left_literal: (found: bool, value: i64) = where_signed_literal(left)
                                rc_apply_atom(right_name, rc_flip_operator(operator), left_literal.value, names, los, his) if left_literal.found
                    _:
                        pass

        def rc_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            los: mutable darray[i64] = []
                            his: mutable darray[i64] = []
                            for statement in body |names, los, his|:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        rc_collect_predicate(expression, names, los, his) if kind == "requires"
                                    _:
                                        pass
                            contradictory: mutable bool = false
                            check_index: mutable usize = 0
                            while check_index < names.count |check_index, contradictory, los, his|:
                                contradictory <- true if los[check_index] > his[check_index]
                                check_index <- check_index + 1
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContradictoryRequires, name: function_name, line: line.line, expected: "", actual: ""}) if contradictory
                        Decl.Module(module_name, module_body, module_line):
                            table <- rc_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- rc_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_requires_contradictory(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- rc_walk(file.top_decls, table)
