# Named-state protocol values are created only inside the module that owns the
# family. Public operations may return them; external callers cannot forge a
# state by writing a struct literal. This is independent of which operation
# performs a legal graph transition.
extend Semantic:
    private:
        def protocol_constructor_missing_id() -> DeclId:
            DeclId{value: 4294967295}

        def protocol_constructor_family_id(type_expression: Ast::Expr, scope: sview, table: SymbolTable&, visited: mutable darray[u32]&, depth: u32 = 0) -> DeclId:
            can Memory.Allocate, Abort.Panic:
                missing: DeclId = protocol_constructor_missing_id()
                return missing if depth >= 128
                match type_expression:
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _):
                        return protocol_constructor_family_id(base, scope, table, visited, depth + 1)
                    Expr.Unary(_, inner, _) | Expr.Paren(inner, _):
                        return protocol_constructor_family_id(inner, scope, table, visited, depth + 1)
                    Expr.Refinement(base, _, _):
                        return protocol_constructor_family_id(base, scope, table, visited, depth + 1)
                    _:
                        pass
                row: u32 = binding_nominal_declaration(type_expression, scope, table)
                return missing if row == SYMBOL_INDEX_ROW_NONE or row.usize() >= table.symbols.count
                symbol: Symbol = table.symbols[row.usize()]
                if symbol.kind == SymbolKind.Struct:
                    return symbol.id if protocol_family_source_index(table, symbol.id) != SYMBOL_INDEX_ROW_NONE else missing
                return missing if symbol.kind != SymbolKind.Alias or any previous in visited where previous == symbol.id.value
                visited.push(symbol.id.value)
                matches: mutable usize = 0
                result: mutable DeclId = missing
                for alias in table.type_alias_declarations |matches, result, visited|:
                    if alias.declaration_id.value == symbol.id.value:
                        matches <- matches + 1
                        result <- protocol_constructor_family_id(alias.target, alias.module_owner, table, visited, depth + 1)
                return result if matches == 1 else missing

        def check_protocol_constructor_owner_at(type_expression: Ast::Expr, position: Ast::Pos, lookup_scope: sview, construction_scope: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                visited: mutable darray[u32] = []
                family_id: DeclId = protocol_constructor_family_id(type_expression, lookup_scope, table, visited)
                family_index: u32 = protocol_family_source_index(table, family_id)
                return if family_index == SYMBOL_INDEX_ROW_NONE
                family: Ast::StateFamily = table.state_family_declarations[family_index.usize()]
                owns_family: bool = construction_scope == family.module_name or (family.module_name != "" and pma_within_module(construction_scope, family.module_name))
                return if owns_family
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolConstructorUnauthorized, name: family.owner, pos: position, line: position.line, expected: family.module_name, actual: construction_scope})

        def check_protocol_constructor_owner(type_expression: Ast::Expr, position: Ast::Pos, scope: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_protocol_constructor_owner_at(type_expression, position, scope, scope, table)

        def check_protocol_constructor_expression(expression: Ast::Expr, scope: sview, table: lmut SymbolTable, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth >= 512
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        table <- check_protocol_constructor_expression(callee, scope, table, depth + 1)
                        for argument in arguments |table, depth|:
                            table <- check_protocol_constructor_expression(argument, scope, table, depth + 1)
                    Expr.StaticEffectCall(effect_type, _, _, arguments, _, _):
                        table <- check_protocol_constructor_expression(effect_type, scope, table, depth + 1)
                        for argument in arguments |table, depth|:
                            table <- check_protocol_constructor_expression(argument, scope, table, depth + 1)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        table <- check_protocol_constructor_expression(object, scope, table, depth + 1)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        table <- check_protocol_constructor_expression(object, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(index, scope, table, depth + 1)
                    Expr.IndexN(object, arguments, _):
                        table <- check_protocol_constructor_expression(object, scope, table, depth + 1)
                        for argument in arguments |table, depth|:
                            table <- check_protocol_constructor_expression(argument, scope, table, depth + 1)
                    Expr.Slice(object, low, high, _):
                        table <- check_protocol_constructor_expression(object, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(low, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(high, scope, table, depth + 1)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- check_protocol_constructor_expression(operand, scope, table, depth + 1)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table, depth|:
                            table <- check_protocol_constructor_expression(element, scope, table, depth + 1)
                    Expr.DictLit(entries, _):
                        for entry in entries |table, depth|:
                            table <- check_protocol_constructor_expression(entry.key, scope, table, depth + 1)
                            table <- check_protocol_constructor_expression(entry.value, scope, table, depth + 1)
                    Expr.Construct(type_expression, fields, position):
                        table <- check_protocol_constructor_owner(type_expression, position, scope, table)
                        for field in fields |table, depth|:
                            table <- check_protocol_constructor_expression(field.value, scope, table, depth + 1)
                    Expr.RecordUpdate(base, fields, _):
                        table <- check_protocol_constructor_expression(base, scope, table, depth + 1)
                        for field in fields |table, depth|:
                            table <- check_protocol_constructor_expression(field.value, scope, table, depth + 1)
                    Expr.If(condition, then_value, else_value, _):
                        table <- check_protocol_constructor_expression(condition, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(then_value, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(else_value, scope, table, depth + 1)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- check_protocol_constructor_expression(scrutinee, scope, table, depth + 1)
                        for arm in arms |table, depth|:
                            table <- check_protocol_constructor_expression(arm.guard, scope, table, depth + 1)
                            table <- check_protocol_constructor_statements(arm.body, scope, table, depth + 1)
                    Expr.Comprehension(_, iterable, condition, body, _):
                        table <- check_protocol_constructor_expression(iterable, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(condition, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(body, scope, table, depth + 1)
                    Expr.Refinement(base, predicate, _):
                        table <- check_protocol_constructor_expression(base, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(predicate, scope, table, depth + 1)
                    Expr.GetElse(guarded, recovery, _):
                        table <- check_protocol_constructor_expression(guarded, scope, table, depth + 1)
                        table <- check_protocol_constructor_statements(recovery, scope, table, depth + 1)
                    Expr.Lambda(_, body, _):
                        table <- check_protocol_constructor_statements(body, scope, table, depth + 1)
                    Expr.Block(statements, value, _, _):
                        table <- check_protocol_constructor_statements(statements, scope, table, depth + 1)
                        table <- check_protocol_constructor_expression(value, scope, table, depth + 1)
                    _:
                        pass

        def check_protocol_constructor_statements(statements: darray[Ast::Stmt], scope: sview, table: lmut SymbolTable, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth >= 512
                for statement in statements |table, depth|:
                    match statement:
                        Stmt.Expr(expression, _):
                            table <- check_protocol_constructor_expression(expression, scope, table, depth + 1)
                        Stmt.Block(_, _, _, body, _):
                            table <- check_protocol_constructor_statements(body, scope, table, depth + 1)
                        Stmt.VarDecl(_, _, value, _):
                            table <- check_protocol_constructor_expression(value, scope, table, depth + 1)
                        Stmt.Assign(target, _, value, _):
                            table <- check_protocol_constructor_expression(target, scope, table, depth + 1)
                            table <- check_protocol_constructor_expression(value, scope, table, depth + 1)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- check_protocol_constructor_expression(condition, scope, table, depth + 1)
                            table <- check_protocol_constructor_statements(then_body, scope, table, depth + 1)
                            table <- check_protocol_constructor_statements(else_body, scope, table, depth + 1)
                        Stmt.While(condition, body, _):
                            table <- check_protocol_constructor_expression(condition, scope, table, depth + 1)
                            table <- check_protocol_constructor_statements(body, scope, table, depth + 1)
                        Stmt.For(_, _, iterable, body, _):
                            table <- check_protocol_constructor_expression(iterable, scope, table, depth + 1)
                            table <- check_protocol_constructor_statements(body, scope, table, depth + 1)
                        Stmt.Return(value, _):
                            if value is returned:
                                table <- check_protocol_constructor_expression(returned, scope, table, depth + 1)
                        Stmt.Match(scrutinee, arms, _):
                            table <- check_protocol_constructor_expression(scrutinee, scope, table, depth + 1)
                            for arm in arms |table, depth|:
                                table <- check_protocol_constructor_expression(arm.guard, scope, table, depth + 1)
                                table <- check_protocol_constructor_statements(arm.body, scope, table, depth + 1)
                        Stmt.Contract(_, expression, _):
                            table <- check_protocol_constructor_expression(expression, scope, table, depth + 1)
                        _:
                            pass

        def check_protocol_constructor_declarations(declarations: darray[Ast::Decl], scope: sview, table: lmut SymbolTable, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth >= 512
                for declaration in declarations |table, depth|:
                    match declaration:
                        Decl.Func(_, _, _, body, _, _, _):
                            table <- check_protocol_constructor_statements(body, scope, table)
                        Decl.Module(name, body, _):
                            table <- check_protocol_constructor_declarations(body, name, table, depth + 1)
                        Decl.Scoped(body, _):
                            table <- check_protocol_constructor_declarations(body, scope, table, depth + 1)
                        Decl.Const(_, type_expression, value, _, _):
                            table <- check_protocol_constructor_expression(type_expression, scope, table)
                            table <- check_protocol_constructor_expression(value, scope, table)
                        Decl.Struct(_, members, _, _, _, invariants, _):
                            for member in members |table|:
                                table <- check_protocol_constructor_expression(member.default_value, scope, table) if member.has_default
                            for invariant in invariants |table|:
                                table <- check_protocol_constructor_expression(invariant, scope, table)
                        Decl.Enum(_, variants, _, storage_type, _):
                            table <- check_protocol_constructor_expression(storage_type, scope, table)
                            for variant in variants |table|:
                                table <- check_protocol_constructor_expression(variant.value_expr, scope, table)
                        Decl.Law(_, predicate, _):
                            table <- check_protocol_constructor_expression(predicate, scope, table)
                        _:
                            pass

    public:
        # `zeroed` creates an aggregate without an Expr.Construct node, so typed
        # value-position checks need the same module-authority gate as literals.
        def check_protocol_zeroed_state_construction(type_expression: Ast::Expr, position: Ast::Pos, lookup_scope: sview, construction_scope: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_protocol_constructor_owner_at(type_expression, position, lookup_scope, construction_scope, table)

        def check_protocol_state_construction(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_protocol_constructor_declarations(file.top_decls, "", table)
