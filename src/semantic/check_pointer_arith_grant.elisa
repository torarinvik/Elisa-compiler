# Pointer arithmetic needs its own lexical capability in strict mode. The general strict walk
# diagnoses it when no grant is present; this pass diagnoses it under an unrelated grant. The
# function's effect row remains the caller's obligation and never authorizes the function body.
extend Semantic:
    private:
        def pag_is_ref_param(name: sview, ref_params: darray[sview]&) -> bool:
            can Abort.Panic:
                return name != "" and (any p in ref_params where p == name)

        def pag_is_int_operand(expression: Ast::Expr, int_params: darray[sview]&) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.IntLit(value, _): true
                    Expr.Ident(name, line): any p in int_params where p == name
                    _: false

        def pag_pointer_arith_binary(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, ref_params: darray[sview]&, int_params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                left_ref: bool = pag_is_ref_param(ident_name_of(left), ref_params)
                right_ref: bool = pag_is_ref_param(ident_name_of(right), ref_params)
                is_add: bool = operator == TokenKind.Plus
                return ((is_add or operator == TokenKind.Minus) and left_ref and pag_is_int_operand(right, int_params)) or (is_add and right_ref and pag_is_int_operand(left, int_params))

        # Whether a grant block's clause covers pointer arithmetic: a blanket `Unsafe`, or an
        # explicit `Unsafe.PointerArithmetic` / `PointerArithmetic`.
        def pag_clause_covers(clause: darray[sview]&) -> bool:
            can Abort.Panic:
                return any entry in clause where entry == "Unsafe" or entry == "Unsafe.PointerArithmetic" or entry == "PointerArithmetic"

        def pag_expr(expression: Ast::Expr, ref_params: darray[sview]&, int_params: darray[sview]&, in_grant: bool, covers: bool, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PointerArithmeticUngranted, name: "", line: line, expected: "", actual: ""}) if in_grant and not covers and pag_pointer_arith_binary(left, operator, right, ref_params, int_params)
                        table <- pag_expr(left, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(right, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.RegionNew(operand, _, unary_line) | Expr.Paren(operand, unary_line):
                        table <- pag_expr(operand, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- pag_expr(callee, ref_params, int_params, in_grant, covers, line, table)
                        for argument in arguments |table| -> table:
                            table <- pag_expr(argument, ref_params, int_params, in_grant, covers, line, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- pag_expr(argument, ref_params, int_params, in_grant, covers, line, table)
                        for candidate in candidates |table| -> table:
                            table <- pag_expr(candidate.effect_type, ref_params, int_params, in_grant, covers, line, table)
                            for capture in candidate.captures |table| -> table:
                                table <- pag_expr(capture, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Field(object, field, field_line):
                        table <- pag_expr(object, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Scope(base, name, scope_line):
                        if base is not Expr.Ident(_, _):
                            table <- pag_expr(base, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Index(object, index, index_line):
                        table <- pag_expr(object, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(index, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- pag_expr(object, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(low, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(high, ref_params, int_params, in_grant, covers, line, table)
                    Expr.IndexN(object, arguments, index_line):
                        table <- pag_expr(object, ref_params, int_params, in_grant, covers, line, table)
                        for argument in arguments |table| -> table:
                            table <- pag_expr(argument, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- pag_expr(element, ref_params, int_params, in_grant, covers, line, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- pag_expr(entry.key, ref_params, int_params, in_grant, covers, line, table)
                            table <- pag_expr(entry.value, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        for field in fields |table| -> table:
                            table <- pag_expr(field.value, ref_params, int_params, in_grant, covers, line, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        table <- pag_expr(base, ref_params, int_params, in_grant, covers, line, table)
                        for field in fields |table| -> table:
                            table <- pag_expr(field.value, ref_params, int_params, in_grant, covers, line, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- pag_expr(condition, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(then_value, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(else_value, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- pag_expr(scrutinee, ref_params, int_params, in_grant, covers, line, table)
                        for arm in arms |table|:
                            table <- pag_expr(arm.guard, ref_params, int_params, in_grant, covers, line, table)
                            table <- pag_walk(arm.body, ref_params, int_params, in_grant, covers, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- pag_expr(iterable, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(condition, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(body, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- pag_expr(base, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(predicate, ref_params, int_params, in_grant, covers, line, table)
                    Expr.GetElse(guarded, recovery, getelse_line):
                        table <- pag_expr(guarded, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_walk(recovery, ref_params, int_params, in_grant, covers, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- pag_walk(statements, ref_params, int_params, in_grant, covers, table)
                        table <- pag_expr(value, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Lambda(parameters, body, lambda_line):
                        table <- pag_walk(body, ref_params, int_params, false, false, table)
                    _:
                        pass

        def pag_walk(statements: darray[Ast::Stmt], ref_params: darray[sview]&, int_params: darray[sview]&, in_grant: bool, covers: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- pag_expr(expression, ref_params, int_params, in_grant, covers, line.line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pag_expr(value, ref_params, int_params, in_grant, covers, line.line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- pag_expr(target, ref_params, int_params, in_grant, covers, line.line, table)
                            table <- pag_expr(value, ref_params, int_params, in_grant, covers, line.line, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- pag_expr(returned, ref_params, int_params, in_grant, covers, line.line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pag_expr(condition, ref_params, int_params, in_grant, covers, line.line, table)
                            table <- pag_walk(then_body, ref_params, int_params, in_grant, covers, table)
                            table <- pag_walk(else_body, ref_params, int_params, in_grant, covers, table)
                        Stmt.While(condition, body, line):
                            table <- pag_expr(condition, ref_params, int_params, in_grant, covers, line.line, table)
                            table <- pag_walk(body, ref_params, int_params, in_grant, covers, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- pag_expr(iterable, ref_params, int_params, in_grant, covers, line.line, table)
                            table <- pag_walk(body, ref_params, int_params, in_grant, covers, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- pag_expr(scrutinee, ref_params, int_params, in_grant, covers, line.line, table)
                            for arm in arms |table, line, ref_params, int_params, in_grant, covers|:
                                table <- pag_expr(arm.guard, ref_params, int_params, in_grant, covers, line.line, table)
                                table <- pag_walk(arm.body, ref_params, int_params, in_grant, covers, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            is_grant: bool = kind == "can" or kind == "trusted"
                            grant_here: bool = in_grant or is_grant
                            covers_here: bool = covers or (is_grant and pag_clause_covers(clause))
                            table <- pag_walk(body, ref_params, int_params, grant_here, covers_here, table)
                        Stmt.Contract(kind, expression, line):
                            table <- pag_expr(expression, ref_params, int_params, in_grant, covers, line.line, table)
                        _:
                            pass

        def check_pointer_arith_grant_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            ref_params: mutable darray[sview] = []
                            int_params: mutable darray[sview] = []
                            for parameter in parameters |ref_params, int_params|:
                                ref_params.push(parameter.name) if type_marker_present_here(parameter.type_expression, TokenKind.Ampersand)
                                int_params.push(parameter.name) if is_integer_type_name(bare_type_name(parameter.type_expression))
                            # Function effects are obligations for callers; the function still
                            # needs a local grant before performing this operation.
                            table <- pag_walk(body, ref_params, int_params, false, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_pointer_arith_grant_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_pointer_arith_grant_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_pointer_arith_grant(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_pointer_arith_grant_decls(declarations, table)
