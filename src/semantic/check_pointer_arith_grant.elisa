# Pointer arithmetic has one lexical authority check in strict mode. This walk diagnoses
# both missing grants and unrelated grants, using a conservative scoped type environment so
# local reference aliases and compound integer offsets cannot bypass the capability boundary.
extend Semantic:
    private:
        # Latest binding wins, including kind 0, which deliberately masks an outer typed
        # binding when a nested scope shadows it with a value of unknown type.
        def pag_binding_kind(name: sview, binding_names: darray[sview]&, binding_kinds: darray[u8]&) -> u8:
            can Abort.Panic:
                while binding_index > 0 |binding_index: usize = binding_names.count|:
                    binding_index <- binding_index - 1
                    binding_kinds[binding_index] return if binding_names[binding_index] == name
                return 0

        def pag_bind(name: sview, kind: u8, binding_names: mutable darray[sview]&, binding_kinds: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                binding_names.push(name)
                binding_kinds.push(kind)

        def pag_structural_type_id(expression: Ast::Expr, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return pag_structural_type_id(inner, table)
                    _:
                        empty_names: darray[sview] = []
                        empty_types: darray[sview] = []
                        return structural_type_id_of(expression, empty_names, empty_types, table)

        # The type of one value produced by a structurally known iterable. Range binders
        # are handled separately because range expressions are not container type rows.
        def pag_iteration_item_type_id(iterable: Ast::Expr, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                iterable_type_id: u32 = pag_structural_type_id(iterable, table)
                return interned_elem(iterable_type_id, 0, table) if interned_kind(iterable_type_id, table) == SemTypeKind.Container
                return 0

        def pag_iteration_binding_kind(iterable: Ast::Expr, item_type_id: u32, table: SymbolTable&) -> u8:
            can Abort.Panic:
                match iterable:
                    Expr.Binary(_, operator, _, _):
                        return 2 if operator in {TokenKind.Range, TokenKind.RangeLt, TokenKind.RangeGt, TokenKind.RangeLe}
                    _:
                        pass
                item_kind: SemTypeKind = interned_kind(item_type_id, table)
                return 1 if item_kind == SemTypeKind.Ref
                return 2 if item_kind == SemTypeKind.Int
                return 0

        # A multi-name for binder destructures a dict's key/value pair or a tuple-valued
        # element. Unknown and mismatched shapes stay untyped rather than borrowing one
        # component's type for every binding.
        def pag_iteration_binding_type_id(iterable: Ast::Expr, item_type_id: u32, binding_count: usize, binding_index: usize, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                if binding_count == 1:
                    return item_type_id
                iterable_type_id: u32 = pag_structural_type_id(iterable, table)
                if interned_kind(iterable_type_id, table) == SemTypeKind.Container and interned_name(iterable_type_id, table) == "dict" and interned_elem_count(iterable_type_id, table).usize() == binding_count:
                    return interned_elem(iterable_type_id, binding_index.u32(), table)
                if interned_kind(item_type_id, table) == SemTypeKind.Tuple and interned_elem_count(item_type_id, table).usize() == binding_count:
                    return interned_elem(item_type_id, binding_index.u32(), table)
                return 0

        # The pattern path's final component is the variant name. Keeping this as a
        # source-view slice avoids allocating a temporary spelling while matching
        # qualified forms such as `module.Packet.Offset` and `.Offset`.
        def pag_pattern_terminal_name(path: sview) -> sview:
            can Abort.Panic:
                path_length: usize = sview_len(path)
                component_start: mutable usize = 0
                for cursor in 0..<path_length |component_start, path|:
                    component_start <- cursor + 1 if sview_at(path, cursor) == 46
                return path[component_start:path_length]

        # Look up a payload field's full structural type. Rows are stored in source
        # declaration order and include function-local generated payload enums too.
        # Conflicting duplicate owner/variant declarations conservatively yield Unknown.
        def pag_enum_payload_type_id(owner: sview, variant_name: sview, field_index: usize, table: SymbolTable&) -> u32:
            can Abort.Panic:
                found: mutable u32 = 0
                seen: mutable bool = false
                ambiguous: mutable bool = false
                for row in 0..<table.enum_payload_owner.count |found, seen, ambiguous, owner, variant_name, field_index, table|:
                    if table.enum_payload_owner[row] == owner and table.enum_payload_variant[row] == variant_name and row < table.enum_payload_position.count and table.enum_payload_position[row].usize() == field_index:
                        candidate_type_id: u32 = table.enum_payload_type_id[row] if row < table.enum_payload_type_id.count else 0
                        ambiguous <- true if seen and found != candidate_type_id
                        found <- candidate_type_id if not seen
                        seen <- true
                return 0 if ambiguous or not seen
                return found

        # Struct field rows already carry full structural types. Duplicate bare type
        # names across modules are resolved only when every matching row agrees; a
        # conflicting result stays Unknown instead of borrowing another module's field.
        def pag_struct_field_type_id(owner: sview, field_name: sview, table: SymbolTable&) -> u32:
            can Abort.Panic:
                found: mutable u32 = 0
                seen: mutable bool = false
                ambiguous: mutable bool = false
                for row in 0..<table.struct_field_owner.count |found, seen, ambiguous, owner, field_name, table|:
                    if table.struct_field_owner[row] == owner and table.struct_field_name[row] == field_name:
                        candidate_type_id: u32 = table.struct_field_type_id[row] if row < table.struct_field_type_id.count else 0
                        ambiguous <- true if seen and found != candidate_type_id
                        found <- candidate_type_id if not seen
                        seen <- true
                return 0 if ambiguous or not seen
                return found

        # Recover the type of `target_name` when a match pattern gives the value a
        # structurally known shape. Unknown pattern forms, opaque enum payloads, and
        # ambiguous declarations stay Unknown; the visitor never guesses a reference.
        def pag_pattern_binding_type_id(pattern: Ast::Pattern, subject_type_id: u32, target_name: sview, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(binding_name):
                        return subject_type_id if binding_name == target_name
                    Pattern.TypeBind(type_name, binder):
                        return subject_type_id if binder == target_name
                    Pattern.As(as_name, inner):
                        return subject_type_id if as_name == target_name
                        if inner.count == 1:
                            return pag_pattern_binding_type_id(inner[0], subject_type_id, target_name, table)
                    Pattern.Tuple(elements):
                        return 0 if interned_kind(subject_type_id, table) != SemTypeKind.Tuple or interned_elem_count(subject_type_id, table).usize() != elements.count
                        for element_index in 0..<elements.count |table, subject_type_id, elements, target_name|:
                            element_type_id: u32 = interned_elem(subject_type_id, element_index.u32(), table)
                            element_binding_type_id: u32 = pag_pattern_binding_type_id(elements[element_index], element_type_id, target_name, table)
                            return element_binding_type_id if element_binding_type_id != 0
                        return 0
                    Pattern.Variant(path, fields):
                        return 0 if interned_kind(subject_type_id, table) != SemTypeKind.Named
                        enum_owner: sview = interned_name(subject_type_id, table)
                        variant_name: sview = pag_pattern_terminal_name(path)
                        for field_index in 0..<fields.count |table, fields, enum_owner, variant_name, target_name|:
                            payload_type_id: u32 = pag_enum_payload_type_id(enum_owner, variant_name, field_index, table)
                            field_binding_type_id: u32 = pag_pattern_binding_type_id(fields[field_index], payload_type_id, target_name, table)
                            return field_binding_type_id if field_binding_type_id != 0
                        return 0
                    Pattern.Struct(path, fields):
                        return 0 if interned_kind(subject_type_id, table) != SemTypeKind.Named
                        struct_owner: sview = interned_name(subject_type_id, table)
                        for field_pattern in fields |table, struct_owner, target_name|:
                            match field_pattern:
                                Pattern.Binding(binding_name):
                                    if binding_name == target_name:
                                        return pag_struct_field_type_id(struct_owner, binding_name, table)
                                Pattern.Field(selector, inner):
                                    if inner.count == 1:
                                        field_type_id: u32 = pag_struct_field_type_id(struct_owner, selector, table)
                                        field_binding_type_id: u32 = pag_pattern_binding_type_id(inner[0], field_type_id, target_name, table)
                                        return field_binding_type_id if field_binding_type_id != 0
                                _:
                                    pass
                        return 0
                    Pattern.Field(selector, inner):
                        if inner.count == 1:
                            return pag_pattern_binding_type_id(inner[0], subject_type_id, target_name, table)
                    Pattern.Or(options):
                        # Every alternative must establish the same non-unknown type;
                        # otherwise the binding is intentionally left unclassified.
                        return 0 if options.count == 0
                        common_type_id: mutable u32 = 0
                        for option in options |common_type_id, subject_type_id, target_name, table|:
                            option_type_id: u32 = pag_pattern_binding_type_id(option, subject_type_id, target_name, table)
                            return 0 if option_type_id == 0
                            return 0 if common_type_id != 0 and common_type_id != option_type_id
                            common_type_id <- option_type_id
                        return common_type_id
                    _:
                        pass
                return 0

        # Install every arm binding in both channels used by this pass. The structural
        # TypeId detects refs produced by payloads/tuples; the compact kind also lets
        # identifier-only fallback recognize integer binders.
        def pag_bind_match_pattern(pattern: Ast::Pattern, subject_type_id: u32, binding_names: mutable darray[sview]&, binding_kinds: mutable darray[u8]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                pattern_names: mutable darray[sview] = []
                collect_pattern_binding_names(pattern, pattern_names)
                for pattern_name in pattern_names |binding_names, binding_kinds, subject_type_id, pattern, table|:
                    pattern_type_id: u32 = pag_pattern_binding_type_id(pattern, subject_type_id, pattern_name, table)
                    pattern_kind: u8 = 1 if interned_kind(pattern_type_id, table) == SemTypeKind.Ref else (2 if interned_kind(pattern_type_id, table) == SemTypeKind.Int else 0)
                    pag_bind(pattern_name, pattern_kind, binding_names, binding_kinds)
                    note_local_type_id_direct(pattern_name, pattern_type_id, table)

        def pag_is_ref_operand(expression: Ast::Expr, binding_names: darray[sview]&, binding_kinds: darray[u8]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                expression_type_id: u32 = pag_structural_type_id(expression, table)
                return true if interned_kind(expression_type_id, table) == SemTypeKind.Ref
                match expression:
                    Expr.Ident(name, _):
                        return pag_binding_kind(name, binding_names, binding_kinds) == 1
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return pag_is_ref_operand(inner, binding_names, binding_kinds, table)
                    Expr.Unary(operator, operand, _):
                        # Address-of creates a reference. Numeric unary operators do not
                        # preserve pointer identity, so do not classify them as a ref.
                        return operator == TokenKind.Ampersand
                    Expr.Call(callee, _, _, _):
                        match callee:
                            Expr.Ident(name, _):
                                return interned_kind(function_return_type_id(table, name), table) == SemTypeKind.Ref
                            _:
                                return false
                    _:
                        return false

        def pag_is_integer_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.LShift, TokenKind.RShift, TokenKind.Pipe, TokenKind.Caret, TokenKind.Ampersand}

        def pag_is_int_operand(expression: Ast::Expr, binding_names: darray[sview]&, binding_kinds: darray[u8]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                expression_type_id: u32 = pag_structural_type_id(expression, table)
                return true if interned_kind(expression_type_id, table) == SemTypeKind.Int
                match expression:
                    Expr.IntLit(_, _):
                        return true
                    Expr.Ident(name, _):
                        return pag_binding_kind(name, binding_names, binding_kinds) == 2 or interned_kind(global_type_id_of(name, table), table) == SemTypeKind.Int
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return pag_is_int_operand(inner, binding_names, binding_kinds, table)
                    Expr.Unary(operator, operand, _):
                        return (operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Tilde) and pag_is_int_operand(operand, binding_names, binding_kinds, table)
                    Expr.Binary(left, operator, right, _):
                        return pag_is_integer_operator(operator) and pag_is_int_operand(left, binding_names, binding_kinds, table) and pag_is_int_operand(right, binding_names, binding_kinds, table)
                    Expr.Call(callee, _, _, _):
                        match callee:
                            Expr.Ident(name, _):
                                return interned_kind(function_return_type_id(table, name), table) == SemTypeKind.Int
                            _:
                                return false
                    _:
                        return false

        def pag_pointer_arith_binary(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, binding_names: darray[sview]&, binding_kinds: darray[u8]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                left_ref: bool = pag_is_ref_operand(left, binding_names, binding_kinds, table)
                right_ref: bool = pag_is_ref_operand(right, binding_names, binding_kinds, table)
                is_add: bool = operator == TokenKind.Plus
                return ((is_add or operator == TokenKind.Minus) and left_ref and pag_is_int_operand(right, binding_names, binding_kinds, table)) or (is_add and right_ref and pag_is_int_operand(left, binding_names, binding_kinds, table))

        # Whether a grant block's clause covers pointer arithmetic: a blanket `Unsafe`, or an
        # explicit `Unsafe.PointerArithmetic` / `PointerArithmetic`.
        def pag_clause_covers(clause: darray[sview]&) -> bool:
            can Abort.Panic:
                return any entry in clause where entry == "Unsafe" or entry == "Unsafe.PointerArithmetic" or entry == "PointerArithmetic"

        def pag_expr(expression: Ast::Expr, binding_names: darray[sview]&, binding_kinds: darray[u8]&, in_grant: bool, covers: bool, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_line):
                        pointer_arithmetic: bool = pag_pointer_arith_binary(left, operator, right, binding_names, binding_kinds, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PointerArithmeticUngranted, name: "", line: line, expected: "", actual: ""}) if pointer_arithmetic and (not in_grant or not covers)
                        table <- pag_expr(left, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_expr(right, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.RegionNew(operand, _, unary_line) | Expr.Paren(operand, unary_line):
                        table <- pag_expr(operand, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- pag_expr(callee, binding_names, binding_kinds, in_grant, covers, line, table)
                        for argument in arguments |table| -> table:
                            table <- pag_expr(argument, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- pag_expr(argument, binding_names, binding_kinds, in_grant, covers, line, table)
                        for candidate in candidates |table|:
                            table <- pag_expr(candidate.effect_type, binding_names, binding_kinds, in_grant, covers, line, table)
                            for capture in candidate.captures |table| -> table:
                                table <- pag_expr(capture, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Field(object, field, field_line):
                        table <- pag_expr(object, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Scope(base, name, scope_line):
                        if base is not Expr.Ident(_, _):
                            table <- pag_expr(base, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Index(object, index, index_line):
                        table <- pag_expr(object, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_expr(index, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- pag_expr(object, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_expr(low, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_expr(high, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.IndexN(object, arguments, index_line):
                        table <- pag_expr(object, binding_names, binding_kinds, in_grant, covers, line, table)
                        for argument in arguments |table| -> table:
                            table <- pag_expr(argument, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- pag_expr(element, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- pag_expr(entry.key, binding_names, binding_kinds, in_grant, covers, line, table)
                            table <- pag_expr(entry.value, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        for field in fields |table| -> table:
                            table <- pag_expr(field.value, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        table <- pag_expr(base, binding_names, binding_kinds, in_grant, covers, line, table)
                        for field in fields |table| -> table:
                            table <- pag_expr(field.value, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- pag_expr(condition, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_expr(then_value, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_expr(else_value, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        match_subject_type_id: u32 = pag_structural_type_id(scrutinee, table)
                        table <- pag_expr(scrutinee, binding_names, binding_kinds, in_grant, covers, line, table)
                        for arm in arms |table|:
                            arm_type_mark: usize = table.local_type_names.count
                            arm_names: mutable darray[sview] = [bound_name for bound_name in binding_names]
                            arm_kinds: mutable darray[u8] = [bound_kind for bound_kind in binding_kinds]
                            table <- pag_bind_match_pattern(arm.pattern, match_subject_type_id, arm_names, arm_kinds, table)
                            table <- pag_expr(arm.guard, arm_names, arm_kinds, in_grant, covers, line, table)
                            table <- pag_walk(arm.body, arm_names, arm_kinds, in_grant, covers, Ast::Expr.Absent, line, table)
                            table.local_type_names <- table.local_type_names.truncate(arm_type_mark) if table.local_type_names.count > arm_type_mark
                            table.local_type_ids <- table.local_type_ids.truncate(arm_type_mark) if table.local_type_ids.count > arm_type_mark
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- pag_expr(iterable, binding_names, binding_kinds, in_grant, covers, line, table)
                        comp_names: mutable darray[sview] = [bound_name for bound_name in binding_names]
                        comp_kinds: mutable darray[u8] = [bound_kind for bound_kind in binding_kinds]
                        comp_type_mark: usize = table.local_type_names.count
                        item_type_id: u32 = pag_iteration_item_type_id(iterable, table)
                        item_kind: u8 = pag_iteration_binding_kind(iterable, item_type_id, table)
                        pag_bind(variable, item_kind, comp_names, comp_kinds)
                        note_local_type_id_direct(variable, item_type_id, table)
                        table <- pag_expr(condition, comp_names, comp_kinds, in_grant, covers, line, table)
                        table <- pag_expr(body, comp_names, comp_kinds, in_grant, covers, line, table)
                        table.local_type_names <- table.local_type_names.truncate(comp_type_mark) if table.local_type_names.count > comp_type_mark
                        table.local_type_ids <- table.local_type_ids.truncate(comp_type_mark) if table.local_type_ids.count > comp_type_mark
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- pag_expr(base, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_expr(predicate, binding_names, binding_kinds, in_grant, covers, line, table)
                    Expr.GetElse(guarded, recovery, getelse_line):
                        table <- pag_expr(guarded, binding_names, binding_kinds, in_grant, covers, line, table)
                        table <- pag_walk(recovery, binding_names, binding_kinds, in_grant, covers, Ast::Expr.Absent, line, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- pag_walk(statements, binding_names, binding_kinds, in_grant, covers, value, line, table)
                    Expr.Lambda(parameters, body, lambda_line):
                        lambda_names: mutable darray[sview] = [bound_name for bound_name in binding_names]
                        lambda_kinds: mutable darray[u8] = [bound_kind for bound_kind in binding_kinds]
                        lambda_type_mark: usize = table.local_type_names.count
                        for parameter_name in parameters |lambda_names, lambda_kinds, table|:
                            pag_bind(parameter_name, 0, lambda_names, lambda_kinds)
                            note_local_type_id_direct(parameter_name, 0, table)
                        table <- pag_walk(body, lambda_names, lambda_kinds, false, false, Ast::Expr.Absent, line, table)
                        table.local_type_names <- table.local_type_names.truncate(lambda_type_mark) if table.local_type_names.count > lambda_type_mark
                        table.local_type_ids <- table.local_type_ids.truncate(lambda_type_mark) if table.local_type_ids.count > lambda_type_mark
                    _:
                        pass

        def pag_walk(statements: darray[Ast::Stmt], inherited_names: darray[sview]&, inherited_kinds: darray[u8]&, in_grant: bool, covers: bool, value_expression: Ast::Expr, value_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Each block gets a private environment. Sequential declarations update this
                # copy, while branches, loops, grants, and match arms cannot leak bindings.
                binding_names: mutable darray[sview] = [bound_name for bound_name in inherited_names]
                binding_kinds: mutable darray[u8] = [bound_kind for bound_kind in inherited_kinds]
                type_scope_mark: usize = table.local_type_names.count
                for statement in statements |table, binding_names, binding_kinds| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- pag_expr(expression, binding_names, binding_kinds, in_grant, covers, line.line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pag_expr(value, binding_names, binding_kinds, in_grant, covers, line.line, table)
                            binding_kind: mutable u8 = 0
                            binding_kind <- 1 if type_marker_present_here(type_expression, TokenKind.Ampersand)
                            binding_kind <- 2 if binding_kind == 0 and is_integer_type_name(bare_type_name(type_expression))
                            binding_kind <- 1 if binding_kind == 0 and pag_is_ref_operand(value, binding_names, binding_kinds, table)
                            binding_kind <- 2 if binding_kind == 0 and pag_is_int_operand(value, binding_names, binding_kinds, table)
                            pag_bind(name, binding_kind, binding_names, binding_kinds)
                            if type_expression is not Ast::Expr.Absent:
                                note_local_type_id(name, type_expression, table)
                            else:
                                note_local_type_id_direct(name, pag_structural_type_id(value, table), table)
                        Stmt.Assign(target, operator, value, line):
                            table <- pag_expr(target, binding_names, binding_kinds, in_grant, covers, line.line, table)
                            table <- pag_expr(value, binding_names, binding_kinds, in_grant, covers, line.line, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- pag_expr(returned, binding_names, binding_kinds, in_grant, covers, line.line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pag_expr(condition, binding_names, binding_kinds, in_grant, covers, line.line, table)
                            table <- pag_walk(then_body, binding_names, binding_kinds, in_grant, covers, Ast::Expr.Absent, line.line, table)
                            table <- pag_walk(else_body, binding_names, binding_kinds, in_grant, covers, Ast::Expr.Absent, line.line, table)
                        Stmt.While(condition, body, line):
                            table <- pag_expr(condition, binding_names, binding_kinds, in_grant, covers, line.line, table)
                            table <- pag_walk(body, binding_names, binding_kinds, in_grant, covers, Ast::Expr.Absent, line.line, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- pag_expr(iterable, binding_names, binding_kinds, in_grant, covers, line.line, table)
                            loop_names: mutable darray[sview] = [bound_name for bound_name in binding_names]
                            loop_kinds: mutable darray[u8] = [bound_kind for bound_kind in binding_kinds]
                            loop_type_mark: usize = table.local_type_names.count
                            item_type_id: u32 = pag_iteration_item_type_id(iterable, table)
                            variable_index: mutable usize = 0
                            for variable in variables |loop_names, loop_kinds, table, variable_index|:
                                variable_type_id: u32 = pag_iteration_binding_type_id(iterable, item_type_id, variables.count, variable_index, table)
                                variable_kind: u8 = pag_iteration_binding_kind(iterable, variable_type_id, table)
                                pag_bind(variable, variable_kind, loop_names, loop_kinds)
                                note_local_type_id_direct(variable, variable_type_id, table)
                                variable_index <- variable_index + 1
                            table <- pag_walk(body, loop_names, loop_kinds, in_grant, covers, Ast::Expr.Absent, line.line, table)
                            table.local_type_names <- table.local_type_names.truncate(loop_type_mark) if table.local_type_names.count > loop_type_mark
                            table.local_type_ids <- table.local_type_ids.truncate(loop_type_mark) if table.local_type_ids.count > loop_type_mark
                        Stmt.Match(scrutinee, arms, line):
                            match_subject_type_id: u32 = pag_structural_type_id(scrutinee, table)
                            table <- pag_expr(scrutinee, binding_names, binding_kinds, in_grant, covers, line.line, table)
                            for arm in arms |table, line, binding_names, binding_kinds, in_grant, covers|:
                                arm_type_mark: usize = table.local_type_names.count
                                arm_names: mutable darray[sview] = [bound_name for bound_name in binding_names]
                                arm_kinds: mutable darray[u8] = [bound_kind for bound_kind in binding_kinds]
                                table <- pag_bind_match_pattern(arm.pattern, match_subject_type_id, arm_names, arm_kinds, table)
                                table <- pag_expr(arm.guard, arm_names, arm_kinds, in_grant, covers, line.line, table)
                                table <- pag_walk(arm.body, arm_names, arm_kinds, in_grant, covers, Ast::Expr.Absent, line.line, table)
                                table.local_type_names <- table.local_type_names.truncate(arm_type_mark) if table.local_type_names.count > arm_type_mark
                                table.local_type_ids <- table.local_type_ids.truncate(arm_type_mark) if table.local_type_ids.count > arm_type_mark
                        Stmt.Block(kind, clause, binding, body, line):
                            is_grant: bool = kind == "can" or kind == "trusted"
                            grant_here: bool = in_grant or is_grant
                            covers_here: bool = covers or (is_grant and pag_clause_covers(clause))
                            block_names: mutable darray[sview] = [bound_name for bound_name in binding_names]
                            block_kinds: mutable darray[u8] = [bound_kind for bound_kind in binding_kinds]
                            block_type_mark: usize = table.local_type_names.count
                            pag_bind(binding, 0, block_names, block_kinds) if binding != ""
                            note_local_type_id_direct(binding, 0, table) if binding != ""
                            table <- pag_walk(body, block_names, block_kinds, grant_here, covers_here, Ast::Expr.Absent, line.line, table)
                            table.local_type_names <- table.local_type_names.truncate(block_type_mark) if table.local_type_names.count > block_type_mark
                            table.local_type_ids <- table.local_type_ids.truncate(block_type_mark) if table.local_type_ids.count > block_type_mark
                        Stmt.Contract(kind, expression, line):
                            table <- pag_expr(expression, binding_names, binding_kinds, in_grant, covers, line.line, table)
                        _:
                            pass
                match value_expression:
                    Expr.Absent:
                        pass
                    _:
                        table <- pag_expr(value_expression, binding_names, binding_kinds, in_grant, covers, value_line, table)
                table.local_type_names <- table.local_type_names.truncate(type_scope_mark) if table.local_type_names.count > type_scope_mark
                table.local_type_ids <- table.local_type_ids.truncate(type_scope_mark) if table.local_type_ids.count > type_scope_mark

        def check_pointer_arith_grant_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            binding_names: mutable darray[sview] = []
                            binding_kinds: mutable darray[u8] = []
                            clear_local_type_ids(table)
                            for parameter in parameters |binding_names, binding_kinds, table|:
                                parameter_kind: u8 = 1 if type_marker_present_here(parameter.type_expression, TokenKind.Ampersand) else (2 if is_integer_type_name(bare_type_name(parameter.type_expression)) else 0)
                                pag_bind(parameter.name, parameter_kind, binding_names, binding_kinds)
                                note_local_type_id(parameter.name, parameter.type_expression, table)
                            # Function effects are obligations for callers; they do not authorize
                            # pointer arithmetic inside the function body.
                            table <- pag_walk(body, binding_names, binding_kinds, false, false, Ast::Expr.Absent, line.line, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_pointer_arith_grant_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_pointer_arith_grant_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_pointer_arith_grant(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Move the caller's transient buffers aside rather than copying them into
                # this function's inferred region: they must be restored without letting
                # a short-lived copy escape through the longer-lived SymbolTable.
                saved_local_names: mutable darray[sview] = move table.local_type_names
                saved_local_ids: mutable darray[u32] = move table.local_type_ids
                table.local_type_names <- []
                table.local_type_ids <- []
                table <- check_pointer_arith_grant_decls(declarations, table)
                table.local_type_names <- move saved_local_names
                table.local_type_ids <- move saved_local_ids
