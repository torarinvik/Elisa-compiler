# Pointer arithmetic under the WRONG effect grant (strict mode). `check_strict_unsafe_ops` reports
# `ptr + offset` when it is under NO grant, but its blanket "any can/trusted block grants
# everything" suppression misses the case where the enclosing grant is for a DIFFERENT unsafe
# permission (`trusted Unsafe.PointerCast: return ptr + offset`) — stage0 still requires
# `Unsafe.PointerArithmetic` specifically. This pass fires only INSIDE a grant that does not cover
# pointer arithmetic, so it is disjoint from the other pass (which handles the no-grant case) —
# together they match stage0 (flag unless a covering grant is in scope).
extend Semantic:
    private:
        def pag_is_ref_param(name: sview, ref_params: darray[sview]&) -> bool:
            can Abort.Panic:
                return name != "" and (any p in ref_params where p == name)

        def pag_is_int_operand(expression: Ast::Expr, int_params: darray[sview]&) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.IntLit(value): true
                    Expr.Ident(name, line): any p in int_params where p == name
                    _: false

        # `ref +/- int` or `int + ref` — the pointer-arithmetic shapes (matching stage0's
        # binaryExprRequiresUnsafePointerArithmetic: `int - ref` is NOT one).
        def pag_is_pointer_arith(expression: Ast::Expr, ref_params: darray[sview]&, int_params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Binary(left, operator, right, line):
                        pag_pointer_arith_binary(left, operator, right, ref_params, int_params)
                    _: false

        def pag_pointer_arith_binary(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, ref_params: darray[sview]&, int_params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                left_ref: bool = pag_is_ref_param(ident_name_of(left), ref_params)
                right_ref: bool = pag_is_ref_param(ident_name_of(right), ref_params)
                is_add: bool = operator == TokenKind.Plus
                return ((is_add or operator == TokenKind.Minus) and left_ref and pag_is_int_operand(right, int_params)) or (is_add and right_ref and pag_is_int_operand(left, int_params))

        # Whether a grant block's clause covers pointer arithmetic: a blanket `Unsafe`, or an
        # explicit `Unsafe.PointerArithmetic` / `PointerArithmetic`.
        def pag_clause_covers(clause: darray[sview]&) -> bool:
            can Abort.Panic:
                return any entry in clause where entry == "Unsafe" or entry == "Unsafe.PointerArithmetic" or entry == "PointerArithmetic"

        def pag_expr(expression: Ast::Expr, ref_params: darray[sview]&, int_params: darray[sview]&, in_grant: bool, covers: bool, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PointerArithmeticUngranted, name: "", line: line, expected: "", actual: ""}) if in_grant and not covers and pag_pointer_arith_binary(left, operator, right, ref_params, int_params)
                        table <- pag_expr(left, ref_params, int_params, in_grant, covers, line, table)
                        table <- pag_expr(right, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- pag_expr(operand, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- pag_expr(inner, ref_params, int_params, in_grant, covers, line, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- pag_expr(argument, ref_params, int_params, in_grant, covers, line, table)
                    _:
                        pass

        def pag_walk(statements: darray[Ast::Stmt], ref_params: darray[sview]&, int_params: darray[sview]&, in_grant: bool, covers: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- pag_expr(expression, ref_params, int_params, in_grant, covers, line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pag_expr(value, ref_params, int_params, in_grant, covers, line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- pag_expr(value, ref_params, int_params, in_grant, covers, line, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- pag_expr(returned, ref_params, int_params, in_grant, covers, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pag_expr(condition, ref_params, int_params, in_grant, covers, line, table)
                            table <- pag_walk(then_body, ref_params, int_params, in_grant, covers, table)
                            table <- pag_walk(else_body, ref_params, int_params, in_grant, covers, table)
                        Stmt.While(condition, body, line):
                            table <- pag_walk(body, ref_params, int_params, in_grant, covers, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- pag_walk(body, ref_params, int_params, in_grant, covers, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            is_grant: bool = kind == "can" or kind == "trusted"
                            grant_here: bool = in_grant or is_grant
                            covers_here: bool = covers or (is_grant and pag_clause_covers(clause))
                            table <- pag_walk(body, ref_params, int_params, grant_here, covers_here, table)
                        _:
                            pass

        def check_pointer_arith_grant_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            continue if effects.count > 0
                            ref_params: mutable darray[sview] = []
                            int_params: mutable darray[sview] = []
                            for parameter in parameters |ref_params, int_params|:
                                ref_params.push(parameter.name) if type_marker_present(parameter.type_expression, TokenKind.Ampersand)
                                int_params.push(parameter.name) if is_integer_type_name(bare_type_name(parameter.type_expression))
                            table <- pag_walk(body, ref_params, int_params, false, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_pointer_arith_grant_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_pointer_arith_grant_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_pointer_arith_grant(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_pointer_arith_grant_decls(declarations, table)
