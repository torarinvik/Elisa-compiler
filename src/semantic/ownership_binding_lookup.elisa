extend Semantic:
    public:
        # Resolve one exact source occurrence, never a spelling/line guess. A
        # repeated row is harmless only if it names the identical binding.
        # The contracts establish positive-result soundness, singleton success on both
        # scan paths, and ambiguous/malformed miss behavior. General index completeness
        # remains outside this postcondition.
        def ownership_binding_at_position(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> (known: bool, binding_id: BindingId):
            ensure result.known implies result.binding_id.owner.value == owner.value
            ensure result.known implies owner.value != INVALID_DECL_ID_VALUE
            ensure result.known implies owner.value.usize() < table.symbols.count
            ensure result.known implies position.end_offset > position.offset
            ensure result.known implies table.ref_pos.count == table.ref_binding_ids.count
            ensure result.known implies not table.ref_owner_index_valid or table.ref_owner_next.count == table.ref_pos.count
            ensure result.known implies not table.ref_owner_index_valid or owner.value.usize() < table.ref_owner_heads.count
            ensure (
                result.known implies exists candidate in 0..<table.ref_pos.count: table.ref_binding_ids[candidate].owner.value == result.binding_id.owner.value
                and table.ref_binding_ids[candidate].serial == result.binding_id.serial
                and table.ref_pos[candidate].offset == position.offset
                and table.ref_pos[candidate].end_offset == position.end_offset
            )
            ensure not result.known implies result.binding_id.owner.value == INVALID_DECL_ID_VALUE
            ensure not result.known implies result.binding_id.serial == FIRST_BINDING_SERIAL
            ensure (
                (owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads.count == table.ref_owner_tails.count
                    and table.ref_owner_heads.count == table.ref_owner_counts.count
                    and table.ref_owner_heads.count == table.ref_owner_observed_counts.count
                    and owner.value.usize() < table.ref_owner_tails.count
                    and owner.value.usize() < table.ref_owner_counts.count
                    and owner.value.usize() < table.ref_owner_observed_counts.count
                    and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                    and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                    and table.ref_owner_tails[owner.value.usize()] == table.ref_owner_heads[owner.value.usize()]
                    and table.ref_owner_counts[owner.value.usize()] == 1.u32()
                    and table.ref_owner_observed_counts[owner.value.usize()] == 1.usize()
                    and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset) implies (result.known
                    and ownership_binding_ids_equal(result.binding_id, table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()]))
            )
            ensure (
                (not table.ref_owner_index_valid
                    and owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == 1
                    and table.ref_binding_ids.count == 1
                    and table.ref_binding_ids[0].owner.value == owner.value
                    and table.ref_pos[0].offset == position.offset
                    and table.ref_pos[0].end_offset == position.end_offset) implies (result.known
                    and ownership_binding_ids_equal(result.binding_id, table.ref_binding_ids[0]))
            )
            ensure (
                (owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                    and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                    and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                    and (table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset != position.offset
                        or table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset != position.end_offset)) implies not result.known
            )
            ensure (
                (owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                    and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] != SYMBOL_INDEX_ROW_NONE
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                    and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                    and table.ref_binding_ids[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].owner.value == owner.value
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset
                    and table.ref_pos[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].offset == position.offset
                    and table.ref_pos[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].end_offset == position.end_offset
                    and not ownership_binding_ids_equal(table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()], table.ref_binding_ids[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()])) implies not result.known
            )
            ensure (
                (owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == 1
                    and table.ref_binding_ids.count == 1
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == 1
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads[owner.value.usize()] == 0
                    and table.ref_owner_next[0] == 0
                    and table.ref_binding_ids[0].owner.value == owner.value
                    and table.ref_pos[0].offset == position.offset
                    and table.ref_pos[0].end_offset == position.end_offset) implies not result.known
            )
            can Abort.Panic:
                missing: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                return (false, missing) if:
                    owner.value == INVALID_DECL_ID_VALUE or owner.value.usize() >= table.symbols.count
                    position.end_offset <= position.offset
                    table.ref_pos.count != table.ref_binding_ids.count
                found: mutable bool = false
                result: mutable BindingId = missing
                # Use the resolver's owner bucket in ordinary tables; canonical
                # fallback is required when its u32 index cannot represent rows.
                if table.ref_owner_index_valid:
                    # A valid flag promises that all owner-index arrays describe a
                    # complete bucket. Any inconsistent metadata or link fails closed.
                    return (false, missing) if table.ref_owner_next.count != table.ref_binding_ids.count
                    return (false, missing) if table.ref_owner_heads.count != table.ref_owner_tails.count
                    return (false, missing) if table.ref_owner_heads.count != table.ref_owner_counts.count
                    return (false, missing) if table.ref_owner_heads.count != table.ref_owner_observed_counts.count
                    return (false, missing) if owner.value.usize() >= table.ref_owner_heads.count
                    expected_count: usize = table.ref_owner_counts[owner.value.usize()].usize()
                    expected_tail: u32 = table.ref_owner_tails[owner.value.usize()]
                    return (false, missing) if expected_count > table.ref_pos.count
                    return (false, missing) if expected_count != table.ref_owner_observed_counts[owner.value.usize()]
                    head: usize = table.ref_owner_heads[owner.value.usize()].usize()
                    if expected_count == 0:
                        return (false, missing) if head != SYMBOL_INDEX_ROW_NONE.usize() or expected_tail != SYMBOL_INDEX_ROW_NONE
                        return (false, missing)
                    return (false, missing) if head == SYMBOL_INDEX_ROW_NONE.usize() or head >= table.ref_pos.count
                    row: mutable usize = head
                    last_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    for step in 0..<expected_count |step, row, last_row, found, result, table, owner, position, expected_count, head|:
                        invariant step <= expected_count
                        invariant (step == 0 implies row == head) and (step != 0 implies last_row.usize() < table.ref_owner_next.count and row == table.ref_owner_next[last_row.usize()].usize())
                        invariant (found or (result.owner.value == INVALID_DECL_ID_VALUE and result.serial == FIRST_BINDING_SERIAL))
                        invariant not found or result.owner.value == owner.value
                        invariant (
                            found implies exists candidate in 0..<table.ref_pos.count: table.ref_binding_ids[candidate].owner.value == result.owner.value
                            and table.ref_binding_ids[candidate].serial == result.serial
                            and table.ref_pos[candidate].offset == position.offset
                            and table.ref_pos[candidate].end_offset == position.end_offset
                        )
                        return (false, missing) if row == SYMBOL_INDEX_ROW_NONE.usize() or row >= table.ref_pos.count or row >= table.ref_owner_next.count
                        index: usize = row
                        id: BindingId = table.ref_binding_ids[index]
                        return (false, missing) if id.owner.value != owner.value
                        recorded: Ast::Pos = table.ref_pos[index]
                        if recorded.offset == position.offset and recorded.end_offset == position.end_offset:
                            return (false, missing) if found and not ownership_binding_ids_equal(result, id)
                            if not found:
                                found <- true
                                result <- id
                        last_row <- row.u32()
                        row <- table.ref_owner_next[index].usize()
                    return (false, missing) if row != SYMBOL_INDEX_ROW_NONE.usize() or last_row != expected_tail
                    return (found, result)
                if not table.ref_owner_index_valid
                    and table.ref_binding_ids.count == 1
                    and table.ref_pos.count == 1
                    and table.ref_binding_ids[0].owner.value == owner.value
                    and table.ref_pos[0].offset == position.offset
                    and table.ref_pos[0].end_offset == position.end_offset:
                    return (true, table.ref_binding_ids[0])
                for index in 0..<table.ref_binding_ids.count |index, table, owner, position, found, result|:
                    invariant (found or (result.owner.value == INVALID_DECL_ID_VALUE and result.serial == FIRST_BINDING_SERIAL))
                    invariant not found or result.owner.value == owner.value
                    invariant (
                        found implies exists candidate in 0..<table.ref_pos.count: table.ref_binding_ids[candidate].owner.value == result.owner.value
                        and table.ref_binding_ids[candidate].serial == result.serial
                        and table.ref_pos[candidate].offset == position.offset
                        and table.ref_pos[candidate].end_offset == position.end_offset
                    )
                    id: BindingId = table.ref_binding_ids[index]
                    continue if id.owner.value != owner.value
                    recorded: Ast::Pos = table.ref_pos[index]
                    continue if recorded.offset != position.offset or recorded.end_offset != position.end_offset
                    return (false, missing) if found and not ownership_binding_ids_equal(result, id)
                    if not found:
                        found <- true
                        result <- id
                return (found, result)
