extend Semantic:
    private:
        def ownership_lookup_indexed_singleton_exact(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> bool:
            ensure result == (
                owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads.count == table.ref_owner_tails.count
                    and table.ref_owner_heads.count == table.ref_owner_counts.count
                    and table.ref_owner_heads.count == table.ref_owner_observed_counts.count
                    and owner.value.usize() < table.ref_owner_tails.count
                    and owner.value.usize() < table.ref_owner_counts.count
                    and owner.value.usize() < table.ref_owner_observed_counts.count
                    and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                    and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                    and table.ref_owner_tails[owner.value.usize()] == table.ref_owner_heads[owner.value.usize()]
                    and table.ref_owner_counts[owner.value.usize()] == 1.u32()
                    and table.ref_owner_observed_counts[owner.value.usize()] == 1.usize()
                    and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset
            )
            return owner.value != INVALID_DECL_ID_VALUE
                and owner.value.usize() < table.symbols.count
                and position.end_offset > position.offset
                and table.ref_pos.count == table.ref_binding_ids.count
                and table.ref_owner_index_valid
                and table.ref_owner_next.count == table.ref_pos.count
                and owner.value.usize() < table.ref_owner_heads.count
                and table.ref_owner_heads.count == table.ref_owner_tails.count
                and table.ref_owner_heads.count == table.ref_owner_counts.count
                and table.ref_owner_heads.count == table.ref_owner_observed_counts.count
                and owner.value.usize() < table.ref_owner_tails.count
                and owner.value.usize() < table.ref_owner_counts.count
                and owner.value.usize() < table.ref_owner_observed_counts.count
                and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                and table.ref_owner_tails[owner.value.usize()] == table.ref_owner_heads[owner.value.usize()]
                and table.ref_owner_counts[owner.value.usize()] == 1.u32()
                and table.ref_owner_observed_counts[owner.value.usize()] == 1.usize()
                and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset

        def ownership_lookup_fallback_singleton_exact(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> bool:
            ensure result == (
                not table.ref_owner_index_valid
                    and owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == 1
                    and table.ref_binding_ids.count == 1
                    and table.ref_binding_ids[0].owner.value == owner.value
                    and table.ref_pos[0].offset == position.offset
                    and table.ref_pos[0].end_offset == position.end_offset
            )
            return not table.ref_owner_index_valid
                and owner.value != INVALID_DECL_ID_VALUE
                and owner.value.usize() < table.symbols.count
                and position.end_offset > position.offset
                and table.ref_pos.count == 1
                and table.ref_binding_ids.count == 1
                and table.ref_binding_ids[0].owner.value == owner.value
                and table.ref_pos[0].offset == position.offset
                and table.ref_pos[0].end_offset == position.end_offset

        def ownership_lookup_indexed_singleton_span_mismatch(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> bool:
            ensure result == (
                owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                    and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                    and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                    and (table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset != position.offset
                        or table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset != position.end_offset)
            )
            return owner.value != INVALID_DECL_ID_VALUE
                and owner.value.usize() < table.symbols.count
                and position.end_offset > position.offset
                and table.ref_pos.count == table.ref_binding_ids.count
                and table.ref_owner_index_valid
                and table.ref_owner_next.count == table.ref_pos.count
                and owner.value.usize() < table.ref_owner_heads.count
                and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                and (table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset != position.offset
                    or table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset != position.end_offset)

        def ownership_lookup_indexed_conflicting_rows(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> bool:
            ensure result == (
                owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                    and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] != SYMBOL_INDEX_ROW_NONE
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                    and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                    and table.ref_binding_ids[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].owner.value == owner.value
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset
                    and table.ref_pos[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].offset == position.offset
                    and table.ref_pos[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].end_offset == position.end_offset
                    and not ownership_binding_ids_equal(table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()], table.ref_binding_ids[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()])
            )
            return owner.value != INVALID_DECL_ID_VALUE
                and owner.value.usize() < table.symbols.count
                and position.end_offset > position.offset
                and table.ref_pos.count == table.ref_binding_ids.count
                and table.ref_owner_index_valid
                and table.ref_owner_next.count == table.ref_pos.count
                and owner.value.usize() < table.ref_owner_heads.count
                and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] != SYMBOL_INDEX_ROW_NONE
                and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize() < table.ref_pos.count
                and table.ref_owner_next[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                and table.ref_binding_ids[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].owner.value == owner.value
                and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset
                and table.ref_pos[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].offset == position.offset
                and table.ref_pos[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()].end_offset == position.end_offset
                and not ownership_binding_ids_equal(table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()], table.ref_binding_ids[table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()].usize()])

        def ownership_lookup_indexed_matching_self_loop(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> bool:
            ensure result == (
                owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == 1
                    and table.ref_binding_ids.count == 1
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == 1
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads[owner.value.usize()] == 0
                    and table.ref_owner_next[0] == 0
                    and table.ref_binding_ids[0].owner.value == owner.value
                    and table.ref_pos[0].offset == position.offset
                    and table.ref_pos[0].end_offset == position.end_offset
            )
            return owner.value != INVALID_DECL_ID_VALUE
                and owner.value.usize() < table.symbols.count
                and position.end_offset > position.offset
                and table.ref_pos.count == 1
                and table.ref_binding_ids.count == 1
                and table.ref_owner_index_valid
                and table.ref_owner_next.count == 1
                and owner.value.usize() < table.ref_owner_heads.count
                and table.ref_owner_heads[owner.value.usize()] == 0
                and table.ref_owner_next[0] == 0
                and table.ref_binding_ids[0].owner.value == owner.value
                and table.ref_pos[0].offset == position.offset
                and table.ref_pos[0].end_offset == position.end_offset

        def ownership_lookup_candidate_row(table: SymbolTable&, candidate: usize, owner: DeclId, position: Ast::Pos) -> (matches: bool, binding_id: BindingId):
            ensure (
                candidate < old(table.ref_pos.count)
                    and candidate < old(table.ref_binding_ids.count)
            ) implies (
                result.binding_id.owner.value == old(table.ref_binding_ids[candidate].owner.value)
                    and result.binding_id.serial == old(table.ref_binding_ids[candidate].serial)
            )
            ensure result.matches == (
                candidate < old(table.ref_pos.count)
                    and candidate < old(table.ref_binding_ids.count)
                    and old(table.ref_binding_ids[candidate].owner.value) == owner.value
                    and old(table.ref_pos[candidate].offset) == old(position.offset)
                    and old(table.ref_pos[candidate].end_offset) == old(position.end_offset)
            )
            can Abort.Panic:
                missing: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                return (false, missing) if candidate >= table.ref_pos.count or candidate >= table.ref_binding_ids.count
                query_offset: u32 = position.offset
                query_end_offset: u32 = position.end_offset
                candidate_binding_id: BindingId = table.ref_binding_ids[candidate]
                candidate_offset: u32 = table.ref_pos[candidate].offset
                candidate_end_offset: u32 = table.ref_pos[candidate].end_offset
                matches: bool = candidate_binding_id.owner.value == owner.value
                    and candidate_offset == query_offset
                    and candidate_end_offset == query_end_offset
                return (matches, candidate_binding_id)

        def ownership_lookup_candidate_matches(table: SymbolTable&, candidate: usize, binding_id: BindingId, owner: DeclId, position: Ast::Pos) -> bool:
            ensure result == (
                candidate < old(table.ref_pos.count)
                    and candidate < old(table.ref_binding_ids.count)
                    and old(table.ref_binding_ids[candidate].owner.value) == owner.value
                    and old(table.ref_binding_ids[candidate].serial) == binding_id.serial
                    and old(table.ref_pos[candidate].offset) == old(position.offset)
                    and old(table.ref_pos[candidate].end_offset) == old(position.end_offset)
                    and binding_id.owner.value == owner.value
            )
            can Abort.Panic:
                row_matches, row_binding_id = ownership_lookup_candidate_row(table, candidate, owner, position)
                return row_matches and ownership_binding_ids_equal(row_binding_id, binding_id)

extend Semantic:
    public:
        # Resolve one exact source occurrence, never a spelling/line guess. A
        # repeated row is harmless only if it names the identical binding.
        # The contracts establish positive-result soundness, singleton success on both
        # scan paths, and ambiguous/malformed miss behavior. General index completeness
        # remains outside this postcondition.
        def ownership_binding_at_position(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> (known: bool, binding_id: BindingId):
            ensure result.known implies result.binding_id.owner.value == owner.value
            ensure result.known implies owner.value != INVALID_DECL_ID_VALUE
            ensure result.known implies owner.value.usize() < table.symbols.count
            ensure result.known implies position.end_offset > position.offset
            ensure result.known implies table.ref_pos.count == table.ref_binding_ids.count
            ensure result.known implies not table.ref_owner_index_valid or table.ref_owner_next.count == table.ref_pos.count
            ensure result.known implies not table.ref_owner_index_valid or owner.value.usize() < table.ref_owner_heads.count
            ensure (
                result.known implies exists candidate in 0..<table.ref_pos.count:
                    ownership_lookup_candidate_matches(table, candidate, result.binding_id, owner, position)
            )
            ensure not result.known implies result.binding_id.owner.value == INVALID_DECL_ID_VALUE
            ensure not result.known implies result.binding_id.serial == FIRST_BINDING_SERIAL
            ensure ownership_lookup_indexed_singleton_exact(table, owner, position) implies (
                result.known
                    and ownership_lookup_candidate_matches(table, table.ref_owner_heads[owner.value.usize()].usize(), result.binding_id, owner, position)
            )
            ensure ownership_lookup_fallback_singleton_exact(table, owner, position) implies (
                result.known and ownership_lookup_candidate_matches(table, 0, result.binding_id, owner, position)
            )
            ensure ownership_lookup_indexed_singleton_span_mismatch(table, owner, position) implies not result.known
            ensure ownership_lookup_indexed_conflicting_rows(table, owner, position) implies not result.known
            ensure ownership_lookup_indexed_matching_self_loop(table, owner, position) implies not result.known
            can Abort.Panic:
                missing: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                return (false, missing) if:
                    owner.value == INVALID_DECL_ID_VALUE or owner.value.usize() >= table.symbols.count
                    position.end_offset <= position.offset
                    table.ref_pos.count != table.ref_binding_ids.count
                indexed_singleton_exact: bool = ownership_lookup_indexed_singleton_exact(table, owner, position)
                indexed_singleton_span_mismatch: bool = ownership_lookup_indexed_singleton_span_mismatch(table, owner, position)
                indexed_conflicting_rows: bool = ownership_lookup_indexed_conflicting_rows(table, owner, position)
                indexed_matching_self_loop: bool = ownership_lookup_indexed_matching_self_loop(table, owner, position)
                fallback_singleton_exact: bool = ownership_lookup_fallback_singleton_exact(table, owner, position)
                if fallback_singleton_exact:
                    fallback_row_matches, fallback_binding_id = ownership_lookup_candidate_row(table, 0, owner, position)
                    assert fallback_row_matches
                    return (true, fallback_binding_id)
                if indexed_singleton_exact:
                    indexed_head: usize = table.ref_owner_heads[owner.value.usize()].usize()
                    indexed_row_matches, indexed_binding_id = ownership_lookup_candidate_row(table, indexed_head, owner, position)
                    assert indexed_row_matches
                    return (true, indexed_binding_id)
                if indexed_matching_self_loop or indexed_singleton_span_mismatch or indexed_conflicting_rows:
                    return (false, missing)
                found: mutable bool = false
                result_index: mutable usize = 0
                result_binding_id: mutable BindingId = missing
                lookup_valid: mutable bool = true
                # Use the resolver's owner bucket in ordinary tables; canonical
                # fallback is required when its u32 index cannot represent rows.
                if table.ref_owner_index_valid:
                    # Discharge the specified one-row case directly before the
                    # general traversal so its bounds and identity facts stay local.
                    if indexed_singleton_exact:
                        result_index <- table.ref_owner_heads[owner.value.usize()].usize()
                        result_binding_id <- table.ref_binding_ids[result_index]
                        found <- true
                    else:
                        # A valid flag promises that all owner-index arrays describe a
                        # complete bucket. Any inconsistent metadata or link fails closed.
                        if table.ref_owner_next.count == table.ref_binding_ids.count
                            and table.ref_owner_heads.count == table.ref_owner_tails.count
                            and table.ref_owner_heads.count == table.ref_owner_counts.count
                            and table.ref_owner_heads.count == table.ref_owner_observed_counts.count
                            and owner.value.usize() < table.ref_owner_heads.count:
                            expected_count: usize = table.ref_owner_counts[owner.value.usize()].usize()
                            expected_tail: u32 = table.ref_owner_tails[owner.value.usize()]
                            head: usize = table.ref_owner_heads[owner.value.usize()].usize()
                            if expected_count > table.ref_pos.count or expected_count != table.ref_owner_observed_counts[owner.value.usize()]:
                                lookup_valid <- false
                            elif expected_count == 0:
                                if head != SYMBOL_INDEX_ROW_NONE.usize() or expected_tail != SYMBOL_INDEX_ROW_NONE:
                                    lookup_valid <- false
                            elif head == SYMBOL_INDEX_ROW_NONE.usize() or head >= table.ref_pos.count or head >= table.ref_owner_next.count:
                                lookup_valid <- false
                            else:
                                row: mutable usize = head
                                last_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                                for step in 0..<expected_count |step, row, last_row, found, result_index, result_binding_id, table, owner, position, expected_count, head, lookup_valid|:
                                    invariant step <= expected_count
                                    invariant (step == 0 implies row == head) and (step != 0 implies last_row.usize() < table.ref_owner_next.count and row == table.ref_owner_next[last_row.usize()].usize())
                                    invariant not found or result_index < table.ref_pos.count
                                    invariant not found or table.ref_binding_ids[result_index].owner.value == owner.value
                                    invariant not found or ownership_binding_ids_equal(result_binding_id, table.ref_binding_ids[result_index])
                                    invariant not found or (table.ref_pos[result_index].offset == position.offset and table.ref_pos[result_index].end_offset == position.end_offset)
                                    if row == SYMBOL_INDEX_ROW_NONE.usize() or row >= table.ref_pos.count or row >= table.ref_owner_next.count:
                                        lookup_valid <- false
                                    else:
                                        index: usize = row
                                        row_matches, id = ownership_lookup_candidate_row(table, index, owner, position)
                                        if row_matches:
                                            if found and not ownership_binding_ids_equal(result_binding_id, id):
                                                lookup_valid <- false
                                            elif not found:
                                                result_index <- index
                                                result_binding_id <- id
                                                found <- true
                                        last_row <- row.u32()
                                        row <- table.ref_owner_next[index].usize()
                                if row != SYMBOL_INDEX_ROW_NONE.usize() or last_row != expected_tail:
                                    lookup_valid <- false
                        else:
                            lookup_valid <- false
                else:
                    for index in 0..<table.ref_binding_ids.count |index, table, owner, position, found, result_index, result_binding_id|:
                        invariant not found or result_index < table.ref_pos.count
                        invariant not found or table.ref_binding_ids[result_index].owner.value == owner.value
                        invariant not found or ownership_binding_ids_equal(result_binding_id, table.ref_binding_ids[result_index])
                        invariant not found or (table.ref_pos[result_index].offset == position.offset and table.ref_pos[result_index].end_offset == position.end_offset)
                        row_matches, id = ownership_lookup_candidate_row(table, index, owner, position)
                        continue if not row_matches
                        if found and not ownership_binding_ids_equal(result_binding_id, id):
                            lookup_valid <- false
                        if not found:
                            result_index <- index
                            result_binding_id <- id
                            found <- true
                if not lookup_valid:
                    found <- false
                    result_index <- 0
                    result_binding_id <- missing
                if found:
                    assert owner.value != INVALID_DECL_ID_VALUE
                    assert owner.value.usize() < table.symbols.count
                    assert position.end_offset > position.offset
                    assert table.ref_pos.count == table.ref_binding_ids.count
                    assert not table.ref_owner_index_valid or table.ref_owner_next.count == table.ref_pos.count
                    assert not table.ref_owner_index_valid or owner.value.usize() < table.ref_owner_heads.count
                    assert result_index < table.ref_pos.count
                    assert result_index < table.ref_binding_ids.count
                    binding_id: BindingId = result_binding_id
                    assert ownership_lookup_candidate_matches(table, result_index, binding_id, owner, position)
                    assert binding_id.owner.value == owner.value
                    return (true, binding_id)
                assert missing.owner.value == INVALID_DECL_ID_VALUE
                assert missing.serial == FIRST_BINDING_SERIAL
                return (false, missing)
