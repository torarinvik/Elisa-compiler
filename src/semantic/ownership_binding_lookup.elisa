extend Semantic:
    private:
        # A lookup witness is one aligned row with the requested owner, exact
        # source span, and complete binding identity.
        def ownership_lookup_candidate_matches(table: SymbolTable&, candidate: usize, owner: DeclId, position: Ast::Pos, binding_id: BindingId) -> bool:
            ensure result == (
                candidate < table.ref_pos.count
                and candidate < table.ref_binding_ids.count
                and table.ref_binding_ids[candidate].owner.value == owner.value
                and ownership_binding_ids_equal(table.ref_binding_ids[candidate], binding_id)
                and table.ref_pos[candidate].offset == position.offset
                and table.ref_pos[candidate].end_offset == position.end_offset
            )
            return false if:
                candidate >= table.ref_pos.count or candidate >= table.ref_binding_ids.count
                table.ref_binding_ids[candidate].owner.value != owner.value
                not ownership_binding_ids_equal(table.ref_binding_ids[candidate], binding_id)
                table.ref_pos[candidate].offset != position.offset
                table.ref_pos[candidate].end_offset != position.end_offset
            return true

    public:
        struct OwnershipBindingLookupResult:
            known: bool
            binding_id: BindingId
            witness_index: usize

        # Resolve one exact source occurrence, never a spelling/line guess. A
        # repeated row is harmless only if it names the identical binding.
        # The public contract establishes positive-result soundness. Concrete probes
        # cover singleton success and fail-closed malformed/ambiguous table behavior.
        def ownership_binding_at_position(table: SymbolTable&, owner: DeclId, position: Ast::Pos) -> OwnershipBindingLookupResult:
            ensure result.known implies result.binding_id.owner.value == owner.value
            ensure result.known implies owner.value != INVALID_DECL_ID_VALUE
            ensure result.known implies owner.value.usize() < table.symbols.count
            ensure result.known implies position.end_offset > position.offset
            ensure result.known implies table.ref_pos.count == table.ref_binding_ids.count
            ensure result.known implies not table.ref_owner_index_valid or table.ref_owner_next.count == table.ref_pos.count
            ensure result.known implies not table.ref_owner_index_valid or owner.value.usize() < table.ref_owner_heads.count
            ensure result.known implies result.witness_index < table.ref_pos.count
            ensure result.known implies result.witness_index < table.ref_binding_ids.count
            ensure result.known implies table.ref_binding_ids[result.witness_index].owner.value == owner.value
            ensure result.known implies table.ref_binding_ids[result.witness_index].owner.value == result.binding_id.owner.value
            ensure result.known implies table.ref_binding_ids[result.witness_index].serial == result.binding_id.serial
            ensure result.known implies table.ref_pos[result.witness_index].offset == position.offset
            ensure result.known implies table.ref_pos[result.witness_index].end_offset == position.end_offset
            ensure not result.known implies result.binding_id.owner.value == INVALID_DECL_ID_VALUE
            ensure not result.known implies result.binding_id.serial == FIRST_BINDING_SERIAL
            can Abort.Panic:
                return OwnershipBindingLookupResult{known: false, binding_id: BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}, witness_index: SYMBOL_INDEX_ROW_NONE.usize()} if:
                    owner.value == INVALID_DECL_ID_VALUE or owner.value.usize() >= table.symbols.count
                    position.end_offset <= position.offset
                    table.ref_pos.count != table.ref_binding_ids.count
                # Resolve the exact one-row fallback before the shared mutable scan
                # state so its returned binding remains the local witness.
                if not table.ref_owner_index_valid
                    and owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_pos.count == 1
                    and table.ref_binding_ids.count == 1
                    and table.ref_binding_ids[0].owner.value == owner.value
                    and table.ref_pos[0].offset == position.offset
                    and table.ref_pos[0].end_offset == position.end_offset:
                    fallback_binding_id: BindingId = table.ref_binding_ids[0]
                    assert 0 < table.ref_pos.count
                    assert 0 < table.ref_binding_ids.count
                    assert fallback_binding_id.owner.value == owner.value
                    assert ownership_binding_ids_equal(table.ref_binding_ids[0], fallback_binding_id)
                    assert table.ref_pos[0].offset == position.offset
                    assert table.ref_pos[0].end_offset == position.end_offset
                    assert ownership_lookup_candidate_matches(table, 0, owner, position, fallback_binding_id)
                    assert owner.value != INVALID_DECL_ID_VALUE
                    assert owner.value.usize() < table.symbols.count
                    assert position.end_offset > position.offset
                    assert table.ref_pos.count == table.ref_binding_ids.count
                    assert not table.ref_owner_index_valid or table.ref_owner_next.count == table.ref_pos.count
                    assert not table.ref_owner_index_valid or owner.value.usize() < table.ref_owner_heads.count
                    assert ownership_lookup_candidate_matches(table, 0, owner, position, fallback_binding_id)
                    return OwnershipBindingLookupResult{known: true, binding_id: fallback_binding_id, witness_index: 0}
                # A row whose next link points back to itself is malformed. Reject
                # this exact singleton shape without relying on the traversal exit
                # invariant to discover the cycle.
                if owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == 1
                    and table.ref_binding_ids.count == 1
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == 1
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads[owner.value.usize()] == 0
                    and table.ref_owner_next[0] == 0
                    and table.ref_binding_ids[0].owner.value == owner.value
                    and table.ref_pos[0].offset == position.offset
                    and table.ref_pos[0].end_offset == position.end_offset:
                    return OwnershipBindingLookupResult{known: false, binding_id: BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}, witness_index: SYMBOL_INDEX_ROW_NONE.usize()}
                # A one-row owner bucket with a different span is an exact miss.
                # Resolve it here so the postcondition does not depend on the loop
                # carrying a negative fact across mutable scan state.
                if table.ref_owner_index_valid
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.ref_owner_heads.count:
                    singleton_head: usize = table.ref_owner_heads[owner.value.usize()].usize()
                    if singleton_head != SYMBOL_INDEX_ROW_NONE.usize()
                        and singleton_head < table.ref_pos.count
                        and table.ref_owner_next[singleton_head] == SYMBOL_INDEX_ROW_NONE
                        and table.ref_binding_ids[singleton_head].owner.value == owner.value
                        and (table.ref_pos[singleton_head].offset != position.offset
                            or table.ref_pos[singleton_head].end_offset != position.end_offset):
                        return OwnershipBindingLookupResult{known: false, binding_id: BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}, witness_index: SYMBOL_INDEX_ROW_NONE.usize()}
                # Two exact-span rows with distinct binding identities are
                # ambiguous even in a valid bucket; reject the precise two-row
                # shape before the general traversal.
                if table.ref_owner_index_valid
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.ref_owner_heads.count:
                    duplicate_head: usize = table.ref_owner_heads[owner.value.usize()].usize()
                    if duplicate_head != SYMBOL_INDEX_ROW_NONE.usize()
                        and duplicate_head < table.ref_pos.count
                        and table.ref_owner_next[duplicate_head] != SYMBOL_INDEX_ROW_NONE:
                        duplicate_second: usize = table.ref_owner_next[duplicate_head].usize()
                        if duplicate_second < table.ref_pos.count
                            and table.ref_owner_next[duplicate_second] == SYMBOL_INDEX_ROW_NONE
                            and table.ref_binding_ids[duplicate_head].owner.value == owner.value
                            and table.ref_binding_ids[duplicate_second].owner.value == owner.value
                            and table.ref_pos[duplicate_head].offset == position.offset
                            and table.ref_pos[duplicate_head].end_offset == position.end_offset
                            and table.ref_pos[duplicate_second].offset == position.offset
                            and table.ref_pos[duplicate_second].end_offset == position.end_offset
                            and not ownership_binding_ids_equal(table.ref_binding_ids[duplicate_head], table.ref_binding_ids[duplicate_second]):
                            return OwnershipBindingLookupResult{known: false, binding_id: BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}, witness_index: SYMBOL_INDEX_ROW_NONE.usize()}
                found: mutable bool = false
                result_index: mutable usize = 0
                lookup_valid: mutable bool = true
                # Use the resolver's owner bucket in ordinary tables; canonical
                # fallback is required when its u32 index cannot represent rows.
                if table.ref_owner_index_valid:
                    # Discharge the specified one-row case directly before the
                    # general traversal so its bounds and identity facts stay local.
                    if table.ref_pos.count == table.ref_binding_ids.count
                        and table.ref_owner_next.count == table.ref_pos.count
                        and table.ref_owner_heads.count == table.ref_owner_tails.count
                        and table.ref_owner_heads.count == table.ref_owner_counts.count
                        and table.ref_owner_heads.count == table.ref_owner_observed_counts.count
                        and owner.value.usize() < table.ref_owner_heads.count
                        and owner.value.usize() < table.ref_owner_tails.count
                        and owner.value.usize() < table.ref_owner_counts.count
                        and owner.value.usize() < table.ref_owner_observed_counts.count
                        and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                        and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                        and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                        and table.ref_owner_tails[owner.value.usize()] == table.ref_owner_heads[owner.value.usize()]
                        and table.ref_owner_counts[owner.value.usize()] == 1.u32()
                        and table.ref_owner_observed_counts[owner.value.usize()] == 1.usize()
                        and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                        and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                        and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset:
                        result_index <- table.ref_owner_heads[owner.value.usize()].usize()
                        found <- true
                        assert owner.value != INVALID_DECL_ID_VALUE
                        assert owner.value.usize() < table.symbols.count
                        assert position.end_offset > position.offset
                        assert table.ref_pos.count == table.ref_binding_ids.count
                        assert table.ref_owner_next.count == table.ref_pos.count
                        assert owner.value.usize() < table.ref_owner_heads.count
                        assert result_index == table.ref_owner_heads[owner.value.usize()].usize()
                        assert ownership_lookup_candidate_matches(table, result_index, owner, position, table.ref_binding_ids[result_index])
                        return OwnershipBindingLookupResult{known: true, binding_id: table.ref_binding_ids[result_index], witness_index: result_index}
                    else:
                        # A valid flag promises that all owner-index arrays describe a
                        # complete bucket. Any inconsistent metadata or link fails closed.
                        if table.ref_owner_next.count == table.ref_binding_ids.count
                            and table.ref_owner_heads.count == table.ref_owner_tails.count
                            and table.ref_owner_heads.count == table.ref_owner_counts.count
                            and table.ref_owner_heads.count == table.ref_owner_observed_counts.count
                            and owner.value.usize() < table.ref_owner_heads.count:
                            expected_count: usize = table.ref_owner_counts[owner.value.usize()].usize()
                            expected_tail: u32 = table.ref_owner_tails[owner.value.usize()]
                            head: usize = table.ref_owner_heads[owner.value.usize()].usize()
                            if expected_count > table.ref_pos.count or expected_count != table.ref_owner_observed_counts[owner.value.usize()]:
                                lookup_valid <- false
                            elif expected_count == 0:
                                if head != SYMBOL_INDEX_ROW_NONE.usize() or expected_tail != SYMBOL_INDEX_ROW_NONE:
                                    lookup_valid <- false
                            elif head == SYMBOL_INDEX_ROW_NONE.usize() or head >= table.ref_pos.count or head >= table.ref_owner_next.count:
                                lookup_valid <- false
                            else:
                                row: mutable u32 = table.ref_owner_heads[owner.value.usize()]
                                last_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                                for step in 0..<expected_count |step, row, last_row, found, result_index, table, owner, position, expected_count, head, lookup_valid|:
                                    invariant step <= expected_count
                                    invariant (step == 0 implies row.usize() == head) and (step != 0 implies last_row.usize() < table.ref_owner_next.count and row == table.ref_owner_next[last_row.usize()])
                                    invariant not found or (
                                        result_index < table.ref_pos.count and
                                        result_index < table.ref_binding_ids.count and
                                        table.ref_binding_ids[result_index].owner.value == owner.value and
                                        table.ref_pos[result_index].offset == position.offset and
                                        table.ref_pos[result_index].end_offset == position.end_offset
                                    )
                                    if row == SYMBOL_INDEX_ROW_NONE or row.usize() >= table.ref_pos.count or row.usize() >= table.ref_owner_next.count:
                                        lookup_valid <- false
                                    else:
                                        index: usize = row.usize()
                                        id: BindingId = table.ref_binding_ids[index]
                                        if id.owner.value != owner.value:
                                            lookup_valid <- false
                                        else:
                                            recorded: Ast::Pos = table.ref_pos[index]
                                            if recorded.offset == position.offset and recorded.end_offset == position.end_offset:
                                                if found and not ownership_binding_ids_equal(table.ref_binding_ids[result_index], id):
                                                    lookup_valid <- false
                                                elif not found:
                                                    result_index <- index
                                                    found <- true
                                                    assert table.ref_binding_ids[result_index].owner.value == owner.value
                                                    assert table.ref_pos[result_index].offset == position.offset
                                                    assert table.ref_pos[result_index].end_offset == position.end_offset
                                        last_row <- row
                                        row <- table.ref_owner_next[index]
                                        assert last_row.usize() < table.ref_owner_next.count
                                        assert row == table.ref_owner_next[last_row.usize()]
                                    assert not found or (
                                        result_index < table.ref_pos.count and
                                        result_index < table.ref_binding_ids.count and
                                        table.ref_binding_ids[result_index].owner.value == owner.value and
                                        table.ref_pos[result_index].offset == position.offset and
                                        table.ref_pos[result_index].end_offset == position.end_offset
                                    )
                                if row != SYMBOL_INDEX_ROW_NONE or last_row != expected_tail:
                                    lookup_valid <- false
                        else:
                            lookup_valid <- false
                else:
                    for index in 0..<table.ref_binding_ids.count |index, table, owner, position, found, result_index|:
                        invariant not found or (
                            result_index < table.ref_pos.count and
                            result_index < table.ref_binding_ids.count and
                            table.ref_binding_ids[result_index].owner.value == owner.value and
                            table.ref_pos[result_index].offset == position.offset and
                            table.ref_pos[result_index].end_offset == position.end_offset
                        )
                        id: BindingId = table.ref_binding_ids[index]
                        continue if id.owner.value != owner.value
                        recorded: Ast::Pos = table.ref_pos[index]
                        continue if recorded.offset != position.offset or recorded.end_offset != position.end_offset
                        if found and not ownership_binding_ids_equal(table.ref_binding_ids[result_index], id):
                            lookup_valid <- false
                        if not found:
                            result_index <- index
                            found <- true
                            assert table.ref_binding_ids[result_index].owner.value == owner.value
                            assert table.ref_pos[result_index].offset == position.offset
                            assert table.ref_pos[result_index].end_offset == position.end_offset
                        assert not found or (
                            result_index < table.ref_pos.count and
                            result_index < table.ref_binding_ids.count and
                            table.ref_binding_ids[result_index].owner.value == owner.value and
                            table.ref_pos[result_index].offset == position.offset and
                            table.ref_pos[result_index].end_offset == position.end_offset
                        )
                if not lookup_valid:
                    found <- false
                    result_index <- 0
                if found:
                    assert owner.value != INVALID_DECL_ID_VALUE
                    assert owner.value.usize() < table.symbols.count
                    assert position.end_offset > position.offset
                    assert table.ref_pos.count == table.ref_binding_ids.count
                    assert not table.ref_owner_index_valid or table.ref_owner_next.count == table.ref_pos.count
                    assert not table.ref_owner_index_valid or owner.value.usize() < table.ref_owner_heads.count
                    assert result_index < table.ref_pos.count
                    assert result_index < table.ref_binding_ids.count
                    # Reload the selected row for the returned value. The row index
                    # is the single witness used for both duplicate checks and proof.
                    selected_binding_id: BindingId = table.ref_binding_ids[result_index]
                    assert selected_binding_id.owner.value == owner.value
                    assert ownership_binding_ids_equal(table.ref_binding_ids[result_index], selected_binding_id)
                    assert table.ref_pos[result_index].offset == position.offset
                    assert table.ref_pos[result_index].end_offset == position.end_offset
                    assert ownership_lookup_candidate_matches(table, result_index, owner, position, selected_binding_id)
                    assert ownership_binding_ids_equal(selected_binding_id, table.ref_binding_ids[result_index])
                    return OwnershipBindingLookupResult{known: true, binding_id: selected_binding_id, witness_index: result_index}
                assert not (
                    owner.value != INVALID_DECL_ID_VALUE
                    and owner.value.usize() < table.symbols.count
                    and position.end_offset > position.offset
                    and table.ref_pos.count == table.ref_binding_ids.count
                    and table.ref_owner_index_valid
                    and table.ref_owner_next.count == table.ref_pos.count
                    and owner.value.usize() < table.ref_owner_heads.count
                    and table.ref_owner_heads.count == table.ref_owner_tails.count
                    and table.ref_owner_heads.count == table.ref_owner_counts.count
                    and table.ref_owner_heads.count == table.ref_owner_observed_counts.count
                    and owner.value.usize() < table.ref_owner_tails.count
                    and owner.value.usize() < table.ref_owner_counts.count
                    and owner.value.usize() < table.ref_owner_observed_counts.count
                    and table.ref_owner_heads[owner.value.usize()].usize() != SYMBOL_INDEX_ROW_NONE.usize()
                    and table.ref_owner_heads[owner.value.usize()].usize() < table.ref_pos.count
                    and table.ref_owner_next[table.ref_owner_heads[owner.value.usize()].usize()] == SYMBOL_INDEX_ROW_NONE
                    and table.ref_owner_tails[owner.value.usize()] == table.ref_owner_heads[owner.value.usize()]
                    and table.ref_owner_counts[owner.value.usize()] == 1.u32()
                    and table.ref_owner_observed_counts[owner.value.usize()] == 1.usize()
                    and table.ref_binding_ids[table.ref_owner_heads[owner.value.usize()].usize()].owner.value == owner.value
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].offset == position.offset
                    and table.ref_pos[table.ref_owner_heads[owner.value.usize()].usize()].end_offset == position.end_offset
                )
                return OwnershipBindingLookupResult{known: false, binding_id: BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}, witness_index: SYMBOL_INDEX_ROW_NONE.usize()}
