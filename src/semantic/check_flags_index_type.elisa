# Flags index type mismatch. A `Flags[E]` value is indexed by variants of its own flag enum
# E; indexing with a variant of a different enum is rejected:
#
#   const enum RoutineFlag of u8: External; Forward
#   const enum OtherFlag of u8: Other
#   def bad(value: Flags[RoutineFlag]&) -> bool:
#       return value[OtherFlag.Other]          # error: flags index expects RoutineFlag, got OtherFlag
#
# SOUND subset: fire only when the receiver is a parameter of type `Flags[E]` and the index is
# a const-enum variant access `X.Variant` where X differs from E. Non-parameter receivers or
# non-enum indices are conservative misses.
extend Semantic:
    private:
        # The flag enum E of a `Flags[E]` parameter type (peeling `&`/`mutable`/paren), else "".
        def fit_flags_element(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return fit_flags_element(operand)
                    Expr.Paren(inner, paren_line):
                        return fit_flags_element(inner)
                    Expr.Index(head, argument, index_line):
                        ident_name_of(argument) return if ident_name_of(head) == "Flags"
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # The enum name of a const-enum variant access `X.Variant` / `X::Variant`, else "".
        def fit_index_enum(index_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match index_expression:
                    Expr.Field(object, field, field_line):
                        return ident_name_of(object)
                    Expr.Scope(base, name, scope_line):
                        return ident_name_of(base)
                    _:
                        return sview("", 0, 0)

        def fit_param_flags_element(parameters: darray[Ast::ParamDecl]&, name: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters:
                    fit_flags_element(parameter.type_expression) return if parameter.name == name
                return sview("", 0, 0)

        def fit_check_expression(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index_argument, index_line):
                        match object:
                            Expr.Ident(object_name, object_ident_line):
                                flag_enum: sview = fit_param_flags_element(parameters, object_name)
                                index_enum: sview = fit_index_enum(index_argument)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlagsIndexType, name: "", pos: index_line, line: index_line.line, expected: flag_enum, actual: index_enum}) if flag_enum != "" and index_enum != "" and flag_enum != index_enum
                            _:
                                pass
                        table <- fit_check_expression(object, parameters, table)
                        table <- fit_check_expression(index_argument, parameters, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- fit_check_expression(left, parameters, table)
                        table <- fit_check_expression(right, parameters, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- fit_check_expression(operand, parameters, table)
                    Expr.Paren(inner, paren_line):
                        table <- fit_check_expression(inner, parameters, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- fit_check_expression(argument, parameters, table)
                    _:
                        pass

        def fit_check_statements(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- fit_check_expression(returned, parameters, table)
                        Stmt.Expr(expression, line):
                            table <- fit_check_expression(expression, parameters, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- fit_check_expression(value, parameters, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- fit_check_expression(value, parameters, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- fit_check_expression(condition, parameters, table)
                            table <- fit_check_statements(then_body, parameters, table)
                            table <- fit_check_statements(else_body, parameters, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- fit_check_expression(condition, parameters, table)
                            table <- fit_check_statements(while_body, parameters, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- fit_check_statements(for_body, parameters, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- fit_check_statements(body, parameters, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- fit_check_statements(arm.body, parameters, table)
                        _:
                            pass

        def fit_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- fit_check_statements(body, parameters, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- fit_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fit_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_flags_index_type(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- fit_check_declarations(file.top_decls, table)
