# `extend Foo:` adds members to a module that ALREADY EXISTS. Extending one that was never
# declared is a typo catcher, and stage0 refuses it:
#
#     extend WbProtocol::Contract:      # no `module WbProtocol::Contract:` anywhere in the unit
#         public:
#             def helper() -> i64: ...
#
#     stage0: no module "WbProtocol.Contract" to extend; declare it with
#             `module WbProtocol.Contract:` first (...)
#
# stage1 had NO such check and accepted the file silently. That is the PERMISSIVE direction --
# the one no census of stage1's own source can see, because the compiler declares every module
# it extends. It surfaced from a PORT: a file built cleanly on stage1 and was then rejected by
# stage0, so the gap only showed up when someone ran the oracle.
#
# Both compilers collect every declaration first and validate afterwards, so the check is
# FILE-ORDER independent: `extend Foo:` may precede `module Foo:` in the source.
#
# The same pass carries stage0's sibling rule: a module DECLARED TWICE is an error, and the
# second block should have been `extend Foo:`. stage1 accepted that silently too. Its message
# names the FIRST declaration's position, which only the driver can render (the source path and
# the `#line` remapping both live there), so the check records that position on the diagnostic
# and the driver turns it into text -- see Diagnostic.secondary_line.
extend Semantic:
    private:
        # Is the `Decl.Module` node at `pos` an `extend` block rather than a `module`
        # declaration? The parser gives both forms the SAME node and records the provenance in
        # a `__compiler_extension_module` annotation, keyed by the module's qualified name and
        # the keyword token's line -- the same token this node's `pos` came from, so the two
        # agree even after `#line` renumbering.
        def mext_is_extension(annotations: darray[Ast::EnumAnnotation]&, name: sview, pos: Ast::Pos) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    true return if annotation.owner == "__compiler_extension_module" and annotation.name == name and annotation.line == pos.line
                return false


        # The static-if ROW a `Decl.Scoped` branch was parsed from (its pos is the `static`
        # keyword, the line the parser recorded), or -1 for a Scoped that is not a branch.
        def mext_branch_row(static_if_lines: darray[u32]&, line: u32) -> i64:
            can Abort.Panic:
                for row in 0..<static_if_lines.count:
                    row.i64() return if static_if_lines[row] == line
                return -1

        # The row that opens the chain `row` belongs to: walk back over same-depth
        # `elif`/`else` rows (kind != 0) to the `if` (kind 0). Two modules declared in
        # DIFFERENT branches of ONE chain can never both exist, so they are not duplicates;
        # stage0 reaches the same answer by walking only the active branch.
        def mext_chain_row(static_if_kinds: darray[u32]&, static_if_depths: darray[u32]&, row: i64) -> i64:
            can Abort.Panic:
                start: mutable i64 = row
                depth: u32 = static_if_depths[row.usize()]
                while start > 0 and static_if_kinds[start.usize()] != 0 |start|:
                    start <- start - 1
                    # Skip rows of a NESTED chain recorded between this chain's arms.
                    while start > 0 and static_if_depths[start.usize()] > depth |start|:
                        start <- start - 1
                return start

        # Split the unit's module nodes into the names DECLARED and the sites that EXTEND.
        # Nested modules are already recorded under their qualified name by the parser
        # (`qualify_nested_module_name`), so the bodies are walked without threading a
        # namespace. `Decl.Scoped` is a static-if branch or impl body: a module may be
        # declared inside one.
        def mext_collect(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, static_if_lines: darray[u32]&, static_if_kinds: darray[u32]&, static_if_depths: darray[u32]&, chain: i64, branch: i64, declared: mutable darray[sview]&, declared_lines: mutable darray[u32]&, declared_columns: mutable darray[u32]&, declared_end_columns: mutable darray[u32]&, declared_chains: mutable darray[i64]&, declared_branches: mutable darray[i64]&, extend_names: mutable darray[sview]&, extend_lines: mutable darray[u32]&, extend_columns: mutable darray[u32]&, extend_end_columns: mutable darray[u32]&, extend_offsets: mutable darray[u32]&, extend_end_offsets: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Module(module_name, module_body, module_pos):
                            if mext_is_extension(annotations, module_name, module_pos):
                                extend_names.push(module_name)
                                extend_lines.push(module_pos.line)
                                extend_columns.push(module_pos.column)
                                extend_end_columns.push(module_pos.end_column)
                                extend_offsets.push(module_pos.offset)
                                extend_end_offsets.push(module_pos.end_offset)
                            else:
                                declared.push(module_name)
                                declared_lines.push(module_pos.line)
                                declared_columns.push(module_pos.column)
                                declared_end_columns.push(module_pos.end_column)
                                declared_chains.push(chain)
                                declared_branches.push(branch)
                            mext_collect(module_body, annotations, static_if_lines, static_if_kinds, static_if_depths, chain, branch, declared, declared_lines, declared_columns, declared_end_columns, declared_chains, declared_branches, extend_names, extend_lines, extend_columns, extend_end_columns, extend_offsets, extend_end_offsets)
                        Decl.Scoped(scoped_body, scoped_pos):
                            row: i64 = mext_branch_row(static_if_lines, scoped_pos.line)
                            scoped_chain: i64 = mext_chain_row(static_if_kinds, static_if_depths, row) if row >= 0 else chain
                            scoped_branch: i64 = row if row >= 0 else branch
                            mext_collect(scoped_body, annotations, static_if_lines, static_if_kinds, static_if_depths, scoped_chain, scoped_branch, declared, declared_lines, declared_columns, declared_end_columns, declared_chains, declared_branches, extend_names, extend_lines, extend_columns, extend_end_columns, extend_offsets, extend_end_offsets)
                        _:
                            pass

    public:
        def check_module_extension_target(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                declared: mutable darray[sview] = []
                declared_lines: mutable darray[u32] = []
                declared_columns: mutable darray[u32] = []
                declared_end_columns: mutable darray[u32] = []
                declared_chains: mutable darray[i64] = []
                declared_branches: mutable darray[i64] = []
                extend_names: mutable darray[sview] = []
                extend_lines: mutable darray[u32] = []
                extend_columns: mutable darray[u32] = []
                extend_end_columns: mutable darray[u32] = []
                extend_offsets: mutable darray[u32] = []
                extend_end_offsets: mutable darray[u32] = []
                mext_collect(file.top_decls, file.enum_annotations, file.static_if_lines, file.static_if_kinds, file.static_if_depths, -1, -1, declared, declared_lines, declared_columns, declared_end_columns, declared_chains, declared_branches, extend_names, extend_lines, extend_columns, extend_end_columns, extend_offsets, extend_end_offsets)
                # Collected in source order, so the FIRST entry for a name is the one the
                # message points back at and every later entry is the error.
                for later in 0..<declared.count |table, declared, declared_lines, declared_columns, declared_end_columns, declared_chains, declared_branches|:
                    first: mutable i64 = -1
                    for earlier in 0..<later |first, declared, declared_chains, declared_branches, later|:
                        exclusive: bool = declared_chains[earlier] >= 0 and declared_chains[earlier] == declared_chains[later] and declared_branches[earlier] != declared_branches[later]
                        first <- earlier.i64() if first < 0 and declared[earlier] == declared[later] and not exclusive
                    if first >= 0:
                        origin: usize = first.usize()
                        site: Ast::Pos = Ast::Pos{line: declared_lines[later], column: declared_columns[later], offset: 0, end_line: declared_lines[later], end_column: declared_end_columns[later], end_offset: 0}
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ModuleRedeclared, name: declared[later], line: declared_lines[later], pos: site, expected: "", actual: "", secondary_line: declared_lines[origin], secondary_column: declared_columns[origin], secondary_end_column: declared_end_columns[origin]})
                for index in 0..<extend_names.count |table, declared, extend_names, extend_lines, extend_columns, extend_end_columns, extend_offsets, extend_end_offsets|:
                    extended: sview = extend_names[index]
                    known: mutable bool = false
                    for declared_name in declared |known, extended|:
                        known <- true if declared_name == extended
                    if not known:
                        site: Ast::Pos = Ast::Pos{line: extend_lines[index], column: extend_columns[index], offset: extend_offsets[index], end_line: extend_lines[index], end_column: extend_end_columns[index], end_offset: extend_end_offsets[index]}
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExtendUnknownModule, name: extended, line: extend_lines[index], pos: site, expected: "", actual: ""})
