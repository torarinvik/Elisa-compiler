extend Semantic:
    private:
        # `darray[M::T]`: annotation_type_id has no `Expr.Scope` arm, so a module-qualified
        # element interns to 0 and the interned path above yields "". Read the field's
        # annotation directly: the element counts only when its last segment names a
        # declared struct or enum, keyed like the interned path (a name collision across
        # modules only merges keys, which costs precision, never soundness).
        def storage_view_qualified_darray_elem(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        return storage_view_qualified_darray_elem(operand, table) if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return ""
                    Expr.Index(indexed_head, index_argument, _):
                        return "" if ident_name_of(indexed_head) != "darray"
                        match index_argument:
                            Expr.Scope(_, element_name, _):
                                return element_name if:
                                    element_name != "" and storage_view_struct_segment_known(table, element_name)
                                    element_name != "" and storage_view_enum_segment_known(table, element_name)
                                return ""
                            _:
                                return ""
                    _:
                        return ""

        # `storage_view_last_segment(owner) == name` without walking OWNER: true exactly when
        # OWNER ends in NAME at a `:` boundary (or is NAME) and NAME itself holds no `:`. The
        # callers probe every struct-field / enum-variant owner row per darray element, so the
        # byte walk of each owner showed up in self-host profiles.
        def storage_view_segment_is(owner: sview, name: sview) -> bool:
            can Abort.Panic:
                owner_length: usize = owner.len
                name_length: usize = name.len
                return false if name_length > owner_length
                prefix: usize = owner_length - name_length
                return false if:
                    prefix > 0 and owner[prefix - 1] != ':'
                    string_view_slice(owner, i64(prefix), i64(owner_length)) != name
                for position in 0..<name_length |name|:
                    return false if name[position] == ':'
                return true

        # `any owner in table.struct_field_owner where storage_view_segment_is(owner, NAME)`:
        # for a NAME without `:` that is exactly "some owner's last segment is NAME", so the
        # hashed segment index answers it; otherwise (or with a stale index) scan as before.
        def storage_view_struct_segment_known(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                if table.storage_struct_segments_built and table.storage_struct_segment_source_count == table.struct_field_owner.count and not storage_view_has_colon(name):
                    row: mutable u32 = head if table.storage_struct_segment_heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE
                    while row != SYMBOL_INDEX_ROW_NONE |row, table, name|:
                        return true if table.storage_struct_segments[row.usize()] == name
                        row <- table.storage_struct_segment_next[row.usize()]
                    return false
                return any owner in table.struct_field_owner where storage_view_segment_is(owner, name)

        def storage_view_enum_segment_known(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                if table.storage_enum_segments_built and table.storage_enum_segment_source_count == table.enum_variant_owner.count and not storage_view_has_colon(name):
                    row: mutable u32 = head if table.storage_enum_segment_heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE
                    while row != SYMBOL_INDEX_ROW_NONE |row, table, name|:
                        return true if table.storage_enum_segments[row.usize()] == name
                        row <- table.storage_enum_segment_next[row.usize()]
                    return false
                return any owner in table.enum_variant_owner where storage_view_segment_is(owner, name)

        def storage_view_has_colon(name: sview) -> bool:
            can Abort.Panic:
                for byte in name:
                    return true if byte == ':'
                return false

        def storage_view_index_segments(table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # These indexes answer only existential membership. Keep one row per exact
                # leaf name so a type with many fields/variants does not lengthen its own
                # hash chain; different strings with the same hash remain separate rows.
                table.storage_struct_segments <- []
                table.storage_struct_segment_next <- []
                table.storage_struct_segment_heads <- {}
                for owner in table.struct_field_owner |table|:
                    segment: sview = storage_view_last_segment(owner)
                    hash: u64 = name_hash(segment)
                    previous: u32 = head if table.storage_struct_segment_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                    duplicate: mutable bool = false
                    candidate: mutable u32 = previous
                    while candidate != SYMBOL_INDEX_ROW_NONE and not duplicate |candidate, duplicate, table, segment|:
                        duplicate <- true if table.storage_struct_segments[candidate.usize()] == segment
                        candidate <- table.storage_struct_segment_next[candidate.usize()]
                    if not duplicate:
                        table.storage_struct_segment_heads <- table.storage_struct_segment_heads.put(hash, table.storage_struct_segments.count.u32()) can Global{Read,Write}
                        table.storage_struct_segment_next <- table.storage_struct_segment_next.push(previous)
                        table.storage_struct_segments <- table.storage_struct_segments.push(segment)
                table.storage_struct_segment_source_count <- table.struct_field_owner.count
                table.storage_struct_segments_built <- true
                table.storage_enum_segments <- []
                table.storage_enum_segment_next <- []
                table.storage_enum_segment_heads <- {}
                for owner in table.enum_variant_owner |table|:
                    segment: sview = storage_view_last_segment(owner)
                    hash: u64 = name_hash(segment)
                    previous: u32 = head if table.storage_enum_segment_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                    duplicate: mutable bool = false
                    candidate: mutable u32 = previous
                    while candidate != SYMBOL_INDEX_ROW_NONE and not duplicate |candidate, duplicate, table, segment|:
                        duplicate <- true if table.storage_enum_segments[candidate.usize()] == segment
                        candidate <- table.storage_enum_segment_next[candidate.usize()]
                    if not duplicate:
                        table.storage_enum_segment_heads <- table.storage_enum_segment_heads.put(hash, table.storage_enum_segments.count.u32()) can Global{Read,Write}
                        table.storage_enum_segment_next <- table.storage_enum_segment_next.push(previous)
                        table.storage_enum_segments <- table.storage_enum_segments.push(segment)
                table.storage_enum_segment_source_count <- table.enum_variant_owner.count
                table.storage_enum_segments_built <- true

        def storage_view_last_segment(name: sview) -> sview:
            can Abort.Panic:
                start: mutable usize = 0
                length: usize = name.len
                for position in 0..<length |start, name|:
                    start <- position + 1 if name[position] == ':'
                return string_view_slice(name, i64(start), i64(length))

        # Whether CALLEE's positional parameter POSITION is a `mutable T&` borrow whose type can
        # hold relocatable storage. Only a scalar pointee is known not to: a darray, a struct
        # with a darray field or a generic may be grown by the callee through the borrow.
        # Advance a call-local cursor to POSITION in CALLEE's flattened parameter rows.
        # Callers ask for positions in ascending order, so one invocation continues where
        # the previous one stopped instead of restarting the same-hash chain per argument.
        def storage_callee_param_may_relocate_at(table: SymbolTable&, callee: sview, position: usize, cur: mutable u32&, seen: mutable usize&) -> bool:
            can Abort.Panic:
                while cur != 4294967295:
                    row: usize = cur.usize()
                    cur <- table.function_param_name_next[row]
                    if table.function_param_owner[row] == callee:
                        if seen == position:
                            seen <- seen + 1
                            return table.function_param_mutable_ref[row] and not storage_scalar_pointee(table.function_param_type_id[row], table)
                        seen <- seen + 1
                return false

        # One-shot query for callers that do not visit positions sequentially. Ordered
        # argument walkers keep a cursor and use the helper above to avoid rescanning.
        def storage_callee_param_may_relocate(table: SymbolTable&, callee: sview, position: usize) -> bool:
            can Abort.Panic:
                cur: mutable u32 = function_param_chain_head(table, callee)
                seen: mutable usize = 0
                return storage_callee_param_may_relocate_at(table, callee, position, cur, seen)

        # Whether TYPE_ID, seen through reference/optional layers, is a scalar. Unknown (0) is
        # NOT scalar: an unmodeled parameter type must keep invalidating. Optional scalar
        # pointers (for example `u8&?&`) carry a pointer value, not a relocatable container.
        def storage_scalar_pointee(type_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                current: mutable u32 = type_id
                while current != 0 and (interned_kind(current, table) == SemTypeKind.Ref or interned_kind(current, table) == SemTypeKind.Optional) and interned_elem_count(current, table) == 1:
                    current <- interned_elem(current, 0, table)
                kind: SemTypeKind = interned_kind(current, table)
                return current != 0 and (kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char)

        # Container roots a call relocates through a user function's `mutable T&` parameters
        # (`grow(&xs)` where `def grow(ys: mutable darray[i64]&)` pushes). The callee is
        # analysed in its own scope, so the call site is the only place that can see an
        # interior reference into `xs` outlive the growth. Nested calls in arguments count.
        def callee_relocation_targets(expression: Ast::Expr, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        param_cursor: mutable u32 = 4294967295
                        param_cursor_ready: mutable bool = false
                        seen_params: mutable usize = 0
                        for argument in arguments |position: usize = 0, out, callee_name, table, param_cursor, param_cursor_ready, seen_params|:
                            callee_relocation_targets(argument, table, out) can Global{Read,Write}
                            root: sview = storage_view_place_root(argument) if callee_name != "" else ""
                            may_relocate: mutable bool = false
                            if root != "" and callee_name != "":
                                if not param_cursor_ready:
                                    param_cursor <- function_param_chain_head(table, callee_name)
                                    param_cursor_ready <- true
                                may_relocate <- storage_callee_param_may_relocate_at(table, callee_name, position, param_cursor, seen_params)
                            callee_relocation_summarised(root, argument, callee_name, position, table, out) can Global{Read,Write} if root != "" and may_relocate
                            position <- position + 1
                        # Receiver form `xs.grow()` / `b.add(v)`: the receiver is the callee's
                        # first parameter, so the arguments shift by one.
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                if callee_name == "" and function_param_chain_head(table, method) != 4294967295:
                                    method_cursor: mutable u32 = function_param_chain_head(table, method)
                                    method_seen: mutable usize = 0
                                    callee_relocation_targets(receiver, table, out) can Global{Read,Write}
                                    receiver_root: sview = storage_view_place_root(receiver)
                                    receiver_may_relocate: bool = storage_callee_param_may_relocate_at(table, method, 0, method_cursor, method_seen) if receiver_root != "" else false
                                    callee_relocation_summarised(receiver_root, receiver, method, 0, table, out) can Global{Read,Write} if receiver_root != "" and receiver_may_relocate
                                    for argument in arguments |shifted: usize = 1, out, method, table, method_cursor, method_seen|:
                                        argument_root: sview = storage_view_place_root(argument)
                                        argument_may_relocate: bool = storage_callee_param_may_relocate_at(table, method, shifted, method_cursor, method_seen) if argument_root != "" else false
                                        callee_relocation_summarised(argument_root, argument, method, shifted, table, out) can Global{Read,Write} if argument_root != "" and argument_may_relocate
                                        shifted <- shifted + 1
                            _:
                                pass
                    Expr.Paren(inner, line):
                        callee_relocation_targets(inner, table, out) can Global{Read,Write}
                    Expr.Unary(operator, operand, line):
                        callee_relocation_targets(operand, table, out) can Global{Read,Write}
                    Expr.Binary(left, operator, right, line):
                        callee_relocation_targets(left, table, out) can Global{Read,Write}
                        callee_relocation_targets(right, table, out) can Global{Read,Write}
                    _:
                        pass

        # A relocating argument mapped through the callee's field-growth summary: a bare
        # root invalidates only the fields the callee grows; `root.f` (or a deeper place)
        # survives a callee that grows nothing. Unsummarised callees keep the old pairs.
        def callee_relocation_summarised(root: sview @source, argument: Ast::Expr, callee: sview, position: usize, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[sview @source] = []
                if not param_growth_fields(table, callee, position, fields) can Global{Read,Write}:
                    callee_relocation_push(root, storage_view_direct_field(argument), out)
                    return
                return if fields.count == 0
                if storage_view_place_root(argument) == root and pgs_top_field(argument, root) == "" and storage_view_direct_field(argument) == "" and pgs_is_bare(argument, root):
                    for field in fields |root, out|:
                        callee_relocation_push(root, field, out)
                    return
                callee_relocation_push(root, storage_view_direct_field(argument), out)

        # Flat (root, field) pairs: FIELD is the direct field `f` when the relocating argument is
        # exactly `root.f` (the callee can only grow that field), else "" for the whole root.
        def callee_relocation_push(root: sview @source, field: sview @source, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if root == "" or root == "[held]"
                pair: mutable usize = 0
                while pair + 1 < out.count |pair, out, root, field|:
                    return if out[pair] == root and out[pair + 1] == field
                    pair <- pair + 2
                out.push(root)
                out.push(field)

        def invalidate_callee_relocations(expression: Ast::Expr, field_elems: darray[sview]&, function_line: u32, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&, stable_regions: darray[sview @source]&, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview @source]&, invalidated_by: mutable darray[sview @source]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                targets: mutable darray[sview @source] = []
                callee_relocation_targets(expression, table, targets) can Global{Read,Write}
                pair: mutable usize = 0
                while pair + 1 < targets.count |pair, targets, field_elems, invalidated, invalidated_by|:
                    invalidate_growth_aliases(targets[pair], targets[pair + 1], field_elems, function_line, line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                    pair <- pair + 2

        def invalidated_alias_in_expression(expression: Ast::Expr, invalidated: darray[sview @source]&) -> sview can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.Ident(name, line):
                    return name if fresh_wrapper_name_exists(invalidated, name) else ""
                Expr.Field(receiver, field, line):
                    return invalidated_alias_in_expression(receiver, invalidated)
                Expr.Index(object, index, line):
                    return invalidated_alias_in_expression(object, invalidated)
                Expr.IndexN(object, arguments, line):
                    return invalidated_alias_in_expression(object, invalidated)
                Expr.Unary(operator, operand, line):
                    return invalidated_alias_in_expression(operand, invalidated)
                Expr.Paren(inner, line) | Expr.Move(inner, line):
                    return invalidated_alias_in_expression(inner, invalidated)
                # `match t:` in value position reads the scrutinee (an enum holding a view).
                Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                    return invalidated_alias_in_expression(scrutinee, invalidated)
                Expr.Call(callee, arguments, argument_names, line):
                    from_callee: sview = invalidated_alias_in_expression(callee, invalidated)
                    return from_callee if from_callee != ""
                    return invalidated_alias_in_arguments(arguments, invalidated)
                Expr.Binary(left, operator, right, line):
                    found_left: sview = invalidated_alias_in_expression(left, invalidated)
                    return found_left if found_left != ""
                    return invalidated_alias_in_expression(right, invalidated)
                Expr.If(condition, then_value, else_value, line):
                    # The condition is evaluated first: `x if v[0] == 1 else y` reads `v`.
                    found_condition: sview = invalidated_alias_in_expression(condition, invalidated)
                    return found_condition if found_condition != ""
                    found_then: sview = invalidated_alias_in_expression(then_value, invalidated)
                    return found_then if found_then != ""
                    return invalidated_alias_in_expression(else_value, invalidated)
                Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                    return invalidated_alias_in_arguments(elements, invalidated)
                # `submit f(v)` / `await t` parse as a statement-less value block around the
                # operand; without this arm a stale view handed to a task was never seen.
                Expr.Block(block_statements, block_value, block_captures, line):
                    return invalidated_alias_in_expression(block_value, invalidated) if block_statements.count == 0
                    return ""
                _:
                    return ""

        def invalidated_alias_in_arguments(arguments: darray[Ast::Expr]&, invalidated: darray[sview @source]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = ""
                for argument in arguments |found, invalidated|:
                    found <- invalidated_alias_in_expression(argument, invalidated) if found == ""
                return found

        def diagnose_invalidated_alias(expression: Ast::Expr, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, invalidated: darray[sview @source]&, invalidated_by: darray[sview @source]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias: sview = invalidated_alias_in_expression(expression, invalidated)
                by: sview =
                    for candidate_index in 0..<invalidated.count |by: sview = ""| -> by:
                        by <- invalidated_by[candidate_index] if invalidated[candidate_index] == alias and candidate_index < invalidated_by.count
                moved: bool = by != "" and storage_view_container_moved(by, alias_names, alias_sources)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StorageDependencyInvalidated, name: alias, pos: ident_extent_or_line(expression, line), line: line, expected: by, actual: "move" if moved else ""}) if alias != ""

        # `move xs` (a consuming call argument, a value, or a `for e in move xs` drain) hands
        # xs's buffer and elements to a new owner: every view or interior reference taken into
        # xs before it is stale from then on, exactly as after a relocating push (stage0
        # invalidateStorageViewsForMovedContainer; fuzz F16). A `"[moved]"` marker row records
        # the move so the diagnostic says "move of xs".
        def storage_view_container_moved(name: sview, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&) -> bool:
            can Abort.Panic:
                for index in 0..<alias_names.count:
                    return true if alias_names[index] == "[moved]" and index < alias_sources.count and alias_sources[index] == name
                return false

        def storage_view_collect_moves(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Move(Expr.Ident(moved_name, _), _):
                        out.push(moved_name) if not fresh_wrapper_name_exists(out, moved_name)
                    Expr.Move(inner, _) | Expr.Paren(inner, _):
                        storage_view_collect_moves(inner, out)
                    Expr.Call(callee, arguments, _, _):
                        storage_view_collect_moves(callee, out)
                        for argument in arguments |out|:
                            storage_view_collect_moves(argument, out)
                    Expr.Field(object, _, _):
                        storage_view_collect_moves(object, out)
                    Expr.Binary(left, _, right, _):
                        storage_view_collect_moves(left, out)
                        storage_view_collect_moves(right, out)
                    Expr.Unary(_, operand, _):
                        storage_view_collect_moves(operand, out)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements |out|:
                            storage_view_collect_moves(element, out)
                    Expr.Construct(_, fields, _):
                        for field in fields |out|:
                            storage_view_collect_moves(field.value, out)
                    _:
                        pass

        def invalidate_moved_containers(expression: Ast::Expr, field_elems: darray[sview]&, function_line: u32, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&, stable_regions: darray[sview @source]&, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, invalidated: mutable darray[sview @source]&, invalidated_by: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                moved: mutable darray[sview @source] = []
                storage_view_collect_moves(expression, moved)
                for moved_name in moved |alias_names, alias_sources, alias_is_view, invalidated, invalidated_by|:
                    invalidate_growth_aliases(moved_name, "", field_elems, function_line, line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                    if not storage_view_container_moved(moved_name, alias_names, alias_sources):
                        alias_names.push("[moved]")
                        alias_sources.push(moved_name)
                        alias_is_view.push(false)

        # A plain darray and a darray in malloc/chained/scratch storage can move its backing
        # buffer when it grows. Only reserve_commit and fixed are single-block backings whose
        # base remains stable. This mirrors stage0's storage-view dependency rule: an absent
        # region is deliberately treated as relocatable rather than silently accepted.
        def storage_backing_is_stable(region: sview, stable_regions: darray[sview @source]&) -> bool:
            return region != "" and destroyed_region_contains(stable_regions, region)

        def invalidate_growth_aliases(target: sview @source, target_field: sview, field_elems: darray[sview]&, function_line: u32, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&, stable_regions: darray[sview @source]&, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview @source]&, invalidated_by: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                region: sview = function_region_of_name(annotations, target, function_line, line) can Global{Read,Write}
                return if target == "" or storage_backing_is_stable(region, stable_regions)
                # `target` itself is tested directly below, so the list holds only the
                # target's alias sources and stays empty (allocation-free) in the common case.
                # The `[target]` literal used to be allocated on every call, and in a function
                # with mutable darray& params it lands in the caller's arena and never dies:
                # ~106 MB of a 1.6 GB peak (tools/memprof --live, stage1-built compiler).
                target_sources: mutable darray[sview @source] = []
                for alias_index in 0..<alias_names.count |target_sources, alias_names, alias_sources, target|:
                    held_row: bool = alias_index > 0 and alias_names[alias_index - 1] == target and alias_sources[alias_index - 1] == "[held]"
                    storage_view_push_source(alias_sources[alias_index], target_sources) if alias_names[alias_index] == target and alias_index < alias_sources.count and not held_row and alias_sources[alias_index] != "[held]"
                for source in alias_sources |index: usize = 0, invalidated, target_sources, alias_names, alias_is_view, invalidated_by, target|:
                    # Growing through a name relocates the buffer it owns or points to, never the
                    # name itself: `__with_place = &rows[i]` then `__with_place.names += x` must
                    # not invalidate __with_place (its own row matches via target_sources).
                    # Views INTO that buffer are still rows whose source is `target`.
                    own_row: bool = index < alias_names.count and alias_names[index] == target
                    if not own_row and (source == target or any owner_source in target_sources where owner_source == source) and not storage_view_row_spared(index, target, target_field, field_elems, alias_names, alias_sources):
                        invalidated.push(alias_names[index]) if index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and not fresh_wrapper_name_exists(invalidated, alias_names[index])
                        invalidated_by.push(target) if index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and invalidated.count > invalidated_by.count
                    index <- index + 1

        # A whole assignment `xs <- [..]` of a darray/dict/set frees the buffer every interior
        # view of `xs` points into (stage0: invalidateStorageViewsForWholeAssignment). Only
        # names whose declared type is the container itself qualify, or a by-reference param
        # with an immutable binding (`<-` then writes the caller's container). A mutable ref
        # binding rebinds instead, and a name also declared with another type is left out:
        # the walk has no scope-accurate type, so an ambiguous name is a sound miss.
        def storage_view_type_is_replaceable(type_expression: Ast::Expr, allow_reference: bool) -> bool:
            can Abort.Panic:
                current: mutable Ast::Expr = type_expression
                through_reference: mutable bool = false
                while true |current, through_reference|:
                    match current:
                        Expr.Unary(operator, operand, line):
                            return false if:
                                operator != TokenKind.Mutable and operator != TokenKind.Ampersand
                                operator == TokenKind.Ampersand and (through_reference or not allow_reference)
                            through_reference <- true if operator == TokenKind.Ampersand
                            current <- operand
                        Expr.Paren(operand, line):
                            current <- operand
                        Expr.Index(head, argument, line) | Expr.IndexN(head, arguments, line):
                            head_name: sview = ident_name_of(head)
                            return head_name == "darray" or head_name == "dict" or head_name == "set"
                        # `out <- "..."` on a dstr frees the bytes `out.as_sview()` pointed at.
                        Expr.Ident(type_name, line):
                            return type_name == "dstr"
                        _:
                            return false
                return false

        def storage_view_element_is_replaceable(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line) | Expr.Paren(operand, line):
                        return storage_view_element_is_replaceable(operand)
                    Expr.Index(head, argument, line):
                        return ident_name_of(head) == "darray" and storage_view_type_is_replaceable(argument, false)
                    _:
                        return false

        # `grid: darray[darray[T]]` records a (grid, "[]") row: replacing an element
        # `grid[i] <- ..` frees that row's buffer, so it invalidates views of grid too.
        def storage_view_has_element_marker(alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, name: sview) -> bool:
            can Abort.Panic:
                for index in 0..<alias_names.count |alias_names, alias_sources, name|:
                    return true if alias_names[index] == name and index < alias_sources.count and alias_sources[index] == "[]"
                return false

        # One body walk feeds the replaceable-name sets, local-type index, and deferred
        # field-view candidates. Candidates are resolved after this walk so type-owner
        # ambiguity still sees the complete local type table.
        # The `collect_local_types` flag is false inside Expr.Block: replacement analysis
        # descends into those expression bodies, while the local-type and field-view collectors
        # historically did not. Keeping that distinction preserves their candidate sets.
        def storage_view_collect_declarations(statements: darray[Ast::Stmt]&, names: mutable darray[sview @source]&, others: mutable darray[sview @source]&, local_names: mutable darray[sview @source]&, local_types: mutable darray[Ast::Expr]&, collect_local_types: bool, field_candidate_names: mutable darray[sview @source]&, field_candidate_values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if collect_local_types:
                                local_names.push(name)
                                local_types.push(type_expression)
                                field_candidate_names.push(name)
                                field_candidate_values.push(value)
                            if storage_view_type_is_replaceable(type_expression, false):
                                names.push(name)
                            else:
                                others.push(name)
                            storage_view_collect_declarations_expr(value, names, others, local_names, local_types, field_candidate_names, field_candidate_values)
                        Stmt.Expr(expression, line):
                            storage_view_collect_declarations_expr(expression, names, others, local_names, local_types, field_candidate_names, field_candidate_values)
                        Stmt.If(condition, then_body, else_body, line):
                            storage_view_collect_declarations(then_body, names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values)
                            storage_view_collect_declarations(else_body, names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values)
                        Stmt.While(condition, body, line):
                            storage_view_collect_declarations(body, names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values)
                        Stmt.For(bind, variables, iterable, body, line):
                            others.push(bind)
                            for variable in variables |others|:
                                others.push(variable)
                            storage_view_collect_declarations(body, names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values)
                        Stmt.Block(kind, clause, binding, body, line):
                            others.push(binding) if binding != ""
                            storage_view_collect_declarations(body, names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values|:
                                storage_view_collect_declarations(arm.body, names, others, local_names, local_types, collect_local_types, field_candidate_names, field_candidate_values)
                        _:
                            pass

        def storage_view_collect_declarations_expr(expression: Ast::Expr, names: mutable darray[sview @source]&, others: mutable darray[sview @source]&, local_names: mutable darray[sview @source]&, local_types: mutable darray[Ast::Expr]&, field_candidate_names: mutable darray[sview @source]&, field_candidate_values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Block(statements, value, captures, line):
                        storage_view_collect_declarations(statements, names, others, local_names, local_types, false, field_candidate_names, field_candidate_values)
                    _:
                        pass

        def storage_view_drop_shadowed(names: mutable darray[sview @source]&, others: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                kept: mutable darray[sview @source] = []
                # Keep linear scans for small inputs and for one candidate: a single scan
                # of `others` is cheaper than building an index. Multiple candidates with
                # large `others`, or a large candidate list, use the indexed path.
                if names.count < 16 and (others.count < 16 or names.count <= 1):
                    for name in names |kept, others|:
                        kept.push(name) if name != "" and not fresh_wrapper_name_exists(others, name) and not fresh_wrapper_name_exists(kept, name)
                else:
                    # Large local-name lists used to rescan `others` and the growing `kept`
                    # array for every candidate, making this filter quadratic. Keep the
                    # output in first-seen order while using collision-safe exact-name sets.
                    shadowed: mutable NameSet = empty_name_set()
                    seen: mutable NameSet = empty_name_set()
                    for name in others |shadowed|:
                        name_set_add(shadowed, name) if name != ""
                    for name in names |kept, shadowed, seen|:
                        if name != "" and not name_set_contains(shadowed, name) and not name_set_contains(seen, name):
                            kept.push(name)
                            name_set_add(seen, name)
                names.truncate(0)
                for name in kept |names|:
                    names.push(name)

        # The struct type named by OBJECT: a local whose every declaration names the same
        # type, or a field whose row is a named type. "" when it is not known.
        def storage_view_field_owner(object: Ast::Expr, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match object:
                    Expr.Ident(name, line):
                        owner: mutable sview = ""
                        for index in 0..<local_names.count |owner, local_names, local_types, name|:
                            if local_names[index] == name and index < local_types.count:
                                declared: sview = storage_view_declared_type_name(local_types[index])
                                return "" if declared == "" or (owner != "" and owner != declared)
                                owner <- declared
                        return owner
                    Expr.Field(inner, field, line):
                        type_id: u32 = storage_view_field_chain_type_id(object, local_names, local_types, table)
                        return interned_name(type_id, table) if type_id != 0 and interned_kind(type_id, table) == SemTypeKind.Named else ""
                    _:
                        return ""

        # `S`, `mutable S`, `S&` and `mutable S&` all name S: a reference root reaches the same
        # struct storage.
        def storage_view_declared_type_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                current: mutable Ast::Expr = type_expression
                while true:
                    match current:
                        Expr.Unary(operator, operand, line):
                            return "" if operator != TokenKind.Mutable and operator != TokenKind.Ampersand and operator != TokenKind.Lmut
                            current <- operand
                        Expr.Paren(inner, line):
                            current <- inner
                        _:
                            return ident_name_of(current)
                return ""

        def storage_view_field_chain_type_id(chain: Ast::Expr, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match chain:
                    Expr.Field(object, field, line):
                        owner: sview = storage_view_field_owner(object, local_names, local_types, table)
                        return 0 if owner == ""
                        return pag_struct_field_type_id(owner, field, table)
                    _:
                        return 0

        # The field chain `s.items` indexed by `&s.items[i]`, when VALUE is that borrow.
        def storage_view_field_element_head(value: Ast::Expr, head: mutable Ast::Expr&) -> bool:
            current: mutable Ast::Expr = value
            borrowed: mutable bool = false
            while true:
                match current:
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        current <- inner
                    Expr.Unary(operator, operand, line):
                        return false if operator != TokenKind.Ampersand or borrowed
                        borrowed <- true
                        current <- operand
                    Expr.Index(object, index, line):
                        return false if not borrowed
                        match object:
                            Expr.Field(inner, field, field_line):
                                head <- object
                                return true
                            _:
                                return false
                    _:
                        return false
            return false

        # `p.name.as_sview()` over a dstr field: replacing `p.name` frees the bytes the view reads
        # (stage0 invalidateStorageViewsForSourceScoped on the field place).
        def storage_view_dstr_field_view_head(value: Ast::Expr, head: mutable Ast::Expr&) -> bool:
            match storage_view_strip_paren_move(value):
                Expr.Call(callee, arguments, argument_names, line):
                    return false if arguments.count != 0
                    match callee:
                        Expr.Field(object, method, field_line):
                            return false if method != "as_sview" and method != "as_cstr" and method != "as_view" and method != "as_slice" and method != "as_str"
                            match object:
                                Expr.Field(inner, field, inner_line):
                                    head <- object
                                    return true
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false
            return false
