# Fresh logical shapes propagate through wrappers. Every wrapper call receives a
# distinct identity, so two calls cannot satisfy parameters that require one shared
# shape witness.

extend Semantic:
    private:
        def statement_fresh_shape_origin(statements: darray[Ast::Stmt]) -> sview:
            for statement in statements:
                if statement is Stmt.Return(value, _):
                    if value is returned:
                        function_name: sview = fresh_shape_call_name(returned)
                        return function_name if fresh_return_shape(function_name) != "" else ""
            return ""

        def collect_fresh_shape_wrappers(declarations: darray[Ast::Decl]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names|:
                    if declaration is Decl.Func(name, params, return_type, body, effects, decorators, line):
                        if return_type is return_expression:
                            shape: sview = logical_shape_label(return_expression)
                            origin: sview = statement_fresh_shape_origin(body)
                            names.push(name) if is_abstract_shape_label(shape) and origin != ""

        def fresh_wrapper_name_exists(names: darray[sview]&, candidate: sview) -> bool:
            for name in names:
                true return if name == candidate
            return false

        def expression_calls_fresh_wrapper(expression: Ast::Expr, wrapper_names: darray[sview]&) -> bool:
            function_name: sview = fresh_shape_call_name(expression)
            return fresh_wrapper_name_exists(wrapper_names, function_name)

        def check_fresh_wrapper_call(expression: Ast::Expr, declarations: darray[Ast::Decl]&, wrapper_names: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if expression is Expr.Call(Expr.Ident(callee_name, _), arguments, argument_names, _):
                    for declaration in declarations |table|:
                        if declaration is Decl.Func(name, params, return_type, body, effects, decorators, function_line):
                            continue if name != callee_name
                            for right_index in 1..<params.count |table|:
                                continue if right_index >= arguments.count or not expression_calls_fresh_wrapper(arguments[right_index], wrapper_names)
                                right_shape: sview = logical_shape_label(params[right_index].type_expression)
                                for left_index in 0..<right_index |table|:
                                    continue if left_index >= arguments.count or not expression_calls_fresh_wrapper(arguments[left_index], wrapper_names)
                                    left_shape: sview = logical_shape_label(params[left_index].type_expression)
                                    mismatch: bool = left_shape != "" and left_shape == right_shape
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FixedArrayShapeMismatch, name: callee_name, line: line, expected: left_shape, actual: right_shape, expected_count: 0, actual_count: 0}) if mismatch

        def walk_fresh_wrapper_statements(statements: darray[Ast::Stmt], declarations: darray[Ast::Decl]&, wrapper_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- check_fresh_wrapper_call(expression, declarations, wrapper_names, line.line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_fresh_wrapper_call(value, declarations, wrapper_names, line.line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_fresh_wrapper_call(value, declarations, wrapper_names, line.line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_fresh_wrapper_statements(then_body, declarations, wrapper_names, table)
                            table <- walk_fresh_wrapper_statements(else_body, declarations, wrapper_names, table)
                        Stmt.While(condition, body, line):
                            table <- walk_fresh_wrapper_statements(body, declarations, wrapper_names, table)
                        Stmt.For(_, _, _, body, line):
                            table <- walk_fresh_wrapper_statements(body, declarations, wrapper_names, table)
                        Stmt.Block(_, _, _, body, line):
                            table <- walk_fresh_wrapper_statements(body, declarations, wrapper_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- walk_fresh_wrapper_statements(arm.body, declarations, wrapper_names, table)
                        _:
                            pass

        def check_fresh_shape_wrapper_scope(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                wrapper_names: mutable darray[sview] = []
                collect_fresh_shape_wrappers(declarations, wrapper_names)
                for declaration in declarations |table|:
                    if declaration is Decl.Func(name, params, return_type, body, effects, decorators, line):
                        table <- walk_fresh_wrapper_statements(body, declarations, wrapper_names, table)
                    elif declaration is Decl.Module(name, body, line):
                        table <- check_fresh_shape_wrapper_scope(body, table)
                    elif declaration is Decl.Scoped(body, line):
                        table <- check_fresh_shape_wrapper_scope(body, table)

    public:
        def check_fresh_shape_wrapper(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_fresh_shape_wrapper_scope(declarations, table)
