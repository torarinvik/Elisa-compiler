# `@c_bind(header, name)` binds a struct to a C type, which is only sound when the struct uses
# `layout(c)` (so Elisa and C agree on field order/padding). A `@c_bind` struct without a c layout
# is rejected. The parser records struct decorators (name = decorator, owner = struct) and a
# `__layout_c` marker for c-layout structs; fire for a `c_bind`-decorated struct that has no
# `__layout_c` marker.
extend Semantic:
    private:
        def cbind_struct_has_c_layout(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__layout_c" and annotation.owner == name

    public:
        def check_cbind_requires_c_layout(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.name == "c_bind" and annotation.owner != "" and not cbind_struct_has_c_layout(file.enum_annotations, annotation.owner):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CBindRequiresCLayout, name: annotation.owner, line: annotation.line, expected: "", actual: ""})
