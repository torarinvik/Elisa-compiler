# A `@nolock` function promises not to acquire a lock or block on a condition. Granting a
# blocking synchronization effect (`Sync.Lock`/`Sync.Unlock`) in its body breaks that
# promise:
#
#   @nolock
#   def locky() -> void:
#       can Sync.Lock, Sync.Unlock:      # error: acquires a lock / waits on a condition
#           pass
#
# A grant is a `Stmt.Block("can", clause, ...)` whose clause lists the effect names. One
# diagnostic is emitted per blocking effect granted, in clause order (stage0 parity).
extend Semantic:
    private:
        def nlb_is_blocking(effect: sview) -> bool:
            can Abort.Panic:
                return effect == "Sync.Lock" or effect == "Sync.Unlock"

        def nlb_walk(statements: darray[Ast::Stmt], function_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, block_line):
                            if kind == "can":
                                for effect in clause |table| -> table:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NolockBlocking, name: function_name, line: block_line.line, expected: "", actual: effect}) if nlb_is_blocking(effect)
                            table <- nlb_walk(body, function_name, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- nlb_walk(then_body, function_name, table)
                            table <- nlb_walk(else_body, function_name, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- nlb_walk(while_body, function_name, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- nlb_walk(for_body, function_name, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- nlb_walk(arm.body, function_name, table)
                        _:
                            pass

        def nlb_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            is_nolock: bool = any decorator in decorators where decorator.name == "nolock"
                            table <- nlb_walk(body, function_name, table) if is_nolock
                        Decl.Module(module_name, module_body, module_line):
                            table <- nlb_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- nlb_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_nolock_blocking(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- nlb_check_declarations(file.top_decls, table)
