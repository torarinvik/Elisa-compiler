extend Semantic:
    private:
        def ga_condition_origin_inner(condition: Ast::Expr, binder: sview, state: mutable GlobalAuthority&) -> Ast::Expr?:
            match condition:
                Expr.Paren(inner, _):
                    return ga_condition_origin(inner, binder, state)
                Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Is or operator == TokenKind.As:
                        return left if right is Expr.Ident(name, _) and name == binder
                    elif operator == TokenKind.And or operator == TokenKind.Or:
                        if ga_condition_origin(left, binder, state) is origin:
                            return origin
                        return ga_condition_origin(right, binder, state)
                _:
                    pass
            return null

        def ga_condition_origin(condition: Ast::Expr, binder: sview, state: mutable GlobalAuthority&) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(condition), state):
                    return null
                result: Ast::Expr? = ga_condition_origin_inner(condition, binder, state)
                state.walk_depth <- state.walk_depth - 1
                return result

        def ga_gather_is_target_inner(expression: Ast::Expr, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        bound.push(name)
                    Expr.Call(_, arguments, _, _) | Expr.Array(arguments, _):
                        for argument in arguments |state, bound|:
                            ga_gather_is_target(argument, state, bound) can Global{Read,Write}
                    Expr.Construct(_, fields, _):
                        for field in fields |state, bound|:
                            ga_gather_is_target(field.value, state, bound) can Global{Read,Write}
                    _:
                        pass

        def ga_gather_is_target(expression: Ast::Expr, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                ga_gather_is_target_inner(expression, state, bound) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_gather_is_variant_aliases_inner(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(alias_left, alias_operator, alias_right, _):
                        ga_gather_is_variant_aliases(alias_left, table, state, bound) can Global{Read,Write}
                        if alias_operator == TokenKind.Is:
                            match alias_right:
                                Expr.Field(_, _, alias_variant_line):
                                    if table.is_variant_alias_lines.count == table.is_variant_alias_offsets.count and table.is_variant_alias_lines.count == table.is_variant_alias_names.count:
                                        for probe in 0..<table.is_variant_alias_lines.count |bound, table, alias_variant_line|:
                                            bound.push(table.is_variant_alias_names[probe]) if table.is_variant_alias_lines[probe].i64() == alias_variant_line.line and table.is_variant_alias_offsets[probe] == alias_variant_line.offset
                                _:
                                    ga_gather_is_variant_aliases(alias_right, table, state, bound) can Global{Read,Write}
                        else:
                            ga_gather_is_variant_aliases(alias_right, table, state, bound) can Global{Read,Write}
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _):
                        ga_gather_is_variant_aliases(operand, table, state, bound) can Global{Read,Write}
                    _:
                        pass

        def ga_gather_is_variant_aliases(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                ga_gather_is_variant_aliases_inner(expression, table, state, bound) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_gather_truthy_condition_bindings_inner(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, _):
                        ga_gather_truthy_condition_bindings(inner, table, state, bound) can Global{Read,Write}
                    Expr.Binary(left, operator, right, _):
                        match operator:
                            TokenKind.And:
                                ga_gather_truthy_condition_bindings(left, table, state, bound) can Global{Read,Write}
                                ga_gather_truthy_condition_bindings(right, table, state, bound) can Global{Read,Write}
                            TokenKind.Or:
                                left_names: mutable darray[sview] = []
                                right_names: mutable darray[sview] = []
                                ga_gather_truthy_condition_bindings(left, table, state, left_names) can Global{Read,Write}
                                ga_gather_truthy_condition_bindings(right, table, state, right_names) can Global{Read,Write}
                                for candidate in left_names |bound, right_names|:
                                    bound.push(candidate) if any other in right_names where other == candidate
                            TokenKind.Is | TokenKind.As:
                                ga_gather_is_target(right, state, bound) can Global{Read,Write}
                                ga_gather_is_variant_aliases(expression, table, state, bound) can Global{Read,Write}
                            _:
                                pass
                    _:
                        pass

        def ga_gather_truthy_condition_bindings(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                ga_gather_truthy_condition_bindings_inner(expression, table, state, bound) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_condition_bindings(condition: Ast::Expr, state: mutable GlobalAuthority&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                ga_gather_truthy_condition_bindings(condition, table, state, names) can Global{Read,Write}
                for name in names |state|:
                    type_expression: mutable Ast::Expr? = null
                    callback: mutable usize = GLOBAL_AUTHORITY_NONE
                    alias_origin: mutable usize = GLOBAL_AUTHORITY_NONE
                    type_scope: mutable usize = GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    if ga_condition_origin(condition, name, state) is origin:
                        type_expression <- ga_annotation(origin, state, 0)
                        type_scope <- ga_expression_type_scope(origin, state, 0)
                        callback <- ga_callee_slot(origin, state) can Global{Read,Write}
                        alias_origin <- ga_local_reference_binding_origin(type_expression, origin, state)
                    state.locals.push(name)
                    _ = ga_push_local_origin_id(state) can Global{Read,Write}
                    state.local_types.push(type_expression)
                    state.local_type_scopes.push(type_scope)
                    state.local_callees.push(callback if callback < state.functions.count else GLOBAL_AUTHORITY_NONE)
                    state.local_global_origins.push(alias_origin)

        def ga_expression_inner(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                at: Ast::Pos = Ast::expr_pos(expression)
                while next_index > 0 |next_index: usize = ga_inline_limit(at.offset, state), state|:
                    index: usize = next_index - 1
                    next_index <- index
                    break if state.inline_prefix_ends[index] <= at.offset
                    span: Ast::Pos = state.inline_spans[index]
                    if at.offset >= span.offset and at.offset < span.end_offset:
                        grant: sview = state.inline_refs[index]
                        if not state.report:
                            if not ga_refs_cover_at(state.firewalls, state.firewall_scopes, state.firewall_offsets, grant, state.inline_scopes[index], state, span.offset):
                                _ = ga_row_add(state.function, grant, true, state, state.inline_scopes[index], 0, span.offset) can Global{Read,Write}
                            state.reads[state.function] <- true if ga_ref_covers(grant, "Global.Read", state.inline_scopes[index], 0, state, 0, span.offset, GLOBAL_AUTHORITY_OFFSET_NONE) and not ga_refs_cover_at(state.firewalls, state.firewall_scopes, state.firewall_offsets, "Global.Read", 0, state, GLOBAL_AUTHORITY_OFFSET_NONE)
                            state.writes[state.function] <- true if ga_ref_covers(grant, "Global.Write", state.inline_scopes[index], 0, state, 0, span.offset, GLOBAL_AUTHORITY_OFFSET_NONE) and not ga_refs_cover_at(state.firewalls, state.firewall_scopes, state.firewall_offsets, "Global.Write", 0, state, GLOBAL_AUTHORITY_OFFSET_NONE)
                match expression:
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        table <- ga_access(expression, false, state, table) can Global{Read,Write}
                    Expr.Unary(operator, operand, _):
                        table <- ga_expression(operand, state, table) can Global{Read,Write}
                        table <- ga_write_place(operand, state, table) can Global{Read,Write} if operator == TokenKind.Mutable
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- ga_expression(operand, state, table) can Global{Read,Write}
                    Expr.Field(base, _, _):
                        if ga_place_global(expression, state) < state.globals.count and ga_global_path_mutable(expression, state, 0):
                            table <- ga_access(expression, false, state, table) can Global{Read,Write}
                        else:
                            alias_origin: usize = ga_reference_path_origin(expression, state, 0)
                            if alias_origin < state.globals.count and (state.writable[alias_origin] or ga_global_path_mutable(expression, state, 0)):
                                table <- ga_access_slot(alias_origin, Ast::expr_pos(expression), false, true, state, table) can Global{Read,Write}
                            elif ga_expression_is_reference(expression, state, 0):
                                table <- ga_access(expression, false, state, table) can Global{Read,Write}
                            else:
                                table <- ga_expression(base, state, table) can Global{Read,Write}
                    Expr.Binary(left, operator, right, _):
                        table <- ga_expression(left, state, table) can Global{Read,Write}
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            mark: usize = state.locals.count
                            ga_condition_bindings(left, state, table) can Global{Read,Write} if operator == TokenKind.And
                            table <- ga_expression(right, state, table) can Global{Read,Write}
                            state.locals.truncate(mark)
                            state.local_origin_ids.truncate(mark)
                            state.local_types.truncate(mark)
                            state.local_type_scopes.truncate(mark)
                            state.local_callees.truncate(mark)
                            state.local_global_origins.truncate(mark)
                    Expr.Index(left, right, _) | Expr.Refinement(left, right, _):
                        # `x.cast[T]` reads x and names a type (see ga_cast_operand).
                        if ga_cast_operand(expression) is cast_operand:
                            table <- ga_expression(cast_operand, state, table) can Global{Read,Write}
                        else:
                            table <- ga_expression(left, state, table) can Global{Read,Write}
                            table <- ga_expression(right, state, table) can Global{Read,Write}
                    Expr.Slice(base, low, high, _):
                        table <- ga_expression(base, state, table) can Global{Read,Write}
                        table <- ga_expression(low, state, table) can Global{Read,Write}
                        table <- ga_expression(high, state, table) can Global{Read,Write}
                    Expr.IndexN(base, arguments, _):
                        table <- ga_expression(base, state, table) can Global{Read,Write}
                        for argument in arguments |state, table| -> table:
                            table <- ga_expression(argument, state, table) can Global{Read,Write}
                    Expr.Call(callee, arguments, argument_names, _):
                        conversion: bool = arguments.count == 0 and argument_names.count == 0 and ga_target_conversion(callee, state)
                        callable: Ast::Expr = ga_postfix_callee(ga_callable_core(callee)) if conversion else ga_callable_core(callee)
                        call_arguments: mutable darray[Ast::Expr] @source = arguments
                        call_labels: mutable darray[sview @source] @source = argument_names
                        receiver_count: mutable usize = 0
                        match callable:
                            Expr.Field(base, _, _):
                                method_arguments: mutable darray[Ast::Expr] @source = [base]
                                method_labels: mutable darray[sview @source] @source = [""]
                                method_arguments.extend(arguments)
                                method_labels.extend(argument_names)
                                call_arguments <- method_arguments
                                call_labels <- method_labels
                                receiver_count <- 1
                            _:
                                pass
                        resolved_head: mutable usize = GLOBAL_AUTHORITY_NONE
                        resolved_head_stable: mutable bool = false
                        table <- ga_call(callee, call_arguments, call_labels, state, table, resolved_head, resolved_head_stable, conversion) can Global{Read,Write}
                        reuse_head: mutable bool = false
                        match callable:
                            Expr.Ident(_, _) | Expr.Scope(_, _, _):
                                reuse_head <- not conversion and resolved_head_stable
                            _:
                                pass
                        call_head: usize = resolved_head if reuse_head else ga_callee_slot(callee, state, 0, conversion) can Global{Read,Write}
                        # Default-argument analysis above can mutate callable rows without
                        # changing their count. Re-select after it so callback and mutation
                        # checks see the current candidates; only the stable name-chain head
                        # is reused.
                        call_slot: usize = ga_select_function(call_head, call_arguments, call_labels, state, receiver_count == 1)
                        match callable:
                            Expr.Field(base, method, _):
                                mutation_receiver: Ast::Expr = ga_collection_mutation_receiver(base, method)
                                builtin_mutates: bool = ga_mutating_collection(mutation_receiver, method, state)
                                mutates: mutable bool = builtin_mutates
                                opaque_mutates: mutable bool = false
                                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(call_slot, state), mutates|:
                                    candidate: usize = next_candidate
                                    next_candidate <- state.function_next[candidate]
                                    candidate_mutates: bool = ga_candidate_selected(candidate, call_slot, call_arguments, call_labels, state, receiver_count == 1) and ga_argument_mutates(candidate, 0, "", state)
                                    mutates <- true if candidate_mutates
                                    opaque_mutates <- true if candidate_mutates
                                table <- ga_expression(base, state, table) can Global{Read,Write}
                                table <- ga_write_place(mutation_receiver, state, table) can Global{Read,Write} if mutates
                                if mutates:
                                    if builtin_mutates and not opaque_mutates:
                                        for argument in arguments |mutation_receiver, state|:
                                            _ = ga_join_aggregate_reference_origin(mutation_receiver, argument, state) can Global{Read,Write}
                                    else:
                                        ga_mark_aggregate_origin_unknown_if_mutated(mutation_receiver, state)
                            _:
                                table <- ga_expression(callable, state, table) can Global{Read,Write}
                        for index in 0..<arguments.count |state, table| -> table:
                            argument: Ast::Expr = arguments[index]
                            label: sview = argument_names[index] if index < argument_names.count else sview("", 0, 0)
                            mutates: mutable bool = false
                            while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(call_slot, state), mutates|:
                                candidate: usize = next_candidate
                                next_candidate <- state.function_next[candidate]
                                mutates <- true if ga_candidate_selected(candidate, call_slot, call_arguments, call_labels, state, receiver_count == 1) and ga_argument_mutates(candidate, index + receiver_count, label, state)
                            table <- ga_expression(argument, state, table) can Global{Read,Write}
                            table <- ga_callback_handoff(callable, argument, state, table) can Global{Read,Write}
                            table <- ga_write_place(argument, state, table) can Global{Read,Write} if mutates
                            ga_mark_aggregate_origin_unknown_if_mutated(argument, state) if mutates
                    Expr.StaticEffectCall(_, operation, candidates, arguments, argument_names, position):
                        table <- ga_static_effect_call(operation, candidates, arguments, argument_names, position, state, table) can Global{Read,Write}
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |state, table| -> table:
                            table <- ga_expression(element, state, table) can Global{Read,Write}
                    Expr.DictLit(entries, _):
                        for entry in entries |state, table| -> table:
                            table <- ga_expression(entry.key, state, table) can Global{Read,Write}
                            table <- ga_expression(entry.value, state, table) can Global{Read,Write}
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        match expression:
                            Expr.RecordUpdate(base, _, _):
                                table <- ga_expression(base, state, table) can Global{Read,Write}
                            _:
                                pass
                        for field in fields |state, table| -> table:
                            table <- ga_expression(field.value, state, table) can Global{Read,Write}
                    Expr.If(condition, then_expression, else_expression, _):
                        table <- ga_expression(condition, state, table) can Global{Read,Write}
                        mark: usize = state.locals.count
                        ga_condition_bindings(condition, state, table) can Global{Read,Write}
                        table <- ga_expression(then_expression, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                        table <- ga_expression(else_expression, state, table) can Global{Read,Write}
                    Expr.Match(value, arms, _) | Expr.Catch(value, arms, _):
                        table <- ga_expression(value, state, table) can Global{Read,Write}
                        table <- ga_arms(value, arms, state, table) can Global{Read,Write}
                    Expr.GetElse(value, recovery, _):
                        table <- ga_expression(value, state, table) can Global{Read,Write}
                        table <- ga_body(recovery, state, table) can Global{Read,Write}
                    Expr.Comprehension(variable, iterable, condition, body, _, query_scope_id):
                        table <- ga_expression(iterable, state, table) can Global{Read,Write}
                        mark: usize = state.locals.count
                        # Resolve all metadata from the enclosing scope before any
                        # comprehension binder can shadow a name used by `iterable` or
                        # by another binder's inferred type.
                        iterable_type_scope: usize = ga_expression_type_scope(iterable, state, 0)
                        iterable_origin: usize = ga_reference_origin(iterable, state, 0)
                        item_type_id: u32 = pag_iteration_item_type_id(iterable, table)
                        query_binder_limit: usize = table.query_binder_offsets.count if table.query_binder_offsets.count < table.query_binder_names.count else table.query_binder_names.count
                        extra_binder_count: mutable usize = 0
                        for query_binder_index in 0..<query_binder_limit |extra_binder_count|:
                            extra_binder_count <- extra_binder_count + 1 if query_scope_id != 0 and Ast::query_scope_id_from_offset(table.query_binder_offsets[query_binder_index]) == query_scope_id
                        binding_count: usize = extra_binder_count + 1
                        binding_type_id: u32 = pag_iteration_binding_type_id(iterable, item_type_id, binding_count, 0, table)
                        binding_type_expression: Ast::Expr? = ga_iteration_binding_type_expression(iterable, binding_type_id, binding_count, 0, Ast::expr_pos(iterable), state, table)
                        binding_has_references: mutable bool = ga_type_id_contains_reference(binding_type_id, table)
                        if binding_type_expression is item_type_expression:
                            binding_has_references <- true if ga_type_expression_contains_reference(item_type_expression, state, 0)
                        extra_binder_names: mutable darray[sview] = []
                        extra_binding_type_expressions: mutable darray[Ast::Expr?] = []
                        extra_binding_has_references: mutable darray[bool] = []
                        query_binder_index: mutable usize = 0
                        binding_index: mutable usize = 1
                        while query_binder_index < query_binder_limit |query_binder_index, binding_index, state|:
                            if query_scope_id != 0 and Ast::query_scope_id_from_offset(table.query_binder_offsets[query_binder_index]) == query_scope_id:
                                extra_type_id: u32 = pag_iteration_binding_type_id(iterable, item_type_id, binding_count, binding_index, table)
                                extra_type_expression: Ast::Expr? = ga_iteration_binding_type_expression(iterable, extra_type_id, binding_count, binding_index, Ast::expr_pos(iterable), state, table)
                                extra_has_references: mutable bool = ga_type_id_contains_reference(extra_type_id, table)
                                if extra_type_expression is extra_item_type_expression:
                                    extra_has_references <- true if ga_type_expression_contains_reference(extra_item_type_expression, state, 0)
                                extra_binder_names.push(table.query_binder_names[query_binder_index])
                                extra_binding_type_expressions.push(extra_type_expression)
                                extra_binding_has_references.push(extra_has_references)
                                binding_index <- binding_index + 1
                            query_binder_index <- query_binder_index + 1
                        state.locals.push(variable)
                        _ = ga_push_local_origin_id(state) can Global{Read,Write}
                        state.local_types.push(binding_type_expression)
                        state.local_type_scopes.push(iterable_type_scope)
                        state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                        state.local_global_origins.push(SemanticGlobalAuthorityOrigin::pattern_binding_origin(binding_has_references, iterable_origin))
                        for extra_index in 0..<extra_binder_names.count |extra_binder_names, extra_binding_type_expressions, extra_binding_has_references, iterable_type_scope, iterable_origin, state|:
                            state.locals.push(extra_binder_names[extra_index])
                            _ = ga_push_local_origin_id(state) can Global{Read,Write}
                            state.local_types.push(extra_binding_type_expressions[extra_index])
                            state.local_type_scopes.push(iterable_type_scope)
                            state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                            state.local_global_origins.push(SemanticGlobalAuthorityOrigin::pattern_binding_origin(extra_binding_has_references[extra_index], iterable_origin))
                        table <- ga_expression(condition, state, table) can Global{Read,Write}
                        table <- ga_expression(body, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                    Expr.Lambda(parameters, body, at):
                        mark: usize = state.locals.count
                        enclosing_function: usize = state.function
                        lambda_slot: mutable usize = ga_callee_slot(expression, state) can Global{Read,Write}
                        if lambda_slot == state.functions.count:
                            state.function_next.push(GLOBAL_AUTHORITY_NONE)
                            state.functions.push("")
                            state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                            state.function_scopes.push(state.module_scope)
                            state.function_offsets.push(at.offset)
                            state.function_lines.push(0)
                            state.function_variadic.push(false)
                            state.function_return_types.push(null)
                            state.parameter_starts.push(state.parameter_functions.count)
                            state.parameter_counts.push(parameters.count)
                            state.parameter_minimum.push(parameters.count)
                            state.reads.push(false)
                            state.writes.push(false)
                        state.function <- lambda_slot
                        state.lambda_depth <- state.lambda_depth + 1
                        for parameter in parameters:
                            state.locals.push(parameter)
                            _ = ga_push_local_origin_id(state) can Global{Read,Write}
                            state.local_types.push(null)
                            state.local_type_scopes.push(GLOBAL_AUTHORITY_UNKNOWN_ALIAS)
                            state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                            state.local_global_origins.push(GLOBAL_AUTHORITY_NONE)
                        table <- ga_body(body, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                        state.function <- enclosing_function
                        state.lambda_depth <- state.lambda_depth - 1
                    Expr.Block(statements, value, _, _):
                        mark: usize = state.locals.count
                        table <- ga_statements(statements, state, table) can Global{Read,Write}
                        table <- ga_expression(value, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                    _:
                        pass

        def ga_expression(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                table <- ga_expression_inner(expression, state, table) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        # Origin edges retain callable shape facts separately from propagated rows.
        def ga_callback_origin_index_ready(state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                return state.callback_origin_indexed and state.callback_origin_next.count == state.callback_origin_from.count and state.callback_origin_to.count == state.callback_origin_from.count

        def ga_callback_origin_head(parent: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return head if state.callback_origin_heads.get(parent) is head else GLOBAL_AUTHORITY_NONE

        # Rebuild only if a caller supplied pre-existing origin rows without their
        # append-only index. Normal inference keeps the arrays synchronized in
        # ga_callback_origin; readers retain a linear fallback for incomplete states.
        def ga_index_callback_origins(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                state.callback_origin_indexed <- false
                return if state.callback_origin_from.count != state.callback_origin_to.count
                state.callback_origin_heads <- {}
                state.callback_origin_tails <- {}
                state.callback_origin_next <- []
                for edge in 0..<state.callback_origin_from.count |edge, state|:
                    parent: usize = state.callback_origin_from[edge]
                    last_edge: usize = previous_edge_value if state.callback_origin_tails.get(parent) is previous_edge_value else GLOBAL_AUTHORITY_NONE
                    state.callback_origin_next.push(GLOBAL_AUTHORITY_NONE)
                    if last_edge < edge:
                        state.callback_origin_next[last_edge] <- edge
                    else:
                        state.callback_origin_heads <- state.callback_origin_heads.put(parent, edge) can Global{Read,Write}
                    state.callback_origin_tails <- state.callback_origin_tails.put(parent, edge) can Global{Read,Write}
                state.callback_origin_indexed <- true

        def ga_callback_origin(parent: usize, child: usize, state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if parent >= state.functions.count or child >= state.functions.count or parent == child
                ga_index_callback_origins(state) can Global{Read,Write} if not ga_callback_origin_index_ready(state)
                if ga_callback_origin_index_ready(state):
                    edge: mutable usize = ga_callback_origin_head(parent, state)
                    while edge < state.callback_origin_from.count |edge, parent, child, state|:
                        return if state.callback_origin_from[edge] == parent and state.callback_origin_to[edge] == child
                        edge <- state.callback_origin_next[edge]
                else:
                    for edge in 0..<state.callback_origin_from.count:
                        return if state.callback_origin_from[edge] == parent and state.callback_origin_to[edge] == child
                edge: usize = state.callback_origin_from.count
                index_new_edge: bool = ga_callback_origin_index_ready(state)
                state.callback_origin_from.push(parent)
                state.callback_origin_to.push(child)
                if index_new_edge:
                    state.callback_origin_next.push(GLOBAL_AUTHORITY_NONE)
                    last_edge: usize = previous_edge_value if state.callback_origin_tails.get(parent) is previous_edge_value else GLOBAL_AUTHORITY_NONE
                    if last_edge < edge:
                        state.callback_origin_next[last_edge] <- edge
                    else:
                        state.callback_origin_heads <- state.callback_origin_heads.put(parent, edge) can Global{Read,Write}
                    state.callback_origin_tails <- state.callback_origin_tails.put(parent, edge) can Global{Read,Write}
                ga_edge_rows(parent, child, state, false) can Global{Read,Write}
                state.edge_from.push(parent)
                state.edge_to.push(child)
                state.edge_reads.push(true)
                state.edge_writes.push(true)

        # Prepublish a fail-closed callable for bounded graph traversal failures.
        def ga_unknown_callback(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if state.unknown_callback_slot < state.functions.count
                slot: usize = state.functions.count
                state.unknown_callback_slot <- slot
                state.function_next.push(GLOBAL_AUTHORITY_NONE)
                state.functions.push("")
                state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                state.function_scopes.push(0)
                state.function_offsets.push(0)
                state.function_lines.push(0)
                state.function_variadic.push(true)
                state.function_return_types.push(null)
                state.parameter_starts.push(state.parameter_types.count)
                state.parameter_counts.push(0)
                state.parameter_minimum.push(0)
                state.reads.push(true)
                state.writes.push(true)
                function_offset: u32 = state.function_offsets[slot] if slot < state.function_offsets.count else GLOBAL_AUTHORITY_OFFSET_NONE
                _ = ga_row_add(slot, "Global.Read", true, state, 0, 0, function_offset) can Global{Read,Write}
                _ = ga_row_add(slot, "Global.Write", true, state, 0, 0, function_offset) can Global{Read,Write}
                _ = ga_row_add(slot, "Unsafe", true, state, 0, 0, function_offset) can Global{Read,Write}

        # Cache keys distinguish invocation layers at one source expression. A union
        # exposes no first-only return annotation or parameter-based viability filter.
        def ga_join_callback(first: usize, second: usize, at: Ast::Pos, state: mutable GlobalAuthority&, owner: usize = GLOBAL_AUTHORITY_NONE, force_union: bool = false) -> usize:
            can Memory.Allocate, Abort.Panic:
                return second if first >= state.functions.count
                return first if second >= state.functions.count or (first == second and not force_union)
                joined: mutable usize = state.functions.count
                for index in 0..<state.callback_join_slots.count |joined|:
                    joined <- state.callback_join_slots[index] if state.callback_join_offsets[index] == at.offset and state.callback_join_scopes[index] == state.module_scope and state.callback_join_owners[index] == owner
                if joined == state.functions.count:
                    state.function_next.push(GLOBAL_AUTHORITY_NONE)
                    state.functions.push("")
                    state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                    state.function_scopes.push(state.module_scope)
                    state.function_offsets.push(at.offset)
                    state.function_lines.push(0)
                    state.function_variadic.push(true)
                    state.function_return_types.push(null)
                    state.parameter_starts.push(state.parameter_types.count)
                    state.parameter_counts.push(0)
                    state.parameter_minimum.push(0)
                    state.reads.push(false)
                    state.writes.push(false)
                    state.callback_join_slots.push(joined)
                    state.callback_join_owners.push(owner)
                    state.callback_join_offsets.push(at.offset)
                    state.callback_join_scopes.push(state.module_scope)
                if not state.report:
                    ga_callback_origin(joined, first, state) can Global{Read,Write}
                    ga_callback_origin(joined, second, state) can Global{Read,Write}
                return joined

        # The return of a callable union retains every child's future capability;
        # constructing that union does not charge the child's execution effects.
        # A stable result proxy can be referenced before a forward factory's body
        # reveals its concrete origins. Execution and future capability stay separate.
        def ga_callback_return_slot(slot: usize, at: Ast::Pos, state: mutable GlobalAuthority&, depth: u32 = 0) -> usize:
            can Memory.Allocate, Abort.Panic:
                return state.unknown_callback_slot if depth > 32 or slot == state.unknown_callback_slot
                return GLOBAL_AUTHORITY_NONE if slot >= state.functions.count
                # A scalar-returning call cannot be a function-valued argument. Creating
                # callback-result proxies for these calls poisons unrelated effect rows
                # when the proxy graph reaches the conservative unknown callback.
                if slot < state.function_return_types.count and state.functions[slot] != "":
                    if state.function_return_types[slot] is declared_return:
                        return GLOBAL_AUTHORITY_NONE if ga_builtin_unshadowed(declared_return, state.function_scopes[slot], state)
                        return GLOBAL_AUTHORITY_NONE if ga_exact_void_return(declared_return)
                if slot < state.returned_callees.count:
                    mapped: usize = state.returned_callees[slot]
                    return mapped if mapped < state.functions.count
                for index in 0..<state.callback_result_sources.count:
                    return state.callback_result_slots[index] if state.callback_result_sources[index] == slot
                return state.unknown_callback_slot if state.report
                result: usize = state.functions.count
                state.function_next.push(GLOBAL_AUTHORITY_NONE)
                state.functions.push("")
                state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                state.function_scopes.push(state.module_scope)
                state.function_offsets.push(at.offset)
                state.function_lines.push(0)
                state.function_variadic.push(true)
                state.function_return_types.push(null)
                state.parameter_starts.push(state.parameter_types.count)
                state.parameter_counts.push(0)
                state.parameter_minimum.push(0)
                state.reads.push(false)
                state.writes.push(false)
                state.callback_result_sources.push(slot)
                state.callback_result_slots.push(result)
                return result

        def ga_resolve_callback_results(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                changed: mutable bool = true
                rounds: mutable usize = 0
                while changed and rounds < 32 |state, changed, rounds|:
                    changed <- false
                    rounds <- rounds + 1
                    old_requests: usize = state.callback_result_sources.count
                    old_edges: usize = state.callback_origin_from.count
                    for index in 0..<old_requests |state|:
                        source: usize = state.callback_result_sources[index]
                        result: usize = state.callback_result_slots[index]
                        origin_count: usize = state.callback_origin_from.count
                        if ga_callback_origin_index_ready(state):
                            edge: mutable usize = ga_callback_origin_head(source, state)
                            while edge < origin_count |edge, origin_count, source, result, state|:
                                if state.callback_origin_from[edge] == source:
                                    child: usize = state.callback_origin_to[edge]
                                    child_result: usize = ga_callback_return_slot(child, ga_position_value(0, 0, 0, 0, 0, 0), state)
                                    ga_callback_origin(result, child_result, state) can Global{Read,Write}
                                edge <- state.callback_origin_next[edge]
                        else:
                            for edge in 0..<origin_count |state|:
                                continue if state.callback_origin_from[edge] != source
                                child: usize = state.callback_origin_to[edge]
                                child_result: usize = ga_callback_return_slot(child, ga_position_value(0, 0, 0, 0, 0, 0), state)
                                ga_callback_origin(result, child_result, state) can Global{Read,Write}
                    changed <- old_requests != state.callback_result_sources.count or old_edges != state.callback_origin_from.count
                if changed:
                    result_count: usize = state.callback_result_slots.count
                    for index in 0..<result_count |state|:
                        result: usize = state.callback_result_slots[index]
                        ga_callback_origin(result, state.unknown_callback_slot, state) can Global{Read,Write}
