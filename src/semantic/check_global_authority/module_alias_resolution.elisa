extend Semantic:
    private:
        # Core registers a block's direct aliases before descending into child modules.
        # Within one block, aliases retain source order; unrelated blocks follow source
        # order because their module declarations are traversed in source order.
        def ga_module_alias_registration_precedes(left_scope: usize, left_offset: u32, left_index: usize, right_scope: usize, right_offset: u32, right_index: usize, state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                if left_scope == right_scope:
                    left_is_branch: bool = ga_module_alias_is_static_branch(left_index, state)
                    right_is_branch: bool = ga_module_alias_is_static_branch(right_index, state)
                    return false if left_is_branch and not right_is_branch
                    return true if not left_is_branch and right_is_branch
                    return left_offset < right_offset or (left_offset == right_offset and left_index < right_index)
                current: mutable usize = right_scope
                while current < state.parents.count |current, left_scope|:
                    return true if current == left_scope
                    break if current == 0
                    current <- state.parents[current]
                current <- left_scope
                while current < state.parents.count |current, right_scope|:
                    return false if current == right_scope
                    break if current == 0
                    current <- state.parents[current]
                return left_offset < right_offset or (left_offset == right_offset and left_index < right_index)

        # Alias-target recursion passes the declaration offset. Find that declaration's
        # registration position so ancestor aliases registered by Core's scope prepass
        # remain visible even when their source text appears later.
        def ga_module_alias_registration_index(scope: usize, offset: u32, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                if state.module_alias_index_ready and state.module_alias_index_annotation_count == state.annotations.count:
                    for alias_row in 0..<state.module_alias_rows.count |scope, offset, state|:
                        registration_index: usize = state.module_alias_rows[alias_row]
                        alias: Ast::EnumAnnotation = state.annotations[registration_index]
                        return registration_index if alias.name == "__using_alias" and alias.offset == offset and ga_module_text(alias.module, state) == scope
                    return state.annotations.count
                for alias_index in 0..<state.annotations.count:
                    alias: Ast::EnumAnnotation = state.annotations[alias_index]
                    continue if alias.name != "__using_alias" or alias.offset != offset
                    continue if ga_module_text(alias.module, state) != scope
                    return alias_index
                return state.annotations.count

        def ga_module_alias_choice_consider(alias_index: usize, name: sview, lexical_scope: usize, before_index: usize, before_offset: u32, source_positioned: bool, state: GlobalAuthority&, selected_index: mutable usize&, selected_scope: mutable usize&, uncertain_index: mutable usize&, uncertain_scope: mutable usize&) -> void:
            can Abort.Panic:
                return if alias_index >= state.annotations.count
                alias: Ast::EnumAnnotation = state.annotations[alias_index]
                return if alias.name != "__using_alias" or alias.owner != name
                alias_scope: usize = ga_module_text(alias.module, state)
                return if alias_scope >= state.modules.count
                if source_positioned:
                    if before_index < state.annotations.count:
                        before_alias: Ast::EnumAnnotation = state.annotations[before_index]
                        return if not ga_module_alias_registration_precedes(alias_scope, alias.offset, alias_index, lexical_scope, before_alias.offset, before_index, state)
                    else:
                        return if alias.offset >= before_offset
                branch_selection: (known: bool, active: bool) = ga_module_alias_branch_selection(alias_index, state)
                return if branch_selection.known and not branch_selection.active
                if not branch_selection.known:
                    if uncertain_index >= state.annotations.count:
                        uncertain_index <- alias_index
                        uncertain_scope <- alias_scope
                    else:
                        uncertain_alias: Ast::EnumAnnotation = state.annotations[uncertain_index]
                        if source_positioned:
                            if ga_module_alias_registration_precedes(uncertain_scope, uncertain_alias.offset, uncertain_index, alias_scope, alias.offset, alias_index, state):
                                uncertain_index <- alias_index
                                uncertain_scope <- alias_scope
                        else:
                            if ga_module_alias_registration_precedes(alias_scope, alias.offset, alias_index, uncertain_scope, uncertain_alias.offset, uncertain_index, state):
                                uncertain_index <- alias_index
                                uncertain_scope <- alias_scope
                    return
                if selected_index >= state.annotations.count:
                    selected_index <- alias_index
                    selected_scope <- alias_scope
                else:
                    selected_alias: Ast::EnumAnnotation = state.annotations[selected_index]
                    if source_positioned:
                        if ga_module_alias_registration_precedes(selected_scope, selected_alias.offset, selected_index, alias_scope, alias.offset, alias_index, state):
                            selected_index <- alias_index
                            selected_scope <- alias_scope
                    else:
                        if ga_module_alias_registration_precedes(alias_scope, alias.offset, alias_index, selected_scope, selected_alias.offset, selected_index, state):
                            selected_index <- alias_index
                            selected_scope <- alias_scope

        # Without a source cutoff, select the first program-wide alias Core registered
        # for a head. A source-positioned lookup instead selects the latest eligible
        # registration before that use, while preserving uncertainty from a later
        # conditional alias that could become the winner.
        def ga_module_alias_choice(name: sview, lexical_scope: usize, state: GlobalAuthority&, depth: u32 = 0, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> (found: bool, ambiguous: bool, index: usize, scope: usize):
            can Abort.Panic:
                return (false, false, state.annotations.count, state.modules.count) if lexical_scope >= state.parents.count
                selected_index: mutable usize = state.annotations.count
                selected_scope: mutable usize = state.modules.count
                before_index: usize = ga_module_alias_registration_index(lexical_scope, before_offset, state) if before_offset != GLOBAL_AUTHORITY_OFFSET_NONE else state.annotations.count
                source_positioned: bool = before_offset != GLOBAL_AUTHORITY_OFFSET_NONE
                uncertain_index: mutable usize = state.annotations.count
                uncertain_scope: mutable usize = state.modules.count
                if state.module_alias_index_ready and state.module_alias_index_annotation_count == state.annotations.count:
                    for alias_row in 0..<state.module_alias_rows.count |name, lexical_scope, before_index, before_offset, source_positioned, selected_index, selected_scope, uncertain_index, uncertain_scope, state|:
                        alias_index: usize = state.module_alias_rows[alias_row]
                        ga_module_alias_choice_consider(alias_index, name, lexical_scope, before_index, before_offset, source_positioned, state, selected_index, selected_scope, uncertain_index, uncertain_scope)
                else:
                    for alias_index in 0..<state.annotations.count |name, lexical_scope, before_index, before_offset, source_positioned, selected_index, selected_scope, uncertain_index, uncertain_scope, state|:
                        alias: Ast::EnumAnnotation = state.annotations[alias_index]
                        continue if alias.name != "__using_alias" or alias.owner != name
                        ga_module_alias_choice_consider(alias_index, name, lexical_scope, before_index, before_offset, source_positioned, state, selected_index, selected_scope, uncertain_index, uncertain_scope)
                if uncertain_index < state.annotations.count:
                    if selected_index >= state.annotations.count:
                        return (true, true, uncertain_index, uncertain_scope)
                    selected_alias: Ast::EnumAnnotation = state.annotations[selected_index]
                    uncertain_alias: Ast::EnumAnnotation = state.annotations[uncertain_index]
                    if source_positioned:
                        return (true, true, uncertain_index, uncertain_scope) if ga_module_alias_registration_precedes(selected_scope, selected_alias.offset, selected_index, uncertain_scope, uncertain_alias.offset, uncertain_index, state)
                    else:
                        return (true, true, uncertain_index, uncertain_scope) if ga_module_alias_registration_precedes(uncertain_scope, uncertain_alias.offset, uncertain_index, selected_scope, selected_alias.offset, selected_index, state)
                return (selected_scope < state.modules.count, false, selected_index, selected_scope)

        # Alias target rows are paired by the alias token's full declaration identity.
        def ga_module_alias_target_path(module: sview, line: u32, offset: u32, state: GlobalAuthority&) -> (found: bool, path: sview @source):
            can Abort.Panic:
                target_path: mutable sview @source = ""
                target_count: mutable usize = 0
                for target in state.annotations:
                    continue if target.name != "__using_alias_target" or target.offset != offset or target.line != line or target.module != module
                    target_path <- target.owner
                    target_count <- target_count + 1
                return (target_count == 1, target_path)

        def ga_module_alias_raw_segment_count(path: sview @source, start_index: usize = 0) -> (valid: bool, count: usize):
            can Abort.Panic:
                return (false, 0.usize()) if start_index > path.len
                return (true, 0.usize()) if start_index == path.len
                start: mutable usize = start_index
                count: mutable usize = 0.usize()
                while start < path.len |start, count|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    return (false, 0.usize()) if effect_ref_trim_layout(path[start:end]).len == 0
                    count <- count + 1.usize()
                    return (false, 0.usize()) if end < path.len and (end + 2 >= path.len or path[end + 1] != 58)
                    start <- path.len if end == path.len else end + 2
                return (true, count)

        def ga_module_alias_raw_segment_at(path: sview @source, start_index: usize, target_index: usize) -> (found: bool, segment: sview @source):
            can Abort.Panic:
                return (false, "") if start_index > path.len
                start: mutable usize = start_index
                current: mutable usize = 0.usize()
                while start < path.len |start, current, target_index|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    part: sview @source = effect_ref_trim_layout(path[start:end])
                    return (false, "") if part.len == 0 or (end < path.len and (end + 2 >= path.len or path[end + 1] != 58))
                    return (true, part) if current == target_index
                    current <- current + 1.usize()
                    start <- path.len if end == path.len else end + 2
                return (false, "")

        # Count the canonical path without allocating. Unresolved module names still
        # compare by their declaration-scope-qualified segments, preserving idempotent
        # duplicate aliases even when their target module has not been declared.
        def ga_module_alias_target_segment_count(path: sview @source, declaration_scope: usize, state: GlobalAuthority&, before_offset: u32, depth: u32 = 0) -> (valid: bool, count: usize):
            can Abort.Panic:
                return (false, 0.usize()) if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT or declaration_scope >= state.modules.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return (false, 0.usize()) if first.len == 0 or (first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58))
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, declaration_scope, state, depth, before_offset)
                return (false, 0.usize()) if alias.ambiguous
                suffix_start: usize = path.len if first_end == path.len else first_end + 2
                suffix_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(path, suffix_start)
                return (false, 0.usize()) if not suffix_count.valid
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    return (false, 0.usize()) if not target.found
                    target_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(target.path, alias.scope, state, alias_row.offset, depth + 1)
                    return (false, 0.usize()) if not target_count.valid
                    return (true, target_count.count + suffix_count.count)
                scope_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(state.modules[declaration_scope], 0.usize())
                path_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(path, 0.usize())
                return (false, 0.usize()) if not scope_count.valid or not path_count.valid
                return (true, scope_count.count + path_count.count)

        def ga_module_alias_target_segment_at(path: sview @source, declaration_scope: usize, state: GlobalAuthority&, before_offset: u32, target_index: usize, depth: u32 = 0) -> (found: bool, segment: sview @source):
            can Abort.Panic:
                return (false, "") if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT or declaration_scope >= state.modules.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return (false, "") if first.len == 0 or (first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58))
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, declaration_scope, state, depth, before_offset)
                return (false, "") if alias.ambiguous
                suffix_start: usize = path.len if first_end == path.len else first_end + 2
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    return (false, "") if not target.found
                    target_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(target.path, alias.scope, state, alias_row.offset, depth + 1)
                    return (false, "") if not target_count.valid
                    if target_index < target_count.count:
                        return ga_module_alias_target_segment_at(target.path, alias.scope, state, alias_row.offset, target_index, depth + 1)
                    return ga_module_alias_raw_segment_at(path, suffix_start, target_index - target_count.count)
                scope_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(state.modules[declaration_scope], 0.usize())
                return (false, "") if not scope_count.valid
                if target_index < scope_count.count:
                    return ga_module_alias_raw_segment_at(state.modules[declaration_scope], 0.usize(), target_index)
                return ga_module_alias_raw_segment_at(path, 0.usize(), target_index - scope_count.count)

        def ga_module_alias_targets_equal(left_path: sview @source, left_scope: usize, left_before_offset: u32, right_path: sview @source, right_scope: usize, right_before_offset: u32, state: GlobalAuthority&, depth: u32) -> bool:
            can Abort.Panic:
                left_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(left_path, left_scope, state, left_before_offset, depth)
                right_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(right_path, right_scope, state, right_before_offset, depth)
                return false if not left_count.valid or not right_count.valid or left_count.count != right_count.count
                for index in 0..<left_count.count:
                    left_segment: (found: bool, segment: sview @source) = ga_module_alias_target_segment_at(left_path, left_scope, state, left_before_offset, index, depth)
                    right_segment: (found: bool, segment: sview @source) = ga_module_alias_target_segment_at(right_path, right_scope, state, right_before_offset, index, depth)
                    return false if not left_segment.found or not right_segment.found or left_segment.segment != right_segment.segment
                return true

        def ga_module_lexical_child(name: sview, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current < state.parents.count |current|:
                    child: usize = ga_child(state, current, name)
                    return child if child < state.modules.count
                    break if current == 0
                    current <- state.parents[current]
                return state.modules.count

        # Resolve a complete module path through non-root lexical namespaces. Root lookup
        # is intentionally left until after alias rewriting at a use site.
        def ga_module_lexical_path(path: sview, first: sview, start_index: usize, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current != 0 and current < state.parents.count |current|:
                    child: usize = ga_child(state, current, first)
                    if child < state.modules.count:
                        candidate: usize = ga_module_path_suffix(path, start_index, child, state)
                        return candidate if candidate < state.modules.count
                    current <- state.parents[current]
                return state.modules.count

        def ga_module_path_suffix(path: sview, start_index: usize, base_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if base_scope >= state.modules.count or start_index > path.len
                current: mutable usize = base_scope
                start: mutable usize = start_index
                while start < path.len |start, current|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    part: sview = effect_ref_trim_layout(path[start:end])
                    return state.modules.count if part.len == 0
                    current <- ga_child(state, current, part)
                    return state.modules.count if current >= state.modules.count
                    return state.modules.count if end < path.len and (end + 2 >= path.len or path[end + 1] != 58)
                    start <- path.len if end == path.len else end + 2
                return current

        # Split a qualified source path into borrowed components. Keeping the original
        # spelling as parts lets expression lookup apply lexical, alias, and raw-root
        # candidates to the complete qualifier instead of resolving one Expr.Scope node
        # at a time.
        def ga_module_path_parts(path: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                return [] if path.len == 0
                parts: mutable darray[sview] = []
                start: mutable usize = 0
                offset: mutable usize = 0
                while offset < path.len |start, offset, parts, path|:
                    if path[offset] == 58:
                        return [] if offset + 1.usize() >= path.len or path[offset + 1.usize()] != 58
                        parts.push(effect_ref_trim_layout(path[start:offset]))
                        offset <- offset + 2.usize()
                        start <- offset
                    else:
                        offset <- offset + 1.usize()
                parts.push(effect_ref_trim_layout(path[start:path.len]))
                return parts

        def ga_module_path_parts_suffix(parts: darray[sview]&, start_index: usize, base_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if base_scope >= state.modules.count or start_index > parts.count
                current: mutable usize = base_scope
                index: mutable usize = start_index
                while index < parts.count |current, index, parts, state|:
                    return state.modules.count if parts[index].len == 0
                    current <- ga_child(state, current, parts[index])
                    return state.modules.count if current >= state.modules.count
                    index <- index + 1.usize()
                return current

        # Stage0 checks a complete candidate in the current namespace, then each
        # enclosing namespace. The root spelling is deliberately left for after alias
        # rewriting, because a visible alias beats a same-named root module.
        def ga_module_lexical_parts_path(parts: darray[sview]&, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if parts.count == 0 or lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current != 0 and current < state.parents.count |current, parts, state|:
                    child: usize = ga_child(state, current, parts[0])
                    if child < state.modules.count:
                        candidate: usize = ga_module_path_parts_suffix(parts, 1, child, state)
                        return candidate if candidate < state.modules.count
                    current <- state.parents[current]
                return state.modules.count

        def ga_module_parts_resolve(parts: darray[sview]&, lexical_scope: usize, state: GlobalAuthority&, depth: u32 = 0, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if parts.count == 0 or lexical_scope >= state.parents.count
                for part in parts:
                    return state.modules.count if part.len == 0
                lexical: usize = ga_module_lexical_parts_path(parts, lexical_scope, state)
                return lexical if lexical < state.modules.count

                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(parts[0], lexical_scope, state, depth, before_offset)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    if target.found:
                        resolved: usize = ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1, alias_row.offset)
                        return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                        if resolved < state.modules.count:
                            alias_path: usize = ga_module_path_parts_suffix(parts, 1, resolved, state)
                            return alias_path if alias_path < state.modules.count

                # The final Stage0 candidate is the raw spelling in the root namespace.
                raw_root: usize = ga_child(state, 0, parts[0])
                return ga_module_path_parts_suffix(parts, 1, raw_root, state)

        def ga_module_expression_parts(expression: Ast::Expr, parts: mutable darray[sview]&, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                match expression:
                    Expr.Ident(name, _):
                        parts.push(effect_ref_trim_layout(name))
                        return true
                    Expr.Scope(base, name, _):
                        return false if not ga_module_expression_parts(base, parts, depth + 1)
                        parts.push(effect_ref_trim_layout(name))
                        return true
                    Expr.Paren(inner, _):
                        return ga_module_expression_parts(inner, parts, depth + 1)
                    _:
                        return false

        # Resolve an unaliased target relative to exactly the module where its alias was
        # declared. Do not climb to a same-named root module; the using-site resolver owns
        # fallback to the alias's raw spelling when this canonical target is absent.
        def ga_module_path_exact(path: sview, declaration_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if declaration_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                first_scope: usize = ga_child(state, declaration_scope, first)
                return state.modules.count if first_scope >= state.modules.count
                start: usize = path.len if first_end == path.len else first_end + 2
                return ga_module_path_suffix(path, start, first_scope, state)

        # Resolve a `using TARGET as ALIAS` target. A complete concrete candidate in the
        # declaration module wins before an earlier visible alias can rewrite its head.
        # Any alias rewrite still uses only declarations earlier than the current alias,
        # matching Stage0 registration order; unresolved targets stay anchored here.
        def ga_module_alias_target_resolve(path: sview @source, declaration_scope: usize, state: GlobalAuthority&, depth: u32 = 0, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if declaration_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                exact_path: usize = ga_module_path_exact(path, declaration_scope, state)
                return exact_path if exact_path < state.modules.count
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, declaration_scope, state, depth, before_offset)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                return exact_path if not alias.found
                alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                return GLOBAL_AUTHORITY_NONE if not target.found
                resolved: usize = ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1, alias_row.offset)
                return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                return state.modules.count if resolved >= state.modules.count
                start: usize = path.len if first_end == path.len else first_end + 2
                return ga_module_path_suffix(path, start, resolved, state)

        # Resolve a module path at a use site. A complete concrete candidate in the
        # current or enclosing namespace wins first, then a visible alias rewrites the
        # head, then the original spelling is tried at root. Import annotations keep
        # their own lookup order and call this helper with use_site_child_precedence=false.
        def ga_module_alias_resolve(path: sview, lexical_scope: usize, state: GlobalAuthority&, depth: u32 = 0, use_site_child_precedence: bool = false, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if lexical_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                start: usize = path.len if first_end == path.len else first_end + 2
                if use_site_child_precedence:
                    lexical_path: usize = ga_module_lexical_path(path, first, start, lexical_scope, state)
                    return lexical_path if lexical_path < state.modules.count
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, lexical_scope, state, depth, before_offset)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                resolved: mutable usize = state.modules.count
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    if not target.found:
                        return GLOBAL_AUTHORITY_NONE if not use_site_child_precedence
                    else:
                        resolved <- ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1, alias_row.offset)
                        return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                if use_site_child_precedence:
                    if alias.found and resolved < state.modules.count:
                        alias_path: usize = ga_module_path_suffix(path, start, resolved, state)
                        return alias_path if alias_path < state.modules.count
                    raw_root: usize = ga_child(state, 0, first)
                    return ga_module_path_suffix(path, start, raw_root, state)
                if not alias.found or resolved >= state.modules.count:
                    resolved <- ga_module_lexical_child(first, lexical_scope, state)
                return state.modules.count if resolved >= state.modules.count
                return ga_module_path_suffix(path, start, resolved, state)
