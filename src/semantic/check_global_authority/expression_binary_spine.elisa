extend Semantic:
    private:
        # Search conjunction/disjunction trees left to right without using a
        # native frame for every left-associated condition.
        def ga_condition_origin_spine(expression: Ast::Expr, binder: sview, state: mutable GlobalAuthority&) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                pending: mutable darray[Ast::Expr] = []
                while true |current, pending, state|:
                    if current is Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And or operator == TokenKind.Or:
                            if pending.count >= 1000:
                                ga_mark_walk_overflow(Ast::expr_pos(current), state)
                                return null
                            pending.push(right)
                            current <- left
                            continue
                    result: Ast::Expr? = ga_condition_origin_inner(current, binder, state)
                    return origin if result is origin
                    return null if pending.count == 0
                    current <- pending[pending.count - 1]
                    pending.truncate(pending.count - 1)

        # A conjunction's bindings are the union of its parts; preserve the
        # original left-to-right order while avoiding a recursive left spine.
        def ga_gather_truthy_condition_spine(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                pending: mutable darray[Ast::Expr] = []
                while current is Expr.Binary(left, operator, right, _) |current, pending, state|:
                    break if operator != TokenKind.And
                    if pending.count >= 1000:
                        ga_mark_walk_overflow(Ast::expr_pos(current), state)
                        return
                    pending.push(right)
                    current <- left
                ga_gather_truthy_condition_bindings_inner(current, table, state, bound) can Global{Read,Write}
                while pending.count > 0 |pending, state, bound|:
                    node: Ast::Expr = pending[pending.count - 1]
                    pending.truncate(pending.count - 1)
                    ga_gather_truthy_condition_bindings(node, table, state, bound) can Global{Read,Write}

        # Apply each node's inline grants before descending into its children.
        def ga_expression_inline_grants(expression: Ast::Expr, state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                at: Ast::Pos = Ast::expr_pos(expression)
                while next_index > 0 |next_index: usize = ga_inline_limit(at.offset, state), state|:
                    index: usize = next_index - 1
                    next_index <- index
                    break if state.inline_prefix_ends[index] <= at.offset
                    span: Ast::Pos = state.inline_spans[index]
                    if at.offset >= span.offset and at.offset < span.end_offset:
                        grant: sview = state.inline_refs[index]
                        if not state.report:
                            if not ga_refs_cover_at(state.firewalls, state.firewall_scopes, state.firewall_offsets, grant, state.inline_scopes[index], state, span.offset):
                                _ = ga_row_add(state.function, grant, true, state, state.inline_scopes[index], 0, span.offset) can Global{Read,Write}
                            state.reads[state.function] <- true if ga_ref_covers(grant, "Global.Read", state.inline_scopes[index], 0, state, 0, span.offset, GLOBAL_AUTHORITY_OFFSET_NONE) and not ga_refs_cover_at(state.firewalls, state.firewall_scopes, state.firewall_offsets, "Global.Read", 0, state, GLOBAL_AUTHORITY_OFFSET_NONE)
                            state.writes[state.function] <- true if ga_ref_covers(grant, "Global.Write", state.inline_scopes[index], 0, state, 0, span.offset, GLOBAL_AUTHORITY_OFFSET_NONE) and not ga_refs_cover_at(state.firewalls, state.firewall_scopes, state.firewall_offsets, "Global.Write", 0, state, GLOBAL_AUTHORITY_OFFSET_NONE)

        # Preserve the recursive walk's pre-order grants and post-order RHS
        # visits, while keeping the left-associated binary spine off the stack.
        def ga_expression_binary_spine(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                pending: mutable darray[Ast::Expr] = []
                while current is Expr.Binary(left, _, _, _) |current, pending, state|:
                    break if not (left is Expr.Binary(_, _, _, _))
                    if pending.count >= 1000:
                        ga_mark_walk_overflow(Ast::expr_pos(current), state)
                        return
                    ga_expression_inline_grants(current, state) can Global{Read,Write}
                    pending.push(current)
                    current <- left
                table <- ga_expression_inner(current, state, table, false, false) can Global{Read,Write}
                while pending.count > 0 |pending, state, table|:
                    node: Ast::Expr = pending[pending.count - 1]
                    pending.truncate(pending.count - 1)
                    table <- ga_expression_inner(node, state, table, true, true) can Global{Read,Write}

