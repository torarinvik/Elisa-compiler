extend Semantic:
    private:
        def ga_reference_origin(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > 32
                if ga_cast_operand(expression) is cast_operand:
                    # A cast from a value with no origin (an integer address) names no
                    # global binding: the result is detached storage.
                    cast_origin: usize = ga_reference_origin(cast_operand, state, depth + 1)
                    return GLOBAL_AUTHORITY_LOCAL_ALIAS if cast_origin == GLOBAL_AUTHORITY_NONE
                    return cast_origin
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ga_reference_origin(inner, state, depth + 1)
                    # `new[region] value` produces fresh storage in the selected arena.
                    # It does not alias mutable global storage; the expression visitor
                    # still walks its allocated value operand normally.
                    Expr.RegionNew(_, _, _):
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Ampersand:
                            direct_global: usize = ga_place_global(operand, state)
                            return direct_global if direct_global < state.globals.count
                            local_address_origin: usize = ga_local_address_origin(operand, state)
                            return local_address_origin if local_address_origin != GLOBAL_AUTHORITY_NONE
                            alias_origin: usize = ga_local_reference_origin(operand, state, depth + 1)
                            return alias_origin if alias_origin != GLOBAL_AUTHORITY_NONE
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return ga_reference_origin(operand, state, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack
                        return GLOBAL_AUTHORITY_NONE
                    Expr.Ident(name, _):
                        local_index: usize = ga_local_slot(name, state)
                        if local_index < state.local_global_origins.count:
                            origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                            return origin if origin != GLOBAL_AUTHORITY_NONE
                            # Every alias to a global records its exact origin where it is
                            # created; a local with none holds detached storage (stage0).
                            return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_expression_is_reference(expression, state, depth + 1)
                            return ga_expression_reference_origin(expression, state, depth + 1)
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index < state.locals.count
                        global_slot: usize = ga_global(expression, state)
                        if global_slot < state.globals.count and ga_expression_is_reference(state.global_types[global_slot], state, depth + 1):
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return SemanticGlobalAuthorityOrigin::opaque_expression_origin(true, ga_type_expression_contains_reference(state.global_types[global_slot], state, depth + 1)) if global_slot < state.globals.count
                        # Neither a local nor a global (`result` in a contract, a function
                        # name): no global binding is named, so its storage is detached.
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS
                    Expr.Call(callee, arguments, labels, _):
                        variant_slot: usize = ga_enum_variant_slot(callee, state)
                        return ga_enum_constructor_origin(variant_slot, arguments, labels, state, depth + 1) if variant_slot < state.enum_variant_names.count
                        # A dict lookup yields what the receiver holds: no new alias.
                        match callee:
                            Expr.Field(lookup_receiver, lookup_method, _):
                                if lookup_method == "get" and ga_annotation(lookup_receiver, state, depth + 1) is receiver_type:
                                    return ga_reference_origin(lookup_receiver, state, depth + 1) if ga_known_struct(receiver_type, ga_expression_type_scope(lookup_receiver, state, depth + 1), state, depth + 1) >= state.struct_names.count
                            _:
                                pass
                        opaque_origin: usize = ga_expression_reference_origin(expression, state, depth + 1)
                        return opaque_origin if opaque_origin != GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return ga_call_result_origin(callee, arguments, labels, state, depth + 1)
                    Expr.If(_, then_value, else_value, _):
                        then_origin: usize = ga_reference_origin(then_value, state, depth + 1)
                        # `return X if c` has no else value: only X can be produced.
                        return then_origin if else_value is Expr.Absent
                        return ga_join_origins(state, then_origin, ga_reference_origin(else_value, state, depth + 1))
                    Expr.Match(_, _, _):
                        return ga_expression_reference_origin(expression, state, depth + 1)
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        # Literal storage is static and immutable, never a mutable global.
                        return GLOBAL_AUTHORITY_NONE
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        origin: mutable usize = GLOBAL_AUTHORITY_NONE
                        for element in elements |origin, state| -> origin:
                            element_origin: usize = ga_reference_origin(element, state, depth + 1)
                            origin <- ga_join_origins(state, origin, element_origin)
                        return origin
                    # The recovery block's yields are walked as statements, where each alias
                    # is charged at its own creation; the value keeps the guarded origin.
                    Expr.GetElse(guarded, _, _):
                        return ga_reference_origin(guarded, state, depth + 1)
                    Expr.Comprehension(_, iterable, _, body, _, _):
                        # Elements come from the iterable and the body; the binder itself
                        # is not a slot here, so it reads as detached storage.
                        return ga_join_origins(state, ga_reference_origin(iterable, state, depth + 1), ga_reference_origin(body, state, depth + 1))
                    Expr.DictLit(entries, _):
                        origin: mutable usize = GLOBAL_AUTHORITY_NONE
                        for entry in entries |origin, state| -> origin:
                            key_origin: usize = ga_reference_origin(entry.key, state, depth + 1)
                            value_origin: usize = ga_reference_origin(entry.value, state, depth + 1)
                            origin <- ga_join_origins(state, origin, key_origin)
                            origin <- ga_join_origins(state, origin, value_origin)
                        return origin
                    Expr.Construct(type_expression, fields, _):
                        origin: mutable usize = GLOBAL_AUTHORITY_NONE
                        for field in fields |origin, state| -> origin:
                            field_origin: usize = ga_reference_origin(field.value, state, depth + 1)
                            origin <- ga_join_origins(state, origin, field_origin)
                        if ga_type_expression_contains_reference(type_expression, state, depth + 1) and ga_construct_omits_reference_field(type_expression, fields, state):
                            return SemanticGlobalAuthorityOrigin::constructor_origin(origin, false)
                        return SemanticGlobalAuthorityOrigin::constructor_origin(origin, true)
                    Expr.RecordUpdate(base, fields, _):
                        origin: mutable usize = ga_reference_origin(base, state, depth + 1)
                        for field in fields |origin, state| -> origin:
                            field_origin: usize = ga_reference_origin(field.value, state, depth + 1)
                            origin <- ga_join_origins(state, origin, field_origin)
                        return origin
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _):
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_loaded_reference(expression, state)
                        origin: usize = ga_local_reference_origin(expression, state, depth + 1)
                        return origin if origin != GLOBAL_AUTHORITY_NONE
                        # A projection rooted in neither a global place nor a recorded alias
                        # cannot reach a global: every global alias records its origin.
                        return ga_expression_reference_origin(expression, state, depth + 1) if ga_place_global(expression, state) < state.globals.count
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_local_storage_slot(expression, state) < state.locals.count
                        return ga_expression_reference_origin(expression, state, depth + 1)
                    Expr.Binary(left, operator, right, _):
                        # Pointer arithmetic stays inside the storage its reference operand
                        # names; the integer operand contributes no origin of its own.
                        if operator == TokenKind.Plus or operator == TokenKind.Minus:
                            return ga_reference_origin(left, state, depth + 1) if ga_integer_valued(right, state, depth + 1)
                            return ga_reference_origin(right, state, depth + 1) if ga_integer_valued(left, state, depth + 1)
                            left_origin: usize = ga_reference_origin(left, state, depth + 1)
                            right_origin: usize = ga_reference_origin(right, state, depth + 1)
                            return ga_join_origins(state, left_origin, right_origin)
                        # Only pointer arithmetic can yield a reference; logic and comparison
                        # results are plain values even where they carry no inferred type.
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if ga_expression_is_reference(expression, state, depth + 1)
                        return GLOBAL_AUTHORITY_NONE
                    _:
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if ga_expression_is_reference(expression, state, depth + 1)
                        return ga_expression_reference_origin(expression, state, depth + 1)

        def ga_local_storage_slot(expression: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                depth: mutable u32 = 0
                while true |current, depth, state|:
                    if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                        ga_mark_walk_overflow(Ast::expr_pos(current), state)
                        return GLOBAL_AUTHORITY_NONE
                    match current:
                        Expr.Ident(name, _):
                            return ga_local_slot(name, state)
                        Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _) | Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                            current <- base
                            depth <- depth + 1
                        _:
                            return GLOBAL_AUTHORITY_NONE
                return GLOBAL_AUTHORITY_NONE

        # For aggregate-content updates, a local reference binding names its live local
        # referent when that target is known. Other uses keep ga_local_storage_slot's
        # binding-slot semantics.
        def ga_local_referent_storage_slot(expression: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                local_index: usize = ga_local_storage_slot(expression, state)
                return local_index if local_index >= state.locals.count or local_index >= state.local_types.count
                if state.local_types[local_index] is root_type and ga_reference_type(root_type, state, 0):
                    origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state) if local_index < state.local_global_origins.count else GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    root_index: usize = ga_local_origin_index(origin, state)
                    return root_index if root_index < state.locals.count
                    return state.locals.count
                return local_index

        # Borrowing a local place names that place's storage, not the references
        # contained in its value. A projection through a reference binding instead
        # names storage reached through that binding, so preserve the binding origin.
        def ga_local_address_origin(expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                depth: mutable u32 = 0
                projected: mutable bool = false
                while true |current, depth, projected, state|:
                    if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    match current:
                        Expr.Ident(name, _):
                            local_index: usize = ga_local_slot(name, state)
                            return GLOBAL_AUTHORITY_NONE if local_index >= state.locals.count
                            return ga_local_origin(local_index, state) if not projected
                            if local_index < state.local_types.count and state.local_types[local_index] is root_type:
                                return ga_validate_local_origin(state.local_global_origins[local_index], state) if ga_reference_type(root_type, state, 0) and local_index < state.local_global_origins.count
                                return ga_local_origin(local_index, state) if not ga_reference_type(root_type, state, 0)
                            return ga_local_origin(local_index, state)
                        Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _):
                            current <- base
                            projected <- true
                            depth <- depth + 1
                        Expr.Paren(base, _) | Expr.Move(base, _):
                            current <- base
                            depth <- depth + 1
                        Expr.Unary(operator, base, _):
                            if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack:
                                current <- base
                                depth <- depth + 1
                            else:
                                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        _:
                            return GLOBAL_AUTHORITY_NONE
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS

        # The reference-binding pass classifies a real rebind. Keep exact global roots for
        # direct places and fail closed for reference-producing expressions this walk cannot
        # resolve, so a later local use cannot erase the global authority requirement.
        def ga_reference_rebind_origin(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > 32
                if ga_cast_operand(expression) is cast_operand:
                    # A cast from a value with no origin (an integer address) names no
                    # global binding: the result is detached storage.
                    cast_origin: usize = ga_reference_rebind_origin(cast_operand, state, depth + 1)
                    return GLOBAL_AUTHORITY_LOCAL_ALIAS if cast_origin == GLOBAL_AUTHORITY_NONE
                    return cast_origin
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ga_reference_rebind_origin(inner, state, depth + 1)
                    Expr.GetElse(guarded, _, _):
                        return ga_reference_origin(guarded, state, depth + 1)
                    # A newly allocated reference is detached from mutable globals.
                    # Keep this explicit so local bindings initialized by `new[...]`
                    # do not become unknown aliases requiring Global.Read.
                    Expr.RegionNew(_, _, _):
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Ampersand:
                            direct_global: usize = ga_place_global(operand, state)
                            return direct_global if direct_global < state.globals.count
                            local_address_origin: usize = ga_local_address_origin(operand, state)
                            return local_address_origin if local_address_origin != GLOBAL_AUTHORITY_NONE
                            alias_origin: usize = ga_local_reference_origin(operand, state, depth + 1)
                            return alias_origin if alias_origin != GLOBAL_AUTHORITY_NONE
                            return GLOBAL_AUTHORITY_NONE if ga_local_storage_slot(operand, state) < state.locals.count
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return ga_reference_rebind_origin(operand, state, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    Expr.Ident(name, _):
                        # `null` parses as a keyword identifier and names no storage.
                        return GLOBAL_AUTHORITY_NONE if name == "null"
                        local_index: usize = ga_local_slot(name, state)
                        return ga_validate_local_origin(state.local_global_origins[local_index], state) if local_index < state.local_global_origins.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index < state.locals.count
                        # A declared function's address is code, even when cast to a
                        # raw reference. A same-named storage binding takes priority.
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_global(expression, state) >= state.globals.count and ga_named_callee_slot(expression, state) < state.functions.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    Expr.Scope(_, _, _):
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_global(expression, state) >= state.globals.count and ga_named_callee_slot(expression, state) < state.functions.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        return GLOBAL_AUTHORITY_NONE
                    Expr.Call(_, _, _, _) | Expr.If(_, _, _, _) | Expr.Match(_, _, _) | Expr.Binary(_, _, _, _):
                        # Same opaque-result rule as ga_reference_origin: only a result whose
                        # type may carry a reference (or is unknown) stays an unknown alias.
                        return ga_reference_origin(expression, state, depth + 1)
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _):
                        # A projection names storage reached through its root, exactly as
                        # ga_reference_origin resolves it; unknown roots stay unknown.
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_loaded_reference(expression, state)
                        projected_origin: usize = ga_local_reference_origin(expression, state, depth + 1)
                        return projected_origin if projected_origin != GLOBAL_AUTHORITY_NONE
                        return ga_reference_origin(expression, state, depth + 1)
                    _:
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS

        def ga_local_reference_binding_origin(type_expression: Ast::Expr?, value: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                if type_expression is declared_type and ga_reference_type(declared_type, state, 0, ga_expression_type_scope(value, state, 0)):
                    # A reference stored in a global aggregate may use an unqualified
                    # alias from that aggregate's module. Keep the root as its scope
                    # provenance so later projections resolve the same field types.
                    return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_loaded_reference(value, state)
                    global_slot: usize = ga_place_global(value, state)
                    return global_slot if global_slot < state.globals.count
                    return ga_reference_rebind_origin(value, state, 0)
                # A binding whose declared type holds no reference cannot carry an alias.
                if type_expression is scalar_type:
                    return GLOBAL_AUTHORITY_NONE if not ga_type_expression_contains_reference(scalar_type, state, 0) and ga_expression_type_scope(value, state, 0) != GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                return ga_reference_origin(value, state, 0)

        def ga_access_unknown_alias(at: Ast::Pos, write: bool, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                required: sview = SemanticGlobalAuthorityOrigin::unknown_alias_permission(write)
                return if ga_refs_cover_at(state.firewalls, state.firewall_scopes, state.firewall_offsets, required, 0, state, at.offset)
                if not state.report:
                    _ = ga_row_add(state.function, required, true, state, GLOBAL_AUTHORITY_NONE, 0, at.offset) can Global{Read,Write}
                    if write:
                        state.writes[state.function] <- true
                    else:
                        state.reads[state.function] <- true
                elif not ga_granted(required, at, state):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalPermissionUngranted, name: "write" if write else "read", expected: required, actual: "unknown mutable reference alias", line: at.line, pos: ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)})

        def ga_reference_rebind(target: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match target:
                    Expr.Ident(_, _):
                        assignment_site: u64 = rbm_assignment_site_key(Ast::expr_pos(target))
                        return false if assignment_site == 0
                        return effect == RBM_ASSIGN_EFFECT_REBIND if table.ref_assignment_modes.get(assignment_site) is effect
                        return false
                    Expr.Paren(inner, _):
                        return ga_reference_rebind(inner, table)
                    _:
                        return false

        def ga_update_reference_origin(target: Ast::Expr, value: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        local_index: usize = ga_local_slot(name, state)
                        return GLOBAL_AUTHORITY_NONE if local_index >= state.locals.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index >= state.local_global_origins.count
                        source_origin: usize = ga_reference_rebind_origin(value, state, 0)
                        previous_origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                        if previous_origin == GLOBAL_AUTHORITY_NONE:
                            state.local_global_origins[local_index] <- source_origin
                        elif previous_origin != source_origin:
                            state.local_global_origins[local_index] <- ga_join_origins(state, previous_origin, source_origin)
                        return state.local_global_origins[local_index]
                    Expr.Paren(inner, _):
                        return ga_update_reference_origin(inner, value, state)
                    _:
                        return GLOBAL_AUTHORITY_NONE

        # By-value aggregate origins summarize references reachable from a local root. A
        # subplace store can add another origin, so join it with the old summary instead
        # of leaving a stale local-only alias behind. Direct reference bindings keep their
        # storage origin here; merging aggregate contents into that slot would lose the
        # distinction between where the binding points and what its referent contains.
        def ga_join_aggregate_reference_origin(target: Ast::Expr, value: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                local_index: usize = ga_local_referent_storage_slot(target, state)
                return GLOBAL_AUTHORITY_NONE if local_index >= state.locals.count
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index >= state.local_global_origins.count
                previous_origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                state.local_global_origins[local_index] <- previous_origin if previous_origin != state.local_global_origins[local_index]
                return previous_origin if previous_origin == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                if local_index < state.local_types.count and state.local_types[local_index] is root_type:
                    return previous_origin if ga_reference_type(root_type, state, 0)
                # A slot whose declared type holds no reference cannot receive an alias, whatever
                # the value's spelling (`p.flag <- p.flag or other` has no inferred type).
                if ga_annotation(target, state, 0) is target_type:
                    return previous_origin if not ga_type_expression_contains_reference(target_type, state, 0)
                if ga_annotation(value, state, 0) is value_type:
                    return previous_origin if not ga_type_expression_contains_reference(value_type, state, 0)
                source_origin: usize = ga_reference_origin(value, state, 0)
                return previous_origin if source_origin == GLOBAL_AUTHORITY_NONE
                joined_origin: usize = ga_join_origins(state, previous_origin, source_origin)
                state.local_global_origins[local_index] <- joined_origin
                return joined_origin

        # A call through a mutable aggregate may replace or synthesize contained
        # references. If the callee's write is opaque, discard a precise local-only
        # summary so subsequent projections fail closed.
        def ga_mark_aggregate_origin_unknown_if_mutated(target: Ast::Expr, state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                local_index: usize = ga_local_referent_storage_slot(target, state)
                return if local_index >= state.locals.count or local_index >= state.local_global_origins.count
                origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                state.local_global_origins[local_index] <- origin if origin != state.local_global_origins[local_index]
                return if state.local_global_origins[local_index] == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                if local_index < state.local_types.count and state.local_types[local_index] is root_type:
                    return if ga_reference_type(root_type, state, 0)
                if ga_annotation(target, state, 0) is type_expression:
                    return if not ga_mutation_can_change_reference_contents(type_expression, state, 0)
                # A global alias the callee stores here is charged at that store (stage0's
                # creation rule), so the contents become detached storage, not unknown.
                state.local_global_origins[local_index] <- ga_join_origins(state, state.local_global_origins[local_index], GLOBAL_AUTHORITY_LOCAL_ALIAS)

        # `return r` from a reference-returning function hands the reference itself
        # back without touching its referent. The caller sees an opaque call result,
        # so an unknown alias stays fail-closed at the caller's first access.
        def ga_returns_reference_local(returned: Ast::Expr, state: mutable GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if state.lambda_depth != 0
                declared_return: Ast::Expr = get state.return_type else return false
                return false if not ga_reference_type(declared_return, state, 0)
                current: mutable Ast::Expr = returned
                while true |current|:
                    match current:
                        Expr.Paren(inner, _) | Expr.Move(inner, _):
                            current <- inner
                        Expr.Ident(name, _):
                            local_index: usize = ga_local_slot(name, state)
                            return false if local_index >= state.locals.count or local_index >= state.local_types.count or local_index >= state.local_global_origins.count
                            if state.local_types[local_index] is local_type:
                                return false if not ga_reference_type(local_type, state, 0)
                            else:
                                return false
                            origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                            return origin >= state.globals.count
                        _:
                            return false
                return false

