# Atomic storage accepts scalar payloads only. This pass validates every retained
# annotation position; operation-specific numeric restrictions are checked separately.

extend Semantic:
    private:
        def declared_struct_name(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any symbol in table.symbols where symbol.name == name and symbol.kind == SymbolKind.Struct

        def atomic_payload_name(payload: Ast::Expr) -> sview:
            can Abort.Panic:
                match payload:
                    Expr.Ident(name, line):
                        return name
                    Expr.Index(head, argument, line):
                        return ident_name_of(head)
                    Expr.IndexN(head, arguments, line):
                        return ident_name_of(head)
                    Expr.Tuple(elements, line):
                        return "tuple"
                    _:
                        return "aggregate"

        def check_atomic_annotation(type_expression: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line) if operator == TokenKind.Mutable or operator == TokenKind.Lmut:
                        table <- check_atomic_annotation(operand, line, table)
                    Expr.Index(head, payload, index_line):
                        if ident_name_of(head) == "atomic":
                            invalid: bool = match payload:
                                Expr.Ident(payload_name, payload_line): declared_struct_name(payload_name, table)
                                Expr.Index(payload_head, payload_argument, payload_index_line): true
                                Expr.IndexN(payload_head_n, payload_arguments, payload_index_n_line): true
                                Expr.Tuple(payload_elements, payload_tuple_line): true
                                Expr.Unary(payload_operator, payload_operand, payload_unary_line): payload_operator == TokenKind.Question
                                _: false
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AtomicUnsafePayload, name: atomic_payload_name(payload), line: line, expected: "", actual: ""}) if invalid
                    _:
                        pass

        def check_atomic_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_atomic_annotation(type_expression, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_atomic_statements(then_body, table)
                            table <- check_atomic_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_atomic_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_atomic_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_atomic_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_atomic_statements(arm.body, table)
                        _:
                            pass

        def check_atomic_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for param in params |table|:
                                table <- check_atomic_annotation(param.type_expression, line, table)
                            table <- check_atomic_annotation(result_type, line, table) if return_type is result_type
                            table <- check_atomic_statements(body, table)
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |table|:
                                table <- check_atomic_annotation(member.type_expression, line, table)
                        Decl.Alias(name, target, line):
                            table <- check_atomic_annotation(target, line, table)
                        Decl.Const(name, type_expression, value, is_mutable, line):
                            table <- check_atomic_annotation(type_expression, line, table)
                        Decl.Module(name, body, line):
                            table <- check_atomic_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_atomic_declarations(body, table)
                        _:
                            pass

    public:
        def check_atomic_payload(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_atomic_declarations(declarations, table)
