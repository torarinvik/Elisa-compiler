# References to linear-containing values are unsupported. A `linear` value (or a container
# whose elements are linear) holds must-consume handles; a reference to it would let the
# handle be observed while ownership lives elsewhere, so stage0 rejects a parameter typed
# as a reference to such a value:
#
#   def drain(gs: mutable darray[Guard]&) -> void:   # Guard is `linear`
#       ...                                          # error: references to values
#                                                    # containing linear handles ... got
#                                                    # darray[Guard]&
#
# A reference type is `Expr.Unary(Ampersand, ...)`; `mutable`/`lmut` wrappers strip. The
# referent is linear-containing when it is a `darray`/`set` of a linear struct, or a bare
# linear struct. Reuses the linear-struct registry from check_darray_linear_consume.
extend Semantic:
    private:
        # Peel `&`/`mutable`/`lmut`/paren wrappers off a param type. Returns whether a `&`
        # was seen (a reference) and the referent core type expression.
        def lref_strip(type_expression: Ast::Expr, seen_ref: bool) -> (is_ref: bool, core: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        lref_strip(operand, true) return if operator == TokenKind.Ampersand
                        lref_strip(operand, seen_ref) return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return (seen_ref, type_expression)
                    Expr.Paren(inner, paren_line):
                        return lref_strip(inner, seen_ref)
                    _:
                        return (seen_ref, type_expression)

        def lref_check_declarations(declarations: darray[Ast::Decl], linear_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for parameter in parameters |table| -> table:
                                stripped: (is_ref: bool, core: Ast::Expr) = lref_strip(parameter.type_expression, false)
                                if stripped.is_ref:
                                    # darray[E]/set[E] of a linear element.
                                    if darray_linear_element(stripped.core, linear_names):
                                        head_arg: (head: sview, argument: sview) = dd_type_head_arg(stripped.core)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LinearReferenceUnsupported, name: parameter.name, line: line.line, expected: head_arg.argument, actual: head_arg.head})
                                    # A bare `linear` struct reference (`Guard&`).
                                    if stripped.core is Expr.Ident(core_name, core_line):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LinearReferenceUnsupported, name: parameter.name, line: line.line, expected: "", actual: core_name}) if darray_linear_name_present(linear_names, core_name)
                        Decl.Module(module_name, module_body, module_line):
                            table <- lref_check_declarations(module_body, linear_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- lref_check_declarations(scoped_body, linear_names, table)
                        _:
                            pass

    public:
        def check_linear_reference(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                linear_names: mutable darray[sview] = []
                darray_linear_type_names(file.top_decls, linear_names)
                table <- lref_check_declarations(file.top_decls, linear_names, table)
