extend Semantic:
    private:
        # Check if a value expression is a call to a known void function.
        # If so, push a VoidValueUse diagnostic.
        # The bare target name of an assignment (for the cannot-bind message); ""
        # for non-ident targets (fields, indexes).
        def assign_target_name(target: Ast::Expr) -> sview:
            return match target:
                Expr.Ident(target_name, target_line): target_name
                _: ""

        def flag_if_void_call(value: Ast::Expr, binding_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # `_ = side_effect()` is the explicit-discard form — discarding a void
                # call to the wildcard is exactly how you spell "run it for effect",
                # so stage0 accepts it. Only a NAMED binding of void is an error.
                return if binding_name == "_"
                # `-g()` / `~g()` over a void call binds void just like a bare call —
                # stage0 reports the same cannot-bind message (void_unary_operand.pos).
                if value is Expr.Unary(unary_operator, unary_operand, unary_line):
                    table <- flag_if_void_call(unary_operand, binding_name, table)
                if value is Expr.Call(callee, args, names, line):
                    if callee is Expr.Ident(fn_name, fn_line):
                        if find_symbol(table, fn_name) is sym:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidValueUse, name: fn_name, line: line, expected: binding_name, actual: ""}) if direct_function_count(table, fn_name) == 1 and sym.kind == SymbolKind.Func and sym.return_type == "void"


        def flag_return_void_call(value: Ast::Expr, return_type: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if return_type == "" or return_type == "void"
                if value is Expr.Call(callee, args, names, call_line):
                    if callee is Expr.Ident(fn_name, fn_line):
                        if find_symbol(table, fn_name) is sym:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: "return", line: line, expected: return_type, actual: "void"}) if direct_function_count(table, fn_name) == 1 and sym.kind == SymbolKind.Func and sym.return_type == "void"


        # Check for void function calls used as values in statement lists.
        def check_void_value_use_statements(statements: darray[Ast::Stmt], return_type: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- flag_if_void_call(value, name, table)
                        Stmt.Assign(target, operator, value, line):
                            # Check for assignment (=) only, not mutation (<-) — the threading
                            # pattern `table <- func(args)` is idiomatic Elisa (docs/lmut).
                            table <- flag_if_void_call(value, assign_target_name(target), table) if operator == TokenKind.Assign
                        Stmt.Return(maybe_value, line):
                            # Returning a void call from a void function is accepted by
                            # stage0. Return-signature validation owns all other cases.
                            table <- flag_return_void_call(returned_value, return_type, line, table) if maybe_value is returned_value
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_void_value_use_statements(then_body, return_type, table)
                            table <- check_void_value_use_statements(else_body, return_type, table)
                        Stmt.While(condition, body, line):
                            table <- check_void_value_use_statements(body, return_type, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_void_value_use_statements(body, return_type, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_void_value_use_statements(body, return_type, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_void_value_use_statements(arm.body, return_type, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Check for void function calls used as values in all declarations
        # (recursing through Func/Module/Scoped).
        def check_void_value_use(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            return_name: mutable sview = "void"
                            return_name <- bare_type_name(return_expression) if return_type is return_expression
                            table <- check_void_value_use_statements(body, return_name, table)
                        Decl.Module(name, body, line):
                            table <- check_void_value_use(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_value_use(body, table)
                        _:
                            pass
