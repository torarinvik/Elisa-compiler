extend Semantic:
    private:
        # Check if a value expression is a call to a known void function.
        # If so, push a VoidValueUse diagnostic.
        def flag_if_void_call(value: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if value is Expr.Call(callee, args, names, line):
                    if callee is Expr.Ident(fn_name, fn_line):
                        if find_symbol(table, fn_name) is sym:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidValueUse, name: fn_name, line: line, expected: "", actual: ""}) if direct_function_count(table, fn_name) == 1 and sym.kind == SymbolKind.Func and sym.return_type == "void"


        # Check for void function calls used as values in statement lists.
        def check_void_value_use_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- flag_if_void_call(value, table)
                        Stmt.Assign(target, operator, value, line):
                            # Check for assignment (=) only, not mutation (<-) — the threading
                            # pattern `table <- func(args)` is idiomatic Elisa (docs/lmut).
                            table <- flag_if_void_call(value, table) if operator == TokenKind.Assign
                        Stmt.Return(maybe_value, line):
                            if maybe_value is returned_expr:
                                table <- flag_if_void_call(returned_expr, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_void_value_use_statements(then_body, table)
                            table <- check_void_value_use_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_void_value_use_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_void_value_use_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_void_value_use_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_void_value_use_statements(arm.body, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Check for void function calls used as values in all declarations
        # (recursing through Func/Module/Scoped).
        def check_void_value_use(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_void_value_use_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_void_value_use(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_value_use(body, table)
                        _:
                            pass
