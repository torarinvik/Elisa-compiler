extend Semantic:
    private:
        # Whether a call to `owner` requires an effect grant at the call site: it either
        # DECLARES signature effects or INFERS one (untrusted panic in body). One sound hop
        # of stage0's transitive effect inference.
        # The first declared signature-effect ref of `owner` ("Abort.Panic",
        # "Console", ...), or "Abort.Panic" when the effect is inferred from an
        # untrusted body panic, or "" when the function carries no effect. Used to
        # render stage0's exact ungranted-call warning text.
        def function_first_effect_ref(table: SymbolTable&, owner: sview) -> sview:
            can Abort.Panic:
                if table.effect_owner_indexed == table.function_effect_owner.count:
                    effect_row: mutable u32 = effect_owner_chain_head(table, owner)
                    while effect_row != SYMBOL_INDEX_ROW_NONE |effect_row, table, owner|:
                        if table.function_effect_owner[effect_row.usize()] == owner:
                            return table.function_effect_name[effect_row.usize()]
                        effect_row <- table.effect_owner_next[effect_row.usize()]
                else:
                    while effect_row_index < table.function_effect_owner.count |effect_row_index: usize = 0|:
                        return table.function_effect_name[effect_row_index] if table.function_effect_owner[effect_row_index] == owner
                        effect_row_index <- effect_row_index + 1
                if table.effect_source_indexed == table.function_effect_source_owner.count:
                    source_row: mutable u32 = effect_source_chain_head(table, owner)
                    while source_row != SYMBOL_INDEX_ROW_NONE |source_row, table, owner|:
                        if table.function_effect_source_owner[source_row.usize()] == owner:
                            recorded: sview = table.function_effect_source_ref[source_row.usize()] if source_row.usize() < table.function_effect_source_ref.count else ""
                            return recorded if recorded != "" else "Abort.Panic"
                        source_row <- table.effect_source_next[source_row.usize()]
                else:
                    while source_index < table.function_effect_source_owner.count |source_index: usize = 0|:
                        if table.function_effect_source_owner[source_index] == owner:
                            recorded: sview = table.function_effect_source_ref[source_index] if source_index < table.function_effect_source_ref.count else ""
                            return recorded if recorded != "" else "Abort.Panic"
                        source_index <- source_index + 1
                return ""

        # The canonical declared effect refs of `owner`, including the concrete `via`
        # requirement rows recorded by symbol collection. A bare family suppresses its
        # member rows, matching stage0's permission-ref canonicalization. The small insertion
        # sort keeps diagnostics deterministic and matches stage0's lexical ordering.
        def effect_ref_less(left: sview, right: sview) -> bool:
            can Abort.Panic:
                limit: usize = left.len if left.len < right.len else right.len
                while index < limit |index: usize = 0|:
                    return true if left[index] < right[index]
                    return false if left[index] > right[index]
                    index <- index + 1.usize()
                return left.len < right.len

        def function_effect_refs(table: SymbolTable&, owner: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                collected: mutable darray[sview] = []
                if table.effect_owner_indexed == table.function_effect_owner.count:
                    row: mutable u32 = effect_owner_chain_head(table, owner)
                    while row != SYMBOL_INDEX_ROW_NONE |row, table, owner, collected|:
                        if table.function_effect_owner[row.usize()] == owner:
                            candidate: sview = table.function_effect_name[row.usize()]
                            duplicate: bool = any existing in collected where existing == candidate
                            collected.push(candidate) if not duplicate
                        row <- table.effect_owner_next[row.usize()]
                else:
                    while row_index < table.function_effect_owner.count |row_index: usize = 0|:
                        if table.function_effect_owner[row_index] == owner:
                            candidate: sview = table.function_effect_name[row_index]
                            duplicate: bool = any existing in collected where existing == candidate
                            collected.push(candidate) if not duplicate
                        row_index <- row_index + 1.usize()
                if collected.count == 0:
                    if table.effect_source_indexed == table.function_effect_source_owner.count:
                        source_row: mutable u32 = effect_source_chain_head(table, owner)
                        while source_row != SYMBOL_INDEX_ROW_NONE |source_row, table, owner, collected|:
                            if table.function_effect_source_owner[source_row.usize()] == owner:
                                inferred: mutable sview = table.function_effect_source_ref[source_row.usize()] if source_row.usize() < table.function_effect_source_ref.count else ""
                                inferred <- "Abort.Panic" if inferred == ""
                                collected.push(inferred) if not (any existing in collected where existing == inferred)
                            source_row <- table.effect_source_next[source_row.usize()]
                    else:
                        while source_index < table.function_effect_source_owner.count |source_index: usize = 0|:
                            if table.function_effect_source_owner[source_index] == owner:
                                inferred: mutable sview = table.function_effect_source_ref[source_index] if source_index < table.function_effect_source_ref.count else ""
                                inferred <- "Abort.Panic" if inferred == ""
                                collected.push(inferred) if not (any existing in collected where existing == inferred)
                            source_index <- source_index + 1.usize()
                # The Global family is INFERRED, never declared-only: a function that declares
                # `can[Memory.Allocate]` and also reads a global requires BOTH (stage0 unions
                # its declared and inferred refs). The fallback above consults the inferred
                # rows only when nothing is declared, so the Global rows are merged in
                # unconditionally. Nothing registers them unless `-Wglobals` is on, which is
                # what keeps this a no-op on a default build.
                if table.effect_source_indexed == table.function_effect_source_owner.count:
                    global_row: mutable u32 = effect_source_chain_head(table, owner)
                    while global_row != SYMBOL_INDEX_ROW_NONE |global_row, table, owner, collected|:
                        if table.function_effect_source_owner[global_row.usize()] == owner:
                            global_ref: sview = table.function_effect_source_ref[global_row.usize()] if global_row.usize() < table.function_effect_source_ref.count else ""
                            is_global_ref: bool = effect_ref_family(global_ref) == "Global"
                            collected.push(global_ref) if is_global_ref and not (any existing in collected where existing == global_ref)
                        global_row <- table.effect_source_next[global_row.usize()]
                else:
                    while global_index < table.function_effect_source_owner.count |global_index: usize = 0, collected|:
                        if table.function_effect_source_owner[global_index] == owner:
                            global_ref: sview = table.function_effect_source_ref[global_index] if global_index < table.function_effect_source_ref.count else ""
                            is_global_ref: bool = effect_ref_family(global_ref) == "Global"
                            collected.push(global_ref) if is_global_ref and not (any existing in collected where existing == global_ref)
                        global_index <- global_index + 1
                # If both `P` and `P.Member` are present, stage0 retains the whole-family
                # ref and drops the more specific rows.
                canonical: mutable darray[sview] = []
                for candidate in collected:
                    family: sview = effect_ref_family(candidate)
                    has_bare: bool = any bare in collected where bare == family
                    canonical.push(candidate) if not (has_bare and candidate != family)
                for outer in 0..<canonical.count |canonical|:
                    position: mutable usize = outer
                    while position > 0.usize() |position, canonical|:
                        break if not effect_ref_less(canonical[position], canonical[position - 1.usize()])
                        swap: sview = canonical[position - 1.usize()]
                        canonical[position - 1.usize()] <- canonical[position]
                        canonical[position] <- swap
                        position <- position - 1.usize()
                return canonical

        # DECLARED-only variant: the first signature-declared effect ref of `owner`,
        # ignoring body-inferred registry entries (whose ref is a heuristic). Used by
        # the postfix-grant coverage check, which must not over-fire on inferred refs.
        def function_first_declared_effect_ref(table: SymbolTable&, owner: sview) -> sview:
            can Abort.Panic:
                if table.effect_owner_indexed == table.function_effect_owner.count:
                    row: mutable u32 = effect_owner_chain_head(table, owner)
                    while row != SYMBOL_INDEX_ROW_NONE |row, table, owner|:
                        if table.function_effect_owner[row.usize()] == owner:
                            return table.function_effect_name[row.usize()]
                        row <- table.effect_owner_next[row.usize()]
                else:
                    while declared_index < table.function_effect_owner.count |declared_index: usize = 0|:
                        return table.function_effect_name[declared_index] if table.function_effect_owner[declared_index] == owner
                        declared_index <- declared_index + 1
                return ""

        # The concrete permission named after `via`, or empty when this is an ordinary
        # permission/effect reference. `via` remains part of the source spelling in the
        # abstract row; callers get a separate concrete row for authority checking.
        def effect_ref_via(effect_ref: sview) -> sview:
            via_index: mutable usize = 0
            depth: mutable int = 0
            while via_index + 2.usize() < effect_ref.len |via_index, depth|:
                byte: u8 = effect_ref[via_index]
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                is_via: bool = depth == 0 and effect_ref[via_index] == 118 and effect_ref[via_index + 1.usize()] == 105 and effect_ref[via_index + 2.usize()] == 97
                before_is_boundary: bool = via_index == 0.usize() or not ((effect_ref[via_index - 1.usize()] >= 48 and effect_ref[via_index - 1.usize()] <= 57) or (effect_ref[via_index - 1.usize()] >= 65 and effect_ref[via_index - 1.usize()] <= 90) or (effect_ref[via_index - 1.usize()] >= 97 and effect_ref[via_index - 1.usize()] <= 122) or effect_ref[via_index - 1.usize()] == 95)
                after_index: mutable usize = via_index + 3.usize()
                after_is_boundary: bool = after_index >= effect_ref.len or not ((effect_ref[after_index] >= 48 and effect_ref[after_index] <= 57) or (effect_ref[after_index] >= 65 and effect_ref[after_index] <= 90) or (effect_ref[after_index] >= 97 and effect_ref[after_index] <= 122) or effect_ref[after_index] == 95)
                if is_via and before_is_boundary and after_is_boundary:
                    while after_index < effect_ref.len and (effect_ref[after_index] == 32 or effect_ref[after_index] == 9 or effect_ref[after_index] == 13) |after_index|:
                        after_index <- after_index + 1.usize()
                    return effect_ref[after_index:effect_ref.len]
                via_index <- via_index + 1.usize()
            return sview("", 0, 0)

        def effect_ref_trim_layout(effect_ref: sview) -> sview:
            start: mutable usize = 0
            finish: mutable usize = effect_ref.len
            while start < finish and (effect_ref[start] == 32 or effect_ref[start] == 9 or effect_ref[start] == 13) |start, finish, effect_ref|:
                start <- start + 1.usize()
            while finish > start and (effect_ref[finish - 1.usize()] == 32 or effect_ref[finish - 1.usize()] == 9 or effect_ref[finish - 1.usize()] == 13) |finish, start, effect_ref|:
                finish <- finish - 1.usize()
            return effect_ref[start:finish]

        # The abstract row of a two-dimensional effect reference. Handler
        # specialization compares this part; `via` is checked as a separate
        # concrete permission row and is never part of the abstract identity.
        def effect_ref_abstract(effect_ref: sview) -> sview:
            abstract_index: mutable usize = 0
            depth: mutable int = 0
            while abstract_index + 2.usize() < effect_ref.len |abstract_index, depth|:
                byte: u8 = effect_ref[abstract_index]
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                is_via: bool = depth == 0 and effect_ref[abstract_index] == 118 and effect_ref[abstract_index + 1.usize()] == 105 and effect_ref[abstract_index + 2.usize()] == 97
                before_is_boundary: bool = abstract_index == 0.usize() or not ((effect_ref[abstract_index - 1.usize()] >= 48 and effect_ref[abstract_index - 1.usize()] <= 57) or (effect_ref[abstract_index - 1.usize()] >= 65 and effect_ref[abstract_index - 1.usize()] <= 90) or (effect_ref[abstract_index - 1.usize()] >= 97 and effect_ref[abstract_index - 1.usize()] <= 122) or effect_ref[abstract_index - 1.usize()] == 95)
                after_index: mutable usize = abstract_index + 3.usize()
                after_is_boundary: bool = after_index >= effect_ref.len or not ((effect_ref[after_index] >= 48 and effect_ref[after_index] <= 57) or (effect_ref[after_index] >= 65 and effect_ref[after_index] <= 90) or (effect_ref[after_index] >= 97 and effect_ref[after_index] <= 122) or effect_ref[after_index] == 95)
                return effect_ref_trim_layout(effect_ref[0:abstract_index]) if is_via and before_is_boundary and after_is_boundary
                abstract_index <- abstract_index + 1.usize()
            return effect_ref_trim_layout(effect_ref)

        # Return the opening brace of a well-formed grouped permission, or zero. A group is
        # `Family{Member, Member}`; only top-level commas split members. Invalid groups are
        # deliberately left as ordinary unknown spellings so they cannot grant a family.
        def effect_ref_group_open(effect_ref: sview) -> usize:
            can Abort.Panic:
                length: usize = effect_ref.len
                return 0 if length < 4.usize() or effect_ref[length - 1.usize()] != 125
                square_depth: mutable int = 0
                paren_depth: mutable int = 0
                brace_depth: mutable int = 0
                opening: mutable usize = 0
                while index < length |index: usize = 0, square_depth, paren_depth, brace_depth, opening|:
                    byte: u8 = effect_ref[index]
                    if byte == 123 and square_depth == 0 and paren_depth == 0 and brace_depth == 0:
                        opening <- index
                        break
                    square_depth <- square_depth + 1 if byte == 91
                    square_depth <- square_depth - 1 if byte == 93 and square_depth > 0
                    paren_depth <- paren_depth + 1 if byte == 40
                    paren_depth <- paren_depth - 1 if byte == 41 and paren_depth > 0
                    brace_depth <- brace_depth + 1 if byte == 123
                    brace_depth <- brace_depth - 1 if byte == 125 and brace_depth > 0
                    index <- index + 1.usize()
                return 0 if opening == 0 or opening + 1.usize() >= length - 1.usize()
                member_count: usize = effect_ref_group_member_count_at(effect_ref, opening)
                return opening if member_count > 0 else 0

        def effect_ref_group_member_count_at(effect_ref: sview, opening: usize) -> usize:
            can Abort.Panic:
                length: usize = effect_ref.len
                return 0 if opening == 0 or opening >= length or effect_ref[length - 1.usize()] != 125
                count: mutable usize = 0
                item_start: mutable usize = opening + 1.usize()
                square_depth: mutable int = 0
                paren_depth: mutable int = 0
                while index < length - 1.usize() |index: usize = opening + 1.usize(), count, item_start, square_depth, paren_depth|:
                    byte: u8 = effect_ref[index]
                    return 0 if byte == 123 or byte == 125
                    if byte == 44 and square_depth == 0 and paren_depth == 0:
                        return 0 if not effect_ref_group_member_is_name(effect_ref[item_start:index])
                        count <- count + 1.usize()
                        item_start <- index + 1.usize()
                    square_depth <- square_depth + 1 if byte == 91
                    square_depth <- square_depth - 1 if byte == 93 and square_depth > 0
                    paren_depth <- paren_depth + 1 if byte == 40
                    paren_depth <- paren_depth - 1 if byte == 41 and paren_depth > 0
                    index <- index + 1.usize()
                return 0 if:
                    square_depth != 0 or paren_depth != 0
                    not effect_ref_group_member_is_name(effect_ref[item_start:length - 1.usize()])
                return count + 1.usize()

        def effect_ref_group_member_is_name(member_ref: sview) -> bool:
            can Abort.Panic:
                member: sview = effect_ref_trim_layout(member_ref)
                length: usize = member.len
                return false if length == 0
                first: u8 = member[0]
                return false if not ((first >= 65 and first <= 90) or (first >= 97 and first <= 122) or first == 95)
                while index < length |index: usize = 1, member|:
                    byte: u8 = member[index]
                    return false if not ((byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95)
                    index <- index + 1.usize()
                return true

        def effect_ref_group_member_at(effect_ref: sview, opening: usize, member_index: usize) -> sview:
            can Abort.Panic:
                return "" if opening == 0 or member_index >= effect_ref_group_member_count_at(effect_ref, opening)
                length: usize = effect_ref.len
                item_start: mutable usize = opening + 1.usize()
                item_index: mutable usize = 0
                square_depth: mutable int = 0
                paren_depth: mutable int = 0
                brace_depth: mutable int = 0
                while index < length - 1.usize() |index: usize = opening + 1.usize(), item_start, item_index, square_depth, paren_depth, brace_depth|:
                    byte: u8 = effect_ref[index]
                    if byte == 44 and square_depth == 0 and paren_depth == 0 and brace_depth == 0:
                        return effect_ref_trim_layout(effect_ref[item_start:index]) if item_index == member_index
                        item_index <- item_index + 1.usize()
                        item_start <- index + 1.usize()
                    square_depth <- square_depth + 1 if byte == 91
                    square_depth <- square_depth - 1 if byte == 93 and square_depth > 0
                    paren_depth <- paren_depth + 1 if byte == 40
                    paren_depth <- paren_depth - 1 if byte == 41 and paren_depth > 0
                    brace_depth <- brace_depth + 1 if byte == 123
                    brace_depth <- brace_depth - 1 if byte == 125 and brace_depth > 0
                    index <- index + 1.usize()
                return effect_ref_trim_layout(effect_ref[item_start:length - 1.usize()]) if item_index == member_index
                return ""

        def effect_ref_group_has_member(effect_ref: sview, member: sview) -> bool:
            can Abort.Panic:
                opening: usize = effect_ref_group_open(effect_ref)
                return false if opening == 0 or member == ""
                for index in 0..<effect_ref_group_member_count_at(effect_ref, opening) |effect_ref, opening, member|:
                    return true if effect_ref_group_member_at(effect_ref, opening, index) == member
                return false

        # Whether a grouped grant contains every member of a grouped requirement. A bare
        # family grant is handled by its caller because it covers members beyond the group.
        def effect_ref_group_covers_group(grant_ref: sview, required_ref: sview) -> bool:
            can Abort.Panic:
                grant_open: usize = effect_ref_group_open(grant_ref)
                required_open: usize = effect_ref_group_open(required_ref)
                return false if grant_open == 0 or required_open == 0 or effect_ref_family(grant_ref) != effect_ref_family(required_ref)
                for index in 0..<effect_ref_group_member_count_at(required_ref, required_open) |index, grant_ref, required_ref, required_open|:
                    return false if not effect_ref_group_has_member(grant_ref, effect_ref_group_member_at(required_ref, required_open, index))
                return true

        # The member portion of `Family.Member`, excluding a `via` realization.
        def effect_ref_member(effect_ref: sview) -> sview:
            can Abort.Panic:
                abstract_ref: sview = effect_ref_abstract(effect_ref)
                return "" if effect_ref_group_open(abstract_ref) > 0
                depth: mutable int = 0
                while index < abstract_ref.len |index: usize = 0, depth|:
                    byte: u8 = abstract_ref[index]
                    if byte == 46 and depth == 0:
                        return abstract_ref[index + 1.usize():abstract_ref.len]
                    depth <- depth + 1 if byte == 91 or byte == 40
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41)
                    index <- index + 1.usize()
                return ""

        # Whether a plain effect reference spells exactly FAMILY.MEMBER.
        def effect_ref_is_family_member(effect_ref: sview, family: sview, member: sview) -> bool:
            can Abort.Panic:
                return false if:
                    family == "" or member == ""
                    effect_ref.len != family.len + 1.usize() + member.len
                    effect_ref[family.len] != 46
                for index in 0..<family.len |effect_ref, family|:
                    return false if effect_ref[index] != family[index]
                for index in 0..<member.len |effect_ref, family, member|:
                    return false if effect_ref[family.len + 1.usize() + index] != member[index]
                return true

        # The permission FAMILY of an effect ref: the segment before the first '.', '[' or
        # valid grouped-member brace. Generic abstract effects retain their full surface name.
        # Generic abstract effects such as `Writer[sview]` retain their full surface spelling
        # in function rows, but grant coverage and diagnostics operate on the family head.
        def effect_ref_family(effect_ref: sview) -> sview:
            can Abort.Panic:
                abstract_ref: sview = effect_ref_abstract(effect_ref)
                family_start: mutable usize = 0
                group_open: usize = effect_ref_group_open(abstract_ref)
                while dot_index < abstract_ref.len |dot_index: usize = 0|:
                    # Namespace qualification is not a new effect family:
                    # `Effects::Tick` has the same row identity as `Tick`.
                    if abstract_ref[dot_index] == 58 and dot_index + 1.usize() < abstract_ref.len and abstract_ref[dot_index + 1.usize()] == 58:
                        family_start <- dot_index + 2.usize()
                        dot_index <- dot_index + 2.usize()
                        continue
                    return abstract_ref[family_start:dot_index] if abstract_ref[dot_index] == '.' or abstract_ref[dot_index] == '[' or (group_open > 0 and dot_index == group_open)
                    dot_index <- dot_index + 1
                return abstract_ref[family_start:abstract_ref.len]

        def function_has_effect(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                return function_declares_effect(table, owner) or function_body_panics(table, owner)
