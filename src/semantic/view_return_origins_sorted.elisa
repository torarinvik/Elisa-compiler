# Keyed lookup over view-return-origin rows (view_return_origins.elisa).
#
# The rows are a flat darray[sview], five entries per row, and every consumer scans all of
# them per call expression for the rows whose first two entries equal a (name, arity-tag)
# or (marker, name) key -- one full scan per call site, so quadratic in the unit. Once a
# pass has finished building its rows, vro_sort_rows returns a copy headed by a marker row
# and stably sorted by those two entries. The scan helpers then start at the first row of
# the key (binary search) and stop after its last; on unsorted rows (still being built)
# they degrade to the full scan. Every consumer acts only on rows whose first two entries
# equal its key, and the stable sort keeps those rows in their original relative order, so
# the sorted scan visits exactly the rows the full scan would act on, in the same order.
extend Semantic:
    private:
        def vro_rows_sorted(rows: darray[sview]&) -> bool:
            can Abort.Panic:
                return rows.count >= VRO_ROW_WIDTH and rows[VRO_SORTED_MARKER_INDEX] == VRO_SORTED_MARKER

        # Independent recursive specification of bytewise lexicographic ordering. The
        # production comparator below is iterative so large identifiers do not consume
        # recursive stack; this ghost definition gives its exact first-difference meaning.
        ghost def vro_text_compare_reference_from(left: sview, right: sview, position: usize) -> i32:
            requires position <= left.len and position <= right.len
            decreases (left.len if left.len < right.len else right.len) - position
            if position == left.len or position == right.len:
                VRO_COMPARE_LESS return if left.len < right.len
                VRO_COMPARE_GREATER return if left.len > right.len
                return VRO_COMPARE_EQUAL
            VRO_COMPARE_LESS return if left[position] < right[position]
            VRO_COMPARE_GREATER return if left[position] > right[position]
            return vro_text_compare_reference_from(left, right, position + VRO_BYTE_STEP)

        # A prefix whose bytes agree cannot change the comparison result. This recursive
        # lemma lets the loop below carry a small prefix fact instead of asking the solver
        # to discover induction over the entire byte range at each early-return branch.
        ghost def vro_text_compare_prefix_preserves(left: sview, right: sview, position: usize) -> bool:
            requires position <= left.len and position <= right.len
            requires forall prefix_index in VRO_FIRST_BYTE_POSITION..<position: left[prefix_index] == right[prefix_index]
            decreases position
            ensure result == true
            ensure vro_text_compare_reference_from(left, right, VRO_FIRST_BYTE_POSITION) == vro_text_compare_reference_from(left, right, position)
            return true if position == VRO_FIRST_BYTE_POSITION
            return vro_text_compare_prefix_preserves(left, right, position - VRO_BYTE_STEP)

        # The first differing byte reverses sign when the operands swap; equal prefixes
        # recurse together, and an exhausted prefix reverses by length. This is the key
        # order law used when the comparator drives merges and lower-bound searches.
        ghost def vro_text_compare_reference_swap(left: sview, right: sview, position: usize) -> bool:
            requires position <= left.len and position <= right.len
            decreases (left.len if left.len < right.len else right.len) - position
            ensure result == true
            ensure vro_text_compare_reference_from(left, right, position) == -vro_text_compare_reference_from(right, left, position)
            if position == left.len or position == right.len:
                return true
            if left[position] < right[position]:
                return true
            if left[position] > right[position]:
                return true
            return vro_text_compare_reference_swap(left, right, position + VRO_BYTE_STEP)

        # Byte-wise three-way comparison.
        def vro_text_compare(left: sview, right: sview) -> i32:
            ensure result == vro_text_compare_reference_from(left, right, VRO_FIRST_BYTE_POSITION)
            ensure result >= VRO_COMPARE_LESS and result <= VRO_COMPARE_GREATER
            can Abort.Panic:
                left_length: usize = left.len
                right_length: usize = right.len
                shared: usize = left_length if left_length < right_length else right_length
                for position in VRO_FIRST_BYTE_POSITION..<shared |left, right|:
                    invariant position <= shared
                    invariant forall prefix_index in VRO_FIRST_BYTE_POSITION..<position: left[prefix_index] == right[prefix_index]
                    invariant vro_text_compare_prefix_preserves(left, right, position)
                    if left[position] != right[position]:
                        VRO_COMPARE_LESS return if left[position] < right[position]
                        return VRO_COMPARE_GREATER
                VRO_COMPARE_LESS return if left_length < right_length
                VRO_COMPARE_GREATER return if left_length > right_length
                return VRO_COMPARE_EQUAL

        def vro_key_compare(rows: darray[sview]&, row: usize, first: sview, second: sview) -> i32:
            can Abort.Panic:
                head: i32 = vro_text_compare(rows[row], first)
                head return if head != VRO_COMPARE_EQUAL
                return vro_text_compare(rows[row + VRO_ROW_ARITY_OFFSET], second)

        def vro_rows_less(rows: darray[sview]&, left_row: usize, right_row: usize) -> bool:
            can Abort.Panic:
                return vro_key_compare(rows, left_row, rows[right_row], rows[right_row + VRO_ROW_ARITY_OFFSET]) < VRO_COMPARE_EQUAL

        # Offset of the first row a scan for (FIRST, SECOND) must visit.
        def vro_scan_start(rows: darray[sview]&, first: sview, second: sview) -> usize:
            can Abort.Panic:
                VRO_FIRST_ROW_INDEX return if not vro_rows_sorted(rows)
                low: mutable usize = VRO_FIRST_DATA_ROW_INDEX
                high: mutable usize = rows.count / VRO_ROW_WIDTH
                while low < high |low, high, rows, first, second|:
                    middle: usize = low + (high - low) / VRO_BINARY_SEARCH_DIVISOR
                    if vro_key_compare(rows, middle * VRO_ROW_WIDTH, first, second) < VRO_COMPARE_EQUAL:
                        low <- middle + VRO_BYTE_STEP
                    else:
                        high <- middle
                return low * VRO_ROW_WIDTH

        # Whether a scan for (FIRST, SECOND) at offset ROW still has rows to visit.
        def vro_scan_live(rows: darray[sview]&, row: usize, first: sview, second: sview) -> bool:
            can Abort.Panic:
                false return if row + VRO_ROW_FIELD_OFFSET >= rows.count
                true return if not vro_rows_sorted(rows)
                return rows[row] == first and rows[row + VRO_ROW_ARITY_OFFSET] == second

        # Marker row plus the complete rows of ROWS, stably sorted by their first two entries
        # (bottom-up merge sort of row offsets).
        def vro_sort_rows(rows: darray[sview]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                order: mutable darray[usize] = []
                scratch: mutable darray[usize] = []
                while row + VRO_ROW_FIELD_OFFSET < rows.count |row: usize = VRO_FIRST_ROW_INDEX, order, scratch|:
                    order.push(row)
                    scratch.push(row)
                    row <- row + VRO_ROW_WIDTH
                width: mutable usize = VRO_INITIAL_MERGE_WIDTH
                while width < order.count |width, order, scratch, rows|:
                    start: mutable usize = VRO_FIRST_ROW_INDEX
                    while start < order.count |start, width, order, scratch, rows|:
                        middle: usize = start + width if start + width < order.count else order.count
                        stop: usize = start + VRO_MERGE_PAIR_COUNT * width if start + VRO_MERGE_PAIR_COUNT * width < order.count else order.count
                        left: mutable usize = start
                        right: mutable usize = middle
                        target: mutable usize = start
                        while target < stop |target, left, right, middle, stop, order, scratch, rows|:
                            take_right: bool = right < stop and (left >= middle or vro_rows_less(rows, order[right], order[left]))
                            if take_right:
                                scratch[target] <- order[right]
                                right <- right + VRO_BYTE_STEP
                            else:
                                scratch[target] <- order[left]
                                left <- left + VRO_BYTE_STEP
                            target <- target + VRO_BYTE_STEP
                        start <- stop
                    for index in VRO_FIRST_ROW_INDEX..<order.count |order, scratch|:
                        order[index] <- scratch[index]
                    width <- width * VRO_MERGE_PAIR_COUNT
                sorted: mutable darray[sview] = [VRO_SORTED_MARKER, "", "", "", ""]
                for offset in order |sorted, rows|:
                    sorted.push(rows[offset])
                    sorted.push(rows[offset + VRO_ROW_ARITY_OFFSET])
                    sorted.push(rows[offset + VRO_ROW_POSITION_OFFSET])
                    sorted.push(rows[offset + VRO_ROW_MODE_OFFSET])
                    sorted.push(rows[offset + VRO_ROW_FIELD_OFFSET])
                return sorted
