# Keyed lookup over view-return-origin rows (view_return_origins.elisa).
#
# The rows are a flat darray[sview], five entries per row, and every consumer scans all of
# them per call expression for the rows whose first two entries equal a (name, arity-tag)
# or (marker, name) key -- one full scan per call site, so quadratic in the unit. Once a
# pass has finished building its rows, vro_sort_rows returns a copy headed by a marker row
# and stably sorted by those two entries. The scan helpers then start at the first row of
# the key (binary search) and stop after its last; on unsorted rows (still being built)
# they degrade to the full scan. Every consumer acts only on rows whose first two entries
# equal its key, and the stable sort keeps those rows in their original relative order, so
# the sorted scan visits exactly the rows the full scan would act on, in the same order.
extend Semantic:
    private:
        def vro_rows_sorted(rows: darray[sview]&) -> bool:
            can Abort.Panic:
                return rows.count >= 5 and rows[0] == "[vro-sorted]"

        # Byte-wise three-way comparison.
        def vro_text_compare(left: sview, right: sview) -> i32:
            can Abort.Panic:
                left_length: usize = sview_len(left)
                right_length: usize = sview_len(right)
                shared: usize = left_length if left_length < right_length else right_length
                for position in 0..<shared |left, right|:
                    if left[position] != right[position]:
                        -1 return if left[position] < right[position]
                        return 1
                -1 return if left_length < right_length
                1 return if left_length > right_length
                return 0

        def vro_key_compare(rows: darray[sview]&, row: usize, first: sview, second: sview) -> i32:
            can Abort.Panic:
                head: i32 = vro_text_compare(rows[row], first)
                head return if head != 0
                return vro_text_compare(rows[row + 1], second)

        def vro_rows_less(rows: darray[sview]&, left_row: usize, right_row: usize) -> bool:
            can Abort.Panic:
                return vro_key_compare(rows, left_row, rows[right_row], rows[right_row + 1]) < 0

        # Offset of the first row a scan for (FIRST, SECOND) must visit.
        def vro_scan_start(rows: darray[sview]&, first: sview, second: sview) -> usize:
            can Abort.Panic:
                0 return if not vro_rows_sorted(rows)
                low: mutable usize = 1
                high: mutable usize = rows.count / 5
                while low < high |low, high, rows, first, second|:
                    middle: usize = low + (high - low) / 2
                    if vro_key_compare(rows, middle * 5, first, second) < 0:
                        low <- middle + 1
                    else:
                        high <- middle
                return low * 5

        # Whether a scan for (FIRST, SECOND) at offset ROW still has rows to visit.
        def vro_scan_live(rows: darray[sview]&, row: usize, first: sview, second: sview) -> bool:
            can Abort.Panic:
                false return if row + 4 >= rows.count
                true return if not vro_rows_sorted(rows)
                return rows[row] == first and rows[row + 1] == second

        # Marker row plus the complete rows of ROWS, stably sorted by their first two entries
        # (bottom-up merge sort of row offsets).
        def vro_sort_rows(rows: darray[sview]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                order: mutable darray[usize] = []
                scratch: mutable darray[usize] = []
                while row + 4 < rows.count |row: usize = 0, order, scratch|:
                    order.push(row)
                    scratch.push(row)
                    row <- row + 5
                width: mutable usize = 1
                while width < order.count |width, order, scratch, rows|:
                    start: mutable usize = 0
                    while start < order.count |start, width, order, scratch, rows|:
                        middle: usize = start + width if start + width < order.count else order.count
                        stop: usize = start + 2 * width if start + 2 * width < order.count else order.count
                        left: mutable usize = start
                        right: mutable usize = middle
                        target: mutable usize = start
                        while target < stop |target, left, right, middle, stop, order, scratch, rows|:
                            take_right: bool = right < stop and (left >= middle or vro_rows_less(rows, order[right], order[left]))
                            if take_right:
                                scratch[target] <- order[right]
                                right <- right + 1
                            else:
                                scratch[target] <- order[left]
                                left <- left + 1
                            target <- target + 1
                        start <- stop
                    for index in 0..<order.count |order, scratch|:
                        order[index] <- scratch[index]
                    width <- width * 2
                sorted: mutable darray[sview] = ["[vro-sorted]", "", "", "", ""]
                for offset in order |sorted, rows|:
                    sorted.push(rows[offset])
                    sorted.push(rows[offset + 1])
                    sorted.push(rows[offset + 2])
                    sorted.push(rows[offset + 3])
                    sorted.push(rows[offset + 4])
                return sorted
