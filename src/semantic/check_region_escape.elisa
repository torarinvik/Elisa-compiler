# Nested-region store-escape (sound subset of stage0's region_containers escape check).
#
# Storing a value that lives in an INNER `region NAME:` scope into a container that lives
# in an OUTER (longer-lived) region leaves a dangling reference once the inner region is
# freed: `region outer: big @outer …; region inner: small @inner …; big.push(small)`.
#
# Stage0's full check uses region-stamped types + an outlives lattice + adoption/region-
# polymorphic exceptions. This sound subset relies ONLY on the lexical region-block nesting
# and explicit `@region` local annotations: a store `container.push(value)` where BOTH the
# container's and the value's regions are function-local `region` blocks on the current
# nesting nesting, and the container's region strictly ENCLOSES the value's, is an
# unconditional escape (the exception cases — region-polymorphic params, adopted arenas —
# use param regions that are NOT on the local block nesting, so they never match here).
extend Semantic:
    private:
        # Peel `&v` to the borrowed base.
        def view_arg_base(argument: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Unary(operator, operand, line):
                        return view_arg_base(operand) if operator == TokenKind.Ampersand else argument
                    Expr.Paren(inner, paren_line):
                        return view_arg_base(inner)
                    _:
                        return argument


        # Free functions whose RETURN type is a view family (`view[u8]`, `sview`) — the
        # result aliases an argument's backing.
        def collect_view_returning_fns(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if return_type is declared_return:
                                out.push(name) if return_type_is_view(declared_return)
                        Decl.Module(module_name, module_body, module_line):
                            collect_view_returning_fns(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_view_returning_fns(scoped_body, out)
                        _:
                            pass


        # Whether a return type is a bare OWNED container (`darray[T]`/`dstr`/`set`/`dict`/array) —
        # a value the callee allocates in the AMBIENT region. A `@region`-qualified or ref/view
        # return is excluded (it aliases longer-lived storage, not the caller's region block).
        def return_type_is_owned_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        return name == "dstr"
                    Expr.Index(object, element, index_line):
                        head: sview = ident_name_of(object)
                        return head == "darray" or head == "set" or head == "dict" or head == "array"
                    Expr.IndexN(object_n, arguments_n, index_n_line):
                        head_n: sview = ident_name_of(object_n)
                        return head_n == "darray" or head_n == "set" or head_n == "dict" or head_n == "array"
                    _:
                        return false

        # An owned-container member type through a `mutable`/paren wrapper (`mutable darray[i64]`
        # -> darray). Such a member holds inferred-region heap storage.
        def member_type_is_owned_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        member_type_is_owned_container(operand) return if operator == TokenKind.Mutable
                        return return_type_is_owned_container(type_expression)
                    Expr.Paren(inner, paren_line):
                        return member_type_is_owned_container(inner)
                    _:
                        return return_type_is_owned_container(type_expression)

        # Struct names that OWN inferred-region heap storage — a member is an owned container.
        # A function returning such a struct (built from container literals, no region param)
        # yields an inferred-region value, exactly like a bare-container return.
        def collect_container_structs(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            has_container: bool = any member in members where member_type_is_owned_container(member.type_expression)
                            out.push(struct_name) if has_container
                        Decl.Module(module_name, module_body, module_line):
                            collect_container_structs(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_container_structs(scoped_body, out)
                        _:
                            pass

        # Free functions that allocate an owned container in the AMBIENT region and return it — a
        # bare-owned-container return type OR a container-owning struct, AND no region parameters (a
        # region-poly function allocates in its region param, not the caller's block). A call to one
        # inside a region block yields a value living in that block's region.
        def region_escape_collect_container_fns(declarations: darray[Ast::Decl], container_structs: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if return_type is declared_return:
                                returns_container_struct: bool = any container_struct in container_structs where container_struct == ident_name_of(declared_return)
                                out.push(name) if (return_type_is_owned_container(declared_return) or returns_container_struct) and not func_has_region_param(parameters)
                        Decl.Module(module_name, module_body, module_line):
                            region_escape_collect_container_fns(module_body, container_structs, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            region_escape_collect_container_fns(scoped_body, container_structs, out)
                        _:
                            pass

        # Whether any parameter is an Arena/region handle — such a function may allocate its return
        # in that param region rather than the caller's ambient block, so it is not ambient-tainting.
        def region_escape_type_mentions_arena(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        return name == "Arena" or name == "Region"
                    Expr.Unary(operator, operand, unary_line):
                        return region_escape_type_mentions_arena(operand)
                    Expr.Paren(inner, paren_line):
                        return region_escape_type_mentions_arena(inner)
                    Expr.Index(object, element, index_line):
                        return region_escape_type_mentions_arena(object)
                    _:
                        return false

        def func_has_region_param(parameters: darray[Ast::ParamDecl]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any parameter in parameters where region_escape_type_mentions_arena(parameter.type_expression)

        def return_type_is_view(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return name == "sview"
                    Expr.Index(object, element, index_line):
                        return ident_name_of(object) == "view"
                    Expr.Unary(operator, operand, unary_line):
                        return return_type_is_view(operand)
                    Expr.Paren(inner, paren_line):
                        return return_type_is_view(inner)
                    _:
                        return false


        # The declared @region of a local, or "" when it carries none.
        def local_region_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                annotation_option: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, name, before_line)
                region_name: mutable sview = sview("", 0, 0)
                region_name <- present.region if annotation_option is present
                return region_name

        # The nesting position of REGION on the nesting (outer regions have smaller indices),
        # with found=false when it is not an enclosing function-local region.
        def region_stack_position(nesting: darray[sview]&, region_name: sview) -> (found: bool, position: usize):
            can Memory.Allocate, Abort.Panic:
                found_here: mutable bool = false
                position_here: mutable usize = 0
                while probe < nesting.count |probe: usize = 0, found_here, position_here|:
                    matched: bool = nesting[probe] == region_name
                    found_here <- true if matched
                    position_here <- probe if matched
                    probe <- probe + 1
                return (found_here, position_here)

        # The @region of a stored VALUE expression: a plain ident's region, or — for a list
        # literal `[v, …]` — the (single) inner region shared by its element idents. Returns
        # "" when no region-annotated value is found. Sound: only explicitly-annotated
        # idents contribute, so a region-less element yields no false region.
        def stored_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        return local_region_name(annotations, name, line)
                    Expr.Paren(inner, paren_line):
                        return stored_value_region(inner, annotations, view_fns, line)
                    Expr.Index(head, argument, index_line):
                        # A view/element of a region-local (`v[i]`) lives in the base's region.
                        return stored_value_region(head, annotations, view_fns, line)
                    Expr.Slice(object, low, high, slice_line):
                        # A slice `v[0:n]` is a view into the base's region.
                        return stored_value_region(object, annotations, view_fns, line)
                    Expr.Field(object, field, field_line):
                        # A field of a region-local lives in the same region.
                        return stored_value_region(object, annotations, view_fns, line)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        # A view-producing method on a region-local (`d.as_sview()`,
                        # `d.as_cstr()`, `d.as_view()`, `d.as_slice()`) aliases the region's
                        # backing. Other methods (`d.count()`) return owned values → not a region
                        # dependency, so only these whitelisted borrows carry the region.
                        method_region: sview = stored_view_method_region(callee, annotations, view_fns, line)
                        method_region return if method_region != ""
                        # A VIEW-returning free function's result aliases its argument's
                        # backing (`escaped <- head(&v, 1)` with v @inner ties the view
                        # to inner) — cross-function view provenance.
                        called: sview = ident_name_of(callee)
                        return_region: mutable sview = sview("", 0, 0)
                        if called != "" and (any vf in view_fns where vf == called):
                            for argument in arguments |return_region|:
                                candidate2: sview = stored_value_region(view_arg_base(argument), annotations, view_fns, line)
                                return_region <- candidate2 if return_region == "" and candidate2 != ""
                        return return_region
                    Expr.Move(inner, move_line):
                        return stored_value_region(inner, annotations, view_fns, line)
                    Expr.Array(elements, array_line):
                        element_region: mutable sview = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview = stored_value_region(element, annotations, view_fns, line)
                            element_region <- candidate if candidate != ""
                        return element_region
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        return stored_value_region(body, annotations, view_fns, line)
                    Expr.If(condition, then_expression, else_expression, if_line):
                        # A conditional value `v if c else w` escapes if EITHER branch carries
                        # an inner region.
                        then_region: sview = stored_value_region(then_expression, annotations, view_fns, line)
                        return then_region if then_region != "" else stored_value_region(else_expression, annotations, view_fns, line)
                    _:
                        return sview("", 0, 0)

        # The region of the receiver of a whitelisted view-producing method call, else "".
        def stored_view_method_region(callee: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, method, field_line):
                        is_view_method: bool = method == "as_sview" or method == "as_cstr" or method == "as_view" or method == "as_slice" or method == "as_str"
                        stored_value_region(object, annotations, view_fns, line) return if is_view_method
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Whether the grow call is `extend` (copy semantics).
        def grow_call_is_extend(callee: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, field_line):
                        return method == "extend"
                    _:
                        return false


        # Whether RECEIVER's declared element type is itself a container (`darray[darray[u8]]`):
        # extending it copies region handles, not bytes.
        def receiver_elements_are_containers(annotations: darray[Ast::LocalRegionAnnotation]&, receiver: sview, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                annotation_lookup: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, receiver, line)
                if annotation_lookup is annotation:
                    return container_element_is_container(annotation.type_expression)
                return false


        def container_element_is_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return container_element_is_container(operand)
                    Expr.Paren(inner, paren_line):
                        return container_element_is_container(inner)
                    Expr.Index(object, element, index_line):
                        head: sview = ident_name_of(object)
                        false return if head != "darray" and head != "dict"
                        return annotation_is_container(element)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        false return if head_n != "darray" and head_n != "dict"
                        return any argument in arguments_n where annotation_is_container(argument)
                    _:
                        return false


        # Report a `container.push/extend(value)` whose value region is nested strictly
        # inside (shorter-lived than) the container region.
        def region_escape_check_store(expression: Ast::Expr, line: u32, nesting: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        grow: (found: bool, receiver: sview, value_index: usize) = grow_call_info(callee)
                        return if not grow.found or grow.receiver == "" or grow.value_index >= arguments.count
                        # `extend` COPIES elements: safe for a SCALAR-element receiver, but a
                        # container-element receiver copies region HANDLES, which still escape.
                        is_extend: bool = grow_call_is_extend(callee)
                        return if is_extend and not receiver_elements_are_containers(annotations, grow.receiver, line)
                        container_region: sview = local_region_name(annotations, grow.receiver, line)
                        value_region: sview = stored_value_region(arguments[grow.value_index], annotations, view_fns, line)
                        return if container_region == "" or value_region == "" or container_region == value_region
                        container_position: (found: bool, position: usize) = region_stack_position(nesting, container_region)
                        value_position: (found: bool, position: usize) = region_stack_position(nesting, value_region)
                        escapes: bool = container_position.found and value_position.found and container_position.position < value_position.position
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: container_region, actual: value_region}) if escapes
                    _:
                        pass

        # Whether copying `value` out of its region can carry a REGION HANDLE with it.
        # stage0 flags only stores that smuggle a reference: a whole container value (a bare
        # ident, a builder call), or a projection whose ELEMENT itself is a container. A
        # scalar or POD-struct projection (`items[0].kind`, `items[0]` of `darray[Pod]`) is
        # a VALUE COPY and perfectly legal — flagging those blocked the compiler's own
        # scalar copy-out of inferred type args. Unknown shapes stay conservative-true;
        # projections default false, matching stage0's acceptance of value copies.
        def region_escape_value_carries_handles(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(carries_inner, carries_paren_line):
                        return region_escape_value_carries_handles(carries_inner, annotations, line)
                    Expr.Index(carries_object, carries_element, carries_index_line):
                        carries_base: sview = ident_name_of(carries_object)
                        false return if carries_base == ""
                        return receiver_elements_are_containers(annotations, carries_base, line)
                    Expr.Field(carries_field_object, carries_field_name, carries_field_line):
                        return false
                    _:
                        return true

        # Report a whole-value assignment `target <- value` where target's region strictly
        # encloses (outlives) the value's region — `outer_list <- [v]` with v in an inner
        # region. Only plain-ident targets with an explicit region participate.
        # A parameter whose type is a plain (non-static, non-heap) reference: its pointee lives
        # in the caller's frame and may not outlive this function, so forwarding it into a global
        # is a stale-reference escape. `static`/`heap` refs target longer-lived storage and are
        # exempt (stage0 tells you to annotate them exactly so).
        def collect_forwardable_ref_params(parameters: darray[Ast::ParamDecl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |out|:
                    is_forwardable: bool = type_contains_operator(parameter.type_expression, TokenKind.Ampersand) and not type_contains_operator(parameter.type_expression, TokenKind.Static) and not type_contains_heap(parameter.type_expression)
                    out.push(parameter.name) if is_forwardable

        # The root ident of an assignment target, walking through field/index selectors and parens
        # (`h.xs <- v` / `out.items[0] <- v` -> "h" / "out"). Storing a region value into a FIELD of
        # an outer-living aggregate dangles just as a whole-value store does, so the outlives check
        # keys on the aggregate's root.
        def region_escape_assign_target_root(target: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match target:
                    Expr.Ident(name, ident_line): name
                    Expr.Field(receiver, field_name, field_line): region_escape_assign_target_root(receiver)
                    Expr.Index(object, index, index_line): region_escape_assign_target_root(object)
                    Expr.Paren(inner, paren_line): region_escape_assign_target_root(inner)
                    _: sview("", 0, 0)

        # The callee name of a direct call VALUE (`make_users()` -> "make_users"), else "".
        def region_escape_call_callee_name(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return ident_name_of(callee)
                    Expr.Paren(inner, paren_line):
                        return region_escape_call_callee_name(inner)
                    _:
                        return sview("", 0, 0)

        # Whether an assignment target selects a FIELD (`out.p`, `a.b.c`) rather than being a
        # whole binding (`out`) — a forwarded-ref store escapes only through a field of a
        # longer-lived ref target, never a whole-binding assign (which is a type error).
        def region_escape_is_field_target(target: Ast::Expr) -> bool:
            can Abort.Panic:
                match target:
                    Expr.Field(receiver, field_name, field_line):
                        return true
                    Expr.Index(object, index, index_line):
                        return region_escape_is_field_target(object)
                    Expr.Paren(inner, paren_line):
                        return region_escape_is_field_target(inner)
                    _:
                        return false

        # The root ident of a stored VALUE expression, through field/index/paren/move selectors
        # (`inner.xs` / `mid` -> "inner" / "mid"). A `copy(x)`/other-call value has no ident root,
        # so a deep copy correctly launders the region (returns "").
        def region_value_root_ident(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Ident(name, ident_line): name
                    Expr.Field(object, field_name, field_line): region_value_root_ident(object)
                    Expr.Index(object, index, index_line): region_value_root_ident(object)
                    Expr.Paren(inner, paren_line): region_value_root_ident(inner)
                    Expr.Move(inner, move_line): region_value_root_ident(inner)
                    _: sview("", 0, 0)

        # The region a name has been TAINTED with (a value from that region flowed into it, directly
        # or via a struct field/copy), or "".
        def region_taint_lookup(taint_names: darray[sview]&, taint_regions: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                while probe < taint_names.count |found, probe: usize = 0|:
                    found <- taint_regions[probe] if taint_names[probe] == name and found == "" and name != ""
                    probe <- probe + 1
                return found

        # The region a stored value lives in: its own `@region` provenance, or — when it has none —
        # the region tainting its root ident (a struct copied/field-assigned from a region value).
        def effective_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, taint_names: darray[sview]&, taint_regions: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = stored_value_region(value, annotations, view_fns, line)
                direct return if direct != ""
                return region_taint_lookup(taint_names, taint_regions, region_value_root_ident(value))

        # The taint region a value contributes: its own @region/taint, OR — for a call to an
        # ambient-allocating container-returning function made INSIDE a region block — the innermost
        # region (the call allocates its owned result in the current block's region).
        def region_escape_stored_or_call_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, container_fns: darray[sview]&, nesting: darray[sview]&, taint_names: darray[sview]&, taint_regions: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = effective_value_region(value, annotations, view_fns, taint_names, taint_regions, line)
                direct return if direct != ""
                sview("", 0, 0) return if nesting.count == 0
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        nesting[nesting.count - 1] return if callee_name != "" and (any container_fn in container_fns where container_fn == callee_name)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def region_escape_check_assign(target: Ast::Expr, value: Ast::Expr, line: u32, nesting: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, ref_params: darray[sview]&, outer_locals: darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, taint_names: darray[sview]&, taint_regions: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                target_name: sview = region_escape_assign_target_root(target)
                return if target_name == ""
                target_is_global_mutable: bool = any global_name in mutable_globals where global_name == target_name
                # Forwarded-reference escape: a plain ref param stored into a global.
                value_name: sview = ident_name_of(value)
                value_is_ref_param: bool = value_name != "" and (any ref_name in ref_params where ref_name == value_name)
                if target_is_global_mutable and value_is_ref_param:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: "", actual: ""})
                    return
                # Forwarded-reference escape into a REF PARAMETER's field: `out.p <- x` where
                # `out: mutable Box&` points to caller-owned (longer-lived) storage and `x` is a
                # plain ref param whose pointee is only frame-local. Requires a FIELD target (a
                # whole-`out <- x` is a type error, not an escape) whose root is itself a ref param.
                target_is_field: bool = region_escape_is_field_target(target)
                target_root_is_ref_param: bool = any ref_name in ref_params where ref_name == target_name
                if target_is_field and target_root_is_ref_param and value_is_ref_param:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: "", actual: ""})
                    return
                # `dst.users <- make_users()` — an inferred-region container value (a call to an
                # owned-container / container-struct-returning free function) stored into a ref
                # parameter's field escapes: the inferred region is freed at scope exit while the
                # caller-owned target outlives it. stage0: "escapes its `in auto:` scope".
                value_callee_name: sview = region_escape_call_callee_name(value)
                value_is_container_call: bool = value_callee_name != "" and (any container_fn in container_fns where container_fn == value_callee_name)
                if target_is_field and target_root_is_ref_param and value_is_container_call:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: "", actual: ""})
                    return
                value_region: sview = effective_value_region(value, annotations, view_fns, taint_names, taint_regions, line)
                return if value_region == ""
                # A value copy that carries no region handle cannot dangle, whatever the
                # regions say (see region_escape_value_carries_handles).
                return if not region_escape_value_carries_handles(value, annotations, line)
                value_position: (found: bool, position: usize) = region_stack_position(nesting, value_region)
                # Store of a function-local region value into a GLOBAL is an unconditional escape:
                # a global outlives every function-local region, so no nesting comparison is needed.
                # The value must live in a region block currently on the nesting stack (a param
                # region — region-polymorphic/adopted — is never on the local stack, so it is not
                # flagged here, matching stage0's exceptions).
                if value_position.found and target_is_global_mutable:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: value_region, actual: value_region})
                    return
                target_region: sview = local_region_name(annotations, target_name, line)
                # Outlives escape: a value living in an active inner `region` block stored into a
                # plain local declared in an ENCLOSING scope (outside that region block). The outer
                # local outlives the region, so once the region is freed the stored reference
                # dangles ("stored into X, which outlives the region"). Only un-annotated outer
                # locals participate — a region-annotated target goes through the nesting comparison
                # below; an inner local (declared inside the region body) is not in outer_locals.
                target_is_outer_local: bool = any outer_name in outer_locals where outer_name == target_name
                # `outer_locals` is relative to the CURRENT (innermost) block, so it only proves the
                # target outlives the value's region when the value lives in that innermost region.
                # A value from an ENCLOSING region stored into a same-level local does not dangle (the
                # local does not outlive that enclosing region), so require value_region == innermost.
                value_is_innermost: bool = nesting.count > 0 and nesting[nesting.count - 1] == value_region
                if value_position.found and target_region == "" and target_is_outer_local and value_is_innermost:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: value_region, actual: value_region})
                    return
                return if target_region == "" or target_region == value_region
                target_position: (found: bool, position: usize) = region_stack_position(nesting, target_region)
                escapes: bool = target_position.found and value_position.found and target_position.position < value_position.position
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: target_region, actual: value_region}) if escapes

        # For a container-growth call, the receiver name and which argument carries the
        # stored VALUE: push/extend/add take it at index 0, dict.put at index 1 (after the
        # key). found=false for any other call.
        def grow_call_info(callee: Ast::Expr) -> (found: bool, receiver: sview, value_index: usize):
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, field_line):
                        receiver_name: sview = ident_name_of(receiver)
                        is_element_grow: bool = method == "push" or method == "extend" or method == "add"
                        is_map_put: bool = method == "put"
                        value_index: usize = 1 if is_map_put else 0
                        return (is_element_grow or is_map_put, receiver_name, value_index)
                    _:
                        return (false, sview("", 0, 0), 0)

        # Direct-level local names (VarDecls at this statement list's own level, no recursion).
        # Ordering is not tracked: a later-declared local can never be an assign target inside an
        # earlier region block (it is not yet in scope there), so the full set is a safe superset.
        def collect_level_local_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name)
                        _:
                            pass

        def region_escape_walk(statements: darray[Ast::Stmt], nesting: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, ref_params: darray[sview]&, outer_locals: darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Locals visible from a child scope = the enclosing set plus every local declared
                # directly at this level. Passed as the `outer_locals` of child region/control blocks
                # so the outlives check can tell a region-enclosed value stored into an enclosing
                # local (escape) from one stored into a region-body local (fine).
                child_outer_locals: mutable darray[sview] = [name for name in outer_locals]
                collect_level_local_names(statements, child_outer_locals)
                # Value-taint accumulated within THIS statement list: a name maps to the region a
                # value from that region flowed into it (a struct field-assigned or copied from a
                # region-local). Local to this scope — the copy-launder escape occurs within one
                # region block's body, so no cross-block threading is needed.
                taint_names: mutable darray[sview] = []
                taint_regions: mutable darray[sview] = []
                for statement in statements |table, taint_names, taint_regions| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            is_region_block: bool = kind == "region" and clause.count > 0
                            region_label: sview = clause[0] if clause.count > 0 else sview("", 0, 0)
                            child_stack: mutable darray[sview] = [entry for entry in nesting]
                            child_stack.push(region_label) if is_region_block
                            # A `can/trusted Unsafe.StaleRef:` grant discharges the
                            # forwarded-ref-into-global escape inside its body.
                            grants_stale: bool = (kind == "can" or kind == "trusted") and (any grant in clause where grant == "Unsafe.StaleRef" or grant == "StaleRef")
                            granted_ref_params: darray[sview] = [] if grants_stale else [ref_name for ref_name in ref_params]
                            table <- region_escape_walk(body, child_stack, annotations, mutable_globals, granted_ref_params, child_outer_locals, view_fns, container_fns, table)
                        Stmt.Expr(expression, line):
                            table <- region_escape_check_store(expression, line, nesting, annotations, view_fns, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- region_escape_check_store(value, line, nesting, annotations, view_fns, table)
                            # A local copied/derived from a region value carries that region's taint.
                            var_region: sview = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                            if var_region != "":
                                taint_names.push(name)
                                taint_regions.push(var_region)
                        Stmt.Assign(target, operator, value, line):
                            table <- region_escape_check_store(value, line, nesting, annotations, view_fns, table)
                            table <- region_escape_check_assign(target, value, line, nesting, annotations, mutable_globals, ref_params, outer_locals, view_fns, container_fns, taint_names, taint_regions, table)
                            # Storing a region value into a field of an aggregate taints the aggregate
                            # (`inner.xs <- v` taints `inner`); a whole-value store taints the target.
                            assign_region: sview = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                            assign_root: sview = region_escape_assign_target_root(target)
                            if assign_region != "" and assign_root != "":
                                taint_names.push(assign_root)
                                taint_regions.push(assign_region)
                        Stmt.Return(value, line):
                            if value is returned:
                                returned_region: sview = stored_value_region(returned, annotations, view_fns, line)
                                returned_position: (found: bool, position: usize) = region_stack_position(nesting, returned_region)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionReturnEscape, name: "", line: line, expected: "", actual: returned_region}) if returned_region != "" and returned_position.found
                        Stmt.If(condition, then_body, else_body, line):
                            table <- region_escape_walk(then_body, nesting, annotations, mutable_globals, ref_params, child_outer_locals, view_fns, container_fns, table)
                            table <- region_escape_walk(else_body, nesting, annotations, mutable_globals, ref_params, child_outer_locals, view_fns, container_fns, table)
                        Stmt.While(condition, while_body, line):
                            table <- region_escape_walk(while_body, nesting, annotations, mutable_globals, ref_params, child_outer_locals, view_fns, container_fns, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- region_escape_walk(for_body, nesting, annotations, mutable_globals, ref_params, child_outer_locals, view_fns, container_fns, table)
                        _:
                            pass

        def check_region_escape_walk(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            empty_stack: darray[sview] = []
                            ref_params: mutable darray[sview] = []
                            collect_forwardable_ref_params(parameters, ref_params)
                            empty_outer_locals: darray[sview] = []
                            table <- region_escape_walk(body, empty_stack, annotations, mutable_globals, ref_params, empty_outer_locals, view_fns, container_fns, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_region_escape_walk(module_body, annotations, mutable_globals, view_fns, container_fns, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_region_escape_walk(scoped_body, annotations, mutable_globals, view_fns, container_fns, table)
                        _:
                            pass

        def check_region_escape(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                mutable_globals: mutable darray[sview] = []
                collect_mutable_globals(file.top_decls, mutable_globals)
                view_fns: mutable darray[sview] = []
                collect_view_returning_fns(file.top_decls, view_fns)
                container_structs: mutable darray[sview] = []
                collect_container_structs(file.top_decls, container_structs)
                container_fns: mutable darray[sview] = []
                region_escape_collect_container_fns(file.top_decls, container_structs, container_fns)
                table <- check_region_escape_walk(file.top_decls, file.local_region_annotations, mutable_globals, view_fns, container_fns, table)
