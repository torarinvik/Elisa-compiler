# Nested-region store-escape (sound subset of stage0's region_containers escape check).
#
# Storing a value that lives in an INNER `region NAME:` scope into a container that lives
# in an OUTER (longer-lived) region leaves a dangling reference once the inner region is
# freed: `region outer: big @outer …; region inner: small @inner …; big.push(small)`.
#
# Stage0's full check uses region-stamped types + an outlives lattice + adoption/region-
# polymorphic exceptions. This sound subset relies ONLY on the lexical region-block nesting
# and explicit `@region` local annotations: a store `container.push(value)` where BOTH the
# container's and the value's regions are function-local `region` blocks on the current
# nesting nesting, and the container's region strictly ENCLOSES the value's, is an
# unconditional escape (the exception cases — region-polymorphic params, adopted arenas —
# use param regions that are NOT on the local block nesting, so they never match here).

extend Semantic:
    private:
        # Whether a region-return diagnostic that OUTRANKS the spanless escape row already
        # sits on `line`. Four kinds qualify: the spanned twin of the very same sentence,
        # and the three more specific sentences stage0 prefers when it has one.
        def rre_line_outranked(table: SymbolTable&, line: u32) -> bool:
            can Abort.Panic:
                for diagnostic in table.diagnostics:
                    continue if diagnostic.line != line
                    outranks: bool = match diagnostic.kind:
                        DiagnosticKind.RegionValueEscapesReturn:    true
                        DiagnosticKind.LocalArenaEscape:            true
                        DiagnosticKind.RegionReturnDependency:      true
                        DiagnosticKind.RegionAggregateReturnEscape: true
                        DiagnosticKind.ScopeOwnedRegionReturnEscape: true
                        # stage0 stops at the first defect: an unmatchable scrutinee poisons
                        # the arm values, so it never reaches the escape on that return.
                        DiagnosticKind.MatchScrutineeNotMatchable:  true
                        DiagnosticKind.VoidMatchScrutinee:          true
                        _:                                          false
                    return true if outranks
                return false

        # Peel `&v` to the borrowed base.
        def view_arg_base(argument: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Unary(operator, operand, line):
                        return view_arg_base(operand) if operator == TokenKind.Ampersand else argument
                    Expr.Paren(inner, paren_line):
                        return view_arg_base(inner)
                    _:
                        return argument




        # Free functions whose RETURN type aliases input-backed storage (`view[u8]`, `sview`, or
        # an opaque RegionPool/Pooled carrier) — consumers must inherit its region facts.
        def collect_view_returning_fns(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if return_type is declared_return:
                                out.push(name) if return_type_is_view(declared_return) or return_tuple_type_has_view(declared_return)
                        Decl.Module(module_name, module_body, module_line):
                            collect_view_returning_fns(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_view_returning_fns(scoped_body, out)
                        _:
                            pass




        # Whether a return type is a bare OWNED container (`darray[T]`/`dstr`/`set`/`dict`/array) —
        # a value the callee allocates in the AMBIENT region. A `@region`-qualified or ref/view
        # return is excluded (it aliases longer-lived storage, not the caller's region block).
        def return_type_is_owned_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        return name == "dstr"
                    Expr.Index(object, element, index_line):
                        head: sview = ident_name_of(object)
                        return when head:
                            "darray" | "set" | "dict" | "array" -> true
                            _ -> false
                    Expr.IndexN(object_n, arguments_n, index_n_line):
                        head_n: sview = ident_name_of(object_n)
                        return when head_n:
                            "darray" | "set" | "dict" | "array" -> true
                            _ -> false
                    _:
                        return false



        # An owned-container member type through a `mutable`/paren wrapper (`mutable darray[i64]`
        # -> darray). Such a member holds inferred-region heap storage.
        def member_type_is_owned_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return member_type_is_owned_container(operand) if operator == TokenKind.Mutable
                        return return_type_is_owned_container(type_expression)
                    Expr.Paren(inner, paren_line):
                        return member_type_is_owned_container(inner)
                    _:
                        return return_type_is_owned_container(type_expression)


        def region_escape_is_fresh_container_value(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Array(_, _): true
                    Expr.Comprehension(_, _, _, _, _, _): true
                    # `d: dstr = "A"` copies the literal into the enclosing region's arena
                    # (only reached when the declared type is an owned container, i.e. dstr).
                    Expr.StringLit(_, _): true
                    _: false


        # A struct literal with a field initialised by a fresh container literal
        # (`HU{bytes: [65.u8()]}`): that field's buffer is allocated in the current region.
        def region_escape_construct_has_fresh_container(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Construct(_, fields, _):
                        # A string literal field may be a static `sview`, so only array and
                        # comprehension literals count.
                        return any field in fields where field.value is Expr.Array(_, _) or field.value is Expr.Comprehension(_, _, _, _, _, _) or region_escape_construct_has_fresh_container(field.value)
                    Expr.Paren(inner, _):
                        return region_escape_construct_has_fresh_container(inner)
                    _:
                        return false



        # A construction (possibly nested) with a field initialised from a non-empty fresh
        # container literal. String literals do not count here: an `sview` field holds static data.
        def region_escape_construct_holds_fresh_container(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return region_escape_construct_holds_fresh_container(inner)
                    Expr.Construct(_, fields, _):
                        for field in fields:
                            match field.value:
                                # An EMPTY literal allocates nothing, so the struct holds no
                                # block storage yet (stage0 accepts returning it).
                                Expr.Array(field_elements, _):
                                    return true if field_elements.count > 0
                                Expr.Comprehension(_, _, _, _, _, _):
                                    return true
                                _:
                                    return true if region_escape_construct_holds_fresh_container(field.value)
                        return false
                    _:
                        return false



        # Struct names that OWN inferred-region heap storage — a member is an owned container.
        # A function returning such a struct (built from container literals, no region param)
        # yields an inferred-region value, exactly like a bare-container return.
        def collect_container_structs(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            has_container: bool = any member in members where member_type_is_owned_container(member.type_expression)
                            out.push(struct_name) if has_container
                        Decl.Module(module_name, module_body, module_line):
                            collect_container_structs(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_container_structs(scoped_body, out)
                        _:
                            pass



        # Free functions that allocate an owned container in the AMBIENT region and return it — a
        # bare-owned-container return type OR a container-owning struct, AND no region parameters (a
        # region-poly function allocates in its region param, not the caller's block). A call to one
        # inside a region block yields a value living in that block's region.
        def region_escape_collect_container_fns(declarations: darray[Ast::Decl], container_structs: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if return_type is declared_return:
                                returns_container_struct: bool = any container_struct in container_structs where container_struct == ident_name_of(declared_return)
                                out.push(name) if (return_type_is_owned_container(declared_return) or returns_container_struct) and not func_has_region_param(parameters)
                        Decl.Module(module_name, module_body, module_line):
                            region_escape_collect_container_fns(module_body, container_structs, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            region_escape_collect_container_fns(scoped_body, container_structs, out)
                        _:
                            pass



        # Whether any parameter is an Arena/region handle — such a function may allocate its return
        # in that param region rather than the caller's ambient block, so it is not ambient-tainting.
        def region_escape_type_mentions_arena(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        return when name:
                            "Arena" | "Region" -> true
                            _ -> false
                    Expr.Unary(operator, operand, unary_line):
                        return region_escape_type_mentions_arena(operand)
                    Expr.Paren(inner, paren_line):
                        return region_escape_type_mentions_arena(inner)
                    Expr.Index(object, element, index_line):
                        return region_escape_type_mentions_arena(object)
                    _:
                        return false



        def func_has_region_param(parameters: darray[Ast::ParamDecl]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any parameter in parameters where region_escape_type_mentions_arena(parameter.type_expression)



        # A tuple return type with a view element (`-> (known: bool, v: view[T])`) aliases
        # input-backed storage through that element just as a bare view return does.
        def return_tuple_type_has_view(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Tuple(elements, tuple_line):
                        return any element in elements where return_type_is_view(element) or return_tuple_type_has_view(element)
                    Expr.Paren(inner, paren_line):
                        return return_tuple_type_has_view(inner)
                    _:
                        return false



        def return_type_is_view(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return name == "sview"
                    Expr.Index(object, element, index_line):
                        index_object_name: sview = ident_name_of(object)
                        return when index_object_name:
                            "view" | "RegionPool" | "Pooled" -> true
                            _ -> false
                    Expr.IndexN(object, arguments, indexn_line):
                        indexn_object_name: sview = ident_name_of(object)
                        return when indexn_object_name:
                            "view" | "RegionPool" | "Pooled" -> true
                            _ -> false
                    Expr.Unary(operator, operand, unary_line):
                        return return_type_is_view(operand)
                    Expr.Paren(inner, paren_line):
                        return return_type_is_view(inner)
                    _:
                        return false



        # Report a whole-value assignment `target <- value` where target's region strictly
        # encloses (outlives) the value's region — `outer_list <- [v]` with v in an inner
        # region. Only plain-ident targets with an explicit region participate.
        # A parameter whose type is a plain (non-static, non-heap) reference: its pointee lives
        # in the caller's frame and may not outlive this function, so forwarding it into a global
        # is a stale-reference escape. `static`/`heap` refs target longer-lived storage and are
        # exempt (stage0 tells you to annotate them exactly so).
        def collect_forwardable_ref_params(parameters: darray[Ast::ParamDecl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |out|:
                    is_forwardable: bool = type_contains_operator(parameter.type_expression, TokenKind.Ampersand) and not type_contains_operator(parameter.type_expression, TokenKind.Static) and not type_contains_heap(parameter.type_expression)
                    out.push(parameter.name) if is_forwardable



        # Direct-level local names (VarDecls at this statement list's own level, no recursion).
        # Ordering is not tracked: a later-declared local can never be an assign target inside an
        # earlier region block (it is not yet in scope there), so the full set is a safe superset.
        def collect_level_local_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name)
                        _:
                            pass



        # Whether a returned local was DECLARED with a struct type that holds containers --
        # the shape stage0's typeCarriesRegionStorage gates its aggregate-escape wording on.
        # Uses the walk's own declared-type ledger; `mutable`/`lmut` wrappers are transparent.
        def region_escape_returned_is_aggregate(returned: Ast::Expr, local_type_names: darray[sview]&, local_type_exprs: darray[Ast::Expr]&, container_structs: darray[sview]&) -> bool:
            can Abort.Panic:
                returned_name: sview = ident_name_of(returned)
                return false if returned_name == ""
                declared: mutable Ast::Expr = Ast::Expr.Absent
                for index in 0..<local_type_names.count |declared, local_type_names, local_type_exprs, returned_name|:
                    declared <- local_type_exprs[index] if local_type_names[index] == returned_name
                return region_escape_type_is_container_struct(declared, container_structs)

        def region_escape_type_is_container_struct(type_expression: Ast::Expr, container_structs: darray[sview]&) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        return region_escape_type_is_container_struct(operand, container_structs)
                    Expr.Paren(inner, paren_pos):
                        return region_escape_type_is_container_struct(inner, container_structs)
                    Expr.Ident(type_name, ident_pos):
                        return any container_struct in container_structs where container_struct == type_name
                    _:
                        return false

        def region_escape_walk(statements: darray[Ast::Stmt], function_line: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, ref_params: darray[sview]&, outer_locals: darray[sview]&, param_names: darray[sview]&, region_locals: mutable darray[sview]&, region_local_regions: mutable darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, local_type_names: mutable darray[sview]&, local_type_exprs: mutable darray[Ast::Expr]&, container_structs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                local_type_mark: usize = local_type_names.count
                region_local_mark: usize = region_locals.count
                region_owner_mark: usize = region_local_regions.count
                taint_mark: usize = taint_names.count
                # A child scope may update an enclosing binding even though declarations
                # made in that scope must not leak out. Keep those two kinds of facts apart
                # when restoring the taint environment below.
                scope_declared_names: mutable darray[sview] = []
                collect_level_local_names(statements, scope_declared_names)
                entry_local_names: mutable darray[sview] = []
                for entry_name in local_type_names |entry_local_names|:
                    entry_local_names.push(entry_name)
                # Locals visible from a child scope = the enclosing set plus every local declared
                # directly at this level. Passed as the `outer_locals` of child region/control blocks
                # so the outlives check can tell a region-enclosed value stored into an enclosing
                # local (escape) from one stored into a region-body local (fine).
                child_outer_locals: mutable darray[sview] = [name for name in outer_locals]
                collect_level_local_names(statements, child_outer_locals)
                for statement in statements |table, taint_names, taint_regions, local_type_names, local_type_exprs, region_locals, region_local_regions| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            # A `region name:` block selects a concrete region.  The special
                            # `in region_param:` form does too, but `in owner:` is also used for
                            # an Arena& scratch allocator and is handled by check_arena_grow_escape
                            # instead.  Only parser-recorded region parameters are safe to add to
                            # this lexical region stack; treating every `in` name as a region
                            # caused false RegionNestedGrowthEscape diagnostics throughout the
                            # compiler's Arena-based runtime.
                            in_region_param: bool = kind == "in" and clause.count > 0 and clause[0] != "auto" and (any annotation in annotations where annotation.name == "__region_param" and annotation.region == clause[0] and annotation.line == function_line)
                            # A user `in auto:` block frees its arena at block exit (stage0
                            # RegionStmt{UserAuto}); a view stored out of it dangles, so it is a
                            # storage block like `region r:` (stage0 checkRegionlessTargetStoreEscape).
                            in_user_auto: bool = kind == "in" and clause.count > 0 and clause[0] == "auto"
                            is_storage_block: bool = (kind == "region" and clause.count > 0) or in_region_param or in_user_auto
                            region_label: sview = clause[0] if clause.count > 0 else sview("", 0, 0)
                            # A `can/trusted Unsafe.StaleRef:` grant discharges the
                            # forwarded-ref-into-global escape inside its body.
                            grants_stale: bool = (kind == "can" or kind == "trusted") and (any grant in clause where grant == "Unsafe.StaleRef" or grant == "StaleRef")
                            # Both child lists used to be built for EVERY block, and for a block
                            # that neither opens a region nor grants StaleRef both are identity
                            # copies — `child_stack` equals `nesting` and `granted_ref_params`
                            # equals `ref_params` by construction. Blocks are everywhere in this
                            # compiler (every `can …:` is one), and each copy allocates into the
                            # walker's auto-region, so the pair cost an mmap and an munmap per
                            # block. Pass the originals when nothing changes.
                            block_type_mark: usize = local_type_names.count
                            if binding != "":
                                local_type_names.push(binding)
                                local_type_exprs.push(Ast::Expr.Absent)
                            # Regions are keyed by NAME here and in every region side table, so a
                            # region reopening the name of one still open around it would be
                            # indistinguishable from it (stage0 analyzeRegionDecl).
                            shadows_open_region: bool = kind == "region" and region_label != "" and (any open_region in nesting where open_region == region_label)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionShadowsEnclosing, name: region_label, pos: line, line: line.line, expected: "", actual: ""}) if shadows_open_region
                            if is_storage_block or grants_stale:
                                child_stack: mutable darray[sview @source] = [entry for entry in nesting]
                                child_stack.push(region_label) if is_storage_block
                                child_region_locals: mutable darray[sview] = [name for name in region_locals]
                                child_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                                granted_ref_params: darray[sview] = [] if grants_stale else [ref_name for ref_name in ref_params]
                                table <- region_escape_walk(body, function_line, child_stack, annotations, mutable_globals, granted_ref_params, child_outer_locals, param_names, child_region_locals, child_region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            else:
                                child_region_locals: mutable darray[sview] = [name for name in region_locals]
                                child_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                                table <- region_escape_walk(body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, child_region_locals, child_region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            local_type_names <- local_type_names.truncate(block_type_mark) if local_type_names.count > block_type_mark
                            local_type_exprs <- local_type_exprs.truncate(block_type_mark) if local_type_exprs.count > block_type_mark
                        Stmt.Expr(expression, line):
                            table <- region_escape_check_store(expression, line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs, table)
                            # A captured loop WITH a yield (`for … |t| -> t:`) stays an
                            # Expr.Block in the loop view, so its body was never walked: a
                            # growth inside it escaped every rule here (fuzz F14). Walk its
                            # statements as a plain nested scope.
                            match expression:
                                Expr.Block(captured_statements, captured_value, captured_names, captured_pos):
                                    captured_region_locals: mutable darray[sview] = [name for name in region_locals]
                                    captured_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                                    captured_scope: mutable darray[Ast::Stmt] @source = [captured_statement for captured_statement in captured_statements]
                                    if not (captured_value is Ast::Expr.Invalid) and not (captured_value is Ast::Expr.Absent):
                                        captured_scope.push(Ast::Stmt.Expr(captured_value, Ast::expr_pos(captured_value)))
                                    table <- region_escape_walk(captured_scope, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, captured_region_locals, captured_region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                                _:
                                    table <- region_escape_walk_get_else_recovery(expression, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- region_escape_check_store(value, line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs, table)
                            table <- region_escape_walk_get_else_recovery(value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            declared_type: mutable Ast::Expr = type_expression
                            if declared_type is Ast::Expr.Absent:
                                match value:
                                    Expr.Construct(inferred_construct_type, _, _):
                                        declared_type <- inferred_construct_type
                                    _:
                                        pass
                            local_type_names.push(name)
                            local_type_exprs.push(declared_type)
                            declared_region: mutable sview = local_region_name(annotations, name, line.line)
                            declared_region <- nesting[nesting.count - 1] if declared_region == "" and nesting.count > 0
                            if declared_region != "":
                                region_locals.push(name)
                                region_local_regions.push(declared_region)
                            # A local copied/derived from a region value carries that region's taint.
                            var_region: mutable sview = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line.line)
                            # A fresh local container created lexically inside a region block owns
                            # storage from that block even when its empty literal has no borrowed
                            # input from which provenance can be inferred.
                            if var_region == "" and nesting.count > 0 and member_type_is_owned_container(type_expression) and region_escape_is_fresh_container_value(value):
                                var_region <- nesting[nesting.count - 1]
                            # Likewise a struct BUILT inside the block around a fresh container
                            # literal (`h = HU{bytes: [..]}`): its field's buffer comes from the
                            # block's arena, so a view of `h.bytes` stored outside dangles once
                            # the block frees it (fuzz F4; stage0 tracks this).
                            if var_region == "" and nesting.count > 0 and region_escape_construct_holds_fresh_container(value):
                                var_region <- nesting[nesting.count - 1]
                            # An empty marker is significant: a shadowing declaration with
                            # no region taint must hide an enclosing binding's older taint.
                            taint_names.push(name)
                            taint_regions.push(var_region)
                        Stmt.Assign(target, operator, value, line):
                            if operator == TokenKind.PlusEq:
                                table <- region_escape_check_store(collection_append_call(target, value, line), line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs, table)
                            table <- region_escape_check_store(value, line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs, table)
                            table <- region_escape_walk_get_else_recovery(target, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            table <- region_escape_walk_get_else_recovery(value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            table <- region_escape_check_assign(target, value, line.line, nesting, annotations, mutable_globals, ref_params, outer_locals, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, table)
                            # Storing a region value into a field of an aggregate taints the aggregate
                            # (`inner.xs <- v` taints `inner`); a whole-value store taints the target.
                            assign_region: sview = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line.line)
                            assign_root: sview = region_escape_assign_target_root(target)
                            if assign_region != "" and assign_root != "":
                                taint_names.push(assign_root)
                                taint_regions.push(assign_region)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- region_escape_walk_get_else_recovery(returned, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                                returned_region: sview = region_escape_stored_or_call_region(returned, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line.line)
                                returned_position: (found: bool, position: usize) = region_stack_position(nesting, returned_region)
                                carries_region_handle: bool = region_escape_value_carries_handles(returned, annotations, line.line, local_type_names, local_type_exprs, table)
                                # stage0 words an escaping AGGREGATE (a struct carrying containers) as
                                # "value backed by scope-owned region …" (checkRegionAggregateReturnEscape,
                                # gated on typeCarriesRegionStorage) and a bare container as "value
                                # allocated in region …". Same detection here, different family. The
                                # returned local's DECLARED type decides, looked up against the structs
                                # that actually hold containers -- a plain named type that is not one
                                # of those keeps the container wording rather than guessing.
                                returned_is_aggregate: bool = region_escape_returned_is_aggregate(returned, local_type_names, local_type_exprs, container_structs)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAggregateReturnEscape, name: returned_region, line: line.line, expected: "", actual: returned_region}) if returned_region != "" and returned_position.found and carries_region_handle and returned_is_aggregate
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionReturnEscape, name: "", line: line.line, expected: "", actual: returned_region}) if returned_region != "" and returned_position.found and carries_region_handle and not returned_is_aggregate
                        Stmt.If(condition, then_body, else_body, line):
                            table <- region_escape_walk_get_else_recovery(condition, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            then_region_locals: mutable darray[sview] = [name for name in region_locals]
                            then_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                            else_region_locals: mutable darray[sview] = [name for name in region_locals]
                            else_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                            table <- region_escape_walk(then_body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, then_region_locals, then_region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            table <- region_escape_walk(else_body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, else_region_locals, else_region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.While(condition, while_body, line):
                            table <- region_escape_walk_get_else_recovery(condition, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            while_region_locals: mutable darray[sview] = [name for name in region_locals]
                            while_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                            table <- region_escape_walk(while_body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, while_region_locals, while_region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- region_escape_walk_get_else_recovery(iterable, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            loop_type_names: mutable darray[sview] = []
                            loop_type_exprs: mutable darray[Ast::Expr] @source = []
                            loop_region_locals: mutable darray[sview] = [name for name in region_locals]
                            loop_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                            table <- region_escape_walk(for_body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, loop_region_locals, loop_region_local_regions, view_fns, container_fns, taint_names, taint_regions, loop_type_names, loop_type_exprs, container_structs, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- region_escape_walk_get_else_recovery(scrutinee, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            for arm in arms |table| -> table:
                                arm_type_names: mutable darray[sview] = []
                                arm_type_exprs: mutable darray[Ast::Expr] @source = []
                                arm_region_locals: mutable darray[sview] = [name for name in region_locals]
                                arm_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                                table <- region_escape_walk_get_else_recovery(arm.guard, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, arm_region_locals, arm_region_local_regions, view_fns, container_fns, taint_names, taint_regions, arm_type_names, arm_type_exprs, container_structs, table)
                                table <- region_escape_walk(arm.body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, arm_region_locals, arm_region_local_regions, view_fns, container_fns, taint_names, taint_regions, arm_type_names, arm_type_exprs, container_structs, table)
                        Stmt.Contract(kind, expression, line):
                            table <- region_escape_walk_get_else_recovery(expression, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        _:
                            pass
                local_type_names <- local_type_names.truncate(local_type_mark) if local_type_names.count > local_type_mark
                local_type_exprs <- local_type_exprs.truncate(local_type_mark) if local_type_exprs.count > local_type_mark
                region_locals <- region_locals.truncate(region_local_mark) if region_locals.count > region_local_mark
                region_local_regions <- region_local_regions.truncate(region_owner_mark) if region_local_regions.count > region_owner_mark
                exported_names: mutable darray[sview] = []
                exported_regions: mutable darray[sview] = []
                for index in taint_mark..<taint_names.count:
                    name: sview = taint_names[index]
                    belongs_to_entry: bool = any entry_name in entry_local_names where entry_name == name
                    shadowed_here: bool = any declared_name in scope_declared_names where declared_name == name
                    if belongs_to_entry and not shadowed_here:
                        exported_names.push(name)
                        exported_regions.push(taint_regions[index]) if index < taint_regions.count
                        exported_regions.push("") if index >= taint_regions.count
                taint_names <- taint_names.truncate(taint_mark) if taint_names.count > taint_mark
                taint_regions <- taint_regions.truncate(taint_mark) if taint_regions.count > taint_mark
                for index in 0..<exported_names.count |taint_names, taint_regions, exported_names, exported_regions|:
                    taint_names.push(exported_names[index])
                    taint_regions.push(exported_regions[index])


        # A GetElse recovery is a separate control-flow path. Walk it with a snapshot of
        # the enclosing facts so its locals and assignments do not leak into the success
        # path, while still reporting stores performed before the recovery exits.
        # Expression-form match/catch/lambda bodies contain statements rather than child
        # expressions, so inspect those statements for nested GetElse nodes as well.
        def region_escape_walk_get_else_recovery_statements(statements: darray[Ast::Stmt], function_line: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, ref_params: darray[sview]&, outer_locals: darray[sview]&, param_names: darray[sview]&, region_locals: mutable darray[sview]&, region_local_regions: mutable darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, local_type_names: mutable darray[sview]&, local_type_exprs: mutable darray[Ast::Expr]&, container_structs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                    match statement:
                        Stmt.Expr(value, _) | Stmt.Contract(_, value, _):
                            table <- region_escape_walk_get_else_recovery(value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.VarDecl(_, type_expression, value, _):
                            table <- region_escape_walk_get_else_recovery(type_expression, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            table <- region_escape_walk_get_else_recovery(value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.Assign(target, _, value, _):
                            table <- region_escape_walk_get_else_recovery(target, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            table <- region_escape_walk_get_else_recovery(value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- region_escape_walk_get_else_recovery(condition, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                            branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                            table <- region_escape_walk_get_else_recovery_branch(Ast::Expr.Absent, then_body, branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            table <- region_escape_walk_get_else_recovery_branch(Ast::Expr.Absent, else_body, branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.While(condition, body, _):
                            table <- region_escape_walk_get_else_recovery(condition, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                            branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                            table <- region_escape_walk_get_else_recovery_branch(Ast::Expr.Absent, body, branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.For(_, variables, iterable, body, _):
                            table <- region_escape_walk_get_else_recovery(iterable, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            loop_outer_locals: mutable darray[sview] = [name for name in outer_locals]
                            loop_type_names: mutable darray[sview] = [name for name in local_type_names]
                            loop_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                            for variable in variables |loop_outer_locals, loop_type_names, loop_type_exprs|:
                                loop_outer_locals.push(variable)
                                loop_type_names.push(variable)
                                loop_type_exprs.push(Ast::Expr.Absent)
                            branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                            branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                            table <- region_escape_walk_get_else_recovery_branch(Ast::Expr.Absent, body, branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, loop_outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, loop_type_names, loop_type_exprs, container_structs, table)
                        Stmt.Block(_, _, _, body, _):
                            branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                            branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                            table <- region_escape_walk_get_else_recovery_branch(Ast::Expr.Absent, body, branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.Return(value, _):
                            if value is returned:
                                table <- region_escape_walk_get_else_recovery(returned, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Stmt.Match(scrutinee, arms, _):
                            table <- region_escape_walk_get_else_recovery(scrutinee, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                            branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                            for arm in arms |table, region_locals, region_local_regions, taint_names, taint_regions| -> table:
                                arm_bound_names: mutable darray[sview] = []
                                collect_pattern_binding_names(arm.pattern, arm_bound_names)
                                arm_outer_locals: mutable darray[sview] = [name for name in outer_locals]
                                arm_type_names: mutable darray[sview] = [name for name in local_type_names]
                                arm_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                                for bound_name in arm_bound_names |arm_outer_locals, arm_type_names, arm_type_exprs|:
                                    arm_outer_locals.push(bound_name)
                                    arm_type_names.push(bound_name)
                                    arm_type_exprs.push(Ast::Expr.Absent)
                                table <- region_escape_walk_get_else_recovery_branch(arm.guard, arm.body, branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, arm_outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, arm_type_names, arm_type_exprs, container_structs, table)
                        _:
                            pass

        # Analyze a mutually exclusive arm with private facts, then conservatively join its
        # region taints back into the enclosing expression/statement flow.
        def region_escape_walk_get_else_recovery_branch(expression: Ast::Expr, statements: darray[Ast::Stmt], incoming_taint_names: darray[sview @source]&, incoming_taint_regions: darray[sview @source]&, function_line: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, ref_params: darray[sview]&, outer_locals: darray[sview]&, param_names: darray[sview]&, region_locals: mutable darray[sview]&, region_local_regions: mutable darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, local_type_names: mutable darray[sview]&, local_type_exprs: mutable darray[Ast::Expr]&, container_structs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                branch_nesting: mutable darray[sview @source] = [region for region in nesting]
                branch_region_locals: mutable darray[sview] = [name for name in region_locals]
                branch_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                branch_taint_names: mutable darray[sview @source] = [name for name in incoming_taint_names]
                branch_taint_regions: mutable darray[sview @source] = [region for region in incoming_taint_regions]
                branch_type_names: mutable darray[sview] = [name for name in local_type_names]
                branch_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                if not (expression is Ast::Expr.Absent) and not (expression is Ast::Expr.Invalid):
                    table <- region_escape_walk_get_else_recovery(expression, function_line, branch_nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, branch_region_locals, branch_region_local_regions, view_fns, container_fns, branch_taint_names, branch_taint_regions, branch_type_names, branch_type_exprs, container_structs, table)
                table <- region_escape_walk_get_else_recovery_statements(statements, function_line, branch_nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, branch_region_locals, branch_region_local_regions, view_fns, container_fns, branch_taint_names, branch_taint_regions, branch_type_names, branch_type_exprs, container_structs, table)
                region_escape_merge_recovery_taints(taint_names, taint_regions, incoming_taint_names, incoming_taint_regions, branch_taint_names, branch_taint_regions, nesting)

        def region_escape_walk_get_else_recovery(expression: Ast::Expr, function_line: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, ref_params: darray[sview]&, outer_locals: darray[sview]&, param_names: darray[sview]&, region_locals: mutable darray[sview]&, region_local_regions: mutable darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, local_type_names: mutable darray[sview]&, local_type_exprs: mutable darray[Ast::Expr]&, container_structs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.GetElse(guarded, recovery, _):
                        table <- region_escape_walk_get_else_recovery(guarded, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        incoming_taint_names: darray[sview @source] = [name for name in taint_names]
                        incoming_taint_regions: darray[sview @source] = [region for region in taint_regions]
                        recovery_nesting: mutable darray[sview @source] = [region for region in nesting]
                        recovery_region_locals: mutable darray[sview] = [name for name in region_locals]
                        recovery_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                        recovery_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                        recovery_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                        recovery_type_names: mutable darray[sview] = [name for name in local_type_names]
                        recovery_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                        table <- region_escape_walk(recovery, function_line, recovery_nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, recovery_region_locals, recovery_region_local_regions, view_fns, container_fns, recovery_taint_names, recovery_taint_regions, recovery_type_names, recovery_type_exprs, container_structs, table)
                        # A returning recovery is dead after the GetElse. Otherwise its writes
                        # and the guarded success path can both reach the next statement, so
                        # retain the shorter-lived provenance from either path.
                        if not statements_terminate(recovery, table):
                            region_escape_merge_recovery_taints(taint_names, taint_regions, incoming_taint_names, incoming_taint_regions, recovery_taint_names, recovery_taint_regions, nesting)
                    Expr.Paren(inner, _):
                        table <- region_escape_walk_get_else_recovery(inner, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Block(statements, value, _, _):
                        block_region_locals: mutable darray[sview] = [name for name in region_locals]
                        block_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                        block_statements: mutable darray[Ast::Stmt] @source = [statement for statement in statements]
                        if not (value is Ast::Expr.Invalid) and not (value is Ast::Expr.Absent):
                            block_statements.push(Ast::Stmt.Expr(value, Ast::expr_pos(value)))
                        table <- region_escape_walk(block_statements, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, block_region_locals, block_region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Call(callee, arguments, _, _):
                        table <- region_escape_walk_get_else_recovery(callee, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        for argument in arguments |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(argument, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                        table <- region_escape_walk_get_else_recovery(effect_type, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        for candidate in candidates |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(candidate.effect_type, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            for capture in candidate.captures |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                                table <- region_escape_walk_get_else_recovery(capture, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        for argument in arguments |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(argument, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Binary(left, _, right, _) | Expr.Refinement(left, right, _):
                        table <- region_escape_walk_get_else_recovery(left, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        table <- region_escape_walk_get_else_recovery(right, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.If(condition, then_value, else_value, _):
                        table <- region_escape_walk_get_else_recovery(condition, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                        branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                        table <- region_escape_walk_get_else_recovery_branch(then_value, [], branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        table <- region_escape_walk_get_else_recovery_branch(else_value, [], branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _):
                        table <- region_escape_walk_get_else_recovery(object, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Index(object, index, _):
                        table <- region_escape_walk_get_else_recovery(object, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        table <- region_escape_walk_get_else_recovery(index, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Slice(object, low, high, _):
                        table <- region_escape_walk_get_else_recovery(object, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        table <- region_escape_walk_get_else_recovery(low, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        table <- region_escape_walk_get_else_recovery(high, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.IndexN(object, indices, _):
                        table <- region_escape_walk_get_else_recovery(object, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        for index in indices |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(index, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(element, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(entry.key, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            table <- region_escape_walk_get_else_recovery(entry.value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Construct(type_expression, fields, _):
                        table <- region_escape_walk_get_else_recovery(type_expression, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        for field in fields |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(field.value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.RecordUpdate(base, fields, _):
                        table <- region_escape_walk_get_else_recovery(base, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        for field in fields |table, region_locals, region_local_regions, taint_names, taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(field.value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- region_escape_walk_get_else_recovery(scrutinee, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                        branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                        for arm in arms |table, region_locals, region_local_regions, taint_names, taint_regions| -> table:
                            arm_bound_names: mutable darray[sview] = []
                            collect_pattern_binding_names(arm.pattern, arm_bound_names)
                            arm_outer_locals: mutable darray[sview] = [name for name in outer_locals]
                            arm_type_names: mutable darray[sview] = [name for name in local_type_names]
                            arm_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                            for bound_name in arm_bound_names |arm_outer_locals, arm_type_names, arm_type_exprs|:
                                arm_outer_locals.push(bound_name)
                                arm_type_names.push(bound_name)
                                arm_type_exprs.push(Ast::Expr.Absent)
                            table <- region_escape_walk_get_else_recovery_branch(arm.guard, arm.body, branch_incoming_names, branch_incoming_regions, function_line, nesting, annotations, mutable_globals, ref_params, arm_outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, arm_type_names, arm_type_exprs, container_structs, table)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        table <- region_escape_walk_get_else_recovery(iterable, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        incoming_taint_names: darray[sview @source] = [name for name in taint_names]
                        incoming_taint_regions: darray[sview @source] = [region for region in taint_regions]
                        comprehension_outer_locals: mutable darray[sview] = [name for name in outer_locals]
                        comprehension_outer_locals.push(variable)
                        comprehension_nesting: mutable darray[sview @source] = [region for region in nesting]
                        comprehension_region_locals: mutable darray[sview] = [name for name in region_locals]
                        comprehension_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                        comprehension_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                        comprehension_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                        comprehension_type_names: mutable darray[sview] = [name for name in local_type_names]
                        comprehension_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                        comprehension_type_names.push(variable)
                        comprehension_type_exprs.push(Ast::Expr.Absent)
                        table <- region_escape_walk_get_else_recovery(condition, function_line, comprehension_nesting, annotations, mutable_globals, ref_params, comprehension_outer_locals, param_names, comprehension_region_locals, comprehension_region_local_regions, view_fns, container_fns, comprehension_taint_names, comprehension_taint_regions, comprehension_type_names, comprehension_type_exprs, container_structs, table)
                        table <- region_escape_walk_get_else_recovery(body, function_line, comprehension_nesting, annotations, mutable_globals, ref_params, comprehension_outer_locals, param_names, comprehension_region_locals, comprehension_region_local_regions, view_fns, container_fns, comprehension_taint_names, comprehension_taint_regions, comprehension_type_names, comprehension_type_exprs, container_structs, table)
                        region_escape_merge_recovery_taints(taint_names, taint_regions, incoming_taint_names, incoming_taint_regions, comprehension_taint_names, comprehension_taint_regions, nesting)
                    Expr.Lambda(parameters, body, _):
                        lambda_outer_locals: mutable darray[sview] = [name for name in outer_locals]
                        lambda_type_names: mutable darray[sview] = [name for name in local_type_names]
                        lambda_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                        lambda_region_locals: mutable darray[sview] = [name for name in region_locals]
                        lambda_region_local_regions: mutable darray[sview] = [region for region in region_local_regions]
                        lambda_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                        lambda_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                        for parameter in parameters |lambda_outer_locals, lambda_type_names, lambda_type_exprs|:
                            lambda_outer_locals.push(parameter)
                            lambda_type_names.push(parameter)
                            lambda_type_exprs.push(Ast::Expr.Absent)
                        table <- region_escape_walk(body, function_line, nesting, annotations, mutable_globals, ref_params, lambda_outer_locals, param_names, lambda_region_locals, lambda_region_local_regions, view_fns, container_fns, lambda_taint_names, lambda_taint_regions, lambda_type_names, lambda_type_exprs, container_structs, table)
                    _:
                        pass


        def region_escape_merge_recovery_taints(taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, incoming_names: darray[sview @source]&, incoming_regions: darray[sview @source]&, recovery_names: darray[sview @source]&, recovery_regions: darray[sview @source]&, nesting: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                visited_names: mutable darray[sview] = []
                for name in recovery_names |taint_names, taint_regions, incoming_names, incoming_regions, recovery_names, recovery_regions, nesting, visited_names|:
                    continue if any visited in visited_names where visited == name
                    visited_names.push(name)
                    incoming_region: sview = region_taint_lookup(incoming_names, incoming_regions, name)
                    recovery_region: sview = region_taint_lookup(recovery_names, recovery_regions, name)
                    joined_region: sview = region_escape_deeper_region(incoming_region, recovery_region, nesting)
                    if joined_region != incoming_region:
                        taint_names.push(name)
                        taint_regions.push(joined_region)



        def check_region_escape_walk(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, view_fns: darray[sview]&, container_fns: darray[sview]&, container_structs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            empty_stack: darray[sview @source] = []
                            ref_params: mutable darray[sview] = []
                            collect_forwardable_ref_params(parameters, ref_params)
                            empty_outer_locals: mutable darray[sview] = [parameter.name for parameter in parameters]
                            # The parameter names on their own. outer_locals is seeded WITH them
                            # (the store rules need that -- storing a region value into a param is
                            # an escape in both compilers), but the GROWTH rule must tell them
                            # apart: a param's container belongs to the caller.
                            param_names: darray[sview] = [parameter.name for parameter in parameters]
                            local_type_names: mutable darray[sview] = [parameter.name for parameter in parameters]
                            local_type_exprs: mutable darray[Ast::Expr] @source = [parameter.type_expression for parameter in parameters]
                            region_locals: mutable darray[sview] = []
                            region_local_regions: mutable darray[sview] = []
                            taint_names: mutable darray[sview @source] = []
                            taint_regions: mutable darray[sview @source] = []
                            table <- region_escape_walk(body, line.line, empty_stack, annotations, mutable_globals, ref_params, empty_outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Decl.Module(module_name, module_body, module_line):
                            previous_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- check_region_escape_walk(module_body, annotations, mutable_globals, view_fns, container_fns, container_structs, table)
                            table.current_module <- previous_module
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_region_escape_walk(scoped_body, annotations, mutable_globals, view_fns, container_fns, container_structs, table)
                        _:
                            pass



        def check_region_escape(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                mutable_globals: mutable darray[sview @source] = []
                collect_mutable_globals(file.top_decls, mutable_globals)
                view_fns: mutable darray[sview] = []
                collect_view_returning_fns(file.top_decls, view_fns)
                container_structs: mutable darray[sview] = []
                collect_container_structs(file.top_decls, container_structs)
                container_fns: mutable darray[sview] = []
                region_escape_collect_container_fns(file.top_decls, container_structs, container_fns)
                table <- check_region_escape_walk(file.top_decls, file.local_region_annotations, mutable_globals, view_fns, container_fns, container_structs, table)

include "./region_escape_provenance.elisa"
include "./region_escape_stores.elisa"
include "./region_escape_assignments.elisa"
