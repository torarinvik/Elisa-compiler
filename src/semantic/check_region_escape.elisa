        def region_escape_merge_recovery_taints(taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, recovery_names: darray[sview @source]&, recovery_regions: darray[sview @source]&, nesting: darray[sview @source]&, excluded_name: sview, excluded_names: darray[sview @source], replace_existing: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                visited_names: mutable darray[sview @source] = []
                for name in recovery_names |taint_names, taint_regions, recovery_names, recovery_regions, nesting, visited_names|:
                    continue if name == excluded_name or any excluded in excluded_names where excluded == name
                    continue if any visited in visited_names where visited == name
                    visited_names.push(name)
                    current_region: sview @source = region_taint_lookup(taint_names, taint_regions, name)
                    recovery_region: sview @source = region_taint_lookup(recovery_names, recovery_regions, name)
                    joined_region: sview @source = recovery_region if replace_existing else region_escape_deeper_region(current_region, recovery_region, nesting)
                    if joined_region != current_region or replace_existing:
                        taint_names.push(name)
                        taint_regions.push(joined_region)


        # An indexed read carries the selected element's provenance in addition to the
        # collection's own storage lifetime.
        def region_escape_stored_or_call_region_with_elements(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32] = []) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return region_escape_stored_or_call_region_with_elements(inner, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        return region_escape_stored_or_call_region_with_elements(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.Ident(name, _):
                        owner_region: sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, [catch_line for catch_line in catch_match_lines])
                        element_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name)
                        return nesting[nesting.count - 1] if element_region == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION and nesting.count > 0
                        return owner_region if element_region == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION
                        return region_escape_deeper_region(owner_region, element_region, nesting)
                    Expr.If(condition, then_value, else_value, _):
                        literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(condition)
                        if literal.known:
                            return region_escape_stored_or_call_region_with_elements(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines) if literal.value
                            return region_escape_stored_or_call_region_with_elements(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        then_region: sview @source = region_escape_stored_or_call_region_with_elements(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        else_region: sview @source = region_escape_stored_or_call_region_with_elements(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        return region_escape_deeper_region(then_region, else_region, nesting)
                    Expr.Block(statements, tail_value, _, _):
                        result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(statements, tail_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        return nesting[result.position] if result.found
                        return ""
                    Expr.Match(scrutinee, arms, _):
                        return region_escape_value_arms_region_with_elements(false, scrutinee, arms, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.Catch(guarded, arms, _):
                        return region_escape_value_arms_region_with_elements(true, guarded, arms, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Field(receiver, method, _) if method == "get" or method == "get_or_insert":
                                collection_name: sview @source = region_escape_assign_target_root(receiver)
                                owner_region: sview @source = region_escape_stored_or_call_region(receiver, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, [catch_line for catch_line in catch_match_lines])
                                element_region: mutable sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, collection_name)
                                if element_region == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION:
                                    element_region <- nesting[nesting.count - 1] if nesting.count > 0
                                elif element_region == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION:
                                    owner_position: (found: bool, position: usize) = region_stack_position(nesting, owner_region)
                                    element_region <- nesting[nesting.count - 1] if owner_position.found and nesting.count > 0
                                result_region: mutable sview @source = region_escape_deeper_region(owner_region, element_region, nesting)
                                if method == "get_or_insert" and arguments.count > 0:
                                    inserted_region: sview @source = region_escape_stored_or_call_region_with_elements(arguments[arguments.count - 1], annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                                    result_region <- region_escape_deeper_region(result_region, inserted_region, nesting)
                                return result_region
                            _:
                                pass
                        return region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, [catch_line for catch_line in catch_match_lines])
                    Expr.Index(object, _, _) | Expr.IndexN(object, _, _):
                        base_region: sview @source = region_escape_stored_or_call_region(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, [catch_line for catch_line in catch_match_lines])
                        collection_name: sview @source = region_escape_assign_target_root(object)
                        element_region: mutable sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, collection_name)
                        element_region <- nesting[nesting.count - 1] if element_region == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION and nesting.count > 0
                        if element_region == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION:
                            base_position: (found: bool, position: usize) = region_stack_position(nesting, base_region)
                            element_region <- nesting[nesting.count - 1] if base_position.found and nesting.count > 0
                        return region_escape_deeper_region(base_region, element_region, nesting)
                    _:
                        return region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, [catch_line for catch_line in catch_match_lines])



        # A comprehension binder gets value provenance from a literal iterable's elements.
        # The region owning a named collection is not the region of each element, so do not
        # copy that owner region onto every binder value.
        def region_escape_element_taint_lookup(element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                while probe > 0 |probe: usize = element_taint_names.count|:
                    probe <- probe - 1
                    return element_taint_regions[probe] if probe < element_taint_regions.count and element_taint_names[probe] == name
                return REGION_ESCAPE_UNKNOWN_ELEMENT_REGION



        def region_escape_element_region_join(left: sview, right: sview, nesting: darray[sview @source]&) -> sview:
            can Abort.Panic:
                if left == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION or right == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION:
                    return REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                left_unknown: bool = left == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION
                right_unknown: bool = right == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION
                if left_unknown or right_unknown:
                    known_candidate: sview = right if left_unknown else left
                    known_position: (found: bool, position: usize) = region_stack_position(nesting, known_candidate)
                    return REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION if known_position.found
                    return REGION_ESCAPE_UNKNOWN_ELEMENT_REGION
                left_position: (found: bool, position: usize) = region_stack_position(nesting, left)
                right_position: (found: bool, position: usize) = region_stack_position(nesting, right)
                return nesting[right_position.position] if right_position.found and (not left_position.found or right_position.position > left_position.position)
                return nesting[left_position.position] if left_position.found
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION if left == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION or right == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
                return right if left == ""
                return left if right == "" or left == right
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION


        # Branch replay copies element summaries into a caller-owned environment. Rebase
        # regions from its private arrays onto the active nesting stack (or stable sentinels)
        # before storing them so no view can retain the private branch buffer.
        def region_escape_element_region_stabilize(region: sview @source, nesting: darray[sview @source]&) -> sview @source:
            can Abort.Panic:
                return region if region == "" or region == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION or region == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION or region == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
                position: (found: bool, position: usize) = region_stack_position(nesting, region)
                return nesting[position.position] if position.found
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION


        def region_escape_element_taint_replace(element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, name: sview, region: sview @source, nesting: darray[sview @source]&) -> void:
            can Abort.Panic:
                while probe > 0 |probe: usize = element_taint_names.count, element_taint_names, element_taint_regions, name, region, nesting|:
                    probe <- probe - 1
                    if probe < element_taint_regions.count and element_taint_names[probe] == name:
                        element_taint_regions[probe] <- region_escape_element_region_stabilize(region, nesting)
                        return


        def region_escape_region_stabilize(region: sview @source, nesting: darray[sview @source]&) -> sview @source:
            can Abort.Panic:
                return region if region == "" or region == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
                position: (found: bool, position: usize) = region_stack_position(nesting, region)
                return nesting[position.position] if position.found
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION


        def region_escape_taint_replace(taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, name: sview, region: sview @source, nesting: darray[sview @source]&) -> void:
            can Abort.Panic:
                while probe > 0 |probe: usize = taint_names.count, taint_names, taint_regions, name, region, nesting|:
                    probe <- probe - 1
                    if probe < taint_regions.count and taint_names[probe] == name:
                        taint_regions[probe] <- region_escape_region_stabilize(region, nesting)
                        return



        def region_escape_element_taint_set(element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, name: sview @source, region: sview @source) -> void:
            element_taint_names.push(name)
            element_taint_regions.push(region)



        # Keep a named collection's element provenance when it is grown after its
        # declaration. The collection's storage region is separate from the region
        # carried by each appended element.
        def region_escape_record_collection_element_mutation(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, line: u32, catch_match_lines: darray[u32] = []) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Field(receiver, method, _):
                                collection_name: sview @source = region_escape_assign_target_root(receiver)
                                if collection_name != "":
                                    appended_region: mutable sview @source = ""
                                    clears_collection: bool = method == "clear" and arguments.count == 0 and receiver is Expr.Ident(_, _)
                                    read_only_query: bool = method == "contains" or method == "count" or method == "is_empty" or method == "len" or method == "get" or method == "keys" or method == "values" or method == "items"
                                    if not read_only_query and not clears_collection and (method == "push" or method == "append" or method == "add") and arguments.count == 1:
                                        appended_region <- region_escape_stored_or_call_region_with_elements(arguments[0], annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                                    elif not read_only_query and not clears_collection and (method == "extend" or method == "append_many") and arguments.count == 1:
                                        appended_region <- region_escape_comprehension_element_region(arguments[0], annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                                    elif not read_only_query and not clears_collection and (method == "insert" or method == "put") and arguments.count == 2:
                                        appended_region <- region_escape_stored_or_call_region_with_elements(arguments[1], annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                                    elif not read_only_query and not clears_collection and method == "get_or_insert" and arguments.count == 1:
                                        appended_region <- region_escape_stored_or_call_region_with_elements(arguments[0], annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                                    elif not read_only_query and not clears_collection:
                                        for argument in arguments |appended_region|:
                                            candidate: sview @source = region_escape_stored_or_call_region_with_elements(argument, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                                            candidate_position: (found: bool, position: usize) = region_stack_position(nesting, candidate)
                                            if candidate_position.found:
                                                appended_region <- region_escape_element_region_join(appended_region, candidate, nesting)
                                    if clears_collection:
                                        region_escape_element_taint_set(element_taint_names, element_taint_regions, collection_name, "")
                                    elif not read_only_query:
                                        prior_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, collection_name)
                                        joined_region: sview @source = region_escape_element_region_join(prior_region, appended_region, nesting)
                                        region_escape_element_taint_set(element_taint_names, element_taint_regions, collection_name, joined_region)
                            _:
                                pass
                        region_escape_record_collection_element_mutation(callee, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        for argument in arguments |element_taint_names, element_taint_regions|:
                            region_escape_record_collection_element_mutation(argument, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.If(condition, then_value, else_value, _):
                        return if region_escape_provenance_expression_terminates(condition)
                        branch_names: darray[sview @source] = [name for name in element_taint_names]
                        branch_regions: darray[sview @source] = [region for region in element_taint_regions]
                        then_names: mutable darray[sview @source] = [name for name in branch_names]
                        then_regions: mutable darray[sview @source] = [region for region in branch_regions]
                        else_names: mutable darray[sview @source] = [name for name in branch_names]
                        else_regions: mutable darray[sview @source] = [region for region in branch_regions]
                        region_escape_record_collection_element_mutation(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, then_names, then_regions, line, catch_match_lines)
                        region_escape_record_collection_element_mutation(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, else_names, else_regions, line, catch_match_lines)
                        condition_literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(condition)
                        if condition_literal.known:
                            selected_names: darray[sview @source] = then_names if condition_literal.value else else_names
                            selected_regions: darray[sview @source] = then_regions if condition_literal.value else else_regions
                            region_escape_merge_element_taints(element_taint_names, element_taint_regions, selected_names, selected_regions, nesting, "", [], true)
                        else:
                            region_escape_merge_element_taints(element_taint_names, element_taint_regions, then_names, then_regions, nesting, "", [], true)
                            region_escape_merge_element_taints(element_taint_names, element_taint_regions, else_names, else_regions, nesting, "", [])
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        region_escape_record_collection_element_mutation(inner, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.Binary(left, _, right, _) | Expr.Refinement(left, right, _):
                        region_escape_record_collection_element_mutation(left, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        region_escape_record_collection_element_mutation(right, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Index(object, _, _) | Expr.IndexN(object, _, _) | Expr.Slice(object, _, _, _) | Expr.Unary(_, object, _) | Expr.RegionNew(object, _, _):
                        region_escape_record_collection_element_mutation(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    _:
                        pass



        def region_escape_merge_element_taints(element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, branch_names: darray[sview @source]&, branch_regions: darray[sview @source]&, nesting: darray[sview @source]&, excluded_name: sview, excluded_names: darray[sview @source], replace_existing: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                existing_names: darray[sview @source] = [name for name in element_taint_names]
                visited_names: mutable darray[sview @source] = []
                for name in branch_names |element_taint_names, element_taint_regions, branch_names, branch_regions, nesting, visited_names|:
                    continue if name == excluded_name or any excluded in excluded_names where excluded == name
                    continue if not any existing in existing_names where existing == name
                    continue if any visited in visited_names where visited == name
                    visited_names.push(name)
                    current_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name)
                    branch_region: sview @source = region_escape_element_taint_lookup(branch_names, branch_regions, name)
                    joined_region: sview @source = branch_region if replace_existing else region_escape_element_region_join(current_region, branch_region, nesting)
                    if joined_region != current_region or replace_existing:
                        region_escape_element_taint_set(element_taint_names, element_taint_regions, name, joined_region)



        def region_escape_comprehension_element_region(iterable: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32] = []) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return region_escape_comprehension_element_region(inner, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                    Expr.Ident(name, _):
                        element_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name)
                        return nesting[nesting.count - 1] if element_region == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION and nesting.count > 0
                        if element_region == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION:
                            owner_region: sview @source = region_escape_stored_or_call_region(iterable, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                            owner_position: (found: bool, position: usize) = region_stack_position(nesting, owner_region)
                            return nesting[nesting.count - 1] if owner_position.found and nesting.count > 0
                        return element_region
                    Expr.If(condition, then_iterable, else_iterable, _):
                        return "" if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(condition)
                        if literal.known:
                            return region_escape_comprehension_element_region(then_iterable, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines) if literal.value
                            return region_escape_comprehension_element_region(else_iterable, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        then_region: sview @source = region_escape_comprehension_element_region(then_iterable, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        else_region: sview @source = region_escape_comprehension_element_region(else_iterable, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, catch_match_lines)
                        return region_escape_element_region_join(then_region, else_region, nesting)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        collection_name: sview @source = region_escape_assign_target_root(object)
                        element_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, collection_name)
                        owner_region: sview @source = region_escape_stored_or_call_region(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                        owner_position: (found: bool, position: usize) = region_stack_position(nesting, owner_region)
                        return nesting[nesting.count - 1] if element_region == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION and nesting.count > 0
                        return nesting[nesting.count - 1] if element_region == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION and owner_position.found and nesting.count > 0
                        return element_region
                    Expr.Index(object, _, _) | Expr.IndexN(object, _, _):
                        collection_name: sview @source = region_escape_assign_target_root(object)
                        element_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, collection_name)
                        owner_region: sview @source = region_escape_stored_or_call_region(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                        owner_position: (found: bool, position: usize) = region_stack_position(nesting, owner_region)
                        return nesting[nesting.count - 1] if element_region == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION and nesting.count > 0
                        return nesting[nesting.count - 1] if element_region == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION and owner_position.found and nesting.count > 0
                        return element_region
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        element_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview @source = region_escape_stored_or_call_region_with_elements(element, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line)
                            element_region <- region_escape_element_region_join(element_region, candidate, nesting)
                        return element_region
                    Expr.SetLit(elements, _):
                        element_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview @source = region_escape_stored_or_call_region_with_elements(element, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line)
                            element_region <- region_escape_element_region_join(element_region, candidate, nesting)
                        return element_region
                    _:
                        return REGION_ESCAPE_UNKNOWN_ELEMENT_REGION


        def region_escape_collect_pattern_binding_names(pattern: Ast::Pattern, out: mutable darray[sview @source]& @source) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(binding_name) | Pattern.Rest(binding_name):
                        out.push(binding_name) if binding_name != ""
                    Pattern.TypeBind(_, binder):
                        out.push(binder)
                    Pattern.As(as_name, inner):
                        out.push(as_name)
                        for inner_pattern in inner |out|:
                            region_escape_collect_pattern_binding_names(inner_pattern, out)
                    Pattern.Variant(_, fields):
                        for field_pattern in fields |out|:
                            region_escape_collect_pattern_binding_names(field_pattern, out)
                    Pattern.Struct(_, fields):
                        for field_pattern in fields |out|:
                            region_escape_collect_pattern_binding_names(field_pattern, out)
                    Pattern.Field(_, inner):
                        for inner_pattern in inner |out|:
                            region_escape_collect_pattern_binding_names(inner_pattern, out)
                    Pattern.Tuple(elements):
                        for element_pattern in elements |out|:
                            region_escape_collect_pattern_binding_names(element_pattern, out)
                    Pattern.Or(options):
                        for option_pattern in options |out|:
                            region_escape_collect_pattern_binding_names(option_pattern, out)
                    _:
                        pass



        def check_region_escape_walk(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview @source]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, container_structs: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            empty_stack: darray[sview @source] = []
                            ref_params: mutable darray[sview @source] = []
                            collect_forwardable_ref_params(parameters, ref_params)
                            empty_outer_locals: mutable darray[sview @source] = [parameter.name for parameter in parameters]
                            # The parameter names on their own. outer_locals is seeded WITH them
                            # (the store rules need that -- storing a region value into a param is
                            # an escape in both compilers), but the GROWTH rule must tell them
                            # apart: a param's container belongs to the caller.
                            param_names: darray[sview @source] = [parameter.name for parameter in parameters]
                            local_type_names: mutable darray[sview @source] = [parameter.name for parameter in parameters]
                            local_type_exprs: mutable darray[Ast::Expr] @source = [parameter.type_expression for parameter in parameters]
                            region_locals: mutable darray[sview @source] = []
                            region_local_regions: mutable darray[sview @source] = []
                            taint_names: mutable darray[sview @source] = []
                            taint_regions: mutable darray[sview @source] = []
                            element_taint_names: mutable darray[sview @source] = []
                            element_taint_regions: mutable darray[sview @source] = []
                            table <- region_escape_walk(body, line.line, empty_stack, annotations, mutable_globals, ref_params, empty_outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        Decl.Module(module_name, module_body, module_line):
                            previous_module: sview @source = table.current_module
                            table.current_module <- module_name
                            table <- check_region_escape_walk(module_body, annotations, mutable_globals, view_fns, container_fns, container_structs, table)
                            table.current_module <- previous_module
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_region_escape_walk(scoped_body, annotations, mutable_globals, view_fns, container_fns, container_structs, table)
                        _:
                            pass



        def check_region_escape(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                mutable_globals: mutable darray[sview @source] = []
                collect_mutable_globals(file.top_decls, mutable_globals)
                view_fns: mutable darray[sview @source] = []
                collect_view_returning_fns(file.top_decls, view_fns)
                container_structs: mutable darray[sview @source] = []
                collect_container_structs(file.top_decls, container_structs)
                container_fns: mutable darray[sview @source] = []
                region_escape_collect_container_fns(file.top_decls, container_structs, container_fns)
                table <- check_region_escape_walk(file.top_decls, file.local_region_annotations, mutable_globals, view_fns, container_fns, container_structs, table)

include "./region_escape_provenance.elisa"
include "./region_escape_stores.elisa"
include "./region_escape_assignments.elisa"
