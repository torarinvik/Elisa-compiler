                                arm_bound_names: mutable darray[sview @source] @source = []
                                region_escape_collect_pattern_binding_names(arm.pattern, arm_bound_names)
                                arm_incoming_names: mutable darray[sview @source] = [name for name in branch_incoming_names]
                                arm_incoming_regions: mutable darray[sview @source] = [region for region in branch_incoming_regions]
                                arm_incoming_element_taint_names: mutable darray[sview @source] = [name for name in branch_incoming_element_taint_names]
                                arm_incoming_element_taint_regions: mutable darray[sview @source] = [region for region in branch_incoming_element_taint_regions]
                                for bound_name in arm_bound_names |arm_incoming_names, arm_incoming_regions, arm_incoming_element_taint_names, arm_incoming_element_taint_regions|:
                                    arm_incoming_names.push(bound_name)
                                    arm_incoming_regions.push(scrutinee_region)
                                    arm_incoming_element_taint_names.push(bound_name)
                                    arm_incoming_element_taint_regions.push("")
                                arm_outer_locals: mutable darray[sview @source] = [name for name in outer_locals]
                                arm_type_names: mutable darray[sview @source] = [name for name in local_type_names]
                                arm_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                                for bound_name in arm_bound_names |arm_outer_locals, arm_type_names, arm_type_exprs|:
                                    arm_outer_locals.push(bound_name)
                                    arm_type_names.push(bound_name)
                                    arm_type_exprs.push(Ast::Expr.Absent)
                                arm_body: darray[Ast::Stmt] = [] if arm_guard_aborts else arm.body
                                table <- region_escape_walk_get_else_recovery_branch(arm.guard, arm_body, branch_incoming_names, branch_incoming_regions, branch_incoming_element_taint_names, branch_incoming_element_taint_regions, arm_bound_names, function_line, nesting, annotations, mutable_globals, ref_params, arm_outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, arm_type_names, arm_type_exprs, container_structs, table)
                            arm_index <- arm_index + 1.usize()
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos, _):
                        table <- region_escape_walk_get_else_recovery(iterable, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        incoming_taint_names: darray[sview @source] = [name for name in taint_names]
                        incoming_taint_regions: darray[sview @source] = [region for region in taint_regions]
                        comprehension_outer_locals: mutable darray[sview @source] = [name for name in outer_locals]
                        comprehension_outer_locals.push(variable)
                        comprehension_nesting: mutable darray[sview @source] = [region for region in nesting]
                        comprehension_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                        comprehension_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                        comprehension_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                        comprehension_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                        comprehension_element_taint_names: mutable darray[sview @source] = [name for name in element_taint_names]
                        comprehension_element_taint_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                        comprehension_element_region: sview @source = region_escape_comprehension_element_region(iterable, annotations, view_fns, container_fns, comprehension_nesting, comprehension_taint_names, comprehension_taint_regions, comprehension_element_taint_names, comprehension_element_taint_regions, comprehension_pos.line, [catch_line for catch_line in table.catch_match_lines])
                        comprehension_taint_names.push(variable)
                        comprehension_taint_regions.push(comprehension_element_region)
                        region_escape_element_taint_set(comprehension_element_taint_names, comprehension_element_taint_regions, variable, comprehension_element_region)
                        comprehension_type_names: mutable darray[sview @source] = [name for name in local_type_names]
                        comprehension_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                        comprehension_type_names.push(variable)
                        comprehension_type_exprs.push(Ast::Expr.Absent)
                        table <- region_escape_walk_get_else_recovery(condition, function_line, comprehension_nesting, annotations, mutable_globals, ref_params, comprehension_outer_locals, param_names, comprehension_region_locals, comprehension_region_local_regions, view_fns, container_fns, comprehension_taint_names, comprehension_taint_regions, comprehension_element_taint_names, comprehension_element_taint_regions, comprehension_type_names, comprehension_type_exprs, container_structs, table)
                        table <- region_escape_walk_get_else_recovery(body, function_line, comprehension_nesting, annotations, mutable_globals, ref_params, comprehension_outer_locals, param_names, comprehension_region_locals, comprehension_region_local_regions, view_fns, container_fns, comprehension_taint_names, comprehension_taint_regions, comprehension_element_taint_names, comprehension_element_taint_regions, comprehension_type_names, comprehension_type_exprs, container_structs, table)
                        region_escape_merge_recovery_taints(taint_names, taint_regions, comprehension_taint_names, comprehension_taint_regions, nesting, variable, [])
                        region_escape_merge_element_taints(element_taint_names, element_taint_regions, comprehension_element_taint_names, comprehension_element_taint_regions, nesting, variable, [])
                    Expr.Lambda(parameters, body, _):
                        lambda_outer_locals: mutable darray[sview @source] = [name for name in outer_locals]
                        lambda_type_names: mutable darray[sview @source] = [name for name in local_type_names]
                        lambda_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                        lambda_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                        lambda_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                        lambda_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                        lambda_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                        lambda_element_taint_names: mutable darray[sview @source] = [name for name in element_taint_names]
                        lambda_element_taint_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                        for parameter in parameters |lambda_outer_locals, lambda_type_names, lambda_type_exprs|:
                            lambda_outer_locals.push(parameter)
                            lambda_type_names.push(parameter)
                            lambda_type_exprs.push(Ast::Expr.Absent)
                            lambda_region_locals.push(parameter)
                            lambda_region_local_regions.push("")
                            lambda_taint_names.push(parameter)
                            lambda_taint_regions.push("")
                            region_escape_element_taint_set(lambda_element_taint_names, lambda_element_taint_regions, parameter, REGION_ESCAPE_UNKNOWN_ELEMENT_REGION)
                        table <- region_escape_walk(body, function_line, nesting, annotations, mutable_globals, ref_params, lambda_outer_locals, param_names, lambda_region_locals, lambda_region_local_regions, view_fns, container_fns, lambda_taint_names, lambda_taint_regions, lambda_element_taint_names, lambda_element_taint_regions, lambda_type_names, lambda_type_exprs, container_structs, table)
