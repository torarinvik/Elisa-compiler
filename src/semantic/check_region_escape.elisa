                        for field in fields |table, region_locals, region_local_regions, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs| -> table:
                            table <- region_escape_walk_get_else_recovery(field.value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                    Expr.Match(scrutinee, arms, expression_pos) | Expr.Catch(scrutinee, arms, expression_pos):
