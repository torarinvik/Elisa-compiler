                            region_escape_merge_element_taints(element_taint_names, element_taint_regions, else_element_taint_names, else_element_taint_regions, nesting, "", [], not then_reachable)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.RegionNew(object, _, _):
                        table <- region_escape_walk_get_else_recovery(object, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
