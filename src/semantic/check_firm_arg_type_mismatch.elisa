# Check for FIRM (non-literal) arguments whose inferred type can never inhabit
# their parameter's declared type. e.g., def g(k: i64) called as g(s) where
# s: cstr — a string value can never fit an i64 parameter.
# Disjoint from LiteralArgTypeMismatch, which owns literal arguments.

extend Semantic:
    private:
        def protocol_state_of_annotation(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.IndexN(protocol_head, protocol_arguments, protocol_line):
                        if protocol_arguments.count == 2:
                            match protocol_arguments[1]:
                                Expr.Ident(state_name, state_line):
                                    return state_name
                                _:
                                    pass
                    _:
                        pass
                return ""

        def local_protocol_state(name: sview, state_names: darray[sview]&, states: darray[sview]&) -> sview:
            can Abort.Panic:
                # Bindings are shadowable.  The most recently recorded state is the
                # innermost one, just like local_type_of/local_type_id_of.
                while state_index > 0 |state_index: usize = state_names.count|:
                    state_index <- state_index - 1
                    states[state_index] return if state_names[state_index] == name
                return ""


        # Return the structural element type bound by a loop pattern.  Ranges are the
        # one non-container iterable represented directly in the AST; their counter is
        # the language's default integer type.  For containers, use the same interned
        # TypeId channel as the main type resolver so a firm argument inside a loop sees
        # the binder's type instead of an outer local with the same spelling.
        def firm_loop_binding_type_id(iterable: Ast::Expr, variable_index: usize, variable_count: usize, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match iterable:
                    Expr.Binary(range_left, range_operator, range_right, range_line):
                        return 0 if range_operator == TokenKind.Range or range_operator == TokenKind.RangeLt or range_operator == TokenKind.RangeGt or range_operator == TokenKind.RangeLe
                    _:
                        pass
                iterable_id: u32 = structural_type_id_of(iterable, var_types, type_names, table)
                iterable_head: sview = interned_name(iterable_id, table) if interned_kind(iterable_id, table) == SemTypeKind.Container else ""
                if iterable_head == "dict" and variable_count == 2:
                    return interned_elem(iterable_id, variable_index, table) if variable_index < 2
                if (iterable_head == "darray" or iterable_head == "array" or iterable_head == "set") and variable_count == 1:
                    return interned_elem(iterable_id, 0, table)
                return 0


        def firm_loop_binding_type_name(iterable: Ast::Expr, variable_index: usize, variable_count: usize, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match iterable:
                    Expr.Binary(range_left, range_operator, range_right, range_line):
                        return "i64" if range_operator == TokenKind.Range or range_operator == TokenKind.RangeLt or range_operator == TokenKind.RangeGt or range_operator == TokenKind.RangeLe
                    _:
                        pass
                binding_id: u32 = firm_loop_binding_type_id(iterable, variable_index, variable_count, var_types, type_names, table)
                return type_name_of_row(binding_id, table) if binding_id != 0
                return ""


        # Keep the firm walker's flat type stack, structural TypeId stack, and protocol
        # state stack lexically scoped together.  The old walk never popped any of these,
        # so a declaration in an earlier loop could incorrectly type a later shadowing
        # binder (for example `moves: darray[i64]` followed by `for moves in 1..<3`).
        def close_firm_scope(flat_mark: usize, structural_mark: usize, state_mark: usize, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, state_names: mutable darray[sview]&, states: mutable darray[sview]&, table: mutable SymbolTable&) -> void:
            can Abort.Panic:
                var_types.truncate(flat_mark)
                type_names.truncate(flat_mark)
                state_names.truncate(state_mark)
                states.truncate(state_mark)
                table.local_type_names <- table.local_type_names.truncate(structural_mark) if table.local_type_names.count > structural_mark
                table.local_type_ids <- table.local_type_ids.truncate(structural_mark) if table.local_type_ids.count > structural_mark

        def extern_protocol_state(function_name: sview, position: usize, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&) -> sview:
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, _, decorators, extern_line):
                            retained_state: sview = extern_params[param_start.usize() + position].type_name if position < arity.usize() else ""
                            retained_state return if callable and extern_name == function_name and retained_state in {"Joinable", "Pending"}
                        Decl.Module(module_name, body, module_line):
                            nested_state: sview = extern_protocol_state(function_name, position, body, extern_params)
                            nested_state return if nested_state != ""
                        Decl.Scoped(body, scoped_line):
                            nested_state: sview = extern_protocol_state(function_name, position, body, extern_params)
                            nested_state return if nested_state != ""
                        _:
                            pass
                return ""

        def moved_local_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, ident_line): name
                    Expr.Move(operand, move_line): moved_local_name(operand)
                    _: ""

        def unmoved_local_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, ident_line): name
                    Expr.Paren(inner, paren_line): unmoved_local_name(inner)
                    _: ""

        # Whether NAME is a GENUINE nominal type — a declared enum or a struct with fields.
        # Deliberately narrow: enums (is_enum_name) and structs (owning a registered field)
        # are the only names this returns true for. Type aliases, refinements, type params,
        # primitives, and generics are NONE of those, so they are excluded automatically —
        # no separate alias/refine registry needed. A struct/enum value can never inhabit a
        # primitive scalar parameter, and (unlike aliases/refines) is not transparently
        # convertible to one, so flagging it matches stage0 without false positives.
        def firm_is_nominal_struct_or_enum(name: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if name == ""
                # No length guard: the registries below already exclude type params (a bare
                # `T` is neither an enum nor a field-owning struct), so a single-letter struct
                # name like `S` is still caught while `T` is not.
                true return if is_enum_name(table, name)
                return any owner in table.struct_field_owner where owner == name

        # Whether a firm argument of nominal type `arg_type` can never inhabit parameter type
        # `param_type`: the parameter is a primitive scalar family (int/float/bool/char/string)
        # and the argument is a genuine struct/enum. Mirrors stage0's `argument N to F expects
        # <scalar>, got <Struct>`.
        def firm_nominal_never_fits(arg_type: InferType, param_type: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if arg_type.kind != SemTypeKind.Named
                false return if family_of_type_name(param_type) == ""
                return firm_is_nominal_struct_or_enum(arg_type.name, table)

        # Get the declared bare type name of parameter at position `position` in function `function_name`.
        # Returns "" if the parameter type is not a bare ident, or position is out of bounds.
        def function_parameter_type_at_firm(table: SymbolTable&, function_name: sview, position: usize) -> sview:
            can Abort.Panic:
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per non-literal argument of every direct call — see the matching
                # comment on function_parameter_count in resolve_expr.elisa.
                seen: mutable usize = 0
                cur: mutable u32 = function_param_chain_head(table, function_name)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == function_name:
                        table.function_param_type[cur.usize()] return if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return ""

        # Extern parameters live in the AST side table rather than the symbol table's
        # function-parameter chain.  Keep the same firm-argument check for them: without
        # this lookup, `extern draw_text(value: cstr)` accepted `bytes[0]` (u8), and the
        # backend converted that byte to an integer-to-pointer value instead of diagnosing
        # the ABI mismatch.  Stage0 rejects the call before code generation.
        # Accumulate every declaration of NAME, so a REDECLARED extern can be detected rather
        # than silently resolved to whichever one the walk happened to reach first.
        def extern_parameter_type_scan(function_name: sview, position: usize, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&, found: mutable sview&, conflict: mutable bool&) -> void:
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                            if extern_name == function_name and position < arity.usize():
                                candidate: sview = extern_params[param_start.usize() + position].type_name
                                if found == "":
                                    found <- candidate
                                else:
                                    conflict <- true if found != candidate
                        Decl.Module(module_name, body, module_line):
                            extern_parameter_type_scan(function_name, position, body, extern_params, found, conflict)
                        Decl.Scoped(body, scoped_line):
                            extern_parameter_type_scan(function_name, position, body, extern_params, found, conflict)
                        _:
                            pass

        # An extern declared TWICE with different parameter types is UNMODELED here, not
        # resolved to the first declaration seen. stage0 accepts a call that matches EITHER
        # declaration, in either declaration order (verified both ways), so picking one and
        # rejecting arguments that match the other is a false positive.
        #
        # This is not hypothetical: stage1's own src/backend/llvm_c.elisa declares
        # `extern getenv(name: cstr)` while its vendored elisacore_std/debug_referee.elisa
        # declares `extern getenv(name: u8&)`. The self-host build concatenates both, and
        # returning the first match made stage1 reject ITS OWN SOURCE with 14 copies of
        # `argument 1 to "getenv" expects u8, got cstr` -- so gen2 never built and the
        # gen3 == gen4 fixpoint could not run at all.
        # See repro/nw_stage1_redeclared_extern_signature.elisa in the elisa-core worktree.
        def extern_parameter_type_at_firm(function_name: sview, position: usize, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                conflict: mutable bool = false
                extern_parameter_type_scan(function_name, position, declarations, extern_params, found, conflict)
                return "" if conflict
                return found

        # Whether at least one same-named extern overload can accept this firm argument at
        # POSITION. Extern declarations are deliberately kept out of the function-parameter
        # chain, so `extern_parameter_type_at_firm` above used to select the FIRST declaration
        # only. That is unsound for legal ABI overloads such as the runtime `puts(u8&)` beside
        # the LLVM binding `puts(cstr)`: a cstr argument was checked against u8 and rejected
        # before the backend could select the cstr overload. Walk every declaration instead.
        # An unmodelled parameter spelling is compatible here: this check is a sound mismatch
        # subset and must not reject a candidate whose full type structure is unavailable.
        def extern_has_compatible_firm_parameter(function_name: sview, position: usize, argument_type: InferType, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    if declaration is Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                        if extern_name == function_name and position < arity.usize():
                            candidate: sview = extern_params[param_start.usize() + position].type_name
                            true return if candidate == "" or not firm_argument_never_fits(argument_type, candidate, table)
                    if declaration is Decl.Module(module_name, body, module_line):
                        true return if extern_has_compatible_firm_parameter(function_name, position, argument_type, body, extern_params, table)
                    if declaration is Decl.Scoped(body, scoped_line):
                        true return if extern_has_compatible_firm_parameter(function_name, position, argument_type, body, extern_params, table)
                return false

        # The same small mismatch predicate is shared by the overload-aware extern scan and
        # the existing diagnostic arm below. Keeping it centralized prevents the two paths
        # from drifting on nominal struct/enum arguments.
        def firm_argument_never_fits(argument_type: InferType, param_type: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if param_type == ""
                argument_family: sview = family_of_kind(argument_type)
                return firm_never_fits(argument_family, param_type) if argument_family != ""
                return firm_nominal_never_fits(argument_type, param_type, table)

        # Check every positional, firm (non-literal) argument of a direct call against its
        # parameter's declared type. Extracted from the expression walk so the Call arm
        # there dispatches once instead of pyramiding a while + four `if`s (docs/121 flow).
        def check_firm_call_arguments(fn_name: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], line: u32, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview]&, state_names: darray[sview]&, states: darray[sview]&, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&) -> void:
            can Memory.Allocate, Abort.Panic:
                argument_index: mutable usize = 0
                while argument_index < arguments.count:
                    # Named args + literals are owned by other checks; skip them in one guard.
                    if argument_names[argument_index] == "" and literal_kind_of(arguments[argument_index]) == "":
                        direct_param_type: sview = function_parameter_type_at_firm(table, fn_name, argument_index)
                        extern_param_type: sview = extern_parameter_type_at_firm(fn_name, argument_index, declarations, extern_params)
                        param_type: sview = direct_param_type if direct_param_type != "" else extern_param_type
                        arg_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                        arg_family: sview = family_of_kind(arg_type) if param_type != "" else ""
                        extern_candidate_compatible: bool = extern_has_compatible_firm_parameter(fn_name, argument_index, arg_type, declarations, extern_params, table) if extern_param_type != "" else false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, line: line, expected: param_type, actual: stage0_value_spelling(arg_type), expected_count: (argument_index + 1).u32()}) if param_type != "" and not extern_candidate_compatible and arg_family != "" and firm_never_fits(arg_family, param_type)
                        # Nominal struct/enum value against a primitive-scalar parameter — a
                        # family the coarse `arg_family` leaves unmodeled (""). Disjoint from the
                        # firm_never_fits wall above (that fires only on non-"" scalar families).
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, line: line, expected: param_type, actual: arg_type.name, expected_count: (argument_index + 1).u32()}) if param_type != "" and not extern_candidate_compatible and arg_family == "" and firm_nominal_never_fits(arg_type, param_type, table)
                        unmoved_name: sview = unmoved_local_name(arguments[argument_index]) if state_names.count > 0 else ""
                        flat_argument_type: sview = local_type_of(var_types, type_names, unmoved_name) if unmoved_name != "" else ""
                        argument_state: sview = local_protocol_state(unmoved_name, state_names, states) if unmoved_name != "" else ""
                        argument_declared_type: sview = "Thread" if argument_state == "Joinable" else ("Task" if argument_state == "Pending" else flat_argument_type)
                        thread_argument: bool = argument_declared_type == "Thread"
                        extern_state: sview = extern_protocol_state(fn_name, argument_index, declarations, extern_params) if thread_argument else ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: unmoved_name, line: line, expected: "ThreadCall", actual: fn_name}) if thread_argument and extern_state == "Joinable"
                        expected_state: sview = extern_protocol_state(fn_name, argument_index, declarations, extern_params)
                        actual_state: sview = local_protocol_state(moved_local_name(arguments[argument_index]), state_names, states)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, line: line, expected: expected_state, actual: actual_state}) if expected_state != "" and actual_state != "" and expected_state != actual_state
                    argument_index <- argument_index + 1

        # Walk through expressions, checking for firm argument type mismatches.
        def walk_expression_for_firm_arg_type_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, state_names: mutable darray[sview]&, states: mutable darray[sview]&, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        # A direct, non-overloaded call: check its firm arguments' types.
                        match callee:
                            Expr.Ident(fn_name, _):
                                direct_count: u32 = direct_function_count(table, fn_name)
                                extern_first_param: sview = extern_parameter_type_at_firm(fn_name, 0, declarations, extern_params)
                                table <- check_firm_call_arguments(fn_name, arguments, argument_names, line.line, table, var_types, type_names, state_names, states, declarations, extern_params) if direct_count == 1 or state_names.count > 0 or extern_first_param != ""
                            _:
                                pass
                        # Recursively walk callee
                        table <- walk_expression_for_firm_arg_type_mismatch(callee, table, var_types, type_names, state_names, states, declarations, extern_params)
                        # Recursively walk arguments
                        for argument in arguments |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(argument, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(left, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(right, table, var_types, type_names, state_names, states, declarations, extern_params) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(base, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(index, table, var_types, type_names, state_names, states, declarations, extern_params) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(operand, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(inner, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(low, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(high, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params)
                        for argument in arguments |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(argument, table, var_types, type_names, state_names, states, declarations, extern_params) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(entry.key, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- walk_expression_for_firm_arg_type_mismatch(entry.value, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(type_expression, table, var_types, type_names, state_names, states, declarations, extern_params)
                        for field in fields |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(field.value, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(base, table, var_types, type_names, state_names, states, declarations, extern_params)
                        for field in fields |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(field.value, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(then_expr, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(else_expr, table, var_types, type_names, state_names, states, declarations, extern_params)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(iterable, table, var_types, type_names, state_names, states, declarations, extern_params)
                        comprehension_flat_mark: usize = var_types.count
                        comprehension_structural_mark: usize = table.local_type_names.count
                        comprehension_state_mark: usize = state_names.count
                        comprehension_type_name: sview = firm_loop_binding_type_name(iterable, 0, 1, var_types, type_names, table)
                        comprehension_type_id: u32 = firm_loop_binding_type_id(iterable, 0, 1, var_types, type_names, table)
                        note_local_type(var_types, type_names, loop_variable, comprehension_type_name)
                        note_local_type_id_direct(loop_variable, comprehension_type_id, table)
                        table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- close_firm_scope(comprehension_flat_mark, comprehension_structural_mark, comprehension_state_mark, var_types, type_names, state_names, states, table)
                    Expr.Lambda(parameters, body, line):
                        lambda_flat_mark: usize = var_types.count
                        lambda_structural_mark: usize = table.local_type_names.count
                        lambda_state_mark: usize = state_names.count
                        for parameter in parameters |var_types, type_names, table|:
                            # Lambda parameters are stored as names only in this AST form;
                            # they still must shadow an outer local, but have no annotation
                            # from which this sound-subset pass could infer a firm type.
                            note_local_type(var_types, type_names, parameter, "")
                            note_local_type_id_direct(parameter, 0, table)
                        table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- close_firm_scope(lambda_flat_mark, lambda_structural_mark, lambda_state_mark, var_types, type_names, state_names, states, table)
                    Expr.Block(statements, value, captures, line):
                        block_flat_mark: usize = var_types.count
                        block_structural_mark: usize = table.local_type_names.count
                        block_state_mark: usize = state_names.count
                        table <- walk_statements_for_firm_arg_type_mismatch(statements, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names, state_names, states, declarations, extern_params)
                        table <- close_firm_scope(block_flat_mark, block_structural_mark, block_state_mark, var_types, type_names, state_names, states, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(scrutinee, table, var_types, type_names, state_names, states, declarations, extern_params)
                        for arm in arms |table|:
                            arm_flat_mark: usize = var_types.count
                            arm_structural_mark: usize = table.local_type_names.count
                            arm_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(arm.body, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- close_firm_scope(arm_flat_mark, arm_structural_mark, arm_state_mark, var_types, type_names, state_names, states, table)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for firm argument mismatches.
        def walk_statements_for_firm_arg_type_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, state_names: mutable darray[sview]&, states: mutable darray[sview]&, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(expression, table, var_types, type_names, state_names, states, declarations, extern_params)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable BEFORE walking its value,
                            # so downstream expressions see the local's type.
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            # Keep the structural side channel local to this function and
                            # lexical scope as well.  The firm pass runs after name resolution,
                            # so relying on the resolver's last function's side table made a
                            # same-named container from another walk leak into this one.
                            note_local_type_id(name, type_expression, table)
                            declared_state: sview = protocol_state_of_annotation(type_expression)
                            state_names.push(name) if declared_state != ""
                            states.push(declared_state) if declared_state != ""
                            table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names, state_names, states, declarations, extern_params)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(target, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names, state_names, states, declarations, extern_params)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params)
                            then_flat_mark: usize = var_types.count
                            then_structural_mark: usize = table.local_type_names.count
                            then_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(then_body, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- close_firm_scope(then_flat_mark, then_structural_mark, then_state_mark, var_types, type_names, state_names, states, table)
                            else_flat_mark: usize = var_types.count
                            else_structural_mark: usize = table.local_type_names.count
                            else_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(else_body, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- close_firm_scope(else_flat_mark, else_structural_mark, else_state_mark, var_types, type_names, state_names, states, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params)
                            while_flat_mark: usize = var_types.count
                            while_structural_mark: usize = table.local_type_names.count
                            while_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- close_firm_scope(while_flat_mark, while_structural_mark, while_state_mark, var_types, type_names, state_names, states, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(iterable, table, var_types, type_names, state_names, states, declarations, extern_params)
                            for_flat_mark: usize = var_types.count
                            for_structural_mark: usize = table.local_type_names.count
                            for_state_mark: usize = state_names.count
                            for variable_index in 0..<variables.count |var_types, type_names, table|:
                                loop_type_name: sview = firm_loop_binding_type_name(iterable, variable_index, variables.count, var_types, type_names, table)
                                loop_type_id: u32 = firm_loop_binding_type_id(iterable, variable_index, variables.count, var_types, type_names, table)
                                note_local_type(var_types, type_names, variables[variable_index], loop_type_name)
                                note_local_type_id_direct(variables[variable_index], loop_type_id, table)
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- close_firm_scope(for_flat_mark, for_structural_mark, for_state_mark, var_types, type_names, state_names, states, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_flat_mark: usize = var_types.count
                            block_structural_mark: usize = table.local_type_names.count
                            block_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params)
                            table <- close_firm_scope(block_flat_mark, block_structural_mark, block_state_mark, var_types, type_names, state_names, states, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(scrutinee, table, var_types, type_names, state_names, states, declarations, extern_params)
                            for arm in arms |table|:
                                arm_flat_mark: usize = var_types.count
                                arm_structural_mark: usize = table.local_type_names.count
                                arm_state_mark: usize = state_names.count
                                table <- walk_expression_for_firm_arg_type_mismatch(arm.guard, table, var_types, type_names, state_names, states, declarations, extern_params)
                                table <- walk_statements_for_firm_arg_type_mismatch(arm.body, table, var_types, type_names, state_names, states, declarations, extern_params)
                                table <- close_firm_scope(arm_flat_mark, arm_structural_mark, arm_state_mark, var_types, type_names, state_names, states, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_firm_arg_type_mismatch(return_value, table, var_types, type_names, state_names, states, declarations, extern_params)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(expression, table, var_types, type_names, state_names, states, declarations, extern_params)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_firm_arg_type_mismatch_declarations(declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            state_names: mutable darray[sview] = []
                            states: mutable darray[sview] = []
                            clear_local_type_ids(table)
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                                note_local_type_id(param.name, param.type_expression, table)
                                declared_state: sview = protocol_state_of_annotation(param.type_expression)
                                state_names.push(param.name) if declared_state != ""
                                states.push(declared_state) if declared_state != ""
                            # Walk the function body
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params)
                            clear_local_type_ids(table)
                        Decl.Module(module_name, body, line):
                            table <- check_firm_arg_type_mismatch_declarations(body, extern_params, table)
                        Decl.Scoped(body, line):
                            table <- check_firm_arg_type_mismatch_declarations(body, extern_params, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_firm_arg_type_mismatch(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_firm_arg_type_mismatch_declarations(file.top_decls, file.extern_params, table)
