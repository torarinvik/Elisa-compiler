# Check for FIRM (non-literal) arguments whose inferred type can never inhabit
# their parameter's declared type. e.g., def g(k: i64) called as g(s) where
# s: cstr — a string value can never fit an i64 parameter.
# Disjoint from LiteralArgTypeMismatch, which owns literal arguments.

extend Semantic:
    private:
        # Extern declarations are queried from every direct-call walk. Flatten them once so
        # those lookups do not repeatedly traverse unrelated functions and nested scopes.
        def collect_extern_declarations(declarations: darray[Ast::Decl] @source, extern_declarations: mutable darray[Ast::Decl]& @source) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |extern_declarations|:
                    match declaration:
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                            extern_declarations.push(declaration)
                        Decl.Module(module_name, body, module_line):
                            collect_extern_declarations(body, extern_declarations)
                        Decl.Scoped(body, scoped_line):
                            collect_extern_declarations(body, extern_declarations)
                        _:
                            pass

        def protocol_state_of_annotation(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.IndexN(protocol_head, protocol_arguments, protocol_line):
                        if protocol_arguments.count == 2:
                            match protocol_arguments[1]:
                                Expr.Ident(state_name, state_line):
                                    return state_name
                                _:
                                    pass
                    _:
                        pass
                return ""

        # Preserve the semantic identity of nullable string annotations in the
        # flat local-type channel. `bare_type_name` intentionally returns an
        # empty name for `cstr?`/`sview?`/`dstr?`; their lowered optional
        # reference carrier can then be mistaken for an unvalidated raw byte
        # pointer by `expression_is_raw_reference` when forwarded to `sview`.
        # Structural string payload recognition keeps string contracts distinct
        # from genuine `u8&?` values without weakening the pointer-safety check.
        def firm_local_type_name(type_expression: Ast::Expr, table: mutable SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                declared_type_id: u32 = annotation_type_id(type_expression, table) can Global{Read,Write}
                string_payload_id: u32 = string_payload_type_id(declared_type_id, table)
                return surface_name_of_row(string_payload_id, table) if string_payload_id != 0
                return bare_type_name(type_expression)

        def local_protocol_state(name: sview, state_names: darray[sview @source]&, states: darray[sview @source]&) -> sview:
            can Abort.Panic:
                while state_index > 0 |state_index: usize = state_names.count|:
                    state_index <- state_index - 1
                    return states[state_index] if state_names[state_index] == name
                return ""

        def extern_protocol_state(function_name: sview, position: usize, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&, table: SymbolTable&) -> sview @source:
            can Abort.Panic:
                return extern_protocol_state_slow(function_name, position, declarations, extern_params) if table.firm_extern_next.count != declarations.count
                row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.firm_extern_heads.get(name_hash(function_name)) is head:
                    row <- head
                probes: mutable usize = 0
                while row != SYMBOL_INDEX_ROW_NONE and probes < declarations.count |row, probes, declarations, extern_params, function_name, position, table|:
                    return "" if row.usize() >= declarations.count
                    if declarations[row.usize()] is Decl.Extern(extern_name, param_start, arity, variadic, callable, _, decorators, extern_line):
                        retained_state: sview = extern_params[param_start.usize() + position].type_name if position < arity.usize() else ""
                        return retained_state if callable and extern_name == function_name and retained_state in {"Joinable", "Pending"}
                    row <- table.firm_extern_next[row.usize()]
                    probes <- probes + 1
                return ""

        private def extern_protocol_state_slow(function_name: sview, position: usize, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&) -> sview:
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, _, decorators, extern_line):
                            retained_state: sview = extern_params[param_start.usize() + position].type_name if position < arity.usize() else ""
                            return retained_state if callable and extern_name == function_name and retained_state in {"Joinable", "Pending"}
                        Decl.Module(module_name, body, module_line):
                            nested_state: sview = extern_protocol_state_slow(function_name, position, body, extern_params)
                            return nested_state if nested_state != ""
                        Decl.Scoped(body, scoped_line):
                            nested_state: sview = extern_protocol_state_slow(function_name, position, body, extern_params)
                            return nested_state if nested_state != ""
                        _:
                            pass
                return ""

        # The element type of a loop over an array LITERAL whose elements are all literals
        # of one scalar kind, spelled as stage0 types the binder (`for n in [1, 2]` binds
        # `int`, stage0's untyped-literal spelling). "" when unknown, mixed or a string: check_static_string_binding owns the
        # `static u8&` binder. Without it the binder was untyped here, so `f(n)` for
        # `def f(s: sview)` reached the backend and emitted invalid IR.
        def literal_array_element_type(iterable: Ast::Expr) -> sview:
            can Abort.Panic:
                match iterable:
                    Expr.Array(elements, array_pos):
                        return "" if elements.count == 0
                        kind: sview = literal_kind_of(elements[0])
                        return "" if any element in elements where literal_kind_of(element) != kind
                        return when kind:
                            "int" -> "int"
                            "float" -> "f64"
                            "bool" -> "bool"
                            _ -> ""
                    _:
                        pass
                return ""

        def moved_local_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, ident_line): name
                    Expr.Move(operand, move_line): moved_local_name(operand)
                    _: ""

        def unmoved_local_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, ident_line): name
                    Expr.Paren(inner, paren_line): unmoved_local_name(inner)
                    _: ""

        # The firm-argument walk has its own lightweight local-type channels. Keep those
        # channels scoped exactly like the initializer walk: a declaration or loop binder
        # inside one branch must not shadow a same-named local in a sibling or later branch.
        # Without this, `darray` locals could survive a loop and make a later scalar loop
        # binder look like a container, producing a false FirmArgTypeMismatch diagnostic.
        def close_firm_type_scope(name_mark: usize, state_mark: usize, var_types: mutable darray[sview @source]&, type_names: mutable darray[sview @source]&, state_names: mutable darray[sview @source]&, states: mutable darray[sview @source]&) -> void:
            can Abort.Panic:
                var_types.truncate(name_mark)
                type_names.truncate(name_mark)
                state_names.truncate(state_mark)
                states.truncate(state_mark)

        # Whether NAME is a GENUINE nominal type — a declared enum or a struct with fields.
        # Deliberately narrow: enums (is_enum_name) and structs (owning a registered field)
        # are the only names this returns true for. Type aliases, refinements, type params,
        # primitives, and generics are NONE of those, so they are excluded automatically —
        # no separate alias/refine registry needed. A struct/enum value can never inhabit a
        # primitive scalar parameter, and (unlike aliases/refines) is not transparently
        # convertible to one, so flagging it matches stage0 without false positives.
        def firm_is_nominal_struct_or_enum(name: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if name == ""
                # No length guard: the registries below already exclude type params (a bare
                # `T` is neither an enum nor a field-owning struct), so a single-letter struct
                # name like `S` is still caught while `T` is not.
                return true if is_enum_name(table, name)
                return any owner in table.struct_field_owner where owner == name

        # Whether a firm argument of nominal type `arg_type` can never inhabit parameter type
        # `param_type`: the parameter is a primitive scalar family (int/float/bool/char/string)
        # and the argument is a genuine struct/enum. Mirrors stage0's `argument N to F expects
        # <scalar>, got <Struct>`.
        def firm_nominal_never_fits(arg_type: InferType, param_type: sview @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if:
                    arg_type.kind != SemTypeKind.Named
                    family_of_type_name(param_type) == ""
                return firm_is_nominal_struct_or_enum(arg_type.name, table)

        # Get the declared bare type name of parameter at position `position` in function `function_name`.
        # Returns "" if the parameter type is not a bare ident, or position is out of bounds.
        def function_parameter_type_at_firm(table: SymbolTable&, function_name: sview, position: usize) -> sview:
            can Abort.Panic:
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per non-literal argument of every direct call — see the matching
                # comment on function_parameter_count in resolve_expr.elisa.
                seen: mutable usize = 0
                cur: mutable u32 = function_param_chain_head(table, function_name)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == function_name:
                        return table.function_param_type[cur.usize()] if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return ""


        def function_parameter_type_id_at_firm(table: SymbolTable&, function_name: sview, position: usize) -> u32:
            can Abort.Panic:
                seen: mutable usize = 0
                cur: mutable u32 = function_param_chain_head(table, function_name)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == function_name:
                        return table.function_param_type_id[cur.usize()] if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return 0


        def firm_parameter_type_is_generic(table: SymbolTable&, function_name: sview, parameter_type_id: u32) -> bool:
            can Abort.Panic:
                return false if interned_kind(parameter_type_id, table) != SemTypeKind.Named
                parameter_name: sview = interned_name(parameter_type_id, table)
                cur: mutable u32 = symbol_chain_head(table, function_name)
                while cur != 4294967295:
                    symbol: Symbol = table.symbols[cur.usize()]
                    if symbol.name == function_name and symbol.kind == SymbolKind.Func:
                        generic_index: mutable usize = 0
                        while generic_index < table.generic_param_names.count:
                            return true if table.generic_param_lines[generic_index] == symbol.line and table.generic_param_names[generic_index] == parameter_name
                            generic_index <- generic_index + 1
                    cur <- table.symbol_name_next[cur.usize()]
                return false


        # The string spelling helper above intentionally returns an empty name for a
        # shaped annotation such as `cstr[shape]`. Keep a structural path for the safety
        # boundary so this spelling erasure cannot make a raw pointer look admissible.
        def function_parameter_is_string_at_firm(table: SymbolTable&, function_name: sview, position: usize) -> bool:
            can Abort.Panic:
                seen: mutable usize = 0
                cur: mutable u32 = function_param_chain_head(table, function_name)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == function_name:
                        return string_payload_type_id(table.function_param_type_id[cur.usize()], table) != 0 if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return false

        # Match-bound Optional TypeIds are not always expressible in the checker’s flat
        # name channel. Reject only that structurally confirmed value at a non-optional,
        # non-generic, uniquely-resolved direct-call parameter.
        def firm_optional_type_mismatch(argument: Ast::Expr, function_name: sview, position: usize, names: darray[sview @source]&, types: darray[sview @source]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Ident(name, _):
                        return false if local_type_of(names, types, name) != "__firm_optional_payload__"
                    _:
                        return false
                argument_type_id: u32 = structural_type_id_of(argument, names, types, table)
                return false if interned_kind(argument_type_id, table) != SemTypeKind.Optional
                parameter_type_id: u32 = function_parameter_type_id_at_firm(table, function_name, position)
                return false if parameter_type_id == 0 or interned_kind(parameter_type_id, table) == SemTypeKind.Optional or firm_parameter_type_is_generic(table, function_name, parameter_type_id)
                return true

        # Extern parameters live in the AST side table rather than the symbol table's
        # function-parameter chain.  Keep the same firm-argument check for them: without
        # this lookup, `extern draw_text(value: cstr)` accepted `bytes[0]` (u8), and the
        # backend converted that byte to an integer-to-pointer value instead of diagnosing
        # the ABI mismatch.  Stage0 rejects the call before code generation.
        # Accumulate every declaration of NAME, so a REDECLARED extern can be detected rather
        # than silently resolved to whichever one the walk happened to reach first.
        def extern_parameter_type_scan(function_name: sview @source, position: usize, declarations: darray[Ast::Decl]& @source, extern_params: darray[Ast::ExternParam]& @source, table: SymbolTable&, found: mutable sview& @source, conflict: mutable bool&) -> void:
            can Abort.Panic:
                if table.firm_extern_next.count != declarations.count:
                    for declaration in declarations |found, conflict|:
                        match declaration:
                            Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                                if extern_name == function_name and position < arity.usize():
                                    candidate: sview @source = extern_params[param_start.usize() + position].type_name
                                    if found == "":
                                        found <- candidate
                                    else:
                                        conflict <- true if found != candidate
                            _:
                                pass
                    return
                row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.firm_extern_heads.get(name_hash(function_name)) is head:
                    row <- head
                probes: mutable usize = 0
                while row != SYMBOL_INDEX_ROW_NONE and probes < declarations.count |row, probes, declarations, extern_params, function_name, position, table, found, conflict|:
                    return if row.usize() >= declarations.count
                    if declarations[row.usize()] is Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                        if extern_name == function_name and position < arity.usize():
                            candidate: sview @source = extern_params[param_start.usize() + position].type_name
                            if found == "":
                                found <- candidate
                            else:
                                conflict <- true if found != candidate
                    row <- table.firm_extern_next[row.usize()]
                    probes <- probes + 1

        # An extern declared TWICE with different parameter types is UNMODELED here, not
        # resolved to the first declaration seen. stage0 accepts a call that matches EITHER
        # declaration, in either declaration order (verified both ways), so picking one and
        # rejecting arguments that match the other is a false positive.
        #
        # This is not hypothetical: stage1's own src/backend/llvm_c.elisa declares
        # `extern getenv(name: cstr)` while its vendored elisacore_std/debug_referee.elisa
        # declares `extern getenv(name: u8&)`. The self-host build concatenates both, and
        # returning the first match made stage1 reject ITS OWN SOURCE with 14 copies of
        # `argument 1 to "getenv" expects u8, got cstr` -- so gen2 never built and the
        # gen3 == gen4 fixpoint could not run at all.
        # See repro/nw_stage1_redeclared_extern_signature.elisa in the elisa-core worktree.
        def extern_parameter_type_at_firm(function_name: sview @source, position: usize, declarations: darray[Ast::Decl]& @source, extern_params: darray[Ast::ExternParam]& @source, table: SymbolTable&) -> sview @source:
            can Abort.Panic:
                found: mutable sview @source = ""
                conflict: mutable bool = false
                extern_parameter_type_scan(function_name, position, declarations, extern_params, table, found, conflict)
                return "" if conflict
                return found

        # Whether at least one same-named extern overload can accept this firm argument at
        # POSITION. Extern declarations are deliberately kept out of the function-parameter
        # chain, so this walks every same-name overload in the existing hash chain. That is
        # sound for ABI overloads such as runtime `puts(u8&)` beside LLVM `puts(cstr)` without
        # rescanning every extern in the program at each call site.
        # An unmodelled parameter spelling is compatible here: this check is a sound mismatch
        # subset and must not reject a candidate whose full type structure is unavailable.
        def extern_has_compatible_firm_parameter(function_name: sview @source, position: usize, argument_type: InferType, declarations: darray[Ast::Decl]& @source, extern_params: darray[Ast::ExternParam]& @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if table.firm_extern_next.count != declarations.count:
                    for declaration in declarations:
                        if declaration is Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                            if extern_name == function_name and position < arity.usize():
                                candidate: sview = extern_params[param_start.usize() + position].type_name
                                return true if candidate == "" or not firm_argument_never_fits(argument_type, candidate, table)
                    return false
                row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.firm_extern_heads.get(name_hash(function_name)) is head:
                    row <- head
                probes: mutable usize = 0
                while row != SYMBOL_INDEX_ROW_NONE and probes < declarations.count |row, probes, declarations, extern_params, function_name, position, argument_type, table|:
                    return false if row.usize() >= declarations.count
                    if declarations[row.usize()] is Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                        if extern_name == function_name and position < arity.usize():
                            candidate: sview = extern_params[param_start.usize() + position].type_name
                            return true if candidate == "" or not firm_argument_never_fits(argument_type, candidate, table)
                    row <- table.firm_extern_next[row.usize()]
                    probes <- probes + 1
                return false

        # The same small mismatch predicate is shared by the overload-aware extern scan and
        # the existing diagnostic arm below. Keeping it centralized prevents the two paths
        # from drifting on nominal struct/enum arguments.
        def firm_argument_never_fits(argument_type: InferType, param_type: sview @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if param_type == ""
                # A C string is an invariant-bearing pointer: it must point to a live,
                # NUL-terminated byte sequence. A one-byte reference (or any other raw
                # reference) does not establish that invariant, even when its address is
                # non-null. Require the caller to create/receive a cstr through an explicit
                # unsafe boundary instead of silently treating `&byte` as a string.
                return true if:
                    argument_type.kind == SemTypeKind.Ref and is_string_type_name(param_type)
                    string_member_never_fits(argument_type, param_type)
                argument_family: sview = family_of_kind(argument_type)
                return firm_never_fits(argument_family, param_type) if argument_family != ""
                return firm_nominal_never_fits(argument_type, param_type, table)


        # Check every positional, firm (non-literal) argument of a direct call against its
        # parameter's declared type. Extracted from the expression walk so the Call arm
        # there dispatches once instead of pyramiding a while + four `if`s (docs/121 flow).
        def firm_name_has_protocol_parameter(fn_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if table.function_param_owner.count != table.function_param_name.count
                if table.function_param_name_next.count == table.function_param_owner.count:
                    hash: u64 = name_hash(fn_name)
                    expected_tail: mutable u32 = 4294967295
                    if table.function_param_name_tail.get(hash) is indexed_tail:
                        expected_tail <- indexed_tail
                    cur: mutable u32 = function_param_chain_head(table, fn_name)
                    probes: mutable usize = 0
                    last_row: mutable u32 = 4294967295
                    previous_row: mutable u32 = 4294967295
                    while cur != 4294967295 and probes < table.function_param_owner.count:
                        row: usize = cur.usize()
                        if row >= table.function_param_owner.count or row >= table.function_param_name.count or row >= table.function_param_name_next.count:
                            break
                        if (previous_row != 4294967295 and cur <= previous_row) or name_hash(table.function_param_owner[row]) != hash:
                            break
                        return true if table.function_param_owner[row] == fn_name and sview_starts_with(table.function_param_name[row], "__protocol_arg_")
                        last_row <- cur
                        previous_row <- cur
                        cur <- table.function_param_name_next[row]
                        probes <- probes + 1
                    return false if cur == 4294967295 and probes > 0 and probes <= table.function_param_owner.count and last_row == expected_tail
                # A missing head/tail or malformed chain cannot establish absence.
                row: mutable usize = 0
                while row < table.function_param_owner.count and row < table.function_param_name.count |row, fn_name, table|:
                    return true if table.function_param_owner[row] == fn_name and sview_starts_with(table.function_param_name[row], "__protocol_arg_")
                    row <- row + 1
                return false

        def check_firm_call_arguments(fn_name: sview @source, arguments: darray[Ast::Expr] @source, argument_names: darray[sview @source], call_pos: Ast::Pos, table: lmut SymbolTable, var_types: darray[sview @source]&, type_names: darray[sview @source]&, state_names: darray[sview @source]&, states: darray[sview @source]&, declarations: darray[Ast::Decl]& @source, extern_params: darray[Ast::ExternParam]& @source, unique_direct_function: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                line: u32 = call_pos.line
                caller_line: mutable u32 = 0
                caller_id: u32 = table.current_function_decl_id.value
                caller_line <- table.symbols[caller_id.usize()].line if caller_id < table.symbols.count and caller_id != INVALID_DECL_ID_VALUE
                argument_index: mutable usize = 0
                while argument_index < arguments.count:
                    # Anonymous protocol constraints also apply to named and literal arguments.
                    protocol_position: int = function_parameter_index(table, fn_name, argument_names[argument_index]) if argument_names[argument_index] != "" else argument_index.int()
                    if protocol_position >= 0:
                        protocol_type: sview = function_parameter_type_at_firm(table, fn_name, protocol_position.usize())
                        if sview_starts_with(protocol_type, "__protocol_arg_"):
                            protocol_argument: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                            table <- check_inferred_protocol_argument(fn_name, protocol_type, arguments[argument_index], protocol_argument, call_pos, caller_line, unique_direct_function, table)
                    # This structural check applies only to a single direct declaration:
                    # with overloads, candidate selection owns the parameter type.
                    optional_position: int = function_parameter_index(table, fn_name, argument_names[argument_index]) if argument_names[argument_index] != "" else argument_index.int()
                    optional_mismatch: mutable bool = false
                    if literal_kind_of(arguments[argument_index]) == "" and optional_position >= 0 and direct_function_count(table, fn_name) == 1:
                        optional_mismatch <- firm_optional_type_mismatch(arguments[argument_index], fn_name, optional_position.usize(), var_types, type_names, table)
                    parameter_type_id: u32 = function_parameter_type_id_at_firm(table, fn_name, optional_position.usize()) if optional_mismatch else 0
                    optional_expected: sview = diagnostic_name_of_row(parameter_type_id, table) if optional_mismatch else ""
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: optional_expected, actual: "optional", expected_count: (argument_index + 1).u32()}) if optional_mismatch
                    # Named args + literals are owned by other checks; skip them in one guard.
                    if argument_names[argument_index] == "" and literal_kind_of(arguments[argument_index]) == "":
                        direct_param_type: sview = function_parameter_type_at_firm(table, fn_name, argument_index)
                        extern_param_type: sview = extern_parameter_type_at_firm(fn_name, argument_index, declarations, extern_params, table)
                        param_type: sview = direct_param_type if direct_param_type != "" else extern_param_type
                        arg_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                        arg_family: sview = family_of_kind(arg_type) if param_type != "" else ""
                        raw_reference_source: bool = expression_is_raw_reference(arguments[argument_index], var_types, type_names, table)
                        # The current sview implementation accepts a raw pointer and scans
                        # for NUL before applying the requested range. Only an already
                        # validated cstr or literal may reach that operation safely;
                        # sized buffers use bytes_view_range instead.
                        raw_sview_source: bool = fn_name == "sview" and argument_index == 0.usize() and raw_reference_source
                        string_parameter: bool = raw_reference_source and (is_string_type_name(param_type) or function_parameter_is_string_at_firm(table, fn_name, argument_index))
                        raw_cstr_source: bool = string_parameter and raw_reference_source
                        extern_candidate_compatible: bool = extern_has_compatible_firm_parameter(fn_name, argument_index, arg_type, declarations, extern_params, table) if extern_param_type != "" else false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: "NUL-terminated cstr", actual: "raw reference", expected_count: (argument_index + 1).u32()}) if raw_sview_source
                        raw_cstr_expected: sview = param_type if param_type != "" else "cstr"
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: raw_cstr_expected, actual: "raw reference", expected_count: (argument_index + 1).u32()}) if raw_cstr_source and not raw_sview_source
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: param_type, actual: stage0_value_spelling(arg_type), expected_count: (argument_index + 1).u32()}) if param_type != "" and not extern_candidate_compatible and arg_family != "" and firm_never_fits(arg_family, param_type)
                        # S1g: cstr/sview/dstr never convert implicitly; stage0 spells dstr lowered.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: diagnostic_type_spelling(param_type), actual: stage0_index_spelling(arg_type), expected_count: (argument_index + 1).u32()}) if param_type != "" and not extern_candidate_compatible and string_member_never_fits(arg_type, param_type)
                        # The MIRROR of the nominal wall below: a firm PRIMITIVE argument
                        # against a struct-typed parameter. `firm_never_fits` bails when the
                        # parameter is not a primitive family, so `sink(u)` for `def sink(v: P)`
                        # was silent where stage0 says `argument 1 to "sink" expects P, got u8`
                        # (measured 2026-09-19). Literals never reach here -- the guard above
                        # hands them to the literal checker, which grew the same wall.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: param_type, actual: stage0_value_spelling(arg_type), expected_count: (argument_index + 1).u32()}) if param_type != "" and not extern_candidate_compatible and arg_family != "" and named_struct_target(param_type, table)
                        # Nominal struct/enum value against a primitive-scalar parameter — a
                        # family the coarse `arg_family` leaves unmodeled (""). Disjoint from the
                        # firm_never_fits wall above (that fires only on non-"" scalar families).
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: param_type, actual: arg_type.name, expected_count: (argument_index + 1).u32()}) if param_type != "" and not extern_candidate_compatible and arg_family == "" and firm_nominal_never_fits(arg_type, param_type, table)
                        # Enum into an unrelated enum parameter (check_enum_value_wall). A bare
                        # local argument belongs to check_narrowed_arg_enum, which knows when a
                        # `match` arm narrowed it; judging it here too would report it twice.
                        argument_is_local: bool = enum_wall_is_local(arguments[argument_index])
                        argument_enum: sview = enum_value_never_fits(arguments[argument_index], direct_param_type, var_types, type_names, table) if direct_param_type != "" and not argument_is_local and direct_function_count(table, fn_name) == 1 else ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: direct_param_type, actual: argument_enum, expected_count: (argument_index + 1).u32()}) if argument_enum != ""
                        unmoved_name: sview = unmoved_local_name(arguments[argument_index]) if state_names.count > 0 else ""
                        flat_argument_type: sview = local_type_of(var_types, type_names, unmoved_name) if unmoved_name != "" else ""
                        argument_state: sview = local_protocol_state(unmoved_name, state_names, states) if unmoved_name != "" else ""
                        argument_declared_type: sview = "Thread" if argument_state == "Joinable" else ("Task" if argument_state == "Pending" else flat_argument_type)
                        thread_argument: bool = argument_declared_type == "Thread"
                        extern_state: sview = extern_protocol_state(fn_name, argument_index, declarations, extern_params, table) if thread_argument else ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: unmoved_name, line: line, expected: "ThreadCall", actual: fn_name}) if thread_argument and extern_state == "Joinable"
                        expected_state: sview = extern_protocol_state(fn_name, argument_index, declarations, extern_params, table)
                        actual_state: sview = local_protocol_state(moved_local_name(arguments[argument_index]), state_names, states)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, pos: Ast::expr_pos(arguments[argument_index]), line: line, expected: expected_state, actual: actual_state}) if expected_state != "" and actual_state != "" and expected_state != actual_state
                    argument_index <- argument_index + 1

        # Walk through expressions, checking for firm argument type mismatches.
        def firm_extern_name_of(declaration: Ast::Decl) -> sview @source:
            can Abort.Panic:
                if declaration is Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                    return extern_name
                return ""

        def index_firm_externs(extern_declarations: darray[Ast::Decl]& @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.firm_extern_heads <- {}
                table.firm_extern_tails <- {}
                table.firm_extern_next <- []
                for row in 0..<extern_declarations.count |table|:
                    hash: u64 = name_hash(firm_extern_name_of(extern_declarations[row]))
                    table.firm_extern_next <- table.firm_extern_next.push(SYMBOL_INDEX_ROW_NONE)
                    if table.firm_extern_tails.get(hash) is last_row:
                        table.firm_extern_next[last_row.usize()] <- row.u32()
                    else:
                        table.firm_extern_heads <- table.firm_extern_heads.put(hash, row.u32()) can Global{Read,Write}
                    table.firm_extern_tails <- table.firm_extern_tails.put(hash, row.u32()) can Global{Read,Write}

        def walk_expression_for_firm_arg_type_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview @source]&, type_names: mutable darray[sview @source]&, state_names: mutable darray[sview @source]&, states: mutable darray[sview @source]&, declarations: darray[Ast::Decl]& @source, extern_params: darray[Ast::ExternParam]& @source) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        # A direct, non-overloaded call: check its firm arguments' types.
                        match callee:
                            Expr.Ident(fn_name, _):
                                direct_count: u32 = direct_function_count(table, fn_name)
                                if direct_count > 1 and firm_name_has_protocol_parameter(fn_name, table):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: fn_name, pos: line, line: line.line, expected: "candidate-aware generic-bound overload resolution", actual: "ambiguous overload", expected_count: 1})
                                extern_first_param: sview @source = extern_parameter_type_at_firm(fn_name, 0, declarations, extern_params, table)
                                table <- check_firm_call_arguments(fn_name, arguments, argument_names, line, table, var_types, type_names, state_names, states, declarations, extern_params, direct_count == 1) if direct_count == 1 or state_names.count > 0 or extern_first_param != ""
                            _:
                                pass
                        # Recursively walk callee
                        table <- walk_expression_for_firm_arg_type_mismatch(callee, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        # Recursively walk arguments
                        for argument in arguments |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(argument, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(left, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(right, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write} if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(base, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(index, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write} if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(operand, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(inner, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(low, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(high, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        for argument in arguments |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(argument, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write} if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(entry.key, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            table <- walk_expression_for_firm_arg_type_mismatch(entry.value, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(type_expression, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        for field in fields |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(field.value, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(base, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        for field in fields |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(field.value, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(then_expr, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(else_expr, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        comprehension_name_mark: usize = var_types.count
                        comprehension_state_mark: usize = state_names.count
                        table <- walk_expression_for_firm_arg_type_mismatch(iterable, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        note_local_type(var_types, type_names, loop_variable, "__firm_scope_binder__") if loop_variable != ""
                        table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        close_firm_type_scope(comprehension_name_mark, comprehension_state_mark, var_types, type_names, state_names, states)
                    Expr.Lambda(parameters, body, line):
                        lambda_name_mark: usize = var_types.count
                        lambda_state_mark: usize = state_names.count
                        for parameter in parameters |var_types, type_names|:
                            # Lambda parameters are stored as names rather than ParamDecls;
                            # their inferred types are intentionally conservative here.
                            note_local_type(var_types, type_names, parameter, "__firm_scope_binder__")
                        table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        close_firm_type_scope(lambda_name_mark, lambda_state_mark, var_types, type_names, state_names, states)
                    Expr.Block(statements, value, captures, line):
                        block_name_mark: usize = var_types.count
                        block_state_mark: usize = state_names.count
                        table <- walk_statements_for_firm_arg_type_mismatch(statements, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        close_firm_type_scope(block_name_mark, block_state_mark, var_types, type_names, state_names, states)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(scrutinee, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        match_type_id: u32 = structural_type_id_of(scrutinee, var_types, type_names, table)
                        for arm in arms |table|:
                            arm_name_mark: usize = var_types.count
                            arm_state_mark: usize = state_names.count
                            arm_type_id_mark: usize = table.local_type_names.count
                            arm_pattern: Ast::Pattern = arm.pattern
                            arm_binding_type_id: mutable u32 = match_type_id
                            arm_is_optional_payload_binding: bool = match arm_pattern:
                                Pattern.Binding(_): true
                                _: false
                            arm_binding_type_id <- interned_elem(match_type_id, 0, table) if arm_is_optional_payload_binding and interned_kind(match_type_id, table) == SemTypeKind.Optional and interned_elem_count(match_type_id, table) == 1
                            arm_bindings: mutable darray[sview @source] = []
                            collect_pattern_binding_names(arm_pattern, arm_bindings)
                            for arm_binding in arm_bindings |table, arm_pattern, arm_binding_type_id|:
                                binding_type_id: u32 = pag_pattern_binding_type_id(arm_pattern, arm_binding_type_id, arm_binding, table)
                                note_local_type_id_direct(arm_binding, binding_type_id, table)
                                binding_type_name: sview = type_name_of_row(binding_type_id, table) if interned_kind(binding_type_id, table) == SemTypeKind.Named else ""
                                note_local_type(var_types, type_names, arm_binding, "__firm_optional_payload__") if interned_kind(binding_type_id, table) == SemTypeKind.Optional
                                note_local_type(var_types, type_names, arm_binding, binding_type_name) if binding_type_name != "" and interned_kind(binding_type_id, table) != SemTypeKind.Optional
                            table <- walk_statements_for_firm_arg_type_mismatch(arm.body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            close_firm_type_scope(arm_name_mark, arm_state_mark, var_types, type_names, state_names, states)
                            table.local_type_names <- table.local_type_names.truncate(arm_type_id_mark)
                            table.local_type_ids <- table.local_type_ids.truncate(arm_type_id_mark)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass
