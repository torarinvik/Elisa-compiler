# Check for FIRM (non-literal) arguments whose inferred type can never inhabit
# their parameter's declared type. e.g., def g(k: i64) called as g(s) where
# s: cstr — a string value can never fit an i64 parameter.
# Disjoint from LiteralArgTypeMismatch, which owns literal arguments.

extend Semantic:
    private:
        # Get the declared bare type name of parameter at position `position` in function `function_name`.
        # Returns "" if the parameter type is not a bare ident, or position is out of bounds.
        def function_parameter_type_at_firm(table: SymbolTable&, function_name: sview, position: usize) -> sview:
            can Abort.Panic:
                seen: mutable usize = 0
                while parameter_index < table.function_param_owner.count |parameter_index: usize = 0|:
                    if table.function_param_owner[parameter_index] == function_name:
                        if seen == position:
                            return table.function_param_type[parameter_index]
                        seen <- seen + 1
                    parameter_index <- parameter_index + 1
                return ""

        # Check every positional, firm (non-literal) argument of a direct call against its
        # parameter's declared type. Extracted from the expression walk so the Call arm
        # there dispatches once instead of pyramiding a while + four `if`s (docs/121 flow).
        def check_firm_call_arguments(fn_name: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], line: u32, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                argument_index: mutable usize = 0
                while argument_index < arguments.count:
                    # Named args + literals are owned by other checks; skip them in one guard.
                    if argument_names[argument_index] == "" and literal_kind_of(arguments[argument_index]) == "":
                        param_type: sview = function_parameter_type_at_firm(table, fn_name, argument_index)
                        arg_family: sview = family_of_kind(infer_expression_type(arguments[argument_index], var_types, type_names, table)) if param_type != "" else ""
                        if param_type != "" and arg_family != "" and firm_never_fits(arg_family, param_type):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, line: line, expected: param_type, actual: arg_family})
                    argument_index <- argument_index + 1

        # Walk through expressions, checking for firm argument type mismatches.
        def walk_expression_for_firm_arg_type_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        # A direct, non-overloaded call: check its firm arguments' types.
                        if callee is Expr.Ident(fn_name, _):
                            if direct_function_count(table, fn_name) == 1:
                                table <- check_firm_call_arguments(fn_name, arguments, argument_names, line, table, var_types, type_names)
                        # Recursively walk callee
                        table <- walk_expression_for_firm_arg_type_mismatch(callee, table, var_types, type_names)
                        # Recursively walk arguments
                        for argument in arguments |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(argument, table, var_types, type_names)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(left, table, var_types, type_names)
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            table <- walk_expression_for_firm_arg_type_mismatch(right, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names)
                        if not index_receiver_is_type_application(object):
                            table <- walk_expression_for_firm_arg_type_mismatch(index, table, var_types, type_names)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_firm_arg_type_mismatch(low, table, var_types, type_names)
                        table <- walk_expression_for_firm_arg_type_mismatch(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_firm_arg_type_mismatch(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_firm_arg_type_mismatch(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_firm_arg_type_mismatch(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_firm_arg_type_mismatch(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(iterable, table, var_types, type_names)
                        table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_firm_arg_type_mismatch(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_firm_arg_type_mismatch(statements, table, var_types, type_names)
                        table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_firm_arg_type_mismatch(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_firm_arg_type_mismatch(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for firm argument mismatches.
        def walk_statements_for_firm_arg_type_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable BEFORE walking its value,
                            # so downstream expressions see the local's type.
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(target, table, var_types, type_names)
                            table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_firm_arg_type_mismatch(then_body, table, var_types, type_names)
                            table <- walk_statements_for_firm_arg_type_mismatch(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(iterable, table, var_types, type_names)
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_firm_arg_type_mismatch(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_firm_arg_type_mismatch(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_firm_arg_type_mismatch(return_value, table, var_types, type_names)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_firm_arg_type_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_firm_arg_type_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_firm_arg_type_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_firm_arg_type_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_firm_arg_type_mismatch_declarations(declarations, table)
