# A bare callable reference is ambiguous when distinct active wildcard imports
# expose the same name and no lexical declaration takes precedence.
extend Semantic:
    private:
        def callable_wildcard_ambiguous(file: Ast::File&, name: sview @source, caller_module: sview @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if table.wildcard_import_rows.count < 2
                return false if direct_function_count(table, name) < 2
                return false if semantic_possible_import_name_visible(table, name, caller_module)
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == name and ewr_module_is_lexical_ancestor(symbol.module_owner, caller_module):
                        branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, name, symbol, table, 0)
                        return false if not branch.known or branch.active
                    row <- table.symbol_name_next[row.usize()]
                selected_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                found: mutable bool = false
                for binding in table.definite_import_annotations |selected_row, found, file, name, caller_module, table|:
                    continue if binding.name != "__binding_wildcard_import" or not ewr_module_is_lexical_ancestor(binding.module, caller_module)
                    candidate: mutable u32 = symbol_chain_head(table, name)
                    while candidate != SYMBOL_INDEX_ROW_NONE:
                        symbol: Symbol = table.symbols[candidate.usize()]
                        if symbol.kind == SymbolKind.Func and symbol.name == name and semantic_import_module_path_matches(symbol.module_owner, binding.owner, binding.module):
                            branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, name, symbol, table, 0)
                            return false if not branch.known
                            if branch.active and ewr_callable_name_visible(table.protocol_annotations, name, symbol.module_owner, caller_module, symbol.line, symbol.offset):
                                return true if found and symbol.module_owner != table.symbols[selected_row.usize()].module_owner
                                selected_row <- candidate
                                found <- true
                        candidate <- table.symbol_name_next[candidate.usize()]
                return false
