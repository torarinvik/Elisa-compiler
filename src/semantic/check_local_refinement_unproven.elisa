# A local declared with a refinement (`y: T is Law = SOURCE`) where nothing establishes the
# law for SOURCE. stage0 reports it as unprovable, and the value carries no runtime check
# either, so the refinement is simply not enforced.
#
# The provability boundary, pinned against stage0 in both directions:
#
#   y: i64 is Positive = 5                     LITERAL      -> clean (evaluated elsewhere)
#   requires x > 0; y: i64 is Positive = x     fact         -> clean
#   y: i64 is Positive = x                     no facts     -> UNPROVEN
#
# A first version keyed only on "no `requires` mentions the source" and measured 14 fixed /
# 12 BROKEN. Every false positive was a fact this check could not see, in four families:
#
#   1. `requires forall i in xs.indices: xs[i] > 0`  — reached only through field/index
#   2. `if a >= 10 and a <= 20:`                     — an enclosing GUARD, not a requires
#   3. `law CountIsFour(self) = self.count == 4` on `array[i64, 4]` — from the TYPE
#   4. `Bounded[0..=500]` under a guard                — guard plus law arguments
#
# So the fact layer below collects all four sources. It is deliberately CONSERVATIVE: any
# mention of the source in a requires-clause or an enclosing guard counts as establishing
# the law, and a matching type-derived extent counts. That can only cause MISSES, never a
# false positive — and a false positive (warning where stage0 accepts) is the worse failure
# for a port.
extend Semantic:
    private:
        # The law NAME applied by a type annotation `T is Law` / `T is Law[args]`, or "".
        def local_refinement_law_name(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Binary(left, operator, right, line):
                        empty_name: sview = sview("", 0, 0)
                        empty_name return if operator != TokenKind.Is
                        return match right:
                            Expr.Ident(law_name, ident_line): law_name
                            Expr.Index(applied, argument, index_line): ident_name_of(applied)
                            Expr.IndexN(applied_n, arguments_n, index_n_line): ident_name_of(applied_n)
                            Expr.Call(callee, arguments, argument_names, call_line): ident_name_of(callee)
                            _: sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        # Every identifier an expression mentions, reaching through FIELD and INDEX access so
        # `forall i in xs.indices: xs[i] > 0` counts as mentioning `xs` (family 1).
        # Whether a refinement predicate references an EXTERNAL non-constant term — a field
        # access (`xs.count`) or a call — which the non-SMT prover cannot discharge from a
        # local's initializer (unlike `y > 0 = 5`, provable from the literal). stage0 warns
        # "local where refinement could not be proven" for such predicates.
        def refinement_has_field_or_call(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(object, field, field_line):
                        return true
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return true
                    Expr.Binary(left, operator, right, binary_line):
                        return refinement_has_field_or_call(left) or refinement_has_field_or_call(right)
                    Expr.Unary(operator, operand, unary_line):
                        return refinement_has_field_or_call(operand)
                    Expr.Paren(inner, paren_line):
                        return refinement_has_field_or_call(inner)
                    Expr.Index(object, index, index_line):
                        return refinement_has_field_or_call(object) or refinement_has_field_or_call(index)
                    _:
                        return false

        def refinement_mentions(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Field(object, field, field_line):
                        refinement_mentions(object, out)
                    Expr.Index(object, index, index_line):
                        refinement_mentions(object, out)
                        refinement_mentions(index, out)
                    Expr.IndexN(object, arguments, indexn_line):
                        refinement_mentions(object, out)
                        for argument in arguments |out|:
                            refinement_mentions(argument, out)
                    Expr.Binary(left, operator, right, binary_line):
                        refinement_mentions(left, out)
                        refinement_mentions(right, out)
                    Expr.Paren(inner, paren_line):
                        refinement_mentions(inner, out)
                    Expr.Unary(operator, operand, unary_line):
                        refinement_mentions(operand, out)
                    Expr.Comprehension(variable, iterable, condition, body, q_line):
                        refinement_mentions(iterable, out)
                        refinement_mentions(condition, out)
                        refinement_mentions(body, out)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |out|:
                            refinement_mentions(argument, out)
                    _:
                        pass


        # Facts from `requires` clauses (family 1).
        def refinement_requires_facts(body: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |out|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            refinement_mentions(expression, out) if contract_kind == "requires"
                        _:
                            pass


        # The extent N of an `array[T, N]` annotation, or -1.
        def refinement_array_extent(type_expression: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return refinement_array_extent(operand)
                    Expr.Paren(inner, paren_line):
                        return refinement_array_extent(inner)
                    Expr.IndexN(object, arguments, index_line):
                        (-1) return if ident_name_of(object) != "array" or arguments.count != 2
                        extent: (found: bool, value: i64) = fold_const_int(arguments[1])
                        return extent.value if extent.found else -1
                    _:
                        return (-1)


        # Whether LAW's predicate is `self.count == N` for the given extent (family 3): the
        # fact then comes from the TYPE and needs no other evidence.
        def refinement_count_law_holds(predicate: Ast::Expr, extent: i64) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if extent < 0
                match predicate:
                    Expr.Binary(left, operator, right, line):
                        false return if operator != TokenKind.EqEq
                        counts_self: bool = match left:
                            Expr.Field(object, field, field_line): field == "count" and ident_name_of(object) == "self"
                            _: false
                        false return if not counts_self
                        bound: (found: bool, value: i64) = fold_const_int(right)
                        return bound.found and bound.value == extent
                    _:
                        return false


        # A law whose TOP-LEVEL predicate is an implication (`A implies B`, desugared by the
        # parser to `(not A) or B`) holds without any facts about the value: it is either
        # vacuous or a logical consequence. stage0 proves all of these.
        #
        # Only at the TOP level. An implication nested inside a quantifier -- as in
        # `forall i: (0 <= i and i < self.count) implies self[i] == self[0]` -- is a real
        # obligation about the elements and still needs facts.
        def law_is_top_level_implication(predicate: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Binary(left, operator, right, line):
                        false return if operator != TokenKind.Or
                        return match left:
                            Expr.Unary(unary_operator, operand, unary_line): unary_operator == TokenKind.Not
                            _: false
                    Expr.Paren(inner, paren_line):
                        return law_is_top_level_implication(inner)
                    _:
                        return false


        # A law the check cannot classify (a multi-statement law body parses to no usable
        # predicate expression) is left alone rather than reported.
        def law_predicate_is_opaque(predicate: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if predicate is Expr.Invalid
                true return if predicate is Expr.Absent
                return false


        # A law predicate that quantifies over the value's elements (contains a `forall`/comprehension).
        # Such an element law is NOT established by a fact that merely mentions the source non-element-
        # wise (e.g. `requires xs.count == 3`) — only by a quantified fact over the same source.
        def lru_predicate_is_quantified(predicate: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                # `forall`/`exists` lowers to a Comprehension or a binder Block (both recognised by
                # qr_quantifier_of); also descend through boolean structure to catch nested quantifiers.
                quant: (found: bool, binder: sview, body: Ast::Expr) = qr_quantifier_of(predicate)
                true return if quant.found
                match predicate:
                    Expr.Paren(inner, paren_line):
                        return lru_predicate_is_quantified(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        true return if lru_predicate_is_quantified(left)
                        return lru_predicate_is_quantified(right)
                    Expr.Unary(operator, operand, unary_line):
                        return lru_predicate_is_quantified(operand)
                    _:
                        return false


        # Whether the body carries ANY quantified (`forall`/`exists`) requires. The parser drops a
        # quantifier's source iterable (`forall x in xs` keeps no reference to `xs`), so an element
        # law cannot be tied to a specific source; the presence of any quantified requires is treated
        # conservatively as possibly establishing the element law (suppressing the tightening).
        def refinement_has_quantified_requires(body: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in body:
                    match statement:
                        Stmt.Contract(contract_kind, expression, contract_line):
                            true return if contract_kind == "requires" and lru_predicate_is_quantified(expression)
                        _:
                            pass
                return false


        # The integer VALUE of a match arm whose body is a single value expression
        # (`0: 0`), or (false, 0) when the arm body is not a lone constant-int expression.
        def lru_arm_int_value(arm: Ast::MatchArm) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                (false, 0) return if arm.body.count != 1
                match arm.body[0]:
                    Stmt.Expr(expression, expr_line):
                        return signed_int_literal(expression)
                    _:
                        return (false, 0)

        # A match-arm pattern that CONSTRAINS its scrutinee to a specific value/shape (a literal,
        # variant, struct, or pin) — as opposed to a wildcard `_` or a fresh binding, which leave
        # the scrutinee unconstrained. Used to establish a fact on the scrutinee for that arm only
        # (stage0 does NOT leak a sibling arm's fact — a wildcard arm keeps the scrutinee free).
        def lru_pattern_constrains(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard:
                        return false
                    Pattern.Binding(binding_name):
                        return false
                    _:
                        return true

        # Every match arm yields a constant within [lo, hi] — the only shape the non-SMT prover
        # can discharge for a match-valued range refinement.
        def lru_match_all_in_range(arms: darray[Ast::MatchArm], lo: i64, hi: i64) -> bool:
            can Memory.Allocate, Abort.Panic:
                for arm in arms:
                    arm_value: (found: bool, value: i64) = lru_arm_int_value(arm)
                    false return if not arm_value.found or arm_value.value < lo or arm_value.value > hi
                return true

        def local_refinement_unproven_statements(statements: darray[Ast::Stmt], parameters: darray[sview]&, parameter_types: darray[Ast::Expr]&, established: darray[sview]&, has_quantified: bool, poisoned: mutable darray[sview]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                where_refined_names: mutable darray[sview] = []
                for statement in statements |poisoned, where_refined_names, table| -> table:
                    match statement:
                        # A REASSIGNMENT after a fact-bearing event (an is-guard, a
                        # post-state ensures call) invalidates the source: a following
                        # refinement declaration from it is unproven.
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                            assigned: sview = ident_name_of(assign_target)
                            # Only a REBIND (`<-`) invalidates; `x = ...` is a declaration.
                            is_rebind: bool = assign_operator == TokenKind.LArrow
                            # Reassigning a where-refined local with a CALL/FIELD rhs (e.g.
                            # `x <- some_unknown()`) cannot re-establish the refinement under
                            # the non-SMT prover — stage0 warns "where refinement on
                            # reassignment could not be proven". (Literal/ident rhs = a separate
                            # discharge case, left as a sound miss.)
                            reassigns_refined: bool = is_rebind and (any wr in where_refined_names where wr == assigned) and refinement_has_field_or_call(assign_value)
                            # IDENT rhs (`x <- n`): reassigning a where-refined local from an
                            # UNCONSTRAINED source param (unrefined type, no requires/guard fact)
                            # cannot re-establish the refinement — stage0 warns. Mirrors the VarDecl
                            # ident-source (ws_unproven) path; sound (any fact on the source stays
                            # silent, so never a false positive).
                            reassign_ident_unproven: mutable bool = false
                            rhs_source: sview = ident_name_of(assign_value)
                            if is_rebind and rhs_source != "" and (any wr2 in where_refined_names where wr2 == assigned):
                                rs_poisoned: bool = any rp in poisoned where rp == rhs_source
                                rs_slot: mutable i64 = -1
                                rs_probe: mutable usize = 0
                                while rs_probe < parameters.count |rs_slot, rs_probe, rhs_source, parameters|:
                                    rs_slot <- rs_probe.i64() if parameters[rs_probe] == rhs_source and rs_slot < 0
                                    rs_probe <- rs_probe + 1
                                rs_established: bool = any re in established where re == rhs_source
                                rs_refined: mutable bool = false
                                if rs_slot >= 0:
                                    rs_type: Ast::Expr = parameter_types[rs_slot.usize()]
                                    rs_refined <- local_refinement_law_name(rs_type) != ""
                                    match where_predicate_of_type(rs_type):
                                        Expr.Absent:
                                            pass
                                        _:
                                            rs_refined <- true
                                reassign_ident_unproven <- (rs_slot >= 0 or rs_poisoned) and not rs_established and not rs_refined
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "where refinement on reassignment", line: assign_line, expected: "", actual: ""}) if reassigns_refined or reassign_ident_unproven
                            poisoned.push(assigned) if is_rebind and assigned != "" and not (any p0 in poisoned where p0 == assigned)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Inline `x: T where PRED = SOURCE` (parses through
                            # where_predicate_of_type, NOT a bare Expr.Refinement). stage0 warns
                            # `precondition of "local where refinement" could not be proven`
                            # when SOURCE — an unrefined bare parameter with no requires/guard
                            # fact — does not establish PRED. Conservative like the is-Law case:
                            # any fact keeps it silent (misses, never a false positive).
                            where_predicate: Ast::Expr = where_predicate_of_type(type_expression)
                            where_present: bool = match where_predicate:
                                Expr.Absent: false
                                _: true
                            # Only a predicate that genuinely CONSTRAINS the bound local (mentions
                            # `name`) is an obligation. `where true` or `where n > 0` (a predicate
                            # over the source, not the local) is not a constraint on the value —
                            # stage0 accepts those, so they must not fire.
                            where_mentions: mutable darray[sview] = []
                            refinement_mentions(where_predicate, where_mentions) if where_present
                            where_constrains_local: bool = any wm in where_mentions where wm == name
                            where_refined_names.push(name) if where_present and where_constrains_local and not (any wrn in where_refined_names where wrn == name)
                            # A constraining predicate that references an external field/call
                            # (e.g. `i < xs.count`) can never be discharged from the local's
                            # initializer — stage0 warns regardless of the source. Fire directly.
                            if where_present and where_constrains_local and refinement_has_field_or_call(where_predicate):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "local where refinement", line: line, expected: "", actual: ""})
                                continue
                            # A COMPUTED initializer (an arithmetic expression, call, or field
                            # access — `x: i64 where x > 0 = n + 1`) is not a constant and cannot
                            # establish the constraint under the non-SMT prover.
                            value_computed: bool = match value:
                                Expr.Binary(vc_left, vc_op, vc_right, vc_line): true
                                Expr.Unary(vc_uop, vc_operand, vc_uline): true
                                Expr.Call(vc_callee, vc_args, vc_names, vc_cline): true
                                Expr.Field(vc_obj, vc_field, vc_fline): true
                                _: false
                            if where_present and where_constrains_local and value_computed:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "local where refinement", line: line, expected: "", actual: ""})
                                continue
                            # A REFINE-ALIAS type (`refine Positive = i64 where self > 0`; used as
                            # `x: Positive = n + 1`) carries a where refinement; a computed
                            # initializer cannot establish it either.
                            type_name_here: sview = ident_name_of(type_expression)
                            is_refine_alias: bool = type_name_here != "" and (any an in alias_names where an == type_name_here)
                            if is_refine_alias and value_computed:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "local where refinement", line: line, expected: "", actual: ""})
                                continue
                            if where_present and where_constrains_local:
                                where_source: sview = ident_name_of(value)
                                if where_source != "":
                                    ws_poisoned: bool = any wp in poisoned where wp == where_source
                                    ws_slot: mutable i64 = -1
                                    ws_probe: mutable usize = 0
                                    while ws_probe < parameters.count |ws_slot, ws_probe, where_source, parameters|:
                                        ws_slot <- ws_probe.i64() if parameters[ws_probe] == where_source and ws_slot < 0
                                        ws_probe <- ws_probe + 1
                                    ws_established: bool = any we in established where we == where_source
                                    ws_refined: mutable bool = false
                                    if ws_slot >= 0:
                                        ws_type: Ast::Expr = parameter_types[ws_slot.usize()]
                                        ws_refined <- local_refinement_law_name(ws_type) != ""
                                        ws_where: Ast::Expr = where_predicate_of_type(ws_type)
                                        match ws_where:
                                            Expr.Absent:
                                                pass
                                            _:
                                                ws_refined <- true
                                    ws_unproven: bool = (ws_slot >= 0 or ws_poisoned) and not ws_established and not ws_refined
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "local where refinement", line: line, expected: "", actual: ""}) if ws_unproven
                                continue
                            continue if law_names.count == 0
                            law_name: sview = local_refinement_law_name(type_expression)
                            continue if law_name == ""
                            # A MATCH-valued initializer for a RANGE-shaped law is provable only when
                            # EVERY arm yields a constant within [lo, hi]; any out-of-range or non-
                            # constant arm leaves the refinement unproven (stage0 const-evaluates the
                            # arms under the non-SMT prover). Non-range laws are left to the prover.
                            match value:
                                Expr.Match(match_scrutinee, match_arms, match_line):
                                    match_bounds: (found: bool, lo: i64, hi: i64) = return_refinement_bounds(type_expression, law_names, law_predicates)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRefinementUnproven, name: law_name, line: line, expected: "", actual: name}) if match_bounds.found and not lru_match_all_in_range(match_arms, match_bounds.lo, match_bounds.hi)
                                    continue
                                _:
                                    pass
                            source: sview = ident_name_of(value)
                            # Only a bare identifier initializer is decided here.
                            continue if source == ""
                            # A refinement whose BOUND args reference a POISONED (reassigned)
                            # variable is unproven: an established fact over the OLD bound no
                            # longer holds (`i is Bounded[0, n]` after `n <- other`).
                            law_arg_refs: mutable darray[sview] = []
                            refinement_mentions(type_expression, law_arg_refs)
                            bound_poisoned: bool = any lar in law_arg_refs where (any p2 in poisoned where p2 == lar)
                            if bound_poisoned:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRefinementUnproven, name: law_name, line: line, expected: "", actual: name})
                                continue
                            # A POISONED source (reassigned after its facts) is unproven
                            # whatever its origin.
                            source_poisoned: bool = any p1 in poisoned where p1 == source
                            if source_poisoned:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRefinementUnproven, name: law_name, line: line, expected: "", actual: name})
                                continue
                            source_slot: mutable i64 = -1
                            probe: mutable usize = 0
                            while probe < parameters.count |source_slot, probe, source, parameters|:
                                source_slot <- probe.i64() if parameters[probe] == source and source_slot < 0
                                probe <- probe + 1
                            continue if source_slot < 0
                            # Is this an ELEMENT law (quantifies over the value's elements)? If so, a
                            # fact that merely mentions the source (`requires xs.count == 3`) does NOT
                            # establish it — only a quantified fact over the same source does.
                            law_is_element: mutable bool = false
                            elem_probe: mutable usize = 0
                            while elem_probe < law_names.count |law_is_element, elem_probe, law_name, law_names, law_predicates|:
                                law_is_element <- lru_predicate_is_quantified(law_predicates[elem_probe]) if law_names[elem_probe] == law_name
                                elem_probe <- elem_probe + 1
                            # A fact mentioning the source (requires or enclosing guard). For an element
                            # law, a non-quantified mention (`requires xs.count == 3`) does NOT establish
                            # it — but the parser drops a quantifier's source, so if ANY quantified
                            # requires/guard is in scope we conservatively keep the source established.
                            source_established: mutable bool = any e in established where e == source
                            source_established <- false if law_is_element and not has_quantified
                            continue if source_established
                            # The source's own type already carries this law.
                            source_type: Ast::Expr = parameter_types[source_slot.usize()]
                            continue if local_refinement_law_name(source_type) == law_name
                            # Type-derived: a `self.count == N` law on an `array[T, N]`.
                            extent: i64 = refinement_array_extent(source_type)
                            derived: mutable bool = false
                            law_probe: mutable usize = 0
                            while law_probe < law_names.count |derived, law_probe, law_name, extent, law_names, law_predicates|:
                                derived <- refinement_count_law_holds(law_predicates[law_probe], extent) if law_names[law_probe] == law_name
                                law_probe <- law_probe + 1
                            continue if derived
                            # A top-level implication, or a law whose predicate this check
                            # cannot classify, is not reported.
                            skip_law: mutable bool = false
                            shape_probe: mutable usize = 0
                            while shape_probe < law_names.count |skip_law, shape_probe, law_name, law_names, law_predicates|:
                                if law_names[shape_probe] == law_name:
                                    skip_law <- law_is_top_level_implication(law_predicates[shape_probe]) or law_predicate_is_opaque(law_predicates[shape_probe])
                                shape_probe <- shape_probe + 1
                            continue if skip_law
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRefinementUnproven, name: law_name, line: line, expected: "", actual: name})
                        Stmt.If(condition, then_body, else_body, if_line):
                            # An enclosing GUARD establishes facts about what it mentions
                            # (family 2/4), for the guarded arm only.
                            guarded: mutable darray[sview] = []
                            for carried in established |guarded|:
                                guarded.push(carried)
                            refinement_mentions(condition, guarded)
                            # A quantified guard (`if forall i ...:`) also establishes an element law.
                            guard_has_quantified: bool = has_quantified or lru_predicate_is_quantified(condition)
                            then_poisoned: mutable darray[sview] = [p2 for p2 in poisoned]
                            else_poisoned: mutable darray[sview] = [p3 for p3 in poisoned]
                            table <- local_refinement_unproven_statements(then_body, parameters, parameter_types, guarded, guard_has_quantified, then_poisoned, law_names, law_predicates, alias_names, table)
                            table <- local_refinement_unproven_statements(else_body, parameters, parameter_types, established, has_quantified, else_poisoned, law_names, law_predicates, alias_names, table)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- local_refinement_unproven_statements(while_body, parameters, parameter_types, established, has_quantified, poisoned, law_names, law_predicates, alias_names, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- local_refinement_unproven_statements(block_body, parameters, parameter_types, established, has_quantified, poisoned, law_names, law_predicates, alias_names, table)
                        Stmt.Match(match_scrutinee, match_arms, match_line):
                            # Each arm is checked with the scrutinee ESTABLISHED only when the arm
                            # pattern constrains it (a literal/variant arm carries that fact); a
                            # wildcard/binding arm leaves it free, so a refinement bound to it there
                            # is unproven — matching stage0's no-fact-leak between sibling arms.
                            scrutinee_name: sview = ident_name_of(match_scrutinee)
                            for arm in match_arms |table| -> table:
                                arm_established: mutable darray[sview] = [carried for carried in established]
                                arm_established.push(scrutinee_name) if scrutinee_name != "" and lru_pattern_constrains(arm.pattern)
                                arm_poisoned: mutable darray[sview] = [pp for pp in poisoned]
                                table <- local_refinement_unproven_statements(arm.body, parameters, parameter_types, arm_established, has_quantified, arm_poisoned, law_names, law_predicates, alias_names, table)
                        _:
                            pass


        # A `-> T where result > 0` return refinement whose single straight-line return value is a
        # bare SIGNED-int param that is unconstrained (unrefined type, no requires) cannot establish
        # the predicate — stage0 warns "return where refinement could not be proven". Sound: skips
        # literals (may satisfy), unsigned params (carry >= 0), refined/established params, and any
        # branchy body (a guard may discharge it) — never a false positive.
        def lru_check_return_where(return_type: Ast::Expr, body: darray[Ast::Stmt], parameter_names: darray[sview]&, parameter_types: darray[Ast::Expr]&, established: darray[sview]&, alias_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                where_predicate: Ast::Expr = where_predicate_of_type(return_type)
                where_present: bool = match where_predicate:
                    Expr.Absent: false
                    _: true
                return if not where_present
                # A degenerate `-> T where true` return: stage0's non-SMT prover cannot discharge a
                # bare boolean-literal goal, so it reports the where precondition as unproven. (`where
                # false` is a REFUTED case with a different diagnostic and is intentionally left alone.)
                bool_where: (is_bool: bool, value: bool) = match where_predicate:
                    Expr.BoolLit(bool_value): (true, bool_value)
                    _: (false, false)
                if bool_where.is_bool:
                    # `return <param>` whose own type carries a `where` entails the return `where`
                    # (stage0's direct-entailment discharge), so only a non-parameter return value
                    # (a literal / computed expression) leaves `-> T where true` unproven.
                    bw_return_is_bare_param: mutable bool = false
                    for statement in body |bw_return_is_bare_param, parameter_names|:
                        match statement:
                            Stmt.Return(bw_value, bw_line):
                                if bw_value is bw_returned:
                                    bw_name: sview = ident_name_of(bw_returned)
                                    bw_return_is_bare_param <- (any pn in parameter_names where pn == bw_name) if bw_name != ""
                            _:
                                pass
                    if bool_where.value and not bw_return_is_bare_param:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "return where refinement", line: expr_line(return_type), expected: "", actual: ""})
                    return
                mentions: mutable darray[sview] = []
                refinement_mentions(where_predicate, mentions)
                return if not (any m in mentions where m == "result")
                return_count: mutable usize = 0
                branchy: mutable bool = false
                return_name: mutable sview = sview("", 0, 0)
                for statement in body |return_count, branchy, return_name|:
                    match statement:
                        Stmt.Return(value, return_line):
                            return_count <- return_count + 1
                            return_name <- ident_name_of(returned) if value is returned
                        # An `assert` may establish the return param's range (`assert x>=1 and x<=8`);
                        # refinement_requires_facts does not gather asserts, so treat any assert as
                        # branchy (skip) to stay sound.
                        Stmt.Contract(contract_kind, contract_expr, contract_c_line):
                            branchy <- true if contract_kind == "assert"
                        Stmt.If(condition, then_body, else_body, if_line):
                            branchy <- true
                        Stmt.While(while_condition, while_body, while_line):
                            branchy <- true
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            branchy <- true
                        Stmt.Match(scrutinee, arms, match_line):
                            branchy <- true
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            branchy <- true
                        _:
                            pass
                return if return_count != 1 or branchy or return_name == ""
                slot: mutable i64 = -1
                probe: mutable usize = 0
                while probe < parameter_names.count |slot, probe, return_name, parameter_names|:
                    slot <- probe.i64() if parameter_names[probe] == return_name and slot < 0
                    probe <- probe + 1
                return if slot < 0
                param_type: Ast::Expr = parameter_types[slot.usize()]
                signed_primitive: bool = si_is_signed_int_name(bare_type_name(param_type))
                param_refined: bool = local_refinement_law_name(param_type) != "" or (any an in alias_names where an == ident_name_of(param_type))
                param_where: bool = match where_predicate_of_type(param_type):
                    Expr.Absent: false
                    _: true
                param_established: bool = any e in established where e == return_name
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "return where refinement", line: expr_line(where_predicate), expected: "", actual: ""}) if signed_primitive and not param_refined and not param_where and not param_established

        # A COMPUTED value expression (arithmetic, call, field) — not a constant literal or a bare
        # identifier — which the non-SMT prover cannot bound to establish a refinement.
        def lru_expr_is_computed(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Binary(cb_left, cb_op, cb_right, cb_line):
                        return true
                    Expr.Unary(cu_op, cu_operand, cu_line):
                        return true
                    Expr.Call(cc_callee, cc_args, cc_names, cc_line):
                        return true
                    Expr.Field(cf_obj, cf_field, cf_line):
                        return true
                    _:
                        return false

        # A `-> RefineAlias` return (`refine Positive = i64 where self > 0`) whose single straight-line
        # return value is a COMPUTED expression over an UNCONSTRAINED parameter cannot establish the
        # alias predicate under the non-SMT prover — stage0 warns "precondition of return where
        # refinement could not be proven". Sound: a branchy body, a literal/refined/established
        # operand, or a fully-constrained value all decline, so it never fires on a provable return.
        def lru_check_refine_alias_return(return_type: Ast::Expr, body: darray[Ast::Stmt], parameter_names: darray[sview]&, parameter_types: darray[Ast::Expr]&, established: darray[sview]&, alias_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                type_name: sview = ident_name_of(return_type)
                return if type_name == "" or not (any an in alias_names where an == type_name)
                return_count: mutable usize = 0
                branchy: mutable bool = false
                value_expr: mutable Ast::Expr = (Ast::Expr.Absent)
                for statement in body |return_count, branchy, value_expr|:
                    match statement:
                        Stmt.Return(value, return_line):
                            return_count <- return_count + 1
                            value_expr <- returned if value is returned
                        Stmt.Contract(contract_kind, contract_expr, contract_c_line):
                            branchy <- true if contract_kind == "assert"
                        Stmt.If(condition, then_body, else_body, if_line):
                            branchy <- true
                        Stmt.While(while_condition, while_body, while_line):
                            branchy <- true
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            branchy <- true
                        Stmt.Match(scrutinee, arms, match_line):
                            branchy <- true
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            branchy <- true
                        _:
                            pass
                return if return_count != 1 or branchy
                return if not lru_expr_is_computed(value_expr)
                mentions: mutable darray[sview] = []
                refinement_mentions(value_expr, mentions)
                has_unconstrained: mutable bool = false
                for mentioned in mentions |has_unconstrained, parameter_names, parameter_types, established, alias_names|:
                    slot: mutable i64 = -1
                    probe: mutable usize = 0
                    while probe < parameter_names.count |slot, probe, mentioned, parameter_names|:
                        slot <- probe.i64() if parameter_names[probe] == mentioned and slot < 0
                        probe <- probe + 1
                    if slot >= 0:
                        param_type: Ast::Expr = parameter_types[slot.usize()]
                        param_refined: bool = local_refinement_law_name(param_type) != "" or (any an in alias_names where an == ident_name_of(param_type))
                        param_where: bool = match where_predicate_of_type(param_type):
                            Expr.Absent: false
                            _: true
                        param_established: bool = any e in established where e == mentioned
                        has_unconstrained <- true if not param_refined and not param_where and not param_established
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "return where refinement", line: expr_line(return_type), expected: "", actual: ""}) if has_unconstrained

        def check_local_refinement_unproven_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            parameter_names: mutable darray[sview] = []
                            parameter_types: mutable darray[Ast::Expr] = []
                            for parameter in parameters |parameter_names, parameter_types|:
                                parameter_names.push(parameter.name)
                                parameter_types.push(parameter.type_expression)
                            established: mutable darray[sview] = []
                            refinement_requires_facts(body, established)
                            has_quantified: bool = refinement_has_quantified_requires(body)
                            poisoned: mutable darray[sview] = []
                            table <- local_refinement_unproven_statements(body, parameter_names, parameter_types, established, has_quantified, poisoned, law_names, law_predicates, alias_names, table)
                            if return_type is present_return_type:
                                table <- lru_check_return_where(present_return_type, body, parameter_names, parameter_types, established, alias_names, table)
                                table <- lru_check_refine_alias_return(present_return_type, body, parameter_names, parameter_types, established, alias_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_local_refinement_unproven_walk(module_body, law_names, law_predicates, alias_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_local_refinement_unproven_walk(scoped_body, law_names, law_predicates, alias_names, table)
                        _:
                            pass

    public:
        def check_local_refinement_unproven(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, law_names, law_predicates)
                alias_names: mutable darray[sview] = []
                alias_predicates: mutable darray[Ast::Expr] = []
                collect_refine_aliases(declarations, alias_names, alias_predicates)
                # The is-Law path needs declared laws, but the inline-`where` path does not —
                # so the walk always runs; the is-Law VarDecl arm self-guards on law presence.
                table <- check_local_refinement_unproven_walk(declarations, law_names, law_predicates, alias_names, table)
