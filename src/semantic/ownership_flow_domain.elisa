# Boolean components of the ownership flow lattice. A join conservatively unions
# possible live/consumed paths; knownness requires knowledge on both incoming paths.
# The caller must join only the same BindingId and exclude unreachable predecessors.
module OwnershipFlow:
    def join_possible(left: bool, right: bool) -> bool:
        ensure result == (left or right)
        return left or right

    def join_known(left: bool, right: bool) -> bool:
        ensure result == (left and right)
        return left and right

    def can_move(known: bool, may_live: bool, may_consumed: bool) -> bool:
        ensure result == (known and may_live and not may_consumed)
        return known and may_live and not may_consumed

    # These joins apply only to facts about the same BindingId. No reachable
    # predecessor means unknown, not vacuous permission to consume an owner.
    def join_reachable_possible(left_reachable: bool, left: bool, right_reachable: bool, right: bool) -> bool:
        ensure result == ((left_reachable and left) or (right_reachable and right))
        return (left_reachable and left) or (right_reachable and right)

    def join_reachable_known(left_reachable: bool, left: bool, right_reachable: bool, right: bool) -> bool:
        ensure result == ((left_reachable or right_reachable) and (not left_reachable or left) and (not right_reachable or right))
        return (left_reachable or right_reachable) and (not left_reachable or left) and (not right_reachable or right)
