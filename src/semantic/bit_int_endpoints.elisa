# Arithmetic used after bit-int width parsing computes a power-of-two span.
# Callers must check the shift result against the corresponding span window
# before using these functions; the preconditions make the endpoint arithmetic
# representable in signed i64.
module SemanticBitIntEndpoints:
    public:
        const I64_MAX: i64 = 9223372036854775807
        const SIGNED_SPAN_MAX: i64 = 4611686018427387904
        const SIGNED_LOW_MIN: i64 = 0 - SIGNED_SPAN_MAX

        def unsigned_high_from_span(span: i64) -> i64:
            requires span >= 1 and span <= I64_MAX
            ensure result == span - 1
            ensure result >= 0
            ensure result <= I64_MAX
            return span - 1

        def signed_low_from_span(span: i64) -> i64:
            requires span >= 1 and span <= SIGNED_SPAN_MAX
            ensure result == 0 - span
            ensure result >= SIGNED_LOW_MIN
            ensure result < 0
            return 0 - span

        def signed_high_from_span(span: i64) -> i64:
            requires span >= 1 and span <= SIGNED_SPAN_MAX
            ensure result == span - 1
            ensure result >= 0
            ensure result <= I64_MAX
            return span - 1
