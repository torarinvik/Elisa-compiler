# Check for modulo by zero: x % 0 with a constant zero divisor.

extend Semantic:
    private:
        const MODULO_ZERO_LITERAL: i64 = 0

        # Walk through all expressions, checking for Binary operations with a zero divisor.
        def walk_expression_for_modulo_by_zero(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        # Check for modulo by zero: only flag Percent with IntLit(0).
                        # Each `is`-binding is used only inside a nested body — stage1's
                        # resolver does not carry an `is`-binding into the rest of the SAME
                        # boolean condition, so `right is IntLit(v) and v == 0` would leave
                        # `v` unresolved. Nest instead.
                        if operator == TokenKind.Percent:
                            match right:
                                Expr.IntLit(divisor, _):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ModuloByZero, name: "", line: line.line, expected: "", actual: ""}) if divisor == MODULO_ZERO_LITERAL
                                _:
                                    pass
                        # Recursively walk left and right operands
                        table <- walk_expression_for_modulo_by_zero(left, table)
                        table <- walk_expression_for_modulo_by_zero(right, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_modulo_by_zero(callee, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(argument, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- walk_expression_for_modulo_by_zero(child, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_modulo_by_zero(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_modulo_by_zero(base, table)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_modulo_by_zero(object, table)
                        table <- walk_expression_for_modulo_by_zero(index, table) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_modulo_by_zero(operand, table)
                    Expr.Move(operand, line):
                        table <- walk_expression_for_modulo_by_zero(operand, table)
                    Expr.RegionNew(operand, region, line):
                        table <- walk_expression_for_modulo_by_zero(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_modulo_by_zero(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(element, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_modulo_by_zero(object, table)
                        table <- walk_expression_for_modulo_by_zero(low, table)
                        table <- walk_expression_for_modulo_by_zero(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_modulo_by_zero(object, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(argument, table) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(entry.key, table)
                            table <- walk_expression_for_modulo_by_zero(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_modulo_by_zero(type_expression, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_modulo_by_zero(base, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_modulo_by_zero(condition, table)
                        table <- walk_expression_for_modulo_by_zero(then_expr, table)
                        table <- walk_expression_for_modulo_by_zero(else_expr, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_modulo_by_zero(iterable, table)
                        table <- walk_expression_for_modulo_by_zero(condition, table)
                        table <- walk_expression_for_modulo_by_zero(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_modulo_by_zero(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_modulo_by_zero(statements, table)
                        table <- walk_expression_for_modulo_by_zero(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_modulo_by_zero(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(arm.guard, table)
                            table <- walk_statements_for_modulo_by_zero(arm.body, table)
                    Expr.Catch(guarded, arms, line):
                        table <- walk_expression_for_modulo_by_zero(guarded, table)
                        for arm in arms |table| -> table:
                            table <- walk_expression_for_modulo_by_zero(arm.guard, table)
                            table <- walk_statements_for_modulo_by_zero(arm.body, table)
                    Expr.Refinement(base, predicate, line):
                        table <- walk_expression_for_modulo_by_zero(base, table)
                        table <- walk_expression_for_modulo_by_zero(predicate, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- walk_expression_for_modulo_by_zero(guarded, table)
                        table <- walk_statements_for_modulo_by_zero(recovery, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for modulo by zero in expressions.
        def walk_statements_for_modulo_by_zero(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_modulo_by_zero(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_expression_for_modulo_by_zero(type_expression, table)
                            table <- walk_expression_for_modulo_by_zero(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_modulo_by_zero(target, table)
                            table <- walk_expression_for_modulo_by_zero(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_modulo_by_zero(condition, table)
                            table <- walk_statements_for_modulo_by_zero(then_body, table)
                            table <- walk_statements_for_modulo_by_zero(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_modulo_by_zero(condition, table)
                            table <- walk_statements_for_modulo_by_zero(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_modulo_by_zero(iterable, table)
                            table <- walk_statements_for_modulo_by_zero(body, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_modulo_by_zero(return_value, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_modulo_by_zero(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_modulo_by_zero(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_expression_for_modulo_by_zero(arm.guard, table)
                                table <- walk_statements_for_modulo_by_zero(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_modulo_by_zero(expression, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk every declaration expression, including signatures, initializers, laws, and fields.
        def check_modulo_by_zero(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for parameter in params |table|:
                                table <- walk_expression_for_modulo_by_zero(parameter.type_expression, table)
                                table <- walk_expression_for_modulo_by_zero(parameter.default_value, table)
                            table <- walk_expression_for_modulo_by_zero(return_type, table) if return_type is return_type
                            table <- walk_statements_for_modulo_by_zero(body, table)
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |table|:
                                table <- walk_expression_for_modulo_by_zero(member.type_expression, table)
                                table <- walk_expression_for_modulo_by_zero(member.default_value, table)
                                for bit_member in member.bit_group_members |table| -> table:
                                    table <- walk_expression_for_modulo_by_zero(bit_member.type_expression, table)
                            for invariant in invariants |table| -> table:
                                table <- walk_expression_for_modulo_by_zero(invariant, table)
                        Decl.Enum(name, variants, is_const, storage_type, line):
                            table <- walk_expression_for_modulo_by_zero(storage_type, table)
                            for variant in variants |table|:
                                for field_type in variant.fields |table| -> table:
                                    table <- walk_expression_for_modulo_by_zero(field_type, table)
                                table <- walk_expression_for_modulo_by_zero(variant.value_expr, table)
                        Decl.Alias(name, target, line):
                            table <- walk_expression_for_modulo_by_zero(target, table)
                        Decl.Law(name, predicate, line):
                            table <- walk_expression_for_modulo_by_zero(predicate, table)
                        Decl.Const(name, type_expression, value, is_mutable, line):
                            table <- walk_expression_for_modulo_by_zero(type_expression, table)
                            table <- walk_expression_for_modulo_by_zero(value, table)
                        Decl.Module(module_name, body, line):
                            table <- check_modulo_by_zero(body, table)
                        Decl.Scoped(body, line):
                            table <- check_modulo_by_zero(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
