extend Semantic:
    private:
        def shape_name_is_implicit(name: sview) -> bool:
            can Abort.Panic:
                return sview_len(name) >= 6 and name[0:6] == "shape_"

        def check_darray_shape_pair(expected_arguments: darray[Ast::Expr]&, actual_type: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if expected_arguments.count < 2
                expected_element: sview = ident_name_of(expected_arguments[0])
                expected_shape: sview = ident_name_of(expected_arguments[1])
                return if expected_element == "" or expected_shape == "" or shape_name_is_implicit(expected_shape)
                actual_element: mutable sview = ""
                actual_shape: mutable sview = ""
                match actual_type:
                    Expr.Index(object, argument, index_line):
                        actual_element <- ident_name_of(argument) if ident_name_of(object) == "darray"
                    Expr.IndexN(object, arguments, index_line):
                        if ident_name_of(object) == "darray" and arguments.count > 0:
                            actual_element <- ident_name_of(arguments[0])
                            actual_shape <- ident_name_of(arguments[1]) if arguments.count > 1
                    _:
                        pass
                mismatch: bool = actual_element == expected_element and actual_shape != expected_shape
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContainerShapeReturn, name: "darray", line: line, expected: expected_element, actual: expected_shape, detail: actual_shape}) if mismatch

        def check_string_shape_pair(expected_head: sview, expected_shape: Ast::Expr, actual_type: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                shape_name: sview = ident_name_of(expected_shape)
                return if shape_name == "" or shape_name_is_implicit(shape_name)
                actual_head: mutable sview = ident_name_of(actual_type)
                actual_shape: mutable sview = ""
                match actual_type:
                    Expr.Index(object, argument, index_line):
                        actual_head <- ident_name_of(object)
                        actual_shape <- ident_name_of(argument)
                    _:
                        pass
                mismatch: bool = actual_head == expected_head and actual_shape != shape_name
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContainerShapeReturn, name: expected_head, line: line, expected: "", actual: shape_name, detail: actual_shape}) if mismatch

        def check_container_shape_pair(return_type: Ast::Expr, actual_type: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match return_type:
                    Expr.IndexN(object, arguments, index_line):
                        table <- check_darray_shape_pair(arguments, actual_type, line, table) if ident_name_of(object) == "darray"
                    Expr.Index(object, argument, index_line):
                        expected_head: sview = ident_name_of(object)
                        table <- check_string_shape_pair(expected_head, argument, actual_type, line, table) if expected_head == "cstr" or expected_head == "dstr"
                    _:
                        pass

        def check_container_shape_return_value(value: Ast::Expr, return_type: Ast::Expr, parameter_name: sview, parameter_type: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                value_name: sview = ident_name_of(value)
                table <- check_container_shape_pair(return_type, parameter_type, line, table) if value_name == parameter_name

        def check_container_shape_return_statements(statements: darray[Ast::Stmt], return_type: Ast::Expr, parameter_name: sview, parameter_type: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Return(value, line):
                            table <- check_container_shape_return_value(return_value, return_type, parameter_name, parameter_type, line.line, table) if value is return_value
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_container_shape_return_statements(then_body, return_type, parameter_name, parameter_type, table)
                            table <- check_container_shape_return_statements(else_body, return_type, parameter_name, parameter_type, table)
                        Stmt.While(condition, body, line):
                            table <- check_container_shape_return_statements(body, return_type, parameter_name, parameter_type, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_container_shape_return_statements(body, return_type, parameter_name, parameter_type, table)
                        _:
                            pass

        def check_container_shape_return_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if return_type is return_expression:
                                for parameter in parameters |table|:
                                    table <- check_container_shape_return_statements(body, return_expression, parameter.name, parameter.type_expression, table)
                        Decl.Module(name, body, line):
                            table <- check_container_shape_return_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_container_shape_return_declarations(body, table)
                        _:
                            pass

    public:
        def check_container_shape_return(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_container_shape_return_declarations(declarations, table)
