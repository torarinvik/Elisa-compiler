# Compare overload parameter shapes while resolving region binders at their
# exact source positions. Other identifiers retain their ordinary identity.
extend Semantic:
    private:
        def overload_type_same_without_regions(a: Ast::Expr, b: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match a:
                    Expr.Ident(a_name, a_pos):
                        match b:
                            Expr.Ident(b_name, b_pos):
                                return true if a_name == b_name
                                a_region: RegionId = type_region_binding_id_at(a_name, a_pos.line, a_pos.offset, table)
                                b_region: RegionId = type_region_binding_id_at(b_name, b_pos.line, b_pos.offset, table)
                                return a_region.value != 0 and b_region.value != 0
                            _:
                                return false
                    Expr.Index(a_head, a_arg, _):
                        match b:
                            Expr.Index(b_head, b_arg, _):
                                return overload_type_same_without_regions(a_head, b_head, table) and overload_type_same_without_regions(a_arg, b_arg, table)
                            _:
                                return false
                    Expr.IndexN(a_head, a_args, _):
                        match b:
                            Expr.IndexN(b_head, b_args, _):
                                return false if a_args.count != b_args.count or not overload_type_same_without_regions(a_head, b_head, table)
                                for index in 0..<a_args.count |a_args, b_args, table|:
                                    return false if not overload_type_same_without_regions(a_args[index], b_args[index], table)
                                return true
                            _:
                                return false
                    Expr.Unary(a_op, a_inner, _):
                        match b:
                            Expr.Unary(b_op, b_inner, _):
                                return a_op == b_op and overload_type_same_without_regions(a_inner, b_inner, table)
                            _:
                                return false
                    Expr.Paren(a_inner, _):
                        match b:
                            Expr.Paren(b_inner, _):
                                return overload_type_same_without_regions(a_inner, b_inner, table)
                            _:
                                return false
                    _:
                        return same_type_expression(a, b)

        def overload_region_only_conflict(a: Ast::Decl, b: Ast::Decl, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match a:
                    Decl.Func(a_name, a_params, a_return, _, _, _, _):
                        match b:
                            Decl.Func(b_name, b_params, b_return, _, _, _, _):
                                return false if a_params.count < 2 or a_params.count != b_params.count
                                return false if declaration_is_constructor(a_name, a_return) or declaration_is_constructor(b_name, b_return)
                                return false if not same_type_expression(a_params[0].type_expression, b_params[0].type_expression)
                                for index in 1..<a_params.count |a_params, b_params, table|:
                                    return false if not overload_type_same_without_regions(a_params[index].type_expression, b_params[index].type_expression, table)
                                return true
                            _:
                                return false
                    _:
                        return false
