# stage0 validates a struct's and an enum's decorators the way it validates a function's:
# the NAME against a per-declaration allowlist, then that name's own ARGUMENTS. stage1 had
# the function half only, so `@bogus` on a struct — and, worse, a typo like `@algin(8)` or a
# wrong `@align(3)` — compiled in silence and the request it spelled simply did nothing.
#
# Both halves read the `__struct_annotation` / `__enum_annotation` rows the parser leaves
# behind, which carry the decorator's spelling, its argument slice and its own source span.

include "./positive_power_of_two_text.elisa"
include "./type_annotation_argument.elisa"
include "./type_annotation_policy.elisa"

extend Semantic:
    private:
        # stage0 (EnumType.SourcePacked, hierarchy-root-store merge 4a68f508) asks whether
        # the SOURCE spelled `packed enum` on this very declaration. A plain enum promoted to
        # the region-backed store -- by-value recursion, `common(...)` fields, or membership
        # in such a hierarchy -- shares the store representation but is not a packed enum,
        # so it cannot carry a packed profile.
        def enum_is_packed(file: Ast::File&, owner: sview) -> bool:
            return any annotation in file.enum_annotations where annotation.owner == owner and annotation.name == "__declared_packed"

        # stage0 does not run `analyzeEnumAnnotations` over an extern enum at all: its
        # decorators describe the C side, so every name is allowed there and none of the
        # argument rules apply.
        def enum_is_foreign(annotations: darray[Ast::EnumAnnotation]&, owner: sview) -> bool:
            for annotation in annotations:
                if annotation.owner == owner:
                    match annotation.name:
                        "__extern_enum" | "__extern_enum_open" | "__extern_enum_no_storage":
                            return true
                        _:
                            pass
            return false

        def check_type_annotation_arguments(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    argument: sview = SemanticTypeAnnotationArgument::first_argument(file.annotation_args, annotation.arg_start, annotation.arg_count)
                    if annotation.name == "__struct_annotation" and annotation.detail_name == "align":
                        if annotation.arg_count != 1 or argument == "":
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AlignAnnotationArity, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner})
                        else:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AlignAnnotationValue, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner, detail: argument}) if not SemanticPositivePowerOfTwoText::accepts(argument)
                    if annotation.name == "__struct_annotation" and annotation.detail_name == "fixed_layout" and annotation.arg_count != 0:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FixedLayoutAnnotationArguments, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner})
                    if annotation.name == "__enum_annotation" and annotation.detail_name == "packed_profile" and not enum_is_foreign(file.enum_annotations, annotation.owner):
                        # stage0's order: the TARGET first (a plain enum cannot carry a profile
                        # at all), then the arity, then the profile name.
                        if not enum_is_packed(file, annotation.owner):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedProfileAnnotationNotPacked, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner})
                        elif annotation.arg_count != 1 or argument == "":
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedProfileAnnotationArity, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner})
                        else:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedProfileAnnotationMode, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner, detail: argument}) if argument != "canonical" and argument != "retained_reads" and argument != "build_heavy"

    public:
        def check_unknown_type_annotation(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    if annotation.name == "__struct_annotation" and not SemanticTypeAnnotationPolicy::supported_struct_annotation(annotation.detail_name) and not SemanticTypeAnnotationPolicy::removed_annotation_name(annotation.detail_name):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownStructAnnotation, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner})
                    if annotation.name == "__enum_annotation" and not SemanticTypeAnnotationPolicy::supported_enum_annotation(annotation.detail_name) and not SemanticTypeAnnotationPolicy::removed_annotation_name(annotation.detail_name) and not enum_is_foreign(file.enum_annotations, annotation.owner):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownEnumAnnotation, name: annotation.detail_name, line: annotation.line, pos: annotation.pos, expected: "", actual: annotation.owner})
                table <- check_type_annotation_arguments(file, table)
