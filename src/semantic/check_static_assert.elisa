# Compile-time static assert (stage0 static-evaluation). A line-form `static assert COND, "MSG"`
# whose condition provably evaluates to FALSE at compile time is rejected ("static assert failed:
# MSG"). SOUND subset: fires only when COND is a constant comparison (both operands fold to
# integer literals) that is false, or an and/or of such; anything non-constant is left to the
# full static evaluator (a sound miss).
extend Semantic:
    private:
        def static_assert_provably_false(condition: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, line):
                        return static_assert_provably_false(inner)
                    Expr.Binary(left, operator, right, line):
                        is_comparison: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
                        if is_comparison:
                            left_const: (found: bool, value: i64) = fold_const_int(left)
                            right_const: (found: bool, value: i64) = fold_const_int(right)
                            return left_const.found and right_const.found and not evaluate_comparison(left_const.value, operator, right_const.value)
                        # `A and B` is false if either side is provably false; `A or B` only if both.
                        (static_assert_provably_false(left) or static_assert_provably_false(right)) return if operator == TokenKind.And
                        (static_assert_provably_false(left) and static_assert_provably_false(right)) return if operator == TokenKind.Or
                        return false
                    _:
                        return false

        def check_static_assert(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                while index < file.static_assert_conds.count |table, index: usize = 0| -> table:
                    if static_assert_provably_false(file.static_assert_conds[index]):
                        message: sview = strip_quotes(file.static_assert_msgs[index])
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticAssertFailed, name: message, line: file.static_assert_lines[index], expected: "", actual: ""})
                    index <- index + 1
