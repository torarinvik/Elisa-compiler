# Compile-time static assert (stage0 static-evaluation). A line-form `static assert COND, "MSG"`
# whose condition provably evaluates to FALSE at compile time is rejected ("static assert failed:
# MSG"). SOUND subset: fires only when COND is a constant comparison (both operands fold to
# integer literals) that is false, or an and/or of such; anything non-constant is left to the
# full static evaluator (a sound miss).
include "./comparison_operator_policy.elisa"

extend Semantic:
    private:
        # Assertions in static-if declarations are captured before branch selection.
        # Retain every enclosing row and evaluate only when all are proven active.
        def static_assert_branch_activity(file: Ast::File&, index: usize, current_module: sview, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                return (false, true) if index >= file.static_assert_branch_rows_known.count
                return (false, true) if not file.static_assert_branch_rows_known[index]
                return (false, true) if index >= file.static_assert_branch_row_starts.count or index >= file.static_assert_branch_row_counts.count
                start: usize = file.static_assert_branch_row_starts[index]
                return (false, true) if start > file.static_assert_branch_row_ids.count
                available: usize = file.static_assert_branch_row_ids.count - start
                row_count: usize = file.static_assert_branch_row_counts[index] if file.static_assert_branch_row_counts[index] < available else available
                return (false, true) if row_count != file.static_assert_branch_row_counts[index]
                row_offset: mutable usize = 0.usize()
                while row_offset < row_count |row_offset, row_count, start, file, current_module, table|:
                    branch_row: u32 = file.static_assert_branch_row_ids[start + row_offset]
                    if branch_row.usize() < file.static_if_lines.count:
                        branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row.usize(), current_module, table)
                        return (true, false) if branch.known and not branch.selected
                        return (false, true) if not branch.known
                    else:
                        return (false, true)
                    row_offset <- row_offset + 1.usize()
                return (true, true)

        def static_assert_provably_false(condition: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, line):
                        return static_assert_provably_false(inner)
                    Expr.Binary(left, operator, right, line):
                        is_comparison: bool = ComparisonOperatorPolicy::is_comparison(operator)
                        if is_comparison:
                            left_const: (found: bool, value: i64) = fold_const_int(left)
                            right_const: (found: bool, value: i64) = fold_const_int(right)
                            return left_const.found and right_const.found and not evaluate_comparison(left_const.value, operator, right_const.value)
                        # `A and B` is false if either side is provably false; `A or B` only if both.
                        return (static_assert_provably_false(left) or static_assert_provably_false(right)) if operator == TokenKind.And
                        return (static_assert_provably_false(left) and static_assert_provably_false(right)) if operator == TokenKind.Or
                        return false
                    _:
                        return false

        def check_static_assert(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                while index < file.static_assert_conds.count |table, index: usize = 0| -> table:
                    condition: Ast::Expr = file.static_assert_conds[index]
                    current_module: sview = file.static_assert_modules[index] if index < file.static_assert_modules.count else ""
                    activity: (known: bool, active: bool) = static_assert_branch_activity(file, index, current_module, table)
                    if activity.known and activity.active:
                        if static_assert_provably_false(condition):
                            message: sview = strip_quotes(file.static_assert_msgs[index])
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticAssertFailed, name: message, line: file.static_assert_lines[index], expected: "", actual: ""})
                        # A `static assert` condition must be bool, just like a runtime `assert`. The
                        # `static` form is recorded here (its marker is dropped before the ordinary
                        # assert-nonbool walk), so reuse the same non-bool family classifier.
                        nonbool_family: sview = assert_nonbool_family(condition)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssertConditionNonBool, name: "", line: file.static_assert_lines[index], expected: "", actual: nonbool_family}) if nonbool_family != ""
                    index <- index + 1
