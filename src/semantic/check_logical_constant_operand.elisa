# Check for logical operators with constant boolean operands.
# Flags binary AND/OR operations where at least one operand is a literal boolean
# (e.g., `x and true`, `x and false`, etc.). This is redundant/constant logic.

extend Semantic:
    private:
        # Walk through all expressions, checking for logical operators with constant operands.
        def walk_expression_for_logical_constant_operand(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        # Check for logical operators (AND/OR) with at least one boolean literal operand
                        left_const: bool = match left:
                            Expr.BoolLit(left_bool): true
                            _: false
                        right_const: bool = match right:
                            Expr.BoolLit(right_bool): true
                            _: false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LogicalConstantOperand, name: "", line: line.line, expected: "", actual: ""}) if (operator == TokenKind.And or operator == TokenKind.Or) and (left_const or right_const)
                        # Recursively walk left and right operands
                        table <- walk_expression_for_logical_constant_operand(left, table)
                        table <- walk_expression_for_logical_constant_operand(right, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_logical_constant_operand(callee, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_logical_constant_operand(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_logical_constant_operand(base, table)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_logical_constant_operand(object, table)
                        table <- walk_expression_for_logical_constant_operand(index, table) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_logical_constant_operand(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_logical_constant_operand(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(element, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_logical_constant_operand(object, table)
                        table <- walk_expression_for_logical_constant_operand(low, table)
                        table <- walk_expression_for_logical_constant_operand(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_logical_constant_operand(object, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(argument, table) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(entry.key, table)
                            table <- walk_expression_for_logical_constant_operand(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_logical_constant_operand(type_expression, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_logical_constant_operand(base, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_logical_constant_operand(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_logical_constant_operand(condition, table)
                        table <- walk_expression_for_logical_constant_operand(then_expr, table)
                        table <- walk_expression_for_logical_constant_operand(else_expr, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_logical_constant_operand(iterable, table)
                        table <- walk_expression_for_logical_constant_operand(condition, table)
                        table <- walk_expression_for_logical_constant_operand(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_logical_constant_operand(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_logical_constant_operand(statements, table)
                        table <- walk_expression_for_logical_constant_operand(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_logical_constant_operand(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- walk_statements_for_logical_constant_operand(arm.body, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for logical constant operands in expressions.
        def walk_statements_for_logical_constant_operand(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_logical_constant_operand(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_expression_for_logical_constant_operand(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_logical_constant_operand(target, table)
                            table <- walk_expression_for_logical_constant_operand(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_logical_constant_operand(condition, table)
                            table <- walk_statements_for_logical_constant_operand(then_body, table)
                            table <- walk_statements_for_logical_constant_operand(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_logical_constant_operand(condition, table)
                            table <- walk_statements_for_logical_constant_operand(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_logical_constant_operand(iterable, table)
                            table <- walk_statements_for_logical_constant_operand(body, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_logical_constant_operand(return_value, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_logical_constant_operand(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_logical_constant_operand(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_statements_for_logical_constant_operand(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            # Contract clauses (`require`/`ensure`/`assert`) intentionally use
                            # tautologies such as `ensure result >= 0 or true` as proof fillers;
                            # do not lint constant logical operands there.
                            pass
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk through function declarations, checking expressions in their bodies.
        def check_logical_constant_operand(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_statements_for_logical_constant_operand(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_logical_constant_operand(body, table)
                        Decl.Scoped(body, line):
                            table <- check_logical_constant_operand(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
