# Handler-capture escape: a local view container FILLED by a call that also receives a
# local owner's storage, whose elements are then stored into parameter-owned storage.
#
#     buf: mutable darray[u8] = []
#     captures: mutable darray[Prm] = []
#     rebind ok: bool, parser = parser.fill(captures, buf)   # captures may view buf
#     for capture in captures |parser|:
#         parser.params <- parser.params.push(capture)        # dangles once the frame ends
#
# Mirrors stage0's recordCallFilledElementStates (region_local_container_elements.go): a
# direct call to a TRUSTED declared function that binds a tracked container to a writable
# parameter merges every other argument's provenance into the container's elements. A callee
# is untrusted (stage0 stops tracking, so nothing is reported) when it takes an Arena or
# region parameter, or when fillMayAdopt holds: its call graph (every function its body
# NAMES) reaches a void grower of a container parameter. Conservative everywhere else: the
# filled container and the owner must be unannotated locals, the element type must hold an
# sview, and anything unclear stays SILENT.
extend Semantic:
    private:
        # No unique function row: absent, or an ambiguous (overloaded) name.
        const HCE_NO_ROW: u32 = 4294967295
        # Not a declared function at all (distinct from an ambiguous name).
        const HCE_ABSENT: u32 = 4294967294

        # stage1's backend lowers dict operations only on locals and struct fields, never through
        # a `dict&` parameter, so each map travels inside a struct.
        struct HceMap:
            rows: mutable dict[u64, u32]

        def hce_mentions_exprs(expressions: darray[Ast::Expr], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for expression in expressions |out|:
                    hce_mentions_expr(expression, out)

        # Every identifier and member name an expression NAMES (stage0 links a function to any
        # mention, not only a callee: a function referenced as a value may be called later).
        def hce_mentions_expr(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        out.push(name)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        hce_mentions_expr(callee, out)
                        hce_mentions_exprs(arguments, out)
                    Expr.Field(object, field, field_pos):
                        out.push(field)
                        hce_mentions_expr(object, out)
                    Expr.Index(object, index, index_pos):
                        hce_mentions_expr(object, out)
                        hce_mentions_expr(index, out)
                    Expr.Slice(object, low, high, slice_pos):
                        hce_mentions_expr(object, out)
                        hce_mentions_expr(low, out)
                        hce_mentions_expr(high, out)
                    Expr.IndexN(object, arguments, index_pos):
                        hce_mentions_expr(object, out)
                        hce_mentions_exprs(arguments, out)
                    Expr.Binary(left, operator, right, binary_pos):
                        hce_mentions_expr(left, out)
                        hce_mentions_expr(right, out)
                    Expr.Unary(operator, operand, unary_pos):
                        hce_mentions_expr(operand, out)
                    Expr.Move(operand, move_pos):
                        hce_mentions_expr(operand, out)
                    Expr.RegionNew(operand, region, new_pos):
                        hce_mentions_expr(operand, out)
                    Expr.Paren(inner, paren_pos):
                        hce_mentions_expr(inner, out)
                    Expr.Array(elements, array_pos):
                        hce_mentions_exprs(elements, out)
                    Expr.Tuple(elements, tuple_pos):
                        hce_mentions_exprs(elements, out)
                    Expr.SetLit(elements, set_pos):
                        hce_mentions_exprs(elements, out)
                    Expr.Construct(type_expression, fields, construct_pos):
                        for field in fields |out|:
                            hce_mentions_expr(field.value, out)
                    Expr.RecordUpdate(base, fields, update_pos):
                        hce_mentions_expr(base, out)
                        for field in fields |out|:
                            hce_mentions_expr(field.value, out)
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        hce_mentions_expr(condition, out)
                        hce_mentions_expr(then_expr, out)
                        hce_mentions_expr(else_expr, out)
                    Expr.Match(scrutinee, arms, match_pos):
                        hce_mentions_expr(scrutinee, out)
                        for arm in arms |out|:
                            hce_mentions_expr(arm.guard, out)
                            hce_mentions_stmts(arm.body, out)
                    Expr.Catch(guarded, arms, catch_pos):
                        hce_mentions_expr(guarded, out)
                        for arm in arms |out|:
                            hce_mentions_stmts(arm.body, out)
                    Expr.Comprehension(comp_var, iterable, condition, body, comp_pos):
                        hce_mentions_expr(iterable, out)
                        hce_mentions_expr(condition, out)
                        hce_mentions_expr(body, out)
                    Expr.GetElse(guarded, recovery, get_pos):
                        hce_mentions_expr(guarded, out)
                        hce_mentions_stmts(recovery, out)
                    Expr.Lambda(lambda_params, lambda_body, lambda_pos):
                        hce_mentions_stmts(lambda_body, out)
                    Expr.Block(block_stmts, block_value, block_captures, block_pos):
                        hce_mentions_stmts(block_stmts, out)
                        hce_mentions_expr(block_value, out)
                    _:
                        pass

        def hce_mentions_stmts(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Expr(expression, expr_pos):
                            hce_mentions_expr(expression, out)
                        Stmt.VarDecl(name, type_expression, value, var_pos):
                            hce_mentions_expr(value, out)
                        Stmt.Assign(target, operator, value, assign_pos):
                            hce_mentions_expr(target, out)
                            hce_mentions_expr(value, out)
                        Stmt.If(condition, then_body, else_body, if_pos):
                            hce_mentions_expr(condition, out)
                            hce_mentions_stmts(then_body, out)
                            hce_mentions_stmts(else_body, out)
                        Stmt.While(condition, while_body, while_pos):
                            hce_mentions_expr(condition, out)
                            hce_mentions_stmts(while_body, out)
                        Stmt.For(bind, variables, iterable, for_body, for_pos):
                            hce_mentions_expr(iterable, out)
                            hce_mentions_stmts(for_body, out)
                        Stmt.Return(value, return_pos):
                            if value is returned:
                                hce_mentions_expr(returned, out)
                        Stmt.Block(kind, clause, binding, block_body, block_pos):
                            hce_mentions_stmts(block_body, out)
                        Stmt.Match(scrutinee, arms, match_pos):
                            hce_mentions_expr(scrutinee, out)
                            for arm in arms |out|:
                                hce_mentions_expr(arm.guard, out)
                                hce_mentions_stmts(arm.body, out)
                        _:
                            pass

        def hce_collect_functions(declarations: darray[Ast::Decl], fns: mutable darray[Ast::Decl]&, fn_index: mutable HceMap&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |fns, fn_index|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            key: u64 = name_hash(name)
                            # A name with several declarations (overloads) is ambiguous: untrusted.
                            prior: u32 = found if fn_index.rows.get(key) is found else HCE_ABSENT
                            fn_index.rows <- fn_index.rows.put(key, fns.count.u32() if prior == HCE_ABSENT else HCE_NO_ROW)
                            fns.push(declaration)
                        Decl.Module(module_name, module_body, module_line):
                            hce_collect_functions(module_body, fns, fn_index)
                        Decl.Scoped(scoped_body, scoped_line):
                            hce_collect_functions(scoped_body, fns, fn_index)
                        _:
                            pass

        # Row of the unique declared function NAME; HCE_NO_ROW when none or ambiguous.
        def hce_function_row(name: sview, fns: darray[Ast::Decl]&, fn_index: HceMap&) -> u32:
            can Memory.Allocate, Abort.Panic:
                row: u32 = found if fn_index.rows.get(name_hash(name)) is found else HCE_ABSENT
                return HCE_NO_ROW if row == HCE_NO_ROW or row == HCE_ABSENT
                match fns[row.usize()]:
                    Decl.Func(fn_name, parameters, return_type, body, effects, decorators, line):
                        return row if fn_name == name
                    _:
                        pass
                return HCE_NO_ROW

        # A void function with a writable container parameter: the ambient grower stage0 seeds.
        def hce_void_grower(parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?) -> bool:
            can Memory.Allocate, Abort.Panic:
                if return_type is declared_return:
                    return false if ident_name_of(declared_return) != "void"
                return any parameter in parameters where param_is_mutable_ref(parameter) and annotation_is_container(oe_strip(parameter.type_expression))

        # fillMayAdopt: the function, or any function its body names (transitively), is a void
        # grower. `visited` makes the walk a least fixpoint over the call graph.
        def hce_may_adopt(row: u32, fns: darray[Ast::Decl]&, fn_index: HceMap&, visited: mutable HceMap&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match fns[row.usize()]:
                    Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                        key: u64 = name_hash(name)
                        seen: u32 = found if visited.rows.get(key) is found else HCE_ABSENT
                        return false if seen != HCE_ABSENT
                        visited.rows <- visited.rows.put(key, 1)
                        return true if hce_void_grower(parameters, return_type)
                        mentions: mutable darray[sview] = []
                        hce_mentions_stmts(body, mentions)
                        position: mutable usize = 0
                        while position < mentions.count |visited, position|:
                            key_m: u64 = name_hash(mentions[position])
                            mention_row: u32 = found if fn_index.rows.get(key_m) is found else HCE_ABSENT
                            # Every overload of an ambiguous name may be the one called.
                            return true if mention_row == HCE_NO_ROW
                            return true if mention_row != HCE_ABSENT and hce_may_adopt(mention_row, fns, fn_index, visited)
                            position <- position + 1
                        return false
                    _:
                        return false

        # The callee takes an Arena or an explicit region parameter (a region annotation on its
        # header line): it can allocate into the caller's arenas, so stage0 does not trust it.
        def hce_callee_region_bound(parameters: darray[Ast::ParamDecl]&, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if any parameter in parameters where bare_type_name(oe_strip(parameter.type_expression)) == "Arena"
                return any annotation in annotations where annotation.line == line and annotation.region != "" and not sview_starts_with(annotation.region, "__rg_")

        def hce_contains(names: darray[sview]&, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return name != "" and (any existing in names where existing == name)

        # An argument that hands the callee THIS frame's owned storage: an owner local, its
        # address, a view of it, or a slice of it.
        def hce_local_derived(argument: Ast::Expr, owners: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Ident(name, ident_pos):
                        return hce_contains(owners, name)
                    Expr.Paren(inner, paren_pos):
                        return hce_local_derived(inner, owners)
                    Expr.Unary(operator, operand, unary_pos):
                        return operator == TokenKind.Ampersand and hce_local_derived(operand, owners)
                    Expr.Slice(object, low, high, slice_pos):
                        return hce_contains(owners, ident_name_of(object))
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(receiver, method, method_pos):
                                return arguments.count == 0 and (method == "as_sview" or method == "view") and hce_contains(owners, ident_name_of(receiver))
                            _:
                                return false
                    _:
                        return false

        # Whether an element type can hold an sview: `sview` itself, or a struct with an sview field.
        def hce_element_holds_view(element_type: Ast::Expr, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if ident_name_of(element_type) == "sview"
                struct_name: sview = bare_type_name(element_type)
                return false if struct_name == ""
                position: mutable usize = 0
                while position < f_struct.count:
                    return true if f_struct[position] == struct_name and ident_name_of(oe_strip(f_type[position])) == "sview"
                    position <- position + 1
                return false

        # A call that may fill a tracked view container from a local owner: taint the container.
        def hce_record_fill(expression: Ast::Expr, views: darray[sview]&, owners: darray[sview]&, tainted: mutable darray[sview]&, fns: darray[Ast::Decl]&, fn_index: HceMap&, annotations: darray[Ast::LocalRegionAnnotation]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_pos):
                        hce_record_fill(inner, views, owners, tainted, fns, fn_index, annotations)
                        return
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        # Positional arguments carry an empty label; skip only genuinely named calls.
                        return if any label in argument_names where label != ""
                        effective: mutable darray[Ast::Expr] = []
                        callee_name: mutable sview = ident_name_of(callee)
                        match callee:
                            Expr.Field(receiver, method, method_pos):
                                callee_name <- method
                                effective.push(receiver)
                            _:
                                pass
                        return if callee_name == ""
                        for argument in arguments |effective|:
                            effective.push(argument)
                        # Cheap filter first: some argument must be a tracked view container.
                        return if not (any argument in effective where hce_contains(views, ident_name_of(oe_strip(argument))))
                        row: u32 = hce_function_row(callee_name, fns, fn_index)
                        return if row == HCE_NO_ROW
                        match fns[row.usize()]:
                            Decl.Func(fn_name, parameters, return_type, body, effects, decorators, line):
                                return if parameters.count != effective.count
                                return if hce_callee_region_bound(parameters, line.line, annotations)
                                visited: mutable HceMap = HceMap{rows: {}}
                                # An adopting callee is untrusted for owner arguments, but a source
                                # container already holding local views still taints what it fills.
                                adopting: bool = hce_may_adopt(row, fns, fn_index, visited)
                                index: mutable usize = 0
                                while index < effective.count |tainted|:
                                    filled: sview = ident_name_of(oe_strip(effective[index]))
                                    if hce_contains(views, filled) and param_is_mutable_ref(parameters[index]) and annotation_is_container(oe_strip(parameters[index].type_expression)):
                                        other: mutable usize = 0
                                        while other < effective.count |tainted|:
                                            if other != index and ((not adopting and hce_local_derived(effective[other], owners)) or hce_contains(tainted, ident_name_of(oe_strip(effective[other])))):
                                                tainted.push(filled) if not hce_contains(tainted, filled)
                                            other <- other + 1
                                    index <- index + 1
                            _:
                                pass
                    _:
                        pass

        # The position of a value that carries THIS frame's storage through a local: a loop
        # binder over a tainted container, `c[i]`, a tainted sview/struct local, or a struct
        # literal with such a field (reported at its type name, as stage0 does); an end_column of
        # 0 when it does not. A DIRECT local view (`buf.as_sview()`) is the `in auto:` checker's.
        def hce_tainted_element(value: Ast::Expr, tainted: darray[sview]&, elements: darray[sview]&) -> Ast::Pos:
            can Memory.Allocate, Abort.Panic:
                none: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                match value:
                    Expr.Ident(name, ident_pos):
                        return ident_pos if hce_contains(elements, name)
                    Expr.Paren(inner, paren_pos):
                        return hce_tainted_element(inner, tainted, elements)
                    Expr.Index(object, index, index_pos):
                        return index_pos if hce_contains(tainted, ident_name_of(object))
                    Expr.Construct(type_expression, fields, construct_pos):
                        for field in fields:
                            field_pos: Ast::Pos = hce_tainted_element(field.value, tainted, elements)
                            return Ast::expr_pos(type_expression) if field_pos.end_column != 0 or field_pos.line != 0
                    _:
                        pass
                return none

        def hce_is_tainted(value: Ast::Expr, tainted: darray[sview]&, elements: darray[sview]&, owners: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if hce_local_derived(value, owners)
                match value:
                    Expr.Construct(type_expression, fields, construct_pos):
                        return any field in fields where hce_is_tainted(field.value, tainted, elements, owners)
                    _:
                        pass
                found: Ast::Pos = hce_tainted_element(value, tainted, elements)
                return found.end_column != 0 or found.line != 0

        # A local frame container named as a source: an owner or a view container that is not a
        # parameter.
        def hce_local_container(expression: Ast::Expr, views: darray[sview]&, owners: darray[sview]&, params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                name: sview = ident_name_of(oe_strip(expression))
                return (hce_contains(views, name) or hce_contains(owners, name)) and not hce_contains(params, name)

        # stage0 derives a container's element region from its provenance: a comprehension over a
        # local container, or a call result that received one, inherits that container's LOCAL
        # region whatever its elements are; a ternary merges its branches; a literal merges its
        # elements.
        def hce_derived_tainted(value: Ast::Expr, views: darray[sview]&, owners: darray[sview]&, params: darray[sview]&, tainted: darray[sview]&, elements: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return hce_derived_tainted(inner, views, owners, params, tainted, elements)
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        return hce_derived_tainted(then_expr, views, owners, params, tainted, elements) or hce_derived_tainted(else_expr, views, owners, params, tainted, elements)
                    Expr.Ident(name, ident_pos):
                        return hce_contains(tainted, name)
                    Expr.Comprehension(comp_var, iterable, condition, body, comp_pos):
                        return hce_local_container(iterable, views, owners, params)
                    Expr.Array(array_elements, array_pos):
                        return any element in array_elements where hce_is_tainted(element, tainted, elements, owners)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(receiver, method, method_pos):
                                return true if hce_local_container(receiver, views, owners, params)
                            _:
                                pass
                        return any argument in arguments where hce_local_container(argument, views, owners, params) or hce_local_derived(argument, owners)
                    _:
                        return false

        # `C.push(V)` / `C <- C.push(V)` on a local view container: V's taint flows to C's elements.
        def hce_record_push(expression: Ast::Expr, views: darray[sview]&, owners: darray[sview]&, params: darray[sview]&, tainted: mutable darray[sview]&, elements: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_pos):
                        hce_record_push(inner, views, owners, params, tainted, elements)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(object, method, method_pos):
                                return if method != "push" or arguments.count != 1
                                name: sview = ident_name_of(object)
                                return if not hce_contains(views, name) or hce_contains(params, name) or hce_contains(tainted, name)
                                tainted.push(name) if hce_is_tainted(arguments[0], tainted, elements, owners)
                            _:
                                pass
                    _:
                        pass

        # Blank every row naming NAME (an empty name never matches hce_contains).
        def hce_forget(names: mutable darray[sview]&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                position: mutable usize = 0
                while position < names.count |names, position|:
                    names[position] <- "" if names[position] == name
                    position <- position + 1

        def hce_is_construct(value: Ast::Expr) -> bool:
            match value:
                Expr.Construct(type_expression, fields, construct_pos):
                    return true
                Expr.Paren(inner, paren_pos):
                    return hce_is_construct(inner)
                _:
                    return false

        def hce_is_param_index(target: Ast::Expr, params: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Index(object, index, index_pos):
                        return hce_contains(params, ident_name_of(object))
                    _:
                        return false

        def hce_report(line: u32, pos: Ast::Pos, parameter: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                duplicate: bool = any existing in table.diagnostics where existing.kind == DiagnosticKind.RegionStoreEscape and existing.line == line
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: parameter, pos: pos, line: line, expected: "__param_region", actual: "<inferred>"}) if not duplicate

        # `P.….push(ELEMENT)` with P a parameter (and not a shadowing local).
        def hce_check_push(expression: Ast::Expr, line: u32, params: darray[sview]&, locals: darray[sview]&, tainted: darray[sview]&, elements: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_pos):
                        table <- hce_check_push(inner, line, params, locals, tainted, elements, table)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(object, method, method_pos):
                                return if method != "push" or arguments.count != 1
                                root: sview = auto_escape_place_root(object)
                                return if not hce_contains(params, root) or hce_contains(locals, root)
                                element_pos: Ast::Pos = hce_tainted_element(arguments[0], tainted, elements)
                                table <- hce_report(line, element_pos, root, table) if element_pos.end_column != 0 or element_pos.line != 0
                            _:
                                pass
                    _:
                        pass

        def hce_walk(body: darray[Ast::Stmt], params: darray[sview]&, locals: mutable darray[sview]&, views: mutable darray[sview]&, owners: mutable darray[sview]&, tainted: mutable darray[sview]&, elements: mutable darray[sview]&, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, fns: darray[Ast::Decl]&, fn_index: HceMap&, annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |locals, views, owners, tainted, elements, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, pos):
                            hce_record_fill(value, views, owners, tainted, fns, fn_index, annotations)
                            hce_record_push(value, views, owners, params, tainted, elements)
                            table <- hce_check_push(value, pos.line, params, locals, tainted, elements, table)
                            # A redeclaration starts clean (shadowing is legal).
                            hce_forget(tainted, name)
                            hce_forget(elements, name)
                            derived: bool = hce_derived_tainted(value, views, owners, params, tainted, elements)
                            value_tainted: bool = hce_is_tainted(value, tainted, elements, owners)
                            locals.push(name)
                            annotated: bool = any annotation in annotations where annotation.name == name and annotation.line == pos.line and annotation.region != "" and not sview_starts_with(annotation.region, "__")
                            stripped: Ast::Expr = oe_strip(type_expression)
                            head: sview = bare_type_name(stripped)
                            if not annotated:
                                element_type: Ast::Expr = oe_element_type(stripped)
                                if annotation_is_container(stripped) and hce_element_holds_view(element_type, f_struct, f_name, f_type):
                                    views.push(name)
                                    tainted.push(name) if derived
                                elif not annotation_is_container(stripped) and value_tainted and (head == "sview" or hce_element_holds_view(stripped, f_struct, f_name, f_type)):
                                    elements.push(name)
                                owning_darray: bool = annotation_is_container(stripped) and ident_name_of(element_type) != "sview" and (ident_name_of(element_type) == "u8" or not annotation_is_scalar_darray(stripped))
                                owners.push(name) if owning_darray or head == "dstr"
                        Stmt.Expr(expression, pos):
                            hce_record_fill(expression, views, owners, tainted, fns, fn_index, annotations)
                            hce_record_push(expression, views, owners, params, tainted, elements)
                            table <- hce_check_push(expression, pos.line, params, locals, tainted, elements, table)
                        Stmt.Assign(target, operator, value, pos):
                            hce_record_fill(value, views, owners, tainted, fns, fn_index, annotations)
                            hce_record_push(value, views, owners, params, tainted, elements)
                            table <- hce_check_push(value, pos.line, params, locals, tainted, elements, table)
                            assigned: sview = ident_name_of(target)
                            if operator == TokenKind.LArrow and assigned != "" and hce_contains(locals, assigned) and not hce_contains(params, assigned):
                                if hce_contains(views, assigned):
                                    tainted.push(assigned) if not hce_contains(tainted, assigned) and hce_derived_tainted(value, views, owners, params, tainted, elements)
                                elif not hce_contains(elements, assigned) and hce_is_tainted(value, tainted, elements, owners):
                                    elements.push(assigned)
                            if operator == TokenKind.LArrow:
                                root: sview = auto_escape_place_root(target)
                                element_pos: Ast::Pos = hce_tainted_element(value, tainted, elements)
                                # An indexed store straight into a container parameter (`P[i] <- v`)
                                # runs push's element checks (stage0 checkIndexedElementStoreEscape),
                                # so a literal's fields count there; deeper places still check the
                                # literal, not its fields.
                                direct_indexed: bool = hce_is_param_index(target, params)
                                if (direct_indexed or not hce_is_construct(value)) and ident_name_of(target) == "" and hce_contains(params, root) and not hce_contains(locals, root) and (element_pos.end_column != 0 or element_pos.line != 0):
                                    table <- hce_report(pos.line, element_pos, root, table)
                        Stmt.For(bind, variables, iterable, for_body, pos):
                            loop_var: sview = variables[0] if variables.count == 1 else (bind if variables.count == 0 else "")
                            elements.push(loop_var) if loop_var != "" and hce_contains(tainted, ident_name_of(iterable))
                            table <- hce_walk(for_body, params, locals, views, owners, tainted, elements, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        Stmt.Block(kind, clause, binding, block_body, pos):
                            table <- hce_walk(block_body, params, locals, views, owners, tainted, elements, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        Stmt.If(condition, then_body, else_body, pos):
                            table <- hce_walk(then_body, params, locals, views, owners, tainted, elements, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                            table <- hce_walk(else_body, params, locals, views, owners, tainted, elements, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        Stmt.While(condition, while_body, pos):
                            table <- hce_walk(while_body, params, locals, views, owners, tainted, elements, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        Stmt.Match(scrutinee, arms, pos):
                            for arm in arms |locals, views, owners, tainted, elements, table| -> table:
                                table <- hce_walk(arm.body, params, locals, views, owners, tainted, elements, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        _:
                            pass

        def hce_check_declarations(declarations: darray[Ast::Decl], f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, fns: darray[Ast::Decl]&, fn_index: HceMap&, annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            params: mutable darray[sview] = []
                            for parameter in parameters |params|:
                                params.push(parameter.name)
                            continue if params.count == 0
                            locals: mutable darray[sview] = []
                            views: mutable darray[sview] = []
                            owners: mutable darray[sview] = []
                            tainted: mutable darray[sview] = []
                            elements: mutable darray[sview] = []
                            table <- hce_walk(body, params, locals, views, owners, tainted, elements, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- hce_check_declarations(module_body, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- hce_check_declarations(scoped_body, f_struct, f_name, f_type, fns, fn_index, annotations, table)
                        _:
                            pass

    public:
        def check_handler_capture_escape(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                f_struct: mutable darray[sview] = []
                f_name: mutable darray[sview] = []
                f_type: mutable darray[Ast::Expr] = []
                oe_collect_fields(file.top_decls, f_struct, f_name, f_type)
                fns: mutable darray[Ast::Decl] = []
                fn_index: mutable HceMap = HceMap{rows: {}}
                hce_collect_functions(file.top_decls, fns, fn_index)
                table <- hce_check_declarations(file.top_decls, f_struct, f_name, f_type, fns, fn_index, file.local_region_annotations, table)
