# A `packed enum` value has NO scalar cast: its representation is a STORE ROW, not an
# inline tag, so `op.u32()` has nothing to convert. stage0 rejects it with
# "invalid cast from Op to u32" (verified with `-emit semantic`: a plain `enum` and a
# `const enum` both accept the same cast, only `packed` rejects it).
#
# SOUND and decidable: `packed_enum_names` is a parser side-table of the declared packed
# enums, and the receiver's type comes from its parameter annotation. A receiver whose type
# is not a declared packed enum is never flagged, so nothing else can trip this.
extend Semantic:
    private:
        # The scalar-cast target of a method-style call `x.u32()`, or "" when the expression
        # is not one. Only INTEGER targets are cast spellings here; `.to_string()` and other
        # methods are ordinary calls.
        def packed_cast_target(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return match callee:
                            Expr.Field(object, field, field_line): field if is_integer_type_name(field) and arguments.count == 0 else sview("", 0, 0)
                            _: sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        # The receiver identifier of a method-style call, or "".
        def packed_cast_receiver(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return match callee:
                            Expr.Field(object, field, field_line): ident_name_of(object)
                            _: sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        def packed_cast_expression(expression: Ast::Expr, line: u32, packed_params: darray[sview]&, packed_types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                target: sview = packed_cast_target(expression)
                receiver: sview = packed_cast_receiver(expression)
                if target != "" and receiver != "":
                    slot: mutable i64 = -1
                    index: mutable usize = 0
                    while index < packed_params.count |slot, index, receiver, packed_params|:
                        slot <- index.i64() if packed_params[index] == receiver and slot < 0
                        index <- index + 1
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidBoolCast, name: receiver, line: line, expected: packed_types[slot.usize()], actual: target}) if slot >= 0
                # Recurse into sub-expressions so a cast nested in an index or argument is
                # still seen: `table[op.u32()]` is exactly that shape.
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- packed_cast_expression(argument, line, packed_params, packed_types, table)
                    Expr.Index(object, index_expression, index_line):
                        table <- packed_cast_expression(object, line, packed_params, packed_types, table)
                        table <- packed_cast_expression(index_expression, line, packed_params, packed_types, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- packed_cast_expression(left, line, packed_params, packed_types, table)
                        table <- packed_cast_expression(right, line, packed_params, packed_types, table)
                    Expr.Paren(inner, paren_line):
                        table <- packed_cast_expression(inner, line, packed_params, packed_types, table)
                    _:
                        pass


        def packed_cast_walk(statements: darray[Ast::Stmt], packed_params: darray[sview]&, packed_types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- packed_cast_expression(expression, line, packed_params, packed_types, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- packed_cast_expression(value, line, packed_params, packed_types, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- packed_cast_expression(value, line, packed_params, packed_types, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- packed_cast_expression(returned, line, packed_params, packed_types, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- packed_cast_expression(condition, line, packed_params, packed_types, table)
                            table <- packed_cast_walk(then_body, packed_params, packed_types, table)
                            table <- packed_cast_walk(else_body, packed_params, packed_types, table)
                        Stmt.While(condition, body, line):
                            table <- packed_cast_expression(condition, line, packed_params, packed_types, table)
                            table <- packed_cast_walk(body, packed_params, packed_types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- packed_cast_walk(body, packed_params, packed_types, table)
                        _:
                            pass


        def check_packed_enum_cast_walk(declarations: darray[Ast::Decl], packed_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            packed_params: mutable darray[sview] = []
                            packed_types: mutable darray[sview] = []
                            for parameter in parameters |packed_params, packed_types, packed_names|:
                                annotated: sview = bare_type_name(parameter.type_expression)
                                continue if not (any packed_name in packed_names where packed_name == annotated)
                                packed_params.push(parameter.name)
                                packed_types.push(annotated)
                            continue if packed_params.count == 0
                            table <- packed_cast_walk(body, packed_params, packed_types, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_packed_enum_cast_walk(module_body, packed_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_packed_enum_cast_walk(scoped_body, packed_names, table)
                        _:
                            pass

    public:
        def check_packed_enum_cast(declarations: darray[Ast::Decl], packed_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if packed_names.count == 0
                table <- check_packed_enum_cast_walk(declarations, packed_names, table)
