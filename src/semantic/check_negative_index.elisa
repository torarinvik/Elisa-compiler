# Check for negative integer indices on sequence types (darray, fixed array, view/sview).
# A negative constant index into a sequence is always invalid (dict keys can be negative, so dict receivers never flag).

extend Semantic:
    private:
        # Extract the bare type name from a type expression, handling Index and IndexN (generic types).
        # For Index(Ident("darray"), ...) returns "darray", for Ident("sview") returns "sview".
        def extract_sequence_type_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                # Try to extract from Index form (e.g., darray[i64])
                name return if type_expression is Expr.Index(object, index, line) and object is Expr.Ident(name, _)
                # Try to extract from IndexN form (e.g., generic types with multiple params)
                name return if type_expression is Expr.IndexN(object, arguments, line) and object is Expr.Ident(name, _)
                # Fall back to bare_type_name for simple types (e.g., sview)
                return bare_type_name(type_expression)

        # Check if a type name is a sequence type (can be indexed with non-negative indices).
        # Returns true for darray, view, sview, but NOT dict.
        def is_sequence_type_name(type_name: sview) -> bool:
            can Abort.Panic:
                return type_name == "darray" or type_name == "view" or type_name == "sview"

        # Walk through all expressions, checking for Index expressions with negative constant indices.
        def walk_expression_for_negative_index(expression: Ast::Expr, names: mutable darray[sview]&, types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index, line):
                        # Check if this is a negative index on a sequence type.
                        # First determine if the object is a sequence type.
                        is_sequence: mutable bool = false

                        # Case 1: Array literal — always indexable as a sequence
                        sequence_length: mutable u32 = 0
                        elem_spelling: mutable sview = "int"
                        if object is Expr.Array(elements, _):
                            is_sequence <- true
                            sequence_length <- elements.count.u32()
                        elif object is Expr.Index(base, size, _):
                            # Case 2: Fixed-size array like T[N] — always a sequence
                            is_sequence <- true
                        elif object is Expr.Ident(var_name, _):
                            # Case 3: Identifier — check its tracked type
                            tracked_type: sview = local_type_of(names, types, var_name)
                            # tracked_type is already the bare type name from our tracking
                            is_sequence <- true if tracked_type != "" and is_sequence_type_name(tracked_type)
                            elem_spelling <- type_name_of_row(interned_elem(local_type_id_of(var_name, table), 0, table), table) if type_name_of_row(interned_elem(local_type_id_of(var_name, table), 0, table), table) != ""

                        # Now check if the index is a negative literal
                        if is_sequence:
                            match index:
                                Expr.IntLit(idx_value):
                                    if idx_value < 0:
                                        # Negative index on a sequence — flag it
                                        object_name: sview = match object:
                                            Expr.Ident(name, _): name
                                            _: ""
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NegativeIndex, name: object_name, line: line.line, expected: elem_spelling, actual: "", expected_count: sequence_length, actual_count: (-idx_value).u32()})
                                Expr.Unary(unary_op, operand, _):
                                    # Check for Unary(Minus, IntLit(...))
                                    if unary_op == TokenKind.Minus and operand is Expr.IntLit(pos_value):
                                        # This is a negative literal in the form -(positive)
                                        object_name: sview = match object:
                                            Expr.Ident(name, _): name
                                            _: ""
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NegativeIndex, name: object_name, line: line.line, expected: elem_spelling, actual: "", expected_count: sequence_length, actual_count: pos_value.u32()})
                                _:
                                    pass

                        # Recursively walk the object and index expressions
                        table <- walk_expression_for_negative_index(object, names, types, table)
                        table <- walk_expression_for_negative_index(index, names, types, table) if not index_receiver_is_type_application(object)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_negative_index(left, names, types, table)
                        table <- walk_expression_for_negative_index(right, names, types, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_negative_index(callee, names, types, table)
                        for argument in arguments:
                            table <- walk_expression_for_negative_index(argument, names, types, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_negative_index(object, names, types, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_negative_index(base, names, types, table)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_negative_index(operand, names, types, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_negative_index(inner, names, types, table)
                    Expr.Array(elements, line):
                        for element in elements:
                            table <- walk_expression_for_negative_index(element, names, types, table)
                    Expr.Tuple(elements, line):
                        for element in elements:
                            table <- walk_expression_for_negative_index(element, names, types, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_negative_index(object, names, types, table)
                        table <- walk_expression_for_negative_index(low, names, types, table)
                        table <- walk_expression_for_negative_index(high, names, types, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_negative_index(object, names, types, table)
                        for argument in arguments:
                            table <- walk_expression_for_negative_index(argument, names, types, table) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements:
                            table <- walk_expression_for_negative_index(element, names, types, table)
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            table <- walk_expression_for_negative_index(entry.key, names, types, table)
                            table <- walk_expression_for_negative_index(entry.value, names, types, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_negative_index(type_expression, names, types, table)
                        for field in fields:
                            table <- walk_expression_for_negative_index(field.value, names, types, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_negative_index(base, names, types, table)
                        for field in fields:
                            table <- walk_expression_for_negative_index(field.value, names, types, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_negative_index(condition, names, types, table)
                        table <- walk_expression_for_negative_index(then_expr, names, types, table)
                        table <- walk_expression_for_negative_index(else_expr, names, types, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_negative_index(iterable, names, types, table)
                        table <- walk_expression_for_negative_index(condition, names, types, table)
                        table <- walk_expression_for_negative_index(body, names, types, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_negative_index(body, names, types, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_negative_index(statements, names, types, table)
                        table <- walk_expression_for_negative_index(value, names, types, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_negative_index(scrutinee, names, types, table)
                        for arm in arms:
                            table <- walk_statements_for_negative_index(arm.body, names, types, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for negative indices in expressions and
        # tracking local variable types.
        def walk_statements_for_negative_index(statements: darray[Ast::Stmt], names: mutable darray[sview]&, types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Track the type of this local variable
                            type_name: sview = extract_sequence_type_name(type_expression)
                            note_local_type(names, types, name, type_name)
                            # Check expressions in the value
                            table <- walk_expression_for_negative_index(value, names, types, table)
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_negative_index(expression, names, types, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_negative_index(target, names, types, table)
                            table <- walk_expression_for_negative_index(value, names, types, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_negative_index(condition, names, types, table)
                            table <- walk_statements_for_negative_index(then_body, names, types, table)
                            table <- walk_statements_for_negative_index(else_body, names, types, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_negative_index(condition, names, types, table)
                            table <- walk_statements_for_negative_index(body, names, types, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_negative_index(iterable, names, types, table)
                            table <- walk_statements_for_negative_index(body, names, types, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_negative_index(return_value, names, types, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_negative_index(body, names, types, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_negative_index(scrutinee, names, types, table)
                            for arm in arms:
                                table <- walk_statements_for_negative_index(arm.body, names, types, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_negative_index(expression, names, types, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Walk through function declarations, checking expressions in their bodies.
        def check_negative_index(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Collect parameter types
                            param_names: mutable darray[sview] = []
                            param_types: mutable darray[sview] = []
                            for param in params:
                                param_names.push(param.name)
                                param_types.push(extract_sequence_type_name(param.type_expression))
                            # Walk the body
                            table <- walk_statements_for_negative_index(body, param_names, param_types, table)
                        Decl.Module(module_name, body, line):
                            table <- check_negative_index(body, table)
                        Decl.Scoped(body, line):
                            table <- check_negative_index(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
