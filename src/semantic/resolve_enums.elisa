extend Semantic:
    private:
        # Whether a declared return type is void: absent (`def f():`) or the
        # literal `void` name. Anything else (incl. `T?`, tuples, refs) requires a
        # return value.
        def return_type_is_void(return_type: Ast::Expr?) -> bool:
            can Abort.Panic:
                if return_type is declared_return_type:
                    match declared_return_type:
                        Expr.Ident(name, line):
                            return name == "void"
                        _:
                            return false
                return true


        # Check every `return` against the declared return type: a value returned
        # from a void function, or a bare `return` where a value is required.
        # Recurses nested statement bodies but NOT expressions (a lambda's returns
        # belong to the lambda's own signature).
        def check_returns(statements: darray[Ast::Stmt], is_void: bool, function_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements|table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned_value:
                                # Stage0 permits forwarding a void call through `return`
                                # in a void function (`return cleanup()`). It is control
                                # flow sequencing, not a value return.
                                returns_void_call: mutable bool = false
                                match returned_value:
                                    Expr.Call(callee, args, names, call_line):
                                        match callee:
                                            Expr.Ident(callee_name, callee_line):
                                                if find_symbol(table, callee_name) is callee_symbol:
                                                    returns_void_call <- direct_function_count(table, callee_name) == 1 and callee_symbol.kind == SymbolKind.Func and callee_symbol.return_type == "void"
                                            _:
                                                pass
                                    _:
                                        pass
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReturnValueInVoid, name: function_name, line: line.line, expected: "", actual: ""}) if is_void and not returns_void_call
                                table
                            else:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MissingReturnValue, name: function_name, line: line.line, expected: "", actual: ""}) if not is_void
                                table
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_returns(then_body, is_void, function_name, table)
                            table <- check_returns(else_body, is_void, function_name, table)
                            table
                        Stmt.While(condition, body, line):
                            table <- check_returns(body, is_void, function_name, table)
                            table
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_returns(body, is_void, function_name, table)
                            table
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_returns(body, is_void, function_name, table)
                            table
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_returns(arm.body, is_void, function_name, table)
                        Stmt.Expr(expression, line):
                            table
                        Stmt.VarDecl(name, type_expression, value, line):
                            table
                        Stmt.Assign(target, operator, value, line):
                            table
                        Stmt.Contract(kind, expression, line):
                            table
                        Stmt.Invalid:
                            table
                        Stmt.Break(label, line):
                            table
                        Stmt.Continue(label, line):
                            table


        # Whether `name` is a declared enum type in the table.
        def is_enum_name(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return any symbol in table.symbols where symbol.name == name and symbol.kind == SymbolKind.Enum


        # Registry index of `owner`'s variant `variant_name`, or -1 if not declared.
        def enum_variant_index(table: SymbolTable&, owner: sview, variant_name: sview) -> int:
            can Abort.Panic:
                while variant_index < table.enum_variant_owner.count |variant_index: usize = 0|:
                    variant_index.int() return if table.enum_variant_owner[variant_index] == owner and table.enum_variant_name[variant_index] == variant_name
                    variant_index <- variant_index + 1
                return -1


        # Whether enum `owner` declares variant `variant_name`.
        def enum_has_variant(table: SymbolTable&, owner: sview, variant_name: sview) -> bool:
            can Abort.Panic:
                return enum_variant_index(table, owner, variant_name) >= 0


        # Whether `name` is an immutable `const` declaration (not a `global`).
        def const_is_immutable(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return any const_name in table.immutable_const_names where const_name == name


        # Whether struct `owner` has a KNOWN, closed field set recorded (>=1 named
        # field, every member cleanly named). Only such structs are checkable.
        def struct_is_registered(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                return any field_owner in table.struct_field_owner where field_owner == owner


        # Whether struct `owner` declares named field `field_name`.
        def struct_has_field(table: SymbolTable&, owner: sview, field_name: sview) -> bool:
            can Abort.Panic:
                while field_index < table.struct_field_owner.count |field_index: usize = 0|:
                    true return if table.struct_field_owner[field_index] == owner and table.struct_field_name[field_index] == field_name
                    field_index <- field_index + 1
                return false


        # The module recorded for field row `index`. Read defensively: struct_field_module
        # is index-parallel with struct_field_owner, and a recording site that forgot to
        # grow it would otherwise be an out-of-bounds read rather than a missing module.
        def struct_field_module_at(table: SymbolTable&, index: usize) -> sview:
            can Abort.Panic:
                return "" if index >= table.struct_field_module.count
                return table.struct_field_module[index]


        # Which module's `owner` a name written HERE means: the enclosing module first, then
        # a top-level struct, and only then whichever module declares it -- which is what a
        # bare name meant before structs had modules at all, so nothing that checked before
        # stops checking now.
        #
        # `scope_module` is the module the construction was written in.
        def struct_owner_module_for(table: SymbolTable&, scope_module: sview, owner: sview) -> sview:
            can Abort.Panic:
                if scope_module != "":
                    while own_index < table.struct_field_owner.count |own_index: usize = 0|:
                        scope_module return if table.struct_field_owner[own_index] == owner and struct_field_module_at(table, own_index) == scope_module
                        own_index <- own_index + 1
                while top_index < table.struct_field_owner.count |top_index: usize = 0|:
                    "" return if table.struct_field_owner[top_index] == owner and struct_field_module_at(table, top_index) == ""
                    top_index <- top_index + 1
                while any_index < table.struct_field_owner.count |any_index: usize = 0|:
                    struct_field_module_at(table, any_index) return if table.struct_field_owner[any_index] == owner
                    any_index <- any_index + 1
                return ""


        # struct_has_field, restricted to one module's `owner`.
        def struct_has_field_in(table: SymbolTable&, owner_module: sview, owner: sview, field_name: sview) -> bool:
            can Abort.Panic:
                while field_index < table.struct_field_owner.count |field_index: usize = 0|:
                    if table.struct_field_owner[field_index] == owner and table.struct_field_name[field_index] == field_name and struct_field_module_at(table, field_index) == owner_module:
                        return true
                    field_index <- field_index + 1
                return false


        # The bare struct name of a construction's type expression, or "" when it is
        # not a plain identifier (generic `Box[T]`, qualified `Mod::Point`, …) — those
        # bail out of the UnknownField check.
        def construct_type_name(type_expression: Ast::Expr) -> sview:
            return match type_expression:
                Ast::Expr.Ident(name, _): name
                _:                        sview("", 0, 0)


        # Check a match-arm pattern's variant paths against the enum registry. A
        # Variant pattern's `path` is raw dotted text (`Color.Purple`); it is
        # matched against each known enum by prefix (enum name + `.`) with the
        # remainder compared to that enum's variants — no substring allocation.
        # Qualified (`Mod::Enum.V`) and non-enum-headed paths are skipped.
        def check_pattern_variants(pattern: Ast::Pattern, table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Variant(path, fields):
                        table <- check_variant_path(path, fields.count, table, line)
                        for field in fields |table| -> table:
                            table <- check_pattern_variants(field, table, line)
                    Pattern.Struct(struct_path, struct_fields):
                        for struct_field in struct_fields |table| -> table:
                            table <- check_pattern_variants(struct_field, table, line)
                    Pattern.Field(selector, inner):
                        for inner_pattern in inner |table| -> table:
                            table <- check_pattern_variants(inner_pattern, table, line)
                    Pattern.Tuple(elements):
                        for element in elements |table| -> table:
                            table <- check_pattern_variants(element, table, line)
                    Pattern.Rest(name):
                        pass
                    Pattern.Or(options):
                        for option in options |table| -> table:
                            table <- check_pattern_variants(option, table, line)
                    Pattern.Wildcard:
                        pass
                    Pattern.Literal(text):
                        pass
                    Pattern.Binding(binding_name):
                        pass
                    Pattern.Pin(binding_name):
                        pass
                    Pattern.TypeBind(bound_type, binder):
                        pass
                    Pattern.Range(lo, hi, inclusive):
                        pass
                    Pattern.As(as_name, inner):
                        for inner_pattern in inner |table| -> table:
                            table <- check_pattern_variants(inner_pattern, table, line)
                    Pattern.Other(text):
                        pass


        # Flag `match` arms that can never match because an earlier arm already covers
        # every value they would: an exact-duplicate variant/literal, or any arm after a
        # catch-all (`_` or a bare binding). Parity-matched to stage0's "unreachable
        # because an earlier arm already matches it". SOUND SUBSET: a variant arm counts
        # as a dominator only when its payload subpatterns are ALL irrefutable
        # (`_`/binding), so `E.A(1)` vs `E.A(2)` — which match different payloads — is
        # never falsely flagged. Or/Struct/Tuple/TypeBind arms are conservatively skipped
        # (recorded neither as keys nor dominators), so they never produce a false finding.
        def check_unreachable_arms(arms: darray[Ast::MatchArm], table: lmut SymbolTable, match_line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in arms |table, catchall = false, seen: darray[sview] = []|:
                    # Patterns carry no line; locate the finding at the arm's first body statement.
                    arm_line: u32 = statement_line(arm.body[0]) if arm.body.count > 0 else match_line
                    # One dispatch, three outputs (is_catchall, dominance key, finding
                    # text) — a tuple-yielding match-expression. A bare Binding is NOT a
                    # catch-all: `catch EXPR:` desugars to the SAME Stmt.Match with a
                    # bare-binding success arm followed by reachable error arms, so
                    # treating it as a dominator would falsely flag those (subset of
                    # stage0; `_` is safe — catch never uses it for the success arm).
                    # A Variant dominates only when its payload is all-irrefutable.
                    # Or/Struct/Tuple/TypeBind arms are conservatively keyless.
                    is_catchall, key, text = match arm.pattern:
                        Pattern.Wildcard:              true, "", "_"
                        Pattern.Binding(binding_name): false, "", binding_name
                        Pattern.Variant(path, fields): false, path if all_fields_irrefutable(fields) else "", path
                        Pattern.Literal(literal_text): false, literal_text, literal_text
                        Pattern.Struct(struct_path, struct_fields): false, "", struct_path
                        Pattern.Field(selector, inner): false, "", selector
                        _:                             false, "", ""
                    # docs/122 §5.1: a guarded arm can fail at runtime, so it never
                    # dominates later arms (no catchall, no dominance key) — but it is
                    # still flagged when an EARLIER arm already covers it.
                    guarded: bool = match arm.guard:
                        Expr.Invalid: false
                        Expr.Absent: false
                        _:            true
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnreachableMatchArm, name: text, line: arm_line, expected: "", actual: ""}) if catchall
                    continue if catchall
                    catchall <- true if is_catchall and not guarded
                    continue if is_catchall
                    if key != "":
                        # docs/119 §3: "have we seen this key?" is a fold with early exit —
                        # `break` yields the accumulator's current state.
                        duplicate: bool =
                            for seen_key in seen |found = false| -> found:
                                if seen_key == key:
                                    found <- true
                                    break
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnreachableMatchArm, name: text, line: arm_line, expected: "", actual: ""}) if duplicate
                        seen.push(key) if not duplicate and not guarded


        # Whether every subpattern is irrefutable (so a variant arm carrying them matches
        # its whole variant, dominating any later arm of that variant).
        def all_fields_irrefutable(fields: darray[Ast::Pattern]) -> bool:
            can Abort.Panic:
                # Fold with early exit: `break` yields the accumulator's current state.
                ok: bool =
                    for field in fields |all_irrefutable = true| -> all_irrefutable:
                        if not field_is_irrefutable(field):
                            all_irrefutable <- false
                            break
                return ok


        # A subpattern is irrefutable iff it matches every value: a `_` wildcard or a bare
        # binding. Any literal/variant/struct/tuple/or/typebind can fail to match.
        def field_is_irrefutable(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                return match pattern:
                    Pattern.Wildcard:               true
                    Pattern.Binding(binding_name):  true
                    Pattern.Field(selector, inner): all_fields_irrefutable(inner)
                    _:                              false


        # Whether `slice` equals `path`'s bytes starting at `offset` (caller guarantees
        # `offset + len(slice)` is in bounds).
        def sview_slice_equals(path: sview, offset: usize, slice: sview) -> bool:
            can Abort.Panic:
                for byte_index in 0..<sview_len(slice):
                    false return if sview_at(path, offset + byte_index) != sview_at(slice, byte_index)
                return true


        # Whether `path` is exactly `enum_name` + `.` + a nonempty tail.
        def path_names_enum(path: sview, enum_name: sview) -> bool:
            can Abort.Panic:
                enum_name_length: usize = sview_len(enum_name)
                return sview_len(path) > enum_name_length + 1 and sview_at(path, enum_name_length) == '.' and sview_slice_equals(path, 0, enum_name)


        # Registry index of `enum_name`'s variant whose name equals `path`'s tail after
        # `enum_name.`, or -1 (no substring allocation).
        def enum_tail_variant_index(table: SymbolTable&, enum_name: sview, path: sview) -> int:
            can Abort.Panic:
                tail_start: usize = sview_len(enum_name) + 1
                tail_length: usize = sview_len(path) - tail_start
                while variant_index < table.enum_variant_owner.count |variant_index: usize = 0|:
                    variant_index.int() return if table.enum_variant_owner[variant_index] == enum_name and sview_len(table.enum_variant_name[variant_index]) == tail_length and sview_slice_equals(path, tail_start, table.enum_variant_name[variant_index])
                    variant_index <- variant_index + 1
                return -1


        # Match `path` (raw `Enum.Variant` text) against the registry; flag when the
        # head names a declared enum but the tail is not one of its variants, or
        # when the pattern destructures a payload count differing from the
        # declaration. `argument_count` = supplied subpattern count; 0 means a bare tag-only
        # pattern (`Enum.Variant:`), which is legal for any arity and never flagged.
        def check_variant_path(path: sview, argument_count: usize, table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                for symbol in table.symbols |table|:
                    continue if symbol.kind != SymbolKind.Enum or not path_names_enum(path, symbol.name)
                    # The head names this enum — resolve the tail against its variants.
                    variant_index: int = enum_tail_variant_index(table, symbol.name, path)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownVariant, name: path, line: line, expected: "", actual: ""}) if variant_index < 0
                    break if variant_index < 0
                    slot: usize = variant_index.usize()
                    common_count: mutable u32 = 0
                    while common_index < table.enum_common_owners.count |common_index: usize = 0|:
                        common_count <- table.enum_common_counts[common_index] if table.enum_common_owners[common_index] == symbol.name
                        common_index <- common_index + 1
                    pattern_arity: u32 = table.enum_variant_arity[slot] - common_count
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VariantArity, name: table.enum_variant_name[slot], line: line, expected: symbol.name, actual: "", expected_count: pattern_arity, actual_count: argument_count.u32()}) if argument_count > 0 and argument_count.u32() != pattern_arity
                    break
