extend Semantic:
    private:
        def rtr_check_returns(statements: darray[Ast::Stmt], ref_params: darray[sview]&, param_regions: darray[sview @source]&, return_region: sview, stored_targets: darray[sview]&, stored_sources: darray[sview]&, grown: darray[sview]&, alias_names: darray[sview]&, alias_roots: darray[sview @source]&, cond_aliases: darray[sview]&, view_return: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                rebind handled_grown: bool, table = rtr_check_grown_return(returned, line.line, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                                continue if handled_grown
                                root: sview = rtr_return_root(returned, ref_params, true)
                                if root != "":
                                    # The tied region name: the param's declared @r, or
                                    # the implicit __rg_<param> spelled by the renderer.
                                    declared: mutable sview = sview("", 0, 0)
                                    probe: mutable usize = 0
                                    while probe < ref_params.count |probe, declared, root, ref_params, param_regions|:
                                        declared <- param_regions[probe] if ref_params[probe] == root and declared == ""
                                        probe <- probe + 1
                                    continue if declared != "" and declared == return_region
                                    # Unannotated references may be forwarded directly, but a
                                    # derived field borrow must preserve its inferred region.
                                    continue if declared == "" and rtr_return_root(returned, ref_params, false) == ""
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionTiedReturn, name: root, line: line.line, expected: declared, actual: ""})
                                returned_root: sview = rtr_expression_root(returned)
                                for stored_index in 0..<stored_targets.count |table, stored_targets, stored_sources, returned_root, param_regions, return_region|:
                                    continue if stored_targets[stored_index] != returned_root
                                    source_index: mutable usize = 0
                                    source_found: mutable bool = false
                                    for parameter_index in 0..<ref_params.count:
                                        if ref_params[parameter_index] == stored_sources[stored_index]:
                                            source_index <- parameter_index
                                            source_found <- true
                                    continue if not source_found or source_index >= param_regions.count
                                    source_region: sview = param_regions[source_index]
                                    continue if source_region != "" and source_region == return_region
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionTiedReturn, name: returned_root, line: line.line, expected: source_region, actual: ""})
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- rtr_check_returns(then_body, ref_params, param_regions, return_region, stored_targets, stored_sources, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                            table <- rtr_check_returns(else_body, ref_params, param_regions, return_region, stored_targets, stored_sources, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- rtr_check_returns(while_body, ref_params, param_regions, return_region, stored_targets, stored_sources, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                            table <- rtr_check_returns(for_body, ref_params, param_regions, return_region, stored_targets, stored_sources, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- rtr_check_returns(block_body, ref_params, param_regions, return_region, stored_targets, stored_sources, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- rtr_check_returns(arm.body, ref_params, param_regions, return_region, stored_targets, stored_sources, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                        _:
                            pass


        def rtr_walk(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, runtime_std: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            region_kind: mutable bool = false
                            if return_type is declared_return:
                                region_kind <- rtr_type_is_region_kind(declared_return)
                            continue if not region_kind
                            # A declared `-> T @r` tie is accepted when it matches the source
                            # parameter's explicit region. A view-producing expression can erase
                            # the source type syntactically, so track the region annotation itself
                            # rather than trying to whitelist only particular carrier types.
                            return_region: mutable sview = sview("", 0, 0)
                            has_return_region: mutable bool = false
                            for annotation in annotations |return_region, has_return_region|:
                                matches_return: bool = annotation.name == "__region_return" and annotation.line == line.line and annotation.owner_offset == line.offset
                                has_return_region <- true if matches_return
                                return_region <- annotation.region if matches_return
                            ref_params: mutable darray[sview] = []
                            param_regions: mutable darray[sview @source] = []
                            for parameter in parameters |ref_params, param_regions, annotations, line|:
                                declared_region: mutable sview = sview("", 0, 0)
                                for annotation in annotations |declared_region, parameter, line|:
                                    matches: bool = annotation.name == parameter.name and annotation.line == line.line and annotation.owner_offset == line.offset
                                    declared_region <- annotation.region if matches and declared_region == ""
                                # Explicit regions apply even to direct forwarding. Implicit
                                # typed-reference regions apply only to derived field borrows.
                                is_ref: bool = not runtime_std and rtr_type_has_outer_reference(parameter.type_expression) and not type_contains_operator(parameter.type_expression, TokenKind.Static) and not rtr_type_has_void_pointee(parameter.type_expression)
                                is_region_source: bool = declared_region != "" and declared_region != return_region
                                continue if not is_ref and not is_region_source
                                ref_params.push(parameter.name)
                                param_regions.push(declared_region)
                            # Grown-parameter candidates: by-ref or lmut, region-less, typed.
                            candidates: mutable darray[sview] = []
                            for parameter in parameters |candidates, annotations, line|:
                                continue if runtime_std or has_return_region
                                continue if any annotation in annotations where annotation.name == parameter.name and annotation.line == line.line and annotation.owner_offset == line.offset
                                by_ref: bool = rtr_type_has_outer_reference(parameter.type_expression) or type_is_lmut(parameter.type_expression)
                                continue if not by_ref or type_contains_operator(parameter.type_expression, TokenKind.Static) or rtr_type_has_void_pointee(parameter.type_expression)
                                candidates.push(parameter.name)
                            grown: mutable darray[sview] = []
                            rtr_grown_statements(body, candidates, grown) if candidates.count > 0
                            alias_names: mutable darray[sview] = []
                            alias_roots: mutable darray[sview @source] = []
                            cond_aliases: mutable darray[sview] = []
                            rtr_grown_aliases(body, grown, alias_names, alias_roots, cond_aliases) if grown.count > 0
                            view_return: mutable bool = false
                            if return_type is view_return_type:
                                view_return <- rtr_type_is_view_family(view_return_type)
                            if ref_params.count > 0 or grown.count > 0:
                                stored_targets: mutable darray[sview] = []
                                stored_sources: mutable darray[sview] = []
                                rtr_collect_stored_borrows_statements(body, parameters, ref_params, stored_targets, stored_sources)
                                table <- rtr_check_returns(body, ref_params, param_regions, return_region, stored_targets, stored_sources, grown, alias_names, alias_roots, cond_aliases, view_return, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- rtr_walk(module_body, annotations, runtime_std, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- rtr_walk(scoped_body, annotations, runtime_std, table)
                        _:
                            pass

    public:
        def check_region_tied_return(file: Ast::File&, runtime_std: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- rtr_walk(file.top_decls, file.local_region_annotations, runtime_std, table)
