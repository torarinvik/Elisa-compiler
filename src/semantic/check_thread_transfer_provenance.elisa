# Values crossing a thread boundary may not retain dependencies on an unpublished
# local packed store or a local region. Dependency rows propagate through ordinary
# wrappers, arrays, calls, and views; freezing a store publishes/remaps store-backed
# values but deliberately leaves independent local-region dependencies intact.
#
# Kind 3 rows mirror stage0's region dependency facts for plain allocations: a
# darray literal/comprehension declared inside `region r:` depends on `r`, one
# declared with no region open depends on the function's inferred region
# (`<inferred>`). A view of such a value may not reach `spawn1` at all, and may
# reach a nursery/pool `submit` only when its region was open before the nursery
# started (it then outlives the join; stage0 analyzePoolStmt). Scalars carry no
# borrow, so only view-shaped payloads are checked.
extend Semantic:
    private:
        def transfer_type_is_local_store(expression: Ast::Expr) -> bool:
            can Memory.Allocate:
                can Abort.Panic:
                    match expression:
                        Expr.Index(Expr.Field(_, field, field_line), Expr.Ident(state, state_line), line):
                            return sview_equal(field, "Store") and sview_equal(state, "Local")
                        Expr.Index(Expr.Scope(_, field, field_line), Expr.Ident(state, state_line), line):
                            return sview_equal(field, "Store") and sview_equal(state, "Local")
                        Expr.Unary(_, inner, line) | Expr.Paren(inner, line):
                            return transfer_type_is_local_store(inner)
                        _:
                            return false


        def transfer_name_exists(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for name in names:
                    true return if name == wanted
                return false


        def transfer_allocation_on_line(allocation_names: darray[sview]&, allocation_lines: darray[u32]&, line: u32) -> sview:
            can Abort.Panic:
                while index < allocation_names.count |index: usize = 0|:
                    allocation_names[index] return if allocation_lines[index] == line
                    index <- index + 1
                return ""


        def transfer_note(owner: sview, kind: u8, dependency: sview, owners: mutable darray[sview]&, kinds: mutable darray[u8]&, dependencies: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if owner == "" or dependency == "" or kind == 0
                while index < owners.count |index: usize = 0|:
                    return if owners[index] == owner and kinds[index] == kind and dependencies[index] == dependency
                    index <- index + 1
                owners.push(owner)
                kinds.push(kind)
                dependencies.push(dependency)


        def transfer_copy_name(target: sview, source: sview, owners: mutable darray[sview]&, kinds: mutable darray[u8]&, dependencies: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                original_count: usize = owners.count
                while index < original_count |index: usize = 0|:
                    transfer_note(target, kinds[index], dependencies[index], owners, kinds, dependencies) if owners[index] == source and kinds[index] != 0
                    index <- index + 1


        def transfer_propagate_expression(target: sview, expression: Ast::Expr, owners: mutable darray[sview]&, kinds: mutable darray[u8]&, dependencies: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        transfer_copy_name(target, name, owners, kinds, dependencies)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments:
                            transfer_propagate_expression(target, argument, owners, kinds, dependencies)
                        match callee:
                            Expr.Field(object, method, method_line):
                                transfer_propagate_expression(target, object, owners, kinds, dependencies) if transfer_view_method(method)
                            _:
                                pass
                    Expr.Array(elements, line) | Expr.Tuple(elements, line):
                        for element in elements:
                            transfer_propagate_expression(target, element, owners, kinds, dependencies)
                    Expr.Slice(object, low, high, line) | Expr.Binary(object, _, low, line):
                        transfer_propagate_expression(target, object, owners, kinds, dependencies)
                        transfer_propagate_expression(target, low, owners, kinds, dependencies)
                    Expr.Index(object, index, line) | Expr.Field(object, _, line) | Expr.Unary(_, object, line) | Expr.Move(object, line) | Expr.Paren(object, line):
                        transfer_propagate_expression(target, object, owners, kinds, dependencies)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields:
                            transfer_propagate_expression(target, field.value, owners, kinds, dependencies)
                    _:
                        pass


        def transfer_freeze_source(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(Expr.Ident(name, ident_line), arguments, argument_names, line):
                        affine_root(arguments[0]) return if name == "freeze" and arguments.count > 0
                    _:
                        return ""
                return ""


        def transfer_publish_store(store: sview, kinds: mutable darray[u8]&, dependencies: darray[sview]&) -> void:
            can Abort.Panic:
                while index < kinds.count |index: usize = 0|:
                    kinds[index] <- 0 if kinds[index] == 1 and dependencies[index] == store
                    index <- index + 1


        def transfer_dependency_of(expression: Ast::Expr, wanted_kind: u8, owners: darray[sview]&, kinds: darray[u8]&, dependencies: darray[sview]&) -> sview:
            can Abort.Panic:
                root: sview = transfer_dependency_root(expression)
                while index < owners.count |index: usize = 0|:
                    dependencies[index] return if owners[index] == root and kinds[index] == wanted_kind
                    index <- index + 1
                return ""


        def transfer_view_method(name: sview) -> bool:
            return name == "as_sview" or name == "as_view" or name == "view" or name == "slice" or name == "as_slice"


        def transfer_dependency_root(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Slice(object, low, high, line) | Expr.Move(object, line) | Expr.Unary(_, object, line):
                    return transfer_dependency_root(object)
                Expr.Call(Expr.Field(object, method, method_line), arguments, argument_names, line):
                    return transfer_dependency_root(object) if transfer_view_method(method) else ""
                _:
                    return affine_root(expression)


        # A payload that can carry a borrow into a region: a name, a slice, or a view
        # method call. `b.count.i64()` / `b[0]` are scalar reads and carry none.
        def transfer_payload_is_view_shaped(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Ident(name, line):
                    return true
                Expr.Slice(object, low, high, line):
                    return true
                Expr.Move(object, line) | Expr.Paren(object, line):
                    return transfer_payload_is_view_shaped(object)
                Expr.Call(Expr.Field(object, method, method_line), arguments, argument_names, line):
                    return transfer_view_method(method)
                _:
                    return false


        # Kind-3 region of a view-shaped payload, or "".
        def transfer_local_region_of(payload: Ast::Expr, owners: darray[sview]&, kinds: darray[u8]&, dependencies: darray[sview]&) -> sview:
            can Abort.Panic:
                return "" if not transfer_payload_is_view_shaped(payload)
                annotated: sview = transfer_dependency_of(payload, 2, owners, kinds, dependencies)
                return annotated if annotated != "" else transfer_dependency_of(payload, 3, owners, kinds, dependencies)


        def transfer_allocates(value: Ast::Expr) -> bool:
            match value:
                Expr.Array(elements, line):
                    return true
                Expr.Comprehension(_, _, _, _, line):
                    return true
                _:
                    return false


        def check_transfer_boundary(expression: Ast::Expr, owners: darray[sview]&, kinds: darray[u8]&, dependencies: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(Expr.Ident(name, ident_line), arguments, argument_names, line):
                        boundary: bool = name == "spawn1" or name == "pool_submit1"
                        while has_payload |has_payload: bool = boundary and arguments.count > 0, table|:
                            payload: Ast::Expr = arguments[arguments.count - 1]
                            store_dependency: sview = transfer_dependency_of(payload, 1, owners, kinds, dependencies)
                            region_dependency: sview = transfer_dependency_of(payload, 2, owners, kinds, dependencies)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadTransferStoreDependency, name: name, line: line.line, expected: "", actual: store_dependency}) if store_dependency != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadTransferRegionDependency, name: name, line: line.line, expected: "", actual: region_dependency}) if region_dependency != ""
                            local_region: sview = transfer_local_region_of(payload, owners, kinds, dependencies) if region_dependency == "" and name == "spawn1" else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadTransferRegionDependency, name: name, line: line.line, expected: "", actual: local_region}) if local_region != ""
                            has_payload <- false
                    _:
                        pass


        def transfer_region_open_below(open_regions: darray[sview]&, floor: usize, region: sview) -> bool:
            can Abort.Panic:
                while index < floor |index: usize = 0|:
                    true return if open_regions[index] == region
                    index <- index + 1
                return false


        # `submit f(args)` inside a nursery/pool (`Expr.Block([], call)`): an argument
        # viewing a region opened INSIDE the nursery is freed before the join.
        def check_transfer_submit(value: Ast::Expr, open_regions: darray[sview]&, nursery_floor: usize, owners: darray[sview]&, kinds: darray[u8]&, dependencies: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Block(statements, Expr.Call(callee, arguments, argument_names, call_line), captures, line):
                        return if statements.count != 0
                        for argument in arguments |table|:
                            region: sview = transfer_local_region_of(argument, owners, kinds, dependencies)
                            outer: bool = region == "<inferred>" or transfer_region_open_below(open_regions, nursery_floor, region)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadTransferRegionDependency, name: "pool_submit1", line: call_line.line, expected: "", actual: region}) if region != "" and not outer
                    _:
                        pass


        def walk_transfer_statements(statements: darray[Ast::Stmt], allocation_names: darray[sview]&, allocation_lines: darray[u32]&, store_names: mutable darray[sview]&, owners: mutable darray[sview]&, kinds: mutable darray[u8]&, dependencies: mutable darray[sview]&, open_regions: mutable darray[sview]&, in_nursery: bool, nursery_floor: usize, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            store_names.push(name) if transfer_type_is_local_store(type_expression)
                            allocation: sview = transfer_allocation_on_line(allocation_names, allocation_lines, line.line)
                            allocation_kind: u8 = 1 if transfer_name_exists(store_names, allocation) else (2 if allocation != "" else 0)
                            transfer_note(name, allocation_kind, allocation, owners, kinds, dependencies)
                            transfer_note(name, 3, open_regions[open_regions.count - 1] if open_regions.count > 0 else sview("<inferred>", 0, 10), owners, kinds, dependencies) if allocation_kind == 0 and transfer_allocates(value)
                            transfer_propagate_expression(name, value, owners, kinds, dependencies)
                            frozen_store: sview = transfer_freeze_source(value)
                            transfer_publish_store(frozen_store, kinds, dependencies) if frozen_store != ""
                            table <- check_transfer_boundary(value, owners, kinds, dependencies, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_transfer_boundary(value, owners, kinds, dependencies, table)
                        Stmt.Expr(value, line):
                            table <- check_transfer_boundary(value, owners, kinds, dependencies, table)
                            table <- check_transfer_submit(value, open_regions, nursery_floor, owners, kinds, dependencies, table) if in_nursery
                        Stmt.Return(value, line):
                            table <- check_transfer_boundary(returned, owners, kinds, dependencies, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_transfer_statements(then_body, allocation_names, allocation_lines, store_names, owners, kinds, dependencies, open_regions, in_nursery, nursery_floor, table)
                            table <- walk_transfer_statements(else_body, allocation_names, allocation_lines, store_names, owners, kinds, dependencies, open_regions, in_nursery, nursery_floor, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            opens_region: bool = kind == "region" and clause.count > 0
                            open_regions.push(clause[0]) if opens_region
                            starts_nursery: bool = kind == "nursery" or kind == "pool"
                            child_floor: usize = open_regions.count if starts_nursery else nursery_floor
                            table <- walk_transfer_statements(body, allocation_names, allocation_lines, store_names, owners, kinds, dependencies, open_regions, in_nursery or starts_nursery, child_floor, table)
                            open_regions <- open_regions.truncate(open_regions.count - 1) if opens_region
                        Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- walk_transfer_statements(body, allocation_names, allocation_lines, store_names, owners, kinds, dependencies, open_regions, in_nursery, nursery_floor, table)
                        _:
                            pass


        def check_transfer_declarations(declarations: darray[Ast::Decl], allocation_names: darray[sview]&, allocation_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            store_names: mutable darray[sview] = []
                            owners: mutable darray[sview] = []
                            kinds: mutable darray[u8] = []
                            dependencies: mutable darray[sview] = []
                            open_regions: mutable darray[sview] = []
                            table <- walk_transfer_statements(body, allocation_names, allocation_lines, store_names, owners, kinds, dependencies, open_regions, false, 0, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_transfer_declarations(body, allocation_names, allocation_lines, table)
                        _:
                            pass

    public:
        def check_thread_transfer_provenance(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_transfer_declarations(file.top_decls, file.allocation_region_names, file.allocation_region_lines, table)
