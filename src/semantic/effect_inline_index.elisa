# Offset index for postfix can clauses. Numeric rows keep borrowed source text rooted
# in the caller's annotation table while queries avoid scanning every grant per node.
extend Semantic:
    private:
        struct InlineEffectIndex:
            rows: mutable darray[usize]
            starts: mutable darray[u32]
            ends: mutable darray[u32]
            prefix_ends: mutable darray[u32]

        def inline_effect_index(annotations: darray[Ast::EnumAnnotation]&) -> InlineEffectIndex:
            can Memory.Allocate, Abort.Panic:
                index: mutable InlineEffectIndex = InlineEffectIndex{rows: [], starts: [], ends: [], prefix_ends: []}
                for row in 0..<annotations.count |index|:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    continue if annotation.owner != "__inline_expression_grant"
                    index.rows.push(row)
                    index.starts.push(annotation.pos.offset)
                    index.ends.push(annotation.pos.end_offset)
                for outer in 1..<index.rows.count |index|:
                    position: mutable usize = outer
                    while position > 0 and index.starts[position] < index.starts[position - 1] |position, index|:
                        row: usize = index.rows[position]
                        start: u32 = index.starts[position]
                        stop: u32 = index.ends[position]
                        index.rows[position] <- index.rows[position - 1]
                        index.starts[position] <- index.starts[position - 1]
                        index.ends[position] <- index.ends[position - 1]
                        index.rows[position - 1] <- row
                        index.starts[position - 1] <- start
                        index.ends[position - 1] <- stop
                        position <- position - 1
                longest: mutable u32 = 0
                for stop in index.ends |longest, index|:
                    longest <- max(longest, stop)
                    index.prefix_ends.push(longest)
                return index

        def inline_effect_limit(offset: u32, index: InlineEffectIndex&) -> usize:
            can Abort.Panic:
                lower: mutable usize = 0
                upper: mutable usize = index.rows.count
                while lower < upper |lower, upper|:
                    middle: usize = lower + (upper - lower) / 2
                    if index.starts[middle] <= offset:
                        lower <- middle + 1
                    else:
                        upper <- middle
                return lower
