extend Semantic:
    private:
        def const_float_text(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.FloatLit(text):
                        return text
                    Expr.Paren(inner, line):
                        return const_float_text(inner)
                    Expr.Unary(operator, operand, line):
                        return const_float_text(operand) if operator == TokenKind.Minus or operator == TokenKind.Plus else ""
                    _:
                        return ""

        def const_float_negative(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Paren(inner, line):
                        return const_float_negative(inner)
                    Expr.Unary(operator, operand, line):
                        true return if operator == TokenKind.Minus
                        return const_float_negative(operand)
                    _:
                        return false

        def decimal_integer_exceeds(text: sview, limit: sview) -> bool:
            can Abort.Panic:
                integer_end: mutable usize = 0
                while integer_end < sview_len(text) and text[integer_end] != '.' and text[integer_end] != 'e' and text[integer_end] != 'E' |integer_end|:
                    integer_end <- integer_end + 1
                first: mutable usize = 0
                while first + 1 < integer_end and text[first] == '0' |first|:
                    first <- first + 1
                digits: usize = integer_end - first
                true return if digits > sview_len(limit)
                false return if digits < sview_len(limit)
                while index < digits |index: usize = 0|:
                    true return if text[first + index] > limit[index]
                    false return if text[first + index] < limit[index]
                    index <- index + 1
                return false

        def const_float_cast_invalid(target: sview, receiver: Ast::Expr) -> bool:
            can Abort.Panic:
                text: sview = const_float_text(receiver)
                false return if text == ""
                negative: bool = const_float_negative(receiver)
                true return if negative and target in {"u8", "u16", "u32", "u64", "usize", "uintptr"}
                false return if negative
                limit: sview = match target:
                    "i8": "127"
                    "i16": "32767"
                    "i32": "2147483647"
                    "i64" | "int" | "isize" | "u64" | "usize" | "uintptr": "9223372036854775807"
                    "u8": "255"
                    "u16": "65535"
                    "u32": "4294967295"
                    _: ""
                return limit != "" and decimal_integer_exceeds(text, limit)

        def check_const_float_cast_value(name: sview, declared_type: Ast::Expr, value: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        if arguments.count == 0:
                            match callee:
                                Expr.Field(receiver, target, field_line):
                                    declared_name: sview = bare_type_name(declared_type)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstFloatCastRange, name: name, line: line, expected: declared_name, actual: target}) if target == declared_name and const_float_cast_invalid(target, receiver)
                                _:
                                    pass
                    _:
                        pass

        def check_const_float_cast_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Const(name, declared_type, value, is_mutable, line):
                            table <- check_const_float_cast_value(name, declared_type, value, line, table)
                        Decl.Module(name, body, line):
                            table <- check_const_float_cast_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_const_float_cast_declarations(body, table)
                        _:
                            pass

    public:
        def check_const_float_cast(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_const_float_cast_declarations(declarations, table)
