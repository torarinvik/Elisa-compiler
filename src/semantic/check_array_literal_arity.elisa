# Array literal arity checking: ensure fixed-size array literals have the correct number of elements.
# An array declaration like `xs: [3]i64 = [1, 2, 3]` must have exactly 3 elements.
# `[1, 2]` or `[1, 2, 3, 4]` raises an error.

extend Semantic:
    private:
        # Extract the expected array size from a type expression representing a fixed-size array.
        # For `i64[3]`, this should return 3 if the type is Index(i64, IntLit(3)).
        # Returns -1 if the type does not represent a fixed-size array.
        def extract_array_size(type_expr: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.Index(object, index, line):
                        # Fixed-size array syntax: BaseType[Size]
                        # The index should be an IntLit
                        match index:
                            Expr.IntLit(size_value, _):
                                return size_value
                            _:
                                return (-1)
                    _:
                        return (-1)

        # Whether a type expression denotes a sequence (`darray[T]`, `array[T, N]`, or a
        # fixed-size `T[N]`) — used to decide whether a bare `xs = []` returned from the
        # function can adopt the return type's element type.
        def type_is_sequence(type_expr: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.Index(object, index, line):
                        # `darray[T]` / `array[T]`, or a fixed-size `T[N]` (integer-literal size).
                        base_is_container: bool = ident_name_of(object) == "darray" or ident_name_of(object) == "array"
                        is_fixed_array: bool = match index:
                            Expr.IntLit(size_value, _): true
                            _: false
                        return base_is_container or is_fixed_array
                    Expr.IndexN(object, indices, line):
                        return ident_name_of(object) == "darray" or ident_name_of(object) == "array"
                    _:
                        return false

        # Whether `name` is grown by `name.push(...)` / `name.extend(...)` anywhere in
        # `statements` (recursing into nested bodies). Such a mutation determines the
        # element type of a bare `name = []`, so stage0 accepts it — the diagnostic is
        # suppressed. Mirrors stage0's "infer element type from a later grow" rule.
        def name_is_grown(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if expression_grows_name(expression, name)
                        Stmt.VarDecl(var_name, type_expression, value, line):
                            true return if expression_grows_name(value, name)
                        Stmt.Assign(target, operator, value, line):
                            true return if expression_grows_name(value, name)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if name_is_grown(then_body, name) or name_is_grown(else_body, name)
                        Stmt.While(condition, body, line):
                            true return if name_is_grown(body, name)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if name_is_grown(body, name)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if name_is_grown(body, name)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if name_is_grown(arm.body, name)
                        _:
                            pass
                return false

        # Whether `expression` is (or contains) a `name.push(...)` / `name.extend(...)` call.
        def expression_grows_name(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                grows: bool = (method == "push" or method == "extend") and ident_name_of(receiver) == name
                                true return if grows
                            _:
                                pass
                        return any argument in arguments where expression_grows_name(argument, name)
                    Expr.Binary(left, operator, right, line):
                        return expression_grows_name(left, name) or expression_grows_name(right, name)
                    Expr.Paren(inner, line):
                        return expression_grows_name(inner, name)
                    _:
                        return false

        # Whether `name` is returned (`return name`) somewhere in `statements` — the second
        # element-type-determining use stage0 recognizes when the function return type is a
        # sequence.
        def name_is_returned(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned_value:
                                returns_name: bool = match returned_value:
                                    Expr.Ident(returned_name, ident_line): returned_name == name
                                    _: false
                                true return if returns_name
                        Stmt.If(condition, then_body, else_body, line):
                            true return if name_is_returned(then_body, name) or name_is_returned(else_body, name)
                        Stmt.While(condition, body, line):
                            true return if name_is_returned(body, name)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if name_is_returned(body, name)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if name_is_returned(body, name)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if name_is_returned(arm.body, name)
                        _:
                            pass
                return false

        # Walk through statements and check array literal arities.
        def walk_array_arity_check(statements: darray[Ast::Stmt], func_body: darray[Ast::Stmt], func_return: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Check if the type is a fixed-size array and the value is an array literal
                            expected_size: i64 = extract_array_size(type_expression)
                            if expected_size > 0:
                                # Type is a fixed-size array
                                match value:
                                    Expr.Array(elements, array_line):
                                        actual_size: i64 = elements.count.i64()
                                        if actual_size != expected_size:
                                            # Arity mismatch: push diagnostic
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArrayLiteralArity, name: name, pos: array_line, line: line.line, expected: "", actual: "", expected_count: expected_size.u32(), actual_count: actual_size.u32()})
                                    _:
                                        pass
                        Stmt.Assign(target, operator, value, line):
                            match target:
                                Expr.Ident(name, target_line):
                                    match value:
                                        Expr.Array(elements, array_line):
                                            # A bare `xs = []` has no expected element type — UNLESS a later
                                            # `xs.push(...)`/`xs.extend(...)` grow or a `return xs` (with a
                                            # sequence return type) determines it (stage0's inference rule).
                                            determined: bool = name_is_grown(func_body, name) or (name_is_returned(func_body, name) and type_is_sequence(func_return))
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyArrayWithoutContext, name: name, line: line.line, expected: "", actual: ""}) if operator == TokenKind.Assign and elements.count == 0 and not determined
                                        _:
                                            pass
                                _:
                                    pass
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_array_arity_check(then_body, func_body, func_return, table)
                            table <- walk_array_arity_check(else_body, func_body, func_return, table)
                        Stmt.While(condition, body, line):
                            table <- walk_array_arity_check(body, func_body, func_return, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_array_arity_check(body, func_body, func_return, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_array_arity_check(body, func_body, func_return, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- walk_array_arity_check(arm.body, func_body, func_return, table)
                        _:
                            pass

        # A MATCH ARM's value never receives an expected type in stage0, whatever the match
        # itself is used for -- so a bare `[]` there always fails with "empty list literal
        # requires an expected array or darray type". Measured one context at a time:
        #     return match c: … false: []                 flagged
        #     xs: darray[i64] = match c: … false: []      flagged (the annotation does NOT reach the arm)
        #     zs = match c: … false: []                   flagged
        #     match c: … false: []        (statement)     flagged
        #     return ([1] if c else [])                   accepted -- a TERNARY arm is not a match arm
        #     ys: darray[i64] = ([1] if c else [])        accepted for the `[]`
        # So the rule keys on the ARM, not on where the match sits, and leaves ternaries alone.
        def empty_list_value(expression: Ast::Expr) -> (found: bool, pos: Ast::Pos):
            can Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_pos):
                        return empty_list_value(inner)
                    Expr.Array(elements, array_pos):
                        return (elements.count == 0, array_pos)
                    _:
                        return (false, Ast::pos_at_line(0))

        def match_arms_empty_lists(arms: darray[Ast::MatchArm]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in arms |table| -> table:
                    if arm.body.count > 0:
                        if arm.body[arm.body.count - 1] is Stmt.Expr(arm_value, arm_value_pos):
                            empty: (found: bool, pos: Ast::Pos) = empty_list_value(arm_value)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyArrayWithoutContext, name: "", line: empty.pos.line, pos: empty.pos, expected: "", actual: ""}) if empty.found
                    table <- walk_match_arm_empty_lists(arm.body, table)

        def expr_match_arm_empty_lists(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Match(scrutinee, arms, match_pos):
                        table <- match_arms_empty_lists(arms, table)
                    Expr.Paren(inner, paren_pos):
                        table <- expr_match_arm_empty_lists(inner, table)
                    _:
                        pass

        def walk_match_arm_empty_lists(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- expr_match_arm_empty_lists(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- expr_match_arm_empty_lists(value, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- expr_match_arm_empty_lists(returned, table)
                        Stmt.Expr(expression, line):
                            table <- expr_match_arm_empty_lists(expression, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- match_arms_empty_lists(arms, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_match_arm_empty_lists(then_body, table)
                            table <- walk_match_arm_empty_lists(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- walk_match_arm_empty_lists(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- walk_match_arm_empty_lists(for_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_match_arm_empty_lists(body, table)
                        _:
                            pass

    public:
        # Entry point for array literal arity checking across all declarations.
        def check_array_literal_arity(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            func_return: Ast::Expr = get return_type else (Ast::Expr.Invalid)
                            table <- walk_array_arity_check(body, body, func_return, table)
                            table <- walk_match_arm_empty_lists(body, table)
                        Decl.Module(name, body, line):
                            table <- check_array_literal_arity(body, table)
                        Decl.Scoped(body, line):
                            table <- check_array_literal_arity(body, table)
                        _:
                            pass
