# Array literal arity checking: ensure fixed-size array literals have the correct number of elements.
# An array declaration like `xs: [3]i64 = [1, 2, 3]` must have exactly 3 elements.
# `[1, 2]` or `[1, 2, 3, 4]` raises an error.

extend Semantic:
    private:
        # Extract the expected array size from a type expression representing a fixed-size array.
        # For `i64[3]`, this should return 3 if the type is Index(i64, IntLit(3)).
        # Returns -1 if the type does not represent a fixed-size array.
        def extract_array_size(type_expr: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.Index(object, index, line):
                        # Fixed-size array syntax: BaseType[Size]
                        # The index should be an IntLit
                        match index:
                            Expr.IntLit(size_value):
                                return size_value
                            _:
                                return (-1)
                    _:
                        return (-1)

        # Walk through statements and check array literal arities.
        def walk_array_arity_check(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Check if the type is a fixed-size array and the value is an array literal
                            expected_size: i64 = extract_array_size(type_expression)
                            if expected_size > 0:
                                # Type is a fixed-size array
                                match value:
                                    Expr.Array(elements, array_line):
                                        actual_size: i64 = elements.count.i64()
                                        if actual_size != expected_size:
                                            # Arity mismatch: push diagnostic
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArrayLiteralArity, name: name, line: line, expected: "", actual: "", expected_count: expected_size.u32(), actual_count: actual_size.u32()})
                                    _:
                                        pass
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Ident(name, target_line) and value is Expr.Array(elements, array_line):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyArrayWithoutContext, name: name, line: line, expected: "", actual: ""}) if operator == TokenKind.Assign and elements.count == 0
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_array_arity_check(then_body, table)
                            table <- walk_array_arity_check(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_array_arity_check(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_array_arity_check(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_array_arity_check(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- walk_array_arity_check(arm.body, table)
                        _:
                            pass

    public:
        # Entry point for array literal arity checking across all declarations.
        def check_array_literal_arity(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_array_arity_check(body, table)
                        Decl.Module(name, body, line):
                            table <- check_array_literal_arity(body, table)
                        Decl.Scoped(body, line):
                            table <- check_array_literal_arity(body, table)
                        _:
                            pass
