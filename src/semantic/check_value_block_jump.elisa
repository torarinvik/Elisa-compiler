# docs/119 §2.2 rule 3 / E5, as relaxed for early exits: a `break`/`continue` inside a value
# block may leave the block for an enclosing loop (`continue if tmp < 0` inside a
# `total: i64 =` initializer). The binding simply never happens on that path, exactly as
# with the statement form. What stays illegal is leaving a block with a `|capture|` header:
# its captured values are written back only when the block ends, so a jump past that end
# would drop them. stage0 still rejects every such jump, so the relaxed forms are stage1 only.
#
# The walk carries the enclosing loops' labels (innermost last, "" for an unlabelled loop)
# and `barrier`: the loop count when the innermost capture block was entered. A jump whose
# target loop sits below the barrier crosses that block. A `'name:` label is the parser's
# `label` block wrapped around the loop statement; a jump naming no enclosing loop is
# reported here. A jump with no loop at all is left to the ordinary "outside a loop" check.
extend Semantic:
    private:
        def check_value_block_jump(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Ast::Decl.Func(func_name, func_params, func_return_type, func_body, func_effects, func_decorators, func_line):
                            table <- check_value_block_jump_statements(func_body, [], 0, table)
                        Ast::Decl.Module(module_name, module_body, module_line):
                            table <- check_value_block_jump(module_body, table)
                        Ast::Decl.Scoped(scoped_body, scoped_line):
                            table <- check_value_block_jump(scoped_body, table)
                        _:
                            pass


        def check_value_block_jump_statements(statements: darray[Ast::Stmt], labels: darray[sview], barrier: usize, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Ast::Stmt.Expr(expression, line):
                            table <- check_value_block_jump_expression(expression, labels, barrier, table)
                        Ast::Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_value_block_jump_expression(value, labels, barrier, table)
                        Ast::Stmt.Assign(target, operator, value, line):
                            table <- check_value_block_jump_expression(target, labels, barrier, table)
                            table <- check_value_block_jump_expression(value, labels, barrier, table)
                        Ast::Stmt.If(condition, then_body, else_body, line):
                            table <- check_value_block_jump_expression(condition, labels, barrier, table)
                            table <- check_value_block_jump_statements(then_body, labels, barrier, table)
                            table <- check_value_block_jump_statements(else_body, labels, barrier, table)
                        Ast::Stmt.While(condition, body, line):
                            table <- check_value_block_jump_loop(statement, "", labels, barrier, table)
                        Ast::Stmt.For(bind, variables, iterable, body, line):
                            table <- check_value_block_jump_loop(statement, "", labels, barrier, table)
                        Ast::Stmt.Block(kind, clause, binding, body, line):
                            if kind == "label" and clause.count == 1 and body.count == 1:
                                table <- check_value_block_jump_loop(body[0], clause[0], labels, barrier, table)
                            else:
                                table <- check_value_block_jump_statements(body, labels, barrier, table)
                        Ast::Stmt.Match(scrutinee, arms, line):
                            table <- check_value_block_jump_expression(scrutinee, labels, barrier, table)
                            for arm in arms |table| -> table:
                                table <- check_value_block_jump_expression(arm.guard, labels, barrier, table)
                                table <- check_value_block_jump_statements(arm.body, labels, barrier, table)
                        Ast::Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_value_block_jump_expression(return_value, labels, barrier, table)
                        Ast::Stmt.Contract(kind, expression, line):
                            table <- check_value_block_jump_expression(expression, labels, barrier, table)
                        Ast::Stmt.Invalid:
                            pass
                        Ast::Stmt.Break(label, line):
                            table <- check_value_block_jump_target("break", label, line, labels, barrier, table)
                        Ast::Stmt.Continue(label, line):
                            table <- check_value_block_jump_target("continue", label, line, labels, barrier, table)


        # A loop statement, labelled `label` ("" when unlabelled): its header is evaluated
        # outside the loop, its body one loop deeper.
        def check_value_block_jump_loop(loop_statement: Ast::Stmt, label: sview, labels: darray[sview], barrier: usize, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                inner_labels: mutable darray[sview] = [outer_label for outer_label in labels]
                inner_labels.push(label)
                match loop_statement:
                    Ast::Stmt.While(condition, body, line):
                        table <- check_value_block_jump_expression(condition, labels, barrier, table)
                        table <- check_value_block_jump_statements(body, inner_labels, barrier, table)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        table <- check_value_block_jump_expression(iterable, labels, barrier, table)
                        table <- check_value_block_jump_statements(body, inner_labels, barrier, table)
                    _:
                        table <- check_value_block_jump_statements([loop_statement], labels, barrier, table)


        # One `break`/`continue` (`label` "" for the innermost loop): the loop it names must
        # enclose it, and reaching that loop must not cross a capture block.
        def check_value_block_jump_target(keyword: sview, label: sview, line: Ast::Pos, labels: darray[sview], barrier: usize, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if labels.count == 0 and label == ""
                target: mutable i64 = labels.count.i64() - 1
                if label != "":
                    target <- -1
                    index: mutable usize = labels.count
                    while index > 0 and target < 0 |index, target|:
                        index <- index - 1
                        target <- index.i64() if labels[index] == label
                if target < 0:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ValueBlockJumpOut, name: keyword, pos: line, line: line.line, expected: "label", actual: label})
                    return
                if target.usize() < barrier:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ValueBlockJumpOut, name: keyword, pos: line, line: line.line, expected: "capture", actual: label})


        def check_value_block_jump_expression(expression: Ast::Expr, labels: darray[sview], barrier: usize, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.If(condition, then_expr, else_expr, line):
                        table <- check_value_block_jump_expression(condition, labels, barrier, table)
                        table <- check_value_block_jump_expression(then_expr, labels, barrier, table)
                        table <- check_value_block_jump_expression(else_expr, labels, barrier, table)
                    Ast::Expr.Binary(left, operator, right, line):
                        table <- check_value_block_jump_expression(left, labels, barrier, table)
                        table <- check_value_block_jump_expression(right, labels, barrier, table)
                    Ast::Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- check_value_block_jump_expression(child, labels, barrier, table)
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        table <- check_value_block_jump_expression(callee, labels, barrier, table)
                        for argument in arguments |table| -> table:
                            table <- check_value_block_jump_expression(argument, labels, barrier, table)
                    Ast::Expr.Field(object, field, line):
                        table <- check_value_block_jump_expression(object, labels, barrier, table)
                    Ast::Expr.Scope(base, name, line):
                        table <- check_value_block_jump_expression(base, labels, barrier, table)
                    Ast::Expr.Index(object, index, line):
                        table <- check_value_block_jump_expression(object, labels, barrier, table)
                        table <- check_value_block_jump_expression(index, labels, barrier, table)
                    Ast::Expr.Slice(object, low, high, line):
                        table <- check_value_block_jump_expression(object, labels, barrier, table)
                        table <- check_value_block_jump_expression(low, labels, barrier, table)
                        table <- check_value_block_jump_expression(high, labels, barrier, table)
                    Ast::Expr.IndexN(object, arguments, line):
                        table <- check_value_block_jump_expression(object, labels, barrier, table)
                        for argument in arguments |table| -> table:
                            table <- check_value_block_jump_expression(argument, labels, barrier, table)
                    Ast::Expr.Unary(operator, operand, line):
                        table <- check_value_block_jump_expression(operand, labels, barrier, table)
                    Ast::Expr.Move(operand, line):
                        table <- check_value_block_jump_expression(operand, labels, barrier, table)
                    Ast::Expr.RegionNew(operand, region, line):
                        table <- check_value_block_jump_expression(operand, labels, barrier, table)
                    Ast::Expr.Refinement(base, predicate, line):
                        table <- check_value_block_jump_expression(base, labels, barrier, table)
                        table <- check_value_block_jump_expression(predicate, labels, barrier, table)
                    # `get EXPR else break` — the recovery statements run where the `get` is.
                    Ast::Expr.GetElse(guarded, recovery, line):
                        table <- check_value_block_jump_expression(guarded, labels, barrier, table)
                        table <- check_value_block_jump_statements(recovery, labels, barrier, table)
                    Ast::Expr.Paren(inner, line):
                        table <- check_value_block_jump_expression(inner, labels, barrier, table)
                    Ast::Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- check_value_block_jump_expression(element, labels, barrier, table)
                    Ast::Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- check_value_block_jump_expression(element, labels, barrier, table)
                    Ast::Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- check_value_block_jump_expression(element, labels, barrier, table)
                    Ast::Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- check_value_block_jump_expression(entry.key, labels, barrier, table)
                            table <- check_value_block_jump_expression(entry.value, labels, barrier, table)
                    Ast::Expr.Construct(type_expression, fields, line):
                        table <- check_value_block_jump_expression(type_expression, labels, barrier, table)
                        for field in fields |table| -> table:
                            table <- check_value_block_jump_expression(field.value, labels, barrier, table)
                    Ast::Expr.RecordUpdate(base, fields, line):
                        table <- check_value_block_jump_expression(base, labels, barrier, table)
                        for field in fields |table| -> table:
                            table <- check_value_block_jump_expression(field.value, labels, barrier, table)
                    Ast::Expr.Match(scrutinee, arms, line):
                        table <- check_value_block_jump_expression(scrutinee, labels, barrier, table)
                        for arm in arms |table| -> table:
                            table <- check_value_block_jump_expression(arm.guard, labels, barrier, table)
                            table <- check_value_block_jump_statements(arm.body, labels, barrier, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Ast::Expr.Catch(scrutinee, arms, line):
                        table <- check_value_block_jump_expression(scrutinee, labels, barrier, table)
                        for arm in arms |table| -> table:
                            table <- check_value_block_jump_expression(arm.guard, labels, barrier, table)
                            table <- check_value_block_jump_statements(arm.body, labels, barrier, table)
                    Ast::Expr.Comprehension(var, iterable, condition, body, line):
                        table <- check_value_block_jump_expression(iterable, labels, barrier, table)
                        table <- check_value_block_jump_expression(condition, labels, barrier, table)
                        table <- check_value_block_jump_expression(body, labels, barrier, table)
                    # A lambda body is its own function: no enclosing loop reaches into it.
                    Ast::Expr.Lambda(parameters, body, line):
                        table <- check_value_block_jump_statements(body, [], 0, table)
                    # A value block: a jump may leave it, unless it has a `|capture|` header,
                    # whose write-back only happens at the block's end. Loops opened inside
                    # the capture block sit above the barrier, so their own jumps stay legal.
                    Ast::Expr.Block(statements, value, captures, line):
                        block_barrier: usize = labels.count if captures.count > 0 else barrier
                        table <- check_value_block_jump_statements(statements, labels, block_barrier, table)
                        table <- check_value_block_jump_expression(value, labels, block_barrier, table)
                    Ast::Expr.Invalid:
                        pass
                    Ast::Expr.Absent:
                        pass
                        pass
                    Ast::Expr.IntLit(value, _):
                        pass
                    Ast::Expr.FloatLit(text, _):
                        pass
                    Ast::Expr.StringLit(text, _):
                        pass
                    Ast::Expr.CharLit(text, _):
                        pass
                    Ast::Expr.BoolLit(value, _):
                        pass
                    Ast::Expr.Ident(name, line):
                        pass
                    Ast::Expr.ShorthandMember(parts, line):
                        pass
