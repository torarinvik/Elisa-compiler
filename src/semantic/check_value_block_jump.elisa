# docs/119 §2.2 rule 3 / E5: control flow may not jump out of a value block except through
# the function's own `return`/`raise`. A `break`/`continue` whose loop is OUTSIDE the
# block it sits in is an error — stage0's rule, at the same place: the jump is illegal
# exactly when no loop was opened between the innermost value block and the jump.
#
# `in_loop` is whether any loop encloses the current point; `escapes` is whether the
# innermost value block was entered inside a loop with no loop opened since. A loop
# resets `escapes`; a value block sets it to `in_loop`. A loop EXPRESSION lowers to a
# block around its header locals and the loop statement, so its own body's jumps sit
# one loop deeper and are never flagged. A jump with no loop at all is left to the
# ordinary "outside a loop" check.
extend Semantic:
    private:
        def check_value_block_jump(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Ast::Decl.Func(func_name, func_params, func_return_type, func_body, func_effects, func_decorators, func_line):
                            table <- check_value_block_jump_statements(func_body, false, false, table)
                        Ast::Decl.Module(module_name, module_body, module_line):
                            table <- check_value_block_jump(module_body, table)
                        Ast::Decl.Scoped(scoped_body, scoped_line):
                            table <- check_value_block_jump(scoped_body, table)
                        _:
                            pass


        def check_value_block_jump_statements(statements: darray[Ast::Stmt], in_loop: bool, escapes: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Ast::Stmt.Expr(expression, line):
                            table <- check_value_block_jump_expression(expression, in_loop, escapes, table)
                        Ast::Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_value_block_jump_expression(value, in_loop, escapes, table)
                        Ast::Stmt.Assign(target, operator, value, line):
                            table <- check_value_block_jump_expression(target, in_loop, escapes, table)
                            table <- check_value_block_jump_expression(value, in_loop, escapes, table)
                        Ast::Stmt.If(condition, then_body, else_body, line):
                            table <- check_value_block_jump_expression(condition, in_loop, escapes, table)
                            table <- check_value_block_jump_statements(then_body, in_loop, escapes, table)
                            table <- check_value_block_jump_statements(else_body, in_loop, escapes, table)
                        Ast::Stmt.While(condition, body, line):
                            table <- check_value_block_jump_expression(condition, in_loop, escapes, table)
                            table <- check_value_block_jump_statements(body, true, false, table)
                        Ast::Stmt.For(bind, variables, iterable, body, line):
                            table <- check_value_block_jump_expression(iterable, in_loop, escapes, table)
                            table <- check_value_block_jump_statements(body, true, false, table)
                        Ast::Stmt.Block(kind, clause, binding, body, line):
                            table <- check_value_block_jump_statements(body, in_loop, escapes, table)
                        Ast::Stmt.Match(scrutinee, arms, line):
                            table <- check_value_block_jump_expression(scrutinee, in_loop, escapes, table)
                            for arm in arms |table| -> table:
                                table <- check_value_block_jump_expression(arm.guard, in_loop, escapes, table)
                                table <- check_value_block_jump_statements(arm.body, in_loop, escapes, table)
                        Ast::Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_value_block_jump_expression(return_value, in_loop, escapes, table)
                        Ast::Stmt.Contract(kind, expression, line):
                            table <- check_value_block_jump_expression(expression, in_loop, escapes, table)
                        Ast::Stmt.Invalid:
                            pass
                        Ast::Stmt.Break(label, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ValueBlockJumpOut, name: "break", pos: line, line: line.line, expected: "", actual: ""}) if escapes
                        Ast::Stmt.Continue(label, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ValueBlockJumpOut, name: "continue", pos: line, line: line.line, expected: "", actual: ""}) if escapes


        def check_value_block_jump_expression(expression: Ast::Expr, in_loop: bool, escapes: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.If(condition, then_expr, else_expr, line):
                        table <- check_value_block_jump_expression(condition, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(then_expr, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(else_expr, in_loop, escapes, table)
                    Ast::Expr.Binary(left, operator, right, line):
                        table <- check_value_block_jump_expression(left, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(right, in_loop, escapes, table)
                    Ast::Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- check_value_block_jump_expression(child, in_loop, escapes, table)
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        table <- check_value_block_jump_expression(callee, in_loop, escapes, table)
                        for argument in arguments |table| -> table:
                            table <- check_value_block_jump_expression(argument, in_loop, escapes, table)
                    Ast::Expr.Field(object, field, line):
                        table <- check_value_block_jump_expression(object, in_loop, escapes, table)
                    Ast::Expr.Scope(base, name, line):
                        table <- check_value_block_jump_expression(base, in_loop, escapes, table)
                    Ast::Expr.Index(object, index, line):
                        table <- check_value_block_jump_expression(object, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(index, in_loop, escapes, table)
                    Ast::Expr.Slice(object, low, high, line):
                        table <- check_value_block_jump_expression(object, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(low, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(high, in_loop, escapes, table)
                    Ast::Expr.IndexN(object, arguments, line):
                        table <- check_value_block_jump_expression(object, in_loop, escapes, table)
                        for argument in arguments |table| -> table:
                            table <- check_value_block_jump_expression(argument, in_loop, escapes, table)
                    Ast::Expr.Unary(operator, operand, line):
                        table <- check_value_block_jump_expression(operand, in_loop, escapes, table)
                    Ast::Expr.Move(operand, line):
                        table <- check_value_block_jump_expression(operand, in_loop, escapes, table)
                    Ast::Expr.RegionNew(operand, region, line):
                        table <- check_value_block_jump_expression(operand, in_loop, escapes, table)
                    Ast::Expr.Refinement(base, predicate, line):
                        table <- check_value_block_jump_expression(base, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(predicate, in_loop, escapes, table)
                    # `get EXPR else break` — the recovery statements run where the `get` is.
                    Ast::Expr.GetElse(guarded, recovery, line):
                        table <- check_value_block_jump_expression(guarded, in_loop, escapes, table)
                        table <- check_value_block_jump_statements(recovery, in_loop, escapes, table)
                    Ast::Expr.Paren(inner, line):
                        table <- check_value_block_jump_expression(inner, in_loop, escapes, table)
                    Ast::Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- check_value_block_jump_expression(element, in_loop, escapes, table)
                    Ast::Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- check_value_block_jump_expression(element, in_loop, escapes, table)
                    Ast::Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- check_value_block_jump_expression(element, in_loop, escapes, table)
                    Ast::Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- check_value_block_jump_expression(entry.key, in_loop, escapes, table)
                            table <- check_value_block_jump_expression(entry.value, in_loop, escapes, table)
                    Ast::Expr.Construct(type_expression, fields, line):
                        table <- check_value_block_jump_expression(type_expression, in_loop, escapes, table)
                        for field in fields |table| -> table:
                            table <- check_value_block_jump_expression(field.value, in_loop, escapes, table)
                    Ast::Expr.RecordUpdate(base, fields, line):
                        table <- check_value_block_jump_expression(base, in_loop, escapes, table)
                        for field in fields |table| -> table:
                            table <- check_value_block_jump_expression(field.value, in_loop, escapes, table)
                    Ast::Expr.Match(scrutinee, arms, line):
                        table <- check_value_block_jump_expression(scrutinee, in_loop, escapes, table)
                        for arm in arms |table| -> table:
                            table <- check_value_block_jump_expression(arm.guard, in_loop, escapes, table)
                            table <- check_value_block_jump_statements(arm.body, in_loop, escapes, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Ast::Expr.Catch(scrutinee, arms, line):
                        table <- check_value_block_jump_expression(scrutinee, in_loop, escapes, table)
                        for arm in arms |table| -> table:
                            table <- check_value_block_jump_expression(arm.guard, in_loop, escapes, table)
                            table <- check_value_block_jump_statements(arm.body, in_loop, escapes, table)
                    Ast::Expr.Comprehension(var, iterable, condition, body, line):
                        table <- check_value_block_jump_expression(iterable, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(condition, in_loop, escapes, table)
                        table <- check_value_block_jump_expression(body, in_loop, escapes, table)
                    # A lambda body is its own function: no enclosing loop reaches into it.
                    Ast::Expr.Lambda(parameters, body, line):
                        table <- check_value_block_jump_statements(body, false, false, table)
                    # The value block: from here to the next loop opened inside it, a
                    # `break`/`continue` would leave the block for a loop outside it.
                    Ast::Expr.Block(statements, value, captures, line):
                        table <- check_value_block_jump_statements(statements, in_loop, in_loop, table)
                        table <- check_value_block_jump_expression(value, in_loop, in_loop, table)
                    Ast::Expr.Invalid:
                        pass
                    Ast::Expr.Absent:
                        pass
                        pass
                    Ast::Expr.IntLit(value, _):
                        pass
                    Ast::Expr.FloatLit(text, _):
                        pass
                    Ast::Expr.StringLit(text, _):
                        pass
                    Ast::Expr.CharLit(text, _):
                        pass
                    Ast::Expr.BoolLit(value, _):
                        pass
                    Ast::Expr.Ident(name, line):
                        pass
                    Ast::Expr.ShorthandMember(parts, line):
                        pass
