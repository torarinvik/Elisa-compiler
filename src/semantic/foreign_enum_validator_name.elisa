# Exact name predicate for the one compiler-generated foreign-enum conversion validator.
module ForeignEnumName:
    public:
        def is_validator_of(function_name: sview, enum_name: sview) -> bool can[Abort.Panic]:
            ensure result == (
                function_name.len == enum_name.len + "__from_c".len
                and (forall prefix_index in 0..<enum_name.len: prefix_index >= function_name.len or function_name[prefix_index] == enum_name[prefix_index])
                and (forall suffix_index in 0..<"__from_c".len: enum_name.len + suffix_index >= function_name.len or function_name[enum_name.len + suffix_index] == "__from_c"[suffix_index])
            )
            suffix: sview = "__from_c"
            return false if function_name.len != enum_name.len + suffix.len
            index: mutable usize = 0
            while index < enum_name.len |index|:
                decreases enum_name.len - index
                invariant forall prefix_index in 0..<index: function_name[prefix_index] == enum_name[prefix_index]
                invariant index <= enum_name.len
                false return if function_name[index] != enum_name[index]
                index <- index + 1
            suffix_index: mutable usize = 0
            while suffix_index < suffix.len |suffix_index|:
                decreases suffix.len - suffix_index
                invariant forall suffix_probe in 0..<suffix_index: function_name[enum_name.len + suffix_probe] == suffix[suffix_probe]
                invariant suffix_index <= suffix.len
                false return if function_name[enum_name.len + suffix_index] != suffix[suffix_index]
                suffix_index <- suffix_index + 1
            return true
