# Exact name predicate for the one compiler-generated foreign-enum conversion validator.
module ForeignEnumName:
    public:
        def is_validator_of(function_name: sview, enum_name: sview) -> bool can[Abort.Panic]:
            ensure result == (
                function_name.len >= enum_name.len
                and function_name.len - enum_name.len == "__from_c".len
                and function_name[0:enum_name.len] == enum_name
                and function_name[enum_name.len:function_name.len] == "__from_c"
            )
            return (
                function_name.len >= enum_name.len
                and function_name.len - enum_name.len == "__from_c".len
                and function_name[0:enum_name.len] == enum_name
                and function_name[enum_name.len:function_name.len] == "__from_c"
            )
