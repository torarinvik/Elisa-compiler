extend Semantic:
    private:
        # An UNNAMED view handed to a task (`submit first(buf.as_sview())`) lives until the
        # nursery/pool joins, exactly like a named one, but has no binding for the join check to
        # find. Each such argument is recorded at its submit as a synthetic alias, so growth of its
        # backing later in the body invalidates it, and the join reports it (stage0 analyzePoolStmt
        # JoinedViews spells it "buf.as_sview()"). Synthetic names come from a small static table
        # keyed by the submit line; two submits sharing a slot merge (conservative). They are
        # dropped at the join: joined tasks no longer read anything.
        def storage_view_submit_temp_name(line: u32) -> sview:
            return match line % 8:
                0: "[submit#0]"
                1: "[submit#1]"
                2: "[submit#2]"
                3: "[submit#3]"
                4: "[submit#4]"
                5: "[submit#5]"
                6: "[submit#6]"
                _: "[submit#7]"

        def storage_view_is_submit_temp(name: sview) -> bool:
            can Abort.Panic:
                return name.len == 10 and name[0] == 91.u8() and name[1] == 115.u8() and name[7] == 35.u8()

        # The spelling a report names an unnamed view by: the method or function producing it
        # (`as_sview`, `bytes_view_range`). "" for a plain binding (the named path covers it).
        def storage_view_submit_temp_label(argument: Ast::Expr) -> sview:
            can Abort.Panic:
                return match argument:
                    Expr.Paren(inner, _): storage_view_submit_temp_label(inner)
                    Expr.Call(Expr.Field(_, method, _), _, _, _): method
                    Expr.Call(Expr.Ident(called, _), _, _, _): called
                    _: ""

        def storage_view_submit_call_arguments(operand: Ast::Expr) -> darray[Ast::Expr]:
            can Memory.Allocate, Abort.Panic:
                match operand:
                    Expr.Block(block_statements, block_value, _, _):
                        return storage_view_submit_call_arguments(block_value) if block_statements.count == 0
                    Expr.Call(_, arguments, _, _):
                        return arguments
                    _:
                        pass
                return []

        # Walk the call's arguments in place instead of returning the nested darray as a
        # temporary value. The AST owns these expression views; a copied darray header has a
        # shorter inferred region and must not be mistaken for the lifetime of its elements.
        def storage_view_record_submit_arguments(expression: Ast::Expr, line: u32, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Block(block_statements, block_value, _, _):
                        return if block_statements.count != 0
                        storage_view_record_submit_arguments(block_value, line, alias_names, alias_sources, alias_is_view, view_fns)
                    Expr.Call(_, arguments, _, _):
                        for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, line|:
                            continue if storage_view_submit_temp_label(argument) == ""
                            storage_view_record_alias(storage_view_submit_temp_name(line), argument, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        def storage_view_record_submit_temps(expression: Ast::Expr, line: u32, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Block(block_statements, block_value, _, _):
                        return if block_statements.count != 0
                        storage_view_record_submit_arguments(block_value, line, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        def storage_view_check_submit_temps(operand: Ast::Expr, line: u32, invalidated: darray[sview]&, invalidated_by: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                temp: sview = storage_view_submit_temp_name(line)
                index: usize =
                    for candidate in 0..<invalidated.count |index: usize = invalidated.count| -> index:
                        index <- candidate if index == invalidated.count and invalidated[candidate] == temp
                return if index == invalidated.count
                by: sview = invalidated_by[index] if index < invalidated_by.count else ""
                arguments: darray[Ast::Expr] = storage_view_submit_call_arguments(operand)
                for argument in arguments |table, by, line|:
                    label: sview = storage_view_submit_temp_label(argument)
                    continue if label == ""
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StorageDependencyInvalidated, name: label, pos: ident_extent_or_line(argument, line), line: line, expected: by, actual: ""}) if not storage_view_already_reported(label, line, table)

        def storage_view_drop_submit_temps(alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if alias_names.count != alias_sources.count or alias_names.count != alias_is_view.count or invalidated.count != invalidated_by.count
                kept: mutable usize = 0
                for row in 0..<alias_names.count |kept, alias_names, alias_sources, alias_is_view|:
                    continue if storage_view_is_submit_temp(alias_names[row])
                    if kept != row:
                        alias_names[kept] <- alias_names[row]
                        alias_sources[kept] <- alias_sources[row]
                        alias_is_view[kept] <- alias_is_view[row]
                    kept <- kept + 1
                alias_names <- alias_names.truncate(kept)
                alias_sources <- alias_sources.truncate(kept)
                alias_is_view <- alias_is_view.truncate(kept)
                stale: mutable usize = 0
                for row in 0..<invalidated.count |stale, invalidated, invalidated_by|:
                    continue if storage_view_is_submit_temp(invalidated[row])
                    if stale != row:
                        invalidated[stale] <- invalidated[row]
                        invalidated_by[stale] <- invalidated_by[row]
                    stale <- stale + 1
                invalidated <- invalidated.truncate(stale)
                invalidated_by <- invalidated_by.truncate(stale)
