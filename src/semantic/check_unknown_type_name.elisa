# Unknown type-name checking: a type annotation (parameter, return, local `VarDecl`, or
# `const`) that names a type which does not exist. It follows the same conservative rules as
# `is_unresolved_type` in resolve_struct_layout, while filtering alias declarations that occur
# only in proven-inactive static branches. Empty names and single-letter generics (`T`) remain exempt;
# structured expressions (`darray[T]`, `T&`, `T?`, qualified `A::B`) are handled by the element
# walk or their qualified-name checks. Parity: stage0's `unknown type`.

extend Semantic:
    private:
        def unknown_type_static_scope_is_inactive(file: Ast::File&, position: Ast::Pos, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                branch_row: usize = pma_static_if_row_for_position(file, position)
                return false if branch_row >= file.static_if_lines.count
                branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                return branch.known and not branch.selected

        # Struct, enum, and opaque extern rows remain in Stage1's global symbol table
        # after parsing every static-if arm. Stage0 registers only the selected branch,
        # so exclude such a row only when its exact nominal marker proves it inactive.
        def unknown_type_nominal_declaration_is_static_inactive(file: Ast::File&, name: sview, declaration_module: sview, declaration_line: u32, declaration_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                markers: darray[Ast::EnumAnnotation] = table.unknown_nominal_markers if table.unknown_nominal_markers_active else file.enum_annotations
                for marker in markers |file, name, declaration_module, declaration_line, declaration_offset, table|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__nominal_type_static_branch" or marker.detail_name != name or marker.module != declaration_module or marker.line != declaration_line or marker.offset != declaration_offset
                    continue if marker.identity_id == 4294967295
                    branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    return true if branch.known and not branch.selected
                return false

        # Alias symbols are collected before this pass, including declarations in static
        # branches. Their parser marker carries the exact alias identity and every enclosing
        # static-if row. Unknown rows remain possible for type lookup but cannot prove a cycle.
        def unknown_type_alias_declaration_activity(file: Ast::File&, alias_name: sview, alias_module: sview, position: Ast::Pos, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                unknown: mutable bool = false
                for marker in file.enum_annotations |unknown, file, table, alias_name, alias_module, position|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__type_alias_static_branch" or marker.detail_name != alias_name or marker.module != alias_module or marker.line != position.line or marker.offset != position.offset
                    if marker.identity_id == 4294967295:
                        unknown <- true
                        continue
                    branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if not branch.known
                return (false, false) if unknown
                return (true, true)

        def unknown_type_alias_index_activity(alias_index: usize, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                return (false, true) if alias_index >= table.type_alias_name.count or alias_index >= table.type_alias_module.count or alias_index >= table.type_alias_declarations.count
                declaration: TypeAliasDeclaration = table.type_alias_declarations[alias_index]
                return (false, true) if declaration.module_owner != table.type_alias_module[alias_index]
                return unknown_type_alias_declaration_activity(file, table.type_alias_name[alias_index], declaration.module_owner, declaration.pos, table)

        def unknown_type_alias_index_is_inactive(alias_index: usize, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                activity: (known: bool, active: bool) = unknown_type_alias_index_activity(alias_index, file, table)
                return activity.known and not activity.active

        # Same classification as `is_registered_type`, with the source-owned exception
        # this pass can prove: aliases in inactive static branches do not make an otherwise
        # unknown type name valid. Unresolved aliases remain conservatively known.
        def unknown_type_is_registered(name: sview, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE |row, name, file, table|:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.name == name:
                        if symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Extern:
                            return true if not unknown_type_nominal_declaration_is_static_inactive(file, symbol.name, symbol.module_owner, symbol.line, symbol.offset, table)
                        if symbol.kind == SymbolKind.Alias:
                            alias_found: mutable bool = false
                            for index in 0..<table.type_alias_declarations.count |index, alias_found, symbol, file, table|:
                                if table.type_alias_declarations[index].declaration_id.value == symbol.id.value:
                                    alias_found <- true
                                    return true if not unknown_type_alias_index_is_inactive(index, file, table)
                            return true if not alias_found
                    row <- table.symbol_name_next[row.usize()]
                return false

        # Generic names are valid only for the declaration that owns the exact source
        # offset. Logical #line values can collide, and name-only lookup leaks a generic
        # into unrelated declarations.
        def unknown_type_is_generic(name: sview, owner_line: u32, owner_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if name == "" or owner_line >= 2147483648
                return false if table.generic_param_names.count != table.generic_param_lines.count or table.generic_param_names.count != table.generic_param_owner_offsets.count
                for index in 0..<table.generic_param_names.count |index, name, owner_line, owner_offset, table|:
                    return true if table.generic_param_lines[index] < 2147483648 and table.generic_param_lines[index] == owner_line and table.generic_param_owner_offsets[index] == owner_offset and table.generic_param_names[index] == name
                return false

        def unknown_type_is_unresolved(name: sview, file: Ast::File&, owner_line: u32, owner_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if:
                    any region_name in table.region_names where region_name == name
                    name == ""
                    unknown_type_is_generic(name, owner_line, owner_offset, table)
                return false if name.len == 1 or is_primitive_type(name) or unknown_type_is_registered(name, file, table)
                return true

        def is_protocol_constraint_name(name: sview, owner_line: u32, owner_offset: u32, table: SymbolTable&) -> bool:
            return false if name == ""
            return false if unknown_type_is_generic(name, owner_line, owner_offset, table)
            # A user STRUCT of the same name shadows a builtin protocol (`struct Index:` in a
            # file that never mentions the Index protocol). stage0 accepts such a file; naming
            # the struct as a parameter type was reported here as a constraint misuse.
            return false if struct_declares_fields(table, name)
            return interface_is_declared(table.protocol_declarations, name)

        # Resolve the bare-alias graph once per semantic pass. Iterative paths avoid
        # stack growth on long valid chains; completed nodes memoize whether following
        # their unique same-module targets reaches a cycle. Duplicate declarations and
        # non-bare targets intentionally terminate a path instead of guessing.
        def type_alias_cycle_info(file: Ast::File&, table: SymbolTable&) -> darray[bool]:
            can Memory.Allocate, Abort.Panic:
                count: usize = table.type_alias_name.count
                cycles: mutable darray[bool] = []
                state: mutable darray[u8] = []
                for index in 0..<count |cycles, state|:
                    cycles.push(false)
                    state.push(0)
                for root in 0..<count |cycles, state, count, file, table|:
                    root_activity: (known: bool, active: bool) = unknown_type_alias_index_activity(root, file, table)
                    continue if not root_activity.known or not root_activity.active
                    continue if state[root] == 2
                    path: mutable darray[usize] = []
                    current: mutable usize = root
                    reaches_cycle: mutable bool = false
                    walking: mutable bool = true
                    while walking |current, reaches_cycle, walking, path, cycles, state, count, file, table|:
                        if current >= count:
                            walking <- false
                        elif state[current] == 2:
                            reaches_cycle <- cycles[current]
                            walking <- false
                        elif state[current] == 1:
                            reaches_cycle <- true
                            walking <- false
                        else:
                            state[current] <- 1
                            path.push(current)
                            target: sview = table.type_alias_target[current] if current < table.type_alias_target.count else ""
                            current_module: sview = table.type_alias_module[current] if current < table.type_alias_module.count else ""
                            selected: mutable usize = count
                            matches: mutable usize = 0
                            uncertain: mutable bool = false
                            if target != "":
                                for candidate in 0..<count |selected, matches, uncertain, target, current_module, file, table|:
                                    candidate_module: sview = table.type_alias_module[candidate] if candidate < table.type_alias_module.count else ""
                                    if table.type_alias_name[candidate] == target and candidate_module == current_module:
                                        candidate_activity: (known: bool, active: bool) = unknown_type_alias_index_activity(candidate, file, table)
                                        if not candidate_activity.known:
                                            uncertain <- true
                                        elif candidate_activity.active:
                                            selected <- candidate
                                            matches <- matches + 1.usize()
                            if matches == 1 and not uncertain and selected < count and selected < table.type_alias_target.count:
                                current <- selected
                            else:
                                walking <- false
                    for path_index in 0..<path.count |path_index, path, cycles, state, reaches_cycle|:
                        alias_index: usize = path[path_index]
                        cycles[alias_index] <- reaches_cycle
                        state[alias_index] <- 2
                return cycles


        def type_alias_name_is_cyclic(name: sview, current_module: sview, cycles: darray[bool]&, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                selected: mutable usize = table.type_alias_name.count
                matches: mutable usize = 0
                uncertain: mutable bool = false
                for index in 0..<table.type_alias_name.count |selected, matches, uncertain, name, current_module, cycles, file, table|:
                    alias_module: sview = table.type_alias_module[index] if index < table.type_alias_module.count else ""
                    if table.type_alias_name[index] == name and alias_module == current_module:
                        activity: (known: bool, active: bool) = unknown_type_alias_index_activity(index, file, table)
                        if not activity.known:
                            uncertain <- true
                        elif activity.active:
                            selected <- index
                            matches <- matches + 1.usize()
                return false if uncertain or matches != 1 or selected >= cycles.count
                return cycles[selected]

        # `Self` is a compiler-defined receiver type, but only inside an impl scope. Keeping
        # the context explicit matters: a free `def f(x: Self)` and a struct field `x: Self`
        # are still unknown types, while `impl P for T: def f(self: Self)` is well-formed.
        def check_type_annotation(type_expression: Ast::Expr, owner_line: u32, owner_offset: u32, allow_self: bool, current_module: sview, alias_cycles: darray[bool]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                type_name: sview = bare_type_name(type_expression)
                return if allow_self and type_name == "Self"
                if type_alias_name_is_cyclic(type_name, current_module, alias_cycles, file, table):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownTypeName, name: type_name, pos: ident_extent_or_line(type_expression, expr_line(type_expression)), line: expr_line(type_expression), expected: "", actual: ""})
                    return
                if is_protocol_constraint_name(type_name, owner_line, owner_offset, table):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolRequiresConcreteType, name: type_name, pos: Ast::expr_pos(type_expression), line: expr_line(type_expression), expected: "", actual: ""})
                    return
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownTypeName, name: type_name, pos: ident_extent_or_line(type_expression, expr_line(type_expression)), line: expr_line(type_expression), expected: "", actual: ""}) if unknown_type_is_unresolved(type_name, file, owner_line, owner_offset, table)


        def check_ordinary_enum_variant_type(type_expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Field(Expr.Ident(owner, owner_line), variant, line):
                        is_packed: bool = any packed_name in table.packed_enum_names where packed_name == owner
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrdinaryEnumBareVariantType, name: owner, pos: owner_line, line: line.line, expected: variant, actual: ""}) if is_enum_name(table, owner) and enum_has_variant(table, owner, variant) and not is_packed
                    Expr.Field(Expr.Scope(owner_base, owner_name, owner_scope_pos), variant, line):
                        # `Pack::Kind.A` as a type: the enum is reached through a module path
                        # (every separator but the last `::`), so the owner is a qualified type
                        # row. Rendered with the path as written, like stage0's Spelling.
                        table <- check_qualified_enum_variant_type(type_expression, owner_name, variant, line, table)
                    _:
                        pass


        def check_qualified_enum_variant_type(type_expression: Ast::Expr, owner_name: sview, variant: sview @source, line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                dotted: mutable darray[bool] = []
                return if:
                    not type_path_collect(type_expression, names, dotted)
                    names.count < 3
                module_count: usize = names.count - 2.usize()
                for index in 0..<module_count |dotted|:
                    return if dotted[index]
                enum_in_module: mutable bool = false
                row_index: mutable usize = 0
                while row_index < table.qualified_type_name.count |row_index, enum_in_module, table, owner_name, names, module_count|:
                    enum_in_module <- true if table.qualified_type_name[row_index] == owner_name and module_symbol_matches(table.qualified_type_module[row_index], sview("", 0, 0), names, 0, module_count)
                    row_index <- row_index + 1.usize()
                return if not enum_in_module
                is_packed: bool = any packed_name in table.packed_enum_names where packed_name == owner_name
                return if is_packed or not is_enum_name(table, owner_name) or not enum_has_variant(table, owner_name, variant)
                rebind owner_text: sview, table = type_path_text(names, 0, names.count - 1.usize(), dotted, names.count, table)
                head: Ast::Pos = type_path_head_pos(type_expression)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrdinaryEnumBareVariantType, name: owner_text, pos: head, line: line.line, expected: variant, actual: ""})
        # Structural tier (Phase C, rides the interned type table): flag unresolved
        # ELEMENT type names inside a structured annotation — `darray[mysterytype]`,
        # `dict[k, mysterytype]`, `(a, mysterytype)`, `mysterytype?`, `mysterytype&` —
        # which `bare_type_name` cannot see (it returns "" for non-bare exprs). The
        # ROOT row is never flagged here (a bare `x: mysterytype` is owned by
        # check_type_annotation above — no double report). Covers statement AND
        # parameter positions (param payload lists read correctly since stage0
        # da3fb1c6 fixed brace-grower region inference).
        def check_annotation_element_types(type_expression: Ast::Expr, line: u32, owner_line: u32, owner_offset: u32, allow_self: bool, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                no_siblings: darray[sview] = []
                table <- check_annotation_element_types_with(type_expression, line, owner_line, owner_offset, no_siblings, allow_self, file, table) can Global{Read,Write}


        # Parameter positions pass the SIBLING parameter names: `i: IndexOf[xs]` uses
        # `xs` (a sibling param) as a VALUE argument to a dependent refinement, and
        # `SlotIndex[cap128]` uses a declared const — neither is a type name.
        def check_annotation_element_types_with(type_expression: Ast::Expr, line: u32, owner_line: u32, owner_offset: u32, sibling_params: darray[sview]&, allow_self: bool, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                type_id: u32 = annotation_type_id(type_expression, table) can Global{Read,Write}
                table <- check_interned_elements(type_id, type_expression, line, 0, owner_line, owner_offset, sibling_params, allow_self, file, table)


        # Whether NAME is a VALUE in scope (a declared const, or a sibling parameter) —
        # legal as a value-form type argument, never an unknown TYPE.
        def type_arg_is_value_name(name: sview, sibling_params: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if any sibling in sibling_params where sibling == name
                symbol_lookup: Semantic::Symbol? = find_symbol(table, name)
                if symbol_lookup is symbol:
                    return symbol.kind == SymbolKind.Const
                return false

        # A STATE argument rather than a type. A typestate struct's first argument names one
        # of its declared states. stage0 also pre-registers the typestate tags `Local`/
        # `Frozen`/`Joinable`/`Pending`/`Held` as representation-less builtin types
        # (analyzer_builtins.go), so a tag passed to a generic struct resolves: `Guard[Held]`,
        # `Thread[void, Joinable]`. stage0 instantiates such a phantom (`%Guard__Held`) and
        # refuses only a FIELD that must lower the tag, which instantiate_generic_struct
        # declines here too. A tag with nothing to parameterize (`x: Held`, `Frozen?`) stays
        # unknown - stage0 rejects those as well - and any other name is still checked:
        # `Guard[Missing]` is an unknown type in both compilers.
        def is_protocol_state_argument(type_id: u32, element_position: u32, name: sview, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                head: sview = interned_name(type_id, table)
                return true if element_position == 0 and any typestate_name in table.typestate_struct_names where typestate_name == head
                return is_builtin_type_name(name) and (head in {"Thread", "Task", "MutexGuard"} or unknown_type_is_registered(head, file, table))

        # Recursively flag unresolved Named ELEMENT rows of an interned type. Depth-
        # bounded defensively (interned rows are acyclic by construction).
        # The Pos of the identifier NAME inside a type annotation (`darray[mysterytype]`):
        # the interned-element walk reports by NAME, and stage0 spans the spelling.
        def type_ident_pos_in(annotation: Ast::Expr, name: sview, line: u32) -> Ast::Pos:
            can Abort.Panic:
                match annotation:
                    Expr.Ident(tip_name, tip_pos):
                        return tip_pos if tip_name == name else Ast::pos_at_line(line)
                    Expr.Index(tip_object, tip_argument, tip_index_pos):
                        tip_found: Ast::Pos = type_ident_pos_in(tip_argument, name, line)
                        return tip_found if tip_found.end_column != 0 else type_ident_pos_in(tip_object, name, line)
                    Expr.IndexN(tip_n_object, tip_n_arguments, tip_n_pos):
                        for tip_n_argument in tip_n_arguments |name, line|:
                            tip_n_found: Ast::Pos = type_ident_pos_in(tip_n_argument, name, line)
                            return tip_n_found if tip_n_found.end_column != 0
                        return type_ident_pos_in(tip_n_object, name, line)
                    Expr.Unary(tip_u_op, tip_operand, tip_u_pos):
                        return type_ident_pos_in(tip_operand, name, line)
                    Expr.Paren(tip_inner, tip_paren_pos):
                        return type_ident_pos_in(tip_inner, name, line)
                    _:
                        return Ast::pos_at_line(line)


        def check_interned_elements(type_id: u32, annotation: Ast::Expr, line: u32, depth: u32, owner_line: u32, owner_offset: u32, sibling_params: darray[sview]&, allow_self: bool, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if type_id == 0 or depth > 16
                element_count: u32 = interned_elem_count(type_id, table)
                while element_position < element_count |element_position: u32 = 0, table|:
                    element_id: u32 = interned_elem(type_id, element_position, table)
                    element_name: sview = interned_name(element_id, table) if interned_kind(element_id, table) == SemTypeKind.Named else ""
                    flagged: bool = element_name != "" and unknown_type_is_unresolved(element_name, file, owner_line, owner_offset, table) and not (allow_self and element_name == "Self") and not type_arg_is_value_name(element_name, sibling_params, table) and not is_protocol_state_argument(type_id, element_position, element_name, file, table)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownTypeName, name: element_name, pos: type_ident_pos_in(annotation, element_name, line), line: line, expected: "", actual: ""}) if flagged
                    table <- check_interned_elements(element_id, annotation, line, depth + 1, owner_line, owner_offset, sibling_params, allow_self, file, table)
                    element_position <- element_position + 1

        # Local `VarDecl` annotations, recursing into nested statement bodies. The
        # enclosing function's parameter names are threaded as `sibling_params` so a
        # value-form type argument that names a param (`head: Expr[owner]`, where `owner`
        # is a value binding filling a region/dependent parameter of `Expr`) is recognized
        # as a VALUE, not flagged as an unknown type — mirrors the parameter-position path.
        def check_unknown_types_in_body(statements: darray[Ast::Stmt], sibling_params: darray[sview]&, owner_line: u32, owner_offset: u32, allow_self: bool, current_module: sview, alias_cycles: darray[bool]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # LOCALS join the value-name set as the walk passes their declarations: a
                # region-parameterized application `Expr[arena]` names the LOCAL `arena:
                # Arena = zeroed` (and `Expr[scratch]` names a `region scratch(4096)`
                # binding) as a VALUE argument — neither is an unknown TYPE. Same
                # over-accepting stance as the sibling-param path: a name added here can
                # only MISS a true unknown, never invent one.
                scoped_names: mutable darray[sview] = []
                scoped_names.extend(sibling_params)
                for statement in statements |table, scoped_names| -> table, scoped_names:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_type_annotation(type_expression, owner_line, owner_offset, allow_self, current_module, alias_cycles, file, table)
                            table <- check_ordinary_enum_variant_type(type_expression, table)
                            table <- check_annotation_element_types_with(type_expression, line.line, owner_line, owner_offset, scoped_names, allow_self, file, table) can Global{Read,Write}
                            scoped_names.push(name)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_unknown_types_in_body(then_body, scoped_names, owner_line, owner_offset, allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                            table <- check_unknown_types_in_body(else_body, scoped_names, owner_line, owner_offset, allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                        Stmt.While(condition, body, line):
                            table <- check_unknown_types_in_body(body, scoped_names, owner_line, owner_offset, allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_unknown_types_in_body(body, scoped_names, owner_line, owner_offset, allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                        Stmt.Block(kind, clause, binding, body, line):
                            continue if kind == "static" and unknown_type_static_scope_is_inactive(file, line, current_module, table)
                            scoped_names.push(binding) if binding != ""
                            table <- check_unknown_types_in_body(body, scoped_names, owner_line, owner_offset, allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, scoped_names| -> table:
                                table <- check_unknown_types_in_body(arm.body, scoped_names, owner_line, owner_offset, allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                        _:
                            pass

        # A type-alias RHS `type NameId = TARGET` must name a KNOWN type. The only legitimate
        # capitalized bare names here are the alias's own type-params (`type Foo[Elem] = Elem`).
        # Bare targets only (non-bare `darray[T]` return "").
        def alias_target_unresolved(name: sview, alias_params: darray[sview]&, file: Ast::File&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if:
                    name == "" or name.len == 1
                    any param in alias_params where param == name
                    any region_name in table.region_names where region_name == name
                    is_primitive_type(name)
                    unknown_type_is_registered(name, file, table)
                return true

        # New parser rows bind each alias formal list to its declaration token by exact
        # (name, line, offset, identity_id). Build the ordered table once, then binary-search it
        # per alias. Keep the old global-formal fallback only for wholly legacy annotation sets.
        def alias_formal_metadata_build(annotations: darray[Ast::EnumAnnotation]&, names: mutable darray[sview]&, lines: mutable darray[u32]&, offsets: mutable darray[u32]&, identities: mutable darray[u32]&, starts: mutable darray[usize]&, counts: mutable darray[usize]&, params: mutable darray[sview]&, identity_present: mutable bool&) -> bool:
            can Memory.Allocate, Abort.Panic:
                names.clear()
                lines.clear()
                offsets.clear()
                identities.clear()
                starts.clear()
                counts.clear()
                params.clear()
                identity_present <- false
                legacy_rows: mutable bool = false
                for annotation in annotations |names, lines, offsets, identities, starts, counts, params, identity_present, legacy_rows|:
                    if annotation.owner == "__alias_owner":
                        if annotation.identity_id == 0:
                            legacy_rows <- true
                        else:
                            identity_present <- true
                            return false if annotation.identity_id.u64() != annotation.offset.u64() + 1u64
                            return false if names.count > 0 and annotation.offset <= offsets[names.count - 1]
                            names.push(annotation.name)
                            lines.push(annotation.line)
                            offsets.push(annotation.offset)
                            identities.push(annotation.identity_id)
                            starts.push(params.count)
                            counts.push(0)
                    elif annotation.owner == "__alias_param":
                        if annotation.identity_id == 0:
                            legacy_rows <- true
                        else:
                            identity_present <- true
                            return false if:
                                identities.count == 0
                                annotation.identity_id != identities[identities.count - 1]
                                annotation.line != lines[lines.count - 1]
                                annotation.offset != offsets[offsets.count - 1]
                            params.push(annotation.name)
                            counts[counts.count - 1] <- counts[counts.count - 1] + 1
                return false if legacy_rows and identity_present == true
                return names.count == lines.count and names.count == offsets.count and names.count == identities.count and names.count == starts.count and names.count == counts.count

        def alias_params_for_declaration(alias_name: sview, position: Ast::Pos, names: darray[sview]&, lines: darray[u32]&, offsets: darray[u32]&, identities: darray[u32]&, starts: darray[usize]&, counts: darray[usize]&, params: darray[sview]&, identity_present: bool, legacy_params: darray[sview]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                if not identity_present:
                    legacy_copy: mutable darray[sview] = []
                    legacy_copy.extend(legacy_params)
                    return legacy_copy
                expected_identity: u32 = 0 if position.offset == 4294967295 else position.offset + 1
                return [] if expected_identity == 0
                low: mutable usize = 0
                high: mutable usize = identities.count
                while low < high |low, high, identities, expected_identity|:
                    middle: usize = low + (high - low) / 2
                    if identities[middle] < expected_identity:
                        low <- middle + 1
                    else:
                        high <- middle
                return [] if low >= identities.count or identities[low] != expected_identity
                return [] if names[low] != alias_name or lines[low] != position.line or offsets[low] != position.offset
                result: mutable darray[sview] = []
                for index in starts[low]..<(starts[low] + counts[low]) |index, params, result|:
                    result.push(params[index])
                return result

        # Check every alias RHS, keeping module scope so same-spelled names in separate
        # declaration owners cannot create a fabricated local cycle.
        def check_alias_target_declarations(declarations: darray[Ast::Decl], alias_params: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, alias_names: darray[sview]&, alias_lines: darray[u32]&, alias_offsets: darray[u32]&, alias_identities: darray[u32]&, alias_param_starts: darray[usize]&, alias_param_counts: darray[usize]&, alias_formals: darray[sview]&, alias_identity_present: bool, current_module: sview, alias_cycles: darray[bool]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Alias(alias_name, target, alias_position):
                            target_name: sview = bare_type_name(target)
                            local_params: darray[sview] = alias_params_for_declaration(alias_name, alias_position, alias_names, alias_lines, alias_offsets, alias_identities, alias_param_starts, alias_param_counts, alias_formals, alias_identity_present, alias_params)
                            cyclic: bool = target_name != "" and type_alias_name_is_cyclic(target_name, current_module, alias_cycles, file, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownTypeName, name: target_name, pos: ident_extent_or_line(target, expr_line(target)), line: expr_line(target), expected: "", actual: ""}) if alias_target_unresolved(target_name, local_params, file, table) or cyclic
                        Decl.Module(module_name, module_body, module_line):
                            # Decl.Module names are already canonical qualified paths in
                            # the parser AST; do not join them to the current path again.
                            nested_module: sview @source = module_name
                            table <- check_alias_target_declarations(module_body, alias_params, annotations, alias_names, alias_lines, alias_offsets, alias_identities, alias_param_starts, alias_param_counts, alias_formals, alias_identity_present, nested_module, alias_cycles, file, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            continue if unknown_type_static_scope_is_inactive(file, scoped_line, current_module, table)
                            table <- check_alias_target_declarations(scoped_body, alias_params, annotations, alias_names, alias_lines, alias_offsets, alias_identities, alias_param_starts, alias_param_counts, alias_formals, alias_identity_present, current_module, alias_cycles, file, table)
                        _:
                            pass

    public:
        # Alias-RHS unknown-type entry: reads each alias's own type-param set from
        # enum_annotations by parser identity, with a compatibility fallback for legacy rows.
        def check_alias_target_type(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_params: mutable darray[sview] = []
                alias_cycles: mutable darray[bool] = type_alias_cycle_info(file, table)
                for annotation in file.enum_annotations |alias_params|:
                    alias_params.push(annotation.name) if annotation.owner == "__alias_param"
                alias_names: mutable darray[sview] = []
                alias_lines: mutable darray[u32] = []
                alias_offsets: mutable darray[u32] = []
                alias_identities: mutable darray[u32] = []
                alias_param_starts: mutable darray[usize] = []
                alias_param_counts: mutable darray[usize] = []
                alias_formals: mutable darray[sview] = []
                alias_identity_present: mutable bool = false
                alias_metadata_complete: bool = alias_formal_metadata_build(file.enum_annotations, &alias_names, &alias_lines, &alias_offsets, &alias_identities, &alias_param_starts, &alias_param_counts, &alias_formals, &alias_identity_present)
                if not alias_metadata_complete and alias_identity_present:
                    alias_names.clear()
                    alias_lines.clear()
                    alias_offsets.clear()
                    alias_identities.clear()
                    alias_param_starts.clear()
                    alias_param_counts.clear()
                    alias_formals.clear()
                table <- check_alias_target_declarations(file.top_decls, alias_params, file.enum_annotations, alias_names, alias_lines, alias_offsets, alias_identities, alias_param_starts, alias_param_counts, alias_formals, alias_identity_present, "", alias_cycles, file, table)

    private:
        # Source offsets identify the actual scope even when #line resets line numbers in
        # another included file. Both protocol and inherent implementations bind Self.
        def is_impl_scope(pos: Ast::Pos, table: SymbolTable&) -> bool:
            return any annotation in table.protocol_annotations where (annotation.owner == "__impl_scope" or annotation.owner == "__ext_concrete") and annotation.offset == pos.offset and annotation.line == pos.line

        # Entry point: check parameter, return, local, and const type annotations across all
        # declarations (recursing into modules and scoped blocks).
        def check_unknown_type_name_in(declarations: darray[Ast::Decl], allow_self: bool, current_module: sview, alias_cycles: darray[bool]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            sibling_params: mutable darray[sview] = []
                            for parameter in params |sibling_params|:
                                sibling_params.push(parameter.name)
                            for parameter in params |table| -> table:
                                table <- check_type_annotation(parameter.type_expression, line.line, line.offset, allow_self, current_module, alias_cycles, file, table)
                                table <- check_ordinary_enum_variant_type(parameter.type_expression, table)
                                table <- check_annotation_element_types_with(parameter.type_expression, line.line, line.line, line.offset, sibling_params, allow_self, file, table) can Global{Read,Write}
                            if return_type is return_type_expr:
                                table <- check_type_annotation(return_type_expr, line.line, line.offset, allow_self, current_module, alias_cycles, file, table)
                                table <- check_ordinary_enum_variant_type(return_type_expr, table)
                            table <- check_unknown_types_in_body(body, sibling_params, line.line, line.offset, allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                        Decl.Const(const_name, type_expression, value, is_mutable, const_line):
                            table <- check_type_annotation(type_expression, const_line.line, const_line.offset, allow_self, current_module, alias_cycles, file, table)
                        Decl.Enum(enum_name, enum_variants, enum_is_const, enum_storage, enum_line):
                            # A variant PAYLOAD names a type like any annotation does; nothing
                            # checked these, so `A(Thing)` was accepted silently while stage0
                            # reported it.
                            for enum_variant in enum_variants |table| -> table:
                                for payload_type in enum_variant.fields |table| -> table:
                                    table <- check_type_annotation(payload_type, enum_line.line, enum_line.offset, allow_self, current_module, alias_cycles, file, table)
                        Decl.Module(module_name, module_body, module_line):
                            # Decl.Module names are already canonical qualified paths in
                            # the parser AST; do not join them to the current path again.
                            nested_module: sview @source = module_name
                            table <- check_unknown_type_name_in(module_body, allow_self, nested_module, alias_cycles, file, table) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_line):
                            continue if unknown_type_static_scope_is_inactive(file, scoped_line, current_module, table)
                            nested_allow_self: bool = allow_self or is_impl_scope(scoped_line, table)
                            table <- check_unknown_type_name_in(scoped_body, nested_allow_self, current_module, alias_cycles, file, table) can Global{Read,Write}
                        _:
                            pass

    public:
        # Free functions and ordinary scopes have no implicit receiver type.
        def check_unknown_type_name(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                nominal_markers: mutable darray[Ast::EnumAnnotation] = []
                for marker in file.enum_annotations |nominal_markers|:
                    nominal_markers.push(marker) if marker.owner == "__static_if_branch" and marker.name == "__nominal_type_static_branch"
                table.unknown_nominal_markers <- nominal_markers
                table.unknown_nominal_markers_active <- true
                defer block:
                    table.unknown_nominal_markers_active <- false
                    table.unknown_nominal_markers <- []
                alias_cycles: mutable darray[bool] = type_alias_cycle_info(file, table)
                table <- check_unknown_type_name_in(file.top_decls, false, "", alias_cycles, file, table) can Global{Read,Write}
