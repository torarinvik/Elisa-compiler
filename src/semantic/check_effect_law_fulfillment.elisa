# Effect/composite law fulfillment (docs/85 contract algebra). A `law N forbids Effect`
# (effect law) or `law N includes A, B` (composite law) constrains a function that
# declares `fulfills N`:
#   - the function may not USE (grant, via a `can Effect:` block) any effect its fulfilled
#     effect/composite law forbids (transitively through `includes`);
#   - a composite law's `includes` may name only effect/composite laws — composing a value
#     law (`law P(...) = pred`) or a measure law (Vectorizes/NoBoundsChecks) is rejected;
#   - a composite law may not transitively include itself (a cycle).
# Parser sentinels: 3900000021 fulfills(fn->law), 3900000022 forbids(law->effect),
# 3900000023 includes(law->law), 3900000024 effect/composite-law marker, 3900000025 value-law.
extend Semantic:
    private:
        # A builtin measure law (a performance measure, not composable — docs/85 §8).
        def is_measure_law(name: sview) -> bool:
            can Abort.Panic:
                return name == "Vectorizes" or name == "NoBoundsChecks"

        # Collect every effect ref granted by a `can ...:` block anywhere in `statements`.
        def collect_effect_grants(statements: darray[Ast::Stmt], grants: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |grants|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            grants.extend(clause) if kind == "can"
                            collect_effect_grants(body, grants)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_effect_grants(then_body, grants)
                            collect_effect_grants(else_body, grants)
                        Stmt.While(condition, while_body, line):
                            collect_effect_grants(while_body, grants)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            collect_effect_grants(for_body, grants)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |grants|:
                                collect_effect_grants(arm.body, grants)
                        _:
                            pass

        # Transitively accumulate into `effects` the forbidden effects of `root` (its own
        # `forbids` plus those of every law it `includes`). `visited` guards the worklist.
        def accumulate_forbidden(root: sview, forbids_owner: darray[sview]&, forbids_effect: darray[sview]&, includes_owner: darray[sview]&, includes_law: darray[sview]&, effects: mutable darray[sview]&, visited: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if any seen in visited where seen == root
                visited.push(root)
                index: mutable usize = 0
                while index < forbids_owner.count |effects, index|:
                    effects.push(forbids_effect[index]) if forbids_owner[index] == root
                    index <- index + 1
                include_index: mutable usize = 0
                while include_index < includes_owner.count |effects, visited, include_index|:
                    accumulate_forbidden(includes_law[include_index], forbids_owner, forbids_effect, includes_owner, includes_law, effects, visited) if includes_owner[include_index] == root
                    include_index <- include_index + 1

        # Whether `law` transitively includes `target` (used to detect self-cycles).
        def law_reaches(law: sview, target: sview, includes_owner: darray[sview]&, includes_law: darray[sview]&, visited: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if any seen in visited where seen == law
                visited.push(law)
                index: mutable usize = 0
                found: mutable bool = false
                while index < includes_owner.count |found, visited, index|:
                    reached: bool = includes_owner[index] == law and (includes_law[index] == target or law_reaches(includes_law[index], target, includes_owner, includes_law, visited))
                    found <- true if reached
                    index <- index + 1
                return found

    public:
        def check_effect_law_fulfillment(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                effect_law_names: mutable darray[sview] = [a.owner for a in file.enum_annotations if a.line == 3900000024]
                value_law_names: mutable darray[sview] = [a.owner for a in file.enum_annotations if a.line == 3900000025]
                forbids_owner: mutable darray[sview] = [a.owner for a in file.enum_annotations if a.line == 3900000022]
                forbids_effect: mutable darray[sview] = [a.name for a in file.enum_annotations if a.line == 3900000022]
                includes_owner: mutable darray[sview] = [a.owner for a in file.enum_annotations if a.line == 3900000023]
                includes_law: mutable darray[sview] = [a.name for a in file.enum_annotations if a.line == 3900000023]

                # 1. `includes` target must be an effect/composite law — reject value/measure laws.
                edge_index: mutable usize = 0
                while edge_index < includes_owner.count |table, edge_index| -> table:
                    owner: sview = includes_owner[edge_index]
                    member: sview = includes_law[edge_index]
                    is_composable: bool = any law_name in effect_law_names where law_name == member
                    is_measure: bool = is_measure_law(member)
                    is_value: bool = any value_name in value_law_names where value_name == member
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CompositeLawBadMember, name: owner, expected: member, actual: "measure", line: 0}) if not is_composable and is_measure
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CompositeLawBadMember, name: owner, expected: member, actual: "value", line: 0}) if not is_composable and not is_measure and is_value
                    edge_index <- edge_index + 1

                # 2. Cycle: a composite law that transitively includes itself.
                cycle_index: mutable usize = 0
                while cycle_index < effect_law_names.count |table, cycle_index| -> table:
                    law_name: sview = effect_law_names[cycle_index]
                    reach_visited: mutable darray[sview] = []
                    cyclic: bool = law_reaches(law_name, law_name, includes_owner, includes_law, reach_visited)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CompositeLawCyclic, name: law_name, expected: "", actual: "", line: 0}) if cyclic
                    cycle_index <- cycle_index + 1

                # 3. A `fulfills SUBJECT is PROTOCOL` whose PROTOCOL is an effect law is malformed —
                #    an effect law constrains the whole function (`fulfills PROTOCOL`).
                subject_index: mutable usize = 0
                while subject_index < file.enum_annotations.count |table, subject_index| -> table:
                    subject_annotation: Ast::EnumAnnotation = file.enum_annotations[subject_index]
                    is_effect_subject: bool = subject_annotation.line == 3900000026 and (any law_name in effect_law_names where law_name == subject_annotation.name)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectLawSubject, name: subject_annotation.name, expected: "", actual: "", line: 0}) if is_effect_subject
                    subject_index <- subject_index + 1

                # 4. `EXPR is EffectLaw` in value position is malformed — apply it with `fulfills`.
                #    5. A `fulfills`ing function may not grant an effect its law forbids.
                table <- check_effect_law_fulfillment_decls(file.top_decls, file.enum_annotations, effect_law_names, forbids_owner, forbids_effect, includes_owner, includes_law, table)

    private:
        def check_effect_law_fulfillment_decls(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation], effect_law_names: darray[sview]&, forbids_owner: darray[sview]&, forbids_effect: darray[sview]&, includes_owner: darray[sview]&, includes_law: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- check_value_is_effect_law(body, effect_law_names, table)
                            grants: mutable darray[sview] = []
                            collect_effect_grants(body, grants)
                            for annotation in annotations |table, grants| -> table:
                                fulfilled_effect_law: bool = annotation.line == 3900000021 and annotation.owner == function_name and (any law_name in effect_law_names where law_name == annotation.name)
                                table <- report_forbidden_grants(function_name, annotation.name, grants, forbids_owner, forbids_effect, includes_owner, includes_law, table) if fulfilled_effect_law
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_effect_law_fulfillment_decls(module_body, annotations, effect_law_names, forbids_owner, forbids_effect, includes_owner, includes_law, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_effect_law_fulfillment_decls(scoped_body, annotations, effect_law_names, forbids_owner, forbids_effect, includes_owner, includes_law, table)
                        _:
                            pass

        # Walk a body for `EXPR is EffectLawName` in value position (a misuse — effect laws
        # apply via `fulfills`, not `is`).
        def check_value_is_effect_law_expr(expression: Ast::Expr, effect_law_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        rhs_effect_law: bool = operator == TokenKind.Is and (any known in effect_law_names where known == ident_name_of(right))
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectLawValueIs, name: ident_name_of(right), expected: "", actual: "", line: 0}) if rhs_effect_law
                        table <- check_value_is_effect_law_expr(left, effect_law_names, table)
                    Expr.Paren(inner, line):
                        table <- check_value_is_effect_law_expr(inner, effect_law_names, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_value_is_effect_law_expr(operand, effect_law_names, table)
                    _:
                        pass

        def check_value_is_effect_law(statements: darray[Ast::Stmt], effect_law_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- check_value_is_effect_law_expr(returned, effect_law_names, table)
                        Stmt.Expr(expression, line):
                            table <- check_value_is_effect_law_expr(expression, effect_law_names, table)
                        Stmt.VarDecl(name, type_expression, initializer, line):
                            table <- check_value_is_effect_law_expr(initializer, effect_law_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_value_is_effect_law_expr(condition, effect_law_names, table)
                            table <- check_value_is_effect_law(then_body, effect_law_names, table)
                            table <- check_value_is_effect_law(else_body, effect_law_names, table)
                        Stmt.While(condition, while_body, line):
                            table <- check_value_is_effect_law_expr(condition, effect_law_names, table)
                            table <- check_value_is_effect_law(while_body, effect_law_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_value_is_effect_law(body, effect_law_names, table)
                        _:
                            pass

        def report_forbidden_grants(function_name: sview, law: sview, grants: darray[sview]&, forbids_owner: darray[sview]&, forbids_effect: darray[sview]&, includes_owner: darray[sview]&, includes_law: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                forbidden: mutable darray[sview] = []
                visited: mutable darray[sview] = []
                accumulate_forbidden(law, forbids_owner, forbids_effect, includes_owner, includes_law, forbidden, visited)
                for grant in grants |table| -> table:
                    is_forbidden: bool = any forbidden_effect in forbidden where forbidden_effect == grant
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EffectLawViolation, name: function_name, expected: law, actual: grant, line: 0}) if is_forbidden
