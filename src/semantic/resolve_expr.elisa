extend Semantic:
    private:
        # Check a direct call `name(arguments...)` against the declared arity of `name`'s
        # Func symbol(s). Conservative by design -- flags ONLY when the callee name is
        # known, every symbol with that name is a Func, and the argument count fits
        # none of their [required, total] ranges. Any shadowing local, non-Func symbol
        # (extern/const/struct/builtin), labeled argument, or unknown name skips the
        # check, so an unmodeled call shape can never produce a false positive.
        # Collect the FIELD path (root→leaf) of a place expression into `out`, returning
        # whether it is a modelable field-only place. Address-of / `mutable` / `lmut`
        # prefixes are seen through; any Index/Slice/other node makes the place
        # unmodelable (returns false) so the aliasing check stays sound — it only ever
        # compares places it can match exactly, never guessing about dynamic indices.
        def place_fields(expression: Ast::Expr, out: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return true
                    Expr.Field(object, field, field_line):
                        if not place_fields(object, out):
                            return false
                        out.push(field)
                        return true
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut:
                            return place_fields(operand, out)
                        return false
                    _:
                        return false


        # Whether two argument expressions name overlapping storage: same root variable
        # and one field path a prefix of (or equal to) the other. Only field-only places
        # are compared; anything with an index/slice is treated as non-overlapping (sound
        # — we never flag unless the two places provably collide).
        def places_overlap(expression_a: Ast::Expr, expression_b: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                root_a: sview = target_root_ident(expression_a)
                root_b: sview = target_root_ident(expression_b)
                if root_a == "" or root_a != root_b:
                    return false
                fields_a: mutable darray[sview] = []
                fields_b: mutable darray[sview] = []
                if not place_fields(expression_a, fields_a):
                    return false
                if not place_fields(expression_b, fields_b):
                    return false
                min_count: usize = fields_a.count if fields_a.count < fields_b.count else fields_b.count
                while field_index < min_count |field_index: usize = 0|:
                    if fields_a[field_index] != fields_b[field_index]:
                        return false
                    field_index <- field_index + 1
                return true


        # Whether callee `function_name` declares an `lmut` parameter at positional index `position`.
        def argument_position_is_lmut(table: SymbolTable&, function_name: sview, position: usize) -> bool:
            can Abort.Panic:
                while lmut_index < table.lmut_param_owner.count |lmut_index: usize = 0|:
                    if table.lmut_param_owner[lmut_index] == function_name and table.lmut_param_pos[lmut_index].usize() == position:
                        return true
                    lmut_index <- lmut_index + 1
                return false


        # The `lmut` non-aliasing rule at a direct call site: an argument bound to an
        # `lmut` parameter may not name the same place as any other argument of the same
        # call. Conservative like the arity check — only for a uniquely-named function
        # (overloaded names can't be positionally resolved here, so they are skipped).
        def check_call_lmut_aliasing(table: lmut SymbolTable, function_name: sview, arguments: darray[Ast::Expr], line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                # Fast bail: does this name have any lmut parameter at all?
                any_lmut: bool =
                    while lmut_index < table.lmut_param_owner.count |any_lmut = false, lmut_index: usize = 0| -> any_lmut:
                        if table.lmut_param_owner[lmut_index] == function_name:
                            any_lmut <- true
                        lmut_index <- lmut_index + 1
                if not any_lmut:
                    return
                # Poison overloaded names: only a unique Func declaration binds positionally here.
                func_count: u32 =
                    while symbol_index < table.symbols.count |func_count: u32 = 0, symbol_index: usize = 0| -> func_count:
                        if table.symbols[symbol_index].name == function_name and table.symbols[symbol_index].kind == SymbolKind.Func:
                            func_count <- func_count + 1
                        symbol_index <- symbol_index + 1
                if func_count != 1:
                    return
                argument_count: usize = arguments.count
                while first_argument_index < argument_count |first_argument_index: usize = 0|:
                    while second_argument_index < argument_count |second_argument_index: usize = first_argument_index + 1|:
                        if (argument_position_is_lmut(table, function_name, first_argument_index) or argument_position_is_lmut(table, function_name, second_argument_index)) and places_overlap(arguments[first_argument_index], arguments[second_argument_index]):
                            root: sview = target_root_ident(arguments[second_argument_index])
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutAliasing, name: root, line: line, expected: "", actual: ""})
                        second_argument_index <- second_argument_index + 1
                    first_argument_index <- first_argument_index + 1


        def check_call_arity(table: lmut SymbolTable, function_name: sview, argument_count: usize, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                # docs/119 §3: the symbol scan is a multi-accumulator loop expression — the
                # header declares exactly what it computes (found a Func? did any shape fit?
                # how many Func decls, and the last one's arity range), and the tail tuple
                # binds them. `table.symbols` is only READ, so no capture is needed (the
                # loop body is pure over outer state); the diagnostic is pushed afterward.
                found_func, fits, func_count, only_min, only_max =
                    for symbol in table.symbols |found_func = false, fits = false, func_count: u32 = 0, only_min: u32 = 0, only_max: u32 = 0| -> found_func, fits, func_count, only_min, only_max:
                        if symbol.name == function_name:
                            if symbol.kind == SymbolKind.Func:
                                found_func <- true
                                func_count <- func_count + 1
                                only_min <- symbol.arity_min
                                only_max <- symbol.arity_max
                                if argument_count.u32() >= symbol.arity_min and argument_count.u32() <= symbol.arity_max:
                                    fits <- true
                            else:
                                # A non-Func symbol shares the name (constructor, extern,
                                # builtin, ...) -- callable shapes we don't model; skip.
                                fits <- true
                if found_func and not fits:
                    # When exactly one declaration and no defaults (min == max), the
                    # expected count is unambiguous — report it (stage0 parity). With
                    # overloads or defaults, keep the generic message. `expected` = "n"
                    # marks the enriched form for diagnostic_message.
                    if func_count == 1 and only_min == only_max:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: function_name, line: line, expected: "n", actual: "", expected_count: only_max, actual_count: argument_count.u32()})
                    else:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: function_name, line: line, expected: "", actual: ""})


        # Resolve every identifier in a value expression, recursing into children. Field names
        # (`object.field`) are member selectors, not references, so only the object is walked.
        #
        # Depth-guarded wrapper: every recursive re-entry (Call/Field/Index/Binary/…
        # inside `walk_expression_inner` calls `walk_expression`) passes through here, so a
        # pathologically deep AST (`a.b.b.b…` built by the postfix LOOP, which the
        # parser's own depth guard never sees) stops at WALK_DEPTH_LIMIT instead of
        # overflowing the stack. WALK_DEPTH_LIMIT is far above any real expression's
        # depth and well below the observed overflow threshold.
        # Whether an `Index`/`IndexN` receiver is a type-application field operator — `.cast`,
        # `.ref`, `.specialize`. For these the bracket holds a TYPE argument
        # (`x.cast[i64]`, `p.ref[T]`, `f.specialize[T]`), not a value to resolve; walking
        # it as a value reference falsely reports the type name as an undefined name.
        def index_receiver_is_type_application(object: Ast::Expr) -> bool:
            can Abort.Panic:
                if object is Expr.Field(field_object, field_name, field_line):
                    return field_name == "cast" or field_name == "ref" or field_name == "specialize"
                return false


        def walk_expression(expression: Ast::Expr, table: lmut SymbolTable, bound: darray[sview]&, mutable_names: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                table.walk_depth <- table.walk_depth + 1
                if table.walk_depth <= WALK_DEPTH_LIMIT:
                    table <- walk_expression_inner(expression, table, bound, mutable_names)
                table.walk_depth <- table.walk_depth - 1


        def walk_expression_inner(expression: Ast::Expr, table: lmut SymbolTable, bound: darray[sview]&, mutable_names: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        if not name_known(table, bound, name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: name, line: line, expected: "", actual: ""})
                        else:
                            # A resolved reference to a param/local: log it for
                            # tooling (globals are left to the symbol table).
                            reference_index: int = bound_last_index(bound, name)
                            if reference_index >= 0:
                                table <- record_reference(table, line, name, reference_index.usize() < table.current_param_count)
                    Expr.Call(callee, arguments, argument_names, line):
                        # `argument_names` are field/parameter labels (selectors), not value
                        # references — walk only the argument values.
                        table <- walk_expression(callee, table, bound, mutable_names)
                        for argument in arguments |table| -> table:
                            table <- walk_expression(argument, table, bound, mutable_names)
                        # Arity check for a direct unshadowed call: `f(a, b)` with a bare
                        # callee name that is not a local/param. UFCS (`recv.f(a)`),
                        # qualified (`Mod::f(...)`), specialized (`f[T](...)`), and
                        # labeled-argument calls are skipped (shapes not modeled).
                        if callee is Expr.Ident(function_name, function_line):
                            labeled: bool = any argument_name in argument_names where argument_name != ""
                            shadowed: bool = any bound_name in bound where bound_name == function_name
                            if not labeled and not shadowed:
                                table <- check_call_arity(table, function_name, arguments.count, line)
                                # lmut single-live-binding rule: no argument bound to an
                                # `lmut` parameter may alias another argument of this call.
                                table <- check_call_lmut_aliasing(table, function_name, arguments, line)
                        # Enum-constructor arity: `Enum.Variant(v1, …)` must supply
                        # exactly the declared payload count (labels allowed — the
                        # count is positional either way).
                        if callee is Expr.Field(constructor_object, constructor_field, constructor_line):
                            if constructor_object is Expr.Ident(constructor_enum_name, constructor_enum_line):
                                constructor_shadowed: bool = any bound_name in bound where bound_name == constructor_enum_name
                                if not constructor_shadowed and is_enum_name(table, constructor_enum_name):
                                    constructor_variant_index: int = enum_variant_index(table, constructor_enum_name, constructor_field)
                                    if constructor_variant_index >= 0 and arguments.count.u32() != table.enum_variant_arity[constructor_variant_index.usize()]:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VariantArity, name: constructor_field, line: line, expected: constructor_enum_name, actual: "", expected_count: table.enum_variant_arity[constructor_variant_index.usize()], actual_count: arguments.count.u32()})
                    Expr.Field(object, field, line):
                        table <- walk_expression(object, table, bound, mutable_names)
                        # `Enum.Variant` in value position: when the object is a bare
                        # unshadowed enum-type name, the member must be a variant.
                        if object is Expr.Ident(enum_name, enum_line):
                            shadowed: bool = any bound_name in bound where bound_name == enum_name
                            if not shadowed and is_enum_name(table, enum_name):
                                if not enum_has_variant(table, enum_name, field):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownVariant, name: field, line: line, expected: "", actual: ""})
                    Expr.Scope(base, name, line):
                        # `base::name` is a namespace/type path; the leading name is
                        # resolved like any reference, `::name` is a selector.
                        table <- walk_expression(base, table, bound, mutable_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression(object, table, bound, mutable_names)
                        # `x.cast[T]` / `.ref[T]` / `.specialize[T]`: the bracket is a type
                        # argument, not a value — don't resolve it as a value reference.
                        if not index_receiver_is_type_application(object):
                            table <- walk_expression(index, table, bound, mutable_names)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression(left, table, bound, mutable_names)
                        # The right operand of `is` (a refinement target/binding) and `as`
                        # (a type) is not a value reference, so it isn't resolved here.
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            table <- walk_expression(right, table, bound, mutable_names)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression(operand, table, bound, mutable_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression(inner, table, bound, mutable_names)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression(element, table, bound, mutable_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression(element, table, bound, mutable_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression(object, table, bound, mutable_names)
                        table <- walk_expression(low, table, bound, mutable_names)
                        table <- walk_expression(high, table, bound, mutable_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression(object, table, bound, mutable_names)
                        # Multi-arg type application (`x.cast[K, V]` / `.specialize[A, B]`):
                        # the brackets hold type arguments, not values — skip resolving them.
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table| -> table:
                                table <- walk_expression(argument, table, bound, mutable_names)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression(element, table, bound, mutable_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_expression(entry.key, table, bound, mutable_names)
                            table <- walk_expression(entry.value, table, bound, mutable_names)
                    Expr.Construct(type_expression, fields, line):
                        # The type is the constructor (resolves as a type/global); each
                        # field's value is a reference, but the field label is not.
                        table <- walk_expression(type_expression, table, bound, mutable_names)
                        for field in fields |table| -> table:
                            table <- walk_expression(field.value, table, bound, mutable_names)
                        # Field checks on a construction whose type is a bare identifier
                        # naming a struct with a known closed field set. Positional
                        # (unlabeled) fields are skipped — they carry no label to check.
                        struct_name: sview = construct_type_name(type_expression)
                        if struct_name != "" and struct_is_registered(table, struct_name):
                            any_positional, seen_labels =
                                for field in fields |table, any_positional = false, seen_labels: darray[sview] = []| -> any_positional, seen_labels:
                                    if field.name == "":
                                        any_positional <- true
                                        continue
                                    # UnknownField: a labeled field the struct does not declare.
                                    if not struct_has_field(table, struct_name, field.name):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownField, name: field.name, line: line, expected: struct_name, actual: ""})
                                    # DuplicateFieldInit: the same label given twice.
                                    if any seen_label in seen_labels where seen_label == field.name:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateFieldInit, name: field.name, line: line, expected: struct_name, actual: ""})
                                    else:
                                        seen_labels.push(field.name)
                            # MissingField: in PURE by-label mode (>=1 label, no positional
                            # field — positional fills fields in order, so we cannot tell
                            # which are covered), every REQUIRED field must be present.
                            if not any_positional and seen_labels.count > 0:
                                while field_row_index < table.struct_field_owner.count |field_row_index: usize = 0|:
                                    if table.struct_field_owner[field_row_index] == struct_name and table.struct_field_required[field_row_index]:
                                        required_field: sview = table.struct_field_name[field_row_index]
                                        if not any seen_label in seen_labels where seen_label == required_field:
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MissingField, name: required_field, line: line, expected: struct_name, actual: ""})
                                    field_row_index <- field_row_index + 1
                    Expr.RecordUpdate(base, fields, line):
                        # `base` is a value reference; each override value is a reference,
                        # the field label is a selector.
                        table <- walk_expression(base, table, bound, mutable_names)
                        for field in fields |table| -> table:
                            table <- walk_expression(field.value, table, bound, mutable_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression(condition, table, bound, mutable_names)
                        # An `is` refinement in the condition binds its name in the TRUE
                        # value (`if … is t: t else: …` — mirrors the statement-if rule);
                        # the else value does not see the binding.
                        then_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        gather_expression_bindings(condition, then_scope)
                        table <- walk_expression(then_expr, table, then_scope, mutable_names)
                        table <- walk_expression(else_expr, table, bound, mutable_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        # The iterable is resolved in the OUTER scope (the loop variable
                        # is not visible there); condition/body see `loop_variable` via an extended copy.
                        table <- walk_expression(iterable, table, bound, mutable_names)
                        comprehension_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        comprehension_scope.push(loop_variable)
                        table <- walk_expression(condition, table, comprehension_scope, mutable_names)
                        table <- walk_expression(body, table, comprehension_scope, mutable_names)
                    Expr.Lambda(parameters, body, line):
                        # The lambda's params + its body's own locals scope the body
                        # (flattened INSIDE the lambda — bodies are small).
                        lambda_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        lambda_scope.extend([lambda_parameter for lambda_parameter in parameters])
                        gather_locals(body, lambda_scope)
                        table <- walk_statements(body, table, lambda_scope, mutable_names)
                    Expr.Block(statements, value, captures, line):
                        # A block expression (docs/119 §2) scopes its own leading locals
                        # over both the statements and the tail value. Captured outer
                        # bindings (docs/119 §6) are licensed for mutation inside the block.
                        # E4/E10/E11 validation: check capture validity and E4 purity.
                        table <- check_value_block(expression, table, bound, mutable_names)
                        block_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                        gather_locals(statements, block_scope)
                        # Add captures to the block's scope (valid to mutate).
                        for capture in captures |block_scope|:
                            block_scope.push(capture)
                        table <- walk_statements(statements, table, block_scope, mutable_names)
                        table <- walk_expression(value, table, block_scope, mutable_names)
                    Expr.Match(scrutinee, arms, line):
                        # Match in expression position: each arm's pattern bindings (and
                        # the arm body's own locals, flattened) scope that arm only.
                        table <- walk_expression(scrutinee, table, bound, mutable_names)
                        for arm in arms |table| -> table:
                            table <- check_pattern_variants(arm.pattern, table, line)
                            arm_scope: mutable darray[sview] = [bound_name for bound_name in bound]
                            gather_pattern(arm.pattern, arm_scope)
                            gather_locals(arm.body, arm_scope)
                            table <- walk_statements(arm.body, table, arm_scope, mutable_names)
                    # Literal/invalid leaves reference nothing. Listed explicitly (no
                    # wildcard) so a new Expr variant is a compile error here, not a silent
                    # resolution gap.
                    Expr.Invalid:
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.ShorthandMember(parts, line):
                        # `.Variant` parts are enum selectors inferred from context, not
                        # value references — nothing to resolve.
                        pass
