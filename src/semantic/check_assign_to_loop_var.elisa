# Check for mutations to loop iteration variables inside loop bodies.
# A loop iteration variable is rebound at each iteration, so any mutation to it has no effect.

extend Semantic:
    private:
        # Helper: check if a TokenKind represents a mutation operator (<- or compound assigns)
        def is_mutation_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                if operator == TokenKind.LArrow:
                    return true
                elif operator == TokenKind.PlusEq:
                    return true
                elif operator == TokenKind.MinusEq:
                    return true
                elif operator == TokenKind.StarEq:
                    return true
                elif operator == TokenKind.SlashEq:
                    return true
                elif operator == TokenKind.PercentEq:
                    return true
                elif operator == TokenKind.CaretEq:
                    return true
                elif operator == TokenKind.PipeEq:
                    return true
                elif operator == TokenKind.AmpEq:
                    return true
                elif operator == TokenKind.LShiftEq:
                    return true
                elif operator == TokenKind.RShiftEq:
                    return true
                else:
                    return false


        # Helper: check if a name is in the tracked loop variable list
        def name_in_list(name: sview, list: darray[sview]) -> bool:
            can Abort.Panic:
                for tracked_name in list:
                    if tracked_name == name:
                        return true
                return false


        # Helper: remove a name from the tracked list, returning a new list
        def remove_name(name: sview, list: darray[sview]) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[sview] = []
                for item in list:
                    if item != name:
                        result.push(item)
                return result


        # Walk through statements, checking for mutations to tracked loop variables.
        # tracked_loop_vars: the set of loop variable names we're tracking
        def check_assign_to_loop_var_statements(statements: darray[Ast::Stmt], tracked_loop_vars: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                current_tracked: mutable darray[sview] = tracked_loop_vars
                for statement in statements |table|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            # Check if target is a simple identifier
                            if target is Expr.Ident(name, ident_line):
                                # Only flag mutations (<- or compound), not new bindings (=)
                                if is_mutation_operator(operator):
                                    if name_in_list(name, current_tracked):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignToLoopVar, name: name, line: line, expected: "", actual: ""})
                                elif operator == TokenKind.Assign:
                                    # A `=` assignment introduces a new local that shadows any loop variable with the same name
                                    current_tracked <- remove_name(name, current_tracked)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # A VarDecl introduces a new local that shadows any loop variable with the same name
                            current_tracked <- remove_name(name, current_tracked)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_assign_to_loop_var_statements(then_body, current_tracked, table)
                            table <- check_assign_to_loop_var_statements(else_body, current_tracked, table)
                        Stmt.While(condition, body, line):
                            table <- check_assign_to_loop_var_statements(body, current_tracked, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            # Nested loop: the inner loop's variables shadow the outer ones
                            # Build a reduced list (outer vars minus inner loop vars)
                            remaining_outer: mutable darray[sview] = []
                            for outer_var in current_tracked:
                                if not name_in_list(outer_var, variables):
                                    remaining_outer.push(outer_var)
                            # Now track the inner loop's own variables for its body
                            table <- check_assign_to_loop_var_statements(body, variables, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_assign_to_loop_var_statements(body, current_tracked, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_assign_to_loop_var_statements(arm.body, current_tracked, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Entry point: walk through all statements in function bodies
        def check_assign_to_loop_var(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_assign_to_loop_var_statements(body, [], table)
                        Decl.Module(module_name, body, line):
                            table <- check_assign_to_loop_var(body, table)
                        Decl.Scoped(body, line):
                            table <- check_assign_to_loop_var(body, table)
                        _:
                            pass
