# Check for a `match`/`when` whose scrutinee cannot be matched on at all:
#   - it infers to Void (a `-> void` call used directly as the matched value), or
#   - it infers to a firm FLOAT or BOOL, the two scalar kinds stage0 refuses.
# Void sibling of the various NonXxx/VoidXxx scrutinee-position checks (VoidCondition,
# VoidIndex, ...); the non-void half reports MatchScrutineeNotMatchable, which renders
# stage0's identical sentence with the offending type appended.

extend Semantic:
    private:
        # `catch EXPR:` desugars to a plain `Stmt.Match(scrutinee, arms, line)` (see
        # parser_stmt_pattern.elisa's `catch_statement`) — indistinguishable at this AST
        # level from a genuine `match`. Its scrutinee is a fallible call whose SUCCESS type
        # collapses to the same stored "void" as a truly-void function (the parser's
        # `parse_signature_clauses` discards the `error[...]` clause entirely, so
        # `-> void error[E]` and `-> void` are identical in the symbol table). A catch is
        # structurally marked by an `error NAME` arm, parsed as `Pattern.TypeBind("error", ...)`
        # (see `parse_pattern_primary`) — bare `_`/other patterns never produce that shape.
        # Skip the void-scrutinee check whenever any arm carries that pattern: this is the
        # only signal available to keep the check sound against catch-desugared matches.
        # Whether a scrutinee type is one stage0 refuses to `match` on. MEASURED: f64, f32
        # and bool are rejected; i64, u8, char, cstr, sview, darray, optional and struct are
        # ACCEPTED and must never fire here. The rejection is unconditional on arm shape —
        # `true:`/`false:` arms, a float literal arm, an expression-position match and a
        # `when` are all refused, so no arm inspection is needed.
        #
        # Deliberately only the two FIRM scalar kinds: Unknown and Named must stay silent,
        # since a false positive rejects a valid program.
        def match_scrutinee_is_unmatchable(scrutinee_type: InferType) -> bool:
            can Abort.Panic:
                return scrutinee_type.kind == SemTypeKind.Float or scrutinee_type.kind == SemTypeKind.Bool




        def match_arms_have_error_pattern(arms: darray[Ast::MatchArm]) -> bool:
            can Abort.Panic:
                for arm in arms:
                    is_error_arm: bool = match arm.pattern:
                        Ast::Pattern.TypeBind(bound_type, binder): bound_type == "error"
                        _: false
                    true return if is_error_arm
                return false

        # Walk through expressions, checking any nested match scrutinees.
        def walk_expression_for_void_match_scrutinee(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_void_match_scrutinee(left, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_void_match_scrutinee(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_match_scrutinee(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_void_match_scrutinee(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_void_match_scrutinee(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_void_match_scrutinee(object, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_void_match_scrutinee(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_void_match_scrutinee(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_match_scrutinee(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_match_scrutinee(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_void_match_scrutinee(object, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(low, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_void_match_scrutinee(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_match_scrutinee(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_match_scrutinee(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_void_match_scrutinee(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_void_match_scrutinee(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_void_match_scrutinee(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_match_scrutinee(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_void_match_scrutinee(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_match_scrutinee(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_void_match_scrutinee(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_void_match_scrutinee(iterable, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_void_match_scrutinee(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_void_match_scrutinee(statements, table, var_types, type_names)
                        table <- walk_expression_for_void_match_scrutinee(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        # A void scrutinee is only meaningful for a non-error match. Inference
                        # is pure, so compute the type unconditionally and guard the push.
                        match_scrutinee_type: InferType = infer_expression_type(scrutinee, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidMatchScrutinee, name: "", line: line.line, expected: "", actual: ""}) if not match_arms_have_error_pattern(arms) and match_scrutinee_type.kind == SemTypeKind.Void
                        # Judge the value being matched, NOT the raw scrutinee. The
                        # PACKED-STORE form `match node in store:` parses its scrutinee as a
                        # MEMBERSHIP binary, which infers Bool — judging that rejected 17
                        # valid packed-enum programs in stage0's own semantic suite, every
                        # one a `match … in …`. Stripping the store clause leaves `node`,
                        # which is Named and correctly stays silent. A genuine
                        # `match (a in b):` is skipped too; missing a diagnostic on that rare
                        # shape beats rejecting every packed match.
                        match_judged_type: InferType = infer_expression_type(match_scrutinee_without_store(scrutinee), var_types, type_names, table)
                        # `expected` carries the POSITION, because stage0's sentence differs by
                        # it: a STATEMENT match lists "tuple, sequence, or struct", a VALUE
                        # match "tuple, or struct" — same type, same rule, one word apart.
                        # MEASURED both ways for bool and f64.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MatchScrutineeNotMatchable, name: "", line: line.line, expected: "expr", actual: stage0_value_spelling(match_judged_type)}) if not match_arms_have_error_pattern(arms) and match_scrutinee_is_unmatchable(match_judged_type)
                        table <- walk_expression_for_void_match_scrutinee(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_void_match_scrutinee(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking match scrutinees.
        def walk_statements_for_void_match_scrutinee(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_void_match_scrutinee(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_void_match_scrutinee(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_void_match_scrutinee(target, table, var_types, type_names)
                            table <- walk_expression_for_void_match_scrutinee(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_void_match_scrutinee(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_match_scrutinee(then_body, table, var_types, type_names)
                            table <- walk_statements_for_void_match_scrutinee(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_void_match_scrutinee(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_match_scrutinee(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_void_match_scrutinee(iterable, table, var_types, type_names)
                            table <- walk_statements_for_void_match_scrutinee(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_void_match_scrutinee(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            stmt_scrutinee_type: InferType = infer_expression_type(scrutinee, var_types, type_names, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidMatchScrutinee, name: "", line: line.line, expected: "", actual: ""}) if not match_arms_have_error_pattern(arms) and stmt_scrutinee_type.kind == SemTypeKind.Void
                            # Store clause stripped first — see the expression-position note.
                            stmt_judged_type: InferType = infer_expression_type(match_scrutinee_without_store(scrutinee), var_types, type_names, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MatchScrutineeNotMatchable, name: "", line: line.line, expected: "", actual: stage0_value_spelling(stmt_judged_type)}) if not match_arms_have_error_pattern(arms) and match_scrutinee_is_unmatchable(stmt_judged_type)
                            table <- walk_expression_for_void_match_scrutinee(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_void_match_scrutinee(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_void_match_scrutinee(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_void_match_scrutinee(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_void_match_scrutinee(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_void_match_scrutinee_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_void_match_scrutinee(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_void_match_scrutinee_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_match_scrutinee_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_void_match_scrutinee(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_void_match_scrutinee_declarations(declarations, table)
