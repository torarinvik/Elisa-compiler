# Nested-region store-escape — the CONTAINER-GROWTH check: `container.push(value)` /
# `.extend(value)` whose value lives in a region nested strictly inside the container's own.
# Copy (`extend`) and move (`push`) differ, and a nested container element can carry a region
# handle out with it. Continues check_region_escape.elisa.

extend Semantic:
    private:

        # Whether the grow call is `extend` (copy semantics).
        def grow_call_is_extend(callee: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, field_line):
                        return method == "extend"
                    _:
                        return false




        # Extending scalar storage copies bytes; views, references, and aggregates
        # containing them still copy lifetime-bearing handles.
        def receiver_elements_carry_handles(annotations: darray[Ast::LocalRegionAnnotation]&, receiver: sview, line: u32, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&, use_offset: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                receiver_type: mutable u32 = 0
                annotation_lookup: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, receiver, line, use_offset, true)
                if annotation_lookup is annotation:
                    receiver_type <- region_escape_annotation_type_id(annotation.type_expression, table)
                else:
                    local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(receiver, local_names, local_types)
                    receiver_type <- region_escape_annotation_type_id(local_type.type_expression, table) if local_type.found
                while interned_kind(receiver_type, table) == SemTypeKind.Ref:
                    receiver_type <- interned_elem(receiver_type, 0, table)
                # An owning string stores copied bytes, never source-view handles.
                return false if interned_kind(receiver_type, table) == SemTypeKind.String and interned_name(receiver_type, table) == "dstr"
                return true if interned_kind(receiver_type, table) != SemTypeKind.Container
                # Missing element metadata cannot establish scalar-copy safety.
                return true if interned_elem_count(receiver_type, table) == 0
                empty_ancestors: darray[sview @source] = []
                for element_index in 0..<interned_elem_count(receiver_type, table):
                    return true if region_escape_type_id_carries_handles(interned_elem(receiver_type, element_index.u32(), table), empty_ancestors, table)
                return false




        # Report a `container.push/extend(value)` whose value region is nested strictly
        # inside (shorter-lived than) the container region.
        def region_escape_growth_call_info(callee: Ast::Expr) -> (found: bool, receiver: sview @source, operation: sview @source):
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, method, field_line):
                        may_grow: bool = when method:
                            "push" | "extend" | "reserve" | "resize" | "add" | "put" | "get_or_insert" -> true
                            _ -> false
                        return (true, region_escape_assign_target_root(object), method) if may_grow
                        return (false, "", "")
                    _:
                        return (false, "", "")



        # The container FAMILY named by a receiver's declared type ("darray"/"dict"/"set"), or ""
        # when the declaration is not visible here. stage0 prefixes the nested-growth diagnostic
        # with the family its own builtin dispatcher matched on, so the prefix has to come from
        # the receiver's TYPE. It is read straight out of the type expression, which keeps it a
        # SOURCE sview -- a Diagnostic may not carry a view into a per-frame text buffer.
        def region_growth_container_family(annotations: darray[Ast::LocalRegionAnnotation]&, receiver: sview, line: u32, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, use_offset: u32 = 0) -> sview:
            can Memory.Allocate, Abort.Panic:
                annotation_lookup: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, receiver, line, use_offset, true)
                if annotation_lookup is annotation:
                    annotated_family: sview @source = container_family_of_type(annotation.type_expression)
                    return annotated_family if annotated_family != ""
                local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(receiver, local_names, local_types)
                return container_family_of_type(local_type.type_expression) if local_type.found
                return ""




        # A field's `@region` storage qualifier is separate from its structural TypeId.
        # Apply the receiver's generic region argument and retain its lexical binder ID.
        def region_escape_receiver_storage_region(callee: Ast::Expr, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> (found: bool, region: sview, binding_id: u32):
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, method_line):
                        match receiver:
                            Expr.Field(object, field, field_line):
                                object_type_id: mutable u32 = region_escape_expression_type_id(object, local_names, local_types, table)
                                while interned_kind(object_type_id, table) == SemTypeKind.Ref:
                                    object_type_id <- interned_elem(object_type_id, 0, table)
                                owner: sview @source = interned_name(object_type_id, table)
                                # This is a projected container receiver, so the root local's
                                # region is not a safe substitute when its projected type is
                                # unresolved (qualified generic heads currently have no bare
                                # TypeId). Preserve the unknown as __auto so the caller fails
                                # closed instead of silently treating the root's region as the
                                # storage region of the nested container.
                                return (true, "__auto", 0) if owner == ""
                                field_info: (found: bool, region: sview, module: sview) = region_escape_field_region_info(owner, field, table)
                                return (false, "", 0) if not field_info.found or field_info.region == ""
                                return (true, "__auto", 0) if field_info.region == "__auto"
                                struct_identity: (found: bool, line: u32, offset: u32) = region_escape_struct_identity(owner, field_info.module, table)
                                return (true, "__auto", 0) if not struct_identity.found
                                return (true, "__auto", 0) if struct_identity.line >= 2147483648
                                return (true, "__auto", 0) if table.generic_param_lines.count != table.generic_param_names.count or table.generic_param_lines.count != table.generic_param_owner_offsets.count
                                field_region: sview @source = field_info.region
                                applied_index: mutable u32 = 0
                                matching_parameter_count: mutable u32 = 0
                                field_parameter_found: mutable bool = false
                                for row in 0..<table.generic_param_lines.count |applied_index, field_region, struct_identity, object_type_id, table|:
                                    if table.generic_param_lines[row] == struct_identity.line and table.generic_param_owner_offsets[row] == struct_identity.offset:
                                        if table.generic_param_names[row] == field_region:
                                            applied_index <- matching_parameter_count
                                            field_parameter_found <- true
                                        matching_parameter_count <- matching_parameter_count + 1
                                if field_parameter_found:
                                    # Pair each generic row with the exact struct declaration;
                                    # a #line directive can assign this owner and unrelated
                                    # functions or structs the same display line.
                                    return (true, "__auto", 0) if matching_parameter_count.usize() != interned_elem_count(object_type_id, table)
                                    if applied_index < interned_elem_count(object_type_id, table):
                                        applied_type_id: u32 = interned_elem(object_type_id, applied_index, table)
                                        if interned_kind(applied_type_id, table) == SemTypeKind.Region:
                                            region_row: usize = (applied_type_id - 1).usize()
                                            binding_id: u32 = table.type_row_region_ids[region_row] if region_row < table.type_row_region_ids.count else 0
                                            return (true, interned_name(applied_type_id, table), binding_id) if binding_id != 0
                                    # A generic storage region without a concrete Region
                                    # argument is unknown; treating its declaration name as
                                    # a local region would silently miss the escape.
                                    return (true, "__auto", 0)
                                binding_id: u32 = region_escape_region_binding_id(field_region, struct_identity.line, struct_identity.offset, table)
                                return (true, "__auto", 0) if binding_id == 0
                                return (true, field_region, binding_id)
                            _:
                                return (false, "", 0)
                    _:
                        return (false, "", 0)


        def region_escape_field_region_info(owner: sview, field: sview, table: SymbolTable&) -> (found: bool, region: sview, module: sview):
            can Abort.Panic:
                preferred_found: mutable bool = false
                preferred_count: mutable usize = 0
                preferred_region: mutable sview @source = ""
                preferred_module: mutable sview @source = ""
                fallback_found: mutable bool = false
                fallback_has_region: mutable bool = false
                fallback_region: mutable sview @source = ""
                fallback_module: mutable sview @source = ""
                fallback_count: mutable usize = 0
                row: mutable u32 = struct_field_pair_head(table, struct_field_pair_hash(owner, field))
                while row != SYMBOL_INDEX_ROW_NONE |row, preferred_found, preferred_count, preferred_region, preferred_module, fallback_found, fallback_has_region, fallback_region, fallback_module, fallback_count, owner, field, table|:
                    index: usize = row.usize()
                    if table.struct_field_owner[index] == owner and table.struct_field_name[index] == field and index < table.struct_field_region.count:
                        candidate_module: sview @source = table.struct_field_module[index] if index < table.struct_field_module.count else ""
                        candidate_region: sview @source = table.struct_field_region[index]
                        fallback_has_region <- true if candidate_region != ""
                        if candidate_module == table.current_module:
                            preferred_count <- preferred_count + 1
                            if not preferred_found:
                                preferred_found <- true
                                preferred_region <- candidate_region
                                preferred_module <- candidate_module
                        fallback_found <- true
                        fallback_region <- candidate_region
                        fallback_module <- candidate_module
                        fallback_count <- fallback_count + 1
                    row <- table.struct_field_pair_next[index]
                if preferred_count > 1:
                    return (true, "__auto", "") if fallback_has_region
                    return (false, "", "")
                # TypeIds retain a bare owner spelling, not the module that resolved it.
                # A current-module field row therefore cannot disambiguate an explicit
                # imported `Other::Box` from this module's own `Box` with the same name.
                # If both modules have a row and any row carries storage metadata, let the
                # caller report an unknown owner rather than choosing the wrong lifetime.
                return (true, "__auto", "") if fallback_count != preferred_count and fallback_has_region
                if preferred_found:
                    return (true, preferred_region, preferred_module)
                if fallback_count == 1:
                    return (fallback_found, fallback_region, fallback_module)
                return (true, "__auto", "") if fallback_has_region
                return (false, "", "")


        def region_escape_struct_identity(owner: sview, module: sview, table: SymbolTable&) -> (found: bool, line: u32, offset: u32):
            can Abort.Panic:
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                matching_structs: mutable usize = 0
                same_name_structs: mutable usize = 0
                for symbol in table.symbols:
                    if symbol.kind == SymbolKind.Struct and symbol.name == owner:
                        same_name_structs <- same_name_structs + 1
                        if symbol.module_owner == module:
                            selected_line <- symbol.line
                            selected_offset <- symbol.offset
                            matching_structs <- matching_structs + 1
                # The owner's TypeId is only its bare name, so this source table must still
                # identify one struct spelling and one module-qualified declaration. Its
                # generic rows are then joined by both source line and declaration offset.
                return (false, 0, 0) if matching_structs != 1 or same_name_structs != 1
                return (true, selected_line, selected_offset)


        def region_escape_region_binding_id(region: sview, line: u32, offset: u32, table: SymbolTable&) -> u32:
            can Abort.Panic:
                return type_region_binding_id_at(region, line, offset, table).value


        def container_family_of_type(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return container_family_of_type(operand)
                    Expr.Paren(inner, paren_line):
                        return container_family_of_type(inner)
                    Expr.Index(object, element, index_line):
                        head: sview @source = ident_name_of(object)
                        return when head:
                            "darray" | "dict" | "set" -> head
                            _ -> ""
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview @source = ident_name_of(object_n)
                        return when head_n:
                            "darray" | "dict" | "set" -> head_n
                            _ -> ""
                    _:
                        return ""




        # A mutating container operation inside a nested region uses that region's allocator
        # unless the receiver carries a more specific owner. Growing a binding from an enclosing
        # scope in the short-lived arena is unsafe even when the inserted element is a scalar: the
        # container header itself will point at backing freed when the nested region exits.
        #
        # An owner region used to END the check -- an annotated `values: ... @outer` was taken as
        # proof the growth was fine. It proves the opposite half: it says where the container's
        # storage LIVES, and says nothing about which arena this growth ALLOCATES FROM, which is
        # always the innermost active region. So `region outer:` holding `values @outer`, growing
        # it inside a nested `region scratch:`, put the new backing in `scratch` and left `values`
        # pointing at it after `scratch` was freed -- a use-after-free stage1 accepted in all three
        # spellings (annotated, unannotated, and pushing a plain literal) that stage0 rejects.
        # The owner is the CONTAINER region; compare it with the active one instead of trusting it.
        def region_escape_outer_growth(callee: Ast::Expr, line: u32, use_offset: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview @source]&, outer_locals: darray[sview @source]&, param_names: darray[sview @source]&, region_locals: darray[sview @source]&, region_local_regions: darray[sview @source]&, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> (found: bool, operation: sview @source, store_region: sview @source, container_region: sview @source):
            can Memory.Allocate, Abort.Panic:
                growth: (found: bool, receiver: sview @source, operation: sview @source) = region_escape_growth_call_info(callee)
                return (false, "", "", "") if not growth.found or growth.receiver == "" or nesting.count == 0
                store_region: sview @source = nesting[nesting.count - 1]
                owner_region: mutable sview @source = local_region_name(annotations, growth.receiver, line, use_offset, true)
                owner_region <- region_escape_local_owner_region(region_locals, region_local_regions, growth.receiver) if owner_region == ""
                field_owner: (found: bool, region: sview, binding_id: u32) = region_escape_receiver_storage_region(callee, local_names, local_types, table)
                owner_region <- field_owner.region if field_owner.found
                return (growth.found, growth.operation, store_region, owner_region) if field_owner.found and owner_region == "__auto"
                if owner_region != "":
                    # Growing a container in its OWN region takes backing from the arena that
                    # owns it: exactly right, and the overwhelmingly common case.
                    store_region_id: u32 = region_escape_region_binding_id(store_region, line, use_offset, table)
                    same_region: bool = field_owner.binding_id == store_region_id if field_owner.found and field_owner.binding_id != 0 and store_region_id != 0 else owner_region == store_region
                    return (false, "", "", "") if same_region
                    # Any OTHER owner outlives the active region, so the growth escapes. The two
                    # things an in-scope owner annotation can name are an enclosing region block
                    # (`nesting` is a true lexical ancestor stack, so being on it means ancestor --
                    # stage0's `regionIsAncestor`) and a `@r` REGION PARAM, which the caller owns
                    # and which outlives every local region. Requiring a hit on the stack silently
                    # excused the second: `def fill[@r](values: mutable darray[i64]& @r)` growing
                    # `values` inside a local `region scratch:` allocated from `scratch` and was
                    # accepted, where stage0 rejects it. Nothing else can reach here -- a name that
                    # is neither is "unknown region qualifier", including a closed sibling region.
                    # ... with one exception stage0 measures silent: an owner that is a
                    # STATEMENT-form region of the same function (`region host(4096)` with no
                    # block, so it never joins the lexical stack) is not an ancestor, and a
                    # pinned `@host` container grows in host regardless of the active block.
                    # Only a lexical ancestor block or a `@r` REGION PARAM is reported.
                    owner_on_stack: (found: bool, position: usize) = region_stack_position(nesting, owner_region)
                    owner_is_param: bool = region_escape_is_region_param(owner_region, annotations, line, use_offset)
                    return (false, "", "", "") if not owner_on_stack.found and not owner_is_param
                    return (growth.found, growth.operation, store_region, owner_region)
                # A PARAMETER's container is grown here too. This used to be exempt ("the
                # caller's container, not this function's region"), after a 2026-09-17
                # measurement of stage0 being silent on `def build(seed: mutable darray[u8]&)
                # ... region r(64): seed.push(1)`. Current stage0 rejects that shape (the
                # buffer comes from `r` and outlives it: "growing non-local storage in region
                # \"__rg_seed\""), and so does it for an `lmut` parameter, whose value is
                # threaded back (fuzz F14). param_names is still passed for the other rules.
                receiver_is_outer: bool = any name in outer_locals where name == growth.receiver
                receiver_is_global: bool = any name in mutable_globals where name == growth.receiver
                # No owner region: the container belongs to the region inferred for the function
                # body. An empty container_region is how the message renderer is told to say so.
                return (growth.found, growth.operation, store_region, "") if receiver_is_outer or receiver_is_global
                return (false, "", "", "")



        def region_escape_check_store(expression: Ast::Expr, line: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, mutable_globals: darray[sview @source]&, outer_locals: darray[sview @source]&, param_names: darray[sview @source]&, region_locals: darray[sview @source]&, region_local_regions: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        outer_growth: (found: bool, operation: sview @source, store_region: sview @source, container_region: sview @source) = region_escape_outer_growth(callee, line, call_line.offset, nesting, annotations, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, local_names, local_types, table)
                        # stage0 runs this check ONLY when the active allocation store is a
                        # `region NAME(...):` DECLARATION: `activeStoreIsLocalRegion` ends in
                        # `sym.Kind == SymbolRegion`. An `in <arena>:` block names a LOCAL (or a
                        # param) of Arena type, so stage0 skips the growth check inside one
                        # entirely — which is why `elisacore_std` compiles clean under it despite
                        # growing caller-owned containers inside `in owner:` all over collections,
                        # stores_core and the string runtime. Once `in` blocks joined the nesting
                        # stack, every one of those became a false positive here and the runtime
                        # object stopped building. A store name that resolves to a declared local
                        # is an arena value, not a region block.
                        store_is_arena_value: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(outer_growth.store_region, local_names, local_types)
                        if outer_growth.found and not store_is_arena_value.found:
                            growth_receiver: (found: bool, receiver: sview @source, operation: sview @source) = region_escape_growth_call_info(callee)
                            growth_family: sview @source = region_growth_container_family(annotations, growth_receiver.receiver, line, local_names, local_types, call_line.offset)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionNestedGrowthEscape, name: outer_growth.operation, line: line, expected: outer_growth.store_region, actual: outer_growth.container_region, detail: growth_family})
                            # NO `return` here. stage0 reports the growth and the STORE separately
                            # -- `rows.push(row)` out of an inner region both grows `rows` from the
                            # wrong arena AND puts a value that dies first inside it, and its
                            # message pair names each. Stopping at the first finding hid the second
                            # and left the pair unmatchable. The store check below is independently
                            # guarded (it needs a value with a region and a handle to carry), so a
                            # growth whose argument is a plain literal still reports only once.
                        grow: (found: bool, receiver: sview @source, value_index: usize) = grow_call_info(callee)
                        return if not grow.found or grow.receiver == "" or grow.value_index >= arguments.count
                        # `extend` copies elements: scalar bytes are safe, while views,
                        # references, and aggregates can copy shorter-lived handles.
                        is_extend: bool = grow_call_is_extend(callee)
                        return if is_extend and not receiver_elements_carry_handles(annotations, grow.receiver, line, local_names, local_types, table, call_line.offset)
                        container_region: mutable sview @source = local_region_name(annotations, grow.receiver, line, call_line.offset, true)
                        container_region <- region_escape_local_owner_region(region_locals, region_local_regions, grow.receiver) if container_region == ""
                        field_owner: (found: bool, region: sview, binding_id: u32) = region_escape_receiver_storage_region(callee, local_names, local_types, table)
                        container_region <- field_owner.region if field_owner.found
                        value_region: sview @source = region_escape_stored_or_call_region_with_elements(arguments[grow.value_index], annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, region_escape_catch_context(table))
                        return if:
                            value_region == ""
                            not region_escape_value_carries_handles(arguments[grow.value_index], annotations, line, local_names, local_types, table)
                        value_is_region_param: bool = region_escape_is_region_param(value_region, annotations, line, call_line.offset) or value_region == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
                        target_is_region_param: bool = region_escape_is_region_param(container_region, annotations, line, call_line.offset)
                        target_region_id: u32 = field_owner.binding_id if field_owner.found else region_escape_region_binding_id(container_region, line, call_line.offset, table)
                        value_region_id: u32 = region_escape_region_binding_id(value_region, line, call_line.offset, table)
                        same_region: bool = target_region_id == value_region_id if target_region_id != 0 and value_region_id != 0 else value_region == container_region
                        if value_is_region_param and target_is_region_param and not same_region:
                            # Distinct region parameters are independent caller-owned lifetimes.
                            # Neither is known to outlive the other; treating every parameter as
                            # longer-lived than every other parameter lets a callee retain a
                            # borrowed nested container after its source region has ended.
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: container_region, actual: value_region})
                            return
                        value_position: (found: bool, position: usize) = region_stack_position(nesting, value_region)
                        target_is_outer_local: bool = any outer_name in outer_locals where outer_name == grow.receiver
                        if container_region == "" and target_is_outer_local:
                            container_region <- "__auto"
                        if container_region == "__auto" and value_position.found:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: container_region, actual: value_region})
                            return
                        return if container_region == "" or same_region
                        container_position: (found: bool, position: usize) = region_stack_position(nesting, container_region)
                        escapes: bool = container_position.found and value_position.found and container_position.position < value_position.position
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: container_region, actual: value_region}) if escapes
                    Expr.GetElse(guarded, _, _):
                        # The guarded success path is still the expression's value. Keep
                        # checking its root call for a container growth/store just as if
                        # the GetElse wrapper were absent; its recovery statements are
                        # walked separately by region_escape_walk.
                        table <- region_escape_check_store(guarded, line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, element_taint_names, element_taint_regions, local_names, local_types, table)
                    _:
                        pass



        # Whether copying `value` out of its region can carry a REGION HANDLE with it.
        # stage0 flags only stores that smuggle a reference: a whole container value (a bare
        # ident, a builder call), or a projection whose ELEMENT itself is a container. A
        # scalar or POD-struct projection (`items[0].kind`, `items[0]` of `darray[Pod]`) is
        # a VALUE COPY and perfectly legal — flagging those blocked the compiler's own
        # scalar copy-out of inferred type args. Unknown shapes stay conservative-true;
        # only a known scalar/POD projection establishes that the copy carries no handle.
        def region_escape_local_type_find(name: sview, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&) -> (found: bool, type_expression: Ast::Expr):
            can Abort.Panic:
                while index > 0 |index: usize = local_names.count|:
                    index <- index - 1
                    if local_names[index] == name:
                        return (true, local_types[index]) if index < local_types.count
                        return (true, Ast::Expr.Absent)
                return (false, Ast::Expr.Absent)




        def region_escape_type_head_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, _): name
                    Expr.Unary(_, operand, _): region_escape_type_head_name(operand)
                    Expr.Refinement(base, _, _): region_escape_type_head_name(base)
                    _: ""




        def region_escape_named_type_id(name: sview, table: SymbolTable&) -> u32:
            can Abort.Panic:
                for index in 0..<table.type_row_kind.count:
                    if table.type_row_name[index] == name and table.type_row_elem_count[index] == 0:
                        return (index + 1).u32()
                return 0


        # Read the already-interned annotation; never erase ref/container wrappers when
        # deciding whether a value can carry a lifetime. An unavailable row is unknown.
        def region_escape_annotation_type_id(expression: Ast::Expr, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return region_escape_named_type_id(name, table)
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        return region_escape_annotation_type_id(inner, table)
                    Expr.Unary(operator, operand, _):
                        return region_escape_annotation_type_id(operand, table) if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return 0 if operator != TokenKind.Ampersand and operator != TokenKind.Question
                        kind: SemTypeKind = SemTypeKind.Ref if operator == TokenKind.Ampersand else SemTypeKind.Optional
                        name: sview @source = "ref" if operator == TokenKind.Ampersand else "optional"
                        elements: darray[u32] = [region_escape_annotation_type_id(operand, table)]
                        for row in 0..<table.type_row_kind.count:
                            return (row + 1).u32() if type_row_matches(row, kind, name, elements, table)
                        return 0
                    Expr.Index(head, argument, _):
                        name: sview @source = ident_name_of(head)
                        element: u32 = region_escape_annotation_argument_type_id(argument, table)
                        if argument is Expr.IntLit(_, _):
                            elements: darray[u32] = [region_escape_annotation_type_id(head, table)]
                            for row in 0..<table.type_row_kind.count:
                                return (row + 1).u32() if type_row_matches(row, SemTypeKind.Container, "array", elements, table)
                            return 0
                        elements: darray[u32] = [element]
                        for row in 0..<table.type_row_kind.count:
                            return (row + 1).u32() if type_row_matches(row, SemTypeKind.Container, name, elements, table)
                        return 0
                    # A MULTI-argument annotation: `dict[K, V]`, a user generic `Foo[A, B]`, and
                    # the prefix fixed-array spelling `array[T, N]`. Without this arm every one of
                    # them resolved to TypeId 0, which the handle classifier must read
                    # conservatively -- so `items: array[Holder, 2]` inside a `region` block made
                    # even a plain `out <- items[0].count` (an i32 COPY) look like a region escape.
                    # Only the postfix `T[N]` spelling reached the array row above.
                    Expr.IndexN(head, arguments, _):
                        name: sview @source = ident_name_of(head)
                        # MIRRORS annotation_type_id's IndexN arm in type_table.elisa, which is
                        # what actually interned the row this lookup has to find: every argument
                        # contributes an element (a non-type one, like the `2` in `array[T, 2]`,
                        # interns as 0), except `darray[T, shape]` where the shape is a value
                        # binding and only the element type counts. Building a ONE-element list
                        # for `array[T, N]` -- the shape the postfix `T[N]` spelling produces --
                        # matched no row and left the annotation unresolved, which is the bug
                        # this arm exists to fix. Keep the two in lockstep.
                        argument_total: usize = arguments.count
                        type_argument_count: usize = 1 if name == "darray" and argument_total == 2 else argument_total
                        elements: mutable darray[u32] = []
                        while argument_position < type_argument_count |argument_position: usize = 0, elements|:
                            elements.push(region_escape_annotation_argument_type_id(arguments[argument_position], table))
                            argument_position <- argument_position + 1
                        for row in 0..<table.type_row_kind.count:
                            return (row + 1).u32() if type_row_matches(row, SemTypeKind.Container, name, elements, table)
                        return 0
                    _:
                        return 0




        # Region names inside generic type applications are represented by canonical
        # Region TypeIds, not ordinary Named rows. Resolve the already-interned row so
        # projected generic fields retain the applied lexical binder identity.
        def region_escape_annotation_argument_type_id(argument: Ast::Expr, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match argument:
                    Expr.Ident(name, position):
                        if any known_region in table.region_names where known_region == name:
                            binding_id: u32 = region_escape_region_binding_id(name, position.line, position.offset, table)
                            selected: mutable u32 = 0
                            matches: mutable usize = 0
                            for row in 0..<table.type_row_kind.count:
                                if table.type_row_kind[row] == SemTypeKind.Region and table.type_row_name[row] == name and row < table.type_row_region_ids.count:
                                    if table.type_row_region_ids[row] == binding_id:
                                        selected <- (row + 1).u32()
                                        matches <- matches + 1
                            return selected if binding_id != 0 and matches > 0
                            return selected if binding_id == 0 and matches == 1
                    _:
                        pass
                return region_escape_annotation_type_id(argument, table)




        # Resolve the declared type of the small expression subset needed for a projection.
        # Unknown expressions return TypeId 0, which the handle classifier treats
        # conservatively; this pass must never guess that an opaque projection is scalar.
        def region_escape_expression_type_id(expression: Ast::Expr, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(name, local_names, local_types)
                        if local_type.found:
                            match local_type.type_expression:
                                Expr.Absent:
                                    return 0
                                _:
                                    return region_escape_annotation_type_id(local_type.type_expression, table)
                        return global_type_id_of(name, table)
                    Expr.Paren(inner, paren_line) | Expr.Move(inner, move_line):
                        return region_escape_expression_type_id(inner, local_names, local_types, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        return region_escape_named_type_id(region_escape_type_head_name(type_expression), table)
                    Expr.RecordUpdate(base, fields, update_line):
                        return region_escape_expression_type_id(base, local_names, local_types, table)
                    Expr.Field(object, field, field_line):
                        # Container metadata is a scalar copy, not a borrow of backing.
                        # Resolve the receiver first: a user struct's field named count
                        # may itself contain references and must keep normal field lookup.
                        owner_type_id: mutable u32 = region_escape_expression_type_id(object, local_names, local_types, table)
                        while interned_kind(owner_type_id, table) == SemTypeKind.Ref:
                            owner_type_id <- interned_elem(owner_type_id, 0, table)
                        if interned_kind(owner_type_id, table) == SemTypeKind.Container and (field == "count" or field == "capacity"):
                            owner_container: sview @source = interned_name(owner_type_id, table)
                            if owner_container == "darray" or owner_container == "dict" or owner_container == "set":
                                return region_escape_named_type_id("usize", table)
                        # ONE walk of `object`, not two. This arm used to ALSO call
                        # region_escape_expression_type_name(object), and that function's own Field
                        # arm calls straight back into this one on the WHOLE expression -- so every
                        # link cost T(n) = T(n-1) + T(n-1), i.e. 2^links. MEASURED 2026-09-17: the
                        # internal-suite corpus's 270-link chain.elisa never finished and hung that
                        # gate for hours; 26 links took ~1s and every two more quadrupled it.
                        # Localized by disabling halves of check_full_diagnostics (six builds) down
                        # to check_region_escape's group, then to this pair of mutually recursive
                        # helpers. See test/repro/field_chain_exponential_*.elisa.
                        #
                        # `owner_type_id` IS the object's type, already resolved and already
                        # ref-unwrapped just above, and the name function's Field/Index arms do
                        # nothing but interned_name() of exactly that id -- so reading the name off
                        # the id we hold is the same answer without the second descent.
                        owner_name: sview @source = interned_name(owner_type_id, table) if owner_type_id != 0 else ""
                        return region_escape_field_type_id(owner_name, field, table) if owner_name != "" else 0
                    Expr.Index(object, index, index_line):
                        object_type_id: mutable u32 = region_escape_expression_type_id(object, local_names, local_types, table)
                        while interned_kind(object_type_id, table) == SemTypeKind.Ref:
                            object_type_id <- interned_elem(object_type_id, 0, table)
                        # Builtin string-view indexing returns a copied byte, represented
                        # as i64, rather than a reference into the backing region.
                        if object_type_id != 0 and object_type_id == region_escape_named_type_id("sview", table):
                            return region_escape_named_type_id("i64", table)
                        if interned_kind(object_type_id, table) == SemTypeKind.Container:
                            element_position: u32 = 1 if interned_name(object_type_id, table) == "dict" else 0
                            return interned_elem(object_type_id, element_position, table)
                        return 0
                    _:
                        return 0




        def region_escape_expression_type_name(expression: Ast::Expr, local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(name, local_names, local_types)
                        return region_escape_type_head_name(local_type.type_expression) if local_type.found
                        return interned_name(global_type_id_of(name, table), table)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return region_escape_expression_type_name(inner, local_names, local_types, table)
                    Expr.Construct(type_expression, _, _):
                        return region_escape_type_head_name(type_expression)
                    Expr.RecordUpdate(base, _, _):
                        return region_escape_expression_type_name(base, local_names, local_types, table)
                    Expr.Field(object, field, _):
                        field_id: u32 = region_escape_expression_type_id(expression, local_names, local_types, table)
                        return interned_name(field_id, table) if field_id != 0
                        return ""
                    Expr.Index(object, _, _):
                        element_id: u32 = region_escape_expression_type_id(expression, local_names, local_types, table)
                        return interned_name(element_id, table)
                    _:
                        return ""
