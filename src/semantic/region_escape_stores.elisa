# Nested-region store-escape — the CONTAINER-GROWTH check: `container.push(value)` /
# `.extend(value)` whose value lives in a region nested strictly inside the container's own.
# Copy (`extend`) and move (`push`) differ, and a nested container element can carry a region
# handle out with it. Continues check_region_escape.elisa.

extend Semantic:
    private:

        # Whether the grow call is `extend` (copy semantics).
        def grow_call_is_extend(callee: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, field_line):
                        return method == "extend"
                    _:
                        return false




        # Whether RECEIVER's declared element type is itself a container (`darray[darray[u8]]`):
        # extending it copies region handles, not bytes.
        def receiver_elements_are_containers(annotations: darray[Ast::LocalRegionAnnotation]&, receiver: sview, line: u32, local_names: darray[sview]&, local_types: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                annotation_lookup: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, receiver, line)
                if annotation_lookup is annotation:
                    return container_element_is_container(annotation.type_expression)
                local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(receiver, local_names, local_types)
                return container_element_is_container(local_type.type_expression) if local_type.found
                return false




        def container_element_is_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return container_element_is_container(operand)
                    Expr.Paren(inner, paren_line):
                        return container_element_is_container(inner)
                    Expr.Index(object, element, index_line):
                        head: sview = ident_name_of(object)
                        false return if head != "darray" and head != "dict"
                        return annotation_is_container(element)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        false return if head_n != "darray" and head_n != "dict"
                        return any argument in arguments_n where annotation_is_container(argument)
                    _:
                        return false




        # Report a `container.push/extend(value)` whose value region is nested strictly
        # inside (shorter-lived than) the container region.
        def region_escape_growth_call_info(callee: Ast::Expr) -> (found: bool, receiver: sview, operation: sview):
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, method, field_line):
                        may_grow: bool = method == "push" or method == "extend" or method == "reserve" or method == "resize" or method == "add" or method == "put" or method == "get_or_insert"
                        return (true, region_escape_assign_target_root(object), method) if may_grow
                        return (false, sview("", 0, 0), sview("", 0, 0))
                    _:
                        return (false, sview("", 0, 0), sview("", 0, 0))



        # The container FAMILY named by a receiver's declared type ("darray"/"dict"/"set"), or ""
        # when the declaration is not visible here. stage0 prefixes the nested-growth diagnostic
        # with the family its own builtin dispatcher matched on, so the prefix has to come from
        # the receiver's TYPE. It is read straight out of the type expression, which keeps it a
        # SOURCE sview -- a Diagnostic may not carry a view into a per-frame text buffer.
        def region_growth_container_family(annotations: darray[Ast::LocalRegionAnnotation]&, receiver: sview, line: u32, local_names: darray[sview]&, local_types: darray[Ast::Expr]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                annotation_lookup: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, receiver, line)
                if annotation_lookup is annotation:
                    annotated_family: sview = container_family_of_type(annotation.type_expression)
                    return annotated_family if annotated_family != ""
                local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(receiver, local_names, local_types)
                return container_family_of_type(local_type.type_expression) if local_type.found
                return ""




        def container_family_of_type(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return container_family_of_type(operand)
                    Expr.Paren(inner, paren_line):
                        return container_family_of_type(inner)
                    Expr.Index(object, element, index_line):
                        head: sview = ident_name_of(object)
                        return head if head == "darray" or head == "dict" or head == "set"
                        return ""
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        return head_n if head_n == "darray" or head_n == "dict" or head_n == "set"
                        return ""
                    _:
                        return ""




        # A mutating container operation inside a nested region uses that region's allocator
        # unless the receiver carries a more specific owner. Growing a binding from an enclosing
        # scope in the short-lived arena is unsafe even when the inserted element is a scalar: the
        # container header itself will point at backing freed when the nested region exits.
        #
        # An owner region used to END the check -- an annotated `values: ... @outer` was taken as
        # proof the growth was fine. It proves the opposite half: it says where the container's
        # storage LIVES, and says nothing about which arena this growth ALLOCATES FROM, which is
        # always the innermost active region. So `region outer:` holding `values @outer`, growing
        # it inside a nested `region scratch:`, put the new backing in `scratch` and left `values`
        # pointing at it after `scratch` was freed -- a use-after-free stage1 accepted in all three
        # spellings (annotated, unannotated, and pushing a plain literal) that stage0 rejects.
        # The owner is the CONTAINER region; compare it with the active one instead of trusting it.
        def region_escape_outer_growth(callee: Ast::Expr, line: u32, nesting: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview]&, outer_locals: darray[sview]&, region_locals: darray[sview]&, region_local_regions: darray[sview]&) -> (found: bool, operation: sview, store_region: sview, container_region: sview):
            can Memory.Allocate, Abort.Panic:
                growth: (found: bool, receiver: sview, operation: sview) = region_escape_growth_call_info(callee)
                return (false, sview("", 0, 0), sview("", 0, 0), sview("", 0, 0)) if not growth.found or growth.receiver == "" or nesting.count == 0
                store_region: sview = nesting[nesting.count - 1]
                owner_region: mutable sview = local_region_name(annotations, growth.receiver, line)
                owner_region <- region_escape_local_owner_region(region_locals, region_local_regions, growth.receiver) if owner_region == ""
                if owner_region != "":
                    # Growing a container in its OWN region takes backing from the arena that
                    # owns it: exactly right, and the overwhelmingly common case.
                    return (false, sview("", 0, 0), sview("", 0, 0), sview("", 0, 0)) if owner_region == store_region
                    # Any OTHER owner outlives the active region, so the growth escapes. The two
                    # things an in-scope owner annotation can name are an enclosing region block
                    # (`nesting` is a true lexical ancestor stack, so being on it means ancestor --
                    # stage0's `regionIsAncestor`) and a `@r` REGION PARAM, which the caller owns
                    # and which outlives every local region. Requiring a hit on the stack silently
                    # excused the second: `def fill[@r](values: mutable darray[i64]& @r)` growing
                    # `values` inside a local `region scratch:` allocated from `scratch` and was
                    # accepted, where stage0 rejects it. Nothing else can reach here -- a name that
                    # is neither is "unknown region qualifier", including a closed sibling region.
                    return (growth.found, growth.operation, store_region, owner_region)
                receiver_is_outer: bool = any name in outer_locals where name == growth.receiver
                receiver_is_global: bool = any name in mutable_globals where name == growth.receiver
                # No owner region: the container belongs to the region inferred for the function
                # body. An empty container_region is how the message renderer is told to say so.
                return (growth.found, growth.operation, store_region, sview("", 0, 0)) if receiver_is_outer or receiver_is_global
                return (false, sview("", 0, 0), sview("", 0, 0), sview("", 0, 0))



        def region_escape_check_store(expression: Ast::Expr, line: u32, nesting: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, container_fns: darray[sview]&, mutable_globals: darray[sview]&, outer_locals: darray[sview]&, region_locals: darray[sview]&, region_local_regions: darray[sview]&, taint_names: darray[sview]&, taint_regions: darray[sview]&, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        outer_growth: (found: bool, operation: sview, store_region: sview, container_region: sview) = region_escape_outer_growth(callee, line, nesting, annotations, mutable_globals, outer_locals, region_locals, region_local_regions)
                        # stage0 runs this check ONLY when the active allocation store is a
                        # `region NAME(...):` DECLARATION: `activeStoreIsLocalRegion` ends in
                        # `sym.Kind == SymbolRegion`. An `in <arena>:` block names a LOCAL (or a
                        # param) of Arena type, so stage0 skips the growth check inside one
                        # entirely — which is why `elisacore_std` compiles clean under it despite
                        # growing caller-owned containers inside `in owner:` all over collections,
                        # stores_core and the string runtime. Once `in` blocks joined the nesting
                        # stack, every one of those became a false positive here and the runtime
                        # object stopped building. A store name that resolves to a declared local
                        # is an arena value, not a region block.
                        store_is_arena_value: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(outer_growth.store_region, local_names, local_types)
                        if outer_growth.found and not store_is_arena_value.found:
                            growth_receiver: (found: bool, receiver: sview, operation: sview) = region_escape_growth_call_info(callee)
                            growth_family: sview = region_growth_container_family(annotations, growth_receiver.receiver, line, local_names, local_types)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionNestedGrowthEscape, name: outer_growth.operation, line: line, expected: outer_growth.store_region, actual: outer_growth.container_region, detail: growth_family})
                            # NO `return` here. stage0 reports the growth and the STORE separately
                            # -- `rows.push(row)` out of an inner region both grows `rows` from the
                            # wrong arena AND puts a value that dies first inside it, and its
                            # message pair names each. Stopping at the first finding hid the second
                            # and left the pair unmatchable. The store check below is independently
                            # guarded (it needs a value with a region and a handle to carry), so a
                            # growth whose argument is a plain literal still reports only once.
                        grow: (found: bool, receiver: sview, value_index: usize) = grow_call_info(callee)
                        return if not grow.found or grow.receiver == "" or grow.value_index >= arguments.count
                        # `extend` COPIES elements: safe for a SCALAR-element receiver, but a
                        # container-element receiver copies region HANDLES, which still escape.
                        is_extend: bool = grow_call_is_extend(callee)
                        return if is_extend and not receiver_elements_are_containers(annotations, grow.receiver, line, local_names, local_types)
                        container_region: mutable sview = local_region_name(annotations, grow.receiver, line)
                        container_region <- region_escape_local_owner_region(region_locals, region_local_regions, grow.receiver) if container_region == ""
                        value_region: sview = region_escape_stored_or_call_region(arguments[grow.value_index], annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                        return if value_region == ""
                        return if not region_escape_value_carries_handles(arguments[grow.value_index], annotations, line, local_names, local_types, table)
                        value_position: (found: bool, position: usize) = region_stack_position(nesting, value_region)
                        target_is_outer_local: bool = any outer_name in outer_locals where outer_name == grow.receiver
                        if container_region == "" and target_is_outer_local:
                            container_region <- "__auto"
                        if container_region == "__auto" and value_position.found:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: container_region, actual: value_region})
                            return
                        return if container_region == "" or container_region == value_region
                        container_position: (found: bool, position: usize) = region_stack_position(nesting, container_region)
                        escapes: bool = container_position.found and value_position.found and container_position.position < value_position.position
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionStoreEscape, name: "", line: line, expected: container_region, actual: value_region}) if escapes
                    _:
                        pass



        # Whether copying `value` out of its region can carry a REGION HANDLE with it.
        # stage0 flags only stores that smuggle a reference: a whole container value (a bare
        # ident, a builder call), or a projection whose ELEMENT itself is a container. A
        # scalar or POD-struct projection (`items[0].kind`, `items[0]` of `darray[Pod]`) is
        # a VALUE COPY and perfectly legal — flagging those blocked the compiler's own
        # scalar copy-out of inferred type args. Unknown shapes stay conservative-true;
        # only a known scalar/POD projection establishes that the copy carries no handle.
        def region_escape_local_type_find(name: sview, local_names: darray[sview]&, local_types: darray[Ast::Expr]&) -> (found: bool, type_expression: Ast::Expr):
            can Abort.Panic:
                while index > 0 |index: usize = local_names.count|:
                    index <- index - 1
                    if local_names[index] == name:
                        return (true, local_types[index]) if index < local_types.count
                        return (true, Ast::Expr.Absent)
                return (false, Ast::Expr.Absent)




        def region_escape_type_head_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, _): name
                    Expr.Unary(_, operand, _): region_escape_type_head_name(operand)
                    Expr.Refinement(base, _, _): region_escape_type_head_name(base)
                    _: ""




        def region_escape_named_type_id(name: sview, table: SymbolTable&) -> u32:
            can Abort.Panic:
                for index in 0..<table.type_row_kind.count:
                    if table.type_row_name[index] == name and table.type_row_elem_count[index] == 0:
                        return (index + 1).u32()
                return 0


        # Read the already-interned annotation; never erase ref/container wrappers when
        # deciding whether a value can carry a lifetime. An unavailable row is unknown.
        def region_escape_annotation_type_id(expression: Ast::Expr, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return region_escape_named_type_id(name, table)
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        return region_escape_annotation_type_id(inner, table)
                    Expr.Unary(operator, operand, _):
                        return region_escape_annotation_type_id(operand, table) if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return 0 if operator != TokenKind.Ampersand and operator != TokenKind.Question
                        kind: SemTypeKind = SemTypeKind.Ref if operator == TokenKind.Ampersand else SemTypeKind.Optional
                        name: sview = "ref" if operator == TokenKind.Ampersand else "optional"
                        elements: darray[u32] = [region_escape_annotation_type_id(operand, table)]
                        for row in 0..<table.type_row_kind.count:
                            return (row + 1).u32() if type_row_matches(row, kind, name, elements, table)
                        return 0
                    Expr.Index(head, argument, _):
                        name: sview = ident_name_of(head)
                        element: u32 = region_escape_annotation_type_id(argument, table)
                        if argument is Expr.IntLit(_, _):
                            elements: darray[u32] = [region_escape_annotation_type_id(head, table)]
                            for row in 0..<table.type_row_kind.count:
                                return (row + 1).u32() if type_row_matches(row, SemTypeKind.Container, "array", elements, table)
                            return 0
                        elements: darray[u32] = [element]
                        for row in 0..<table.type_row_kind.count:
                            return (row + 1).u32() if type_row_matches(row, SemTypeKind.Container, name, elements, table)
                        return 0
                    _:
                        return 0




        # Resolve the declared type of the small expression subset needed for a projection.
        # Unknown expressions return TypeId 0, which the handle classifier treats
        # conservatively; this pass must never guess that an opaque projection is scalar.
        def region_escape_expression_type_id(expression: Ast::Expr, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(name, local_names, local_types)
                        if local_type.found:
                            match local_type.type_expression:
                                Expr.Absent:
                                    return 0
                                _:
                                    return region_escape_annotation_type_id(local_type.type_expression, table)
                        return global_type_id_of(name, table)
                    Expr.Paren(inner, paren_line) | Expr.Move(inner, move_line):
                        return region_escape_expression_type_id(inner, local_names, local_types, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        return region_escape_named_type_id(region_escape_type_head_name(type_expression), table)
                    Expr.RecordUpdate(base, fields, update_line):
                        return region_escape_expression_type_id(base, local_names, local_types, table)
                    Expr.Field(object, field, field_line):
                        # Container metadata is a scalar copy, not a borrow of backing.
                        # Resolve the receiver first: a user struct's field named count
                        # may itself contain references and must keep normal field lookup.
                        owner_type_id: mutable u32 = region_escape_expression_type_id(object, local_names, local_types, table)
                        while interned_kind(owner_type_id, table) == SemTypeKind.Ref:
                            owner_type_id <- interned_elem(owner_type_id, 0, table)
                        if interned_kind(owner_type_id, table) == SemTypeKind.Container and (field == "count" or field == "capacity"):
                            owner_container: sview = interned_name(owner_type_id, table)
                            if owner_container == "darray" or owner_container == "dict" or owner_container == "set":
                                return region_escape_named_type_id("usize", table)
                        owner_name: sview = region_escape_expression_type_name(object, local_names, local_types, table)
                        return region_escape_field_type_id(owner_name, field, table) if owner_name != "" else 0
                    Expr.Index(object, index, index_line):
                        object_type_id: mutable u32 = region_escape_expression_type_id(object, local_names, local_types, table)
                        while interned_kind(object_type_id, table) == SemTypeKind.Ref:
                            object_type_id <- interned_elem(object_type_id, 0, table)
                        if interned_kind(object_type_id, table) == SemTypeKind.Container:
                            element_position: u32 = 1 if interned_name(object_type_id, table) == "dict" else 0
                            return interned_elem(object_type_id, element_position, table)
                        return 0
                    _:
                        return 0




        def region_escape_expression_type_name(expression: Ast::Expr, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        local_type: (found: bool, type_expression: Ast::Expr) = region_escape_local_type_find(name, local_names, local_types)
                        return region_escape_type_head_name(local_type.type_expression) if local_type.found
                        return interned_name(global_type_id_of(name, table), table)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return region_escape_expression_type_name(inner, local_names, local_types, table)
                    Expr.Construct(type_expression, _, _):
                        return region_escape_type_head_name(type_expression)
                    Expr.RecordUpdate(base, _, _):
                        return region_escape_expression_type_name(base, local_names, local_types, table)
                    Expr.Field(object, field, _):
                        field_id: u32 = region_escape_expression_type_id(expression, local_names, local_types, table)
                        return interned_name(field_id, table) if field_id != 0
                        return ""
                    Expr.Index(object, _, _):
                        element_id: u32 = region_escape_expression_type_id(expression, local_names, local_types, table)
                        return interned_name(element_id, table)
                    _:
                        return ""




        # Module-aware field lookup. A repeated bare struct name from another module is
        # not evidence about this receiver; if the current module has no exact row, only
        # a unique fallback can establish the field type.
        def region_escape_field_type_id(owner: sview, field: sview, table: SymbolTable&) -> u32:
            can Abort.Panic:
                preferred: mutable u32 = 0
                fallback: mutable u32 = 0
                fallback_count: mutable usize = 0
                for index in 0..<table.struct_field_owner.count |preferred, fallback, fallback_count, owner, field, table|:
                    continue if table.struct_field_owner[index] != owner or table.struct_field_name[index] != field
                    field_module: sview = table.struct_field_module[index] if index < table.struct_field_module.count else ""
                    preferred <- table.struct_field_type_id[index] if field_module == table.current_module and preferred == 0
                    fallback <- table.struct_field_type_id[index]
                    fallback_count <- fallback_count + 1
                return preferred if preferred != 0
                return fallback if fallback_count == 1
                return 0




        # Whether a structural type can contain a lifetime-bearing handle. Struct fields
        # are traversed so POD projections remain legal, while containers, references,
        # strings/views, and unknown types remain escape-sensitive.
        def region_escape_type_id_carries_handles(type_id: u32, ancestors: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                kind: SemTypeKind = interned_kind(type_id, table)
                true return if type_id == 0 or kind == SemTypeKind.Unknown or kind == SemTypeKind.Container or kind == SemTypeKind.Ref or kind == SemTypeKind.String
                if kind == SemTypeKind.Optional or kind == SemTypeKind.Tuple:
                    carries_element: mutable bool = false
                    for element_index in 0..<interned_elem_count(type_id, table) |carries_element, type_id, ancestors, table|:
                        carries_element <- true if region_escape_type_id_carries_handles(interned_elem(type_id, element_index.u32(), table), ancestors, table)
                    return carries_element
                if kind == SemTypeKind.Named:
                    owner: sview = interned_name(type_id, table)
                    true return if owner == "" or (any ancestor in ancestors where ancestor == owner)
                    is_struct: bool = any symbol in table.symbols where symbol.kind == SymbolKind.Struct and symbol.name == owner
                    true return if not is_struct
                    next_ancestors: mutable darray[sview] = [ancestor for ancestor in ancestors]
                    next_ancestors.push(owner)
                    for field_index in 0..<table.struct_field_owner.count:
                        continue if table.struct_field_owner[field_index] != owner
                        field_id: u32 = table.struct_field_type_id[field_index]
                        true return if region_escape_type_id_carries_handles(field_id, next_ancestors, table)
                    return false
                return false




        def region_escape_body_carries_handles(body: darray[Ast::Stmt]&, explicit_value: Ast::Expr?, annotations: darray[Ast::LocalRegionAnnotation]&, line: u32, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                body_names: mutable darray[sview] = [name for name in local_names]
                body_types: mutable darray[Ast::Expr] = [kind for kind in local_types]
                for statement in body |body_names, body_types|:
                    match statement:
                        Stmt.VarDecl(name, kind, _, _):
                            body_names.push(name)
                            body_types.push(kind)
                        _:
                            pass
                if explicit_value is value:
                    return region_escape_value_carries_handles(value, annotations, line, body_names, body_types, table)
                return true if body.count == 0
                return match body[body.count - 1]:
                    Stmt.Expr(value, _): region_escape_value_carries_handles(value, annotations, line, body_names, body_types, table)
                    _: true


        def region_escape_value_carries_handles(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, line: u32, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(_, _):
                        empty_ancestors: darray[sview] = []
                        return region_escape_type_id_carries_handles(region_escape_expression_type_id(value, local_names, local_types, table), empty_ancestors, table)
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _):
                        return false
                    Expr.Paren(carries_inner, carries_paren_line):
                        return region_escape_value_carries_handles(carries_inner, annotations, line, local_names, local_types, table)
                    Expr.Tuple(carries_elements, carries_tuple_line):
                        return any element in carries_elements where region_escape_value_carries_handles(element, annotations, line, local_names, local_types, table)
                    Expr.Array(carries_elements, carries_array_line):
                        return true
                    Expr.Construct(carries_type, carries_fields, carries_construct_line):
                        return any field in carries_fields where region_escape_value_carries_handles(field.value, annotations, line, local_names, local_types, table)
                    Expr.RecordUpdate(carries_base, carries_fields, carries_update_line):
                        return region_escape_value_carries_handles(carries_base, annotations, line, local_names, local_types, table) or any field in carries_fields where region_escape_value_carries_handles(field.value, annotations, line, local_names, local_types, table)
                    Expr.If(carries_condition, carries_then, carries_else, carries_if_line):
                        return region_escape_value_carries_handles(carries_then, annotations, line, local_names, local_types, table) or region_escape_value_carries_handles(carries_else, annotations, line, local_names, local_types, table)
                    Expr.Block(body, carries_value, _, _):
                        return region_escape_body_carries_handles(body, carries_value, annotations, line, local_names, local_types, table)
                    Expr.Match(_, carries_arms, _):
                        for arm in carries_arms:
                            arm_names: mutable darray[sview] = [name for name in local_names]
                            arm_types: mutable darray[Ast::Expr] = [kind for kind in local_types]
                            collect_pattern_binding_names(arm.pattern, arm_names)
                            while arm_types.count < arm_names.count |arm_types|:
                                arm_types.push(Ast::Expr.Absent)
                            return true if region_escape_body_carries_handles(arm.body, null, annotations, line, arm_names, arm_types, table)
                        return false
                    Expr.Catch(guarded, carries_arms, _):
                        true return if region_escape_value_carries_handles(guarded, annotations, line, local_names, local_types, table)
                        for arm in carries_arms:
                            true return if arm.body.count == 0
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    true return if region_escape_value_carries_handles(arm_value, annotations, line, local_names, local_types, table)
                                _:
                                    return true
                        return false
                    Expr.Index(carries_object, carries_element, carries_index_line):
                        object_type_id: mutable u32 = region_escape_expression_type_id(carries_object, local_names, local_types, table)
                        while interned_kind(object_type_id, table) == SemTypeKind.Ref:
                            object_type_id <- interned_elem(object_type_id, 0, table)
                        if interned_kind(object_type_id, table) == SemTypeKind.Container:
                            element_position: u32 = 1 if interned_name(object_type_id, table) == "dict" else 0
                            empty_ancestors: darray[sview] = []
                            return region_escape_type_id_carries_handles(interned_elem(object_type_id, element_position, table), empty_ancestors, table)
                        # An unknown element type cannot establish that copying it is safe.
                        return true
                    Expr.Field(carries_field_object, carries_field_name, carries_field_line):
                        field_type_id: u32 = region_escape_expression_type_id(value, local_names, local_types, table)
                        empty_ancestors: darray[sview] = []
                        return region_escape_type_id_carries_handles(field_type_id, empty_ancestors, table)
                    _:
                        return true



        # For a container-growth call, the receiver name and which argument carries the
        # stored VALUE: push/extend/add take it at index 0, dict.put at index 1 (after the
        # key). found=false for any other call.
        def grow_call_info(callee: Ast::Expr) -> (found: bool, receiver: sview, value_index: usize):
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, field_line):
                        receiver_name: sview = region_escape_assign_target_root(receiver)
                        is_element_grow: bool = method == "push" or method == "extend" or method == "add"
                        is_map_put: bool = method == "put"
                        value_index: usize = 1 if is_map_put else 0
                        return (is_element_grow or is_map_put, receiver_name, value_index)
                    _:
                        return (false, sview("", 0, 0), 0)
