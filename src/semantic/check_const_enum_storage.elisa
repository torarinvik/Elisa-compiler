# Const-enum-family diagnostic (structural). A `const enum X of T:` is an integer-backed
# compile-time enum, so its storage type `T` must be an integer type. stage0 rejects a
# non-integer backing type. Reads `is_const`/`storage_type` now captured on Decl.Enum.
#
# SOUND SUBSET: fire only when the storage type is a KNOWN non-integer scalar (bool/float/
# char/string family). A bit-int (`u4`), a named integer, or any unrecognized type is left
# silent — so we never false-fire on a valid narrow-int backing type we don't enumerate.
extend Semantic:
    private:
        # Known non-integer scalar type names that cannot back a const enum.
        def is_non_integer_storage(type_name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                non_integer_names: darray[sview] = ["bool", "f16", "f32", "f64", "char", "string", "str", "cstr", "sview", "dstr"]
                while candidate_index < non_integer_names.count |candidate_index: usize = 0|:
                    true return if non_integer_names[candidate_index] == type_name
                    candidate_index <- candidate_index + 1
                return false


        def check_const_enum_storage(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Enum(name, variants, is_const, storage_type, line):
                            if is_const:
                                storage_name: sview = bare_type_name(storage_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstEnumStorageNotInt, name: name, line: line.line, expected: storage_name, actual: ""}) if is_non_integer_storage(storage_name)
                        Decl.Module(module_name, body, module_line):
                            table <- check_const_enum_storage(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_const_enum_storage(scoped_body, table)
                        _:
                            pass
