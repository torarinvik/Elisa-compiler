# `diagnostic_message`: renders one diagnostic's human-readable wording (`extend Semantic:
# public:`). The single source of truth for diagnostic text; LSP, CLI and tests render this
# rather than re-deriving per-kind text.
#
# One `match diagnostic.kind:` per kind does not fit in a 600-line file, so the arms are
# split across this directory. Each handler reports through `handled`: one that matches no
# arm leaves it false and dispatch.elisa tries the next, so every kind reaches its arm exactly
# as one flat match would. Wording must match stage0 byte for byte.
extend Semantic:
    public:
        def diagnostic_message(diagnostic: Diagnostic, secondary_location: sview = "") -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                buffer: mutable darray[u8] = []
                handled: mutable bool = true
                diagnostic_message_resolution(diagnostic, secondary_location, buffer, handled)
                if not handled:
                    diagnostic_message_values_and_lints(diagnostic, secondary_location, buffer, handled)
                if not handled:
                    diagnostic_message_effects(diagnostic, buffer, handled)
                if not handled:
                    diagnostic_message_views_and_regions(diagnostic, buffer, handled)
                if not handled:
                    diagnostic_message_globals_and_exports(diagnostic, secondary_location, buffer, handled)
                return buffer
