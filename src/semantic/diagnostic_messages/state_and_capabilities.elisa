# Diagnostic wording for derived states, pointer and buffer capabilities, dense node keys
# and thread-transfer dependencies.
#
# One `match diagnostic.kind:` per kind does not fit in a 600-line file, so the arms are
# split across this directory. Each handler reports through `handled`: one that matches no
# arm leaves it false and dispatch.elisa tries the next, so every kind reaches its arm exactly
# as one flat match would. Wording must match stage0 byte for byte.
extend Semantic:
    private:
        def diagnostic_message_state_and_capabilities(diagnostic: Diagnostic, buffer: mutable darray[u8]&, handled: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                handled <- true
                match diagnostic.kind:
                    DiagnosticKind.DerivedStateConstructorMismatch:
                        buffer.extend(f"struct literal \"{diagnostic.name}\" does not satisfy derived state {diagnostic.expected}")

                    DiagnosticKind.DerivedStateArgumentMismatch:
                        buffer.extend(f"argument to \"{diagnostic.name}\" expects {diagnostic.detail}[{diagnostic.expected}], got {diagnostic.detail}[{diagnostic.actual}]")

                    DiagnosticKind.DerivedStateResultMismatch:
                        buffer.extend(f"result expression for \"{diagnostic.name}\" does not satisfy derived state {diagnostic.expected}")

                    DiagnosticKind.DerivedStateEvidenceUnproven:
                        buffer.extend(f"cannot establish derived state {diagnostic.expected} of \"{diagnostic.name}\" from unknown predicate evidence")

                    DiagnosticKind.NamedStateArgumentUnknown:
                        buffer.extend(f"struct \"{diagnostic.name}\" has no named state {diagnostic.expected}")

                    DiagnosticKind.UngrantedPointerCast:
                        push_str(buffer, "warning: ") if diagnostic.detail == "warn"
                        push_str(buffer, "forging a reference from an integer (`.cast` of a number to a reference type) ") if diagnostic.detail == "forge"
                        push_str(buffer, "upgrading a read-only reference to a mutable one (`.cast[mutable T&]` of a non-mutable reference) ") if diagnostic.detail == "upgrade"
                        push_str(buffer, "pointer cast ") if diagnostic.detail != "forge" and diagnostic.detail != "upgrade"
                        buffer.extend(f"requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.PointerCast or a surrounding can ...: block; missing required effect facts")

                    DiagnosticKind.UngrantedBufferReinterpret:
                        push_str(buffer, "warning: ") if diagnostic.detail == "warn"
                        buffer.extend(f"buffer reinterpret cast requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.BufferReinterpret or a surrounding can ...: block; missing required effect facts")

                    DiagnosticKind.DenseNodeKeyRootMismatch:
                        buffer.extend(f"node key and frozen store must share the same exact frozen store root")

                    DiagnosticKind.ThreadTransferStoreDependency:
                        buffer.extend(f"argument to \"{diagnostic.name}\" cannot cross thread boundary: store dependency facts require rebase to frozen/public store")

                    DiagnosticKind.ThreadTransferRegionDependency:
                        buffer.extend(f"argument to \"{diagnostic.name}\" cannot cross thread boundary: region dependency facts include local region \"{diagnostic.actual}\"")

                    DiagnosticKind.FlowFlagStateMachine:
                        buffer.extend(f"mutable bool flag \"{diagnostic.name}\" is written in multiple branches and read after the join; this encodes a state machine — flatten the flow")

                    DiagnosticKind.IfValueMissingElse:
                        buffer.extend(f"an `if` used as a value must have a final `else`")

                    DiagnosticKind.TuplePatternArityMismatch:
                        push_str(buffer, "tuple pattern expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " elements, got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.OrPatternBindingMismatch:
                        # Wording matches stage0 exactly ("with compatible types"); diagnostics_diff
                        # compares normalized message TEXT, so a shorter paraphrase reads as a
                        # missing stage0 diagnostic.
                        buffer.extend(f"or-pattern alternatives must bind the same names with compatible types")

                    DiagnosticKind.TopLevelOrPatternBindsNames:
                        # stage0 analyzer_flow_match_core.go wording, verbatim: diagnostics_diff
                        # compares normalized message TEXT, so any paraphrase reads as a missing
                        # stage0 diagnostic.
                        buffer.extend(f"top-level or-pattern alternatives that bind names are not supported")

                    DiagnosticKind.AssignValueMismatch:
                        buffer.extend(f"cannot assign {diagnostic.actual} to {diagnostic.expected}")
                        push_str(buffer, "?") if diagnostic.detail3 == "?"

                    DiagnosticKind.ValueBlockJumpOut:
                        if diagnostic.expected == "label":
                            buffer.extend(f"`{diagnostic.name} '{diagnostic.actual}` names no enclosing loop; label the loop it should leave (`'{diagnostic.actual}: for x in xs:`)")
                        else:
                            buffer.extend(f"`{diagnostic.name}` may not jump out of a value block with a `|capture|` header (docs/119 E5): its captured values are written back only when the block ends; decide before the block, or drop the capture and thread the value through the loop instead")

                    # stage0 analyzer_discarded_loop_value.go wording, verbatim: diagnostics_diff
                    # compares normalized message TEXT.
                    DiagnosticKind.DiscardedLoopValue:
                        buffer.extend(f"accumulator loop result `{diagnostic.name}` is discarded; make the loop the final expression of its block, bind it (`{diagnostic.name}: T = <loop>`), or drop `-> {diagnostic.name}` if only its effects matter")

                    DiagnosticKind.MembershipRhsContainer:
                        push_str(buffer, "membership operator requires a list literal or tokenset on the right-hand side, got ")
                        push_sview(buffer, diagnostic.actual if diagnostic.actual != "" else "container")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != ""

                    DiagnosticKind.DarrayPushTypeMismatch:
                        buffer.extend(f"darray push expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.DictIndexKeyTypeMismatch:
                        buffer.extend(f"dict index expects key of type {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.InvalidCtorCast:
                        buffer.extend(f"invalid cast from {diagnostic.actual} to {diagnostic.expected}")

                    DiagnosticKind.UndefinedModuleMember:
                        buffer.extend(f"undefined identifier \"{diagnostic.name}.{diagnostic.expected}\"")
                    DiagnosticKind.AssignThroughReadonlyRef:
                        buffer.extend(f"cannot assign through readonly ref \"{diagnostic.name}\"")
                    DiagnosticKind.AggregateStateArgMismatch:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.name}\" expects ")
                        push_aggregate_state_spelling(buffer, diagnostic.expected, diagnostic.actual_count)
                        push_str(buffer, ", got ")
                        push_aggregate_state_spelling(buffer, diagnostic.expected, diagnostic.state_code)
                    DiagnosticKind.ReadonlyRefAssignNote:
                        buffer.extend(f"note: plain refs T& are readonly; use mutable {diagnostic.expected}& if this reference should allow writes")
                    DiagnosticKind.NamespaceUsedAsValue:
                        buffer.extend(f"\"{diagnostic.name}\" is a namespace; write {diagnostic.name}::")
                        push_sview(buffer, diagnostic.expected if diagnostic.expected != "" else "member")
                        # The CALL form carries stage0's `(...)`: a namespace used as a callee
                        # reads `write M::geti(...)`, the plain field form `write M::geti`.
                        push_str(buffer, "(...)") if diagnostic.actual == "call"
                        # stage0's parenthetical, which stage1 had INVERTED — it told the reader that
                        # `::` reaches value members and `.` reaches namespaces, the exact
                        # opposite of the rule, in the one message whose job is to teach it.
                        push_str(buffer, " (`.` accesses value members, `::` accesses namespaces)")

                    DiagnosticKind.PackedMoveStoreMismatch:
                        buffer.extend(f"packed enum move-as over \"{diagnostic.expected}\" requires store type \"{diagnostic.expected}.Store\", got {diagnostic.actual}.Store")

                    DiagnosticKind.RecordUpdateUnknownField:
                        buffer.extend(f"record update has no field \"{diagnostic.name}\"")

                    DiagnosticKind.ModuloOperandNonIntegral:
                        push_str(buffer, "operator requires integral operands")

                    DiagnosticKind.ArrayIndexNonIntegral:
                        buffer.extend(f"index must be integral, got {diagnostic.actual}")

                    DiagnosticKind.RangeStepZero:
                        push_str(buffer, "for loop range step cannot be zero")

                    DiagnosticKind.MoveStructPatternArityMismatch:
                        buffer.extend(f"move-as pattern \"{diagnostic.name}\" expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " bindings, got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.LetDestructureUnknownField:
                        buffer.extend(f"struct \"{diagnostic.expected}\" has no field \"{diagnostic.name}\"")

                    DiagnosticKind.UnknownFunctionAnnotation:
                        buffer.extend(f"unknown function annotation @{diagnostic.name} on \"{diagnostic.expected}\"")

                    DiagnosticKind.InlineAnnotationArity:
                        buffer.extend(f"@inline on function \"{diagnostic.name}\" expects exactly one mode argument")

                    DiagnosticKind.InlineAnnotationMode:
                        buffer.extend(f"@inline on function \"{diagnostic.name}\" uses unsupported mode \"{diagnostic.actual}\" (expected always or never)")

                    DiagnosticKind.UnknownExternFunctionAnnotation:
                        buffer.extend(f"unknown extern function annotation @{diagnostic.name} on \"{diagnostic.expected}\"")

                    DiagnosticKind.TestFunctionParameters:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must not take parameters")

                    DiagnosticKind.BenchFunctionNonVoidReturn:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must return void, got {diagnostic.actual}")

                    DiagnosticKind.GenericFixtureFunction:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must not have type or shape parameters")

                    DiagnosticKind.AnnotatedFunctionPermissions:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must not require permissions")

                    DiagnosticKind.GuardNonnullNonOptionalParam:
                        buffer.extend(f"@guard_nonnull on function \"{diagnostic.expected}\" requires a nullable reference or optional parameter, got {diagnostic.actual}")

                    DiagnosticKind.ProtocolRequiresConcreteType:
                        buffer.extend(f"protocol \"{diagnostic.name}\" is a constraint, not a concrete value type; use it as a function parameter constraint or use a concrete implementing type")

                    DiagnosticKind.GenericInterfaceBoundUnsatisfied:
                        if diagnostic.expected_count == 1:
                            buffer.extend(f"type \"{diagnostic.actual}\" does not satisfy required interface fact \"{diagnostic.expected}\" for call to \"{diagnostic.name}\"")
                        else:
                            buffer.extend(f"type \"{diagnostic.actual}\" does not satisfy required interface fact \"{diagnostic.expected}\" for type argument")

                    DiagnosticKind.GenericOperatorNoBound:
                        buffer.extend(f"operator \"{diagnostic.expected}\" used on unbound generic type parameter \"{diagnostic.name}\" in \"{diagnostic.actual}\" -- add an interface bound (e.g. [{diagnostic.name}: Add]) or it is not guaranteed to support this operator")

                    DiagnosticKind.ExternBorrowUnknownParam:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" references unknown parameter \"{diagnostic.name}\"")

                    DiagnosticKind.ExternBorrowNonProvenanceParam:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" cannot borrow from parameter \"{diagnostic.name}\" of type {diagnostic.actual}")

                    DiagnosticKind.ExternBorrowFieldNonStructReturn:
                        buffer.extend(f"@borrows_return(field, …) on extern function \"{diagnostic.expected}\" requires a concrete struct return type, got {diagnostic.actual}")

                    DiagnosticKind.ExternBorrowUnknownReturnField:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" references unknown return field path \"{diagnostic.name}\" in {diagnostic.actual}")

                    DiagnosticKind.ThreadArgumentNotShareable:
                        buffer.extend(f"argument to \"{diagnostic.name}\" is not structurally shareable across threads: non-static reference")

                    DiagnosticKind.ThreadResultNotShareable:
                        buffer.extend(f"result of \"{diagnostic.name}\" is not structurally shareable across threads: non-static reference")

                    DiagnosticKind.ArraySliceEndOutOfBounds:
                        push_str(buffer, "constant slice end ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, " out of bounds for array of length ")
                        push_int(buffer, diagnostic.expected_count.i64())

                    DiagnosticKind.ArraySliceReversed:
                        push_str(buffer, "constant slice start ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " is after end ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.RuntimeArraySize:
                        push_str(buffer, "array size must be a compile-time integer")

                    DiagnosticKind.FixedArrayShapeMismatch:
                        buffer.extend(f"return type expects {diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "]")
                        buffer.extend(f" | {diagnostic.error_set}") if diagnostic.error_set != ""
                        buffer.extend(f", got {diagnostic.actual}[")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, "]")

                    DiagnosticKind.BorrowUseAfterOwnerMove:
                        push_str(buffer, "linear value \"")
                        push_sview(buffer, diagnostic.name)
                        push_str(buffer, ".") if diagnostic.detail != ""
                        push_sview(buffer, diagnostic.detail) if diagnostic.detail != ""
                        push_str(buffer, "\" cannot be used: usage facts were consumed by ")
                        match diagnostic.expected_count:
                            1:
                                buffer.extend(f"argument to call \"{diagnostic.expected}\"")
                            2:
                                buffer.extend(f"move into local \"{diagnostic.expected}\"")
                            4:
                                buffer.extend(f"move into struct literal field \"{diagnostic.expected}\"")
                            _:
                                push_str(buffer, "assignment")

                    DiagnosticKind.ReturnRefToLocal:
                        push_str(buffer, "returning a reference into function-local storage; it dangles once the function returns. Return/store the value or owner by value, or clone it into a longer-lived region (clone[dstr]/clone[darray[...]])")

                    DiagnosticKind.ReturnRefAggregateLocal:
                        push_str(buffer, "returning an aggregate or helper result that contains a reference into function-local storage; it dangles once the function returns. Return/store the value or owner by value, or clone it into a longer-lived region")

                    DiagnosticKind.StoreRefToLocal:
                        # `state_code` is the store form: 0 a direct `&local`, 1 a darray push,
                        # 2 an aggregate carrying one, 3 a forwarded local reference alias;
                        # 10*(i+1)+4 a call storing through its 1-based argument i+1.
                        match diagnostic.state_code:
                            1:
                                push_str(buffer, "darray push stores a reference to function-local storage into longer-lived storage; it dangles once the function returns. Store the value or owner by value, or clone it into a longer-lived region")
                            2:
                                push_str(buffer, "storing an aggregate that contains a reference to function-local storage into longer-lived storage; it dangles once the function returns. Store the value or owner by value, or clone it into a longer-lived region")
                            3:
                                push_str(buffer, "storing a forwarded reference into longer-lived storage; its pointee may not outlive the function. Annotate the reference as `heap`/`static` if its target outlives the frame, store the value/owner by value, or take responsibility with `can Unsafe.StaleRef:` (tracked) or `trusted Unsafe.StaleRef:`")
                            _:
                                if diagnostic.state_code >= 10 and diagnostic.state_code % 10 == 4:
                                    push_str(buffer, "call may store a reference to function-local storage into longer-lived storage through argument ")
                                    push_int(buffer, (diagnostic.state_code / 10).i64())
                                    push_str(buffer, "; it dangles once the function returns. Store the value or owner by value, or clone it into a longer-lived region")
                                else:
                                    push_str(buffer, "storing a reference to function-local storage into longer-lived storage; it dangles once the function returns. Return/store the value or owner by value, or clone it into a longer-lived region (clone[dstr]/clone[darray[...]])")

                    DiagnosticKind.RefValueCopy:
                        # stage0's three sentences for copying a value out of a reference
                        # (check_ref_value_copy). `state_code` is the form: 1 a declaration,
                        # 2 a return, 3 a `<-` mutation, 4 a struct literal field.
                        form: u32 = diagnostic.state_code % 10
                        match form:
                            1:
                                buffer.extend(f"variable \"{diagnostic.name}\" expects ")
                            2:
                                push_str(buffer, "return type expects ")
                            4:
                                buffer.extend(f"struct literal field \"{diagnostic.name}\" expects ")
                            _:
                                push_str(buffer, "cannot assign ")
                        match form:
                            3:
                                push_ref_copy_reference(buffer, diagnostic)
                                push_str(buffer, " to ")
                                push_ref_copy_type(buffer, diagnostic)
                            _:
                                push_ref_copy_type(buffer, diagnostic)
                                push_str(buffer, ", got ")
                                push_ref_copy_reference(buffer, diagnostic)

                    DiagnosticKind.FnValueEffectRow:
                        # stage0's five sentences for a function value whose effect row
                        # differs from the fn type it meets (analyzer_flow / analyzer_expr_calls
                        # / struct literal / return / assignment). `state_code` is the site.
                        match diagnostic.state_code:
                            1:
                                buffer.extend(f"variable \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")
                            2:
                                buffer.extend(f"return type expects {diagnostic.expected}, got {diagnostic.actual}")
                            3:
                                buffer.extend(f"cannot assign {diagnostic.actual} to {diagnostic.expected}")
                            4:
                                buffer.extend(f"struct literal field \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")
                            _:
                                push_str(buffer, "argument ")
                                push_int(buffer, diagnostic.expected_count.i64())
                                buffer.extend(f" to \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")

                    _:
                        handled <- false
