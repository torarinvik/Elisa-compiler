# Diagnostic wording helper: module paths in stage0's dotted spelling (`Geo::Scalar` ->
# `Geo.Scalar`).
extend Semantic:
    public:
        # Canonical human-readable message for a diagnostic, with the offending `name`
        # interpolated, as an owned UTF-8 `darray[u8]`. This is the SINGLE SOURCE OF TRUTH
        # for diagnostic wording: consumers (LSP, CLI, tests) render this rather than
        # re-deriving per-kind text, so a new `DiagnosticKind` is worded in exactly one
        # place. The `match` is exhaustive with no wildcard arm, so adding a kind without
        # wording it here is a compile error rather than a silent generic fallback.
        # Append a module path in stage0's diagnostic spelling: `Geo::Scalar` -> `Geo.Scalar`.
        def push_dot_module_path(buffer: mutable darray[u8]&, path: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                path_length: usize = path.len
                index: mutable usize = 0
                while index < path_length |index, buffer, path, path_length|:
                    separator: bool = path[index] == 58 and index + 1.usize() < path_length and path[index + 1.usize()] == 58
                    buffer.push(46 if separator else path[index])
                    index <- index + (2.usize() if separator else 1.usize())
