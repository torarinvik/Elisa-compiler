# Diagnostic wording for proofs and laws: unproven lemmas and refinements, interior
# pointers, imports, defer rules, law subjects and iteration mutation.
#
# One `match diagnostic.kind:` per kind does not fit in a 600-line file, so the arms are
# split across this directory. Each handler reports through `handled`: one that matches no
# arm leaves it false and dispatch.elisa tries the next, so every kind reaches its arm exactly
# as one flat match would. Wording must match stage0 byte for byte.
extend Semantic:
    private:
        def diagnostic_message_proofs(diagnostic: Diagnostic, buffer: mutable darray[u8]&, handled: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                handled <- true
                match diagnostic.kind:
                    DiagnosticKind.LemmaEnsureUnproven:
                        buffer.extend(f"lemma \"{diagnostic.name}\" does not prove its `ensure`: a lemma is erased from code, so every postcondition must follow statically from its `requires` and body (add intermediate `assert`s, call a helper lemma, or strengthen `requires`)")

                    DiagnosticKind.AssertByUnproven:
                        push_str(buffer, "`assert … by:` condition could not be proven from its proof block; the block's facts plus the caller's facts must entail it (add intermediate `assert`s or call a helper `lemma`)")

                    DiagnosticKind.LocalRefinementUnproven:
                        buffer.extend(f"refinement \"{diagnostic.name}\" on \"{diagnostic.actual}\" could not be proven statically")

                    DiagnosticKind.UnboundedStringErasure:
                        buffer.extend(f"casting an interior pointer of a sized darray to an unbounded string ({diagnostic.actual}) erases its length; a static_strlen / C-string scan can read past the darray into adjacent memory (out-of-bounds, nondeterministic). Prefer a length-bounded view (sview), or copy bounded bytes into a fresh allocation")

                    DiagnosticKind.InteriorPointerWiden:
                        buffer.extend(f"casting an interior pointer of a byte darray to {diagnostic.actual}& reinterprets darray as a wider value; reading it accesses more bytes than the index bounds and can read past the darray (out-of-bounds, nondeterministic). Bounds-check the offset against the buffer length, or copy the bytes into a properly typed value")

                    DiagnosticKind.ConflictingImport:
                        buffer.extend(f"conflicting import: \"{diagnostic.name}\" is already imported from \"{diagnostic.expected}\", cannot also import it from \"{diagnostic.actual}\"; a name may be selectively imported from only one module")

                    DiagnosticKind.ConflictingModuleAlias:
                        buffer.extend(f"conflicting alias: \"{diagnostic.name}\" already aliases module \"")
                        push_dot_module_path(buffer, diagnostic.expected)
                        buffer.extend("\", cannot also alias \"")
                        push_dot_module_path(buffer, diagnostic.actual)
                        buffer.extend("\"")

                    DiagnosticKind.MeasureShapeLawInValueIs:
                        buffer.extend(f"\"{diagnostic.name}\" is a {diagnostic.actual} law; apply it to a function with `fulfills {diagnostic.name}`, not with `is` in a value position")

                    DiagnosticKind.DeferBodyReturns:
                        buffer.extend("defer body cannot return from the enclosing function")

                    DiagnosticKind.DeferFunctionNotOutermost:
                        buffer.extend("defer function is currently only supported in the outermost function scope")

                    DiagnosticKind.LawNeedsSubject:
                        buffer.extend(f"law \"{diagnostic.name}\" needs a subject: give it at least one value parameter (conventionally `self`)")

                    DiagnosticKind.EnumRefinesNonEnum:
                        buffer.extend(f"enum \"{diagnostic.name}\" can only refine another enum with `is`, but \"{diagnostic.actual}\" is {diagnostic.actual}")

                    DiagnosticKind.MutateWhileIterating:
                        buffer.extend(f"cannot mutate \"{diagnostic.name}\" while it is being iterated: reassignment of {diagnostic.name} would move its buffer out from under the loop. Iterate by index up to a saved count, collect into a separate darray, or back it with a stable region (reserve_commit/fixed)") if diagnostic.actual == "reassignment" and diagnostic.expected == ""
                        buffer.extend(f"cannot mutate \"{diagnostic.name}\" while it is being iterated: reassignment of {diagnostic.expected} would move its buffer out from under the loop. Iterate by index up to a saved count, collect into a separate darray, or back it with a stable region (reserve_commit/fixed)") if diagnostic.actual == "reassignment" and diagnostic.expected != ""
                        buffer.extend(f"cannot mutate \"{diagnostic.name}\" while it is being iterated: darray {diagnostic.actual} of {diagnostic.name} would move its buffer out from under the loop. Iterate by index up to a saved count, collect into a separate darray, or back it with a stable region (reserve_commit/fixed)") if diagnostic.actual != "reassignment"

                    DiagnosticKind.IndexFallbackTypeMismatch:
                        buffer.extend(f"index fallback expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.CastConstantTruncated:
                        push_str(buffer, "constant ")
                        push_str(buffer, "-") if diagnostic.expected == "neg"
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" does not fit in {diagnostic.actual} and is truncated by this cast")

                    DiagnosticKind.StructuralDecreasesUnproven:
                        buffer.extend(f"cannot prove structural `decreases` for \"{diagnostic.name}\": recursive calls must pass values bound from a match on the decreasing enum parameter")

                    DiagnosticKind.AutoRegionStoreEscape:
                        # state_code > 0: a call storing through its 1-based argument state_code
                        # (check_call_holder_view_store).
                        push_str(buffer, "value backed by a short-lived region escapes via store into longer-lived storage")
                        if diagnostic.state_code > 0:
                            push_str(buffer, " through argument ")
                            push_int(buffer, diagnostic.state_code.i64())
                        push_str(buffer, "; the region ends at scope exit. Give the value a longer lifetime by copying it into a caller-provided region param (def f[@r] ... -> ... @r) or a longer-lived region")
                    DiagnosticKind.AutoRegionReturnEscape:
                        push_str(buffer, "value backed by a short-lived region escapes via return; the region ends at scope exit. Give the value a longer lifetime by copying it into a caller-provided region param (def f[@r] ... -> ... @r) or a longer-lived region")

                    DiagnosticKind.ClosureCaptureEscape:
                        buffer.extend(f"the closure passed to \"{diagnostic.name}\" captures state that cannot outlive the task; move owned state into the task or capture only values")

                    DiagnosticKind.SentinelIndex:
                        buffer.extend(f"index \"{diagnostic.name}\" derives from a function that can return a negative not-found sentinel and is never bounds-checked here; casting a negative sentinel to an unsigned index reads far out of bounds. Guard it (e.g. `if {diagnostic.name} >= 0 ...`) or use `get coll[{diagnostic.name}] else ...`")

                    DiagnosticKind.UntypedEmptyBuilder:
                        buffer.extend(f"cannot infer element type for empty darray builder \"{diagnostic.name}\"; add a type declaration (for example `{diagnostic.name}: T[] = []` or `{diagnostic.name}: mutable darray[T] = []`) or push/extend typed values before type-dependent darray operations")

                    DiagnosticKind.CStrPointerCompare:
                        buffer.extend(f"{diagnostic.name} on two raw u8& C-string pointers compares addresses, not contents; use streq() or compare via cstr/sview/dstr for content equality")

                    DiagnosticKind.RegionStoreEscape:
                        # "__auto" is this check's marker for a container that was declared with no
                        # region of its own, so it belongs to the region inferred for the function
                        # body. stage0 prints that region under a fixed placeholder rather than its
                        # internal name, which is built from a buffer offset and therefore moved
                        # with the source file's path.
                        # "__param_region" marks a store into a PARAMETER's storage; stage0 names that
                        # region after the parameter (`__rg_<name>`), and `name` carries the parameter.
                        store_escape_target = f"<inferred>" if diagnostic.expected == "__auto" else (f"__rg_{diagnostic.name}" if diagnostic.expected == "__param_region" else f"{diagnostic.expected}")
                        buffer.extend(f"value in region \"{diagnostic.actual}\" is stored into longer-lived region \"{store_escape_target}\"; region \"{diagnostic.actual}\" is freed first, leaving a dangling reference. Copy it into region \"{store_escape_target}\" (or a region that outlives \"{store_escape_target}\") before storing")

                    DiagnosticKind.RegionShadowsEnclosing:
                        buffer.extend(f"region \"{diagnostic.name}\" shadows an enclosing region of the same name; values of the two cannot be told apart, so rename the inner region")
                    DiagnosticKind.RegionStoreEscapeVia:
                        buffer.extend(f"value in region \"{diagnostic.actual}\" is stored into longer-lived region \"__rg_{diagnostic.name}\" via a {diagnostic.expected}; region \"{diagnostic.actual}\" is freed first, leaving a dangling element. Copy it into region \"__rg_{diagnostic.name}\" (or a region that outlives \"__rg_{diagnostic.name}\") before storing")

                    DiagnosticKind.LoopElementReadWidened:
                        buffer.extend(f"element added to \"{diagnostic.name}\" inside a loop may be read by the element copy at line ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " on a later iteration, which was checked only against the elements added before it; add it after the loop or copy it into the container's region first")

                    DiagnosticKind.ArenaGrowEscape:
                        buffer.extend(f"darray {diagnostic.name} grows a non-local darray from local arena \"{diagnostic.expected}\"; its backing buffer is freed when \"{diagnostic.expected}\" goes out of scope (use-after-free). Allocate from a persistent arena instead (a global Arena, or an Arena& parameter owned by the caller)")

                    DiagnosticKind.RegionNestedGrowthEscape:
                        # `actual` is the container's own region; EMPTY means the container has
                        # none it was declared with, so it belongs to the region the compiler
                        # infers for the function body. stage0 names that region internally from
                        # a BUFFER OFFSET, which made its message depend on the source file's
                        # path; both compilers now print the fixed placeholder instead.
                        growth_container_region = f"<inferred>" if diagnostic.actual == "" else f"{diagnostic.actual}"
                        growth_family = f"{diagnostic.detail}" if diagnostic.detail != "" else f"{growth_default_family(diagnostic.name)}"
                        buffer.extend(f"{growth_family} {diagnostic.name} allocates into function-scoped region \"{diagnostic.expected}\" while growing non-local storage in region \"{growth_container_region}\"; this would leave the container pointing at freed memory")

                    DiagnosticKind.OverlayUnknownField:
                        buffer.extend(f"overlay-unknown-field: field {diagnostic.name} is not declared in layout {diagnostic.expected}; add the field or correct the access")

                    DiagnosticKind.StructFieldWhereRefScope:
                        buffer.extend(f"struct field where refinement on \"{diagnostic.name}\" may only reference the field itself or earlier-declared fields; \"{diagnostic.actual}\" is not available here (later fields are not in scope at this point)")

                    DiagnosticKind.LocalWhereRefinementViolated:
                        push_str(buffer, "local where refinement is violated")

                    DiagnosticKind.StructFieldRefinementViolated:
                        of_phrase = f" of {diagnostic.expected}" if diagnostic.expected != "" else f""
                        buffer.extend(f"where refinement on field \"{diagnostic.name}\"{of_phrase} is violated")

                    DiagnosticKind.StructFieldRefinementUnproven:
                        buffer.extend(f"where refinement on field \"{diagnostic.name}\" of {diagnostic.expected} could not be proven statically")

                    DiagnosticKind.RegionReturnEscape:
                        buffer.extend(f"value allocated in region \"{diagnostic.actual}\" escapes via return; the region is freed at scope exit. Copy it into a caller-provided region param (def f[@r] ... -> ... @r) or a longer-lived region first")

                    DiagnosticKind.RegionNewOwnerUnresolved:
                        push_str(buffer, "new[...] owner must be a region name, tree store, or packed enum store, got <invalid>")

                    DiagnosticKind.DviewRemoved:
                        push_str(buffer, "`dview[T]` has been removed; use `view[T]`")

                    DiagnosticKind.NoallocArguments:
                        buffer.extend(f"@noalloc on function \"{diagnostic.name}\" does not take arguments")

                    DiagnosticKind.HotContract:
                        hot_reason = f"chases raw pointers or dispatches indirectly through a heap reference" if diagnostic.expected == "pointer" else f"allocates or frees on the hot path (via the `Memory.Allocate` effect)"
                        buffer.extend(f"@hot function \"{diagnostic.name}\" {hot_reason}")

                    DiagnosticKind.DecreasesStarReason:
                        push_str(buffer, "`decreases *` requires a non-empty reason string explaining why termination is unbounded")

                    DiagnosticKind.DecreasesRuntimeUnmodelable:
                        push_str(buffer, "warning: loop `decreases` measure could not be proven: the body has effects this analyzer cannot model (calls, non-arithmetic writes, or control flow); falling back to the runtime loop-progress check")

                    DiagnosticKind.ProgressNoEvidence:
                        push_str(buffer, "progress warning: while loop has no progress evidence; prove termination with `decreases <measure>`, add a Progress.Tick/Progress.Yield budget check, or — if progress is real but unprovable — `can Unsafe.AssumeProgress` to propagate the assumption upward (reach for `trusted` only at the boundary where propagation no longer helps); for a deliberately non-terminating loop, `can Unsafe.NonProgress`")

                    DiagnosticKind.ProgressRecursiveCycle:
                        buffer.extend(f"progress warning: recursive cycle {diagnostic.name} has no progress evidence; prove it with `decreases <measure>` or structural recursion, add Progress.EnterRecursion/Progress.Tick budget checks, or — if non-progress is intended — `can Unsafe.NonProgress` to propagate it upward (reach for `trusted` only at the boundary where propagation no longer helps)")

                    DiagnosticKind.GetFallbackVoidNonVoid:
                        buffer.extend(f"get fallback cannot use else void for non-void result {diagnostic.expected}")

                    DiagnosticKind.ExternNoContract:
                        buffer.extend(f"extern function \"{diagnostic.name}\" has no contract: under -strict-externs every extern must declare a `requires`/`ensure` boundary contract or be annotated `@trusted(\"reason\")` to document why the unverified native body is trusted")

                    DiagnosticKind.ExternUntypedPointerParam:
                        buffer.extend(f"extern function \"{diagnostic.name}\" parameter \"{diagnostic.expected}\" is an untyped pointer (")
                        extern_untyped_pointer_spelling(diagnostic.expected_count, buffer)
                        buffer.extend(f"); declare an opaque handle with `extern Name` and use it instead of void, or mark the extern @trusted(\"reason\")")

                    DiagnosticKind.ExternUntypedPointerReturn:
                        buffer.extend(f"extern function \"{diagnostic.name}\" returns an untyped pointer (")
                        extern_untyped_pointer_spelling(diagnostic.expected_count, buffer)
                        buffer.extend(f"); declare an opaque handle with `extern Name` and return it instead of void, or mark the extern @trusted(\"reason\")")

                    DiagnosticKind.ExternPointerParamUncovered:
                        buffer.extend(f"extern function \"{diagnostic.name}\" pointer parameter \"{diagnostic.expected}\" is not covered by its contract; under -strict-externs every pointer parameter must be named by a `requires`/`ensure` clause, be an opaque handle, or the extern must be @trusted(\"reason\")")

                    DiagnosticKind.ExternPointerNoBounds:
                        buffer.extend(f"extern function \"{diagnostic.name}\" parameter \"{diagnostic.expected}\" is a pointer with no bounds; declare it as ")
                        buffer.extend(f"mutable ") if diagnostic.expected_count == 1
                        buffer.extend(f"view[{diagnostic.actual}], bind a length with @bounds({diagnostic.expected}, <length>), or mark the extern @trusted(\"reason\")")

                    DiagnosticKind.ExternResourceNoDrop:
                        buffer.extend(f"extern resource \"{diagnostic.name}\" declares no `__drop__`; add `def __drop__(self: {diagnostic.name})` in this module so the native handle is released on every exit path")

                    DiagnosticKind.ExternResourceBorrowedReturn:
                        buffer.extend(f"extern function \"{diagnostic.name}\" returns a borrowed resource handle {diagnostic.expected}&; return {diagnostic.expected} (owned) so the caller releases it, or {diagnostic.expected}? when the call can fail")

                    DiagnosticKind.ExternBoundsOdd:
                        buffer.extend(f"@bounds on extern function \"{diagnostic.name}\" expects pairs of parameter names (pointer, length), got ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" argument(s)")

                    DiagnosticKind.ExternBoundsUnknown:
                        buffer.extend(f"@bounds on extern function \"{diagnostic.name}\" names unknown parameter \"{diagnostic.expected}\"")

                    DiagnosticKind.ExternBoundsReused:
                        buffer.extend(f"@bounds on extern function \"{diagnostic.name}\" uses parameter \"{diagnostic.expected}\" more than once")

                    DiagnosticKind.ExternBoundsBadPtr:
                        buffer.extend(f"@bounds on extern function \"{diagnostic.name}\": pointer parameter \"{diagnostic.expected}\" must be a non-optional reference (`T&` or `mutable T&`)")

                    DiagnosticKind.ExternBoundsBadLen:
                        buffer.extend(f"@bounds on extern function \"{diagnostic.name}\": length parameter \"{diagnostic.expected}\" must be an integer (usize)")

                    DiagnosticKind.ExternBoundsNeedsCallConv:
                        buffer.extend(f"@bounds on extern function \"{diagnostic.name}\" requires @callconv(c): the bounded view crosses to C as (pointer, length)")

                    DiagnosticKind.ExternBoundsLengthInContract:
                        buffer.extend(f"extern function \"{diagnostic.name}\" contract names the length parameter \"{diagnostic.expected}\", which @bounds supplies from {diagnostic.actual}.count; write `{diagnostic.actual}.count` instead")

                    DiagnosticKind.EnsuresUnknownParam:
                        buffer.extend(f"ensures on function \"{diagnostic.expected}\" references unknown parameter \"{diagnostic.name}\"")

                    DiagnosticKind.EnsuresReturnNeedsBool:
                        buffer.extend(f"ensures return true on function \"{diagnostic.name}\" requires a bool return type, got {diagnostic.expected}")

                    DiagnosticKind.ImplStrengthensPrecondition:
                        buffer.extend(f"impl method \"{diagnostic.name}\" for protocol \"{diagnostic.expected}\" on {diagnostic.actual} strengthens the precondition: {diagnostic.detail}")

                    DiagnosticKind.ImplWeakensPostcondition:
                        buffer.extend(f"impl method \"{diagnostic.name}\" for protocol \"{diagnostic.expected}\" on {diagnostic.actual} weakens the postcondition: it does not guarantee {diagnostic.detail}")

                    DiagnosticKind.EnsuresRefTarget:
                        buffer.extend(f"ensures on function \"{diagnostic.expected}\" requires \"{diagnostic.name}\" to resolve to a ref target for refstate effects")
                        buffer.extend(f", got {diagnostic.actual}") if diagnostic.actual != ""

                    # stage0 spells the target's FULL type (`got mutable ParseJob&`), so the
                    # two markers travel as counts and the base name as `actual` -- a
                    # Diagnostic may only carry SOURCE sviews, and a composed spelling built
                    # in the check would dangle the moment its frame went.
                    DiagnosticKind.EnsuresStateTarget:
                        buffer.extend(f"ensures on function \"{diagnostic.expected}\" requires \"{diagnostic.name}\" to resolve to a named-state-bearing target, got ")
                        push_str(buffer, "mutable ") if diagnostic.expected_count == 1
                        buffer.extend(f"{diagnostic.actual}")
                        push_str(buffer, "&") if diagnostic.actual_count == 1

                    DiagnosticKind.EnsuresArgCount:
                        buffer.extend(f"ensures \"{diagnostic.name}\" expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" argument(s), got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.DeprecatedFunctionUse:
                        default_note = f"this function is deprecated" if diagnostic.actual == "" else f"{diagnostic.actual}"
                        buffer.extend(f"deprecated: call to \"{diagnostic.name}\" — {default_note}")

                    DiagnosticKind.InAutoDeprecated:
                        push_str(buffer, "`in auto:` is deprecated; remove the block and rely on region inference, or use `region NAME(size):` for an explicit scope")

                    DiagnosticKind.NewAutoDeprecated:
                        push_str(buffer, "`new[auto]` is deprecated; use `new` instead")

                    DiagnosticKind.ContradictoryRequires:
                        buffer.extend(f"the `requires` preconditions of \"{diagnostic.name}\" are contradictory (their conjunction is unsatisfiable); the function can never be called and its body can vacuously prove any `ensure`")

                    DiagnosticKind.PermissionReservedName:
                        buffer.extend(f"\"{diagnostic.name}\" is the reserved top permission and cannot be declared")

                    DiagnosticKind.HotArgument:
                        buffer.extend(f"@hot on function \"{diagnostic.name}\" only accepts the optional `alloc` argument")

                    DiagnosticKind.NoBoundsCheckUnproven:
                        buffer.extend(f"function \"{diagnostic.name}\" `fulfills NoBoundsChecks` but has an index access that is not statically proven in-bounds, so a runtime bounds check would be emitted")

                    DiagnosticKind.HotVectorize:
                        buffer.extend(f"@hot kernel \"{diagnostic.name}\" will not vectorize: its buffers are not provably disjoint, so LLVM keeps the runtime alias-guard around the element loop")

                    DiagnosticKind.IntrinsicNamePrefix:
                        buffer.extend(f"@intrinsic on extern function \"{diagnostic.name}\" expects an LLVM intrinsic name starting with \"llvm.\"")

                    DiagnosticKind.TrustedExternReason:
                        buffer.extend(f"@trusted on extern function \"{diagnostic.name}\" requires exactly one non-empty reason string explaining why the unverified native body is trusted")

                    DiagnosticKind.ExternLinkNameConflict:
                        buffer.extend(f"extern link_name \"{diagnostic.expected}\" for \"{diagnostic.name}\" has a signature that conflicts with a previous declaration sharing that link_name; use one shared declaration or matching wrapper to avoid native symbol splitting")

                    DiagnosticKind.LmutMutationNotReassignment:
                        if diagnostic.actual != "":
                            buffer.extend(f"mutation of `lmut` value \"{diagnostic.name}.{diagnostic.actual}\" must be a reassignment (docs/120 §10): write `{diagnostic.name}.{diagnostic.actual} <- …` so the dataflow is visible (a bare mutating call is a hidden mutation)")
                        else:
                            buffer.extend(f"mutation of `lmut` value \"{diagnostic.name}\" must be a reassignment (docs/120 §10): write `{diagnostic.name} <- …` so the dataflow is visible (a bare mutating call is a hidden mutation)")

                    DiagnosticKind.LmutFalseClaim:
                        buffer.extend(f"rebind target \"{diagnostic.name}\" claims a threaded slot, but \"{diagnostic.expected}\" neither declares lmut threading for it nor passes it to an `lmut` parameter")

                    DiagnosticKind.StaticGenerateInterpRuntime:
                        buffer.extend(f"static generate interpolation must evaluate at compile time")

                    DiagnosticKind.MutualDecreasesCycle:
                        if diagnostic.actual == "callee-measure-unsupported":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": the callee has no supported immutable positive-integer decreases measure")
                        elif diagnostic.actual == "ambiguous-callee":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": a cycle callee is ambiguous")
                        elif diagnostic.actual == "caller-measure-unsupported":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": the caller measure is outside the checked immutable positive-integer subset")
                        elif diagnostic.actual == "indirect-callee":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": a cycle call is not a direct named callee")
                        elif diagnostic.actual == "argument-arrays-unaligned":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": call arguments cannot be mapped to their names")
                        elif diagnostic.actual == "measure-argument-missing":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": the callee measure formal cannot be mapped uniquely to a call argument")
                        elif diagnostic.actual == "measure-argument-not-decreasing":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": the callee measure argument is not exactly the caller measure minus one")
                        elif diagnostic.actual == "untracked-call":
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": a cycle call has no statically tracked target")
                        else:
                            buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\": the cycle edge to \"{diagnostic.actual}\" is outside the checked one-step-decrease subset; the cycle may not terminate" if diagnostic.actual != "" else f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\"; the cycle may not terminate")

                    DiagnosticKind.PreconditionProvablyViolated:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" is violated: the argument provably does not satisfy it")
                    _:
                        handled <- false
