# Diagnostic wording helpers for reference copies and affine subjects.
extend Semantic:
    private:
        # The copied type as stage0 spells it: `actual_count` 1 named (`dstr` is `darray[u8]`),
        # 2 `expected[detail]`, 3 `dict[detail, actual]`, 4 the fixed array `expected[N]`.
        def push_ref_copy_type(buffer: mutable darray[u8]&, diagnostic: Diagnostic) -> void:
            can Memory.Allocate, Abort.Panic:
                match diagnostic.actual_count:
                    4:
                        buffer.extend(f"{diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "]")
                    3:
                        buffer.extend(f"dict[{diagnostic.detail}, {diagnostic.actual}]")
                    2:
                        buffer.extend(f"{diagnostic.expected}[{diagnostic.detail}]")
                    _:
                        push_str(buffer, "darray[u8]") if diagnostic.expected == "dstr"
                        push_sview(buffer, diagnostic.expected) if diagnostic.expected != "dstr"

        # The reference, `mutable` when `state_code` carries the +10 marker.
        def push_ref_copy_reference(buffer: mutable darray[u8]&, diagnostic: Diagnostic) -> void:
            can Memory.Allocate, Abort.Panic:
                push_str(buffer, "mutable ") if diagnostic.state_code > 10
                push_ref_copy_type(buffer, diagnostic)
                push_str(buffer, "&")

        # An affine move subject: a local, or the field path stage0 names, carried as
        # root + up to two segments (`p.h` = name "p", detail2 "h").
        def push_affine_subject(buffer: mutable darray[u8]&, diagnostic: Diagnostic) -> void:
            can Memory.Allocate, Abort.Panic:
                push_str(buffer, " \"")
                push_sview(buffer, diagnostic.name)
                buffer.extend(f".{diagnostic.detail2}") if diagnostic.detail2 != ""
                buffer.extend(f".{diagnostic.detail3}") if diagnostic.detail3 != ""
                push_str(buffer, "\"")
