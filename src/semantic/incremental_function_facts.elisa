# Portable, in-memory direct semantic facts for a translation-unit function body.
# Unsupported syntax remains on the cold checker path. Reusable records contain only owned
# byte spans, stable source names, direct facts, and body-relative token anchors.
extend Semantic:
    public:
        const INCREMENTAL_FUNCTION_FACTS_SCHEMA: u32 = 3
        # Bump whenever a semantic change can alter the meaning of facts consumed by
        # checker replay. This is deliberately separate from the wire schema: a cache
        # can decode correctly yet describe different checker semantics.
        const INCREMENTAL_SEMANTIC_ENGINE_VERSION: u64 = 3
        const INCREMENTAL_FACT_HASH_OFFSET: u64 = 14695981039346656037
        const INCREMENTAL_NO_ANCHOR: u32 = 4294967295
        const INCREMENTAL_FACT_HASH_PRIME: u64 = 1099511628211
        const INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT: usize = 8

        const enum IncrementalFactKind of u8:
            DirectCall
            GlobalRead
            GlobalWrite
            CanGrant
            TrustedGrant
            PanicSite

        const enum IncrementalGrantKind of u8:
            Can
            Trusted

        const enum IncrementalRejectReason of u8:
            None
            MissingStablePath
            NonUniqueOrGenericFunction
            MissingBlockBody
            UnsupportedBodySyntax
            MissingSourceAnchor
            InvalidTokenSpan
            UnsupportedSignature

        # These graph-local IDs are deliberately distinct from DeclId/BindingId,
        # which are rebuilt with each SymbolTable. They never leave the private graph.
        const INCREMENTAL_SEMANTIC_QUERY_NONE: u32 = 4294967295
        # Admission caps for the session query graph. The node cap also bounds the
        # number of possible hash-index entries; the byte estimate includes conservative
        # map/index overhead but does not account for allocator capacity rounding.
        const INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT: usize = 8388608
        const INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT: usize = 16777216
        const INCREMENTAL_SEMANTIC_QUERY_NODE_LIMIT: usize = 65536
        const INCREMENTAL_SEMANTIC_QUERY_EDGE_LIMIT: usize = 262144
        const INCREMENTAL_SEMANTIC_QUERY_PER_DEPENDENCY_LIMIT: usize = 4096
        const INCREMENTAL_SEMANTIC_QUERY_RETAINED_BYTES_LIMIT: usize = 33554432
        private const INCREMENTAL_SEMANTIC_QUERY_KEY_VERSION: u32 = 1
        private const INCREMENTAL_SEMANTIC_NAME_LOOKUP_KEY_VERSION: u32 = 2
        private const INCREMENTAL_SEMANTIC_QUERY_RESULT_VERSION: u32 = 1

        private const enum IncrementalSemanticQueryKind of u8:
            SourceInput
            FunctionBodyFacts
            FunctionSummary
            VisibleNameSet
            NameLookup
            TypeOf
            ConstantValue

        private const enum IncrementalSemanticQueryStatus of u8:
            Dirty
            PotentiallyDirty
            Green

        private struct IncrementalSemanticQueryId:
            value: u32

        private struct IncrementalSemanticDependencyEdgeId:
            value: u32

        private struct IncrementalSemanticQueryHandle[@r]:
            private:
                node: IncrementalSemanticQueryId
                session_cookie: uintptr
                graph_generation: u64
                request_generation: u64
                context_generation: u64

        private struct IncrementalSemanticQueryEvaluation:
            hit: bool
            result_start: usize
            result_length: usize

        private struct IncrementalSemanticQueryValueSize:
            valid: bool
            byte_count: usize

        private struct IncrementalSemanticQueryDependencyCheck:
            valid: mutable bool
            structural: mutable bool
            equal: mutable bool
            results_current: mutable bool
            all_dependencies_green: mutable bool
            unique_count: mutable usize
            old_count: mutable usize
            dependency_ids: mutable darray[IncrementalSemanticQueryId]

        private struct IncrementalSemanticQueryWalkResult:
            valid: mutable bool
            budget_ok: mutable bool
            reaches_target: mutable bool

        private struct IncrementalSemanticQueryStagedFact:
            kind: IncrementalFactKind
            subject_start: usize
            subject_length: usize
            anchor_token: u32
            active_grant_start: usize
            active_grant_count: usize

        private struct IncrementalSemanticQueryStagedGrant:
            kind: IncrementalGrantKind
            name_start: usize
            name_length: usize

        private struct IncrementalSemanticQueryNode:
            # Keep status and adjacency links together at the front: invalidation walks
            # this state before it needs the colder key spans or fingerprints. Grouping
            # fields by alignment also avoids padding between every 32-bit handle and
            # 64-bit value in the dense node array.
            kind: IncrementalSemanticQueryKind
            status: mutable IncrementalSemanticQueryStatus
            # Collision chain in query_key_heads. Key bytes are owned by the session.
            next_same_hash: IncrementalSemanticQueryId
            # Outgoing edges are this query's dependencies; incoming edges are its dependers.
            first_dependency: mutable IncrementalSemanticDependencyEdgeId
            first_depender: mutable IncrementalSemanticDependencyEdgeId
            incoming_edge_count: mutable u32
            incoming_chain_generation: mutable u64
            incoming_chain_validated_generation: mutable u64
            # Session generation of the last bounded graph walk.
            last_invalidation_generation: mutable u64
            key_hash: u64
            # These six spans index pools capped at 8/16 MiB. Store offsets and
            # lengths narrowly; admission checks them before explicit widening at
            # each pool access.
            key_start: u32
            key_length: u32
            has_committed_value: mutable bool
            input_start: mutable u32
            input_length: mutable u32
            result_start: mutable u32
            result_length: mutable u32
            input_fingerprint: mutable u64
            result_fingerprint: mutable u64
            result_generation: mutable u64

        private struct IncrementalSemanticDependencyEdge:
            # A NONE endpoint marks a reusable free-list slot.
            depender: mutable IncrementalSemanticQueryId
            dependee: mutable IncrementalSemanticQueryId
            next_dependency: mutable IncrementalSemanticDependencyEdgeId
            previous_depender: mutable IncrementalSemanticDependencyEdgeId
            next_depender: mutable IncrementalSemanticDependencyEdgeId
            observed_result_generation: mutable u64

        # These spans address the snapshot-owned byte pool, not source buffers or intern tables.
        struct IncrementalFunctionFactRecord:
            key_start: usize
            key_length: usize
            body_start: usize
            body_length: usize
            body_hash: u64
            direct_fact_start: mutable usize
            direct_fact_count: mutable usize
            cacheable: mutable bool
            matched_previous: mutable bool
            reject_reason: mutable IncrementalRejectReason

        # Subject is a stable path/name key for calls and globals, or an effect name for panic.
        # The anchor is a token ordinal relative to the owning function body.
        # Invocation-local source positions, keyed by the function-record owner slot. These
        # are rebuilt on every collection and are never part of the portable persisted facts.
        struct IncrementalFunctionSourceAnchor:
            definition_offset: u32
            body_token_start: usize
            body_token_end: usize

        struct IncrementalDirectFact:
            owner: usize
            kind: IncrementalFactKind
            subject_start: usize
            subject_length: usize
            anchor_token: u32
            active_grant_start: usize
            active_grant_count: usize

        struct IncrementalActiveGrant:
            kind: IncrementalGrantKind
            name_start: usize
            name_length: usize

        # Separate syntactic-linter facts and coverage. `complete` says the canonical
        # self-assignment traversal finished and every emitted finding has two usable
        # body-relative token anchors; it does not imply direct-effect cacheability.
        # `reused_previous` is collection accounting only: fresh scans and reused facts
        # are both rebound to current-source anchors before replay.
        struct IncrementalSelfAssignmentFactRange:
            start: usize
            count: usize
            complete: mutable bool
            reused_previous: mutable bool

        struct IncrementalSelfAssignmentFact:
            target_anchor_token: u32
            statement_anchor_token: u32

        # Invocation-local rebindings. These are intentionally omitted from the snapshot
        # codec and are rebuilt from current tokens after a session snapshot is cloned.
        struct IncrementalSelfAssignmentAnchor:
            name: sview
            target_position: Ast::Pos
            statement_line: u32

        # Declaration-surface v1 is an exact token stream with supported function bodies
        # removed while every function header remains. Any unsupported body stays in the
        # surface and conservatively invalidates all records when edited.
        struct IncrementalSemanticSnapshot:
            schema_version: mutable u32
            semantic_fingerprint: mutable u64
            # Fast prefilter; collisions never authorize reuse.
            options_fingerprint: mutable u64
            # Exact versioned semantic-options identity.
            options_key: mutable darray[u8]
            bytes: mutable darray[u8]
            source_path_start: mutable usize
            source_path_length: mutable usize
            declaration_surface_start: mutable usize
            declaration_surface_length: mutable usize
            declaration_surface_hash: mutable u64
            functions: mutable darray[IncrementalFunctionFactRecord]
            current_anchors: mutable darray[IncrementalFunctionSourceAnchor]
            direct_facts: mutable darray[IncrementalDirectFact]
            active_grants: mutable darray[IncrementalActiveGrant]
            self_assignment_ranges: mutable darray[IncrementalSelfAssignmentFactRange]
            self_assignment_facts: mutable darray[IncrementalSelfAssignmentFact]
            current_self_assignment_anchors: mutable darray[IncrementalSelfAssignmentAnchor]
            bodies_visited: mutable u32
            bodies_matched: mutable u32
            bodies_rejected: mutable u32
            self_assignment_bodies_scanned: mutable u32
            self_assignment_bodies_reused: mutable u32
            # Invocation/session-only proof that the exact declaration surface was
            # completely encoded. Omitted from the sidecar codec.
            declaration_surface_valid: mutable bool
            surface_compatible: mutable bool

        # A session retains only portable scalar/byte facts. Invocation anchors,
        # including source-borrowing self-assignment names, are rebuilt per request.
        private struct IncrementalSemanticSessionSnapshot[@r]:
            schema_version: mutable u32
            semantic_fingerprint: mutable u64
            options_fingerprint: mutable u64
            options_key: mutable darray[u8] @r
            bytes: mutable darray[u8] @r
            source_path_start: mutable usize
            source_path_length: mutable usize
            declaration_surface_start: mutable usize
            declaration_surface_length: mutable usize
            declaration_surface_hash: mutable u64
            functions: mutable darray[IncrementalFunctionFactRecord] @r
            direct_facts: mutable darray[IncrementalDirectFact] @r
            active_grants: mutable darray[IncrementalActiveGrant] @r
            self_assignment_ranges: mutable darray[IncrementalSelfAssignmentFactRange] @r
            self_assignment_facts: mutable darray[IncrementalSelfAssignmentFact] @r
            bodies_visited: mutable u32
            bodies_matched: mutable u32
            bodies_rejected: mutable u32
            self_assignment_bodies_scanned: mutable u32
            self_assignment_bodies_reused: mutable u32
            declaration_surface_valid: mutable bool
            surface_compatible: mutable bool

        # Callers retain this object, but only Semantic can access or replace its
        # previous facts. No public API accepts a raw snapshot as a trusted prior.
        struct IncrementalSemanticSession[@r]:
            private:
                enabled: bool
                # The benchmark switch disables only query-graph work. The trusted
                # session snapshot and its exact-body reuse path remain enabled.
                query_graph_enabled: mutable bool
                valid: mutable bool
                analyzed_source: mutable darray[u8] @r
                identity_key: mutable darray[u8] @r
                options_key: mutable darray[u8] @r
                generated_input: mutable bool
                semantic_fingerprint: mutable u64
                snapshot: mutable IncrementalSemanticSessionSnapshot[r]
                # Query keys stay owned for the lifetime of this session. Edges refer only
                # to compact IDs, never to keys or current SymbolTable rows.
                query_key_bytes: mutable darray[u8] @r
                query_key_heads: mutable dict[u64, IncrementalSemanticQueryId] @r
                query_nodes: mutable darray[IncrementalSemanticQueryNode] @r
                query_edges: mutable darray[IncrementalSemanticDependencyEdge] @r
                free_query_edges: mutable darray[IncrementalSemanticDependencyEdgeId] @r
                # Canonical inputs and result payloads are retained exactly. Fingerprints
                # are only prefilters and never authorize a hit or red-to-green stop.
                query_value_bytes: mutable darray[u8] @r
                query_graph_generation: mutable u64
                query_request_generation: mutable u64
                query_context_generation: mutable u64
                query_graph_poisoned: mutable bool
                query_invalidation_generation: mutable u64
                query_invalidation_worklist: mutable darray[IncrementalSemanticQueryId] @r

        # Borrowed only for one semantic-gate request. Handles are reacquired after
        # collection/publication and are never retained in the portable fact snapshot.
        struct IncrementalSemanticNameLookupContext[@r]:
            private:
                session: mutable IncrementalSemanticSession[r]&? @r
                source_input: mutable IncrementalSemanticQueryHandle[r]
                active: mutable bool
                track_stats: bool
                lookup_hits: mutable u64
                classification_chain_visits: mutable u64
                # Reused for one synchronous evaluate -> cold-classify -> commit sequence.
                # Query graph APIs consume these buffers synchronously and copy stored bytes.
                lookup_key_scratch: mutable darray[u8]
                lookup_input_scratch: mutable darray[u8]
                lookup_scratch_ready: mutable bool

        struct IncrementalSemanticNameLookupResult:
            hit: bool
            known: bool
            module_only: bool

        struct IncrementalSemanticNameLookupStats:
            hits: u64
            classification_chain_visits: u64

        struct IncrementalSessionCollectionResult:
            snapshot: IncrementalSemanticSnapshot
            prior_valid: bool
            exact_hit: bool
            body_facts_reused: bool
            function_body_facts_restored: u32
            body_query_publish_skips: u32
            prior_snapshot_fact_fallbacks: u32
            cold_body_scans: u32
            source_input_admitted: bool

        # Request-local evidence that a FunctionBodyFacts node was Green and its
        # canonical direct facts were restored against this exact request snapshot.
        # Query IDs and pool spans are meaningful only in the recorded graph generation;
        # this is evidence, never a handle retained across context/request changes.
        private struct IncrementalSemanticBodyQueryHitMarker:
            function_record_index: usize
            query_id: IncrementalSemanticQueryId
            query_result_generation: u64
            source_result_generation: u64
            graph_generation: u64
            body_start: usize
            body_length: usize
            direct_facts_restored: bool

        private struct IncrementalFunctionFactsRequestMetrics:
            function_body_facts_restored: mutable u32
            body_query_publish_skips: mutable u32
            prior_snapshot_fact_fallbacks: mutable u32
            cold_body_scans: mutable u32
            source_input_admitted: mutable bool
            validated_body_query_generation: mutable u64
            validated_body_query_hits: mutable darray[IncrementalSemanticBodyQueryHitMarker]

        private def ifc_increment_candidate_metric(count: mutable u32, candidate_count: usize) -> void:
            can Abort.Panic:
                return if count == 4294967295 or count.u64() >= candidate_count.u64()
                count <- count + 1

        def incremental_empty_snapshot() -> IncrementalSemanticSnapshot:
            can Memory.Allocate:
                return IncrementalSemanticSnapshot{schema_version: 0, semantic_fingerprint: 0, options_fingerprint: 0, options_key: [], bytes: [], source_path_start: 0, source_path_length: 0, declaration_surface_start: 0, declaration_surface_length: 0, declaration_surface_hash: 0, functions: [], current_anchors: [], direct_facts: [], active_grants: [], self_assignment_ranges: [], self_assignment_facts: [], current_self_assignment_anchors: [], bodies_visited: 0, bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_scanned: 0, self_assignment_bodies_reused: 0, declaration_surface_valid: false, surface_compatible: false}

        private struct IncrementalFactCandidate:
            name: sview
            parameters: darray[Ast::ParamDecl]
            return_type: Ast::Expr?
            body: darray[Ast::Stmt]
            definition_offset: u32
            definition_token: usize
            generic_header: bool
            span_ordered: bool
            body_token_start: usize
            body_token_end: usize
            skip_start: usize
            skip_end: usize
            owner: usize
            header_supported: mutable bool
            prior_record: mutable usize
            prior_record_cacheable: mutable bool
            prior_body_matches: mutable bool
            scanned: mutable bool

        private struct IncrementalFactTokenSpan:
            found: bool
            body_start: usize
            body_end: usize
            skip_start: usize
            skip_end: usize
            definition_token: usize

        private struct IncrementalFactWalkGrant:
            kind: IncrementalGrantKind
            name: sview

    private:
        def ifc_read_u32(bytes: darray[u8]&, start: usize) -> u32:
            can Abort.Panic:
                value: mutable u32 = 0
                for shift in 0..<4 |value|:
                    value <- value | (bytes[start + shift].u32() << (shift * 8))
                return value

        def ifc_append_u32_bytes(bytes: mutable darray[u8]&, value: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                encoded: u8[4]
                encoded[0] <- (value & 255).u8()
                encoded[1] <- ((value >> 8) & 255).u8()
                encoded[2] <- ((value >> 16) & 255).u8()
                encoded[3] <- ((value >> 24) & 255).u8()
                if Lexer::make_source_view(&encoded[0], 4, 0, 4) is view:
                    bytes.extend(view)

        def ifc_append_u32(snapshot: mutable IncrementalSemanticSnapshot&, value: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                ifc_append_u32_bytes(snapshot.bytes, value)

        def ifc_append_view(snapshot: mutable IncrementalSemanticSnapshot&, value: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                snapshot.bytes.extend(value)

        # The returned view is consumed immediately by darray.extend, which copies its bytes.
        def ifc_byte_span(source: darray[u8]&, start: usize, length: usize) -> sview?:
            can Abort.Panic:
                assert start <= source.count
                assert length <= source.count - start
                return null if length == 0
                return Lexer::make_source_view(&source[0], source.count, start, start + length)

        def ifc_append_name(snapshot: mutable IncrementalSemanticSnapshot&, path: sview, name: sview) -> (start: usize, length: usize):
            can Memory.Allocate, Abort.Panic:
                start: usize = snapshot.bytes.count
                ifc_append_u32(snapshot, path.len.u32())
                ifc_append_view(snapshot, path)
                ifc_append_u32(snapshot, name.len.u32())
                ifc_append_view(snapshot, name)
                return (start, snapshot.bytes.count - start)

        def ifc_append_token_bytes(bytes: mutable darray[u8]&, source: u8&, source_length: usize, token: Lexer::Token) -> bool:
            can Memory.Allocate, Abort.Panic:
                token_start: usize = token.start.usize()
                text_length: usize = token.length.usize() + token.suffix_length.usize()
                return false if token_start > source_length or text_length > source_length - token_start
                ifc_append_u32_bytes(bytes, token.kind.u32())
                ifc_append_u32_bytes(bytes, text_length.u32())
                if text_length != 0:
                    if Lexer::make_source_view(source, source_length, token_start, token_start + text_length) is text:
                        bytes.extend(text)
                    else:
                        return false
                return true

        def ifc_append_token(snapshot: mutable IncrementalSemanticSnapshot&, source: u8&, source_length: usize, token: Lexer::Token) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ifc_append_token_bytes(snapshot.bytes, source, source_length, token)

        def ifc_append_tokens(snapshot: mutable IncrementalSemanticSnapshot&, source: u8&, source_length: usize, tokens: darray[Lexer::Token]&, start: usize, end: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if start > end or end > tokens.count
                for index in start..<end |snapshot|:
                    return false if not ifc_append_token(snapshot, source, source_length, tokens[index])
                return true

        def ifc_hash(bytes: darray[u8]&, start: usize, length: usize) -> u64:
            can Abort.Panic:
                hash: mutable u64 = INCREMENTAL_FACT_HASH_OFFSET
                for index in start..<start + length |hash|:
                    hash <- (hash ^ bytes[index].u64()) * INCREMENTAL_FACT_HASH_PRIME
                return hash

        def ifc_equal(left: darray[u8]&, left_start: usize, left_length: usize, right: darray[u8]&, right_start: usize, right_length: usize) -> bool:
            can Abort.Panic:
                return false if:
                    left_length != right_length
                    left_start > left.count or left_length > left.count - left_start
                    right_start > right.count or right_length > right.count - right_start
                for offset in 0..<left_length:
                    return false if left[left_start + offset] != right[right_start + offset]
                return true

        def ifc_token_span(tokens: darray[Lexer::Token]&, definition: usize) -> IncrementalFactTokenSpan:
            can Abort.Panic:
                if definition >= tokens.count or tokens[definition].kind != TokenKind.Def:
                    return IncrementalFactTokenSpan{found: false, body_start: 0, body_end: 0, skip_start: 0, skip_end: 0, definition_token: tokens.count}
                indent: mutable usize = tokens.count
                scan: mutable usize = definition + 1
                while scan < tokens.count:
                    kind: TokenKind = tokens[scan].kind
                    if kind == TokenKind.Indent:
                        indent <- scan
                        break
                    if kind == TokenKind.Def or kind == TokenKind.Dedent or kind == TokenKind.Eof:
                        break
                    scan <- scan + 1
                if indent >= tokens.count:
                    return IncrementalFactTokenSpan{found: false, body_start: 0, body_end: 0, skip_start: 0, skip_end: 0, definition_token: definition}
                depth: mutable u32 = 1
                scan <- indent + 1
                while scan < tokens.count:
                    if tokens[scan].kind == TokenKind.Indent:
                        depth <- depth + 1
                    elif tokens[scan].kind == TokenKind.Dedent:
                        depth <- depth - 1
                        if depth == 0:
                            return IncrementalFactTokenSpan{found: true, body_start: indent + 1, body_end: scan, skip_start: indent, skip_end: scan + 1, definition_token: definition}
                    scan <- scan + 1
                return IncrementalFactTokenSpan{found: false, body_start: 0, body_end: 0, skip_start: 0, skip_end: 0, definition_token: definition}

        def ifc_generic_header(tokens: darray[Lexer::Token]&, definition: usize) -> bool:
            can Abort.Panic:
                name_token: mutable usize = definition + 1
                while name_token < tokens.count and tokens[name_token].kind != TokenKind.Ident:
                    name_token <- name_token + 1
                return false if name_token + 1 >= tokens.count
                return tokens[name_token + 1].kind == TokenKind.LBracket

        def ifc_contains(names: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                for item in names:
                    return true if item == name
                return false

        # Invocation-local index: hashes narrow lookup, exact name bytes decide equality.
        private struct IncrementalCandidateNameIndex:
            heads: mutable darray[usize] = []
            next: mutable darray[usize] = []

        def ifc_candidate_name_hash(name: sview) -> u64:
            can Abort.Panic:
                hash: u64 = for offset in 0..<name.len |hash: u64 = INCREMENTAL_FACT_HASH_OFFSET| -> hash:
                    hash <- (hash ^ name[offset].u64()) * INCREMENTAL_FACT_HASH_PRIME
                return hash

        # Invocation-local membership index for the translation unit's global names.
        # Hashes choose a bucket only; exact sview equality remains authoritative.
        private struct IncrementalStringNameIndex:
            heads: mutable darray[usize] = []
            next: mutable darray[usize] = []

        def ifc_string_name_index(names: darray[sview]&, index: mutable IncrementalStringNameIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                index.heads.resize(names.count)
                index.next.resize(names.count)
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- names.count
                for reverse_row in 0..<names.count |index|:
                    row: usize = names.count - 1 - reverse_row
                    bucket: usize = (ifc_candidate_name_hash(names[row]) % index.heads.count.u64()).usize()
                    index.next[row] <- index.heads[bucket]
                    index.heads[bucket] <- row

        def ifc_string_name_contains(names: darray[sview]&, name: sview, index: IncrementalStringNameIndex&) -> bool:
            can Abort.Panic:
                return ifc_contains(names, name) if names.count < INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT or index.heads.count != names.count or index.next.count != names.count
                bucket: usize = (ifc_candidate_name_hash(name) % index.heads.count.u64()).usize()
                row: mutable usize = index.heads[bucket]
                while row < names.count |row|:
                    return true if names[row] == name
                    row <- index.next[row]
                return false

        def ifc_candidate_name_index(candidates: darray[IncrementalFactCandidate]&, index: mutable IncrementalCandidateNameIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                index.heads.resize(candidates.count)
                index.next.resize(candidates.count)
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- candidates.count
                for reverse_row in 0..<candidates.count |index|:
                    row: usize = candidates.count - 1 - reverse_row
                    bucket: usize = (ifc_candidate_name_hash(candidates[row].name) % index.heads.count.u64()).usize()
                    index.next[row] <- index.heads[bucket]
                    index.heads[bucket] <- row

        def ifc_name_unique(candidates: darray[IncrementalFactCandidate]&, name: sview, index: IncrementalCandidateNameIndex&) -> bool:
            can Abort.Panic:
                return false if index.heads.count == 0
                bucket: usize = (ifc_candidate_name_hash(name) % index.heads.count.u64()).usize()
                count: mutable usize = 0
                row: mutable usize = index.heads[bucket]
                while row < candidates.count |row, count|:
                    count <- count + 1 if candidates[row].name == name
                    return false if count > 1
                    row <- index.next[row]
                return count == 1

        # Hash buckets narrow the search; exact owned-key bytes remain authoritative.
        # Reverse insertion preserves ascending row order and the old first-match rule.
        private struct IncrementalPriorKeyIndex:
            heads: mutable darray[usize] = []
            next: mutable darray[usize] = []

        def ifc_prior_key_index(previous: IncrementalSemanticSnapshot&, index: mutable IncrementalPriorKeyIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                index.next.resize(previous.functions.count)
                index.heads.resize(previous.functions.count)
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- previous.functions.count
                for reverse_row in 0..<previous.functions.count |index|:
                    row: usize = previous.functions.count - 1 - reverse_row
                    prior: IncrementalFunctionFactRecord = previous.functions[row]
                    index.next[row] <- previous.functions.count
                    continue if prior.key_start > previous.bytes.count or prior.key_length > previous.bytes.count - prior.key_start
                    hash: u64 = ifc_hash(previous.bytes, prior.key_start, prior.key_length)
                    bucket: usize = (hash % index.heads.count.u64()).usize()
                    index.next[row] <- index.heads[bucket]
                    index.heads[bucket] <- row

        def ifc_prior_index(previous: IncrementalSemanticSnapshot&, bytes: darray[u8]&, key_start: usize, key_length: usize, index: IncrementalPriorKeyIndex&) -> usize:
            can Abort.Panic:
                return previous.functions.count if key_start > bytes.count or key_length > bytes.count - key_start
                hash: u64 = ifc_hash(bytes, key_start, key_length)
                return previous.functions.count if index.heads.count == 0
                bucket: usize = (hash % index.heads.count.u64()).usize()
                row: mutable usize = index.heads[bucket]
                while row < previous.functions.count |row|:
                    prior: IncrementalFunctionFactRecord = previous.functions[row]
                    return row if ifc_equal(bytes, key_start, key_length, previous.bytes, prior.key_start, prior.key_length)
                    row <- index.next[row]
                return previous.functions.count

        def ifc_safe_return_type(expression: Ast::Expr, aliases: darray[sview]&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return false if ifc_contains(aliases, name)
                        return when name:
                            "void" | "bool" | "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "usize" | "isize" | "int" | "float" | "f32" | "f64" | "char" | "str" | "cstr" -> true
                            _ -> false
                    _:
                        return false

        def ifc_signature_supported(parameters: darray[Ast::ParamDecl], return_type: Ast::Expr?, aliases: darray[sview]&) -> bool:
            can Abort.Panic:
                if return_type is declared_return:
                    return false if not ifc_safe_return_type(declared_return, aliases)
                else:
                    return false
                for parameter in parameters:
                    return false if parameter.has_default
                return true

        def ifc_call_target(candidates: darray[IncrementalFactCandidate]&, name: sview, candidate_names: IncrementalCandidateNameIndex&) -> bool:
            can Abort.Panic:
                return false if candidate_names.heads.count == 0
                bucket: usize = (ifc_candidate_name_hash(name) % candidate_names.heads.count.u64()).usize()
                matches: mutable usize = 0
                row: mutable usize = candidate_names.heads[bucket]
                while row < candidates.count |row, matches|:
                    candidate: IncrementalFactCandidate = candidates[row]
                    row <- candidate_names.next[row]
                    continue if candidate.name != name
                    matches <- matches + 1
                    return false if matches > 1 or not candidate.header_supported or candidate.parameters.count != 0
                return matches == 1

        def ifc_anchor(tokens: darray[Lexer::Token]&, body_start: usize, body_end: usize, offset: u32) -> u32:
            can Abort.Panic:
                return INCREMENTAL_NO_ANCHOR if:
                    offset == 0
                    body_start >= body_end or body_end > tokens.count
                # Token spans are ordered and non-overlapping. Find the first token whose
                # full spelling (including a numeric suffix) ends after OFFSET. This is
                # also the first token after OFFSET when it lies in inter-token whitespace.
                low: mutable usize = body_start
                high: mutable usize = body_end
                while low < high |low, high, tokens, offset|:
                    middle: usize = low + (high - low) / 2
                    token: Lexer::Token = tokens[middle]
                    end: u32 = token.start + token.length + token.suffix_length.u32()
                    if end <= offset:
                        low <- middle + 1
                    else:
                        high <- middle
                if low < body_end:
                    return (low - body_start).u32()
                return INCREMENTAL_NO_ANCHOR

        def ifc_exact_token_anchor(tokens: darray[Lexer::Token]&, body_start: usize, body_end: usize, position: Ast::Pos) -> u32:
            can Abort.Panic:
                anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                return INCREMENTAL_NO_ANCHOR if anchor == INCREMENTAL_NO_ANCHOR
                token: Lexer::Token = tokens[body_start + anchor.usize()]
                return INCREMENTAL_NO_ANCHOR if:
                    token.start != position.offset
                    token.line != position.line or token.line != position.end_line
                    token.column != position.column
                    token.column + token.length != position.end_column
                    token.start + token.length != position.end_offset
                return anchor

        def ifc_rebind_self_assignment_anchor(tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, body_start: usize, body_end: usize, target_anchor: u32, statement_anchor: u32) -> (valid: bool, anchor: IncrementalSelfAssignmentAnchor):
            can Abort.Panic:
                invalid: IncrementalSelfAssignmentAnchor = IncrementalSelfAssignmentAnchor{name: "", target_position: Ast::pos_at_line(0), statement_line: 0}
                return (false, invalid) if:
                    body_start >= body_end or body_end > tokens.count
                    target_anchor == INCREMENTAL_NO_ANCHOR or statement_anchor == INCREMENTAL_NO_ANCHOR
                    target_anchor.usize() >= body_end - body_start or statement_anchor.usize() >= body_end - body_start
                target_token: Lexer::Token = tokens[body_start + target_anchor.usize()]
                statement_token: Lexer::Token = tokens[body_start + statement_anchor.usize()]
                return (false, invalid) if:
                    target_token.kind != TokenKind.Ident
                    target_token.suffix_length != 0
                    statement_token.start == 0
                    statement_token.line == 0
                position: Ast::Pos = Ast::Pos{line: target_token.line, column: target_token.column, offset: target_token.start, end_line: target_token.line, end_column: target_token.column + target_token.length, end_offset: target_token.start + target_token.length}
                anchor: IncrementalSelfAssignmentAnchor = IncrementalSelfAssignmentAnchor{name: Lexer::text_or_empty(target_token, source, source_length), target_position: position, statement_line: statement_token.line}
                return (true, anchor)

        def ifc_self_assignment_fact_capacity(snapshot: IncrementalSemanticSnapshot&) -> usize:
            can Abort.Panic:
                return 0 if snapshot.self_assignment_facts.count >= 1000000 or snapshot.self_assignment_ranges.count > 1000000 or snapshot.bytes.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT
                fact_count: u64 = snapshot.self_assignment_facts.count.u64()
                range_count: u64 = snapshot.self_assignment_ranges.count.u64()
                # Facts are two u32 token ordinals. Budget 64 bytes per finding for its
                # invocation-local anchor and 32 per function range, with alignment headroom.
                snapshot_baseline: u64 = 146 + snapshot.bytes.count.u64() + snapshot.options_key.count.u64() + snapshot.functions.count.u64() * 72 + snapshot.direct_facts.count.u64() * 56 + snapshot.active_grants.count.u64() * 24
                total: u64 = snapshot_baseline + fact_count * 64 + range_count * 32
                return 0 if total >= INCREMENTAL_SNAPSHOT_CODEC_LIMIT.u64()
                by_bytes: usize = ((INCREMENTAL_SNAPSHOT_CODEC_LIMIT.u64() - total) / 64).usize()
                by_count: usize = 1000000 - snapshot.self_assignment_facts.count
                return by_bytes if by_bytes < by_count else by_count

        def ifc_self_assignment_storage_within_limit(snapshot: IncrementalSemanticSnapshot&, additional_facts: usize) -> bool:
            can Abort.Panic:
                return additional_facts <= ifc_self_assignment_fact_capacity(snapshot)

        def ifc_self_assignment_forget(snapshot: mutable IncrementalSemanticSnapshot&) -> void:
            can Memory.Allocate:
                snapshot.self_assignment_facts.truncate(0)
                snapshot.current_self_assignment_anchors.truncate(0)
                for index in 0..<snapshot.self_assignment_ranges.count |snapshot|:
                    snapshot.self_assignment_ranges[index] <- IncrementalSelfAssignmentFactRange{start: 0, count: 0, complete: false, reused_previous: false}
                snapshot.self_assignment_bodies_reused <- 0

        def ifc_scan_self_assignment_candidate(index: usize, candidates: darray[IncrementalFactCandidate]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, snapshot: mutable IncrementalSemanticSnapshot&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if index >= candidates.count
                candidate: IncrementalFactCandidate = candidates[index]
                start: usize = snapshot.self_assignment_facts.count
                if not candidate.header_supported or candidate.body_token_start >= candidate.body_token_end or candidate.body_token_end > tokens.count:
                    snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: 0, complete: false, reused_previous: false}
                    return
                findings: mutable darray[SelfAssignmentFinding] = []
                collection_complete: mutable bool = true
                snapshot.self_assignment_bodies_scanned <- snapshot.self_assignment_bodies_scanned + 1
                collect_self_assignment_findings_bounded(candidate.body, ifc_self_assignment_fact_capacity(snapshot), &findings, &collection_complete)
                if not collection_complete:
                    snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: 0, complete: false, reused_previous: false}
                    return
                if not ifc_self_assignment_storage_within_limit(snapshot, findings.count):
                    snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: 0, complete: false, reused_previous: false}
                    return
                staged_facts: mutable darray[IncrementalSelfAssignmentFact] = []
                staged_anchors: mutable darray[IncrementalSelfAssignmentAnchor] = []
                staged_facts.reserve(findings.count)
                staged_anchors.reserve(findings.count)
                # Preflight every finding before extending snapshot storage. A single
                # synthetic or ambiguous position keeps the whole function cold.
                for finding in findings:
                    target_anchor: u32 = ifc_exact_token_anchor(tokens, candidate.body_token_start, candidate.body_token_end, finding.target_position)
                    statement_anchor: u32 = ifc_exact_token_anchor(tokens, candidate.body_token_start, candidate.body_token_end, finding.statement_position)
                    return if target_anchor == INCREMENTAL_NO_ANCHOR or statement_anchor == INCREMENTAL_NO_ANCHOR
                    rebound: (valid: bool, anchor: IncrementalSelfAssignmentAnchor) = ifc_rebind_self_assignment_anchor(tokens, source, source_length, candidate.body_token_start, candidate.body_token_end, target_anchor, statement_anchor)
                    return if not rebound.valid or rebound.anchor.name != finding.name
                    staged_facts.push(IncrementalSelfAssignmentFact{target_anchor_token: target_anchor, statement_anchor_token: statement_anchor})
                    staged_anchors.push(rebound.anchor)
                for fact in staged_facts |snapshot|:
                    snapshot.self_assignment_facts.push(fact)
                for anchor in staged_anchors |snapshot|:
                    snapshot.current_self_assignment_anchors.push(anchor)
                snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: findings.count, complete: true, reused_previous: false}

        # Reuse is authorized only by the private session collector's exact function key
        # and exact token-body comparison. Hashes are never consulted here.
        def ifc_reuse_previous_self_assignment_candidate(index: usize, candidates: darray[IncrementalFactCandidate]&, previous: IncrementalSemanticSnapshot&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if index >= candidates.count
                candidate: IncrementalFactCandidate = candidates[index]
                return false if not candidate.header_supported or not candidate.prior_body_matches or candidate.prior_record >= previous.self_assignment_ranges.count
                old_range: IncrementalSelfAssignmentFactRange = previous.self_assignment_ranges[candidate.prior_record]
                return false if not old_range.complete or old_range.start > previous.self_assignment_facts.count or old_range.count > previous.self_assignment_facts.count - old_range.start
                return false if not ifc_self_assignment_storage_within_limit(snapshot, old_range.count)
                rebound_anchors: mutable darray[IncrementalSelfAssignmentAnchor] = []
                rebound_anchors.reserve(old_range.count)
                for relative in 0..<old_range.count |rebound_anchors|:
                    old_fact: IncrementalSelfAssignmentFact = previous.self_assignment_facts[old_range.start + relative]
                    rebound: (valid: bool, anchor: IncrementalSelfAssignmentAnchor) = ifc_rebind_self_assignment_anchor(tokens, source, source_length, candidate.body_token_start, candidate.body_token_end, old_fact.target_anchor_token, old_fact.statement_anchor_token)
                    return false if not rebound.valid
                    rebound_anchors.push(rebound.anchor)
                start: usize = snapshot.self_assignment_facts.count
                for relative in 0..<old_range.count |snapshot|:
                    old_fact: IncrementalSelfAssignmentFact = previous.self_assignment_facts[old_range.start + relative]
                    snapshot.self_assignment_facts.push(IncrementalSelfAssignmentFact{target_anchor_token: old_fact.target_anchor_token, statement_anchor_token: old_fact.statement_anchor_token})
                    snapshot.current_self_assignment_anchors.push(rebound_anchors[relative])
                snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: old_range.count, complete: true, reused_previous: true}
                snapshot.self_assignment_bodies_reused <- snapshot.self_assignment_bodies_reused + 1
                return true

        def ifc_has_inline_grant(annotations: darray[Ast::EnumAnnotation]&, tokens: darray[Lexer::Token]&, body_start: usize, body_end: usize) -> bool:
            can Abort.Panic:
                return false if body_start >= body_end or body_end > tokens.count
                first_offset: u32 = tokens[body_start].start
                last_token: Lexer::Token = tokens[body_end - 1]
                last_offset: u32 = last_token.start + last_token.length + last_token.suffix_length.u32()
                for annotation in annotations:
                    continue if annotation.owner != "__inline_expression_grant"
                    return true if annotation.pos.offset >= first_offset and annotation.pos.offset < last_offset
                return false

        def ifc_push_fact(snapshot: mutable IncrementalSemanticSnapshot&, owner: usize, kind: IncrementalFactKind, subject: sview, path: sview, anchor: u32, active: darray[IncrementalFactWalkGrant]&) -> void:
            can Memory.Allocate, Abort.Panic:
                subject_span: mutable (start: usize, length: usize) = (snapshot.bytes.count, subject.len)
                if kind == IncrementalFactKind.DirectCall or kind == IncrementalFactKind.GlobalRead or kind == IncrementalFactKind.GlobalWrite:
                    subject_span <- ifc_append_name(snapshot, path, subject)
                else:
                    ifc_append_view(snapshot, subject)
                active_start: usize = snapshot.active_grants.count
                for grant in active:
                    name_start: usize = snapshot.bytes.count
                    ifc_append_view(snapshot, grant.name)
                    snapshot.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name.len})
                snapshot.direct_facts.push(IncrementalDirectFact{owner: owner, kind: kind, subject_start: subject_span.start, subject_length: subject_span.length, anchor_token: anchor, active_grant_start: active_start, active_grant_count: snapshot.active_grants.count - active_start})

        def ifc_walk_expr(expression: Ast::Expr, owner: usize, path: sview, body_start: usize, body_end: usize, tokens: darray[Lexer::Token]&, locals: darray[sview]&, all_globals: darray[sview]&, all_globals_index: IncrementalStringNameIndex&, mutable_globals: darray[sview]&, mutable_globals_index: IncrementalStringNameIndex&, candidates: darray[IncrementalFactCandidate]&, candidate_names: IncrementalCandidateNameIndex&, active: mutable darray[IncrementalFactWalkGrant]&, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        return true
                    Expr.Ident(name, position):
                        # Locals and parameters may be mutable aliases or callback
                        # values. v0 records only literal initializers and direct globals.
                        return false if ifc_contains(locals, name)
                        if ifc_string_name_contains(mutable_globals, name, mutable_globals_index):
                            anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                            if anchor != INCREMENTAL_NO_ANCHOR:
                                ifc_push_fact(snapshot, owner, IncrementalFactKind.GlobalRead, name, path, anchor, active)
                                return true
                            return false
                        # Readonly globals still produce inferred Global.Read rows in
                        # the authority checker. Until that fact has its own kind, fail
                        # closed instead of treating a name as a pure value.
                        return false
                    Expr.Paren(_, _):
                        # The authority walker has a recursive expression-depth limit.
                        # Until this collector tracks the same depth, parenthesized trees
                        # stay cold even when their leaves are otherwise supported.
                        return false
                    Expr.Call(callee, arguments, labels, position):
                        return false if arguments.count != 0 or labels.count != 0
                        if callee is Ast::Expr.Ident(name, _):
                            # `panic` is reserved by the lexer, so source cannot bind a local of that name.
                            # A local function value shadows the translation-unit declaration
                            # and builtins; never cache a call selected by name alone.
                            return false if ifc_contains(locals, name) or ifc_string_name_contains(all_globals, name, all_globals_index)
                            anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                            if anchor != INCREMENTAL_NO_ANCHOR:
                                if ifc_call_target(candidates, name, candidate_names):
                                    ifc_push_fact(snapshot, owner, IncrementalFactKind.DirectCall, name, path, anchor, active)
                                    return true
                                if name == "panic":
                                    ifc_push_fact(snapshot, owner, IncrementalFactKind.PanicSite, "Abort.Panic", path, anchor, active)
                                    return true
                        return false
                    _:
                        return false

        def ifc_walk_body(statements: darray[Ast::Stmt], owner: usize, path: sview, body_start: usize, body_end: usize, tokens: darray[Lexer::Token]&, locals: mutable darray[sview]&, all_globals: darray[sview]&, all_globals_index: IncrementalStringNameIndex&, mutable_globals: darray[sview]&, mutable_globals_index: IncrementalStringNameIndex&, candidates: darray[IncrementalFactCandidate]&, candidate_names: IncrementalCandidateNameIndex&, active: mutable darray[IncrementalFactWalkGrant]&, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |locals, active, snapshot|:
                    match statement:
                        Stmt.Expr(expression, _):
                            return false if not ifc_walk_expr(expression, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                        Stmt.Return(value, _):
                            if value is result:
                                return false if not ifc_walk_expr(result, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                        Stmt.VarDecl(name, type_expression, value, _):
                            return false if ifc_contains(locals, name)
                            # A typed/mutable place or an identifier initializer can
                            # make ga_write_place infer a Global.Write row. Keep v0 local
                            # declarations to untyped literal bindings only.
                            return false if:
                                not (type_expression is Expr.Absent or type_expression is Expr.Invalid)
                                not (value is Expr.IntLit or value is Expr.FloatLit or value is Expr.StringLit or value is Expr.CharLit or value is Expr.BoolLit)
                            locals.push(name)
                        Stmt.Assign(target, operator, value, _):
                            if operator == TokenKind.Assign:
                                # GA treats this spelling as a new local binding; only
                                # literal RHS values are cacheable because they cannot
                                # carry global reads, callback origins, or writable places.
                                if target is Ast::Expr.Ident(name, _):
                                    return false if:
                                        not (value is Expr.IntLit or value is Expr.FloatLit or value is Expr.StringLit or value is Expr.CharLit or value is Expr.BoolLit)
                                        not ifc_walk_expr(value, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                                    locals.push(name)
                                else:
                                    return false
                            else:
                                return false if:
                                    operator != TokenKind.LArrow
                                    not ifc_walk_expr(value, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                                if target is Ast::Expr.Ident(name, position):
                                    # A local may be a reference parameter whose write
                                    # reaches a caller's mutable global. Keep local LArrow
                                    # assignments cold until parameter aliasing is modeled.
                                    if ifc_contains(locals, name):
                                        return false
                                    elif ifc_string_name_contains(mutable_globals, name, mutable_globals_index):
                                        anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                                        if anchor != INCREMENTAL_NO_ANCHOR:
                                            ifc_push_fact(snapshot, owner, IncrementalFactKind.GlobalWrite, name, path, anchor, active)
                                        else:
                                            return false
                                    else:
                                        return false
                                else:
                                    return false
                        Stmt.Block(_, _, _, _, _):
                            # Nested block depth has independent diagnostics in semantic
                            # walkers; do not skip those walkers until that budget is part
                            # of the current-source fact proof.
                            return false
                        _:
                            return false
                return true

        def ifc_scan_candidate(index: usize, candidates: mutable darray[IncrementalFactCandidate]&, candidate_names: IncrementalCandidateNameIndex&, path: sview, tokens: darray[Lexer::Token]&, all_globals: darray[sview]&, all_globals_index: IncrementalStringNameIndex&, mutable_globals: darray[sview]&, mutable_globals_index: IncrementalStringNameIndex&, snapshot: mutable IncrementalSemanticSnapshot&) -> void:
            can Memory.Allocate, Abort.Panic:
                candidate: IncrementalFactCandidate = candidates[index]
                owner: usize = candidate.owner
                fact_start: usize = snapshot.direct_facts.count
                locals: mutable darray[sview] = []
                active: mutable darray[IncrementalFactWalkGrant] = []
                grant_start: usize = snapshot.active_grants.count
                bytes_start: usize = snapshot.bytes.count
                for parameter in candidate.parameters |locals|:
                    locals.push(parameter.name)
                supported: mutable bool = candidate.header_supported and candidate.body_token_start < candidate.body_token_end
                if supported:
                    supported <- ifc_walk_body(candidate.body, owner, path, candidate.body_token_start, candidate.body_token_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                snapshot.bodies_visited <- snapshot.bodies_visited + 1
                if not supported:
                    snapshot.direct_facts.truncate(fact_start)
                    snapshot.active_grants.truncate(grant_start)
                    snapshot.bytes.truncate(bytes_start)
                snapshot.functions[owner].direct_fact_start <- fact_start
                snapshot.functions[owner].direct_fact_count <- snapshot.direct_facts.count - fact_start
                snapshot.functions[owner].cacheable <- supported
                snapshot.functions[owner].matched_previous <- false
                if candidate.header_supported:
                    snapshot.functions[owner].reject_reason <- IncrementalRejectReason.None if supported else IncrementalRejectReason.UnsupportedBodySyntax
                snapshot.bodies_rejected <- snapshot.bodies_rejected + 1 if not supported
                candidates[index].scanned <- true

        # Persist one canonical layout so records do not depend on the order in which
        # their owned key, body, and freshly scanned fact spans were appended.
        def ifc_canonical_layout(snapshot: IncrementalSemanticSnapshot) -> IncrementalSemanticSnapshot:
            can Memory.Allocate, Abort.Panic:
                ordered: mutable IncrementalSemanticSnapshot = snapshot
                ordered.bytes <- []
                ordered.functions <- []
                ordered.direct_facts <- []
                ordered.active_grants <- []
                ordered.self_assignment_ranges <- []
                ordered.self_assignment_facts <- []
                ordered.current_self_assignment_anchors <- []
                ordered.bytes.reserve(snapshot.bytes.count)
                ordered.functions.reserve(snapshot.functions.count)
                ordered.direct_facts.reserve(snapshot.direct_facts.count)
                ordered.active_grants.reserve(snapshot.active_grants.count)
                ordered.self_assignment_ranges.reserve(snapshot.functions.count)
                ordered.self_assignment_facts.reserve(snapshot.self_assignment_facts.count)
                ordered.current_self_assignment_anchors.reserve(snapshot.current_self_assignment_anchors.count)
                ordered.source_path_start <- ordered.bytes.count
                if ifc_byte_span(snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length) is source_path:
                    ordered.bytes.extend(source_path)
                for record in snapshot.functions |ordered|:
                    key_start: usize = ordered.bytes.count
                    if ifc_byte_span(snapshot.bytes, record.key_start, record.key_length) is key:
                        ordered.bytes.extend(key)
                    body_start: usize = ordered.bytes.count
                    if ifc_byte_span(snapshot.bytes, record.body_start, record.body_length) is body:
                        ordered.bytes.extend(body)
                    ordered.functions.push(IncrementalFunctionFactRecord{key_start: key_start, key_length: record.key_length, body_start: body_start, body_length: record.body_length, body_hash: record.body_hash, direct_fact_start: 0, direct_fact_count: 0, cacheable: record.cacheable, matched_previous: record.matched_previous, reject_reason: record.reject_reason})
                for owner in 0..<snapshot.functions.count |ordered|:
                    record: IncrementalFunctionFactRecord = snapshot.functions[owner]
                    fact_start: usize = ordered.direct_facts.count
                    for index in 0..<record.direct_fact_count |ordered|:
                        fact: IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + index]
                        subject_start: usize = ordered.bytes.count
                        if ifc_byte_span(snapshot.bytes, fact.subject_start, fact.subject_length) is subject:
                            ordered.bytes.extend(subject)
                        grant_start: usize = ordered.active_grants.count
                        for grant_index in 0..<fact.active_grant_count |ordered|:
                            grant: IncrementalActiveGrant = snapshot.active_grants[fact.active_grant_start + grant_index]
                            name_start: usize = ordered.bytes.count
                            if ifc_byte_span(snapshot.bytes, grant.name_start, grant.name_length) is name:
                                ordered.bytes.extend(name)
                            ordered.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name_length})
                        ordered.direct_facts.push(IncrementalDirectFact{owner: owner, kind: fact.kind, subject_start: subject_start, subject_length: fact.subject_length, anchor_token: fact.anchor_token, active_grant_start: grant_start, active_grant_count: fact.active_grant_count})
                    ordered.functions[owner].direct_fact_start <- fact_start
                    ordered.functions[owner].direct_fact_count <- record.direct_fact_count
                    self_start: usize = ordered.self_assignment_facts.count
                    self_complete: mutable bool = owner < snapshot.self_assignment_ranges.count
                    self_reused: mutable bool = false
                    if self_complete:
                        source_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[owner]
                        self_complete <- source_range.complete
                        self_reused <- source_range.reused_previous
                        self_complete <- false if source_range.start > snapshot.self_assignment_facts.count or source_range.count > snapshot.self_assignment_facts.count - source_range.start
                        if self_complete:
                            self_complete <- false if source_range.start > snapshot.current_self_assignment_anchors.count or source_range.count > snapshot.current_self_assignment_anchors.count - source_range.start
                        if self_complete:
                            for relative in 0..<source_range.count |ordered|:
                                source_fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[source_range.start + relative]
                                ordered.self_assignment_facts.push(IncrementalSelfAssignmentFact{target_anchor_token: source_fact.target_anchor_token, statement_anchor_token: source_fact.statement_anchor_token})
                                ordered.current_self_assignment_anchors.push(snapshot.current_self_assignment_anchors[source_range.start + relative])
                    self_count: usize = ordered.self_assignment_facts.count - self_start
                    ordered.self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: self_start, count: self_count, complete: self_complete, reused_previous: self_reused and self_complete})
                ordered.declaration_surface_start <- ordered.bytes.count
                if ifc_byte_span(snapshot.bytes, snapshot.declaration_surface_start, snapshot.declaration_surface_length) is declaration_surface:
                    ordered.bytes.extend(declaration_surface)
                ordered.declaration_surface_valid <- snapshot.declaration_surface_valid
                return ordered

        def ifc_surface_equal(previous: IncrementalSemanticSnapshot&, current: IncrementalSemanticSnapshot) -> bool:
            can Abort.Panic:
                return false if:
                    previous.schema_version != current.schema_version
                    previous.semantic_fingerprint != current.semantic_fingerprint
                    previous.options_fingerprint != current.options_fingerprint
                # The 64-bit fingerprint can collide; reuse requires exact key equality.
                return false if:
                    not incremental_semantic_options_key_equal(previous.options_key, current.options_key)
                    not ifc_equal(previous.bytes, previous.source_path_start, previous.source_path_length, current.bytes, current.source_path_start, current.source_path_length)
                return ifc_equal(previous.bytes, previous.declaration_surface_start, previous.declaration_surface_length, current.bytes, current.declaration_surface_start, current.declaration_surface_length)

        def ifc_equal_view(bytes: darray[u8]&, start: usize, length: usize, value: sview) -> bool:
            can Abort.Panic:
                return false if length != value.len or start > bytes.count or length > bytes.count - start
                for offset in 0..<length:
                    return false if bytes[start + offset] != value[offset]
                return true

        def ifc_surface_matches_bytes(previous: IncrementalSemanticSnapshot&, schema_version: u32, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, source_path: sview, declaration_surface: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if:
                    previous.schema_version != schema_version
                    previous.semantic_fingerprint != semantic_fingerprint
                    previous.options_fingerprint != options_fingerprint
                    not incremental_semantic_options_key_equal(previous.options_key, options_key)
                    not ifc_equal_view(previous.bytes, previous.source_path_start, previous.source_path_length, source_path)
                    previous.declaration_surface_length != declaration_surface.count
                    previous.declaration_surface_start > previous.bytes.count
                    previous.declaration_surface_length > previous.bytes.count - previous.declaration_surface_start
                for offset in 0..<declaration_surface.count:
                    return false if previous.bytes[previous.declaration_surface_start + offset] != declaration_surface[offset]
                return true

        def ifc_append_declaration_surface(surface: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, candidates: darray[IncrementalFactCandidate]&, snapshot: IncrementalSemanticSnapshot&, use_previous_cacheability: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                token_index: mutable usize = 0
                candidate_index: mutable usize = 0
                while token_index < tokens.count |token_index, candidate_index, tokens, candidates, snapshot, surface|:
                    while candidate_index < candidates.count and candidates[candidate_index].skip_start < token_index:
                        candidate_index <- candidate_index + 1
                    if candidate_index < candidates.count:
                        candidate: IncrementalFactCandidate = candidates[candidate_index]
                        if candidate.skip_start == token_index:
                            skip_body: bool = candidate.header_supported and candidate.prior_record_cacheable if use_previous_cacheability else candidate.header_supported and snapshot.functions[candidate.owner].cacheable
                            if skip_body and candidate.skip_start <= candidate.skip_end and candidate.skip_end <= tokens.count:
                                token_index <- candidate.skip_end
                                candidate_index <- candidate_index + 1
                                continue
                    return false if not ifc_append_token_bytes(surface, source, source_length, tokens[token_index])
                    token_index <- token_index + 1
                return true

        def ifc_reuse_previous_candidate_facts(index: usize, candidates: mutable darray[IncrementalFactCandidate]&, previous: IncrementalSemanticSnapshot&, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if index >= candidates.count
                candidate: IncrementalFactCandidate = candidates[index]
                return false if candidate.prior_record >= previous.functions.count or not candidate.prior_record_cacheable
                old: IncrementalFunctionFactRecord = previous.functions[candidate.prior_record]
                current: IncrementalFunctionFactRecord = snapshot.functions[candidate.owner]
                return false if not old.cacheable or old.key_start > previous.bytes.count or old.key_length > previous.bytes.count - old.key_start
                return false if current.key_start > snapshot.bytes.count or current.key_length > snapshot.bytes.count - current.key_start
                return false if not ifc_equal(snapshot.bytes, current.key_start, current.key_length, previous.bytes, old.key_start, old.key_length)
                # Candidate matching already did this exact body comparison before
                # declaration-surface admission. Reuse that result instead of walking
                # every unchanged body a second time here.
                return false if not candidate.prior_body_matches
                return false if old.direct_fact_start > previous.direct_facts.count or old.direct_fact_count > previous.direct_facts.count - old.direct_fact_start
                # Validate every nested byte span before copying anything. A malformed
                # in-process image therefore falls back to the current AST walker.
                for relative in 0..<old.direct_fact_count |previous|:
                    fact: IncrementalDirectFact = previous.direct_facts[old.direct_fact_start + relative]
                    return false if fact.owner != candidate.prior_record
                    return false if fact.subject_start > previous.bytes.count or fact.subject_length > previous.bytes.count - fact.subject_start
                    return false if fact.active_grant_start > previous.active_grants.count or fact.active_grant_count > previous.active_grants.count - fact.active_grant_start
                    for grant_relative in 0..<fact.active_grant_count |previous|:
                        grant: IncrementalActiveGrant = previous.active_grants[fact.active_grant_start + grant_relative]
                        return false if grant.name_start > previous.bytes.count or grant.name_length > previous.bytes.count - grant.name_start

                fact_start: usize = snapshot.direct_facts.count
                for relative in 0..<old.direct_fact_count |previous, snapshot|:
                    fact: IncrementalDirectFact = previous.direct_facts[old.direct_fact_start + relative]
                    subject_start: usize = snapshot.bytes.count
                    if fact.subject_length > 0 and ifc_byte_span(previous.bytes, fact.subject_start, fact.subject_length) is subject:
                        snapshot.bytes.extend(subject)
                    grant_start: usize = snapshot.active_grants.count
                    for grant_relative in 0..<fact.active_grant_count |previous, snapshot|:
                        grant: IncrementalActiveGrant = previous.active_grants[fact.active_grant_start + grant_relative]
                        name_start: usize = snapshot.bytes.count
                        if grant.name_length > 0 and ifc_byte_span(previous.bytes, grant.name_start, grant.name_length) is name:
                            snapshot.bytes.extend(name)
                        snapshot.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name_length})
                    snapshot.direct_facts.push(IncrementalDirectFact{owner: candidate.owner, kind: fact.kind, subject_start: subject_start, subject_length: fact.subject_length, anchor_token: fact.anchor_token, active_grant_start: grant_start, active_grant_count: fact.active_grant_count})
                snapshot.functions[candidate.owner].direct_fact_start <- fact_start
                snapshot.functions[candidate.owner].direct_fact_count <- snapshot.direct_facts.count - fact_start
                snapshot.functions[candidate.owner].cacheable <- true
                snapshot.functions[candidate.owner].matched_previous <- true
                snapshot.functions[candidate.owner].reject_reason <- IncrementalRejectReason.None
                snapshot.bodies_matched <- snapshot.bodies_matched + 1
                return true

    public:
        # Replay only fully rebound syntax facts. Unsupported or malformed entries fall
        # back to the checker's streaming walk for that body, preserving cold behavior.
        def check_self_assignment_with_snapshot[@snapshot_region](declarations: darray[Ast::Decl], table: lmut SymbolTable, snapshot: IncrementalSemanticSnapshot& @snapshot_region) -> void:
            can Memory.Allocate, Abort.Panic:
                function_index: mutable usize = 0
                for declaration in declarations |table, function_index|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            replay: mutable bool = function_index < snapshot.functions.count and function_index < snapshot.self_assignment_ranges.count and function_index < snapshot.current_anchors.count
                            if replay:
                                fact_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[function_index]
                                body_anchor: IncrementalFunctionSourceAnchor = snapshot.current_anchors[function_index]
                                # A complete fresh scan is already current-source data;
                                # reused_previous is not a semantic replay requirement.
                                replay <- fact_range.complete
                                replay <- false if fact_range.start > snapshot.self_assignment_facts.count or fact_range.count > snapshot.self_assignment_facts.count - fact_range.start
                                replay <- false if fact_range.start > snapshot.current_self_assignment_anchors.count or fact_range.count > snapshot.current_self_assignment_anchors.count - fact_range.start
                                replay <- false if body_anchor.body_token_start > body_anchor.body_token_end
                                if replay:
                                    for relative in 0..<fact_range.count |replay|:
                                        index: usize = fact_range.start + relative
                                        fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[index]
                                        anchor: IncrementalSelfAssignmentAnchor = snapshot.current_self_assignment_anchors[index]
                                        replay <- false if:
                                            fact.target_anchor_token == INCREMENTAL_NO_ANCHOR or fact.statement_anchor_token == INCREMENTAL_NO_ANCHOR
                                            fact.target_anchor_token.usize() >= body_anchor.body_token_end - body_anchor.body_token_start
                                            fact.statement_anchor_token.usize() >= body_anchor.body_token_end - body_anchor.body_token_start
                                            anchor.name == "" or anchor.target_position.line == 0 or anchor.statement_line == 0
                            if replay:
                                fact_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[function_index]
                                for relative in 0..<fact_range.count |table|:
                                    anchor: IncrementalSelfAssignmentAnchor = snapshot.current_self_assignment_anchors[fact_range.start + relative]
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SelfAssignment, name: anchor.name, pos: anchor.target_position, line: anchor.statement_line, expected: "", actual: ""})
                            else:
                                table <- check_self_assignment_statements(body, table)
                            function_index <- function_index + 1
                        Decl.Module(name, body, line):
                            table <- check_self_assignment(body, table)
                        Decl.Scoped(body, line):
                            table <- check_self_assignment(body, table)
                        _:
                            pass

        # Resolve a portable direct-call fact back to its current source-level name.
        # The serialized subject is a length-prefixed (path, name) key; callers must
        # still resolve that name against the current declaration/index inventory.
        def incremental_direct_call_name(snapshot: IncrementalSemanticSnapshot&, fact: IncrementalDirectFact) -> sview?:
            can Abort.Panic:
                return null if fact.kind != IncrementalFactKind.DirectCall
                return null if fact.subject_start > snapshot.bytes.count or fact.subject_length > snapshot.bytes.count - fact.subject_start
                return null if snapshot.source_path_start > snapshot.bytes.count or snapshot.source_path_length > snapshot.bytes.count - snapshot.source_path_start
                return null if fact.subject_length < 8
                path_length: usize = ifc_read_u32(snapshot.bytes, fact.subject_start).usize()
                return null if path_length > fact.subject_length - 8
                path_start: usize = fact.subject_start + 4
                return null if path_length != snapshot.source_path_length
                return null if not ifc_equal(snapshot.bytes, path_start, path_length, snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length)
                name_length_start: usize = path_start + path_length
                name_length: usize = ifc_read_u32(snapshot.bytes, name_length_start).usize()
                name_start: usize = name_length_start + 4
                return null if name_length == 0 or name_length != fact.subject_length - (path_length + 8)
                if ifc_byte_span(snapshot.bytes, name_start, name_length) is name:
                    return name
                return null

        # Supported functions are unique, top-level, nongeneric defs with ordinary block
        # bodies and scalar builtin return types. Calls must be direct, zero-argument, and
        # unambiguous. Locals are untyped literals; local identifier reads stay cold because
        # they can hide mutable places or callback values. Nested blocks and parenthesized
        # expressions stay cold until their walker depth behavior is modeled. Disk snapshots
        # remain hints only; only a caller-owned in-process session can authorize collector
        # fact reuse after exact surface and body checks.
        def ifc_collect_function_facts[@session,@output](file: Ast::File&, source: u8& @output, source_length: usize, tokens: darray[Lexer::Token]&, source_path: sview, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, identity_key: darray[u8]&, previous: IncrementalSemanticSnapshot&, has_previous: bool, allow_session_reuse: bool, request_metrics: mutable IncrementalFunctionFactsRequestMetrics&, session: mutable IncrementalSemanticSession[session]& @session) -> IncrementalSemanticSnapshot @output:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                request_metrics.function_body_facts_restored <- 0
                request_metrics.body_query_publish_skips <- 0
                request_metrics.prior_snapshot_fact_fallbacks <- 0
                request_metrics.cold_body_scans <- 0
                request_metrics.source_input_admitted <- false
                request_metrics.validated_body_query_generation <- 0
                request_metrics.validated_body_query_hits.truncate(0)
                snapshot: mutable IncrementalSemanticSnapshot = IncrementalSemanticSnapshot{schema_version: INCREMENTAL_FUNCTION_FACTS_SCHEMA, semantic_fingerprint: semantic_fingerprint, options_fingerprint: options_fingerprint, options_key: [], bytes: [], source_path_start: 0, source_path_length: 0, declaration_surface_start: 0, declaration_surface_length: 0, declaration_surface_hash: INCREMENTAL_FACT_HASH_OFFSET, functions: [], current_anchors: [], direct_facts: [], active_grants: [], self_assignment_ranges: [], self_assignment_facts: [], current_self_assignment_anchors: [], bodies_visited: 0, bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_scanned: 0, self_assignment_bodies_reused: 0, declaration_surface_valid: false, surface_compatible: false}
                snapshot.options_key.extend(options_key)
                snapshot.source_path_start <- snapshot.bytes.count
                snapshot.source_path_length <- source_path.len
                ifc_append_view(snapshot, source_path)

                candidates: mutable darray[IncrementalFactCandidate] = []
                all_globals: mutable darray[sview] = []
                mutable_globals: mutable darray[sview] = []
                all_aliases: mutable darray[sview] = []
                for declaration in file.top_decls |all_aliases|:
                    match declaration:
                        Decl.Alias(name, _, _):
                            all_aliases.push(name)
                        _:
                            pass
                definition_cursor: mutable usize = 0
                previous_span_end: mutable usize = 0
                all_spans_ordered: mutable bool = true
                for declaration in file.top_decls |candidates, all_globals, mutable_globals, tokens, snapshot, source, source_length|:
                    match declaration:
                        Decl.Const(name, _, _, is_global, _):
                            all_globals.push(name) if is_global
                        Decl.Func(name, parameters, return_type, body, _, _, position):
                            while definition_cursor < tokens.count and (tokens[definition_cursor].kind != TokenKind.Def or tokens[definition_cursor].start != position.offset):
                                definition_cursor <- definition_cursor + 1
                            span: IncrementalFactTokenSpan = ifc_token_span(tokens, definition_cursor)
                            if span.found:
                                definition_cursor <- span.skip_end
                            elif definition_cursor < tokens.count:
                                definition_cursor <- definition_cursor + 1
                            span_ordered: bool = not span.found or span.skip_start >= previous_span_end
                            if span.found:
                                all_spans_ordered <- false if not span_ordered
                                previous_span_end <- span.skip_end if span.skip_end > previous_span_end
                            generic_header: bool = span.found and ifc_generic_header(tokens, span.definition_token)
                            inline_grant: bool = span.found and ifc_has_inline_grant(file.enum_annotations, tokens, span.body_start, span.body_end)
                            signature_supported: bool = ifc_signature_supported(parameters, return_type, all_aliases)
                            key_span: (start: usize, length: usize) = ifc_append_name(snapshot, source_path, name)
                            body_start: usize = snapshot.bytes.count
                            body_valid: bool = span.found and ifc_append_tokens(snapshot, source, source_length, tokens, span.body_start, span.body_end)
                            body_length: usize = snapshot.bytes.count - body_start if body_valid else 0
                            owner: usize = snapshot.functions.count
                            snapshot.functions.push(IncrementalFunctionFactRecord{key_start: key_span.start, key_length: key_span.length, body_start: body_start, body_length: body_length, body_hash: ifc_hash(snapshot.bytes, body_start, body_length), direct_fact_start: 0, direct_fact_count: 0, cacheable: false, matched_previous: false, reject_reason: IncrementalRejectReason.MissingBlockBody if not span.found else IncrementalRejectReason.None})
                            snapshot.self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: snapshot.self_assignment_facts.count, count: 0, complete: false, reused_previous: false})
                            snapshot.current_anchors.push(IncrementalFunctionSourceAnchor{definition_offset: position.offset, body_token_start: span.body_start, body_token_end: span.body_end})
                            candidates.push(IncrementalFactCandidate{name: name, parameters: parameters, return_type: return_type, body: body, definition_offset: position.offset, definition_token: span.definition_token, generic_header: generic_header, span_ordered: span_ordered, body_token_start: span.body_start, body_token_end: span.body_end, skip_start: span.skip_start, skip_end: span.skip_end, owner: owner, header_supported: span.found and body_valid and source_path != "" and not generic_header and not inline_grant and span_ordered and signature_supported, prior_record: 0, prior_record_cacheable: false, prior_body_matches: false, scanned: false})
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.MissingStablePath if source_path == ""
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan if span.found and not body_valid
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.UnsupportedBodySyntax if inline_grant
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.UnsupportedSignature if not signature_supported
                        _:
                            pass

                if not all_spans_ordered:
                    for candidate_index in 0..<candidates.count |candidates, snapshot|:
                        candidates[candidate_index].header_supported <- false
                        snapshot.functions[candidates[candidate_index].owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan

                # Decl.Const distinguishes globals from consts; mutability lives in the
                # parser's __global_mutable annotation side table.
                all_globals_index: mutable IncrementalStringNameIndex = IncrementalStringNameIndex{}
                ifc_string_name_index(all_globals, &all_globals_index) if all_globals.count >= INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT
                for annotation in file.enum_annotations:
                    if annotation.name == "__global_mutable" and annotation.module == "" and ifc_string_name_contains(all_globals, annotation.owner, all_globals_index):
                        mutable_globals.push(annotation.owner)
                mutable_globals_index: mutable IncrementalStringNameIndex = IncrementalStringNameIndex{}
                ifc_string_name_index(mutable_globals, &mutable_globals_index) if mutable_globals.count >= INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT

                candidate_names: mutable IncrementalCandidateNameIndex = IncrementalCandidateNameIndex{}
                ifc_candidate_name_index(candidates, &candidate_names)
                prior_keys: mutable IncrementalPriorKeyIndex = IncrementalPriorKeyIndex{}
                if has_previous and previous.schema_version == INCREMENTAL_FUNCTION_FACTS_SCHEMA:
                    ifc_prior_key_index(previous, &prior_keys)
                for index in 0..<candidates.count |candidates, snapshot, previous|:
                    unique: bool = ifc_name_unique(candidates, candidates[index].name, candidate_names)
                    generic: bool = candidates[index].generic_header
                    candidates[index].header_supported <- candidates[index].header_supported and unique
                    if not unique or generic:
                        snapshot.functions[candidates[index].owner].reject_reason <- IncrementalRejectReason.NonUniqueOrGenericFunction
                    elif not candidates[index].span_ordered:
                        snapshot.functions[candidates[index].owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan
                    if candidates[index].header_supported and has_previous and previous.schema_version == INCREMENTAL_FUNCTION_FACTS_SCHEMA:
                        current: IncrementalFunctionFactRecord = snapshot.functions[candidates[index].owner]
                        old_index: usize = ifc_prior_index(previous, snapshot.bytes, current.key_start, current.key_length, prior_keys)
                        if old_index < previous.functions.count:
                            old: IncrementalFunctionFactRecord = previous.functions[old_index]
                            same_body: bool = ifc_equal(snapshot.bytes, current.body_start, current.body_length, previous.bytes, old.body_start, old.body_length)
                            candidates[index].prior_record <- old_index
                            candidates[index].prior_record_cacheable <- old.cacheable
                            candidates[index].prior_body_matches <- same_body

                trusted_surface_admitted: mutable bool = false
                proposed_surface: mutable darray[u8] = []
                proposed_surface_valid: mutable bool = false
                if allow_session_reuse and has_previous and all_spans_ordered:
                    proposed_surface_valid <- ifc_append_declaration_surface(proposed_surface, tokens, source, source_length, candidates, snapshot, true)
                    trusted_surface_admitted <- proposed_surface_valid and ifc_surface_matches_bytes(previous, snapshot.schema_version, snapshot.semantic_fingerprint, snapshot.options_fingerprint, snapshot.options_key, source_path, proposed_surface)
                source_query_handle: mutable IncrementalSemanticQueryHandle[session] = ifq_query_handle_invalid()
                graph_surface_admitted: mutable bool = false
                if allow_session_reuse and session.enabled and session.query_graph_enabled and session.valid and not session.query_graph_poisoned and proposed_surface_valid and ifq_source_query_key_fits(identity_key, source_path) and ifq_source_query_value_fits(options_key.count, proposed_surface.count):
                    source_query_key: darray[u8] = ifq_source_query_key(identity_key, source_path)
                    source_query_handle <- incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.SourceInput, source_query_key)
                    source_query_value: darray[u8] = ifq_source_query_value(options_key, proposed_surface)
                    no_dependencies: darray[IncrementalSemanticQueryHandle[session]] = []
                    source_evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, source_query_handle, source_query_value, no_dependencies)
                    graph_surface_admitted <- source_evaluation.hit and ifq_query_value_equals(session, source_evaluation.result_start, source_evaluation.result_length, source_query_value)
                    request_metrics.source_input_admitted <- graph_surface_admitted and trusted_surface_admitted
                for index in 0..<candidates.count |candidates, snapshot|:
                    if allow_session_reuse and trusted_surface_admitted and candidates[index].header_supported and candidates[index].prior_record_cacheable and candidates[index].prior_body_matches:
                        graph_reused: mutable bool = false
                        if graph_surface_admitted:
                            current: IncrementalFunctionFactRecord = snapshot.functions[candidates[index].owner]
                            if ifq_function_query_key_fits(current) and current.body_length <= INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT:
                                query_key: darray[u8] = ifq_function_query_key(snapshot, current)
                                query_handle: IncrementalSemanticQueryHandle[session] = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.FunctionBodyFacts, query_key)
                                body_input: darray[u8] = ifq_snapshot_span_copy(snapshot.bytes, current.body_start, current.body_length)
                                dependencies: mutable darray[IncrementalSemanticQueryHandle[session]] = []
                                dependencies.push(source_query_handle)
                                evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, query_handle, body_input, dependencies)
                                if evaluation.hit:
                                    graph_reused <- ifq_restore_direct_facts_from_result(session, evaluation.result_start, evaluation.result_length, previous, candidates[index].prior_record, snapshot, candidates[index].owner)
                                    if not graph_reused:
                                        _ = ifq_query_mark_stale(session, query_handle.node)
                                    else:
                                        # Snapshot bytes remain request-local and unchanged
                                        # through session_store; retain only scalar identity
                                        # evidence, never the old request-scoped handles.
                                        if not session.query_graph_poisoned and ifq_query_handle_is_valid(session, query_handle) and ifq_query_handle_is_valid(session, source_query_handle):
                                            if request_metrics.validated_body_query_generation != session.query_graph_generation:
                                                request_metrics.validated_body_query_hits.truncate(0)
                                                request_metrics.validated_body_query_generation <- session.query_graph_generation
                                            body_node: IncrementalSemanticQueryNode = session.query_nodes[query_handle.node.value.usize()]
                                            source_node: IncrementalSemanticQueryNode = session.query_nodes[source_query_handle.node.value.usize()]
                                            if body_node.status == IncrementalSemanticQueryStatus.Green and body_node.has_committed_value and source_node.status == IncrementalSemanticQueryStatus.Green and source_node.has_committed_value:
                                                request_metrics.validated_body_query_hits.push(IncrementalSemanticBodyQueryHitMarker{function_record_index: candidates[index].owner, query_id: query_handle.node, query_result_generation: body_node.result_generation, source_result_generation: source_node.result_generation, graph_generation: session.query_graph_generation, body_start: current.body_start, body_length: current.body_length, direct_facts_restored: true})
                        if graph_reused:
                            ifc_increment_candidate_metric(&request_metrics.function_body_facts_restored, candidates.count)
                            candidates[index].scanned <- true
                        else:
                            reused_previous: bool = ifc_reuse_previous_candidate_facts(index, candidates, previous, snapshot)
                            if reused_previous:
                                ifc_increment_candidate_metric(&request_metrics.prior_snapshot_fact_fallbacks, candidates.count)
                            else:
                                ifc_increment_candidate_metric(&request_metrics.cold_body_scans, candidates.count)
                                ifc_scan_candidate(index, candidates, candidate_names, source_path, tokens, all_globals, all_globals_index, mutable_globals, mutable_globals_index, snapshot)
                    else:
                        ifc_increment_candidate_metric(&request_metrics.cold_body_scans, candidates.count)
                        ifc_scan_candidate(index, candidates, candidate_names, source_path, tokens, all_globals, all_globals_index, mutable_globals, mutable_globals_index, snapshot)

                snapshot.declaration_surface_start <- snapshot.bytes.count
                surface_valid: mutable bool = true
                declaration_surface: mutable darray[u8] = []
                surface_valid <- ifc_append_declaration_surface(declaration_surface, tokens, source, source_length, candidates, snapshot, false)
                snapshot.bytes.extend(declaration_surface)
                snapshot.declaration_surface_length <- snapshot.bytes.count - snapshot.declaration_surface_start
                snapshot.declaration_surface_hash <- ifc_hash(snapshot.bytes, snapshot.declaration_surface_start, snapshot.declaration_surface_length)
                snapshot.declaration_surface_valid <- surface_valid
                snapshot.surface_compatible <- has_previous and surface_valid and all_spans_ordered and ifc_surface_equal(previous, snapshot)
                if not surface_valid:
                    snapshot.direct_facts.truncate(0)
                    snapshot.active_grants.truncate(0)
                    snapshot.bodies_matched <- 0
                    for record_index in 0..<snapshot.functions.count |snapshot, record_index|:
                        snapshot.functions[record_index].cacheable <- false
                        snapshot.functions[record_index].matched_previous <- false
                        snapshot.functions[record_index].direct_fact_start <- 0
                        snapshot.functions[record_index].direct_fact_count <- 0
                        snapshot.functions[record_index].reject_reason <- IncrementalRejectReason.InvalidTokenSpan
                    return snapshot

                # This syntax-only query needs no declaration lookup. Collect it after the
                # portable snapshot size is known so the process-local facts share the same
                # bounded storage budget. Disk snapshots omit these facts and stay cold.
                if allow_session_reuse:
                    for index in 0..<candidates.count |candidates, snapshot, previous|:
                        reused_self_assignment: bool = has_previous and ifc_reuse_previous_self_assignment_candidate(index, candidates, previous, tokens, source, source_length, snapshot)
                        if not reused_self_assignment:
                            ifc_scan_self_assignment_candidate(index, candidates, tokens, source, source_length, snapshot)

                if snapshot.surface_compatible:
                    for index in 0..<candidates.count |candidates, snapshot|:
                        continue if not candidates[index].prior_body_matches
                        current: IncrementalFunctionFactRecord = snapshot.functions[candidates[index].owner]
                        # For sidecars this records an exact-body match after a full scan.
                        # Trusted session copies set the bit and count at the copy site.
                        if current.cacheable and not current.matched_previous:
                            snapshot.functions[candidates[index].owner].matched_previous <- true
                            snapshot.bodies_matched <- snapshot.bodies_matched + 1

                return ifc_canonical_layout(snapshot)

        def incremental_collect_function_facts[@output](file: Ast::File&, source: u8& @output, source_length: usize, tokens: darray[Lexer::Token]&, source_path: sview, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, previous: IncrementalSemanticSnapshot&, has_previous: bool) -> IncrementalSemanticSnapshot @output:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                disabled_session: mutable IncrementalSemanticSession[output] @output = incremental_semantic_session_new[output](false) can Memory.Allocate
                request_metrics: mutable IncrementalFunctionFactsRequestMetrics = IncrementalFunctionFactsRequestMetrics{function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false, validated_body_query_generation: 0, validated_body_query_hits: []}
                empty_identity: darray[u8] = []
                return ifc_collect_function_facts[output,output](file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, empty_identity, previous, has_previous, false, &request_metrics, &disabled_session)

        # Rebind an exact-input, compiler-produced session snapshot to the current parse.
        # This intentionally rebuilds only invocation-local source anchors; the session key
        # proves the source, token stream, declaration surface, options, and fact semantics
        # are unchanged, so the supported body fact walkers need not run again.
    private:
        def incremental_reanchor_exact_snapshot(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Abort.Panic, Memory.Allocate:
                return false if snapshot.schema_version != INCREMENTAL_FUNCTION_FACTS_SCHEMA
                return false if snapshot.functions.count > 1000000 or snapshot.direct_facts.count > 1000000 or snapshot.active_grants.count > 1000000
                snapshot.current_anchors.truncate(0)
                snapshot.current_self_assignment_anchors.truncate(0)
                self_stream_valid: mutable bool = snapshot.self_assignment_ranges.count == snapshot.functions.count and snapshot.self_assignment_facts.count <= 1000000
                expected_fact_start: mutable usize = 0
                if self_stream_valid:
                    for self_range in snapshot.self_assignment_ranges |expected_fact_start, self_stream_valid|:
                        self_stream_valid <- false if self_range.start != expected_fact_start or self_range.start > snapshot.self_assignment_facts.count or self_range.count > snapshot.self_assignment_facts.count - self_range.start
                        expected_fact_start <- self_range.start + self_range.count if self_stream_valid
                    self_stream_valid <- false if expected_fact_start != snapshot.self_assignment_facts.count
                if not self_stream_valid:
                    # Decoded disk snapshots intentionally omit this session-only stream.
                    # Keep direct-fact reanchoring intact and make only this linter cold.
                    snapshot.self_assignment_facts.truncate(0)
                    snapshot.self_assignment_ranges.truncate(0)
                    for index in 0..<snapshot.functions.count |snapshot|:
                        snapshot.self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: 0, count: 0, complete: false, reused_previous: false})
                snapshot.bodies_visited <- 0
                snapshot.bodies_matched <- 0
                snapshot.bodies_rejected <- 0
                snapshot.self_assignment_bodies_scanned <- 0
                snapshot.self_assignment_bodies_reused <- 0
                definition_cursor: mutable usize = 0
                previous_span_end: mutable usize = 0
                record_index: mutable usize = 0
                spans_ordered: mutable bool = true
                for declaration in file.top_decls |snapshot, tokens, definition_cursor, previous_span_end, record_index, spans_ordered|:
                    match declaration:
                        Decl.Func(name, _, _, _, _, _, position):
                            return false if record_index >= snapshot.functions.count
                            while definition_cursor < tokens.count and (tokens[definition_cursor].kind != TokenKind.Def or tokens[definition_cursor].start != position.offset):
                                definition_cursor <- definition_cursor + 1
                            definition_found: bool = definition_cursor < tokens.count and tokens[definition_cursor].kind == TokenKind.Def and tokens[definition_cursor].start == position.offset
                            return false if not definition_found
                            span: IncrementalFactTokenSpan = ifc_token_span(tokens, definition_cursor)
                            if span.found:
                                spans_ordered <- false if span.skip_start < previous_span_end
                                previous_span_end <- span.skip_end if span.skip_end > previous_span_end
                                definition_cursor <- span.skip_end
                            elif definition_cursor < tokens.count:
                                definition_cursor <- definition_cursor + 1
                            return false if not spans_ordered
                            record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                            return false if record.key_start > snapshot.bytes.count or record.key_length > snapshot.bytes.count - record.key_start or record.key_length < 8
                            path_length: usize = ifc_read_u32(snapshot.bytes, record.key_start).usize()
                            return false if path_length > record.key_length - 8 or path_length != snapshot.source_path_length
                            path_start: usize = record.key_start + 4
                            return false if not ifc_equal(snapshot.bytes, path_start, path_length, snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length)
                            name_length_start: usize = path_start + path_length
                            name_length: usize = ifc_read_u32(snapshot.bytes, name_length_start).usize()
                            name_start: usize = name_length_start + 4
                            return false if name_length != record.key_length - path_length - 8 or name_length != name.len
                            for name_offset in 0..<name_length |snapshot, name|:
                                return false if snapshot.bytes[name_start + name_offset] != name[name_offset]
                            return false if record.cacheable and not span.found
                            return false if span.found and (span.body_start > span.body_end or span.body_end > tokens.count)
                            snapshot.current_anchors.push(IncrementalFunctionSourceAnchor{definition_offset: position.offset, body_token_start: span.body_start, body_token_end: span.body_end})
                            self_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[record_index]
                            return false if self_range.start > snapshot.self_assignment_facts.count or self_range.count > snapshot.self_assignment_facts.count - self_range.start
                            snapshot.self_assignment_ranges[record_index].reused_previous <- false
                            for relative in 0..<self_range.count |snapshot|:
                                fact_index: usize = self_range.start + relative
                                fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[fact_index]
                                rebound: (valid: bool, anchor: IncrementalSelfAssignmentAnchor) = ifc_rebind_self_assignment_anchor(tokens, source, source_length, span.body_start, span.body_end, fact.target_anchor_token, fact.statement_anchor_token)
                                if rebound.valid:
                                    snapshot.current_self_assignment_anchors.push(rebound.anchor)
                                else:
                                    snapshot.self_assignment_ranges[record_index].complete <- false
                                    snapshot.current_self_assignment_anchors.push(IncrementalSelfAssignmentAnchor{name: "", target_position: Ast::pos_at_line(0), statement_line: 0})
                            snapshot.self_assignment_ranges[record_index].reused_previous <- snapshot.self_assignment_ranges[record_index].complete
                            if snapshot.self_assignment_ranges[record_index].reused_previous:
                                snapshot.self_assignment_bodies_reused <- snapshot.self_assignment_bodies_reused + 1
                            if record.cacheable:
                                # Whole-input byte equality plus successful rebinding proves
                                # this current record still names the retained body. Recompute
                                # the report flags here instead of carrying prior edit counters.
                                snapshot.functions[record_index].matched_previous <- true
                                snapshot.bodies_matched <- snapshot.bodies_matched + 1
                            else:
                                snapshot.functions[record_index].matched_previous <- false
                                snapshot.bodies_rejected <- snapshot.bodies_rejected + 1
                            record_index <- record_index + 1
                        _:
                            pass
                return false if record_index != snapshot.functions.count or snapshot.current_anchors.count != snapshot.functions.count
                snapshot.surface_compatible <- true
                return true

    public:
        def incremental_semantic_name_lookup_context_disabled[@r]() -> IncrementalSemanticNameLookupContext[r] @r:
            return IncrementalSemanticNameLookupContext{session: null, source_input: ifq_query_handle_invalid(), active: false, track_stats: false, lookup_hits: 0, classification_chain_visits: 0, lookup_key_scratch: [], lookup_input_scratch: [], lookup_scratch_ready: false}

        def incremental_semantic_name_lookup_context_is_active[@r](context: IncrementalSemanticNameLookupContext[r]&) -> bool:
            return context.active

        def incremental_semantic_name_lookup_context_tracks_stats[@r](context: IncrementalSemanticNameLookupContext[r]&) -> bool:
            return context.track_stats

        # The resolver starts a new graph phase after collection and publication. Rebuild
        # SourceInput from the authoritative session snapshot so exact-source hits and edits
        # enter resolution with a current, Green dependency handle.
        def incremental_semantic_name_lookup_context_begin_request[@session](session: mutable IncrementalSemanticSession[session]& @session, track_stats: bool) -> IncrementalSemanticNameLookupContext[session] @session can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
            context: mutable IncrementalSemanticNameLookupContext[session] = IncrementalSemanticNameLookupContext{session: session, source_input: ifq_query_handle_invalid(), active: false, track_stats: track_stats, lookup_hits: 0, classification_chain_visits: 0, lookup_key_scratch: [], lookup_input_scratch: [], lookup_scratch_ready: false}
            return context if not session.enabled or not session.query_graph_enabled or not session.valid or session.query_graph_poisoned or not session.snapshot.declaration_surface_valid
            return context if session.snapshot.source_path_length == 0 or session.snapshot.source_path_start > session.snapshot.bytes.count or session.snapshot.source_path_length > session.snapshot.bytes.count - session.snapshot.source_path_start
            return context if session.snapshot.declaration_surface_start > session.snapshot.bytes.count or session.snapshot.declaration_surface_length > session.snapshot.bytes.count - session.snapshot.declaration_surface_start
            source_path: mutable sview = ""
            if ifc_byte_span(session.snapshot.bytes, session.snapshot.source_path_start, session.snapshot.source_path_length) is path_view:
                source_path <- path_view
            return context if source_path.len == 0
            return context if not ifq_source_query_key_fits(session.identity_key, source_path) or not ifq_source_query_value_fits(session.snapshot.options_key.count, session.snapshot.declaration_surface_length)
            return context if not incremental_semantic_query_begin_request(session)
            source_key: darray[u8] = ifq_source_query_key(session.identity_key, source_path)
            return context if source_key.count == 0
            declaration_surface: darray[u8] = ifq_snapshot_span_copy(session.snapshot.bytes, session.snapshot.declaration_surface_start, session.snapshot.declaration_surface_length)
            source_value: darray[u8] = ifq_source_query_value(session.snapshot.options_key, declaration_surface)
            source_handle: IncrementalSemanticQueryHandle[session] = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.SourceInput, source_key) can Global{Read,Write}
            no_dependencies: darray[IncrementalSemanticQueryHandle[session]] = []
            evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, source_handle, source_value, no_dependencies)
            if not evaluation.hit or not ifq_query_value_equals(session, evaluation.result_start, evaluation.result_length, source_value):
                return context if not ifq_query_commit(session, source_handle, source_value, no_dependencies, source_value)
            context.source_input <- source_handle
            context.active <- true
            return context

        def incremental_semantic_name_lookup_evaluate[@r](context: mutable IncrementalSemanticNameLookupContext[r]&, current_module: sview, name: sview, surface: ResolverNameLookupSurface) -> IncrementalSemanticNameLookupResult can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
            miss: IncrementalSemanticNameLookupResult = IncrementalSemanticNameLookupResult{hit: false, known: false, module_only: false}
            context.lookup_scratch_ready <- false
            return miss if not context.active or not surface.valid
            if context.session is session:
                # A graph-budget clear invalidates the request handle and resets its
                # generation. Stop before constructing per-name keys and arrays; the
                # resolver will use its ordinary cold classification from here on.
                if not ifq_query_handle_is_valid(session, context.source_input):
                    context.active <- false
                    return miss
                return miss if not ifq_name_lookup_key_encode(current_module, name, context.lookup_key_scratch)
                ifq_name_lookup_input_encode(name, surface, context.lookup_input_scratch)
                context.lookup_scratch_ready <- true
                # The complete resolver surface is the query input. The SourceInput handle
                # remains a request-lifetime/graph-generation guard on the context, but a
                # declaration edit changes only names whose exact facts changed.
                dependencies: darray[IncrementalSemanticQueryHandle[r]] = []
                handle: IncrementalSemanticQueryHandle[r] = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.NameLookup, context.lookup_key_scratch) can Global{Read,Write}
                evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, handle, context.lookup_input_scratch, dependencies)
                decoded: IncrementalSemanticNameLookupResult = ifq_name_lookup_result_decode(session, evaluation)
                if decoded.hit:
                    context.lookup_hits <- context.lookup_hits + 1 if context.track_stats and context.lookup_hits < 18446744073709551615
                    context.lookup_scratch_ready <- false
                    return decoded
            return miss

        def incremental_semantic_name_lookup_commit[@r](context: mutable IncrementalSemanticNameLookupContext[r]&, known: bool, module_only: bool) -> bool can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
            ready: bool = context.lookup_scratch_ready
            context.lookup_scratch_ready <- false
            return false if not context.active or not ready
            if context.session is session:
                return false if not ifq_query_handle_is_valid(session, context.source_input)
                result: darray[u8] = ifq_name_lookup_result(known, module_only)
                dependencies: darray[IncrementalSemanticQueryHandle[r]] = []
                handle: IncrementalSemanticQueryHandle[r] = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.NameLookup, context.lookup_key_scratch) can Global{Read,Write}
                return ifq_query_commit(session, handle, context.lookup_input_scratch, dependencies, result)
            return false

        def incremental_semantic_name_lookup_record_chain_visits[@r](context: mutable IncrementalSemanticNameLookupContext[r]&, visits: u64) -> void:
            return if not context.track_stats
            context.classification_chain_visits <- context.classification_chain_visits + visits if context.classification_chain_visits <= 18446744073709551615 - visits
            context.classification_chain_visits <- 18446744073709551615 if context.classification_chain_visits > 18446744073709551615 - visits

        def incremental_semantic_name_lookup_stats[@r](context: IncrementalSemanticNameLookupContext[r]&) -> IncrementalSemanticNameLookupStats:
            return IncrementalSemanticNameLookupStats{hits: context.lookup_hits, classification_chain_visits: context.classification_chain_visits}

        def incremental_semantic_session_new[@r](enabled: bool) -> IncrementalSemanticSession[r] @r can[Memory.Allocate]:
            return IncrementalSemanticSession{enabled: enabled, query_graph_enabled: false, valid: false, analyzed_source: [], identity_key: [], options_key: [], generated_input: false, semantic_fingerprint: 0, snapshot: IncrementalSemanticSessionSnapshot{schema_version: 0, semantic_fingerprint: 0, options_fingerprint: 0, options_key: [], bytes: [], source_path_start: 0, source_path_length: 0, declaration_surface_start: 0, declaration_surface_length: 0, declaration_surface_hash: 0, functions: [], direct_facts: [], active_grants: [], self_assignment_ranges: [], self_assignment_facts: [], bodies_visited: 0, bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_scanned: 0, self_assignment_bodies_reused: 0, declaration_surface_valid: false, surface_compatible: false}, query_key_bytes: [], query_key_heads: {}, query_nodes: [], query_edges: [], free_query_edges: [], query_value_bytes: [], query_graph_generation: 1, query_request_generation: 0, query_context_generation: 0, query_graph_poisoned: false, query_invalidation_generation: 0, query_invalidation_worklist: []}

        def incremental_semantic_session_is_enabled[@r](session: IncrementalSemanticSession[r]& @r) -> bool:
            return session.enabled

        # Change the experimental graph mode without discarding the authoritative
        # typed-fact snapshot. Clearing the graph makes switching modes invalidate
        # every outstanding graph handle; failure to advance its generation leaves
        # graph reuse disabled while snapshot reuse remains available.
        def incremental_semantic_session_set_query_graph_enabled[@session](session: mutable IncrementalSemanticSession[session]& @session, enabled: bool) -> bool can[Abort.Panic, Memory.Allocate]:
            if session.query_graph_enabled == enabled:
                return true
            if not enabled:
                session.query_graph_enabled <- false
                ifq_clear_session_graph(session)
                return true
            ifq_clear_session_graph(session)
            return false if session.query_graph_poisoned
            session.query_graph_enabled <- true
            return true

        def incremental_semantic_session_reset[@session](session: mutable IncrementalSemanticSession[session]& @session) -> void:
            can Abort.Panic, Memory.Allocate:
                ifc_session_clear_prior(session)
                ifq_clear_session_graph(session)

    private:
        # Graph admission caps logical payload, not arena capacity retained after growth.
        # Sessions therefore keep the graph disconnected by default; explicit opt-in
        # remains experimental until retained-capacity accounting is measured.
        def ifq_graph_within_limit[@r](session: IncrementalSemanticSession[r]& @r, additional_key_bytes: usize, additional_value_bytes: usize, additional_nodes: usize, additional_edges: usize, additional_free_edges: usize, required_worklist_slots: usize) -> bool:
            can Abort.Panic:
                return false if session.query_key_bytes.count > INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT
                return false if additional_key_bytes > INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT - session.query_key_bytes.count
                return false if session.query_value_bytes.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return false if additional_value_bytes > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT - session.query_value_bytes.count
                return false if session.query_nodes.count > INCREMENTAL_SEMANTIC_QUERY_NODE_LIMIT
                return false if additional_nodes > INCREMENTAL_SEMANTIC_QUERY_NODE_LIMIT - session.query_nodes.count
                return false if session.query_edges.count > INCREMENTAL_SEMANTIC_QUERY_EDGE_LIMIT
                return false if additional_edges > INCREMENTAL_SEMANTIC_QUERY_EDGE_LIMIT - session.query_edges.count
                return false if session.free_query_edges.count > INCREMENTAL_SEMANTIC_QUERY_EDGE_LIMIT
                return false if additional_free_edges > INCREMENTAL_SEMANTIC_QUERY_EDGE_LIMIT - session.free_query_edges.count
                worklist_slots: mutable usize = session.query_invalidation_worklist.capacity
                worklist_slots <- required_worklist_slots if required_worklist_slots > worklist_slots
                return false if worklist_slots > INCREMENTAL_SEMANTIC_QUERY_NODE_LIMIT
                key_bytes: u64 = (session.query_key_bytes.count + additional_key_bytes).u64()
                value_bytes: u64 = (session.query_value_bytes.count + additional_value_bytes).u64()
                # 128 bytes includes the query record, incoming-chain integrity fields,
                # and a conservative index share.
                node_and_index_bytes: u64 = (session.query_nodes.count + additional_nodes).u64() * 128
                # Five u32 fields plus the observed result generation; retain alignment headroom.
                edge_bytes: u64 = (session.query_edges.count + additional_edges).u64() * 48
                free_bytes: u64 = (session.free_query_edges.count + additional_free_edges).u64() * 8
                worklist_bytes: u64 = worklist_slots.u64() * 8
                total: u64 = key_bytes + value_bytes + node_and_index_bytes + edge_bytes + free_bytes + worklist_bytes + 32
                return total <= INCREMENTAL_SEMANTIC_QUERY_RETAINED_BYTES_LIMIT.u64()

        def ifq_invalidation_worklist_push[@session](session: mutable IncrementalSemanticSession[session]& @session, query_id: IncrementalSemanticQueryId) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if session.query_invalidation_worklist.count >= session.query_nodes.count
                if session.query_invalidation_worklist.count >= session.query_invalidation_worklist.capacity:
                    old_capacity: usize = session.query_invalidation_worklist.capacity
                    next_capacity: mutable usize = 8 if old_capacity == 0 else old_capacity * 2
                    return false if next_capacity < old_capacity
                    next_capacity <- session.query_nodes.count if next_capacity > session.query_nodes.count
                    return false if next_capacity <= old_capacity
                    return false if not ifq_graph_within_limit(session, 0, 0, 0, 0, 0, next_capacity)
                    session.query_invalidation_worklist.reserve(next_capacity)
                session.query_invalidation_worklist.push(query_id)
                return true

        def ifq_query_id_is_valid[@r](session: IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId) -> bool:
            can Abort.Panic:
                return query_id.value != INCREMENTAL_SEMANTIC_QUERY_NONE and query_id.value.usize() < session.query_nodes.count

        def ifq_edge_id_is_valid[@r](session: IncrementalSemanticSession[r]& @r, edge_id: IncrementalSemanticDependencyEdgeId) -> bool:
            can Abort.Panic:
                return edge_id.value != INCREMENTAL_SEMANTIC_QUERY_NONE and edge_id.value.usize() < session.query_edges.count and session.query_edges[edge_id.value.usize()].depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE and session.query_edges[edge_id.value.usize()].dependee.value != INCREMENTAL_SEMANTIC_QUERY_NONE

        def ifq_query_key_hash(kind: IncrementalSemanticQueryKind, key: darray[u8]&) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                hash <- (hash ^ kind.u64()) * 1099511628211
                for byte in key |hash|:
                    hash <- (hash ^ byte.u64()) * 1099511628211
                return hash

        def ifq_query_value_hash(bytes: darray[u8]&) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                for byte in bytes |hash|:
                    hash <- (hash ^ byte.u64()) * 1099511628211
                return hash

        def ifq_query_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if left.count != right.count
                for index in 0..<left.count |left, right|:
                    return false if left[index] != right[index]
                return true

        # Graph pool caps are far below UINT32_MAX, but keep a checked narrowing
        # boundary so future cap changes cannot silently truncate stored spans.
        def ifq_query_span_fits_u32(start: usize, length: usize) -> bool:
            can Abort.Panic:
                return false if start > 4294967295 or length > 4294967295
                return start <= 4294967295 - length

        # SourceInput is keyed by exact stable source identity and path. The declaration
        # surface is the result, so editing a body does not change this dependency value.
        def ifq_source_query_key(identity_key: darray[u8]&, source_path: sview) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                key: mutable darray[u8] = []
                ifc_append_u32_bytes(key, INCREMENTAL_SEMANTIC_QUERY_KEY_VERSION)
                ifc_append_u32_bytes(key, identity_key.count.u32())
                key.extend(identity_key)
                ifc_append_u32_bytes(key, source_path.len.u32())
                key.extend(source_path)
                return key

        # The SourceInput key is 12 bytes of lengths/version plus both byte strings.
        # Reject oversize inputs before copying a potentially large source identity.
        def ifq_source_query_key_fits(identity_key: darray[u8]&, source_path: sview) -> bool:
            can Abort.Panic:
                prefix_length: usize = 12
                return false if identity_key.count > INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT - prefix_length
                remaining: usize = INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT - prefix_length - identity_key.count
                return source_path.len <= remaining

        def ifq_source_query_value_fits(options_length: usize, surface_length: usize) -> bool:
            can Abort.Panic:
                prefix_length: usize = 16
                return false if prefix_length > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return false if options_length > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT - prefix_length
                remaining: usize = INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT - prefix_length - options_length
                return surface_length <= remaining

        # SourceInput's exact input and result share one context+surface encoding. This
        # keeps the large declaration-surface bytes single-copy in the graph value pool.
        def ifq_source_query_value(options_key: darray[u8]&, declaration_surface: darray[u8]&) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                value: mutable darray[u8] = []
                return value if not ifq_source_query_value_fits(options_key.count, declaration_surface.count)
                value.reserve(16 + options_key.count + declaration_surface.count)
                ifc_append_u32_bytes(value, INCREMENTAL_SEMANTIC_QUERY_RESULT_VERSION)
                ifc_append_u32_bytes(value, INCREMENTAL_SEMANTIC_ENGINE_VERSION.u32())
                ifc_append_u32_bytes(value, options_key.count.u32())
                value.extend(options_key)
                ifc_append_u32_bytes(value, declaration_surface.count.u32())
                value.extend(declaration_surface)
                return value

        # NameLookup is session-local and its exact resolver-surface projection is the
        # query input. Session identity/options changes clear the graph, so duplicating the
        # full include identity and source path in every spelling key is unnecessary.
        # Keep only stable module/name bytes; SymbolTable rows and declaration IDs are
        # rebuilt for every semantic gate and must never enter the key.
        def ifq_name_lookup_key_fits(module_name: sview, name: sview) -> bool:
            can Abort.Panic:
                prefix_length: usize = 12
                return false if module_name.len > INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT - prefix_length
                remaining: mutable usize = INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT - prefix_length - module_name.len
                return false if name.len > remaining
                return false if module_name.len > 4294967295 or name.len > 4294967295
                return true

        def ifq_name_lookup_key_encode(module_name: sview, name: sview, key: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                key.truncate(0)
                return false if not ifq_name_lookup_key_fits(module_name, name)
                key.reserve(12 + module_name.len + name.len)
                ifc_append_u32_bytes(key, INCREMENTAL_SEMANTIC_NAME_LOOKUP_KEY_VERSION)
                ifc_append_u32_bytes(key, module_name.len.u32())
                key.extend(module_name)
                ifc_append_u32_bytes(key, name.len.u32())
                key.extend(name)
                return true

        def ifq_name_lookup_input_encode(name: sview, surface: ResolverNameLookupSurface, input: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                input.truncate(0)
                input.reserve(22)
                # Schema 2 is an exact, collision-safe projection of the resolver surface.
                # Keep the name in the key; these fields encode every changing fact used by
                # resolver name classification, including empty-name misses.
                ifc_append_u32_bytes(input, 2)
                input.push(1 if surface.name_indexed else 0)
                ifc_append_u32_bytes(input, surface.symbol_count)
                ifc_append_u32_bytes(input, surface.nonmodule_symbol_count)
                ifc_append_u32_bytes(input, surface.member_count)
                input.push(1 if surface.module_present else 0)
                input.push(1 if surface.imported_visible_member else 0)
                input.push(1 if surface.current_module_member else 0)
                input.push(1 if surface.region_name_present else 0)
                forced_builtin: bool = name == "_" or name == "old" or name == "ensures" or name == "variants" or name == "fields"
                input.push(1 if forced_builtin else 0)

        def ifq_name_lookup_result(known: bool, module_only: bool) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[u8] = []
                ifc_append_u32_bytes(result, INCREMENTAL_SEMANTIC_QUERY_RESULT_VERSION)
                result.push(1 if known else 0)
                result.push(1 if module_only else 0)
                return result

        def ifq_name_lookup_result_decode[@r](session: IncrementalSemanticSession[r]& @r, evaluation: IncrementalSemanticQueryEvaluation) -> IncrementalSemanticNameLookupResult:
            can Abort.Panic:
                miss: IncrementalSemanticNameLookupResult = IncrementalSemanticNameLookupResult{hit: false, known: false, module_only: false}
                return miss if evaluation.result_length != 6 or not ifq_query_value_span_is_valid(session, evaluation.result_start, evaluation.result_length)
                return miss if ifc_read_u32(session.query_value_bytes, evaluation.result_start) != INCREMENTAL_SEMANTIC_QUERY_RESULT_VERSION
                known_byte: u8 = session.query_value_bytes[evaluation.result_start + 4]
                module_byte: u8 = session.query_value_bytes[evaluation.result_start + 5]
                return miss if known_byte > 1 or module_byte > 1
                return miss if known_byte == 0 and module_byte == 1
                return IncrementalSemanticNameLookupResult{hit: true, known: known_byte == 1, module_only: module_byte == 1}

        def ifq_function_query_key(snapshot: IncrementalSemanticSnapshot&, record: IncrementalFunctionFactRecord) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                return [] if record.key_start > snapshot.bytes.count or record.key_length > snapshot.bytes.count - record.key_start
                key: mutable darray[u8] = []
                ifc_append_u32_bytes(key, INCREMENTAL_SEMANTIC_QUERY_KEY_VERSION)
                ifc_append_u32_bytes(key, record.key_length.u32())
                if record.key_length > 0 and ifc_byte_span(snapshot.bytes, record.key_start, record.key_length) is key_bytes:
                    key.extend(key_bytes)
                return key

        def ifq_function_query_key_fits(record: IncrementalFunctionFactRecord) -> bool:
            can Abort.Panic:
                prefix_length: usize = 8
                return record.key_length <= INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT - prefix_length

        def ifq_snapshot_span_copy(bytes: darray[u8]&, start: usize, length: usize) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[u8] = []
                return result if start > bytes.count or length > bytes.count - start
                result.reserve(length)
                if length > 0 and ifc_byte_span(bytes, start, length) is span:
                    result.extend(span)
                return result

        def ifq_query_value_size_add(total: mutable usize&, additional: usize) -> bool:
            can Abort.Panic:
                return false if total > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return false if additional > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT - total
                total <- total + additional
                return true

        # Compute and validate the canonical output size before the serializer allocates
        # or appends any result bytes. Oversized results stay on the typed snapshot path.
        def ifq_direct_facts_result_size(snapshot: IncrementalSemanticSnapshot&, record_index: usize) -> IncrementalSemanticQueryValueSize:
            can Abort.Panic:
                invalid: IncrementalSemanticQueryValueSize = IncrementalSemanticQueryValueSize{valid: false, byte_count: 0}
                return invalid if record_index >= snapshot.functions.count
                record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                return invalid if not record.cacheable or record.direct_fact_start > snapshot.direct_facts.count or record.direct_fact_count > snapshot.direct_facts.count - record.direct_fact_start
                return invalid if record.direct_fact_count > 4294967295
                total: mutable usize = 12
                for relative in 0..<record.direct_fact_count |snapshot, record_index, total|:
                    fact: IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + relative]
                    return invalid if fact.owner != record_index
                    return invalid if fact.subject_start > snapshot.bytes.count or fact.subject_length > snapshot.bytes.count - fact.subject_start
                    return invalid if fact.active_grant_start > snapshot.active_grants.count or fact.active_grant_count > snapshot.active_grants.count - fact.active_grant_start
                    return invalid if fact.subject_length > 4294967295 or fact.active_grant_count > 4294967295
                    return invalid if not ifq_query_value_size_add(&total, 16)
                    return invalid if not ifq_query_value_size_add(&total, fact.subject_length)
                    for grant_relative in 0..<fact.active_grant_count |snapshot, fact, total|:
                        grant: IncrementalActiveGrant = snapshot.active_grants[fact.active_grant_start + grant_relative]
                        return invalid if grant.name_start > snapshot.bytes.count or grant.name_length > snapshot.bytes.count - grant.name_start
                        return invalid if grant.name_length > 4294967295
                        return invalid if not ifq_query_value_size_add(&total, 8)
                        return invalid if not ifq_query_value_size_add(&total, grant.name_length)
                return IncrementalSemanticQueryValueSize{valid: true, byte_count: total}

        # This exact portable encoding excludes owners, row ordinals, source offsets,
        # hashes, and metrics. It includes fact kind, subject bytes, body-relative token
        # anchor, completeness, and each ordered grant kind/name.
        def ifq_append_direct_facts_result(snapshot: IncrementalSemanticSnapshot&, record_index: usize, result: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if record_index >= snapshot.functions.count
                record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                return false if not record.cacheable or record.direct_fact_start > snapshot.direct_facts.count or record.direct_fact_count > snapshot.direct_facts.count - record.direct_fact_start
                return false if record.direct_fact_count > 4294967295
                encoded_size: IncrementalSemanticQueryValueSize = ifq_direct_facts_result_size(snapshot, record_index)
                return false if not encoded_size.valid
                result.truncate(0)
                result.reserve(encoded_size.byte_count)
                ifc_append_u32_bytes(result, INCREMENTAL_SEMANTIC_QUERY_RESULT_VERSION)
                ifc_append_u32_bytes(result, 1) # complete supported fact result
                ifc_append_u32_bytes(result, record.direct_fact_count.u32())
                for relative in 0..<record.direct_fact_count |snapshot, record_index, result|:
                    fact: IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + relative]
                    return false if fact.owner != record_index
                    return false if fact.subject_start > snapshot.bytes.count or fact.subject_length > snapshot.bytes.count - fact.subject_start
                    return false if fact.active_grant_start > snapshot.active_grants.count or fact.active_grant_count > snapshot.active_grants.count - fact.active_grant_start
                    return false if fact.subject_length > 4294967295 or fact.active_grant_count > 4294967295
                    ifc_append_u32_bytes(result, fact.kind.u32())
                    ifc_append_u32_bytes(result, fact.anchor_token)
                    ifc_append_u32_bytes(result, fact.subject_length.u32())
                    if fact.subject_length > 0 and ifc_byte_span(snapshot.bytes, fact.subject_start, fact.subject_length) is subject:
                        result.extend(subject)
                    ifc_append_u32_bytes(result, fact.active_grant_count.u32())
                    for grant_relative in 0..<fact.active_grant_count |snapshot, fact, result|:
                        grant: IncrementalActiveGrant = snapshot.active_grants[fact.active_grant_start + grant_relative]
                        return false if grant.name_start > snapshot.bytes.count or grant.name_length > snapshot.bytes.count - grant.name_start
                        return false if grant.name_length > 4294967295
                        ifc_append_u32_bytes(result, grant.kind.u32())
                        ifc_append_u32_bytes(result, grant.name_length.u32())
                        if grant.name_length > 0 and ifc_byte_span(snapshot.bytes, grant.name_start, grant.name_length) is grant_name:
                            result.extend(grant_name)
                return true

        # A graph hit is authoritative only when its canonical result still matches the
        # session snapshot's typed facts exactly. Stage and validate the whole result first,
        # then append it to the current snapshot in one reserved commit.
        def ifq_restore_direct_facts_from_result[@session](session: IncrementalSemanticSession[session]& @session, canonical_start: usize, canonical_length: usize, previous: IncrementalSemanticSnapshot&, previous_record_index: usize, snapshot: mutable IncrementalSemanticSnapshot&, owner: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if previous_record_index >= previous.functions.count or owner >= snapshot.functions.count
                return false if not ifq_query_value_span_is_valid(session, canonical_start, canonical_length)
                old_record: IncrementalFunctionFactRecord = previous.functions[previous_record_index]
                return false if not old_record.cacheable or old_record.direct_fact_start > previous.direct_facts.count or old_record.direct_fact_count > previous.direct_facts.count - old_record.direct_fact_start
                return false if snapshot.functions[owner].direct_fact_count != 0
                read_version: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, 0)
                return false if not read_version.valid or read_version.value != INCREMENTAL_SEMANTIC_QUERY_RESULT_VERSION
                read_complete: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, 4)
                return false if not read_complete.valid or read_complete.value != 1
                read_count: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, 8)
                return false if not read_count.valid or read_count.value.usize() != old_record.direct_fact_count
                cursor: mutable usize = 12
                staged_bytes: mutable darray[u8] = []
                staged_facts: mutable darray[IncrementalSemanticQueryStagedFact] = []
                staged_grants: mutable darray[IncrementalSemanticQueryStagedGrant] = []
                staged_facts.reserve(old_record.direct_fact_count)
                for relative in 0..<old_record.direct_fact_count |session, canonical_start, canonical_length, previous, previous_record_index, owner, cursor, staged_bytes, staged_facts, staged_grants|:
                    old_fact: IncrementalDirectFact = previous.direct_facts[old_record.direct_fact_start + relative]
                    return false if old_fact.owner != previous_record_index
                    return false if old_fact.subject_start > previous.bytes.count or old_fact.subject_length > previous.bytes.count - old_fact.subject_start
                    return false if old_fact.active_grant_start > previous.active_grants.count or old_fact.active_grant_count > previous.active_grants.count - old_fact.active_grant_start
                    read_kind: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, cursor)
                    return false if not read_kind.valid
                    cursor <- cursor + 4
                    fact_kind: mutable IncrementalFactKind = IncrementalFactKind.DirectCall
                    fact_kind_valid: mutable bool = false
                    if read_kind.value == IncrementalFactKind.DirectCall.u32():
                        fact_kind <- IncrementalFactKind.DirectCall
                        fact_kind_valid <- true
                    elif read_kind.value == IncrementalFactKind.GlobalRead.u32():
                        fact_kind <- IncrementalFactKind.GlobalRead
                        fact_kind_valid <- true
                    elif read_kind.value == IncrementalFactKind.GlobalWrite.u32():
                        fact_kind <- IncrementalFactKind.GlobalWrite
                        fact_kind_valid <- true
                    elif read_kind.value == IncrementalFactKind.CanGrant.u32():
                        fact_kind <- IncrementalFactKind.CanGrant
                        fact_kind_valid <- true
                    elif read_kind.value == IncrementalFactKind.TrustedGrant.u32():
                        fact_kind <- IncrementalFactKind.TrustedGrant
                        fact_kind_valid <- true
                    elif read_kind.value == IncrementalFactKind.PanicSite.u32():
                        fact_kind <- IncrementalFactKind.PanicSite
                        fact_kind_valid <- true
                    return false if not fact_kind_valid or fact_kind != old_fact.kind
                    read_anchor: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, cursor)
                    return false if not read_anchor.valid or read_anchor.value != old_fact.anchor_token
                    cursor <- cursor + 4
                    read_subject_length: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, cursor)
                    return false if not read_subject_length.valid or read_subject_length.value.usize() != old_fact.subject_length
                    cursor <- cursor + 4
                    subject_length: usize = read_subject_length.value.usize()
                    return false if cursor > canonical_length or subject_length > canonical_length - cursor
                    return false if not ifq_query_value_span_equals_snapshot(session, canonical_start, canonical_length, cursor, previous, old_fact.subject_start, subject_length)
                    staged_subject_start: usize = staged_bytes.count
                    return false if not ifq_query_value_span_append(session, canonical_start + cursor, subject_length, &staged_bytes)
                    cursor <- cursor + subject_length
                    read_grant_count: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, cursor)
                    return false if not read_grant_count.valid or read_grant_count.value.usize() != old_fact.active_grant_count
                    cursor <- cursor + 4
                    staged_grant_start: usize = staged_grants.count
                    for grant_relative in 0..<old_fact.active_grant_count |session, canonical_start, canonical_length, previous, old_fact, cursor, staged_bytes, staged_grants|:
                        old_grant: IncrementalActiveGrant = previous.active_grants[old_fact.active_grant_start + grant_relative]
                        return false if old_grant.name_start > previous.bytes.count or old_grant.name_length > previous.bytes.count - old_grant.name_start
                        read_grant_kind: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, cursor)
                        return false if not read_grant_kind.valid
                        cursor <- cursor + 4
                        grant_kind: mutable IncrementalGrantKind = IncrementalGrantKind.Can
                        grant_kind_valid: mutable bool = false
                        if read_grant_kind.value == IncrementalGrantKind.Can.u32():
                            grant_kind <- IncrementalGrantKind.Can
                            grant_kind_valid <- true
                        elif read_grant_kind.value == IncrementalGrantKind.Trusted.u32():
                            grant_kind <- IncrementalGrantKind.Trusted
                            grant_kind_valid <- true
                        return false if not grant_kind_valid or grant_kind != old_grant.kind
                        read_name_length: (valid: bool, value: u32) = ifq_read_query_value_u32(session, canonical_start, canonical_length, cursor)
                        return false if not read_name_length.valid or read_name_length.value.usize() != old_grant.name_length
                        cursor <- cursor + 4
                        name_length: usize = read_name_length.value.usize()
                        return false if cursor > canonical_length or name_length > canonical_length - cursor
                        return false if not ifq_query_value_span_equals_snapshot(session, canonical_start, canonical_length, cursor, previous, old_grant.name_start, name_length)
                        staged_name_start: usize = staged_bytes.count
                        return false if not ifq_query_value_span_append(session, canonical_start + cursor, name_length, &staged_bytes)
                        cursor <- cursor + name_length
                        staged_grants.push(IncrementalSemanticQueryStagedGrant{kind: grant_kind, name_start: staged_name_start, name_length: name_length})
                    staged_facts.push(IncrementalSemanticQueryStagedFact{kind: fact_kind, subject_start: staged_subject_start, subject_length: subject_length, anchor_token: read_anchor.value, active_grant_start: staged_grant_start, active_grant_count: old_fact.active_grant_count})
                return false if cursor != canonical_length

                snapshot.bytes.reserve(snapshot.bytes.count + staged_bytes.count)
                snapshot.direct_facts.reserve(snapshot.direct_facts.count + staged_facts.count)
                snapshot.active_grants.reserve(snapshot.active_grants.count + staged_grants.count)
                byte_base: usize = snapshot.bytes.count
                grant_base: usize = snapshot.active_grants.count
                snapshot.bytes.extend(staged_bytes)
                for grant in staged_grants |snapshot, byte_base|:
                    snapshot.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: byte_base + grant.name_start, name_length: grant.name_length})
                fact_start: usize = snapshot.direct_facts.count
                for fact in staged_facts |snapshot, owner, byte_base, grant_base|:
                    snapshot.direct_facts.push(IncrementalDirectFact{owner: owner, kind: fact.kind, subject_start: byte_base + fact.subject_start, subject_length: fact.subject_length, anchor_token: fact.anchor_token, active_grant_start: grant_base + fact.active_grant_start, active_grant_count: fact.active_grant_count})
                snapshot.functions[owner].direct_fact_start <- fact_start
                snapshot.functions[owner].direct_fact_count <- staged_facts.count
                snapshot.functions[owner].cacheable <- true
                snapshot.functions[owner].matched_previous <- true
                snapshot.functions[owner].reject_reason <- IncrementalRejectReason.None
                snapshot.bodies_matched <- snapshot.bodies_matched + 1
                return true

        def ifq_query_session_cookie[@r](session: IncrementalSemanticSession[r]& @r) -> uintptr:
            can Unsafe.PointerCast:
                return (&session).cast[void&].uintptr()

        def ifq_query_handle_invalid[@r]() -> IncrementalSemanticQueryHandle[r]:
            return IncrementalSemanticQueryHandle{node: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, session_cookie: 0, graph_generation: 0, request_generation: 0, context_generation: 0}

        def ifq_query_handle_for_id[@r](session: IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId) -> IncrementalSemanticQueryHandle[r]:
            can Unsafe.PointerCast:
                return IncrementalSemanticQueryHandle{node: query_id, session_cookie: ifq_query_session_cookie(session), graph_generation: session.query_graph_generation, request_generation: session.query_request_generation, context_generation: session.query_context_generation}

        def ifq_query_handle_is_valid[@r](session: IncrementalSemanticSession[r]& @r, handle: IncrementalSemanticQueryHandle[r]) -> bool:
            can Abort.Panic, Unsafe.PointerCast:
                return false if not session.enabled or not session.query_graph_enabled or not session.valid or session.query_graph_poisoned
                return false if session.query_graph_generation == 0 or handle.graph_generation != session.query_graph_generation
                return false if session.query_request_generation == 0 or handle.request_generation != session.query_request_generation
                return false if session.query_context_generation == 0 or handle.context_generation != session.query_context_generation
                return false if handle.session_cookie != ifq_query_session_cookie(session)
                return ifq_query_id_is_valid(session, handle.node)

        # Start a fresh graph phase. The collector probes prior values before storing the
        # new snapshot, then the publisher starts another phase under the committed
        # context. Handles cannot cross either phase boundary.
        def incremental_semantic_query_begin_request[@session](session: mutable IncrementalSemanticSession[session]& @session) -> bool:
            can Abort.Panic:
                return false if not session.enabled or not session.query_graph_enabled or not session.valid or session.query_graph_poisoned or session.query_context_generation == 0 or session.query_graph_generation == 0
                if session.query_request_generation == 18446744073709551615:
                    session.query_graph_poisoned <- true
                    return false
                session.query_request_generation <- session.query_request_generation + 1
                return true

        def ifq_query_key_span_is_valid[@r](session: IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId) -> bool:
            can Abort.Panic:
                return false if not ifq_query_id_is_valid(session, query_id)
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                key_start: usize = node.key_start.usize()
                key_length: usize = node.key_length.usize()
                return key_start <= session.query_key_bytes.count and key_length <= session.query_key_bytes.count - key_start

        def ifq_query_key_matches[@r](session: IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId, kind: IncrementalSemanticQueryKind, key: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if not ifq_query_key_span_is_valid(session, query_id)
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                return false if node.kind != kind or node.key_hash != ifq_query_key_hash(kind, key) or node.key_length.usize() != key.count
                for offset in 0..<key.count |session, node, key|:
                    return false if session.query_key_bytes[node.key_start.usize() + offset] != key[offset]
                return true

        # The hash selects a collision chain only. Exact key bytes decide identity, and
        # chain traversal is bounded so malformed/cyclic chains fail closed.
        def ifq_query_for_key_impl[@session](session: mutable IncrementalSemanticSession[session]& @session, kind: IncrementalSemanticQueryKind, key: darray[u8]&) -> IncrementalSemanticQueryId:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                missing: IncrementalSemanticQueryId = IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}
                return missing if not session.enabled or not session.query_graph_enabled or not session.valid or session.query_graph_poisoned
                return missing if key.count > INCREMENTAL_SEMANTIC_QUERY_KEY_BYTES_LIMIT
                key_hash: u64 = ifq_query_key_hash(kind, key)
                if session.query_key_heads.get(key_hash) is head:
                    cursor: mutable u32 = head.value
                    steps: mutable usize = 0
                    while cursor != INCREMENTAL_SEMANTIC_QUERY_NONE |cursor, steps, session, kind, key|:
                        if cursor.usize() >= session.query_nodes.count:
                            session.query_graph_poisoned <- true
                            return missing
                        steps <- steps + 1
                        if steps > session.query_nodes.count:
                            session.query_graph_poisoned <- true
                            return missing
                        current_id: IncrementalSemanticQueryId = IncrementalSemanticQueryId{value: cursor}
                        if not ifq_query_key_span_is_valid(session, current_id):
                            session.query_graph_poisoned <- true
                            return missing
                        if session.query_nodes[cursor.usize()].key_hash != key_hash:
                            session.query_graph_poisoned <- true
                            return missing
                        return current_id if ifq_query_key_matches(session, current_id, kind, key)
                        cursor <- session.query_nodes[cursor.usize()].next_same_hash.value
                return missing if session.query_nodes.count >= INCREMENTAL_SEMANTIC_QUERY_NONE.usize()
                return missing if not ifq_graph_within_limit(session, key.count, 0, 1, 0, 0, 0)
                key_start: usize = session.query_key_bytes.count
                previous_head: IncrementalSemanticQueryId = IncrementalSemanticQueryId{value: head.value} if session.query_key_heads.get(key_hash) is head else IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}
                return missing if not ifq_query_span_fits_u32(key_start, key.count)
                session.query_key_bytes.reserve(key_start + key.count)
                session.query_nodes.reserve(session.query_nodes.count + 1)
                session.query_key_heads.reserve(session.query_key_heads.count + 1)
                session.query_key_bytes.extend(key)
                query_id: IncrementalSemanticQueryId = IncrementalSemanticQueryId{value: session.query_nodes.count.u32()}
                session.query_nodes.push(IncrementalSemanticQueryNode{kind: kind, status: IncrementalSemanticQueryStatus.Dirty, next_same_hash: previous_head, first_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, first_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, incoming_edge_count: 0, incoming_chain_generation: 1, incoming_chain_validated_generation: 1, last_invalidation_generation: 0, key_hash: key_hash, key_start: key_start.u32(), key_length: key.count.u32(), has_committed_value: false, input_start: 0, input_length: 0, result_start: 0, result_length: 0, input_fingerprint: 0, result_fingerprint: 0, result_generation: 0})
                session.query_key_heads <- session.query_key_heads.put(key_hash, query_id) can Global{Read,Write}
                return query_id

        def incremental_semantic_query_for_key[@session](session: mutable IncrementalSemanticSession[session]& @session, kind: IncrementalSemanticQueryKind, key: darray[u8]&) -> IncrementalSemanticQueryHandle[session]:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                invalid: IncrementalSemanticQueryHandle[session] = ifq_query_handle_invalid()
                return invalid if not session.enabled or not session.query_graph_enabled or not session.valid or session.query_graph_poisoned or session.query_request_generation == 0
                query_id: IncrementalSemanticQueryId = ifq_query_for_key_impl(session, kind, key)
                return invalid if query_id.value == INCREMENTAL_SEMANTIC_QUERY_NONE or session.query_graph_poisoned
                return ifq_query_handle_for_id(session, query_id)

        def ifq_query_value_span_is_valid[@r](session: IncrementalSemanticSession[r]& @r, start: usize, length: usize) -> bool:
            can Abort.Panic:
                return start <= session.query_value_bytes.count and length <= session.query_value_bytes.count - start

        def ifq_query_node_value_state_is_valid[@r](session: IncrementalSemanticSession[r]& @r, node: IncrementalSemanticQueryNode) -> bool:
            can Abort.Panic:
                if not node.has_committed_value:
                    return node.result_generation == 0 and node.status != IncrementalSemanticQueryStatus.Green
                return false if node.result_generation == 0
                return ifq_query_value_span_is_valid(session, node.input_start.usize(), node.input_length.usize()) and ifq_query_value_span_is_valid(session, node.result_start.usize(), node.result_length.usize())

        def ifq_query_value_equals[@r](session: IncrementalSemanticSession[r]& @r, start: usize, length: usize, bytes: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if length != bytes.count or not ifq_query_value_span_is_valid(session, start, length)
                for offset in 0..<length |session, start, bytes|:
                    return false if session.query_value_bytes[start + offset] != bytes[offset]
                return true

        def ifq_query_value_span_append[@r](session: IncrementalSemanticSession[r]& @r, start: usize, length: usize, destination: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not ifq_query_value_span_is_valid(session, start, length)
                destination.reserve(destination.count + length)
                for offset in 0..<length |session, start, destination|:
                    destination.push(session.query_value_bytes[start + offset])
                return true

        def ifq_read_query_value_u32[@r](session: IncrementalSemanticSession[r]& @r, start: usize, length: usize, cursor: usize) -> (valid: bool, value: u32):
            can Abort.Panic:
                return (false, 0) if not ifq_query_value_span_is_valid(session, start, length)
                return (false, 0) if cursor > length or length - cursor < 4
                return (true, ifc_read_u32(session.query_value_bytes, start + cursor))

        def ifq_query_value_span_equals_snapshot[@r](session: IncrementalSemanticSession[r]& @r, canonical_start: usize, canonical_length: usize, canonical_offset: usize, previous: IncrementalSemanticSnapshot&, previous_start: usize, length: usize) -> bool:
            can Abort.Panic:
                return false if not ifq_query_value_span_is_valid(session, canonical_start, canonical_length)
                return false if canonical_offset > canonical_length or length > canonical_length - canonical_offset
                return false if previous_start > previous.bytes.count or length > previous.bytes.count - previous_start
                for offset in 0..<length |session, canonical_start, canonical_offset, previous|:
                    return false if session.query_value_bytes[canonical_start + canonical_offset + offset] != previous.bytes[previous_start + offset]
                return true

        def ifq_edge_links_are_valid[@r](session: IncrementalSemanticSession[r]& @r, edge_id: IncrementalSemanticDependencyEdgeId) -> bool:
            can Abort.Panic:
                return false if not ifq_edge_id_is_valid(session, edge_id)
                edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_id.value.usize()]
                return false if not ifq_query_id_is_valid(session, edge.depender) or not ifq_query_id_is_valid(session, edge.dependee)
                return false if edge.observed_result_generation == 0
                if edge.next_dependency.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                    return false if not ifq_edge_id_is_valid(session, edge.next_dependency)
                    next_dependency: IncrementalSemanticDependencyEdge = session.query_edges[edge.next_dependency.value.usize()]
                    return false if next_dependency.depender.value != edge.depender.value
                if edge.previous_depender.value == INCREMENTAL_SEMANTIC_QUERY_NONE:
                    return false if session.query_nodes[edge.dependee.value.usize()].first_depender.value != edge_id.value
                else:
                    return false if not ifq_edge_id_is_valid(session, edge.previous_depender)
                    previous: IncrementalSemanticDependencyEdge = session.query_edges[edge.previous_depender.value.usize()]
                    return false if previous.dependee.value != edge.dependee.value or previous.next_depender.value != edge_id.value
                if edge.next_depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                    return false if not ifq_edge_id_is_valid(session, edge.next_depender)
                    next: IncrementalSemanticDependencyEdge = session.query_edges[edge.next_depender.value.usize()]
                    return false if next.dependee.value != edge.dependee.value or next.previous_depender.value != edge_id.value
                return true

        def ifq_query_dependencies_check[@r](session: mutable IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId, dependencies: darray[IncrementalSemanticQueryHandle[r]]&) -> IncrementalSemanticQueryDependencyCheck:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                check: mutable IncrementalSemanticQueryDependencyCheck = IncrementalSemanticQueryDependencyCheck{valid: true, structural: false, equal: true, results_current: true, all_dependencies_green: true, unique_count: 0, old_count: 0, dependency_ids: []}
                return IncrementalSemanticQueryDependencyCheck{valid: false, structural: false, equal: false, results_current: false, all_dependencies_green: false, unique_count: 0, old_count: 0, dependency_ids: []} if dependencies.count > INCREMENTAL_SEMANTIC_QUERY_PER_DEPENDENCY_LIMIT
                for index in 0..<dependencies.count |session, query_id, dependencies, check|:
                    handle: IncrementalSemanticQueryHandle[r] = dependencies[index]
                    if not ifq_query_handle_is_valid(session, handle):
                        check.valid <- false
                        return check
                    dependency: IncrementalSemanticQueryId = handle.node
                    if dependency.value == query_id.value:
                        check.valid <- false
                        return check
                    duplicate: mutable bool = false
                    for previous in 0..<check.dependency_ids.count |check, dependency|:
                        duplicate <- true if check.dependency_ids[previous].value == dependency.value
                    continue if duplicate
                    dependency_node: IncrementalSemanticQueryNode = session.query_nodes[dependency.value.usize()]
                    if not dependency_node.has_committed_value:
                        check.valid <- false
                        return check
                    if dependency_node.result_generation == 0:
                        check.valid <- false
                        check.structural <- true
                        return check
                    check.all_dependencies_green <- false if dependency_node.status != IncrementalSemanticQueryStatus.Green
                    if not ifq_query_value_span_is_valid(session, dependency_node.input_start.usize(), dependency_node.input_length.usize()) or not ifq_query_value_span_is_valid(session, dependency_node.result_start.usize(), dependency_node.result_length.usize()):
                        check.valid <- false
                        check.structural <- true
                        return check
                    if not ifq_query_incoming_chain_validate_cached(session, dependency):
                        check.valid <- false
                        check.structural <- true
                        return check
                    check.dependency_ids.push(dependency)
                    check.unique_count <- check.unique_count + 1

                old_ids: mutable darray[IncrementalSemanticQueryId] = []
                edge_cursor: mutable IncrementalSemanticDependencyEdgeId = session.query_nodes[query_id.value.usize()].first_dependency
                steps: mutable usize = 0
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |session, query_id, edge_cursor, steps, old_ids, check|:
                    if not ifq_edge_links_are_valid(session, edge_cursor):
                        check.valid <- false
                        check.structural <- true
                        return check
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                    if edge.depender.value != query_id.value or edge.dependee.value == query_id.value:
                        check.valid <- false
                        check.structural <- true
                        return check
                    dependency_node: IncrementalSemanticQueryNode = session.query_nodes[edge.dependee.value.usize()]
                    if not dependency_node.has_committed_value or dependency_node.result_generation == 0 or not ifq_query_node_value_state_is_valid(session, dependency_node):
                        check.valid <- false
                        check.structural <- true
                        return check
                    if not ifq_query_incoming_chain_validate_cached(session, edge.dependee):
                        check.valid <- false
                        check.structural <- true
                        return check
                    duplicate_old: mutable bool = false
                    for previous in 0..<old_ids.count |old_ids, edge|:
                        duplicate_old <- true if old_ids[previous].value == edge.dependee.value
                    if duplicate_old:
                        check.valid <- false
                        check.structural <- true
                        return check
                    old_ids.push(edge.dependee)
                    found: mutable bool = false
                    for candidate in 0..<check.dependency_ids.count |check, edge, found|:
                        if check.dependency_ids[candidate].value == edge.dependee.value:
                            found <- true
                            dependency_node: IncrementalSemanticQueryNode = session.query_nodes[edge.dependee.value.usize()]
                            check.results_current <- false if edge.observed_result_generation != dependency_node.result_generation
                    check.equal <- false if not found
                    check.old_count <- check.old_count + 1
                    steps <- steps + 1
                    if steps > session.query_edges.count:
                        check.valid <- false
                        check.structural <- true
                        return check
                    edge_cursor <- edge.next_dependency
                check.equal <- false if check.old_count != check.unique_count
                return check

        def ifq_incoming_head_is_valid[@r](session: IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId) -> bool:
            can Abort.Panic:
                return false if not ifq_query_id_is_valid(session, query_id)
                head: IncrementalSemanticDependencyEdgeId = session.query_nodes[query_id.value.usize()].first_depender
                return true if head.value == INCREMENTAL_SEMANTIC_QUERY_NONE
                return false if not ifq_edge_links_are_valid(session, head)
                edge: IncrementalSemanticDependencyEdge = session.query_edges[head.value.usize()]
                return edge.dependee.value == query_id.value and edge.previous_depender.value == INCREMENTAL_SEMANTIC_QUERY_NONE

        def ifq_query_incoming_chain_is_valid[@r](session: IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId) -> bool:
            can Abort.Panic:
                return false if not ifq_query_id_is_valid(session, query_id)
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                edge_cursor: mutable IncrementalSemanticDependencyEdgeId = session.query_nodes[query_id.value.usize()].first_depender
                steps: mutable usize = 0
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |session, query_id, edge_cursor, steps|:
                    return false if not ifq_edge_links_are_valid(session, edge_cursor)
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                    return false if edge.dependee.value != query_id.value
                    steps <- steps + 1
                    return false if steps > session.query_edges.count
                    edge_cursor <- edge.next_depender
                return steps == node.incoming_edge_count.usize()

        # A full incoming-chain check is paid once per node generation. Local edge
        # rewrites preserve the validated invariant while advancing the generation,
        # keeping the shared SourceInput chain from being rescanned for every body.
        def ifq_query_incoming_chain_validate_cached[@r](session: mutable IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId) -> bool:
            can Abort.Panic:
                return false if not ifq_query_id_is_valid(session, query_id)
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                return false if node.incoming_chain_generation == 0
                return true if node.incoming_chain_validated_generation == node.incoming_chain_generation
                return false if not ifq_query_incoming_chain_is_valid(session, query_id)
                session.query_nodes[query_id.value.usize()].incoming_chain_validated_generation <- node.incoming_chain_generation
                return true

        # Called only after preflight validated the affected chain. Count and links
        # advance together; a generation wrap restarts the local proof epoch at one.
        def ifq_query_note_incoming_edge_change[@r](session: mutable IncrementalSemanticSession[r]& @r, query_id: IncrementalSemanticQueryId, added: bool) -> bool:
            can Abort.Panic:
                return false if not ifq_query_id_is_valid(session, query_id)
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                return false if node.incoming_chain_generation == 0 or node.incoming_chain_validated_generation != node.incoming_chain_generation
                if added:
                    return false if node.incoming_edge_count.usize() >= INCREMENTAL_SEMANTIC_QUERY_EDGE_LIMIT
                    session.query_nodes[query_id.value.usize()].incoming_edge_count <- node.incoming_edge_count + 1
                else:
                    return false if node.incoming_edge_count == 0
                    session.query_nodes[query_id.value.usize()].incoming_edge_count <- node.incoming_edge_count - 1
                if node.incoming_chain_generation == 18446744073709551615:
                    session.query_nodes[query_id.value.usize()].incoming_chain_generation <- 1
                    session.query_nodes[query_id.value.usize()].incoming_chain_validated_generation <- 1
                else:
                    next_generation: u64 = node.incoming_chain_generation + 1
                    session.query_nodes[query_id.value.usize()].incoming_chain_generation <- next_generation
                    session.query_nodes[query_id.value.usize()].incoming_chain_validated_generation <- next_generation
                return true

        def ifq_query_walk_path[@session](session: mutable IncrementalSemanticSession[session]& @session, start: IncrementalSemanticQueryId, target: IncrementalSemanticQueryId) -> IncrementalSemanticQueryWalkResult:
            can Memory.Allocate, Abort.Panic:
                result: mutable IncrementalSemanticQueryWalkResult = IncrementalSemanticQueryWalkResult{valid: true, budget_ok: true, reaches_target: false}
                return IncrementalSemanticQueryWalkResult{valid: false, budget_ok: true, reaches_target: false} if not ifq_query_id_is_valid(session, start) or not ifq_query_id_is_valid(session, target)
                return IncrementalSemanticQueryWalkResult{valid: true, budget_ok: true, reaches_target: true} if start.value == target.value
                session.query_invalidation_worklist.truncate(0)
                if session.query_invalidation_generation == 18446744073709551615:
                    for index in 0..<session.query_nodes.count |session|:
                        session.query_nodes[index].last_invalidation_generation <- 0
                    session.query_invalidation_generation <- 0
                session.query_invalidation_generation <- session.query_invalidation_generation + 1
                generation: u64 = session.query_invalidation_generation
                if not ifq_invalidation_worklist_push(session, start):
                    result.budget_ok <- false
                    session.query_invalidation_worklist.truncate(0)
                    return result
                session.query_nodes[start.value.usize()].last_invalidation_generation <- generation
                cursor: mutable usize = 0
                while cursor < session.query_invalidation_worklist.count |session, cursor, result|:
                    current: IncrementalSemanticQueryId = session.query_invalidation_worklist[cursor]
                    cursor <- cursor + 1
                    edge_cursor: mutable IncrementalSemanticDependencyEdgeId = session.query_nodes[current.value.usize()].first_dependency
                    steps: mutable usize = 0
                    while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |edge_cursor, steps, session, current, target, result|:
                        if not ifq_edge_links_are_valid(session, edge_cursor):
                            result.valid <- false
                            session.query_invalidation_worklist.truncate(0)
                            return result
                        edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                        if edge.depender.value != current.value:
                            result.valid <- false
                            session.query_invalidation_worklist.truncate(0)
                            return result
                        dependency: IncrementalSemanticQueryId = edge.dependee
                        if dependency.value == target.value:
                            result.reaches_target <- true
                            session.query_invalidation_worklist.truncate(0)
                            return result
                        if session.query_nodes[dependency.value.usize()].last_invalidation_generation != generation:
                            if not ifq_invalidation_worklist_push(session, dependency):
                                result.budget_ok <- false
                                session.query_invalidation_worklist.truncate(0)
                                return result
                            session.query_nodes[dependency.value.usize()].last_invalidation_generation <- generation
                        steps <- steps + 1
                        if steps > session.query_edges.count:
                            result.valid <- false
                            session.query_invalidation_worklist.truncate(0)
                            return result
                        edge_cursor <- edge.next_dependency
                session.query_invalidation_worklist.truncate(0)
                return result

        # Mark the reverse closure PotentiallyDirty only after the whole closure and
        # its links have been checked. A later query can become Green without walking
        # its body when its direct dependencies stabilize at the same result generations.
        def ifq_mark_reverse_closure[@session](session: mutable IncrementalSemanticSession[session]& @session, root: IncrementalSemanticQueryId, root_status: IncrementalSemanticQueryStatus) -> bool:
            can Memory.Allocate, Abort.Panic:
                walk: IncrementalSemanticQueryWalkResult = IncrementalSemanticQueryWalkResult{valid: true, budget_ok: true, reaches_target: false}
                if not ifq_query_id_is_valid(session, root):
                    session.query_graph_poisoned <- true
                    return false
                session.query_invalidation_worklist.truncate(0)
                if session.query_invalidation_generation == 18446744073709551615:
                    for index in 0..<session.query_nodes.count |session|:
                        session.query_nodes[index].last_invalidation_generation <- 0
                    session.query_invalidation_generation <- 0
                session.query_invalidation_generation <- session.query_invalidation_generation + 1
                generation: u64 = session.query_invalidation_generation
                if not ifq_invalidation_worklist_push(session, root):
                    session.query_invalidation_worklist.truncate(0)
                    session.query_graph_poisoned <- true
                    return false
                session.query_nodes[root.value.usize()].last_invalidation_generation <- generation
                cursor: mutable usize = 0
                while cursor < session.query_invalidation_worklist.count |session, cursor, walk|:
                    current: IncrementalSemanticQueryId = session.query_invalidation_worklist[cursor]
                    cursor <- cursor + 1
                    edge_cursor: mutable IncrementalSemanticDependencyEdgeId = session.query_nodes[current.value.usize()].first_depender
                    steps: mutable usize = 0
                    while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |session, edge_cursor, current, steps, walk|:
                        if not ifq_edge_links_are_valid(session, edge_cursor):
                            walk.valid <- false
                            break
                        edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                        if edge.dependee.value != current.value:
                            walk.valid <- false
                            break
                        dependent: IncrementalSemanticQueryId = edge.depender
                        dependent_node: IncrementalSemanticQueryNode = session.query_nodes[dependent.value.usize()]
                        if not dependent_node.has_committed_value or not ifq_query_node_value_state_is_valid(session, dependent_node):
                            walk.valid <- false
                            break
                        if session.query_nodes[dependent.value.usize()].last_invalidation_generation != generation:
                            if not ifq_invalidation_worklist_push(session, dependent):
                                walk.budget_ok <- false
                                break
                            session.query_nodes[dependent.value.usize()].last_invalidation_generation <- generation
                        steps <- steps + 1
                        if steps > session.query_edges.count:
                            walk.valid <- false
                            break
                        edge_cursor <- edge.next_depender
                    if walk.valid and steps != session.query_nodes[current.value.usize()].incoming_edge_count.usize():
                        walk.valid <- false
                    if not walk.valid or not walk.budget_ok:
                        break
                if not walk.valid or not walk.budget_ok:
                    session.query_invalidation_worklist.truncate(0)
                    session.query_graph_poisoned <- true
                    return false
                for index in 0..<session.query_invalidation_worklist.count |session, root, root_status|:
                    query_id: IncrementalSemanticQueryId = session.query_invalidation_worklist[index]
                    if query_id.value == root.value:
                        if root_status != IncrementalSemanticQueryStatus.PotentiallyDirty or session.query_nodes[query_id.value.usize()].status != IncrementalSemanticQueryStatus.Dirty:
                            session.query_nodes[query_id.value.usize()].status <- root_status
                    elif session.query_nodes[query_id.value.usize()].status != IncrementalSemanticQueryStatus.Dirty:
                        session.query_nodes[query_id.value.usize()].status <- IncrementalSemanticQueryStatus.PotentiallyDirty
                session.query_invalidation_worklist.truncate(0)
                return true

        def ifq_query_mark_stale[@session](session: mutable IncrementalSemanticSession[session]& @session, query_id: IncrementalSemanticQueryId) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ifq_mark_reverse_closure(session, query_id, IncrementalSemanticQueryStatus.Dirty)

        def ifq_query_mark_potentially_stale[@session](session: mutable IncrementalSemanticSession[session]& @session, query_id: IncrementalSemanticQueryId) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ifq_mark_reverse_closure(session, query_id, IncrementalSemanticQueryStatus.PotentiallyDirty)

        def ifq_query_evaluate[@session](session: mutable IncrementalSemanticSession[session]& @session, handle: IncrementalSemanticQueryHandle[session], input: darray[u8]&, dependencies: darray[IncrementalSemanticQueryHandle[session]]&) -> IncrementalSemanticQueryEvaluation:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                miss: IncrementalSemanticQueryEvaluation = IncrementalSemanticQueryEvaluation{hit: false, result_start: 0, result_length: 0}
                return miss if input.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return miss if not ifq_query_handle_is_valid(session, handle)
                query_id: IncrementalSemanticQueryId = handle.node
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                if not ifq_query_node_value_state_is_valid(session, node):
                    session.query_graph_poisoned <- true
                    return miss
                check: IncrementalSemanticQueryDependencyCheck = ifq_query_dependencies_check(session, query_id, dependencies)
                if not check.valid:
                    if check.structural:
                        session.query_graph_poisoned <- true
                    else:
                        _ = ifq_query_mark_stale(session, query_id)
                    return miss
                same_input: bool = node.has_committed_value and node.input_fingerprint == ifq_query_value_hash(input) and ifq_query_value_equals(session, node.input_start.usize(), node.input_length.usize(), input)
                if not check.all_dependencies_green:
                    _ = ifq_query_mark_potentially_stale(session, query_id)
                    return miss
                if not node.has_committed_value:
                    return miss
                if not same_input or not check.equal or not check.results_current:
                    _ = ifq_query_mark_stale(session, query_id)
                    return miss
                return miss if node.status == IncrementalSemanticQueryStatus.Dirty
                session.query_nodes[query_id.value.usize()].status <- IncrementalSemanticQueryStatus.Green if node.status == IncrementalSemanticQueryStatus.PotentiallyDirty
                return IncrementalSemanticQueryEvaluation{hit: true, result_start: node.result_start.usize(), result_length: node.result_length.usize()}

        def ifq_free_query_edges_valid_for_replacement[@r](session: IncrementalSemanticSession[r]& @r, unique_count: usize, old_count: usize) -> bool:
            can Abort.Panic:
                selected_existing: mutable usize = unique_count - old_count if unique_count > old_count else 0
                selected_existing <- session.free_query_edges.count if selected_existing > session.free_query_edges.count
                return false if session.free_query_edges.count > session.query_edges.count
                for relative in 0..<selected_existing |session, relative, old_count|:
                    free_index: usize = session.free_query_edges.count - 1 - relative
                    edge_id: IncrementalSemanticDependencyEdgeId = session.free_query_edges[free_index]
                    return false if edge_id.value == INCREMENTAL_SEMANTIC_QUERY_NONE or edge_id.value.usize() >= session.query_edges.count
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_id.value.usize()]
                    return false if edge.depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE or edge.dependee.value != INCREMENTAL_SEMANTIC_QUERY_NONE
                    for previous in 0..<relative |session, free_index, edge_id|:
                        previous_id: IncrementalSemanticDependencyEdgeId = session.free_query_edges[session.free_query_edges.count - 1 - previous]
                        return false if previous_id.value == edge_id.value
                return true

        def ifq_apply_dependency_set[@session](session: mutable IncrementalSemanticSession[session]& @session, depender: IncrementalSemanticQueryId, dependencies: darray[IncrementalSemanticQueryId]&) -> bool:
            can Abort.Panic:
                edge_cursor: mutable IncrementalSemanticDependencyEdgeId = session.query_nodes[depender.value.usize()].first_dependency
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |session, depender, edge_cursor|:
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                    next_edge: IncrementalSemanticDependencyEdgeId = edge.next_dependency
                    if not ifq_query_note_incoming_edge_change(session, edge.dependee, false):
                        session.query_graph_poisoned <- true
                        return false
                    if edge.previous_depender.value == INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_nodes[edge.dependee.value.usize()].first_depender <- edge.next_depender
                    else:
                        session.query_edges[edge.previous_depender.value.usize()].next_depender <- edge.next_depender
                    if edge.next_depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_edges[edge.next_depender.value.usize()].previous_depender <- edge.previous_depender
                    session.query_edges[edge_cursor.value.usize()] <- IncrementalSemanticDependencyEdge{depender: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, dependee: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, observed_result_generation: 0}
                    session.free_query_edges.push(edge_cursor)
                    edge_cursor <- next_edge
                session.query_nodes[depender.value.usize()].first_dependency <- IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}
                for index in 0..<dependencies.count |session, depender, dependencies|:
                    dependency: IncrementalSemanticQueryId = dependencies[index]
                    duplicate: mutable bool = false
                    for previous in 0..<index |duplicate, dependency, dependencies|:
                        duplicate <- true if dependencies[previous].value == dependency.value
                    continue if duplicate
                    if not ifq_query_note_incoming_edge_change(session, dependency, true):
                        session.query_graph_poisoned <- true
                        return false
                    edge_id: mutable IncrementalSemanticDependencyEdgeId
                    if session.free_query_edges.count > 0:
                        edge_id <- session.free_query_edges.pop()
                    else:
                        edge_id <- IncrementalSemanticDependencyEdgeId{value: session.query_edges.count.u32()}
                        session.query_edges.push(IncrementalSemanticDependencyEdge{depender: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, dependee: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, observed_result_generation: 0})
                    outgoing_head: IncrementalSemanticDependencyEdgeId = session.query_nodes[depender.value.usize()].first_dependency
                    incoming_head: IncrementalSemanticDependencyEdgeId = session.query_nodes[dependency.value.usize()].first_depender
                    session.query_edges[edge_id.value.usize()] <- IncrementalSemanticDependencyEdge{depender: depender, dependee: dependency, next_dependency: outgoing_head, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: incoming_head, observed_result_generation: session.query_nodes[dependency.value.usize()].result_generation}
                    if incoming_head.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_edges[incoming_head.value.usize()].previous_depender <- edge_id
                    session.query_nodes[depender.value.usize()].first_dependency <- edge_id
                    session.query_nodes[dependency.value.usize()].first_depender <- edge_id
                return true

        def ifq_query_commit[@session](session: mutable IncrementalSemanticSession[session]& @session, handle: IncrementalSemanticQueryHandle[session], input: darray[u8]&, dependencies: darray[IncrementalSemanticQueryHandle[session]]&, canonical_result: darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return false if input.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return false if canonical_result.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return false if not ifq_query_handle_is_valid(session, handle)
                query_id: IncrementalSemanticQueryId = handle.node
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                check: IncrementalSemanticQueryDependencyCheck = ifq_query_dependencies_check(session, query_id, dependencies)
                if not check.valid:
                    if check.structural:
                        session.query_graph_poisoned <- true
                    else:
                        _ = ifq_query_mark_stale(session, query_id)
                    return false
                if not check.all_dependencies_green:
                    _ = ifq_query_mark_stale(session, query_id)
                    return false
                dependency_update_required: bool = not check.equal or not check.results_current
                if dependency_update_required and not check.equal:
                    for index in 0..<check.unique_count |session, check, query_id|:
                        walk: IncrementalSemanticQueryWalkResult = ifq_query_walk_path(session, check.dependency_ids[index], query_id)
                        if not walk.valid:
                            session.query_graph_poisoned <- true
                            return false
                        if not walk.budget_ok:
                            ifq_clear_session_graph(session)
                            return false
                        if walk.reaches_target:
                            _ = ifq_query_mark_stale(session, query_id)
                            return false
                if not ifq_query_node_value_state_is_valid(session, node):
                    session.query_graph_poisoned <- true
                    return false
                candidate_input_fingerprint: u64 = ifq_query_value_hash(input)
                candidate_result_fingerprint: u64 = ifq_query_value_hash(canonical_result)
                input_changed: mutable bool = not node.has_committed_value
                if node.has_committed_value:
                    input_changed <- true if node.input_fingerprint != candidate_input_fingerprint
                    input_changed <- true if node.input_fingerprint == candidate_input_fingerprint and not ifq_query_value_equals(session, node.input_start.usize(), node.input_length.usize(), input)
                result_changed: mutable bool = not node.has_committed_value
                if node.has_committed_value:
                    result_changed <- true if node.result_fingerprint != candidate_result_fingerprint
                    result_changed <- true if node.result_fingerprint == candidate_result_fingerprint and not ifq_query_value_equals(session, node.result_start.usize(), node.result_length.usize(), canonical_result)
                if result_changed and node.result_generation == 18446744073709551615:
                    ifq_clear_session_graph(session)
                    return false
                if dependency_update_required and not ifq_free_query_edges_valid_for_replacement(session, check.unique_count, check.old_count):
                    session.query_graph_poisoned <- true
                    return false
                share_input_result: bool = ifq_query_bytes_equal(input, canonical_result)
                new_value_bytes: mutable usize = 0
                if input_changed:
                    return false if input.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                    new_value_bytes <- input.count
                if result_changed and not share_input_result:
                    return false if new_value_bytes > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                    return false if canonical_result.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT - new_value_bytes
                    new_value_bytes <- new_value_bytes + canonical_result.count
                append_edges: usize = check.unique_count - (session.free_query_edges.count + check.old_count) if check.unique_count > session.free_query_edges.count + check.old_count else 0
                extra_free_edges: usize = check.old_count if dependency_update_required else 0
                extra_edges: usize = append_edges if dependency_update_required else 0
                if not ifq_graph_within_limit(session, 0, new_value_bytes, 0, extra_edges, extra_free_edges, 0):
                    # Discard the logical graph on admission overflow. This invalidates
                    # every outstanding handle and lets a later request rebuild within
                    # the same bounded session instead of failing forever at the cap.
                    ifq_clear_session_graph(session)
                    return false
                input_start: mutable usize = node.input_start.usize()
                result_start: mutable usize = node.result_start.usize()
                value_cursor: mutable usize = session.query_value_bytes.count
                if input_changed:
                    input_start <- value_cursor
                    value_cursor <- value_cursor + input.count
                if result_changed:
                    if share_input_result:
                        result_start <- input_start
                    else:
                        result_start <- value_cursor
                        value_cursor <- value_cursor + canonical_result.count
                return false if input_changed and not ifq_query_span_fits_u32(input_start, input.count)
                return false if result_changed and not ifq_query_span_fits_u32(result_start, canonical_result.count)
                session.query_value_bytes.reserve(session.query_value_bytes.count + new_value_bytes)
                if dependency_update_required:
                    session.query_edges.reserve(session.query_edges.count + append_edges)
                    session.free_query_edges.reserve(session.free_query_edges.count + check.old_count)
                if result_changed and not ifq_mark_reverse_closure(session, query_id, IncrementalSemanticQueryStatus.PotentiallyDirty):
                    return false
                if dependency_update_required:
                    return false if not ifq_apply_dependency_set(session, query_id, check.dependency_ids)
                if input_changed:
                    session.query_value_bytes.extend(input)
                session.query_value_bytes.extend(canonical_result) if result_changed and not share_input_result
                session.query_nodes[query_id.value.usize()].has_committed_value <- true
                session.query_nodes[query_id.value.usize()].input_start <- input_start.u32()
                session.query_nodes[query_id.value.usize()].input_length <- input.count.u32()
                session.query_nodes[query_id.value.usize()].result_start <- result_start.u32()
                session.query_nodes[query_id.value.usize()].result_length <- canonical_result.count.u32()
                session.query_nodes[query_id.value.usize()].input_fingerprint <- candidate_input_fingerprint
                session.query_nodes[query_id.value.usize()].result_fingerprint <- candidate_result_fingerprint
                session.query_nodes[query_id.value.usize()].result_generation <- session.query_nodes[query_id.value.usize()].result_generation + 1 if result_changed
                session.query_nodes[query_id.value.usize()].status <- IncrementalSemanticQueryStatus.Green
                return true

        def ifq_clear_session_graph[@session](session: mutable IncrementalSemanticSession[session]& @session) -> void can[Memory.Allocate]:
            session.query_key_bytes.truncate(0)
            session.query_key_heads.clear()
            session.query_nodes.truncate(0)
            session.query_edges.truncate(0)
            session.free_query_edges.truncate(0)
            session.query_value_bytes.truncate(0)
            session.query_request_generation <- 0
            session.query_invalidation_generation <- 0
            session.query_invalidation_worklist.truncate(0)
            if session.query_graph_generation == 0 or session.query_graph_generation == 18446744073709551615:
                session.query_graph_generation <- 0
                session.query_graph_poisoned <- true
            else:
                session.query_graph_generation <- session.query_graph_generation + 1
                session.query_graph_poisoned <- false

        def ifc_session_clear_prior[@session](session: mutable IncrementalSemanticSession[session]& @session) -> void:
            can Memory.Allocate:
                session.valid <- false
                session.analyzed_source.truncate(0)
                session.identity_key.truncate(0)
                session.options_key.truncate(0)
                session.generated_input <- false
                session.semantic_fingerprint <- 0
                session.snapshot.schema_version <- 0
                session.snapshot.semantic_fingerprint <- 0
                session.snapshot.options_fingerprint <- 0
                session.snapshot.options_key.truncate(0)
                session.snapshot.bytes.truncate(0)
                session.snapshot.source_path_start <- 0
                session.snapshot.source_path_length <- 0
                session.snapshot.declaration_surface_start <- 0
                session.snapshot.declaration_surface_length <- 0
                session.snapshot.declaration_surface_hash <- 0
                session.snapshot.functions.truncate(0)
                session.snapshot.direct_facts.truncate(0)
                session.snapshot.active_grants.truncate(0)
                session.snapshot.self_assignment_ranges.truncate(0)
                session.snapshot.self_assignment_facts.truncate(0)
                session.snapshot.bodies_visited <- 0
                session.snapshot.bodies_matched <- 0
                session.snapshot.bodies_rejected <- 0
                session.snapshot.self_assignment_bodies_scanned <- 0
                session.snapshot.self_assignment_bodies_reused <- 0
                session.snapshot.declaration_surface_valid <- false
                session.snapshot.surface_compatible <- false

        def ifc_session_source_matches[@session](session: IncrementalSemanticSession[session]& @session, source: u8&, source_length: usize) -> bool:
            can Abort.Panic, Unsafe.PointerArithmetic:
                return false if source_length != session.analyzed_source.count
                for index in 0..<source_length |session, source|:
                    current_byte: u8& = source + index
                    current_value: u8 = current_byte
                    return false if session.analyzed_source[index] != current_value
                return true

        def ifc_session_key_matches(stored: darray[u8]&, current: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if stored.count != current.count
                for index in 0..<current.count:
                    return false if stored[index] != current[index]
                return true

        # Copy from the session-owned region into a fresh request snapshot. Rebinding
        # anchors and checker updates then cannot mutate trusted retained facts.
        def ifc_clone_session_snapshot[@r](source: IncrementalSemanticSessionSnapshot[r]& @r) -> IncrementalSemanticSnapshot:
            can Memory.Allocate, Abort.Panic:
                cloned: mutable IncrementalSemanticSnapshot = incremental_empty_snapshot()
                cloned.schema_version <- source.schema_version
                cloned.semantic_fingerprint <- source.semantic_fingerprint
                cloned.options_fingerprint <- source.options_fingerprint
                cloned.source_path_start <- source.source_path_start
                cloned.source_path_length <- source.source_path_length
                cloned.declaration_surface_start <- source.declaration_surface_start
                cloned.declaration_surface_length <- source.declaration_surface_length
                cloned.declaration_surface_hash <- source.declaration_surface_hash
                cloned.declaration_surface_valid <- source.declaration_surface_valid
                cloned.options_key.reserve(source.options_key.count)
                cloned.options_key.extend(source.options_key)
                cloned.bytes.reserve(source.bytes.count)
                cloned.bytes.extend(source.bytes)
                cloned.functions.reserve(source.functions.count)
                for record in source.functions |cloned|:
                    cloned.functions.push(record)
                cloned.direct_facts.reserve(source.direct_facts.count)
                for fact in source.direct_facts |cloned|:
                    cloned.direct_facts.push(fact)
                cloned.active_grants.reserve(source.active_grants.count)
                for grant in source.active_grants |cloned|:
                    cloned.active_grants.push(grant)
                cloned.self_assignment_ranges.reserve(source.self_assignment_ranges.count)
                for range in source.self_assignment_ranges |cloned|:
                    cloned.self_assignment_ranges.push(range)
                cloned.self_assignment_facts.reserve(source.self_assignment_facts.count)
                for fact in source.self_assignment_facts |cloned|:
                    cloned.self_assignment_facts.push(fact)
                return cloned

        # Copy portable facts into storage whose element buffers are statically tied to the
        # session region. No request-local source anchors or sview names enter durable state.
        def ifc_clone_session_snapshot_into[@session](source: IncrementalSemanticSnapshot&, destination: mutable IncrementalSemanticSessionSnapshot[session]& @session) -> void:
            can Memory.Allocate, Abort.Panic:
                destination.schema_version <- source.schema_version
                destination.semantic_fingerprint <- source.semantic_fingerprint
                destination.options_fingerprint <- source.options_fingerprint
                destination.source_path_start <- source.source_path_start
                destination.source_path_length <- source.source_path_length
                destination.declaration_surface_start <- source.declaration_surface_start
                destination.declaration_surface_length <- source.declaration_surface_length
                destination.declaration_surface_hash <- source.declaration_surface_hash
                destination.declaration_surface_valid <- source.declaration_surface_valid
                destination.options_key.truncate(0)
                destination.options_key.reserve(source.options_key.count)
                destination.options_key.extend(source.options_key)
                destination.bytes.truncate(0)
                destination.bytes.reserve(source.bytes.count)
                destination.bytes.extend(source.bytes)
                destination.functions.truncate(0)
                destination.functions.reserve(source.functions.count)
                for record in source.functions |destination|:
                    destination.functions.push(record)
                destination.direct_facts.truncate(0)
                destination.direct_facts.reserve(source.direct_facts.count)
                for fact in source.direct_facts |destination|:
                    destination.direct_facts.push(fact)
                destination.active_grants.truncate(0)
                destination.active_grants.reserve(source.active_grants.count)
                for grant in source.active_grants |destination|:
                    destination.active_grants.push(grant)
                destination.self_assignment_ranges.truncate(0)
                destination.self_assignment_ranges.reserve(source.self_assignment_ranges.count)
                for range in source.self_assignment_ranges |destination|:
                    destination.self_assignment_ranges.push(range)
                destination.self_assignment_facts.truncate(0)
                destination.self_assignment_facts.reserve(source.self_assignment_facts.count)
                for fact in source.self_assignment_facts |destination|:
                    destination.self_assignment_facts.push(fact)
                destination.bodies_visited <- 0
                destination.bodies_matched <- 0
                destination.bodies_rejected <- 0
                destination.self_assignment_bodies_scanned <- 0
                destination.self_assignment_bodies_reused <- 0
                destination.surface_compatible <- source.surface_compatible

        def ifc_session_store[@session](session: mutable IncrementalSemanticSession[session]& @session, source: u8&, source_length: usize, identity_key: darray[u8]&, options_key: darray[u8]&, generated_input: bool, semantic_fingerprint: u64, snapshot: IncrementalSemanticSnapshot&) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerArithmetic:
                if not session.enabled:
                    incremental_semantic_session_reset(session)
                    return false
                encoded_size: IncrementalSnapshotSizeResult = incremental_snapshot_encoded_size(snapshot)
                return false if not encoded_size.valid
                size: mutable usize = source_length
                return false if size > INCREMENTAL_SNAPSHOT_CODEC_LIMIT
                return false if identity_key.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                size <- size + identity_key.count
                return false if options_key.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                size <- size + options_key.count
                linter_extra: u64 = snapshot.self_assignment_facts.count.u64() * 64 + snapshot.self_assignment_ranges.count.u64() * 32
                return false if linter_extra > (INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size).u64()
                size <- size + linter_extra.usize()
                return false if encoded_size.byte_count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                # Reserve every retained destination before invalidating the prior
                # snapshot. A rejected size leaves the prior snapshot authoritative;
                # its query graph is poisoned by the caller until another commit.
                session.analyzed_source.reserve(source_length)
                session.identity_key.reserve(identity_key.count)
                session.options_key.reserve(options_key.count)
                session.snapshot.options_key.reserve(options_key.count)
                session.snapshot.bytes.reserve(snapshot.bytes.count)
                session.snapshot.functions.reserve(snapshot.functions.count)
                session.snapshot.direct_facts.reserve(snapshot.direct_facts.count)
                session.snapshot.active_grants.reserve(snapshot.active_grants.count)
                session.snapshot.self_assignment_ranges.reserve(snapshot.self_assignment_ranges.count)
                session.snapshot.self_assignment_facts.reserve(snapshot.self_assignment_facts.count)
                ifc_session_clear_prior(session)
                for index in 0..<source_length |session, source|:
                    current_byte: u8& = source + index
                    current_value: u8 = current_byte
                    session.analyzed_source.push(current_value)
                for index in 0..<identity_key.count |session, identity_key|:
                    byte: u8 = identity_key[index]
                    session.identity_key.push(byte)
                for index in 0..<options_key.count |session, options_key|:
                    byte: u8 = options_key[index]
                    session.options_key.push(byte)
                ifc_clone_session_snapshot_into(snapshot, &session.snapshot)
                session.generated_input <- generated_input
                session.semantic_fingerprint <- semantic_fingerprint
                if session.query_graph_enabled:
                    if session.query_graph_poisoned:
                        ifq_clear_session_graph(session)
                    if session.query_context_generation == 18446744073709551615:
                        ifq_clear_session_graph(session)
                        session.query_context_generation <- 1
                    else:
                        session.query_context_generation <- session.query_context_generation + 1
                session.valid <- true
                return true

        # Collection already evaluated the exact body bytes and restored its canonical
        # facts. The same request-local snapshot is passed unchanged through session_store;
        # this proof permits skipping only the duplicate body evaluation after the expected
        # context bump. It is rejected after graph clear, source/result change, or poisoning.
        def ifc_validated_body_query_hit_is_current[@session](session: mutable IncrementalSemanticSession[session]& @session, request_metrics: IncrementalFunctionFactsRequestMetrics&, record_index: usize, record: IncrementalFunctionFactRecord, query_key: darray[u8]&, query_handle: IncrementalSemanticQueryHandle[session], dependencies: darray[IncrementalSemanticQueryHandle[session]]&, source_result_generation: u64) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return false if not request_metrics.source_input_admitted or session.query_graph_poisoned
                return false if request_metrics.validated_body_query_generation != session.query_graph_generation
                return false if not ifq_query_handle_is_valid(session, query_handle)
                # Collection appends at most one marker per function record, in
                # increasing record order. Lower-bound the sparse list so a warm
                # request does not scan N markers once for each of N cacheable bodies.
                low: mutable usize = 0
                high: mutable usize = request_metrics.validated_body_query_hits.count
                while low < high |low, high, request_metrics, record_index|:
                    middle: usize = low + (high - low) / 2
                    marker: IncrementalSemanticBodyQueryHitMarker = request_metrics.validated_body_query_hits[middle]
                    if marker.function_record_index < record_index:
                        low <- middle + 1
                    else:
                        high <- middle
                return false if low >= request_metrics.validated_body_query_hits.count
                marker: IncrementalSemanticBodyQueryHitMarker = request_metrics.validated_body_query_hits[low]
                return false if not marker.direct_facts_restored
                return false if marker.function_record_index != record_index or marker.query_id.value != query_handle.node.value
                return false if marker.graph_generation != session.query_graph_generation or marker.source_result_generation != source_result_generation
                return false if marker.body_start != record.body_start or marker.body_length != record.body_length
                return false if not ifq_query_key_matches(session, marker.query_id, IncrementalSemanticQueryKind.FunctionBodyFacts, query_key)
                node: IncrementalSemanticQueryNode = session.query_nodes[marker.query_id.value.usize()]
                return false if node.status != IncrementalSemanticQueryStatus.Green or not node.has_committed_value
                return false if node.result_generation != marker.query_result_generation or not ifq_query_node_value_state_is_valid(session, node)
                dependency_check: IncrementalSemanticQueryDependencyCheck = ifq_query_dependencies_check(session, marker.query_id, dependencies)
                return false if not dependency_check.valid or not dependency_check.equal or not dependency_check.results_current or not dependency_check.all_dependencies_green
                return true

        # Publish graph values only after ifc_session_store has made this exact snapshot
        # authoritative. Query handles are reacquired under the committed context.
        def ifc_publish_query_graph_once[@session](session: mutable IncrementalSemanticSession[session]& @session, snapshot: IncrementalSemanticSnapshot&, identity_key: darray[u8]&, source_path: sview, request_metrics: mutable IncrementalFunctionFactsRequestMetrics&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                return false if not session.enabled or not session.query_graph_enabled or not session.valid or not snapshot.declaration_surface_valid
                return false if snapshot.declaration_surface_start > snapshot.bytes.count or snapshot.declaration_surface_length > snapshot.bytes.count - snapshot.declaration_surface_start
                return false if not ifq_source_query_value_fits(snapshot.options_key.count, snapshot.declaration_surface_length)
                return false if not incremental_semantic_query_begin_request(session)
                source_key: darray[u8] = ifq_source_query_key(identity_key, source_path)
                declaration_surface: darray[u8] = ifq_snapshot_span_copy(snapshot.bytes, snapshot.declaration_surface_start, snapshot.declaration_surface_length)
                source_value: darray[u8] = ifq_source_query_value(snapshot.options_key, declaration_surface)
                source_handle: IncrementalSemanticQueryHandle[session] = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.SourceInput, source_key)
                no_dependencies: darray[IncrementalSemanticQueryHandle[session]] = []
                source_evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, source_handle, source_value, no_dependencies)
                source_input_hit_current: bool = source_evaluation.hit and ifq_query_value_equals(session, source_evaluation.result_start, source_evaluation.result_length, source_value)
                if not source_input_hit_current:
                    return false if not ifq_query_commit(session, source_handle, source_value, no_dependencies, source_value)
                dependencies: mutable darray[IncrementalSemanticQueryHandle[session]] = []
                dependencies.push(source_handle)
                body_query_publish_skips: mutable u32 = 0
                for record_index in 0..<snapshot.functions.count |session, snapshot, identity_key, source_path, source_handle, dependencies, source_input_hit_current, request_metrics, body_query_publish_skips|:
                    record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                    continue if not record.cacheable
                    continue if not ifq_function_query_key_fits(record)
                    continue if record.body_length > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                    return false if record.body_start > snapshot.bytes.count or record.body_length > snapshot.bytes.count - record.body_start
                    query_key: darray[u8] = ifq_function_query_key(snapshot, record)
                    query_handle: IncrementalSemanticQueryHandle[session] = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.FunctionBodyFacts, query_key)
                    source_node: IncrementalSemanticQueryNode = session.query_nodes[source_handle.node.value.usize()]
                    if source_input_hit_current and ifc_validated_body_query_hit_is_current(session, request_metrics, record_index, record, query_key, query_handle, dependencies, source_node.result_generation):
                        ifc_increment_candidate_metric(&body_query_publish_skips, snapshot.functions.count)
                        continue
                    body_input: darray[u8] = ifq_snapshot_span_copy(snapshot.bytes, record.body_start, record.body_length)
                    query_evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, query_handle, body_input, dependencies)
                    if not query_evaluation.hit:
                        result_size: IncrementalSemanticQueryValueSize = ifq_direct_facts_result_size(snapshot, record_index)
                        continue if not result_size.valid
                        canonical_result: mutable darray[u8] = []
                        return false if not ifq_append_direct_facts_result(snapshot, record_index, &canonical_result)
                        return false if not ifq_query_commit(session, query_handle, body_input, dependencies, canonical_result)
                request_metrics.body_query_publish_skips <- body_query_publish_skips
                return true

        # query_value_bytes is append-only during a request. When historical values fill
        # its logical budget, clear the graph and rebuild from the current committed
        # snapshot once. If that working set itself does not fit, leave the graph empty;
        # the exact semantic snapshot remains available to its existing cold-safe path.
        def ifc_publish_query_graph[@session](session: mutable IncrementalSemanticSession[session]& @session, snapshot: IncrementalSemanticSnapshot&, identity_key: darray[u8]&, source_path: sview, request_metrics: mutable IncrementalFunctionFactsRequestMetrics&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                return false if not session.query_graph_enabled or not ifq_source_query_key_fits(identity_key, source_path)
                return true if ifc_publish_query_graph_once(session, snapshot, identity_key, source_path, request_metrics)
                ifq_clear_session_graph(session)
                return true if ifc_publish_query_graph_once(session, snapshot, identity_key, source_path, request_metrics)
                ifq_clear_session_graph(session)
                return false

    public:
        # This is the only API that can advance trusted process-local provenance. The prior
        # snapshot is private and reaches allow_session_reuse only after its exact context
        # has matched. Sidecar snapshots continue through the rescan-only API.
        def incremental_collect_function_facts_with_session[@session](file: Ast::File&, source: u8&, source_length: usize, tokens: darray[Lexer::Token]&, source_path: sview, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, identity_key: darray[u8]&, generated_input: bool, session: mutable IncrementalSemanticSession[session]& @session) -> IncrementalSessionCollectionResult:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerArithmetic, Global{Read,Write}, Unsafe.PointerCast:
                empty: IncrementalSessionCollectionResult = IncrementalSessionCollectionResult{snapshot: incremental_empty_snapshot(), prior_valid: false, exact_hit: false, body_facts_reused: false, function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false}
                return empty if not session.enabled
                context_matches: mutable bool = session.valid
                context_matches <- false if session.semantic_fingerprint != semantic_fingerprint or session.generated_input != generated_input
                context_matches <- false if not ifc_session_key_matches(session.options_key, options_key)
                context_matches <- false if not ifc_session_key_matches(session.identity_key, identity_key)
                context_matches <- false if session.snapshot.schema_version != INCREMENTAL_FUNCTION_FACTS_SCHEMA
                context_matches <- false if session.snapshot.semantic_fingerprint != semantic_fingerprint or session.snapshot.options_fingerprint != options_fingerprint
                context_matches <- false if not ifc_session_key_matches(session.snapshot.options_key, options_key)
                if not context_matches:
                    incremental_semantic_session_reset(session)
                else:
                    prior: mutable IncrementalSemanticSnapshot = ifc_clone_session_snapshot(session.snapshot)
                    if ifc_session_source_matches(session, source, source_length):
                        current: mutable IncrementalSemanticSnapshot = prior
                        if ifc_equal_view(current.bytes, current.source_path_start, current.source_path_length, source_path) and incremental_reanchor_exact_snapshot(file, tokens, source, source_length, &current):
                            return IncrementalSessionCollectionResult{snapshot: current, prior_valid: true, exact_hit: true, body_facts_reused: false, function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false}
                    else:
                        if session.query_graph_enabled:
                            if session.query_graph_poisoned:
                                ifq_clear_session_graph(session)
                            if not incremental_semantic_query_begin_request(session):
                                ifq_clear_session_graph(session)
                                incremental_semantic_query_begin_request(session)
                        request_metrics: mutable IncrementalFunctionFactsRequestMetrics = IncrementalFunctionFactsRequestMetrics{function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false, validated_body_query_generation: 0, validated_body_query_hits: []}
                        current: mutable IncrementalSemanticSnapshot = ifc_collect_function_facts(file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, identity_key, prior, true, true, &request_metrics, session)
                        reused: bool = current.bodies_matched > 0 and current.bodies_visited < current.functions.count
                        stored: bool = ifc_session_store(session, source, source_length, identity_key, options_key, generated_input, semantic_fingerprint, current)
                        if not stored:
                            incremental_semantic_session_reset(session)
                            ifc_self_assignment_forget(&current)
                        else:
                            ifc_publish_query_graph(session, current, identity_key, source_path, &request_metrics)
                        return IncrementalSessionCollectionResult{snapshot: current, prior_valid: true, exact_hit: false, body_facts_reused: reused, function_body_facts_restored: request_metrics.function_body_facts_restored, body_query_publish_skips: request_metrics.body_query_publish_skips, prior_snapshot_fact_fallbacks: request_metrics.prior_snapshot_fact_fallbacks, cold_body_scans: request_metrics.cold_body_scans, source_input_admitted: request_metrics.source_input_admitted}
                    incremental_semantic_session_reset(session)
                request_metrics: mutable IncrementalFunctionFactsRequestMetrics = IncrementalFunctionFactsRequestMetrics{function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false, validated_body_query_generation: 0, validated_body_query_hits: []}
                cold: mutable IncrementalSemanticSnapshot = ifc_collect_function_facts(file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, identity_key, empty.snapshot, false, false, &request_metrics, session)
                stored: bool = ifc_session_store(session, source, source_length, identity_key, options_key, generated_input, semantic_fingerprint, cold)
                if not stored:
                    incremental_semantic_session_reset(session)
                    ifc_self_assignment_forget(&cold)
                else:
                    ifc_publish_query_graph(session, cold, identity_key, source_path, &request_metrics)
                return IncrementalSessionCollectionResult{snapshot: cold, prior_valid: false, exact_hit: false, body_facts_reused: false, function_body_facts_restored: request_metrics.function_body_facts_restored, body_query_publish_skips: request_metrics.body_query_publish_skips, prior_snapshot_fact_fallbacks: request_metrics.prior_snapshot_fact_fallbacks, cold_body_scans: request_metrics.cold_body_scans, source_input_admitted: request_metrics.source_input_admitted}
