                return true

        def ifq_query_mark_stale[@session, @session_borrow](session: mutable IncrementalSemanticSession[session]& @session_borrow, query_id: IncrementalSemanticQueryId) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ifq_mark_reverse_closure(session, query_id, IncrementalSemanticQueryStatus.Dirty)

        def ifq_query_mark_potentially_stale[@session, @session_borrow](session: mutable IncrementalSemanticSession[session]& @session_borrow, query_id: IncrementalSemanticQueryId) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ifq_mark_reverse_closure(session, query_id, IncrementalSemanticQueryStatus.PotentiallyDirty)

        def ifq_query_evaluate[@session, @session_borrow, @input_region, @dependency_region](session: mutable IncrementalSemanticSession[session]& @session_borrow, handle: IncrementalSemanticQueryHandle, input: darray[u8]& @input_region, dependencies: darray[IncrementalSemanticQueryHandle]& @dependency_region) -> IncrementalSemanticQueryEvaluation:
