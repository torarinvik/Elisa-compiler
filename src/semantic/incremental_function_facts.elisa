                    session.query_nodes[query_id.value.usize()].incoming_edge_count <- node.incoming_edge_count - 1
                if node.incoming_chain_generation == 18446744073709551615:
                    session.query_nodes[query_id.value.usize()].incoming_chain_generation <- 1
                    session.query_nodes[query_id.value.usize()].incoming_chain_validated_generation <- 1
                else:
                    next_generation: u64 = node.incoming_chain_generation + 1
                    session.query_nodes[query_id.value.usize()].incoming_chain_generation <- next_generation
                    session.query_nodes[query_id.value.usize()].incoming_chain_validated_generation <- next_generation
                return true

        def ifq_query_walk_path[@session, @session_borrow](session: mutable IncrementalSemanticSession[session]& @session_borrow, start: IncrementalSemanticQueryId, target: IncrementalSemanticQueryId) -> IncrementalSemanticQueryWalkResult:
            can Memory.Allocate, Abort.Panic:
                result: mutable IncrementalSemanticQueryWalkResult = IncrementalSemanticQueryWalkResult{valid: true, budget_ok: true, reaches_target: false}
                return IncrementalSemanticQueryWalkResult{valid: false, budget_ok: true, reaches_target: false} if not ifq_query_id_is_valid(session, start) or not ifq_query_id_is_valid(session, target)
                return IncrementalSemanticQueryWalkResult{valid: true, budget_ok: true, reaches_target: true} if start.value == target.value
