# Portable, in-memory direct semantic facts for a translation-unit function body.
# Unsupported syntax remains on the cold checker path. Reusable records contain only owned
# byte spans, stable source names, direct facts, and body-relative token anchors.
extend Semantic:
    public:
        const INCREMENTAL_FUNCTION_FACTS_SCHEMA: u32 = 3
        # Bump whenever a semantic change can alter the meaning of facts consumed by
        # checker replay. This is deliberately separate from the wire schema: a cache
        # can decode correctly yet describe different checker semantics.
        const INCREMENTAL_SEMANTIC_ENGINE_VERSION: u64 = 3
        const INCREMENTAL_FACT_HASH_OFFSET: u64 = 14695981039346656037
        const INCREMENTAL_NO_ANCHOR: u32 = 4294967295
        const INCREMENTAL_FACT_HASH_PRIME: u64 = 1099511628211
        const INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT: usize = 8

        const enum IncrementalFactKind of u8:
            DirectCall
            GlobalRead
            GlobalWrite
            CanGrant
            TrustedGrant
            PanicSite

        const enum IncrementalGrantKind of u8:
            Can
            Trusted

        const enum IncrementalRejectReason of u8:
            None
            MissingStablePath
            NonUniqueOrGenericFunction
            MissingBlockBody
            UnsupportedBodySyntax
            MissingSourceAnchor
            InvalidTokenSpan
            UnsupportedSignature

        # These IDs belong to one IncrementalSemanticSession. They are deliberately
        # distinct from DeclId/BindingId, which are rebuilt with each SymbolTable.
        const INCREMENTAL_SEMANTIC_QUERY_NONE: u32 = 4294967295

        const enum IncrementalSemanticQueryKind of u8:
            SourceInput
            FunctionBodyFacts
            FunctionSummary
            VisibleNameSet
            NameLookup
            TypeOf
            ConstantValue

        const enum IncrementalSemanticQueryStatus of u8:
            Dirty
            Green

        struct IncrementalSemanticQueryId:
            value: u32

        struct IncrementalSemanticDependencyEdgeId:
            value: u32

        struct IncrementalSemanticQueryNode:
            # Keep status and adjacency links together at the front: invalidation walks
            # this state before it needs the colder key spans or fingerprints. Grouping
            # fields by alignment also avoids padding between every 32-bit handle and
            # 64-bit value in the dense node array.
            kind: IncrementalSemanticQueryKind
            status: IncrementalSemanticQueryStatus
            # Collision chain in query_key_heads. Key bytes are owned by the session.
            next_same_hash: IncrementalSemanticQueryId
            # Outgoing edges are this query's dependencies; incoming edges are its dependers.
            first_dependency: IncrementalSemanticDependencyEdgeId
            first_depender: IncrementalSemanticDependencyEdgeId
            key_hash: u64
            key_start: usize
            key_length: usize
            input_fingerprint: u64
            result_fingerprint: u64

        struct IncrementalSemanticDependencyEdge:
            # A NONE endpoint marks a reusable free-list slot.
            depender: IncrementalSemanticQueryId
            dependee: IncrementalSemanticQueryId
            previous_dependency: IncrementalSemanticDependencyEdgeId
            next_dependency: IncrementalSemanticDependencyEdgeId
            previous_depender: IncrementalSemanticDependencyEdgeId
            next_depender: IncrementalSemanticDependencyEdgeId

        # These spans address the snapshot-owned byte pool, not source buffers or intern tables.
        struct IncrementalFunctionFactRecord:
            key_start: usize
            key_length: usize
            body_start: usize
            body_length: usize
            body_hash: u64
            direct_fact_start: mutable usize
            direct_fact_count: mutable usize
            cacheable: mutable bool
            matched_previous: mutable bool
            reject_reason: mutable IncrementalRejectReason

        # Subject is a stable path/name key for calls and globals, or an effect name for panic.
        # The anchor is a token ordinal relative to the owning function body.
        # Invocation-local source positions, keyed by the function-record owner slot. These
        # are rebuilt on every collection and are never part of the portable persisted facts.
        struct IncrementalFunctionSourceAnchor:
            definition_offset: u32
            body_token_start: usize
            body_token_end: usize

        struct IncrementalDirectFact:
            owner: usize
            kind: IncrementalFactKind
            subject_start: usize
            subject_length: usize
            anchor_token: u32
            active_grant_start: usize
            active_grant_count: usize

        struct IncrementalActiveGrant:
            kind: IncrementalGrantKind
            name_start: usize
            name_length: usize

        # Separate syntactic-linter facts and coverage. `complete` says the canonical
        # self-assignment traversal finished and every emitted finding has two usable
        # body-relative token anchors; it does not imply direct-effect cacheability.
        # `reused_previous` is collection accounting only: fresh scans and reused facts
        # are both rebound to current-source anchors before replay.
        struct IncrementalSelfAssignmentFactRange:
            start: usize
            count: usize
            complete: bool
            reused_previous: bool

        struct IncrementalSelfAssignmentFact:
            target_anchor_token: u32
            statement_anchor_token: u32

        # Invocation-local rebindings. These are intentionally omitted from the snapshot
        # codec and are rebuilt from current tokens after a session snapshot is cloned.
        struct IncrementalSelfAssignmentAnchor:
            name: sview
            target_position: Ast::Pos
            statement_line: u32

        # Declaration-surface v1 is an exact token stream with supported function bodies
        # removed while every function header remains. Any unsupported body stays in the
        # surface and conservatively invalidates all records when edited.
        struct IncrementalSemanticSnapshot:
            schema_version: u32
            semantic_fingerprint: u64
            # Fast prefilter; collisions never authorize reuse.
            options_fingerprint: u64
            # Exact versioned semantic-options identity.
            options_key: mutable darray[u8]
            bytes: mutable darray[u8]
            source_path_start: mutable usize
            source_path_length: mutable usize
            declaration_surface_start: mutable usize
            declaration_surface_length: mutable usize
            declaration_surface_hash: mutable u64
            functions: mutable darray[IncrementalFunctionFactRecord]
            current_anchors: mutable darray[IncrementalFunctionSourceAnchor]
            direct_facts: mutable darray[IncrementalDirectFact]
            active_grants: mutable darray[IncrementalActiveGrant]
            self_assignment_ranges: mutable darray[IncrementalSelfAssignmentFactRange]
            self_assignment_facts: mutable darray[IncrementalSelfAssignmentFact]
            current_self_assignment_anchors: mutable darray[IncrementalSelfAssignmentAnchor]
            bodies_visited: mutable u32
            bodies_matched: mutable u32
            bodies_rejected: mutable u32
            self_assignment_bodies_scanned: mutable u32
            self_assignment_bodies_reused: mutable u32
            surface_compatible: mutable bool

        # Callers retain this object, but only Semantic can access or replace its
        # previous facts. No public API accepts a raw snapshot as a trusted prior.
        struct IncrementalSemanticSession:
            private:
                enabled: bool
                valid: mutable bool
                analyzed_source: mutable darray[u8]
                identity_key: mutable darray[u8]
                options_key: mutable darray[u8]
                generated_input: mutable bool
                semantic_fingerprint: mutable u64
                snapshot: mutable IncrementalSemanticSnapshot
                # Query keys stay owned for the lifetime of this session. Edges refer only
                # to compact IDs, never to keys or current SymbolTable rows.
                query_key_bytes: mutable darray[u8]
                query_key_heads: mutable dict[u64, IncrementalSemanticQueryId]
                query_nodes: mutable darray[IncrementalSemanticQueryNode]
                query_edges: mutable darray[IncrementalSemanticDependencyEdge]
                free_query_edges: mutable darray[IncrementalSemanticDependencyEdgeId]

        struct IncrementalSessionCollectionResult:
            snapshot: IncrementalSemanticSnapshot
            prior_valid: bool
            exact_hit: bool
            body_facts_reused: bool

        def incremental_empty_snapshot() -> IncrementalSemanticSnapshot:
            can Memory.Allocate:
                return IncrementalSemanticSnapshot{schema_version: 0, semantic_fingerprint: 0, options_fingerprint: 0, options_key: [], bytes: [], source_path_start: 0, source_path_length: 0, declaration_surface_start: 0, declaration_surface_length: 0, declaration_surface_hash: 0, functions: [], current_anchors: [], direct_facts: [], active_grants: [], self_assignment_ranges: [], self_assignment_facts: [], current_self_assignment_anchors: [], bodies_visited: 0, bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_scanned: 0, self_assignment_bodies_reused: 0, surface_compatible: false}

        private struct IncrementalFactCandidate:
            name: sview
            parameters: darray[Ast::ParamDecl]
            return_type: Ast::Expr?
            body: darray[Ast::Stmt]
            definition_offset: u32
            definition_token: usize
            generic_header: bool
            span_ordered: bool
            body_token_start: usize
            body_token_end: usize
            skip_start: usize
            skip_end: usize
            owner: usize
            header_supported: mutable bool
            prior_record: mutable usize
            prior_record_cacheable: mutable bool
            prior_body_matches: mutable bool
            scanned: mutable bool

        private struct IncrementalFactTokenSpan:
            found: bool
            body_start: usize
            body_end: usize
            skip_start: usize
            skip_end: usize
            definition_token: usize

        private struct IncrementalFactWalkGrant:
            kind: IncrementalGrantKind
            name: sview

    private:
        def ifc_read_u32(bytes: darray[u8]&, start: usize) -> u32:
            can Abort.Panic:
                value: mutable u32 = 0
                for shift in 0..<4 |value|:
                    value <- value | (bytes[start + shift].u32() << (shift * 8))
                return value

        def ifc_append_u32_bytes(bytes: mutable darray[u8]&, value: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                encoded: u8[4]
                encoded[0] <- (value & 255).u8()
                encoded[1] <- ((value >> 8) & 255).u8()
                encoded[2] <- ((value >> 16) & 255).u8()
                encoded[3] <- ((value >> 24) & 255).u8()
                if Lexer::make_source_view(&encoded[0], 4, 0, 4) is view:
                    bytes.extend(view)

        def ifc_append_u32(snapshot: mutable IncrementalSemanticSnapshot&, value: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                ifc_append_u32_bytes(snapshot.bytes, value)

        def ifc_append_view(snapshot: mutable IncrementalSemanticSnapshot&, value: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                snapshot.bytes.extend(value)

        # The returned view is consumed immediately by darray.extend, which copies its bytes.
        def ifc_byte_span(source: darray[u8]&, start: usize, length: usize) -> sview?:
            can Abort.Panic:
                assert start <= source.count
                assert length <= source.count - start
                return null if length == 0
                return Lexer::make_source_view(&source[0], source.count, start, start + length)

        def ifc_append_name(snapshot: mutable IncrementalSemanticSnapshot&, path: sview, name: sview) -> (start: usize, length: usize):
            can Memory.Allocate, Abort.Panic:
                start: usize = snapshot.bytes.count
                ifc_append_u32(snapshot, path.len.u32())
                ifc_append_view(snapshot, path)
                ifc_append_u32(snapshot, name.len.u32())
                ifc_append_view(snapshot, name)
                return (start, snapshot.bytes.count - start)

        def ifc_append_token_bytes(bytes: mutable darray[u8]&, source: u8&, source_length: usize, token: Lexer::Token) -> bool:
            can Memory.Allocate, Abort.Panic:
                token_start: usize = token.start.usize()
                text_length: usize = token.length.usize() + token.suffix_length.usize()
                return false if token_start > source_length or text_length > source_length - token_start
                ifc_append_u32_bytes(bytes, token.kind.u32())
                ifc_append_u32_bytes(bytes, text_length.u32())
                if text_length != 0:
                    if Lexer::make_source_view(source, source_length, token_start, token_start + text_length) is text:
                        bytes.extend(text)
                    else:
                        return false
                return true

        def ifc_append_token(snapshot: mutable IncrementalSemanticSnapshot&, source: u8&, source_length: usize, token: Lexer::Token) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ifc_append_token_bytes(snapshot.bytes, source, source_length, token)

        def ifc_append_tokens(snapshot: mutable IncrementalSemanticSnapshot&, source: u8&, source_length: usize, tokens: darray[Lexer::Token]&, start: usize, end: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if start > end or end > tokens.count
                for index in start..<end |snapshot|:
                    return false if not ifc_append_token(snapshot, source, source_length, tokens[index])
                return true

        def ifc_hash(bytes: darray[u8]&, start: usize, length: usize) -> u64:
            can Abort.Panic:
                hash: mutable u64 = INCREMENTAL_FACT_HASH_OFFSET
                for index in start..<start + length |hash|:
                    hash <- (hash ^ bytes[index].u64()) * INCREMENTAL_FACT_HASH_PRIME
                return hash

        def ifc_equal(left: darray[u8]&, left_start: usize, left_length: usize, right: darray[u8]&, right_start: usize, right_length: usize) -> bool:
            can Abort.Panic:
                return false if:
                    left_length != right_length
                    left_start > left.count or left_length > left.count - left_start
                    right_start > right.count or right_length > right.count - right_start
                for offset in 0..<left_length:
                    return false if left[left_start + offset] != right[right_start + offset]
                return true

        def ifc_token_span(tokens: darray[Lexer::Token]&, definition: usize) -> IncrementalFactTokenSpan:
            can Abort.Panic:
                if definition >= tokens.count or tokens[definition].kind != TokenKind.Def:
                    return IncrementalFactTokenSpan{found: false, body_start: 0, body_end: 0, skip_start: 0, skip_end: 0, definition_token: tokens.count}
                indent: mutable usize = tokens.count
                scan: mutable usize = definition + 1
                while scan < tokens.count:
                    kind: TokenKind = tokens[scan].kind
                    if kind == TokenKind.Indent:
                        indent <- scan
                        break
                    if kind == TokenKind.Def or kind == TokenKind.Dedent or kind == TokenKind.Eof:
                        break
                    scan <- scan + 1
                if indent >= tokens.count:
                    return IncrementalFactTokenSpan{found: false, body_start: 0, body_end: 0, skip_start: 0, skip_end: 0, definition_token: definition}
                depth: mutable u32 = 1
                scan <- indent + 1
                while scan < tokens.count:
                    if tokens[scan].kind == TokenKind.Indent:
                        depth <- depth + 1
                    elif tokens[scan].kind == TokenKind.Dedent:
                        depth <- depth - 1
                        if depth == 0:
                            return IncrementalFactTokenSpan{found: true, body_start: indent + 1, body_end: scan, skip_start: indent, skip_end: scan + 1, definition_token: definition}
                    scan <- scan + 1
                return IncrementalFactTokenSpan{found: false, body_start: 0, body_end: 0, skip_start: 0, skip_end: 0, definition_token: definition}

        def ifc_generic_header(tokens: darray[Lexer::Token]&, definition: usize) -> bool:
            can Abort.Panic:
                name_token: mutable usize = definition + 1
                while name_token < tokens.count and tokens[name_token].kind != TokenKind.Ident:
                    name_token <- name_token + 1
                return false if name_token + 1 >= tokens.count
                return tokens[name_token + 1].kind == TokenKind.LBracket

        def ifc_contains(names: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                for item in names:
                    return true if item == name
                return false

        # Invocation-local index: hashes narrow lookup, exact name bytes decide equality.
        private struct IncrementalCandidateNameIndex:
            heads: mutable darray[usize] = []
            next: mutable darray[usize] = []

        def ifc_candidate_name_hash(name: sview) -> u64:
            can Abort.Panic:
                hash: u64 = for offset in 0..<name.len |hash: u64 = INCREMENTAL_FACT_HASH_OFFSET| -> hash:
                    hash <- (hash ^ name[offset].u64()) * INCREMENTAL_FACT_HASH_PRIME
                return hash

        # Invocation-local membership index for the translation unit's global names.
        # Hashes choose a bucket only; exact sview equality remains authoritative.
        private struct IncrementalStringNameIndex:
            heads: mutable darray[usize] = []
            next: mutable darray[usize] = []

        def ifc_string_name_index(names: darray[sview]&, index: mutable IncrementalStringNameIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                index.heads.resize(names.count)
                index.next.resize(names.count)
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- names.count
                for reverse_row in 0..<names.count |index|:
                    row: usize = names.count - 1 - reverse_row
                    bucket: usize = (ifc_candidate_name_hash(names[row]) % index.heads.count.u64()).usize()
                    index.next[row] <- index.heads[bucket]
                    index.heads[bucket] <- row

        def ifc_string_name_contains(names: darray[sview]&, name: sview, index: IncrementalStringNameIndex&) -> bool:
            can Abort.Panic:
                return ifc_contains(names, name) if names.count < INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT or index.heads.count != names.count or index.next.count != names.count
                bucket: usize = (ifc_candidate_name_hash(name) % index.heads.count.u64()).usize()
                row: mutable usize = index.heads[bucket]
                while row < names.count |row|:
                    return true if names[row] == name
                    row <- index.next[row]
                return false

        def ifc_candidate_name_index(candidates: darray[IncrementalFactCandidate]&, index: mutable IncrementalCandidateNameIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                index.heads.resize(candidates.count)
                index.next.resize(candidates.count)
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- candidates.count
                for reverse_row in 0..<candidates.count |index|:
                    row: usize = candidates.count - 1 - reverse_row
                    bucket: usize = (ifc_candidate_name_hash(candidates[row].name) % index.heads.count.u64()).usize()
                    index.next[row] <- index.heads[bucket]
                    index.heads[bucket] <- row

        def ifc_name_unique(candidates: darray[IncrementalFactCandidate]&, name: sview, index: IncrementalCandidateNameIndex&) -> bool:
            can Abort.Panic:
                return false if index.heads.count == 0
                bucket: usize = (ifc_candidate_name_hash(name) % index.heads.count.u64()).usize()
                count: mutable usize = 0
                row: mutable usize = index.heads[bucket]
                while row < candidates.count |row, count|:
                    count <- count + 1 if candidates[row].name == name
                    return false if count > 1
                    row <- index.next[row]
                return count == 1

        # Hash buckets narrow the search; exact owned-key bytes remain authoritative.
        # Reverse insertion preserves ascending row order and the old first-match rule.
        private struct IncrementalPriorKeyIndex:
            heads: mutable darray[usize] = []
            next: mutable darray[usize] = []

        def ifc_prior_key_index(previous: IncrementalSemanticSnapshot&, index: mutable IncrementalPriorKeyIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                index.next.resize(previous.functions.count)
                index.heads.resize(previous.functions.count)
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- previous.functions.count
                for reverse_row in 0..<previous.functions.count |index|:
                    row: usize = previous.functions.count - 1 - reverse_row
                    prior: IncrementalFunctionFactRecord = previous.functions[row]
                    index.next[row] <- previous.functions.count
                    continue if prior.key_start > previous.bytes.count or prior.key_length > previous.bytes.count - prior.key_start
                    hash: u64 = ifc_hash(previous.bytes, prior.key_start, prior.key_length)
                    bucket: usize = (hash % index.heads.count.u64()).usize()
                    index.next[row] <- index.heads[bucket]
                    index.heads[bucket] <- row

        def ifc_prior_index(previous: IncrementalSemanticSnapshot&, bytes: darray[u8]&, key_start: usize, key_length: usize, index: IncrementalPriorKeyIndex&) -> usize:
            can Abort.Panic:
                return previous.functions.count if key_start > bytes.count or key_length > bytes.count - key_start
                hash: u64 = ifc_hash(bytes, key_start, key_length)
                return previous.functions.count if index.heads.count == 0
                bucket: usize = (hash % index.heads.count.u64()).usize()
                row: mutable usize = index.heads[bucket]
                while row < previous.functions.count |row|:
                    prior: IncrementalFunctionFactRecord = previous.functions[row]
                    return row if ifc_equal(bytes, key_start, key_length, previous.bytes, prior.key_start, prior.key_length)
                    row <- index.next[row]
                return previous.functions.count

        def ifc_safe_return_type(expression: Ast::Expr, aliases: darray[sview]&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return false if ifc_contains(aliases, name)
                        return when name:
                            "void" | "bool" | "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "usize" | "isize" | "int" | "float" | "f32" | "f64" | "char" | "str" | "cstr" -> true
                            _ -> false
                    _:
                        return false

        def ifc_signature_supported(parameters: darray[Ast::ParamDecl], return_type: Ast::Expr?, aliases: darray[sview]&) -> bool:
            can Abort.Panic:
                if return_type is declared_return:
                    return false if not ifc_safe_return_type(declared_return, aliases)
                else:
                    return false
                for parameter in parameters:
                    return false if parameter.has_default
                return true

        def ifc_call_target(candidates: darray[IncrementalFactCandidate]&, name: sview, candidate_names: IncrementalCandidateNameIndex&) -> bool:
            can Abort.Panic:
                return false if candidate_names.heads.count == 0
                bucket: usize = (ifc_candidate_name_hash(name) % candidate_names.heads.count.u64()).usize()
                matches: mutable usize = 0
                row: mutable usize = candidate_names.heads[bucket]
                while row < candidates.count |row, matches|:
                    candidate: IncrementalFactCandidate = candidates[row]
                    row <- candidate_names.next[row]
                    continue if candidate.name != name
                    matches <- matches + 1
                    return false if matches > 1 or not candidate.header_supported or candidate.parameters.count != 0
                return matches == 1

        def ifc_anchor(tokens: darray[Lexer::Token]&, body_start: usize, body_end: usize, offset: u32) -> u32:
            can Abort.Panic:
                return INCREMENTAL_NO_ANCHOR if:
                    offset == 0
                    body_start >= body_end or body_end > tokens.count
                # Token spans are ordered and non-overlapping. Find the first token whose
                # full spelling (including a numeric suffix) ends after OFFSET. This is
                # also the first token after OFFSET when it lies in inter-token whitespace.
                low: mutable usize = body_start
                high: mutable usize = body_end
                while low < high |low, high, tokens, offset|:
                    middle: usize = low + (high - low) / 2
                    token: Lexer::Token = tokens[middle]
                    end: u32 = token.start + token.length + token.suffix_length.u32()
                    if end <= offset:
                        low <- middle + 1
                    else:
                        high <- middle
                if low < body_end:
                    return (low - body_start).u32()
                return INCREMENTAL_NO_ANCHOR

        def ifc_exact_token_anchor(tokens: darray[Lexer::Token]&, body_start: usize, body_end: usize, position: Ast::Pos) -> u32:
            can Abort.Panic:
                anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                return INCREMENTAL_NO_ANCHOR if anchor == INCREMENTAL_NO_ANCHOR
                token: Lexer::Token = tokens[body_start + anchor.usize()]
                return INCREMENTAL_NO_ANCHOR if:
                    token.start != position.offset
                    token.line != position.line or token.line != position.end_line
                    token.column != position.column
                    token.column + token.length != position.end_column
                    token.start + token.length != position.end_offset
                return anchor

        def ifc_rebind_self_assignment_anchor(tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, body_start: usize, body_end: usize, target_anchor: u32, statement_anchor: u32) -> (valid: bool, anchor: IncrementalSelfAssignmentAnchor):
            can Abort.Panic:
                invalid: IncrementalSelfAssignmentAnchor = IncrementalSelfAssignmentAnchor{name: "", target_position: Ast::pos_at_line(0), statement_line: 0}
                return (false, invalid) if:
                    body_start >= body_end or body_end > tokens.count
                    target_anchor == INCREMENTAL_NO_ANCHOR or statement_anchor == INCREMENTAL_NO_ANCHOR
                    target_anchor.usize() >= body_end - body_start or statement_anchor.usize() >= body_end - body_start
                target_token: Lexer::Token = tokens[body_start + target_anchor.usize()]
                statement_token: Lexer::Token = tokens[body_start + statement_anchor.usize()]
                return (false, invalid) if:
                    target_token.kind != TokenKind.Ident
                    target_token.suffix_length != 0
                    statement_token.start == 0
                    statement_token.line == 0
                position: Ast::Pos = Ast::Pos{line: target_token.line, column: target_token.column, offset: target_token.start, end_line: target_token.line, end_column: target_token.column + target_token.length, end_offset: target_token.start + target_token.length}
                anchor: IncrementalSelfAssignmentAnchor = IncrementalSelfAssignmentAnchor{name: Lexer::text_or_empty(target_token, source, source_length), target_position: position, statement_line: statement_token.line}
                return (true, anchor)

        # The semantic checker receives `semantic_loop_view(file)`, where a statement
        # Expr.Block with Invalid yield is rewritten into Stmt.Block. Keep these bodies
        # cold because the raw fact traversal intentionally leaves Stmt.Expr opaque.
        def ifc_has_self_assignment_loop_view_block(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, _):
                            match expression:
                                Expr.Block(_, value, _, _):
                                    return true if value is Ast::Expr.Invalid
                                _:
                                    pass
                        Stmt.If(_, then_body, else_body, _):
                            return true if ifc_has_self_assignment_loop_view_block(then_body) or ifc_has_self_assignment_loop_view_block(else_body)
                        Stmt.While(_, body, _) | Stmt.For(_, _, _, body, _) | Stmt.Block(_, _, _, body, _):
                            return true if ifc_has_self_assignment_loop_view_block(body)
                        Stmt.Match(_, arms, _):
                            for arm in arms:
                                return true if ifc_has_self_assignment_loop_view_block(arm.body)
                        _:
                            pass
                return false

        def ifc_self_assignment_fact_capacity(snapshot: IncrementalSemanticSnapshot&) -> usize:
            can Abort.Panic:
                return 0 if snapshot.self_assignment_facts.count >= 1000000 or snapshot.self_assignment_ranges.count > 1000000 or snapshot.bytes.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT
                fact_count: u64 = snapshot.self_assignment_facts.count.u64()
                range_count: u64 = snapshot.self_assignment_ranges.count.u64()
                # Facts are two u32 token ordinals. Budget 64 bytes per finding for its
                # invocation-local anchor and 32 per function range, with alignment headroom.
                snapshot_baseline: u64 = 146 + snapshot.bytes.count.u64() + snapshot.options_key.count.u64() + snapshot.functions.count.u64() * 72 + snapshot.direct_facts.count.u64() * 56 + snapshot.active_grants.count.u64() * 24
                total: u64 = snapshot_baseline + fact_count * 64 + range_count * 32
                return 0 if total >= INCREMENTAL_SNAPSHOT_CODEC_LIMIT.u64()
                by_bytes: usize = ((INCREMENTAL_SNAPSHOT_CODEC_LIMIT.u64() - total) / 64).usize()
                by_count: usize = 1000000 - snapshot.self_assignment_facts.count
                return by_bytes if by_bytes < by_count else by_count

        def ifc_self_assignment_storage_within_limit(snapshot: IncrementalSemanticSnapshot&, additional_facts: usize) -> bool:
            can Abort.Panic:
                return additional_facts <= ifc_self_assignment_fact_capacity(snapshot)

        def ifc_self_assignment_forget(snapshot: mutable IncrementalSemanticSnapshot&) -> void:
            can Memory.Allocate:
                snapshot.self_assignment_facts.truncate(0)
                snapshot.current_self_assignment_anchors.truncate(0)
                for index in 0..<snapshot.self_assignment_ranges.count |snapshot|:
                    snapshot.self_assignment_ranges[index] <- IncrementalSelfAssignmentFactRange{start: 0, count: 0, complete: false, reused_previous: false}
                snapshot.self_assignment_bodies_reused <- 0

        def ifc_scan_self_assignment_candidate(index: usize, candidates: darray[IncrementalFactCandidate]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, snapshot: mutable IncrementalSemanticSnapshot&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if index >= candidates.count
                candidate: IncrementalFactCandidate = candidates[index]
                start: usize = snapshot.self_assignment_facts.count
                if not candidate.header_supported or candidate.body_token_start >= candidate.body_token_end or candidate.body_token_end > tokens.count or ifc_has_self_assignment_loop_view_block(candidate.body):
                    snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: 0, complete: false, reused_previous: false}
                    return
                findings: mutable darray[SelfAssignmentFinding] = []
                collection_complete: mutable bool = true
                snapshot.self_assignment_bodies_scanned <- snapshot.self_assignment_bodies_scanned + 1
                collect_self_assignment_findings_bounded(candidate.body, ifc_self_assignment_fact_capacity(snapshot), &findings, &collection_complete)
                if not collection_complete:
                    snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: 0, complete: false, reused_previous: false}
                    return
                if not ifc_self_assignment_storage_within_limit(snapshot, findings.count):
                    snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: 0, complete: false, reused_previous: false}
                    return
                staged_facts: mutable darray[IncrementalSelfAssignmentFact] = []
                staged_anchors: mutable darray[IncrementalSelfAssignmentAnchor] = []
                staged_facts.reserve(findings.count)
                staged_anchors.reserve(findings.count)
                # Preflight every finding before extending snapshot storage. A single
                # synthetic or ambiguous position keeps the whole function cold.
                for finding in findings:
                    target_anchor: u32 = ifc_exact_token_anchor(tokens, candidate.body_token_start, candidate.body_token_end, finding.target_position)
                    statement_anchor: u32 = ifc_exact_token_anchor(tokens, candidate.body_token_start, candidate.body_token_end, finding.statement_position)
                    return if target_anchor == INCREMENTAL_NO_ANCHOR or statement_anchor == INCREMENTAL_NO_ANCHOR
                    rebound: (valid: bool, anchor: IncrementalSelfAssignmentAnchor) = ifc_rebind_self_assignment_anchor(tokens, source, source_length, candidate.body_token_start, candidate.body_token_end, target_anchor, statement_anchor)
                    return if not rebound.valid or rebound.anchor.name != finding.name
                    staged_facts.push(IncrementalSelfAssignmentFact{target_anchor_token: target_anchor, statement_anchor_token: statement_anchor})
                    staged_anchors.push(rebound.anchor)
                for fact in staged_facts |snapshot|:
                    snapshot.self_assignment_facts.push(fact)
                for anchor in staged_anchors |snapshot|:
                    snapshot.current_self_assignment_anchors.push(anchor)
                snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: findings.count, complete: true, reused_previous: false}

        # Reuse is authorized only by the private session collector's exact function key
        # and exact token-body comparison. Hashes are never consulted here.
        def ifc_reuse_previous_self_assignment_candidate(index: usize, candidates: darray[IncrementalFactCandidate]&, previous: IncrementalSemanticSnapshot&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if index >= candidates.count
                candidate: IncrementalFactCandidate = candidates[index]
                return false if not candidate.header_supported or not candidate.prior_body_matches or candidate.prior_record >= previous.self_assignment_ranges.count
                old_range: IncrementalSelfAssignmentFactRange = previous.self_assignment_ranges[candidate.prior_record]
                return false if not old_range.complete or old_range.start > previous.self_assignment_facts.count or old_range.count > previous.self_assignment_facts.count - old_range.start
                return false if not ifc_self_assignment_storage_within_limit(snapshot, old_range.count)
                rebound_anchors: mutable darray[IncrementalSelfAssignmentAnchor] = []
                rebound_anchors.reserve(old_range.count)
                for relative in 0..<old_range.count |rebound_anchors|:
                    old_fact: IncrementalSelfAssignmentFact = previous.self_assignment_facts[old_range.start + relative]
                    rebound: (valid: bool, anchor: IncrementalSelfAssignmentAnchor) = ifc_rebind_self_assignment_anchor(tokens, source, source_length, candidate.body_token_start, candidate.body_token_end, old_fact.target_anchor_token, old_fact.statement_anchor_token)
                    return false if not rebound.valid
                    rebound_anchors.push(rebound.anchor)
                start: usize = snapshot.self_assignment_facts.count
                for relative in 0..<old_range.count |snapshot|:
                    old_fact: IncrementalSelfAssignmentFact = previous.self_assignment_facts[old_range.start + relative]
                    snapshot.self_assignment_facts.push(IncrementalSelfAssignmentFact{target_anchor_token: old_fact.target_anchor_token, statement_anchor_token: old_fact.statement_anchor_token})
                    snapshot.current_self_assignment_anchors.push(rebound_anchors[relative])
                snapshot.self_assignment_ranges[candidate.owner] <- IncrementalSelfAssignmentFactRange{start: start, count: old_range.count, complete: true, reused_previous: true}
                snapshot.self_assignment_bodies_reused <- snapshot.self_assignment_bodies_reused + 1
                return true

        def ifc_has_inline_grant(annotations: darray[Ast::EnumAnnotation]&, tokens: darray[Lexer::Token]&, body_start: usize, body_end: usize) -> bool:
            can Abort.Panic:
                return false if body_start >= body_end or body_end > tokens.count
                first_offset: u32 = tokens[body_start].start
                last_token: Lexer::Token = tokens[body_end - 1]
                last_offset: u32 = last_token.start + last_token.length + last_token.suffix_length.u32()
                for annotation in annotations:
                    continue if annotation.owner != "__inline_expression_grant"
                    return true if annotation.pos.offset >= first_offset and annotation.pos.offset < last_offset
                return false

        def ifc_push_fact(snapshot: mutable IncrementalSemanticSnapshot&, owner: usize, kind: IncrementalFactKind, subject: sview, path: sview, anchor: u32, active: darray[IncrementalFactWalkGrant]&) -> void:
            can Memory.Allocate, Abort.Panic:
                subject_span: mutable (start: usize, length: usize) = (snapshot.bytes.count, subject.len)
                if kind == IncrementalFactKind.DirectCall or kind == IncrementalFactKind.GlobalRead or kind == IncrementalFactKind.GlobalWrite:
                    subject_span <- ifc_append_name(snapshot, path, subject)
                else:
                    ifc_append_view(snapshot, subject)
                active_start: usize = snapshot.active_grants.count
                for grant in active:
                    name_start: usize = snapshot.bytes.count
                    ifc_append_view(snapshot, grant.name)
                    snapshot.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name.len})
                snapshot.direct_facts.push(IncrementalDirectFact{owner: owner, kind: kind, subject_start: subject_span.start, subject_length: subject_span.length, anchor_token: anchor, active_grant_start: active_start, active_grant_count: snapshot.active_grants.count - active_start})

        def ifc_walk_expr(expression: Ast::Expr, owner: usize, path: sview, body_start: usize, body_end: usize, tokens: darray[Lexer::Token]&, locals: darray[sview]&, all_globals: darray[sview]&, all_globals_index: IncrementalStringNameIndex&, mutable_globals: darray[sview]&, mutable_globals_index: IncrementalStringNameIndex&, candidates: darray[IncrementalFactCandidate]&, candidate_names: IncrementalCandidateNameIndex&, active: mutable darray[IncrementalFactWalkGrant]&, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        return true
                    Expr.Ident(name, position):
                        # Locals and parameters may be mutable aliases or callback
                        # values. v0 records only literal initializers and direct globals.
                        return false if ifc_contains(locals, name)
                        if ifc_string_name_contains(mutable_globals, name, mutable_globals_index):
                            anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                            if anchor != INCREMENTAL_NO_ANCHOR:
                                ifc_push_fact(snapshot, owner, IncrementalFactKind.GlobalRead, name, path, anchor, active)
                                return true
                            return false
                        # Readonly globals still produce inferred Global.Read rows in
                        # the authority checker. Until that fact has its own kind, fail
                        # closed instead of treating a name as a pure value.
                        return false
                    Expr.Paren(_, _):
                        # The authority walker has a recursive expression-depth limit.
                        # Until this collector tracks the same depth, parenthesized trees
                        # stay cold even when their leaves are otherwise supported.
                        return false
                    Expr.Call(callee, arguments, labels, position):
                        return false if arguments.count != 0 or labels.count != 0
                        if callee is Ast::Expr.Ident(name, _):
                            # `panic` is reserved by the lexer, so source cannot bind a local of that name.
                            # A local function value shadows the translation-unit declaration
                            # and builtins; never cache a call selected by name alone.
                            return false if ifc_contains(locals, name) or ifc_string_name_contains(all_globals, name, all_globals_index)
                            anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                            if anchor != INCREMENTAL_NO_ANCHOR:
                                if ifc_call_target(candidates, name, candidate_names):
                                    ifc_push_fact(snapshot, owner, IncrementalFactKind.DirectCall, name, path, anchor, active)
                                    return true
                                if name == "panic":
                                    ifc_push_fact(snapshot, owner, IncrementalFactKind.PanicSite, "Abort.Panic", path, anchor, active)
                                    return true
                        return false
                    _:
                        return false

        def ifc_walk_body(statements: darray[Ast::Stmt], owner: usize, path: sview, body_start: usize, body_end: usize, tokens: darray[Lexer::Token]&, locals: mutable darray[sview]&, all_globals: darray[sview]&, all_globals_index: IncrementalStringNameIndex&, mutable_globals: darray[sview]&, mutable_globals_index: IncrementalStringNameIndex&, candidates: darray[IncrementalFactCandidate]&, candidate_names: IncrementalCandidateNameIndex&, active: mutable darray[IncrementalFactWalkGrant]&, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |locals, active, snapshot|:
                    match statement:
                        Stmt.Expr(expression, _):
                            return false if not ifc_walk_expr(expression, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                        Stmt.Return(value, _):
                            if value is result:
                                return false if not ifc_walk_expr(result, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                        Stmt.VarDecl(name, type_expression, value, _):
                            return false if ifc_contains(locals, name)
                            # A typed/mutable place or an identifier initializer can
                            # make ga_write_place infer a Global.Write row. Keep v0 local
                            # declarations to untyped literal bindings only.
                            return false if:
                                not (type_expression is Expr.Absent or type_expression is Expr.Invalid)
                                not (value is Expr.IntLit or value is Expr.FloatLit or value is Expr.StringLit or value is Expr.CharLit or value is Expr.BoolLit)
                            locals.push(name)
                        Stmt.Assign(target, operator, value, _):
                            if operator == TokenKind.Assign:
                                # GA treats this spelling as a new local binding; only
                                # literal RHS values are cacheable because they cannot
                                # carry global reads, callback origins, or writable places.
                                if target is Ast::Expr.Ident(name, _):
                                    return false if:
                                        not (value is Expr.IntLit or value is Expr.FloatLit or value is Expr.StringLit or value is Expr.CharLit or value is Expr.BoolLit)
                                        not ifc_walk_expr(value, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                                    locals.push(name)
                                else:
                                    return false
                            else:
                                return false if:
                                    operator != TokenKind.LArrow
                                    not ifc_walk_expr(value, owner, path, body_start, body_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                                if target is Ast::Expr.Ident(name, position):
                                    # A local may be a reference parameter whose write
                                    # reaches a caller's mutable global. Keep local LArrow
                                    # assignments cold until parameter aliasing is modeled.
                                    if ifc_contains(locals, name):
                                        return false
                                    elif ifc_string_name_contains(mutable_globals, name, mutable_globals_index):
                                        anchor: u32 = ifc_anchor(tokens, body_start, body_end, position.offset)
                                        if anchor != INCREMENTAL_NO_ANCHOR:
                                            ifc_push_fact(snapshot, owner, IncrementalFactKind.GlobalWrite, name, path, anchor, active)
                                        else:
                                            return false
                                    else:
                                        return false
                                else:
                                    return false
                        Stmt.Block(_, _, _, _, _):
                            # Nested block depth has independent diagnostics in semantic
                            # walkers; do not skip those walkers until that budget is part
                            # of the current-source fact proof.
                            return false
                        _:
                            return false
                return true

        def ifc_scan_candidate(index: usize, candidates: mutable darray[IncrementalFactCandidate]&, candidate_names: IncrementalCandidateNameIndex&, path: sview, tokens: darray[Lexer::Token]&, all_globals: darray[sview]&, all_globals_index: IncrementalStringNameIndex&, mutable_globals: darray[sview]&, mutable_globals_index: IncrementalStringNameIndex&, snapshot: mutable IncrementalSemanticSnapshot&) -> void:
            can Memory.Allocate, Abort.Panic:
                candidate: IncrementalFactCandidate = candidates[index]
                owner: usize = candidate.owner
                fact_start: usize = snapshot.direct_facts.count
                locals: mutable darray[sview] = []
                active: mutable darray[IncrementalFactWalkGrant] = []
                grant_start: usize = snapshot.active_grants.count
                bytes_start: usize = snapshot.bytes.count
                for parameter in candidate.parameters |locals|:
                    locals.push(parameter.name)
                supported: mutable bool = candidate.header_supported and candidate.body_token_start < candidate.body_token_end
                if supported:
                    supported <- ifc_walk_body(candidate.body, owner, path, candidate.body_token_start, candidate.body_token_end, tokens, locals, all_globals, all_globals_index, mutable_globals, mutable_globals_index, candidates, candidate_names, active, snapshot)
                snapshot.bodies_visited <- snapshot.bodies_visited + 1
                if not supported:
                    snapshot.direct_facts.truncate(fact_start)
                    snapshot.active_grants.truncate(grant_start)
                    snapshot.bytes.truncate(bytes_start)
                snapshot.functions[owner].direct_fact_start <- fact_start
                snapshot.functions[owner].direct_fact_count <- snapshot.direct_facts.count - fact_start
                snapshot.functions[owner].cacheable <- supported
                snapshot.functions[owner].matched_previous <- false
                if candidate.header_supported:
                    snapshot.functions[owner].reject_reason <- IncrementalRejectReason.None if supported else IncrementalRejectReason.UnsupportedBodySyntax
                snapshot.bodies_rejected <- snapshot.bodies_rejected + 1 if not supported
                candidates[index].scanned <- true

        # Persist one canonical layout so records do not depend on the order in which
        # their owned key, body, and freshly scanned fact spans were appended.
        def ifc_canonical_layout(snapshot: IncrementalSemanticSnapshot) -> IncrementalSemanticSnapshot:
            can Memory.Allocate, Abort.Panic:
                ordered: mutable IncrementalSemanticSnapshot = snapshot
                ordered.bytes <- []
                ordered.functions <- []
                ordered.direct_facts <- []
                ordered.active_grants <- []
                ordered.self_assignment_ranges <- []
                ordered.self_assignment_facts <- []
                ordered.current_self_assignment_anchors <- []
                ordered.bytes.reserve(snapshot.bytes.count)
                ordered.functions.reserve(snapshot.functions.count)
                ordered.direct_facts.reserve(snapshot.direct_facts.count)
                ordered.active_grants.reserve(snapshot.active_grants.count)
                ordered.self_assignment_ranges.reserve(snapshot.functions.count)
                ordered.self_assignment_facts.reserve(snapshot.self_assignment_facts.count)
                ordered.current_self_assignment_anchors.reserve(snapshot.current_self_assignment_anchors.count)
                ordered.source_path_start <- ordered.bytes.count
                if ifc_byte_span(snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length) is source_path:
                    ordered.bytes.extend(source_path)
                for record in snapshot.functions |ordered|:
                    key_start: usize = ordered.bytes.count
                    if ifc_byte_span(snapshot.bytes, record.key_start, record.key_length) is key:
                        ordered.bytes.extend(key)
                    body_start: usize = ordered.bytes.count
                    if ifc_byte_span(snapshot.bytes, record.body_start, record.body_length) is body:
                        ordered.bytes.extend(body)
                    ordered.functions.push(IncrementalFunctionFactRecord{key_start: key_start, key_length: record.key_length, body_start: body_start, body_length: record.body_length, body_hash: record.body_hash, direct_fact_start: 0, direct_fact_count: 0, cacheable: record.cacheable, matched_previous: record.matched_previous, reject_reason: record.reject_reason})
                for owner in 0..<snapshot.functions.count |ordered|:
                    record: IncrementalFunctionFactRecord = snapshot.functions[owner]
                    fact_start: usize = ordered.direct_facts.count
                    for index in 0..<record.direct_fact_count |ordered|:
                        fact: IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + index]
                        subject_start: usize = ordered.bytes.count
                        if ifc_byte_span(snapshot.bytes, fact.subject_start, fact.subject_length) is subject:
                            ordered.bytes.extend(subject)
                        grant_start: usize = ordered.active_grants.count
                        for grant_index in 0..<fact.active_grant_count |ordered|:
                            grant: IncrementalActiveGrant = snapshot.active_grants[fact.active_grant_start + grant_index]
                            name_start: usize = ordered.bytes.count
                            if ifc_byte_span(snapshot.bytes, grant.name_start, grant.name_length) is name:
                                ordered.bytes.extend(name)
                            ordered.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name_length})
                        ordered.direct_facts.push(IncrementalDirectFact{owner: owner, kind: fact.kind, subject_start: subject_start, subject_length: fact.subject_length, anchor_token: fact.anchor_token, active_grant_start: grant_start, active_grant_count: fact.active_grant_count})
                    ordered.functions[owner].direct_fact_start <- fact_start
                    ordered.functions[owner].direct_fact_count <- record.direct_fact_count
                    self_start: usize = ordered.self_assignment_facts.count
                    self_complete: mutable bool = owner < snapshot.self_assignment_ranges.count
                    self_reused: mutable bool = false
                    if self_complete:
                        source_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[owner]
                        self_complete <- source_range.complete
                        self_reused <- source_range.reused_previous
                        self_complete <- false if source_range.start > snapshot.self_assignment_facts.count or source_range.count > snapshot.self_assignment_facts.count - source_range.start
                        if self_complete:
                            self_complete <- false if source_range.start > snapshot.current_self_assignment_anchors.count or source_range.count > snapshot.current_self_assignment_anchors.count - source_range.start
                        if self_complete:
                            for relative in 0..<source_range.count |ordered|:
                                source_fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[source_range.start + relative]
                                ordered.self_assignment_facts.push(IncrementalSelfAssignmentFact{target_anchor_token: source_fact.target_anchor_token, statement_anchor_token: source_fact.statement_anchor_token})
                                ordered.current_self_assignment_anchors.push(snapshot.current_self_assignment_anchors[source_range.start + relative])
                    self_count: usize = ordered.self_assignment_facts.count - self_start
                    ordered.self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: self_start, count: self_count, complete: self_complete, reused_previous: self_reused and self_complete})
                ordered.declaration_surface_start <- ordered.bytes.count
                if ifc_byte_span(snapshot.bytes, snapshot.declaration_surface_start, snapshot.declaration_surface_length) is declaration_surface:
                    ordered.bytes.extend(declaration_surface)
                return ordered

        def ifc_surface_equal(previous: IncrementalSemanticSnapshot&, current: IncrementalSemanticSnapshot) -> bool:
            can Abort.Panic:
                return false if:
                    previous.schema_version != current.schema_version
                    previous.semantic_fingerprint != current.semantic_fingerprint
                    previous.options_fingerprint != current.options_fingerprint
                # The 64-bit fingerprint can collide; reuse requires exact key equality.
                return false if:
                    not incremental_semantic_options_key_equal(previous.options_key, current.options_key)
                    not ifc_equal(previous.bytes, previous.source_path_start, previous.source_path_length, current.bytes, current.source_path_start, current.source_path_length)
                return ifc_equal(previous.bytes, previous.declaration_surface_start, previous.declaration_surface_length, current.bytes, current.declaration_surface_start, current.declaration_surface_length)

        def ifc_equal_view(bytes: darray[u8]&, start: usize, length: usize, value: sview) -> bool:
            can Abort.Panic:
                return false if length != value.len or start > bytes.count or length > bytes.count - start
                for offset in 0..<length:
                    return false if bytes[start + offset] != value[offset]
                return true

        def ifc_surface_matches_bytes(previous: IncrementalSemanticSnapshot&, schema_version: u32, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, source_path: sview, declaration_surface: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if:
                    previous.schema_version != schema_version
                    previous.semantic_fingerprint != semantic_fingerprint
                    previous.options_fingerprint != options_fingerprint
                    not incremental_semantic_options_key_equal(previous.options_key, options_key)
                    not ifc_equal_view(previous.bytes, previous.source_path_start, previous.source_path_length, source_path)
                    previous.declaration_surface_length != declaration_surface.count
                    previous.declaration_surface_start > previous.bytes.count
                    previous.declaration_surface_length > previous.bytes.count - previous.declaration_surface_start
                for offset in 0..<declaration_surface.count:
                    return false if previous.bytes[previous.declaration_surface_start + offset] != declaration_surface[offset]
                return true

        def ifc_append_declaration_surface(surface: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, candidates: darray[IncrementalFactCandidate]&, snapshot: IncrementalSemanticSnapshot&, use_previous_cacheability: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                token_index: mutable usize = 0
                candidate_index: mutable usize = 0
                while token_index < tokens.count |token_index, candidate_index, tokens, candidates, snapshot, surface|:
                    while candidate_index < candidates.count and candidates[candidate_index].skip_start < token_index:
                        candidate_index <- candidate_index + 1
                    if candidate_index < candidates.count:
                        candidate: IncrementalFactCandidate = candidates[candidate_index]
                        if candidate.skip_start == token_index:
                            skip_body: bool = candidate.header_supported and candidate.prior_record_cacheable if use_previous_cacheability else candidate.header_supported and snapshot.functions[candidate.owner].cacheable
                            if skip_body and candidate.skip_start <= candidate.skip_end and candidate.skip_end <= tokens.count:
                                token_index <- candidate.skip_end
                                candidate_index <- candidate_index + 1
                                continue
                    return false if not ifc_append_token_bytes(surface, source, source_length, tokens[token_index])
                    token_index <- token_index + 1
                return true

        def ifc_reuse_previous_candidate_facts(index: usize, candidates: mutable darray[IncrementalFactCandidate]&, previous: IncrementalSemanticSnapshot&, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if index >= candidates.count
                candidate: IncrementalFactCandidate = candidates[index]
                return false if candidate.prior_record >= previous.functions.count or not candidate.prior_record_cacheable
                old: IncrementalFunctionFactRecord = previous.functions[candidate.prior_record]
                current: IncrementalFunctionFactRecord = snapshot.functions[candidate.owner]
                return false if not old.cacheable or old.key_start > previous.bytes.count or old.key_length > previous.bytes.count - old.key_start
                return false if current.key_start > snapshot.bytes.count or current.key_length > snapshot.bytes.count - current.key_start
                return false if not ifc_equal(snapshot.bytes, current.key_start, current.key_length, previous.bytes, old.key_start, old.key_length)
                # Candidate matching already did this exact body comparison before
                # declaration-surface admission. Reuse that result instead of walking
                # every unchanged body a second time here.
                return false if not candidate.prior_body_matches
                return false if old.direct_fact_start > previous.direct_facts.count or old.direct_fact_count > previous.direct_facts.count - old.direct_fact_start
                # Validate every nested byte span before copying anything. A malformed
                # in-process image therefore falls back to the current AST walker.
                for relative in 0..<old.direct_fact_count |previous|:
                    fact: IncrementalDirectFact = previous.direct_facts[old.direct_fact_start + relative]
                    return false if fact.owner != candidate.prior_record
                    return false if fact.subject_start > previous.bytes.count or fact.subject_length > previous.bytes.count - fact.subject_start
                    return false if fact.active_grant_start > previous.active_grants.count or fact.active_grant_count > previous.active_grants.count - fact.active_grant_start
                    for grant_relative in 0..<fact.active_grant_count |previous|:
                        grant: IncrementalActiveGrant = previous.active_grants[fact.active_grant_start + grant_relative]
                        return false if grant.name_start > previous.bytes.count or grant.name_length > previous.bytes.count - grant.name_start

                fact_start: usize = snapshot.direct_facts.count
                for relative in 0..<old.direct_fact_count |previous, snapshot|:
                    fact: IncrementalDirectFact = previous.direct_facts[old.direct_fact_start + relative]
                    subject_start: usize = snapshot.bytes.count
                    if fact.subject_length > 0 and ifc_byte_span(previous.bytes, fact.subject_start, fact.subject_length) is subject:
                        snapshot.bytes.extend(subject)
                    grant_start: usize = snapshot.active_grants.count
                    for grant_relative in 0..<fact.active_grant_count |previous, snapshot|:
                        grant: IncrementalActiveGrant = previous.active_grants[fact.active_grant_start + grant_relative]
                        name_start: usize = snapshot.bytes.count
                        if grant.name_length > 0 and ifc_byte_span(previous.bytes, grant.name_start, grant.name_length) is name:
                            snapshot.bytes.extend(name)
                        snapshot.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name_length})
                    snapshot.direct_facts.push(IncrementalDirectFact{owner: candidate.owner, kind: fact.kind, subject_start: subject_start, subject_length: fact.subject_length, anchor_token: fact.anchor_token, active_grant_start: grant_start, active_grant_count: fact.active_grant_count})
                snapshot.functions[candidate.owner].direct_fact_start <- fact_start
                snapshot.functions[candidate.owner].direct_fact_count <- snapshot.direct_facts.count - fact_start
                snapshot.functions[candidate.owner].cacheable <- true
                snapshot.functions[candidate.owner].matched_previous <- true
                snapshot.functions[candidate.owner].reject_reason <- IncrementalRejectReason.None
                snapshot.bodies_matched <- snapshot.bodies_matched + 1
                return true

    public:
        # Replay only fully rebound syntax facts. Unsupported or malformed entries fall
        # back to the checker's streaming walk for that body, preserving cold behavior.
        def check_self_assignment_with_snapshot(declarations: darray[Ast::Decl], table: lmut SymbolTable, snapshot: IncrementalSemanticSnapshot&) -> void:
            can Memory.Allocate, Abort.Panic:
                function_index: mutable usize = 0
                for declaration in declarations |table, function_index|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            replay: mutable bool = function_index < snapshot.functions.count and function_index < snapshot.self_assignment_ranges.count and function_index < snapshot.current_anchors.count
                            if replay:
                                fact_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[function_index]
                                body_anchor: IncrementalFunctionSourceAnchor = snapshot.current_anchors[function_index]
                                # A complete fresh scan is already current-source data;
                                # reused_previous is not a semantic replay requirement.
                                replay <- fact_range.complete
                                replay <- false if fact_range.start > snapshot.self_assignment_facts.count or fact_range.count > snapshot.self_assignment_facts.count - fact_range.start
                                replay <- false if fact_range.start > snapshot.current_self_assignment_anchors.count or fact_range.count > snapshot.current_self_assignment_anchors.count - fact_range.start
                                replay <- false if body_anchor.body_token_start > body_anchor.body_token_end
                                if replay:
                                    for relative in 0..<fact_range.count |replay|:
                                        index: usize = fact_range.start + relative
                                        fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[index]
                                        anchor: IncrementalSelfAssignmentAnchor = snapshot.current_self_assignment_anchors[index]
                                        replay <- false if:
                                            fact.target_anchor_token == INCREMENTAL_NO_ANCHOR or fact.statement_anchor_token == INCREMENTAL_NO_ANCHOR
                                            fact.target_anchor_token.usize() >= body_anchor.body_token_end - body_anchor.body_token_start
                                            fact.statement_anchor_token.usize() >= body_anchor.body_token_end - body_anchor.body_token_start
                                            anchor.name == "" or anchor.target_position.line == 0 or anchor.statement_line == 0
                            if replay:
                                fact_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[function_index]
                                for relative in 0..<fact_range.count |table|:
                                    anchor: IncrementalSelfAssignmentAnchor = snapshot.current_self_assignment_anchors[fact_range.start + relative]
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SelfAssignment, name: anchor.name, pos: anchor.target_position, line: anchor.statement_line, expected: "", actual: ""})
                            else:
                                table <- check_self_assignment_statements(body, table)
                            function_index <- function_index + 1
                        Decl.Module(name, body, line):
                            table <- check_self_assignment(body, table)
                        Decl.Scoped(body, line):
                            table <- check_self_assignment(body, table)
                        _:
                            pass

        # Resolve a portable direct-call fact back to its current source-level name.
        # The serialized subject is a length-prefixed (path, name) key; callers must
        # still resolve that name against the current declaration/index inventory.
        def incremental_direct_call_name(snapshot: IncrementalSemanticSnapshot&, fact: IncrementalDirectFact) -> sview?:
            can Abort.Panic:
                return null if fact.kind != IncrementalFactKind.DirectCall
                return null if fact.subject_start > snapshot.bytes.count or fact.subject_length > snapshot.bytes.count - fact.subject_start
                return null if snapshot.source_path_start > snapshot.bytes.count or snapshot.source_path_length > snapshot.bytes.count - snapshot.source_path_start
                return null if fact.subject_length < 8
                path_length: usize = ifc_read_u32(snapshot.bytes, fact.subject_start).usize()
                return null if path_length > fact.subject_length - 8
                path_start: usize = fact.subject_start + 4
                return null if path_length != snapshot.source_path_length
                return null if not ifc_equal(snapshot.bytes, path_start, path_length, snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length)
                name_length_start: usize = path_start + path_length
                name_length: usize = ifc_read_u32(snapshot.bytes, name_length_start).usize()
                name_start: usize = name_length_start + 4
                return null if name_length == 0 or name_length != fact.subject_length - (path_length + 8)
                if ifc_byte_span(snapshot.bytes, name_start, name_length) is name:
                    return name
                return null

        # Supported functions are unique, top-level, nongeneric defs with ordinary block
        # bodies and scalar builtin return types. Calls must be direct, zero-argument, and
        # unambiguous. Locals are untyped literals; local identifier reads stay cold because
        # they can hide mutable places or callback values. Nested blocks and parenthesized
        # expressions stay cold until their walker depth behavior is modeled. Disk snapshots
        # remain hints only; only a caller-owned in-process session can authorize collector
        # fact reuse after exact surface and body checks.
        def ifc_collect_function_facts(file: Ast::File&, source: u8&, source_length: usize, tokens: darray[Lexer::Token]&, source_path: sview, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, previous: IncrementalSemanticSnapshot&, has_previous: bool, allow_session_reuse: bool) -> IncrementalSemanticSnapshot:
            can Memory.Allocate, Abort.Panic:
                snapshot: mutable IncrementalSemanticSnapshot = IncrementalSemanticSnapshot{schema_version: INCREMENTAL_FUNCTION_FACTS_SCHEMA, semantic_fingerprint: semantic_fingerprint, options_fingerprint: options_fingerprint, options_key: [], bytes: [], source_path_start: 0, source_path_length: 0, declaration_surface_start: 0, declaration_surface_length: 0, declaration_surface_hash: INCREMENTAL_FACT_HASH_OFFSET, functions: [], current_anchors: [], direct_facts: [], active_grants: [], self_assignment_ranges: [], self_assignment_facts: [], current_self_assignment_anchors: [], bodies_visited: 0, bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_scanned: 0, self_assignment_bodies_reused: 0, surface_compatible: false}
                snapshot.options_key.extend(options_key)
                snapshot.source_path_start <- snapshot.bytes.count
                snapshot.source_path_length <- source_path.len
                ifc_append_view(snapshot, source_path)

                candidates: mutable darray[IncrementalFactCandidate] = []
                all_globals: mutable darray[sview] = []
                mutable_globals: mutable darray[sview] = []
                all_aliases: mutable darray[sview] = []
                for declaration in file.top_decls |all_aliases|:
                    match declaration:
                        Decl.Alias(name, _, _):
                            all_aliases.push(name)
                        _:
                            pass
                definition_cursor: mutable usize = 0
                previous_span_end: mutable usize = 0
                all_spans_ordered: mutable bool = true
                for declaration in file.top_decls |candidates, all_globals, mutable_globals, tokens, snapshot, source, source_length|:
                    match declaration:
                        Decl.Const(name, _, _, is_global, _):
                            all_globals.push(name) if is_global
                        Decl.Func(name, parameters, return_type, body, _, _, position):
                            while definition_cursor < tokens.count and (tokens[definition_cursor].kind != TokenKind.Def or tokens[definition_cursor].start != position.offset):
                                definition_cursor <- definition_cursor + 1
                            span: IncrementalFactTokenSpan = ifc_token_span(tokens, definition_cursor)
                            if span.found:
                                definition_cursor <- span.skip_end
                            elif definition_cursor < tokens.count:
                                definition_cursor <- definition_cursor + 1
                            span_ordered: bool = not span.found or span.skip_start >= previous_span_end
                            if span.found:
                                all_spans_ordered <- false if not span_ordered
                                previous_span_end <- span.skip_end if span.skip_end > previous_span_end
                            generic_header: bool = span.found and ifc_generic_header(tokens, span.definition_token)
                            inline_grant: bool = span.found and ifc_has_inline_grant(file.enum_annotations, tokens, span.body_start, span.body_end)
                            signature_supported: bool = ifc_signature_supported(parameters, return_type, all_aliases)
                            key_span: (start: usize, length: usize) = ifc_append_name(snapshot, source_path, name)
                            body_start: usize = snapshot.bytes.count
                            body_valid: bool = span.found and ifc_append_tokens(snapshot, source, source_length, tokens, span.body_start, span.body_end)
                            body_length: usize = snapshot.bytes.count - body_start if body_valid else 0
                            owner: usize = snapshot.functions.count
                            snapshot.functions.push(IncrementalFunctionFactRecord{key_start: key_span.start, key_length: key_span.length, body_start: body_start, body_length: body_length, body_hash: ifc_hash(snapshot.bytes, body_start, body_length), direct_fact_start: 0, direct_fact_count: 0, cacheable: false, matched_previous: false, reject_reason: IncrementalRejectReason.MissingBlockBody if not span.found else IncrementalRejectReason.None})
                            snapshot.self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: snapshot.self_assignment_facts.count, count: 0, complete: false, reused_previous: false})
                            snapshot.current_anchors.push(IncrementalFunctionSourceAnchor{definition_offset: position.offset, body_token_start: span.body_start, body_token_end: span.body_end})
                            candidates.push(IncrementalFactCandidate{name: name, parameters: parameters, return_type: return_type, body: body, definition_offset: position.offset, definition_token: span.definition_token, generic_header: generic_header, span_ordered: span_ordered, body_token_start: span.body_start, body_token_end: span.body_end, skip_start: span.skip_start, skip_end: span.skip_end, owner: owner, header_supported: span.found and body_valid and source_path != "" and not generic_header and not inline_grant and span_ordered and signature_supported, prior_record: 0, prior_record_cacheable: false, prior_body_matches: false, scanned: false})
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.MissingStablePath if source_path == ""
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan if span.found and not body_valid
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.UnsupportedBodySyntax if inline_grant
                            snapshot.functions[owner].reject_reason <- IncrementalRejectReason.UnsupportedSignature if not signature_supported
                        _:
                            pass

                if not all_spans_ordered:
                    for candidate_index in 0..<candidates.count |candidates, snapshot|:
                        candidates[candidate_index].header_supported <- false
                        snapshot.functions[candidates[candidate_index].owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan

                # Decl.Const distinguishes globals from consts; mutability lives in the
                # parser's __global_mutable annotation side table.
                all_globals_index: mutable IncrementalStringNameIndex = IncrementalStringNameIndex{}
                ifc_string_name_index(all_globals, &all_globals_index) if all_globals.count >= INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT
                for annotation in file.enum_annotations:
                    if annotation.name == "__global_mutable" and annotation.module == "" and ifc_string_name_contains(all_globals, annotation.owner, all_globals_index):
                        mutable_globals.push(annotation.owner)
                mutable_globals_index: mutable IncrementalStringNameIndex = IncrementalStringNameIndex{}
                ifc_string_name_index(mutable_globals, &mutable_globals_index) if mutable_globals.count >= INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT

                candidate_names: mutable IncrementalCandidateNameIndex = IncrementalCandidateNameIndex{}
                ifc_candidate_name_index(candidates, &candidate_names)
                prior_keys: mutable IncrementalPriorKeyIndex = IncrementalPriorKeyIndex{}
                if has_previous and previous.schema_version == INCREMENTAL_FUNCTION_FACTS_SCHEMA:
                    ifc_prior_key_index(previous, &prior_keys)
                for index in 0..<candidates.count |candidates, snapshot, previous|:
                    unique: bool = ifc_name_unique(candidates, candidates[index].name, candidate_names)
                    generic: bool = candidates[index].generic_header
                    candidates[index].header_supported <- candidates[index].header_supported and unique
                    if not unique or generic:
                        snapshot.functions[candidates[index].owner].reject_reason <- IncrementalRejectReason.NonUniqueOrGenericFunction
                    elif not candidates[index].span_ordered:
                        snapshot.functions[candidates[index].owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan
                    if candidates[index].header_supported and has_previous and previous.schema_version == INCREMENTAL_FUNCTION_FACTS_SCHEMA:
                        current: IncrementalFunctionFactRecord = snapshot.functions[candidates[index].owner]
                        old_index: usize = ifc_prior_index(previous, snapshot.bytes, current.key_start, current.key_length, prior_keys)
                        if old_index < previous.functions.count:
                            old: IncrementalFunctionFactRecord = previous.functions[old_index]
                            same_body: bool = ifc_equal(snapshot.bytes, current.body_start, current.body_length, previous.bytes, old.body_start, old.body_length)
                            candidates[index].prior_record <- old_index
                            candidates[index].prior_record_cacheable <- old.cacheable
                            candidates[index].prior_body_matches <- same_body

                trusted_surface_admitted: mutable bool = false
                if allow_session_reuse and has_previous and all_spans_ordered:
                    proposed_surface: mutable darray[u8] = []
                    proposed_surface_valid: bool = ifc_append_declaration_surface(proposed_surface, tokens, source, source_length, candidates, snapshot, true)
                    trusted_surface_admitted <- proposed_surface_valid and ifc_surface_matches_bytes(previous, snapshot.schema_version, snapshot.semantic_fingerprint, snapshot.options_fingerprint, snapshot.options_key, source_path, proposed_surface)

                for index in 0..<candidates.count |candidates, snapshot|:
                    if allow_session_reuse and trusted_surface_admitted and candidates[index].header_supported and candidates[index].prior_record_cacheable and candidates[index].prior_body_matches:
                        if ifc_reuse_previous_candidate_facts(index, candidates, previous, snapshot):
                            candidates[index].scanned <- true
                        else:
                            ifc_scan_candidate(index, candidates, candidate_names, source_path, tokens, all_globals, all_globals_index, mutable_globals, mutable_globals_index, snapshot)
                    else:
                        ifc_scan_candidate(index, candidates, candidate_names, source_path, tokens, all_globals, all_globals_index, mutable_globals, mutable_globals_index, snapshot)

                snapshot.declaration_surface_start <- snapshot.bytes.count
                surface_valid: mutable bool = true
                declaration_surface: mutable darray[u8] = []
                surface_valid <- ifc_append_declaration_surface(declaration_surface, tokens, source, source_length, candidates, snapshot, false)
                snapshot.bytes.extend(declaration_surface)
                snapshot.declaration_surface_length <- snapshot.bytes.count - snapshot.declaration_surface_start
                snapshot.declaration_surface_hash <- ifc_hash(snapshot.bytes, snapshot.declaration_surface_start, snapshot.declaration_surface_length)
                snapshot.surface_compatible <- has_previous and surface_valid and all_spans_ordered and ifc_surface_equal(previous, snapshot)
                if not surface_valid:
                    snapshot.direct_facts.truncate(0)
                    snapshot.active_grants.truncate(0)
                    snapshot.bodies_matched <- 0
                    for record_index in 0..<snapshot.functions.count |snapshot, record_index|:
                        snapshot.functions[record_index].cacheable <- false
                        snapshot.functions[record_index].matched_previous <- false
                        snapshot.functions[record_index].direct_fact_start <- 0
                        snapshot.functions[record_index].direct_fact_count <- 0
                        snapshot.functions[record_index].reject_reason <- IncrementalRejectReason.InvalidTokenSpan
                    return snapshot

                # This syntax-only query needs no declaration lookup. Collect it after the
                # portable snapshot size is known so the process-local facts share the same
                # bounded storage budget. Disk snapshots omit these facts and stay cold.
                if allow_session_reuse:
                    for index in 0..<candidates.count |candidates, snapshot, previous|:
                        reused_self_assignment: bool = has_previous and ifc_reuse_previous_self_assignment_candidate(index, candidates, previous, tokens, source, source_length, snapshot)
                        if not reused_self_assignment:
                            ifc_scan_self_assignment_candidate(index, candidates, tokens, source, source_length, snapshot)

                if snapshot.surface_compatible:
                    for index in 0..<candidates.count |candidates, snapshot|:
                        continue if not candidates[index].prior_body_matches
                        current: IncrementalFunctionFactRecord = snapshot.functions[candidates[index].owner]
                        # For sidecars this records an exact-body match after a full scan.
                        # Trusted session copies set the bit and count at the copy site.
                        if current.cacheable and not current.matched_previous:
                            snapshot.functions[candidates[index].owner].matched_previous <- true
                            snapshot.bodies_matched <- snapshot.bodies_matched + 1

                return ifc_canonical_layout(snapshot)

        def incremental_collect_function_facts(file: Ast::File&, source: u8&, source_length: usize, tokens: darray[Lexer::Token]&, source_path: sview, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, previous: IncrementalSemanticSnapshot&, has_previous: bool) -> IncrementalSemanticSnapshot:
            can Memory.Allocate, Abort.Panic:
                return ifc_collect_function_facts(file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, previous, has_previous, false)

        # Rebind an exact-input, compiler-produced session snapshot to the current parse.
        # This intentionally rebuilds only invocation-local source anchors; the session key
        # proves the source, token stream, declaration surface, options, and fact semantics
        # are unchanged, so the supported body fact walkers need not run again.
    private:
        def incremental_reanchor_exact_snapshot(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, snapshot: mutable IncrementalSemanticSnapshot&) -> bool:
            can Abort.Panic, Memory.Allocate:
                return false if snapshot.schema_version != INCREMENTAL_FUNCTION_FACTS_SCHEMA
                return false if snapshot.functions.count > 1000000 or snapshot.direct_facts.count > 1000000 or snapshot.active_grants.count > 1000000
                snapshot.current_anchors.truncate(0)
                snapshot.current_self_assignment_anchors.truncate(0)
                self_stream_valid: mutable bool = snapshot.self_assignment_ranges.count == snapshot.functions.count and snapshot.self_assignment_facts.count <= 1000000
                expected_fact_start: mutable usize = 0
                if self_stream_valid:
                    for self_range in snapshot.self_assignment_ranges |expected_fact_start, self_stream_valid|:
                        self_stream_valid <- false if self_range.start != expected_fact_start or self_range.start > snapshot.self_assignment_facts.count or self_range.count > snapshot.self_assignment_facts.count - self_range.start
                        expected_fact_start <- self_range.start + self_range.count if self_stream_valid
                    self_stream_valid <- false if expected_fact_start != snapshot.self_assignment_facts.count
                if not self_stream_valid:
                    # Decoded disk snapshots intentionally omit this session-only stream.
                    # Keep direct-fact reanchoring intact and make only this linter cold.
                    snapshot.self_assignment_facts.truncate(0)
                    snapshot.self_assignment_ranges.truncate(0)
                    for index in 0..<snapshot.functions.count |snapshot|:
                        snapshot.self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: 0, count: 0, complete: false, reused_previous: false})
                snapshot.bodies_visited <- 0
                snapshot.bodies_matched <- 0
                snapshot.bodies_rejected <- 0
                snapshot.self_assignment_bodies_scanned <- 0
                snapshot.self_assignment_bodies_reused <- 0
                definition_cursor: mutable usize = 0
                previous_span_end: mutable usize = 0
                record_index: mutable usize = 0
                spans_ordered: mutable bool = true
                for declaration in file.top_decls |snapshot, tokens, definition_cursor, previous_span_end, record_index, spans_ordered|:
                    match declaration:
                        Decl.Func(name, _, _, _, _, _, position):
                            return false if record_index >= snapshot.functions.count
                            while definition_cursor < tokens.count and (tokens[definition_cursor].kind != TokenKind.Def or tokens[definition_cursor].start != position.offset):
                                definition_cursor <- definition_cursor + 1
                            definition_found: bool = definition_cursor < tokens.count and tokens[definition_cursor].kind == TokenKind.Def and tokens[definition_cursor].start == position.offset
                            return false if not definition_found
                            span: IncrementalFactTokenSpan = ifc_token_span(tokens, definition_cursor)
                            if span.found:
                                spans_ordered <- false if span.skip_start < previous_span_end
                                previous_span_end <- span.skip_end if span.skip_end > previous_span_end
                                definition_cursor <- span.skip_end
                            elif definition_cursor < tokens.count:
                                definition_cursor <- definition_cursor + 1
                            return false if not spans_ordered
                            record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                            return false if record.key_start > snapshot.bytes.count or record.key_length > snapshot.bytes.count - record.key_start or record.key_length < 8
                            path_length: usize = ifc_read_u32(snapshot.bytes, record.key_start).usize()
                            return false if path_length > record.key_length - 8 or path_length != snapshot.source_path_length
                            path_start: usize = record.key_start + 4
                            return false if not ifc_equal(snapshot.bytes, path_start, path_length, snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length)
                            name_length_start: usize = path_start + path_length
                            name_length: usize = ifc_read_u32(snapshot.bytes, name_length_start).usize()
                            name_start: usize = name_length_start + 4
                            return false if name_length != record.key_length - path_length - 8 or name_length != name.len
                            for name_offset in 0..<name_length |snapshot, name|:
                                return false if snapshot.bytes[name_start + name_offset] != name[name_offset]
                            return false if record.cacheable and not span.found
                            return false if span.found and (span.body_start > span.body_end or span.body_end > tokens.count)
                            snapshot.current_anchors.push(IncrementalFunctionSourceAnchor{definition_offset: position.offset, body_token_start: span.body_start, body_token_end: span.body_end})
                            self_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[record_index]
                            return false if self_range.start > snapshot.self_assignment_facts.count or self_range.count > snapshot.self_assignment_facts.count - self_range.start
                            snapshot.self_assignment_ranges[record_index].reused_previous <- false
                            for relative in 0..<self_range.count |snapshot|:
                                fact_index: usize = self_range.start + relative
                                fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[fact_index]
                                rebound: (valid: bool, anchor: IncrementalSelfAssignmentAnchor) = ifc_rebind_self_assignment_anchor(tokens, source, source_length, span.body_start, span.body_end, fact.target_anchor_token, fact.statement_anchor_token)
                                if rebound.valid:
                                    snapshot.current_self_assignment_anchors.push(rebound.anchor)
                                else:
                                    snapshot.self_assignment_ranges[record_index].complete <- false
                                    snapshot.current_self_assignment_anchors.push(IncrementalSelfAssignmentAnchor{name: "", target_position: Ast::pos_at_line(0), statement_line: 0})
                            snapshot.self_assignment_ranges[record_index].reused_previous <- snapshot.self_assignment_ranges[record_index].complete
                            if snapshot.self_assignment_ranges[record_index].reused_previous:
                                snapshot.self_assignment_bodies_reused <- snapshot.self_assignment_bodies_reused + 1
                            if record.cacheable:
                                # Whole-input byte equality plus successful rebinding proves
                                # this current record still names the retained body. Recompute
                                # the report flags here instead of carrying prior edit counters.
                                snapshot.functions[record_index].matched_previous <- true
                                snapshot.bodies_matched <- snapshot.bodies_matched + 1
                            else:
                                snapshot.functions[record_index].matched_previous <- false
                                snapshot.bodies_rejected <- snapshot.bodies_rejected + 1
                            record_index <- record_index + 1
                        _:
                            pass
                return false if record_index != snapshot.functions.count or snapshot.current_anchors.count != snapshot.functions.count
                snapshot.surface_compatible <- true
                return true

    public:
        def incremental_semantic_session_new(enabled: bool) -> IncrementalSemanticSession can[Memory.Allocate]:
            return IncrementalSemanticSession{enabled: enabled, valid: false, analyzed_source: [], identity_key: [], options_key: [], generated_input: false, semantic_fingerprint: 0, snapshot: incremental_empty_snapshot(), query_key_bytes: [], query_key_heads: {}, query_nodes: [], query_edges: [], free_query_edges: []}

        def incremental_semantic_session_is_enabled(session: IncrementalSemanticSession&) -> bool:
            return session.enabled

        def incremental_semantic_session_reset[@session](session: mutable IncrementalSemanticSession& @session) -> void:
            can Abort.Panic, Memory.Allocate:
                ifc_session_clear_prior(session)
                ifq_clear_session_graph(session)

    private:
        # Find or create a node by the exact query key. The hash selects a collision
        # chain only; it never authorizes identity. New key bytes are copied into the
        # session before the node is published.
        def incremental_semantic_query_for_key[@session](session: mutable IncrementalSemanticSession& @session, kind: IncrementalSemanticQueryKind, key: darray[u8]&) -> IncrementalSemanticQueryId:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                missing: IncrementalSemanticQueryId = IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}
                return missing if not session.enabled
                key_hash: u64 = ifq_query_key_hash(kind, key)
                if session.query_key_heads.get(key_hash) is head:
                    cursor: mutable IncrementalSemanticQueryId = head
                    while cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |cursor, session, kind, key|:
                        return cursor if ifq_query_key_matches(session, cursor, kind, key)
                        return missing if cursor.value.usize() >= session.query_nodes.count
                        cursor <- session.query_nodes[cursor.value.usize()].next_same_hash
                return missing if session.query_nodes.count >= INCREMENTAL_SEMANTIC_QUERY_NONE.usize()
                key_start: usize = session.query_key_bytes.count
                previous_head: IncrementalSemanticQueryId = head if session.query_key_heads.get(key_hash) is head else missing
                session.query_key_bytes.extend(key)
                query_id: IncrementalSemanticQueryId = IncrementalSemanticQueryId{value: session.query_nodes.count.u32()}
                session.query_nodes.push(IncrementalSemanticQueryNode{kind: kind, key_hash: key_hash, key_start: key_start, key_length: key.count, next_same_hash: previous_head, first_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, first_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, input_fingerprint: 0, result_fingerprint: 0, status: IncrementalSemanticQueryStatus.Dirty})
                session.query_key_heads <- session.query_key_heads.put(key_hash, query_id) can Global{Read,Write}
                return query_id

        # Replace the full outgoing dependency set. The old forward and reverse links
        # are removed together, then the new edges are installed in both adjacency lists.
        # Duplicate dependency IDs are ignored so one query contributes one invalidation edge.
        def incremental_semantic_query_replace_dependencies[@session](session: mutable IncrementalSemanticSession& @session, depender: IncrementalSemanticQueryId, dependencies: darray[IncrementalSemanticQueryId]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not session.enabled or not ifq_query_id_is_valid(session, depender)
                unique_count: mutable usize = 0
                for index in 0..<dependencies.count |session, depender, dependencies, unique_count|:
                    dependency: IncrementalSemanticQueryId = dependencies[index]
                    return false if not ifq_query_id_is_valid(session, dependency)
                    duplicate: mutable bool = false
                    for previous in 0..<index |duplicate, dependency, dependencies|:
                        duplicate <- true if dependencies[previous].value == dependency.value
                    unique_count <- unique_count + 1 if not duplicate

                old_count: mutable usize = 0
                edge_cursor: IncrementalSemanticDependencyEdgeId = session.query_nodes[depender.value.usize()].first_dependency
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |edge_cursor, old_count, session|:
                    return false if not ifq_edge_id_is_valid(session, edge_cursor)
                    old_count <- old_count + 1
                    return false if old_count > session.query_edges.count
                    edge_cursor <- session.query_edges[edge_cursor.value.usize()].next_dependency

                reusable_count: usize = session.free_query_edges.count + old_count
                append_count: usize = unique_count - reusable_count if unique_count > reusable_count else 0
                return false if append_count > INCREMENTAL_SEMANTIC_QUERY_NONE.usize() - session.query_edges.count
                session.query_edges.reserve(session.query_edges.count + append_count)
                session.free_query_edges.reserve(session.free_query_edges.count + old_count)

                edge_cursor <- session.query_nodes[depender.value.usize()].first_dependency
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |edge_cursor, session, depender|:
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                    next_edge: IncrementalSemanticDependencyEdgeId = edge.next_dependency
                    if edge.previous_depender.value == INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_nodes[edge.dependee.value.usize()].first_depender <- edge.next_depender
                    else:
                        session.query_edges[edge.previous_depender.value.usize()].next_depender <- edge.next_depender
                    if edge.next_depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_edges[edge.next_depender.value.usize()].previous_depender <- edge.previous_depender
                    session.query_edges[edge_cursor.value.usize()].depender <- IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}
                    session.query_edges[edge_cursor.value.usize()].dependee <- IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}
                    session.free_query_edges.push(edge_cursor)
                    edge_cursor <- next_edge
                session.query_nodes[depender.value.usize()].first_dependency <- IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}

                for index in 0..<dependencies.count |session, depender, dependencies|:
                    dependee: IncrementalSemanticQueryId = dependencies[index]
                    duplicate: mutable bool = false
                    for previous in 0..<index |duplicate, dependee, dependencies|:
                        duplicate <- true if dependencies[previous].value == dependee.value
                    continue if duplicate
                    edge_id: IncrementalSemanticDependencyEdgeId
                    if session.free_query_edges.count > 0:
                        edge_id <- session.free_query_edges.pop()
                    else:
                        edge_id <- IncrementalSemanticDependencyEdgeId{value: session.query_edges.count.u32()}
                        session.query_edges.push(IncrementalSemanticDependencyEdge{depender: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, dependee: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, previous_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE})
                    outgoing_head: IncrementalSemanticDependencyEdgeId = session.query_nodes[depender.value.usize()].first_dependency
                    incoming_head: IncrementalSemanticDependencyEdgeId = session.query_nodes[dependee.value.usize()].first_depender
                    session.query_edges[edge_id.value.usize()] <- IncrementalSemanticDependencyEdge{depender: depender, dependee: dependee, previous_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_dependency: outgoing_head, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: incoming_head}
                    if outgoing_head.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_edges[outgoing_head.value.usize()].previous_dependency <- edge_id
                    if incoming_head.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_edges[incoming_head.value.usize()].previous_depender <- edge_id
                    session.query_nodes[depender.value.usize()].first_dependency <- edge_id
                    session.query_nodes[dependee.value.usize()].first_depender <- edge_id
                return true

        # Mark a query and every reverse depender dirty. The explicit worklist and
        # visited bitmap handle dependency cycles without recursion or repeated work.
        def incremental_semantic_query_invalidate_dependers[@session](session: mutable IncrementalSemanticSession& @session, changed: IncrementalSemanticQueryId) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not session.enabled or not ifq_query_id_is_valid(session, changed)
                work: mutable darray[IncrementalSemanticQueryId] = []
                work.reserve(session.query_nodes.count)
                visited: mutable darray[bool] = [false for _ in 0..<session.query_nodes.count]
                visited[changed.value.usize()] <- true
                work.push(changed)
                while work.count > 0 |session, work, visited|:
                    current: IncrementalSemanticQueryId = work.pop()
                    session.query_nodes[current.value.usize()].status <- IncrementalSemanticQueryStatus.Dirty
                    edge_cursor: IncrementalSemanticDependencyEdgeId = session.query_nodes[current.value.usize()].first_depender
                    steps: mutable usize = 0
                    while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |edge_cursor, steps, session, work, visited|:
                        return false if not ifq_edge_id_is_valid(session, edge_cursor)
                        edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                        dependent: IncrementalSemanticQueryId = edge.depender
                        return false if not ifq_query_id_is_valid(session, dependent)
                        if not visited[dependent.value.usize()]:
                            visited[dependent.value.usize()] <- true
                            work.push(dependent)
                        steps <- steps + 1
                        return false if steps > session.query_edges.count
                        edge_cursor <- edge.next_depender
                return true

        def ifq_query_key_hash(kind: IncrementalSemanticQueryKind, key: darray[u8]&) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                hash <- (hash ^ kind.u64()) * 1099511628211
                for byte in key |hash|:
                    hash <- (hash ^ byte.u64()) * 1099511628211
                return hash

        def ifq_query_id_is_valid(session: IncrementalSemanticSession&, query_id: IncrementalSemanticQueryId) -> bool:
            can Abort.Panic:
                return query_id.value != INCREMENTAL_SEMANTIC_QUERY_NONE and query_id.value.usize() < session.query_nodes.count

        def ifq_edge_id_is_valid(session: IncrementalSemanticSession&, edge_id: IncrementalSemanticDependencyEdgeId) -> bool:
            can Abort.Panic:
                return edge_id.value != INCREMENTAL_SEMANTIC_QUERY_NONE and edge_id.value.usize() < session.query_edges.count and session.query_edges[edge_id.value.usize()].depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE and session.query_edges[edge_id.value.usize()].dependee.value != INCREMENTAL_SEMANTIC_QUERY_NONE

        def ifq_query_key_matches(session: IncrementalSemanticSession&, query_id: IncrementalSemanticQueryId, kind: IncrementalSemanticQueryKind, key: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if not ifq_query_id_is_valid(session, query_id)
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                return false if node.kind != kind or node.key_hash != ifq_query_key_hash(kind, key) or node.key_length != key.count
                return false if node.key_start > session.query_key_bytes.count or node.key_length > session.query_key_bytes.count - node.key_start
                for offset in 0..<key.count |session, node, key|:
                    return false if session.query_key_bytes[node.key_start + offset] != key[offset]
                return true

        def ifq_clear_session_graph[@session](session: mutable IncrementalSemanticSession& @session) -> void can[Memory.Allocate]:
            session.query_key_bytes.truncate(0)
            session.query_key_heads <- {}
            session.query_nodes.truncate(0)
            session.query_edges.truncate(0)
            session.free_query_edges.truncate(0)

        def ifc_session_clear_prior[@session](session: mutable IncrementalSemanticSession& @session) -> void:
            can Memory.Allocate:
                session.valid <- false
                session.analyzed_source.truncate(0)
                session.identity_key.truncate(0)
                session.options_key.truncate(0)
                session.generated_input <- false
                session.semantic_fingerprint <- 0
                session.snapshot.schema_version <- 0
                session.snapshot.semantic_fingerprint <- 0
                session.snapshot.options_fingerprint <- 0
                session.snapshot.options_key.truncate(0)
                session.snapshot.bytes.truncate(0)
                session.snapshot.source_path_start <- 0
                session.snapshot.source_path_length <- 0
                session.snapshot.declaration_surface_start <- 0
                session.snapshot.declaration_surface_length <- 0
                session.snapshot.declaration_surface_hash <- 0
                session.snapshot.functions.truncate(0)
                session.snapshot.current_anchors.truncate(0)
                session.snapshot.direct_facts.truncate(0)
                session.snapshot.active_grants.truncate(0)
                session.snapshot.self_assignment_ranges.truncate(0)
                session.snapshot.self_assignment_facts.truncate(0)
                session.snapshot.current_self_assignment_anchors.truncate(0)
                session.snapshot.bodies_visited <- 0
                session.snapshot.bodies_matched <- 0
                session.snapshot.bodies_rejected <- 0
                session.snapshot.self_assignment_bodies_scanned <- 0
                session.snapshot.self_assignment_bodies_reused <- 0
                session.snapshot.surface_compatible <- false

        def ifc_session_source_matches[@session](session: IncrementalSemanticSession& @session, source: u8&, source_length: usize) -> bool:
            can Abort.Panic, Unsafe.PointerArithmetic:
                return false if source_length != session.analyzed_source.count
                for index in 0..<source_length |session, source|:
                    current_byte: u8& = source + index
                    current_value: u8 = current_byte
                    return false if session.analyzed_source[index] != current_value
                return true

        def ifc_session_key_matches(stored: darray[u8]&, current: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if stored.count != current.count
                for index in 0..<current.count:
                    return false if stored[index] != current[index]
                return true

        # The session is the sole owner of these arrays. Return a deep copy for the
        # caller so rebinding anchors or checker updates cannot mutate trusted prior facts.
        # Source anchors and collection counters are invocation-local and are rebuilt.
        def ifc_clone_session_snapshot(source: IncrementalSemanticSnapshot&) -> IncrementalSemanticSnapshot:
            can Memory.Allocate, Abort.Panic:
                cloned: mutable IncrementalSemanticSnapshot = incremental_empty_snapshot()
                cloned.schema_version <- source.schema_version
                cloned.semantic_fingerprint <- source.semantic_fingerprint
                cloned.options_fingerprint <- source.options_fingerprint
                cloned.source_path_start <- source.source_path_start
                cloned.source_path_length <- source.source_path_length
                cloned.declaration_surface_start <- source.declaration_surface_start
                cloned.declaration_surface_length <- source.declaration_surface_length
                cloned.declaration_surface_hash <- source.declaration_surface_hash
                cloned.options_key.reserve(source.options_key.count)
                cloned.options_key.extend(source.options_key)
                cloned.bytes.reserve(source.bytes.count)
                cloned.bytes.extend(source.bytes)
                cloned.functions.reserve(source.functions.count)
                for record in source.functions |cloned|:
                    cloned.functions.push(record)
                cloned.direct_facts.reserve(source.direct_facts.count)
                for fact in source.direct_facts |cloned|:
                    cloned.direct_facts.push(fact)
                cloned.active_grants.reserve(source.active_grants.count)
                for grant in source.active_grants |cloned|:
                    cloned.active_grants.push(grant)
                cloned.self_assignment_ranges.reserve(source.self_assignment_ranges.count)
                for range in source.self_assignment_ranges |cloned|:
                    cloned.self_assignment_ranges.push(range)
                cloned.self_assignment_facts.reserve(source.self_assignment_facts.count)
                for fact in source.self_assignment_facts |cloned|:
                    cloned.self_assignment_facts.push(fact)
                return cloned

        # Copy portable prior facts into the destination's region. Unlike the invocation
        # clone above, this must never inherit the request region of `source`: the destination
        # belongs to the longer-lived semantic session and survives the current parse.
        def ifc_clone_session_snapshot_into[@session](source: IncrementalSemanticSnapshot&, destination: mutable IncrementalSemanticSnapshot& @session) -> void:
            can Memory.Allocate, Abort.Panic:
                destination.schema_version <- source.schema_version
                destination.semantic_fingerprint <- source.semantic_fingerprint
                destination.options_fingerprint <- source.options_fingerprint
                destination.source_path_start <- source.source_path_start
                destination.source_path_length <- source.source_path_length
                destination.declaration_surface_start <- source.declaration_surface_start
                destination.declaration_surface_length <- source.declaration_surface_length
                destination.declaration_surface_hash <- source.declaration_surface_hash
                destination.options_key.truncate(0)
                destination.options_key.reserve(source.options_key.count)
                destination.options_key.extend(source.options_key)
                destination.bytes.truncate(0)
                destination.bytes.reserve(source.bytes.count)
                destination.bytes.extend(source.bytes)
                destination.functions.truncate(0)
                destination.functions.reserve(source.functions.count)
                for record in source.functions |destination|:
                    destination.functions.push(record)
                destination.current_anchors.truncate(0)
                destination.direct_facts.truncate(0)
                destination.direct_facts.reserve(source.direct_facts.count)
                for fact in source.direct_facts |destination|:
                    destination.direct_facts.push(fact)
                destination.active_grants.truncate(0)
                destination.active_grants.reserve(source.active_grants.count)
                for grant in source.active_grants |destination|:
                    destination.active_grants.push(grant)
                destination.self_assignment_ranges.truncate(0)
                destination.self_assignment_ranges.reserve(source.self_assignment_ranges.count)
                for range in source.self_assignment_ranges |destination|:
                    destination.self_assignment_ranges.push(range)
                destination.self_assignment_facts.truncate(0)
                destination.self_assignment_facts.reserve(source.self_assignment_facts.count)
                for fact in source.self_assignment_facts |destination|:
                    destination.self_assignment_facts.push(fact)
                destination.current_self_assignment_anchors.truncate(0)
                destination.bodies_visited <- 0
                destination.bodies_matched <- 0
                destination.bodies_rejected <- 0
                destination.self_assignment_bodies_scanned <- 0
                destination.self_assignment_bodies_reused <- 0
                destination.surface_compatible <- source.surface_compatible

        def ifc_session_store[@session](session: mutable IncrementalSemanticSession& @session, source: u8&, source_length: usize, identity_key: darray[u8]&, options_key: darray[u8]&, generated_input: bool, semantic_fingerprint: u64, snapshot: IncrementalSemanticSnapshot&) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerArithmetic:
                if not session.enabled:
                    incremental_semantic_session_reset(session)
                    return false
                # Advancing the source snapshot must keep the session-owned query graph:
                # stable query keys and edge IDs are what make cross-edit invalidation
                # possible once semantic callers start recording dependencies.
                ifc_session_clear_prior(session)
                encoded_size: IncrementalSnapshotSizeResult = incremental_snapshot_encoded_size(snapshot)
                return false if not encoded_size.valid
                size: usize = source_length
                return false if size > INCREMENTAL_SNAPSHOT_CODEC_LIMIT
                return false if identity_key.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                size <- size + identity_key.count
                return false if options_key.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                size <- size + options_key.count
                linter_extra: u64 = snapshot.self_assignment_facts.count.u64() * 64 + snapshot.self_assignment_ranges.count.u64() * 32
                return false if linter_extra > (INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size).u64()
                size <- size + linter_extra.usize()
                return false if encoded_size.byte_count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                session.analyzed_source.reserve(source_length)
                session.identity_key.reserve(identity_key.count)
                session.options_key.reserve(options_key.count)
                for index in 0..<source_length |session, source|:
                    current_byte: u8& = source + index
                    current_value: u8 = current_byte
                    session.analyzed_source.push(current_value)
                for index in 0..<identity_key.count |session, identity_key|:
                    byte: u8 = identity_key[index]
                    session.identity_key.push(byte)
                for index in 0..<options_key.count |session, options_key|:
                    byte: u8 = options_key[index]
                    session.options_key.push(byte)
                ifc_clone_session_snapshot_into(snapshot, &session.snapshot)
                session.generated_input <- generated_input
                session.semantic_fingerprint <- semantic_fingerprint
                session.valid <- true
                return true

    public:
        # This is the only API that can advance trusted process-local provenance. The prior
        # snapshot is private and reaches allow_session_reuse only after its exact context
        # has matched. Sidecar snapshots continue through the rescan-only API.
        def incremental_collect_function_facts_with_session[@session](file: Ast::File&, source: u8&, source_length: usize, tokens: darray[Lexer::Token]&, source_path: sview, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, identity_key: darray[u8]&, generated_input: bool, session: mutable IncrementalSemanticSession& @session) -> IncrementalSessionCollectionResult:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerArithmetic:
                empty: IncrementalSessionCollectionResult = IncrementalSessionCollectionResult{snapshot: incremental_empty_snapshot(), prior_valid: false, exact_hit: false, body_facts_reused: false}
                return empty if not session.enabled
                context_matches: bool = session.valid
                context_matches <- false if session.semantic_fingerprint != semantic_fingerprint or session.generated_input != generated_input
                context_matches <- false if not ifc_session_key_matches(session.options_key, options_key)
                context_matches <- false if not ifc_session_key_matches(session.identity_key, identity_key)
                context_matches <- false if session.snapshot.schema_version != INCREMENTAL_FUNCTION_FACTS_SCHEMA
                context_matches <- false if session.snapshot.semantic_fingerprint != semantic_fingerprint or session.snapshot.options_fingerprint != options_fingerprint
                context_matches <- false if not ifc_session_key_matches(session.snapshot.options_key, options_key)
                if not context_matches:
                    incremental_semantic_session_reset(session)
                else:
                    if ifc_session_source_matches(session, source, source_length):
                        current: mutable IncrementalSemanticSnapshot = ifc_clone_session_snapshot(session.snapshot)
                        if ifc_equal_view(current.bytes, current.source_path_start, current.source_path_length, source_path) and incremental_reanchor_exact_snapshot(file, tokens, source, source_length, &current):
                            return IncrementalSessionCollectionResult{snapshot: current, prior_valid: true, exact_hit: true, body_facts_reused: false}
                    else:
                        current: mutable IncrementalSemanticSnapshot = ifc_collect_function_facts(file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, session.snapshot, true, true)
                        reused: bool = current.bodies_matched > 0 and current.bodies_visited < current.functions.count
                        stored: bool = ifc_session_store(session, source, source_length, identity_key, options_key, generated_input, semantic_fingerprint, current)
                        if not stored:
                            ifc_self_assignment_forget(&current)
                        return IncrementalSessionCollectionResult{snapshot: current, prior_valid: true, exact_hit: false, body_facts_reused: reused}
                    incremental_semantic_session_reset(session)
                cold: IncrementalSemanticSnapshot = ifc_collect_function_facts(file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, empty.snapshot, false, true)
                stored: bool = ifc_session_store(session, source, source_length, identity_key, options_key, generated_input, semantic_fingerprint, cold)
                if not stored:
                    ifc_self_assignment_forget(&cold)
                return IncrementalSessionCollectionResult{snapshot: cold, prior_valid: false, exact_hit: false, body_facts_reused: false}
