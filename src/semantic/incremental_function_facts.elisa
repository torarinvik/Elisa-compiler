        def ifq_query_dependencies_check_for_read[@r, @session_borrow](session: mutable IncrementalSemanticSession[r]& @session_borrow, query_id: IncrementalSemanticQueryId, dependencies: darray[IncrementalSemanticQueryHandle]&) -> IncrementalSemanticQueryDependencyCheck:
