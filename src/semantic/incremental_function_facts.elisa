                selected_existing <- session.free_query_edges.count if selected_existing > session.free_query_edges.count
                return false if session.free_query_edges.count > session.query_edges.count
                for relative in 0..<selected_existing |session, relative, old_count|:
                    free_index: usize = session.free_query_edges.count - 1 - relative
                    edge_id: IncrementalSemanticDependencyEdgeId = session.free_query_edges[free_index]
                    return false if edge_id.value == INCREMENTAL_SEMANTIC_QUERY_NONE or edge_id.value.usize() >= session.query_edges.count
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_id.value.usize()]
                    return false if edge.depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE or edge.dependee.value != INCREMENTAL_SEMANTIC_QUERY_NONE
                    for previous in 0..<relative |session, free_index, edge_id|:
                        previous_id: IncrementalSemanticDependencyEdgeId = session.free_query_edges[session.free_query_edges.count - 1 - previous]
                        return false if previous_id.value == edge_id.value
                return true

        def ifq_apply_dependency_set[@session, @session_borrow](session: mutable IncrementalSemanticSession[session]& @session_borrow, depender: IncrementalSemanticQueryId, dependencies: darray[IncrementalSemanticQueryId]&) -> bool:
            can Abort.Panic:
                edge_cursor: mutable IncrementalSemanticDependencyEdgeId = session.query_nodes[depender.value.usize()].first_dependency
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |session, depender, edge_cursor|:
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                    next_edge: IncrementalSemanticDependencyEdgeId = edge.next_dependency
                    if not ifq_query_note_incoming_edge_change(session, edge.dependee, false):
                        session.query_graph_poisoned <- true
                        return false
                    if edge.previous_depender.value == INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_nodes[edge.dependee.value.usize()].first_depender <- edge.next_depender
                    else:
                        session.query_edges[edge.previous_depender.value.usize()].next_depender <- edge.next_depender
                    if edge.next_depender.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_edges[edge.next_depender.value.usize()].previous_depender <- edge.previous_depender
                    session.query_edges[edge_cursor.value.usize()] <- IncrementalSemanticDependencyEdge{depender: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, dependee: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, observed_result_generation: 0}
                    session.free_query_edges.push(edge_cursor)
                    edge_cursor <- next_edge
                session.query_nodes[depender.value.usize()].first_dependency <- IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}
                for index in 0..<dependencies.count |session, depender, dependencies|:
                    dependency: IncrementalSemanticQueryId = dependencies[index]
                    if not ifq_query_note_incoming_edge_change(session, dependency, true):
                        session.query_graph_poisoned <- true
                        return false
                    edge_id: mutable IncrementalSemanticDependencyEdgeId
                    if session.free_query_edges.count > 0:
                        edge_id <- session.free_query_edges.pop()
                    else:
                        edge_id <- IncrementalSemanticDependencyEdgeId{value: session.query_edges.count.u32()}
                        session.query_edges.push(IncrementalSemanticDependencyEdge{depender: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, dependee: IncrementalSemanticQueryId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_dependency: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, observed_result_generation: 0})
                    outgoing_head: IncrementalSemanticDependencyEdgeId = session.query_nodes[depender.value.usize()].first_dependency
                    incoming_head: IncrementalSemanticDependencyEdgeId = session.query_nodes[dependency.value.usize()].first_depender
                    session.query_edges[edge_id.value.usize()] <- IncrementalSemanticDependencyEdge{depender: depender, dependee: dependency, next_dependency: outgoing_head, previous_depender: IncrementalSemanticDependencyEdgeId{value: INCREMENTAL_SEMANTIC_QUERY_NONE}, next_depender: incoming_head, observed_result_generation: session.query_nodes[dependency.value.usize()].result_generation}
                    if incoming_head.value != INCREMENTAL_SEMANTIC_QUERY_NONE:
                        session.query_edges[incoming_head.value.usize()].previous_depender <- edge_id
                    session.query_nodes[depender.value.usize()].first_dependency <- edge_id
                    session.query_nodes[dependency.value.usize()].first_depender <- edge_id
                return true

        # Refresh only the observed result generations on an already validated edge set.
        # The caller admits this path only when dependency IDs are equal and every target is
        # Green; cap the walk by the same per-query dependency limit used by that validation.
        def ifq_refresh_dependency_generations[@session, @session_borrow](session: mutable IncrementalSemanticSession[session]& @session_borrow, depender: IncrementalSemanticQueryId, expected_count: usize) -> bool:
            can Abort.Panic:
                return false if expected_count > INCREMENTAL_SEMANTIC_QUERY_PER_DEPENDENCY_LIMIT
                edge_cursor: mutable IncrementalSemanticDependencyEdgeId = session.query_nodes[depender.value.usize()].first_dependency
                steps: mutable usize = 0
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |session, depender, edge_cursor, steps|:
                    if not ifq_edge_links_are_valid(session, edge_cursor):
                        session.query_graph_poisoned <- true
                        return false
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                    if edge.depender.value != depender.value:
                        session.query_graph_poisoned <- true
                        return false
                    dependency_node: IncrementalSemanticQueryNode = session.query_nodes[edge.dependee.value.usize()]
                    if not dependency_node.has_committed_value or dependency_node.result_generation == 0 or dependency_node.status != IncrementalSemanticQueryStatus.Green or not ifq_query_node_value_state_is_valid(session, dependency_node):
                        session.query_graph_poisoned <- true
                        return false
                    steps <- steps + 1
                    if steps > expected_count:
                        session.query_graph_poisoned <- true
                        return false
                    edge_cursor <- edge.next_dependency
                if steps != expected_count:
                    session.query_graph_poisoned <- true
                    return false
                edge_cursor <- session.query_nodes[depender.value.usize()].first_dependency
                while edge_cursor.value != INCREMENTAL_SEMANTIC_QUERY_NONE |session, depender, edge_cursor|:
                    edge: IncrementalSemanticDependencyEdge = session.query_edges[edge_cursor.value.usize()]
                    dependency_node: IncrementalSemanticQueryNode = session.query_nodes[edge.dependee.value.usize()]
                    session.query_edges[edge_cursor.value.usize()].observed_result_generation <- dependency_node.result_generation
                    edge_cursor <- edge.next_dependency
                return true

        def ifq_query_commit[@session, @session_borrow, @input_region, @dependency_region, @result_region](session: mutable IncrementalSemanticSession[session]& @session_borrow, handle: IncrementalSemanticQueryHandle, input: darray[u8]& @input_region, dependencies: darray[IncrementalSemanticQueryHandle]& @dependency_region, canonical_result: darray[u8]& @result_region) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return false if input.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return false if canonical_result.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                return false if not ifq_query_handle_is_valid(session, handle)
                query_id: IncrementalSemanticQueryId = handle.node
                node: IncrementalSemanticQueryNode = session.query_nodes[query_id.value.usize()]
                check: IncrementalSemanticQueryDependencyCheck = ifq_query_dependencies_check(session, query_id, dependencies)
                if not check.valid:
                    if check.structural:
                        session.query_graph_poisoned <- true
                    else:
                        _ = ifq_query_mark_stale(session, query_id)
                    return false
                if not check.all_dependencies_green:
                    _ = ifq_query_mark_stale(session, query_id)
                    return false
                dependency_replacement_required: bool = not check.equal
                dependency_generation_refresh_required: bool = check.equal and not check.results_current and check.all_dependencies_green
                if dependency_replacement_required:
                    for index in 0..<check.unique_count |session, check, query_id|:
                        walk: IncrementalSemanticQueryWalkResult = ifq_query_walk_path(session, check.dependency_ids[index], query_id)
                        if not walk.valid:
                            session.query_graph_poisoned <- true
                            return false
                        if not walk.budget_ok:
                            ifq_clear_session_graph(session)
                            return false
                        if walk.reaches_target:
                            _ = ifq_query_mark_stale(session, query_id)
                            return false
                if not ifq_query_node_value_state_is_valid(session, node):
                    session.query_graph_poisoned <- true
                    return false
                candidate_input_fingerprint: u64 = ifq_query_value_hash(input)
                candidate_result_fingerprint: u64 = ifq_query_value_hash(canonical_result)
                input_changed: mutable bool = not node.has_committed_value
                if node.has_committed_value:
                    input_changed <- true if node.input_fingerprint != candidate_input_fingerprint
                    input_changed <- true if node.input_fingerprint == candidate_input_fingerprint and not ifq_query_value_equals(session, node.input_start.usize(), node.input_length.usize(), input)
                result_changed: mutable bool = not node.has_committed_value
                if node.has_committed_value:
                    result_changed <- true if node.result_fingerprint != candidate_result_fingerprint
                    result_changed <- true if node.result_fingerprint == candidate_result_fingerprint and not ifq_query_value_equals(session, node.result_start.usize(), node.result_length.usize(), canonical_result)
                if result_changed and node.result_generation == 18446744073709551615:
                    ifq_clear_session_graph(session)
                    return false
                if dependency_replacement_required and not ifq_free_query_edges_valid_for_replacement(session, check.unique_count, check.old_count):
                    session.query_graph_poisoned <- true
                    return false
                share_input_result: bool = ifq_query_bytes_equal(input, canonical_result)
                new_value_bytes: mutable usize = 0
                if input_changed:
                    return false if input.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                    new_value_bytes <- input.count
                if result_changed and not share_input_result:
                    return false if new_value_bytes > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                    return false if canonical_result.count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT - new_value_bytes
                    new_value_bytes <- new_value_bytes + canonical_result.count
                append_edges: usize = check.unique_count - (session.free_query_edges.count + check.old_count) if check.unique_count > session.free_query_edges.count + check.old_count else 0
                extra_free_edges: usize = check.old_count if dependency_replacement_required else 0
                extra_edges: usize = append_edges if dependency_replacement_required else 0
                if not ifq_graph_within_limit(session, 0, new_value_bytes, 0, extra_edges, extra_free_edges, 0):
                    # Discard the logical graph on admission overflow. This invalidates
                    # every outstanding handle and lets a later request rebuild within
                    # the same bounded session instead of failing forever at the cap.
                    ifq_clear_session_graph(session)
                    return false
                input_start: mutable usize = node.input_start.usize()
                result_start: mutable usize = node.result_start.usize()
                value_cursor: mutable usize = session.query_value_bytes.count
                if input_changed:
                    input_start <- value_cursor
                    value_cursor <- value_cursor + input.count
                if result_changed:
                    if share_input_result:
                        result_start <- input_start
                    else:
                        result_start <- value_cursor
                        value_cursor <- value_cursor + canonical_result.count
                return false if input_changed and not ifq_query_span_fits_u32(input_start, input.count)
                return false if result_changed and not ifq_query_span_fits_u32(result_start, canonical_result.count)
                session.query_value_bytes.reserve(session.query_value_bytes.count + new_value_bytes)
                if dependency_replacement_required:
                    session.query_edges.reserve(session.query_edges.count + append_edges)
                    session.free_query_edges.reserve(session.free_query_edges.count + check.old_count)
                if result_changed and not ifq_mark_reverse_closure(session, query_id, IncrementalSemanticQueryStatus.PotentiallyDirty):
                    return false
                if dependency_replacement_required:
                    return false if not ifq_apply_dependency_set(session, query_id, check.dependency_ids)
                if input_changed:
                    session.query_value_bytes.extend(input)
                session.query_value_bytes.extend(canonical_result) if result_changed and not share_input_result
                session.query_nodes[query_id.value.usize()].has_committed_value <- true
                session.query_nodes[query_id.value.usize()].input_start <- input_start.u32()
                session.query_nodes[query_id.value.usize()].input_length <- input.count.u32()
                session.query_nodes[query_id.value.usize()].result_start <- result_start.u32()
                session.query_nodes[query_id.value.usize()].result_length <- canonical_result.count.u32()
                session.query_nodes[query_id.value.usize()].input_fingerprint <- candidate_input_fingerprint
                session.query_nodes[query_id.value.usize()].result_fingerprint <- candidate_result_fingerprint
                session.query_nodes[query_id.value.usize()].result_generation <- session.query_nodes[query_id.value.usize()].result_generation + 1 if result_changed
                if dependency_generation_refresh_required and not ifq_refresh_dependency_generations(session, query_id, check.unique_count):
                    return false
                session.query_nodes[query_id.value.usize()].status <- IncrementalSemanticQueryStatus.Green
                return true

        def ifq_clear_session_graph[@session, @session_borrow](session: mutable IncrementalSemanticSession[session]& @session_borrow) -> void can[Memory.Allocate]:
            session.query_key_bytes.truncate(0)
            session.query_key_heads.clear()
            session.query_nodes.truncate(0)
            session.query_edges.truncate(0)
            session.free_query_edges.truncate(0)
            session.query_dependencies_scratch.truncate(0)
            session.query_probe_key_scratch.truncate(0)
            session.query_value_bytes.truncate(0)
            session.query_request_generation <- 0
            session.query_invalidation_generation <- 0
            session.query_invalidation_worklist.truncate(0)
            if session.query_graph_generation == 0 or session.query_graph_generation == 18446744073709551615:
                session.query_graph_generation <- 0
                session.query_graph_poisoned <- true
            else:
                session.query_graph_generation <- session.query_graph_generation + 1
                session.query_graph_poisoned <- false

        def ifc_session_clear_prior[@session](session: mutable IncrementalSemanticSession[session]& @session) -> void:
            can Memory.Allocate:
                session.valid <- false
                session.analyzed_source.truncate(0)
                session.identity_key.truncate(0)
                session.options_key.truncate(0)
                session.generated_input <- false
                session.semantic_fingerprint <- 0
                session.snapshot.schema_version <- 0
                session.snapshot.semantic_fingerprint <- 0
                session.snapshot.options_fingerprint <- 0
                session.snapshot.options_key.truncate(0)
                session.snapshot.bytes.truncate(0)
                session.snapshot.source_path_start <- 0
                session.snapshot.source_path_length <- 0
                session.snapshot.declaration_surface_start <- 0
                session.snapshot.declaration_surface_length <- 0
                session.snapshot.declaration_surface_hash <- 0
                session.snapshot.functions.truncate(0)
                session.snapshot.direct_facts.truncate(0)
                session.snapshot.active_grants.truncate(0)
                session.snapshot.self_assignment_ranges.truncate(0)
                session.snapshot.self_assignment_facts.truncate(0)
                session.snapshot.bodies_visited <- 0
                session.snapshot.bodies_matched <- 0
                session.snapshot.bodies_rejected <- 0
                session.snapshot.self_assignment_bodies_scanned <- 0
                session.snapshot.self_assignment_bodies_reused <- 0
                session.snapshot.declaration_surface_valid <- false
                session.snapshot.surface_compatible <- false

        def ifc_session_source_matches[@session](session: IncrementalSemanticSession[session]& @session, source: u8&, source_length: usize) -> bool:
            can Abort.Panic, Unsafe.PointerArithmetic:
                return false if source_length != session.analyzed_source.count
                for index in 0..<source_length |session, source|:
                    current_byte: u8& = source + index
                    current_value: u8 = current_byte
                    return false if session.analyzed_source[index] != current_value
                return true

        def ifc_session_key_matches(stored: darray[u8]&, current: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if stored.count != current.count
                for index in 0..<current.count:
                    return false if stored[index] != current[index]
                return true

        # Copy from the session-owned region into a fresh request snapshot. Rebinding
        # anchors and checker updates then cannot mutate trusted retained facts.
        def ifc_clone_session_snapshot[@r, @output](source: mutable IncrementalSemanticSessionSnapshot[r]&) -> IncrementalSemanticSnapshot[output] @output:
            can Memory.Allocate, Abort.Panic:
                options_key: mutable darray[u8] @output = []
                bytes: mutable darray[u8] @output = []
                functions: mutable darray[IncrementalFunctionFactRecord] @output = []
                current_anchors: mutable darray[IncrementalFunctionSourceAnchor] @output = []
                direct_facts: mutable darray[IncrementalDirectFact] @output = []
                active_grants: mutable darray[IncrementalActiveGrant] @output = []
                self_assignment_ranges: mutable darray[IncrementalSelfAssignmentFactRange] @output = []
                self_assignment_facts: mutable darray[IncrementalSelfAssignmentFact] @output = []
                current_self_assignment_anchors: mutable darray[IncrementalSelfAssignmentAnchor] @output = []
                options_key.reserve(source.options_key.count)
                options_key.extend(source.options_key)
                bytes.reserve(source.bytes.count)
                bytes.extend(source.bytes)
                functions.reserve(source.functions.count)
                for record in source.functions |functions|:
                    functions.push(record)
                direct_facts.reserve(source.direct_facts.count)
                for fact in source.direct_facts |direct_facts|:
                    direct_facts.push(fact)
                active_grants.reserve(source.active_grants.count)
                for grant in source.active_grants |active_grants|:
                    active_grants.push(grant)
                self_assignment_ranges.reserve(source.self_assignment_ranges.count)
                for range in source.self_assignment_ranges |self_assignment_ranges|:
                    self_assignment_ranges.push(range)
                self_assignment_facts.reserve(source.self_assignment_facts.count)
                for fact in source.self_assignment_facts |self_assignment_facts|:
                    self_assignment_facts.push(fact)
                return IncrementalSemanticSnapshot{schema_version: source.schema_version, semantic_fingerprint: source.semantic_fingerprint, options_fingerprint: source.options_fingerprint, options_key: options_key, bytes: bytes, source_path_start: source.source_path_start, source_path_length: source.source_path_length, declaration_surface_start: source.declaration_surface_start, declaration_surface_length: source.declaration_surface_length, declaration_surface_hash: source.declaration_surface_hash, functions: functions, current_anchors: current_anchors, direct_facts: direct_facts, active_grants: active_grants, self_assignment_ranges: self_assignment_ranges, self_assignment_facts: self_assignment_facts, current_self_assignment_anchors: current_self_assignment_anchors, bodies_visited: 0, bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_scanned: 0, self_assignment_bodies_reused: 0, declaration_surface_valid: source.declaration_surface_valid, surface_compatible: source.surface_compatible}

        # Copy portable facts into storage whose element buffers are statically tied to the
        # session region. No request-local source anchors or sview names enter durable state.
        def ifc_clone_session_snapshot_into[@session, @source_region](source: IncrementalSemanticSnapshot[source_region]&, destination: mutable IncrementalSemanticSessionSnapshot[session]& @session) -> void:
            can Memory.Allocate, Abort.Panic:
                destination.schema_version <- source.schema_version
                destination.semantic_fingerprint <- source.semantic_fingerprint
                destination.options_fingerprint <- source.options_fingerprint
                destination.source_path_start <- source.source_path_start
                destination.source_path_length <- source.source_path_length
                destination.declaration_surface_start <- source.declaration_surface_start
                destination.declaration_surface_length <- source.declaration_surface_length
                destination.declaration_surface_hash <- source.declaration_surface_hash
                destination.declaration_surface_valid <- source.declaration_surface_valid
                destination.options_key.truncate(0)
                destination.options_key.reserve(source.options_key.count)
                destination.options_key.extend(source.options_key)
                destination.bytes.truncate(0)
                destination.bytes.reserve(source.bytes.count)
                destination.bytes.extend(source.bytes)
                destination.functions.truncate(0)
                destination.functions.reserve(source.functions.count)
                for record in source.functions |destination|:
                    destination.functions.push(record)
                destination.direct_facts.truncate(0)
                destination.direct_facts.reserve(source.direct_facts.count)
                for fact in source.direct_facts |destination|:
                    destination.direct_facts.push(fact)
                destination.active_grants.truncate(0)
                destination.active_grants.reserve(source.active_grants.count)
                for grant in source.active_grants |destination|:
                    destination.active_grants.push(grant)
                destination.self_assignment_ranges.truncate(0)
                destination.self_assignment_ranges.reserve(source.self_assignment_ranges.count)
                for range in source.self_assignment_ranges |destination|:
                    destination.self_assignment_ranges.push(range)
                destination.self_assignment_facts.truncate(0)
                destination.self_assignment_facts.reserve(source.self_assignment_facts.count)
                for fact in source.self_assignment_facts |destination|:
                    destination.self_assignment_facts.push(fact)
                destination.bodies_visited <- 0
                destination.bodies_matched <- 0
                destination.bodies_rejected <- 0
                destination.self_assignment_bodies_scanned <- 0
                destination.self_assignment_bodies_reused <- 0
                destination.surface_compatible <- source.surface_compatible

        def ifc_session_store[@session, @snapshot_region](session: mutable IncrementalSemanticSession[session]& @session, source: u8&, source_length: usize, identity_key: darray[u8]&, options_key: darray[u8]&, generated_input: bool, semantic_fingerprint: u64, snapshot: IncrementalSemanticSnapshot[snapshot_region]&) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerArithmetic:
                if not session.enabled:
                    incremental_semantic_session_reset(session)
                    return false
                encoded_size: IncrementalSnapshotSizeResult = incremental_snapshot_encoded_size(snapshot)
                return false if not encoded_size.valid
                size: mutable usize = source_length
                return false if size > INCREMENTAL_SNAPSHOT_CODEC_LIMIT
                return false if identity_key.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                size <- size + identity_key.count
                return false if options_key.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                size <- size + options_key.count
                linter_extra: u64 = snapshot.self_assignment_facts.count.u64() * 96 + snapshot.self_assignment_ranges.count.u64() * 32
                return false if linter_extra > (INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size).u64()
                size <- size + linter_extra.usize()
                return false if encoded_size.byte_count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - size
                source_bytes: mutable sview? = null
                if source_length > 0:
                    source_bytes <- Lexer::make_source_view(source, source_length, 0, source_length)
                    return false if source_bytes is null
                # Reserve every retained destination before invalidating the prior
                # snapshot. A rejected size leaves the prior snapshot authoritative;
                # its query graph is poisoned by the caller until another commit.
                session.analyzed_source.reserve(source_length)
                session.identity_key.reserve(identity_key.count)
                session.options_key.reserve(options_key.count)
                session.snapshot.options_key.reserve(options_key.count)
                session.snapshot.bytes.reserve(snapshot.bytes.count)
                session.snapshot.functions.reserve(snapshot.functions.count)
                session.snapshot.direct_facts.reserve(snapshot.direct_facts.count)
                session.snapshot.active_grants.reserve(snapshot.active_grants.count)
                session.snapshot.self_assignment_ranges.reserve(snapshot.self_assignment_ranges.count)
                session.snapshot.self_assignment_facts.reserve(snapshot.self_assignment_facts.count)
                ifc_session_clear_prior(session)
                if source_bytes is source_text:
                    session.analyzed_source.extend(source_text)
                session.identity_key.extend(identity_key)
                session.options_key.extend(options_key)
                ifc_clone_session_snapshot_into(snapshot, &session.snapshot)
                session.generated_input <- generated_input
                session.semantic_fingerprint <- semantic_fingerprint
                if session.query_graph_enabled:
                    if session.query_graph_poisoned:
                        ifq_clear_session_graph(session)
                    if session.query_context_generation == 18446744073709551615:
                        ifq_clear_session_graph(session)
                        session.query_context_generation <- 1
                    else:
                        session.query_context_generation <- session.query_context_generation + 1
                session.valid <- true
                return true

        # Collection already evaluated the exact body bytes and restored its canonical
        # facts. The same request-local snapshot is passed unchanged through session_store;
        # this proof permits skipping only the duplicate body evaluation after the expected
        # context bump. It is rejected after graph clear, source/result change, or poisoning.
        def ifc_validated_body_query_hit_is_current[@session, @metrics_region, @hits_region, @key_region, @dependencies_region](session: mutable IncrementalSemanticSession[session]& @session, request_metrics: IncrementalFunctionFactsRequestMetrics& @metrics_region, validated_body_query_hits: darray[IncrementalSemanticBodyQueryHitMarker]& @hits_region, record_index: usize, record: IncrementalFunctionFactRecord, query_key: darray[u8]& @key_region, query_handle: IncrementalSemanticQueryHandle, dependencies: darray[IncrementalSemanticQueryHandle]& @dependencies_region, source_result_generation: u64, requires_source_input: bool) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return false if session.query_graph_poisoned
                return false if request_metrics.validated_body_query_generation != session.query_graph_generation
                return false if not ifq_query_handle_is_valid(session, query_handle)
                # Collection appends at most one marker per function record, in
                # increasing record order. Lower-bound the sparse list so a warm
                # request does not scan N markers once for each of N cacheable bodies.
                low: mutable usize = 0
                high: mutable usize = validated_body_query_hits.count
                while low < high |low, high, validated_body_query_hits, record_index|:
                    middle: usize = low + (high - low) / 2
                    marker: IncrementalSemanticBodyQueryHitMarker = validated_body_query_hits[middle]
                    if marker.function_record_index < record_index:
                        low <- middle + 1
                    else:
                        high <- middle
                return false if low >= validated_body_query_hits.count
                marker: IncrementalSemanticBodyQueryHitMarker = validated_body_query_hits[low]
                return false if not marker.direct_facts_restored
                return false if marker.function_record_index != record_index or marker.query_id.value != query_handle.node.value
                return false if marker.requires_source_input != requires_source_input
                return false if marker.graph_generation != session.query_graph_generation
                if marker.requires_source_input:
                    return false if not request_metrics.source_input_admitted or marker.source_result_generation != source_result_generation
                else:
                    return false if marker.source_result_generation != 0 or source_result_generation != 0 or dependencies.count != 0
                return false if marker.body_start != record.body_start or marker.body_length != record.body_length
                # The query handle was acquired from this exact kind/key lookup, and the
                # marker ID must equal that handle above. Recheck kind, length, and bytes
                # directly without hashing the body key a second time.
                return false if not ifq_query_key_bytes_match(session, marker.query_id, IncrementalSemanticQueryKind.FunctionBodyFacts, query_key)
                node: IncrementalSemanticQueryNode = session.query_nodes[marker.query_id.value.usize()]
                return false if node.status != IncrementalSemanticQueryStatus.Green or not node.has_committed_value
                return false if node.result_generation != marker.query_result_generation or not ifq_query_node_value_state_is_valid(session, node)
                dependency_check: IncrementalSemanticQueryDependencyCheck = ifq_query_dependencies_check_for_read(session, marker.query_id, dependencies)
                return false if not dependency_check.valid or not dependency_check.equal or not dependency_check.results_current or not dependency_check.all_dependencies_green
                return true

        # Publish graph values only after ifc_session_store has made this exact snapshot
        # authoritative. Query handles are reacquired under the committed context.
        def ifc_publish_query_graph_once[@session, @snapshot_region, @identity_region, @path_region, @metrics_region, @hits_region](session: mutable IncrementalSemanticSession[session]& @session, snapshot: IncrementalSemanticSnapshot[snapshot_region]& @snapshot_region, identity_key: darray[u8]& @identity_region, source_path: sview @path_region, request_metrics: mutable IncrementalFunctionFactsRequestMetrics& @metrics_region, validated_body_query_hits: darray[IncrementalSemanticBodyQueryHitMarker]& @hits_region) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                return false if not session.enabled or not session.query_graph_enabled or not session.valid or not snapshot.declaration_surface_valid
                return false if snapshot.declaration_surface_start > snapshot.bytes.count or snapshot.declaration_surface_length > snapshot.bytes.count - snapshot.declaration_surface_start
                return false if not incremental_semantic_query_begin_request(session)
                requires_source_input: mutable bool = false
                for record_index in 0..<snapshot.functions.count |requires_source_input|:
                    requires_source_input <- true if snapshot.functions[record_index].cacheable and not snapshot.functions[record_index].complete_empty_body and not ifc_record_is_zero_fact_surface_independent(snapshot, record_index)
                source_input_available: mutable bool = false
                source_input_hit_current: mutable bool = false
                source_handle: mutable IncrementalSemanticQueryHandle = ifq_query_handle_invalid()
                if requires_source_input and ifq_source_query_key_fits(identity_key, source_path) and ifq_source_query_value_fits(snapshot.options_key.count, snapshot.declaration_surface_length):
                    session.query_probe_key_scratch.truncate(0)
                    ifq_source_query_key_into(session.query_probe_key_scratch, identity_key, source_path)
                    source_value: mutable darray[u8] @snapshot_region = []
                    if ifq_source_query_value_from_span_into(source_value, snapshot.options_key, snapshot.bytes, snapshot.declaration_surface_start, snapshot.declaration_surface_length):
                        source_handle <- incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.SourceInput, session.query_probe_key_scratch)
                        session.query_probe_key_scratch.truncate(0)
                        session.query_dependencies_scratch.truncate(0)
                        source_evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, source_handle, source_value, session.query_dependencies_scratch)
                        source_input_hit_current <- source_evaluation.hit and ifq_query_value_equals(session, source_evaluation.result_start, source_evaluation.result_length, source_value)
                        if source_input_hit_current or ifq_query_commit(session, source_handle, source_value, session.query_dependencies_scratch, source_value):
                            source_input_available <- true
                        else:
                            return false
                session.query_dependencies_scratch.truncate(0)
                body_query_publish_skips: mutable u32 = 0
                complete_empty_body_publish_skips: mutable u32 = 0
                complete_empty_body_commits: mutable u32 = 0
                zero_fact_body_publish_skips: mutable u32 = 0
                zero_fact_body_commits: mutable u32 = 0
                for record_index in 0..<snapshot.functions.count |session, snapshot, identity_key, source_path, source_handle, source_input_available, source_input_hit_current, request_metrics, body_query_publish_skips, complete_empty_body_publish_skips, complete_empty_body_commits, zero_fact_body_publish_skips, zero_fact_body_commits|:
                    record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                    continue if not record.cacheable
                    zero_fact_body: bool = ifc_record_is_zero_fact_surface_independent(snapshot, record_index)
                    source_independent_body: bool = record.complete_empty_body or zero_fact_body
                    continue if not source_independent_body and not source_input_available
                    continue if not ifq_function_query_key_fits(record)
                    continue if record.body_length > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT
                    return false if record.body_start > snapshot.bytes.count or record.body_length > snapshot.bytes.count - record.body_start
                    # Check the canonical value size before interning a key. An
                    # unpublishable record must not leave a key-only FunctionBodyFacts
                    # node in the graph, where it could consume node/key budget and be
                    # mistaken for a reusable query on a later request.
                    result_size: IncrementalSemanticQueryValueSize = ifq_direct_facts_result_size(snapshot, record_index)
                    continue if not result_size.valid
                    # Query values share one bounded append-only store. A body and
                    # its canonical facts result must fit together before key
                    # interning; otherwise commit would clear the whole graph and
                    # force the caller through the cold fallback for every body.
                    continue if result_size.byte_count > INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT - record.body_length
                    continue if not ifq_function_query_key_into(session.query_probe_key_scratch, snapshot, record)
                    query_handle: IncrementalSemanticQueryHandle = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.FunctionBodyFacts, session.query_probe_key_scratch)
                    session.query_dependencies_scratch.truncate(0)
                    session.query_dependencies_scratch.push(source_handle) if not source_independent_body
                    source_result_generation: mutable u64 = 0
                    if not source_independent_body and source_input_available:
                        source_node: IncrementalSemanticQueryNode = session.query_nodes[source_handle.node.value.usize()]
                        source_result_generation <- source_node.result_generation
                    skip_publish: bool = (source_independent_body or source_input_hit_current) and ifc_validated_body_query_hit_is_current[session, metrics_region, hits_region, session, session](session, request_metrics, validated_body_query_hits, record_index, record, session.query_probe_key_scratch, query_handle, session.query_dependencies_scratch, source_result_generation, not source_independent_body)
                    session.query_probe_key_scratch.truncate(0)
                    if skip_publish:
                        if record.complete_empty_body:
                            ifc_increment_candidate_metric(&complete_empty_body_publish_skips, snapshot.functions.count)
                        elif zero_fact_body:
                            ifc_increment_candidate_metric(&zero_fact_body_publish_skips, snapshot.functions.count)
                        else:
                            ifc_increment_candidate_metric(&body_query_publish_skips, snapshot.functions.count)
                        continue
                    query_evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate_span_with_hash(session, query_handle, snapshot.bytes, record.body_start, record.body_length, record.body_hash, session.query_dependencies_scratch)
                    if not query_evaluation.hit:
                        canonical_result: mutable darray[u8] @snapshot_region = []
                        return false if not ifq_append_direct_facts_result(snapshot, record_index, &canonical_result)
                        body_input: darray[u8] @snapshot_region = ifq_snapshot_span_copy(snapshot.bytes, record.body_start, record.body_length)
                        if not ifq_query_commit(session, query_handle, body_input, session.query_dependencies_scratch, canonical_result):
                            return false
                        if record.complete_empty_body:
                            ifc_increment_candidate_metric(&complete_empty_body_commits, snapshot.functions.count)
                        elif zero_fact_body:
                            ifc_increment_candidate_metric(&zero_fact_body_commits, snapshot.functions.count)
                request_metrics.body_query_publish_skips <- body_query_publish_skips
                request_metrics.complete_empty_body_publish_skips <- complete_empty_body_publish_skips
                request_metrics.complete_empty_body_commits <- complete_empty_body_commits
                request_metrics.zero_fact_body_publish_skips <- zero_fact_body_publish_skips
                request_metrics.zero_fact_body_commits <- zero_fact_body_commits
                return true

        # query_value_bytes is append-only during a request. When historical values fill
        # its logical budget, clear the graph and rebuild from the current committed
        # snapshot once. If that working set itself does not fit, leave the graph empty;
        # the exact semantic snapshot remains available to its existing cold-safe path.
        def ifc_publish_query_graph[@session, @snapshot_region, @identity_region, @path_region, @metrics_region, @hits_region](session: mutable IncrementalSemanticSession[session]& @session, snapshot: IncrementalSemanticSnapshot[snapshot_region]& @snapshot_region, identity_key: darray[u8]& @identity_region, source_path: sview @path_region, request_metrics: mutable IncrementalFunctionFactsRequestMetrics& @metrics_region, validated_body_query_hits: darray[IncrementalSemanticBodyQueryHitMarker]& @hits_region) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                # Do not erase a healthy retained graph when this request can never
                # publish SourceInput (for example, an over-budget declaration surface).
                # The retry path below is reserved for graph admission/corruption failures
                # after predictable request-shape checks have passed.
                return false if not session.enabled or not session.query_graph_enabled or not session.valid
                return false if not snapshot.declaration_surface_valid
                return false if snapshot.declaration_surface_start > snapshot.bytes.count or snapshot.declaration_surface_length > snapshot.bytes.count - snapshot.declaration_surface_start
                return true if ifc_publish_query_graph_once[session, snapshot_region, identity_region, path_region, metrics_region, hits_region](session, snapshot, identity_key, source_path, request_metrics, validated_body_query_hits)
                ifq_clear_session_graph(session)
                return true if ifc_publish_query_graph_once[session, snapshot_region, identity_region, path_region, metrics_region, hits_region](session, snapshot, identity_key, source_path, request_metrics, validated_body_query_hits)
                ifq_clear_session_graph(session)
                return false

    public:
        # This is the only API that can advance trusted process-local provenance. The prior
        # snapshot is private and reaches allow_session_reuse only after its exact context
        # has matched. Sidecar snapshots continue through the rescan-only API.
        def incremental_collect_function_facts_with_session[@session, @input_source, @output](file: Ast::File& @input_source, source: u8& @input_source, source_length: usize, tokens: darray[Lexer::Token]& @input_source, source_path: sview @output, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, identity_key: darray[u8]& @output, generated_input: bool, session: mutable IncrementalSemanticSession[session]& @session) -> IncrementalSessionCollectionResult[output] @output:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerArithmetic, Global{Read,Write}, Unsafe.PointerCast:
                if not session.enabled:
                    return IncrementalSessionCollectionResult[output]{snapshot: incremental_empty_snapshot[output](), prior_valid: false, exact_hit: false, body_facts_reused: false, function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false, complete_empty_body_eligible: 0, complete_empty_body_restored: 0, complete_empty_body_publish_skips: 0, complete_empty_body_commits: 0, zero_fact_body_eligible: 0, zero_fact_body_restored: 0, zero_fact_body_publish_skips: 0, zero_fact_body_commits: 0}
                context_matches: mutable bool = session.valid
                context_matches <- false if session.semantic_fingerprint != semantic_fingerprint or session.generated_input != generated_input
                context_matches <- false if not ifc_session_key_matches(session.options_key, options_key)
                context_matches <- false if not ifc_session_key_matches(session.identity_key, identity_key)
                context_matches <- false if session.snapshot.schema_version != INCREMENTAL_FUNCTION_FACTS_SCHEMA
                context_matches <- false if session.snapshot.semantic_fingerprint != semantic_fingerprint or session.snapshot.options_fingerprint != options_fingerprint
                context_matches <- false if not ifc_session_key_matches(session.snapshot.options_key, options_key)
                if not context_matches:
                    incremental_semantic_session_reset(session)
                else:
                    prior_clone_span: PhaseTimer::Span = PhaseTimer::begin_span()
                    prior_slots: mutable darray[IncrementalSemanticSnapshot[output]] @output = [ifc_clone_session_snapshot[session, output](&session.snapshot)]
                    PhaseTimer::end_span("incremental-session-prior-clone", prior_clone_span)
                    if ifc_session_source_matches(session, source, source_length):
                        if ifc_equal_view(prior_slots[0].bytes, prior_slots[0].source_path_start, prior_slots[0].source_path_length, source_path):
                            exact_reanchor_span: PhaseTimer::Span = PhaseTimer::begin_span()
                            exact_reanchored: mutable bool = false
                            region reanchor_plan_scratch:
                                # Keep the O(function/fact) plan arrays in this call-local
                                # region. After validation, copy only scalar records into the
                                # request-owned snapshot, then reclaim the scratch before any
                                # later backend work retains the output region.
                                reanchor_plan_slots: mutable darray[IncrementalExactReanchorPlan[reanchor_plan_scratch]] @reanchor_plan_scratch = [IncrementalExactReanchorPlan[reanchor_plan_scratch]{reset_self_assignment_stream: false, current_anchors: [], current_self_assignment_anchors: [], self_assignment_ranges: [], bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_reused: 0, surface_compatible: false}]
                                if incremental_build_exact_reanchor_plan[output, input_source, reanchor_plan_scratch](file, tokens, &prior_slots[0], &reanchor_plan_slots[0]):
                                    in output:
                                        assert prior_slots[0].current_anchors.count == 0
                                        assert prior_slots[0].current_self_assignment_anchors.count == 0
                                        prior_slots[0].current_anchors.reserve(reanchor_plan_slots[0].current_anchors.count)
                                        for anchor in reanchor_plan_slots[0].current_anchors |prior_slots, reanchor_plan_slots|:
                                            prior_slots[0].current_anchors.push(anchor)
                                        prior_slots[0].current_self_assignment_anchors.reserve(reanchor_plan_slots[0].current_self_assignment_anchors.count)
                                        for anchor in reanchor_plan_slots[0].current_self_assignment_anchors |prior_slots, reanchor_plan_slots|:
                                            prior_slots[0].current_self_assignment_anchors.push(anchor)
                                        prior_slots[0].self_assignment_ranges.truncate(0)
                                        prior_slots[0].self_assignment_ranges.reserve(reanchor_plan_slots[0].self_assignment_ranges.count)
                                        for range in reanchor_plan_slots[0].self_assignment_ranges |prior_slots, reanchor_plan_slots|:
                                            prior_slots[0].self_assignment_ranges.push(range)
                                        if reanchor_plan_slots[0].reset_self_assignment_stream:
                                            prior_slots[0].self_assignment_facts.truncate(0)
                                        for record_index in 0..<prior_slots[0].functions.count |prior_slots|:
                                            prior_slots[0].functions[record_index].matched_previous <- prior_slots[0].functions[record_index].cacheable
                                        prior_slots[0].bodies_visited <- 0
                                        prior_slots[0].bodies_matched <- reanchor_plan_slots[0].bodies_matched
                                        prior_slots[0].bodies_rejected <- reanchor_plan_slots[0].bodies_rejected
                                        prior_slots[0].self_assignment_bodies_scanned <- 0
                                        prior_slots[0].self_assignment_bodies_reused <- reanchor_plan_slots[0].self_assignment_bodies_reused
                                        prior_slots[0].surface_compatible <- reanchor_plan_slots[0].surface_compatible
                                    exact_reanchored <- true
                            PhaseTimer::end_span("incremental-session-exact-reanchor", exact_reanchor_span)
                            if exact_reanchored:
                                return ifc_session_collection_result[output](prior_slots[0], true, true, false, 0, 0, 0, 0, false, 0, 0, 0, 0, 0, 0, 0, 0)
                    else:
                        if session.query_graph_enabled:
                            if session.query_graph_poisoned:
                                ifq_clear_session_graph(session)
                            if not incremental_semantic_query_begin_request(session):
                                ifq_clear_session_graph(session)
                                incremental_semantic_query_begin_request(session)
                        request_metrics_hits: mutable darray[IncrementalSemanticBodyQueryHitMarker] @input_source = []
                        request_metrics_slots: mutable darray[IncrementalFunctionFactsRequestMetrics] @output = [IncrementalFunctionFactsRequestMetrics{function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false, validated_body_query_generation: 0, complete_empty_body_eligible: 0, complete_empty_body_restored: 0, complete_empty_body_publish_skips: 0, complete_empty_body_commits: 0, zero_fact_body_eligible: 0, zero_fact_body_restored: 0, zero_fact_body_publish_skips: 0, zero_fact_body_commits: 0}]
                        current_slots: mutable darray[IncrementalSemanticSnapshot[output]] @output = [ifc_collect_function_facts[session, input_source, output, output, output, output, input_source](file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, identity_key, &prior_slots[0], true, true, &request_metrics_slots[0], request_metrics_hits, session)]
                        reused: bool = current_slots[0].bodies_matched > 0 and current_slots[0].bodies_visited < current_slots[0].functions.count
                        stored: bool = ifc_session_store[session, output](session, source, source_length, identity_key, options_key, generated_input, semantic_fingerprint, &current_slots[0])
                        if not stored:
                            incremental_semantic_session_reset(session)
                            ifc_self_assignment_forget[output](&current_slots[0])
                        else:
                            ifc_publish_query_graph[session, output, output, output, output, input_source](session, &current_slots[0], identity_key, source_path, &request_metrics_slots[0], request_metrics_hits)
                        return ifc_session_collection_result[output](current_slots[0], true, false, reused, request_metrics_slots[0].function_body_facts_restored, request_metrics_slots[0].body_query_publish_skips, request_metrics_slots[0].prior_snapshot_fact_fallbacks, request_metrics_slots[0].cold_body_scans, request_metrics_slots[0].source_input_admitted, request_metrics_slots[0].complete_empty_body_eligible, request_metrics_slots[0].complete_empty_body_restored, request_metrics_slots[0].complete_empty_body_publish_skips, request_metrics_slots[0].complete_empty_body_commits, request_metrics_slots[0].zero_fact_body_eligible, request_metrics_slots[0].zero_fact_body_restored, request_metrics_slots[0].zero_fact_body_publish_skips, request_metrics_slots[0].zero_fact_body_commits)
                    incremental_semantic_session_reset(session)
                request_metrics_hits: mutable darray[IncrementalSemanticBodyQueryHitMarker] @input_source = []
                request_metrics_slots: mutable darray[IncrementalFunctionFactsRequestMetrics] @output = [IncrementalFunctionFactsRequestMetrics{function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false, validated_body_query_generation: 0, complete_empty_body_eligible: 0, complete_empty_body_restored: 0, complete_empty_body_publish_skips: 0, complete_empty_body_commits: 0, zero_fact_body_eligible: 0, zero_fact_body_restored: 0, zero_fact_body_publish_skips: 0, zero_fact_body_commits: 0}]
                empty_snapshot_slots: mutable darray[IncrementalSemanticSnapshot[output]] @output = [incremental_empty_snapshot[output]()]
                cold_slots: mutable darray[IncrementalSemanticSnapshot[output]] @output = [ifc_collect_function_facts[session, input_source, output, output, output, output, input_source](file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, identity_key, &empty_snapshot_slots[0], false, false, &request_metrics_slots[0], request_metrics_hits, session)]
                stored: bool = ifc_session_store[session, output](session, source, source_length, identity_key, options_key, generated_input, semantic_fingerprint, &cold_slots[0])
                if not stored:
                    incremental_semantic_session_reset(session)
                    ifc_self_assignment_forget[output](&cold_slots[0])
                else:
                    ifc_publish_query_graph[session, output, output, output, output, input_source](session, &cold_slots[0], identity_key, source_path, &request_metrics_slots[0], request_metrics_hits)
                return ifc_session_collection_result[output](cold_slots[0], false, false, false, request_metrics_slots[0].function_body_facts_restored, request_metrics_slots[0].body_query_publish_skips, request_metrics_slots[0].prior_snapshot_fact_fallbacks, request_metrics_slots[0].cold_body_scans, request_metrics_slots[0].source_input_admitted, request_metrics_slots[0].complete_empty_body_eligible, request_metrics_slots[0].complete_empty_body_restored, request_metrics_slots[0].complete_empty_body_publish_skips, request_metrics_slots[0].complete_empty_body_commits, request_metrics_slots[0].zero_fact_body_eligible, request_metrics_slots[0].zero_fact_body_restored, request_metrics_slots[0].zero_fact_body_publish_skips, request_metrics_slots[0].zero_fact_body_commits)
