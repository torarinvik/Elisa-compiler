# Deprecated `in auto:` block. The implicit-region block was superseded by region inference;
# write nothing (rely on inference) or `region NAME(size):` for an explicit scope. Pure
# syntactic: a `Stmt.Block` of kind "in" whose clause names the region "auto".
extend Semantic:
    private:
        def in_auto_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            is_in_auto: bool = kind == "in" and clause.count > 0 and clause[0] == "auto"
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InAutoDeprecated, name: "", line: line, expected: "", actual: ""}) if is_in_auto
                            table <- in_auto_statements(body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- in_auto_statements(then_body, table)
                            table <- in_auto_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- in_auto_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- in_auto_statements(for_body, table)
                        _:
                            pass

        def check_in_auto_deprecated(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- in_auto_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_in_auto_deprecated(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_in_auto_deprecated(scoped_body, table)
                        _:
                            pass
