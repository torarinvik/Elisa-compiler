# Line-window scans over the parser's local-region annotations.
#
# check_destroyed_region and check_region_storage_stability ask, per use site, which region
# binders are visible between a function's first line and the use line. Each query scanned
# every annotation of the unit (one per region-carrying local), so the passes were
# quadratic. The parser emits annotations in source order, so when the array's lines never
# decrease the rows a query can act on form one contiguous run: binary-search its first
# row and stop after its last. A scan that starts there visits exactly the rows the full
# scan would act on, in the same order.
#
# Whether the array is line-sorted is memoised per array (buffer address, count, first and
# last lines) the way emit_ast_tokens_line_sorted memoises token order; an unsorted array
# keeps the full scan.
global mutable region_annotation_sorted_base: uintptr
global mutable region_annotation_sorted_count: usize
global mutable region_annotation_sorted_first: u32
global mutable region_annotation_sorted_last: u32
global mutable region_annotation_sorted_value: bool

extend Semantic:
    private:
        def region_annotations_line_sorted(annotations: darray[Ast::LocalRegionAnnotation]&) -> bool:
            can Abort.Panic:
                false return if annotations.count == 0
                base: uintptr = (&annotations[0]).cast[uintptr] can Unsafe.PointerCast
                first_line: u32 = annotations[0].line
                last_line: u32 = annotations[annotations.count - 1].line
                if base != region_annotation_sorted_base or annotations.count != region_annotation_sorted_count or first_line != region_annotation_sorted_first or last_line != region_annotation_sorted_last:
                    sorted: mutable bool = true
                    for index in 1..<annotations.count |sorted, annotations|:
                        sorted <- false if annotations[index].line < annotations[index - 1].line
                    region_annotation_sorted_base <- base
                    region_annotation_sorted_count <- annotations.count
                    region_annotation_sorted_first <- first_line
                    region_annotation_sorted_last <- last_line
                    region_annotation_sorted_value <- sorted
                return region_annotation_sorted_value

        # Drop the memo. Called whenever an annotation array is (re)built in place of
        # another: a new array can land at a freed one's address with the same count and end
        # lines yet a different order, and would otherwise reuse its answer.
        def region_annotations_forget_sorted() -> void:
            region_annotation_sorted_base <- 0
            region_annotation_sorted_count <- 0

        # First row a scan restricted to lines >= LOW must visit (0 when unsorted).
        def region_annotation_window_start(annotations: darray[Ast::LocalRegionAnnotation]&, low: u32) -> usize:
            can Abort.Panic:
                0 return if not region_annotations_line_sorted(annotations)
                lower: mutable usize = 0
                upper: mutable usize = annotations.count
                while lower < upper |lower, upper, annotations, low|:
                    middle: usize = lower + (upper - lower) / 2
                    if annotations[middle].line < low:
                        lower <- middle + 1
                    else:
                        upper <- middle
                return lower

        # One past the last row a scan restricted to lines <= HIGH must visit (count when unsorted).
        def region_annotation_window_end(annotations: darray[Ast::LocalRegionAnnotation]&, high: u32) -> usize:
            can Abort.Panic:
                annotations.count return if not region_annotations_line_sorted(annotations)
                lower: mutable usize = 0
                upper: mutable usize = annotations.count
                while lower < upper |lower, upper, annotations, high|:
                    middle: usize = lower + (upper - lower) / 2
                    if annotations[middle].line <= high:
                        lower <- middle + 1
                    else:
                        upper <- middle
                return lower

    public:
        # The [start, end) rows a scan for annotations on LINE must visit: the line's run
        # when the array is line-sorted, else every row. For callers outside the module.
        def region_annotation_line_window(annotations: darray[Ast::LocalRegionAnnotation]&, line: u32) -> (start: usize, end: usize):
            can Abort.Panic:
                return ((region_annotation_window_start(annotations, line) can Global{Read,Write}), (region_annotation_window_end(annotations, line) can Global{Read,Write}))
