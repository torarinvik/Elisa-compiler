# Check for integer literal assignments that cannot fit the target's declared type.
# e.g., x: mutable u8 = 0; x <- 300 (300 does not fit in u8 range 0..255)

extend Semantic:
    private:
        # Helper: find the declared type of a local or parameter by name.
        # Uses parallel arrays: local_names and local_types.
        def find_local_type(name: sview, local_names: darray[sview]&, local_types: darray[sview]&) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                while index < local_names.count:
                    local_types[index] return if local_names[index] == name
                    index <- index + 1
                return ""


        # Helper: check if an integer literal value fits in a type's range.
        # Only handles the six target types: u8, u16, u32, i8, i16, i32.
        # Returns true if the value fits, false if it's out of range.
        def literal_fits_in_type(value: i64, is_negative: bool, type_name: sview) -> bool:
            can Abort.Panic:
                # Negative literals never fit unsigned types.
                false return if is_negative and type_name in {"u8", "u16", "u32"}

                # Range per type; signed bounds shift by one when the literal is negative
                # (a magnitude of 128 fits i8 only as -128). Unknown types don't flag.
                return when type_name:
                    "u8" -> value >= 0 and value <= 255
                    "u16" -> value >= 0 and value <= 65535
                    "u32" -> value >= 0 and value <= 4294967295
                    "i8" -> (value >= 1 and value <= 128) if is_negative else (value >= 0 and value <= 127)
                    "i16" -> (value >= 1 and value <= 32768) if is_negative else (value >= 0 and value <= 32767)
                    "i32" -> (value >= 1 and value <= 2147483648) if is_negative else (value >= 0 and value <= 2147483647)
                    _ -> true


        # Walk through all statements, checking for literal assignments out of range.
        def walk_statements_for_literal_assign_out_of_range(statements: darray[Ast::Stmt], local_names: mutable darray[sview]&, local_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record this local's type for later checks
                            type_name: sview = bare_type_name(type_expression)
                            local_names <- local_names.push(name) if type_name != ""
                            local_types <- local_types.push(type_name) if type_name != ""
                        Stmt.Assign(target, operator, value, line):
                            # Only check `<-` mutations to a plain-identifier target, not `=` bindings.
                            if operator == TokenKind.LArrow and target is Expr.Ident(target_name, target_line):
                                target_type: sview = find_local_type(target_name, local_names, local_types)
                                if target_type == "u8" or target_type == "u16" or target_type == "u32" or target_type == "i8" or target_type == "i16" or target_type == "i32":
                                    match value:
                                        Expr.IntLit(lit_value):
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{name: target_name, line: line, kind: DiagnosticKind.LiteralAssignOutOfRange, expected: target_type, actual: "", expected_count: lit_value.u32(), actual_count: 0}) if not literal_fits_in_type(lit_value, false, target_type)
                                        Expr.Unary(TokenKind.Minus, Expr.IntLit(neg_lit_value), _):
                                            # actual_count == 1 signals the literal was negated.
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{name: target_name, line: line, kind: DiagnosticKind.LiteralAssignOutOfRange, expected: target_type, actual: "", expected_count: neg_lit_value.u32(), actual_count: 1}) if not literal_fits_in_type(neg_lit_value, true, target_type)
                                        _:
                                            pass
                        Stmt.Block(kind, clause, binding, block_body, line):
                            # Recursively check nested blocks
                            table <- walk_statements_for_literal_assign_out_of_range(block_body, local_names, local_types, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_statements_for_literal_assign_out_of_range(then_body, local_names, local_types, table)
                            table <- walk_statements_for_literal_assign_out_of_range(else_body, local_names, local_types, table)
                        Stmt.While(condition, loop_body, line):
                            table <- walk_statements_for_literal_assign_out_of_range(loop_body, local_names, local_types, table)
                        Stmt.For(bind, variables, iterable, loop_body, line):
                            table <- walk_statements_for_literal_assign_out_of_range(loop_body, local_names, local_types, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- walk_statements_for_literal_assign_out_of_range(arm.body, local_names, local_types, table)
                        _:
                            pass


        # Walk through function declarations, checking for out-of-range literal assignments.
        def check_literal_assign_out_of_range(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Initialize parallel arrays for tracking local types
                            local_names: mutable darray[sview] = []
                            local_types: mutable darray[sview] = []

                            # Add parameters to the tracking arrays
                            for param in params:
                                type_name: sview = bare_type_name(param.type_expression)
                                if type_name != "":
                                    local_names <- local_names.push(param.name)
                                    local_types <- local_types.push(type_name)

                            # Walk the function body
                            table <- walk_statements_for_literal_assign_out_of_range(body, local_names, local_types, table)
                        Decl.Module(module_name, module_body, line):
                            table <- check_literal_assign_out_of_range(module_body, table)
                        Decl.Scoped(scoped_body, line):
                            table <- check_literal_assign_out_of_range(scoped_body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
