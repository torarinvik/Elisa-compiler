# A module owner is visible in its own scope or beneath an exact `::` boundary.
module SemanticLexicalModuleOwnerPolicy:
    public:
        def is_lexical(owner: sview, current: sview) -> bool:
            can Abort.Panic:
                ensure result == (
                    owner == "" or owner == current or (
                        current.len >= 2 and
                        owner.len <= current.len - 2 and
                        current[owner.len] == 58 and
                        current[owner.len + 1.usize()] == 58 and
                        (forall index in 0..<owner.len:
                            owner[index] == current[index]
                        )
                    )
                )
                true return if owner == ""
                true return if owner == current
                owner_length: usize = owner.len
                current_length: usize = current.len
                false return if current_length < 2
                false return if owner_length > current_length - 2
                false return if current[owner_length] != 58 or current[owner_length + 1.usize()] != 58
                for index in 0..<owner_length |owner, current, owner_length, current_length|:
                    invariant index <= owner_length
                    invariant owner_length <= current_length - 2
                    invariant forall prefix_index in 0..<index: owner[prefix_index] == current[prefix_index]
                    false return if owner[index] != current[index]
                return true
