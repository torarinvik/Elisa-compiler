# A module owner is visible in its own scope or beneath an exact `::` boundary.
module SemanticLexicalModuleOwnerPolicy:
    public:
        def is_lexical(owner: sview, current: sview) -> bool:
            can Abort.Panic:
                ensure result == (
                    owner == "" or owner == current or (
                        sview_len(current) >= 2 and
                        sview_len(owner) <= sview_len(current) - 2 and
                        sview_at(current, sview_len(owner)) == 58 and
                        sview_at(current, sview_len(owner) + 1.usize()) == 58 and
                        (forall index in 0..<sview_len(owner):
                            sview_at(owner, index) == sview_at(current, index)
                        )
                    )
                )
                true return if owner == ""
                true return if owner == current
                owner_length: usize = sview_len(owner)
                current_length: usize = sview_len(current)
                false return if current_length < 2
                false return if owner_length > current_length - 2
                false return if sview_at(current, owner_length) != 58 or sview_at(current, owner_length + 1.usize()) != 58
                for index in 0..<owner_length |owner, current, owner_length, current_length|:
                    invariant index <= owner_length
                    invariant owner_length <= current_length - 2
                    invariant forall prefix_index in 0..<index: sview_at(owner, prefix_index) == sview_at(current, prefix_index)
                    false return if sview_at(owner, index) != sview_at(current, index)
                return true
