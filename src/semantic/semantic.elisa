# Stage1 semantic layer — `module Semantic`.
#
# Symbol collection + name resolution over the parsed AST. `Ast`/`Lexer` are top-level
# modules pulled in by the parser. Each piece of the semantic layer is self-describing:
# it declares its own `extend Semantic:` block with its own `public:`/`private:` section,
# so a file's module membership and visibility are visible in the file itself rather than
# encoded by where a central facade `include`s it. This file just declares the canonical
# `module Semantic` and pulls the parts into the compilation unit.
#
#   - semantic_types  (module Semantic, public)  : SymbolKind / Symbol / SymbolTable — the
#                                                  canonical declaration carries the shared vocabulary.
#   - symbols         (extend Semantic, private) : symbol collection helpers.
#   - resolve         (extend Semantic, private) : name-resolution helpers.
#   - semantic_api    (extend Semantic, public)  : the two pass entry points.
#
# `using Ast` sits at top level so the AST enum variants are unqualified in every part's
# `match` arms.
include "../parser/parser.elisa"

# Byte-buffer builders — the shared primitives for assembling UTF-8 output into a
# `darray[u8]` (diagnostic messages here, LSP JSON framing downstream). Kept inline in the
# semantic facade (rather than a separate <50-line file) so its only consumer, the
# diagnostic renderer in semantic_api, has them in scope via `using Bytes`.
module Bytes:
    public:
        # Append a NUL-terminated C-string literal's bytes to a byte buffer.
        def push_str(buf: mutable darray[u8]&, lit: u8&) -> void can[Memory.Allocate, Abort.Panic]:
            for b in sview(lit, 0, -1):
                buf.push(b)


        # Append a source span's raw bytes to a byte buffer. An sview is a contiguous
        # {data, len} byte view, so this lowers to a single arena_memcpy (not a per-byte
        # fill) — the ideal shape for the hot string-append helper called on every
        # diagnostic and token span.
        def push_sview(buf: mutable darray[u8]&, sv: sview) -> void can[Memory.Allocate, Abort.Panic]:
            buf.extend(sv)


        # Append the decimal digits of `n` (>= 0) to a byte buffer. Digits are generated
        # least-significant first, so they are emitted in reverse to land in reading order.
        def push_int(buf: mutable darray[u8]&, n: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if n == 0:
                buf.push(48)
                return
            digits: mutable darray[u8] = []
            v: mutable i64 = n
            while v > 0:
                digits.push((48 + (v % 10)).u8())
                v <- v / 10
            i: mutable i64 = digits.count.i64() - 1
            while i >= 0:
                buf.push(digits[i.usize()])
                i <- i - 1

using Ast
using Bytes

include "./semantic_types.elisa"
include "./symbols.elisa"
include "./resolve_scope.elisa"
include "./resolve_expr.elisa"
include "./resolve_flow.elisa"
include "./resolve_mutability.elisa"
include "./resolve_enums.elisa"
include "./resolve_types.elisa"
include "./resolve.elisa"
include "./semantic_api.elisa"
