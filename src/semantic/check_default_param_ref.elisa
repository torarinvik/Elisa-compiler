# A parameter default value is evaluated with the function's own parameters OUT of scope, so
# `def f(x: i64, y: i64 = x)` rejects `x` as an undefined identifier. The parser discards the
# default expression but records a `__default_param_ref` marker (owner="__default_param_ref",
# name=referenced-parameter) for each bare-Ident reference to a sibling parameter. Emit an
# `undefined identifier` diagnostic for each — UNLESS the name also names a global symbol, in
# which case the default legitimately resolves to that global (parameters shadow nothing here).
extend Semantic:
    public:
        def check_default_param_ref(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.owner == "__default_param_ref" and annotation.name != "" and not name_indexed(table, annotation.name):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: annotation.name, line: annotation.line, expected: "", actual: ""})
