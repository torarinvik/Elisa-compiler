extend Semantic:
    private:
        def try_noncall_expression_directly_raises(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Call(Expr.Ident("raise", _), arguments, _, _):
                        for argument in arguments:
                            return try_noncall_expression_directly_raises(argument) if try_noncall_expression_aborts(argument)
                        return true
                    Expr.Call(callee, arguments, _, _):
                        return try_noncall_expression_directly_raises(callee) if try_noncall_expression_aborts(callee)
                        for argument in arguments:
                            return try_noncall_expression_directly_raises(argument) if try_noncall_expression_aborts(argument)
                        return false
                    Expr.Paren(inner, _): try_noncall_expression_directly_raises(inner)
                    Expr.Field(receiver, _, _): try_noncall_expression_directly_raises(receiver)
                    Expr.If(condition, then_value, else_value, _):
                        return try_noncall_expression_directly_raises(condition) if try_noncall_expression_aborts(condition)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        return try_noncall_expression_directly_raises(then_value) if condition_bool.known and condition_bool.value
                        return try_noncall_expression_directly_raises(else_value) if condition_bool.known
                        return try_noncall_expression_directly_raises(then_value) and try_noncall_expression_directly_raises(else_value)
                    Expr.Match(scrutinee, arms, _):
                        return try_noncall_expression_directly_raises(scrutinee) if try_noncall_expression_aborts(scrutinee)
                        scrutinee_bool: (known: bool, value: bool) = try_noncall_literal_bool(scrutinee)
                        return try_noncall_match_bool_arms_directly_raise(arms, scrutinee_bool.value) if scrutinee_bool.known
                        has_unconditional_wildcard: bool = any arm in arms where try_noncall_pattern_is_match_catchall(arm.pattern) and arm.guard is Expr.Absent
                        has_true_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "true" and arm.guard is Expr.Absent
                        has_false_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "false" and arm.guard is Expr.Absent
                        return false if not has_unconditional_wildcard and not (has_true_literal and has_false_literal)
                        return all arm in arms where try_noncall_guard_is_definitely_false(arm.guard) or (try_noncall_expression_aborts(arm.guard) and try_noncall_expression_directly_raises(arm.guard)) or try_noncall_block_directly_raises(arm.body)
                    Expr.Block(statements, value, _, _):
                        return try_noncall_block_directly_raises(statements) if try_noncall_block_terminates(statements)
                        return try_noncall_expression_directly_raises(value)
                    _: false

        def try_noncall_block_directly_raises(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, _) if try_noncall_expression_aborts(expression):
                            return try_noncall_expression_directly_raises(expression)
                        Stmt.VarDecl(_, _, value, _) if try_noncall_expression_aborts(value):
                            return try_noncall_expression_directly_raises(value)
                        Stmt.Assign(target, _, value, _) if try_noncall_expression_aborts(target) or try_noncall_expression_aborts(value):
                            return try_noncall_expression_directly_raises(target) if try_noncall_expression_aborts(target)
                            return try_noncall_expression_directly_raises(value)
                        Stmt.Return(value, _):
                            if value is returned and try_noncall_expression_aborts(returned):
                                return try_noncall_expression_directly_raises(returned)
                        Stmt.Match(scrutinee, arms, position) if try_noncall_single_statement_terminates(statement):
                            return try_noncall_expression_directly_raises(Ast::Expr.Match(scrutinee, arms, position))
                        Stmt.If(condition, then_body, else_body, _):
                            return try_noncall_expression_directly_raises(condition) if try_noncall_expression_aborts(condition)
                            condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                            if condition_bool.known:
                                selected_body: darray[Ast::Stmt] = then_body if condition_bool.value else else_body
                                return try_noncall_block_directly_raises(selected_body) if try_noncall_block_terminates(selected_body)
                            else:
                                then_terminates: bool = try_noncall_block_terminates(then_body)
                                else_terminates: bool = try_noncall_block_terminates(else_body)
                                if then_terminates and else_terminates:
                                    return try_noncall_block_directly_raises(then_body) and try_noncall_block_directly_raises(else_body)
                                return false if then_terminates and not try_noncall_block_directly_raises(then_body)
                                return false if else_terminates and not try_noncall_block_directly_raises(else_body)
                                # Any still-reachable branch falls through to the remaining
                                # statements. Terminated branches are safe here only when
                                # they already established a direct catchable raise.
                        Stmt.Block(kind, _, _, body, _) if kind in {"block", "can", "trusted", "with", "region", "in", "pool", "nursery", "scope"} and try_noncall_block_terminates(body):
                            return try_noncall_block_directly_raises(body)
                        _:
                            pass
                    return false if try_noncall_single_statement_terminates(statement)
                return false

        def try_noncall_pattern_matches_bool(pattern: Ast::Pattern, value: bool) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Literal(text):
                        return text == "true" if value
                        return text == "false"
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Or(options):
                        return any option in options where try_noncall_pattern_matches_bool(option, value)
                    Pattern.As(_, inner):
                        return any wrapped in inner where try_noncall_pattern_matches_bool(wrapped, value)
                    _:
                        return false

        def try_noncall_match_bool_arms_terminate(arms: darray[Ast::MatchArm], value: bool) -> bool:
            can Abort.Panic:
                for arm in arms:
                    continue if not try_noncall_pattern_matches_bool(arm.pattern, value)
                    continue if try_noncall_guard_is_definitely_false(arm.guard)
                    return true if try_noncall_expression_aborts(arm.guard)
                    return false if not (arm.guard is Expr.Absent)
                    return try_noncall_block_terminates(arm.body)
                return false

        def try_noncall_match_bool_arms_directly_raise(arms: darray[Ast::MatchArm], value: bool) -> bool:
            can Abort.Panic:
                for arm in arms:
                    continue if not try_noncall_pattern_matches_bool(arm.pattern, value)
                    continue if try_noncall_guard_is_definitely_false(arm.guard)
                    return try_noncall_expression_directly_raises(arm.guard) if try_noncall_expression_aborts(arm.guard)
                    return false if not (arm.guard is Expr.Absent)
                    return try_noncall_block_directly_raises(arm.body)
                return false

        # A block arm with no reachable value must not contribute source facts to its
        # enclosing match/catch expression. Stop at direct terminators, aborting
        # expressions, and if/match statements that terminate on every possible path.
        def try_noncall_block_terminates(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Return(_, _):
                            return true
                        Stmt.Break(_, _):
                            return true
                        Stmt.Continue(_, _):
                            return true
                        Stmt.Expr(expression, _) if try_noncall_expression_aborts(expression):
                            return true
                        Stmt.Expr(Expr.Block(block_statements, value, _, _), _) if try_noncall_block_terminates(block_statements) or try_noncall_expression_aborts(value):
                            return true
                        Stmt.VarDecl(_, _, value, _) if try_noncall_expression_aborts(value):
                            return true
                        Stmt.Assign(target, _, value, _) if try_noncall_expression_aborts(target) or try_noncall_expression_aborts(value):
                            return true
                        Stmt.If(condition, then_body, else_body, _):
                            return true if try_noncall_expression_aborts(condition)
                            condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                            if condition_bool.known:
                                return try_noncall_block_terminates(then_body) if condition_bool.value
                                return try_noncall_block_terminates(else_body)
                            return true if try_noncall_block_terminates(then_body) and try_noncall_block_terminates(else_body)
                        Stmt.While(condition, _, _) if try_noncall_expression_aborts(condition):
                            return true
                        Stmt.For(_, _, iterable, _, _) if try_noncall_expression_aborts(iterable):
                            return true
                        Stmt.Match(scrutinee, arms, _):
                            return true if try_noncall_expression_aborts(scrutinee)
                            scrutinee_bool: (known: bool, value: bool) = try_noncall_literal_bool(scrutinee)
                            return try_noncall_match_bool_arms_terminate(arms, scrutinee_bool.value) if scrutinee_bool.known
                            has_unconditional_wildcard: bool = any arm in arms where try_noncall_pattern_is_match_catchall(arm.pattern) and arm.guard is Expr.Absent
                            has_true_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "true" and arm.guard is Expr.Absent
                            has_false_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "false" and arm.guard is Expr.Absent
                            all_arms_terminate: bool = all arm in arms where try_noncall_guard_is_definitely_false(arm.guard) or try_noncall_expression_aborts(arm.guard) or try_noncall_block_terminates(arm.body)
                            return true if arms.count > 0 and (has_unconditional_wildcard or (has_true_literal and has_false_literal)) and all_arms_terminate
                        Stmt.Block(kind, _, _, body, _) if kind in {"block", "can", "trusted", "with", "region", "in", "pool", "nursery", "scope"} and try_noncall_block_terminates(body):
                            return true
                        Stmt.Contract(_, expression, _) if try_noncall_expression_aborts(expression):
                            return true
                        _:
                            pass
                return false

        def try_noncall_single_statement_terminates(statement: Ast::Stmt) -> bool:
            can Abort.Panic:
                match statement:
                    Stmt.Return(_, _):
                        return true
                    Stmt.Break(_, _):
                        return true
                    Stmt.Continue(_, _):
                        return true
                    Stmt.Expr(expression, _):
                        return try_noncall_expression_aborts(expression)
                    Stmt.Expr(Expr.Block(block_statements, value, _, _), _):
                        return try_noncall_block_terminates(block_statements) or try_noncall_expression_aborts(value)
                    Stmt.VarDecl(_, _, value, _):
                        return try_noncall_expression_aborts(value)
                    Stmt.Assign(target, _, value, _):
                        return try_noncall_expression_aborts(target) or try_noncall_expression_aborts(value)
                    Stmt.If(condition, then_body, else_body, _):
                        return true if try_noncall_expression_aborts(condition)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        if condition_bool.known:
                            return try_noncall_block_terminates(then_body) if condition_bool.value
                            return try_noncall_block_terminates(else_body)
                        return try_noncall_block_terminates(then_body) and try_noncall_block_terminates(else_body)
                    Stmt.While(condition, _, _) if try_noncall_expression_aborts(condition):
                        return true
                    Stmt.For(_, _, iterable, _, _) if try_noncall_expression_aborts(iterable):
                        return true
                    Stmt.Match(scrutinee, arms, _):
                        return true if try_noncall_expression_aborts(scrutinee)
                        scrutinee_bool: (known: bool, value: bool) = try_noncall_literal_bool(scrutinee)
                        return try_noncall_match_bool_arms_terminate(arms, scrutinee_bool.value) if scrutinee_bool.known
                        has_unconditional_wildcard: bool = any arm in arms where try_noncall_pattern_is_match_catchall(arm.pattern) and arm.guard is Expr.Absent
                        has_true_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "true" and arm.guard is Expr.Absent
                        has_false_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "false" and arm.guard is Expr.Absent
                        all_arms_terminate: bool = all arm in arms where try_noncall_guard_is_definitely_false(arm.guard) or try_noncall_expression_aborts(arm.guard) or try_noncall_block_terminates(arm.body)
                        return arms.count > 0 and (has_unconditional_wildcard or (has_true_literal and has_false_literal)) and all_arms_terminate
                    Stmt.Block(kind, _, _, body, _) if kind in {"block", "can", "trusted", "with", "region", "in", "pool", "nursery", "scope"}:
                        return try_noncall_block_terminates(body)
                    Stmt.Contract(_, expression, _):
                        return try_noncall_expression_aborts(expression)
                    _:
                        return false

        # Whether some reachable path evaluates an uncaught `raise`. Child expressions
        # are visited in evaluation order, so an earlier unconditional panic prevents a
        # later argument's raise from being counted. This is separate from the broader
        # abort predicate: a Catch can recover a raise even when every guarded path aborts.
        def try_noncall_expression_may_raise_catchably_with_annotations(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        direct_raise: bool = callee is Expr.Ident("raise", _)
                        if not direct_raise:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(callee, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(callee, annotations)
                        for argument in arguments:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(argument, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(argument, annotations)
                        return true if not direct_raise and try_noncall_error_scan_callable_needs_resolution(callee)
                        callee_name: sview @source = try_noncall_error_scan_callable_name(callee)
                        declared_error: (known: bool, family: sview @source) = try_noncall_callable_error_family(callee_name, annotations)
                        return true if not direct_raise and declared_error.known and declared_error.family != ""
                        return true if not direct_raise and not declared_error.known and try_noncall_callable_metadata_present(callee_name, annotations)
                        return direct_raise
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        for child in runtime_children:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(child, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(child, annotations)
                        for candidate in candidates:
                            return true if try_noncall_static_effect_candidate_may_raise(candidate, annotations)
                        return false
                    Expr.Paren(inner, _):
                        return try_noncall_expression_may_raise_catchably_with_annotations(inner, annotations)
                    Expr.Field(receiver, _, _):
                        return try_noncall_expression_may_raise_catchably_with_annotations(receiver, annotations)
                    Expr.If(condition, then_value, else_value, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(condition, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(condition, annotations)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        return try_noncall_expression_may_raise_catchably_with_annotations(then_value, annotations) if condition_bool.known and condition_bool.value
                        return try_noncall_expression_may_raise_catchably_with_annotations(else_value, annotations) if condition_bool.known
                        return try_noncall_expression_may_raise_catchably_with_annotations(then_value, annotations) or try_noncall_expression_may_raise_catchably_with_annotations(else_value, annotations)
                    Expr.Match(scrutinee, arms, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(scrutinee, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(scrutinee, annotations)
                        scrutinee_bool: (known: bool, value: bool) = try_noncall_literal_bool(scrutinee)
                        for arm in arms:
                            continue if scrutinee_bool.known and not try_noncall_pattern_matches_bool(arm.pattern, scrutinee_bool.value)
                            continue if try_noncall_guard_is_definitely_false(arm.guard)
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(arm.guard, annotations)
                            if try_noncall_expression_aborts_with_annotations(arm.guard, annotations):
                                return false if try_noncall_pattern_is_match_catchall(arm.pattern)
                                continue
                            return true if try_noncall_statements_may_raise_catchably_with_annotations(arm.body, annotations)
                            return false if arm.guard is Expr.Absent and try_noncall_pattern_is_match_catchall(arm.pattern)
                        return false
                    Expr.Catch(guarded, arms, _):
                        guarded_aborts: bool = try_noncall_expression_aborts_with_annotations(guarded, annotations)
                        guarded_may_raise: bool = try_noncall_expression_may_raise_catchably_with_annotations(guarded, annotations)
                        arm_index: mutable usize = 0
                        while arm_index < arms.count |arm_index, arms, guarded_aborts, guarded_may_raise|:
                            arm: Ast::MatchArm = arms[arm_index]
                            if (arm_index == 0.usize() and guarded_aborts) or (arm_index > 0.usize() and not guarded_may_raise) or try_noncall_guard_is_definitely_false(arm.guard):
                                arm_index <- arm_index + 1.usize()
                                continue
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(arm.guard, annotations)
                            if try_noncall_expression_aborts_with_annotations(arm.guard, annotations):
                                break if arm_index > 0.usize() and try_noncall_pattern_is_error_catchall(arm.pattern)
                                arm_index <- arm_index + 1.usize()
                                continue
                            return true if try_noncall_statements_may_raise_catchably_with_annotations(arm.body, annotations)
                            guard_bool: (known: bool, value: bool) = try_noncall_literal_bool(arm.guard)
                            error_catchall: bool = arm_index > 0.usize() and try_noncall_pattern_is_error_catchall(arm.pattern)
                            break if error_catchall and (arm.guard is Expr.Absent or (guard_bool.known and guard_bool.value))
                            arm_index <- arm_index + 1.usize()
                        return false
                    Expr.Block(statements, value, _, _):
                        return true if try_noncall_statements_may_raise_catchably_with_annotations(statements, annotations)
                        return false if try_noncall_block_terminates(statements)
                        return try_noncall_expression_may_raise_catchably_with_annotations(value, annotations)
                    Expr.Binary(left, operator, right, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(left, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(left, annotations)
                        if operator == TokenKind.And or operator == TokenKind.Or:
                            left_bool: (known: bool, value: bool) = try_noncall_literal_bool(left)
                            return false if left_bool.known and ((operator == TokenKind.And and not left_bool.value) or (operator == TokenKind.Or and left_bool.value))
                        return try_noncall_expression_may_raise_catchably_with_annotations(right, annotations)
                    Expr.Unary(_, inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        return try_noncall_expression_may_raise_catchably_with_annotations(inner, annotations)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        return try_noncall_expression_may_raise_catchably_with_annotations(object, annotations)
                    Expr.Index(object, index, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(object, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(object, annotations)
                        return try_noncall_expression_may_raise_catchably_with_annotations(index, annotations)
                    Expr.IndexN(object, indices, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(object, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(object, annotations)
                        for index in indices:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(index, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(index, annotations)
                        return false
                    Expr.Slice(object, low, high, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(object, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(object, annotations)
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(low, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(low, annotations)
                        return try_noncall_expression_may_raise_catchably_with_annotations(high, annotations)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(element, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(element, annotations)
                        return false
                    Expr.DictLit(entries, _):
                        for entry in entries:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(entry.key, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(entry.key, annotations)
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(entry.value, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(entry.value, annotations)
                        return false
                    Expr.Construct(_, fields, _):
                        for field in fields:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(field.value, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(field.value, annotations)
                        return false
                    Expr.RecordUpdate(base, fields, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(base, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(base, annotations)
                        for field in fields:
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(field.value, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(field.value, annotations)
                        return false
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(iterable, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(iterable, annotations)
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(condition, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(condition, annotations)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        return false if condition_bool.known and not condition_bool.value
                        return try_noncall_expression_may_raise_catchably_with_annotations(body, annotations)
                    Expr.Refinement(base, predicate, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(base, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(base, annotations)
                        return try_noncall_expression_may_raise_catchably_with_annotations(predicate, annotations)
                    Expr.GetElse(guarded, recovery, _):
                        return true if try_noncall_expression_may_raise_catchably_with_annotations(guarded, annotations)
                        return false if try_noncall_expression_aborts_with_annotations(guarded, annotations)
                        return try_noncall_statements_may_raise_catchably_with_annotations(recovery, annotations)
                    _:
                        return false


        def try_noncall_expression_may_raise_catchably(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                empty_annotations: darray[Ast::EnumAnnotation] = []
                return try_noncall_expression_may_raise_catchably_with_annotations(expression, empty_annotations)

        def try_noncall_statements_may_raise_catchably_with_annotations(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, _):
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(expression, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(expression, annotations)
                        Stmt.VarDecl(_, _, value, _):
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(value, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(value, annotations)
                        Stmt.Assign(target, _, value, _):
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(target, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(target, annotations)
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(value, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(value, annotations)
                        Stmt.Return(value, _):
                            if value is returned:
                                return try_noncall_expression_may_raise_catchably_with_annotations(returned, annotations)
                            return false
                        Stmt.If(condition, then_body, else_body, _):
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(condition, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(condition, annotations)
                            condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                            if condition_bool.known:
                                return true if condition_bool.value and try_noncall_statements_may_raise_catchably_with_annotations(then_body, annotations)
                                return true if not condition_bool.value and try_noncall_statements_may_raise_catchably_with_annotations(else_body, annotations)
                            else:
                                return true if try_noncall_statements_may_raise_catchably_with_annotations(then_body, annotations) or try_noncall_statements_may_raise_catchably_with_annotations(else_body, annotations)
                        Stmt.Match(scrutinee, arms, match_position):
                            # Statement Catch lowers to Match plus a parser marker. Reuse
                            # Expr.Catch's reachability rules so its success binding does
                            # not hide a raising error handler as an ordinary wildcard arm.
                            is_catch: bool = any marker in annotations where marker.name == "__catch_match" and marker.line == match_position.line
                            return try_noncall_expression_may_raise_catchably_with_annotations(Ast::Expr.Catch(scrutinee, arms, match_position), annotations) if is_catch
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(scrutinee, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(scrutinee, annotations)
                            scrutinee_bool: (known: bool, value: bool) = try_noncall_literal_bool(scrutinee)
                            for arm in arms:
                                continue if scrutinee_bool.known and not try_noncall_pattern_matches_bool(arm.pattern, scrutinee_bool.value)
                                continue if try_noncall_guard_is_definitely_false(arm.guard)
                                return true if try_noncall_expression_may_raise_catchably_with_annotations(arm.guard, annotations)
                                if try_noncall_expression_aborts_with_annotations(arm.guard, annotations):
                                    break if try_noncall_pattern_is_match_catchall(arm.pattern)
                                    continue
                                return true if try_noncall_statements_may_raise_catchably_with_annotations(arm.body, annotations)
                                break if arm.guard is Expr.Absent and try_noncall_pattern_is_match_catchall(arm.pattern)
                        Stmt.Block(_, _, _, body, _):
                            return true if try_noncall_statements_may_raise_catchably_with_annotations(body, annotations)
                        Stmt.While(condition, body, _):
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(condition, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(condition, annotations)
                            condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                            return true if not (condition_bool.known and not condition_bool.value) and try_noncall_statements_may_raise_catchably_with_annotations(body, annotations)
                        Stmt.For(_, _, iterable, body, _):
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(iterable, annotations)
                            return false if try_noncall_expression_aborts_with_annotations(iterable, annotations)
                            return true if try_noncall_statements_may_raise_catchably_with_annotations(body, annotations)
                        Stmt.Contract(_, expression, _):
                            return true if try_noncall_expression_may_raise_catchably_with_annotations(expression, annotations)
                        _:
                            pass
                    return false if try_noncall_single_statement_terminates(statement)
                return false


        def try_noncall_statements_may_raise_catchably(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                empty_annotations: darray[Ast::EnumAnnotation] = []
                return try_noncall_statements_may_raise_catchably_with_annotations(statements, empty_annotations)

        def try_noncall_assignment_source_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (family: sview @source, known_nonfallible: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return (try_noncall_family_lookup(environment, name), try_noncall_family_known_nonfallible(environment, name))
                    Expr.Paren(inner, _):
                        return try_noncall_assignment_source_facts(inner, params, environment, annotations)
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        return ("", false) if callee_name == ""
                        if callee_qualifier == "":
                            return ("", false) if try_noncall_family_index(environment, callee_name) < environment.names.count
                            for parameter in params:
                                return ("", false) if parameter.name == callee_name
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool) = try_noncall_callable_source_facts(callee_name, callee_qualifier, callee, arguments, argument_names, params, environment, annotations)
                        return (call_facts.family, call_facts.return_nonfallible and call_facts.family == "") if call_facts.known
                        return ("", false)
                    Expr.If(condition, then_value, else_value, _):
                        return ("", false) if try_noncall_expression_aborts(condition)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        if condition_bool.known and not condition_bool.value:
                            return try_noncall_assignment_source_facts(else_value, params, environment, annotations)
                        then_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        for outer_name in environment.names |then_environment|:
                            # Pattern bindings established by the condition are visible in
                            # the true value and shadow any same-named outer fact.
                            if try_noncall_truthy_condition_binds_name(condition, outer_name, annotations):
                                condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, outer_name, params, annotations)
                                try_noncall_family_bind(&then_environment, outer_name, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                        then_aborts: bool = try_noncall_expression_aborts_with_annotations(then_value, annotations)
                        else_aborts: bool = try_noncall_expression_aborts_with_annotations(else_value, annotations)
                        return ("", false) if condition_bool.known and condition_bool.value and then_aborts
                        return ("", false) if not condition_bool.known and then_aborts and else_aborts
                        return try_noncall_assignment_source_facts(else_value, params, environment, annotations) if not condition_bool.known and then_aborts
                        return try_noncall_assignment_source_facts(then_value, params, then_environment, annotations) if not condition_bool.known and else_aborts
                        then_facts: mutable (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(then_value, params, then_environment, annotations)
                        if not then_facts.known_nonfallible and then_facts.family == "" and then_value is Expr.Ident(then_binder, _) and try_noncall_truthy_condition_binds_name(condition, then_binder, annotations):
                            condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, then_binder, params, annotations)
                            then_facts <- ("", condition_facts.known_nonfallible)
                        return then_facts if condition_bool.known and condition_bool.value
                        else_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(else_value, params, environment, annotations)
                        return (then_facts.family, false) if then_facts.family != "" and then_facts.family == else_facts.family
                        return (then_facts.family, false) if then_facts.family != "" and else_facts.family == "" and else_facts.known_nonfallible
                        return (else_facts.family, false) if else_facts.family != "" and then_facts.family == "" and then_facts.known_nonfallible
                        return ("", true) if then_facts.family == "" and else_facts.family == "" and then_facts.known_nonfallible and else_facts.known_nonfallible
                    Expr.Match(scrutinee, arms, _):
                        common_family: mutable sview @source = ""
                        saw_nonfallible: mutable bool = false
                        conflicting: mutable bool = false
                        unknown: mutable bool = false
                        scrutinee_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(scrutinee, params, environment)
                        for arm in arms |common_family, saw_nonfallible, conflicting, unknown, scrutinee_facts, params, environment, annotations|:
                            if try_noncall_guard_is_definitely_false(arm.guard) or try_noncall_expression_aborts(arm.guard):
                                pass
                            elif arm.body.count == 0:
                                unknown <- true
                            elif not try_noncall_block_terminates(arm.body):
                                arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                                arm_binders: mutable darray[sview @source] = []
                                gather_arm_pattern(arm.pattern, arm_binders)
                                for arm_binder in arm_binders |arm_environment|:
                                    # A pattern binder shadows any same-named outer local.
                                    # Its value may come from the scrutinee, whose error
                                    # family isn't represented in this lightweight scan.
                                    pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, arm_binder)
                                    binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                    binder_facts <- scrutinee_facts if not pattern_facts.known_nonfallible and not pattern_facts.numeric and not pattern_facts.integer
                                    try_noncall_family_bind(&arm_environment, arm_binder, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                                for outer_name in environment.names |arm_environment|:
                                    # Successful `is`/`as` bindings in a guard are visible
                                    # through the arm body and shadow same-named outer facts.
                                    if try_noncall_truthy_condition_binds_name(arm.guard, outer_name, annotations):
                                        guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, outer_name, params, annotations)
                                        try_noncall_family_bind(&arm_environment, outer_name, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                                arm_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_block_source_facts(arm.body, params, arm_environment, annotations)
                                if arm_facts.family != "":
                                    common_family <- arm_facts.family if common_family == ""
                                    conflicting <- true if common_family != arm_facts.family
                                elif arm_facts.known_nonfallible:
                                    saw_nonfallible <- true
                                else:
                                    unknown <- true
                        return (common_family, false) if not conflicting and not unknown and common_family != ""
                        return ("", true) if not conflicting and not unknown and common_family == "" and saw_nonfallible and arms.count > 0
                    Expr.Block(statements, value, _, _):
                        return try_noncall_block_source_facts(statements, params, environment, annotations, value)
                    Expr.Refinement(fallback, guarded, _):
                        if try_noncall_expression_is_try_fallback(expression, annotations):
                            guarded_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(guarded, params, environment, annotations)
                            fallback_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(fallback, params, environment, annotations)
                            return ("", true) if guarded_facts.family != "" and fallback_facts.known_nonfallible
                            return (fallback_facts.family, false) if guarded_facts.family != "" and fallback_facts.family != ""
                            return ("", false)
                        return try_noncall_assignment_source_facts(fallback, params, environment, annotations)
                    Expr.GetElse(guarded, _, _):
                        guarded_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(guarded, params, environment, annotations)
                        return ("", true) if guarded_facts.family != ""
                    Expr.Catch(guarded, arms, _):
                        common_family: mutable sview @source = ""
                        saw_nonfallible: mutable bool = false
                        conflicting: mutable bool = false
                        unknown: mutable bool = false
                        arm_index: mutable usize = 0.usize()
                        catch_guard_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(guarded, params, environment, annotations)
                        payload_facts: (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(guarded, params, environment, annotations)
                        for arm in arms |common_family, saw_nonfallible, conflicting, unknown, arm_index, params, environment, annotations|:
                            if arm_index > 0.usize() and catch_guard_facts.known_nonfallible:
                                pass
                            elif try_noncall_guard_is_definitely_false(arm.guard) or try_noncall_expression_aborts(arm.guard):
                                pass
                            elif arm.body.count == 0:
                                unknown <- true
                            elif not try_noncall_block_terminates(arm.body):
                                arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                                arm_binders: mutable darray[sview @source] = []
                                try_noncall_gather_catch_arm_pattern(arm.pattern, arm_index, arm_binders)
                                for arm_binder in arm_binders |arm_environment|:
                                    pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, arm_binder)
                                    if arm_index == 0.usize() and arm.pattern is Pattern.Binding(success_name) and success_name == arm_binder:
                                        try_noncall_family_bind(&arm_environment, arm_binder, payload_facts.family, payload_facts.known_nonfallible, payload_facts.numeric, payload_facts.integer)
                                    else:
                                        try_noncall_family_bind(&arm_environment, arm_binder, "", pattern_facts.known_nonfallible, pattern_facts.numeric, pattern_facts.integer)
                                for outer_name in environment.names |arm_environment|:
                                    if try_noncall_truthy_condition_binds_name(arm.guard, outer_name, annotations):
                                        guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, outer_name, params, annotations)
                                        try_noncall_family_bind(&arm_environment, outer_name, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                                arm_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_block_source_facts(arm.body, params, arm_environment, annotations)
                                if arm_facts.family != "":
                                    common_family <- arm_facts.family if common_family == ""
                                    conflicting <- true if common_family != arm_facts.family
                                elif arm_facts.known_nonfallible:
                                    saw_nonfallible <- true
                                else:
                                    unknown <- true
                            arm_index <- arm_index + 1.usize()
                        return (common_family, false) if not conflicting and not unknown and common_family != ""
                        return ("", true) if not conflicting and not unknown and common_family == "" and saw_nonfallible and arms.count > 0
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        return ("", true)
                    Expr.Unary(TokenKind.Not, _, _):
                        return ("", true)
                    Expr.Unary(TokenKind.Minus, _, _) | Expr.Unary(TokenKind.Plus, _, _):
                        # Primitive numeric unary operators are nonfallible. A struct's
                        # overloaded `__neg__` can return an error union, so don't inherit
                        # its operand's nonfallible fact.
                        return ("", true) if try_noncall_numeric_value(expression, params, environment)
                    Expr.Binary(_, operator, _, _) if operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}:
                        return ("", true) if try_noncall_expression_is_known_nonfallible(expression, params, environment)
                    Expr.Binary(_, operator, _, _) if operator in {TokenKind.Ampersand, TokenKind.Pipe, TokenKind.Caret, TokenKind.LShift, TokenKind.RShift}:
                        return ("", true) if try_noncall_integer_value(expression, params, environment)
                    _:
                        pass
                return ("", false)
