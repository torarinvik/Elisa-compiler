# Check for `for` loops whose range iterable (`lo..<hi`, `lo..hi`, `lo..>hi`, `lo..<=hi`)
# has a bound that is firmly non-integral: Float, String, or Void. A range is only ever
# valid over integer-like bounds (Int/Char); a firm Float/String bound, or a Void bound
# (e.g. from a `-> void` call), can never produce a valid loop. Fires once per range, on
# the first offending bound found (checking `lo` before `hi`). Unknown/Named bounds are
# never flagged (could be a user-defined Range-like type or an unresolved local).

extend Semantic:
    private:

        # Whether an InferType is a firm non-integral range-bound family: Float, String, or Void.
        # Returns the family text to report ("float"/"string"/"void"), or "" if integral/unknown.
        def range_bound_offending_family(bound_type: Semantic::InferType) -> sview:
            can Abort.Panic:
                "float" return if bound_type.kind == TypeKind.Float
                "string" return if bound_type.kind == TypeKind.String
                "void" return if bound_type.kind == TypeKind.Void
                return ""

        # If `iterable` is a range expression (`lo OP hi` with OP a range operator), check
        # whether either bound is firmly non-integral and push a diagnostic if so.
        def check_range_iterable_bounds(iterable: Ast::Expr, line: u32, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if iterable is Expr.Binary(lo, op, hi, binary_line):
                    is_range_op: bool = op == TokenKind.Range or op == TokenKind.RangeLt or op == TokenKind.RangeGt or op == TokenKind.RangeLe
                    if is_range_op:
                        lo_type: InferType = infer_expression_type(lo, var_types, type_names, table)
                        lo_family: sview = range_bound_offending_family(lo_type)
                        if lo_family != "":
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RangeBoundNonIntegral, name: "", line: line, expected: "", actual: lo_family})
                        else:
                            hi_type: InferType = infer_expression_type(hi, var_types, type_names, table)
                            hi_family: sview = range_bound_offending_family(hi_type)
                            if hi_family != "":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RangeBoundNonIntegral, name: "", line: line, expected: "", actual: hi_family})

        # Walk through expressions, checking for range expressions with non-integral bounds.
        def walk_expression_for_range_bound_non_integral(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        is_range_op: bool = operator == TokenKind.Range or operator == TokenKind.RangeLt or operator == TokenKind.RangeGt or operator == TokenKind.RangeLe
                        if is_range_op:
                            table <- check_range_iterable_bounds(expression, line, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(left, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_range_bound_non_integral(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_range_bound_non_integral(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_range_bound_non_integral(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_range_bound_non_integral(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_range_bound_non_integral(object, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_range_bound_non_integral(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_range_bound_non_integral(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_range_bound_non_integral(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_range_bound_non_integral(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_range_bound_non_integral(object, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(low, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_range_bound_non_integral(object, table, var_types, type_names)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table|:
                                table <- walk_expression_for_range_bound_non_integral(argument, table, var_types, type_names)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_range_bound_non_integral(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_range_bound_non_integral(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_range_bound_non_integral(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_range_bound_non_integral(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_range_bound_non_integral(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_range_bound_non_integral(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_range_bound_non_integral(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_range_bound_non_integral(condition, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_range_bound_non_integral(iterable, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(condition, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_range_bound_non_integral(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_range_bound_non_integral(statements, table, var_types, type_names)
                        table <- walk_expression_for_range_bound_non_integral(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_range_bound_non_integral(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_range_bound_non_integral(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for-loop range bounds.
        def walk_statements_for_range_bound_non_integral(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_range_bound_non_integral(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_range_bound_non_integral(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_range_bound_non_integral(target, table, var_types, type_names)
                            table <- walk_expression_for_range_bound_non_integral(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_range_bound_non_integral(condition, table, var_types, type_names)
                            table <- walk_statements_for_range_bound_non_integral(then_body, table, var_types, type_names)
                            table <- walk_statements_for_range_bound_non_integral(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_range_bound_non_integral(condition, table, var_types, type_names)
                            table <- walk_statements_for_range_bound_non_integral(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            # `walk_expression_for_range_bound_non_integral` already checks a
                            # top-level range Binary (see its Expr.Binary arm), so this covers
                            # the for-loop iterable without a separate/duplicate check here.
                            table <- walk_expression_for_range_bound_non_integral(iterable, table, var_types, type_names)
                            table <- walk_statements_for_range_bound_non_integral(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_range_bound_non_integral(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_range_bound_non_integral(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_range_bound_non_integral(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_range_bound_non_integral(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_range_bound_non_integral(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_range_bound_non_integral(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_range_bound_non_integral_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_range_bound_non_integral(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_range_bound_non_integral_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_range_bound_non_integral_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_range_bound_non_integral(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_range_bound_non_integral_declarations(declarations, table)
