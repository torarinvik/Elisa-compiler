# `@deprecated` function use. A function decorated `@deprecated("reason")` still compiles, but a
# call to it warns with the reason ("deprecated: call to X — reason"). Pure syntactic: collect the
# deprecated functions plus their message argument, then flag direct calls to them by name.
extend Semantic:
    private:
        # Collect (name, message) for every `@deprecated[("msg")]` function.
        def collect_deprecated_functions(declarations: darray[Ast::Decl], annotation_args: darray[sview]&, names: mutable darray[sview]&, messages: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, messages|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for decorator in decorators |names, messages|:
                                if decorator.name == "deprecated":
                                    has_message: bool = decorator.arg_count > 0 and decorator.arg_start.usize() < annotation_args.count
                                    message: sview = annotation_args[decorator.arg_start.usize()] if has_message else sview("", 0, 0)
                                    names.push(function_name)
                                    messages.push(strip_quotes(message))
                        Decl.Module(module_name, module_body, module_line):
                            collect_deprecated_functions(module_body, annotation_args, names, messages)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_deprecated_functions(scoped_body, annotation_args, names, messages)
                        _:
                            pass

        # Drop a single pair of surrounding double quotes from a source span, if present.
        def strip_quotes(text: sview) -> sview:
            can Abort.Panic:
                length: usize = sview_len(text)
                text return if length < 2 or text[0] != 34 or text[length - 1] != 34
                return text[1:length - 1]

        def deprecated_message_of(callee_name: sview, names: darray[sview]&, messages: darray[sview]&) -> (found: bool, message: sview):
            can Memory.Allocate, Abort.Panic:
                probe: mutable usize = 0
                got: mutable bool = false
                message: mutable sview = sview("", 0, 0)
                while probe < names.count |probe, got, message|:
                    matched: bool = names[probe] == callee_name
                    got <- true if matched
                    message <- messages[probe] if matched
                    probe <- probe + 1
                return (got, message)

        # The function name a call targets: a bare `f` ident, or the method `f` of a UFCS
        # `recv.f(...)` call (callee is a Field access).
        def deprecated_callee_name(callee: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Ident(name, line):
                        return name
                    Expr.Field(object, field, field_line):
                        return field
                    _:
                        return sview("", 0, 0)

        def deprecated_call_expression(expression: Ast::Expr, line: u32, names: darray[sview]&, messages: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        # Direct `f(...)` or UFCS/method `recv.f(...)` — both name the callee f.
                        callee_name: sview = deprecated_callee_name(callee)
                        verdict: (found: bool, message: sview) = deprecated_message_of(callee_name, names, messages) if callee_name != "" else (false, sview("", 0, 0))
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DeprecatedFunctionUse, name: callee_name, line: line, expected: "", actual: verdict.message}) if verdict.found
                        for argument in arguments |table| -> table:
                            table <- deprecated_call_expression(argument, line, names, messages, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- deprecated_call_expression(left, line, names, messages, table)
                        table <- deprecated_call_expression(right, line, names, messages, table)
                    Expr.Paren(inner, paren_line):
                        table <- deprecated_call_expression(inner, line, names, messages, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- deprecated_call_expression(operand, line, names, messages, table)
                    _:
                        pass

        def deprecated_call_statements(statements: darray[Ast::Stmt], names: darray[sview]&, messages: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- deprecated_call_expression(value, line, names, messages, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- deprecated_call_expression(value, line, names, messages, table)
                        Stmt.Expr(expression, line):
                            table <- deprecated_call_expression(expression, line, names, messages, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- deprecated_call_expression(returned, line, names, messages, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- deprecated_call_expression(condition, line, names, messages, table)
                            table <- deprecated_call_statements(then_body, names, messages, table)
                            table <- deprecated_call_statements(else_body, names, messages, table)
                        Stmt.While(condition, while_body, line):
                            table <- deprecated_call_expression(condition, line, names, messages, table)
                            table <- deprecated_call_statements(while_body, names, messages, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- deprecated_call_statements(for_body, names, messages, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- deprecated_call_statements(block_body, names, messages, table)
                        _:
                            pass

        def deprecated_call_walk(declarations: darray[Ast::Decl], names: darray[sview]&, messages: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- deprecated_call_statements(body, names, messages, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- deprecated_call_walk(module_body, names, messages, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- deprecated_call_walk(scoped_body, names, messages, table)
                        _:
                            pass

        def check_deprecated_call(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                messages: mutable darray[sview] = []
                collect_deprecated_functions(file.top_decls, file.annotation_args, names, messages)
                table <- deprecated_call_walk(file.top_decls, names, messages, table) if names.count > 0
