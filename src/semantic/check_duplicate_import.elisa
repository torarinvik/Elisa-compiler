# Duplicate import detection: the same module imported more than once in the same scope.
#
# Each scope (top-level, module body, scoped block) has its own independent import
# namespace — a module re-importing something already imported at the top level is NOT
# a duplicate (distinct scopes).

extend Semantic:
    private:
        # Scan a declaration list for duplicate imports and record warnings for
        # later occurrences of the same module in the same scope.
        def check_duplicate_imports(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Running list of module names already seen in this scope
                seen_modules: mutable darray[sview] = []
                while decl_index < declarations.count |decl_index: usize = 0|:
                    current_decl: Ast::Decl = declarations[decl_index]
                    match current_decl:
                        Decl.Import(module, line):
                            # A repeat of a module already seen in this scope is flagged;
                            # a first sighting is recorded. Two postfix guards, no block if.
                            is_duplicate: bool = any seen_module in seen_modules where seen_module == module
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateImport, name: module, line: line.line, expected: "", actual: ""}) if is_duplicate
                            seen_modules <- seen_modules.push(module) if not is_duplicate
                        Decl.Module(name, body, line):
                            # Recurse into module body with a fresh seen-list (new scope)
                            table <- check_duplicate_imports(body, table)
                        Decl.Scoped(body, line):
                            # Recurse into scoped body with a fresh seen-list (new scope)
                            table <- check_duplicate_imports(body, table)
                        # Other declaration kinds don't affect import tracking
                        _:
                            pass
                    decl_index <- decl_index + 1


    public:
        # Entry point: scan top-level declarations for duplicate imports
        def check_duplicate_import(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_duplicate_imports(declarations, table)
