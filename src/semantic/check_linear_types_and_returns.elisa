extend Semantic:
    private:
        # Names of `linear struct`/`linear typestate` types (affinity "linear"): a value of such
        # a type must be consumed exactly once, so an unconsumed local is a leak.
        def collect_linear_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            out.push(struct_name) if affinity == "linear"
                        Decl.Module(module_name, module_body, module_line):
                            collect_linear_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_linear_type_names(scoped_body, out)
                        _:
                            pass

        def linear_type_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # The linear type name of a local (from its `: Linear` / `: Linear[State]` annotation or a
        # `Linear.new(...)` initializer), or "" when the local is not linear-typed.
        # Whether WHOLE equals PREFIX ++ MIDDLE ++ SUFFIX byte-for-byte.
        def linear_sview_wrapped(whole: sview, prefix: sview, middle: sview, suffix: sview) -> bool:
            can Abort.Panic:
                prefix_len: usize = prefix.len
                middle_len: usize = middle.len
                suffix_len: usize = suffix.len
                return false if whole.len != prefix_len + middle_len + suffix_len
                prefix_ok: bool =
                    for probe in 0..<prefix_len |ok: bool = true| -> ok:
                        ok <- false if whole[probe] != prefix[probe]
                return false if not prefix_ok
                middle_ok: bool =
                    for probe in 0..<middle_len |ok: bool = true| -> ok:
                        ok <- false if whole[prefix_len + probe] != middle[probe]
                return false if not middle_ok
                result: bool =
                    for probe in 0..<suffix_len |ok: bool = true| -> ok:
                        ok <- false if whole[prefix_len + middle_len + probe] != suffix[probe]
                return result

        # The linear type T of a synthesized typestate constructor call `__typestate_T_new(...)`
        # (the lowering of `T.new(...)` for a `linear typestate T`), else "". T must be a known
        # linear type name.
        def linear_typestate_new_type(callee_name: sview, linear_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                prefix: sview = sview("__typestate_", 0, -1)
                suffix: sview = sview("_new", 0, -1)
                found: mutable sview = sview("", 0, 0)
                for candidate in linear_names |found|:
                    found <- candidate if found == "" and linear_sview_wrapped(callee_name, prefix, candidate, suffix)
                return found

        def linear_local_type(type_expression: Ast::Expr, value: Ast::Expr, linear_names: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                head_name: sview = match type_expression:
                    Expr.Index(head, argument, index_line): ident_name_of(head)
                    Expr.IndexN(head, arguments, index_n_line): ident_name_of(head)
                    _: bare_type_name(type_expression)
                return head_name if head_name != "" and linear_type_name_present(linear_names, head_name)
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                ctor_type: sview = ident_name_of(object)
                                return ctor_type if field == "new" and linear_type_name_present(linear_names, ctor_type) else sview("", 0, 0)
                            _:
                                return linear_typestate_new_type(ident_name_of(callee), linear_names)
                    _:
                        return sview("", 0, 0)

        # Collect (linear-local name, decl line) declared in a statement list (recursively).
        # A binding the loop body declares itself is a fresh value on every iteration,
        # whether or not its annotation names a linear type directly.
        def affine_body_declares(body: darray[Ast::Stmt], name: sview) -> bool:
            can Abort.Panic:
                for statement in body |name|:
                    match statement:
                        Stmt.VarDecl(declared, _, _, _):
                            return true if declared == name
                        _:
                            pass
                return false

        def collect_linear_locals(statements: darray[Ast::Stmt], linear_names: darray[sview]&, table: SymbolTable&, out_names: mutable darray[sview]&, out_positions: mutable darray[Ast::Pos]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_positions|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            linear_type: sview = linear_local_type(type_expression, value, linear_names, table)
                            out_names.push(name) if linear_type != ""
                            out_positions.push(line) if linear_type != ""
                        Stmt.Assign(target, operator, value, line):
                            # An un-annotated first binding `t = Ticket.new(...)` parses as Assign,
                            # not VarDecl; detect a linear-valued one by its target ident.
                            assign_name: sview = ident_name_of(target)
                            assign_type: sview = linear_local_type((Ast::Expr.Absent), value, linear_names, table) if assign_name != "" else sview("", 0, 0)
                            out_names.push(assign_name) if assign_type != ""
                            out_positions.push(line) if assign_type != ""
                        Stmt.If(condition, then_body, else_body, line):
                            collect_linear_locals(then_body, linear_names, table, out_names, out_positions)
                            collect_linear_locals(else_body, linear_names, table, out_names, out_positions)
                        Stmt.While(condition, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_positions)
                        Stmt.For(bind, variables, iterable, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_positions)
                        Stmt.Block(kind, clause, binding, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_positions)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out_names, out_positions|:
                                collect_linear_locals(arm.body, linear_names, table, out_names, out_positions)
                        _:
                            pass

        # A BARE `return g` of a linear local returns it by COPY; a linear value must be moved
        # out (`return move g`). `move` wraps the value in Expr.Move, so only a plain-ident
        # return of a known linear local is flagged. Self-contained (own linear-local set),
        # so it needs no threading through the affine walk.
        def linear_return_walk(statements: darray[Ast::Stmt], linear_local_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                match returned:
                                    Expr.Ident(returned_name, returned_line):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: returned_name, line: line.line, expected: "Return", actual: ""}) if any linear_name in linear_local_names where linear_name == returned_name
                                    _:
                                        pass
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- linear_return_walk(then_body, linear_local_names, table)
                            table <- linear_return_walk(else_body, linear_local_names, table)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- linear_return_walk(while_body, linear_local_names, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- linear_return_walk(for_body, linear_local_names, table)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_stmt_line):
                            table <- linear_return_walk(block_body, linear_local_names, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- linear_return_walk(arm.body, linear_local_names, table)
                        _:
                            pass
