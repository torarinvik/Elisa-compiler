extend Semantic:
    private:
        # Collect uses across statements (recursing every nested body). Assignment
        # TARGETS count as uses too — a write keeps a binding "used" for hint
        # purposes (write-only locals are a different, later analysis).
        def collect_statement_uses(statements: darray[Ast::Stmt], used: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |used|:
                    match statement:
                        Stmt.Expr(expression, line):
                            collect_expression_uses(expression, used)
                        Stmt.VarDecl(name, type_expression, value, line):
                            collect_expression_uses(value, used)
                        Stmt.Assign(target, operator, value, line):
                            collect_expression_uses(target, used)
                            collect_expression_uses(value, used)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_expression_uses(condition, used)
                            collect_statement_uses(then_body, used)
                            collect_statement_uses(else_body, used)
                        Stmt.While(condition, body, line):
                            collect_expression_uses(condition, used)
                            collect_statement_uses(body, used)
                        Stmt.For(bind, variables, iterable, body, line):
                            collect_expression_uses(iterable, used)
                            collect_statement_uses(body, used)
                        Stmt.Block(kind, clause, binding, body, line):
                            # Prefix-clause names (`in owner:`, `region r:`, `lock m as g:`)
                            # are region/mutex selectors — they USE the named binding.
                            used.extend([clause_name for clause_name in clause])
                            collect_statement_uses(body, used)
                        Stmt.Match(scrutinee, arms, line):
                            collect_expression_uses(scrutinee, used)
                            for arm in arms:
                                collect_statement_uses(arm.body, used)
                        Stmt.Return(value, line):
                            if value is return_value:
                                collect_expression_uses(return_value, used)
                        Stmt.Contract(kind, expression, line):
                            collect_expression_uses(expression, used)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Discard-convention name: `_` or `_`-prefixed. Uses the seeded sview
        # builtins (NOT stdlib helpers) so the frontend stays self-resolving
        # without the standard library in scope.
        def is_discard_name(name: sview) -> bool:
            can Abort.Panic:
                return name.len > 0 and name[0] == '_'


        # Whether a parameter is ownership-threading ABI: an `Arena`, or a packed
        # enum's qualified `Enum.Store[...]`. Packed pattern tests infer their store
        # from this parameter, so it is semantically consumed without an explicit
        # value reference. Wrappers/type applications are transparent here.
        def type_is_implicit_owner(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        return type_is_implicit_owner(operand)
                    Expr.Ident(name, ident_line):
                        return name == "Arena"
                    Expr.Field(owner, field, field_line):
                        return field == "Store"
                    Expr.Scope(owner, name, scope_line):
                        return name == "Store"
                    Expr.Index(owner, argument, index_line):
                        return type_is_implicit_owner(owner)
                    Expr.IndexN(owner, arguments, index_line):
                        return type_is_implicit_owner(owner)
                    _:
                        return false


        # NOTE: stage0 deliberately has no unused-param/local semantic diagnostic, and stage1
        # must not add one — a lint-only hint that changes acceptance is a parity break. There
        # used to be a `check_unused` hook here that took four arguments and did nothing; the
        # rule it encodes is this comment, not a call. The DiagnosticKind ordinals it was said
        # to pin live in the enum and are unaffected.


        # Recurse the body flagging unused `x: T = v` locals at their own lines.
        def check_unused_locals(statements: darray[Ast::Stmt], table: lmut SymbolTable, used: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if not is_discard_name(name):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnusedLocal, name: name, line: line.line, expected: "", actual: ""}) if not (any used_name in used where used_name == name)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_unused_locals(then_body, table, used)
                            table <- check_unused_locals(else_body, table, used)
                        Stmt.While(condition, body, line):
                            table <- check_unused_locals(body, table, used)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_unused_locals(body, table, used)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_unused_locals(body, table, used)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_unused_locals(arm.body, table, used)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
