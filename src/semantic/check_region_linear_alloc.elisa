# A `linear` value must not be allocated into a REGION.
#
# A region frees its contents in bulk (`destroy` / reset) without consuming them, so a
# linear value placed inside one could never be consumed — the must-consume obligation
# becomes undischargeable. stage0:
#
#   cannot allocate a value containing linear handles into region "r": a region frees its
#   contents in bulk (destroy/reset) without consuming them, so the linear value could
#   never be consumed; keep it outside the region and store a borrow, or consume it
#   explicitly
#
# SOUND SUBSET, in the shape check_darray_linear_consume uses: this flags a REGION-QUALIFIED
# allocation (`new[r] T(...)` / `new[r] T{...}`) whose constructed type is DIRECTLY a linear
# struct. stage0's wording covers a value merely CONTAINING linear handles — a struct with a
# linear field — which needs field-type transitivity this does not attempt. Missing those is
# a conservative under-report; never flagging a non-linear allocation is what matters.
extend Semantic:
    private:
        def region_linear_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            out.push(struct_name) if affinity == "linear"
                        Decl.Module(module_name, module_body, module_line):
                            region_linear_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            region_linear_type_names(scoped_body, out)
                        _:
                            pass


        # The type a construction expression builds: `T(...)` (call form) and `T{...}`
        # (brace form) both name T at the head.
        def region_constructed_type_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return ident_name_of(callee)
                    Expr.Construct(constructed_type, fields, construct_line):
                        return ident_name_of(constructed_type)
                    Expr.Paren(inner, paren_line):
                        return region_constructed_type_name(inner)
                    _:
                        return ""


        def region_linear_alloc_expression(expression: Ast::Expr, linear_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.RegionNew(allocated, region_name, region_new_line):
                        allocated_name: sview = region_constructed_type_name(allocated)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionLinearAllocation, name: region_name, line: region_new_line.line, expected: allocated_name, actual: ""}) if allocated_name != "" and (any linear_name in linear_names where linear_name == allocated_name)
                        table <- region_linear_alloc_expression(allocated, linear_names, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table|:
                            table <- region_linear_alloc_expression(argument, linear_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- region_linear_alloc_expression(left, linear_names, table)
                        table <- region_linear_alloc_expression(right, linear_names, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- region_linear_alloc_expression(operand, linear_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- region_linear_alloc_expression(inner, linear_names, table)
                    _:
                        pass


        def region_linear_alloc_statements(statements: darray[Ast::Stmt], linear_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(var_name, var_type, var_value, var_line):
                            table <- region_linear_alloc_expression(var_value, linear_names, table)
                        Stmt.Expr(statement_expression, statement_line):
                            table <- region_linear_alloc_expression(statement_expression, linear_names, table)
                        Stmt.Return(return_value_opt, return_line):
                            if return_value_opt is return_value:
                                table <- region_linear_alloc_expression(return_value, linear_names, table)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_line):
                            table <- region_linear_alloc_statements(block_body, linear_names, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- region_linear_alloc_statements(then_body, linear_names, table)
                            table <- region_linear_alloc_statements(else_body, linear_names, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- region_linear_alloc_statements(while_body, linear_names, table)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                            table <- region_linear_alloc_statements(for_body, linear_names, table)
                        _:
                            pass


        def region_linear_alloc_declarations(declarations: darray[Ast::Decl], linear_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- region_linear_alloc_statements(body, linear_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- region_linear_alloc_declarations(module_body, linear_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- region_linear_alloc_declarations(scoped_body, linear_names, table)
                        _:
                            pass

    public:
        def check_region_linear_alloc(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                linear_names: mutable darray[sview] = []
                region_linear_type_names(declarations, &linear_names)
                return if linear_names.count == 0
                table <- region_linear_alloc_declarations(declarations, linear_names, table)
