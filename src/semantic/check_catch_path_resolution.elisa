extend Semantic:
    private:
        # Comments are omitted from the parser token stream but preserved in this
        # source-backed path row. Skip whitespace, `#` comments, and triple-quoted
        # block comments while comparing against the canonical module spelling.
        def catch_skip_path_trivia(raw_path: sview, start: usize) -> usize:
            can Abort.Panic:
                cursor: mutable usize = start
                while cursor < raw_path.len:
                    if raw_path[cursor] == 32 or raw_path[cursor] == 9 or raw_path[cursor] == 10 or raw_path[cursor] == 13:
                        cursor <- cursor + 1.usize()
                    elif raw_path[cursor] == 35:
                        while cursor < raw_path.len and raw_path[cursor] != 10 and raw_path[cursor] != 13 |cursor, raw_path|:
                            cursor <- cursor + 1.usize()
                    elif raw_path[cursor] == 34 and cursor + 2.usize() < raw_path.len and raw_path[cursor + 1.usize()] == 34 and raw_path[cursor + 2.usize()] == 34:
                        comment_cursor: mutable usize = cursor + 3.usize()
                        comment_closed: mutable bool = false
                        while comment_cursor + 2.usize() < raw_path.len |comment_cursor, comment_closed, raw_path|:
                            if raw_path[comment_cursor] == 34 and raw_path[comment_cursor + 1.usize()] == 34 and raw_path[comment_cursor + 2.usize()] == 34:
                                cursor <- comment_cursor + 3.usize()
                                comment_closed <- true
                                break
                            comment_cursor <- comment_cursor + 1.usize()
                        return raw_path.len if not comment_closed
                    else:
                        break
                return cursor

        # Compare a raw source path such as `Outer /* comment */ :: Provider` with
        # canonical `Outer::Provider`; comments and whitespace are token trivia.
        def catch_module_path_matches(raw_path: sview, canonical_path: sview) -> bool:
            can Abort.Panic:
                raw_index: mutable usize = 0.usize()
                canonical_index: mutable usize = 0.usize()
                while raw_index < raw_path.len or canonical_index < canonical_path.len |raw_index, canonical_index, raw_path, canonical_path|:
                    raw_index <- catch_skip_path_trivia(raw_path, raw_index)
                    return canonical_index == canonical_path.len if raw_index >= raw_path.len
                    return false if canonical_index >= canonical_path.len
                    if raw_path[raw_index] == 58:
                        return false if canonical_index + 1.usize() >= canonical_path.len or canonical_path[canonical_index] != 58 or canonical_path[canonical_index + 1.usize()] != 58
                        raw_index <- catch_skip_path_trivia(raw_path, raw_index + 1.usize())
                        return false if raw_index >= raw_path.len or raw_path[raw_index] != 58
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 2.usize()
                    else:
                        return false if raw_path[raw_index] != canonical_path[canonical_index]
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 1.usize()
                return true

        def catch_module_path_prefix_end(raw_path: sview, canonical_path: sview) -> (found: bool, offset: usize):
            can Abort.Panic:
                raw_index: mutable usize = 0.usize()
                canonical_index: mutable usize = 0.usize()
                while raw_index < raw_path.len |raw_index, canonical_index, raw_path, canonical_path|:
                    raw_index <- catch_skip_path_trivia(raw_path, raw_index)
                    return (true, canonical_index) if raw_index >= raw_path.len
                    return (false, canonical_index) if canonical_index >= canonical_path.len
                    if raw_path[raw_index] == 58:
                        return (false, canonical_index) if canonical_index + 1.usize() >= canonical_path.len or canonical_path[canonical_index] != 58 or canonical_path[canonical_index + 1.usize()] != 58
                        raw_index <- catch_skip_path_trivia(raw_path, raw_index + 1.usize())
                        return (false, canonical_index) if raw_index >= raw_path.len or raw_path[raw_index] != 58
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 2.usize()
                    else:
                        return (false, canonical_index) if raw_path[raw_index] != canonical_path[canonical_index]
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 1.usize()
                return (true, canonical_index)

        # An alias can name a module that has nested modules. Match the resolved alias
        # target followed by the untouched source suffix against the canonical path.
        def catch_module_alias_path_suffixes_match(alias_module: sview, candidate_module: sview @source, suffixes: darray[sview @source]&) -> bool:
            can Abort.Panic:
                prefix: (found: bool, offset: usize) = catch_module_path_prefix_end(alias_module, candidate_module)
                return false if not prefix.found
                suffix_offset: mutable usize = prefix.offset
                for suffix in suffixes |candidate_module, suffix_offset|:
                    continue if suffix == ""
                    return false if candidate_module.len <= suffix_offset + 2.usize()
                    return false if candidate_module[suffix_offset] != 58 or candidate_module[suffix_offset + 1.usize()] != 58
                    suffix_match: (found: bool, offset: usize) = catch_module_path_prefix_end(suffix, candidate_module[suffix_offset + 2.usize():candidate_module.len])
                    return false if not suffix_match.found
                    suffix_offset <- suffix_offset + 2.usize() + suffix_match.offset
                return suffix_offset == candidate_module.len

        def catch_module_alias_path_matches(alias_module: sview, alias_scope: sview @source, suffixes: darray[sview @source]&, candidate_module: sview @source) -> bool:
            can Abort.Panic:
                if alias_scope != "":
                    scope_prefix: (found: bool, offset: usize) = catch_module_path_prefix_end(alias_scope, candidate_module)
                    return false if not scope_prefix.found or scope_prefix.offset + 2.usize() >= candidate_module.len
                    return false if candidate_module[scope_prefix.offset] != 58 or candidate_module[scope_prefix.offset + 1.usize()] != 58
                    relative_candidate: sview @source = candidate_module[scope_prefix.offset + 2.usize():candidate_module.len]
                    return catch_module_alias_path_suffixes_match(alias_module, relative_candidate, suffixes)
                return catch_module_alias_path_suffixes_match(alias_module, candidate_module, suffixes)

        # Relative `using Target as Alias` targets may name a sibling or root module.
        # Retry the resolved target from the alias scope through its lexical parents,
        # preserving suffixes, before deciding the qualified callable cannot match.
        def catch_module_alias_path_matches_ancestor(alias_module: sview, alias_scope: sview @source, suffixes: darray[sview @source]&, candidate_module: sview @source) -> bool:
            can Abort.Panic:
                module_scope: mutable sview @source = alias_scope
                while true |module_scope, alias_module, suffixes, candidate_module|:
                    return true if catch_module_alias_path_matches(alias_module, module_scope, suffixes, candidate_module)
                    break if module_scope == ""
                    module_scope <- catch_module_parent_path(module_scope)
                return false

        # Wildcard import targets are resolved relative to the scope containing the
        # `using` declaration. Keep this form separate from module-alias expansion: the
        # raw target is not rewritten through a `using ... as ...` alias.
        def catch_module_path_matches_relative(import_scope: sview @source, raw_module: sview, candidate_module: sview @source) -> bool:
            can Abort.Panic:
                suffixes: darray[sview @source] = []
                return true if catch_module_path_matches(raw_module, candidate_module)
                return catch_module_alias_path_matches(raw_module, import_scope, suffixes, candidate_module)

        def catch_family_separator_start(path: sview, family_start: usize) -> usize:
            can Abort.Panic:
                cursor: mutable usize = 0.usize()
                separator: mutable usize = path.len
                while cursor < family_start |cursor, separator, path, family_start|:
                    cursor <- catch_skip_path_trivia(path, cursor)
                    break if cursor >= family_start
                    if path[cursor] == 58:
                        next_colon: usize = catch_skip_path_trivia(path, cursor + 1.usize())
                        if next_colon < family_start and path[next_colon] == 58:
                            separator <- cursor
                            cursor <- next_colon + 1.usize()
                        else:
                            cursor <- cursor + 1.usize()
                    else:
                        cursor <- cursor + 1.usize()
                return separator

        def catch_first_module_separator_start(path: sview) -> usize:
            can Abort.Panic:
                cursor: mutable usize = 0.usize()
                while cursor < path.len |cursor, path|:
                    cursor <- catch_skip_path_trivia(path, cursor)
                    break if cursor >= path.len
                    if path[cursor] == 58:
                        next_colon: usize = catch_skip_path_trivia(path, cursor + 1.usize())
                        return cursor if next_colon < path.len and path[next_colon] == 58
                        cursor <- cursor + 1.usize()
                    else:
                        cursor <- cursor + 1.usize()
                return path.len

        def catch_module_parent_path(module_path: sview) -> sview:
            can Abort.Panic:
                separator: mutable usize = module_path.len
                offset: mutable usize = 0.usize()
                while offset + 1.usize() < module_path.len |separator, offset, module_path|:
                    separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                    offset <- offset + 1.usize()
                return "" if separator == module_path.len
                return module_path[0:separator]

        # Select family candidates for one qualified-name tier. Relative namespace and
        # alias tiers use the same prefix/suffix matcher; the final raw-spelling tier may
        # additionally compare the source path directly with a canonical module owner.
        def catch_error_family_module_candidate(annotations: darray[Ast::EnumAnnotation]&, family: sview, path_module: sview, path_scope: sview @source, suffixes: darray[sview @source]&, allow_direct: bool, table: SymbolTable&) -> (found: bool, ambiguous: bool, module: sview @source):
            can Abort.Panic:
                selected_module: mutable sview @source = ""
                found: mutable bool = false
                ambiguous: mutable bool = false
                for declaration in annotations |selected_module, found, ambiguous, annotations, family, path_module, path_scope, suffixes, allow_direct, table|:
                    continue if (declaration.owner != "__error_set_decl" and declaration.owner != "__catch_unknown_error_set_decl") or declaration.name != family
                    candidate_module: sview @source = declaration.module
                    relative_match: bool = catch_module_alias_path_matches(path_module, path_scope, suffixes, candidate_module)
                    direct_match: bool = allow_direct and catch_module_path_matches(path_module, candidate_module)
                    continue if not relative_match and not direct_match
                    if declaration.owner == "__catch_unknown_error_set_decl":
                        ambiguous <- true
                        continue
                    if not found:
                        selected_module <- candidate_module
                        found <- true
                    elif selected_module != candidate_module:
                        ambiguous <- true
                return (found, ambiguous, selected_module)

        # Empty paths and exact bare family names retain legacy leaf lookup. Any other
        # nonempty spelling must resolve to one qualified owner or stay unresolved; callers
        # must not retry malformed or qualified paths with the bare family leaf.
        def catch_explicit_error_family_module(path: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, function_module: sview @source, family: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, uncertain: bool, module: sview @source):
            can Abort.Panic:
                return (false, false, family) if path == ""
                path_end: mutable usize = path.len
                while path_end > 0 and (path[path_end - 1.usize()] == 32 or path[path_end - 1.usize()] == 9) |path_end, path|:
                    path_end <- path_end - 1.usize()
                qualified_separator: usize = catch_first_module_separator_start(path[0:path_end])
                qualified_path: bool = qualified_separator != path_end
                return (false, true, "") if path_end < family.len
                family_start: usize = path_end - family.len
                path_has_family: bool = catch_module_path_matches(path[family_start:path_end], family)
                return (false, true, "") if not path_has_family
                separator: usize = catch_family_separator_start(path, family_start)
                if separator == path.len:
                    return (false, false, family) if catch_module_path_matches(path[0:path_end], family)
                    return (false, true, "")
                return (false, true, "") if not qualified_path
                raw_module: sview @source = path[0:separator]
                empty_suffixes: darray[sview @source] = []
                # Core first probes its canonical named-type table using the written
                # qualified path, before trying namespace-relative or alias lookup.
                raw_candidate: (found: bool, ambiguous: bool, module: sview @source) = catch_error_family_module_candidate(annotations, family, raw_module, "", empty_suffixes, true, table)
                return (false, true, "") if raw_candidate.ambiguous
                return (true, false, raw_candidate.module) if raw_candidate.found
                lexical_scope: mutable sview @source = function_module
                while lexical_scope != "" |lexical_scope, family, raw_module, empty_suffixes, table|:
                    lexical_candidate: (found: bool, ambiguous: bool, module: sview @source) = catch_error_family_module_candidate(annotations, family, raw_module, lexical_scope, empty_suffixes, false, table)
                    return (false, true, "") if lexical_candidate.ambiguous
                    return (true, false, lexical_candidate.module) if lexical_candidate.found
                    lexical_scope <- catch_module_parent_path(lexical_scope)
                alias_target: (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]) = catch_module_qualifier_alias_target(annotations, raw_module, function_module, declaration_line, declaration_offset)
                return (false, true, "") if alias_target.uncertain
                if alias_target.found:
                    alias_scope: mutable sview @source = alias_target.scope
                    while true |alias_scope, family, alias_target, table|:
                        alias_candidate: (found: bool, ambiguous: bool, module: sview @source) = catch_error_family_module_candidate(annotations, family, alias_target.module, alias_scope, alias_target.suffixes, false, table)
                        return (false, true, "") if alias_candidate.ambiguous
                        return (true, false, alias_candidate.module) if alias_candidate.found
                        break if alias_scope == ""
                        alias_scope <- catch_module_parent_path(alias_scope)
                return (false, true, "")

        def catch_error_family_module_for_declaration(annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, family: sview @source, family_path: sview @source, function_module_known: bool, function_module: sview @source, table: SymbolTable&) -> (known: bool, module: sview @source):
            can Abort.Panic:
                explicit_module: (found: bool, uncertain: bool, module: sview @source) = catch_explicit_error_family_module(family_path, declaration_line, declaration_offset, declaration_identity_id, function_module, family, annotations, table)
                return (false, family) if explicit_module.uncertain
                if explicit_module.found:
                    # `__error_set_decl` is the family inventory, including an empty set.
                    # Do not require a variant-owner row to confirm a declaration that can
                    # validly have no variants.
                    return (true, explicit_module.module)
                return catch_error_family_module(family, function_module_known, function_module, annotations)

        # Whether the CALLEE narrows `family` to a subset of its variants -- the
        # `error[FooError{Bad1}, ...]` form. Such a catch is exhaustive once it handles the
        # ALLOWED variants, so sweeping the family's full variant list demands arms for errors
        # the call can never raise: an exhaustive subset catch was flagged for a missing
        # `FooError.Bad2` that `error[FooError{Bad1}]` had already excluded, and stage0 is
        # silent on it. check_catch_out_of_set.elisa already does subset-aware exhaustiveness
        # off these same rows (CatchSubsetNonExhaustive), so this check yields the family to it
        # rather than duplicating the subset arithmetic and disagreeing with it. NOTE these
        # rows put the MARKER in `owner` and the payload in `name` -- the opposite of every
        # other row read in this file.
        def catch_family_is_subset(annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview, family_path: sview) -> bool:
            can Abort.Panic:
                for family_index in 0..<annotations.count:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line or family_annotation.name != family
                    continue if family_annotation.offset != declaration_offset
                    continue if family_annotation.identity_id != declaration_identity_id
                    continue if family_annotation.occurrence_offset != occurrence_offset
                    continue if family_index + 2.usize() >= annotations.count
                    family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != occurrence_offset
                    continue if family_path != "" and not catch_module_path_matches(family_path_annotation.name, family_path)
                    subset_annotation: Ast::EnumAnnotation = annotations[family_index + 2.usize()]
                    return true if subset_annotation.owner == "__error_variant_family" and subset_annotation.line == declaration_line and subset_annotation.name == family and subset_annotation.offset == family_annotation.offset and subset_annotation.identity_id == family_annotation.identity_id and subset_annotation.occurrence_offset == occurrence_offset
                # Old parser producers without family/path rows remain supported only when
                # both rows still carry concrete source identity. An absent legacy offset
                # cannot be treated as a wildcard because byte zero is a valid position.
                return any annotation in annotations where occurrence_offset == 0 and family_path == "" and declaration_offset != 0 and declaration_identity_id != 0 and annotation.owner == "__error_variant_family" and annotation.line == declaration_line and annotation.name == family and annotation.offset == declaration_offset and annotation.identity_id == declaration_identity_id

        # A restricted family occurrence contributes only its listed variants to the
        # caught union. The rows after the family/path pair stay adjacent until the next
        # family row, so repeated short names in excluded variants must not make a valid
        # fallback arm ambiguous.
        def catch_family_row_allows_variant(annotations: darray[Ast::EnumAnnotation]&, family_index: usize, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview, variant: sview) -> bool:
            can Abort.Panic:
                return false if family_index >= annotations.count
                family_annotation: Ast::EnumAnnotation = annotations[family_index]
                return false if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line or family_annotation.name != family
                return false if family_annotation.offset != declaration_offset
                return false if family_annotation.identity_id != declaration_identity_id
                return false if family_annotation.occurrence_offset != occurrence_offset
                return true if family_index + 2.usize() >= annotations.count
                family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                return true if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != occurrence_offset
                subset_annotation: Ast::EnumAnnotation = annotations[family_index + 2.usize()]
                return true if subset_annotation.owner != "__error_variant_family" or subset_annotation.line != declaration_line or subset_annotation.name != family or subset_annotation.offset != family_annotation.offset or subset_annotation.identity_id != family_annotation.identity_id or subset_annotation.occurrence_offset != occurrence_offset
                allow_index: mutable usize = family_index + 3.usize()
                while allow_index < annotations.count |allow_index, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family_annotation, variant|:
                    allow_annotation: Ast::EnumAnnotation = annotations[allow_index]
                    # The next family occurrence is a hard boundary even when it belongs
                    # to a different declaration on the same source line.
                    if allow_annotation.owner == "__error_set_family" and allow_annotation.line == declaration_line:
                        break
                    return true if allow_annotation.owner == "__error_variant_allow" and allow_annotation.line == declaration_line and allow_annotation.name == variant and allow_annotation.offset == family_annotation.offset and allow_annotation.identity_id == family_annotation.identity_id and allow_annotation.occurrence_offset == occurrence_offset
                    allow_index <- allow_index + 1.usize()
                return false

        def catch_error_family(annotations: darray[Ast::EnumAnnotation]&, callee: sview, declaration_line: u32) -> sview:
            can Abort.Panic:
                # SKIP EVERY RESERVED MARKER, not the two that existed when this was
                # written. The parser records several rows against a function at its
                # declaration line; `__lsp_func_name` is pushed BEFORE `__error_return`,
                # so the old two-name denylist returned "__lsp_func_name" as the error
                # FAMILY for every `def`. No enum owns that name, so the variant sweep
                # below matched nothing and `non-exhaustive catch` could never fire on a
                # catch of an ordinary function -- stage0 reports it. A family is a type
                # name and can never begin with `__`, so the prefix is the right test.
                for annotation in annotations:
                    continue if annotation.owner != callee or annotation.line != declaration_line
                    return annotation.name if not catch_name_is_reserved_marker(annotation.name)
                return ""

        # A reserved parser marker (`__error_return`, `__lsp_func_name`, `__export_array`, …)
        # rather than a user-visible name.
        def catch_name_is_reserved_marker(name: sview) -> bool:
            can Abort.Panic:
                return false if name.len < 2
                return name[0] == 95 and name[1] == 95

        def catch_line_has(annotations: darray[Ast::EnumAnnotation]&, callee: sview, line: u32, offset: u32, module: sview, name: sview) -> bool:
            for annotation in annotations:
                return true if annotation.owner == callee and annotation.line == line and annotation.offset == offset and annotation.module == module and annotation.name == name
            return false

        def catch_variant_path_is_exact(path: sview, family: sview, variant: sview, family_module: sview) -> bool:
            can Abort.Panic:
                cursor: mutable usize = 0.usize()
                if family_module != "":
                    return false if path.len < family_module.len + 2.usize()
                    for index in 0..<family_module.len |path, family_module|:
                        return false if path[index] != family_module[index]
                    cursor <- family_module.len
                    return false if path[cursor] != 58 or path[cursor + 1.usize()] != 58
                    cursor <- cursor + 2.usize()
                return false if path.len - cursor != family.len + 1.usize() + variant.len
                for index in 0..<family.len |path, family, cursor|:
                    return false if path[cursor + index] != family[index]
                cursor <- cursor + family.len
                return false if path[cursor] != 46
                cursor <- cursor + 1.usize()
                for index in 0..<variant.len |path, variant, cursor|:
                    return false if path[cursor + index] != variant[index]
                return true

        # Stage0 normalizes `::` to `.` and MatchErrorTag falls back to the suffix after the
        # first dot. Compare that normalized short tag without allocating. This accepts one
        # arbitrary leading module component (`Wrong::Fault.Bad` for `Local::Fault.Bad`) but
        # rejects extra noncanonical components (`Wrong::Other::Fault.Bad`).
        def catch_variant_path_matches(path: sview, family: sview, variant: sview, family_module: sview) -> bool:
            can Abort.Panic:
                # Stage0's short name for a root `Fault.Bad` tag is just `Bad`.
                # Module-scoped tags retain the family component (`Fault.Bad`), so
                # a bare `Bad` arm must not match `Local::Fault.Bad`.
                return true if path == variant and family_module == ""
                short_start: mutable usize = 0.usize()
                for index in 0..<path.len |short_start, path|:
                    if path[index] == 58 and index + 1.usize() < path.len and path[index + 1.usize()] == 58:
                        short_start <- index + 2.usize()
                        break
                    if path[index] == 46:
                        short_start <- index + 1.usize()
                        break
                cursor: mutable usize = short_start
                if family_module == "":
                    return path[cursor:path.len] == variant
                module_separator: mutable usize = family_module.len
                for index in 0..<family_module.len |family_module, module_separator|:
                    if family_module[index] == 58 and index + 1.usize() < family_module.len and family_module[index + 1.usize()] == 58:
                        module_separator <- index
                        break
                if module_separator < family_module.len:
                    module_tail: sview = family_module[module_separator + 2.usize():family_module.len]
                    return false if path.len - cursor < module_tail.len + 2.usize()
                    for index in 0..<module_tail.len |path, module_tail, cursor|:
                        return false if path[cursor + index] != module_tail[index]
                    cursor <- cursor + module_tail.len
                    return false if path[cursor] != 58 or path[cursor + 1.usize()] != 58
                    cursor <- cursor + 2.usize()
                return false if path.len - cursor < family.len + 1.usize() + variant.len
                for index in 0..<family.len |path, family, cursor|:
                    return false if path[cursor + index] != family[index]
                cursor <- cursor + family.len
                return false if path[cursor] != 46
                cursor <- cursor + 1.usize()
                return path[cursor:path.len] == variant

