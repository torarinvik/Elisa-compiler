# Mandatory authority for mutable global storage. Declaration identities include their
# lexical module; binding stacks advance in source order and unwind at module_scope exits.
# `can` grants access locally and exports the effect. `trusted` grants only its named
# members and hides precisely those members from callers.
extend Semantic:
    private:
        const GLOBAL_AUTHORITY_NONE: usize = 4294967295
        const GLOBAL_AUTHORITY_UNKNOWN_ALIAS: usize = 4294967294
        # Reserved ceiling for encoded local-root identities. The legacy generic local
        # alias sentinel remains below UNKNOWN_ALIAS but is no longer emitted.
        const GLOBAL_AUTHORITY_LOCAL_ALIAS: usize = 4294967293
        const GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS: u8 = 2
        const GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT: u32 = 128
        # Return-origin summary value meaning "the join of the call's arguments". Only
        # stored in return_origins; never used as an origin itself.
        const GLOBAL_AUTHORITY_ARGUMENT_RESULT: usize = 4294967292

        struct GlobalAuthority:
            parents: mutable darray[usize] = []
            # Published names borrow parser source/static text; only the row buffers are local.
            modules: mutable darray[sview @source] = []
            module_starts: mutable darray[usize] = []
            module_lengths: mutable darray[usize] = []
            globals: mutable darray[sview] = []
            global_scopes: mutable darray[usize] = []
            global_types: mutable darray[Ast::Expr] = []
            writable: mutable darray[bool] = []
            canonical_declarations: mutable darray[Ast::Decl?] = []
            functions: mutable darray[sview @source] = []
            function_heads: mutable dict[u64, usize] = {}
            # `globals` rows chained by name hash (newest first); see ga_resolve_global.
            # Module children by (parent, segment) hash, chained newest first; see ga_child_part.
            module_child_heads: mutable dict[u64, usize] = {}
            module_child_next: mutable darray[usize] = []
            global_heads: mutable dict[u64, usize] = {}
            global_next: mutable darray[usize] = []
            enum_heads: mutable dict[u64, usize] = {}
            enum_next: mutable darray[usize] = []
            struct_heads: mutable dict[u64, usize] = {}
            struct_next: mutable darray[usize] = []
            alias_heads: mutable dict[u64, usize] = {}
            alias_next: mutable darray[usize] = []
            function_next: mutable darray[usize] = []
            function_scopes: mutable darray[usize] = []
            function_offsets: mutable darray[u32] = []
            function_lines: mutable darray[u32] = []
            function_variadic: mutable darray[bool] = []
            function_return_types: mutable darray[Ast::Expr?] = []
            returned_callees: mutable darray[usize] = []
            callback_result_sources: mutable darray[usize] = []
            callback_result_slots: mutable darray[usize] = []
            callback_origin_from: mutable darray[usize] = []
            callback_origin_to: mutable darray[usize] = []
            callback_origin_heads: mutable dict[usize, usize] = {}
            callback_origin_tails: mutable dict[usize, usize] = {}
            callback_origin_next: mutable darray[usize] = []
            callback_origin_indexed: mutable bool = false
            callback_join_slots: mutable darray[usize] = []
            callback_join_owners: mutable darray[usize] = []
            callback_join_offsets: mutable darray[u32] = []
            callback_join_scopes: mutable darray[usize] = []
            unknown_callback_slot: mutable usize = GLOBAL_AUTHORITY_NONE
            parameter_starts: mutable darray[usize] = []
            parameter_counts: mutable darray[usize] = []
            parameter_minimum: mutable darray[usize] = []
            protocol_names: mutable darray[sview] = []
            protocol_contract_slots: mutable darray[usize] = []
            protocol_contract_offsets: mutable darray[u32] = []
            protocol_contract_scopes: mutable darray[usize] = []
            protocol_scopes: mutable darray[usize] = []
            # Exact indexes for protocol/generic annotations, prepared once after the
            # module tree is complete. Hash chains retain the source rows for exact checks.
            protocol_member_heads: mutable dict[u64, usize] = {}
            protocol_member_next: mutable darray[usize] = []
            protocol_member_offsets: mutable darray[u32] = []
            protocol_member_scopes: mutable darray[usize] = []
            protocol_member_names: mutable darray[sview] = []
            protocol_member_annotation_count: mutable usize = 0
            protocol_member_module_count: mutable usize = 0
            protocol_member_index_ready: mutable bool = false
            protocol_bound_heads: mutable dict[u64, usize] = {}
            protocol_bound_tails: mutable dict[u64, usize] = {}
            protocol_bound_next: mutable darray[usize] = []
            protocol_bound_offsets: mutable darray[u32] = []
            protocol_bound_lines: mutable darray[u32] = []
            protocol_bound_scopes: mutable darray[usize] = []
            protocol_bound_generics: mutable darray[sview] = []
            protocol_bound_names: mutable darray[sview] = []
            protocol_bound_module_count: mutable usize = 0
            protocol_bound_annotation_count: mutable usize = 0
            protocol_bound_index_ready: mutable bool = false
            enum_names: mutable darray[sview] = []
            enum_scopes: mutable darray[usize] = []
            enum_variant_owners: mutable darray[sview] = []
            enum_variant_scopes: mutable darray[usize] = []
            enum_variant_names: mutable darray[sview] = []
            enum_variant_payload_starts: mutable darray[usize] = []
            enum_variant_payload_counts: mutable darray[usize] = []
            enum_variant_payload_names: mutable darray[sview] = []
            enum_variant_payload_types: mutable darray[Ast::Expr] = []
            struct_names: mutable darray[sview] = []
            struct_scopes: mutable darray[usize] = []
            field_owners: mutable darray[sview] = []
            field_scopes: mutable darray[usize] = []
            field_names: mutable darray[sview] = []
            field_types: mutable darray[Ast::Expr] = []
            # Exact per-owner chains over field/variant rows, ascending, built once by
            # ga_prepare_member_index; see ga_field_first/ga_variant_first.
            struct_field_first: mutable darray[usize] = []
            field_row_next: mutable darray[usize] = []
            enum_variant_first: mutable darray[usize] = []
            variant_row_next: mutable darray[usize] = []
            alias_names: mutable darray[sview] = []
            alias_scopes: mutable darray[usize] = []
            alias_types: mutable darray[Ast::Expr] = []
            parameter_functions: mutable darray[usize] = []
            parameter_names: mutable darray[sview] = []
            parameter_types: mutable darray[Ast::Expr] = []
            parameter_defaults: mutable darray[Ast::Expr?] = []
            default_depth: mutable u32 = 0
            walk_depth: mutable u32 = 0
            walk_depth_reported: mutable bool = false
            walk_overflow: mutable bool = false
            walk_overflow_pos: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            grant_scopes: mutable darray[usize] = []
            firewall_scopes: mutable darray[usize] = []
            inline_scopes: mutable darray[usize] = []
            capability_heads: mutable dict[u64, usize] = {}
            capability_next: mutable darray[usize] = []
            permission_heads: mutable dict[u64, usize] = {}
            permission_next: mutable darray[usize] = []
            capabilities_indexed: mutable bool = false
            permission_includes_present: mutable bool = false
            permission_names: mutable darray[sview] = []
            permission_scopes: mutable darray[usize] = []
            row_edge_filter_scopes: mutable darray[usize] = []
            capability_names: mutable darray[sview] = []
            capability_scopes: mutable darray[usize] = []
            capability_refs: mutable darray[sview] = []
            effect_refs: mutable darray[sview @source] = []
            effect_ref_heads: mutable dict[u64, usize] = {}
            effect_ref_next: mutable darray[usize] = []
            # File-local exact permission-parameter classification, prepared only after
            # canonical refs are published and consumed by the Global row report walk.
            permission_param_ref_flags: mutable darray[bool] = []
            permission_param_ref_names: mutable darray[sview] = []
            permission_param_ref_lengths: mutable darray[usize] = []
            permission_param_ref_count: mutable usize = 0
            permission_param_annotation_count: mutable usize = 0
            permission_param_ref_flags_ready: mutable bool = false
            effect_row_heads: mutable darray[usize] = []
            effect_row_refs: mutable darray[usize] = []
            effect_row_next: mutable darray[usize] = []
            effect_row_mandatory: mutable darray[bool] = []
            effect_row_scopes: mutable darray[usize] = []
            row_edge_from: mutable darray[usize] = []
            row_edge_to: mutable darray[usize] = []
            row_edge_filter_starts: mutable darray[usize] = []
            row_edge_filter_counts: mutable darray[usize] = []
            row_edge_filter_refs: mutable darray[usize] = []
            reads: mutable darray[bool] = []
            writes: mutable darray[bool] = []
            edge_from: mutable darray[usize] = []
            edge_to: mutable darray[usize] = []
            edge_reads: mutable darray[bool] = []
            edge_writes: mutable darray[bool] = []
            local_floor: mutable usize = 0
            local_limit: mutable usize = GLOBAL_AUTHORITY_NONE
            locals: mutable darray[sview] = []
            local_types: mutable darray[Ast::Expr?] = []
            local_type_scopes: mutable darray[usize] = []
            local_callees: mutable darray[usize] = []
            local_global_origins: mutable darray[usize] = []
            # Stable-within-analysis identities prevent a captured local-root origin
            # from silently naming a different binding after lexical slots are reused.
            local_origin_ids: mutable darray[usize] = []
            # Locals below this index are the current top-level function's parameters.
            parameter_limit: mutable usize = 0
            # Per-function summary of what a returned reference may alias: NONE, one
            # global slot, ARGUMENT_RESULT, or UNKNOWN_ALIAS (the default; also every
            # function without a walked body). A quiet pre-walk computes them from
            # all-unknown inputs, so every summary over-approximates its function.
            return_origins: mutable darray[usize] = []
            return_origin_acc: mutable darray[usize] = []
            return_summary_dirty: mutable darray[bool] = []
            return_summary_changed: mutable darray[bool] = []
            return_dep_callers: mutable darray[usize] = []
            return_dep_callees: mutable darray[usize] = []
            summary_dependency_rounds: mutable bool = true
            summary_walk: mutable bool = false
            summary_function: mutable usize = GLOBAL_AUTHORITY_NONE
            next_local_origin_id: mutable usize = 0
            return_type: mutable Ast::Expr? = null
            lambda_depth: mutable u32 = 0
            inline_refs: mutable darray[sview] = []
            inline_spans: mutable darray[Ast::Pos] = []
            inline_prefix_ends: mutable darray[u32] = []
            global_mutable_heads: mutable dict[u64, usize] = {}
            global_mutable_owners: mutable darray[sview] = []
            global_mutable_offsets: mutable darray[u32] = []
            global_mutable_lines: mutable darray[u32] = []
            global_mutable_modules: mutable darray[sview] = []
            global_mutable_next: mutable darray[usize] = []
            import_annotations: mutable darray[Ast::EnumAnnotation] = []
            # Per import row, filled once collection ends (ga_prepare_import_scopes): the row's
            # own module scope and the scope it imports from (modules.count when none).
            import_module_scopes: mutable darray[usize] = []
            import_target_scopes: mutable darray[usize] = []
            # `__tuple_label` annotations sorted by offset (ga_prepare_import_scopes); built flag.
            tuple_label_offsets: mutable darray[u32] = []
            tuple_label_names: mutable darray[sview] = []
            tuple_labels_ready: mutable bool = false
            grants: mutable darray[sview] = []
            firewalls: mutable darray[sview] = []
            annotations: darray[Ast::EnumAnnotation]
            generic_lines: darray[u32] = []
            generic_names: darray[sview] = []
            generic_head_heads: mutable dict[u64, usize] = {}
            generic_head_next: mutable darray[usize] = []
            generic_head_index_names: mutable darray[sview] = []
            generic_head_source_count: mutable usize = 0
            generic_head_index_ready: mutable bool = false
            module_scope: mutable usize = 0
            function: mutable usize = 0
            report: mutable bool = false
            strict_unsafe: mutable bool = false
            progress_enabled: mutable bool = false
            progress_functions: mutable u64 = 0

        def ga_import_visible(module: sview, state: GlobalAuthority&, lexical_scope: usize = GLOBAL_AUTHORITY_NONE) -> bool:
            can Abort.Panic:
                return true if module == ""
                module_scope: mutable usize = state.module_scope if lexical_scope == GLOBAL_AUTHORITY_NONE else lexical_scope
                while module_scope != 0 |module_scope|:
                    return true if module_scope == ga_module_text(module, state)
                    module_scope <- state.parents[module_scope]
                return false

        # Select the nearest visible alias declaration for a head. A tie at one lexical
        # depth is ambiguous and must not depend on annotation insertion order.
        def ga_module_alias_choice(name: sview, lexical_scope: usize, state: GlobalAuthority&) -> (found: bool, ambiguous: bool, index: usize, scope: usize):
            can Abort.Panic:
                return (false, false, state.annotations.count, state.modules.count) if lexical_scope >= state.parents.count
                selected_index: mutable usize = state.annotations.count
                selected_scope: mutable usize = state.modules.count
                best_distance: mutable usize = state.modules.count
                ambiguous: mutable bool = false
                for alias_index in 0..<state.annotations.count:
                    alias: Ast::EnumAnnotation = state.annotations[alias_index]
                    continue if alias.name != "__using_alias" or alias.owner != name
                    alias_scope: usize = ga_module_text(alias.module, state)
                    continue if alias_scope >= state.modules.count
                    distance: mutable usize = 0
                    current: mutable usize = lexical_scope
                    while current < state.parents.count and current != alias_scope |current, distance|:
                        break if current == 0
                        current <- state.parents[current]
                        distance <- distance + 1
                    continue if current != alias_scope
                    if distance < best_distance:
                        best_distance <- distance
                        selected_index <- alias_index
                        selected_scope <- alias_scope
                        ambiguous <- false
                    elif distance == best_distance:
                        ambiguous <- true
                return (selected_scope < state.modules.count, ambiguous, selected_index, selected_scope)

        # Alias target rows are paired by the alias token's full declaration identity.
        def ga_module_alias_target_path(module: sview, line: u32, offset: u32, state: GlobalAuthority&) -> (found: bool, path: sview):
            can Abort.Panic:
                target_path: mutable sview = ""
                target_count: mutable usize = 0
                for target in state.annotations:
                    continue if target.name != "__using_alias_target" or target.offset != offset or target.line != line or target.module != module
                    target_path <- target.owner
                    target_count <- target_count + 1
                return (target_count == 1, target_path)

        def ga_module_lexical_child(name: sview, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current < state.parents.count |current|:
                    child: usize = ga_child(state, current, name)
                    return child if child < state.modules.count
                    break if current == 0
                    current <- state.parents[current]
                return state.modules.count

        # Resolve a complete raw module path through lexical parents. Try each complete
        # candidate so a missing suffix in a nearer namespace does not hide a valid root
        # fallback for the original spelling.
        def ga_module_lexical_path(path: sview, first: sview, start_index: usize, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current < state.parents.count |current|:
                    child: usize = ga_child(state, current, first)
                    if child < state.modules.count:
                        candidate: usize = ga_module_path_suffix(path, start_index, child, state)
                        return candidate if candidate < state.modules.count
                    break if current == 0
                    current <- state.parents[current]
                return state.modules.count

        def ga_module_path_suffix(path: sview, start_index: usize, base_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if base_scope >= state.modules.count or start_index > path.len
                current: mutable usize = base_scope
                start: mutable usize = start_index
                while start < path.len |start, current|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    part: sview = effect_ref_trim_layout(path[start:end])
                    return state.modules.count if part.len == 0
                    current <- ga_child(state, current, part)
                    return state.modules.count if current >= state.modules.count
                    return state.modules.count if end < path.len and (end + 2 >= path.len or path[end + 1] != 58)
                    start <- path.len if end == path.len else end + 2
                return current

        # Resolve an unaliased target relative to exactly the module where its alias was
        # declared. Do not climb to a same-named root module; the using-site resolver owns
        # fallback to the alias's raw spelling when this canonical target is absent.
        def ga_module_path_exact(path: sview, declaration_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if declaration_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                first_scope: usize = ga_child(state, declaration_scope, first)
                return state.modules.count if first_scope >= state.modules.count
                start: usize = path.len if first_end == path.len else first_end + 2
                return ga_module_path_suffix(path, start, first_scope, state)

        # Resolve a `using TARGET as ALIAS` target. Existing alias heads are expanded
        # before module lookup, matching Stage0 registration order, including forward
        # chains collected in the same declaration block. Non-alias paths stay anchored
        # to the exact declaration module.
        def ga_module_alias_target_resolve(path: sview, declaration_scope: usize, state: GlobalAuthority&, depth: u32 = 0) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if declaration_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, declaration_scope, state)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                return ga_module_path_exact(path, declaration_scope, state) if not alias.found
                alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                target: (found: bool, path: sview) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                return GLOBAL_AUTHORITY_NONE if not target.found
                resolved: usize = ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1)
                return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                return state.modules.count if resolved >= state.modules.count
                start: usize = path.len if first_end == path.len else first_end + 2
                return ga_module_path_suffix(path, start, resolved, state)

        # Resolve a module path at a use site. Expression paths can prefer a complete
        # concrete child in the current lexical module, then a visible alias, then the
        # original spelling through lexical parents. Import annotations keep their own
        # lookup order and call this helper with use_site_child_precedence=false.
        def ga_module_alias_resolve(path: sview, lexical_scope: usize, state: GlobalAuthority&, depth: u32 = 0, use_site_child_precedence: bool = false) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if lexical_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                start: usize = path.len if first_end == path.len else first_end + 2
                if use_site_child_precedence and lexical_scope != 0:
                    direct_child: usize = ga_child(state, lexical_scope, first)
                    if direct_child < state.modules.count:
                        direct_path: usize = ga_module_path_suffix(path, start, direct_child, state)
                        return direct_path if direct_path < state.modules.count
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, lexical_scope, state)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                resolved: mutable usize = state.modules.count
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    return GLOBAL_AUTHORITY_NONE if not target.found
                    resolved <- ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1)
                    return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                if use_site_child_precedence:
                    if alias.found and resolved < state.modules.count:
                        alias_path: usize = ga_module_path_suffix(path, start, resolved, state)
                        return alias_path if alias_path < state.modules.count
                    return ga_module_lexical_path(path, first, start, lexical_scope, state)
                if not alias.found or resolved >= state.modules.count:
                    resolved <- ga_module_lexical_child(first, lexical_scope, state)
                return state.modules.count if resolved >= state.modules.count
                return ga_module_path_suffix(path, start, resolved, state)

        def ga_index_mutable_annotations(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in state.annotations |state|:
                    continue if annotation.name != "__global_mutable"
                    hash: u64 = name_hash(annotation.owner)
                    previous: usize = head if state.global_mutable_heads.get(hash) is head else GLOBAL_AUTHORITY_NONE
                    index: usize = state.global_mutable_owners.count
                    state.global_mutable_owners.push(annotation.owner)
                    state.global_mutable_offsets.push(annotation.offset)
                    state.global_mutable_lines.push(annotation.line)
                    state.global_mutable_modules.push(annotation.module)
                    state.global_mutable_next.push(previous)
                    state.global_mutable_heads <- state.global_mutable_heads.put(hash, index) can Global{Read,Write}

        def ga_index_import_annotations(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in state.annotations |state|:
                    continue if annotation.owner != "__from_member" and annotation.name != "__binding_wildcard_import"
                    state.import_annotations.push(annotation)

        def ga_collect(declarations: darray[Ast::Decl], module_scope: usize, state: mutable GlobalAuthority&, depth: u32, origin: Ast::Pos) -> void:
            can Memory.Allocate, Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    ga_mark_walk_overflow(origin, state)
                    return
                for declaration in declarations:
                    match declaration:
                        Decl.Const(name, type_expression, _, is_global, at):
                            if is_global:
                                state.global_types.push(type_expression)
                                state.global_next.push(head if state.global_heads.get(name_hash(name)) is head else GLOBAL_AUTHORITY_NONE)
                                state.global_heads <- state.global_heads.put(name_hash(name), state.globals.count) can Global{Read,Write}
                                state.globals.push(name)
                                state.global_scopes.push(module_scope)
                                writable: mutable bool = false
                                candidate: mutable usize = head if state.global_mutable_heads.get(name_hash(name)) is head else GLOBAL_AUTHORITY_NONE
                                while candidate < state.global_mutable_owners.count |candidate, writable, state|:
                                    writable <- true if state.global_mutable_owners[candidate] == name and state.global_mutable_offsets[candidate] == at.offset and state.global_mutable_lines[candidate] == at.line and ga_module_text(state.global_mutable_modules[candidate], state) == module_scope
                                    candidate <- state.global_mutable_next[candidate]
                                state.writable.push(writable)
                        Decl.Func(name, parameters, return_type, _, effects, decorators, at):
                            minimum: mutable usize = 0
                            for parameter in parameters |minimum|:
                                minimum <- minimum + 1 if not parameter.has_default
                            state.parameter_starts.push(state.parameter_functions.count)
                            state.parameter_counts.push(parameters.count)
                            state.parameter_minimum.push(minimum)
                            state.function_offsets.push(at.offset)
                            state.function_lines.push(at.line)
                            state.function_variadic.push(any decorator in decorators where decorator.name == "c_variadic")
                            state.function_return_types.push(return_type)
                            for parameter in parameters:
                                state.parameter_functions.push(state.functions.count)
                                state.parameter_names.push(parameter.name)
                                state.parameter_types.push(parameter.type_expression)
                                state.parameter_defaults.push(parameter.default_value if parameter.has_default else null)
                            previous: usize = head if state.function_heads.get(name_hash(name)) is head else GLOBAL_AUTHORITY_NONE
                            state.function_next.push(previous)
                            state.function_heads <- state.function_heads.put(name_hash(name), state.functions.count) can Global{Read,Write}
                            state.functions.push(name)
                            state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                            for effect in effects |state|:
                                _ = ga_row_add(state.functions.count - 1, effect, true, state, module_scope) can Global{Read,Write}
                            state.function_scopes.push(module_scope)
                            state.reads.push(false)
                            state.writes.push(false)
                        Decl.Enum(name: name, variants: variants, _):
                            state.enum_next.push(head if state.enum_heads.get(name_hash(name)) is head else GLOBAL_AUTHORITY_NONE)
                            state.enum_heads <- state.enum_heads.put(name_hash(name), state.enum_names.count) can Global{Read,Write}
                            state.enum_names.push(name)
                            state.enum_scopes.push(module_scope)
                            for variant in variants |state|:
                                state.enum_variant_owners.push(name)
                                state.enum_variant_scopes.push(module_scope)
                                state.enum_variant_names.push(variant.name)
                                state.enum_variant_payload_starts.push(state.enum_variant_payload_types.count)
                                state.enum_variant_payload_counts.push(variant.fields.count)
                                for field_index in 0..<variant.fields.count:
                                    state.enum_variant_payload_types.push(variant.fields[field_index])
                                    state.enum_variant_payload_names.push(variant.field_names[field_index] if field_index < variant.field_names.count else sview("", 0, 0))
                        Decl.Struct(name: name, members: members, _):
                            state.struct_next.push(head if state.struct_heads.get(name_hash(name)) is head else GLOBAL_AUTHORITY_NONE)
                            state.struct_heads <- state.struct_heads.put(name_hash(name), state.struct_names.count) can Global{Read,Write}
                            state.struct_names.push(name)
                            state.struct_scopes.push(module_scope)
                            for member in members:
                                state.field_owners.push(name)
                                state.field_scopes.push(module_scope)
                                state.field_names.push(member.name)
                                state.field_types.push(member.type_expression)
                        Decl.Alias(name, target, _):
                            state.alias_next.push(head if state.alias_heads.get(name_hash(name)) is head else GLOBAL_AUTHORITY_NONE)
                            state.alias_heads <- state.alias_heads.put(name_hash(name), state.alias_names.count) can Global{Read,Write}
                            state.alias_names.push(name)
                            state.alias_scopes.push(module_scope)
                            state.alias_types.push(target)
                        Decl.Module(name, body, at):
                            child: usize = ga_collect_module(module_scope, name, state) can Global{Read,Write}
                            ga_collect(body, child, state, depth + 1, at) can Global{Read,Write}
                        Decl.Scoped(body, at):
                            ga_collect(body, module_scope, state, depth + 1, at) can Global{Read,Write}
                        _:
                            pass

        def ga_module(expression: Ast::Expr, state: mutable GlobalAuthority&, lexical_scope: usize = GLOBAL_AUTHORITY_NONE, depth: u32 = 0) -> usize:
            can Memory.Allocate, Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    ga_mark_walk_overflow(Ast::expr_pos(expression), state)
                    return state.modules.count
                match expression:
                    Expr.Ident(name, _):
                        return ga_module_alias_resolve(name, state.module_scope if lexical_scope == GLOBAL_AUTHORITY_NONE else lexical_scope, state, depth + 1, true)
                    Expr.Scope(base, name, _):
                        parent: usize = ga_module(base, state, lexical_scope, depth + 1)
                        return ga_child(state, parent, name) if parent < state.modules.count else state.modules.count
                    _:
                        return state.modules.count
                return state.modules.count

        # Read-only module lookup for type and origin queries. On excessive nesting it
        # returns the unresolved sentinel; callers already treat that as unknown metadata.
        def ga_module_readonly(expression: Ast::Expr, state: GlobalAuthority&, lexical_scope: usize = GLOBAL_AUTHORITY_NONE, depth: u32 = 0) -> usize:
            can Memory.Allocate, Abort.Panic:
                return state.modules.count if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                match expression:
                    Expr.Ident(name, _):
                        # A scope lookup that found nothing hands back `modules.count`; the
                        # alias helper checks its lexical scope before walking the module table.
                        resolved_scope: usize = state.module_scope if lexical_scope == GLOBAL_AUTHORITY_NONE or lexical_scope >= state.parents.count else lexical_scope
                        return ga_module_alias_resolve(name, resolved_scope, state, depth + 1, true)
                    Expr.Scope(base, name, _):
                        parent: usize = ga_module_readonly(base, state, lexical_scope, depth + 1)
                        return ga_child(state, parent, name) if parent < state.modules.count
                        return state.modules.count
                    _:
                        return state.modules.count

        # ga_resolve over a table that keeps a name-hash chain (`heads`/`next`, newest first):
        # walks only same-hash rows and returns the LOWEST matching row per scope, exactly what
        # ga_resolve's ascending scan returns. A chain out of step with its table falls back.
        def ga_resolve_indexed(name: sview, module_scope: usize, qualified: bool, names: darray[sview]&, scopes: darray[usize]&, heads: dict[u64, usize]&, chain_next: darray[usize]&, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return ga_resolve_hashed(name, name_hash(name), module_scope, qualified, names, scopes, heads, chain_next, state)

        # ga_resolve_indexed with the caller's name_hash, for callers probing several tables.
        def ga_resolve_hashed(name: sview, hash: u64, module_scope: usize, qualified: bool, names: darray[sview]&, scopes: darray[usize]&, heads: dict[u64, usize]&, chain_next: darray[usize]&, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return ga_resolve(name, module_scope, qualified, names, scopes, state) if chain_next.count != names.count or scopes.count != names.count
                first: usize = head if heads.get(hash) is head else GLOBAL_AUTHORITY_NONE
                # No same-name row: neither the scope walk nor an import can find one.
                return names.count if first == GLOBAL_AUTHORITY_NONE and state.import_target_scopes.count == state.import_annotations.count and state.import_module_scopes.count == state.import_annotations.count
                current: mutable usize = module_scope
                while true |current|:
                    best: mutable usize = names.count
                    row: mutable usize = first
                    while row < names.count |row, best, current, name, names, scopes, chain_next|:
                        best <- row if scopes[row] == current and names[row] == name and row < best
                        row <- chain_next[row]
                    return best if best < names.count
                    return names.count if qualified or current >= state.modules.count
                    break if current == 0
                    current <- state.parents[current]
                # ga_resolve's import step, with the same-name rows taken from the chain: the
                # old fallback re-ran the whole linear scan first on every miss (the common case).
                return ga_resolve(name, module_scope, qualified, names, scopes, state) if state.import_target_scopes.count != state.import_annotations.count or state.import_module_scopes.count != state.import_annotations.count
                for import_index in 0..<state.import_annotations.count |import_index|:
                    import_row: Ast::EnumAnnotation = state.import_annotations[import_index]
                    is_member: bool = import_row.owner == "__from_member" and import_row.name == name
                    continue if not is_member and import_row.name != "__binding_wildcard_import"
                    continue if not ga_import_scope_visible(import_row.module, state.import_module_scopes[import_index], state, module_scope)
                    target_scope: usize = state.import_target_scopes[import_index]
                    continue if target_scope >= state.modules.count
                    imported: usize = ga_resolve_chain_lowest(name, target_scope, first, names, scopes, chain_next)
                    return imported if imported < names.count
                return names.count

        def ga_member_key(owner: sview, scope: usize) -> u64:
            return name_hash(owner) ^ (scope.u64() * 0x9E3779B97F4A7C15)

        # Chain field and variant rows by exact (owner, scope), ascending, so the
        # per-owner scans below visit only that owner's rows, in the old order.
        def ga_prepare_member_index(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                state.struct_field_first.clear()
                state.field_row_next.clear()
                state.enum_variant_first.clear()
                state.variant_row_next.clear()
                return if state.field_scopes.count != state.field_owners.count or state.enum_variant_scopes.count != state.enum_variant_owners.count
                field_heads: mutable dict[u64, usize] = {}
                field_chain: mutable darray[usize] = [GLOBAL_AUTHORITY_NONE for _ in 0..<state.field_owners.count]
                state.field_row_next <- [state.field_owners.count for _ in 0..<state.field_owners.count]
                row: mutable usize = state.field_owners.count
                while row > 0 |row, field_heads, field_chain, state|:
                    row <- row - 1
                    key: u64 = ga_member_key(state.field_owners[row], state.field_scopes[row])
                    head: usize = found if field_heads.get(key) is found else GLOBAL_AUTHORITY_NONE
                    probe: mutable usize = head
                    while probe != GLOBAL_AUTHORITY_NONE |probe|:
                        break if state.field_scopes[probe] == state.field_scopes[row] and state.field_owners[probe] == state.field_owners[row]
                        probe <- field_chain[probe]
                    state.field_row_next[row] <- probe if probe != GLOBAL_AUTHORITY_NONE else state.field_owners.count
                    field_chain[row] <- head
                    field_heads <- field_heads.put(key, row)
                for owner in 0..<state.struct_names.count |state|:
                    probe: mutable usize = found if field_heads.get(ga_member_key(state.struct_names[owner], state.struct_scopes[owner])) is found else GLOBAL_AUTHORITY_NONE
                    while probe != GLOBAL_AUTHORITY_NONE |probe|:
                        break if state.field_scopes[probe] == state.struct_scopes[owner] and state.field_owners[probe] == state.struct_names[owner]
                        probe <- field_chain[probe]
                    state.struct_field_first.push(probe if probe != GLOBAL_AUTHORITY_NONE else state.field_owners.count)
                variant_heads: mutable dict[u64, usize] = {}
                variant_chain: mutable darray[usize] = [GLOBAL_AUTHORITY_NONE for _ in 0..<state.enum_variant_owners.count]
                state.variant_row_next <- [state.enum_variant_owners.count for _ in 0..<state.enum_variant_owners.count]
                row <- state.enum_variant_owners.count
                while row > 0 |row, variant_heads, variant_chain, state|:
                    row <- row - 1
                    key: u64 = ga_member_key(state.enum_variant_owners[row], state.enum_variant_scopes[row])
                    head: usize = found if variant_heads.get(key) is found else GLOBAL_AUTHORITY_NONE
                    probe: mutable usize = head
                    while probe != GLOBAL_AUTHORITY_NONE |probe|:
                        break if state.enum_variant_scopes[probe] == state.enum_variant_scopes[row] and state.enum_variant_owners[probe] == state.enum_variant_owners[row]
                        probe <- variant_chain[probe]
                    state.variant_row_next[row] <- probe if probe != GLOBAL_AUTHORITY_NONE else state.enum_variant_owners.count
                    variant_chain[row] <- head
                    variant_heads <- variant_heads.put(key, row)
                for owner in 0..<state.enum_names.count |state|:
                    probe: mutable usize = found if variant_heads.get(ga_member_key(state.enum_names[owner], state.enum_scopes[owner])) is found else GLOBAL_AUTHORITY_NONE
                    while probe != GLOBAL_AUTHORITY_NONE |probe|:
                        break if state.enum_variant_scopes[probe] == state.enum_scopes[owner] and state.enum_variant_owners[probe] == state.enum_names[owner]
                        probe <- variant_chain[probe]
                    state.enum_variant_first.push(probe if probe != GLOBAL_AUTHORITY_NONE else state.enum_variant_owners.count)

        # First field row of struct `owner` (row 0 when the index is stale: callers
        # still check owner and scope on every row they visit).
        def ga_field_first(owner: usize, state: GlobalAuthority&) -> usize:
            return state.struct_field_first[owner] if ga_field_index_ready(state) and owner < state.struct_field_first.count else 0

        def ga_field_after(row: usize, state: GlobalAuthority&) -> usize:
            return state.field_row_next[row] if ga_field_index_ready(state) and row < state.field_row_next.count else row + 1

        def ga_field_index_ready(state: GlobalAuthority&) -> bool:
            return state.struct_field_first.count == state.struct_names.count and state.field_row_next.count == state.field_owners.count and state.field_row_next.count > 0

        def ga_variant_first(owner: usize, state: GlobalAuthority&) -> usize:
            return state.enum_variant_first[owner] if ga_variant_index_ready(state) and owner < state.enum_variant_first.count else 0

        def ga_variant_after(row: usize, state: GlobalAuthority&) -> usize:
            return state.variant_row_next[row] if ga_variant_index_ready(state) and row < state.variant_row_next.count else row + 1

        def ga_variant_index_ready(state: GlobalAuthority&) -> bool:
            return state.enum_variant_first.count == state.enum_names.count and state.variant_row_next.count == state.enum_variant_owners.count and state.variant_row_next.count > 0


        # ga_import_visible with the module's scope already resolved.
        def ga_import_scope_visible(module: sview, module_text_scope: usize, state: GlobalAuthority&, lexical_scope: usize) -> bool:
            can Abort.Panic:
                return true if module == ""
                walk_scope: mutable usize = state.module_scope if lexical_scope == GLOBAL_AUTHORITY_NONE else lexical_scope
                while walk_scope != 0 and walk_scope < state.parents.count |walk_scope|:
                    return true if walk_scope == module_text_scope
                    walk_scope <- state.parents[walk_scope]
                return false

        # Resolve every import row's scopes once, after the module table is complete.
        def ga_prepare_import_scopes(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                state.import_module_scopes.clear()
                state.import_target_scopes.clear()
                for import_row in state.import_annotations |state|:
                    state.import_module_scopes.push(ga_module_text(import_row.module, state))
                    resolved_target: mutable usize = state.modules.count
                    if import_row.owner == "__from_member":
                        for source in state.annotations |resolved_target|:
                            if resolved_target == state.modules.count and source.owner == "__from_src" and source.offset == import_row.offset and source.line == import_row.line and source.module == import_row.module:
                                resolved_target <- ga_module_alias_resolve(source.name, ga_module_text(import_row.module, state), state)
                    elif import_row.name == "__binding_wildcard_import":
                        resolved_target <- ga_module_alias_resolve(import_row.owner, ga_module_text(import_row.module, state), state)
                    state.import_target_scopes.push(resolved_target)
                # Insertion-sorted by offset: labels are few and arrive nearly in order.
                state.tuple_label_offsets.clear()
                state.tuple_label_names.clear()
                for annotation in state.annotations |state|:
                    continue if annotation.owner != "__tuple_label"
                    state.tuple_label_offsets.push(annotation.offset)
                    state.tuple_label_names.push(annotation.name)
                    slot: mutable usize = state.tuple_label_offsets.count - 1
                    while slot > 0 and state.tuple_label_offsets[slot - 1] > state.tuple_label_offsets[slot] |slot, state|:
                        swap_offset: u32 = state.tuple_label_offsets[slot - 1]
                        swap_name: sview = state.tuple_label_names[slot - 1]
                        state.tuple_label_offsets[slot - 1] <- state.tuple_label_offsets[slot]
                        state.tuple_label_names[slot - 1] <- state.tuple_label_names[slot]
                        state.tuple_label_offsets[slot] <- swap_offset
                        state.tuple_label_names[slot] <- swap_name
                        slot <- slot - 1
                state.tuple_labels_ready <- true

        # The lowest row on a name chain with this exact name and scope, else names.count.
        def ga_resolve_chain_lowest(name: sview, scope: usize, first: usize, names: darray[sview]&, scopes: darray[usize]&, chain_next: darray[usize]&) -> usize:
            can Abort.Panic:
                best: mutable usize = names.count
                row: mutable usize = first
                while row < names.count and row < chain_next.count |row, best, name, scope, names, scopes, chain_next|:
                    best <- row if scopes[row] == scope and names[row] == name and row < best
                    row <- chain_next[row]
                return best

        def ga_resolve_global(name: sview, module_scope: usize, qualified: bool, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return ga_resolve_indexed(name, module_scope, qualified, state.globals, state.global_scopes, state.global_heads, state.global_next, state)

        def ga_resolve(name: sview, module_scope: usize, qualified: bool, names: darray[sview]&, scopes: darray[usize]&, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                current: mutable usize = module_scope
                while true |current|:
                    while index < names.count |index: usize = 0|:
                        return index if scopes[index] == current and names[index] == name
                        index <- index + 1
                    return names.count if qualified or current >= state.modules.count
                    break if current == 0
                    current <- state.parents[current]
                # Import metadata is paired by lexical owner and token identity; a
                # selective import cannot grant every member of its source module.
                for import_row in state.import_annotations:
                    continue if not ga_import_visible(import_row.module, state, module_scope)
                    if import_row.owner == "__from_member" and import_row.name == name:
                        for source in state.annotations:
                            if source.owner == "__from_src" and source.offset == import_row.offset and source.line == import_row.line and source.module == import_row.module:
                                imported_scope: usize = ga_module_alias_resolve(source.name, ga_module_text(import_row.module, state), state)
                                for index in 0..<names.count:
                                    return index if names[index] == name and scopes[index] == imported_scope
                    if import_row.name == "__binding_wildcard_import":
                        imported_scope: usize = ga_module_alias_resolve(import_row.owner, ga_module_text(import_row.module, state), state)
                        for index in 0..<names.count:
                            return index if names[index] == name and scopes[index] == imported_scope
                return names.count

        # Store clauses carry source text rather than an Expr. Resolve their qualified
        # path using the same lexical module/import identities as expression accesses.
        def ga_store_slot(path: sview, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                separator: mutable usize = 0
                while separator < path.len and path[separator] != 58 |separator|:
                    separator <- separator + 1
                if separator == path.len:
                    for index in state.local_floor..<min(state.local_limit, state.locals.count):
                        return state.globals.count if state.locals[index] == path
                    return ga_resolve_global(path, state.module_scope, false, state)
                module_slot: mutable usize = ga_module_alias_resolve(path[0:separator], state.module_scope, state, 0, true)
                start: mutable usize = separator + 2
                while start < path.len and module_slot < state.modules.count |start, module_slot|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    part: sview = effect_ref_trim_layout(path[start:end])
                    if end == path.len:
                        return ga_resolve_global(part, module_slot, true, state)
                    module_slot <- ga_child(state, module_slot, part)
                    start <- end + 2
                return state.globals.count

        def ga_function_head(name: sview, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return head if state.function_heads.get(name_hash(name)) is head else GLOBAL_AUTHORITY_NONE

        def ga_candidate_head(slot: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return GLOBAL_AUTHORITY_NONE if slot >= state.functions.count
                return slot if state.functions[slot] == "" else ga_function_head(state.functions[slot], state)

        def ga_resolve_function(name: sview, module_scope: usize, qualified: bool, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                current: mutable usize = module_scope
                while true |current|:
                    while row < state.functions.count |row: usize = ga_function_head(name, state)|:
                        selected: usize = row
                        row <- state.function_next[row]
                        return selected if state.functions[selected] == name and state.function_scopes[selected] == current
                    return state.functions.count if qualified or current >= state.modules.count
                    break if current == 0
                    current <- state.parents[current]
                for import_row in state.import_annotations:
                    continue if not ga_import_visible(import_row.module, state, module_scope)
                    if import_row.owner == "__from_member" and import_row.name == name:
                        for source in state.annotations:
                            if source.owner == "__from_src" and source.offset == import_row.offset and source.line == import_row.line and source.module == import_row.module:
                                imported_scope: usize = ga_module_alias_resolve(source.name, ga_module_text(import_row.module, state), state)
                                while row < state.functions.count |row: usize = ga_function_head(name, state)|:
                                    selected: usize = row
                                    row <- state.function_next[row]
                                    return selected if state.functions[selected] == name and state.function_scopes[selected] == imported_scope
                    if import_row.name == "__binding_wildcard_import":
                        imported_scope: usize = ga_module_alias_resolve(import_row.owner, ga_module_text(import_row.module, state), state)
                        while row < state.functions.count |row: usize = ga_function_head(name, state)|:
                            selected: usize = row
                            row <- state.function_next[row]
                            return selected if state.functions[selected] == name and state.function_scopes[selected] == imported_scope
                return state.functions.count

        def ga_global(expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        end: usize = min(state.local_limit, state.locals.count)
                        for index in state.local_floor..<end:
                            return state.globals.count if state.locals[index] == name
                        return ga_resolve_global(name, state.module_scope, false, state)
                    Expr.Scope(base, name, _):
                        module_scope: usize = ga_module_readonly(base, state)
                        return ga_resolve_global(name, module_scope, true, state)
                    _:
                        return state.globals.count

        # `x.cast[T]` reinterprets x: its storage root and reference origin are x's, as
        # stage0 roots a cast at its operand. Read as a projection, `cast` is no field of
        # x's referent and every cast of a reference took an unknown alias origin.
        def ga_cast_operand(expression: Ast::Expr) -> Ast::Expr?:
            match expression:
                Expr.Index(cast_callee, _, _):
                    if cast_callee is Expr.Field(cast_operand, cast_member, _) and cast_member == "cast":
                        return cast_operand
                    return null
                _:
                    return null

        def ga_place_global(expression: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                while true |current|:
                    if ga_cast_operand(current) is place_cast_operand:
                        current <- place_cast_operand
                    else:
                        break
                while true |current, state|:
                    match current:
                        Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _) | Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                            current <- base
                        _:
                            return ga_global(current, state)
                return ga_global(current, state)

        # Types reached through a global place or a local reference into one are named in
        # the global's declaration module, even when the current function shadows them.
        def ga_global_expression_scope(expression: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                global_slot: usize = ga_place_global(expression, state)
                return state.global_scopes[global_slot] if global_slot < state.global_scopes.count
                reference_origin: usize = ga_reference_path_origin(expression, state, 0)
                return state.global_scopes[reference_origin] if reference_origin < state.global_scopes.count
                return state.module_scope

        # A projected field type belongs to the module that declared that field,
        # which can differ from the global's module and the current function.
        def ga_expression_type_scope(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                match expression:
                    Expr.Ident(name, _):
                        local_index: usize = ga_local_slot(name, state)
                        if local_index < state.locals.count:
                            return state.local_type_scopes[local_index] if local_index < state.local_type_scopes.count
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        global_slot: usize = ga_global(expression, state)
                        return state.global_scopes[global_slot] if global_slot < state.globals.count
                        return state.module_scope
                    Expr.Field(base, field, _):
                        base_type: Ast::Expr = get ga_annotation(base, state, depth + 1) else return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        base_scope: usize = ga_expression_type_scope(base, state, depth + 1)
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if base_scope == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        resolved_base_type: Ast::Expr = ga_type_alias_result(base_type, base_scope, state, depth + 1)
                        return base_scope if ga_tuple_field_type(resolved_base_type, field, state) is tuple_field_type
                        owner: usize = ga_known_struct(base_type, base_scope, state, depth + 1)
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if owner >= state.struct_names.count
                        index_cursor: mutable usize = ga_field_first(owner, state)
                        while index_cursor < state.field_owners.count |index_cursor|:
                            index: usize = index_cursor
                            index_cursor <- ga_field_after(index, state)
                            return state.field_scopes[index] if state.field_owners[index] == state.struct_names[owner] and state.field_scopes[index] == state.struct_scopes[owner] and state.field_names[index] == field
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _):
                        return ga_expression_type_scope(base, state, depth + 1)
                    Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                        return ga_expression_type_scope(base, state, depth + 1)
                    Expr.Call(callee, arguments, labels, _):
                        return ga_call_return_type_scope(callee, arguments, labels, state, depth + 1)
                    Expr.Construct(type_expression, _, _):
                        return ga_type_scope(type_expression, state)
                    _:
                        global_slot: usize = ga_global(expression, state)
                        return state.global_scopes[global_slot] if global_slot < state.global_scopes.count
                        return state.module_scope

        def ga_call_return_type_scope(callee: Ast::Expr, arguments: darray[Ast::Expr], labels: darray[sview], state: GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                if arguments.count == 0 and labels.count == 0 and ga_target_conversion(callee, state):
                    match callee:
                        Expr.Field(_, target, at):
                            target_type: Ast::Expr = Ast::Expr.Ident(target, at)
                            return state.module_scope if ga_builtin_unshadowed(target_type, state.module_scope, state)
                        _:
                            pass
                    return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                slot: mutable usize = ga_named_callee_slot(callee, state)
                method: mutable bool = false
                actuals: mutable darray[Ast::Expr] = arguments
                actual_labels: mutable darray[sview] = labels
                match ga_callable_core(callee):
                    Expr.Field(receiver, method_name, _):
                        method <- true
                        if ga_annotation(receiver, state, depth + 1) is receiver_type:
                            slot <- ga_resolve_function(method_name, ga_receiver_scope(receiver_type, state), false, state)
                        actuals <- [receiver]
                        actual_labels <- [""]
                        actuals.extend(arguments)
                        actual_labels.extend(labels)
                        slot <- ga_select_function(slot, actuals, actual_labels, state, true)
                    _:
                        slot <- ga_select_function(slot, actuals, actual_labels, state)
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if slot >= state.functions.count
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if ga_unique_call_return(slot, actuals, actual_labels, state, method) is absent
                return state.function_scopes[slot] if slot < state.function_scopes.count
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS

        # A by-value aggregate global can still expose mutable storage through a
        # declared mutable field. Follow the source-level place so accesses to that
        # storage receive the same mandatory grants as a mutable global.
        def ga_mutable_reference_expression(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                if ga_annotation(expression, state, depth + 1) is type_expression:
                    origin: usize = ga_expression_type_scope(expression, state, depth + 1)
                    return true if origin == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    return ga_reference_type(type_expression, state, depth + 1, origin) and ga_mutable_parameter(type_expression, state, depth + 1, origin)
                return false

        # A projection through a local reference no longer has a global identifier
        # at its leaf. Preserve the reference root while examining its place path.
        def ga_reference_path_origin(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                if ga_cast_operand(expression) is cast_operand:
                    return ga_reference_path_origin(cast_operand, state, depth + 1)
                match expression:
                    Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _):
                        if ga_expression_is_reference(base, state, depth + 1):
                            origin: usize = ga_reference_origin(base, state, depth + 1)
                            return origin if origin < state.globals.count
                        return ga_reference_path_origin(base, state, depth + 1)
                    Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                        return ga_reference_path_origin(base, state, depth + 1)
                    _:
                        return ga_reference_origin(expression, state, depth + 1)

        def ga_global_path_mutable(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                match expression:
                    Expr.Field(base, field, _):
                        if ga_annotation(base, state, depth + 1) is base_type:
                            owner_scope: usize = ga_expression_type_scope(base, state, depth + 1)
                            return true if owner_scope == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                            owner: usize = ga_known_struct(base_type, owner_scope, state, depth + 1)
                            if owner < state.struct_names.count:
                                found_field: mutable bool = false
                                index_cursor: mutable usize = ga_field_first(owner, state)
                                while index_cursor < state.field_owners.count |index_cursor, found_field|:
                                    index: usize = index_cursor
                                    index_cursor <- ga_field_after(index, state)
                                    continue if state.field_owners[index] != state.struct_names[owner] or state.field_scopes[index] != state.struct_scopes[owner] or state.field_names[index] != field
                                    found_field <- true
                                    field_type: Ast::Expr = ga_type_alias_result(state.field_types[index], state.field_scopes[index], state, depth + 1)
                                    return true if type_is_mutable(field_type)
                                return true if not found_field
                                return false
                            return true
                        else:
                            return true
                        return true if ga_mutable_reference_expression(expression, state, depth + 1)
                        return ga_global_path_mutable(base, state, depth + 1)
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _) | Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                        return true if ga_mutable_reference_expression(expression, state, depth + 1)
                        return ga_global_path_mutable(base, state, depth + 1)
                    _:
                        return ga_mutable_reference_expression(expression, state, depth + 1)

        # Fetching a reference while forming a place is a read even for plain
        # assignment. A by-value mutable-field store, by contrast, needs only Write.
        def ga_global_path_reads_reference(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32, origin: usize = GLOBAL_AUTHORITY_NONE) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                lexical_scope: usize = ga_global_expression_scope(expression, state) if origin == GLOBAL_AUTHORITY_NONE else origin
                match expression:
                    Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _):
                        return true if ga_expression_is_reference(base, state, depth + 1)
                        return ga_global_path_reads_reference(base, state, depth + 1, lexical_scope)
                    Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                        return ga_global_path_reads_reference(base, state, depth + 1, lexical_scope)
                    _:
                        return false

        def ga_index_inline_grants(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                # The sort buffers are temporary, while the indexed arrays belong to the
                # caller's authority state. Keep buffers in an explicit region and copy
                # their scalar elements back in place so no scratch container escapes.
                region scratch:
                    order: mutable darray[usize] = []
                    scratch_order: mutable darray[usize] = []
                    visited: mutable darray[bool] = []
                    # Reserve all buffers before filling any of them, so later growth
                    # cannot strand old capacities in the chained region.
                    order.reserve(state.inline_spans.count)
                    scratch_order.reserve(state.inline_spans.count)
                    visited.reserve(state.inline_spans.count)
                    for index in 0..<state.inline_spans.count |order, scratch_order, visited|:
                        order.push(index)
                        scratch_order.push(index)
                        visited.push(false)
                    width: mutable usize = 1
                    while width < order.count |width, order, scratch_order, state|:
                        start: mutable usize = 0
                        while start < order.count |start, width, order, scratch_order, state|:
                            middle: usize = start + width if start + width < order.count else order.count
                            stop: usize = start + 2 * width if start + 2 * width < order.count else order.count
                            left: mutable usize = start
                            right: mutable usize = middle
                            target: mutable usize = start
                            while target < stop |target, left, right, middle, stop, order, scratch_order, state|:
                                take_right: bool = right < stop and (left >= middle or state.inline_spans[order[right]].offset < state.inline_spans[order[left]].offset)
                                if take_right:
                                    scratch_order[target] <- order[right]
                                    right <- right + 1
                                else:
                                    scratch_order[target] <- order[left]
                                    left <- left + 1
                                target <- target + 1
                            start <- stop
                        for index in 0..<order.count |order, scratch_order|:
                            order[index] <- scratch_order[index]
                        width <- width * 2
                    # Apply the sorted permutation in place. Keeping only usize/Bool
                    # scratch arrays avoids putting borrowed grant views in this region;
                    # each value copied below comes directly from the caller-owned rows.
                    for start in 0..<order.count |visited, order, state|:
                        continue if visited[start]
                        current: mutable usize = start
                        saved_ref: sview = state.inline_refs[start]
                        saved_span: Ast::Pos = state.inline_spans[start]
                        saved_scope: usize = state.inline_scopes[start]
                        while true |current, visited, order, state, saved_ref, saved_span, saved_scope|:
                            visited[current] <- true
                            source: usize = order[current]
                            if source == start:
                                state.inline_refs[current] <- saved_ref
                                state.inline_spans[current] <- saved_span
                                state.inline_scopes[current] <- saved_scope
                                break
                            state.inline_refs[current] <- state.inline_refs[source]
                            state.inline_spans[current] <- state.inline_spans[source]
                            state.inline_scopes[current] <- state.inline_scopes[source]
                            current <- source
                longest: mutable u32 = 0
                for span in state.inline_spans |longest, state|:
                    longest <- max(longest, span.end_offset)
                    state.inline_prefix_ends.push(longest)

        def ga_inline_limit(offset: u32, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                lower: mutable usize = 0
                upper: mutable usize = state.inline_spans.count
                while lower < upper |lower, upper|:
                    middle: usize = lower + (upper - lower) / 2
                    if state.inline_spans[middle].offset <= offset:
                        lower <- middle + 1
                    else:
                        upper <- middle
                return lower

        def ga_granted(required: sview, at: Ast::Pos, state: GlobalAuthority&, required_scope: usize = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if ga_refs_cover(state.grants, state.grant_scopes, required, required_scope, state)
                while next_index > 0 |next_index: usize = ga_inline_limit(at.offset, state)|:
                    index: usize = next_index - 1
                    next_index <- index
                    break if state.inline_prefix_ends[index] <= at.offset
                    span: Ast::Pos = state.inline_spans[index]
                    return true if at.offset < span.end_offset and ga_ref_covers(state.inline_refs[index], required, state.inline_scopes[index], required_scope, state, 0)
                return false

        # Positions contain exactly six scalar fields. Rebuild them by value so an
        # expression's reference provenance cannot attach to diagnostic source spans.
        def ga_position_value(line: u32, column: u32, offset: u32, end_line: u32, end_column: u32, end_offset: u32) -> Ast::Pos:
            return Ast::Pos{line: line, column: column, offset: offset, end_line: end_line, end_column: end_column, end_offset: end_offset}

        def ga_mark_walk_overflow(at: Ast::Pos, state: mutable GlobalAuthority&) -> void:
            can Abort.Panic:
                if not state.walk_overflow:
                    state.walk_overflow_pos <- ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)
                    state.walk_overflow <- true
                    ga_mark_all_possible_global_effects(state)

        def ga_mark_all_possible_global_effects(state: mutable GlobalAuthority&) -> void:
            can Abort.Panic:
                for function in 0..<min(state.reads.count, state.writes.count) |function, state|:
                    state.reads[function] <- true
                    state.writes[function] <- true

        def ga_report_walk_overflow(state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if state.walk_overflow and not state.walk_depth_reported:
                    already_reported: bool = any diagnostic in table.diagnostics where diagnostic.kind == DiagnosticKind.ExpressionAnalysisDepthExceeded
                    if not already_reported:
                        at: Ast::Pos = state.walk_overflow_pos
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExpressionAnalysisDepthExceeded, name: "global authority", expected: "bounded expression depth", actual: "depth limit exceeded", line: at.line, pos: at})
                    state.walk_depth_reported <- true

        # Keep the recursive authority walk below the native stack limit. Truncating a
        # subtree is never treated as a pure result: inference propagates both possible
        # Global effects, and the reporting pass rejects the input with the same diagnostic
        # used by the other bounded semantic walkers.
        def ga_walk_enter(at: Ast::Pos, state: mutable GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                state.walk_depth <- state.walk_depth + 1
                return true if state.walk_depth <= GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                state.walk_depth <- state.walk_depth - 1
                ga_mark_walk_overflow(at, state)
                return false

        def ga_statement_position(statement: Ast::Stmt) -> Ast::Pos:
            can Abort.Panic:
                match statement:
                    Stmt.Expr(_, position):
                        return position
                    Stmt.Block(pos: position, _):
                        return position
                    Stmt.VarDecl(pos: position, _):
                        return position
                    Stmt.Assign(pos: position, _):
                        return position
                    Stmt.If(pos: position, _):
                        return position
                    Stmt.While(_, _, position):
                        return position
                    Stmt.For(pos: position, _):
                        return position
                    Stmt.Return(_, position):
                        return position
                    Stmt.Break(_, position) | Stmt.Continue(_, position):
                        return position
                    Stmt.Match(_, _, position):
                        return position
                    Stmt.Contract(_, _, position):
                        return position
                    _:
                        return ga_position_value(0, 0, 0, 0, 0, 0)

        def ga_access_slot(global_slot: usize, at: Ast::Pos, write: bool, mutable_path: bool, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if global_slot >= state.globals.count
                if not state.writable[global_slot] and not mutable_path:
                    if not state.report and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Read", 0, state):
                        _ = ga_row_add(state.function, "Global.Read", false, state, 0) can Global{Read,Write}
                    return
                required: sview = "Global.Write" if write else "Global.Read"
                if not ga_refs_cover(state.firewalls, state.firewall_scopes, required, 0, state):
                    if not state.report:
                        _ = ga_row_add(state.function, required, true, state) can Global{Read,Write}
                    if write:
                        state.writes[state.function] <- true
                    else:
                        state.reads[state.function] <- true
                if state.report and not ga_granted(required, at, state):
                    diagnostic_bytes: mutable darray[u8] = []
                    diagnostic_bytes.extend(state.globals[global_slot])
                    stable_global: sview = Parser::persist_name_bytes(&diagnostic_bytes, 0) can Global{Read,Write}
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalPermissionUngranted, name: "write" if write else "read", expected: required, actual: stable_global, line: at.line, pos: ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)})

        def ga_local_slot(name: sview, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                local_index: mutable usize = min(state.local_limit, state.locals.count)
                while local_index > state.local_floor |local_index, name, state|:
                    local_index <- local_index - 1
                    return local_index if state.locals[local_index] == name
                return GLOBAL_AUTHORITY_NONE

        # Origin values below globals.count are global slots. Local roots occupy the
        # remaining ordinary range and carry a monotonically assigned binding ID, so
        # truncating and reusing a lexical local slot cannot retarget an old origin.
        def ga_local_origin(local_index: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index >= state.locals.count or local_index >= state.local_origin_ids.count
                identity: usize = state.local_origin_ids[local_index]
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if:
                    identity >= GLOBAL_AUTHORITY_LOCAL_ALIAS or state.globals.count >= GLOBAL_AUTHORITY_LOCAL_ALIAS
                    identity >= GLOBAL_AUTHORITY_LOCAL_ALIAS - state.globals.count
                return state.globals.count + identity

        def ga_local_origin_index(origin: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.locals.count if origin < state.globals.count or origin >= GLOBAL_AUTHORITY_LOCAL_ALIAS
                identity: usize = origin - state.globals.count
                for local_index in 0..<min(state.locals.count, state.local_origin_ids.count):
                    return local_index if state.local_origin_ids[local_index] == identity
                return state.locals.count

        def ga_validate_local_origin(origin: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                if origin >= state.globals.count and origin < GLOBAL_AUTHORITY_LOCAL_ALIAS:
                    return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if ga_local_origin_index(origin, state) >= state.locals.count
                return origin

        def ga_push_local_origin_id(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                if state.globals.count < GLOBAL_AUTHORITY_LOCAL_ALIAS and state.next_local_origin_id < GLOBAL_AUTHORITY_LOCAL_ALIAS - state.globals.count:
                    state.local_origin_ids.push(state.next_local_origin_id)
                    state.next_local_origin_id <- state.next_local_origin_id + 1
                else:
                    state.local_origin_ids.push(GLOBAL_AUTHORITY_LOCAL_ALIAS)

        # A projection's type tells us whether this result can carry nested references.
        # Use a recovered local-root summary when present; unknown/missing evidence stays
        # fail-closed, while a known reference-free projection contributes no alias.
        def ga_projected_reference_origin(expression: Ast::Expr, summary: usize, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                if ga_annotation(expression, state, 0) is type_expression:
                    return GLOBAL_AUTHORITY_NONE if not ga_type_expression_contains_reference(type_expression, state, 0)
                    if summary != GLOBAL_AUTHORITY_NONE:
                        if summary >= state.globals.count and summary < GLOBAL_AUTHORITY_LOCAL_ALIAS:
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if ga_local_origin_index(summary, state) >= state.locals.count
                        return summary
                    return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS

        def ga_local_reference_origin(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                if ga_cast_operand(expression) is cast_operand:
                    return ga_local_reference_origin(cast_operand, state, depth + 1)
                match expression:
                    Expr.Ident(name, _):
                        # `null` parses as a keyword identifier and names no storage.
                        return GLOBAL_AUTHORITY_NONE if name == "null"
                        local_index: usize = ga_local_slot(name, state)
                        return ga_validate_local_origin(state.local_global_origins[local_index], state) if local_index < state.local_global_origins.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index < state.locals.count
                        # A global root is resolved by the place walk; any other name
                        # (`result` in a contract) names detached storage.
                        return GLOBAL_AUTHORITY_NONE if ga_global(expression, state) < state.globals.count
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS
                    Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _):
                        base_origin: usize = ga_local_reference_origin(base, state, depth + 1)
                        # A projection through a reference reads a nested value from the
                        # referenced local aggregate. A projection through a by-value
                        # aggregate instead selects one of its contained references, so
                        # preserve that content summary unchanged.
                        # Whatever is reached through detached storage is detached too.
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if base_origin == GLOBAL_AUTHORITY_LOCAL_ALIAS
                        if base_origin != GLOBAL_AUTHORITY_NONE and ga_expression_is_reference(base, state, 0):
                            root_index: usize = ga_local_origin_index(base_origin, state)
                            if base_origin >= state.globals.count and base_origin < GLOBAL_AUTHORITY_LOCAL_ALIAS:
                                if root_index >= state.locals.count:
                                    return ga_projected_reference_origin(expression, GLOBAL_AUTHORITY_NONE, state)
                            if root_index < state.locals.count:
                                # Whatever is reachable through a parameter is caller storage,
                                # covered by the caller's grant (stage0's parameter rule), even
                                # when the projection's type (a generic T) gives no evidence.
                                if root_index < state.parameter_limit and root_index < state.local_global_origins.count:
                                    return state.local_global_origins[root_index]
                                if root_index < state.local_global_origins.count:
                                    return ga_projected_reference_origin(expression, state.local_global_origins[root_index], state)
                            return ga_projected_reference_origin(expression, GLOBAL_AUTHORITY_NONE, state)
                        return base_origin if base_origin != GLOBAL_AUTHORITY_NONE
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_expression_is_reference(expression, state, 0)
                        return base_origin
                    Expr.Unary(operator, base, _) if operator == TokenKind.Ampersand:
                        return ga_local_address_origin(base, state)
                    Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                        base_origin: usize = ga_local_reference_origin(base, state, depth + 1)
                        return base_origin if base_origin != GLOBAL_AUTHORITY_NONE
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_expression_is_reference(expression, state, 0)
                        return base_origin
                    _:
                        return GLOBAL_AUTHORITY_NONE

        def ga_expression_is_reference(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > 32
                direct: RefSpelling = rbm_type_spelling(expression)
                return true if (direct.flags & RBM_REF) != 0
                lexical_scope: usize = ga_expression_type_scope(expression, state, depth + 1)
                if ga_annotation(expression, state, depth + 1) is annotation:
                    return true if lexical_scope == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    return ga_reference_type(annotation, state, depth + 1, lexical_scope)
                match expression:
                    Expr.Ident(name, _):
                        local_index: usize = ga_local_slot(name, state)
                        if local_index < state.locals.count:
                            # A declared by-value local is not a reference, whatever
                            # references its contents carry: those are reached through
                            # projections, each judged by its own type.
                            if local_index < state.local_types.count and state.local_types[local_index] is declared_local_type:
                                return ga_reference_type(declared_local_type, state, depth + 1, state.local_type_scopes[local_index] if local_index < state.local_type_scopes.count else GLOBAL_AUTHORITY_NONE)
                            return true if local_index >= state.local_global_origins.count
                            origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                            return true if SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(origin)
                    _:
                        pass
                return true if lexical_scope == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                return false

        def ga_reference_type(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32, origin: usize = GLOBAL_AUTHORITY_NONE) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > 32
                lexical_scope: usize = state.module_scope if origin == GLOBAL_AUTHORITY_NONE else origin
                resolved: Ast::Expr = ga_type_alias_result(type_expression, lexical_scope, state, depth + 1)
                return (rbm_type_spelling(resolved).flags & RBM_REF) != 0

        # Opaque expressions may carry references inside tuples, containers or nominal
        # values even when the expression itself is not a reference. Missing type evidence
        # is unknown, so aggregate joins cannot accidentally erase that provenance.
        def ga_expression_reference_origin(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                if ga_annotation(expression, state, depth + 1) is annotation:
                    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(true, ga_type_expression_contains_reference(annotation, state, depth + 1))
                return SemanticGlobalAuthorityOrigin::opaque_expression_origin(false, false)

        # Named struct construction omits optional and defaulted fields. An omitted
        # reference-bearing field may carry an alias not represented by the explicit
        # initializer expressions, so only a complete reference-field inventory may keep
        # the joined origin summary.
        def ga_construct_omits_reference_field(type_expression: Ast::Expr, fields: darray[Ast::FieldInit], state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                owner: usize = ga_known_struct(type_expression, state.module_scope, state, 0)
                return true if owner >= state.struct_names.count
                field_index_cursor: mutable usize = ga_field_first(owner, state)
                while field_index_cursor < state.field_owners.count |field_index_cursor|:
                    field_index: usize = field_index_cursor
                    field_index_cursor <- ga_field_after(field_index, state)
                    continue if state.field_owners[field_index] != state.struct_names[owner] or state.field_scopes[field_index] != state.struct_scopes[owner]
                    return true if state.field_scopes[field_index] != state.module_scope
                    continue if not ga_type_expression_contains_reference(state.field_types[field_index], state, 0)
                    found: mutable bool = false
                    for initializer in fields:
                        return true if initializer.name == "" and not initializer.is_copy_base
                        found <- true if initializer.name == state.field_names[field_index]
                    return true if not found
                return false

        # A variant constructor is the one call form whose result provenance is exactly
        # the join of its explicit payload arguments. Match its lexical enum owner and
        # declared variant before using that fact; arbitrary function returns stay opaque.
        def ga_enum_variant_slot(callee: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(owner_expression, variant_name, _) | Expr.Scope(owner_expression, variant_name, _):
                        match owner_expression:
                            Expr.Ident(owner_name, _) if ga_local_slot(owner_name, state) < state.locals.count:
                                return state.enum_variant_names.count
                            _:
                                pass
                        enum_slot: usize = ga_resolve_indexed(ga_type_head(owner_expression), ga_type_scope(owner_expression, state), ga_type_qualified(owner_expression), state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state)
                        return state.enum_variant_names.count if enum_slot >= state.enum_names.count
                        variant_slot_cursor: mutable usize = ga_variant_first(enum_slot, state)
                        while variant_slot_cursor < state.enum_variant_names.count |variant_slot_cursor|:
                            variant_slot: usize = variant_slot_cursor
                            variant_slot_cursor <- ga_variant_after(variant_slot, state)
                            return variant_slot if state.enum_variant_owners[variant_slot] == state.enum_names[enum_slot] and state.enum_variant_scopes[variant_slot] == state.enum_scopes[enum_slot] and state.enum_variant_names[variant_slot] == variant_name
                        return state.enum_variant_names.count
                    _:
                        return state.enum_variant_names.count

        def ga_value_contains_mutable_reference(value: Ast::Expr, type_expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                # The expression scope is not reliable for nullary enum values:
                # `Enum.Empty` is a scoped value, not a place with an annotation.
                # Resolve the declared/inferred type in its own lexical scope.
                type_scope: usize = ga_type_scope(type_expression, state)
                resolved_type: Ast::Expr = ga_type_alias_result(type_expression, type_scope, state, depth + 1)
                enum_owner: usize = ga_resolve_indexed(ga_type_head(resolved_type), type_scope, ga_type_qualified(resolved_type), state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state)
                variant_slot: mutable usize = state.enum_variant_names.count
                match value:
                    Expr.Call(callee: callee, _):
                        variant_slot <- ga_enum_variant_slot(callee, state)
                    Expr.Scope(_, _, _) | Expr.Field(_, _, _):
                        variant_slot <- ga_enum_variant_slot(value, state)
                    _:
                        pass
                if enum_owner < state.enum_names.count and variant_slot < state.enum_variant_names.count and state.enum_variant_owners[variant_slot] == state.enum_names[enum_owner] and state.enum_variant_scopes[variant_slot] == state.enum_scopes[enum_owner]:
                    return true if variant_slot >= state.enum_variant_payload_counts.count or variant_slot >= state.enum_variant_payload_starts.count
                    payload_start: usize = state.enum_variant_payload_starts[variant_slot]
                    payload_count: usize = state.enum_variant_payload_counts[variant_slot]
                    return true if payload_start > state.enum_variant_payload_types.count or payload_count > state.enum_variant_payload_types.count - payload_start
                    for payload_index in payload_start..<payload_start + payload_count:
                        return true if ga_type_expression_contains_mutable_reference(state.enum_variant_payload_types[payload_index], state, depth + 1, state.enum_variant_scopes[variant_slot])
                    return false
                return ga_type_expression_contains_mutable_reference(type_expression, state, depth + 1, type_scope)

        def ga_enum_constructor_origin(variant_slot: usize, arguments: darray[Ast::Expr], labels: darray[sview], state: mutable GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > 32 or variant_slot >= state.enum_variant_names.count
                return SemanticGlobalAuthorityOrigin::constructor_origin(GLOBAL_AUTHORITY_NONE, false) if variant_slot >= state.enum_variant_payload_counts.count or arguments.count != state.enum_variant_payload_counts[variant_slot]
                payload_start: usize = state.enum_variant_payload_starts[variant_slot]
                payload_count: usize = state.enum_variant_payload_counts[variant_slot]
                return SemanticGlobalAuthorityOrigin::constructor_origin(GLOBAL_AUTHORITY_NONE, false) if payload_start > state.enum_variant_payload_names.count or payload_count > state.enum_variant_payload_names.count - payload_start
                for argument_index in 0..<arguments.count:
                    label: sview = labels[argument_index] if argument_index < labels.count else sview("", 0, 0)
                    if label != "":
                        found: mutable bool = false
                        for payload_index in payload_start..<payload_start + payload_count:
                            found <- true if state.enum_variant_payload_names[payload_index] == label
                        return SemanticGlobalAuthorityOrigin::constructor_origin(GLOBAL_AUTHORITY_NONE, false) if not found
                origin: mutable usize = GLOBAL_AUTHORITY_NONE
                for argument in arguments |origin, state| -> origin:
                    argument_origin: usize = ga_reference_origin(argument, state, depth + 1)
                    origin <- ga_join_origins(state, origin, argument_origin)
                return SemanticGlobalAuthorityOrigin::constructor_origin(origin, true)

        # An operand that can only be an integer: literals, the layout builtins, integer
        # arithmetic over such operands, proven-scalar locals and non-reference types.
        def ga_integer_valued(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 32
                match expression:
                    Expr.IntLit(_, _):
                        return true
                    Expr.Paren(inner, _):
                        return ga_integer_valued(inner, state, depth + 1)
                    Expr.Call(callee: callee, _):
                        if callee is Expr.Ident(builtin_name, _):
                            if builtin_name == "size_of" or builtin_name == "align_of" or builtin_name == "offset_of":
                                return ga_named_callee_slot(callee, state) >= state.functions.count
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift or operator == TokenKind.Plus or operator == TokenKind.Minus:
                            return true if ga_integer_valued(left, state, depth + 1) and ga_integer_valued(right, state, depth + 1)
                    _:
                        pass
                if ga_annotation(expression, state, depth + 1) is annotation:
                    return not ga_type_expression_contains_reference(annotation, state, depth + 1) and ga_expression_type_scope(expression, state, depth + 1) != GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                return false

        # A call result aliases what its callee's summary says it may return. Every
        # selected overload contributes; an argument-derived summary joins the origins
        # of all actual arguments (the receiver included), which covers any parameter.
        def ga_call_result_origin(callee: Ast::Expr, arguments: darray[Ast::Expr], labels: darray[sview], state: mutable GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > 32
                slot: mutable usize = ga_named_callee_slot(callee, state)
                method: mutable bool = false
                actuals: mutable darray[Ast::Expr] = arguments
                actual_labels: mutable darray[sview] = labels
                match ga_callable_core(callee):
                    Expr.Field(receiver, method_name, _):
                        method <- true
                        if ga_annotation(receiver, state, depth + 1) is receiver_type:
                            slot <- ga_resolve_function(method_name, ga_receiver_scope(receiver_type, state), false, state)
                        actuals <- [receiver]
                        actual_labels <- [""]
                        actuals.extend(arguments)
                        actual_labels.extend(labels)
                        slot <- ga_select_function(slot, actuals, actual_labels, state, true)
                    _:
                        slot <- ga_select_function(slot, actuals, actual_labels, state)
                # stage0's rule: a returned reference was charged where the callee created
                # it, so an opaque call result names detached storage, never a global.
                return GLOBAL_AUTHORITY_LOCAL_ALIAS if slot >= state.functions.count or state.functions[slot] == ""
                result: mutable usize = GLOBAL_AUTHORITY_NONE
                found: mutable bool = false
                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(slot, state), result, found, state|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    continue if not ga_candidate_selected(candidate, slot, actuals, actual_labels, state, method)
                    found <- true
                    # Slots registered after the summary walk (lambdas) have no summary.
                    if state.summary_walk and state.summary_dependency_rounds and state.summary_function < state.return_origins.count and candidate < state.return_origins.count:
                        # Record every summary read. A later round need only revisit callers
                        # whose inputs changed, including newly discovered reads on that walk.
                        # Duplicate edges are harmless and keep this bookkeeping local:
                        # no hash callback or additional global authority is introduced.
                        state.return_dep_callers.push(state.summary_function)
                        state.return_dep_callees.push(candidate)
                    summary: mutable usize = state.return_origins[candidate] if candidate < state.return_origins.count else GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    summary <- GLOBAL_AUTHORITY_LOCAL_ALIAS if summary == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    if summary == GLOBAL_AUTHORITY_ARGUMENT_RESULT:
                        for actual in actuals |result, state| -> result:
                            result <- ga_join_origins(state, result, ga_reference_origin(actual, state, depth + 1))
                    else:
                        result <- ga_join_origins(state, result, summary)
                    return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if result == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                return result if found
                return GLOBAL_AUTHORITY_LOCAL_ALIAS

        # Fold one `return` into the current function's summary, in callee terms.
        def ga_record_return_origin(returned: Ast::Expr, state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                slot: usize = state.summary_function
                return if slot >= state.return_origin_acc.count or state.lambda_depth != 0
                origin: usize = ga_reference_origin(returned, state, 0)
                summary: mutable usize = GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                if origin == GLOBAL_AUTHORITY_NONE or origin < state.globals.count or origin == GLOBAL_AUTHORITY_LOCAL_ALIAS:
                    summary <- origin
                elif origin < GLOBAL_AUTHORITY_LOCAL_ALIAS and ga_local_origin_index(origin, state) < state.parameter_limit:
                    summary <- GLOBAL_AUTHORITY_ARGUMENT_RESULT
                previous: usize = state.return_origin_acc[slot]
                if previous == GLOBAL_AUTHORITY_NONE:
                    state.return_origin_acc[slot] <- summary
                elif previous != summary and summary != GLOBAL_AUTHORITY_NONE:
                    state.return_origin_acc[slot] <- GLOBAL_AUTHORITY_UNKNOWN_ALIAS

        # stage0's rule: following a reference stored in a field or element reaches
        # storage of its own, not the global that held the pointer. Authority is charged
        # where an alias to a global is created (borrow, store, escape) and where the
        # holding global itself is read, never again where the stored pointer is followed.
        def ga_loaded_reference(expression: Ast::Expr, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                        type_expression: Ast::Expr = get ga_annotation(expression, state, 0) else return false
                        loaded_scope: usize = ga_expression_type_scope(expression, state, 0)
                        return false if loaded_scope == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return ga_reference_type(type_expression, state, 0, loaded_scope)
                    _:
                        return false

        # The proved policy join, refined for authority: two different origins that are
        # each known not to be a global (local roots, detached storage) still name no
        # global, so the join is detached rather than an unknown alias.
        def ga_join_origins(state: GlobalAuthority&, left: usize, right: usize) -> usize:
            joined: usize = SemanticGlobalAuthorityOrigin::join_reference_origins(left, right)
            return joined if joined != GLOBAL_AUTHORITY_UNKNOWN_ALIAS
            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if left == GLOBAL_AUTHORITY_UNKNOWN_ALIAS or right == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if left < state.globals.count or right < state.globals.count
            return GLOBAL_AUTHORITY_LOCAL_ALIAS

        def ga_reference_origin(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > 32
                if ga_cast_operand(expression) is cast_operand:
                    # A cast from a value with no origin (an integer address) names no
                    # global binding: the result is detached storage.
                    cast_origin: usize = ga_reference_origin(cast_operand, state, depth + 1)
                    return GLOBAL_AUTHORITY_LOCAL_ALIAS if cast_origin == GLOBAL_AUTHORITY_NONE
                    return cast_origin
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ga_reference_origin(inner, state, depth + 1)
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Ampersand:
                            direct_global: usize = ga_place_global(operand, state)
                            return direct_global if direct_global < state.globals.count
                            local_address_origin: usize = ga_local_address_origin(operand, state)
                            return local_address_origin if local_address_origin != GLOBAL_AUTHORITY_NONE
                            alias_origin: usize = ga_local_reference_origin(operand, state, depth + 1)
                            return alias_origin if alias_origin != GLOBAL_AUTHORITY_NONE
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return ga_reference_origin(operand, state, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack
                        return GLOBAL_AUTHORITY_NONE
                    Expr.Ident(name, _):
                        local_index: usize = ga_local_slot(name, state)
                        if local_index < state.local_global_origins.count:
                            origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                            return origin if origin != GLOBAL_AUTHORITY_NONE
                            # Every alias to a global records its exact origin where it is
                            # created; a local with none holds detached storage (stage0).
                            return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_expression_is_reference(expression, state, depth + 1)
                            return ga_expression_reference_origin(expression, state, depth + 1)
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index < state.locals.count
                        global_slot: usize = ga_global(expression, state)
                        if global_slot < state.globals.count and ga_expression_is_reference(state.global_types[global_slot], state, depth + 1):
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return SemanticGlobalAuthorityOrigin::opaque_expression_origin(true, ga_type_expression_contains_reference(state.global_types[global_slot], state, depth + 1)) if global_slot < state.globals.count
                        # Neither a local nor a global (`result` in a contract, a function
                        # name): no global binding is named, so its storage is detached.
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS
                    Expr.Call(callee, arguments, labels, _):
                        variant_slot: usize = ga_enum_variant_slot(callee, state)
                        return ga_enum_constructor_origin(variant_slot, arguments, labels, state, depth + 1) if variant_slot < state.enum_variant_names.count
                        opaque_origin: usize = ga_expression_reference_origin(expression, state, depth + 1)
                        return opaque_origin if opaque_origin != GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return ga_call_result_origin(callee, arguments, labels, state, depth + 1)
                    Expr.If(_, then_value, else_value, _):
                        then_origin: usize = ga_reference_origin(then_value, state, depth + 1)
                        # `return X if c` has no else value: only X can be produced.
                        return then_origin if else_value is Expr.Absent
                        return ga_join_origins(state, then_origin, ga_reference_origin(else_value, state, depth + 1))
                    Expr.Match(_, _, _):
                        return ga_expression_reference_origin(expression, state, depth + 1)
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        # Literal storage is static and immutable, never a mutable global.
                        return GLOBAL_AUTHORITY_NONE
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        origin: mutable usize = GLOBAL_AUTHORITY_NONE
                        for element in elements |origin, state| -> origin:
                            element_origin: usize = ga_reference_origin(element, state, depth + 1)
                            origin <- ga_join_origins(state, origin, element_origin)
                        return origin
                    Expr.DictLit(entries, _):
                        origin: mutable usize = GLOBAL_AUTHORITY_NONE
                        for entry in entries |origin, state| -> origin:
                            key_origin: usize = ga_reference_origin(entry.key, state, depth + 1)
                            value_origin: usize = ga_reference_origin(entry.value, state, depth + 1)
                            origin <- ga_join_origins(state, origin, key_origin)
                            origin <- ga_join_origins(state, origin, value_origin)
                        return origin
                    Expr.Construct(type_expression, fields, _):
                        origin: mutable usize = GLOBAL_AUTHORITY_NONE
                        for field in fields |origin, state| -> origin:
                            field_origin: usize = ga_reference_origin(field.value, state, depth + 1)
                            origin <- ga_join_origins(state, origin, field_origin)
                        if ga_type_expression_contains_reference(type_expression, state, depth + 1) and ga_construct_omits_reference_field(type_expression, fields, state):
                            return SemanticGlobalAuthorityOrigin::constructor_origin(origin, false)
                        return SemanticGlobalAuthorityOrigin::constructor_origin(origin, true)
                    Expr.RecordUpdate(base, fields, _):
                        origin: mutable usize = ga_reference_origin(base, state, depth + 1)
                        for field in fields |origin, state| -> origin:
                            field_origin: usize = ga_reference_origin(field.value, state, depth + 1)
                            origin <- ga_join_origins(state, origin, field_origin)
                        return origin
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _):
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_loaded_reference(expression, state)
                        origin: usize = ga_local_reference_origin(expression, state, depth + 1)
                        return origin if origin != GLOBAL_AUTHORITY_NONE
                        # A projection rooted in neither a global place nor a recorded alias
                        # cannot reach a global: every global alias records its origin.
                        return ga_expression_reference_origin(expression, state, depth + 1) if ga_place_global(expression, state) < state.globals.count
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_local_storage_slot(expression, state) < state.locals.count
                        return ga_expression_reference_origin(expression, state, depth + 1)
                    Expr.Binary(left, operator, right, _):
                        # Pointer arithmetic stays inside the storage its reference operand
                        # names; the integer operand contributes no origin of its own.
                        if operator == TokenKind.Plus or operator == TokenKind.Minus:
                            return ga_reference_origin(left, state, depth + 1) if ga_integer_valued(right, state, depth + 1)
                            return ga_reference_origin(right, state, depth + 1) if ga_integer_valued(left, state, depth + 1)
                            left_origin: usize = ga_reference_origin(left, state, depth + 1)
                            right_origin: usize = ga_reference_origin(right, state, depth + 1)
                            return ga_join_origins(state, left_origin, right_origin)
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if ga_expression_is_reference(expression, state, depth + 1)
                        return ga_expression_reference_origin(expression, state, depth + 1)
                    _:
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if ga_expression_is_reference(expression, state, depth + 1)
                        return ga_expression_reference_origin(expression, state, depth + 1)

        def ga_local_storage_slot(expression: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                depth: mutable u32 = 0
                while true |current, depth, state|:
                    if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                        ga_mark_walk_overflow(Ast::expr_pos(current), state)
                        return GLOBAL_AUTHORITY_NONE
                    match current:
                        Expr.Ident(name, _):
                            return ga_local_slot(name, state)
                        Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _) | Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                            current <- base
                            depth <- depth + 1
                        _:
                            return GLOBAL_AUTHORITY_NONE
                return GLOBAL_AUTHORITY_NONE

        # For aggregate-content updates, a local reference binding names its live local
        # referent when that target is known. Other uses keep ga_local_storage_slot's
        # binding-slot semantics.
        def ga_local_referent_storage_slot(expression: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                local_index: usize = ga_local_storage_slot(expression, state)
                return local_index if local_index >= state.locals.count or local_index >= state.local_types.count
                if state.local_types[local_index] is root_type and ga_reference_type(root_type, state, 0):
                    origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state) if local_index < state.local_global_origins.count else GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    root_index: usize = ga_local_origin_index(origin, state)
                    return root_index if root_index < state.locals.count
                    return state.locals.count
                return local_index

        # Borrowing a local place names that place's storage, not the references
        # contained in its value. A projection through a reference binding instead
        # names storage reached through that binding, so preserve the binding origin.
        def ga_local_address_origin(expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                depth: mutable u32 = 0
                projected: mutable bool = false
                while true |current, depth, projected, state|:
                    if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    match current:
                        Expr.Ident(name, _):
                            local_index: usize = ga_local_slot(name, state)
                            return GLOBAL_AUTHORITY_NONE if local_index >= state.locals.count
                            return ga_local_origin(local_index, state) if not projected
                            if local_index < state.local_types.count and state.local_types[local_index] is root_type:
                                return ga_validate_local_origin(state.local_global_origins[local_index], state) if ga_reference_type(root_type, state, 0) and local_index < state.local_global_origins.count
                                return ga_local_origin(local_index, state) if not ga_reference_type(root_type, state, 0)
                            return ga_local_origin(local_index, state)
                        Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _):
                            current <- base
                            projected <- true
                            depth <- depth + 1
                        Expr.Paren(base, _) | Expr.Move(base, _):
                            current <- base
                            depth <- depth + 1
                        Expr.Unary(operator, base, _):
                            if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack:
                                current <- base
                                depth <- depth + 1
                            else:
                                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        _:
                            return GLOBAL_AUTHORITY_NONE
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS

        # The reference-binding pass classifies a real rebind. Keep exact global roots for
        # direct places and fail closed for reference-producing expressions this walk cannot
        # resolve, so a later local use cannot erase the global authority requirement.
        def ga_reference_rebind_origin(expression: Ast::Expr, state: mutable GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if depth > 32
                if ga_cast_operand(expression) is cast_operand:
                    # A cast from a value with no origin (an integer address) names no
                    # global binding: the result is detached storage.
                    cast_origin: usize = ga_reference_rebind_origin(cast_operand, state, depth + 1)
                    return GLOBAL_AUTHORITY_LOCAL_ALIAS if cast_origin == GLOBAL_AUTHORITY_NONE
                    return cast_origin
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ga_reference_rebind_origin(inner, state, depth + 1)
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Ampersand:
                            direct_global: usize = ga_place_global(operand, state)
                            return direct_global if direct_global < state.globals.count
                            local_address_origin: usize = ga_local_address_origin(operand, state)
                            return local_address_origin if local_address_origin != GLOBAL_AUTHORITY_NONE
                            alias_origin: usize = ga_local_reference_origin(operand, state, depth + 1)
                            return alias_origin if alias_origin != GLOBAL_AUTHORITY_NONE
                            return GLOBAL_AUTHORITY_NONE if ga_local_storage_slot(operand, state) < state.locals.count
                            return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return ga_reference_rebind_origin(operand, state, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    Expr.Ident(name, _):
                        # `null` parses as a keyword identifier and names no storage.
                        return GLOBAL_AUTHORITY_NONE if name == "null"
                        local_index: usize = ga_local_slot(name, state)
                        return ga_validate_local_origin(state.local_global_origins[local_index], state) if local_index < state.local_global_origins.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index < state.locals.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _):
                        return GLOBAL_AUTHORITY_NONE
                    Expr.Call(_, _, _, _) | Expr.If(_, _, _, _) | Expr.Match(_, _, _) | Expr.Binary(_, _, _, _):
                        # Same opaque-result rule as ga_reference_origin: only a result whose
                        # type may carry a reference (or is unknown) stays an unknown alias.
                        return ga_reference_origin(expression, state, depth + 1)
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _):
                        # A projection names storage reached through its root, exactly as
                        # ga_reference_origin resolves it; unknown roots stay unknown.
                        return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_loaded_reference(expression, state)
                        projected_origin: usize = ga_local_reference_origin(expression, state, depth + 1)
                        return projected_origin if projected_origin != GLOBAL_AUTHORITY_NONE
                        return ga_reference_origin(expression, state, depth + 1)
                    _:
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS

        def ga_local_reference_binding_origin(type_expression: Ast::Expr?, value: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                if type_expression is declared_type and ga_reference_type(declared_type, state, 0, ga_expression_type_scope(value, state, 0)):
                    # A reference stored in a global aggregate may use an unqualified
                    # alias from that aggregate's module. Keep the root as its scope
                    # provenance so later projections resolve the same field types.
                    return GLOBAL_AUTHORITY_LOCAL_ALIAS if ga_loaded_reference(value, state)
                    global_slot: usize = ga_place_global(value, state)
                    return global_slot if global_slot < state.globals.count
                    return ga_reference_rebind_origin(value, state, 0)
                # A binding whose declared type holds no reference cannot carry an alias.
                if type_expression is scalar_type:
                    return GLOBAL_AUTHORITY_NONE if not ga_type_expression_contains_reference(scalar_type, state, 0) and ga_expression_type_scope(value, state, 0) != GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                return ga_reference_origin(value, state, 0)

        def ga_access_unknown_alias(at: Ast::Pos, write: bool, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                required: sview = SemanticGlobalAuthorityOrigin::unknown_alias_permission(write)
                return if ga_refs_cover(state.firewalls, state.firewall_scopes, required, 0, state)
                if not state.report:
                    _ = ga_row_add(state.function, required, true, state) can Global{Read,Write}
                    if write:
                        state.writes[state.function] <- true
                    else:
                        state.reads[state.function] <- true
                elif not ga_granted(required, at, state):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalPermissionUngranted, name: "write" if write else "read", expected: required, actual: "unknown mutable reference alias", line: at.line, pos: ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)})

        def ga_reference_rebind(target: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match target:
                    Expr.Ident(_, _):
                        assignment_site: u64 = rbm_assignment_site_key(Ast::expr_pos(target))
                        return false if assignment_site == 0
                        return effect == RBM_ASSIGN_EFFECT_REBIND if table.ref_assignment_modes.get(assignment_site) is effect
                        return false
                    Expr.Paren(inner, _):
                        return ga_reference_rebind(inner, table)
                    _:
                        return false

        def ga_update_reference_origin(target: Ast::Expr, value: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        local_index: usize = ga_local_slot(name, state)
                        return GLOBAL_AUTHORITY_NONE if local_index >= state.locals.count
                        return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index >= state.local_global_origins.count
                        source_origin: usize = ga_reference_rebind_origin(value, state, 0)
                        previous_origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                        if previous_origin == GLOBAL_AUTHORITY_NONE:
                            state.local_global_origins[local_index] <- source_origin
                        elif previous_origin != source_origin:
                            state.local_global_origins[local_index] <- GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                        return state.local_global_origins[local_index]
                    Expr.Paren(inner, _):
                        return ga_update_reference_origin(inner, value, state)
                    _:
                        return GLOBAL_AUTHORITY_NONE

        # By-value aggregate origins summarize references reachable from a local root. A
        # subplace store can add another origin, so join it with the old summary instead
        # of leaving a stale local-only alias behind. Direct reference bindings keep their
        # storage origin here; merging aggregate contents into that slot would lose the
        # distinction between where the binding points and what its referent contains.
        def ga_join_aggregate_reference_origin(target: Ast::Expr, value: Ast::Expr, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                local_index: usize = ga_local_referent_storage_slot(target, state)
                return GLOBAL_AUTHORITY_NONE if local_index >= state.locals.count
                return GLOBAL_AUTHORITY_UNKNOWN_ALIAS if local_index >= state.local_global_origins.count
                previous_origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                state.local_global_origins[local_index] <- previous_origin if previous_origin != state.local_global_origins[local_index]
                return previous_origin if previous_origin == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                if local_index < state.local_types.count and state.local_types[local_index] is root_type:
                    return previous_origin if ga_reference_type(root_type, state, 0)
                if ga_annotation(value, state, 0) is value_type:
                    return previous_origin if not ga_type_expression_contains_reference(value_type, state, 0)
                source_origin: usize = ga_reference_origin(value, state, 0)
                return previous_origin if source_origin == GLOBAL_AUTHORITY_NONE
                joined_origin: usize = ga_join_origins(state, previous_origin, source_origin)
                state.local_global_origins[local_index] <- joined_origin
                return joined_origin

        # A call through a mutable aggregate may replace or synthesize contained
        # references. If the callee's write is opaque, discard a precise local-only
        # summary so subsequent projections fail closed.
        def ga_mark_aggregate_origin_unknown_if_mutated(target: Ast::Expr, state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                local_index: usize = ga_local_referent_storage_slot(target, state)
                return if local_index >= state.locals.count or local_index >= state.local_global_origins.count
                origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                state.local_global_origins[local_index] <- origin if origin != state.local_global_origins[local_index]
                return if state.local_global_origins[local_index] == GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                if local_index < state.local_types.count and state.local_types[local_index] is root_type:
                    return if ga_reference_type(root_type, state, 0)
                if ga_annotation(target, state, 0) is type_expression:
                    return if not ga_mutation_can_change_reference_contents(type_expression, state, 0)
                # A global alias the callee stores here is charged at that store (stage0's
                # creation rule), so the contents become detached storage, not unknown.
                state.local_global_origins[local_index] <- ga_join_origins(state, state.local_global_origins[local_index], GLOBAL_AUTHORITY_LOCAL_ALIAS)

        # `return r` from a reference-returning function hands the reference itself
        # back without touching its referent. The caller sees an opaque call result,
        # so an unknown alias stays fail-closed at the caller's first access.
        def ga_returns_reference_local(returned: Ast::Expr, state: mutable GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if state.lambda_depth != 0
                declared_return: Ast::Expr = get state.return_type else return false
                return false if not ga_reference_type(declared_return, state, 0)
                current: mutable Ast::Expr = returned
                while true |current|:
                    match current:
                        Expr.Paren(inner, _) | Expr.Move(inner, _):
                            current <- inner
                        Expr.Ident(name, _):
                            local_index: usize = ga_local_slot(name, state)
                            return false if local_index >= state.locals.count or local_index >= state.local_types.count or local_index >= state.local_global_origins.count
                            if state.local_types[local_index] is local_type:
                                return false if not ga_reference_type(local_type, state, 0)
                            else:
                                return false
                            origin: usize = ga_validate_local_origin(state.local_global_origins[local_index], state)
                            return origin >= state.globals.count
                        _:
                            return false
                return false

        def ga_access(expression: Ast::Expr, write: bool, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                global_slot: usize = ga_place_global(expression, state)
                if global_slot < state.globals.count:
                    mutable_path: bool = state.writable[global_slot] or ga_global_path_mutable(expression, state, 0)
                    table <- ga_access_slot(global_slot, Ast::expr_pos(expression), write, mutable_path, state, table) can Global{Read,Write}
                else:
                    alias_origin: usize = ga_reference_origin(expression, state, 0)
                    if ga_expression_is_reference(expression, state, 0):
                        if alias_origin < state.globals.count:
                            mutable_path: bool = state.writable[alias_origin] or ga_global_path_mutable(expression, state, 0)
                            table <- ga_access_slot(alias_origin, Ast::expr_pos(expression), write, mutable_path, state, table) can Global{Read,Write}
                        elif SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(alias_origin):
                            table <- ga_access_unknown_alias(Ast::expr_pos(expression), write, state, table) can Global{Read,Write}

        # A mutable reference local can outlive the expression that created it.
        # Record the global write effect at the borrow binding, while the complete
        # source path is still available (the local origin table retains only a root).
        def ga_record_mutable_global_borrow(value: Ast::Expr, binding_type: Ast::Expr?, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if binding_type is reference_type:
                    type_scope: usize = ga_expression_type_scope(value, state, 0)
                    return if not ga_reference_type(reference_type, state, 0, type_scope) or not ga_mutable_parameter(reference_type, state, 0, type_scope)
                    global_slot: usize = ga_place_global(value, state)
                    return if global_slot >= state.globals.count
                    mutable_path: bool = state.writable[global_slot] or ga_global_path_mutable(value, state, 0)
                    table <- ga_access_slot(global_slot, Ast::expr_pos(value), true, mutable_path, state, table) can Global{Read,Write} if mutable_path

        # Returning an aggregate containing a mutable reference exports the
        # referenced global's write capability, even though the returned value
        # itself is copied by value.
        def ga_record_mutable_global_escape(value: Ast::Expr, value_type: Ast::Expr?, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if value_type is type_expression:
                    type_scope: usize = ga_expression_type_scope(value, state, 0)
                    return if ga_reference_type(type_expression, state, 0, type_scope)
                    return if not ga_value_contains_mutable_reference(value, type_expression, state, 0)
                    table <- ga_charge_global_alias_components(value, state, table, 0) can Global{Read,Write}

        # Each global alias placed into an aggregate is created at that site, so charge
        # every component whose origin is an exact global, not only a uniform summary.
        def ga_charge_global_alias_components(value: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable, depth: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth > 32
                origin: usize = ga_reference_origin(value, state, 0)
                if origin < state.globals.count:
                    mutable_path: bool = state.writable[origin] or ga_global_path_mutable(value, state, 0)
                    table <- ga_access_slot(origin, Ast::expr_pos(value), true, mutable_path, state, table) can Global{Read,Write} if mutable_path
                    return
                match value:
                    Expr.Paren(inner, _):
                        table <- ga_charge_global_alias_components(inner, state, table, depth + 1) can Global{Read,Write}
                    Expr.Call(_, arguments, _, _) | Expr.Array(arguments, _) | Expr.Tuple(arguments, _) | Expr.SetLit(arguments, _):
                        for argument in arguments |state, table| -> table:
                            table <- ga_charge_global_alias_components(argument, state, table, depth + 1) can Global{Read,Write}
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        for field in fields |state, table| -> table:
                            table <- ga_charge_global_alias_components(field.value, state, table, depth + 1) can Global{Read,Write}
                    _:
                        pass

        # A store evaluates all subscripts, but does not read the storage root. A
        # compound store reads that root separately before writing it.
        def ga_target_inner(expression: Ast::Expr, read_root: bool, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                global_slot: usize = ga_place_global(expression, state)
                alias_origin: usize = ga_reference_path_origin(expression, state, 0) if global_slot >= state.globals.count else state.globals.count
                mutable_global_path: mutable bool = global_slot < state.globals.count and (state.writable[global_slot] or ga_global_path_mutable(expression, state, 0))
                mutable_global_path <- true if alias_origin < state.globals.count and (state.writable[alias_origin] or ga_global_path_mutable(expression, state, 0))
                if mutable_global_path:
                    if global_slot < state.globals.count:
                        table <- ga_access(expression, false, state, table) can Global{Read,Write} if read_root or ga_global_path_reads_reference(expression, state, 0)
                        table <- ga_access(expression, true, state, table) can Global{Read,Write}
                    else:
                        table <- ga_access_slot(alias_origin, Ast::expr_pos(expression), false, true, state, table) can Global{Read,Write} if read_root or ga_global_path_reads_reference(expression, state, 0)
                        table <- ga_access_slot(alias_origin, Ast::expr_pos(expression), true, true, state, table) can Global{Read,Write}
                    table <- ga_target_indices(expression, state, table) can Global{Read,Write}
                    return
                match expression:
                    Expr.Field(base, _, _) | Expr.Paren(base, _) | Expr.Unary(_, base, _):
                        if ga_expression_is_reference(base, state, 0):
                            table <- ga_access(base, false, state, table) can Global{Read,Write} if read_root
                            table <- ga_access(base, true, state, table) can Global{Read,Write}
                        else:
                            table <- ga_target(base, read_root, state, table) can Global{Read,Write}
                    Expr.Index(base, index, _):
                        if ga_expression_is_reference(base, state, 0):
                            table <- ga_access(base, false, state, table) can Global{Read,Write} if read_root
                            table <- ga_access(base, true, state, table) can Global{Read,Write}
                        else:
                            table <- ga_target(base, read_root, state, table) can Global{Read,Write}
                        table <- ga_expression(index, state, table) can Global{Read,Write}
                    Expr.IndexN(base, indices, _):
                        if ga_expression_is_reference(base, state, 0):
                            table <- ga_access(base, false, state, table) can Global{Read,Write} if read_root
                            table <- ga_access(base, true, state, table) can Global{Read,Write}
                        else:
                            table <- ga_target(base, read_root, state, table) can Global{Read,Write}
                        for index in indices |state, table| -> table:
                            table <- ga_expression(index, state, table) can Global{Read,Write}
                    _:
                        table <- ga_access(expression, false, state, table) can Global{Read,Write} if read_root
                        table <- ga_access(expression, true, state, table) can Global{Read,Write}

        def ga_target_indices(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                match expression:
                    Expr.Field(base, _, _) | Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                        table <- ga_target_indices(base, state, table) can Global{Read,Write}
                    Expr.Index(base, index, _):
                        table <- ga_target_indices(base, state, table) can Global{Read,Write}
                        table <- ga_expression(index, state, table) can Global{Read,Write}
                    Expr.IndexN(base, indices, _):
                        table <- ga_target_indices(base, state, table) can Global{Read,Write}
                        for index in indices |state, table| -> table:
                            table <- ga_expression(index, state, table) can Global{Read,Write}
                    Expr.Slice(base, low, high, _):
                        table <- ga_target_indices(base, state, table) can Global{Read,Write}
                        table <- ga_expression(low, state, table) can Global{Read,Write}
                        table <- ga_expression(high, state, table) can Global{Read,Write}
                    _:
                        pass
                state.walk_depth <- state.walk_depth - 1

        def ga_target(expression: Ast::Expr, read_root: bool, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                table <- ga_target_inner(expression, read_root, state, table) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_write_place_inner(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                global_slot: usize = ga_place_global(expression, state)
                if global_slot < state.globals.count and ga_global_path_mutable(expression, state, 0):
                    table <- ga_access(expression, true, state, table) can Global{Read,Write}
                    table <- ga_target_indices(expression, state, table) can Global{Read,Write}
                    return
                alias_origin: usize = ga_reference_path_origin(expression, state, 0)
                if alias_origin < state.globals.count and (state.writable[alias_origin] or ga_global_path_mutable(expression, state, 0)):
                    table <- ga_access_slot(alias_origin, Ast::expr_pos(expression), true, true, state, table) can Global{Read,Write}
                    table <- ga_target_indices(expression, state, table) can Global{Read,Write}
                    return
                match expression:
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _) if ga_expression_is_reference(expression, state, 0):
                        table <- ga_access(expression, true, state, table) can Global{Read,Write}
                    Expr.Field(base, _, _) | Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Slice(base, _, _, _) | Expr.Paren(base, _) | Expr.Move(base, _) | Expr.Unary(_, base, _):
                        table <- ga_write_place(base, state, table) can Global{Read,Write}
                    _:
                        table <- ga_access(expression, true, state, table) can Global{Read,Write}

        def ga_write_place(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                table <- ga_write_place_inner(expression, state, table) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_callable_core(expression: Ast::Expr) -> Ast::Expr:
            current: mutable Ast::Expr = expression
            while true |current|:
                match current:
                    Expr.Paren(inner, _) | Expr.Index(inner, _, _) | Expr.IndexN(inner, _, _):
                        current <- inner
                    _:
                        return current
            return current

        def ga_inferred_writable(expression: Ast::Expr, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = expression
                while true |current|:
                    match current:
                        Expr.Paren(inner, _):
                            current <- inner
                        Expr.Unary(operator, _, _):
                            return true if operator == TokenKind.Ampersand
                            break
                        _:
                            break
                if ga_annotation(current, state, 0) is annotation:
                    return ga_mutable_parameter(annotation, state, 0)
                return false

        def ga_named_callee_slot(callee: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                name: mutable sview = ""
                module_scope: mutable usize = state.module_scope
                qualified: mutable bool = false
                match ga_callable_core(callee):
                    Expr.Field(_, method, _):
                        name <- method
                    Expr.Ident(ident, _):
                        local_index: mutable usize = min(state.local_limit, state.locals.count)
                        while local_index > state.local_floor |local_index|:
                            local_index <- local_index - 1
                            return state.local_callees[local_index] if state.locals[local_index] == ident
                        name <- ident
                    Expr.Lambda(_, _, at):
                        for index in 0..<state.functions.count:
                            return index if state.functions[index] == "" and state.function_offsets[index] == at.offset and state.function_scopes[index] == state.module_scope
                        return state.functions.count
                    Expr.Scope(base, member, _):
                        name <- member
                        module_scope <- ga_module_readonly(base, state)
                        qualified <- true
                    _:
                        return state.functions.count
                slot: usize = ga_resolve_function(name, module_scope, qualified, state)
                return slot

        def ga_receiver_scope(type_expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                slot: usize = ga_known_struct(type_expression, state.module_scope, state, 0)
                return state.struct_scopes[slot] if slot < state.struct_names.count else state.module_scope

        def ga_conversion_slot(receiver: Ast::Expr, target: sview @source, at: Ast::Pos, state: mutable GlobalAuthority&, optional_target: bool = false) -> usize:
            can Memory.Allocate, Abort.Panic:
                target_type: Ast::Expr = Ast::Expr.Ident(target, at)
                known_target: bool = ga_cast_builtin(target_type, state.module_scope, state)
                nonbuiltin_target: bool = ga_nonbuiltin_cast_target(target_type, state.module_scope, state)
                protocol: usize = ga_bound_protocol(receiver, state)
                actual_type: Ast::Expr? = ga_annotation(receiver, state, 0)
                actuals: darray[Ast::Expr] = [receiver]
                joined: mutable usize = GLOBAL_AUTHORITY_NONE
                known_receiver: bool = ga_arguments_known(actuals, state)
                if protocol < state.protocol_names.count:
                    for index in 0..<state.protocol_contract_slots.count |joined, state|:
                        slot: usize = state.protocol_contract_slots[index]
                        contract_scope: usize = state.protocol_contract_scopes[index]
                        contract_offset: u32 = state.protocol_contract_offsets[index]
                        belongs: mutable bool = false
                        compatible: mutable bool = true
                        for annotation in state.annotations |belongs, compatible|:
                            continue if annotation.offset != contract_offset or ga_module_text(annotation.module, state) != contract_scope
                            if annotation.owner == "__protocol_method_scope":
                                belongs <- ga_protocol_includes(protocol, annotation.name, contract_scope, state)
                            if annotation.line == 3900000131 and annotation.owner == "__cast__" and known_target and not optional_target:
                                # Only a complete unshadowed builtin return can exclude
                                # another target. Qualified/wrapped/unknown returns stay.
                                declared: Ast::Expr = Ast::Expr.Ident(annotation.name, at)
                                if ga_cast_builtin(declared, contract_scope, state):
                                    compatible <- ga_cast_heads_match(annotation.name, target)
                        continue if not belongs or not compatible
                        child: usize = ga_join_callback(slot, slot, at, state, GLOBAL_AUTHORITY_NONE, true) can Global{Read,Write}
                        joined <- ga_join_callback(joined, child, at, state) can Global{Read,Write}
                while next_candidate < state.functions.count |next_candidate: usize = ga_function_head("__cast__", state), joined, state|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    continue if state.functions[candidate] != "__cast__"
                    result_option: Ast::Expr? = state.function_return_types[candidate]
                    if result_option is result:
                        continue if nonbuiltin_target and not optional_target and ga_cast_builtin(result, state.function_scopes[candidate], state)
                        if known_target and not optional_target:
                            if ga_cast_builtin(result, state.function_scopes[candidate], state):
                                resolved: Ast::Expr = ga_type_alias_result(result, state.function_scopes[candidate], state, 0)
                                continue if not ga_cast_heads_match(ga_type_head(resolved), target)
                            else:
                                continue if ga_known_struct(result, state.function_scopes[candidate], state, 0) < state.struct_names.count
                                # An unresolved return identity cannot eliminate a hook.
                        if protocol < state.protocol_names.count:
                            continue if not ga_protocol_member(candidate, protocol, state)
                        else:
                            continue if known_receiver and ga_protocol_member(candidate, state.protocol_names.count, state)
                            continue if known_receiver and ga_method_receiver_rank(candidate, actuals, state) == -1
                            if actual_type is actual and ga_argument_type(candidate, 0, "", state) is formal:
                                if ga_cast_builtin(formal, state.function_scopes[candidate], state) and ga_cast_builtin(actual, state.module_scope, state):
                                    formal_type: Ast::Expr = ga_type_alias_result(formal, state.function_scopes[candidate], state, 0)
                                    receiver_type: Ast::Expr = ga_type_alias_result(actual, state.module_scope, state, 0)
                                    continue if not ga_cast_heads_match(ga_type_head(formal_type), ga_type_head(receiver_type))
                                continue if ga_known_struct(actual, state.module_scope, state, 0) < state.struct_names.count and ga_cast_builtin(formal, state.function_scopes[candidate], state)
                        child: usize = ga_join_callback(candidate, candidate, at, state, GLOBAL_AUTHORITY_NONE, true) can Global{Read,Write}
                        joined <- ga_join_callback(joined, child, at, state) can Global{Read,Write}
                proven_type: bool = known_target or ga_known_struct(target_type, state.module_scope, state, 0) < state.struct_names.count or ga_resolve_indexed(target, state.module_scope, false, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state) < state.enum_names.count or ga_alias(target_type, state) < state.alias_names.count or target == "void" or target == "int"
                if not proven_type:
                    receiver_scope: usize = ga_receiver_scope(annotation, state) if actual_type is annotation else state.module_scope
                    ordinary: usize = ga_resolve_function(target, receiver_scope, false, state)
                    receiver_labels: darray[sview] = [""]
                    while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(ordinary, state), joined, state|:
                        candidate: usize = next_candidate
                        next_candidate <- state.function_next[candidate]
                        continue if ordinary >= state.functions.count or state.functions[candidate] != target or state.function_scopes[candidate] != state.function_scopes[ordinary] or ga_candidate_score(candidate, actuals, receiver_labels, state, true) < 0
                        child: usize = ga_join_callback(candidate, candidate, at, state, GLOBAL_AUTHORITY_NONE, true) can Global{Read,Write}
                        joined <- ga_join_callback(joined, child, at, state) can Global{Read,Write}
                return joined

        def ga_callee_slot(callee: Ast::Expr, state: mutable GlobalAuthority&, depth: u32 = 0, postfix_conversion: bool = false) -> usize:
            can Memory.Allocate, Abort.Panic:
                if depth > 32:
                    ga_mark_walk_overflow(Ast::expr_pos(callee), state)
                    return state.unknown_callback_slot
                core: Ast::Expr = ga_postfix_callee(ga_callable_core(callee)) if postfix_conversion else ga_callable_core(callee)
                match core:
                    Expr.Call(factory, arguments, labels, at):
                        conversion: bool = arguments.count == 0 and labels.count == 0 and ga_target_conversion(factory, state)
                        callable: Ast::Expr = ga_postfix_callee(ga_callable_core(factory)) if conversion else ga_callable_core(factory)
                        actuals: mutable darray[Ast::Expr] = arguments
                        actual_labels: mutable darray[sview] = labels
                        method: bool = callable is Expr.Field
                        match callable:
                            Expr.Field(receiver, _, _):
                                actuals <- [receiver]
                                actual_labels <- [""]
                                actuals.extend(arguments)
                                actual_labels.extend(labels)
                            _:
                                pass
                        factory_head: usize = ga_callee_slot(factory, state, depth + 1, conversion) can Global{Read,Write}
                        factory_slot: usize = ga_select_function(factory_head, actuals, actual_labels, state, method)
                        returned: mutable usize = GLOBAL_AUTHORITY_NONE
                        while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(factory_slot, state), returned, state|:
                            candidate: usize = next_candidate
                            next_candidate <- state.function_next[candidate]
                            continue if not ga_candidate_selected(candidate, factory_slot, actuals, actual_labels, state, method)
                            child_return: usize = ga_callback_return_slot(candidate, at, state, depth + 1)
                            returned <- ga_join_callback(returned, child_return, at, state, factory_slot) can Global{Read,Write}
                        return returned
                    Expr.Field(receiver, method, at):
                        if postfix_conversion:
                            return ga_conversion_slot(receiver, method, at, state, callee is Expr.Unary) can Global{Read,Write}
                        if ga_annotation(receiver, state, 0) is receiver_type:
                            return ga_resolve_function(method, ga_receiver_scope(receiver_type, state), false, state)
                    _:
                        pass
                return ga_named_callee_slot(callee, state)

        # A type head alone is insufficient: void&, void? and qualified names
        # can carry storage even though their final spelling is "void".
        def ga_exact_void_return(expression: Ast::Expr) -> bool:
            return match expression:
                Expr.Ident(name, _): name == "void"
                _: false

        def ga_return_callback_type(expression: Ast::Expr, origin_scope: usize, state: mutable GlobalAuthority&, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                if depth > 32:
                    ga_mark_walk_overflow(Ast::expr_pos(expression), state)
                    return false
                resolved: Ast::Expr = ga_type_alias_result(expression, origin_scope, state, depth)
                match resolved:
                    Expr.Lambda(_, _, _):
                        return true
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _):
                        return ga_return_callback_type(inner, origin_scope, state, depth + 1)
                    _:
                        return false

        def ga_allocate_return_rows(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                original_count: usize = state.functions.count
                for slot in 0..<original_count |state|:
                    state.returned_callees.push(GLOBAL_AUTHORITY_NONE)
                for slot in 0..<original_count |state|:
                    if state.function_return_types[slot] is declared_return:
                        continue if not ga_return_callback_type(declared_return, state.function_scopes[slot], state)
                        returned_slot: usize = state.functions.count
                        state.returned_callees[slot] <- returned_slot
                        state.functions.push("")
                        state.function_next.push(GLOBAL_AUTHORITY_NONE)
                        state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                        state.function_scopes.push(state.function_scopes[slot])
                        state.function_offsets.push(state.function_offsets[slot])
                        state.function_lines.push(0)
                        state.function_variadic.push(false)
                        state.function_return_types.push(null)
                        state.parameter_starts.push(state.parameter_types.count)
                        state.parameter_counts.push(0)
                        state.parameter_minimum.push(0)
                        state.reads.push(false)
                        state.writes.push(false)

        # Defaults execute only when omitted, using caller authority and callee lexical
        # names. The saved caller binding stacks remain available for resolving actuals.
        def ga_defaults(slot: usize, at: Ast::Pos, arguments: darray[Ast::Expr]&, labels: darray[sview]&, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if state.default_depth >= 32:
                    ga_mark_walk_overflow(at, state)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExpressionAnalysisDepthExceeded, name: "default argument", expected: "32", actual: "", line: at.line, pos: ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)}) if state.report
                    return
                has_origin: mutable bool = false
                if ga_callback_origin_index_ready(state):
                    has_origin <- ga_callback_origin_head(slot, state) < state.callback_origin_from.count
                else:
                    for edge in 0..<state.callback_origin_from.count |has_origin|:
                        has_origin <- true if state.callback_origin_from[edge] == slot
                if has_origin:
                    state.default_depth <- state.default_depth + 1
                    origin_count: usize = state.callback_origin_from.count
                    if ga_callback_origin_index_ready(state):
                        edge: mutable usize = ga_callback_origin_head(slot, state)
                        while edge < origin_count |edge, state, table| -> table:
                            if state.callback_origin_from[edge] == slot:
                                child: usize = state.callback_origin_to[edge]
                                table <- ga_defaults(child, at, arguments, labels, state, table) can Global{Read,Write}
                            edge <- state.callback_origin_next[edge]
                    else:
                        for edge in 0..<origin_count |state, table| -> table:
                            continue if state.callback_origin_from[edge] != slot
                            child: usize = state.callback_origin_to[edge]
                            table <- ga_defaults(child, at, arguments, labels, state, table) can Global{Read,Write}
                    state.default_depth <- state.default_depth - 1
                    return
                end: usize = min(state.parameter_starts[slot] + state.parameter_counts[slot], state.parameter_defaults.count)
                has_default: mutable bool = false
                for index in state.parameter_starts[slot]..<end |has_default|:
                    has_default <- true if state.parameter_functions[index] == slot and state.parameter_defaults[index] != null
                return if not has_default
                grant_mark: usize = state.grants.count
                while next_index > 0 |next_index: usize = ga_inline_limit(at.offset, state), state|:
                    index: usize = next_index - 1
                    next_index <- index
                    break if state.inline_prefix_ends[index] <= at.offset
                    span: Ast::Pos = state.inline_spans[index]
                    if at.offset >= span.offset and at.offset < span.end_offset:
                        state.grants.push(state.inline_refs[index])
                        state.grant_scopes.push(state.inline_scopes[index])
                mark: usize = state.locals.count
                saved_floor: usize = state.local_floor
                saved_limit: usize = state.local_limit
                saved_scope: usize = state.module_scope
                state.local_floor <- mark
                state.local_limit <- GLOBAL_AUTHORITY_NONE
                state.module_scope <- state.function_scopes[slot]
                state.default_depth <- state.default_depth + 1
                parameter_position: mutable usize = 0
                for parameter in state.parameter_starts[slot]..<end |state, table, parameter_position| -> table:
                    continue if state.parameter_functions[parameter] != slot
                    supplied: mutable usize = arguments.count
                    for index in 0..<arguments.count |supplied|:
                        label: sview = labels[index] if index < labels.count else sview("", 0, 0)
                        supplied <- index if label == state.parameter_names[parameter] or (label == "" and index == parameter_position)
                    callback: mutable usize = GLOBAL_AUTHORITY_NONE
                    if supplied < arguments.count:
                        state.local_floor <- saved_floor
                        state.local_limit <- min(saved_limit, mark)
                        state.module_scope <- saved_scope
                        callback <- ga_callee_slot(arguments[supplied], state) can Global{Read,Write}
                        state.local_floor <- mark
                        state.local_limit <- GLOBAL_AUTHORITY_NONE
                        state.module_scope <- state.function_scopes[slot]
                    elif state.parameter_defaults[parameter] is default_value:
                        table <- ga_expression(default_value, state, table) can Global{Read,Write}
                        table <- ga_callback_handoff(default_value, default_value, state, table) can Global{Read,Write}
                        table <- ga_write_place(default_value, state, table) can Global{Read,Write} if ga_mutable_parameter(state.parameter_types[parameter], state, 0)
                        callback <- ga_callee_slot(default_value, state) can Global{Read,Write}
                    state.locals.push(state.parameter_names[parameter])
                    _ = ga_push_local_origin_id(state) can Global{Read,Write}
                    state.local_types.push(state.parameter_types[parameter])
                    state.local_type_scopes.push(ga_type_scope(state.parameter_types[parameter], state))
                    state.local_callees.push(callback if callback < state.functions.count else GLOBAL_AUTHORITY_NONE)
                    state.local_global_origins.push(GLOBAL_AUTHORITY_NONE)
                    parameter_position <- parameter_position + 1
                state.default_depth <- state.default_depth - 1
                state.locals.truncate(mark)
                state.local_origin_ids.truncate(mark)
                state.local_types.truncate(mark)
                state.local_type_scopes.truncate(mark)
                state.local_callees.truncate(mark)
                state.local_global_origins.truncate(mark)
                state.local_floor <- saved_floor
                state.local_limit <- saved_limit
                state.module_scope <- saved_scope
                state.grants.truncate(grant_mark)
                state.grant_scopes.truncate(grant_mark)

        # trusted intentionally suppresses Unsafe implementation effects only.
        def ga_trust_unsafe(ref: sview, origin: usize, at: Ast::Pos, state: mutable GlobalAuthority&, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                if depth > 32:
                    ga_mark_walk_overflow(at, state)
                    return
                alias: usize = ga_capability_slot(ref, origin, state)
                if alias < state.capability_names.count:
                    for row in 0..<state.capability_names.count |state|:
                        if state.capability_names[row] == state.capability_names[alias] and state.capability_scopes[row] == state.capability_scopes[alias]:
                            ga_trust_unsafe(state.capability_refs[row], state.capability_scopes[row], at, state, depth + 1)
                    return
                return if effect_ref_family(ref) != "Unsafe"
                state.grants.push(ref)
                state.grant_scopes.push(origin)
                state.firewalls.push(ref)
                state.firewall_scopes.push(origin)

        # Apply the operation for one already-selected callee. This takes the
        # source position by value so cold AST traversal and future fact replay share
        # the same row/edge behavior without constructing an AST expression.
        def ga_resolved_call_candidate(candidate: usize, at: Ast::Pos, need_read: mutable bool&, need_write: mutable bool&, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                need_read <- need_read or state.reads[candidate]
                need_write <- need_write or state.writes[candidate]
                if state.summary_walk:
                    pass
                elif state.report:
                    table <- ga_generic_call_rows_at(candidate, at, state, table) can Global{Read,Write}
                else:
                    ga_edge_rows(state.function, candidate, state) can Global{Read,Write}
                    state.edge_from.push(state.function)
                    state.edge_to.push(candidate)
                    state.edge_reads.push(not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Read", 0, state))
                    state.edge_writes.push(not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Write", 0, state))

        def ga_report_call_global_requirements(name: sview, at: Ast::Pos, need_read: bool, need_write: bool, state: GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                missing_read: bool = need_read and not ga_granted("Global.Read", at, state)
                missing_write: bool = need_write and not ga_granted("Global.Write", at, state)
                if missing_read or missing_write:
                    required: sview = "Global{Read,Write}" if missing_read and missing_write else ("Global.Write" if missing_write else "Global.Read")
                    diagnostic_bytes: mutable darray[u8] = []
                    diagnostic_bytes.extend(name)
                    stable_name: sview = Parser::persist_name_bytes(&diagnostic_bytes, 0) can Global{Read,Write}
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalCallUngranted, name: stable_name, expected: required, actual: "Global", line: at.line, pos: ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)})

        def ga_call(callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, state: mutable GlobalAuthority&, table: lmut SymbolTable, out_head: mutable usize&, out_head_stable: mutable bool&, postfix_conversion: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                function_count: usize = state.functions.count
                callee_head: usize = ga_callee_slot(callee, state, 0, postfix_conversion) can Global{Read,Write}
                slot: usize = ga_select_function(callee_head, arguments, argument_names, state, ga_callable_core(callee) is Expr.Field)
                name: sview = match callee:
                    Expr.Ident(ident, _) | Expr.Scope(_, ident, _) | Expr.Field(_, ident, _): ident
                    _: "lambda"
                at: Ast::Pos = Ast::expr_pos(callee)
                need_read: mutable bool = false
                need_write: mutable bool = false
                if ga_annotation(callee, state, 0) is callee_type:
                    declared: (read: bool, write: bool) = ga_declared_global_members(callee_type, state, 0)
                    need_read <- declared.read
                    need_write <- declared.write
                if not state.report:
                    state.reads[state.function] <- true if need_read and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Read", 0, state)
                    state.writes[state.function] <- true if need_write and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Write", 0, state)
                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(slot, state), state, table, need_read, need_write| -> table:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    continue if not ga_candidate_selected(candidate, slot, arguments, argument_names, state, ga_callable_core(callee) is Expr.Field)
                    table <- ga_defaults(candidate, at, arguments, argument_names, state, table) can Global{Read,Write}
                    table <- ga_resolved_call_candidate(candidate, at, need_read, need_write, state, table) can Global{Read,Write}
                if state.report:
                    table <- ga_report_call_global_requirements(name, at, need_read, need_write, state, table) can Global{Read,Write}
                out_head <- callee_head
                out_head_stable <- state.functions.count == function_count

        def ga_callback_handoff(callee: Ast::Expr, value: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callback: usize = ga_callee_slot(value, state) can Global{Read,Write}
                declared: (read: bool, write: bool) = ga_declared_global_members(annotation, state, 0) if ga_annotation(value, state, 0) is annotation else (false, false)
                need_read: mutable bool = declared.read
                need_write: mutable bool = declared.write
                if not state.report:
                    state.reads[state.function] <- true if need_read and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Read", 0, state)
                    state.writes[state.function] <- true if need_write and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Write", 0, state)
                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(callback, state) if callback < state.functions.count else GLOBAL_AUTHORITY_NONE, state, need_read, need_write|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    selected: bool = candidate == callback if state.functions[callback] == "" else state.functions[candidate] == state.functions[callback] and state.function_scopes[candidate] == state.function_scopes[callback]
                    continue if not selected
                    table <- ga_resolved_call_candidate(candidate, Ast::expr_pos(callee), need_read, need_write, state, table) can Global{Read,Write}
                if state.report:
                    missing_read: bool = need_read and not ga_granted("Global.Read", Ast::expr_pos(value), state)
                    missing_write: bool = need_write and not ga_granted("Global.Write", Ast::expr_pos(value), state)
                    if missing_read or missing_write:
                        name: sview = match callee:
                            Expr.Ident(ident, _) | Expr.Scope(_, ident, _): ident
                            _: "callback"
                        required: sview = "Global{Read,Write}" if missing_read and missing_write else ("Global.Write" if missing_write else "Global.Read")
                        at: Ast::Pos = Ast::expr_pos(value)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalCallUngranted, name: "callback argument", expected: required, actual: "callback", line: at.line, pos: ga_position_value(at.line, at.column, at.offset, at.end_line, at.end_column, at.end_offset)})

        # A deferred generic effect call is lowered to one of its handler functions.
        # Analyze every candidate conservatively: the generic type binding that selects
        # the runtime handler is not necessarily known in this source pass.
        def ga_static_effect_call(operation: sview @source, candidates: darray[Ast::StaticEffectCandidate], arguments: darray[Ast::Expr], argument_names: darray[sview], at: Ast::Pos, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for child in Ast::effect_runtime_children(candidates, arguments) |state, table|:
                    table <- ga_expression(child, state, table) can Global{Read,Write}
                need_read: mutable bool = false
                need_write: mutable bool = false
                mutates_arguments: mutable darray[bool] = []
                for argument in arguments |mutates_arguments|:
                    mutates_arguments.push(false)
                call_marker: Ast::Expr = Ast::Expr.Ident(operation, at)
                resolved_candidates: mutable usize = 0
                for candidate in candidates |state, table, need_read, need_write, mutates_arguments, resolved_candidates, call_marker, at|:
                    actuals: mutable darray[Ast::Expr] = []
                    labels: mutable darray[sview] = []
                    for capture in candidate.captures |actuals, labels|:
                        actuals.push(capture)
                        labels.push(sview("", 0, 0))
                    for argument_index in 0..<arguments.count |actuals, labels, argument_names|:
                        actuals.push(arguments[argument_index])
                        labels.push(argument_names[argument_index] if argument_index < argument_names.count else sview("", 0, 0))
                    owner_scope: usize = ga_module_text(candidate.callee_owner, state)
                    first: usize = ga_resolve_function(candidate.callee, owner_scope, true, state) if owner_scope < state.modules.count else state.functions.count
                    selected: usize = ga_select_function(first, actuals, labels, state)
                    selected_any: mutable bool = false
                    candidate_capture_mutations: mutable darray[bool] = []
                    for capture in candidate.captures |candidate_capture_mutations|:
                        candidate_capture_mutations.push(false)
                    while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(selected, state), state, table, need_read, need_write, actuals, labels, candidate_capture_mutations, mutates_arguments, resolved_candidates, selected_any| -> table:
                        row: usize = next_candidate
                        next_candidate <- state.function_next[row]
                        continue if not ga_candidate_selected(row, selected, actuals, labels, state)
                        selected_any <- true
                        resolved_candidates <- resolved_candidates + 1
                        table <- ga_defaults(row, at, actuals, labels, state, table) can Global{Read,Write}
                        table <- ga_resolved_call_candidate(row, at, need_read, need_write, state, table) can Global{Read,Write}
                        for capture_index in 0..<candidate.captures.count |candidate_capture_mutations, row, state|:
                            candidate_capture_mutations[capture_index] <- true if ga_argument_mutates(row, capture_index, "", state)
                        for argument_index in 0..<arguments.count |mutates_arguments, row, candidate, argument_names, state|:
                            label: sview = argument_names[argument_index] if argument_index < argument_names.count else sview("", 0, 0)
                            formal_index: usize = candidate.captures.count + argument_index
                            mutates_arguments[argument_index] <- true if ga_argument_mutates(row, formal_index, label, state)
                    if not selected_any:
                        # A malformed or incomplete candidate group must not erase the
                        # operation's effect summary or a possible mutation through refs.
                        need_read <- true
                        need_write <- true
                        for capture_index in 0..<candidate_capture_mutations.count |candidate_capture_mutations|:
                            candidate_capture_mutations[capture_index] <- true
                        for argument_index in 0..<mutates_arguments.count |mutates_arguments|:
                            mutates_arguments[argument_index] <- true
                    for capture_index in 0..<candidate.captures.count |candidate_capture_mutations, state, table, call_marker|:
                        capture: Ast::Expr = candidate.captures[capture_index]
                        table <- ga_callback_handoff(call_marker, capture, state, table) can Global{Read,Write}
                        table <- ga_write_place(capture, state, table) can Global{Read,Write} if candidate_capture_mutations[capture_index]
                        ga_mark_aggregate_origin_unknown_if_mutated(capture, state) if candidate_capture_mutations[capture_index]
                if candidates.count == 0 or resolved_candidates == 0:
                    need_read <- true
                    need_write <- true
                    for argument_index in 0..<mutates_arguments.count |mutates_arguments|:
                        mutates_arguments[argument_index] <- true
                for argument_index in 0..<arguments.count |state, table, mutates_arguments, argument_names, call_marker|:
                    argument: Ast::Expr = arguments[argument_index]
                    table <- ga_callback_handoff(call_marker, argument, state, table) can Global{Read,Write}
                    table <- ga_write_place(argument, state, table) can Global{Read,Write} if mutates_arguments[argument_index]
                    ga_mark_aggregate_origin_unknown_if_mutated(argument, state) if mutates_arguments[argument_index]
                if not state.report:
                    state.reads[state.function] <- true if need_read and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Read", 0, state)
                    state.writes[state.function] <- true if need_write and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Write", 0, state)
                else:
                    table <- ga_report_call_global_requirements(operation, at, need_read, need_write, state, table) can Global{Read,Write}

        def ga_pattern_bound_names(pattern: Ast::Pattern, origin: Ast::Pos, state: mutable GlobalAuthority&, names: mutable darray[sview]&, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    ga_mark_walk_overflow(origin, state)
                    return
                match pattern:
                    Pattern.Binding(name):
                        names.push(name)
                        _ = ga_push_local_origin_id(state) can Global{Read,Write}
                    Pattern.TypeBind(_, binder):
                        names.push(binder)
                        _ = ga_push_local_origin_id(state) can Global{Read,Write}
                    Pattern.Rest(name):
                        names.push(name)
                        _ = ga_push_local_origin_id(state) can Global{Read,Write}
                    Pattern.As(name, inner):
                        names.push(name)
                        _ = ga_push_local_origin_id(state) can Global{Read,Write}
                        for sub in inner |state, names, origin|:
                            ga_pattern_bound_names(sub, origin, state, names, depth + 1) can Global{Read,Write}
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Field(_, fields) | Pattern.Tuple(fields) | Pattern.Or(fields):
                        for sub in fields |state, names, origin|:
                            ga_pattern_bound_names(sub, origin, state, names, depth + 1) can Global{Read,Write}
                    _:
                        pass

        def ga_pattern_binding_is_whole_value(pattern: Ast::Pattern, target_name: sview, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return false if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        return name == target_name
                    Pattern.As(name, inner):
                        return true if name == target_name
                        return inner.count == 1 and ga_pattern_binding_is_whole_value(inner[0], target_name, depth + 1)
                    Pattern.Or(options):
                        return false if options.count == 0
                        for option in options:
                            return false if not ga_pattern_binding_is_whole_value(option, target_name, depth + 1)
                        return true
                    _:
                        return false

        def ga_type_id_is_reference(type_id: u32, table: SymbolTable&, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return true if interned_kind(type_id, table) == SemTypeKind.Ref
                return false if:
                    depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                    interned_kind(type_id, table) != SemTypeKind.Optional or interned_elem_count(type_id, table) != 1
                return ga_type_id_is_reference(interned_elem(type_id, 0, table), table, depth + 1)

        def ga_type_id_contains_reference(type_id: u32, table: SymbolTable&, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return true if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                kind: SemTypeKind = interned_kind(type_id, table)
                return true if kind == SemTypeKind.Ref
                return false if kind != SemTypeKind.Optional and kind != SemTypeKind.Tuple and kind != SemTypeKind.Container
                for element_index in 0..<interned_elem_count(type_id, table):
                    return true if ga_type_id_contains_reference(interned_elem(type_id, element_index, table), table, depth + 1)
                return false

        # Reconstruct only the type-expression shapes this pass needs to recognize a
        # reference and resolve a simple named pointee. Unsupported structural forms stay
        # absent; their binder origin still fails closed when it is known to be reference.
        def ga_type_id_expression(type_id: u32, at: Ast::Pos, table: SymbolTable&, depth: u32 = 0) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                return null if type_id == 0 or depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                kind: SemTypeKind = interned_kind(type_id, table)
                if kind == SemTypeKind.Ref or kind == SemTypeKind.Optional:
                    return null if interned_elem_count(type_id, table) != 1
                    inner: Ast::Expr? = ga_type_id_expression(interned_elem(type_id, 0, table), at, table, depth + 1)
                    if inner is inner_expression:
                        return Ast::Expr.Unary(TokenKind.Ampersand, inner_expression, at) if kind == SemTypeKind.Ref
                        return Ast::Expr.Unary(TokenKind.Question, inner_expression, at)
                    return null
                return null if:
                    kind != SemTypeKind.Named and kind != SemTypeKind.Int and kind != SemTypeKind.Float and kind != SemTypeKind.Bool and kind != SemTypeKind.Char and kind != SemTypeKind.String and kind != SemTypeKind.Void
                    interned_elem_count(type_id, table) != 0
                type_name: sview = interned_name(type_id, table)
                return null if type_name == ""
                return Ast::Expr.Ident(type_name, at)

        def ga_iteration_binding_type_expression(iterable: Ast::Expr, binding_type_id: u32, binding_count: usize, binding_index: usize, at: Ast::Pos, state: GlobalAuthority&, table: SymbolTable&) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                # A range counter is an integer whatever width the range has; the type
                # tables record no item type for it, and only reference-ness matters here.
                if binding_count == 1 and iterable is Expr.Binary and pag_iteration_binding_kind(iterable, 0, table) == 2:
                    return Ast::Expr.Ident("usize", at)
                if ga_annotation(iterable, state, 0) is iterable_annotation:
                    iterable_type: mutable Ast::Expr = ga_type_alias_result(iterable_annotation, state.module_scope, state, 0)
                    while true |iterable_type|:
                        match iterable_type:
                            Expr.Unary(operator, inner, _):
                                if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                                    iterable_type <- inner
                                else:
                                    break
                            _:
                                break
                    match iterable_type:
                        Expr.Index(_, element_type, _):
                            return element_type if binding_count == 1 and ga_builtin_collection(iterable_type, state, 0)
                        Expr.IndexN(_, type_arguments, _):
                            if ga_builtin_collection(iterable_type, state, 0):
                                return type_arguments[0] if binding_count == 1 and type_arguments.count == 1
                                return type_arguments[binding_index] if binding_count == type_arguments.count and binding_index < type_arguments.count
                        _:
                            pass
                return ga_type_id_expression(binding_type_id, at, table)

        def ga_pattern_binding_metadata(pattern: Ast::Pattern, subject: Ast::Expr, subject_type_id: u32, subject_type_expression: Ast::Expr?, target_name: sview, at: Ast::Pos, state: mutable GlobalAuthority&, table: SymbolTable&) -> (type_expression: Ast::Expr?, global_origin: usize, type_scope: usize):
            can Memory.Allocate, Abort.Panic:
                whole_value: bool = ga_pattern_binding_is_whole_value(pattern, target_name)
                binding_type_id: u32 = pag_pattern_binding_type_id(pattern, subject_type_id, target_name, table)
                type_expression: mutable Ast::Expr? = subject_type_expression if whole_value else null
                type_expression <- ga_type_id_expression(binding_type_id, at, table) if type_expression is absent
                is_reference: bool = ga_type_id_is_reference(binding_type_id, table) or (binding_type_id == 0 and whole_value and ga_expression_is_reference(subject, state, 0))
                contains_reference: mutable bool = ga_type_id_contains_reference(binding_type_id, table) or is_reference
                if type_expression is binding_type_expression:
                    contains_reference <- contains_reference or ga_type_expression_contains_reference(binding_type_expression, state, 0)
                source_origin: usize = ga_reference_origin(subject, state, 0) if contains_reference else GLOBAL_AUTHORITY_NONE
                global_origin: mutable usize = SemanticGlobalAuthorityOrigin::pattern_binding_origin(
                    contains_reference,
                    source_origin
                )
                # A subject with no origin is not a global place and no recorded alias, so
                # what its binders reach is detached storage (stage0's creation rule).
                global_origin <- GLOBAL_AUTHORITY_LOCAL_ALIAS if contains_reference and source_origin == GLOBAL_AUTHORITY_NONE
                type_scope: usize = ga_expression_type_scope(subject, state, 0)
                return (type_expression, global_origin, type_scope)

        def ga_arms_inner(subject: Ast::Expr, subject_type_id: u32, subject_type_expression: Ast::Expr?, arms: darray[Ast::MatchArm], state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in arms |state, table| -> table:
                    mark: usize = state.locals.count
                    ga_pattern_bound_names(arm.pattern, arm.pos, state, state.locals) can Global{Read,Write}
                    binding_index: mutable usize = mark
                    while binding_index < state.locals.count |binding_index, arm, subject, subject_type_id, subject_type_expression, state, table|:
                        binding: sview = state.locals[binding_index]
                        metadata: (type_expression: Ast::Expr?, global_origin: usize, type_scope: usize) = ga_pattern_binding_metadata(arm.pattern, subject, subject_type_id, subject_type_expression, binding, arm.pos, state, table) can Global{Read,Write}
                        state.local_types.push(metadata.type_expression)
                        state.local_type_scopes.push(metadata.type_scope)
                        state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                        state.local_global_origins.push(metadata.global_origin)
                        binding_index <- binding_index + 1
                    table <- ga_expression(arm.guard, state, table) can Global{Read,Write}
                    table <- ga_body(arm.body, state, table) can Global{Read,Write}
                    state.locals.truncate(mark)
                    state.local_origin_ids.truncate(mark)
                    state.local_types.truncate(mark)
                    state.local_type_scopes.truncate(mark)
                    state.local_callees.truncate(mark)
                    state.local_global_origins.truncate(mark)

        def ga_arms(subject: Ast::Expr, arms: darray[Ast::MatchArm], state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                at: Ast::Pos = arms[0].pos if arms.count > 0 else ga_position_value(0, 0, 0, 0, 0, 0)
                if not ga_walk_enter(at, state):
                    return
                subject_type_id: u32 = pag_structural_type_id(subject, table)
                subject_type_expression: Ast::Expr? = ga_annotation(subject, state, 0)
                table <- ga_arms_inner(subject, subject_type_id, subject_type_expression, arms, state, table) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_condition_origin_inner(condition: Ast::Expr, binder: sview, state: mutable GlobalAuthority&) -> Ast::Expr?:
            match condition:
                Expr.Paren(inner, _):
                    return ga_condition_origin(inner, binder, state)
                Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Is or operator == TokenKind.As:
                        return left if right is Expr.Ident(name, _) and name == binder
                    elif operator == TokenKind.And or operator == TokenKind.Or:
                        if ga_condition_origin(left, binder, state) is origin:
                            return origin
                        return ga_condition_origin(right, binder, state)
                _:
                    pass
            return null

        def ga_condition_origin(condition: Ast::Expr, binder: sview, state: mutable GlobalAuthority&) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(condition), state):
                    return null
                result: Ast::Expr? = ga_condition_origin_inner(condition, binder, state)
                state.walk_depth <- state.walk_depth - 1
                return result

        def ga_gather_is_target_inner(expression: Ast::Expr, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        bound.push(name)
                    Expr.Call(_, arguments, _, _) | Expr.Array(arguments, _):
                        for argument in arguments |state, bound|:
                            ga_gather_is_target(argument, state, bound) can Global{Read,Write}
                    Expr.Construct(_, fields, _):
                        for field in fields |state, bound|:
                            ga_gather_is_target(field.value, state, bound) can Global{Read,Write}
                    _:
                        pass

        def ga_gather_is_target(expression: Ast::Expr, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                ga_gather_is_target_inner(expression, state, bound) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_gather_is_variant_aliases_inner(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(alias_left, alias_operator, alias_right, _):
                        ga_gather_is_variant_aliases(alias_left, table, state, bound) can Global{Read,Write}
                        if alias_operator == TokenKind.Is:
                            match alias_right:
                                Expr.Field(_, _, alias_variant_line):
                                    paired: usize = min(table.is_variant_alias_lines.count, table.is_variant_alias_names.count)
                                    for probe in 0..<paired |bound, table, alias_variant_line|:
                                        bound.push(table.is_variant_alias_names[probe]) if table.is_variant_alias_lines[probe].i64() == alias_variant_line.line
                                _:
                                    ga_gather_is_variant_aliases(alias_right, table, state, bound) can Global{Read,Write}
                        else:
                            ga_gather_is_variant_aliases(alias_right, table, state, bound) can Global{Read,Write}
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _):
                        ga_gather_is_variant_aliases(operand, table, state, bound) can Global{Read,Write}
                    _:
                        pass

        def ga_gather_is_variant_aliases(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                ga_gather_is_variant_aliases_inner(expression, table, state, bound) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_gather_truthy_condition_bindings_inner(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, _):
                        ga_gather_truthy_condition_bindings(inner, table, state, bound) can Global{Read,Write}
                    Expr.Binary(left, operator, right, _):
                        match operator:
                            TokenKind.And:
                                ga_gather_truthy_condition_bindings(left, table, state, bound) can Global{Read,Write}
                                ga_gather_truthy_condition_bindings(right, table, state, bound) can Global{Read,Write}
                            TokenKind.Or:
                                left_names: mutable darray[sview] = []
                                right_names: mutable darray[sview] = []
                                ga_gather_truthy_condition_bindings(left, table, state, left_names) can Global{Read,Write}
                                ga_gather_truthy_condition_bindings(right, table, state, right_names) can Global{Read,Write}
                                for candidate in left_names |bound, right_names|:
                                    bound.push(candidate) if any other in right_names where other == candidate
                            TokenKind.Is | TokenKind.As:
                                ga_gather_is_target(right, state, bound) can Global{Read,Write}
                                ga_gather_is_variant_aliases(expression, table, state, bound) can Global{Read,Write}
                            _:
                                pass
                    _:
                        pass

        def ga_gather_truthy_condition_bindings(expression: Ast::Expr, table: SymbolTable&, state: mutable GlobalAuthority&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                ga_gather_truthy_condition_bindings_inner(expression, table, state, bound) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_condition_bindings(condition: Ast::Expr, state: mutable GlobalAuthority&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                ga_gather_truthy_condition_bindings(condition, table, state, names) can Global{Read,Write}
                for name in names |state|:
                    type_expression: mutable Ast::Expr? = null
                    callback: mutable usize = GLOBAL_AUTHORITY_NONE
                    alias_origin: mutable usize = GLOBAL_AUTHORITY_NONE
                    type_scope: mutable usize = GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                    if ga_condition_origin(condition, name, state) is origin:
                        type_expression <- ga_annotation(origin, state, 0)
                        type_scope <- ga_expression_type_scope(origin, state, 0)
                        callback <- ga_callee_slot(origin, state) can Global{Read,Write}
                        alias_origin <- ga_local_reference_binding_origin(type_expression, origin, state)
                    state.locals.push(name)
                    _ = ga_push_local_origin_id(state) can Global{Read,Write}
                    state.local_types.push(type_expression)
                    state.local_type_scopes.push(type_scope)
                    state.local_callees.push(callback if callback < state.functions.count else GLOBAL_AUTHORITY_NONE)
                    state.local_global_origins.push(alias_origin)

        def ga_expression_inner(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                at: Ast::Pos = Ast::expr_pos(expression)
                while next_index > 0 |next_index: usize = ga_inline_limit(at.offset, state), state|:
                    index: usize = next_index - 1
                    next_index <- index
                    break if state.inline_prefix_ends[index] <= at.offset
                    span: Ast::Pos = state.inline_spans[index]
                    if at.offset >= span.offset and at.offset < span.end_offset:
                        grant: sview = state.inline_refs[index]
                        if not state.report:
                            if not ga_refs_cover(state.firewalls, state.firewall_scopes, grant, state.inline_scopes[index], state):
                                _ = ga_row_add(state.function, grant, true, state, state.inline_scopes[index]) can Global{Read,Write}
                            state.reads[state.function] <- true if ga_ref_covers(grant, "Global.Read", state.inline_scopes[index], 0, state, 0) and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Read", 0, state)
                            state.writes[state.function] <- true if ga_ref_covers(grant, "Global.Write", state.inline_scopes[index], 0, state, 0) and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Write", 0, state)
                match expression:
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        table <- ga_access(expression, false, state, table) can Global{Read,Write}
                    Expr.Unary(operator, operand, _):
                        table <- ga_expression(operand, state, table) can Global{Read,Write}
                        table <- ga_write_place(operand, state, table) can Global{Read,Write} if operator == TokenKind.Mutable
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- ga_expression(operand, state, table) can Global{Read,Write}
                    Expr.Field(base, _, _):
                        if ga_place_global(expression, state) < state.globals.count and ga_global_path_mutable(expression, state, 0):
                            table <- ga_access(expression, false, state, table) can Global{Read,Write}
                        else:
                            alias_origin: usize = ga_reference_path_origin(expression, state, 0)
                            if alias_origin < state.globals.count and (state.writable[alias_origin] or ga_global_path_mutable(expression, state, 0)):
                                table <- ga_access_slot(alias_origin, Ast::expr_pos(expression), false, true, state, table) can Global{Read,Write}
                            elif ga_expression_is_reference(expression, state, 0):
                                table <- ga_access(expression, false, state, table) can Global{Read,Write}
                            else:
                                table <- ga_expression(base, state, table) can Global{Read,Write}
                    Expr.Binary(left, operator, right, _):
                        table <- ga_expression(left, state, table) can Global{Read,Write}
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            mark: usize = state.locals.count
                            ga_condition_bindings(left, state, table) can Global{Read,Write} if operator == TokenKind.And
                            table <- ga_expression(right, state, table) can Global{Read,Write}
                            state.locals.truncate(mark)
                            state.local_origin_ids.truncate(mark)
                            state.local_types.truncate(mark)
                            state.local_type_scopes.truncate(mark)
                            state.local_callees.truncate(mark)
                            state.local_global_origins.truncate(mark)
                    Expr.Index(left, right, _) | Expr.Refinement(left, right, _):
                        # `x.cast[T]` reads x and names a type (see ga_cast_operand).
                        if ga_cast_operand(expression) is cast_operand:
                            table <- ga_expression(cast_operand, state, table) can Global{Read,Write}
                        else:
                            table <- ga_expression(left, state, table) can Global{Read,Write}
                            table <- ga_expression(right, state, table) can Global{Read,Write}
                    Expr.Slice(base, low, high, _):
                        table <- ga_expression(base, state, table) can Global{Read,Write}
                        table <- ga_expression(low, state, table) can Global{Read,Write}
                        table <- ga_expression(high, state, table) can Global{Read,Write}
                    Expr.IndexN(base, arguments, _):
                        table <- ga_expression(base, state, table) can Global{Read,Write}
                        for argument in arguments |state, table| -> table:
                            table <- ga_expression(argument, state, table) can Global{Read,Write}
                    Expr.Call(callee, arguments, argument_names, _):
                        conversion: bool = arguments.count == 0 and argument_names.count == 0 and ga_target_conversion(callee, state)
                        callable: Ast::Expr = ga_postfix_callee(ga_callable_core(callee)) if conversion else ga_callable_core(callee)
                        call_arguments: mutable darray[Ast::Expr] @source = arguments
                        call_labels: mutable darray[sview @source] @source = argument_names
                        receiver_count: mutable usize = 0
                        match callable:
                            Expr.Field(base, _, _):
                                method_arguments: mutable darray[Ast::Expr] @source = [base]
                                method_labels: mutable darray[sview @source] @source = [""]
                                method_arguments.extend(arguments)
                                method_labels.extend(argument_names)
                                call_arguments <- method_arguments
                                call_labels <- method_labels
                                receiver_count <- 1
                            _:
                                pass
                        resolved_head: mutable usize = GLOBAL_AUTHORITY_NONE
                        resolved_head_stable: mutable bool = false
                        table <- ga_call(callee, call_arguments, call_labels, state, table, resolved_head, resolved_head_stable, conversion) can Global{Read,Write}
                        reuse_head: mutable bool = false
                        match callable:
                            Expr.Ident(_, _) | Expr.Scope(_, _, _):
                                reuse_head <- not conversion and resolved_head_stable
                            _:
                                pass
                        call_head: usize = resolved_head if reuse_head else ga_callee_slot(callee, state, 0, conversion) can Global{Read,Write}
                        # Default-argument analysis above can mutate callable rows without
                        # changing their count. Re-select after it so callback and mutation
                        # checks see the current candidates; only the stable name-chain head
                        # is reused.
                        call_slot: usize = ga_select_function(call_head, call_arguments, call_labels, state, receiver_count == 1)
                        match callable:
                            Expr.Field(base, method, _):
                                mutation_receiver: Ast::Expr = ga_collection_mutation_receiver(base, method)
                                builtin_mutates: bool = ga_mutating_collection(mutation_receiver, method, state)
                                mutates: mutable bool = builtin_mutates
                                opaque_mutates: mutable bool = false
                                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(call_slot, state), mutates|:
                                    candidate: usize = next_candidate
                                    next_candidate <- state.function_next[candidate]
                                    candidate_mutates: bool = ga_candidate_selected(candidate, call_slot, call_arguments, call_labels, state, receiver_count == 1) and ga_argument_mutates(candidate, 0, "", state)
                                    mutates <- true if candidate_mutates
                                    opaque_mutates <- true if candidate_mutates
                                table <- ga_expression(base, state, table) can Global{Read,Write}
                                table <- ga_write_place(mutation_receiver, state, table) can Global{Read,Write} if mutates
                                if mutates:
                                    if builtin_mutates and not opaque_mutates:
                                        for argument in arguments |mutation_receiver, state|:
                                            _ = ga_join_aggregate_reference_origin(mutation_receiver, argument, state) can Global{Read,Write}
                                    else:
                                        ga_mark_aggregate_origin_unknown_if_mutated(mutation_receiver, state)
                            _:
                                table <- ga_expression(callable, state, table) can Global{Read,Write}
                        for index in 0..<arguments.count |state, table| -> table:
                            argument: Ast::Expr = arguments[index]
                            label: sview = argument_names[index] if index < argument_names.count else sview("", 0, 0)
                            mutates: mutable bool = false
                            while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(call_slot, state), mutates|:
                                candidate: usize = next_candidate
                                next_candidate <- state.function_next[candidate]
                                mutates <- true if ga_candidate_selected(candidate, call_slot, call_arguments, call_labels, state, receiver_count == 1) and ga_argument_mutates(candidate, index + receiver_count, label, state)
                            table <- ga_expression(argument, state, table) can Global{Read,Write}
                            table <- ga_callback_handoff(callable, argument, state, table) can Global{Read,Write}
                            table <- ga_write_place(argument, state, table) can Global{Read,Write} if mutates
                            ga_mark_aggregate_origin_unknown_if_mutated(argument, state) if mutates
                    Expr.StaticEffectCall(_, operation, candidates, arguments, argument_names, position):
                        table <- ga_static_effect_call(operation, candidates, arguments, argument_names, position, state, table) can Global{Read,Write}
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |state, table| -> table:
                            table <- ga_expression(element, state, table) can Global{Read,Write}
                    Expr.DictLit(entries, _):
                        for entry in entries |state, table| -> table:
                            table <- ga_expression(entry.key, state, table) can Global{Read,Write}
                            table <- ga_expression(entry.value, state, table) can Global{Read,Write}
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        match expression:
                            Expr.RecordUpdate(base, _, _):
                                table <- ga_expression(base, state, table) can Global{Read,Write}
                            _:
                                pass
                        for field in fields |state, table| -> table:
                            table <- ga_expression(field.value, state, table) can Global{Read,Write}
                    Expr.If(condition, then_expression, else_expression, _):
                        table <- ga_expression(condition, state, table) can Global{Read,Write}
                        mark: usize = state.locals.count
                        ga_condition_bindings(condition, state, table) can Global{Read,Write}
                        table <- ga_expression(then_expression, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                        table <- ga_expression(else_expression, state, table) can Global{Read,Write}
                    Expr.Match(value, arms, _) | Expr.Catch(value, arms, _):
                        table <- ga_expression(value, state, table) can Global{Read,Write}
                        table <- ga_arms(value, arms, state, table) can Global{Read,Write}
                    Expr.GetElse(value, recovery, _):
                        table <- ga_expression(value, state, table) can Global{Read,Write}
                        table <- ga_body(recovery, state, table) can Global{Read,Write}
                    Expr.Comprehension(variable, iterable, condition, body, _, query_scope_id):
                        table <- ga_expression(iterable, state, table) can Global{Read,Write}
                        mark: usize = state.locals.count
                        # Resolve all metadata from the enclosing scope before any
                        # comprehension binder can shadow a name used by `iterable` or
                        # by another binder's inferred type.
                        iterable_type_scope: usize = ga_expression_type_scope(iterable, state, 0)
                        iterable_origin: usize = ga_reference_origin(iterable, state, 0)
                        item_type_id: u32 = pag_iteration_item_type_id(iterable, table)
                        query_binder_limit: usize = table.query_binder_offsets.count if table.query_binder_offsets.count < table.query_binder_names.count else table.query_binder_names.count
                        extra_binder_count: mutable usize = 0
                        for query_binder_index in 0..<query_binder_limit |extra_binder_count|:
                            extra_binder_count <- extra_binder_count + 1 if query_scope_id != 0 and Ast::query_scope_id_from_offset(table.query_binder_offsets[query_binder_index]) == query_scope_id
                        binding_count: usize = extra_binder_count + 1
                        binding_type_id: u32 = pag_iteration_binding_type_id(iterable, item_type_id, binding_count, 0, table)
                        binding_type_expression: Ast::Expr? = ga_iteration_binding_type_expression(iterable, binding_type_id, binding_count, 0, Ast::expr_pos(iterable), state, table)
                        binding_has_references: mutable bool = ga_type_id_contains_reference(binding_type_id, table)
                        if binding_type_expression is item_type_expression:
                            binding_has_references <- true if ga_type_expression_contains_reference(item_type_expression, state, 0)
                        extra_binder_names: mutable darray[sview] = []
                        extra_binding_type_expressions: mutable darray[Ast::Expr?] = []
                        extra_binding_has_references: mutable darray[bool] = []
                        query_binder_index: mutable usize = 0
                        binding_index: mutable usize = 1
                        while query_binder_index < query_binder_limit |query_binder_index, binding_index, state|:
                            if query_scope_id != 0 and Ast::query_scope_id_from_offset(table.query_binder_offsets[query_binder_index]) == query_scope_id:
                                extra_type_id: u32 = pag_iteration_binding_type_id(iterable, item_type_id, binding_count, binding_index, table)
                                extra_type_expression: Ast::Expr? = ga_iteration_binding_type_expression(iterable, extra_type_id, binding_count, binding_index, Ast::expr_pos(iterable), state, table)
                                extra_has_references: mutable bool = ga_type_id_contains_reference(extra_type_id, table)
                                if extra_type_expression is extra_item_type_expression:
                                    extra_has_references <- true if ga_type_expression_contains_reference(extra_item_type_expression, state, 0)
                                extra_binder_names.push(table.query_binder_names[query_binder_index])
                                extra_binding_type_expressions.push(extra_type_expression)
                                extra_binding_has_references.push(extra_has_references)
                                binding_index <- binding_index + 1
                            query_binder_index <- query_binder_index + 1
                        state.locals.push(variable)
                        _ = ga_push_local_origin_id(state) can Global{Read,Write}
                        state.local_types.push(binding_type_expression)
                        state.local_type_scopes.push(iterable_type_scope)
                        state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                        state.local_global_origins.push(SemanticGlobalAuthorityOrigin::pattern_binding_origin(binding_has_references, iterable_origin))
                        for extra_index in 0..<extra_binder_names.count |extra_binder_names, extra_binding_type_expressions, extra_binding_has_references, iterable_type_scope, iterable_origin, state|:
                            state.locals.push(extra_binder_names[extra_index])
                            _ = ga_push_local_origin_id(state) can Global{Read,Write}
                            state.local_types.push(extra_binding_type_expressions[extra_index])
                            state.local_type_scopes.push(iterable_type_scope)
                            state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                            state.local_global_origins.push(SemanticGlobalAuthorityOrigin::pattern_binding_origin(extra_binding_has_references[extra_index], iterable_origin))
                        table <- ga_expression(condition, state, table) can Global{Read,Write}
                        table <- ga_expression(body, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                    Expr.Lambda(parameters, body, at):
                        mark: usize = state.locals.count
                        enclosing_function: usize = state.function
                        lambda_slot: mutable usize = ga_callee_slot(expression, state) can Global{Read,Write}
                        if lambda_slot == state.functions.count:
                            state.function_next.push(GLOBAL_AUTHORITY_NONE)
                            state.functions.push("")
                            state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                            state.function_scopes.push(state.module_scope)
                            state.function_offsets.push(at.offset)
                            state.function_lines.push(0)
                            state.function_variadic.push(false)
                            state.function_return_types.push(null)
                            state.parameter_starts.push(state.parameter_functions.count)
                            state.parameter_counts.push(parameters.count)
                            state.parameter_minimum.push(parameters.count)
                            state.reads.push(false)
                            state.writes.push(false)
                        state.function <- lambda_slot
                        state.lambda_depth <- state.lambda_depth + 1
                        for parameter in parameters:
                            state.locals.push(parameter)
                            _ = ga_push_local_origin_id(state) can Global{Read,Write}
                            state.local_types.push(null)
                            state.local_type_scopes.push(GLOBAL_AUTHORITY_UNKNOWN_ALIAS)
                            state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                            state.local_global_origins.push(GLOBAL_AUTHORITY_NONE)
                        table <- ga_body(body, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                        state.function <- enclosing_function
                        state.lambda_depth <- state.lambda_depth - 1
                    Expr.Block(statements, value, _, _):
                        mark: usize = state.locals.count
                        table <- ga_statements(statements, state, table) can Global{Read,Write}
                        table <- ga_expression(value, state, table) can Global{Read,Write}
                        state.locals.truncate(mark)
                        state.local_origin_ids.truncate(mark)
                        state.local_types.truncate(mark)
                        state.local_type_scopes.truncate(mark)
                        state.local_callees.truncate(mark)
                        state.local_global_origins.truncate(mark)
                    _:
                        pass

        def ga_expression(expression: Ast::Expr, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if not ga_walk_enter(Ast::expr_pos(expression), state):
                    return
                table <- ga_expression_inner(expression, state, table) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        # Origin edges retain callable shape facts separately from propagated rows.
        def ga_callback_origin_index_ready(state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                return state.callback_origin_indexed and state.callback_origin_next.count == state.callback_origin_from.count and state.callback_origin_to.count == state.callback_origin_from.count

        def ga_callback_origin_head(parent: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return head if state.callback_origin_heads.get(parent) is head else GLOBAL_AUTHORITY_NONE

        # Rebuild only if a caller supplied pre-existing origin rows without their
        # append-only index. Normal inference keeps the arrays synchronized in
        # ga_callback_origin; readers retain a linear fallback for incomplete states.
        def ga_index_callback_origins(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                state.callback_origin_indexed <- false
                return if state.callback_origin_from.count != state.callback_origin_to.count
                state.callback_origin_heads <- {}
                state.callback_origin_tails <- {}
                state.callback_origin_next <- []
                for edge in 0..<state.callback_origin_from.count |edge, state|:
                    parent: usize = state.callback_origin_from[edge]
                    last_edge: usize = previous_edge_value if state.callback_origin_tails.get(parent) is previous_edge_value else GLOBAL_AUTHORITY_NONE
                    state.callback_origin_next.push(GLOBAL_AUTHORITY_NONE)
                    if last_edge < edge:
                        state.callback_origin_next[last_edge] <- edge
                    else:
                        state.callback_origin_heads <- state.callback_origin_heads.put(parent, edge) can Global{Read,Write}
                    state.callback_origin_tails <- state.callback_origin_tails.put(parent, edge) can Global{Read,Write}
                state.callback_origin_indexed <- true

        def ga_callback_origin(parent: usize, child: usize, state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if parent >= state.functions.count or child >= state.functions.count or parent == child
                ga_index_callback_origins(state) can Global{Read,Write} if not ga_callback_origin_index_ready(state)
                if ga_callback_origin_index_ready(state):
                    edge: mutable usize = ga_callback_origin_head(parent, state)
                    while edge < state.callback_origin_from.count |edge, parent, child, state|:
                        return if state.callback_origin_from[edge] == parent and state.callback_origin_to[edge] == child
                        edge <- state.callback_origin_next[edge]
                else:
                    for edge in 0..<state.callback_origin_from.count:
                        return if state.callback_origin_from[edge] == parent and state.callback_origin_to[edge] == child
                edge: usize = state.callback_origin_from.count
                index_new_edge: bool = ga_callback_origin_index_ready(state)
                state.callback_origin_from.push(parent)
                state.callback_origin_to.push(child)
                if index_new_edge:
                    state.callback_origin_next.push(GLOBAL_AUTHORITY_NONE)
                    last_edge: usize = previous_edge_value if state.callback_origin_tails.get(parent) is previous_edge_value else GLOBAL_AUTHORITY_NONE
                    if last_edge < edge:
                        state.callback_origin_next[last_edge] <- edge
                    else:
                        state.callback_origin_heads <- state.callback_origin_heads.put(parent, edge) can Global{Read,Write}
                    state.callback_origin_tails <- state.callback_origin_tails.put(parent, edge) can Global{Read,Write}
                ga_edge_rows(parent, child, state, false) can Global{Read,Write}
                state.edge_from.push(parent)
                state.edge_to.push(child)
                state.edge_reads.push(true)
                state.edge_writes.push(true)

        # Prepublish a fail-closed callable for bounded graph traversal failures.
        def ga_unknown_callback(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if state.unknown_callback_slot < state.functions.count
                slot: usize = state.functions.count
                state.unknown_callback_slot <- slot
                state.function_next.push(GLOBAL_AUTHORITY_NONE)
                state.functions.push("")
                state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                state.function_scopes.push(0)
                state.function_offsets.push(0)
                state.function_lines.push(0)
                state.function_variadic.push(true)
                state.function_return_types.push(null)
                state.parameter_starts.push(state.parameter_types.count)
                state.parameter_counts.push(0)
                state.parameter_minimum.push(0)
                state.reads.push(true)
                state.writes.push(true)
                _ = ga_row_add(slot, "Global.Read", true, state, 0) can Global{Read,Write}
                _ = ga_row_add(slot, "Global.Write", true, state, 0) can Global{Read,Write}
                _ = ga_row_add(slot, "Unsafe", true, state, 0) can Global{Read,Write}

        # Cache keys distinguish invocation layers at one source expression. A union
        # exposes no first-only return annotation or parameter-based viability filter.
        def ga_join_callback(first: usize, second: usize, at: Ast::Pos, state: mutable GlobalAuthority&, owner: usize = GLOBAL_AUTHORITY_NONE, force_union: bool = false) -> usize:
            can Memory.Allocate, Abort.Panic:
                return second if first >= state.functions.count
                return first if second >= state.functions.count or (first == second and not force_union)
                joined: mutable usize = state.functions.count
                for index in 0..<state.callback_join_slots.count |joined|:
                    joined <- state.callback_join_slots[index] if state.callback_join_offsets[index] == at.offset and state.callback_join_scopes[index] == state.module_scope and state.callback_join_owners[index] == owner
                if joined == state.functions.count:
                    state.function_next.push(GLOBAL_AUTHORITY_NONE)
                    state.functions.push("")
                    state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                    state.function_scopes.push(state.module_scope)
                    state.function_offsets.push(at.offset)
                    state.function_lines.push(0)
                    state.function_variadic.push(true)
                    state.function_return_types.push(null)
                    state.parameter_starts.push(state.parameter_types.count)
                    state.parameter_counts.push(0)
                    state.parameter_minimum.push(0)
                    state.reads.push(false)
                    state.writes.push(false)
                    state.callback_join_slots.push(joined)
                    state.callback_join_owners.push(owner)
                    state.callback_join_offsets.push(at.offset)
                    state.callback_join_scopes.push(state.module_scope)
                if not state.report:
                    ga_callback_origin(joined, first, state) can Global{Read,Write}
                    ga_callback_origin(joined, second, state) can Global{Read,Write}
                return joined

        # The return of a callable union retains every child's future capability;
        # constructing that union does not charge the child's execution effects.
        # A stable result proxy can be referenced before a forward factory's body
        # reveals its concrete origins. Execution and future capability stay separate.
        def ga_callback_return_slot(slot: usize, at: Ast::Pos, state: mutable GlobalAuthority&, depth: u32 = 0) -> usize:
            can Memory.Allocate, Abort.Panic:
                return state.unknown_callback_slot if depth > 32 or slot == state.unknown_callback_slot
                return GLOBAL_AUTHORITY_NONE if slot >= state.functions.count
                # A scalar-returning call cannot be a function-valued argument. Creating
                # callback-result proxies for these calls poisons unrelated effect rows
                # when the proxy graph reaches the conservative unknown callback.
                if slot < state.function_return_types.count and state.functions[slot] != "":
                    if state.function_return_types[slot] is declared_return:
                        return GLOBAL_AUTHORITY_NONE if ga_builtin_unshadowed(declared_return, state.function_scopes[slot], state)
                        return GLOBAL_AUTHORITY_NONE if ga_exact_void_return(declared_return)
                if slot < state.returned_callees.count:
                    mapped: usize = state.returned_callees[slot]
                    return mapped if mapped < state.functions.count
                for index in 0..<state.callback_result_sources.count:
                    return state.callback_result_slots[index] if state.callback_result_sources[index] == slot
                return state.unknown_callback_slot if state.report
                result: usize = state.functions.count
                state.function_next.push(GLOBAL_AUTHORITY_NONE)
                state.functions.push("")
                state.effect_row_heads.push(GLOBAL_AUTHORITY_NONE)
                state.function_scopes.push(state.module_scope)
                state.function_offsets.push(at.offset)
                state.function_lines.push(0)
                state.function_variadic.push(true)
                state.function_return_types.push(null)
                state.parameter_starts.push(state.parameter_types.count)
                state.parameter_counts.push(0)
                state.parameter_minimum.push(0)
                state.reads.push(false)
                state.writes.push(false)
                state.callback_result_sources.push(slot)
                state.callback_result_slots.push(result)
                return result

        def ga_resolve_callback_results(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                changed: mutable bool = true
                rounds: mutable usize = 0
                while changed and rounds < 32 |state, changed, rounds|:
                    changed <- false
                    rounds <- rounds + 1
                    old_requests: usize = state.callback_result_sources.count
                    old_edges: usize = state.callback_origin_from.count
                    for index in 0..<old_requests |state|:
                        source: usize = state.callback_result_sources[index]
                        result: usize = state.callback_result_slots[index]
                        origin_count: usize = state.callback_origin_from.count
                        if ga_callback_origin_index_ready(state):
                            edge: mutable usize = ga_callback_origin_head(source, state)
                            while edge < origin_count |edge, origin_count, source, result, state|:
                                if state.callback_origin_from[edge] == source:
                                    child: usize = state.callback_origin_to[edge]
                                    child_result: usize = ga_callback_return_slot(child, ga_position_value(0, 0, 0, 0, 0, 0), state)
                                    ga_callback_origin(result, child_result, state) can Global{Read,Write}
                                edge <- state.callback_origin_next[edge]
                        else:
                            for edge in 0..<origin_count |state|:
                                continue if state.callback_origin_from[edge] != source
                                child: usize = state.callback_origin_to[edge]
                                child_result: usize = ga_callback_return_slot(child, ga_position_value(0, 0, 0, 0, 0, 0), state)
                                ga_callback_origin(result, child_result, state) can Global{Read,Write}
                    changed <- old_requests != state.callback_result_sources.count or old_edges != state.callback_origin_from.count
                if changed:
                    result_count: usize = state.callback_result_slots.count
                    for index in 0..<result_count |state|:
                        result: usize = state.callback_result_slots[index]
                        ga_callback_origin(result, state.unknown_callback_slot, state) can Global{Read,Write}


        def ga_statements_inner(statements: darray[Ast::Stmt], state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |state, table| -> table:
                    match statement:
                        Stmt.Expr(expression, _) | Stmt.Contract(_, expression, _):
                            table <- ga_expression(expression, state, table) can Global{Read,Write}
                        Stmt.VarDecl(name, type_expression, value, _):
                            table <- ga_expression(value, state, table) can Global{Read,Write}
                            table <- ga_write_place(value, state, table) can Global{Read,Write} if ga_mutable_parameter(type_expression, state, 0)
                            table <- ga_write_place(value, state, table) can Global{Read,Write} if (type_expression is Expr.Absent or type_expression is Expr.Invalid) and ga_inferred_writable(value, state)
                            callback: usize = ga_callee_slot(value, state) can Global{Read,Write}
                            inferred_type: Ast::Expr? = ga_annotation(value, state, 0) if type_expression is Expr.Absent or type_expression is Expr.Invalid else type_expression
                            binding_origin: usize = ga_local_reference_binding_origin(inferred_type, value, state)
                            binding_type_scope: usize = ga_type_scope(type_expression, state) if type_expression is not Expr.Absent and type_expression is not Expr.Invalid else ga_expression_type_scope(value, state, 0)
                            ga_record_mutable_global_borrow(value, inferred_type, state, table) can Global{Read,Write}
                            # Storing a mutable global alias inside an aggregate creates it here.
                            ga_record_mutable_global_escape(value, inferred_type, state, table) can Global{Read,Write}
                            state.locals.push(name)
                            _ = ga_push_local_origin_id(state) can Global{Read,Write}
                            state.local_types.push(inferred_type)
                            state.local_type_scopes.push(binding_type_scope)
                            state.local_callees.push(callback if callback < state.functions.count else GLOBAL_AUTHORITY_NONE)
                            state.local_global_origins.push(binding_origin)
                        Stmt.Assign(target, operator, value, _):
                            table <- ga_expression(value, state, table) can Global{Read,Write}
                            if operator == TokenKind.Assign and target is Expr.Ident(binding_name, _):
                                callback: usize = ga_callee_slot(value, state) can Global{Read,Write}
                                inferred_type: Ast::Expr? = ga_annotation(value, state, 0)
                                binding_origin: usize = ga_local_reference_binding_origin(inferred_type, value, state)
                                binding_type_scope: usize = ga_expression_type_scope(value, state, 0)
                                table <- ga_write_place(value, state, table) can Global{Read,Write} if ga_inferred_writable(value, state)
                                ga_record_mutable_global_borrow(value, inferred_type, state, table) can Global{Read,Write}
                                # Storing a mutable global alias inside an aggregate creates it here.
                                ga_record_mutable_global_escape(value, inferred_type, state, table) can Global{Read,Write}
                                state.locals.push(binding_name)
                                _ = ga_push_local_origin_id(state) can Global{Read,Write}
                                state.local_types.push(inferred_type)
                                state.local_type_scopes.push(binding_type_scope)
                                state.local_callees.push(callback if callback < state.functions.count else GLOBAL_AUTHORITY_NONE)
                                state.local_global_origins.push(binding_origin)
                            else:
                                reference_rebind: bool = ga_reference_rebind(target, table)
                                if reference_rebind:
                                    origin: usize = ga_update_reference_origin(target, value, state)
                                    if ga_annotation(target, state, 0) is target_type and ga_mutable_parameter(target_type, state, 0):
                                        if origin < state.globals.count:
                                            table <- ga_access_slot(origin, Ast::expr_pos(value), true, false, state, table) can Global{Read,Write}
                                else:
                                    table <- ga_target(target, gp_is_compound_assign(operator), state, table) can Global{Read,Write}
                                    _ = ga_join_aggregate_reference_origin(target, value, state) can Global{Read,Write}
                                    # Storing a mutable global alias into memory creates it here.
                                    if ga_annotation(target, state, 0) is stored_type:
                                        if ga_mutable_parameter(stored_type, state, 0) or ga_value_contains_mutable_reference(value, stored_type, state, 0):
                                            table <- ga_charge_global_alias_components(value, state, table, 0) can Global{Read,Write}
                                if target is Expr.Ident(binding_name, _):
                                    callback: usize = ga_callee_slot(value, state) can Global{Read,Write}
                                    local_index: mutable usize = state.locals.count
                                    while local_index > 0 |local_index, state|:
                                        local_index <- local_index - 1
                                        if state.locals[local_index] == binding_name:
                                            previous: usize = state.local_callees[local_index]
                                            joined: usize = ga_join_callback(previous, callback, Ast::expr_pos(target), state) can Global{Read,Write}
                                            state.local_callees[local_index] <- joined if joined < state.functions.count else GLOBAL_AUTHORITY_NONE
                                            break
                        Stmt.Return(value, _):
                            if value is returned:
                                ga_record_return_origin(returned, state) if state.summary_walk
                                table <- ga_expression(returned, state, table) can Global{Read,Write} if not ga_returns_reference_local(returned, state)
                                if not state.report and state.function < state.returned_callees.count:
                                    returned_slot: usize = state.returned_callees[state.function]
                                    callback_slot: usize = ga_callee_slot(returned, state) can Global{Read,Write}
                                    if returned_slot < state.functions.count and callback_slot < state.functions.count:
                                        ga_callback_origin(returned_slot, callback_slot, state) can Global{Read,Write}
                                        unique_source: mutable usize = GLOBAL_AUTHORITY_NONE
                                        if ga_callback_origin_index_ready(state):
                                            edge: mutable usize = ga_callback_origin_head(returned_slot, state)
                                            while edge < state.callback_origin_from.count |edge, returned_slot, unique_source, state|:
                                                if state.callback_origin_from[edge] == returned_slot:
                                                    child: usize = state.callback_origin_to[edge]
                                                    if unique_source < state.functions.count and unique_source != child:
                                                        unique_source <- state.functions.count
                                                        break
                                                    unique_source <- child
                                                edge <- state.callback_origin_next[edge]
                                        else:
                                            for edge in 0..<state.callback_origin_from.count |unique_source|:
                                                continue if state.callback_origin_from[edge] != returned_slot
                                                child: usize = state.callback_origin_to[edge]
                                                if unique_source < state.functions.count and unique_source != child:
                                                    unique_source <- state.functions.count
                                                    break
                                                unique_source <- child
                                        retained_type: mutable Ast::Expr? = null
                                        if unique_source < state.functions.count and state.function_return_types[unique_source] is source_type:
                                            retained_type <- source_type if ga_return_portable(source_type, state.function_scopes[unique_source], state, 0)
                                        state.function_return_types[returned_slot] <- retained_type
                                        state.parameter_starts[returned_slot] <- state.parameter_types.count
                                        state.parameter_counts[returned_slot] <- 0
                                        state.parameter_minimum[returned_slot] <- 0
                                        state.function_variadic[returned_slot] <- true
                                if state.lambda_depth == 0 and state.return_type is returned_type:
                                    table <- ga_write_place(returned, state, table) can Global{Read,Write} if ga_mutable_parameter(returned_type, state, 0)
                                else:
                                    table <- ga_write_place(returned, state, table) can Global{Read,Write} if ga_inferred_writable(returned, state)
                                escape_type: Ast::Expr? = state.return_type if state.lambda_depth == 0 else ga_annotation(returned, state, 0)
                                ga_record_mutable_global_escape(returned, escape_type, state, table) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, _):
                            table <- ga_expression(condition, state, table) can Global{Read,Write}
                            mark: usize = state.locals.count
                            ga_condition_bindings(condition, state, table) can Global{Read,Write}
                            table <- ga_body(then_body, state, table) can Global{Read,Write}
                            state.locals.truncate(mark)
                            state.local_origin_ids.truncate(mark)
                            state.local_types.truncate(mark)
                            state.local_type_scopes.truncate(mark)
                            state.local_callees.truncate(mark)
                            state.local_global_origins.truncate(mark)
                            table <- ga_body(else_body, state, table) can Global{Read,Write}
                        Stmt.While(condition, body, _):
                            table <- ga_expression(condition, state, table) can Global{Read,Write}
                            mark: usize = state.locals.count
                            ga_condition_bindings(condition, state, table) can Global{Read,Write}
                            table <- ga_body(body, state, table) can Global{Read,Write}
                            state.locals.truncate(mark)
                            state.local_origin_ids.truncate(mark)
                            state.local_types.truncate(mark)
                            state.local_type_scopes.truncate(mark)
                            state.local_callees.truncate(mark)
                            state.local_global_origins.truncate(mark)
                        Stmt.For(bind, variables, iterable, body, _):
                            table <- ga_expression(iterable, state, table) can Global{Read,Write}
                            table <- ga_target(iterable, true, state, table) can Global{Read,Write} if bind == "mutable"
                            mark: usize = state.locals.count
                            # Capture the iterable's meaning and every binder type in
                            # the surrounding scope before installing loop variables.
                            iterable_type_scope: usize = ga_expression_type_scope(iterable, state, 0)
                            iterable_origin: usize = ga_reference_origin(iterable, state, 0)
                            item_type_id: u32 = pag_iteration_item_type_id(iterable, table)
                            binding_index: mutable usize = 0
                            binding_type_expressions: mutable darray[Ast::Expr?] = []
                            binding_reference_flags: mutable darray[bool] = []
                            while binding_index < variables.count |binding_index, state|:
                                binding_type_id: u32 = pag_iteration_binding_type_id(iterable, item_type_id, variables.count, binding_index, table)
                                binding_type_expression: Ast::Expr? = ga_iteration_binding_type_expression(iterable, binding_type_id, variables.count, binding_index, Ast::expr_pos(iterable), state, table)
                                binding_has_references: mutable bool = ga_type_id_contains_reference(binding_type_id, table)
                                if binding_type_expression is item_type_expression:
                                    binding_has_references <- true if ga_type_expression_contains_reference(item_type_expression, state, 0)
                                binding_type_expressions.push(binding_type_expression)
                                binding_reference_flags.push(binding_has_references)
                                binding_index <- binding_index + 1
                            binding_index <- 0
                            for variable in variables |binding_index, state|:
                                state.locals.push(variable)
                                _ = ga_push_local_origin_id(state) can Global{Read,Write}
                                state.local_types.push(binding_type_expressions[binding_index])
                                state.local_type_scopes.push(iterable_type_scope)
                                state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                                state.local_global_origins.push(SemanticGlobalAuthorityOrigin::pattern_binding_origin(binding_reference_flags[binding_index], iterable_origin))
                                binding_index <- binding_index + 1
                            table <- ga_body(body, state, table) can Global{Read,Write}
                            state.locals.truncate(mark)
                            state.local_origin_ids.truncate(mark)
                            state.local_types.truncate(mark)
                            state.local_type_scopes.truncate(mark)
                            state.local_callees.truncate(mark)
                            state.local_global_origins.truncate(mark)
                        Stmt.Match(value, arms, _):
                            table <- ga_expression(value, state, table) can Global{Read,Write}
                            table <- ga_arms(value, arms, state, table) can Global{Read,Write}
                        Stmt.Block(kind, clause, binding, body, at):
                            if kind == "in" and clause.count > 0:
                                arena_slot: usize = ga_store_slot(clause[0], state)
                                table <- ga_access_slot(arena_slot, at, false, false, state, table) can Global{Read,Write}
                                table <- ga_access_slot(arena_slot, at, true, false, state, table) can Global{Read,Write}
                            locals_mark: usize = state.locals.count
                            grants_mark: usize = state.grants.count
                            trusted_mark: usize = state.firewalls.count
                            if binding != "":
                                state.locals.push(binding)
                                _ = ga_push_local_origin_id(state) can Global{Read,Write}
                                state.local_types.push(null)
                                state.local_type_scopes.push(GLOBAL_AUTHORITY_UNKNOWN_ALIAS)
                                state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                                state.local_global_origins.push(GLOBAL_AUTHORITY_NONE)
                            for grant in clause |state|:
                                if kind == "can" and not state.report:
                                    if not ga_refs_cover(state.firewalls, state.firewall_scopes, grant, state.module_scope, state):
                                        _ = ga_row_add(state.function, grant, true, state) can Global{Read,Write}
                                    state.reads[state.function] <- true if ga_ref_covers(grant, "Global.Read", state.module_scope, 0, state, 0) and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Read", 0, state)
                                    state.writes[state.function] <- true if ga_ref_covers(grant, "Global.Write", state.module_scope, 0, state, 0) and not ga_refs_cover(state.firewalls, state.firewall_scopes, "Global.Write", 0, state)
                                if kind == "can":
                                    state.grants.push(grant)
                                    state.grant_scopes.push(state.module_scope)
                                if kind == "trusted":
                                    ga_trust_unsafe(grant, state.module_scope, at, state)
                            table <- ga_body(body, state, table) can Global{Read,Write}
                            state.locals.truncate(locals_mark)
                            state.local_origin_ids.truncate(locals_mark)
                            state.local_types.truncate(locals_mark)
                            state.local_type_scopes.truncate(locals_mark)
                            state.local_callees.truncate(locals_mark)
                            state.local_global_origins.truncate(locals_mark)
                            state.grants.truncate(grants_mark)
                            state.grant_scopes.truncate(grants_mark)
                            state.firewalls.truncate(trusted_mark)
                            state.firewall_scopes.truncate(trusted_mark)
                        _:
                            pass

        def ga_statements(statements: darray[Ast::Stmt], state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                at: Ast::Pos = ga_statement_position(statements[0]) if statements.count > 0 else ga_position_value(0, 0, 0, 0, 0, 0)
                if not ga_walk_enter(at, state):
                    return
                table <- ga_statements_inner(statements, state, table) can Global{Read,Write}
                state.walk_depth <- state.walk_depth - 1

        def ga_body(statements: darray[Ast::Stmt], state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                mark: usize = state.locals.count
                table <- ga_statements(statements, state, table) can Global{Read,Write}
                state.locals.truncate(mark)
                state.local_origin_ids.truncate(mark)
                state.local_types.truncate(mark)
                state.local_type_scopes.truncate(mark)
                state.local_callees.truncate(mark)
                state.local_global_origins.truncate(mark)

        # Only a current-source record with no facts can skip this pass. This also
        # preserves the walker's depth diagnostics for trusted grants, panic sites,
        # and other syntax that has its own checker behavior.
        def ga_incremental_facts_are_authority_irrelevant[@snapshot_storage, @snapshot_borrow](record: IncrementalFunctionFactRecord, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow) -> bool:
            can Abort.Panic:
                return false if record.direct_fact_count != 0
                return false if record.direct_fact_start > snapshot.direct_facts.count
                return true

        def ga_incremental_record_is_direct_call_only[@snapshot_storage, @snapshot_borrow](record_index: usize, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow) -> bool:
            can Abort.Panic:
                return false if record_index >= snapshot.functions.count
                record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                return false if not record.cacheable or record.direct_fact_count == 0
                return false if record.direct_fact_start > snapshot.direct_facts.count or record.direct_fact_count > snapshot.direct_facts.count - record.direct_fact_start
                for relative in 0..<record.direct_fact_count |snapshot|:
                    fact: IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + relative]
                    return false if fact.owner != record_index or fact.kind != IncrementalFactKind.DirectCall or fact.active_grant_count != 0
                    return false if not (Semantic::incremental_direct_call_name(snapshot, fact) is callee_name)
                return true

        # Direct-call-only records may replace the inference body walk after each
        # fact target has been resolved against this invocation's function index.
        # Never persist or trust a numeric function slot.
        def ga_incremental_direct_call_targets[@snapshot_storage, @snapshot_borrow](record_index: usize, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow, state: GlobalAuthority&, targets: mutable darray[usize]&) -> bool:
            can Abort.Panic:
                return false if record_index >= snapshot.functions.count
                record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                return false if not record.cacheable or record.direct_fact_count == 0
                return false if record.direct_fact_start > snapshot.direct_facts.count or record.direct_fact_count > snapshot.direct_facts.count - record.direct_fact_start
                for relative in 0..<record.direct_fact_count |targets, snapshot, state|:
                    fact: IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + relative]
                    return false if fact.owner != record_index or fact.kind != IncrementalFactKind.DirectCall or fact.active_grant_count != 0
                    if Semantic::incremental_direct_call_name(snapshot, fact) is callee_name:
                        # The cold call walk evaluates the callee identifier too.
                        # A same-named local or imported global therefore contributes
                        # its own Global.Read effect; replay only the call edge when
                        # normal global lookup cannot resolve this spelling.
                        global_target: usize = ga_resolve_global(callee_name, state.module_scope, false, state)
                        return false if global_target < state.globals.count
                        target: usize = ga_resolve_function(callee_name, state.module_scope, false, state)
                        return false if target >= state.functions.count
                        return false if state.functions[target] != callee_name or state.function_scopes[target] != state.module_scope
                        return false if state.parameter_counts[target] != 0 or state.function_variadic[target]
                        candidate: mutable usize = ga_candidate_head(target, state)
                        selected: mutable usize = state.functions.count
                        matches: mutable usize = 0
                        while candidate < state.functions.count |candidate, selected, matches, state|:
                            if state.functions[candidate] == callee_name and state.function_scopes[candidate] == state.module_scope:
                                selected <- candidate
                                matches <- matches + 1
                            candidate <- state.function_next[candidate]
                        return false if matches != 1 or selected != target
                        targets.push(target)
                    else:
                        return false
                return targets.count == record.direct_fact_count

        def ga_replay_direct_call_edges(targets: darray[usize]&, state: mutable GlobalAuthority&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                replay_position: Ast::Pos = ga_position_value(0, 0, 0, 0, 0, 0)
                for target in targets |state, table| -> table:
                    need_read: mutable bool = false
                    need_write: mutable bool = false
                    table <- ga_resolved_call_candidate(target, replay_position, need_read, need_write, state, table) can Global{Read,Write}

        def ga_functions[@snapshot_storage, @snapshot_borrow](declarations: darray[Ast::Decl]&, module_scope: usize, state: mutable GlobalAuthority&, table: lmut SymbolTable, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow, reusable_empty_offsets: mutable dict[u64, u8]&, replay_call_records: mutable dict[u64, usize]&, incremental_skip_count: mutable u64&, use_current_snapshot_facts: bool, depth: u32, origin: Ast::Pos) -> void:
            can Memory.Allocate, Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    ga_mark_walk_overflow(origin, state)
                    return
                for declaration in declarations |state, table, reusable_empty_offsets, replay_call_records, incremental_skip_count| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, _, _, at):
                            state.module_scope <- module_scope
                            while next_slot < state.functions.count |next_slot: usize = ga_resolve_function(name, module_scope, true, state)|:
                                slot: usize = next_slot
                                next_slot <- state.function_next[slot]
                                continue if state.function_scopes[slot] != module_scope or state.function_offsets[slot] != at.offset or state.functions[slot] != name
                                state.function <- slot
                                break
                            state.return_type <- return_type
                            state.summary_function <- state.function if state.function < state.functions.count and state.functions[state.function] == name and state.function_scopes[state.function] == module_scope and state.function_offsets[state.function] == at.offset else GLOBAL_AUTHORITY_NONE
                            if state.summary_walk and state.summary_dependency_rounds and state.summary_function < state.return_summary_dirty.count:
                                continue if not state.return_summary_dirty[state.summary_function]
                            # The inference pass has already closed every function's
                            # Global rows. A report walk cannot emit a Global access or
                            # call-grant diagnostic for a function with neither effect;
                            # any earlier depth overflow marks every row possible and
                            # keeps this fast path closed.
                            if state.report and not state.summary_walk and state.summary_function < state.reads.count:
                                if not state.reads[state.summary_function] and not state.writes[state.summary_function]:
                                    if state.progress_enabled:
                                        state.progress_functions <- state.progress_functions + 1
                                        if state.progress_functions % 1024 == 0:
                                            PhaseTimer::counter("authority:report_functions_progress", state.progress_functions) can Global{Read,Write}
                                    continue
                            # A bodiless declaration (extern, protocol requirement) keeps the
                            # unknown summary: its returns are not visible to this walk.
                            state.return_origin_acc[state.summary_function] <- GLOBAL_AUTHORITY_NONE if state.summary_walk and state.summary_function < state.return_origin_acc.count and body.count > 0
                            # Results proven not to contain references cannot carry a
                            # storage alias. Their bodies are still walked for effect
                            # inference and reporting; only this separate summary walk is
                            # omitted. Unknown and generic result shapes stay conservative
                            # through ga_type_expression_contains_reference.
                            if state.summary_walk and body.count > 0:
                                if return_type is declared_return:
                                    continue if ga_exact_void_return(declared_return) or not ga_type_expression_contains_reference(declared_return, state, 0)
                            for parameter in parameters:
                                state.locals.push(parameter.name)
                                _ = ga_push_local_origin_id(state) can Global{Read,Write}
                                state.local_types.push(parameter.type_expression)
                                state.local_type_scopes.push(ga_type_scope(parameter.type_expression, state))
                                state.local_callees.push(GLOBAL_AUTHORITY_NONE)
                                # A parameter holds caller storage, never a global root: the
                                # caller's grant covers what it passes (stage0's rule).
                                state.local_global_origins.push(ga_local_origin(state.locals.count - 1, state))
                            state.parameter_limit <- state.locals.count
                            # Signature effects declare the exported row, not local authority.
                            # The current collector has already rescanned this body. Only
                            # direct top-level declarations have snapshot anchors; nested
                            # module/scoped declarations always take the regular walk.
                            replay_record: usize = owner if replay_call_records.get(at.offset.u64()) is owner else snapshot.functions.count
                            replayed_direct_calls: mutable bool = false
                            if use_current_snapshot_facts and not state.report and replay_record < snapshot.functions.count:
                                replay_targets: mutable darray[usize] = []
                                replayed_direct_calls <- ga_incremental_direct_call_targets(replay_record, snapshot, state, &replay_targets)
                                if replayed_direct_calls:
                                    table <- ga_replay_direct_call_edges(replay_targets, state, table) can Global{Read,Write}
                                    incremental_skip_count <- incremental_skip_count + 1
                            if replayed_direct_calls:
                                pass
                            elif use_current_snapshot_facts and reusable_empty_offsets.get(at.offset.u64()) is reusable_marker:
                                incremental_skip_count <- incremental_skip_count + 1
                            else:
                                table <- ga_body(body, state, table) can Global{Read,Write}
                            if state.progress_enabled:
                                state.progress_functions <- state.progress_functions + 1
                                if state.progress_functions % 1024 == 0:
                                    PhaseTimer::counter("authority:report_functions_progress" if state.report else "authority:inference_functions_progress", state.progress_functions) can Global{Read,Write}
                            state.locals.clear()
                            state.parameter_limit <- 0
                            state.local_origin_ids.clear()
                            state.local_types.clear()
                            state.local_type_scopes.clear()
                            state.local_callees.clear()
                            state.local_global_origins.clear()
                        Decl.Module(name, body, at):
                            table <- ga_functions(body, ga_module_path(module_scope, name, state), state, table, snapshot, reusable_empty_offsets, replay_call_records, incremental_skip_count, false, depth + 1, at) can Global{Read,Write}
                        Decl.Scoped(body, at):
                            table <- ga_functions(body, module_scope, state, table, snapshot, reusable_empty_offsets, replay_call_records, incremental_skip_count, false, depth + 1, at) can Global{Read,Write}
                        _:
                            pass

        def ga_export_rows(declarations: darray[Ast::Decl], module_scope: usize, state: mutable GlobalAuthority&, table: lmut SymbolTable, depth: u32, origin: Ast::Pos) -> void:
            can Memory.Allocate, Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    ga_mark_walk_overflow(origin, state)
                    return
                for declaration in declarations |state, table| -> table:
                    match declaration:
                        Decl.Func(name: name, pos: at, _):
                            while next_slot < state.functions.count |next_slot: usize = ga_resolve_function(name, module_scope, true, state), table| -> table:
                                slot: usize = next_slot
                                next_slot <- state.function_next[slot]
                                continue if state.function_scopes[slot] != module_scope or state.function_offsets[slot] != at.offset or state.functions[slot] != name
                                table <- gp_push_source_row(name, "Global.Read", table) can Global{Read,Write} if state.reads[slot]
                                table <- gp_push_source_row(name, "Global.Write", table) can Global{Read,Write} if state.writes[slot]
                        Decl.Module(name, body, at):
                            table <- ga_export_rows(body, ga_module_path(module_scope, name, state), state, table, depth + 1, at) can Global{Read,Write}
                        Decl.Scoped(body, at):
                            table <- ga_export_rows(body, module_scope, state, table, depth + 1, at) can Global{Read,Write}
                        _:
                            pass

        def check_mutable_global_authority_incremental[@snapshot_storage, @snapshot_borrow](file: Ast::File&, table: lmut SymbolTable, strict_unsafe: bool, enforce_global_grants: bool, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow, incremental_skip_count: mutable u64&) -> void:
            can Memory.Allocate, Abort.Panic:
                setup_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                state: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], module_child_next: [GLOBAL_AUTHORITY_NONE], globals: [], global_scopes: [], global_types: [], writable: [], functions: [], function_heads: {}, function_next: [], function_scopes: [], function_offsets: [], function_lines: [], function_variadic: [], function_return_types: [], callback_origin_heads: {}, callback_origin_tails: {}, callback_origin_next: [], callback_origin_indexed: false, parameter_starts: [], parameter_counts: [], parameter_minimum: [], enum_names: [], enum_scopes: [], struct_names: [], struct_scopes: [], field_owners: [], field_scopes: [], field_names: [], field_types: [], alias_names: [], alias_scopes: [], alias_types: [], parameter_functions: [], parameter_names: [], parameter_types: [], parameter_defaults: [], default_depth: 0, protocol_member_heads: {}, protocol_member_next: [], protocol_member_offsets: [], protocol_member_scopes: [], protocol_member_names: [], protocol_member_annotation_count: 0, protocol_member_module_count: 0, protocol_member_index_ready: false, protocol_bound_heads: {}, protocol_bound_tails: {}, protocol_bound_next: [], protocol_bound_offsets: [], protocol_bound_lines: [], protocol_bound_scopes: [], protocol_bound_generics: [], protocol_bound_names: [], protocol_bound_module_count: 0, protocol_bound_annotation_count: 0, protocol_bound_index_ready: false, reads: [], writes: [], edge_from: [], edge_to: [], edge_reads: [], edge_writes: [], local_floor: 0, local_limit: GLOBAL_AUTHORITY_NONE, locals: [], local_types: [], local_type_scopes: [], local_callees: [], local_global_origins: [], return_type: null, lambda_depth: 0, inline_refs: [], inline_spans: [], inline_prefix_ends: [], global_mutable_heads: {}, global_mutable_owners: [], global_mutable_offsets: [], global_mutable_lines: [], global_mutable_modules: [], global_mutable_next: [], import_annotations: [], grants: [], firewalls: [], annotations: file.enum_annotations, generic_lines: file.generic_param_lines, generic_names: file.generic_param_names, generic_head_heads: {}, generic_head_next: [], generic_head_index_names: [], generic_head_source_count: 0, generic_head_index_ready: false, module_scope: 0, function: 0, report: false, strict_unsafe: false}
                ga_index_import_annotations(&state)
                ga_index_mutable_annotations(&state) can Global{Read,Write}
                state.strict_unsafe <- strict_unsafe
                state.progress_enabled <- setup_span.active
                ga_collect(file.top_decls, 0, &state, 0, ga_position_value(0, 0, 0, 0, 0, 0)) can Global{Read,Write}
                if state.walk_overflow:
                    ga_mark_all_possible_global_effects(&state)
                for annotation in state.annotations:
                    if annotation.owner == "__protocol_decl":
                        state.protocol_names.push(annotation.name)
                        state.protocol_scopes.push(ga_module_text(annotation.module, &state))
                ga_index_protocol_metadata(&state) can Global{Read,Write}
                ga_index_capabilities(&state) can Global{Read,Write}
                ga_resolve_initial_rows(&state) can Global{Read,Write}
                ga_protocol_contracts(&state) can Global{Read,Write}
                for function in 0..<state.functions.count |state|:
                    row: mutable usize = state.effect_row_heads[function]
                    while row < state.effect_row_refs.count |row, state|:
                        ref: sview = state.effect_refs[state.effect_row_refs[row]]
                        state.reads[function] <- true if ga_ref_covers(ref, "Global.Read", state.function_scopes[function], 0, &state, 0)
                        state.writes[function] <- true if ga_ref_covers(ref, "Global.Write", state.function_scopes[function], 0, &state, 0)
                        row <- state.effect_row_next[row]
                for annotation in file.enum_annotations |state|:
                    if annotation.owner == "__inline_expression_grant":
                        state.inline_refs.push(annotation.name)
                        state.inline_spans.push(annotation.pos)
                        state.inline_scopes.push(ga_module_text(annotation.module, &state))
                ga_index_inline_grants(&state)
                ga_allocate_return_rows(&state)
                ga_unknown_callback(&state) can Global{Read,Write}
                reusable_empty_offsets: mutable dict[u64, u8] = {}
                replay_call_records: mutable dict[u64, usize] = {}
                use_current_snapshot_facts: mutable bool = false
                # Inline grants add authority effects by source span during the regular
                # expression walk. Current body facts do not yet bind those annotation
                # spans to a function, so keep both empty-fact skips and direct-call
                # replay cold whenever this translation unit has any inline grant.
                if snapshot.functions.count > 0 and snapshot.current_anchors.count == snapshot.functions.count and state.inline_refs.count == 0:
                    for record_index in 0..<snapshot.functions.count |use_current_snapshot_facts, snapshot|:
                        record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                        if record.cacheable and (ga_incremental_facts_are_authority_irrelevant(record, snapshot) or ga_incremental_record_is_direct_call_only(record_index, snapshot)):
                            use_current_snapshot_facts <- true
                if use_current_snapshot_facts:
                    # Exact source offsets bind only when unique. The collector scans
                    # current AST bodies even on a cold cache, so previous-match flags
                    # and declaration-surface compatibility are not reuse preconditions.
                    offset_owners: mutable dict[u64, usize] = {}
                    missing_offset_owner: usize = snapshot.functions.count + 1
                    for record_index in 0..<snapshot.functions.count |offset_owners, snapshot, missing_offset_owner|:
                        offset: u64 = snapshot.current_anchors[record_index].definition_offset.u64()
                        previous_owner: usize = owner if offset_owners.get(offset) is owner else missing_offset_owner
                        if previous_owner == missing_offset_owner:
                            offset_owners <- offset_owners.put(offset, record_index) can Global{Read,Write}
                        else:
                            offset_owners <- offset_owners.put(offset, snapshot.functions.count) can Global{Read,Write}
                    for record_index in 0..<snapshot.functions.count |offset_owners, reusable_empty_offsets, snapshot|:
                        offset: u64 = snapshot.current_anchors[record_index].definition_offset.u64()
                        unique_owner: usize = owner if offset_owners.get(offset) is owner else snapshot.functions.count
                        continue if unique_owner != record_index
                        record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                        continue if not record.cacheable
                        if ga_incremental_facts_are_authority_irrelevant(record, snapshot):
                            reusable_empty_offsets <- reusable_empty_offsets.put(offset, 1) can Global{Read,Write}
                        elif ga_incremental_record_is_direct_call_only(record_index, snapshot):
                            replay_call_records <- replay_call_records.put(offset, record_index) can Global{Read,Write}
                ga_prepare_import_scopes(&state) can Global{Read,Write}
                ga_prepare_member_index(&state) can Global{Read,Write}
                PhaseTimer::end_span("authority:collect_setup", setup_span)
                summary_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                # Return-origin summaries: quiet report-mode walks (they mutate no rows).
                # The first walk sees every call result as unknown; each later walk reads
                # the previous walk's summaries. Preserve the existing four-round transfer
                # and opaque-result policy, but revisit only changed-summary dependents.
                # Developer reference mode keeps complete rounds for transfer-equivalence
                # checks; normal runs use dependency-driven revisits.
                if phase_timer_getenv("ELISA_AUTHORITY_FULL_SUMMARIES") is reference_flag:
                    reference_first: u8 = reference_flag
                    state.summary_dependency_rounds <- reference_first == 0 or reference_first == 48
                summary_diagnostic_mark: usize = table.diagnostics.count
                state.return_origins.clear()
                state.return_origin_acc.clear()
                state.return_summary_dirty.clear()
                state.return_summary_changed.clear()
                for _ in 0..<state.functions.count |state|:
                    state.return_origins.push(GLOBAL_AUTHORITY_UNKNOWN_ALIAS)
                    state.return_origin_acc.push(GLOBAL_AUTHORITY_UNKNOWN_ALIAS)
                    state.return_summary_dirty.push(true)
                    state.return_summary_changed.push(false)
                summary_overflow: bool = state.walk_overflow
                state.report <- true
                state.summary_walk <- true
                summary_changed: mutable bool = true
                summary_rounds: mutable u32 = 0
                while summary_changed and summary_rounds < 4 |summary_changed, summary_rounds, state, table, reusable_empty_offsets, replay_call_records, incremental_skip_count|:
                    summary_rounds <- summary_rounds + 1
                    round_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                    summary_function_count: usize = state.functions.count
                    summary_callback_edges: usize = state.callback_origin_from.count
                    summary_callback_results: usize = state.callback_result_sources.count
                    table <- ga_functions(file.top_decls, 0, &state, table, snapshot, &reusable_empty_offsets, &replay_call_records, incremental_skip_count, false, 0, ga_position_value(0, 0, 0, 0, 0, 0)) can Global{Read,Write}
                    table.diagnostics <- table.diagnostics.truncate(summary_diagnostic_mark)
                    state.progress_functions <- 0
                    summary_changed <- false
                    break if state.walk_overflow and not summary_overflow
                    changed_origins: mutable bool = false
                    for slot in 0..<min(state.return_origins.count, state.return_origin_acc.count) |state, changed_origins|:
                        state.return_summary_changed[slot] <- state.return_origins[slot] != state.return_origin_acc[slot]
                        changed_origins <- true if state.return_summary_changed[slot]
                        state.return_origins[slot] <- state.return_origin_acc[slot]
                        state.return_summary_dirty[slot] <- false
                    if state.summary_dependency_rounds:
                        for edge in 0..<state.return_dep_callers.count |summary_changed, state|:
                            caller: usize = state.return_dep_callers[edge]
                            callee: usize = state.return_dep_callees[edge]
                            if state.return_summary_changed[callee]:
                                state.return_summary_dirty[caller] <- true
                                summary_changed <- true
                    else:
                        summary_changed <- changed_origins
                    # New callable rows/edges are another input to body transfer. A full
                    # follow-up round preserves the original behavior when they grow.
                    if state.summary_dependency_rounds and changed_origins and (state.functions.count != summary_function_count or state.callback_origin_from.count != summary_callback_edges or state.callback_result_sources.count != summary_callback_results):
                        summary_changed <- true
                        for slot in 0..<state.return_summary_dirty.count |state|:
                            state.return_summary_dirty[slot] <- true
                    PhaseTimer::end_span("authority:return_summary_round", round_span)
                    if state.progress_enabled:
                        PhaseTimer::counter("authority:return_summary_rounds", summary_rounds.u64()) can Global{Read,Write}
                        PhaseTimer::counter("authority:return_summary_dependencies", state.return_dep_callers.count.u64()) can Global{Read,Write}
                if state.walk_overflow and not summary_overflow:
                    for slot in 0..<state.return_origins.count |state|:
                        state.return_origins[slot] <- GLOBAL_AUTHORITY_UNKNOWN_ALIAS
                state.summary_walk <- false
                state.report <- false
                state.summary_function <- GLOBAL_AUTHORITY_NONE
                PhaseTimer::end_span("authority:return_summaries", summary_span)
                inference_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                table <- ga_functions(file.top_decls, 0, &state, table, snapshot, &reusable_empty_offsets, &replay_call_records, incremental_skip_count, use_current_snapshot_facts, 0, ga_position_value(0, 0, 0, 0, 0, 0)) can Global{Read,Write}
                if state.walk_overflow:
                    ga_mark_all_possible_global_effects(&state)
                PhaseTimer::end_span("authority:inference_walk", inference_span)
                if state.progress_enabled:
                    PhaseTimer::counter("authority:function_slots", state.functions.count.u64()) can Global{Read,Write}
                    PhaseTimer::counter("authority:callback_result_proxies", state.callback_result_sources.count.u64()) can Global{Read,Write}
                callback_results_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                ga_resolve_callback_results(&state) can Global{Read,Write}
                PhaseTimer::end_span("authority:callback_results", callback_results_span)
                readwrite_closure_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                # Keep short closures allocation-free with up to two source-order sweeps.
                # If they do not converge, build reverse call edges and propagate each newly
                # known bit only through callers of that function. Each function enters a
                # worklist once per bit, so each caller edge is examined at most once per bit.
                edge_count: usize = state.edge_from.count
                function_count: usize = state.functions.count
                assert state.edge_to.count == edge_count and state.edge_reads.count == edge_count and state.edge_writes.count == edge_count
                assert state.reads.count == function_count and state.writes.count == function_count
                readwrite_queue_items: mutable u64 = 0
                readwrite_edge_visits: mutable u64 = 0
                readwrite_fast_rounds: mutable u64 = 0
                readwrite_changed: mutable bool = true
                while readwrite_changed and readwrite_fast_rounds < 2 |readwrite_changed, readwrite_fast_rounds, readwrite_edge_visits, readwrite_closure_span, state|:
                    readwrite_changed <- false
                    readwrite_fast_rounds <- readwrite_fast_rounds + 1
                    for edge in 0..<edge_count |readwrite_changed, readwrite_edge_visits, readwrite_closure_span, state|:
                        readwrite_edge_visits <- readwrite_edge_visits + 1 if readwrite_closure_span.active
                        caller: usize = state.edge_from[edge]
                        callee: usize = state.edge_to[edge]
                        assert caller < function_count and callee < function_count
                        if state.edge_reads[edge] and state.reads[callee] and not state.reads[caller]:
                            state.reads[caller] <- true
                            readwrite_changed <- true
                        if state.edge_writes[edge] and state.writes[callee] and not state.writes[caller]:
                            state.writes[caller] <- true
                            readwrite_changed <- true

                readwrite_worklist_edge_visits: mutable u64 = 0
                if readwrite_changed:
                    incoming_heads: mutable darray[usize] = []
                    incoming_heads.reserve(function_count)
                    for _ in 0..<function_count |incoming_heads|:
                        incoming_heads.push(GLOBAL_AUTHORITY_NONE)
                    incoming_next: mutable darray[usize] = []
                    incoming_next.reserve(edge_count)
                    for _ in 0..<edge_count |incoming_next|:
                        incoming_next.push(GLOBAL_AUTHORITY_NONE)
                    for edge_index in 0..<edge_count |incoming_heads, incoming_next, readwrite_edge_visits, readwrite_closure_span, state|:
                        readwrite_edge_visits <- readwrite_edge_visits + 1 if readwrite_closure_span.active
                        callee: usize = state.edge_to[edge_index]
                        assert callee < function_count
                        if state.edge_reads[edge_index] or state.edge_writes[edge_index]:
                            incoming_next[edge_index] <- incoming_heads[callee]
                            incoming_heads[callee] <- edge_index

                    read_queue: mutable darray[usize] = []
                    read_queue.reserve(function_count)
                    for function_index in 0..<function_count |read_queue, state|:
                        read_queue.push(function_index) if state.reads[function_index]
                    read_cursor: mutable usize = 0
                    while read_cursor < read_queue.count |read_cursor, read_queue, readwrite_queue_items, readwrite_edge_visits, readwrite_worklist_edge_visits, readwrite_closure_span, incoming_heads, incoming_next, state|:
                        callee: usize = read_queue[read_cursor]
                        read_cursor <- read_cursor + 1
                        readwrite_queue_items <- readwrite_queue_items + 1 if readwrite_closure_span.active
                        edge: mutable usize = incoming_heads[callee]
                        while edge < edge_count |edge, read_queue, readwrite_edge_visits, readwrite_worklist_edge_visits, readwrite_closure_span, incoming_next, state|:
                            readwrite_edge_visits <- readwrite_edge_visits + 1 if readwrite_closure_span.active
                            readwrite_worklist_edge_visits <- readwrite_worklist_edge_visits + 1 if readwrite_closure_span.active
                            caller: usize = state.edge_from[edge]
                            if state.edge_reads[edge] and not state.reads[caller]:
                                state.reads[caller] <- true
                                read_queue.push(caller)
                            edge <- incoming_next[edge]

                    write_queue: mutable darray[usize] = []
                    write_queue.reserve(function_count)
                    for function_index in 0..<function_count |write_queue, state|:
                        write_queue.push(function_index) if state.writes[function_index]
                    write_cursor: mutable usize = 0
                    while write_cursor < write_queue.count |write_cursor, write_queue, readwrite_queue_items, readwrite_edge_visits, readwrite_worklist_edge_visits, readwrite_closure_span, incoming_heads, incoming_next, state|:
                        callee: usize = write_queue[write_cursor]
                        write_cursor <- write_cursor + 1
                        readwrite_queue_items <- readwrite_queue_items + 1 if readwrite_closure_span.active
                        edge: mutable usize = incoming_heads[callee]
                        while edge < edge_count |edge, write_queue, readwrite_edge_visits, readwrite_worklist_edge_visits, readwrite_closure_span, incoming_next, state|:
                            readwrite_edge_visits <- readwrite_edge_visits + 1 if readwrite_closure_span.active
                            readwrite_worklist_edge_visits <- readwrite_worklist_edge_visits + 1 if readwrite_closure_span.active
                            caller: usize = state.edge_from[edge]
                            if state.edge_writes[edge] and not state.writes[caller]:
                                state.writes[caller] <- true
                                write_queue.push(caller)
                            edge <- incoming_next[edge]
                PhaseTimer::end_span("authority:readwrite_closure", readwrite_closure_span)
                if readwrite_closure_span.active:
                    PhaseTimer::counter("authority:readwrite_queue_items", readwrite_queue_items) can Global{Read,Write}
                    PhaseTimer::counter("authority:readwrite_edges", edge_count.u64()) can Global{Read,Write}
                    PhaseTimer::counter("authority:readwrite_fast_rounds", readwrite_fast_rounds) can Global{Read,Write}
                    PhaseTimer::counter("authority:readwrite_edge_visits", readwrite_edge_visits) can Global{Read,Write}
                    PhaseTimer::counter("authority:readwrite_worklist_edge_visits", readwrite_worklist_edge_visits) can Global{Read,Write}
                effect_closure_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                ga_close_rows(&state) can Global{Read,Write}
                PhaseTimer::end_span("authority:effect_row_closure", effect_closure_span)
                publish_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                table <- ga_publish_rows(state.parents, state.modules, state.module_starts, state.module_lengths, state.functions, state.function_scopes, state.function_offsets, state.effect_refs, state.effect_row_heads, state.effect_row_refs, state.effect_row_mandatory, state.effect_row_scopes, state.effect_row_next, table) can Global{Read,Write}
                PhaseTimer::end_span("authority:publish_rows", publish_span)
                if enforce_global_grants:
                    permission_param_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                    ga_prepare_permission_param_ref_flags(&state, table) can Global{Read,Write}
                    PhaseTimer::end_span("authority:permission_param_cache", permission_param_span)
                    report_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                    state.report <- true
                    state.progress_functions <- 0
                    table <- ga_functions(file.top_decls, 0, &state, table, snapshot, &reusable_empty_offsets, &replay_call_records, incremental_skip_count, use_current_snapshot_facts, 0, ga_position_value(0, 0, 0, 0, 0, 0)) can Global{Read,Write}
                    PhaseTimer::end_span("authority:report_walk", report_span)
                # Export facts after the generic checker has run; this checker owns
                # mandatory Global call authority with lexical declaration identities.
                export_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                table <- ga_export_rows(file.top_decls, 0, &state, table, 0, ga_position_value(0, 0, 0, 0, 0, 0)) can Global{Read,Write}
                table <- ga_report_walk_overflow(&state, table) can Global{Read,Write}
                PhaseTimer::end_span("authority:export_rows", export_span)
