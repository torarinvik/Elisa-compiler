# Mandatory authority for mutable global storage. Declaration identities include their
# lexical module; binding stacks advance in source order and unwind at module_scope exits.
# `can` grants access locally and exports the effect. `trusted` grants only its named
# members and hides precisely those members from callers.
extend Semantic:
    private:
        const GLOBAL_AUTHORITY_NONE: usize = 4294967295
        const GLOBAL_AUTHORITY_UNKNOWN_ALIAS: usize = 4294967294
        # Reserved ceiling for encoded local-root identities. The legacy generic local
        # alias sentinel remains below UNKNOWN_ALIAS but is no longer emitted.
        const GLOBAL_AUTHORITY_LOCAL_ALIAS: usize = 4294967293
        const GLOBAL_AUTHORITY_OFFSET_NONE: u32 = 4294967295
        const GLOBAL_AUTHORITY_PERMISSION_PARAM_CACHE_MISS: u8 = 2
        const GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT: u32 = 128
        # Return-origin summary value meaning "the join of the call's arguments". Only
        # stored in return_origins; never used as an origin itself.
        const GLOBAL_AUTHORITY_ARGUMENT_RESULT: usize = 4294967292

        struct GlobalAuthority:
            parents: mutable darray[usize] = []
            # Published names borrow parser source/static text; only the row buffers are local.
            modules: mutable darray[sview @source] = []
            module_starts: mutable darray[usize] = []
            module_lengths: mutable darray[usize] = []
            globals: mutable darray[sview] = []
            global_scopes: mutable darray[usize] = []
            global_types: mutable darray[Ast::Expr] = []
            writable: mutable darray[bool] = []
            canonical_declarations: mutable darray[Ast::Decl?] = []
            functions: mutable darray[sview @source] = []
            function_heads: mutable dict[u64, usize] = {}
            # `globals` rows chained by name hash (newest first); see ga_resolve_global.
            # Module children by (parent, segment) hash, chained newest first; see ga_child_part.
            module_child_heads: mutable dict[u64, usize] = {}
            module_child_next: mutable darray[usize] = []
            global_heads: mutable dict[u64, usize] = {}
            global_next: mutable darray[usize] = []
            enum_heads: mutable dict[u64, usize] = {}
            enum_next: mutable darray[usize] = []
            struct_heads: mutable dict[u64, usize] = {}
            struct_next: mutable darray[usize] = []
            alias_heads: mutable dict[u64, usize] = {}
            alias_next: mutable darray[usize] = []
            function_next: mutable darray[usize] = []
            function_scopes: mutable darray[usize] = []
            function_offsets: mutable darray[u32] = []
            function_lines: mutable darray[u32] = []
            function_variadic: mutable darray[bool] = []
            function_return_types: mutable darray[Ast::Expr?] = []
            static_if_conds: darray[Ast::Expr] = []
            static_if_modules: darray[sview] = []
            static_if_lines: darray[u32] = []
            static_if_kinds: darray[StaticIfBranch::Kind] = []
            static_if_depths: darray[u32] = []
            static_const_names: mutable darray[sview] = []
            static_const_values: mutable darray[Ast::Expr] = []
            static_const_owners: mutable darray[sview @source] = []
            static_const_lines: mutable darray[u32] = []
            static_const_offsets: mutable darray[u32] = []
            returned_callees: mutable darray[usize] = []
            callback_result_sources: mutable darray[usize] = []
            callback_result_slots: mutable darray[usize] = []
            callback_origin_from: mutable darray[usize] = []
            callback_origin_to: mutable darray[usize] = []
            callback_origin_heads: mutable dict[usize, usize] = {}
            callback_origin_tails: mutable dict[usize, usize] = {}
            callback_origin_next: mutable darray[usize] = []
            callback_origin_indexed: mutable bool = false
            callback_join_slots: mutable darray[usize] = []
            callback_join_owners: mutable darray[usize] = []
            callback_join_offsets: mutable darray[u32] = []
            callback_join_scopes: mutable darray[usize] = []
            unknown_callback_slot: mutable usize = GLOBAL_AUTHORITY_NONE
            parameter_starts: mutable darray[usize] = []
            parameter_counts: mutable darray[usize] = []
            parameter_minimum: mutable darray[usize] = []
            protocol_names: mutable darray[sview] = []
            protocol_contract_slots: mutable darray[usize] = []
            protocol_contract_offsets: mutable darray[u32] = []
            protocol_contract_scopes: mutable darray[usize] = []
            protocol_scopes: mutable darray[usize] = []
            # Exact indexes for protocol/generic annotations, prepared once after the
            # module tree is complete. Hash chains retain the source rows for exact checks.
            protocol_member_heads: mutable dict[u64, usize] = {}
            protocol_member_next: mutable darray[usize] = []
            protocol_member_offsets: mutable darray[u32] = []
            protocol_member_scopes: mutable darray[usize] = []
            protocol_member_names: mutable darray[sview] = []
            protocol_member_annotation_count: mutable usize = 0
            protocol_member_module_count: mutable usize = 0
            protocol_member_index_ready: mutable bool = false
            protocol_bound_heads: mutable dict[u64, usize] = {}
            protocol_bound_tails: mutable dict[u64, usize] = {}
            protocol_bound_next: mutable darray[usize] = []
            protocol_bound_offsets: mutable darray[u32] = []
            protocol_bound_lines: mutable darray[u32] = []
            protocol_bound_scopes: mutable darray[usize] = []
            protocol_bound_generics: mutable darray[sview] = []
            protocol_bound_names: mutable darray[sview] = []
            protocol_bound_module_count: mutable usize = 0
            protocol_bound_annotation_count: mutable usize = 0
            protocol_bound_index_ready: mutable bool = false
            enum_names: mutable darray[sview] = []
            enum_scopes: mutable darray[usize] = []
            enum_variant_owners: mutable darray[sview] = []
            enum_variant_scopes: mutable darray[usize] = []
            enum_variant_names: mutable darray[sview] = []
            enum_variant_payload_starts: mutable darray[usize] = []
            enum_variant_payload_counts: mutable darray[usize] = []
            enum_variant_payload_names: mutable darray[sview] = []
            enum_variant_payload_types: mutable darray[Ast::Expr] = []
            struct_names: mutable darray[sview] = []
            struct_scopes: mutable darray[usize] = []
            field_owners: mutable darray[sview] = []
            field_scopes: mutable darray[usize] = []
            field_names: mutable darray[sview] = []
            field_types: mutable darray[Ast::Expr] = []
            # Exact per-owner chains over field/variant rows, ascending, built once by
            # ga_prepare_member_index; see ga_field_first/ga_variant_first.
            struct_field_first: mutable darray[usize] = []
            field_row_next: mutable darray[usize] = []
            enum_variant_first: mutable darray[usize] = []
            variant_row_next: mutable darray[usize] = []
            alias_names: mutable darray[sview] = []
            alias_scopes: mutable darray[usize] = []
            alias_types: mutable darray[Ast::Expr] = []
            parameter_functions: mutable darray[usize] = []
            parameter_names: mutable darray[sview] = []
            parameter_types: mutable darray[Ast::Expr] = []
            parameter_defaults: mutable darray[Ast::Expr?] = []
            default_depth: mutable u32 = 0
            walk_depth: mutable u32 = 0
            walk_depth_reported: mutable bool = false
            walk_overflow: mutable bool = false
            walk_overflow_pos: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            grant_scopes: mutable darray[usize] = []
            firewall_scopes: mutable darray[usize] = []
            grant_offsets: mutable darray[u32] = []
            firewall_offsets: mutable darray[u32] = []
            inline_scopes: mutable darray[usize] = []
            capability_heads: mutable dict[u64, usize] = {}
            capability_next: mutable darray[usize] = []
            permission_heads: mutable dict[u64, usize] = {}
            permission_next: mutable darray[usize] = []
            capabilities_indexed: mutable bool = false
            permission_includes_present: mutable bool = false
            permission_names: mutable darray[sview] = []
            permission_scopes: mutable darray[usize] = []
            row_edge_filter_scopes: mutable darray[usize] = []
            capability_names: mutable darray[sview] = []
            capability_scopes: mutable darray[usize] = []
            capability_refs: mutable darray[sview] = []
            capability_offsets: mutable darray[u32] = []
            effect_refs: mutable darray[sview @source] = []
            effect_ref_heads: mutable dict[u64, usize] = {}
            effect_ref_next: mutable darray[usize] = []
            # File-local exact permission-parameter classification, prepared only after
            # canonical refs are published and consumed by the Global row report walk.
            permission_param_ref_flags: mutable darray[bool] = []
            permission_param_ref_names: mutable darray[sview] = []
            permission_param_ref_lengths: mutable darray[usize] = []
            permission_param_ref_count: mutable usize = 0
            permission_param_annotation_count: mutable usize = 0
            permission_param_ref_flags_ready: mutable bool = false
            effect_row_heads: mutable darray[usize] = []
            effect_row_refs: mutable darray[usize] = []
            effect_row_next: mutable darray[usize] = []
            effect_row_mandatory: mutable darray[bool] = []
            effect_row_scopes: mutable darray[usize] = []
            effect_row_offsets: mutable darray[u32] = []
            row_edge_from: mutable darray[usize] = []
            row_edge_to: mutable darray[usize] = []
            row_edge_filter_starts: mutable darray[usize] = []
            row_edge_filter_counts: mutable darray[usize] = []
            row_edge_filter_refs: mutable darray[usize] = []
            row_edge_filter_offsets: mutable darray[u32] = []
            reads: mutable darray[bool] = []
            writes: mutable darray[bool] = []
            edge_from: mutable darray[usize] = []
            edge_to: mutable darray[usize] = []
            edge_reads: mutable darray[bool] = []
            edge_writes: mutable darray[bool] = []
            local_floor: mutable usize = 0
            local_limit: mutable usize = GLOBAL_AUTHORITY_NONE
            locals: mutable darray[sview] = []
            local_types: mutable darray[Ast::Expr?] = []
            local_type_scopes: mutable darray[usize] = []
            local_callees: mutable darray[usize] = []
            local_global_origins: mutable darray[usize] = []
            # Stable-within-analysis identities prevent a captured local-root origin
            # from silently naming a different binding after lexical slots are reused.
            local_origin_ids: mutable darray[usize] = []
            # Locals below this index are the current top-level function's parameters.
            parameter_limit: mutable usize = 0
            # Per-function summary of what a returned reference may alias: NONE, one
            # global slot, ARGUMENT_RESULT, or UNKNOWN_ALIAS (the default; also every
            # function without a walked body). A quiet pre-walk computes them from
            # all-unknown inputs, so every summary over-approximates its function.
            return_origins: mutable darray[usize] = []
            return_origin_acc: mutable darray[usize] = []
            return_summary_dirty: mutable darray[bool] = []
            return_summary_changed: mutable darray[bool] = []
            return_dep_callers: mutable darray[usize] = []
            return_dep_callees: mutable darray[usize] = []
            summary_dependency_rounds: mutable bool = true
            summary_walk: mutable bool = false
            summary_function: mutable usize = GLOBAL_AUTHORITY_NONE
            next_local_origin_id: mutable usize = 0
            return_type: mutable Ast::Expr? = null
            lambda_depth: mutable u32 = 0
            inline_refs: mutable darray[sview] = []
            inline_spans: mutable darray[Ast::Pos] = []
            inline_prefix_ends: mutable darray[u32] = []
            global_mutable_heads: mutable dict[u64, usize] = {}
            global_mutable_owners: mutable darray[sview] = []
            global_mutable_offsets: mutable darray[u32] = []
            global_mutable_lines: mutable darray[u32] = []
            global_mutable_modules: mutable darray[sview] = []
            global_mutable_next: mutable darray[usize] = []
            # Source-ordered annotation row views for repeated alias and static-branch
            # lookups. The rows retain the full annotation identity for exact checks.
            module_alias_rows: mutable darray[usize] = []
            static_branch_marker_rows: mutable darray[usize] = []
            module_alias_index_annotation_count: mutable usize = 0
            module_alias_index_ready: mutable bool = false
            import_annotations: mutable darray[Ast::EnumAnnotation] = []
            static_import_uncertain: mutable bool = false
            # Per import row, filled once collection ends (ga_prepare_import_scopes): the row's
            # own module scope and the scope it imports from (modules.count when none).
            import_module_scopes: mutable darray[usize] = []
            import_target_scopes: mutable darray[usize] = []
            # `__tuple_label` annotations sorted by offset (ga_prepare_import_scopes); built flag.
            tuple_label_offsets: mutable darray[u32] = []
            tuple_label_names: mutable darray[sview] = []
            tuple_labels_ready: mutable bool = false
            grants: mutable darray[sview] = []
            firewalls: mutable darray[sview] = []
            annotations: darray[Ast::EnumAnnotation]
            generic_lines: mutable darray[u32] = []
            generic_names: mutable darray[sview] = []
            # Parallel parser rows pair each generic binder with its declaration token;
            # same-line functions cannot borrow another candidate's receiver binder.
            generic_owner_offsets: mutable darray[u32] = []
            generic_head_heads: mutable dict[u64, usize] = {}
            generic_head_next: mutable darray[usize] = []
            generic_head_index_names: mutable darray[sview] = []
            generic_head_source_count: mutable usize = 0
            generic_head_index_ready: mutable bool = false
            module_scope: mutable usize = 0
            function: mutable usize = 0
            report: mutable bool = false
            strict_unsafe: mutable bool = false
            progress_enabled: mutable bool = false
            progress_functions: mutable u64 = 0

        def ga_import_visible(module: sview, state: GlobalAuthority&, lexical_scope: usize = GLOBAL_AUTHORITY_NONE) -> bool:
            can Abort.Panic:
                return true if module == ""
                module_scope: mutable usize = state.module_scope if lexical_scope == GLOBAL_AUTHORITY_NONE else lexical_scope
                while module_scope != 0 |module_scope|:
                    return true if module_scope == ga_module_text(module, state)
                    module_scope <- state.parents[module_scope]
                return false

        # Resolve target predicates only when semantic and backend target inputs are known
        # to agree. An explicit non-host triple needs string parsing plus the full backend
        # target model; leave that case unknown rather than deriving a host branch.
        def ga_static_if_target_constant(name: sview) -> (known: bool, value: i64):
            can Abort.Panic:
                explicit_triple: bool = getenv("ELISA_STAGE1_TRIPLE") is target_triple
                return (false, 0) if explicit_triple
                wasm: bool = getenv("ELISA_STAGE1_WASM") is wasm_target
                linux_host: bool = getenv("ELISA_HOST_LINUX") is linux_marker
                windows_host: bool = getenv("ELISA_HOST_WINDOWS") is windows_marker
                x86_host: bool = getenv("ELISA_HOST_X86_64") is x86_marker
                linux: bool = linux_host and not windows_host
                windows: bool = windows_host
                macos: bool = not linux and not windows
                if wasm:
                    if name == "ELISA_TARGET_OS_POSIX" or name == "ELISA_TARGET_OS_WASM" or name == "ELISA_TARGET_OS_WASI" or name == "PLATFORM_WASM" or name == "ELISA_TARGET_ARCH_WASM32" or name == "ELISA_TARGET_ARCH_WASM" or name == "ARCH_WASM32":
                        return (true, 1)
                    if name == "ELISA_TARGET_OS_MACOS" or name == "ELISA_TARGET_OS_FREEBSD" or name == "PLATFORM_APPLE" or name == "PLATFORM_DARWIN" or name == "PLATFORM_FREEBSD" or name == "PLATFORM_LINUX" and not linux_host or name == "PLATFORM_WINDOWS" and not windows_host or name == "ELISA_TARGET_ARCH_ARM64" or name == "ELISA_TARGET_ARCH_WASM64" or name == "ARCH_ARM64":
                        return (true, 0)
                    return (false, 0)
                if name == "ELISA_TARGET_OS_MACOS":
                    return (true, 1 if macos else 0)
                if name == "ELISA_TARGET_OS_LINUX" or name == "PLATFORM_LINUX":
                    return (true, 1 if linux else 0)
                if name == "ELISA_TARGET_OS_WINDOWS" or name == "PLATFORM_WINDOWS":
                    return (true, 1 if windows else 0)
                if name == "ELISA_TARGET_OS_FREEBSD" or name == "PLATFORM_FREEBSD":
                    return (true, 0)
                if name == "ELISA_TARGET_OS_POSIX":
                    return (true, 0 if windows else 1)
                if name == "ELISA_TARGET_OS_WASM" or name == "ELISA_TARGET_OS_WASI" or name == "ELISA_TARGET_ARCH_WASM32" or name == "ELISA_TARGET_ARCH_WASM64" or name == "ELISA_TARGET_ARCH_WASM" or name == "PLATFORM_WASM" or name == "ARCH_WASM32":
                    return (true, 0)
                if name == "ELISA_TARGET_ARCH_X86_64" or name == "ARCH_X86_64":
                    return (true, 1 if x86_host else 0)
                if name == "ELISA_TARGET_ARCH_ARM64" or name == "ARCH_ARM64":
                    return (true, 0 if x86_host else 1)
                return (false, 0)

        def ga_static_if_target_predicate(name: sview) -> bool:
            can Abort.Panic:
                return name == "ELISA_TARGET_OS_MACOS" or name == "ELISA_TARGET_OS_LINUX" or name == "ELISA_TARGET_OS_WINDOWS" or name == "ELISA_TARGET_OS_FREEBSD" or name == "ELISA_TARGET_OS_POSIX" or name == "ELISA_TARGET_OS_WASM" or name == "ELISA_TARGET_OS_WASI" or name == "ELISA_TARGET_ARCH_X86_64" or name == "ELISA_TARGET_ARCH_ARM64" or name == "ELISA_TARGET_ARCH_WASM32" or name == "ELISA_TARGET_ARCH_WASM64" or name == "ELISA_TARGET_ARCH_WASM" or name == "PLATFORM_APPLE" or name == "PLATFORM_DARWIN" or name == "PLATFORM_LINUX" or name == "PLATFORM_WINDOWS" or name == "PLATFORM_FREEBSD" or name == "PLATFORM_WASM" or name == "ARCH_X86_64" or name == "ARCH_ARM64" or name == "ARCH_WASM32"

        # A const declaration inside a static-if arm is only a candidate when that arm is
        # selected. Missing branch metadata is treated as unresolved rather than allowing
        # a sibling declaration with the same lexical owner to win by source order.
        def ga_static_if_const_branch_selection(const_index: usize, state: GlobalAuthority&, depth: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                return (false, false) if const_index >= state.static_const_names.count or const_index >= state.static_const_owners.count or const_index >= state.static_const_lines.count or const_index >= state.static_const_offsets.count
                markers: (found: bool, inactive: bool, unknown: bool) = ga_static_branch_marker_selection("__const_static_branch", state.static_const_names[const_index], state.static_const_owners[const_index], state.static_const_lines[const_index], state.static_const_offsets[const_index], state.static_const_owners[const_index], state, depth + 1)
                return (true, false) if markers.inactive
                return (true, true) if not markers.found
                return (false, false) if markers.unknown
                return (true, true)

        # Resolve the source const subset that backend static-if folding can safely read.
        # Exact-module declarations win, then top-level declarations; the backend's final
        # bare-name fallback is mirrored only when one unambiguous active source candidate remains.
        def ga_static_if_named_constant_value(name: sview, current_module: sview, state: GlobalAuthority&, depth: u32) -> (known: bool, value: i64, backend_folds: bool):
            can Abort.Panic:
                return (false, 0, true) if depth >= 64
                exact_index: mutable usize = state.static_const_names.count
                exact_matches: mutable usize = 0
                exact_unknown: mutable bool = false
                top_index: mutable usize = state.static_const_names.count
                top_matches: mutable usize = 0
                top_unknown: mutable bool = false
                any_index: mutable usize = state.static_const_names.count
                any_matches: mutable usize = 0
                any_unknown: mutable bool = false
                for index in 0..<state.static_const_names.count |exact_index, exact_matches, exact_unknown, top_index, top_matches, top_unknown, any_index, any_matches, any_unknown, current_module, name, state, depth|:
                    continue if index >= state.static_const_owners.count or state.static_const_names[index] != name
                    branch: (known: bool, active: bool) = ga_static_if_const_branch_selection(index, state, depth + 1)
                    if not branch.known:
                        if state.static_const_owners[index] == current_module:
                            exact_unknown <- true
                        elif state.static_const_owners[index] == "":
                            top_unknown <- true
                        any_unknown <- true
                        continue
                    continue if not branch.active
                    any_index <- index if any_matches == 0
                    any_matches <- any_matches + 1
                    if state.static_const_owners[index] == current_module:
                        exact_index <- index if exact_matches == 0
                        exact_matches <- exact_matches + 1
                    elif state.static_const_owners[index] == "":
                        top_index <- index if top_matches == 0
                        top_matches <- top_matches + 1
                exact_selected: bool = exact_matches > 0 or exact_unknown
                top_selected: bool = not exact_selected and (top_matches > 0 or top_unknown)
                selected_index: mutable usize = state.static_const_names.count
                if exact_selected:
                    return (false, 0, true) if exact_unknown or exact_matches != 1
                    selected_index <- exact_index
                elif top_selected:
                    return (false, 0, true) if top_unknown or top_matches != 1
                    selected_index <- top_index
                else:
                    return (false, 0, false) if any_matches == 0 and not any_unknown
                    return (false, 0, true) if any_unknown or any_matches != 1
                    selected_index <- any_index
                return (false, 0, true) if selected_index >= state.static_const_values.count
                selected_owner: sview = state.static_const_owners[selected_index]
                return ga_static_if_condition_value(state.static_const_values[selected_index], selected_owner, state, depth + 1)

        # The semantic pass folds literals, immutable source constants and operations
        # supported by BackendConstArithmetic. Target builtins use the same host inputs as
        # the backend. Unsupported expressions stay unknown.
        def ga_static_if_condition_value(expression: Ast::Expr, current_module: sview, state: GlobalAuthority&, depth: u32 = 0) -> (known: bool, value: i64, backend_folds: bool):
            can Abort.Panic:
                return (false, 0, true) if depth >= 64
                match expression:
                    Expr.BoolLit(value, _):
                        return (true, 1 if value else 0, true)
                    Expr.IntLit(value, _):
                        return (true, value, true)
                    Expr.Paren(inner, _):
                        return ga_static_if_condition_value(inner, current_module, state, depth + 1)
                    Expr.Ident(name, _):
                        target: (known: bool, value: i64) = ga_static_if_target_constant(name)
                        return (target.known, target.value, true) if target.known
                        return (false, 0, true) if ga_static_if_target_predicate(name)
                        return ga_static_if_named_constant_value(name, current_module, state, depth + 1)
                    Expr.Unary(operator, operand, _):
                        inner: (known: bool, value: i64, backend_folds: bool) = ga_static_if_condition_value(operand, current_module, state, depth + 1)
                        if operator == TokenKind.Plus:
                            return inner
                        if operator == TokenKind.Minus:
                            return (false, 0, inner.backend_folds) if not inner.known
                            return (false, 0, false) if not BackendConstArithmetic::negation_is_safe(inner.value)
                            return (true, 0 - inner.value, true)
                        if operator == TokenKind.Tilde:
                            return (false, 0, inner.backend_folds) if not inner.known
                            return (true, ~inner.value, true)
                        return (false, 0, false)
                    Expr.Binary(left, operator, right, _):
                        supported: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq or operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Caret or operator == TokenKind.Pipe or operator == TokenKind.Ampersand or operator == TokenKind.LShift or operator == TokenKind.RShift
                        return (false, 0, false) if not supported
                        left_value: (known: bool, value: i64, backend_folds: bool) = ga_static_if_condition_value(left, current_module, state, depth + 1)
                        right_value: (known: bool, value: i64, backend_folds: bool) = ga_static_if_condition_value(right, current_module, state, depth + 1)
                        if not left_value.known or not right_value.known:
                            return (false, 0, left_value.backend_folds and right_value.backend_folds)
                        if operator == TokenKind.EqEq:
                            return (true, 1 if left_value.value == right_value.value else 0, true)
                        if operator == TokenKind.BangEq:
                            return (true, 1 if left_value.value != right_value.value else 0, true)
                        if operator == TokenKind.Lt:
                            return (true, 1 if left_value.value < right_value.value else 0, true)
                        if operator == TokenKind.Gt:
                            return (true, 1 if left_value.value > right_value.value else 0, true)
                        if operator == TokenKind.LtEq:
                            return (true, 1 if left_value.value <= right_value.value else 0, true)
                        if operator == TokenKind.GtEq:
                            return (true, 1 if left_value.value >= right_value.value else 0, true)
                        if operator == TokenKind.And:
                            return (true, 1 if left_value.value != 0 and right_value.value != 0 else 0, true)
                        if operator == TokenKind.Or:
                            return (true, 1 if left_value.value != 0 or right_value.value != 0 else 0, true)
                        if operator == TokenKind.Plus:
                            return (false, 0, false) if not BackendConstArithmetic::add_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value + right_value.value, true)
                        if operator == TokenKind.Minus:
                            return (false, 0, false) if not BackendConstArithmetic::subtract_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value - right_value.value, true)
                        if operator == TokenKind.Star:
                            return (false, 0, false) if not BackendConstArithmetic::multiply_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value * right_value.value, true)
                        if operator == TokenKind.Slash:
                            return (false, 0, false) if not BackendConstArithmetic::division_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value / right_value.value, true)
                        if operator == TokenKind.Percent:
                            return (false, 0, false) if not BackendConstArithmetic::remainder_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value % right_value.value, true)
                        if operator == TokenKind.Caret:
                            return (true, left_value.value ^ right_value.value, true)
                        if operator == TokenKind.Pipe:
                            return (true, left_value.value | right_value.value, true)
                        if operator == TokenKind.Ampersand:
                            return (true, left_value.value & right_value.value, true)
                        if operator == TokenKind.LShift:
                            return (false, 0, false) if not BackendConstArithmetic::shift_count_is_safe(right_value.value)
                            return (true, left_value.value << right_value.value, true)
                        if operator == TokenKind.RShift:
                            return (false, 0, false) if not BackendConstArithmetic::shift_count_is_safe(right_value.value)
                            return (true, left_value.value >> right_value.value, true)
                        return (false, 0, false)
                    Expr.FloatLit(_, _):
                        return (false, 0, false)
                    Expr.StringLit(_, _):
                        return (false, 0, false)
                    _:
                        # Other AST forms include qualified constants and backend-specific
                        # const expressions; preserve uncertainty unless we can prove failure.
                        return (false, 0, true)

        # Mirror selected_static_if_rows' first-true/fallback policy for one branch row.
        # Backend treats a condition it cannot fold as false, then continues through later
        # elif arms and fallback. GA's own unknown is weaker: explicit target triples and
        # qualified constants may still be foldable by the backend, so preserve uncertainty.
        def ga_static_if_row_selection(branch_row: usize, current_module: sview, state: GlobalAuthority&, depth: u32 = 0) -> (known: bool, selected: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64 or branch_row >= state.static_if_lines.count or branch_row >= state.static_if_kinds.count
                branch_depth: u32 = state.static_if_depths[branch_row] if branch_row < state.static_if_depths.count else StaticIfBranch::TOP_LEVEL_DEPTH
                chain_start: mutable usize = state.static_if_lines.count
                row: mutable usize = branch_row + 1.usize()
                while row > 0 |row, chain_start, branch_depth, state|:
                    row <- row - 1.usize()
                    continue if row >= state.static_if_depths.count or state.static_if_depths[row] != branch_depth
                    if state.static_if_kinds[row] == StaticIfBranch::Kind.ChainHead:
                        chain_start <- row
                        break
                return (false, false) if chain_start >= state.static_if_lines.count
                for row in chain_start..<(branch_row + 1.usize()) |row, branch_row, branch_depth, current_module, state, depth|:
                    continue if row >= state.static_if_depths.count or state.static_if_depths[row] != branch_depth
                    branch_kind: StaticIfBranch::Kind = state.static_if_kinds[row]
                    if branch_kind == StaticIfBranch::Kind.Fallback:
                        return (true, row == branch_row)
                    return (false, false) if row >= state.static_if_conds.count or row >= state.static_if_modules.count
                    condition_module: sview = state.static_if_modules[row]
                    condition: (known: bool, value: i64, backend_folds: bool) = ga_static_if_condition_value(state.static_if_conds[row], condition_module, state, depth + 1)
                    if condition.known:
                        return (true, row == branch_row) if condition.value != 0
                    else:
                        return (false, false) if condition.backend_folds
                    return (true, false) if row == branch_row
                return (true, false)

        def ga_static_branch_marker_consider(marker_index: usize, marker_name: sview, detail_name: sview, module: sview, line: u32, offset: u32, current_module: sview, state: GlobalAuthority&, selection_depth: u32, found_marker: mutable bool&, unknown: mutable bool&) -> bool:
            can Abort.Panic:
                return false if marker_index >= state.annotations.count
                marker: Ast::EnumAnnotation = state.annotations[marker_index]
                return false if marker.owner != "__static_if_branch" or marker.name != marker_name or marker.detail_name != detail_name or marker.module != module or marker.line != line or marker.offset != offset
                found_marker <- true
                if marker.identity_id == 4294967295:
                    unknown <- true
                    return false
                branch: (known: bool, selected: bool) = ga_static_if_row_selection(marker.identity_id.usize(), current_module, state, selection_depth)
                return true if branch.known and not branch.selected
                unknown <- true if not branch.known
                return false

        # Query exact marker rows through the prepared source-ordered row view. The full
        # marker identity is still checked before evaluating a branch.
        def ga_static_branch_marker_selection(marker_name: sview, detail_name: sview, module: sview, line: u32, offset: u32, current_module: sview, state: GlobalAuthority&, selection_depth: u32 = 0) -> (found: bool, inactive: bool, unknown: bool):
            can Abort.Panic:
                found_marker: mutable bool = false
                unknown: mutable bool = false
                if state.module_alias_index_ready and state.module_alias_index_annotation_count == state.annotations.count:
                    for marker_row in 0..<state.static_branch_marker_rows.count |found_marker, unknown, marker_name, detail_name, module, line, offset, current_module, state, selection_depth|:
                        marker_index: usize = state.static_branch_marker_rows[marker_row]
                        return (true, true, unknown) if ga_static_branch_marker_consider(marker_index, marker_name, detail_name, module, line, offset, current_module, state, selection_depth, found_marker, unknown)
                else:
                    for marker_index in 0..<state.annotations.count |found_marker, unknown, marker_name, detail_name, module, line, offset, current_module, state, selection_depth|:
                        return (true, true, unknown) if ga_static_branch_marker_consider(marker_index, marker_name, detail_name, module, line, offset, current_module, state, selection_depth, found_marker, unknown)
                return (found_marker, false, unknown)

        def ga_static_branch_marker_exists(marker_name: sview, detail_name: sview, module: sview, line: u32, offset: u32, state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                if state.module_alias_index_ready and state.module_alias_index_annotation_count == state.annotations.count:
                    for marker_row in 0..<state.static_branch_marker_rows.count |marker_name, detail_name, module, line, offset, state|:
                        marker_index: usize = state.static_branch_marker_rows[marker_row]
                        marker: Ast::EnumAnnotation = state.annotations[marker_index]
                        return true if marker.owner == "__static_if_branch" and marker.name == marker_name and marker.detail_name == detail_name and marker.module == module and marker.line == line and marker.offset == offset
                    return false
                for marker in state.annotations:
                    return true if marker.owner == "__static_if_branch" and marker.name == marker_name and marker.detail_name == detail_name and marker.module == module and marker.line == line and marker.offset == offset
                return false

        # A parser marker is attached to each enclosing branch row for aliases nested inside
        # multiple static-if chains. Any known-false ancestor makes the alias inactive; any
        # unresolved ancestor makes the alias uncertain.
        def ga_module_alias_branch_selection(alias_index: usize, state: GlobalAuthority&) -> (known: bool, active: bool):
            can Abort.Panic:
                return (true, true) if alias_index >= state.annotations.count
                alias: Ast::EnumAnnotation = state.annotations[alias_index]
                markers: (found: bool, inactive: bool, unknown: bool) = ga_static_branch_marker_selection("__using_alias_static_branch", alias.owner, alias.module, alias.line, alias.offset, alias.module, state)
                return (true, false) if markers.inactive
                return (true, true) if not markers.found
                return (false, false) if markers.unknown
                return (true, true)

        # Imports carry the same per-ancestor parser markers as aliases. Exclude both
        # proven-inactive and unresolved branch imports from GlobalAuthority's resolver:
        # authority lookup must not gain a candidate from an arm whose selection is unknown.
        def ga_import_annotation_branch_selection(import_row: Ast::EnumAnnotation, state: GlobalAuthority&) -> (known: bool, active: bool):
            can Abort.Panic:
                marker_name: sview = "__from_member_static_branch" if import_row.owner == "__from_member" else "__binding_wildcard_import_static_branch"
                marker_detail: sview = import_row.name if import_row.owner == "__from_member" else import_row.owner
                return (true, true) if import_row.owner != "__from_member" and import_row.name != "__binding_wildcard_import"
                markers: (found: bool, inactive: bool, unknown: bool) = ga_static_branch_marker_selection(marker_name, marker_detail, import_row.module, import_row.line, import_row.offset, import_row.module, state)
                return (true, false) if markers.inactive
                return (true, true) if not markers.found
                return (false, false) if markers.unknown
                return (true, true)

        def ga_module_alias_is_static_branch(alias_index: usize, state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                return false if alias_index >= state.annotations.count
                alias: Ast::EnumAnnotation = state.annotations[alias_index]
                return ga_static_branch_marker_exists("__using_alias_static_branch", alias.owner, alias.module, alias.line, alias.offset, state)

        # Core registers a block's direct aliases before descending into child modules.
        # Within one block, aliases retain source order; unrelated blocks follow source
        # order because their module declarations are traversed in source order.
        def ga_module_alias_registration_precedes(left_scope: usize, left_offset: u32, left_index: usize, right_scope: usize, right_offset: u32, right_index: usize, state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                if left_scope == right_scope:
                    left_is_branch: bool = ga_module_alias_is_static_branch(left_index, state)
                    right_is_branch: bool = ga_module_alias_is_static_branch(right_index, state)
                    return false if left_is_branch and not right_is_branch
                    return true if not left_is_branch and right_is_branch
                    return left_offset < right_offset or (left_offset == right_offset and left_index < right_index)
                current: mutable usize = right_scope
                while current < state.parents.count |current, left_scope|:
                    return true if current == left_scope
                    break if current == 0
                    current <- state.parents[current]
                current <- left_scope
                while current < state.parents.count |current, right_scope|:
                    return false if current == right_scope
                    break if current == 0
                    current <- state.parents[current]
                return left_offset < right_offset or (left_offset == right_offset and left_index < right_index)

        # Alias-target recursion passes the declaration offset. Find that declaration's
        # registration position so ancestor aliases registered by Core's scope prepass
        # remain visible even when their source text appears later.
        def ga_module_alias_registration_index(scope: usize, offset: u32, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                if state.module_alias_index_ready and state.module_alias_index_annotation_count == state.annotations.count:
                    for alias_row in 0..<state.module_alias_rows.count |scope, offset, state|:
                        registration_index: usize = state.module_alias_rows[alias_row]
                        alias: Ast::EnumAnnotation = state.annotations[registration_index]
                        return registration_index if alias.name == "__using_alias" and alias.offset == offset and ga_module_text(alias.module, state) == scope
                    return state.annotations.count
                for alias_index in 0..<state.annotations.count:
                    alias: Ast::EnumAnnotation = state.annotations[alias_index]
                    continue if alias.name != "__using_alias" or alias.offset != offset
                    continue if ga_module_text(alias.module, state) != scope
                    return alias_index
                return state.annotations.count

        def ga_module_alias_choice_consider(alias_index: usize, name: sview, lexical_scope: usize, before_index: usize, before_offset: u32, source_positioned: bool, state: GlobalAuthority&, selected_index: mutable usize&, selected_scope: mutable usize&, uncertain_index: mutable usize&, uncertain_scope: mutable usize&) -> void:
            can Abort.Panic:
                return if alias_index >= state.annotations.count
                alias: Ast::EnumAnnotation = state.annotations[alias_index]
                return if alias.name != "__using_alias" or alias.owner != name
                alias_scope: usize = ga_module_text(alias.module, state)
                return if alias_scope >= state.modules.count
                if source_positioned:
                    if before_index < state.annotations.count:
                        before_alias: Ast::EnumAnnotation = state.annotations[before_index]
                        return if not ga_module_alias_registration_precedes(alias_scope, alias.offset, alias_index, lexical_scope, before_alias.offset, before_index, state)
                    else:
                        return if alias.offset >= before_offset
                branch_selection: (known: bool, active: bool) = ga_module_alias_branch_selection(alias_index, state)
                return if branch_selection.known and not branch_selection.active
                if not branch_selection.known:
                    if uncertain_index >= state.annotations.count:
                        uncertain_index <- alias_index
                        uncertain_scope <- alias_scope
                    else:
                        uncertain_alias: Ast::EnumAnnotation = state.annotations[uncertain_index]
                        if source_positioned:
                            if ga_module_alias_registration_precedes(uncertain_scope, uncertain_alias.offset, uncertain_index, alias_scope, alias.offset, alias_index, state):
                                uncertain_index <- alias_index
                                uncertain_scope <- alias_scope
                        else:
                            if ga_module_alias_registration_precedes(alias_scope, alias.offset, alias_index, uncertain_scope, uncertain_alias.offset, uncertain_index, state):
                                uncertain_index <- alias_index
                                uncertain_scope <- alias_scope
                    return
                if selected_index >= state.annotations.count:
                    selected_index <- alias_index
                    selected_scope <- alias_scope
                else:
                    selected_alias: Ast::EnumAnnotation = state.annotations[selected_index]
                    if source_positioned:
                        if ga_module_alias_registration_precedes(selected_scope, selected_alias.offset, selected_index, alias_scope, alias.offset, alias_index, state):
                            selected_index <- alias_index
                            selected_scope <- alias_scope
                    else:
                        if ga_module_alias_registration_precedes(alias_scope, alias.offset, alias_index, selected_scope, selected_alias.offset, selected_index, state):
                            selected_index <- alias_index
                            selected_scope <- alias_scope

        # Without a source cutoff, select the first program-wide alias Core registered
        # for a head. A source-positioned lookup instead selects the latest eligible
        # registration before that use, while preserving uncertainty from a later
        # conditional alias that could become the winner.
        def ga_module_alias_choice(name: sview, lexical_scope: usize, state: GlobalAuthority&, depth: u32 = 0, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> (found: bool, ambiguous: bool, index: usize, scope: usize):
            can Abort.Panic:
                return (false, false, state.annotations.count, state.modules.count) if lexical_scope >= state.parents.count
                selected_index: mutable usize = state.annotations.count
                selected_scope: mutable usize = state.modules.count
                before_index: usize = ga_module_alias_registration_index(lexical_scope, before_offset, state) if before_offset != GLOBAL_AUTHORITY_OFFSET_NONE else state.annotations.count
                source_positioned: bool = before_offset != GLOBAL_AUTHORITY_OFFSET_NONE
                uncertain_index: mutable usize = state.annotations.count
                uncertain_scope: mutable usize = state.modules.count
                if state.module_alias_index_ready and state.module_alias_index_annotation_count == state.annotations.count:
                    for alias_row in 0..<state.module_alias_rows.count |name, lexical_scope, before_index, before_offset, source_positioned, selected_index, selected_scope, uncertain_index, uncertain_scope, state|:
                        alias_index: usize = state.module_alias_rows[alias_row]
                        ga_module_alias_choice_consider(alias_index, name, lexical_scope, before_index, before_offset, source_positioned, state, selected_index, selected_scope, uncertain_index, uncertain_scope)
                else:
                    for alias_index in 0..<state.annotations.count |name, lexical_scope, before_index, before_offset, source_positioned, selected_index, selected_scope, uncertain_index, uncertain_scope, state|:
                        alias: Ast::EnumAnnotation = state.annotations[alias_index]
                        continue if alias.name != "__using_alias" or alias.owner != name
                        ga_module_alias_choice_consider(alias_index, name, lexical_scope, before_index, before_offset, source_positioned, state, selected_index, selected_scope, uncertain_index, uncertain_scope)
                if uncertain_index < state.annotations.count:
                    if selected_index >= state.annotations.count:
                        return (true, true, uncertain_index, uncertain_scope)
                    selected_alias: Ast::EnumAnnotation = state.annotations[selected_index]
                    uncertain_alias: Ast::EnumAnnotation = state.annotations[uncertain_index]
                    if source_positioned:
                        return (true, true, uncertain_index, uncertain_scope) if ga_module_alias_registration_precedes(selected_scope, selected_alias.offset, selected_index, uncertain_scope, uncertain_alias.offset, uncertain_index, state)
                    else:
                        return (true, true, uncertain_index, uncertain_scope) if ga_module_alias_registration_precedes(uncertain_scope, uncertain_alias.offset, uncertain_index, selected_scope, selected_alias.offset, selected_index, state)
                return (selected_scope < state.modules.count, false, selected_index, selected_scope)

        # Alias target rows are paired by the alias token's full declaration identity.
        def ga_module_alias_target_path(module: sview, line: u32, offset: u32, state: GlobalAuthority&) -> (found: bool, path: sview @source):
            can Abort.Panic:
                target_path: mutable sview @source = ""
                target_count: mutable usize = 0
                for target in state.annotations:
                    continue if target.name != "__using_alias_target" or target.offset != offset or target.line != line or target.module != module
                    target_path <- target.owner
                    target_count <- target_count + 1
                return (target_count == 1, target_path)

        def ga_module_alias_raw_segment_count(path: sview @source, start_index: usize = 0) -> (valid: bool, count: usize):
            can Abort.Panic:
                return (false, 0.usize()) if start_index > path.len
                return (true, 0.usize()) if start_index == path.len
                start: mutable usize = start_index
                count: mutable usize = 0.usize()
                while start < path.len |start, count|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    return (false, 0.usize()) if effect_ref_trim_layout(path[start:end]).len == 0
                    count <- count + 1.usize()
                    return (false, 0.usize()) if end < path.len and (end + 2 >= path.len or path[end + 1] != 58)
                    start <- path.len if end == path.len else end + 2
                return (true, count)

        def ga_module_alias_raw_segment_at(path: sview @source, start_index: usize, target_index: usize) -> (found: bool, segment: sview @source):
            can Abort.Panic:
                return (false, "") if start_index > path.len
                start: mutable usize = start_index
                current: mutable usize = 0.usize()
                while start < path.len |start, current, target_index|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    part: sview @source = effect_ref_trim_layout(path[start:end])
                    return (false, "") if part.len == 0 or (end < path.len and (end + 2 >= path.len or path[end + 1] != 58))
                    return (true, part) if current == target_index
                    current <- current + 1.usize()
                    start <- path.len if end == path.len else end + 2
                return (false, "")

        # Count the canonical path without allocating. Unresolved module names still
        # compare by their declaration-scope-qualified segments, preserving idempotent
        # duplicate aliases even when their target module has not been declared.
        def ga_module_alias_target_segment_count(path: sview @source, declaration_scope: usize, state: GlobalAuthority&, before_offset: u32, depth: u32 = 0) -> (valid: bool, count: usize):
            can Abort.Panic:
                return (false, 0.usize()) if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT or declaration_scope >= state.modules.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return (false, 0.usize()) if first.len == 0 or (first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58))
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, declaration_scope, state, depth, before_offset)
                return (false, 0.usize()) if alias.ambiguous
                suffix_start: usize = path.len if first_end == path.len else first_end + 2
                suffix_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(path, suffix_start)
                return (false, 0.usize()) if not suffix_count.valid
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    return (false, 0.usize()) if not target.found
                    target_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(target.path, alias.scope, state, alias_row.offset, depth + 1)
                    return (false, 0.usize()) if not target_count.valid
                    return (true, target_count.count + suffix_count.count)
                scope_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(state.modules[declaration_scope], 0.usize())
                path_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(path, 0.usize())
                return (false, 0.usize()) if not scope_count.valid or not path_count.valid
                return (true, scope_count.count + path_count.count)

        def ga_module_alias_target_segment_at(path: sview @source, declaration_scope: usize, state: GlobalAuthority&, before_offset: u32, target_index: usize, depth: u32 = 0) -> (found: bool, segment: sview @source):
            can Abort.Panic:
                return (false, "") if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT or declaration_scope >= state.modules.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return (false, "") if first.len == 0 or (first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58))
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, declaration_scope, state, depth, before_offset)
                return (false, "") if alias.ambiguous
                suffix_start: usize = path.len if first_end == path.len else first_end + 2
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    return (false, "") if not target.found
                    target_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(target.path, alias.scope, state, alias_row.offset, depth + 1)
                    return (false, "") if not target_count.valid
                    if target_index < target_count.count:
                        return ga_module_alias_target_segment_at(target.path, alias.scope, state, alias_row.offset, target_index, depth + 1)
                    return ga_module_alias_raw_segment_at(path, suffix_start, target_index - target_count.count)
                scope_count: (valid: bool, count: usize) = ga_module_alias_raw_segment_count(state.modules[declaration_scope], 0.usize())
                return (false, "") if not scope_count.valid
                if target_index < scope_count.count:
                    return ga_module_alias_raw_segment_at(state.modules[declaration_scope], 0.usize(), target_index)
                return ga_module_alias_raw_segment_at(path, 0.usize(), target_index - scope_count.count)

        def ga_module_alias_targets_equal(left_path: sview @source, left_scope: usize, left_before_offset: u32, right_path: sview @source, right_scope: usize, right_before_offset: u32, state: GlobalAuthority&, depth: u32) -> bool:
            can Abort.Panic:
                left_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(left_path, left_scope, state, left_before_offset, depth)
                right_count: (valid: bool, count: usize) = ga_module_alias_target_segment_count(right_path, right_scope, state, right_before_offset, depth)
                return false if not left_count.valid or not right_count.valid or left_count.count != right_count.count
                for index in 0..<left_count.count:
                    left_segment: (found: bool, segment: sview @source) = ga_module_alias_target_segment_at(left_path, left_scope, state, left_before_offset, index, depth)
                    right_segment: (found: bool, segment: sview @source) = ga_module_alias_target_segment_at(right_path, right_scope, state, right_before_offset, index, depth)
                    return false if not left_segment.found or not right_segment.found or left_segment.segment != right_segment.segment
                return true

        def ga_module_lexical_child(name: sview, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current < state.parents.count |current|:
                    child: usize = ga_child(state, current, name)
                    return child if child < state.modules.count
                    break if current == 0
                    current <- state.parents[current]
                return state.modules.count

        # Resolve a complete module path through non-root lexical namespaces. Root lookup
        # is intentionally left until after alias rewriting at a use site.
        def ga_module_lexical_path(path: sview, first: sview, start_index: usize, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current != 0 and current < state.parents.count |current|:
                    child: usize = ga_child(state, current, first)
                    if child < state.modules.count:
                        candidate: usize = ga_module_path_suffix(path, start_index, child, state)
                        return candidate if candidate < state.modules.count
                    current <- state.parents[current]
                return state.modules.count

        def ga_module_path_suffix(path: sview, start_index: usize, base_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if base_scope >= state.modules.count or start_index > path.len
                current: mutable usize = base_scope
                start: mutable usize = start_index
                while start < path.len |start, current|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    part: sview = effect_ref_trim_layout(path[start:end])
                    return state.modules.count if part.len == 0
                    current <- ga_child(state, current, part)
                    return state.modules.count if current >= state.modules.count
                    return state.modules.count if end < path.len and (end + 2 >= path.len or path[end + 1] != 58)
                    start <- path.len if end == path.len else end + 2
                return current

        # Split a qualified source path into borrowed components. Keeping the original
        # spelling as parts lets expression lookup apply lexical, alias, and raw-root
        # candidates to the complete qualifier instead of resolving one Expr.Scope node
        # at a time.
        def ga_module_path_parts(path: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                return [] if path.len == 0
                parts: mutable darray[sview] = []
                start: mutable usize = 0
                offset: mutable usize = 0
                while offset < path.len |start, offset, parts, path|:
                    if path[offset] == 58:
                        return [] if offset + 1.usize() >= path.len or path[offset + 1.usize()] != 58
                        parts.push(effect_ref_trim_layout(path[start:offset]))
                        offset <- offset + 2.usize()
                        start <- offset
                    else:
                        offset <- offset + 1.usize()
                parts.push(effect_ref_trim_layout(path[start:path.len]))
                return parts

        def ga_module_path_parts_suffix(parts: darray[sview]&, start_index: usize, base_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if base_scope >= state.modules.count or start_index > parts.count
                current: mutable usize = base_scope
                index: mutable usize = start_index
                while index < parts.count |current, index, parts, state|:
                    return state.modules.count if parts[index].len == 0
                    current <- ga_child(state, current, parts[index])
                    return state.modules.count if current >= state.modules.count
                    index <- index + 1.usize()
                return current

        # Stage0 checks a complete candidate in the current namespace, then each
        # enclosing namespace. The root spelling is deliberately left for after alias
        # rewriting, because a visible alias beats a same-named root module.
        def ga_module_lexical_parts_path(parts: darray[sview]&, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if parts.count == 0 or lexical_scope >= state.parents.count
                current: mutable usize = lexical_scope
                while current != 0 and current < state.parents.count |current, parts, state|:
                    child: usize = ga_child(state, current, parts[0])
                    if child < state.modules.count:
                        candidate: usize = ga_module_path_parts_suffix(parts, 1, child, state)
                        return candidate if candidate < state.modules.count
                    current <- state.parents[current]
                return state.modules.count

        def ga_module_parts_resolve(parts: darray[sview]&, lexical_scope: usize, state: GlobalAuthority&, depth: u32 = 0, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if parts.count == 0 or lexical_scope >= state.parents.count
                for part in parts:
                    return state.modules.count if part.len == 0
                lexical: usize = ga_module_lexical_parts_path(parts, lexical_scope, state)
                return lexical if lexical < state.modules.count

                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(parts[0], lexical_scope, state, depth, before_offset)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    if target.found:
                        resolved: usize = ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1, alias_row.offset)
                        return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                        if resolved < state.modules.count:
                            alias_path: usize = ga_module_path_parts_suffix(parts, 1, resolved, state)
                            return alias_path if alias_path < state.modules.count

                # The final Stage0 candidate is the raw spelling in the root namespace.
                raw_root: usize = ga_child(state, 0, parts[0])
                return ga_module_path_parts_suffix(parts, 1, raw_root, state)

        def ga_module_expression_parts(expression: Ast::Expr, parts: mutable darray[sview]&, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT
                match expression:
                    Expr.Ident(name, _):
                        parts.push(effect_ref_trim_layout(name))
                        return true
                    Expr.Scope(base, name, _):
                        return false if not ga_module_expression_parts(base, parts, depth + 1)
                        parts.push(effect_ref_trim_layout(name))
                        return true
                    Expr.Paren(inner, _):
                        return ga_module_expression_parts(inner, parts, depth + 1)
                    _:
                        return false

        # Resolve an unaliased target relative to exactly the module where its alias was
        # declared. Do not climb to a same-named root module; the using-site resolver owns
        # fallback to the alias's raw spelling when this canonical target is absent.
        def ga_module_path_exact(path: sview, declaration_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return state.modules.count if declaration_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                first_scope: usize = ga_child(state, declaration_scope, first)
                return state.modules.count if first_scope >= state.modules.count
                start: usize = path.len if first_end == path.len else first_end + 2
                return ga_module_path_suffix(path, start, first_scope, state)

        # Resolve a `using TARGET as ALIAS` target. A complete concrete candidate in the
        # declaration module wins before an earlier visible alias can rewrite its head.
        # Any alias rewrite still uses only declarations earlier than the current alias,
        # matching Stage0 registration order; unresolved targets stay anchored here.
        def ga_module_alias_target_resolve(path: sview @source, declaration_scope: usize, state: GlobalAuthority&, depth: u32 = 0, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if declaration_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                exact_path: usize = ga_module_path_exact(path, declaration_scope, state)
                return exact_path if exact_path < state.modules.count
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, declaration_scope, state, depth, before_offset)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                return exact_path if not alias.found
                alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                return GLOBAL_AUTHORITY_NONE if not target.found
                resolved: usize = ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1, alias_row.offset)
                return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                return state.modules.count if resolved >= state.modules.count
                start: usize = path.len if first_end == path.len else first_end + 2
                return ga_module_path_suffix(path, start, resolved, state)

        # Resolve a module path at a use site. A complete concrete candidate in the
        # current or enclosing namespace wins first, then a visible alias rewrites the
        # head, then the original spelling is tried at root. Import annotations keep
        # their own lookup order and call this helper with use_site_child_precedence=false.
        def ga_module_alias_resolve(path: sview, lexical_scope: usize, state: GlobalAuthority&, depth: u32 = 0, use_site_child_precedence: bool = false, before_offset: u32 = GLOBAL_AUTHORITY_OFFSET_NONE) -> usize:
            can Abort.Panic:
                if depth > GLOBAL_AUTHORITY_WALK_DEPTH_LIMIT:
                    return GLOBAL_AUTHORITY_NONE
                return state.modules.count if lexical_scope >= state.parents.count or path.len == 0
                first_end: mutable usize = 0
                while first_end < path.len and path[first_end] != 58 |first_end|:
                    first_end <- first_end + 1
                first: sview = effect_ref_trim_layout(path[0:first_end])
                return state.modules.count if first.len == 0
                return state.modules.count if first_end < path.len and (first_end + 2 >= path.len or path[first_end + 1] != 58)
                start: usize = path.len if first_end == path.len else first_end + 2
                if use_site_child_precedence:
                    lexical_path: usize = ga_module_lexical_path(path, first, start, lexical_scope, state)
                    return lexical_path if lexical_path < state.modules.count
                alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice(first, lexical_scope, state, depth, before_offset)
                return GLOBAL_AUTHORITY_NONE if alias.ambiguous
                resolved: mutable usize = state.modules.count
                if alias.found:
                    alias_row: Ast::EnumAnnotation = state.annotations[alias.index]
                    target: (found: bool, path: sview @source) = ga_module_alias_target_path(alias_row.module, alias_row.line, alias_row.offset, state)
                    if not target.found:
                        return GLOBAL_AUTHORITY_NONE if not use_site_child_precedence
                    else:
                        resolved <- ga_module_alias_target_resolve(target.path, alias.scope, state, depth + 1, alias_row.offset)
                        return GLOBAL_AUTHORITY_NONE if resolved == GLOBAL_AUTHORITY_NONE
                if use_site_child_precedence:
                    if alias.found and resolved < state.modules.count:
                        alias_path: usize = ga_module_path_suffix(path, start, resolved, state)
                        return alias_path if alias_path < state.modules.count
                    raw_root: usize = ga_child(state, 0, first)
                    return ga_module_path_suffix(path, start, raw_root, state)
                if not alias.found or resolved >= state.modules.count:
                    resolved <- ga_module_lexical_child(first, lexical_scope, state)
                return state.modules.count if resolved >= state.modules.count
                return ga_module_path_suffix(path, start, resolved, state)
