# Stage1 semantic — operator operand typing (`extend Semantic: private:`).
# `check_operator_operands` decides which operand pairs are comparable or arithmetic-
# compatible, plus value-match exhaustiveness. Continues resolve_types_match.elisa;
# split out to keep each part file under 600 lines.

extend Semantic:
    private:
        def check_operator_operands(expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.Binary(left, operator, right, line):
                        table <- check_operator_operands(left, names, types, table)
                        # `x in LO..HI` is a membership test over a range set — there the bare
                        # `..` is an unambiguous inclusive range (stage0 accepts it), so don't
                        # descend into the range RHS (which would raise the bare-`..` diagnostic).
                        range_rhs_of_in: bool = operator == TokenKind.In and expr_is_bare_range(right)
                        table <- check_operator_operands(right, names, types, table) if not range_rhs_of_in
                        match operator:
                            TokenKind.Range:
                                # stage0 rejects the bare `..` range outright — the
                                # exclusive/inclusive intent must be spelled. The one legal
                                # bare `..` is the STEP separator of a stepped range
                                # (`0..<10..2`), whose left operand is itself a spelled range.
                                left_is_spelled_range: bool = match left:
                                    Expr.Binary(step_left, step_operator, step_right, step_line): step_operator in {TokenKind.RangeLt, TokenKind.RangeGt, TokenKind.RangeLe}
                                    _: false
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AmbiguousBareRange, name: "", line: line, expected: "", actual: ""}) if not left_is_spelled_range
                            TokenKind.And | TokenKind.Or:
                                left_type: InferType = infer_expression_type(left, names, types, table)
                                right_type: InferType = infer_expression_type(right, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: token_text(operator), line: line, expected: "bool", actual: family_of_kind(left_type)}) if kind_is_firm_non_bool(left_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: token_text(operator), line: line, expected: "bool", actual: family_of_kind(right_type)}) if kind_is_firm_non_bool(right_type)
                            TokenKind.Plus | TokenKind.Minus | TokenKind.Star | TokenKind.Slash | TokenKind.Percent:
                                left_type: InferType = infer_expression_type(left, names, types, table)
                                right_type: InferType = infer_expression_type(right, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(operator), line: line, expected: "number", actual: family_of_kind(left_type)}) if kind_is_firm_non_numeric(left_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(operator), line: line, expected: "number", actual: family_of_kind(right_type)}) if kind_is_firm_non_numeric(right_type)
                            TokenKind.In:
                                # `x in RHS` requires a LIST LITERAL or tokenset RHS —
                                # a container-typed value is rejected by stage0 outright
                                # (use `.contains`/lookup instead). Fires only on a firm
                                # structural Container.
                                # `set` is the ONE container that IS a valid membership RHS —
                                # it is what the operator is for. MEASURED with the std
                                # prepended, through -emit obj:
                                #     k in set[i64]/[cstr]/[bool]/[char]   ACCEPTED
                                #     k in darray, dict, array, sview      rejected
                                # Flagging every Container rejected all four accepted rows,
                                # i.e. stage1 refused valid programs. (A set whose ELEMENT
                                # type has no value equality is a different rule, owned by
                                # check_set_membership_element.elisa.)
                                membership_right_type: InferType = infer_expression_type(right, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MembershipRhsContainer, name: "", line: line, expected: "", actual: membership_right_type.name, detail: container_elem_spelling_of(right, names, types, table)}) if membership_right_type.kind == SemTypeKind.Container and membership_right_type.name != "set"
                            TokenKind.EqEq | TokenKind.BangEq:
                                left_type: InferType = infer_expression_type(left, names, types, table)
                                right_type: InferType = infer_expression_type(right, names, types, table)
                                left_group: u8 = comparison_group(left_type)
                                right_group: u8 = comparison_group(right_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IncompatibleComparison, name: token_text(operator), line: line, expected: stage0_operand_spelling(left, left_type), actual: stage0_operand_spelling(right, right_type), detail: container_elem_spelling_of(left, names, types, table) if left_type.kind == SemTypeKind.Container else container_elem_spelling_of(right, names, types, table)}) if left_group != 0 and right_group != 0 and left_group != right_group and not comparison_string_literal_adapts(left, left_type, right, right_type)
                                # `x == null` where x cannot BE null. `null` infers as no
                                # comparison group at all (group 0), so the cross-group wall
                                # above never fired and stage1 accepted it. MEASURED, both
                                # operand orders, matching stage0:
                                #     x == null   x: i64    cannot compare i64 and null
                                #     null == x   x: i64    cannot compare null and i64
                                #     x != null   x: cstr   cannot compare cstr and null
                                #     b == null   b: bool   cannot compare bool and null
                                #     x: i64?  and  p: P&?  ACCEPTED
                                # Scalar kinds only (return_kind_cannot_hold_null): Named and
                                # Container were not measured here, and an affine `P!` accepts
                                # null elsewhere, so they stay a conservative miss.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IncompatibleComparison, name: token_text(operator), line: line, expected: stage0_operand_spelling(left, left_type), actual: "null"}) if expression_is_null(right) and return_kind_cannot_hold_null(left_type.kind)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IncompatibleComparison, name: token_text(operator), line: line, expected: "null", actual: stage0_operand_spelling(right, right_type)}) if expression_is_null(left) and return_kind_cannot_hold_null(right_type.kind)
                            TokenKind.Is:
                                # The right side is syntax, not a value. Only a declared
                                # enum variant makes this a variant test; other refinement
                                # forms remain outside this check.
                                if right is Expr.Field(Expr.Ident(variant_owner, owner_line), variant_name, variant_line):
                                    valid_variant_target: bool = is_enum_name(table, variant_owner) and enum_has_variant(table, variant_owner, variant_name)
                                    tested_type: InferType = infer_expression_type(left, names, types, table)
                                    # `e is Child.Variant` where `e: Root` and `enum Child is Root`
                                    # is a valid hierarchy variant test — the tested value's enum
                                    # need only be related to the variant's owner, not identical.
                                    hierarchy_related: bool = tested_type.kind == SemTypeKind.Named and (tested_type.name == variant_owner or enum_in_hierarchy(variant_owner, tested_type.name, table) or enum_in_hierarchy(tested_type.name, variant_owner, table))
                                    wrong_firm_type: bool = tested_type.kind != SemTypeKind.Unknown and not hierarchy_related
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidVariantTestOperand, name: variant_owner, line: line, expected: variant_owner, actual: comparison_type_name(tested_type)}) if valid_variant_target and wrong_firm_type
                                # `EXPR is Enum` (bare enum name on the RHS): the tested value's enum
                                # type must be that enum or related to it in the hierarchy; a
                                # completely unrelated known enum is rejected.
                                if right is Expr.Ident(enum_target, enum_target_line):
                                    is_target_enum: bool = is_enum_name(table, enum_target)
                                    target_tested_type: InferType = infer_expression_type(left, names, types, table)
                                    firm_named: bool = target_tested_type.kind == SemTypeKind.Named and target_tested_type.name != ""
                                    related_enum: bool = firm_named and (target_tested_type.name == enum_target or enum_in_hierarchy(enum_target, target_tested_type.name, table) or enum_in_hierarchy(target_tested_type.name, enum_target, table))
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IsUnrelatedEnum, name: enum_target, line: line, expected: target_tested_type.name, actual: ""}) if is_target_enum and firm_named and not related_enum
                            _:
                                pass
                    Ast::Expr.Unary(operator, operand, line):
                        table <- check_operator_operands(operand, names, types, table)
                        match operator:
                            TokenKind.Not:
                                operand_type: InferType = infer_expression_type(operand, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: "not", line: line, expected: "bool", actual: family_of_kind(operand_type)}) if kind_is_firm_non_bool(operand_type)
                            TokenKind.Minus | TokenKind.Tilde:
                                operand_type: InferType = infer_expression_type(operand, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnaryOperandNonNumeric, name: token_text(operator), line: line, expected: "number", actual: family_of_kind(operand_type)}) if kind_is_firm_non_numeric(operand_type)
                            _:
                                pass
                    Ast::Expr.Paren(inner, line):
                        table <- check_operator_operands(inner, names, types, table)
                    Ast::Expr.If(condition, then_expression, else_expression, line):
                        table <- check_operator_operands(condition, names, types, table)
                        table <- check_operator_operands(then_expression, names, types, table)
                        table <- check_operator_operands(else_expression, names, types, table)
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table| -> table:
                            table <- check_operator_operands(argument, names, types, table)
                        table <- check_atomic_rmw_call(callee, arguments, line, names, types, table)
                        # Value-constructor walls (Phase C item 104): `T(x)` with a
                        # primitive T rejects a KNOWN-container argument outright and a
                        # numeric argument into bool (oracle: "invalid cast from int to
                        # bool" / "from darray[i64] to i64"). `i64("txt")` (parse) and
                        # numeric<->numeric stay legal and silent.
                        if callee is Expr.Ident(ctor_name, ctor_line) and arguments.count == 1:
                            ctor_target: InferType = type_of_name(ctor_name)
                            is_primitive_ctor: bool = ctor_target.kind == SemTypeKind.Int or ctor_target.kind == SemTypeKind.Float or ctor_target.kind == SemTypeKind.Bool or ctor_target.kind == SemTypeKind.Char or ctor_target.kind == SemTypeKind.String
                            if is_primitive_ctor:
                                ctor_argument: InferType = infer_expression_type(arguments[0], names, types, table)
                                is_known_container_arg: bool = ctor_argument.kind == SemTypeKind.Container and (ctor_argument.name == "darray" or ctor_argument.name == "dict" or ctor_argument.name == "set" or ctor_argument.name == "list" or ctor_argument.name == "array")
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidCtorCast, name: ctor_name, line: line, expected: ctor_name, actual: "container"}) if is_known_container_arg
                                ctor_argument_literal: sview = literal_kind_of(arguments[0])
                                argument_numeric: bool = ctor_argument_literal == "int" or ctor_argument_literal == "float" or ctor_argument.kind == SemTypeKind.Int or ctor_argument.kind == SemTypeKind.Float
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidCtorCast, name: ctor_name, line: line, expected: "bool", actual: "int" if ctor_argument_literal == "int" or ctor_argument.kind == SemTypeKind.Int else "float"}) if ctor_target.kind == SemTypeKind.Bool and argument_numeric
                        # Enum/error payload constructor arguments use the payload types
                        # retained during symbol collection. Unknown expression families
                        # remain silent; only firm incompatibilities are diagnosed.
                        if callee is Expr.Field(constructor_object, constructor_variant, constructor_line):
                            if constructor_object is Expr.Ident(constructor_owner, owner_line) and is_enum_name(table, constructor_owner):
                                while payload_index < arguments.count and payload_index < table.enum_payload_owner.count |payload_index: usize = 0|:
                                    # Payload rows are grouped by owner/variant in declaration order.
                                    seen_position: mutable usize = 0
                                    while row_index < table.enum_payload_owner.count |row_index: usize = 0|:
                                        if table.enum_payload_owner[row_index] == constructor_owner and table.enum_payload_variant[row_index] == constructor_variant:
                                            if seen_position == payload_index:
                                                expected_payload: sview = table.enum_payload_type[row_index]
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorConstructorArgumentType, name: constructor_variant, line: line, expected: expected_payload, actual: constructor_owner, expected_count: payload_index.u32() + 1}) if constructor_argument_never_fits(arguments[payload_index], expected_payload, names, types, table)
                                            seen_position <- seen_position + 1
                                        row_index <- row_index + 1
                                    payload_index <- payload_index + 1
                        # `xs.push(v)` element wall (Phase C): the argument must inhabit
                        # the darray's element type (oracle: "darray push expects i64,
                        # got …"). Only darray heads with a known scalar element flag.
                        if callee is Expr.Field(push_receiver, method_name, method_line) and method_name == "push" and arguments.count == 1:
                            # `s.field.push(v)` on a field NOT declared mutable is a
                            # mutation of immutable storage (stage0's mutable-receiver wall).
                            if push_receiver is Expr.Field(field_owner_expr, receiver_field_name, receiver_field_line):
                                owner_type: InferType = infer_expression_type(field_owner_expr, names, types, table)
                                if owner_type.kind == SemTypeKind.Named:
                                    field_row: mutable usize = 0
                                    while field_row < table.struct_field_owner.count |field_row, table|:
                                        if table.struct_field_owner[field_row] == owner_type.name and table.struct_field_name[field_row] == receiver_field_name:
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayPushImmutableReceiver, name: "", line: line, expected: "", actual: ""}) if not table.struct_field_mutable[field_row]
                                            break
                                        field_row <- field_row + 1
                            receiver_id: u32 = structural_type_id_of(push_receiver, names, types, table)
                            is_darray: bool = interned_kind(receiver_id, table) == SemTypeKind.Container and interned_name(receiver_id, table) == "darray"
                            element_spelling: sview = type_name_of_row(interned_elem(receiver_id, 0, table), table) if is_darray else ""
                            if element_spelling != "":
                                pushed_literal: sview = literal_kind_of(arguments[0])
                                pushed_family: sview = infer_family(arguments[0], names, types, table) if pushed_literal == "" else ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayPushTypeMismatch, name: "", line: line, expected: element_spelling, actual: stage0_literal_spelling(pushed_literal)}) if pushed_literal != "" and literal_never_fits(pushed_literal, element_spelling)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayPushTypeMismatch, name: "", line: line, expected: element_spelling, actual: infer_spelling(arguments[0], names, types, table)}) if pushed_family != "" and firm_never_fits(pushed_family, element_spelling)
                    Ast::Expr.Index(object, index, line):
                        table <- check_operator_operands(object, names, types, table)
                        # `recv.cast[T]`: the bracket is a TYPE, not a value operand — don't
                        # recurse into it. Instead, if `recv` is an identifier whose declared
                        # type is a numeric primitive and `T` is a DIFFERENT numeric primitive,
                        # the `.cast` is a value conversion (stage0 requires a constructor).
                        is_cast: mutable bool = false
                        if object is Expr.Field(receiver, cast_field, cast_field_line):
                            is_cast <- true if cast_field == "cast"
                            if receiver is Expr.Ident(receiver_name, receiver_name_line) and cast_field == "cast":
                                if index is Expr.Ident(target_type_name, target_type_line):
                                    receiver_type_name: sview = local_type_of(names, types, receiver_name)
                                    receiver_numeric: bool = is_integer_type_name(receiver_type_name) or is_float_type_name(receiver_type_name)
                                    destination_numeric: bool = is_integer_type_name(target_type_name) or is_float_type_name(target_type_name)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidCast, name: target_type_name, line: line, expected: receiver_type_name, actual: ""}) if receiver_numeric and destination_numeric and receiver_type_name != target_type_name
                        table <- check_operator_operands(index, names, types, table) if not is_cast
                        # Dict READ key wall (Phase C): `d[k]` in value position with a
                        # key that can never inhabit the declared key type (the `<-`
                        # assignment form is walled in the Assign walk).
                        if not is_cast:
                            read_container_id: u32 = structural_type_id_of(object, names, types, table)
                            is_dict_read: bool = interned_kind(read_container_id, table) == SemTypeKind.Container and interned_name(read_container_id, table) == "dict"
                            read_key_spelling: sview = type_name_of_row(interned_elem(read_container_id, 0, table), table) if is_dict_read else ""
                            if read_key_spelling != "":
                                # The key TYPE itself may be unusable as a hash key, whatever
                                # the index expression is — checked beside the key VALUE wall
                                # below, since both need the same resolved key spelling.
                                read_value_spelling: sview = type_name_of_row(interned_elem(read_container_id, 1, table), table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RuntimeDictKeyUnsupported, name: "", line: line, expected: read_key_spelling, actual: read_value_spelling}) if dict_key_type_unsupported(read_key_spelling)
                                read_key_literal: sview = literal_kind_of(index)
                                read_key_family: sview = infer_family(index, names, types, table) if read_key_literal == "" else ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictIndexKeyTypeMismatch, name: "", line: line, expected: read_key_spelling, actual: stage0_literal_spelling(read_key_literal)}) if read_key_literal != "" and literal_never_fits(read_key_literal, read_key_spelling)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictIndexKeyTypeMismatch, name: "", line: line, expected: read_key_spelling, actual: read_key_family}) if read_key_family != "" and firm_never_fits(read_key_family, read_key_spelling)
                    _:
                        pass


        # A short spelling of an operator token for diagnostics ("and"/"or"/"+"/…).
        def token_text(operator: TokenKind) -> sview:
            can Abort.Panic:
                return when operator:
                    TokenKind.And -> "and"
                    TokenKind.Or -> "or"
                    TokenKind.Plus -> "+"
                    TokenKind.Minus -> "-"
                    TokenKind.Star -> "*"
                    TokenKind.Slash -> "/"
                    TokenKind.Percent -> "%"
                    TokenKind.Tilde -> "~"
                    _ -> "?"


        # docs/125 R2 / stage0 parity: an EXPRESSION-position match or when (`x = match e:`,
        # `return when e:`) must be exhaustive too. The statement walker's Stmt.Match arm
        # only reaches STATEMENT-form matches; this catches the Expr.Match a value
        # initializer / return / assignment carries. It bails on non-enum scrutinees exactly
        # like check_match_exhaustive (open-scalar `_`-required totality is a separate,
        # later rule), so it can only add enum-totality — and stage0 already enforces this,
        # so stage1's own (accepted) source stays clean.
        def arm_pattern_is_wildcard(pattern: Ast::Pattern) -> bool:
            return match pattern:
                Ast::Pattern.Wildcard: true
                _:                     false


        # An unguarded catch-all arm (`_` or a bare binding) makes any match total.
        def match_has_catch_all(arms: darray[Ast::MatchArm]) -> bool:
            for arm in arms:
                guarded: bool = match arm.guard:
                    Ast::Expr.Invalid: false
                    Ast::Expr.Absent: false
                    _:                 true
                if not guarded:
                    is_catch_all: bool = match arm.pattern:
                        Ast::Pattern.Wildcard:      true
                        Ast::Pattern.Binding(name): true
                        # A MULTI-COLUMN default is `_, _` — a Tuple of wildcards, not a bare
                        # Wildcard. It is every bit as much a catch-all, and reading it as a
                        # specific row is what made the totality rules below blind to it.
                        Ast::Pattern.Tuple(elements): elements.count > 0 and not (any element in elements where not arm_pattern_is_wildcard(element))
                        _:                          false
                    true return if is_catch_all
            return false

        def check_value_match_exhaustive(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            match value:
                Ast::Expr.Match(scrutinee, arms, match_line):
                    table <- check_match_exhaustive(scrutinee, arms, match_line, names, types, table)
                    table <- check_sequence_match_arm_types(scrutinee, arms, match_line, names, types, table)
                    # docs/125 R2: a value-producing match/when over an OPEN scalar domain
                    # (int/char/string/float) with no `_` cannot yield a value for every
                    # input. Enum scrutinees infer_family to "" (handled above), so this only
                    # adds open-scalar totality and never double-reports.
                    if not match_has_catch_all(arms):
                        # A TUPLE scrutinee is the multi-column `when a, b:` table. Its domain
                        # is the PRODUCT of its columns, so no enumeration of rows makes it
                        # total — stage0 demands a final `_` row unconditionally ("non-exhaustive
                        # tuple match expression"), including for two `bool` columns whose four
                        # combinations are all spelled out. infer_family reports "" for a tuple,
                        # so without this arm stage1 ACCEPTED what stage0 rejects.
                        tuple_scrutinee: bool = match scrutinee:
                            Ast::Expr.Tuple(tuple_columns, tuple_line): true
                            _:                                          false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveScalarMatch, name: "tuple", line: match_line, expected: "", actual: ""}) if tuple_scrutinee
                        scalar_family: sview = infer_family(scrutinee, names, types, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveScalarMatch, name: scalar_family, line: match_line, expected: "", actual: ""}) if not tuple_scrutinee and (scalar_family == "int" or scalar_family == "char" or scalar_family == "string" or scalar_family == "float")
                _:
                    return
