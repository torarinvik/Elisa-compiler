# Tuple-pattern arity check: a `match` whose scrutinee is a tuple literal (`match a, b:`
# desugars to a tuple scrutinee) flags any arm whose pattern is a tuple pattern with a
# different number of sub-patterns — e.g. `match a, b:` with an arm `(x, y, z):`.
#
# SOUNDNESS (zero false positives is the prime directive): the scrutinee arity is taken
# ONLY from a literal `Expr.Tuple` (known from the AST — no type inference needed), and an
# arm is only compared when its pattern is a literal `Pattern.Tuple`. A wildcard, binding,
# variant, or any non-tuple pattern bails, as does a non-tuple scrutinee. Arities are read
# structurally from the AST, so this needs no type table and introduces no region concerns.

extend Semantic:
    private:
        # The number of positions in a tuple-literal scrutinee, or -1 when the scrutinee is
        # not a tuple literal (unknown arity — never flag).
        def tuple_scrutinee_arity(scrutinee: Ast::Expr) -> i64:
            match scrutinee:
                Expr.Tuple(elements, line):
                    return elements.count.i64()
                _:
                    return -1

        # Compare every tuple-pattern arm against a known tuple scrutinee arity.
        def check_arms_tuple_arity(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                scrutinee_arity: i64 = tuple_scrutinee_arity(scrutinee)
                return if scrutinee_arity < 0
                for arm in arms |table| -> table:
                    match arm.pattern:
                        Pattern.Tuple(elements):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TuplePatternArityMismatch, name: "", line: match_line, expected: "", actual: "", expected_count: scrutinee_arity.u32(), actual_count: elements.count.u32()}) if elements.count.i64() != scrutinee_arity
                        _:
                            pass

        # Walk statements, descending every block-bearing statement and checking each match.
        def check_tuple_pattern_arity_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_arms_tuple_arity(scrutinee, arms, line.line, table)
                            for arm in arms |table| -> table:
                                table <- check_tuple_pattern_arity_statements(arm.body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_tuple_pattern_arity_statements(then_body, table)
                            table <- check_tuple_pattern_arity_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_tuple_pattern_arity_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_tuple_pattern_arity_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_tuple_pattern_arity_statements(body, table)
                        _:
                            pass

    public:
        # Entry point: descend all function bodies (recursing into modules and scoped blocks).
        def check_tuple_pattern_arity(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_tuple_pattern_arity_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_tuple_pattern_arity(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_tuple_pattern_arity(scoped_body, table)
                        _:
                            pass
