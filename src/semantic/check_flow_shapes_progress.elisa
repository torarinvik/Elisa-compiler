# Stage1 semantic — loop progress and exit budget (`extend Semantic: private:`). Decides
# whether a loop body makes unconditional progress on its carried names, and counts the
# distinct exit shapes a loop returns. Continues check_flow_shapes.elisa; split out to
# keep each part file under 600 lines.

extend Semantic:
    private:
        # R5 progress helpers ---------------------------------------------------------------
        # Whether an expression performs a call (Call/Move/Paren-wrapped call).
        def flow_expr_performs_call(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return true
                    Expr.Move(operand, line):
                        return flow_expr_performs_call(operand)
                    Expr.Paren(inner, line):
                        return flow_expr_performs_call(inner)
                    _:
                        return false

        # An assignment, exit, or call-bearing statement is progress.
        def flow_is_progress_stmt(statement: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Assign(target, operator, value, line):
                        return true
                    Stmt.Return(value, line):
                        return true
                    Stmt.Break(label, line):
                        return true
                    Stmt.Continue(label, line):
                        return true
                    Stmt.Expr(expression, line):
                        return flow_expr_performs_call(expression)
                    Stmt.VarDecl(name, type_expression, value, line):
                        return flow_expr_performs_call(value)
                    _:
                        return false

        # Whether a statement list makes progress on some path: any assign/call/exit, a nested
        # loop, or progress inside any branch.
        def flow_stmts_make_progress(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    true return if flow_is_progress_stmt(statement)
                    match statement:
                        Stmt.While(condition, body, line):
                            return true
                        Stmt.For(bind, variables, iterable, body, line):
                            return true
                        Stmt.If(condition, then_body, else_body, line):
                            true return if flow_stmts_make_progress(then_body)
                            true return if flow_stmts_make_progress(else_body)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if flow_stmts_make_progress(arm.body)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if flow_stmts_make_progress(body)
                        _:
                            pass
                return false

        # Whether a top-level statement makes UNCONDITIONAL progress: assign to a carried name,
        # an exit, or a bare call (a plain read `c = f()` VarDecl does NOT — it does not advance).
        def flow_is_unconditional_progress(statement: Ast::Stmt, carried: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Assign(target, operator, value, line):
                        return any name in carried where name == target_root_ident(target)
                    Stmt.Return(value, line):
                        return true
                    Stmt.Break(label, line):
                        return true
                    Stmt.Continue(label, line):
                        return true
                    Stmt.Expr(expression, line):
                        return flow_expr_performs_call(expression)
                    _:
                        return false

        def flow_has_direct_progress(statements: darray[Ast::Stmt], carried: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any statement in statements where flow_is_unconditional_progress(statement, carried)

        # Whether any expression is a call whose RECEIVER is a carried name (`carried.method(...)`)
        # — the erasure-proof marker of a thread-slot loop.
        def flow_expr_call_on_names(expression: Ast::Expr, names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                true return if any name in names where name == ident_name_of(object)
                            _:
                                pass
                        true return if flow_expr_call_on_names(callee, names)
                        return any argument in arguments where flow_expr_call_on_names(argument, names)
                    Expr.Field(object, field, field_line):
                        return flow_expr_call_on_names(object, names)
                    Expr.Binary(left, operator, right, binary_line):
                        return flow_expr_call_on_names(left, names) or flow_expr_call_on_names(right, names)
                    Expr.Unary(operator, operand, unary_line):
                        return flow_expr_call_on_names(operand, names)
                    Expr.Paren(inner, paren_line):
                        return flow_expr_call_on_names(inner, names)
                    Expr.Index(object, index, index_line):
                        return flow_expr_call_on_names(object, names) or flow_expr_call_on_names(index, names)
                    _:
                        return false

        def flow_stmts_call_on_carried(statements: darray[Ast::Stmt], names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if flow_expr_call_on_names(expression, names)
                        Stmt.Assign(target, operator, value, line):
                            true return if flow_expr_call_on_names(value, names) or flow_expr_call_on_names(target, names)
                        Stmt.VarDecl(decl_name, decl_type, decl_value, decl_line):
                            true return if flow_expr_call_on_names(decl_value, names)
                        Stmt.Return(value, line):
                            if value is returned:
                                true return if flow_expr_call_on_names(returned, names)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if flow_expr_call_on_names(condition, names)
                            true return if flow_stmts_call_on_carried(then_body, names)
                            true return if flow_stmts_call_on_carried(else_body, names)
                        Stmt.While(condition, body, line):
                            true return if flow_expr_call_on_names(condition, names)
                            true return if flow_stmts_call_on_carried(body, names)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if flow_stmts_call_on_carried(body, names)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if flow_stmts_call_on_carried(body, names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if flow_stmts_call_on_carried(arm.body, names)
                        _:
                            pass
                return false

        # R5: an inert branch arm (no progress on any path) in a while whose loop as a whole isn't a
        # threaded-cursor loop and has no unconditional top-level progress.
        def flow_progress_check(loop_body: darray[Ast::Stmt], carried: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if flow_stmts_call_on_carried(loop_body, carried)
                return if flow_has_direct_progress(loop_body, carried)
                for statement in loop_body |table| -> table:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowProgress, name: "", line: line, expected: "", actual: ""}) if not flow_stmts_make_progress(then_body)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowProgress, name: "", line: line, expected: "", actual: ""}) if else_body.count > 0 and not flow_stmts_make_progress(else_body)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowProgress, name: "", line: line, expected: "", actual: ""}) if not flow_stmts_make_progress(arm.body)
                        _:
                            pass

        # The structural shape of a returned value as (category, int_value, name). Categories:
        # 1=ctor call, 2=int literal (value distinguishes -1 vs 0), 3=bool, 4=char, 5=binding
        # (all idents collapse), 8=other. Two returns share a shape iff same category and, for
        # ctor/char, same name; for int, same value.
        def flow_return_shape(value: Ast::Expr) -> (category: u8, int_value: i64, name: sview):
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_line):
                        return flow_return_shape(inner)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        head: sview = ident_name_of(callee)
                        return (1, 0, head if head != "" else sview("__call", 0, 0))
                    Expr.IntLit(literal_value):
                        return (2, literal_value, sview("", 0, 0))
                    Expr.BoolLit(bool_value):
                        return (3, 1 if bool_value else 0, sview("", 0, 0))
                    Expr.CharLit(text):
                        return (4, 0, text)
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Minus:
                            match operand:
                                Expr.IntLit(neg_value):
                                    return (2, 0 - neg_value, sview("", 0, 0))
                                _:
                                    return (8, 0, sview("", 0, 0))
                        return (8, 0, sview("", 0, 0))
                    Expr.Ident(ident_name, ident_line):
                        return (5, 0, sview("", 0, 0))
                    _:
                        return (8, 0, sview("", 0, 0))

        def flow_shape_present(categories: darray[u8]&, int_values: darray[i64]&, names: darray[sview]&, category: u8, int_value: i64, name: sview) -> bool:
            can Abort.Panic:
                while probe < categories.count |probe: usize = 0|:
                    same: bool = categories[probe] == category and (category != 2 or int_values[probe] == int_value) and ((category != 1 and category != 4) or names[probe] == name)
                    true return if same
                    probe <- probe + 1
                return false

        def flow_add_shape(categories: mutable darray[u8]&, int_values: mutable darray[i64]&, names: mutable darray[sview]&, category: u8, int_value: i64, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if flow_shape_present(categories, int_values, names, category, int_value, name)
                categories.push(category)
                int_values.push(int_value)
                names.push(name)

        # Collect the distinct exit shapes of a loop body (break + return shapes). Recurses through
        # if/match/block but NOT nested loops (their breaks are their own; returns there undercount).
        def flow_collect_exits(statements: darray[Ast::Stmt], categories: mutable darray[u8]&, int_values: mutable darray[i64]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |categories, int_values, names|:
                    match statement:
                        Stmt.Break(label, line):
                            flow_add_shape(categories, int_values, names, 0, 0, sview("", 0, 0))
                        Stmt.Return(value, line):
                            if value is returned:
                                shape: (category: u8, int_value: i64, name: sview) = flow_return_shape(returned)
                                flow_add_shape(categories, int_values, names, shape.category, shape.int_value, shape.name)
                            else:
                                flow_add_shape(categories, int_values, names, 7, 0, sview("", 0, 0))
                        Stmt.If(condition, then_body, else_body, line):
                            flow_collect_exits(then_body, categories, int_values, names)
                            flow_collect_exits(else_body, categories, int_values, names)
                        Stmt.Block(kind, clause, binding, body, line):
                            flow_collect_exits(body, categories, int_values, names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |categories, int_values, names|:
                                flow_collect_exits(arm.body, categories, int_values, names)
                        _:
                            pass

        def flow_exit_budget_check(loop_body: darray[Ast::Stmt], loop_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                categories: mutable darray[u8] = []
                int_values: mutable darray[i64] = []
                names: mutable darray[sview] = []
                flow_collect_exits(loop_body, categories, int_values, names)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowExitBudget, name: "", line: loop_line, expected: "", actual: ""}) if categories.count > 2
