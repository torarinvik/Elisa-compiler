# Stage1 abstract-effect validation — recognising an OPERATION CALL SITE: the family head behind a
# namespace expression, whether the head carried an explicit generic specialization, and whether
# a given call or value is an abstract operation at all. Continues check_abstract_effects.elisa.

extend Semantic:
    private:

        # Return the family head of an abstract-effect namespace expression. Generic effect
        # applications are represented by the ordinary expression index nodes in the compact
        # AST (`Writer[sview]`), so they must be recognized here even though the zero-overhead
        # call rewriter currently accepts the canonical `Writer.write(...)` spelling.
        def ae_operation_head(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(owner, owner_pos):
                        return owner
                    # Qualified effect families retain their terminal family name
                    # (`Effects::Tick` / `Effects.Tick`). The namespace is resolved
                    # separately by ordinary symbol lookup; effect-row identity is
                    # the declared family, so this remains metadata-only.
                    Expr.Scope(namespace, owner_scope, scope_pos):
                        return owner_scope
                    Expr.Field(namespace_field, owner_field, field_pos):
                        return owner_field
                    Expr.Index(indexed_head, index, index_pos):
                        return ae_operation_head(indexed_head)
                    Expr.IndexN(indexed_head_n, arguments, index_n_pos):
                        return ae_operation_head(indexed_head_n)
                    _:
                        pass
                return ""



        # Parser rows name the exact source head and lexical module. Resolve here rather
        # than joining on the terminal family, so a bare ambiguous name or a qualified
        # path to another module cannot borrow a same-leaf declaration.
        def ae_operation_ref_site(annotations: darray[Ast::EnumAnnotation]&, sites: EffectOperationPositionIndex&, effects: EffectDeclarationIdentityIndex&, member: sview, position: Ast::Pos, effect_ref: mutable sview&, effect_identity_id: mutable u32&) -> bool:
            can Abort.Panic:
                key: u64 = ae_effect_operation_site_hash(member, position.line, position.offset)
                row: mutable u32 = head if sites.operation_heads.get(key) is head else AE_EFFECT_INDEX_NONE
                while row != AE_EFFECT_INDEX_NONE |row, annotations, sites, effects, member, position|:
                    annotation: Ast::EnumAnnotation = sites.operation_annotations[row.usize()]
                    if annotation.owner == "__effect_operation_ref" and annotation.name == member and annotation.line == position.line and annotation.offset == position.offset:
                        effect_ref <- annotation.detail_name
                        effect_identity_id <- sites.operation_effect_ids[row.usize()]
                        return true
                    row <- sites.operation_next[row.usize()]
                return false



        # Whether an operation head used an explicit generic specialization. Bare
        # `Writer.write` remains an inferred family-level operation; `Writer[T].write`
        # carries a count that must agree with `effect Writer[...]` before lowering.
        def ae_operation_head_is_explicit(expression: Ast::Expr, argument_count: mutable u32&) -> bool:
            match expression:
                Expr.Index(indexed_head, index, index_pos):
                    argument_count <- 1
                    return true
                Expr.IndexN(indexed_head_n, arguments, index_n_pos):
                    argument_count <- arguments.count.u32()
                    return true
                _:
                    return false



        def ae_call_explicit_specialization(expression: Ast::Expr, argument_count: mutable u32&) -> bool:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_pos):
                    match callee:
                        Expr.Field(head, member, field_pos):
                            return ae_operation_head_is_explicit(head, argument_count)
                        Expr.Scope(head, member_scope, scope_pos):
                            return ae_operation_head_is_explicit(head, argument_count)
                        _:
                            pass
                _:
                    pass
            return false



        def ae_call_is_operation(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, sites: EffectOperationPositionIndex&, effects: EffectDeclarationIdentityIndex&, effect_name: mutable sview&, effect_identity_id: mutable u32&, effect_ref: mutable sview&, operation: mutable sview&, line: mutable u32&, site_line: mutable u32&, site_offset: mutable u32&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(head, member, field_pos):
                                resolved_effect_name: sview = ae_operation_head(head)
                                if resolved_effect_name != "" and ae_operation_ref_site(annotations, sites, effects, member, field_pos, effect_ref, effect_identity_id):
                                    if ae_effect_family_indexed(effects, resolved_effect_name):
                                        effect_name <- resolved_effect_name
                                        operation <- member
                                        line <- call_pos.line
                                        site_line <- field_pos.line
                                        site_offset <- field_pos.offset
                                        return true
                            Expr.Scope(head, member, scope_pos):
                                resolved_effect_name: sview = ae_operation_head(head)
                                if resolved_effect_name != "" and ae_operation_ref_site(annotations, sites, effects, member, scope_pos, effect_ref, effect_identity_id):
                                    if ae_effect_family_indexed(effects, resolved_effect_name):
                                        effect_name <- resolved_effect_name
                                        operation <- member
                                        line <- call_pos.line
                                        site_line <- scope_pos.line
                                        site_offset <- scope_pos.offset
                                        return true
                            _:
                                pass
                    _:
                        pass
                return false



        def ae_value_is_operation(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, sites: EffectOperationPositionIndex&, effects: EffectDeclarationIdentityIndex&, effect_name: mutable sview&, effect_identity_id: mutable u32&, effect_ref: mutable sview&, operation: mutable sview&, line: mutable u32&, site_line: mutable u32&, site_offset: mutable u32&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(head, member, field_pos):
                        resolved_effect_name: sview = ae_operation_head(head)
                        if resolved_effect_name != "" and ae_operation_ref_site(annotations, sites, effects, member, field_pos, effect_ref, effect_identity_id):
                            if ae_effect_family_indexed(effects, resolved_effect_name):
                                effect_name <- resolved_effect_name
                                operation <- member
                                line <- field_pos.line
                                site_line <- field_pos.line
                                site_offset <- field_pos.offset
                                return true
                    Expr.Scope(head, member, scope_pos):
                        resolved_effect_name: sview = ae_operation_head(head)
                        if resolved_effect_name != "" and ae_operation_ref_site(annotations, sites, effects, member, scope_pos, effect_ref, effect_identity_id):
                            if ae_effect_family_indexed(effects, resolved_effect_name):
                                effect_name <- resolved_effect_name
                                operation <- member
                                line <- scope_pos.line
                                site_line <- scope_pos.line
                                site_offset <- scope_pos.offset
                                return true
                    _:
                        pass
                return false



        def ae_specialization_mismatch_at_site(annotations: darray[Ast::EnumAnnotation]&, sites: EffectOperationPositionIndex&, line: u32, offset: u32) -> sview:
            can Abort.Panic:
                key: u64 = ae_effect_mismatch_site_hash(line, offset)
                row: mutable u32 = head if sites.mismatch_heads.get(key) is head else AE_EFFECT_INDEX_NONE
                while row != AE_EFFECT_INDEX_NONE |row, annotations, sites, line, offset|:
                    annotation: Ast::EnumAnnotation = sites.mismatch_annotations[row.usize()]
                    return annotation.name if annotation.owner == "__effect_specialization_mismatch" and annotation.line == line and annotation.offset == offset
                    row <- sites.mismatch_next[row.usize()]
                return ""
