extend Semantic:
    private:
        def local_type_cannot_carry_region(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                if type_expression is Expr.Unary(operator, operand, line):
                    false return if operator == TokenKind.Ampersand
                    local_type_cannot_carry_region(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                if type_expression is Expr.Index(object, argument, line):
                    if object is Expr.Ident(head, head_line):
                        return head == "array"
                if type_expression is Expr.IndexN(object, arguments, line):
                    if object is Expr.Ident(head, head_line):
                        return head == "array"
                if type_expression is Expr.Ident(name, line):
                    return is_integer_type_name(name) or is_float_type_name(name) or name == "bool" or name == "char" or name == "void"
                return false


        def local_region_is_declared(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "" and annotation.region == region


        def local_region_annotation_of(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32) -> Ast::LocalRegionAnnotation?:
            can Abort.Panic:
                found: mutable Ast::LocalRegionAnnotation? = null
                for annotation in annotations |found|:
                    found <- annotation if annotation.name == name and annotation.line <= before_line
                return found


        def region_reference_base(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                if type_expression is Expr.Unary(operator, operand, line):
                    return region_reference_base(operand)
                if type_expression is Expr.Ident(name, line):
                    return name
                return "reference"


        def check_region_assignment_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, Expr.Ident(source_name, source_line), line):
                            if local_region_annotation_of(annotations, name, line) is target_annotation and local_region_annotation_of(annotations, source_name, line) is source_annotation:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionQualifierMismatch, name: name, line: line, expected: target_annotation.region, actual: source_annotation.region, detail: region_reference_base(target_annotation.type_expression)}) if target_annotation.region != source_annotation.region
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_region_assignment_statements(body, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_region_assignment_statements(then_body, annotations, table)
                            table <- check_region_assignment_statements(else_body, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- check_region_assignment_statements(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_region_assignment_statements(body, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_region_assignment_statements(arm.body, annotations, table)
                        _:
                            pass


        def check_region_assignment_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_region_assignment_statements(body, annotations, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_region_assignment_declarations(body, annotations, table)
                        _:
                            pass

    public:
        def check_local_region_annotation(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.local_region_annotations |table|:
                    continue if annotation.name == ""
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAnnotationOnNonRegionLocal, name: annotation.name, line: annotation.line, expected: "", actual: annotation.region}) if local_type_cannot_carry_region(annotation.type_expression)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownRegionQualifier, name: annotation.name, line: annotation.line, expected: "", actual: annotation.region}) if not local_type_cannot_carry_region(annotation.type_expression) and not local_region_is_declared(file.local_region_annotations, annotation.region)
                table <- check_region_assignment_declarations(file.top_decls, file.local_region_annotations, table)
