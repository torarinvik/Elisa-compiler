extend Semantic:
    private:
        def local_type_cannot_carry_region(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                if type_expression is Expr.Unary(operator, operand, line):
                    false return if operator == TokenKind.Ampersand
                    local_type_cannot_carry_region(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                if type_expression is Expr.Index(object, argument, line):
                    if object is Expr.Ident(head, head_line):
                        return head == "array"
                if type_expression is Expr.IndexN(object, arguments, line):
                    if object is Expr.Ident(head, head_line):
                        return head == "array"
                if type_expression is Expr.Ident(name, line):
                    return is_integer_type_name(name) or is_float_type_name(name) or name == "bool" or name == "char" or name == "void"
                return false


        def local_region_is_declared(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name in {"__region_local", "__region_param"} and annotation.region == region


        def local_region_annotation_of(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32) -> Ast::LocalRegionAnnotation?:
            can Abort.Panic:
                found: mutable Ast::LocalRegionAnnotation? = null
                for annotation in annotations |found|:
                    found <- annotation if annotation.name == name and annotation.line <= before_line
                return found


        def region_reference_base(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                if type_expression is Expr.Unary(operator, operand, line):
                    return region_reference_base(operand)
                if type_expression is Expr.Ident(name, line):
                    return name
                return "reference"


        def region_is_function_local(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, function_line: u32, use_line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__region_local" and annotation.region == region and annotation.line >= function_line and annotation.line <= use_line


        def allocation_region_at(regions: darray[sview]&, lines: darray[u32]&, line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                for allocation_line in lines |index: usize = 0, found|:
                    found <- regions[index] if allocation_line == line
                    index <- index + 1
                return found


        def allocated_local_region(statements: darray[Ast::Stmt]&, regions: darray[sview]&, lines: darray[u32]&, name: sview, before_line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                for statement in statements |found|:
                    if statement is Stmt.VarDecl(local_name, type_expression, value, line):
                        found <- allocation_region_at(regions, lines, line) if local_name == name and line <= before_line
                return found


        def region_return_source_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                if expression is Expr.Ident(name, line):
                    return name
                if expression is Expr.Index(object, target_type, line):
                    if object is Expr.Field(receiver, field, field_line):
                        return region_return_source_name(receiver) if field == "cast" else ""
                return ""


        def check_region_assignment_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, function_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, Expr.Ident(source_name, source_line), line):
                            if local_region_annotation_of(annotations, name, line) is target_annotation and local_region_annotation_of(annotations, source_name, line) is source_annotation:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionQualifierMismatch, name: name, line: line, expected: target_annotation.region, actual: source_annotation.region, detail: region_reference_base(target_annotation.type_expression)}) if target_annotation.region != source_annotation.region
                        Stmt.Return(value, line):
                            if value is return_value:
                                return_name: sview = region_return_source_name(return_value)
                                if return_name != "":
                                    if local_region_annotation_of(annotations, return_name, line) is return_annotation:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: return_name, line: line, expected: "", actual: return_annotation.region}) if region_is_function_local(annotations, return_annotation.region, function_line, line)
                                    allocation_region: sview = allocated_local_region(statements, allocation_regions, allocation_lines, return_name, line)
                                    has_explicit_region: bool = any annotation in annotations where annotation.name == return_name and annotation.line <= line
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: return_name, line: line, expected: "", actual: allocation_region}) if not has_explicit_region and allocation_region != "" and region_is_function_local(annotations, allocation_region, function_line, line)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_region_assignment_statements(body, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_region_assignment_statements(then_body, annotations, allocation_regions, allocation_lines, function_line, table)
                            table <- check_region_assignment_statements(else_body, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.While(condition, body, line):
                            table <- check_region_assignment_statements(body, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_region_assignment_statements(body, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_region_assignment_statements(arm.body, annotations, allocation_regions, allocation_lines, function_line, table)
                        _:
                            pass


        def check_region_assignment_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_region_assignment_statements(body, annotations, allocation_regions, allocation_lines, line, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_region_assignment_declarations(body, annotations, allocation_regions, allocation_lines, table)
                        _:
                            pass

    public:
        def check_local_region_annotation(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.local_region_annotations |table|:
                    continue if annotation.name in {"__region_local", "__region_param"}
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAnnotationOnNonRegionLocal, name: annotation.name, line: annotation.line, expected: "", actual: annotation.region}) if local_type_cannot_carry_region(annotation.type_expression)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownRegionQualifier, name: annotation.name, line: annotation.line, expected: "", actual: annotation.region}) if not local_type_cannot_carry_region(annotation.type_expression) and not local_region_is_declared(file.local_region_annotations, annotation.region)
                table <- check_region_assignment_declarations(file.top_decls, file.local_region_annotations, file.allocation_region_names, file.allocation_region_lines, table)
