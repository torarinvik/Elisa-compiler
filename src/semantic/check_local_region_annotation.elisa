extend Semantic:
    private:
        def local_type_cannot_carry_region(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return false if operator == TokenKind.Ampersand
                        return local_type_cannot_carry_region(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return false
                    Expr.Index(object, argument, line):
                        match object:
                            Expr.Ident(head, head_line):
                                return head == "array"
                            _:
                                return false
                    Expr.IndexN(object, arguments, line):
                        match object:
                            Expr.Ident(head, head_line):
                                return head == "array"
                            _:
                                return false
                    Expr.Ident(name, line):
                        return true if is_integer_type_name(name) or is_float_type_name(name)
                        is_regionless_primitive_name: bool = when name:
                            "bool" | "char" | "void" -> true
                            _ -> false
                        return true if is_regionless_primitive_name
                        # A Capitalised bare head is a struct, an enum or a generic
                        # parameter; the region-carrying builtins are all lowercase.
                        return false if:
                            name.len == 0
                            # `Arena` is the one Capitalised type that DOES carry a region:
                            # `in scratch:` over `scratch: mutable Arena` synthesises a
                            # region annotation on it, so this fires on the compiler's own
                            # parser if the carrier is not excluded. stage0 reaches it
                            # through the internal-runtime-carrier path, never this one.
                            name == "Arena"
                        head_byte: u8 = name[0]
                        return head_byte >= 65 and head_byte <= 90
                    _:
                        return false


        # As above, but a `region NAME:` BLOCK only counts when it is already open at
        # USE_LINE. `outer: darray[u8] @a = []` written ABOVE `region a(4096):` names a
        # region that does not exist yet, which stage0 reports as an unknown qualifier
        # (verified: the same annotation INSIDE the block is accepted).
        #
        # A `__region_param` (`def f[@r]`) is visible only within its parsed
        # function range; line bounds also keep a later same-spelled parameter
        # from leaking into an earlier function's annotations.
        # `__region_local` is visible only while its block is open. Comparing line order alone
        # lets a closed sibling region satisfy the query; zero end_line is the unbounded form.
        def local_region_is_in_scope(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, use_line: u32, use_offset: u32) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    continue if annotation.region != region or annotation.owner_offset > use_offset
                    scope_active: bool = use_offset < annotation.end_offset if annotation.end_offset != 0 else annotation.end_line == 0 or use_line <= annotation.end_line
                    if annotation.name == "__region_param" or annotation.name == "__region_local":
                        return true if scope_active
                    # An `Arena&`-typed LOCAL declared earlier in the same lexical block owns a
                    # region too -- `alloc: mutable Arena& = ...` then
                    # `xs: darray[i64] @alloc = [...]`. Parser block extents prevent this binding
                    # from leaking into sibling blocks or later functions after it is out of scope.
                    return true if annotation.name == "__region_arena_local" and scope_active
                return false


        # The newest `@region` annotation on local NAME active at the use position, or null.
        # When BEFORE_OFFSET_KNOWN, byte offsets are authoritative even at offset zero;
        # source-less callers retain the legacy BEFORE_LINE fallback. An annotation on a type
        # with no region of its own (`xs: array[i64, 4] @r`, `x: i64 @r`,
        # `y: T @r`) is skipped: stage0 drops that region when it resolves the type, so the value
        # has no dependency on it. Counting one turned the single rejected annotation into a
        # cascade -- `cannot return reference` on a returned i64, and a destroy-then-use error.
        def local_region_annotation_of(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32, before_offset: u32 = 0, before_offset_known: bool = false) -> Ast::LocalRegionAnnotation?:
            can Abort.Panic:
                found: mutable Ast::LocalRegionAnnotation? = null
                found_offset: mutable u32 = 0
                for annotation in annotations |found, found_offset, before_offset, before_offset_known|:
                    # Rows starting after the query, or before an already selected
                    # later row, cannot win regardless of their name or type.
                    candidate_offset: u32 = annotation.owner_offset if before_offset_known else annotation.line
                    continue if candidate_offset > (before_offset if before_offset_known else before_line) or candidate_offset < found_offset
                    if before_offset_known and annotation.end_offset != 0:
                        continue if before_offset >= annotation.end_offset
                    else:
                        continue if annotation.end_line != 0 and before_line > annotation.end_line
                    continue if annotation.name != name
                    source_visible: bool = annotation.owner_offset <= before_offset and (before_offset < annotation.end_offset if annotation.end_offset != 0 else annotation.end_line == 0 or before_line <= annotation.end_line)
                    line_visible: bool = annotation.line <= before_line and (annotation.end_line == 0 or before_line <= annotation.end_line)
                    visible: bool = source_visible if before_offset_known else line_visible
                    if visible and not local_type_cannot_carry_region(annotation.type_expression):
                        if candidate_offset >= found_offset:
                            found <- annotation
                            found_offset <- candidate_offset
                return found


        def region_reference_base(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return region_reference_base(operand)
                    Expr.Ident(name, line):
                        return name
                    _:
                        return "reference"


        def region_is_function_local(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, function_line: u32, use_line: u32, use_offset: u32 = 0) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__region_local" and annotation.region == region and (annotation.owner_offset <= use_offset and (use_offset < annotation.end_offset if annotation.end_offset != 0 else annotation.end_line == 0 or use_line <= annotation.end_line) if use_offset > 0 else annotation.line >= function_line and annotation.line <= use_line)


        def allocation_region_is_inline_effect_row(regions: darray[sview @source]&, offsets: darray[u32]&, row: usize) -> bool:
            can Abort.Panic:
                return false if row >= regions.count
                return true if regions[row] == "__inline_can"
                return false if offsets.count != regions.count or row >= offsets.count
                for marker_index in 0..<regions.count |regions, offsets, row|:
                    return true if regions[marker_index] == "__inline_can" and offsets[marker_index] == offsets[row]
                return false


        def allocation_region_note(out: mutable darray[sview @source]&, region: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if region == "" or region == "__inline_can"
                out.push(region) if not any existing in out where existing == region


        # An initializer's AST may keep only the payload position after parser lowering removes
        # a prefix `new[region]`. The containing declaration/return interval still spans the
        # exact allocation token and avoids attributing a different allocation on the same line.
        def allocation_regions_in_source_interval(start_offset: u32, end_offset: u32, regions: darray[sview @source]&, offsets: darray[u32]&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if offsets.count != regions.count or end_offset <= start_offset
                for row_index in 0..<regions.count |out, offsets, start_offset, end_offset|:
                    allocation_offset: u32 = offsets[row_index]
                    if allocation_offset >= start_offset and allocation_offset < end_offset and not allocation_region_is_inline_effect_row(regions, offsets, row_index):
                        allocation_region_note(out, regions[row_index])


        # allocation_regions_in_source_interval through the offset-ordered row index: the rows
        # whose offsets fall in the interval form one run of offset_order, and each recordable
        # name is noted in order of its smallest row there, which is the order a row scan
        # first meets it.
        def allocation_regions_in_indexed_interval(start_offset: u32, end_offset: u32, regions: darray[sview @source]&, offsets: darray[u32]&, call_spans: CallSourceSpanIndex&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if call_spans.offset_order.count != offsets.count or call_spans.row_name_ids.count != offsets.count:
                    allocation_regions_in_source_interval(start_offset, end_offset, regions, offsets, out)
                    return
                return if offsets.count != regions.count or end_offset <= start_offset
                low: mutable usize = 0
                high: mutable usize = offsets.count
                while low < high |low, high, offsets, call_spans, start_offset|:
                    middle: usize = low + (high - low) / 2
                    if offsets[call_spans.offset_order[middle]] < start_offset:
                        low <- middle + 1
                    else:
                        high <- middle
                hit_rows: mutable darray[usize] = []
                hit_names: mutable darray[u32] = []
                position: mutable usize = low
                while position < offsets.count and offsets[call_spans.offset_order[position]] < end_offset |position, offsets, call_spans, hit_rows, hit_names|:
                    row: usize = call_spans.offset_order[position]
                    name: u32 = call_spans.row_name_ids[row]
                    if name != SYMBOL_INDEX_ROW_NONE:
                        seen: mutable bool = false
                        for hit in 0..<hit_names.count |seen, hit_rows, hit_names, name, row|:
                            if hit_names[hit] == name:
                                seen <- true
                                hit_rows[hit] <- row if row < hit_rows[hit]
                        if not seen:
                            hit_rows.push(row)
                            hit_names.push(name)
                    position <- position + 1
                # Rows of distinct names never tie; insertion-sort the few hits by row.
                for next_hit in 1..<hit_rows.count |hit_rows, hit_names|:
                    slot: mutable usize = next_hit
                    while slot > 0 and hit_rows[slot - 1] > hit_rows[slot] |slot, hit_rows, hit_names|:
                        row_swap: usize = hit_rows[slot - 1]
                        hit_rows[slot - 1] <- hit_rows[slot]
                        hit_rows[slot] <- row_swap
                        name_swap: u32 = hit_names[slot - 1]
                        hit_names[slot - 1] <- hit_names[slot]
                        hit_names[slot] <- name_swap
                        slot <- slot - 1
                for hit in 0..<hit_rows.count |out, hit_rows, regions|:
                    allocation_region_note(out, regions[hit_rows[hit]])


        def allocation_source_interval_has_region(start_offset: u32, end_offset: u32, region: sview, regions: darray[sview @source]&, offsets: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if offsets.count != regions.count or end_offset <= start_offset
                for row_index in 0..<regions.count |offsets, start_offset, end_offset|:
                    allocation_offset: u32 = offsets[row_index]
                    return true if allocation_offset >= start_offset and allocation_offset < end_offset and regions[row_index] == region and not allocation_region_is_inline_effect_row(regions, offsets, row_index)
                return false


        # The allocation walkers read call_spans only for `__call_source_span` rows, keyed by
        # the call offset they describe. The entry points index just those rows once, so a
        # call expression visits its own span rows instead of scanning every call in the file.
        # `heads` names the newest row for an offset and `next` chains the older ones.
        struct CallSourceSpanIndex:
            rows: mutable darray[Ast::EnumAnnotation] = []
            heads: mutable dict[u32, u32] = {}
            next: mutable darray[u32] = []
            # Offsets that carry an `__inline_can` row, so the inline-effect test does not
            # rescan every allocation row.
            inline_can_offsets: mutable dict[u32, u8] = {}
            # Allocation rows ordered by (offset, row); offsets restart per included file, so
            # the rows are not sorted themselves. row_name_ids[row] names the region text a
            # row scan would record (an index into names), or SYMBOL_INDEX_ROW_NONE for rows
            # allocation_region_note skips: empty names and inline-effect rows.
            offset_order: mutable darray[usize] = []
            row_name_ids: mutable darray[u32] = []
            names: mutable darray[sview @source] = []
            name_heads: mutable dict[u64, u32] = {}
            name_next: mutable darray[u32] = []

        def allocation_fill_call_source_spans(annotations: darray[Ast::EnumAnnotation]&, regions: darray[sview @source]&, offsets: darray[u32]&, call_spans: mutable CallSourceSpanIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                if regions.count == offsets.count:
                    for row in 0..<regions.count |call_spans, regions, offsets|:
                        call_spans.inline_can_offsets <- call_spans.inline_can_offsets.put(offsets[row], 1) can Global{Read,Write} if regions[row] == "__inline_can"
                    allocation_fill_region_name_rows(regions, offsets, call_spans) can Global{Read,Write}
                for row in 0..<annotations.count |call_spans|:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    if annotation.owner == "__call_source_span":
                        older: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        if call_spans.heads.get(annotation.offset) is head:
                            older <- head
                        call_spans.next.push(older)
                        call_spans.heads <- call_spans.heads.put(annotation.offset, call_spans.rows.count.u32()) can Global{Read,Write}
                        call_spans.rows.push(annotation)

        def allocation_fill_region_name_rows(regions: darray[sview @source]&, offsets: darray[u32]&, call_spans: mutable CallSourceSpanIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<regions.count |call_spans, regions, offsets|:
                    region: sview @source = regions[row]
                    eligible: bool = region != "" and region != "__inline_can" and not (call_spans.inline_can_offsets.get(offsets[row]) is inline_marker)
                    if not eligible:
                        call_spans.row_name_ids.push(SYMBOL_INDEX_ROW_NONE)
                    else:
                        hash: u64 = name_hash(region)
                        found: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        if call_spans.name_heads.get(hash) is head:
                            candidate: mutable u32 = head
                            while candidate != SYMBOL_INDEX_ROW_NONE and found == SYMBOL_INDEX_ROW_NONE |candidate, found, call_spans, region|:
                                if call_spans.names[candidate.usize()] == region:
                                    found <- candidate
                                else:
                                    candidate <- call_spans.name_next[candidate.usize()]
                        if found == SYMBOL_INDEX_ROW_NONE:
                            found <- call_spans.names.count.u32()
                            older: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            if call_spans.name_heads.get(hash) is head:
                                older <- head
                            call_spans.name_next.push(older)
                            call_spans.name_heads <- call_spans.name_heads.put(hash, found) can Global{Read,Write}
                            call_spans.names.push(region)
                        call_spans.row_name_ids.push(found)
                # Stable bottom-up merge sort of row indices by offset.
                scratch: mutable darray[usize] = []
                for row in 0..<offsets.count |call_spans, scratch|:
                    call_spans.offset_order.push(row)
                    scratch.push(row)
                width: mutable usize = 1
                while width < call_spans.offset_order.count |width, call_spans, scratch, offsets|:
                    left: mutable usize = 0
                    while left < call_spans.offset_order.count |left, width, call_spans, scratch, offsets|:
                        middle: usize = left + width if left + width < call_spans.offset_order.count else call_spans.offset_order.count
                        right: usize = left + 2 * width if left + 2 * width < call_spans.offset_order.count else call_spans.offset_order.count
                        a: mutable usize = left
                        b: mutable usize = middle
                        dest: mutable usize = left
                        while dest < right |a, b, dest, middle, right, call_spans, scratch, offsets|:
                            if a < middle and (b >= right or offsets[call_spans.offset_order[a]] <= offsets[call_spans.offset_order[b]]):
                                scratch[dest] <- call_spans.offset_order[a]
                                a <- a + 1
                            else:
                                scratch[dest] <- call_spans.offset_order[b]
                                b <- b + 1
                            dest <- dest + 1
                        left <- right
                    for position in 0..<call_spans.offset_order.count |call_spans, scratch|:
                        call_spans.offset_order[position] <- scratch[position]
                    width <- width * 2

        # The newest call-source span recorded for the call at `offset`, or `fallback`.
        # Newest is the last such row in annotation order, which is what a full scan kept.
        def allocation_call_source_span(call_spans: CallSourceSpanIndex&, offset: u32, fallback: Ast::Pos) -> Ast::Pos:
            can Abort.Panic:
                if call_spans.heads.get(offset) is head:
                    return call_spans.rows[head.usize()].pos
                return fallback

        # The largest end among the call-source spans recorded for the call at `offset`.
        def allocation_call_source_end(call_spans: CallSourceSpanIndex&, offset: u32, end_offset: u32) -> u32:
            can Abort.Panic:
                result: mutable u32 = end_offset
                row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if call_spans.heads.get(offset) is head:
                    row <- head
                while row != SYMBOL_INDEX_ROW_NONE |result, row, call_spans|:
                    result <- call_spans.rows[row.usize()].pos.end_offset if call_spans.rows[row.usize()].pos.end_offset > result
                    row <- call_spans.next[row.usize()]
                return result

        # `Ast::Pos` for postfix brace forms may be only the opening brace token. Extend an
        # initializer's end through its child expressions so a removed prefix `new[r]` stays
        # inside the bounded statement interval.
        def allocation_expression_end_offset(expression: Ast::Expr, call_spans: CallSourceSpanIndex&) -> u32:
            can Abort.Panic:
                end_offset: mutable u32 = Ast::expr_pos(expression).end_offset
                match expression:
                    Expr.RegionNew(operand, _, _):
                        child_end: mutable u32 = allocation_expression_end_offset(operand, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.Call(callee, arguments, _, call_pos):
                        end_offset <- allocation_call_source_end(call_spans, call_pos.offset, end_offset)
                        child_end: mutable u32 = allocation_expression_end_offset(callee, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        for argument in arguments |end_offset, call_spans|:
                            child_end <- allocation_expression_end_offset(argument, call_spans)
                            end_offset <- child_end if child_end > end_offset
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        child_end: mutable u32 = allocation_expression_end_offset(object, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _):
                        child_end: mutable u32 = allocation_expression_end_offset(operand, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.Index(object, index, _):
                        child_end: mutable u32 = allocation_expression_end_offset(object, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(index, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.Slice(object, low, high, _):
                        child_end: mutable u32 = allocation_expression_end_offset(object, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(low, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(high, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.IndexN(object, arguments, _):
                        child_end: mutable u32 = allocation_expression_end_offset(object, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        for argument in arguments |end_offset, call_spans|:
                            child_end <- allocation_expression_end_offset(argument, call_spans)
                            end_offset <- child_end if child_end > end_offset
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |end_offset, call_spans|:
                            child_end: mutable u32 = allocation_expression_end_offset(element, call_spans)
                            end_offset <- child_end if child_end > end_offset
                    Expr.DictLit(entries, _):
                        for entry in entries |end_offset, call_spans|:
                            key_end: u32 = allocation_expression_end_offset(entry.key, call_spans)
                            value_end: u32 = allocation_expression_end_offset(entry.value, call_spans)
                            end_offset <- key_end if key_end > end_offset
                            end_offset <- value_end if value_end > end_offset
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        child_end: mutable u32 = allocation_expression_end_offset(type_expression, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        for field in fields |end_offset, call_spans|:
                            child_end <- allocation_expression_end_offset(field.value, call_spans)
                            end_offset <- child_end if child_end > end_offset
                    Expr.Binary(left, _, right, _) | Expr.Refinement(left, right, _):
                        child_end: mutable u32 = allocation_expression_end_offset(left, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(right, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.If(condition, then_expression, else_expression, _):
                        child_end: mutable u32 = allocation_expression_end_offset(condition, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(then_expression, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(else_expression, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        child_end: mutable u32 = allocation_expression_end_offset(scrutinee, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        for arm in arms |end_offset, call_spans|:
                            child_end <- allocation_expression_end_offset(arm.guard, call_spans)
                            end_offset <- child_end if child_end > end_offset
                            child_end <- allocation_statements_end_offset(arm.body, call_spans)
                            end_offset <- child_end if child_end > end_offset
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        child_end: mutable u32 = allocation_expression_end_offset(iterable, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(condition, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(body, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.GetElse(guarded, recovery, _):
                        child_end: mutable u32 = allocation_expression_end_offset(guarded, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_statements_end_offset(recovery, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    Expr.Block(statements, value, _, _):
                        child_end: mutable u32 = allocation_statements_end_offset(statements, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        child_end <- allocation_expression_end_offset(value, call_spans)
                        end_offset <- child_end if child_end > end_offset
                    # Lambda bodies run later. Their statement walker computes its own
                    # initializer intervals when the closure is validated.
                    Expr.Lambda(_, _, _):
                        pass
                    Expr.StaticEffectCall(head, _, _, arguments, _, _):
                        child_end: mutable u32 = allocation_expression_end_offset(head, call_spans)
                        end_offset <- child_end if child_end > end_offset
                        for argument in arguments |end_offset, call_spans|:
                            child_end <- allocation_expression_end_offset(argument, call_spans)
                            end_offset <- child_end if child_end > end_offset
                    _:
                        pass
                return end_offset


        def allocation_statements_end_offset(statements: darray[Ast::Stmt], call_spans: CallSourceSpanIndex&) -> u32:
            can Abort.Panic:
                end_offset: mutable u32 = 0
                for statement in statements |end_offset, call_spans|:
                    match statement:
                        Stmt.VarDecl(_, _, value, line):
                            child_end: mutable u32 = allocation_expression_end_offset(value, call_spans)
                            end_offset <- child_end if child_end > end_offset
                        Stmt.Assign(target, _, value, line):
                            child_end: mutable u32 = allocation_expression_end_offset(target, call_spans)
                            end_offset <- child_end if child_end > end_offset
                            child_end <- allocation_expression_end_offset(value, call_spans)
                            end_offset <- child_end if child_end > end_offset
                        Stmt.Return(value, line):
                            if value is returned:
                                child_end: mutable u32 = allocation_expression_end_offset(returned, call_spans)
                                end_offset <- child_end if child_end > end_offset
                        Stmt.Expr(value, line):
                            child_end: u32 = allocation_expression_end_offset(value, call_spans)
                            end_offset <- child_end if child_end > end_offset
                        Stmt.If(condition, then_body, else_body, line):
                            child_end: mutable u32 = allocation_expression_end_offset(condition, call_spans)
                            end_offset <- child_end if child_end > end_offset
                            child_end <- allocation_statements_end_offset(then_body, call_spans)
                            end_offset <- child_end if child_end > end_offset
                            child_end <- allocation_statements_end_offset(else_body, call_spans)
                            end_offset <- child_end if child_end > end_offset
                        Stmt.Block(_, _, _, body, _):
                            child_end: u32 = allocation_statements_end_offset(body, call_spans)
                            end_offset <- child_end if child_end > end_offset
                        Stmt.While(condition, body, _) | Stmt.For(_, _, condition, body, _):
                            child_end: mutable u32 = allocation_expression_end_offset(condition, call_spans)
                            end_offset <- child_end if child_end > end_offset
                            child_end <- allocation_statements_end_offset(body, call_spans)
                            end_offset <- child_end if child_end > end_offset
                        Stmt.Match(scrutinee, arms, _):
                            child_end: mutable u32 = allocation_expression_end_offset(scrutinee, call_spans)
                            end_offset <- child_end if child_end > end_offset
                            for arm in arms |end_offset, call_spans|:
                                child_end <- allocation_expression_end_offset(arm.guard, call_spans)
                                end_offset <- child_end if child_end > end_offset
                                child_end <- allocation_statements_end_offset(arm.body, call_spans)
                                end_offset <- child_end if child_end > end_offset
                        _:
                            pass
                return end_offset


        # Exact `new[region]` token rows inside a call's full parser-recorded source span.
        # A lone Ast::Pos token is sufficient only for an exact-token hit. Logical line
        # fallback is reserved for synthetic positions or legacy/misaligned metadata.
        def allocation_regions_in_call_span(call_pos: Ast::Pos, regions: darray[sview @source]&, lines: darray[u32]&, offsets: darray[u32]&, call_spans: CallSourceSpanIndex&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                span: Ast::Pos = allocation_call_source_span(call_spans, call_pos.offset, call_pos)
                if offsets.count == regions.count and lines.count == regions.count and span.end_offset > span.offset:
                    allocation_regions_in_indexed_interval(span.offset, span.end_offset, regions, offsets, call_spans, out)
                    return
                if offsets.count == regions.count and lines.count == regions.count and call_pos.end_offset > call_pos.offset:
                    for row_index in 0..<regions.count |out, offsets, call_pos|:
                        allocation_offset: u32 = offsets[row_index]
                        allocation_region_note(out, regions[row_index]) if allocation_offset >= call_pos.offset and allocation_offset < call_pos.end_offset and not allocation_region_is_inline_effect_row(regions, offsets, row_index)
                    return
                return if call_pos.offset != 0 or call_pos.end_offset != 0
                for row_index in 0..<regions.count |out, lines, call_pos|:
                    allocation_region_note(out, regions[row_index]) if row_index < lines.count and lines[row_index] == call_pos.line and not allocation_region_is_inline_effect_row(regions, offsets, row_index)


        def allocation_regions_in_expression(expression: Ast::Expr, regions: darray[sview @source]&, lines: darray[u32]&, offsets: darray[u32]&, call_spans: CallSourceSpanIndex&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                position: Ast::Pos = Ast::expr_pos(expression)
                allocation_regions_in_indexed_interval(position.offset, position.end_offset, regions, offsets, call_spans, out)
                match expression:
                    Expr.RegionNew(operand, region, _):
                        allocation_region_note(out, region)
                        allocation_regions_in_expression(operand, regions, lines, offsets, call_spans, out)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        allocation_regions_in_call_span(call_pos, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(callee, regions, lines, offsets, call_spans, out)
                        for argument in arguments |regions, lines, offsets, call_spans, out|:
                            allocation_regions_in_expression(argument, regions, lines, offsets, call_spans, out)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        allocation_regions_in_expression(object, regions, lines, offsets, call_spans, out)
                    Expr.Index(object, index, _):
                        allocation_regions_in_expression(object, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(index, regions, lines, offsets, call_spans, out)
                    Expr.Slice(object, low, high, _):
                        allocation_regions_in_expression(object, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(low, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(high, regions, lines, offsets, call_spans, out)
                    Expr.IndexN(object, arguments, _):
                        allocation_regions_in_expression(object, regions, lines, offsets, call_spans, out)
                        for argument in arguments |regions, lines, offsets, call_spans, out|:
                            allocation_regions_in_expression(argument, regions, lines, offsets, call_spans, out)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _):
                        allocation_regions_in_expression(operand, regions, lines, offsets, call_spans, out)
                    Expr.Binary(left, _, right, _) | Expr.Refinement(left, right, _):
                        allocation_regions_in_expression(left, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(right, regions, lines, offsets, call_spans, out)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |regions, lines, offsets, call_spans, out|:
                            allocation_regions_in_expression(element, regions, lines, offsets, call_spans, out)
                    Expr.DictLit(entries, _):
                        for entry in entries |regions, lines, offsets, call_spans, out|:
                            allocation_regions_in_expression(entry.key, regions, lines, offsets, call_spans, out)
                            allocation_regions_in_expression(entry.value, regions, lines, offsets, call_spans, out)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        allocation_regions_in_expression(type_expression, regions, lines, offsets, call_spans, out)
                        for field in fields |regions, lines, offsets, call_spans, out|:
                            allocation_regions_in_expression(field.value, regions, lines, offsets, call_spans, out)
                    Expr.If(condition, then_expression, else_expression, _):
                        allocation_regions_in_expression(condition, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(then_expression, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(else_expression, regions, lines, offsets, call_spans, out)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        allocation_regions_in_expression(scrutinee, regions, lines, offsets, call_spans, out)
                        for arm in arms |regions, lines, offsets, call_spans, out|:
                            allocation_regions_in_expression(arm.guard, regions, lines, offsets, call_spans, out)
                            allocation_regions_in_statements(arm.body, regions, lines, offsets, call_spans, out)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        allocation_regions_in_expression(iterable, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(condition, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(body, regions, lines, offsets, call_spans, out)
                    Expr.GetElse(guarded, recovery, _):
                        allocation_regions_in_expression(guarded, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_statements(recovery, regions, lines, offsets, call_spans, out)
                    Expr.Block(statements, value, _, _):
                        allocation_regions_in_statements(statements, regions, lines, offsets, call_spans, out)
                        allocation_regions_in_expression(value, regions, lines, offsets, call_spans, out)
                    # Deferred allocations belong to lambda execution, not to the
                    # enclosing closure initializer.
                    Expr.Lambda(_, _, _):
                        pass
                    Expr.StaticEffectCall(head, _, _, arguments, _, _):
                        allocation_regions_in_expression(head, regions, lines, offsets, call_spans, out)
                        for argument in arguments |regions, lines, offsets, call_spans, out|:
                            allocation_regions_in_expression(argument, regions, lines, offsets, call_spans, out)
                    _:
                        pass


