extend Semantic:
    private:
        def local_type_cannot_carry_region(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        false return if operator == TokenKind.Ampersand
                        local_type_cannot_carry_region(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return false
                    Expr.Index(object, argument, line):
                        match object:
                            Expr.Ident(head, head_line):
                                return head == "array"
                            _:
                                return false
                    Expr.IndexN(object, arguments, line):
                        match object:
                            Expr.Ident(head, head_line):
                                return head == "array"
                            _:
                                return false
                    Expr.Ident(name, line):
                        return is_integer_type_name(name) or is_float_type_name(name) or name == "bool" or name == "char" or name == "void"
                    _:
                        return false


        # As above, but a `region NAME:` BLOCK only counts when it is already open at
        # USE_LINE. `outer: darray[u8] @a = []` written ABOVE `region a(4096):` names a
        # region that does not exist yet, which stage0 reports as an unknown qualifier
        # (verified: the same annotation INSIDE the block is accepted).
        #
        # A `__region_param` (`def f[@r]`) is function-wide and carries no ordering.
        def local_region_is_in_scope(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, use_line: u32) -> bool:
            can Abort.Panic:
                true return if any annotation in annotations where annotation.name == "__region_param" and annotation.region == region
                # An `Arena&`-typed LOCAL declared earlier in the body owns a region too --
                # `alloc: mutable Arena& = ...` then `xs: darray[i64] @alloc = [...]`, which
                # stage0 accepts and stage1 rejected as an unknown region qualifier.
                true return if any annotation in annotations where annotation.name == "__region_arena_local" and annotation.region == region and annotation.line <= use_line
                return any annotation in annotations where annotation.name == "__region_local" and annotation.region == region and annotation.line <= use_line


        def local_region_annotation_of(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32) -> Ast::LocalRegionAnnotation?:
            can Abort.Panic:
                found: mutable Ast::LocalRegionAnnotation? = null
                for annotation in annotations |found|:
                    found <- annotation if annotation.name == name and annotation.line <= before_line
                return found


        def region_reference_base(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return region_reference_base(operand)
                    Expr.Ident(name, line):
                        return name
                    _:
                        return "reference"


        def region_is_function_local(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, function_line: u32, use_line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__region_local" and annotation.region == region and annotation.line >= function_line and annotation.line <= use_line


        def allocation_region_at(regions: darray[sview]&, lines: darray[u32]&, line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                for allocation_line in lines |index: usize = 0, found|:
                    found <- regions[index] if allocation_line == line
                    index <- index + 1
                return found


        def allocated_local_region(statements: darray[Ast::Stmt]&, regions: darray[sview]&, lines: darray[u32]&, name: sview, before_line: u32) -> sview:
            can Abort.Panic:
                found: mutable sview = ""
                for statement in statements |found|:
                    match statement:
                        Stmt.VarDecl(local_name, type_expression, value, line):
                            allocation_region: sview = allocation_region_at(regions, lines, line.line)
                            direct_allocation: bool = allocation_region != "" and region_expression_is_direct_allocation(value, allocation_region)
                            found <- allocation_region if local_name == name and line.line <= before_line and direct_allocation
                        _:
                            pass
                return found


        def region_return_source_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name
                    Expr.Index(object, target_type, line):
                        match object:
                            Expr.Field(receiver, field, field_line):
                                return region_return_source_name(receiver) if field == "cast" else ""
                            _:
                                return ""
                    _:
                        return ""


        def function_return_region(annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.region return if annotation.name == "__region_return" and annotation.line == function_line
                return ""


        def function_param_region_index(function: Ast::Decl, annotations: darray[Ast::LocalRegionAnnotation]&, region: sview) -> int:
            can Abort.Panic:
                match function:
                    Decl.Func(name, params, return_type, body, effects, decorators, line):
                        for param in params |index: int = 0|:
                            matching: bool = any annotation in annotations where annotation.name == param.name and annotation.line == line.line and annotation.region == region
                            index return if matching
                            index <- index + 1
                    _:
                        pass
                return -1


        def region_call_result_is_uninferable(expression: Ast::Expr, declarations: darray[Ast::Decl]&, annotations: darray[Ast::LocalRegionAnnotation]&, caller_line: u32) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(Expr.Ident(callee_name, callee_line), arguments, argument_names, call_line):
                        for declaration in declarations:
                            match declaration:
                                Decl.Func(function_name, params, return_type, body, effects, decorators, function_line):
                                    continue if function_name != callee_name
                                    return_region: sview = function_return_region(annotations, function_line.line)
                                    continue if return_region == ""
                                    param_index: int = function_param_region_index(declaration, annotations, return_region)
                                    continue if param_index < 0 or param_index.usize() >= arguments.count
                                    match arguments[param_index.usize()]:
                                        Expr.Ident(argument_name, argument_line):
                                            argument_has_region: bool = any annotation in annotations where annotation.name == argument_name and annotation.line == caller_line
                                            return_region return if not argument_has_region
                                        _:
                                            pass
                                Decl.Module(module_name, body, module_line):
                                    nested_region: sview = region_call_result_is_uninferable(expression, body, annotations, caller_line)
                                    nested_region return if nested_region != ""
                                Decl.Scoped(body, module_line):
                                    nested_region: sview = region_call_result_is_uninferable(expression, body, annotations, caller_line)
                                    nested_region return if nested_region != ""
                                _:
                                    pass
                    _:
                        pass
                return ""


        def region_return_can_carry_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        true return if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                        return region_return_can_carry_reference(operand)
                    Expr.Index(head, argument, line):
                        return region_return_can_carry_reference(head) or region_return_can_carry_reference(argument)
                    Expr.IndexN(head, arguments, line):
                        true return if region_return_can_carry_reference(head)
                        for argument in arguments:
                            true return if region_return_can_carry_reference(argument)
                        return false
                    Expr.Paren(inner, line):
                        return region_return_can_carry_reference(inner)
                    _:
                        return false


        def region_tainted_name(names: darray[sview]&, name: sview) -> bool:
            return any candidate in names where candidate == name


        def region_expression_depends_on(expression: Ast::Expr, names: darray[sview]&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return region_tainted_name(names, name)
                    Expr.Call(callee, arguments, argument_names, line):
                        true return if region_expression_depends_on(callee, names)
                        for argument in arguments:
                            true return if region_expression_depends_on(argument, names)
                        return false
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        return region_expression_depends_on(object, names)
                    Expr.Index(object, index, line):
                        return region_expression_depends_on(object, names) or region_expression_depends_on(index, names)
                    Expr.Slice(object, low, high, line):
                        return region_expression_depends_on(object, names) or region_expression_depends_on(low, names) or region_expression_depends_on(high, names)
                    Expr.IndexN(object, arguments, line):
                        true return if region_expression_depends_on(object, names)
                        for argument in arguments:
                            true return if region_expression_depends_on(argument, names)
                        return false
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        return region_expression_depends_on(operand, names)
                    Expr.Binary(left, operator, right, line) | Expr.Refinement(left, right, line):
                        return region_expression_depends_on(left, names) or region_expression_depends_on(right, names)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements:
                            true return if region_expression_depends_on(element, names)
                        return false
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields:
                            true return if region_expression_depends_on(field.value, names)
                        return false
                    _:
                        return false


        # The parser records every `new[r]` token by source line. A variable declaration can
        # therefore share its line with a temporary allocation passed to a call, even when the
        # variable itself is an ordinary scalar:
        #
        #     result: i64 = read(new[r] 7)
        #
        # Only a declaration whose value is the allocation itself acquires that region as its
        # stored lifetime. A consumed call temporary must not taint the scalar result.
        def region_expression_is_direct_allocation(expression: Ast::Expr, region: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.RegionNew(operand, allocation_region, line):
                        return allocation_region == region
                    Expr.Paren(inner, line):
                        return region_expression_is_direct_allocation(inner, region)
                    _:
                        return false


        def taint_move_bindings(body: darray[Ast::Stmt]&, tainted: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if body.count == 0
                match body[0]:
                    Stmt.Match(scrutinee, arms, line):
                        return if not region_expression_depends_on(scrutinee, tainted)
                        for statement in body |tainted|:
                            match statement:
                                Stmt.VarDecl(name, type_expression, value, decl_line):
                                    tainted.push(name) if not region_tainted_name(tainted, name)
                                _:
                                    pass
                    _:
                        pass


        def walk_local_region_dependencies(statements: darray[Ast::Stmt], region: sview, return_carries_reference: bool, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, tainted: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |tainted, table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            allocated_here: bool = allocation_region_at(allocation_regions, allocation_lines, line.line) == region and region_expression_is_direct_allocation(value, region)
                            tainted.push(name) if (allocated_here or region_expression_depends_on(value, tainted)) and not region_tainted_name(tainted, name)
                        Stmt.Assign(target, operator, value, line):
                            target_name: sview = region_return_source_name(target)
                            tainted.push(target_name) if target_name != "" and region_expression_depends_on(value, tainted) and not region_tainted_name(tainted, target_name)
                        Stmt.Return(value, line):
                            if value is returned:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: region_return_source_name(returned), line: line.line, expected: "", actual: region}) if return_carries_reference and region_expression_depends_on(returned, tainted)
                        Stmt.Block("move", clause, binding, body, line):
                            taint_move_bindings(body, tainted)
                            table <- walk_local_region_dependencies(body, region, return_carries_reference, allocation_regions, allocation_lines, tainted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_local_region_dependencies(body, region, return_carries_reference, allocation_regions, allocation_lines, tainted, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_local_region_dependencies(then_body, region, return_carries_reference, allocation_regions, allocation_lines, tainted, table)
                            table <- walk_local_region_dependencies(else_body, region, return_carries_reference, allocation_regions, allocation_lines, tainted, table)
                        Stmt.While(condition, body, line) | Stmt.For(_, _, condition, body, line):
                            table <- walk_local_region_dependencies(body, region, return_carries_reference, allocation_regions, allocation_lines, tainted, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |tainted, table|:
                                table <- walk_local_region_dependencies(arm.body, region, return_carries_reference, allocation_regions, allocation_lines, tainted, table)
                        _:
                            pass


        def check_local_region_dependencies(statements: darray[Ast::Stmt], return_type: Ast::Expr, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block("region", clause, binding, body, line):
                            tainted: mutable darray[sview] = []
                            table <- walk_local_region_dependencies(body, binding, region_return_can_carry_reference(return_type), allocation_regions, allocation_lines, tainted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_local_region_dependencies(body, return_type, allocation_regions, allocation_lines, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_local_region_dependencies(then_body, return_type, allocation_regions, allocation_lines, table)
                            table <- check_local_region_dependencies(else_body, return_type, allocation_regions, allocation_lines, table)
                        _:
                            pass


        def check_region_assignment_statements(statements: darray[Ast::Stmt], declarations: darray[Ast::Decl]&, annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, function_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, Expr.Ident(source_name, source_line), line):
                            if local_region_annotation_of(annotations, name, line.line) is target_annotation and local_region_annotation_of(annotations, source_name, line.line) is source_annotation:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionQualifierMismatch, name: name, line: line.line, expected: target_annotation.region, actual: source_annotation.region, detail: region_reference_base(target_annotation.type_expression)}) if target_annotation.region != source_annotation.region
                        Stmt.Return(value, line):
                            if value is return_value:
                                uninferred_region: sview = region_call_result_is_uninferable(return_value, declarations, annotations, function_line)
                                caller_return_region: sview = function_return_region(annotations, function_line)
                                # stage0 names the region after the CALLER-side binding it
                                # was inferred from ("__rg_value" for identity(value)); the
                                # renderer adds the __rg_ prefix around this recorded name.
                                inferred_source_name: mutable sview = ""
                                match return_value:
                                    Expr.Call(region_callee, region_arguments, region_argument_names, region_call_line):
                                        inferred_source_name <- ident_name_of(region_arguments[0]) if region_arguments.count > 0
                                    _:
                                        pass
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionParamInferenceFailure, name: inferred_source_name, line: line.line, expected: "", actual: uninferred_region}) if uninferred_region != "" and caller_return_region == ""
                                return_name: sview = region_return_source_name(return_value)
                                if return_name != "":
                                    if local_region_annotation_of(annotations, return_name, line.line) is return_annotation:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: return_name, line: line.line, expected: "", actual: return_annotation.region}) if region_is_function_local(annotations, return_annotation.region, function_line, line.line)
                                    allocation_region: sview = allocated_local_region(statements, allocation_regions, allocation_lines, return_name, line.line)
                                    has_explicit_region: bool = any annotation in annotations where annotation.name == return_name and annotation.line <= line.line
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRegionReferenceEscape, name: return_name, line: line.line, expected: "", actual: allocation_region}) if not has_explicit_region and allocation_region != "" and region_is_function_local(annotations, allocation_region, function_line, line.line)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_region_assignment_statements(then_body, declarations, annotations, allocation_regions, allocation_lines, function_line, table)
                            table <- check_region_assignment_statements(else_body, declarations, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.While(condition, body, line):
                            table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, function_line, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_region_assignment_statements(arm.body, declarations, annotations, allocation_regions, allocation_lines, function_line, table)
                        _:
                            pass


        def check_region_assignment_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, allocation_regions: darray[sview]&, allocation_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_region_assignment_statements(body, declarations, annotations, allocation_regions, allocation_lines, line.line, table)
                            table <- check_local_region_dependencies(body, function_return_type, allocation_regions, allocation_lines, table) if return_type is function_return_type
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_region_assignment_declarations(body, annotations, allocation_regions, allocation_lines, table)
                        _:
                            pass

        # Names bound as `owned Arena` (locals or parameters) anywhere in the file: an
        # owned linear region is a legal `@name` qualifier and `new[name]` target
        # (`r: owned Arena = new_arena(64); n: Node[r]& @r = new[r] ...`).
        def collect_owned_region_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            out.extend([parameter.name for parameter in parameters if annotation_is_owned(parameter.type_expression)])
                            collect_owned_region_locals(body, out)
                        Decl.Module(module_name, module_body, module_line):
                            collect_owned_region_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_owned_region_names(scoped_body, out)
                        _:
                            pass


        def collect_owned_region_locals(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if annotation_is_owned(type_expression)
                        Stmt.If(condition, then_body, else_body, if_line):
                            collect_owned_region_locals(then_body, out)
                            collect_owned_region_locals(else_body, out)
                        Stmt.While(condition, while_body, while_line):
                            collect_owned_region_locals(while_body, out)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            collect_owned_region_locals(block_body, out)
                        _:
                            pass


    public:
        def check_local_region_annotation(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owned_regions: mutable darray[sview] = []
                collect_owned_region_names(file.top_decls, owned_regions)
                for annotation in file.local_region_annotations |owned_regions, table|:
                    continue if annotation.name in {"__region_local", "__region_param"}
                    # An `owned Arena` binding is itself a region qualifier.
                    continue if any owned_name in owned_regions where owned_name == annotation.region
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAnnotationOnNonRegionLocal, name: annotation.name, line: annotation.line, expected: "", actual: annotation.region}) if local_type_cannot_carry_region(annotation.type_expression)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownRegionQualifier, name: annotation.name, line: annotation.line, expected: "", actual: annotation.region}) if not local_type_cannot_carry_region(annotation.type_expression) and not local_region_is_in_scope(file.local_region_annotations, annotation.region, annotation.line)
                table <- check_region_assignment_declarations(file.top_decls, file.local_region_annotations, file.allocation_region_names, file.allocation_region_lines, table)
