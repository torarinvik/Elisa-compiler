# A LEADING decorator on a struct field (`@owner` / `@align(8)` on its own line, before
# `x: i32`). The spelling is legal only inside an enum's `common:` block — that is where
# `@storage(inline)` lives — so stage0 parses it and rejects it with one sentence naming the
# decorator. stage1's struct parser used to skip the `@` as an unknown token and then read
# the decorator NAME as the field name, turning one mistake into a four-error parse cascade;
# the parser now records a 3900000045 row instead and this reports it.
extend Semantic:
    public:
        def check_struct_field_annotation(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldAnnotationUnsupported, name: annotation.name, line: annotation.detail_line, pos: annotation.pos, expected: "", actual: annotation.owner}) if annotation.line == 3900000045
                    # 3900000046: the same shape one block over — a decorator on a protocol
                    # member, which stage0 rejects with its own sentence at the member's `def`.
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InterfaceMemberAnnotationUnsupported, name: annotation.name, line: annotation.detail_line, pos: annotation.pos, expected: "", actual: annotation.owner}) if annotation.line == 3900000046
