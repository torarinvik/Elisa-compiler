# Mutable-view capability checks at function call and return boundaries.
extend Semantic:
    private:
        def check_mutable_view_value_against(expected_type: Ast::Expr, value: Ast::Expr, name: sview @source, expected_module: sview, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl], depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth > 64
                expected_family: sview = mv_type_family(expected_type, expected_module, table)
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        check_mutable_view_value_against(expected_type, inner, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        return
                    Expr.If(_, then_value, else_value, _):
                        check_mutable_view_value_against(expected_type, then_value, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        check_mutable_view_value_against(expected_type, else_value, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        return
                    Expr.Block(statements, block_value, _, _):
                        scope_mark: usize = var_types.count
                        expression_mark: usize = type_expressions.count
                        for statement in statements |table|:
                            match statement:
                                Stmt.VarDecl(local_name, local_type, _, _):
                                    local_family: sview = mv_type_family(local_type, current_module, table)
                                    local_name_type: sview = local_family if local_family == "array" or local_family == "mutable_array" or local_family == "darray" or local_family == "mutable_darray" or local_family == "view" or local_family == "mutable_view" else bare_type_name_through_ref(local_type)
                                    note_local_type(var_types, type_names, local_name, local_name_type)
                                    type_expressions.push(local_type)
                                    expression_names.push(local_name)
                                    note_local_type_id_direct(local_name, annotation_type_id(local_type, table) can Global{Read,Write}, table)
                                _:
                                    pass
                        check_mutable_view_value_against(expected_type, block_value, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        close_type_scope(scope_mark, var_types, type_names, table)
                        type_expressions.truncate(expression_mark)
                        expression_names.truncate(expression_mark)
                        return
                    _:
                        pass
                is_arm_expression: bool = match value:
                    Expr.Match(_, _, _) | Expr.Catch(_, _, _): true
                    _: false
                if expected_family == "mutable_view" and not is_arm_expression:
                    match value:
                        Expr.Call(callee, _, _, _):
                            returned: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_call_return_type(callee, declarations, current_module, expression_names, table)
                            return if returned.found and mv_type_family(returned.type_expression, returned.module_owner, table) == "mutable_view"
                            if returned.found and mv_type_family(returned.type_expression, returned.module_owner, table) == "view":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableViewFromReadonlySource, name: name, line: Ast::expr_pos(value).line, expected: "mutable source", actual: "readonly function result"})
                            else:
                                check_mutable_view_slice_source(name, value, Ast::expr_pos(value).line, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        _:
                            check_mutable_view_slice_source(name, value, Ast::expr_pos(value).line, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                    return
                match value:
                    Expr.If(_, then_value, else_value, _):
                        check_mutable_view_value_against(expected_type, then_value, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        check_mutable_view_value_against(expected_type, else_value, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        for arm in arms |expected_type, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth|:
                            scope_mark: usize = var_types.count
                            expression_mark: usize = type_expressions.count
                            bindings: mutable darray[sview @source] = []
                            collect_pattern_binding_names(arm.pattern, bindings)
                            for binding_name in bindings |table|:
                                note_local_type(var_types, type_names, binding_name, "__firm_scope_binder__")
                                type_expressions.push(Expr.Absent)
                                expression_names.push(binding_name)
                                note_local_type_id_direct(binding_name, 0, table)
                            if arm.body.count > 0:
                                statement_index: usize = 0
                                while statement_index + 1.usize() < arm.body.count |statement_index, current_module, table, var_types, type_names, type_expressions, expression_names|:
                                    match arm.body[statement_index]:
                                        Stmt.VarDecl(local_name, local_type, _, _):
                                            local_family: sview = mv_type_family(local_type, current_module, table)
                                            local_name_type: sview = local_family if local_family == "array" or local_family == "mutable_array" or local_family == "darray" or local_family == "mutable_darray" or local_family == "view" or local_family == "mutable_view" else bare_type_name_through_ref(local_type)
                                            note_local_type(var_types, type_names, local_name, local_name_type)
                                            type_expressions.push(local_type)
                                            expression_names.push(local_name)
                                            note_local_type_id_direct(local_name, annotation_type_id(local_type, table) can Global{Read,Write}, table)
                                        _:
                                            pass
                                    statement_index <- statement_index + 1.usize()
                                match arm.body[arm.body.count - 1.usize()]:
                                    Stmt.Expr(arm_value, _):
                                        check_mutable_view_value_against(expected_type, arm_value, name, expected_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                                    _:
                                        pass
                            close_type_scope(scope_mark, var_types, type_names, table)
                            type_expressions.truncate(expression_mark)
                            expression_names.truncate(expression_mark)
                    Expr.Array(elements, _):
                        element: (found: bool, type_expression: Ast::Expr) = mv_type_element(expected_type, expected_module, table)
                        element_module: sview = mv_type_element_owner(expected_type, expected_module, table) if element.found else expected_module
                        if element.found:
                            for item in elements |element, element_module, name, current_module, table, var_types, type_names, type_expressions, expression_names, depth|:
                                check_mutable_view_value_against(element.type_expression, item, name, element_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Comprehension(loop_variable, iterable, condition, body, _, _):
                        element: (found: bool, type_expression: Ast::Expr) = mv_type_element(expected_type, expected_module, table)
                        if element.found:
                            element_module: sview = mv_type_element_owner(expected_type, expected_module, table)
                            scope_mark: usize = var_types.count
                            expression_mark: usize = type_expressions.count
                            mv_note_iterable_element_binding(loop_variable, iterable, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                            check_mutable_view_value_against(element.type_expression, body, name, element_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                            close_type_scope(scope_mark, var_types, type_names, table)
                            type_expressions.truncate(expression_mark)
                            expression_names.truncate(expression_mark)
                    Expr.SetLit(elements, _):
                        element: (found: bool, type_expression: Ast::Expr) = mv_type_element(expected_type, expected_module, table)
                        element_module: sview = mv_type_element_owner(expected_type, expected_module, table) if element.found else expected_module
                        if element.found:
                            for item in elements |element, element_module, name, current_module, table, var_types, type_names, type_expressions, expression_names, depth|:
                                check_mutable_view_value_against(element.type_expression, item, name, element_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.DictLit(entries, _):
                        element: (found: bool, type_expression: Ast::Expr) = mv_type_element(expected_type, expected_module, table)
                        element_module: sview = mv_type_element_owner(expected_type, expected_module, table) if element.found else expected_module
                        if element.found:
                            for entry in entries |element, element_module, name, current_module, table, var_types, type_names, type_expressions, expression_names, depth|:
                                check_mutable_view_value_against(element.type_expression, entry.value, name, element_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Tuple(elements, _):
                        expected_tuple: (found: bool, elements: darray[Ast::Expr], module_owner: sview) = mv_type_tuple_elements(expected_type, expected_module, table)
                        if expected_tuple.found:
                            for index in 0..<elements.count |expected_tuple, elements, index, name, current_module, table, var_types, type_names, type_expressions, expression_names, depth|:
                                check_mutable_view_value_against(expected_tuple.elements[index], elements[index], name, expected_tuple.module_owner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32()) if index < expected_tuple.elements.count
                    _:
                        pass


        def check_mutable_view_container_mutation(callee: Ast::Expr, arguments: darray[Ast::Expr], line: u32, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl]) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, _):
                        receiver_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(receiver, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        global_receiver_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_global_const_type(receiver, declarations, current_module, expression_names, table) if not receiver_type.found else (false, Expr.Absent, "")
                        resolved_receiver_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = receiver_type if receiver_type.found else global_receiver_type
                        return if not resolved_receiver_type.found
                        receiver_module: sview = resolved_receiver_type.module_owner
                        receiver_family: sview = mv_type_family(resolved_receiver_type.type_expression, receiver_module, table)
                        value_index: usize = arguments.count
                        if receiver_family == "mutable_darray" and method == "push" and arguments.count == 1:
                            value_index <- 0
                        elif (receiver_family == "set" or receiver_family == "mutable_set") and (method == "add" or method == "insert") and arguments.count == 1:
                            value_index <- 0
                        elif (receiver_family == "dict" or receiver_family == "mutable_dict") and (method == "put" or method == "get_or_insert") and arguments.count > 1:
                            value_index <- 1
                        elif receiver_family == "mutable_darray" and method == "insert" and arguments.count == 2:
                            value_index <- 1
                        if value_index < arguments.count:
                            element: (found: bool, type_expression: Ast::Expr) = mv_type_element(resolved_receiver_type.type_expression, receiver_module, table)
                            element_module: sview = mv_type_element_owner(resolved_receiver_type.type_expression, receiver_module, table) if element.found else receiver_module
                            check_mutable_view_value_against(element.type_expression, arguments[value_index], "container element", element_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations) if element.found
                        if receiver_family == "mutable_darray" and method == "extend" and arguments.count == 1:
                            target_element: (found: bool, type_expression: Ast::Expr) = mv_type_element(resolved_receiver_type.type_expression, receiver_module, table)
                            target_element_module: sview = mv_type_element_owner(resolved_receiver_type.type_expression, receiver_module, table) if target_element.found else receiver_module
                            check_mutable_view_extend_source(target_element.type_expression, arguments[0], target_element_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations) if target_element.found
                        if method == "insert" and arguments.count == 1:
                            match receiver:
                                Expr.Call(entry_callee, entry_arguments, _, _):
                                    match entry_callee:
                                        Expr.Field(dict_receiver, "entry", _):
                                            dict_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(dict_receiver, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                                            dict_module: sview = dict_type.module_owner
                                            dict_family: sview = mv_type_family(dict_type.type_expression, dict_module, table) if dict_type.found else ""
                                            dict_value: (found: bool, type_expression: Ast::Expr) = mv_type_element(dict_type.type_expression, dict_module, table) if dict_type.found and (dict_family == "dict" or dict_family == "mutable_dict") else (false, Expr.Absent)
                                            dict_value_module: sview = mv_type_element_owner(dict_type.type_expression, dict_module, table) if dict_value.found else dict_module
                                            check_mutable_view_value_against(dict_value.type_expression, arguments[0], "container element", dict_value_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations) if dict_value.found
                                        _:
                                            pass
                                _:
                                    pass
                    _:
                        pass


        def mv_selective_import_owner_status(module_owner: sview, name: sview, current_module: sview, table: SymbolTable&) -> (found: bool, known: bool, first: bool):
            can Memory.Allocate, Abort.Panic:
                for source in table.definite_import_annotations |module_owner, name, current_module, table|:
                    continue if source.owner != "__from_src"
                    resolved_owner: sview = binding_import_module_owner(source.name, source.module, table)
                    continue if resolved_owner != module_owner
                    selected: (found: bool, known: bool, first: bool) = pma_selective_import_target_status(table.definite_import_annotations, current_module, source.name, name)
                    return selected if selected.found
                return (false, false, false)


        def mv_global_const_owner_matches(module_owner: sview, name: sview, current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                all_count: usize = 0
                for symbol in table.symbols |all_count, module_owner, name, current_module|:
                    continue if symbol.kind != SymbolKind.Const or symbol.name != name
                    all_count <- all_count + 1
                # Reuse the semantic nominal resolver's lexical/import/root precedence. A
                # local-module declaration beats imports, selected imports beat root fallback,
                # and tied or unresolved imports remain unknown.
                selected_row: u32 = binding_nominal_declaration(Expr.Ident(name, Ast::pos_at_line(0)), current_module, table, true)
                if selected_row != SYMBOL_INDEX_ROW_NONE:
                    selected_symbol: Symbol = table.symbols[selected_row.usize()]
                    return false if selected_symbol.kind != SymbolKind.Const or selected_symbol.name != name
                    # A non-root lexical declaration already outranks imports. The root
                    # fallback and imported candidate still need the possible-import guard.
                    if selected_symbol.module_owner != "" and named_type_owner_is_lexical(selected_symbol.module_owner, current_module):
                        return selected_symbol.module_owner == module_owner
                # A possible import can still supply the bare name; do not classify an
                # unrelated unique external global before its branch/owner is known.
                possible_import: bool = semantic_possible_import_may_select_type(table, name, SymbolKind.Const, current_module, true)
                return false if possible_import
                return table.symbols[selected_row.usize()].module_owner == module_owner if selected_row != SYMBOL_INDEX_ROW_NONE
                # The binding resolver conservatively rejects multiple selective imports,
                # while Elisa's first same-scope import remains authoritative. Recover that
                # exact winner from the active import annotations before falling back to a
                # globally unique unimported name.
                selected_import_owner: mutable sview = ""
                selected_import_count: mutable usize = 0
                for symbol in table.symbols |selected_import_owner, selected_import_count, current_module, name, table|:
                    continue if symbol.kind != SymbolKind.Const or symbol.name != name
                    imported: (found: bool, known: bool, first: bool) = mv_selective_import_owner_status(symbol.module_owner, name, current_module, table)
                    if imported.found and imported.known and imported.first:
                        selected_import_owner <- symbol.module_owner
                        selected_import_count <- selected_import_count + 1.usize()
                if selected_import_count > 0:
                    return selected_import_count == 1 and module_owner == selected_import_owner
                if all_count == 1:
                    for symbol in table.symbols |module_owner, name|:
                        return symbol.module_owner == module_owner if symbol.kind == SymbolKind.Const and symbol.name == name
                return false


        def mv_scan_global_const_type(declarations: darray[Ast::Decl], module_owner: sview, name: sview, qualified: bool, qualifier_path: sview @source, current_module: sview, position: Ast::Pos, matches: mutable usize&, type_expression: mutable Ast::Expr&, type_module: mutable sview&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |matches, type_expression, type_module, module_owner, name, qualified, qualifier_path, current_module, position, table|:
                    match declaration:
                        Decl.Const(const_name, declared_type, _, _, _):
                            continue if const_name != name
                            resolved: bool = mv_qualified_owner_matches(module_owner, qualifier_path, current_module, position.offset, table) if qualified else mv_global_const_owner_matches(module_owner, name, current_module, table)
                            if resolved:
                                matches <- matches + 1
                                type_expression <- declared_type
                                type_module <- module_owner
                        Decl.Module(nested_module, body, _):
                            mv_scan_global_const_type(body, nested_module, name, qualified, qualifier_path, current_module, position, matches, type_expression, type_module, table)
                        Decl.Scoped(body, _):
                            mv_scan_global_const_type(body, module_owner, name, qualified, qualifier_path, current_module, position, matches, type_expression, type_module, table)
                        _:
                            pass


        def mv_global_const_type(source: Ast::Expr, declarations: darray[Ast::Decl], current_module: sview, expression_names: darray[sview]&, table: SymbolTable&) -> (found: bool, type_expression: Ast::Expr, module_owner: sview):
            can Memory.Allocate, Abort.Panic:
                name: sview = ""
                qualified: mutable bool = false
                qualifier_path: mutable sview @source = ""
                position: Ast::Pos = Ast::pos_at_line(0)
                match source:
                    Expr.Ident(identifier, identifier_position):
                        return (false, Expr.Absent, "") if any local_name in expression_names where local_name == identifier
                        name <- identifier
                        position <- identifier_position
                    Expr.Scope(base, member, member_position):
                        qualifier: (valid: bool, path: sview @source, head: sview @source) = mv_scope_path(base, table)
                        return (false, Expr.Absent, "") if not qualifier.valid or any local_name in expression_names where local_name == qualifier.head
                        name <- member
                        qualifier_path <- qualifier.path
                        qualified <- true
                        position <- member_position
                    _:
                        return (false, Expr.Absent, "")
                matches: mutable usize = 0
                type_expression: mutable Ast::Expr = Expr.Absent
                type_module: mutable sview = ""
                mv_scan_global_const_type(declarations, "", name, qualified, qualifier_path, current_module, position, matches, type_expression, type_module, table)
                return (false, Expr.Absent, "") if matches != 1
                return (true, type_expression, type_module)


        def check_mutable_view_extend_source(target_element: Ast::Expr, source: Ast::Expr, target_module: sview, current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl], depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth > 64 or mv_type_family(target_element, target_module, table) != "mutable_view"
                match source:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        check_mutable_view_extend_source(target_element, inner, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.If(_, then_value, else_value, _):
                        check_mutable_view_extend_source(target_element, then_value, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        check_mutable_view_extend_source(target_element, else_value, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Block(statements, block_value, _, _):
                        scope_mark: usize = var_types.count
                        expression_mark: usize = type_expressions.count
                        for statement in statements |table|:
                            match statement:
                                Stmt.VarDecl(local_name, local_type, _, _):
                                    local_family: sview = mv_type_family(local_type, current_module, table)
                                    local_name_type: sview = local_family if local_family == "array" or local_family == "mutable_array" or local_family == "darray" or local_family == "mutable_darray" or local_family == "view" or local_family == "mutable_view" else bare_type_name_through_ref(local_type)
                                    note_local_type(var_types, type_names, local_name, local_name_type)
                                    type_expressions.push(local_type)
                                    expression_names.push(local_name)
                                    note_local_type_id_direct(local_name, annotation_type_id(local_type, table) can Global{Read,Write}, table)
                                _:
                                    pass
                        check_mutable_view_extend_source(target_element, block_value, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        close_type_scope(scope_mark, var_types, type_names, table)
                        type_expressions.truncate(expression_mark)
                        expression_names.truncate(expression_mark)
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        for arm in arms |target_element, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth|:
                            scope_mark: usize = var_types.count
                            expression_mark: usize = type_expressions.count
                            bindings: mutable darray[sview @source] = []
                            collect_pattern_binding_names(arm.pattern, bindings)
                            for binding_name in bindings |table|:
                                note_local_type(var_types, type_names, binding_name, "__firm_scope_binder__")
                                type_expressions.push(Expr.Absent)
                                expression_names.push(binding_name)
                                note_local_type_id_direct(binding_name, 0, table)
                            if arm.body.count > 0:
                                statement_index: usize = 0
                                while statement_index + 1.usize() < arm.body.count |statement_index, current_module, table, var_types, type_names, type_expressions, expression_names|:
                                    match arm.body[statement_index]:
                                        Stmt.VarDecl(local_name, local_type, _, _):
                                            local_family: sview = mv_type_family(local_type, current_module, table)
                                            local_name_type: sview = local_family if local_family == "array" or local_family == "mutable_array" or local_family == "darray" or local_family == "mutable_darray" or local_family == "view" or local_family == "mutable_view" else bare_type_name_through_ref(local_type)
                                            note_local_type(var_types, type_names, local_name, local_name_type)
                                            type_expressions.push(local_type)
                                            expression_names.push(local_name)
                                            note_local_type_id_direct(local_name, annotation_type_id(local_type, table) can Global{Read,Write}, table)
                                        _:
                                            pass
                                    statement_index <- statement_index + 1.usize()
                                match arm.body[arm.body.count - 1.usize()]:
                                    Stmt.Expr(arm_value, _):
                                        check_mutable_view_extend_source(target_element, arm_value, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                                    _:
                                        pass
                            close_type_scope(scope_mark, var_types, type_names, table)
                            type_expressions.truncate(expression_mark)
                            expression_names.truncate(expression_mark)
                    Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for item in elements |target_element, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth|:
                            check_mutable_view_value_against(target_element, item, "container element", target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Comprehension(loop_variable, iterable, _, body, _, _):
                        scope_mark: usize = var_types.count
                        expression_mark: usize = type_expressions.count
                        mv_note_iterable_element_binding(loop_variable, iterable, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        check_mutable_view_value_against(target_element, body, "container element", target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                        close_type_scope(scope_mark, var_types, type_names, table)
                        type_expressions.truncate(expression_mark)
                        expression_names.truncate(expression_mark)
                    Expr.Slice(container, _, _, _):
                        check_mutable_view_extend_source(target_element, container, target_module, current_module, table, var_types, type_names, type_expressions, expression_names, declarations, depth + 1.u32())
                    Expr.Call(callee, _, _, _):
                        returned: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_call_return_type(callee, declarations, current_module, expression_names, table)
                        returned_element: (found: bool, type_expression: Ast::Expr) = mv_type_element(returned.type_expression, returned.module_owner, table) if returned.found else (false, Expr.Absent)
                        returned_element_module: sview = mv_type_element_owner(returned.type_expression, returned.module_owner, table) if returned_element.found else returned.module_owner
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableViewFromReadonlySource, name: "container element", line: Ast::expr_pos(source).line, expected: "mutable source", actual: "readonly container element"}) if returned_element.found and mv_type_family(returned_element.type_expression, returned_element_module, table) == "view"
                    _:
                        source_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_projected_type(source, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                        global_source: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_global_const_type(source, declarations, current_module, expression_names, table) if not source_type.found else (false, Expr.Absent, "")
                        resolved_source_type: (found: bool, type_expression: Ast::Expr, module_owner: sview) = source_type if source_type.found else global_source
                        source_element: (found: bool, type_expression: Ast::Expr) = mv_type_element(resolved_source_type.type_expression, resolved_source_type.module_owner, table) if resolved_source_type.found else (false, Expr.Absent)
                        source_element_module: sview = mv_type_element_owner(resolved_source_type.type_expression, resolved_source_type.module_owner, table) if source_element.found else resolved_source_type.module_owner
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableViewFromReadonlySource, name: "container element", line: Ast::expr_pos(source).line, expected: "mutable source", actual: "readonly container element"}) if source_element.found and mv_type_family(source_element.type_expression, source_element_module, table) == "view"


        def mv_scan_function_parameter(declarations: darray[Ast::Decl], module_owner: sview, function_name: sview, qualified: bool, qualifier_path: sview @source, current_module: sview, call_pos: Ast::Pos, argument_position: usize, argument_name: sview, matches: mutable usize&, parameter_type: mutable Ast::Expr&, parameter_module: mutable sview&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |matches, parameter_type, parameter_module, module_owner, function_name, qualified, qualifier_path, current_module, call_pos, argument_position, argument_name, table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            continue if name != function_name
                            resolved: bool = mv_qualified_owner_matches(module_owner, qualifier_path, current_module, call_pos.offset, table) if qualified else mv_unqualified_function_owner_matches(module_owner, function_name, current_module, table)
                            if resolved:
                                matches <- matches + 1
                                selected: usize = parameters.count if argument_name != "" else argument_position
                                if argument_name != "":
                                    for index in 0..<parameters.count |selected, parameters, argument_name|:
                                        selected <- index if parameters[index].name == argument_name
                                if selected < parameters.count:
                                    parameter_type <- parameters[selected].type_expression
                                    parameter_module <- module_owner
                        Decl.Module(name, body, line):
                            mv_scan_function_parameter(body, name, function_name, qualified, qualifier_path, current_module, call_pos, argument_position, argument_name, matches, parameter_type, parameter_module, table)
                        Decl.Scoped(body, line):
                            mv_scan_function_parameter(body, module_owner, function_name, qualified, qualifier_path, current_module, call_pos, argument_position, argument_name, matches, parameter_type, parameter_module, table)
                        _:
                            pass


        def mv_call_parameter_type(callee: Ast::Expr, argument_index: usize, argument_names: darray[sview]&, declarations: darray[Ast::Decl], current_module: sview, expression_names: darray[sview]&, table: SymbolTable&) -> (found: bool, type_expression: Ast::Expr, module_owner: sview):
            can Memory.Allocate, Abort.Panic:
                function_name: sview = ""
                qualified: mutable bool = false
                receiver_offset: usize = 0
                qualifier_path: mutable sview @source = ""
                call_pos: Ast::Pos = Ast::pos_at_line(0)
                match callee:
                    Expr.Paren(inner, _):
                        return mv_call_parameter_type(inner, argument_index, argument_names, declarations, current_module, expression_names, table)
                    Expr.IndexN(base, _, _) | Expr.Index(base, _, _):
                        return mv_call_parameter_type(base, argument_index, argument_names, declarations, current_module, expression_names, table) if index_receiver_is_type_application(base)
                        return (false, Expr.Absent, "")
                    Expr.Ident(name, _):
                        return (false, Expr.Absent, "") if any local_name in expression_names where local_name == name
                        function_name <- name
                    Expr.Field(_, name, position):
                        function_name <- name
                        call_pos <- position
                        receiver_offset <- 1
                    Expr.Scope(base, name, position):
                        qualifier: (valid: bool, path: sview @source, head: sview @source) = mv_scope_path(base, table)
                        return (false, Expr.Absent, "") if not qualifier.valid or any local_name in expression_names where local_name == qualifier.head
                        function_name <- name
                        qualifier_path <- qualifier.path
                        qualified <- true
                        call_pos <- position
                    _:
                        return (false, Expr.Absent, "")
                positional_index: usize = 0
                for index in 0..<argument_index |positional_index, argument_names|:
                    positional_index <- positional_index + 1 if index >= argument_names.count or argument_names[index] == ""
                positional_index <- positional_index + receiver_offset
                argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                matches: mutable usize = 0
                parameter_type: mutable Ast::Expr = Expr.Absent
                parameter_module: mutable sview = ""
                mv_scan_function_parameter(declarations, "", function_name, qualified, qualifier_path, current_module, call_pos, positional_index, argument_name, matches, parameter_type, parameter_module, table)
                return (false, Expr.Absent, "") if matches != 1
                return (true, parameter_type, parameter_module)


        def mv_unqualified_function_owner_matches(module_owner: sview, function_name: sview, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                selected_count: usize = 0
                for symbol in table.symbols |selected_count, module_owner, function_name, current_module|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != function_name
                    selected_count <- selected_count + 1 if symbol.module_owner == current_module
                if selected_count > 0:
                    return module_owner == current_module and selected_count == 1
                return direct_function_count(table, function_name) == 1


        def mv_scan_function_return(declarations: darray[Ast::Decl], module_owner: sview, function_name: sview, qualified: bool, qualifier_path: sview @source, current_module: sview, call_pos: Ast::Pos, matches: mutable usize&, return_type: mutable Ast::Expr&, return_module: mutable sview&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |matches, return_type, return_module, module_owner, function_name, qualified, qualifier_path, current_module, call_pos, table|:
                    match declaration:
                        Decl.Func(name, _, function_return, _, _, _, _):
                            continue if name != function_name
                            resolved: bool = mv_qualified_owner_matches(module_owner, qualifier_path, current_module, call_pos.offset, table) if qualified else mv_unqualified_function_owner_matches(module_owner, function_name, current_module, table)
                            if resolved:
                                matches <- matches + 1
                                return_type <- function_return
                                return_module <- module_owner
                        Decl.Module(name, body, _):
                            mv_scan_function_return(body, name, function_name, qualified, qualifier_path, current_module, call_pos, matches, return_type, return_module, table)
                        Decl.Scoped(body, _):
                            mv_scan_function_return(body, module_owner, function_name, qualified, qualifier_path, current_module, call_pos, matches, return_type, return_module, table)
                        _:
                            pass


        def mv_call_return_type(callee: Ast::Expr, declarations: darray[Ast::Decl], current_module: sview, expression_names: darray[sview]&, table: SymbolTable&) -> (found: bool, type_expression: Ast::Expr, module_owner: sview):
            can Memory.Allocate, Abort.Panic:
                function_name: sview = ""
                qualified: mutable bool = false
                qualifier_path: mutable sview @source = ""
                call_pos: Ast::Pos = Ast::pos_at_line(0)
                match callee:
                    Expr.Paren(inner, _):
                        return mv_call_return_type(inner, declarations, current_module, expression_names, table)
                    Expr.IndexN(base, _, _) | Expr.Index(base, _, _):
                        return mv_call_return_type(base, declarations, current_module, expression_names, table) if index_receiver_is_type_application(base)
                        return (false, Expr.Absent, "")
                    Expr.Ident(name, _):
                        return (false, Expr.Absent, "") if any local_name in expression_names where local_name == name
                        function_name <- name
                    Expr.Field(_, name, position):
                        function_name <- name
                        call_pos <- position
                    Expr.Scope(base, name, position):
                        qualifier: (valid: bool, path: sview @source, head: sview @source) = mv_scope_path(base, table)
                        return (false, Expr.Absent, "") if not qualifier.valid or any local_name in expression_names where local_name == qualifier.head
                        function_name <- name
                        qualifier_path <- qualifier.path
                        qualified <- true
                        call_pos <- position
                    _:
                        return (false, Expr.Absent, "")
                matches: mutable usize = 0
                return_type: mutable Ast::Expr = Expr.Absent
                return_module: mutable sview = ""
                mv_scan_function_return(declarations, "", function_name, qualified, qualifier_path, current_module, call_pos, matches, return_type, return_module, table)
                return (false, Expr.Absent, "") if matches != 1
                return (true, return_type, return_module)


        def check_mutable_view_call_arguments(callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview]&, line: u32, declarations: darray[Ast::Decl], current_module: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for argument_index in 0..<arguments.count |argument_names, arguments, callee, line, declarations, current_module, table, var_types, type_names, type_expressions, expression_names|:
                    parameter: (found: bool, type_expression: Ast::Expr, module_owner: sview) = mv_call_parameter_type(callee, argument_index, argument_names, declarations, current_module, expression_names, table)
                    if parameter.found:
                        check_mutable_view_value_against(parameter.type_expression, arguments[argument_index], "argument", parameter.module_owner, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                check_mutable_view_container_mutation(callee, arguments, line, current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
