            EmptyListNeedsType
            FlowStrictBlockIf
            ZipMapSourceNotReadonly
            StructPadding
            SubmitOutsidePool
            InvalidTopLevelScalarMatchArm
            InvalidExportBoundary
            BlockLambdaMissingContext
            LegacyErrorSyntax
            NullableWithoutProof
            AggregateStateArity
            FunctionParameterVariance
            NonExhaustiveCatch
            # A `catch` ARM whose body ends with an assignment. stage0 reads catch arms as
            # match EXPRESSION arms, so each must end with an expression; stage1 accepted the
            # assignment tail. Recorded by the parser as a `__catch_arm_tail` annotation.
            CatchArmTail
            OrdinaryEnumTailPayload
            FloatDictRuntimeKey
            TryRequiresFallible
            ConstFloatCastRange
            ContainerShapeReturn
            InternalRuntimeCarrier
            UngrantedParallelFor
            ParallelOuterMutation
