# Duplicate pattern binding check — detects when a single match arm pattern
# or a for-loop binds the same name twice.

extend Semantic:
    private:
        # Check all arms in a match for duplicate pattern bindings.
        def check_duplicate_pattern_binding_match_arms(arms: darray[Ast::MatchArm], match_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # For now, just check for duplicate for loop variables
                pass


        # Recursively check for duplicate pattern bindings in statements.
        def check_duplicate_pattern_binding_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- check_duplicate_pattern_binding_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_duplicate_pattern_binding_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_duplicate_pattern_binding_expression(target, table)
                            table <- check_duplicate_pattern_binding_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_duplicate_pattern_binding_expression(condition, table)
                            table <- check_duplicate_pattern_binding_statements(then_body, table)
                            table <- check_duplicate_pattern_binding_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_duplicate_pattern_binding_expression(condition, table)
                            table <- check_duplicate_pattern_binding_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            # Check for duplicate variables in the for loop
                            for i in 0..<variables.count:
                                if variables[i] != "_":
                                    for j in i + 1..<variables.count:
                                        if variables[i] == variables[j]:
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicatePatternBinding, name: variables[i], line: line, expected: "", actual: ""})
                            table <- check_duplicate_pattern_binding_expression(iterable, table)
                            table <- check_duplicate_pattern_binding_statements(body, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_duplicate_pattern_binding_expression(return_value, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_duplicate_pattern_binding_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_duplicate_pattern_binding_expression(scrutinee, table)
                            table <- check_duplicate_pattern_binding_match_arms(arms, line, table)
                            for arm in arms |table|:
                                table <- check_duplicate_pattern_binding_statements(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- check_duplicate_pattern_binding_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Recursively check for duplicate pattern bindings in expressions.
        def check_duplicate_pattern_binding_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_duplicate_pattern_binding_expression(callee, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_pattern_binding_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- check_duplicate_pattern_binding_expression(base, table)
                    Expr.Index(object, index, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                        table <- check_duplicate_pattern_binding_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                        table <- check_duplicate_pattern_binding_expression(low, table)
                        table <- check_duplicate_pattern_binding_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_pattern_binding_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_duplicate_pattern_binding_expression(left, table)
                        table <- check_duplicate_pattern_binding_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_duplicate_pattern_binding_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- check_duplicate_pattern_binding_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_pattern_binding_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_pattern_binding_expression(element, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_pattern_binding_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- check_duplicate_pattern_binding_expression(entry.key, table)
                            table <- check_duplicate_pattern_binding_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- check_duplicate_pattern_binding_expression(type_expression, table)
                        for field in fields |table|:
                            table <- check_duplicate_pattern_binding_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- check_duplicate_pattern_binding_expression(base, table)
                        for field in fields |table|:
                            table <- check_duplicate_pattern_binding_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- check_duplicate_pattern_binding_expression(condition, table)
                        table <- check_duplicate_pattern_binding_expression(then_expr, table)
                        table <- check_duplicate_pattern_binding_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- check_duplicate_pattern_binding_expression(scrutinee, table)
                        table <- check_duplicate_pattern_binding_match_arms(arms, line, table)
                        for arm in arms |table|:
                            table <- check_duplicate_pattern_binding_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- check_duplicate_pattern_binding_expression(iterable, table)
                        table <- check_duplicate_pattern_binding_expression(condition, table)
                        table <- check_duplicate_pattern_binding_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- check_duplicate_pattern_binding_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- check_duplicate_pattern_binding_statements(statements, table)
                        table <- check_duplicate_pattern_binding_expression(value, table)
                    _:
                        pass


    public:
        # Entry point: check all function bodies for duplicate pattern bindings.
        def check_duplicate_pattern_binding(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_duplicate_pattern_binding_impl(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_duplicate_pattern_binding(body, table)
                        Decl.Scoped(body, line):
                            table <- check_duplicate_pattern_binding(body, table)
                        _:
                            pass


        # Helper to recurse into declaration bodies.
        def check_duplicate_pattern_binding_impl(body: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_duplicate_pattern_binding_statements(body, table)
