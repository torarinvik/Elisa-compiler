# Duplicate set element check — detects literal element duplicates within a single set literal.
#
# This check walks all set expressions and flags when a literal element appears
# twice in the same set literal. Non-literal elements are ignored.
# Only IntLit, StringLit, and CharLit elements are checked for equality.

extend Semantic:
    private:
        # Recursively check for duplicate literal elements in statements.
        def check_duplicate_set_element_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- check_duplicate_set_element_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_duplicate_set_element_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_duplicate_set_element_expression(target, table)
                            table <- check_duplicate_set_element_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_duplicate_set_element_expression(condition, table)
                            table <- check_duplicate_set_element_statements(then_body, table)
                            table <- check_duplicate_set_element_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_duplicate_set_element_expression(condition, table)
                            table <- check_duplicate_set_element_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_duplicate_set_element_expression(iterable, table)
                            table <- check_duplicate_set_element_statements(body, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_duplicate_set_element_expression(return_value, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_duplicate_set_element_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_duplicate_set_element_expression(scrutinee, table)
                            for arm in arms |table|:
                                table <- check_duplicate_set_element_expression(arm.guard, table)
                                table <- check_duplicate_set_element_statements(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- check_duplicate_set_element_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Recursively check for duplicate literal elements in expressions.
        def check_duplicate_set_element_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_duplicate_set_element_expression(callee, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_set_element_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- check_duplicate_set_element_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- check_duplicate_set_element_expression(base, table)
                    Expr.Index(object, index, line):
                        table <- check_duplicate_set_element_expression(object, table)
                        table <- check_duplicate_set_element_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- check_duplicate_set_element_expression(object, table)
                        table <- check_duplicate_set_element_expression(low, table)
                        table <- check_duplicate_set_element_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- check_duplicate_set_element_expression(object, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_set_element_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_duplicate_set_element_expression(left, table)
                        table <- check_duplicate_set_element_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_duplicate_set_element_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- check_duplicate_set_element_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_set_element_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_set_element_expression(element, table)
                    Expr.SetLit(elements, line):
                        # Check for duplicate literals within this set
                        table <- check_set_literal_duplicates(elements, line, table)
                        # Also recurse into any nested expressions
                        for element in elements |table|:
                            table <- check_duplicate_set_element_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- check_duplicate_set_element_expression(entry.key, table)
                            table <- check_duplicate_set_element_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- check_duplicate_set_element_expression(type_expression, table)
                        for field in fields |table|:
                            table <- check_duplicate_set_element_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- check_duplicate_set_element_expression(base, table)
                        for field in fields |table|:
                            table <- check_duplicate_set_element_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- check_duplicate_set_element_expression(condition, table)
                        table <- check_duplicate_set_element_expression(then_expr, table)
                        table <- check_duplicate_set_element_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- check_duplicate_set_element_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- check_duplicate_set_element_expression(arm.guard, table)
                            table <- check_duplicate_set_element_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- check_duplicate_set_element_expression(iterable, table)
                        table <- check_duplicate_set_element_expression(condition, table)
                        table <- check_duplicate_set_element_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- check_duplicate_set_element_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- check_duplicate_set_element_statements(statements, table)
                        table <- check_duplicate_set_element_expression(value, table)
                    _:
                        # Ident, IntLit, FloatLit, StringLit, CharLit, BoolLit, ShorthandMember, Invalid, etc.
                        # These require no recursion into sub-expressions
                        pass


        # Check a single set literal for duplicate literal elements.
        # Collects all literal element values and flags duplicates.
        def check_set_literal_duplicates(elements: darray[Ast::Expr], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Collect literal texts/values from elements
                seen_ints: mutable darray[i64] = []
                seen_strings: mutable darray[sview] = []
                seen_chars: mutable darray[sview] = []

                for element in elements |table, seen_ints, seen_strings, seen_chars|:
                    match element:
                        Expr.IntLit(value):
                            # Check if this int value was already seen
                            duplicate_int: bool = any previous_value in seen_ints where previous_value == value
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateSetElement, name: "", line: line, expected: "", actual: ""}) if duplicate_int
                            seen_ints.push(value) if not duplicate_int
                        Expr.StringLit(text):
                            # Check if this string text was already seen
                            duplicate_string: bool = any previous_text in seen_strings where previous_text == text
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateSetElement, name: text, line: line, expected: "", actual: ""}) if duplicate_string
                            seen_strings.push(text) if not duplicate_string
                        Expr.CharLit(text):
                            # Check if this char text was already seen
                            duplicate_char: bool = any previous_text in seen_chars where previous_text == text
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateSetElement, name: text, line: line, expected: "", actual: ""}) if duplicate_char
                            seen_chars.push(text) if not duplicate_char
                        _:
                            # Non-literal elements are ignored
                            pass


    public:
        # Entry point: check all function bodies for duplicate literal set elements.
        def check_duplicate_set_element(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_duplicate_set_element_impl(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_duplicate_set_element(body, table)
                        Decl.Scoped(body, line):
                            table <- check_duplicate_set_element(body, table)
                        _:
                            pass


        # Helper to recurse into declaration bodies.
        def check_duplicate_set_element_impl(body: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_duplicate_set_element_statements(body, table)
