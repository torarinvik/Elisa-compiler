# Rule R on a returned value: a function declared `-> mutable T&` (plain or fallible; the
# parser keeps only the payload type, so `-> mutable T& error[E]` spells the same here) must
# not hand back a reference the caller could not write through. stage0 rejects through its
# general RefType assignability ("return type expects mutable Node&, got Node&"); this pass
# reports only when rbm_assignable is CERTAIN (RBM_NO), so a value it cannot spell stays
# silent. Value-producing control shapes (`if`/`match`/block tails) check each arm.
extend Semantic:
    private:
        def rbm_check_return(value: Ast::Expr, bindings: RefBindingScope&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, lookup: ReadonlyFunctionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if (bindings.return_flags & RBM_REF) == 0 or (bindings.return_flags & RBM_MUTABLE) == 0
                match value:
                    Expr.Paren(inner, _):
                        table <- rbm_check_return(inner, bindings, callee_names, callee_owners, positions, lookup, table)
                        return
                    Expr.If(_, then_value, else_value, _):
                        table <- rbm_check_return(then_value, bindings, callee_names, callee_owners, positions, lookup, table)
                        table <- rbm_check_return(else_value, bindings, callee_names, callee_owners, positions, lookup, table)
                        return
                    Expr.Block(_, block_value, _, _):
                        table <- rbm_check_return(block_value, bindings, callee_names, callee_owners, positions, lookup, table)
                        return
                    Expr.Match(_, arms, _):
                        for arm in arms |table, bindings, callee_names, callee_owners, positions, lookup|:
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(arm_value, _):
                                        table <- rbm_check_return(arm_value, bindings, callee_names, callee_owners, positions, lookup, table)
                                    _:
                                        pass
                        return
                    _:
                        pass
                expected: RefSpelling = RefSpelling{elem: bindings.return_elem, flags: bindings.return_flags | RBM_PRESENT}
                source: RefSpelling = rbm_spell_value(value, bindings, callee_names, callee_owners, positions, lookup, table)
                return if (source.flags & RBM_REF) == 0
                # A nullable source may be flow-narrowed (`found return if found != null`);
                # this rule is about readonly vs mutable, so leave optionality to stage0.
                return if (source.flags & RBM_NULLABLE) != 0 and (expected.flags & RBM_NULLABLE) == 0
                pos: Ast::Pos = Ast::expr_pos(value)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefAssignMismatch, name: "return", pos: pos, line: pos.line, expected: expected.elem, actual: source.elem, expected_count: expected.flags, actual_count: source.flags | RBM_PRESENT, state_code: 2}) if rbm_assignable(expected, source, table) == RBM_NO
