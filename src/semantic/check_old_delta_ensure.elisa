# `ensure p <cmp> old(p)` disproof by net delta. A `changes p` function whose body moves the
# mutable-reference parameter `p` by a fixed integer delta (a sequence of `p += k` / `p -= k` with
# literal `k`) cannot satisfy a comparison against `old(p)` whose required direction the delta
# contradicts: a decrement can never prove `p >= old(p)`, an unchanged `p` can never prove `p > old(p)`,
# etc. stage0 reports "ensure postcondition ... could not be proven". SOUND subset: fires only when
# the net delta is exactly known and provably misaligned with the comparison (a strict subset of
# "not provable" — such a postcondition is false at every non-wraparound value, so never a false
# positive). Any non-additive write, call, or control flow touching `p` leaves the delta unknown (skip).
extend Semantic:
    private:
        # A mutable "place": a bare ident (kind 1, base=name) or `base.field` (kind 2), else kind 0.
        def ode_place_of(expression: Ast::Expr) -> (kind: i64, base: sview, field: sview):
            can Memory.Allocate, Abort.Panic:
                name: sview = ident_name_of(expression)
                (1, name, sview("", 0, 0)) return if name != ""
                match expression:
                    Expr.Paren(inner, paren_line):
                        return ode_place_of(inner)
                    Expr.Field(object, field, field_line):
                        base: sview = ident_name_of(object)
                        (2, base, field) return if base != ""
                        return (0, sview("", 0, 0), sview("", 0, 0))
                    _:
                        return (0, sview("", 0, 0), sview("", 0, 0))

        def ode_places_match(a: (kind: i64, base: sview, field: sview), b: (kind: i64, base: sview, field: sview)) -> bool:
            can Abort.Panic:
                false return if a.kind == 0 or a.kind != b.kind or a.base != b.base
                return a.kind == 1 or a.field == b.field

        # The place inside `old(PLACE)`, else kind 0.
        def ode_old_place(expression: Ast::Expr) -> (kind: i64, base: sview, field: sview):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        ode_place_of(arguments[0]) return if ident_name_of(callee) == "old" and arguments.count == 1
                    _:
                        pass
                return (0, sview("", 0, 0), sview("", 0, 0))

        # The delta of a plain-rebind RHS relative to `place`: `place` (unchanged) -> 0,
        # `place + lit` -> +lit, `place - lit` -> -lit, else not-ok.
        def ode_assign_delta(value: Ast::Expr, place: (kind: i64, base: sview, field: sview)) -> (ok: bool, delta: i64):
            can Memory.Allocate, Abort.Panic:
                true_place: (kind: i64, base: sview, field: sview) = ode_place_of(value)
                (true, 0) return if ode_places_match(true_place, place)
                match value:
                    Expr.Paren(inner, paren_line):
                        return ode_assign_delta(inner, place)
                    Expr.Binary(left, operator, right, binary_line):
                        left_place: (kind: i64, base: sview, field: sview) = ode_place_of(left)
                        if ode_places_match(left_place, place):
                            literal: (found: bool, value: i64) = where_signed_literal(right)
                            (true, literal.value) return if literal.found and operator == TokenKind.Plus
                            (true, 0 - literal.value) return if literal.found and operator == TokenKind.Minus
                        return (false, 0)
                    _:
                        return (false, 0)

        # Flip a comparison operator for the mirrored form (`old(p) <op> p` == `p <flip> old(p)`).
        def ode_flip(operator: TokenKind) -> TokenKind:
            can Abort.Panic:
                return when operator:
                    TokenKind.Gt -> TokenKind.Lt
                    TokenKind.Lt -> TokenKind.Gt
                    TokenKind.GtEq -> TokenKind.LtEq
                    TokenKind.LtEq -> TokenKind.GtEq
                    _ -> operator

        # (place, comparison) of an `ensure PLACE <cmp> old(PLACE)` (either operand order), else kind 0.
        def ode_match_goal(predicate: Ast::Expr) -> (ok: bool, place: (kind: i64, base: sview, field: sview), op: TokenKind):
            can Memory.Allocate, Abort.Panic:
                empty: (kind: i64, base: sview, field: sview) = (0, sview("", 0, 0), sview("", 0, 0))
                match predicate:
                    Expr.Paren(inner, paren_line):
                        return ode_match_goal(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        left_place: (kind: i64, base: sview, field: sview) = ode_place_of(left)
                        right_old: (kind: i64, base: sview, field: sview) = ode_old_place(right)
                        (true, left_place, operator) return if ode_places_match(left_place, right_old)
                        left_old: (kind: i64, base: sview, field: sview) = ode_old_place(left)
                        right_place: (kind: i64, base: sview, field: sview) = ode_place_of(right)
                        (true, right_place, ode_flip(operator)) return if ode_places_match(right_place, left_old)
                        return (false, empty, TokenKind.Eof)
                    _:
                        return (false, empty, TokenKind.Eof)

        # The set of net deltas of `place` across EVERY control-flow path to a function exit (each
        # `return` and the fall-through end is an exit; a top-level `if` forks into then+rest / else+rest,
        # flattening nested ifs). `known` becomes false on any mutation of the place the analysis cannot
        # model as an additive constant (so the caller declines rather than guesses).
        def ode_path_deltas(statements: darray[Ast::Stmt], index: usize, delta: i64, place: (kind: i64, base: sview, field: sview), out: mutable darray[i64]&, known: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                if index >= statements.count:
                    out.push(delta)
                    return
                match statements[index]:
                    Stmt.Return(value, return_line):
                        out.push(delta)
                    Stmt.Contract(kind, expression, contract_line):
                        ode_path_deltas(statements, index + 1, delta, place, out, known)
                    Stmt.Assign(target, operator, value, assign_line):
                        target_place: (kind: i64, base: sview, field: sview) = ode_place_of(target)
                        if ode_places_match(target_place, place):
                            step: mutable i64 = 0
                            ok: mutable bool = false
                            literal: (found: bool, value: i64) = where_signed_literal(value)
                            if operator == TokenKind.PlusEq and literal.found:
                                step <- literal.value
                                ok <- true
                            elif operator == TokenKind.MinusEq and literal.found:
                                step <- 0 - literal.value
                                ok <- true
                            elif operator == TokenKind.LArrow:
                                rebind: (ok: bool, delta: i64) = ode_assign_delta(value, place)
                                step <- rebind.delta
                                ok <- rebind.ok
                            known <- false if not ok
                            ode_path_deltas(statements, index + 1, delta + step, place, out, known)
                        elif target_place.kind == 1 and target_place.base == place.base:
                            known <- false
                            ode_path_deltas(statements, index + 1, delta, place, out, known)
                        elif ode_expr_mentions(value, place.base):
                            known <- false
                            ode_path_deltas(statements, index + 1, delta, place, out, known)
                        else:
                            ode_path_deltas(statements, index + 1, delta, place, out, known)
                    Stmt.If(condition, then_body, else_body, if_line):
                        rest: mutable darray[Ast::Stmt] = []
                        rest_index: mutable usize = index + 1
                        while rest_index < statements.count |rest, rest_index, statements|:
                            rest.push(statements[rest_index])
                            rest_index <- rest_index + 1
                        then_seq: mutable darray[Ast::Stmt] = [s for s in then_body]
                        then_seq.extend(rest)
                        else_seq: mutable darray[Ast::Stmt] = [s for s in else_body]
                        else_seq.extend(rest)
                        ode_path_deltas(then_seq, 0, delta, place, out, known)
                        ode_path_deltas(else_seq, 0, delta, place, out, known)
                    _:
                        # A loop / block / other statement that could touch the place is unmodelable.
                        known <- false
                        ode_path_deltas(statements, index + 1, delta, place, out, known)

        # Does the expression reference `name` anywhere?
        def ode_expr_mentions(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if ident_name_of(expression) == name
                match expression:
                    Expr.Paren(inner, paren_line):
                        return ode_expr_mentions(inner, name)
                    Expr.Unary(operator, operand, unary_line):
                        return ode_expr_mentions(operand, name)
                    Expr.Move(operand, move_line):
                        return ode_expr_mentions(operand, name)
                    Expr.Field(object, field, field_line):
                        return ode_expr_mentions(object, name)
                    Expr.Binary(left, operator, right, binary_line):
                        true return if ode_expr_mentions(left, name)
                        return ode_expr_mentions(right, name)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments:
                            true return if ode_expr_mentions(argument, name)
                        return false
                    _:
                        return false

        # Is the comparison provably UNSATISFIABLE given `p == old(p) + delta` (ignoring wraparound,
        # which stage0 also cannot rely on — so an unprovable goal here is exactly stage0's verdict)?
        def ode_misaligned(operator: TokenKind, delta: i64) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.GtEq -> delta < 0
                    TokenKind.Gt -> delta <= 0
                    TokenKind.LtEq -> delta > 0
                    TokenKind.Lt -> delta >= 0
                    TokenKind.EqEq -> delta != 0
                    TokenKind.BangEq -> delta == 0
                    _ -> false

        # A comparison whose delta is ALIGNED with the required direction but non-zero: the mutation
        # `p += k` (or `p -= k`) can still OVERFLOW/UNDERFLOW at the type extreme, so the bound is only
        # unprovable if nothing bounds `p` away from that extreme. stage0's SMT always finds the
        # wraparound counterexample when no `requires` constrains the base — a sound parity flag.
        def ode_overflow_prone(operator: TokenKind, delta: i64) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.GtEq -> delta > 0
                    TokenKind.Gt -> delta > 0
                    TokenKind.LtEq -> delta < 0
                    TokenKind.Lt -> delta < 0
                    _ -> false

        # Does any `requires` in the body mention `base` (so it might bound it away from wraparound)?
        def ode_requires_mentions_base(body: darray[Ast::Stmt], base: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in body:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            true return if kind == "requires" and ode_expr_mentions(expression, base)
                        _:
                            pass
                return false

        def ode_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for statement in body |table| -> table:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        if kind == "ensure":
                                            goal: (ok: bool, place: (kind: i64, base: sview, field: sview), op: TokenKind) = ode_match_goal(expression)
                                            if goal.ok:
                                                deltas: mutable darray[i64] = []
                                                known: mutable bool = true
                                                ode_path_deltas(body, 0, 0, goal.place, deltas, known)
                                                base_bounded: bool = ode_requires_mentions_base(body, goal.place.base)
                                                # Overflow/underflow is only a sound disproof for a
                                                # STRAIGHT-LINE (single-path) mutation: a guarded write
                                                # (`if p < stop: p += 1`) may be bounded by its condition,
                                                # so stage0 can prove it. The ensure must hold at EVERY
                                                # exit; any misaligned path always fails.
                                                straight_line: bool = deltas.count == 1
                                                any_violates: mutable bool = false
                                                for d in deltas |any_violates, base_bounded, straight_line|:
                                                    any_violates <- true if ode_misaligned(goal.op, d)
                                                    any_violates <- true if straight_line and ode_overflow_prone(goal.op, d) and not base_bounded
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: contract_line.line, expected: "", actual: ""}) if known and any_violates
                                    _:
                                        pass
                        Decl.Module(module_name, module_body, module_line):
                            table <- ode_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- ode_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_old_delta_ensure(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- ode_check_declarations(declarations, table)
