module Semantic:
    public:
        # Symbol-table types — the shared vocabulary the semantic passes produce, public
        # members of `module Semantic` (callers name them `Semantic::SymbolTable`). `SymbolKind`
        # is a module-scoped enum used across the module's files, which stage0 now lowers.

        const enum SymbolKind of u8:
            Func
            Struct
            Enum
            Const
            Module
            Alias
            Law
            Import
            Extern
            Unknown


        # The structured type the inference engine assigns to an expression. A sound
        # SUBSET: `Unknown` is the bottom for anything not modeled and is NEVER used to
        # raise a diagnostic (only a firmly-known kind can). Numerics collapse to `Int`/
        # `Float` (Elisa inter-converts widths); `String` spans cstr/dstr/sview; `Named`
        # carries a struct/enum spelling in `InferType.name`. Supersedes the older coarse
        # "family" strings, which are now a projection of this (`family_of_kind`).
        const enum SemTypeKind of u8:
            Unknown
            Void
            Int
            Float
            Bool
            Char
            String
            Named
            Tuple
            # --- structural kinds (Phase C, backlog 92-94) — meaningful only as interned
            # type-table rows (see type_table.elisa): the element/base types live in the
            # table's flat pool, NOT in InferType (which must stay POD; see DESIGN NOTE).
            # An `InferType` value itself never carries these kinds today.
            # `T?` — one pool element: the base type.
            Optional
            # `T&` (each `&` of a `T&&` chain is one Ref row) — one pool element: the referent.
            Ref
            # A generic-instance/container annotation: `darray[T]`, `dict[K, V]`, `i64[3]`
            # (name "array"), or a user generic `Foo[A, B]`. `name` is the head spelling;
            # pool elements are the type arguments in order.
            Container


        # An inferred expression type: a `kind` plus, for `Named`, the struct/enum name
        # (empty otherwise). Deliberately small — richer shape (refs, optionals, generics) is
        # added as the engine grows; until then those infer to `Unknown`.
        #
        # DESIGN NOTE (backlog item 91): `InferType` must stay POD. It must NOT gain an owned
        # `darray[InferType]` field for structural element types — that makes
        # `infer_expression_type` return a region-bearing value, which turns it
        # region-polymorphic and forces all ~20 of its callers into region-inferable contexts
        # (verified empirically). Structural detail is instead read on demand from the AST
        # (e.g. a `Tuple` type's element expressions live in `Expr.Tuple(elements, …)`);
        # a consumer that needs element types recurses into that node in its own region
        # context. Only if O(1) structural type identity is later needed does the flat
        # `u32`-interned element pool (stage0 `typeid.go`) become necessary.
        struct InferType:
            kind: SemTypeKind
            name: sview


        struct Symbol:
            name: sview
            kind: SymbolKind
            line: u32
            # Declared-parameter arity range, meaningful for Func symbols only
            # (0/0 otherwise): `arity_min` = parameters without defaults,
            # `arity_max` = all declared parameters.
            arity_min: u32
            arity_max: u32
            # Declared bare RETURN-type name of a Func symbol ("" when absent, void, or
            # not a bare ident/primitive). Feeds the engine's call-return typing: a direct
            # `f(...)` call to a uniquely-named function gets this type.
            return_type: sview
            # Structural sibling (Phase C): the return annotation's interned TypeId
            # (0 when absent/unmodeled). Lets calls to `-> darray[T]` functions infer
            # Container where the bare name above is "".
            return_type_id: u32 = 0

        # A structured finding: the offending name/token text, the source line, and its
        # kind. This is the LSP-facing output of the frontend — `name`/`line` locate it in
        # source (for syntax findings `name` is the parser's `ParseError.context` token).
        # Fields ordered name/line/kind to avoid struct padding.
        struct Diagnostic:
            name: sview
            line: u32
            # The COLUMN SPAN, when the reporting check had the AST node's `Ast::Pos` to
            # hand. stage0's shape is `PATH:LINE:COLSTART-COLEND:`, and the driver prints
            # the span whenever `pos.end_column` is non-zero — so a check that has not been
            # threaded yet degrades to `PATH:LINE:`, which is what every check printed
            # before this field existed. Defaulted for exactly that reason: adding the
            # column to a check is a one-line change at its construction site, not a
            # migration of all ~790 of them.
            pos: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            kind: DiagnosticKind
            # Optional typed context for kinds that have it (TypeMismatch,
            # NonBoolCondition): the declared/expected type name and the value's
            # kind or family. Empty for other kinds.
            expected: sview
            actual: sview
            # Optional numeric context (VariantArity: expected vs actual argument
            # count). Defaulted so the ~30 diagnostic literals that don't need them
            # omit both — only kinds that carry counts set them.
            expected_count: u32 = 0
            actual_count: u32 = 0
            # Optional third textual detail for diagnostics whose compact payload needs
            # three names (currently the three-field struct-padding suggestion).
            detail: sview = ""
            # Fourth/fifth textual details: the tuple-value mismatch prints the full
            # two-field tuple spelling ((first: i64, second: i64)) from four pieces.
            detail2: sview = ""
            detail3: sview = ""


        # Fresh, empty table. Container literals seed the caller's inferred region, carried
        # out through this region-polymorphic builder's return (see `check` / `collect_symbols`).
        def SymbolTable() -> SymbolTable:
                    return SymbolTable{symbols: [], catch_match_lines: [], new_construct_lines: [], forward_arg_lines: [], block_if_lines: [], region_names: [], query_binder_lines: [], query_binder_names: [], duplicates: 0, statements: 0, diagnostics: [], name_primary: {}, name_overflow: [], symbol_name_head: {}, symbol_name_tail: {}, symbol_name_next: [], module_member_owner: [], module_member_name: [], imported_modules: [], imported_members: [], current_module: "", enum_variant_owner: [], enum_variant_name: [], enum_hierarchy_child: [], enum_hierarchy_parent: [], enum_variant_arity: [], enum_payload_owner: [], enum_payload_variant: [], enum_payload_name: [], enum_payload_type: [], enum_common_owners: [], enum_common_counts: [], struct_field_owner: [], struct_field_name: [], struct_field_required: [], struct_field_type: [], struct_field_mutable: [], struct_field_type_id: [], qualified_type_module: [], qualified_type_name: [], lmut_param_owner: [], lmut_param_pos: [], function_param_owner: [], function_param_name: [], function_param_has_default: [], function_param_type: [], function_param_type_id: [], function_param_mutable_ref: [], function_param_name_head: {}, function_param_name_tail: {}, function_param_name_next: [], function_effect_owner: [], function_effect_name: [], function_effect_source_owner: [], function_effect_source_ref: [], generic_param_lines: [], generic_param_names: [], packed_enum_names: [], declared_packed_names: [], ast_refinement_names: [], region_tied_param_names: [], fn_alias_names: [], struct_affine_owner: [], struct_affine_container_owner: [], immutable_const_names: [], const_int_names: [], const_int_values: [], ref_line: [], ref_name: [], ref_kind: [], type_row_kind: [], type_row_name: [], type_row_elem_start: [], type_row_elem_count: [], type_elem_pool: [], tuple_binding_names: [], tuple_binding_l1: [], tuple_binding_t1: [], tuple_binding_l2: [], tuple_binding_t2: [], local_type_names: [], local_type_ids: [], current_param_count: 0, current_loop_depth: 0, walk_depth: 0}


        struct SymbolTable:
            symbols: mutable darray[Symbol]
            # Source lines of catch-desugared Match statements (the scalar-match arm
            # check exempts them; their arms are error-set members, not scalars).
            catch_match_lines: mutable darray[u32]
            # Source lines of `new`-form constructions (the keyword is erased at
            # parse time; the brace-only construction check exempts these calls).
            new_construct_lines: mutable darray[u32]
            # Source lines of calls carrying a `..` forward-args placeholder (exempt from the
            # missing-argument check — the unspecified params fill from the caller).
            forward_arg_lines: mutable darray[u32]
            # Source lines of statement-position block `if`s (flow-strict targets).
            block_if_lines: mutable darray[u32]
            # Declared `region NAME(...)` names — legal in type position.
            region_names: mutable darray[sview]
            # Extra comma binders of a query expression (`each k, v in m` / `count a, b in …`),
            # line-paired to the Comprehension's head line so the resolver can bring every
            # binder (not just the canonical first one) into the query's condition/body scope.
            query_binder_lines: mutable darray[u32]
            query_binder_names: mutable darray[sview]
            # `node is Expr.Pair as pair` — the VARIANT-test alias, line-paired to the alias
            # token. Defaulted so the SymbolTable literal above needs no edit.
            # Owners of `struct S layout(soa)` — every field of one is a COLUMN (a darray of
            # the declared type), which is what stage0 lowers it to.
            soa_layout_owners: mutable darray[sview] = []
            is_variant_alias_lines: mutable darray[u32] = []
            is_variant_alias_names: mutable darray[sview] = []
            # Number of declarations whose name duplicates an earlier one in the same
            # collection. Kept as a quick count; `diagnostics` carries the located findings.
            duplicates: mutable u32
            # Total statements across all function bodies (incl. nested blocks/arms). Walks the
            # per-node `darray[Stmt]` side-tables, matching each entry as a Stmt directly.
            statements: mutable u32
            # Located semantic findings accumulated during collection (duplicate decls) and
            # resolution (undefined names).
            diagnostics: mutable darray[Diagnostic]
            # O(1) membership index over `symbols` names, so resolution (called once per
            # referenced identifier) and duplicate detection avoid an O(n) scan of `symbols`
            # — the whole table was O(n^2) in a file's symbol count. Keyed by an FNV hash of
            # the name's bytes; `name_primary` holds one name per hash and `name_overflow`
            # the rare hash collisions. sview is not a valid dict/set key (no value-equality),
            # hence the hand-rolled hash index. `symbols` stays the source of truth for
            # iteration/metadata; these two mirror only its names.
            name_primary: mutable dict[u64, sview]
            name_overflow: mutable darray[sview]
            # Forward singly-linked hash chain over `symbols` ITSELF (as opposed to
            # name_primary/name_overflow above, which only answer "does this name exist" —
            # not "give me every Symbol row named X"). Same shape as function_param_name_
            # head/tail/next (see that field group's comment and index_function_param/
            # symbol_chain_head in symbols.elisa): turns "every declaration named NAME"
            # (direct_function_count, check_call_arity, the lmut-aliasing poison check,
            # forwarding_callee_is_variadic — all called once per direct-call expression)
            # from an O(symbols.count) scan of every declaration in the WHOLE PROGRAM into
            # an O(this name's own overload count) walk.
            symbol_name_head: mutable dict[u64, u32]
            symbol_name_tail: mutable dict[u64, u32]
            symbol_name_next: mutable darray[u32]
            module_member_owner: mutable darray[sview]
            module_member_name: mutable darray[sview]
            imported_modules: mutable darray[sview]
            # Members brought into unqualified scope by a `from Mod import a, b` selective
            # import (docs module-visibility). A module member is visible unqualified iff
            # its whole module is imported OR its own name appears here.
            imported_members: mutable darray[sview]
            current_module: mutable sview
            # Enum variant registry (parallel arrays — sview can't key a dict):
            # entry i says enum `enum_variant_owner[i]` declares variant
            # `enum_variant_name[i]`. Scanned linearly (per-file scale).
            enum_variant_owner: mutable darray[sview]
            enum_variant_name: mutable darray[sview]
            # Enum hierarchy: `enum Child is Parent` — parallel (child, parent) rows so the
            # match-exhaustiveness check can treat a parent root's coverage as the union of its
            # children's variants (docs/81 tree/enum-hierarchy).
            enum_hierarchy_child: mutable darray[sview]
            enum_hierarchy_parent: mutable darray[sview]
            # Declared payload field count of entry i's variant.
            enum_variant_arity: mutable darray[u32]
            # Enum variant payload field labels. Each entry records one payload field
            # in declaration order; empty names mark positional-only payload fields.
            enum_payload_owner: mutable darray[sview]
            enum_payload_variant: mutable darray[sview]
            enum_payload_name: mutable darray[sview]
            # Bare declared payload type at the same index (empty for structural types).
            enum_payload_type: mutable darray[sview]
            enum_common_owners: mutable darray[sview]
            enum_common_counts: mutable darray[u32]
            # Struct field registry (parallel arrays, same shape as the enum one):
            # entry i says struct `struct_field_owner[i]` declares NAMED field
            # `struct_field_name[i]`. Anonymous/positional members are not recorded
            # (they have no label to check a construction against). A struct with
            # >=1 entry here has a KNOWN, closed field set (Elisa structs do not
            # inherit fields), so a `Name{label: ...}` construction can be checked.
            struct_field_owner: mutable darray[sview]
            # The MODULE that owner was declared in, "" for a top-level struct. Parallel to
            # struct_field_owner, and deliberately a SECOND column rather than a qualified
            # name in the first: 37 sites compare struct_field_owner by bare name, and
            # making them all namespace-aware at once is a far larger change than the bug
            # needs. The construct-site checks consult both; everything else is unchanged.
            #
            # Without it, two modules each declaring a `Work` share one owner key, so
            # `Grade::Work{total: 3}` sees Score::Work's fields too and reports
            # `struct literal "Work" is missing field "tally"` -- for a program stage0
            # compiles and runs.
            struct_field_module: mutable darray[sview] = []
            struct_field_name: mutable darray[sview]
            # Whether entry i's field is REQUIRED in a by-label construction (not an
            # optional `name?: T` nor a defaulted `name: T = v` field). Drives MissingField.
            struct_field_required: mutable darray[bool]
            # Entry i's field's declared bare TYPE name ("" when not a bare ident/primitive
            # — refs/generics/optionals skipped). Feeds the type-inference engine's field-
            # access typing (`p.x` gets field x's type when p is a known struct).
            struct_field_type: mutable darray[sview]
            # Entry i's field's declared mutability (true iff the field's type_expression was
            # wrapped `mutable T`). Feeds FieldImmutableAssign: assigning through `<-`/compound
            # to a field that is present but NOT mutable is an error.
            struct_field_mutable: mutable darray[bool]
            # Entry i's field's STRUCTURAL interned TypeId (0 when unmodeled) — the
            # Phase C sibling of struct_field_type, so `p.items` on a registered
            # struct infers Container/Optional where the bare name is "".
            struct_field_type_id: mutable darray[u32]
            # Qualified type ownership: parallel module/type names for direct
            # `Module::Type` declarations. Keeps namespace ownership separate from
            # the flat symbol index used by ordinary value resolution.
            qualified_type_module: mutable darray[sview]
            qualified_type_name: mutable darray[sview]
            # `lmut` parameter registry (parallel arrays, same shape as the struct/enum
            # ones): entry i says function `lmut_param_owner[i]` declares an `lmut`
            # parameter at positional index `lmut_param_pos[i]`. Feeds the call-site
            # aliasing check (`check_call_lmut_aliasing`) — an `lmut` argument may not
            # name the same place as another argument of the same call. Only recorded
            # for uniquely-named functions (the check poisons overloaded names).
            lmut_param_owner: mutable darray[sview]
            lmut_param_pos: mutable darray[u32]
            # Function parameter registry for conservative named-call checking. Each
            # entry records one explicit parameter of a Func declaration in declaration
            # order, with the default flag copied from the parser.
            function_param_owner: mutable darray[sview]
            function_param_name: mutable darray[sview]
            function_param_has_default: mutable darray[bool]
            # Declared bare TYPE name of each parameter, parallel to function_param_name
            # ("" when the type is not a bare ident/primitive). Feeds literal-argument
            # type checking at direct call sites.
            function_param_type: mutable darray[sview]
            # Interned structural TypeId for each parameter annotation, parallel to
            # function_param_type. Zero means an unmodeled/ambiguous annotation.
            function_param_type_id: mutable darray[u32]
            # Whether each parameter is spelled `mutable T&` (a mutable borrow), parallel to
            # function_param_type. `bare_type_name` above strips the markers, so this preserves
            # the borrow-ness for call-site checks (e.g. value-block outer mutation via a call).
            function_param_mutable_ref: mutable darray[bool]
            # Forward singly-linked hash chain over function_param_owner, keyed by FNV hash of
            # the owner name (same hash as name_primary/name_overflow above) — turns "every
            # parameter of function NAME" from an O(function_param_owner.count) scan of every
            # parameter in the WHOLE PROGRAM into an O(this function's own parameter/overload
            # count) walk. `function_param_name_head[hash]` is the index of the FIRST entry
            # with that hash; `function_param_name_next[i]` is the index of the NEXT entry
            # sharing entry i's owner hash, sentinel 4294967295 for "no next" (mirrors the
            # arity_max variadic sentinel already used elsewhere in this table). `..._tail`
            # is the running last-entry index per hash, so a new push is an O(1) append to the
            # chain rather than a rewalk. See index_function_param/symbols.elisa. Populated
            # ONLY at that one push site — every reader below is unaffected if unindexed
            # (an absent hash simply yields an empty chain).
            function_param_name_head: mutable dict[u64, u32]
            function_param_name_tail: mutable dict[u64, u32]
            function_param_name_next: mutable darray[u32]
            # Effect-row registry (parallel arrays): entry i records that function
            # `function_effect_owner[i]` declares effect ref `function_effect_name[i]` in its
            # signature `can[...]` clause, one row per declared ref (dotted source text, e.g.
            # "Abort.Panic"; the parser keeps each comma-separated entry whole — NOT dot-split,
            # unlike the `can X:` block clause). Feeds call-site effect-requirement checking.
            function_effect_owner: mutable darray[sview]
            function_effect_name: mutable darray[sview]
            # Effect-source registry: names of functions whose body performs a `panic(...)`
            # NOT enclosed by a `trusted` block — i.e. functions that INFER the Abort effect
            # even without declaring it (a `can` block discharges locally but still propagates
            # the effect to the row; only `trusted` drops it — verified against stage0). One
            # hop of transitive inference: a call to such a function requires a local grant.
            function_effect_source_owner: mutable darray[sview]
            # The effect ref inferred for that owner ("Console.Write" from a forwarded
            # call, "Abort.Panic" from an untrusted panic) — parallel to source_owner.
            function_effect_source_ref: mutable darray[sview]
            # Function-scoped generic declarations copied from Ast::File. Parallel
            # owner-line/name rows are consulted only when entering that function.
            generic_param_lines: mutable darray[u32]
            generic_param_names: mutable darray[sview]
            packed_enum_names: mutable darray[sview]
            # Enums written `packed enum X:` EXPLICITLY, as opposed to auto-promoted by
            # record_recursive_enum. Only a DECLARED packed enum carries the store-clause
            # requirement — the parser's own note on __declared_packed says an
            # auto-promoted recursive enum "must not inherit the explicit store-clause
            # requirement (stage0 accepts `match t:` on one)", and the same holds for its
            # CONSTRUCTORS. packed_enum_names holds both kinds, so it cannot answer this.
            declared_packed_names: mutable darray[sview]
            # Enums marked `__ast_refinement` by record_recursive_enum: members of a
            # SEALED Node hierarchy. stage0 exempts these from the packed store-clause
            # requirement (it compiles the compiler's own bare `(Ast::Expr.Ident(...))`),
            # but NOT a plain user recursive enum — measured, one probe each.
            ast_refinement_names: mutable darray[sview]
            # Parameters carrying a DECLARED region tie (`def f[@r](m: mutable Mod& @r)`).
            # Storage reached through one is CALLER-provided, so nothing stored into it
            # escapes — stage0 returns early on exactly this
            # (region_containers.go: `if a.lookupRegionParam(region) { return }`).
            region_tied_param_names: mutable darray[sview]
            # Names introduced by `type X = fn(A) -> R`. SemTypeKind has no Fn variant, so the
            # alias resolves to `Named` and every call through it was reported as "cannot call
            # non-function value"; stage0 accepts. A fn TYPE parses to an Expr.Lambda — the
            # alias RHS is marked a type position precisely so it does (parser_decl_dispatch).
            fn_alias_names: mutable darray[sview]
            # Names of structs declared with an affinity discipline (`linear`/`affine`) — i.e.
            # single-use "linear handle" types. Feeds the affine-collection check: such a type
            # may not be a dict key or set element.
            struct_affine_owner: mutable darray[sview]
            # User structs whose fields transitively contain an affine owner. Unlike
            # direct runtime handles, references to these aggregates are unsupported.
            struct_affine_container_owner: mutable darray[sview]
            # Names of immutable `const` declarations (NOT `global`s). A `<-`/compound
            # assignment to one of these is rejected (cannot assign to immutable const).
            immutable_const_names: mutable darray[sview]
            const_int_names: mutable darray[sview]
            const_int_values: mutable darray[i64]
            # Per-occurrence resolution log for tooling (the LSP's semantic-token
            # highlighter): each referenced or declared param/local name is
            # recorded as parallel arrays — occurrence i is at line `ref_line[i]`,
            # spells `ref_name[i]`, and resolves to kind `ref_kind[i]`
            # (1 = parameter, 2 = local). Looked up by (line, name): the AST keeps
            # only line per identifier, but two distinct resolutions of one name
            # on one line is vanishingly rare (fields are handled separately).
            ref_line: mutable darray[u32]
            ref_name: mutable darray[sview]
            ref_kind: mutable darray[u8]
            # Transient: how many leading `bound` entries are the current
            # function's parameters (indices below it are params, the rest
            # locals). Set per function before its body is resolved.
            current_param_count: mutable usize
            # Transient: enclosing `for`/`while` nesting depth during resolution.
            # >0 inside a loop body; a `break`/`continue` at depth 0 is outside any
            # loop. Reset to 0 at each function entry.
            current_loop_depth: mutable usize
            # --- The flat interned TYPE TABLE (Phase C; stage0 typeid.go analogue) ---
            # Structural types (tuples/optionals/refs/generic instances) as parallel
            # rows: row i (TypeId i+1; id 0 = "no type"/Unknown) has kind
            # `type_row_kind[i]`, head spelling `type_row_name[i]` (Named/Container
            # only, "" otherwise), and element TypeIds
            # `type_elem_pool[type_row_elem_start[i] .. +type_row_elem_count[i]]`.
            # Rows are DEDUPED on insert (intern_type), so TypeId equality IS type
            # equality. This keeps `InferType` POD (see its DESIGN NOTE): structure
            # lives here, reached through the SymbolTable& every check already has.
            type_row_kind: mutable darray[SemTypeKind]
            type_row_name: mutable darray[sview]
            type_row_elem_start: mutable darray[u32]
            type_row_elem_count: mutable darray[u32]
            type_elem_pool: mutable darray[u32]
            # Transient (reset per function): the current function's local bindings'
            # STRUCTURAL types — parallel arrays mapping a local's name to its
            # annotation's interned TypeId (0 = unannotated/unmodeled; a name
            # re-declared with a different id degrades to 0, mirroring the flat
            # name/type-name table's shadowing conservatism). Lets
            # infer_expression_type see container/optional/ref locals without
            # threading a third parallel array through every check signature.
            # Two-field tuple ANNOTATION spellings per binding (stage0-parity type
            # text): binding name -> (label1, type1, label2, type2). Populated from
            # the parser's __tuple_label rows before the tuple sidecar runs.
            tuple_binding_names: mutable darray[sview]
            tuple_binding_l1: mutable darray[sview]
            tuple_binding_t1: mutable darray[sview]
            tuple_binding_l2: mutable darray[sview]
            tuple_binding_t2: mutable darray[sview]
            local_type_names: mutable darray[sview]
            local_type_ids: mutable darray[u32]
            # Transient: AST-walk recursion depth. A pathological deeply left-nested
            # expression (`a.b.b.b…`, `a()()()…`, `a+a+a+…` — parsed by a loop, so
            # the parser's own depth guard never sees it) is bounded here so the
            # recursive resolver walkers stop instead of overflowing the stack.
            walk_depth: mutable u32
