module Semantic:
    public:
        # Symbol-table types — the shared vocabulary the semantic passes produce, public
        # members of `module Semantic` (callers name them `Semantic::SymbolTable`). `SymbolKind`
        # is a module-scoped enum used across the module's files, which stage0 now lowers.

        const enum SymbolKind of u8:
            Func
            Struct
            Enum
            Const
            Module
            Alias
            Law
            Import
            Extern
            Unknown


        # The structured type the inference engine assigns to an expression. A sound
        # SUBSET: `Unknown` is the bottom for anything not modeled and is NEVER used to
        # raise a diagnostic (only a firmly-known kind can). Numerics collapse to `Int`/
        # `Float` (Elisa inter-converts widths); `String` spans cstr/dstr/sview; `Named`
        # carries a struct/enum spelling in `InferType.name`. Supersedes the older coarse
        # "family" strings, which are now a projection of this (`family_of_kind`).
        const enum TypeKind of u8:
            Unknown
            Void
            Int
            Float
            Bool
            Char
            String
            Named


        # An inferred expression type: a `kind` plus, for `Named`, the struct/enum name
        # (empty otherwise). Deliberately small — richer shape (tuples, refs, optionals,
        # generics) is added as the engine grows; until then those infer to `Unknown`.
        struct InferType:
            kind: TypeKind
            name: sview


        struct Symbol:
            name: sview
            kind: SymbolKind
            line: u32
            # Declared-parameter arity range, meaningful for Func symbols only
            # (0/0 otherwise): `arity_min` = parameters without defaults,
            # `arity_max` = all declared parameters.
            arity_min: u32
            arity_max: u32
            # Declared bare RETURN-type name of a Func symbol ("" when absent, void, or
            # not a bare ident/primitive). Feeds the engine's call-return typing: a direct
            # `f(...)` call to a uniquely-named function gets this type.
            ret_type: sview


        # The category of a diagnostic. Human-readable wording and LSP severity for each
        # kind are the frontend's responsibility — see `diagnostic_message` /
        # `diagnostic_severity` in semantic_api. Consumers (LSP, CLI) render those rather
        # than re-deriving text/severity per kind. Both the parser (syntax findings) and
        # the checker (semantic findings) feed the one `SymbolTable.diagnostics` stream, so
        # this enum spans both — `Semantic::check` folds `Ast::File.errors` in via
        # `parse_error_kind`.
        const enum DiagnosticKind of u8:
            # A value-position identifier that resolves to no parameter, local, or global.
            UndefinedName
            # A FUNCTION whose name + signature duplicates an earlier function in the
            # same scope (an overload with a different signature is legal). Parity:
            # stage0's `duplicate declaration "f" (already defined as func)`.
            DuplicateDecl
            # A TYPE (struct/enum) whose name duplicates an earlier type in the same
            # scope. Parity: stage0's `duplicate type "P"`. Types have their own
            # namespace, so a struct and a function may share a name.
            DuplicateType
            # A mutation (`x <- v` or a compound assign) whose target is a parameter or
            # local declared without `mutable`.
            AssignImmutable
            # A parameter name repeated in the same function signature.
            DuplicateParam
            # A field name repeated in the same struct declaration. `name` is the field,
            # `expected` the struct. Parity-matched to stage0's `duplicate field`.
            DuplicateField
            # A variant name repeated in the same enum declaration. `name` is the variant,
            # `expected` the enum. Parity-matched to stage0's `duplicate variant`.
            DuplicateVariant
            # A `match` on a value of a known enum type that omits at least one variant and
            # has NO catch-all arm (`_`/binding). `name` is the enum, `expected` the first
            # missing variant. Parity-matched to stage0's `non-exhaustive match`. Sound
            # subset: fires ONLY when the scrutinee is a plain identifier whose declared
            # type is a registered enum and EVERY arm is a variant (or or-of-variants)
            # pattern — any catch-all or unclassifiable arm bails (no report).
            NonExhaustiveMatch
            # A direct call whose argument count matches no declaration of the callee
            # (fewer than the required parameters, or more than all of them).
            ArityMismatch
            # A local redefined in the same statement list: a second `x: T = v`
            # declaration, or an `x = v` binding definition when `x` is already a
            # local/param of that list. (A nested block legally SHADOWS; only
            # same-list redefinition is an error — mirrors stage0.)
            DuplicateLocal
            # A `return EXPR` in a function declared (or defaulted) `-> void`.
            ReturnValueInVoid
            # A bare `return` in a function declared to return a value.
            MissingReturnValue
            # A reference to `Enum.Variant` where `Enum` is a declared enum but
            # `Variant` is not one of its variants (expression or pattern position).
            UnknownVariant
            # An `Enum.Variant(...)` construction or destructuring pattern whose
            # value/pattern count differs from the variant's declared payload
            # fields. (A bare tag-only pattern `Enum.Variant:` is legal and exempt.)
            VariantArity
            # A literal initializer whose kind can never inhabit the declared
            # primitive type (`x: i64 = "s"`, `b: bool = 1`, ...). Only the
            # oracle-verified impossible pairs are flagged; adaptive literals
            # (int->float, int->char, char->int, float->int) are legal.
            TypeMismatch
            # An `if`/`while` condition whose inferred type family is provably
            # not bool (a numeric/string local, arithmetic result, or non-bool
            # literal). Unknown families are never flagged.
            NonBoolCondition
            # An operand of a logical `and`/`or` that the engine proves is not bool
            # (a firm int/float/string/char). `name` is the operator ("and"/"or"),
            # `actual` the operand's family. Parity with stage0's "logical operator
            # requires bool operands". Sound subset: only fires on a firmly-known
            # non-bool operand kind.
            NonBoolOperand
            # An operand of an arithmetic `+ - * / %` that the engine proves is not
            # numeric (a firm bool or string). `name` is the operator, `actual` the
            # operand's family. Parity with stage0's "operator requires numeric
            # operands". Char is numeric-adjacent (char arithmetic is legal) and never
            # flagged; unknown operands never flag.
            NonNumericOperand
            # An `==`/`!=` comparison whose two operands the engine proves live in
            # DIFFERENT comparison groups (bool / string / numeric{int,float,char}) — a
            # value that can never equal the other, e.g. `n == "s"`. `expected`/`actual`
            # are the two families. Sound subset: fires only when BOTH operands are firm
            # and cross-group; numeric-width and int/float/char mixes are compatible.
            IncompatibleComparison
            # --- hints (stage1-only; stage0 is silent on these) ---
            # A parameter never referenced in the body (and not `_`-discarded).
            UnusedParam
            # A `x: T = v` local never referenced after its declaration.
            UnusedLocal
            # A `break` not lexically inside a `for`/`while` loop body. (stage1-only,
            # like the unused hints — stage0 does not diagnose it; an error since
            # it can never be valid.)
            BreakOutsideLoop
            # A `continue` not lexically inside a `for`/`while` loop body.
            ContinueOutsideLoop
            # A `for` loop whose iterable expression is a non-iterable type (a firm
            # primitive like int, float, bool, or void). Unknown families and named types
            # are never flagged (conservative, firm-typed only).
            NonIterableLoop
            # A statement that can never execute because an earlier statement in the
            # same list always exits it (`return`/`break`/`continue`). stage1-only
            # (stage0 is silent), surfaced as a Warning: the code is valid but dead.
            # Only the FIRST unreachable statement of a list is flagged. Conservative:
            # a `match`/`if` whose branches all exit is NOT treated as an exit, so code
            # after it is never falsely flagged.
            UnreachableCode
            # A `match` arm that can never match because an earlier arm already covers
            # every value it would: an exact-duplicate variant/literal, or any arm after
            # a catch-all (`_` or a bare binding). Parity-matched to stage0's
            # "unreachable because an earlier arm already matches it" ERROR. Conservative
            # — a variant arm is only treated as a dominator when its payload
            # subpatterns are all irrefutable (`_`/binding), so `E.A(1)` vs `E.A(2)` is
            # never falsely flagged.
            UnreachableMatchArm
            # A `Name{label: value, ...}` construction naming a field the struct does
            # not declare. `name` is the field, `expected` the struct. Parity-matched
            # to stage0's `struct literal "S" has no field "f"`. Sound subset: fires
            # ONLY when the constructed type is a bare identifier naming a struct with
            # a known (>=1 named field) registry entry — generic/qualified type exprs,
            # positional (unlabeled) fields, and fieldless structs all bail. (Elisa
            # structs have a closed field set — no field inheritance — so a known
            # field set is authoritative.)
            UnknownField
            # A `Name{label: a, label: b}` construction naming the same field twice.
            # `name` is the field, `expected` the struct. Parity-matched to stage0's
            # `struct literal "S" field "f" is specified more than once`. Always an
            # error regardless of field defaults/optionality, so no field-modeling is
            # needed — same registered-struct gate as UnknownField.
            DuplicateFieldInit
            # A by-label `Name{...}` construction that omits a REQUIRED field (one
            # that is neither optional `f?: T` nor defaulted `f: T = v`). `name` is
            # the missing field, `expected` the struct. Parity-matched to stage0's
            # `struct literal "S" is missing field "f"`. Sound subset: fires only in
            # PURE by-label mode (every provided field labeled) — an empty `{}` or any
            # positional/mixed field bails (positional fills fields in order).
            MissingField
            # A `<-` mutation whose target is a bare name that resolves to nothing
            # (no param/local/global). Distinct from UndefinedName: `<-` requires an
            # EXISTING target, so this points the user at `=` to introduce a local.
            # Parity: stage0's `undefined assignment target "x" (use = to introduce a
            # new local; <- requires an existing mutable target)`.
            AssignUndefinedTarget
            # An assignment whose target is not an assignable place — specifically a
            # function-call result (`g() <- v` / `g() = v`). Parity: stage0's `invalid
            # assignment target`. Only the unambiguous call-target form is flagged
            # (fields/indexes are valid places and never reported).
            InvalidAssignTarget
            # --- docs/119 value-block rules ---
            # A direct assignment to an outer binding inside a value block without
            # capture (docs/119 §4 E4). `name` is the outer binding being mutated.
            ValueBlockMutation
            # A `|capture|` header naming a binding that does not exist in outer scope
            # (docs/119 §6 E11). `name` is the undefined capture name.
            CaptureUndefined
            # A `|capture|` header naming an immutable outer binding (docs/119 §6 E10).
            # Only mutable bindings and `mutable T&` ref-parameters can be captured.
            # `name` is the immutable binding's name.
            CaptureImmutable
            # --- struct layout checks (stage1 port) ---
            # A struct field whose declared type names an unknown/unresolved type (not a
            # primitive, not a registered struct/enum). `name` is the field, `expected` the
            # struct, `actual` the unresolved type name. Conservative: refs/optionals/
            # generics (not bare names) are skipped and never flagged.
            UnknownFieldType
            # A struct that references itself directly without indirection (e.g. `struct S: x: S`
            # — infinite size). `name` is the struct, `expected` the offending field. Only the
            # direct case is flagged; mutual recursion via refs is sound and not caught here.
            RecursiveStruct
            # A `.cast[T]` between two DIFFERENT numeric primitive types (`x.cast[u32]`
            # where `x: i32`). `.cast[T]` is reinterpret-only; a numeric value conversion
            # must use a constructor `T(x)` / `x.T()`. `name` is the target type spelling.
            # Sound subset: fires only when the receiver is an identifier whose declared
            # type is a numeric primitive and the target is a different numeric primitive
            # (same-type `.cast`, ref casts, and unknown receivers stay silent).
            InvalidCast
            # --- syntax findings surfaced from the parser (Ast::ParseErrorKind) ---
            # A required token was missing.
            SyntaxExpectedToken
            # A token appeared where none was valid.
            SyntaxUnexpectedToken
            # A declaration was expected.
            SyntaxExpectedDeclaration
            # An expression was expected.
            SyntaxExpectedExpression
            # Two arguments of one call name the same place (same root + overlapping
            # field path) and at least one is bound to an `lmut` parameter. A
            # linear-mutable value must be named by exactly one live binding, so an
            # `lmut` argument may not alias another argument of the same call. `name`
            # is the offending root variable. Appended last for ordinal stability.
            LmutAliasing


        # A structured finding: the offending name/token text, the source line, and its
        # kind. This is the LSP-facing output of the frontend — `name`/`line` locate it in
        # source (for syntax findings `name` is the parser's `ParseError.context` token).
        # Fields ordered name/line/kind to avoid struct padding.
        struct Diagnostic:
            name: sview
            line: u32
            kind: DiagnosticKind
            # Optional typed context for kinds that have it (TypeMismatch,
            # NonBoolCondition): the declared/expected type name and the value's
            # kind or family. Empty for other kinds.
            expected: sview
            actual: sview
            # Optional numeric context (VariantArity: expected vs actual argument
            # count). Defaulted so the ~30 diagnostic literals that don't need them
            # omit both — only kinds that carry counts set them.
            n1: u32 = 0
            n2: u32 = 0


        # Fresh, empty table. Container literals seed the caller's inferred region, carried
        # out through this region-polymorphic builder's return (see `check` / `collect_symbols`).
        def SymbolTable() -> SymbolTable:
            return SymbolTable{symbols: [], duplicates: 0, statements: 0, diagnostics: [], name_primary: {}, name_overflow: [], enum_variant_owner: [], enum_variant_name: [], enum_variant_arity: [], struct_field_owner: [], struct_field_name: [], struct_field_required: [], struct_field_type: [], lmut_param_owner: [], lmut_param_pos: [], immutable_const_names: [], ref_line: [], ref_name: [], ref_kind: [], current_param_count: 0, current_loop_depth: 0, walk_depth: 0}


        struct SymbolTable:
            symbols: mutable darray[Symbol]
            # Number of declarations whose name duplicates an earlier one in the same
            # collection. Kept as a quick count; `diagnostics` carries the located findings.
            duplicates: mutable u32
            # Total statements across all function bodies (incl. nested blocks/arms). Walks the
            # per-node `darray[Stmt]` side-tables, matching each entry as a Stmt directly.
            statements: mutable u32
            # Located semantic findings accumulated during collection (duplicate decls) and
            # resolution (undefined names).
            diagnostics: mutable darray[Diagnostic]
            # O(1) membership index over `symbols` names, so resolution (called once per
            # referenced identifier) and duplicate detection avoid an O(n) scan of `symbols`
            # — the whole table was O(n^2) in a file's symbol count. Keyed by an FNV hash of
            # the name's bytes; `name_primary` holds one name per hash and `name_overflow`
            # the rare hash collisions. sview is not a valid dict/set key (no value-equality),
            # hence the hand-rolled hash index. `symbols` stays the source of truth for
            # iteration/metadata; these two mirror only its names.
            name_primary: mutable dict[u64, sview]
            name_overflow: mutable darray[sview]
            # Enum variant registry (parallel arrays — sview can't key a dict):
            # entry i says enum `enum_variant_owner[i]` declares variant
            # `enum_variant_name[i]`. Scanned linearly (per-file scale).
            enum_variant_owner: mutable darray[sview]
            enum_variant_name: mutable darray[sview]
            # Declared payload field count of entry i's variant.
            enum_variant_arity: mutable darray[u32]
            # Struct field registry (parallel arrays, same shape as the enum one):
            # entry i says struct `struct_field_owner[i]` declares NAMED field
            # `struct_field_name[i]`. Anonymous/positional members are not recorded
            # (they have no label to check a construction against). A struct with
            # >=1 entry here has a KNOWN, closed field set (Elisa structs do not
            # inherit fields), so a `Name{label: ...}` construction can be checked.
            struct_field_owner: mutable darray[sview]
            struct_field_name: mutable darray[sview]
            # Whether entry i's field is REQUIRED in a by-label construction (not an
            # optional `name?: T` nor a defaulted `name: T = v` field). Drives MissingField.
            struct_field_required: mutable darray[bool]
            # Entry i's field's declared bare TYPE name ("" when not a bare ident/primitive
            # — refs/generics/optionals skipped). Feeds the type-inference engine's field-
            # access typing (`p.x` gets field x's type when p is a known struct).
            struct_field_type: mutable darray[sview]
            # `lmut` parameter registry (parallel arrays, same shape as the struct/enum
            # ones): entry i says function `lmut_param_owner[i]` declares an `lmut`
            # parameter at positional index `lmut_param_pos[i]`. Feeds the call-site
            # aliasing check (`check_call_lmut_aliasing`) — an `lmut` argument may not
            # name the same place as another argument of the same call. Only recorded
            # for uniquely-named functions (the check poisons overloaded names).
            lmut_param_owner: mutable darray[sview]
            lmut_param_pos: mutable darray[u32]
            # Names of immutable `const` declarations (NOT `global`s). A `<-`/compound
            # assignment to one of these is rejected (cannot assign to immutable const).
            immutable_const_names: mutable darray[sview]
            # Per-occurrence resolution log for tooling (the LSP's semantic-token
            # highlighter): each referenced or declared param/local name is
            # recorded as parallel arrays — occurrence i is at line `ref_line[i]`,
            # spells `ref_name[i]`, and resolves to kind `ref_kind[i]`
            # (1 = parameter, 2 = local). Looked up by (line, name): the AST keeps
            # only line per identifier, but two distinct resolutions of one name
            # on one line is vanishingly rare (fields are handled separately).
            ref_line: mutable darray[u32]
            ref_name: mutable darray[sview]
            ref_kind: mutable darray[u8]
            # Transient: how many leading `bound` entries are the current
            # function's parameters (indices below it are params, the rest
            # locals). Set per function before its body is resolved.
            current_param_count: mutable usize
            # Transient: enclosing `for`/`while` nesting depth during resolution.
            # >0 inside a loop body; a `break`/`continue` at depth 0 is outside any
            # loop. Reset to 0 at each function entry.
            current_loop_depth: mutable usize
            # Transient: AST-walk recursion depth. A pathological deeply left-nested
            # expression (`a.b.b.b…`, `a()()()…`, `a+a+a+…` — parsed by a loop, so
            # the parser's own depth guard never sees it) is bounded here so the
            # recursive resolver walkers stop instead of overflowing the stack.
            walk_depth: mutable u32
