extend Semantic:
    public:
        # Symbol-table types — the shared vocabulary the semantic passes produce, public
        # members of `module Semantic` (callers name them `Semantic::SymbolTable`). `SymbolKind`
        # is a module-scoped enum used across the module's files, which stage0 now lowers.

        const enum SymbolKind of u8:
            Func
            Struct
            Enum
            Const
            Module
            Alias
            Law
            Import
            Extern
            Unknown


        # The structured type the inference engine assigns to an expression. A sound
        # SUBSET: `Unknown` is the bottom for anything not modeled and is NEVER used to
        # raise a diagnostic (only a firmly-known kind can). Numerics collapse to `Int`/
        # `Float` (Elisa inter-converts widths); `String` spans cstr/dstr/sview; `Named`
        # carries a struct/enum spelling in `InferType.name`. Supersedes the older coarse
        # "family" strings, which are now a projection of this (`family_of_kind`).
        const enum SemTypeKind of u8:
            Unknown
            Void
            Int
            Float
            Bool
            Char
            String
            Named
            Tuple
            # --- structural kinds (Phase C, backlog 92-94) — meaningful only as interned
            # type-table rows (see type_table.elisa): the element/base types live in the
            # table's flat pool, NOT in InferType (which must stay POD; see DESIGN NOTE).
            # An `InferType` value itself never carries these kinds today.
            # `T?` — one pool element: the base type.
            Optional
            # `T&` (each `&` of a `T&&` chain is one Ref row) — one pool element: the referent.
            Ref
            # A generic-instance/container annotation: `darray[T]`, `dict[K, V]`, `i64[3]`
            # (name "array"), or a user generic `Foo[A, B]`. `name` is the head spelling;
            # pool elements are the type arguments in order.
            Container
            # A region lifetime used as a generic type argument, e.g. `JsonHandle[arena]`.
            # Region names participate in structural type identity: collapsing them to
            # Unknown lets a value tied to one arena be assigned to a handle tied to another.
            Region


        # Source indices address immutable Ast::File metadata; declaration IDs
        # address the collected symbol table. No spelling is used as identity.
        struct ResolvedStateFamily:
            declaration_id: DeclId
            source_index: u32

        struct ResolvedStateEdge:
            declaration_id: DeclId
            source_index: u32

        struct ResolvedDerivedStateRule:
            declaration_id: DeclId
            source_index: u32

        # Declared structural type of one lexical owner. Shadowed spellings have
        # different BindingIds; the module is retained for later nominal lookup.
        struct BindingDeclaredType:
            binding_id: BindingId
            type_id: u32
            # Preserve state arguments and qualifiers erased by structural interning.
            annotation: Ast::Expr
            module_owner: sview
            pos: Ast::Pos
            # Syntax facts, not an assertion that a nominal alias is owned.
            explicit_borrow: bool
            writable_borrow: bool
            linear_mutable: bool
            binding_mutable: bool
            capabilities: BindingCapabilities
            state_identity: BindingStateIdentity

        struct BindingStateIdentity:
            known: bool
            family_id: DeclId
            state_index: u32
            protocol: bool

        # A source occurrence, not an execution trace or a consumption verdict.
        struct ResolvedBindingMove:
            resolved: bool
            binding_id: BindingId
            pos: Ast::Pos
            operand_pos: Ast::Pos

        # Observational whole-binding liveness only. Not borrow/type/state-edge
        # authority, and not a replacement for the existing affine diagnostics.
        struct OwnershipOccurrence:
            binding_id: BindingId
            pos: Ast::Pos
            is_move: bool
            known: bool
            liveness_available: bool

        struct OwnershipFunctionFlow:
            owner: DeclId
            coverage_complete: bool
            fallthrough_reachable: bool
            facts_start: usize
            facts_count: usize

        struct OwnershipFrontier:
            facts: mutable darray[OwnershipBindingFact]
            reachable: mutable bool
            coverage_complete: mutable bool

        struct OwnershipFlowWork:
            occurrences: mutable darray[OwnershipOccurrence]
            fuel: mutable usize

        struct BindingCapabilities:
            known: bool
            borrowed: bool
            writable: bool
            linear_mutable: bool
            declaration_id: DeclId

        # Bare alias projections used by tooling cannot preserve references,
        # state arguments, or lmut. Keep the complete target under canonical ID.
        struct TypeAliasDeclaration:
            declaration_id: DeclId
            target: Ast::Expr
            module_owner: sview
            pos: Ast::Pos


        # One lexical region binder within a collected file. The wrapped value is
        # table-local and remains distinct from a region's source spelling and from
        # a TypeId. Persistent caches must pair it with the source/module fingerprint.
        struct RegionId:
            value: u32


        # An inferred expression type: a `kind` plus, for `Named`, the struct/enum name
        # (empty otherwise). Deliberately small — richer shape (refs, optionals, generics) is
        # added as the engine grows; until then those infer to `Unknown`.
        #
        # DESIGN NOTE (backlog item 91): `InferType` must stay POD. It must NOT gain an owned
        # `darray[InferType]` field for structural element types — that makes
        # `infer_expression_type` return a region-bearing value, which turns it
        # region-polymorphic and forces all ~20 of its callers into region-inferable contexts
        # (verified empirically). Structural detail is instead read on demand from the AST
        # (e.g. a `Tuple` type's element expressions live in `Expr.Tuple(elements, …)`);
        # a consumer that needs element types recurses into that node in its own region
        # context. Only if O(1) structural type identity is later needed does the flat
        # `u32`-interned element pool (stage0 `typeid.go`) become necessary.
        struct InferType:
            kind: SemTypeKind
            name: sview @source


        struct Symbol:
            name: sview @source
            # Declared bare RETURN-type name of a Func symbol ("" when absent, void, or
            # not a bare ident/primitive). Feeds the engine's call-return typing: a direct
            # `f(...)` call to a uniquely-named function gets this type.
            return_type: sview @source
            # Exact source span of the declared identifier when the parser carries it. The
            # declaration node's `line` often points at a keyword, so it is not a substitute.
            name_pos: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            # Canonical identity equal to this declaration's row in the owning SymbolTable.
            id: DeclId
            line: u32
            # Byte offset of the declaration (0 when the producer had none): the order key
            # that survives `#line` renumbering — see enclosing_try_function.
            offset: u32 = 0
            # Declared-parameter arity range, meaningful for Func symbols only
            # (0/0 otherwise): `arity_min` = parameters without defaults,
            # `arity_max` = all declared parameters.
            arity_min: u32
            arity_max: u32
            # Structural sibling (Phase C): the return annotation's interned TypeId
            # (0 when absent/unmodeled). Lets calls to `-> darray[T]` functions infer
            # Container where the bare name above is "".
            return_type_id: u32 = 0
            kind: SymbolKind
            # Lexical module that owns this declaration. The flat symbol-name index is
            # intentionally cross-module for lookup, so checks that classify nominal types
            # must not infer ownership from a same-spelled symbol in an unrelated module.
            module_owner: sview = ""
            # Const-enum identity is nominal and module-scoped even though its backend
            # representation is the underlying scalar. Keep the kind on the declaration row;
            # the legacy const_enum_names projection is intentionally only a bare-name list.
            is_const_enum: bool = false
            # A bare `extern T` is a foreign-owned handle value, distinct from a
            # typed extern global or an Elisa reference to a handle's local slot.
            opaque_extern_type: bool = false

        # One high-confidence definition edge produced while resolving a value identifier.
        # The `DeclId` identifies a row in `symbols`; the source `Pos` is the exact parsed token span.
        # Consumers must still apply their own supported-subset policy before exposing it.
        struct DefinitionReference:
            pos: Ast::Pos
            declaration_id: DeclId

        # Exact per-spelling facts used by the resolver's NameLookup query. The index is
        # rebuilt after declarations, imports, aliases, and region annotations are collected.
        # `name_indexed` mirrors exact symbol-name membership; counts preserve the resolver's
        # multiplicity-sensitive rule, and visibility bits answer member visibility separately.
        struct ResolverNameLookupSurface:
            valid: bool
            name_indexed: bool
            nonmodule_symbol_count: u32
            module_present: bool
            member_count: u32
            imported_visible_member: bool
            current_module_member: bool
            region_name_present: bool


        # A structured finding: the offending name/token text, the source line, and its
        # kind. This is the LSP-facing output of the frontend — `name`/`line` locate it in
        # source (for syntax findings `name` is the parser's `ParseError.context` token).
        # Fields ordered name/line/kind to avoid struct padding.
        struct Diagnostic:
            name: sview @source
            line: u32
            # The COLUMN SPAN, when the reporting check had the AST node's `Ast::Pos` to
            # hand. stage0's shape is `PATH:LINE:COLSTART-COLEND:`, and the driver prints
            # the span whenever `pos.end_column` is non-zero — so a check that has not been
            # threaded yet degrades to `PATH:LINE:`, which is what every check printed
            # before this field existed. Defaulted for exactly that reason: adding the
            # column to a check is a one-line change at its construction site, not a
            # migration of all ~790 of them.
            pos: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            kind: DiagnosticKind
            # Optional typed context for kinds that have it (TypeMismatch,
            # NonBoolCondition): the declared/expected type name and the value's
            # kind or family. Empty for other kinds.
            expected: sview @source
            actual: sview @source
            # Optional numeric context (VariantArity: expected vs actual argument
            # count). Defaulted so the ~30 diagnostic literals that don't need them
            # omit both — only kinds that carry counts set them.
            expected_count: u32 = 0
            actual_count: u32 = 0
            # Optional third textual detail for diagnostics whose compact payload needs
            # three names (currently the three-field struct-padding suggestion).
            detail: sview = ""
            # Nominal module owners for const-enum comparison diagnostics. Kept as separate
            # source views so rendering can qualify identical enum names without allocating
            # or rewriting borrowed spelling data during semantic analysis.
            const_enum_module_expected: sview = ""
            const_enum_module_actual: sview = ""
            # Second packed aggregate-state code (AggregateStateArgMismatch: the argument's).
            state_code: u32 = 0
            # A SECOND source position this diagnostic points at, when its sentence names one
            # ("module X is already declared (at PATH:LINE:COL-COL)"). Only the DRIVER can
            # render it: the path lives there, and so does the `#line` remapping a raw line
            # number has to go through. So the check records the position here, the driver
            # turns it into text, and the message builder is handed that text. Zero = this
            # diagnostic names no second position, which is all but one of them.
            secondary_line: u32 = 0
            secondary_column: u32 = 0
            secondary_end_column: u32 = 0
            # Fourth/fifth textual details: the tuple-value mismatch prints the full
            # two-field tuple spelling ((first: i64, second: i64)) from four pieces.
            detail2: sview = ""
            detail3: sview = ""
            # Inline canonical signature refs for effect-authority diagnostics. Keeping this
            # small fixed payload avoids putting a fresh compiler-temporary darray into the
            # table's longer-lived diagnostic region. Eight refs cover the largest runtime
            # signatures while preserving a scalar, zero-runtime-cost diagnostic shape.
            effect_ref_count: u32 = 0
            effect_ref_1: sview = ""
            effect_ref_2: sview = ""
            effect_ref_3: sview = ""
            effect_ref_4: sview = ""
            effect_ref_5: sview = ""
            effect_ref_6: sview = ""
            effect_ref_7: sview = ""
            effect_ref_8: sview = ""
            # stage0 spells a fallible return type `T | Set`; set for `name == "return"`
            # rows on the way out of check_full_diagnostics, where the enclosing
            # function is known. A SOURCE sview (the annotation token's text).
            error_set: mutable sview = ""


        # Fresh, empty table. Container literals seed the caller's inferred region, carried
        # out through this region-polymorphic builder's return (see `check` / `collect_symbols`).
        def SymbolTable(reserve_text_storage: bool = true) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                text_storage: mutable darray[u8] = []
                text_storage.reserve(65536) if reserve_text_storage
                return SymbolTable{symbols: [], definition_references: [], catch_match_lines: [], new_construct_lines: [], forward_arg_lines: [], forward_arg_offsets: [], block_if_lines: [], region_names: [], query_binder_offsets: [], query_binder_names: [], duplicates: 0, statements: 0, diagnostics: [], name_primary: {}, name_overflow: [], symbol_name_head: {}, symbol_name_tail: {}, symbol_name_next: [], incremental_name_lookup_chain_visits: 0, member_name_head: {}, member_name_tail: {}, member_name_next: [], imported_modules: [], imported_members: [], definite_import_annotations: [], possible_import_annotations: [], current_module: "", enum_variant_owner: [], enum_variant_name: [], enum_hierarchy_child: [], enum_hierarchy_parent: [], enum_variant_arity: [], enum_payload_owner: [], enum_payload_variant: [], enum_payload_name: [], enum_payload_type: [], enum_payload_type_id: [], enum_payload_position: [], enum_common_owners: [], enum_common_modules: [], enum_common_counts: [], struct_field_owner: [], struct_field_private: [], private_field_types: [], struct_field_name: [], struct_field_required: [], struct_field_type: [], struct_field_mutable: [], struct_field_type_id: [], qualified_type_module: [], qualified_type_name: [], lmut_param_owner: [], lmut_param_pos: [], function_param_owner: [], function_param_declaration_id: [], function_param_name: [], function_param_has_default: [], function_param_type: [], function_param_type_id: [], function_param_state_code: [], function_param_mutable_ref: [], function_param_name_head: {}, function_param_name_tail: {}, function_param_name_next: [], function_effect_owner: [], function_effect_name: [], function_effect_source_owner: [], function_effect_source_ref: [], generic_param_lines: [], generic_param_names: [], generic_param_owner_offsets: [], region_generic_function_lines: [], region_generic_function_offsets: [], packed_enum_names: [], declared_packed_names: [], ast_refinement_names: [], region_tied_param_names: [], fn_alias_names: [], struct_affine_owner: [], struct_affine_container_owner: [], immutable_const_names: [], const_int_names: [], const_int_values: [], ref_line: [], ref_name: [], ref_kind: [], ref_binding_ids: [], next_binding_serial: 0, current_function_decl_id: DeclId{value: 4294967295}, type_row_kind: [], type_row_name: [], type_row_elem_start: [], type_row_elem_count: [], type_elem_pool: [], tuple_binding_names: [], tuple_binding_offsets: [], tuple_binding_l1: [], tuple_binding_t1: [], tuple_binding_l2: [], tuple_binding_t2: [], local_type_names: [], local_type_ids: [], current_param_count: 0, walk_depth: 0, current_loop_depth: 0, text_storage: text_storage, joined_text: NameStore::new_store(), joined_text_heads: {}, extern_bounds_owner: [], extern_bounds_length: [], generic_extern_names: [], param_growth_rows: []}


        # The resolver builds these side indexes once after the symbol/import surface is
        # complete. Keep their storage together so SymbolTable exposes one cohesive
        # resolver-index component rather than a dozen parallel implementation fields.
        struct ResolverMemberPairIndex:
            owners: mutable darray[sview @source] = []
            names: mutable darray[sview @source] = []
            slots: mutable darray[u32] = []
            valid: mutable bool = false

        struct ResolverNameSurfaceIndex:
            names: mutable darray[sview @source] = []
            slots: mutable darray[u32] = []
            # Mirrors the canonical symbol-name index so a lookup needs no second hash probe.
            symbol_present: mutable darray[bool] = []
            nonmodule_counts: mutable darray[u32] = []
            module_present: mutable darray[bool] = []
            member_counts: mutable darray[u32] = []
            imported_visible: mutable darray[bool] = []
            region_present: mutable darray[bool] = []
            member_pairs: mutable ResolverMemberPairIndex = ResolverMemberPairIndex{}
            valid: mutable bool = false
