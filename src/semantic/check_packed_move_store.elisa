# Validate `move VALUE in STORE as PackedEnum.V(...)`. The parser's transparent
# move Block records `[qualified_pattern_path, store_identifier]` in its clause.
# This pass fires only when both packed enum and Store owners are exact.

extend Semantic:
    private:
        # Whether `qualified` (`Outer::Right::Message`) is spelled by the `::` chain
        # `path` as seen from `current_module`: exactly, or relative to a module that
        # encloses the use (`Right::Message` inside `Outer`). Compared in place, no join.
        def packed_qualified_name_matches_path(qualified: sview, path: darray[sview]&, current_module: sview) -> bool:
            can Abort.Panic:
                spelled: mutable usize = 0
                for segment in path |spelled|:
                    spelled <- spelled + segment.len
                spelled <- spelled + 2.usize() * (path.count - 1.usize())
                total: usize = qualified.len
                return false if spelled > total
                start: usize = total - spelled
                if start > 0:
                    return false if start < 2 or qualified[start - 1.usize()] != ':' or qualified[start - 2.usize()] != ':'
                offset: mutable usize = start
                for segment in path |offset|:
                    return false if not sview_slice_equals(qualified, offset, segment)
                    offset <- offset + segment.len + 2.usize()
                return true if start == 0
                # The unspelled prefix must be the use site's module or one enclosing it.
                prefix: usize = start - 2.usize()
                return false if current_module.len < prefix
                for byte_index in 0..<prefix:
                    return false if current_module[byte_index] != qualified[byte_index]
                return current_module.len == prefix or (current_module[prefix] == ':' and current_module[prefix + 1.usize()] == ':')


        # The declared packed enum a module-qualified type chain names, as an index into
        # table.qualified_packed_names, or `null` for anything else (a bare Ident is the
        # registry's own key and needs no resolving). The packed registries are keyed by
        # the BARE name, so callers use the chain's last segment as the owner.
        def packed_enum_of_scope_chain(expression: Ast::Expr, table: SymbolTable&) -> usize?:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Scope(base, name, line):
                        pass
                    _:
                        return null
                return null if table.qualified_packed_names.count == 0
                path: mutable darray[sview] = []
                return null if not zeroed_collect_qualified_type_path(expression, path)
                for index in 0..<table.qualified_packed_names.count:
                    return index if packed_qualified_name_matches_path(table.qualified_packed_names[index], path, table.current_module)
                return null


        # `Message` for a bare `Message` and for a qualified chain naming a packed enum.
        def packed_owner_name_of(expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Scope(base, name, line):
                        return name if packed_enum_of_scope_chain(expression, table) is found
                        return ""
                    _:
                        return ident_name_of(expression)


        # How a diagnostic spells the owner: the declared qualified name for a chain.
        def packed_owner_display_of(expression: Ast::Expr, fallback: sview, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return table.qualified_packed_names[found] if packed_enum_of_scope_chain(expression, table) is found
                return fallback


        # How a diagnostic names the packed enum a BARE `name` refers to. stage0 prints the
        # declared module path (`Outer::Right::Message`), also for a bare use inside the
        # module. The nearest declaration visible from table.current_module wins; else the
        # single nested declaration when no top-level one shares the name; else `name`.
        def packed_bare_display_name(name: sview, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return name if table.qualified_packed_names.count == 0
                path: mutable darray[sview] = [name]
                best: mutable sview = ""
                only: mutable sview = ""
                candidates: mutable usize = 0
                while index < table.qualified_packed_names.count |index: usize = 0, best, only, candidates|:
                    qualified: sview = table.qualified_packed_names[index]
                    # Passing the qualified name itself as the use-site module accepts any
                    # prefix, so this asks only "is `name` its last segment".
                    if packed_qualified_name_matches_path(qualified, path, qualified):
                        candidates <- candidates + 1
                        only <- qualified
                        best <- qualified if packed_qualified_name_matches_path(qualified, path, table.current_module) and qualified.len > best.len
                    index <- index + 1
                return best if best != ""
                declarations: mutable usize = 0
                while slot < table.declared_packed_names.count |slot: usize = 0, declarations|:
                    declarations <- declarations + 1 if table.declared_packed_names[slot] == name
                    slot <- slot + 1
                return only if candidates == 1 and declarations == candidates
                return name


        def packed_store_owner_of_type(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, line):
                        return packed_store_owner_of_type(head, table)
                    Expr.IndexN(head, arguments, line):
                        return packed_store_owner_of_type(head, table)
                    Expr.Unary(operator, operand, line):
                        return packed_store_owner_of_type(operand, table)
                    Expr.Field(owner, field, line):
                        return packed_owner_name_of(owner, table) if field == "Store"
                    Expr.Scope(owner, field, line):
                        return packed_owner_name_of(owner, table) if field == "Store"
                    _:
                        pass
                return ""


        # Select an allocation enclosing this constructor call while excluding allocations
        # whose token belongs to one of its argument expressions. The call span alone also
        # contains nested argument allocations, which must be checked at their own AST node.
        def packed_call_enclosing_allocation(call_pos: Ast::Pos, arguments: darray[Ast::Expr], statement_start: u32, statement_end: u32, allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: darray[Ast::EnumAnnotation]&) -> sview:
            can Abort.Panic:
                span: mutable Ast::Pos = call_pos
                for annotation in call_spans |span|:
                    span <- annotation.pos if annotation.owner == "__call_source_span" and annotation.offset == call_pos.offset
                if allocation_regions.count == allocation_offsets.count and span.end_offset > span.offset:
                    for row_index in 0..<allocation_regions.count |span, arguments, allocation_offsets, allocation_regions, call_spans|:
                        allocation_offset: u32 = allocation_offsets[row_index]
                        continue if allocation_region_is_inline_effect_row(allocation_regions, allocation_offsets, row_index)
                        in_call_span: bool = allocation_offset >= span.offset and allocation_offset < span.end_offset
                        in_statement_prefix: bool = statement_end > statement_start and allocation_offset >= statement_start and allocation_offset < statement_end and allocation_offset < span.offset
                        continue if not in_call_span and not in_statement_prefix
                        in_argument: mutable bool = false
                        for argument in arguments |allocation_offset, in_argument|:
                            argument_pos: Ast::Pos = Ast::expr_pos(argument)
                            argument_end: u32 = allocation_expression_end_offset(argument, call_spans)
                            starts_in_argument: bool = argument_end > argument_pos.offset and allocation_offset >= argument_pos.offset and allocation_offset < argument_end
                            # If lowering erased a prefix `new[r]`, the argument Pos can start
                            # at its payload. Rows from this call's callee start to that payload
                            # still belong to the argument; an allocation wrapping the call is
                            # before the recorded call span and stays eligible as its store.
                            erased_prefix_in_argument: bool = allocation_offset >= span.offset and allocation_offset < argument_pos.offset and allocation_offset < argument_end
                            in_argument <- true if starts_in_argument or erased_prefix_in_argument
                        return allocation_regions[row_index] if not in_argument
                    return ""
                return allocation_region_at(allocation_regions, allocation_lines, allocation_offsets, call_pos.line) if call_pos.offset == 0 and call_pos.end_offset == 0
                return ""


        # Every bare identifier a signature type mentions, so `Tree`, `Tree?`,
        # `darray[Tree]` and `mutable Tree&` all report `Tree`. Used only to decide whether
        # an AUTO-PROMOTED enum's value can escape the function; see
        # check_packed_constructor_path.
        def collect_type_identifiers(type_expression: Ast::Expr, found: mutable darray[sview]&) -> void:
            can Abort.Panic, Memory.Allocate:
                match type_expression:
                    Expr.Ident(name, line):
                        found.push(name)
                    Expr.Index(head, argument, line):
                        collect_type_identifiers(head, found)
                        collect_type_identifiers(argument, found)
                    Expr.IndexN(head, arguments, line):
                        collect_type_identifiers(head, found)
                        for argument in arguments |found|:
                            collect_type_identifiers(argument, found)
                    Expr.Unary(operator, operand, line) | Expr.Paren(operand, line):
                        collect_type_identifiers(operand, found)
                    Expr.Field(owner, field, line) | Expr.Scope(owner, field, line):
                        collect_type_identifiers(owner, found)
                    _:
                        pass


        def store_owner_for_name(names: darray[sview]&, owners: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    return owners[index] if names[index] == name
                return ""


        def packed_store_is_frozen(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return (name == "Frozen")
                    Expr.Index(head, argument, line):
                        return packed_store_is_frozen(head) or packed_store_is_frozen(argument)
                    Expr.IndexN(head, arguments, line):
                        return true if packed_store_is_frozen(head)
                        for argument in arguments:
                            return true if packed_store_is_frozen(argument)
                        return false
                    Expr.Unary(operator, operand, line) | Expr.Paren(operand, line):
                        return packed_store_is_frozen(operand)
                    _:
                        return false


        def frozen_store_for_name(names: darray[sview]&, frozen: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    return frozen[index] if names[index] == name
                return false


        def packed_owner_for_path(path: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                while index < table.packed_enum_names.count |index: usize = 0|:
                    owner: sview = table.packed_enum_names[index]
                    return owner if path_qualified_by(path, owner)
                    index <- index + 1
                return ""


        def registered_struct_field_count(owner: sview, table: SymbolTable&) -> u32:
            can Abort.Panic:
                count: mutable u32 = 0
                while index < table.struct_field_owner.count |index: usize = 0, count|:
                    count <- count + 1 if table.struct_field_owner[index] == owner
                    index <- index + 1
                return count


        def packed_store_owner_active(owners: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any owner in owners where owner == wanted


        def packed_new_construct_at(table: SymbolTable&, target_pos: Ast::Pos) -> bool:
            can Abort.Panic:
                return false if table.new_construct_lines.count != table.new_construct_offsets.count
                for index in 0..<table.new_construct_lines.count:
                    return true if table.new_construct_lines[index] == target_pos.line and table.new_construct_offsets[index] == target_pos.offset
                return false


        def check_packed_constructor_path(owner: sview, shown: sview @source, variant: sview @source, target_pos: Ast::Pos, owners: darray[sview]&, signature_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # The store-clause requirement applies to an EXPLICITLY `packed enum`
                # owner AND to a plain recursive enum auto-promoted by
                # record_recursive_enum — but NOT to a member of a sealed Node hierarchy.
                #
                # The exemption used to cover every auto-promoted enum, because demanding
                # a store for the compiler's own bare `(Ast::Expr.Ident(text, line))`
                # produced 49 findings on our own source. It was then narrowed to AST
                # REFINEMENTS only, on this measurement:
                #
                #   enum Node: Leaf(v: i64); Pair(a: Node, b: Node)   bare Node.Leaf(42)
                #     -> stage0: "packed enum constructor Node.Leaf requires an active in
                #        Node.Store: scope or explicit new[Node.Store]"      REJECTED
                #   the same shape inside a sealed `is Node` hierarchy
                #     -> no store error at all                               exempt
                #
                # RE-MEASURED, and the narrowing was too strong. stage0 rejects that bare
                # constructor only when the value CANNOT LEAVE the function; a helper that
                # returns it is accepted. The probe above must have been the non-escaping
                # shape, and stage0 rejects that one with a REGION error
                # ("`new` needs a region to infer"), not with this store error — two
                # different diagnostics that read alike in a pass/fail table.
                #
                # As written the rule rejected every ordinary
                # `def make() -> Tree: return Tree.Leaf(…)`, which is the whole ergonomic
                # point of an auto-promoted enum. The escape test below restores it.
                packed_owner: sview = owner if (any packed_name in table.packed_enum_names where packed_name == owner) else ""
                declared: bool = any declared_name in table.declared_packed_names where declared_name == owner
                refinement: bool = any refinement_name in table.ast_refinement_names where refinement_name == owner
                # An AUTO-PROMOTED enum whose value can ESCAPE this function needs no store
                # clause: the caller's region is threaded in, which is what stage0's own
                # message asks for ("return the allocation from this function so a region is
                # threaded in"). Measured against stage0, one probe per shape:
                #
                #   def make() -> Tree:            return Tree.Leaf(v: 1)     ACCEPT
                #   def make() -> darray[Tree]:    xs.push(Tree.Leaf(v: 1))   ACCEPT
                #   def make() -> Tree?:           return Tree.Leaf(v: 1)     ACCEPT
                #   def make(out: mutable Tree&) -> void: out <- Tree.Leaf(…) ACCEPT
                #   def make() -> i64:             t: Tree = Tree.Leaf(v: 1)  REJECT
                #
                # So the condition is that the SIGNATURE mentions the enum, not that the
                # value is returned — an out-parameter escapes too. A `region` in scope does
                # NOT satisfy it; constructing into one and returning i64 is still rejected.
                #
                # The previous rule waived this only for AST refinements, which rejected
                # every ordinary `def make() -> Tree: return Tree.Leaf(…)`. The comment
                # justifying that cited stage0 rejecting a bare `Node.Leaf(42)` — true only
                # for the NON-escaping shape, whose stage0 rejection is a REGION error, not
                # this store error. The two were conflated.
                #
                # It stays limited to auto-promoted enums: an explicitly `packed enum` is
                # rejected by stage0 even when returned, and even under a bare `new`.
                escapes: bool = any signature_name in signature_names where signature_name == owner
                needs_store: bool = declared or (not refinement and not escapes)
                # A plain `new Node.Leaf(42)` satisfies the requirement for an
                # AUTO-PROMOTED recursive enum, which is region-backed by design — stage0
                # accepts that where it rejects the bare form.
                #
                # It does NOT satisfy it for an explicitly DECLARED packed enum: stage0's
                # own TestAnalyzeRejectsBarePackedAllocOutsideInStoreScope rejects
                # `return new Expr.Int(value: 1)` on a `packed enum Expr`. The diagnostic
                # means what it says — `new[Expr.Store]`, naming a store, not a bare `new`.
                # Exempting every `new` cost one case on that suite and is the reason this
                # condition carries `not declared`.
                under_new: bool = (not declared) and packed_new_construct_at(table, target_pos)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedConstructorWithoutStore, name: shown, line: target_pos.line, expected: variant, actual: ""}) if packed_owner != "" and needs_store and not under_new and variant != "Store" and not packed_store_owner_active(owners, packed_owner)


        # `Outer::Right::Message.A(...)`: the same rule as the bare spelling, once the
        # chain resolves to a declared packed enum. A chain naming anything else (a plain
        # enum that shares the bare name, a module function) is not this check's business.
        def check_packed_scope_constructor(chain: Ast::Expr, variant: sview @source, target_pos: Ast::Pos, owners: darray[sview]&, signature_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match chain:
                    Expr.Scope(base, name, chain_line):
                        # Read the shown name BEFORE the lmut call: passing a projection of
                        # `table` beside `table` itself aliases the linear value.
                        if packed_enum_of_scope_chain(chain, table) is found:
                            shown: sview = table.qualified_packed_names[found]
                            table <- check_packed_constructor_path(name, shown, variant, target_pos, owners, signature_names, table)
                    _:
                        pass


        def check_frozen_packed_allocation(expression: Ast::Expr, names: darray[sview]&, frozen: darray[bool]&, allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: darray[Ast::EnumAnnotation]&, statement_start: u32, statement_end: u32, explicit_store: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        call_store: sview = explicit_store if explicit_store != "" else packed_call_enclosing_allocation(line, arguments, statement_start, statement_end, allocation_regions, allocation_lines, allocation_offsets, call_spans)
                        match callee:
                            Expr.Field(Expr.Ident(owner, owner_line), variant, field_line):
                                packed_owner: sview = owner if (any packed_name in table.packed_enum_names where packed_name == owner) else ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedFrozenStoreAllocation, name: packed_owner, line: line.line, expected: "", actual: ""}) if packed_owner != "" and frozen_store_for_name(names, frozen, call_store)
                            _:
                                pass
                        for argument in arguments |table|:
                            table <- check_frozen_packed_allocation(argument, names, frozen, allocation_regions, allocation_lines, allocation_offsets, call_spans, 0, 0, "", table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- check_frozen_packed_allocation(element, names, frozen, allocation_regions, allocation_lines, allocation_offsets, call_spans, 0, 0, "", table)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields |table|:
                            table <- check_frozen_packed_allocation(field.value, names, frozen, allocation_regions, allocation_lines, allocation_offsets, call_spans, 0, 0, "", table)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        table <- check_frozen_packed_allocation(operand, names, frozen, allocation_regions, allocation_lines, allocation_offsets, call_spans, statement_start, statement_end, explicit_store, table)
                    # `new[store] Packed.Variant(…)` — the allocation this check exists to
                    # reject is INSIDE the wrapper, so the wrapper must be walked through.
                    # A separate arm rather than joining the or-pattern above: this variant
                    # binds a third field, and or-pattern options must bind alike.
                    Expr.RegionNew(operand, region, line):
                        table <- check_frozen_packed_allocation(operand, names, frozen, allocation_regions, allocation_lines, allocation_offsets, call_spans, statement_start, statement_end, region, table)
                    _:
                        pass


        def walk_packed_constructor_expression(expression: Ast::Expr, owners: darray[sview]&, signature_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(Expr.Ident(owner, _), variant, _):
                                shown_owner: sview = packed_bare_display_name(owner, table)
                                table <- check_packed_constructor_path(owner, shown_owner, variant, line, owners, signature_names, table)
                            Expr.Field(Expr.Scope(chain_base, chain_name, chain_line), variant, _):
                                table <- check_packed_scope_constructor(Expr.Scope(chain_base, chain_name, chain_line), variant, line, owners, signature_names, table)
                            _:
                                table <- walk_packed_constructor_expression(callee, owners, signature_names, table)
                        for argument in arguments |table|:
                            table <- walk_packed_constructor_expression(argument, owners, signature_names, table)
                    Expr.Field(Expr.Ident(owner, owner_line), variant, line):
                        shown_field_owner: sview = packed_bare_display_name(owner, table)
                        table <- check_packed_constructor_path(owner, shown_field_owner, variant, line, owners, signature_names, table)
                    Expr.Field(Expr.Scope(chain_base, chain_name, chain_line), variant, line):
                        table <- check_packed_scope_constructor(Expr.Scope(chain_base, chain_name, chain_line), variant, line, owners, signature_names, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_packed_constructor_expression(left, owners, signature_names, table)
                        table <- walk_packed_constructor_expression(right, owners, signature_names, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Unary(operator, operand, line):
                        table <- walk_packed_constructor_expression(operand, owners, signature_names, table)
                    Expr.Paren(inner, line):
                        table <- walk_packed_constructor_expression(inner, owners, signature_names, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_packed_constructor_expression(element, owners, signature_names, table)
                    Expr.Index(object, index, line):
                        table <- walk_packed_constructor_expression(object, owners, signature_names, table)
                        table <- walk_packed_constructor_expression(index, owners, signature_names, table) if not index_receiver_is_type_application(object)
                    Expr.Slice(object, low, high, line):
                        table <- walk_packed_constructor_expression(object, owners, signature_names, table)
                        table <- walk_packed_constructor_expression(low, owners, signature_names, table)
                        table <- walk_packed_constructor_expression(high, owners, signature_names, table)
                    _:
                        pass


        # The parser keeps a move destructure as Block("move") whose first statement is
        # the synthetic Match. Inspect only that exact lowering shape, so ordinary match
        # patterns retain their own diagnostics and wording.
        def check_move_struct_arity(clause: darray[sview @source]&, body: darray[Ast::Stmt]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if clause.count == 0 or body.count == 0
                path: sview = clause[0]
                expected_count: u32 = registered_struct_field_count(path, table)
                return if expected_count == 0
                match body[0]:
                    Stmt.Match(scrutinee, arms, match_line):
                        return if arms.count == 0
                        match arms[0].pattern:
                            Pattern.Struct(struct_path, fields):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MoveStructPatternArityMismatch, name: path, line: line, expected: "", actual: "", expected_count: expected_count, actual_count: fields.count.u32()}) if struct_path == path and fields.count.u32() != expected_count
                            # Parenthesized move patterns are syntactically shared with enum
                            # variants. A registered struct path disambiguates this case here.
                            Pattern.Variant(struct_path, fields):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MoveStructPatternArityMismatch, name: path, line: line, expected: "", actual: "", expected_count: expected_count, actual_count: fields.count.u32()}) if struct_path == path and fields.count.u32() != expected_count
                            _:
                                pass
                    _:
                        pass


        def walk_packed_move_store(statements: darray[Ast::Stmt], names: mutable darray[sview]&, owners: mutable darray[sview]&, frozen: mutable darray[bool]&, signature_names: darray[sview]&, allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, owners, frozen, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_packed_constructor_expression(value, owners, signature_names, table)
                            value_end_offset: u32 = allocation_expression_end_offset(value, call_spans)
                            table <- check_frozen_packed_allocation(value, names, frozen, allocation_regions, allocation_lines, allocation_offsets, call_spans, line.offset, value_end_offset, "", table)
                            names.push(name)
                            owners.push(packed_store_owner_of_type(type_expression, table))
                            frozen.push(packed_store_is_frozen(type_expression))
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_packed_constructor_expression(value, owners, signature_names, table)
                        Stmt.Expr(expression, line):
                            table <- walk_packed_constructor_expression(expression, owners, signature_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_packed_constructor_expression(condition, owners, signature_names, table)
                            table <- walk_packed_move_store(then_body, names, owners, frozen, signature_names, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                            table <- walk_packed_move_store(else_body, names, owners, frozen, signature_names, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        Stmt.While(condition, body, line):
                            table <- walk_packed_constructor_expression(condition, owners, signature_names, table)
                            table <- walk_packed_move_store(body, names, owners, frozen, signature_names, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_packed_constructor_expression(iterable, owners, signature_names, table)
                            table <- walk_packed_move_store(body, names, owners, frozen, signature_names, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "move" and clause.count >= 2:
                                expected_owner: sview = packed_owner_for_path(clause[0], table)
                                actual_owner: sview = store_owner_for_name(names, owners, clause[1])
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedMoveStoreMismatch, name: clause[1], line: line.line, expected: expected_owner, actual: actual_owner}) if expected_owner != "" and actual_owner != "" and expected_owner != actual_owner
                            table <- check_move_struct_arity(clause, body, line.line, table) if kind == "move"
                            table <- walk_packed_move_store(body, names, owners, frozen, signature_names, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_packed_constructor_expression(scrutinee, owners, signature_names, table)
                            for arm in arms |names, owners, frozen, table| -> table:
                                table <- walk_packed_move_store(arm.body, names, owners, frozen, signature_names, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        Stmt.Return(value, line):
                            table <- walk_packed_constructor_expression(returned_value, owners, signature_names, table) if value is returned_value
                            if value is returned_value:
                                value_end_offset: u32 = allocation_expression_end_offset(returned_value, call_spans)
                                table <- check_frozen_packed_allocation(returned_value, names, frozen, allocation_regions, allocation_lines, allocation_offsets, call_spans, line.offset, value_end_offset, "", table)
                        _:
                            pass


        def check_packed_move_store_declarations(declarations: darray[Ast::Decl], allocation_regions: darray[sview @source]&, allocation_lines: darray[u32]&, allocation_offsets: darray[u32]&, call_spans: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            owners: mutable darray[sview] = []
                            frozen: mutable darray[bool] = []
                            # Every type named in the SIGNATURE. A value of such a type can
                            # leave this function, so an auto-promoted enum constructed here
                            # is backed by the caller's threaded region and needs no store
                            # clause. See check_packed_constructor_path.
                            signature_names: mutable darray[sview] = []
                            for param in params |names, owners, frozen, signature_names|:
                                names.push(param.name)
                                owners.push(packed_store_owner_of_type(param.type_expression, table))
                                frozen.push(packed_store_is_frozen(param.type_expression))
                                collect_type_identifiers(param.type_expression, signature_names)
                            collect_type_identifiers(return_value_type, signature_names) if return_type is return_value_type
                            table <- walk_packed_move_store(body, names, owners, frozen, signature_names, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        Decl.Module(module_name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- check_packed_move_store_declarations(body, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- check_packed_move_store_declarations(body, allocation_regions, allocation_lines, allocation_offsets, call_spans, table)
                        _:
                            pass

    public:
        def check_packed_move_store(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_packed_move_store_declarations(file.top_decls, file.allocation_region_names, file.allocation_region_lines, file.allocation_region_offsets, file.enum_annotations, table)
