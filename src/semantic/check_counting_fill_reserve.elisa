# Counting-fill without a synthesizable reserve (stage0 auto-reserve lint, docs/70).
# This mirrors stage0's direct lint for a provably bounded counting loop that grows one darray
# declared in the loop body. A nested loop's growth is included only when its bound is available
# before the flagged loop; if it mentions a name introduced by that loop or its body, suggesting
# a reserve before the loop would produce an out-of-scope expression and is suppressed. The
# auto-reserve pass remains responsible for fresh darrays whose bound can be synthesized.
# Reuses is_darray_type / expr_mentions_name / collect_darray_names / push_call_shape from
# check_push_loop_lint.elisa.
extend Semantic:
    private:
        # The HI operand of a counting range `LO..<HI` / `LO..HI` / `LO..=HI`, else (false, Absent).
        def cfr_range_hi(iterable: Ast::Expr) -> (found: bool, hi: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                match iterable:
                    Expr.Binary(left, operator, right, line):
                        counting: bool = operator == TokenKind.Range or operator == TokenKind.RangeLt or operator == TokenKind.RangeLe
                        return (true, right) if counting else (false, (Ast::Expr.Absent))
                    Expr.Paren(inner, paren_line):
                        return cfr_range_hi(inner)
                    _:
                        return (false, (Ast::Expr.Absent))

        # Every name introduced anywhere in a statement list (recursively), including nested
        # loop binders. This is the source-language counterpart of stage0's
        # namesBoundInsideLoop: these names are not in scope before the current loop.
        def cfr_collect_bound_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if name != "" and name != "_"
                        Stmt.If(condition, then_body, else_body, if_line):
                            cfr_collect_bound_names(then_body, out)
                            cfr_collect_bound_names(else_body, out)
                        Stmt.While(condition, while_body, while_line):
                            cfr_collect_bound_names(while_body, out)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            for loop_var in variables |out|:
                                out.push(loop_var) if loop_var != "" and loop_var != "_"
                            cfr_collect_bound_names(for_body, out)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            cfr_collect_bound_names(block_body, out)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |out|:
                                cfr_collect_bound_names(arm.body, out)
                        _:
                            pass

        # Every VarDecl name declared anywhere in a statement list (recursively).
        def cfr_collect_local_decls(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name)
                        Stmt.If(condition, then_body, else_body, if_line):
                            cfr_collect_local_decls(then_body, out)
                            cfr_collect_local_decls(else_body, out)
                        Stmt.While(condition, while_body, while_line):
                            cfr_collect_local_decls(while_body, out)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            cfr_collect_local_decls(for_body, out)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            cfr_collect_local_decls(block_body, out)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |out|:
                                cfr_collect_local_decls(arm.body, out)
                        _:
                            pass

        # Whether EXPR mentions any name in NAMES.
        def cfr_mentions_any(expression: Ast::Expr, names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any candidate in names where candidate != "" and expr_mentions_name(expression, candidate)

        # Whether `name.reserve(...)` or `name.resize(...)` occurs anywhere — either disqualifies
        # the fresh darray from the lint (an explicit or resizing capacity is already present).
        def cfr_has_reserve(statements: darray[Ast::Stmt]&, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if cfr_expr_is_reserve(expression, name)
                        Stmt.If(condition, then_body, else_body, if_line):
                            true return if cfr_has_reserve(then_body, name)
                            true return if cfr_has_reserve(else_body, name)
                        Stmt.While(condition, while_body, while_line):
                            true return if cfr_has_reserve(while_body, name)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            true return if cfr_has_reserve(for_body, name)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            true return if cfr_has_reserve(block_body, name)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |name|:
                                true return if cfr_has_reserve(arm.body, name)
                        _:
                            pass
                return false

        def cfr_expr_is_reserve(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                grows: bool = field == "reserve" or field == "resize"
                                return grows and ident_name_of(object) == name
                            _:
                                pass
                        return false
                    _:
                        return false

        # Collect darray destinations pushed-to anywhere in a statement list (recursively).
        def cfr_collect_pushes(statements: darray[Ast::Stmt], darray_names: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |darray_names, out|:
                    shape: (dst: sview, value: Ast::Expr) = push_call_shape(statement)
                    out.push(shape.dst) if shape.dst != "" and (any d in darray_names where d == shape.dst)
                    match statement:
                        Stmt.If(condition, then_body, else_body, if_line):
                            cfr_collect_pushes(then_body, darray_names, out)
                            cfr_collect_pushes(else_body, darray_names, out)
                        Stmt.While(condition, while_body, while_line):
                            cfr_collect_pushes(while_body, darray_names, out)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            cfr_collect_pushes(for_body, darray_names, out)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            cfr_collect_pushes(block_body, darray_names, out)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |darray_names, out|:
                                cfr_collect_pushes(arm.body, darray_names, out)
                        _:
                            pass

        # Whether this loop contains a nested counting loop whose bound depends on a name
        # introduced by the current loop. Stage0 can reserve that nested loop per iteration,
        # but cannot hoist the resulting product before the current loop. Do not issue the
        # outer-loop warning in that case: the suggested reserve expression would be out of scope.
        def cfr_has_dependent_inner(statements: darray[Ast::Stmt], outer_names: darray[sview]&, in_owner: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            hi: (found: bool, hi: Ast::Expr) = cfr_range_hi(iterable)
                            return true if hi.found and cfr_mentions_any(hi.hi, outer_names) and not in_owner
                            return true if cfr_has_dependent_inner(for_body, outer_names, in_owner)
                        Stmt.If(condition, then_body, else_body, if_line):
                            return true if cfr_has_dependent_inner(then_body, outer_names, in_owner)
                            return true if cfr_has_dependent_inner(else_body, outer_names, in_owner)
                        Stmt.While(condition, while_body, while_line):
                            return true if cfr_has_dependent_inner(while_body, outer_names, in_owner)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            nested_owner: bool = in_owner or kind == "in" or kind == "region"
                            return true if cfr_has_dependent_inner(block_body, outer_names, nested_owner)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms:
                                return true if cfr_has_dependent_inner(arm.body, outer_names, in_owner)
                        _:
                            pass
                return false

        # Stage0's direct counting-fill lint warns when a darray declared inside a counting
        # loop grows without a synthesizable reserve. This is intentionally source-shaped: a
        # target declared outside the loop is handled by semantic auto-reserve when possible,
        # while a target declared in the loop body cannot be reserved before the loop. The
        # nested dependent-bound case is excluded by cfr_has_dependent_inner above.
        def cfr_emit_direct_fill_warnings(statements: darray[Ast::Stmt], darray_names: darray[sview]&, full_body: darray[Ast::Stmt]&, in_owner: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            hi: (found: bool, hi: Ast::Expr) = cfr_range_hi(iterable)
                            if hi.found and not in_owner:
                                outer_names: mutable darray[sview] = []
                                for loop_var in variables |outer_names|:
                                    outer_names.push(loop_var) if loop_var != "" and loop_var != "_"
                                cfr_collect_bound_names(for_body, outer_names)
                                local_names: mutable darray[sview] = []
                                cfr_collect_local_decls(for_body, local_names)
                                nested_dependent: bool = cfr_has_dependent_inner(for_body, outer_names, in_owner)
                                pushed: mutable darray[sview] = []
                                cfr_collect_pushes(for_body, darray_names, pushed)
                                distinct: mutable darray[sview] = []
                                for target in pushed |distinct|:
                                    distinct.push(target) if not any seen in distinct where seen == target
                                if distinct.count == 1 and any local in local_names where local == distinct[0] and not nested_dependent and not cfr_has_reserve(full_body, distinct[0]):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CountingFillUnreserved, name: distinct[0], line: for_line.line, expected: "", actual: ""})
                            nested_owner: bool = in_owner
                            cfr_emit_direct_fill_warnings(for_body, darray_names, full_body, nested_owner, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            cfr_emit_direct_fill_warnings(then_body, darray_names, full_body, in_owner, table)
                            cfr_emit_direct_fill_warnings(else_body, darray_names, full_body, in_owner, table)
                        Stmt.While(condition, while_body, while_line):
                            cfr_emit_direct_fill_warnings(while_body, darray_names, full_body, in_owner, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            nested_owner: bool = in_owner or kind == "in" or kind == "region"
                            cfr_emit_direct_fill_warnings(block_body, darray_names, full_body, nested_owner, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                cfr_emit_direct_fill_warnings(arm.body, darray_names, full_body, in_owner, table)
                        _:
                            pass

        def cfr_check_declarations(declarations: darray[Ast::Decl], region_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            has_region: bool = any region_line in region_lines where region_line == line.line
                            if not has_region:
                                darray_names: mutable darray[sview] = []
                                for parameter in parameters |darray_names|:
                                    darray_names.push(parameter.name) if is_darray_type(parameter.type_expression)
                                collect_darray_names(body, darray_names)
                                table <- cfr_emit_direct_fill_warnings(body, darray_names, body, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cfr_check_declarations(module_body, region_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cfr_check_declarations(scoped_body, region_lines, table)
                        _:
                            pass

    public:
        def check_counting_fill_reserve(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region_lines: mutable darray[u32] = []
                for annotation in file.local_region_annotations |region_lines|:
                    region_lines.push(annotation.line)
                table <- cfr_check_declarations(file.top_decls, region_lines, table)
