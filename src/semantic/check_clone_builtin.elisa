# The `clone[T](x)` builtin (v1 restrictions). `clone` deep-copies a value into a
# region-owned buffer. Two type-argument errors are diagnosable without inferring the
# source expression's type:
#
#   clone[i64&](value)                # error: clone cannot clone a reference
#   return clone[darray[u32]](items)  # error: a container clone needs an `in <owner>:` scope
#
# `clone[T](x)` parses as `Call(Index(Ident "clone", T), [x])`. An `in owner:` scope is a
# `Stmt.Block("in", ...)`. Container heads (darray/dstr/dict/set) own heap storage and so
# require an active owner scope; a reference type argument is never clonable.
extend Semantic:
    private:
        # v1 rejects cloning a reference type unconditionally. (The container-needs-owner-scope
        # rule is deliberately NOT ported here: it is context-sensitive — a `@r` region
        # annotation or a region parameter supplies the owner without an explicit `in <owner>:`
        # scope, which stage0 accepts, so a purely syntactic scope check over-fires.)
        # Peel `Paren`/`Move` wrappers so `clone[...](move src)` and `clone[...]((src))` are
        # recognised the same as a bare `clone[...](src)` — `ident_name_of` itself only
        # matches a bare `Expr.Ident` (by design, for its OTHER callers), so this file's own
        # source-argument matching must unwrap first. Confirmed against stage0: `move src`
        # gets the SAME "clone cannot clone sview into darray[u32]" rejection as bare `src`.
        def cb_unwrap_source(argument: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match argument:
                    Expr.Paren(inner, paren_line):
                        return cb_unwrap_source(inner)
                    Expr.Move(operand, move_line):
                        return cb_unwrap_source(operand)
                    _:
                        return argument

        # The declared type of a bare-ident (or `move`/paren-wrapped) source argument, if it
        # names a parameter; else Absent. Used to spot a `sview` source cloned into a wider-
        # element container.
        def cb_source_param_type(argument: Ast::Expr, param_names: darray[sview]&, param_types: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                name: sview = ident_name_of(cb_unwrap_source(argument))
                return (Ast::Expr.Absent) if name == ""
                probe: mutable usize = 0
                while probe < param_names.count |probe, name, param_names, param_types|:
                    return param_types[probe] if param_names[probe] == name
                    probe <- probe + 1
                return (Ast::Expr.Absent)

        # The source of a clone call in any spelling, or Absent: `clone[T](x)`, `clone(x)`, or
        # `x.clone()` (stage0 rewrites the method to the builtin when nothing user-defined is
        # named clone).
        def cb_clone_source(callee: Ast::Expr, arguments: darray[Ast::Expr]) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Index(head, type_argument, index_line):
                        return arguments[0] if ident_name_of(head) == "clone" and arguments.count == 1
                    Expr.IndexN(head_n, type_arguments, index_n_line):
                        return arguments[0] if ident_name_of(head_n) == "clone" and arguments.count == 1
                    Expr.Ident(plain_name, plain_pos):
                        return arguments[0] if plain_name == "clone" and arguments.count == 1
                    Expr.Field(receiver, method, method_pos):
                        return receiver if method == "clone" and arguments.count == 0
                    _:
                        pass
                return (Ast::Expr.Absent)

        # An affine or linear value -- or a struct holding one -- is never clonable: a copy
        # would duplicate a unique owner. Only parameter sources are typed here.
        def cb_reject_unclonable(source: Ast::Expr, call_pos: Ast::Pos, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, unclonable: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                source_type: Ast::Expr = cb_source_param_type(source, param_names, param_types)
                return if source_type is Expr.Absent
                type_name: sview = bare_type_name_through_ref(source_type)
                return if not (any name in unclonable where name == type_name)
                through_reference: sview = "&" if bare_type_name_through_ref(source_type) != ident_name_of(source_type) else ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneAffineRejected, name: "", line: call_pos.line, pos: call_pos, expected: through_reference, actual: type_name})

        # Struct names that cannot be cloned: every affine/linear struct, then (to a fixed
        # point) every struct with a field naming one.
        def cb_collect_unclonable(declarations: darray[Ast::Decl], names: mutable darray[sview]&, struct_names: mutable darray[sview]&, struct_fields: mutable darray[darray[Ast::StructMember]]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, struct_names, struct_fields|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_pos):
                            names.push(struct_name) if affinity == "affine" or affinity == "linear"
                            struct_names.push(struct_name)
                            struct_fields.push(members)
                        Decl.Module(module_name, module_body, module_line):
                            cb_collect_unclonable(module_body, names, struct_names, struct_fields)
                        Decl.Scoped(scoped_body, scoped_line):
                            cb_collect_unclonable(scoped_body, names, struct_names, struct_fields)
                        _:
                            pass

        def cb_unclonable_structs(declarations: darray[Ast::Decl]) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                struct_names: mutable darray[sview] = []
                struct_fields: mutable darray[darray[Ast::StructMember]] = []
                cb_collect_unclonable(declarations, names, struct_names, struct_fields)
                grew: mutable bool = true
                while grew |grew, names, struct_names, struct_fields|:
                    grew <- false
                    for index in 0..<struct_names.count |grew, names, struct_names, struct_fields|:
                        candidate: sview = struct_names[index]
                        if not (any known in names where known == candidate) and (any member in struct_fields[index] where (any held in names where held == bare_type_name_through_ref(member.type_expression))):
                            names.push(candidate)
                            grew <- true
                return names

        def cb_apply(type_argument: Ast::Expr, first_argument: Ast::Expr, call_line: u32, in_owner_scope: bool, function_has_region: bool, is_return: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, unclonable: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_argument:
                    Expr.Unary(operator, inner, unary_line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneRefRejected, name: "", line: call_line, expected: "", actual: ident_name_of(inner)}) if operator == TokenKind.Ampersand
                        # stage0 reports the rejected builtin instantiation as an unresolved
                        # generic function too (measured on every clone/copy rejection fixture).
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedGenericFunction, name: "clone", line: call_line, expected: "", actual: ""}) if operator == TokenKind.Ampersand
                    # `clone[darray[T]](src)` where src is a `sview` param and T is not `u8`: v1
                    # cannot widen a byte view into a T-element container.
                    Expr.Index(container_head, element_type, container_line):
                        element_name: sview = ident_name_of(element_type)
                        source_type: Ast::Expr = cb_source_param_type(first_argument, param_names, param_types)
                        source_is_sview: bool = bare_type_name_through_ref(source_type) == "sview"
                        mismatch: bool = ident_name_of(container_head) == "darray" and element_name != "" and element_name != "u8" and source_is_sview
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneElemMismatch, name: "", line: call_line, expected: "", actual: element_name}) if mismatch
                        # A container clone (`clone[darray[T]](x)`) that ESCAPES — its value is the
                        # function's direct `return` — owns heap storage that must outlive the call,
                        # so it needs an explicit `in <owner>:` scope. A NON-escaping clone (bound to a
                        # local) is auto-region-inferred, and a `@r`-annotated type argument is not a
                        # bare `Index` (so it never reaches here) — both correctly stay silent.
                        head_name: sview = ident_name_of(container_head)
                        is_container_head: bool = when head_name:
                            "darray" | "dstr" | "dict" | "set" -> true
                            _ -> false
                        owner_required: bool = is_container_head and is_return and not in_owner_scope and not function_has_region
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneOwnerRequired, name: "", line: call_line, expected: element_name, actual: head_name}) if owner_required
                        # ONE companion for the arm: a call that trips both rules is still a single
                        # unresolved instantiation.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedGenericFunction, name: "clone", line: call_line, expected: "", actual: ""}) if mismatch or owner_required
                    _:
                        pass

        def cb_check_clone(callee: Ast::Expr, arguments: darray[Ast::Expr], call_line: u32, in_owner_scope: bool, function_has_region: bool, is_return: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, unclonable: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                first_argument: Ast::Expr = arguments[0] if arguments.count > 0 else (Ast::Expr.Absent)
                match callee:
                    Expr.Index(head, type_argument, index_line):
                        table <- cb_apply(type_argument, first_argument, call_line, in_owner_scope, function_has_region, is_return, param_names, param_types, unclonable, table) if ident_name_of(head) == "clone"
                    Expr.IndexN(head_n, type_arguments, index_n_line):
                        table <- cb_apply(type_arguments[0], first_argument, call_line, in_owner_scope, function_has_region, is_return, param_names, param_types, unclonable, table) if ident_name_of(head_n) == "clone" and type_arguments.count > 0
                    _:
                        pass

        def cb_expr(expression: Ast::Expr, in_owner_scope: bool, function_has_region: bool, is_return: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, unclonable: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        clone_source: Ast::Expr = cb_clone_source(callee, arguments)
                        table <- cb_reject_unclonable(clone_source, call_line, param_names, param_types, unclonable, table) if not (clone_source is Expr.Absent)
                        table <- cb_check_clone(callee, arguments, call_line.line, in_owner_scope, function_has_region, is_return, param_names, param_types, unclonable, table)
                        for argument in arguments |table| -> table:
                            table <- cb_expr(argument, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cb_expr(left, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                        table <- cb_expr(right, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- cb_expr(operand, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                    Expr.Paren(inner, paren_line):
                        table <- cb_expr(inner, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                    Expr.Move(operand, move_line):
                        table <- cb_expr(operand, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                    Expr.Field(object, field, field_line):
                        table <- cb_expr(object, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- cb_expr(object, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                        table <- cb_expr(index_argument, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                    _:
                        pass

        def cb_stmt(statements: darray[Ast::Stmt], in_owner_scope: bool, function_has_region: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, unclonable: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cb_expr(expression, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cb_expr(value, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cb_expr(value, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- cb_expr(returned, in_owner_scope, function_has_region, true, param_names, param_types, unclonable, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cb_expr(condition, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                            table <- cb_stmt(then_body, in_owner_scope, function_has_region, param_names, param_types, unclonable, table)
                            table <- cb_stmt(else_body, in_owner_scope, function_has_region, param_names, param_types, unclonable, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cb_expr(condition, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                            table <- cb_stmt(while_body, in_owner_scope, function_has_region, param_names, param_types, unclonable, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cb_expr(iterable, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                            table <- cb_stmt(for_body, in_owner_scope, function_has_region, param_names, param_types, unclonable, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            nested_owner: bool = in_owner_scope or kind == "in"
                            table <- cb_stmt(body, nested_owner, function_has_region, param_names, param_types, unclonable, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- cb_expr(scrutinee, in_owner_scope, function_has_region, false, param_names, param_types, unclonable, table)
                            for arm in arms |table| -> table:
                                table <- cb_stmt(arm.body, in_owner_scope, function_has_region, param_names, param_types, unclonable, table)
                        _:
                            pass

        def cb_check_declarations(declarations: darray[Ast::Decl], region_lines: darray[u32]&, unclonable: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            param_names: mutable darray[sview] = []
                            param_types: mutable darray[Ast::Expr] = []
                            for parameter in parameters |param_names, param_types|:
                                param_names.push(parameter.name)
                                param_types.push(parameter.type_expression)
                            # A function with a `@r` region annotation (on a param/return, recorded
                            # in local_region_annotations at its line) supplies the clone's owner, so
                            # the owner-required lint is suppressed for it.
                            function_has_region: bool = any region_line in region_lines where region_line == line.line
                            table <- cb_stmt(body, false, function_has_region, param_names, param_types, unclonable, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cb_check_declarations(module_body, region_lines, unclonable, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cb_check_declarations(scoped_body, region_lines, unclonable, table)
                        _:
                            pass

    public:
        def check_clone_builtin(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region_lines: mutable darray[u32] = []
                for annotation in file.local_region_annotations |region_lines|:
                    region_lines.push(annotation.line)
                unclonable: darray[sview] = cb_unclonable_structs(file.top_decls)
                table <- cb_check_declarations(file.top_decls, region_lines, unclonable, table)
