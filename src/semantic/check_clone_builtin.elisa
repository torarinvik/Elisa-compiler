# The `clone[T](x)` builtin (v1 restrictions). `clone` deep-copies a value into a
# region-owned buffer. Two type-argument errors are diagnosable without inferring the
# source expression's type:
#
#   clone[i64&](value)                # error: clone cannot clone a reference
#   return clone[darray[u32]](items)  # error: a container clone needs an `in <owner>:` scope
#
# `clone[T](x)` parses as `Call(Index(Ident "clone", T), [x])`. An `in owner:` scope is a
# `Stmt.Block("in", ...)`. Container heads (darray/dstr/dict/set) own heap storage and so
# require an active owner scope; a reference type argument is never clonable.
extend Semantic:
    private:
        # v1 rejects cloning a reference type unconditionally. (The container-needs-owner-scope
        # rule is deliberately NOT ported here: it is context-sensitive — a `@r` region
        # annotation or a region parameter supplies the owner without an explicit `in <owner>:`
        # scope, which stage0 accepts, so a purely syntactic scope check over-fires.)
        # The declared type of a bare-ident source argument, if it names a parameter; else
        # Absent. Used to spot a `sview` source cloned into a wider-element container.
        def cb_source_param_type(argument: Ast::Expr, param_names: darray[sview]&, param_types: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                name: sview = ident_name_of(argument)
                (Ast::Expr.Absent) return if name == ""
                probe: mutable usize = 0
                while probe < param_names.count |probe, name, param_names, param_types|:
                    param_types[probe] return if param_names[probe] == name
                    probe <- probe + 1
                return (Ast::Expr.Absent)

        def cb_apply(type_argument: Ast::Expr, first_argument: Ast::Expr, call_line: u32, in_owner_scope: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if type_argument is Expr.Unary(operator, inner, unary_line):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneRefRejected, name: "", line: call_line, expected: "", actual: ident_name_of(inner)}) if operator == TokenKind.Ampersand
                # `clone[darray[T]](src)` where src is a `sview` param and T is not `u8`: v1
                # cannot widen a byte view into a T-element container.
                if type_argument is Expr.Index(container_head, element_type, container_line):
                    element_name: sview = ident_name_of(element_type)
                    source_type: Ast::Expr = cb_source_param_type(first_argument, param_names, param_types)
                    source_is_sview: bool = bare_type_name_through_ref(source_type) == "sview"
                    mismatch: bool = ident_name_of(container_head) == "darray" and element_name != "" and element_name != "u8" and source_is_sview
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneElemMismatch, name: "", line: call_line, expected: "", actual: element_name}) if mismatch

        def cb_check_clone(callee: Ast::Expr, arguments: darray[Ast::Expr], call_line: u32, in_owner_scope: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                first_argument: Ast::Expr = arguments[0] if arguments.count > 0 else (Ast::Expr.Absent)
                if callee is Expr.Index(head, type_argument, index_line):
                    table <- cb_apply(type_argument, first_argument, call_line, in_owner_scope, param_names, param_types, table) if ident_name_of(head) == "clone"
                if callee is Expr.IndexN(head_n, type_arguments, index_n_line):
                    table <- cb_apply(type_arguments[0], first_argument, call_line, in_owner_scope, param_names, param_types, table) if ident_name_of(head_n) == "clone" and type_arguments.count > 0

        def cb_expr(expression: Ast::Expr, in_owner_scope: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- cb_check_clone(callee, arguments, call_line, in_owner_scope, param_names, param_types, table)
                        for argument in arguments |table| -> table:
                            table <- cb_expr(argument, in_owner_scope, param_names, param_types, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cb_expr(left, in_owner_scope, param_names, param_types, table)
                        table <- cb_expr(right, in_owner_scope, param_names, param_types, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- cb_expr(operand, in_owner_scope, param_names, param_types, table)
                    Expr.Paren(inner, paren_line):
                        table <- cb_expr(inner, in_owner_scope, param_names, param_types, table)
                    Expr.Move(operand, move_line):
                        table <- cb_expr(operand, in_owner_scope, param_names, param_types, table)
                    Expr.Field(object, field, field_line):
                        table <- cb_expr(object, in_owner_scope, param_names, param_types, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- cb_expr(object, in_owner_scope, param_names, param_types, table)
                        table <- cb_expr(index_argument, in_owner_scope, param_names, param_types, table)
                    _:
                        pass

        def cb_stmt(statements: darray[Ast::Stmt], in_owner_scope: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cb_expr(expression, in_owner_scope, param_names, param_types, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cb_expr(value, in_owner_scope, param_names, param_types, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cb_expr(value, in_owner_scope, param_names, param_types, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- cb_expr(returned, in_owner_scope, param_names, param_types, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cb_expr(condition, in_owner_scope, param_names, param_types, table)
                            table <- cb_stmt(then_body, in_owner_scope, param_names, param_types, table)
                            table <- cb_stmt(else_body, in_owner_scope, param_names, param_types, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cb_expr(condition, in_owner_scope, param_names, param_types, table)
                            table <- cb_stmt(while_body, in_owner_scope, param_names, param_types, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cb_expr(iterable, in_owner_scope, param_names, param_types, table)
                            table <- cb_stmt(for_body, in_owner_scope, param_names, param_types, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            nested_owner: bool = in_owner_scope or kind == "in"
                            table <- cb_stmt(body, nested_owner, param_names, param_types, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- cb_expr(scrutinee, in_owner_scope, param_names, param_types, table)
                            for arm in arms |table| -> table:
                                table <- cb_stmt(arm.body, in_owner_scope, param_names, param_types, table)
                        _:
                            pass

        def cb_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            param_names: mutable darray[sview] = []
                            param_types: mutable darray[Ast::Expr] = []
                            for parameter in parameters |param_names, param_types|:
                                param_names.push(parameter.name)
                                param_types.push(parameter.type_expression)
                            table <- cb_stmt(body, false, param_names, param_types, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cb_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cb_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_clone_builtin(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cb_check_declarations(file.top_decls, table)
