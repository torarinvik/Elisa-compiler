# The `clone[T](x)` builtin (v1 restrictions). `clone` deep-copies a value into a
# region-owned buffer. Two type-argument errors are diagnosable without inferring the
# source expression's type:
#
#   clone[i64&](value)                # error: clone cannot clone a reference
#   return clone[darray[u32]](items)  # error: a container clone needs an `in <owner>:` scope
#
# `clone[T](x)` parses as `Call(Index(Ident "clone", T), [x])`. An `in owner:` scope is a
# `Stmt.Block("in", ...)`. Container heads (darray/dstr/dict/set) own heap storage and so
# require an active owner scope; a reference type argument is never clonable.
extend Semantic:
    private:
        # v1 rejects cloning a reference type unconditionally. (The container-needs-owner-scope
        # rule is deliberately NOT ported here: it is context-sensitive — a `@r` region
        # annotation or a region parameter supplies the owner without an explicit `in <owner>:`
        # scope, which stage0 accepts, so a purely syntactic scope check over-fires.)
        # Peel `Paren`/`Move` wrappers so `clone[...](move src)` and `clone[...]((src))` are
        # recognised the same as a bare `clone[...](src)` — `ident_name_of` itself only
        # matches a bare `Expr.Ident` (by design, for its OTHER callers), so this file's own
        # source-argument matching must unwrap first. Confirmed against stage0: `move src`
        # gets the SAME "clone cannot clone sview into darray[u32]" rejection as bare `src`.
        def cb_unwrap_source(argument: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match argument:
                    Expr.Paren(inner, paren_line):
                        return cb_unwrap_source(inner)
                    Expr.Move(operand, move_line):
                        return cb_unwrap_source(operand)
                    _:
                        return argument

        # The declared type of a bare-ident (or `move`/paren-wrapped) source argument, if it
        # names a parameter; else Absent. Used to spot a `sview` source cloned into a wider-
        # element container.
        def cb_source_param_type(argument: Ast::Expr, param_names: darray[sview]&, param_types: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                name: sview = ident_name_of(cb_unwrap_source(argument))
                (Ast::Expr.Absent) return if name == ""
                probe: mutable usize = 0
                while probe < param_names.count |probe, name, param_names, param_types|:
                    param_types[probe] return if param_names[probe] == name
                    probe <- probe + 1
                return (Ast::Expr.Absent)

        def cb_apply(type_argument: Ast::Expr, first_argument: Ast::Expr, call_line: u32, in_owner_scope: bool, function_has_region: bool, is_return: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if type_argument is Expr.Unary(operator, inner, unary_line):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneRefRejected, name: "", line: call_line, expected: "", actual: ident_name_of(inner)}) if operator == TokenKind.Ampersand
                # `clone[darray[T]](src)` where src is a `sview` param and T is not `u8`: v1
                # cannot widen a byte view into a T-element container.
                if type_argument is Expr.Index(container_head, element_type, container_line):
                    element_name: sview = ident_name_of(element_type)
                    source_type: Ast::Expr = cb_source_param_type(first_argument, param_names, param_types)
                    source_is_sview: bool = bare_type_name_through_ref(source_type) == "sview"
                    mismatch: bool = ident_name_of(container_head) == "darray" and element_name != "" and element_name != "u8" and source_is_sview
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneElemMismatch, name: "", line: call_line, expected: "", actual: element_name}) if mismatch
                    # A container clone (`clone[darray[T]](x)`) that ESCAPES — its value is the
                    # function's direct `return` — owns heap storage that must outlive the call,
                    # so it needs an explicit `in <owner>:` scope. A NON-escaping clone (bound to a
                    # local) is auto-region-inferred, and a `@r`-annotated type argument is not a
                    # bare `Index` (so it never reaches here) — both correctly stay silent.
                    head_name: sview = ident_name_of(container_head)
                    is_container_head: bool = head_name == "darray" or head_name == "dstr" or head_name == "dict" or head_name == "set"
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneOwnerRequired, name: "", line: call_line, expected: element_name, actual: head_name}) if is_container_head and is_return and not in_owner_scope and not function_has_region

        def cb_check_clone(callee: Ast::Expr, arguments: darray[Ast::Expr], call_line: u32, in_owner_scope: bool, function_has_region: bool, is_return: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                first_argument: Ast::Expr = arguments[0] if arguments.count > 0 else (Ast::Expr.Absent)
                if callee is Expr.Index(head, type_argument, index_line):
                    table <- cb_apply(type_argument, first_argument, call_line, in_owner_scope, function_has_region, is_return, param_names, param_types, table) if ident_name_of(head) == "clone"
                if callee is Expr.IndexN(head_n, type_arguments, index_n_line):
                    table <- cb_apply(type_arguments[0], first_argument, call_line, in_owner_scope, function_has_region, is_return, param_names, param_types, table) if ident_name_of(head_n) == "clone" and type_arguments.count > 0

        def cb_expr(expression: Ast::Expr, in_owner_scope: bool, function_has_region: bool, is_return: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- cb_check_clone(callee, arguments, call_line, in_owner_scope, function_has_region, is_return, param_names, param_types, table)
                        for argument in arguments |table| -> table:
                            table <- cb_expr(argument, in_owner_scope, function_has_region, false, param_names, param_types, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cb_expr(left, in_owner_scope, function_has_region, false, param_names, param_types, table)
                        table <- cb_expr(right, in_owner_scope, function_has_region, false, param_names, param_types, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- cb_expr(operand, in_owner_scope, function_has_region, false, param_names, param_types, table)
                    Expr.Paren(inner, paren_line):
                        table <- cb_expr(inner, in_owner_scope, function_has_region, false, param_names, param_types, table)
                    Expr.Move(operand, move_line):
                        table <- cb_expr(operand, in_owner_scope, function_has_region, false, param_names, param_types, table)
                    Expr.Field(object, field, field_line):
                        table <- cb_expr(object, in_owner_scope, function_has_region, false, param_names, param_types, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- cb_expr(object, in_owner_scope, function_has_region, false, param_names, param_types, table)
                        table <- cb_expr(index_argument, in_owner_scope, function_has_region, false, param_names, param_types, table)
                    _:
                        pass

        def cb_stmt(statements: darray[Ast::Stmt], in_owner_scope: bool, function_has_region: bool, param_names: darray[sview]&, param_types: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cb_expr(expression, in_owner_scope, function_has_region, false, param_names, param_types, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cb_expr(value, in_owner_scope, function_has_region, false, param_names, param_types, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cb_expr(value, in_owner_scope, function_has_region, false, param_names, param_types, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- cb_expr(returned, in_owner_scope, function_has_region, true, param_names, param_types, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cb_expr(condition, in_owner_scope, function_has_region, false, param_names, param_types, table)
                            table <- cb_stmt(then_body, in_owner_scope, function_has_region, param_names, param_types, table)
                            table <- cb_stmt(else_body, in_owner_scope, function_has_region, param_names, param_types, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cb_expr(condition, in_owner_scope, function_has_region, false, param_names, param_types, table)
                            table <- cb_stmt(while_body, in_owner_scope, function_has_region, param_names, param_types, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cb_expr(iterable, in_owner_scope, function_has_region, false, param_names, param_types, table)
                            table <- cb_stmt(for_body, in_owner_scope, function_has_region, param_names, param_types, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            nested_owner: bool = in_owner_scope or kind == "in"
                            table <- cb_stmt(body, nested_owner, function_has_region, param_names, param_types, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- cb_expr(scrutinee, in_owner_scope, function_has_region, false, param_names, param_types, table)
                            for arm in arms |table| -> table:
                                table <- cb_stmt(arm.body, in_owner_scope, function_has_region, param_names, param_types, table)
                        _:
                            pass

        def cb_check_declarations(declarations: darray[Ast::Decl], region_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            param_names: mutable darray[sview] = []
                            param_types: mutable darray[Ast::Expr] = []
                            for parameter in parameters |param_names, param_types|:
                                param_names.push(parameter.name)
                                param_types.push(parameter.type_expression)
                            # A function with a `@r` region annotation (on a param/return, recorded
                            # in local_region_annotations at its line) supplies the clone's owner, so
                            # the owner-required lint is suppressed for it.
                            function_has_region: bool = any region_line in region_lines where region_line == line
                            table <- cb_stmt(body, false, function_has_region, param_names, param_types, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cb_check_declarations(module_body, region_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cb_check_declarations(scoped_body, region_lines, table)
                        _:
                            pass

    public:
        def check_clone_builtin(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region_lines: mutable darray[u32] = []
                for annotation in file.local_region_annotations |region_lines|:
                    region_lines.push(annotation.line)
                table <- cb_check_declarations(file.top_decls, region_lines, table)
