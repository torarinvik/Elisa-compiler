# The `clone[T](x)` builtin (v1 restrictions). `clone` deep-copies a value into a
# region-owned buffer. Two type-argument errors are diagnosable without inferring the
# source expression's type:
#
#   clone[i64&](value)                # error: clone cannot clone a reference
#   return clone[darray[u32]](items)  # error: a container clone needs an `in <owner>:` scope
#
# `clone[T](x)` parses as `Call(Index(Ident "clone", T), [x])`. An `in owner:` scope is a
# `Stmt.Block("in", ...)`. Container heads (darray/dstr/dict/set) own heap storage and so
# require an active owner scope; a reference type argument is never clonable.
extend Semantic:
    private:
        # v1 rejects cloning a reference type unconditionally. (The container-needs-owner-scope
        # rule is deliberately NOT ported here: it is context-sensitive — a `@r` region
        # annotation or a region parameter supplies the owner without an explicit `in <owner>:`
        # scope, which stage0 accepts, so a purely syntactic scope check over-fires.)
        def cb_apply(type_argument: Ast::Expr, call_line: u32, in_owner_scope: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if type_argument is Expr.Unary(operator, inner, unary_line):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CloneRefRejected, name: "", line: call_line, expected: "", actual: ident_name_of(inner)}) if operator == TokenKind.Ampersand

        def cb_check_clone(callee: Ast::Expr, call_line: u32, in_owner_scope: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if callee is Expr.Index(head, type_argument, index_line):
                    table <- cb_apply(type_argument, call_line, in_owner_scope, table) if ident_name_of(head) == "clone"
                if callee is Expr.IndexN(head_n, type_arguments, index_n_line):
                    table <- cb_apply(type_arguments[0], call_line, in_owner_scope, table) if ident_name_of(head_n) == "clone" and type_arguments.count > 0

        def cb_expr(expression: Ast::Expr, in_owner_scope: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- cb_check_clone(callee, call_line, in_owner_scope, table)
                        for argument in arguments |table| -> table:
                            table <- cb_expr(argument, in_owner_scope, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cb_expr(left, in_owner_scope, table)
                        table <- cb_expr(right, in_owner_scope, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- cb_expr(operand, in_owner_scope, table)
                    Expr.Paren(inner, paren_line):
                        table <- cb_expr(inner, in_owner_scope, table)
                    Expr.Move(operand, move_line):
                        table <- cb_expr(operand, in_owner_scope, table)
                    Expr.Field(object, field, field_line):
                        table <- cb_expr(object, in_owner_scope, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- cb_expr(object, in_owner_scope, table)
                        table <- cb_expr(index_argument, in_owner_scope, table)
                    _:
                        pass

        def cb_stmt(statements: darray[Ast::Stmt], in_owner_scope: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cb_expr(expression, in_owner_scope, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cb_expr(value, in_owner_scope, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cb_expr(value, in_owner_scope, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- cb_expr(returned, in_owner_scope, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cb_expr(condition, in_owner_scope, table)
                            table <- cb_stmt(then_body, in_owner_scope, table)
                            table <- cb_stmt(else_body, in_owner_scope, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- cb_expr(condition, in_owner_scope, table)
                            table <- cb_stmt(while_body, in_owner_scope, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- cb_expr(iterable, in_owner_scope, table)
                            table <- cb_stmt(for_body, in_owner_scope, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            nested_owner: bool = in_owner_scope or kind == "in"
                            table <- cb_stmt(body, nested_owner, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- cb_expr(scrutinee, in_owner_scope, table)
                            for arm in arms |table| -> table:
                                table <- cb_stmt(arm.body, in_owner_scope, table)
                        _:
                            pass

        def cb_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- cb_stmt(body, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cb_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cb_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_clone_builtin(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cb_check_declarations(file.top_decls, table)
