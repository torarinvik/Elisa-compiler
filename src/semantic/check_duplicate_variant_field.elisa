# Duplicate variant field detection: the same non-empty field name appears
# more than once in the same enum variant's payload field list.
#
# Each variant has an independent field namespace — a field name repeated in
# two DIFFERENT variants of the same enum is NOT a duplicate. Only duplicate
# names within a SINGLE variant's field list are flagged.

extend Semantic:
    private:
        # Scan a single variant's field_names for duplicate non-empty field names.
        # `field_names[i] == ""` means positional/unnamed, which is never compared
        # for duplicates.
        def check_variant_field_duplicates(variant: Ast::EnumVariant&, enum_name: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Running list of field names already seen in this variant
                seen_fields: mutable darray[sview] = []
                while field_index < variant.field_names.count |field_index: usize = 0|:
                    current_field_name: sview = variant.field_names[field_index]
                    # Only check non-empty field names (empty means positional)
                    if current_field_name != "":
                        # Check if this field was already seen in this variant
                        is_duplicate: mutable bool = false
                        while seen_index < seen_fields.count |seen_index: usize = 0|:
                            is_duplicate <- true if seen_fields[seen_index] == current_field_name
                            seen_index <- seen_index + 1
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateVariantField, name: current_field_name, line: line, expected: variant.name, actual: enum_name}) if is_duplicate
                        seen_fields <- seen_fields.push(current_field_name) if not is_duplicate
                    field_index <- field_index + 1


        # Scan all declarations for Decl.Enum and check each variant's field names.
        def check_duplicate_variant_fields(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Enum(enum_name, variants, enum_is_const, enum_storage, line):
                            # Check each variant in this enum for duplicate field names
                            for variant in variants |table|:
                                table <- check_variant_field_duplicates(variant, enum_name, line, table)
                        Decl.Module(module_name, body, line):
                            # Recurse into module body
                            table <- check_duplicate_variant_fields(body, table)
                        Decl.Scoped(body, line):
                            # Recurse into scoped body
                            table <- check_duplicate_variant_fields(body, table)
                        # Other declarations don't contain enums
                        _:
                            pass


    public:
        # Entry point: scan top-level declarations for duplicate variant field names
        def check_duplicate_variant_field(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_duplicate_variant_fields(declarations, table)
