# A bounded resolver for local reference aliases used by iterator invalidation checks.
module SemanticIteratorAliasResolution:
    public:
        ghost def direct_target_index_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, index: usize) -> usize:
            requires index <= alias_names.count
            decreases alias_names.count - index
            ensure result < alias_names.count implies result < alias_targets.count
            return alias_names.count if index == alias_names.count
            return index if index < alias_names.count and index < alias_targets.count and alias_names[index] == name
            return direct_target_index_from(alias_names, alias_targets, name, index + 1)

        ghost def direct_target_found_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, index: usize) -> bool:
            requires index <= alias_names.count
            return direct_target_index_from(alias_names, alias_targets, name, index) < alias_names.count

        ghost def direct_target_value_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, index: usize) -> sview:
            requires index <= alias_names.count
            return alias_targets[direct_target_index_from(alias_names, alias_targets, name, index)] if direct_target_index_from(alias_names, alias_targets, name, index) < alias_names.count and direct_target_index_from(alias_names, alias_targets, name, index) < alias_targets.count else ""

        ghost def ambiguous_from(alias_names: darray[sview]&, name: sview, index: usize, seen: bool) -> bool:
            requires index <= alias_names.count
            decreases alias_names.count - index
            ensure (index < alias_names.count and not (alias_names[index] == name and seen)) implies result == ambiguous_from(alias_names, name, index + 1, seen or (index < alias_names.count and alias_names[index] == name))
            return false if index == alias_names.count
            return true if index < alias_names.count and alias_names[index] == name and seen
            return ambiguous_from(alias_names, name, index + 1, seen or (index < alias_names.count and alias_names[index] == name))

        ghost def resolve_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, remaining: usize) -> sview:
            requires remaining <= alias_names.count
            decreases remaining
            ensure ambiguous_from(alias_names, name, 0, false) implies result == ""
            ensure (not ambiguous_from(alias_names, name, 0, false) and direct_target_index_from(alias_names, alias_targets, name, 0) >= alias_names.count) implies result == name
            ensure (not ambiguous_from(alias_names, name, 0, false) and direct_target_index_from(alias_names, alias_targets, name, 0) < alias_names.count and direct_target_value_from(alias_names, alias_targets, name, 0) == name) implies result == ""
            ensure (not ambiguous_from(alias_names, name, 0, false) and direct_target_index_from(alias_names, alias_targets, name, 0) < alias_names.count and direct_target_value_from(alias_names, alias_targets, name, 0) != name and remaining == 0) implies result == ""
            ensure (not ambiguous_from(alias_names, name, 0, false) and direct_target_index_from(alias_names, alias_targets, name, 0) < alias_names.count and direct_target_value_from(alias_names, alias_targets, name, 0) != name and remaining > 0) implies result == resolve_from(alias_names, alias_targets, direct_target_value_from(alias_names, alias_targets, name, 0), remaining - 1)
            return "" if ambiguous_from(alias_names, name, 0, false)
            return name if direct_target_index_from(alias_names, alias_targets, name, 0) >= alias_names.count
            return "" if alias_targets[direct_target_index_from(alias_names, alias_targets, name, 0)] == name
            return "" if remaining == 0
            return resolve_from(alias_names, alias_targets, alias_targets[direct_target_index_from(alias_names, alias_targets, name, 0)], remaining - 1)

    private:
        # These executable helpers follow the same recursion as the ghost specs,
        # so each step can use the recursive call's postcondition as a cutpoint.
        def direct_target_index(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, index: usize) -> usize:
            requires index <= alias_names.count
            decreases alias_names.count - index
            ensure result == direct_target_index_from(alias_names, alias_targets, name, index)
            ensure result < alias_names.count implies result < alias_targets.count
            if index == alias_names.count:
                assert direct_target_index_from(alias_names, alias_targets, name, index) == alias_names.count
                return alias_names.count
            if index < alias_names.count and index < alias_targets.count and alias_names[index] == name:
                assert direct_target_index_from(alias_names, alias_targets, name, index) == index
                return index
            assert direct_target_index_from(alias_names, alias_targets, name, index + 1) == direct_target_index_from(alias_names, alias_targets, name, index)
            next_index: usize = direct_target_index(alias_names, alias_targets, name, index + 1)
            assert next_index == direct_target_index_from(alias_names, alias_targets, name, index + 1)
            assert next_index == direct_target_index_from(alias_names, alias_targets, name, index)
            return next_index

        def ambiguous_from_runtime(alias_names: darray[sview]&, name: sview, index: usize, seen: bool) -> bool:
            requires index <= alias_names.count
            decreases alias_names.count - index
            ensure result == ambiguous_from(alias_names, name, index, seen)
            return false if index == alias_names.count
            if index < alias_names.count and alias_names[index] == name and seen:
                assert ambiguous_from(alias_names, name, index, seen)
                return true
            next_seen: bool = seen or (index < alias_names.count and alias_names[index] == name)
            assert ambiguous_from(alias_names, name, index, seen) == ambiguous_from(alias_names, name, index + 1, next_seen)
            next_ambiguous: bool = ambiguous_from_runtime(alias_names, name, index + 1, next_seen)
            assert next_ambiguous == ambiguous_from(alias_names, name, index + 1, next_seen)
            return next_ambiguous

    public:
        def direct_target_found(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview) -> bool:
            target_index: usize = direct_target_index(alias_names, alias_targets, name, 0)
            return target_index < alias_names.count

        def ambiguous(alias_names: darray[sview]&, name: sview) -> bool:
            ensure result == ambiguous_from(alias_names, name, 0, false)
            resolved: bool = ambiguous_from_runtime(alias_names, name, 0, false)
            assert resolved == ambiguous_from(alias_names, name, 0, false)
            return resolved

    private:
        def resolve_runtime_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, remaining: usize) -> sview:
            requires remaining <= alias_names.count
            decreases remaining
            ensure result == resolve_from(alias_names, alias_targets, name, remaining)
            if ambiguous(alias_names, name):
                assert "" == resolve_from(alias_names, alias_targets, name, remaining)
                return ""
            target_index: usize = direct_target_index(alias_names, alias_targets, name, 0)
            assert target_index == direct_target_index_from(alias_names, alias_targets, name, 0)
            if target_index >= alias_names.count:
                assert name == resolve_from(alias_names, alias_targets, name, remaining)
                return name
            assert target_index < alias_targets.count
            target_value: sview = alias_targets[target_index]
            if target_value == name:
                assert "" == resolve_from(alias_names, alias_targets, name, remaining)
                return ""
            if remaining == 0:
                assert "" == resolve_from(alias_names, alias_targets, name, remaining)
                return ""
            assert resolve_from(alias_names, alias_targets, name, remaining) == resolve_from(alias_names, alias_targets, target_value, remaining - 1)
            next_resolved: sview = resolve_runtime_from(alias_names, alias_targets, target_value, remaining - 1)
            assert next_resolved == resolve_from(alias_names, alias_targets, target_value, remaining - 1)
            assert next_resolved == resolve_from(alias_names, alias_targets, name, remaining)
            return next_resolved

    public:
        def resolve(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview) -> sview:
            ensure result == resolve_from(alias_names, alias_targets, name, alias_names.count)
            return resolve_runtime_from(alias_names, alias_targets, name, alias_names.count)

        # An empty result means the bounded walk found an unresolved cycle, so callers that
        # protect a live iterator must conservatively treat it as possibly naming any source.
        def may_name(resolved: sview, source: sview) -> bool:
            ensure result == (resolved == "" or resolved == source)
            return resolved == "" or resolved == source
