# A bounded resolver for local reference aliases used by iterator invalidation checks.
module SemanticIteratorAliasResolution:
    public:
        ghost def direct_target_found_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, index: usize) -> bool:
            requires index <= alias_names.count
            decreases alias_names.count - index
            ensure index == alias_names.count implies result == false
            ensure (index < alias_names.count and index < alias_targets.count and alias_names[index] == name) implies result == true
            ensure (index < alias_names.count and (index >= alias_targets.count or alias_names[index] != name)) implies result == direct_target_found_from(alias_names, alias_targets, name, index + 1.usize())
            return false if index == alias_names.count
            return true if index < alias_targets.count and alias_names[index] == name
            return direct_target_found_from(alias_names, alias_targets, name, index + 1)

        ghost def direct_target_value_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, index: usize) -> sview:
            requires index <= alias_names.count
            decreases alias_names.count - index
            ensure index == alias_names.count implies result == ""
            ensure (index < alias_names.count and index < alias_targets.count and alias_names[index] == name) implies result == alias_targets[index]
            ensure (index < alias_names.count and (index >= alias_targets.count or alias_names[index] != name)) implies result == direct_target_value_from(alias_names, alias_targets, name, index + 1.usize())
            return "" if index == alias_names.count
            return alias_targets[index] if index < alias_targets.count and alias_names[index] == name
            return direct_target_value_from(alias_names, alias_targets, name, index + 1)

        struct DirectAliasTarget:
            found: bool
            target: sview

        def direct_target(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview) -> DirectAliasTarget:
            ensure result.found == direct_target_found_from(alias_names, alias_targets, name, 0)
            ensure result.target == direct_target_value_from(alias_names, alias_targets, name, 0)
            for index in 0..<alias_names.count |index|:
                invariant index <= alias_names.count
                invariant direct_target_found_from(alias_names, alias_targets, name, index) == direct_target_found_from(alias_names, alias_targets, name, 0)
                invariant direct_target_value_from(alias_names, alias_targets, name, index) == direct_target_value_from(alias_names, alias_targets, name, 0)
                if index < alias_targets.count and alias_names[index] == name:
                    assert direct_target_found_from(alias_names, alias_targets, name, index) == true
                    assert direct_target_value_from(alias_names, alias_targets, name, index) == alias_targets[index]
                    assert direct_target_found_from(alias_names, alias_targets, name, 0) == true
                    assert direct_target_value_from(alias_names, alias_targets, name, 0) == alias_targets[index]
                    return DirectAliasTarget{found: true, target: alias_targets[index]}
                assert direct_target_found_from(alias_names, alias_targets, name, index) == direct_target_found_from(alias_names, alias_targets, name, index + 1.usize())
                assert direct_target_value_from(alias_names, alias_targets, name, index) == direct_target_value_from(alias_names, alias_targets, name, index + 1.usize())
            assert direct_target_found_from(alias_names, alias_targets, name, alias_names.count) == false
            assert direct_target_value_from(alias_names, alias_targets, name, alias_names.count) == ""
            assert direct_target_found_from(alias_names, alias_targets, name, 0) == false
            assert direct_target_value_from(alias_names, alias_targets, name, 0) == ""
            return DirectAliasTarget{found: false, target: sview("", 0, 0)}

        ghost def ambiguous_from(alias_names: darray[sview]&, name: sview, index: usize, seen: bool) -> bool:
            requires index <= alias_names.count
            decreases alias_names.count - index
            ensure index == alias_names.count implies result == false
            ensure (index < alias_names.count and alias_names[index] == name and seen) implies result == true
            ensure (index < alias_names.count and (alias_names[index] != name or not seen)) implies result == ambiguous_from(alias_names, name, index + 1.usize(), seen or alias_names[index] == name)
            return false if index == alias_names.count
            return true if alias_names[index] == name and seen
            next_seen: bool = seen or alias_names[index] == name
            return ambiguous_from(alias_names, name, index + 1, next_seen)

        def ambiguous(alias_names: darray[sview]&, name: sview) -> bool:
            ensure result == ambiguous_from(alias_names, name, 0, false)
            found: mutable bool = false
            for index in 0..<alias_names.count |index, found|:
                invariant index <= alias_names.count
                invariant ambiguous_from(alias_names, name, index, found) == ambiguous_from(alias_names, name, 0, false)
                if alias_names[index] == name and found:
                    assert ambiguous_from(alias_names, name, index, found) == true
                    assert ambiguous_from(alias_names, name, 0, false) == true
                    return true
                next_found: bool = found or alias_names[index] == name
                assert ambiguous_from(alias_names, name, index, found) == ambiguous_from(alias_names, name, index + 1.usize(), next_found)
                found <- next_found
            assert ambiguous_from(alias_names, name, alias_names.count, found) == false
            assert ambiguous_from(alias_names, name, 0, false) == false
            return false

        ghost def resolve_from(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview, remaining: usize) -> sview:
            requires remaining <= alias_names.count
            decreases remaining
            ensure ambiguous_from(alias_names, name, 0, false) implies result == ""
            ensure (not ambiguous_from(alias_names, name, 0, false) and not direct_target_found_from(alias_names, alias_targets, name, 0)) implies result == name
            ensure (not ambiguous_from(alias_names, name, 0, false) and direct_target_found_from(alias_names, alias_targets, name, 0) and direct_target_value_from(alias_names, alias_targets, name, 0) == name) implies result == ""
            ensure (not ambiguous_from(alias_names, name, 0, false) and direct_target_found_from(alias_names, alias_targets, name, 0) and direct_target_value_from(alias_names, alias_targets, name, 0) != name and remaining == 0) implies result == ""
            ensure (not ambiguous_from(alias_names, name, 0, false) and direct_target_found_from(alias_names, alias_targets, name, 0) and direct_target_value_from(alias_names, alias_targets, name, 0) != name and remaining > 0) implies result == resolve_from(alias_names, alias_targets, direct_target_value_from(alias_names, alias_targets, name, 0), remaining - 1)
            ambiguous_name: bool = ambiguous_from(alias_names, name, 0, false)
            assert ambiguous_name == ambiguous_from(alias_names, name, 0, false)
            return "" if ambiguous_name
            found: bool = direct_target_found_from(alias_names, alias_targets, name, 0)
            assert found == direct_target_found_from(alias_names, alias_targets, name, 0)
            return name if not found
            target: sview = direct_target_value_from(alias_names, alias_targets, name, 0)
            assert target == direct_target_value_from(alias_names, alias_targets, name, 0)
            return "" if target == name
            return "" if remaining == 0
            return resolve_from(alias_names, alias_targets, target, remaining - 1)

        def resolve(alias_names: darray[sview]&, alias_targets: darray[sview]&, name: sview) -> sview:
            ensure result == resolve_from(alias_names, alias_targets, name, alias_names.count)
            current: mutable sview = name
            remaining: mutable usize = alias_names.count
            assert remaining <= alias_names.count
            while remaining > 0 |current, remaining, alias_names, alias_targets, name|:
                decreases remaining
                invariant remaining <= alias_names.count
                invariant resolve_from(alias_names, alias_targets, current, remaining) == resolve_from(alias_names, alias_targets, name, alias_names.count)
                if ambiguous(alias_names, current):
                    assert resolve_from(alias_names, alias_targets, current, remaining) == ""
                    return sview("", 0, 0)
                target: DirectAliasTarget = direct_target(alias_names, alias_targets, current)
                if not target.found:
                    assert resolve_from(alias_names, alias_targets, current, remaining) == current
                    return current
                if target.target == current:
                    assert resolve_from(alias_names, alias_targets, current, remaining) == ""
                    return sview("", 0, 0)
                assert remaining > 0
                assert resolve_from(alias_names, alias_targets, current, remaining) == resolve_from(alias_names, alias_targets, target.target, remaining - 1)
                current <- target.target
                remaining <- remaining - 1
                assert remaining <= alias_names.count
            if ambiguous(alias_names, current):
                assert resolve_from(alias_names, alias_targets, current, 0) == ""
                return sview("", 0, 0)
            target: DirectAliasTarget = direct_target(alias_names, alias_targets, current)
            if target.found:
                assert resolve_from(alias_names, alias_targets, current, 0) == ""
                return sview("", 0, 0)
            assert resolve_from(alias_names, alias_targets, current, 0) == current
            return current

        # An empty result means the bounded walk found an unresolved cycle, so callers that
        # protect a live iterator must conservatively treat it as possibly naming any source.
        def may_name(resolved: sview, source: sview) -> bool:
            ensure result == (resolved == "" or resolved == source)
            return resolved == "" or resolved == source
