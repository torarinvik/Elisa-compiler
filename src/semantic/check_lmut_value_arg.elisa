# Passing a value literal to an `lmut` parameter. An `lmut T` parameter lowers to a mutable
# reference — it must be given a PLACE (a mutable local/field), never a temporary. Passing a struct
# LITERAL `f(Counter{...})` to such a parameter is rejected ("argument N to f expects mutable T&,
# got T"). SOUND subset: an argument with no mutable place at a parameter position the callee declared
# `lmut` (tracked in lmut_param_owner/pos) — either a construction literal, or an ident naming a
# by-value binding (a param/local whose type is a bare struct Ident: no `mutable`/`&`, non-primitive).
# Such bindings are immutable values, never mutable places.
extend Semantic:
    private:
        # Parameter rows are keyed only by bare function name. A full-program build can
        # legitimately contain the same member name in several modules, so positional
        # facts are sound only when that bare name resolves to one Func declaration.
        def lvarg_signature_is_unique(table: SymbolTable&, callee: sview) -> bool:
            can Abort.Panic:
                return direct_function_count(table, callee) == 1

        # Whether callee's positional parameter at `position` is a `mutable T&` borrow (from the
        # function_param registry). Like an lmut parameter, it needs a mutable PLACE — a value or
        # a temporary is rejected the same way.
        def mutable_ref_position_of(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                false return if not lvarg_signature_is_unique(table, callee)
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per call argument — see the matching comment on
                # function_parameter_count in resolve_expr.elisa.
                seen: mutable u32 = 0
                result: mutable bool = false
                cur: mutable u32 = function_param_chain_head(table, callee)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == callee:
                        result <- table.function_param_mutable_ref[cur.usize()] if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return result

        def place_required_position(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                false return if not lvarg_signature_is_unique(table, callee)
                return lmut_threads_position(table, callee, position) or mutable_ref_position_of(table, callee, position)

        # The declared bare type of callee's positional parameter at `position`, else "".
        def value_param_type_at(table: SymbolTable&, callee: sview, position: u32) -> sview:
            can Abort.Panic:
                sview("", 0, 0) return if not lvarg_signature_is_unique(table, callee)
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per call argument — see the matching comment on
                # function_parameter_count in resolve_expr.elisa.
                seen: mutable u32 = 0
                result: mutable sview = sview("", 0, 0)
                cur: mutable u32 = function_param_chain_head(table, callee)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == callee:
                        result <- table.function_param_type[cur.usize()] if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return result

        # Whether a type annotation is a REFERENCE type — carries `&` or `lmut` (a borrow).
        # A plain `mutable T` (no `&`) is a mutable VALUE, NOT a reference, and must not be
        # treated as one (`mutable Handle` local passed by `move` to a value param is fine).
        def lvarg_type_is_ref(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        true return if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                        return lvarg_type_is_ref(operand)
                    Expr.Paren(inner, paren_line):
                        return lvarg_type_is_ref(inner)
                    _:
                        return false

        # Whether a type annotation carries `mutable` anywhere outside its base name. This is
        # the whole difference between stage0's `got T&` and its `got mutable T&`.
        def lvarg_type_has_mutable(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        true return if operator == TokenKind.Mutable
                        return lvarg_type_has_mutable(operand)
                    Expr.Paren(inner, paren_line):
                        return lvarg_type_has_mutable(inner)
                    _:
                        return false

        # Whether a type annotation is an `lmut` borrow, which stage0 spells `mutable T&`.
        def lvarg_type_is_lmut(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        true return if operator == TokenKind.Lmut
                        return lvarg_type_is_lmut(operand)
                    Expr.Paren(inner, paren_line):
                        return lvarg_type_is_lmut(inner)
                    _:
                        return false

        # How a binding is passed: 0 a plain value, 1 a plain `T&`, 2 an explicit
        # writable borrow (`mutable T&` or `lmut T`), and 3 a mutable aggregate local
        # whose initializer aliases an existing reference. Stage0 permits ordinary
        # mutable aggregate values to be copied by value; only the aliasing form is
        # represented as `mutable T&` at a by-value call boundary. The receiver map
        # carries this distinction instead of a bare bool.
        def lvarg_ref_kind(type_expression: Ast::Expr) -> u8:
            can Abort.Panic:
                2 return if lvarg_type_is_lmut(type_expression) or (lvarg_type_is_ref(type_expression) and lvarg_type_has_mutable(type_expression))
                1 return if lvarg_type_is_ref(type_expression)
                return 0

        # A mutable aggregate is address-backed for value-parameter assignability, but
        # `&value` is still its first valid borrow and must not be diagnosed as a
        # reference-to-reference. Only explicit reference annotations qualify here.
        def ref_arg_is_explicit(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_is_ref: darray[u8]&) -> bool:
            can Abort.Panic:
                name: sview = match argument:
                    Expr.Ident(ident_name, ident_line): ident_name
                    Expr.Move(operand, move_line): ident_name_of(operand)
                    Expr.Paren(inner, paren_line): ident_name_of(inner)
                    _: sview("", 0, 0)
                false return if name == ""
                index: mutable usize = 0
                found: mutable bool = false
                while index < receiver_names.count |found, index|:
                    found <- true if not found and receiver_names[index] == name and (receiver_is_ref[index] == 1 or receiver_is_ref[index] == 2)
                    index <- index + 1
                return found

        # The base struct type of a REFERENCE argument — an ident (or `move ident`) naming a
        # binding whose type is a reference (`&`/`lmut`, per `receiver_is_ref`) — else "". Such
        # a borrow cannot satisfy a BY-VALUE parameter: stage0 rejects `expects C, got mutable C&`.
        def ref_arg_base_type(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview]&, receiver_is_ref: darray[u8]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                name: sview = match argument:
                    Expr.Ident(ident_name, ident_line): ident_name
                    Expr.Move(operand, move_line): ident_name_of(operand)
                    Expr.Paren(inner, paren_line): ident_name_of(inner)
                    _: sview("", 0, 0)
                "" return if name == ""
                index: mutable usize = 0
                found: mutable sview = sview("", 0, 0)
                while index < receiver_names.count |found, index|:
                    found <- receiver_types[index] if found == "" and receiver_names[index] == name and receiver_is_ref[index] != 0
                    index <- index + 1
                return found

        # The borrow kind of the binding `ref_arg_base_type` matched — 1 for a plain `T&`, 2
        # for a writable one. Scanned the same way and in the same order, so the kind always
        # belongs to the binding whose type was reported.
        def ref_arg_ref_kind(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview]&, receiver_is_ref: darray[u8]&) -> u8:
            can Memory.Allocate, Abort.Panic:
                name: sview = match argument:
                    Expr.Ident(ident_name, ident_line): ident_name
                    Expr.Move(operand, move_line): ident_name_of(operand)
                    Expr.Paren(inner, paren_line): ident_name_of(inner)
                    _: sview("", 0, 0)
                0 return if name == ""
                index: mutable usize = 0
                found: mutable sview = sview("", 0, 0)
                kind: mutable u8 = 0
                while index < receiver_names.count |found, kind, index|:
                    kind <- receiver_is_ref[index] if found == "" and receiver_names[index] == name and receiver_is_ref[index] != 0
                    found <- receiver_types[index] if found == "" and receiver_names[index] == name and receiver_is_ref[index] != 0
                    index <- index + 1
                return kind

        # Whether a by-value parameter type is one a mutable aggregate borrow cannot inhabit.
        # Stage0 permits sview/dstr borrows through their special assignability rules.
        # cstr is a pointer value: cstr& is a reference to that pointer, not a cstr.
        def lvarg_value_param_is_place(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                true return if name == "cstr"
                false return if name == "sview" or name == "dstr"
                return is_registered_type(name, table)

        # Whether an argument explicitly takes the address of its operand. A reference binding
        # already denotes a borrow; applying `&` to it would manufacture T&&, which is not a
        # valid way to pass it to a T& parameter and used to reach codegen in stage1.
        def lvarg_has_explicit_ref(argument: Ast::Expr) -> bool:
            can Abort.Panic:
                match argument:
                    Expr.Unary(operator, operand, unary_line):
                        true return if operator == TokenKind.Ampersand
                        return lvarg_has_explicit_ref(operand)
                    Expr.Paren(inner, paren_line):
                        return lvarg_has_explicit_ref(inner)
                    _:
                        return false

        # The binding named by an explicitly borrowed argument (`&value`), but only when that
        # binding is already a reference. Keep this separate from `ref_arg_base_type`: the latter
        # intentionally inspects the argument's outer shape for the inverse ref-to-value check.
        def nested_ref_arg_base_type(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview]&, receiver_is_ref: darray[u8]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Unary(operator, operand, unary_line):
                        return ref_arg_base_type(operand, receiver_names, receiver_types, receiver_is_ref) if operator == TokenKind.Ampersand and ref_arg_is_explicit(operand, receiver_names, receiver_is_ref)
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return nested_ref_arg_base_type(inner, receiver_names, receiver_types, receiver_is_ref)
                    _:
                        return sview("", 0, 0)

        # Look up a struct FIELD's declared type name in the field registry — the bare type
        # (`bare_type_name`), so a value field `arena: S` yields "S" while a ref-typed field
        # yields "" and is never treated as a placeless value. A field declared `mutable`
        # ALSO yields "": a mutable field of a mutable place is itself a mutable place (a valid
        # borrow target), so only a NON-mutable value field is a placeless copy. This is the
        # distinction between `combine(p.a)` where `a: mutable C` (accepted) and `bump(h.arena)`
        # where `arena: ScratchArena` (rejected — needs `&h.arena`).
        def lvarg_field_type(table: SymbolTable&, struct_name: sview, field_name: sview) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                found: mutable sview = sview("", 0, 0)
                while index < table.struct_field_owner.count |found, index|:
                    found <- table.struct_field_type[index] if found == "" and table.struct_field_owner[index] == struct_name and table.struct_field_name[index] == field_name and not table.struct_field_mutable[index]
                    index <- index + 1
                return found

        # A receiver's base STRUCT type (peeling `mutable`/`&`/`lmut`), from the whole-function
        # receiver map — includes ref params (`h: mutable Holder&` -> "Holder"), which the
        # value-only map deliberately omits.
        def lvarg_receiver_type(name: sview, receiver_names: darray[sview]&, receiver_types: darray[sview]&) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                found: mutable sview = sview("", 0, 0)
                while index < receiver_names.count |found, index|:
                    found <- receiver_types[index] if found == "" and receiver_names[index] == name
                    index <- index + 1
                return found

        # The value-binding type of an argument at an lmut call position, else "": a struct
        # LITERAL (a temporary), an ident naming a by-value binding (bare struct type, not mutable/
        # ref) in `value_names`/`value_types`, or a FIELD access `recv.field` whose field is a
        # by-value struct — a copy, not a mutable place, so it needs an explicit `&recv.field`.
        def lmut_value_arg_type(argument: Ast::Expr, value_names: darray[sview]&, value_types: darray[sview]&, receiver_names: darray[sview]&, receiver_types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Construct(type_expression, fields, construct_line):
                        return ident_name_of(type_expression)
                    Expr.Ident(name, line):
                        binding_index: mutable usize = 0
                        found: mutable sview = sview("", 0, 0)
                        while binding_index < value_names.count |found|:
                            found <- value_types[binding_index] if value_names[binding_index] == name and found == ""
                            binding_index <- binding_index + 1
                        return found
                    Expr.Field(receiver, field_name, field_line):
                        receiver_name: sview = ident_name_of(receiver)
                        "" return if receiver_name == ""
                        receiver_type: sview = lvarg_receiver_type(receiver_name, receiver_names, receiver_types)
                        "" return if receiver_type == ""
                        field_type: sview = lvarg_field_type(table, receiver_type, field_name)
                        field_type return if field_type != "" and lvarg_needs_place_tracking(field_type)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def lmut_value_check_expression(expression: Ast::Expr, value_names: darray[sview]&, value_types: darray[sview]&, receiver_names: darray[sview]&, receiver_types: darray[sview]&, receiver_is_ref: darray[u8]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        if callee_name != "":
                            position: mutable u32 = 0
                            for argument in arguments |table, position| -> table:
                                argument_type: sview = lmut_value_arg_type(argument, value_names, value_types, receiver_names, receiver_types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutValueArg, name: callee_name, pos: Ast::expr_pos(argument), line: line.line, expected: argument_type, actual: "", expected_count: position + 1}) if argument_type != "" and place_required_position(table, callee_name, position)
                                # A reference binding is already a borrow. Reject an explicit
                                # second borrow before code generation, where stage1 previously
                                # lowered this invalid T&& shape and could crash in unrelated code.
                                nested_ref_base: sview = nested_ref_arg_base_type(argument, receiver_names, receiver_types, receiver_is_ref)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutValueArg, name: callee_name, pos: Ast::expr_pos(argument), line: line.line, expected: nested_ref_base, actual: "reference to a reference", expected_count: position + 1}) if nested_ref_base != "" and lvarg_has_explicit_ref(argument) and place_required_position(table, callee_name, position)
                                # Inverse mismatch: a REFERENCE binding passed to a BY-VALUE param of
                                # the same struct — a borrow cannot inhabit a value slot. Require a
                                # registered value struct (excludes generics) and matching bases, so
                                # this never collides with the place-required check above.
                                ref_base: sview = ref_arg_base_type(argument, receiver_names, receiver_types, receiver_is_ref)
                                value_param: sview = value_param_type_at(table, callee_name, position)
                                ref_to_value: bool = ref_base != "" and value_param == ref_base and lvarg_value_param_is_place(value_param, table) and not place_required_position(table, callee_name, position)
                                # stage0 spells a writable borrow `mutable T&` and a plain one `T&`.
                                # A Diagnostic may only carry source sviews, so the spelling lives in
                                # the kind rather than being concatenated into `actual`.
                                writable_borrow: bool = ref_arg_ref_kind(argument, receiver_names, receiver_types, receiver_is_ref) >= 2
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefArgValueParam, name: callee_name, pos: Ast::expr_pos(argument), line: line.line, expected: value_param, actual: ref_base, expected_count: position + 1}) if ref_to_value and writable_borrow
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PlainRefArgValueParam, name: callee_name, pos: Ast::expr_pos(argument), line: line.line, expected: value_param, actual: ref_base, expected_count: position + 1}) if ref_to_value and not writable_borrow
                                position <- position + 1
                        table <- lmut_value_check_expression(callee, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for argument in arguments |table| -> table:
                            table <- lmut_value_check_expression(argument, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        table <- lmut_value_check_expression(effect_type, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for argument in arguments |table| -> table:
                            table <- lmut_value_check_expression(argument, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Field(object, field, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Scope(base, name, line):
                        table <- lmut_value_check_expression(base, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Index(object, index, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(index, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Slice(object, low, high, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(low, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(high, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.IndexN(object, arguments, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for argument in arguments |table| -> table:
                            table <- lmut_value_check_expression(argument, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Binary(left, operator, right, line):
                        table <- lmut_value_check_expression(left, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(right, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Unary(operator, operand, line):
                        table <- lmut_value_check_expression(operand, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Move(operand, line):
                        table <- lmut_value_check_expression(operand, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.RegionNew(operand, region, line):
                        table <- lmut_value_check_expression(operand, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Paren(inner, line):
                        table <- lmut_value_check_expression(inner, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- lmut_value_check_expression(element, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- lmut_value_check_expression(entry.key, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_expression(entry.value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- lmut_value_check_expression(type_expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for field in fields |table| -> table:
                            table <- lmut_value_check_expression(field.value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- lmut_value_check_expression(base, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for field in fields |table| -> table:
                            table <- lmut_value_check_expression(field.value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.If(condition, then_expression, else_expression, line):
                        table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(then_expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(else_expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- lmut_value_check_expression(scrutinee, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for arm in arms |table| -> table:
                            table <- lmut_value_check_expression(arm.guard, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_statements(arm.body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        table <- lmut_value_check_expression(iterable, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Refinement(base, predicate, line):
                        table <- lmut_value_check_expression(base, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(predicate, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- lmut_value_check_expression(guarded, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_statements(recovery, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Lambda(parameters, body, line):
                        table <- lmut_value_check_statements(body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Block(statements, value, captures, line):
                        block_value_names: mutable darray[sview] = [name for name in value_names]
                        block_value_types: mutable darray[sview] = [type_name for type_name in value_types]
                        block_receiver_names: mutable darray[sview] = [name for name in receiver_names]
                        block_receiver_types: mutable darray[sview] = [type_name for type_name in receiver_types]
                        block_receiver_is_ref: mutable darray[u8] = [is_ref for is_ref in receiver_is_ref]
                        lmut_collect_value_locals(statements, &block_value_names, &block_value_types)
                        lvarg_collect_receivers(statements, &block_receiver_names, &block_receiver_types, &block_receiver_is_ref)
                        table <- lmut_value_check_statements(statements, block_value_names, block_value_types, block_receiver_names, block_receiver_types, block_receiver_is_ref, table)
                        table <- lmut_value_check_expression(value, block_value_names, block_value_types, block_receiver_names, block_receiver_types, block_receiver_is_ref, table)
                    _:
                        pass

        # A by-value binding's struct type name, else "": a bare-Ident type (no `mutable`/`&`/`?`
        # wrapper — those are places or optionals) whose name is not a primitive. Only such value
        # bindings are placeless and thus invalid at an lmut parameter position.
        def lmut_value_type_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return name if name != "" and lvarg_needs_place_tracking(name) else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def is_primitive_type_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "usize" | "isize" | "int" | "uint" | "f32" | "f64" | "bool" | "void" | "char" | "cstr" | "dstr" | "sview" -> true
                    _ -> false

        # `is_primitive_type_name` folds `sview`/`cstr`/`dstr` in with the true scalars — correct
        # for its OTHER callers (e.g. `.sview()`/`.cstr()` are real builtin conversion METHOD
        # names, so `check_field_access_type_param.elisa` needs them treated as "primitive-ish"
        # to stay silent). But `sview`/`cstr`/`dstr` are STRUCTS: stage0 requires a mutable place
        # for an `lmut sview`/`lmut cstr`/`lmut dstr` parameter exactly like any other struct
        # ("argument 1 to f expects mutable sview&, got sview" — confirmed against stage0 for all
        # three spellings). So THIS file's own place-tracking logic must NOT treat them as
        # primitive, even though the shared helper above (by design, for its other callers) does.
        def lvarg_needs_place_tracking(name: sview) -> bool:
            can Abort.Panic:
                return not is_primitive_type_name(name) or name == "sview" or name == "cstr" or name == "dstr"

        # Collect by-value local declarations (recursively) into the value-binding maps.
        def lmut_collect_value_locals(statements: darray[Ast::Stmt], value_names: mutable darray[sview]&, value_types: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |value_names, value_types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            local_type: sview = lmut_value_type_name(type_expression)
                            if local_type != "":
                                value_names.push(name)
                                value_types.push(local_type)
                        Stmt.If(condition, then_body, else_body, line):
                            lmut_collect_value_locals(then_body, value_names, value_types)
                            lmut_collect_value_locals(else_body, value_names, value_types)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |value_names, value_types|:
                                lmut_collect_value_locals(arm.body, value_names, value_types)
                        Stmt.While(condition, while_body, line):
                            lmut_collect_value_locals(while_body, value_names, value_types)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            lmut_collect_value_locals(for_body, value_names, value_types)
                        Stmt.Block(kind, clause, binding, body, line):
                            lmut_collect_value_locals(body, value_names, value_types)
                        _:
                            pass

        def lmut_value_check_statements(statements: darray[Ast::Stmt], value_names: darray[sview]&, value_types: darray[sview]&, receiver_names: darray[sview]&, receiver_types: darray[sview]&, receiver_is_ref: darray[u8]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- lmut_value_check_expression(expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- lmut_value_check_expression(value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- lmut_value_check_expression(target, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_expression(value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- lmut_value_check_expression(returned, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_statements(then_body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_statements(else_body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.While(condition, while_body, line):
                            table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_statements(while_body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- lmut_value_check_expression(iterable, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_statements(for_body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- lmut_value_check_statements(body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- lmut_value_check_expression(scrutinee, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            for arm in arms |table| -> table:
                                table <- lmut_value_check_expression(arm.guard, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                                table <- lmut_value_check_statements(arm.body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Contract(kind, expression, line):
                            table <- lmut_value_check_expression(expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        _:
                            pass

        # The base STRUCT type of an annotation, peeling `mutable`/`&`/`lmut`/`stack`/`heap`
        # wrappers: `mutable Holder&` -> "Holder". Bare/primitive/non-struct annotations that
        # bare_type_name cannot reduce to a non-primitive name yield "". Used for the receiver
        # map so a field access through a ref receiver resolves its owning struct.
        def lvarg_base_struct_name(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        return name if name != "" and lvarg_needs_place_tracking(name) else sview("", 0, 0)
                    Expr.Unary(operator, operand, unary_line):
                        lvarg_base_struct_name(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return lvarg_base_struct_name(inner)
                    Expr.Index(indexed_object, index, index_line):
                        return lvarg_base_struct_name(indexed_object)
                    Expr.IndexN(indexed_object, arguments, index_n_line):
                        return lvarg_base_struct_name(indexed_object)
                    _:
                        return sview("", 0, 0)

        # Collect the base struct type of every local decl (recursively) into the receiver map,
        # tracking how each binding borrows (`lvarg_ref_kind`) in the parallel is_ref map.
        def lvarg_collect_receivers(statements: darray[Ast::Stmt], receiver_names: mutable darray[sview]&, receiver_types: mutable darray[sview]&, receiver_is_ref: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |receiver_names, receiver_types, receiver_is_ref|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            base_type: sview = lvarg_base_struct_name(type_expression)
                            if base_type != "":
                                receiver_names.push(name)
                                receiver_types.push(base_type)
                                kind: mutable u8 = lvarg_ref_kind(type_expression)
                                # A mutable value initialized directly from a reference
                                # binding remains an alias, even though its annotation
                                # has no `&`. This is the Stage0-invalid case; a fresh
                                # mutable value such as `Vec3 = zeroed` is an ordinary
                                # by-value aggregate and must remain accepted.
                                kind <- 3 if kind == 0 and lvarg_type_has_mutable(type_expression) and ref_arg_is_explicit(value, receiver_names, receiver_is_ref)
                                receiver_is_ref.push(kind)
                        Stmt.If(condition, then_body, else_body, line):
                            lvarg_collect_receivers(then_body, receiver_names, receiver_types, receiver_is_ref)
                            lvarg_collect_receivers(else_body, receiver_names, receiver_types, receiver_is_ref)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |receiver_names, receiver_types, receiver_is_ref|:
                                lvarg_collect_receivers(arm.body, receiver_names, receiver_types, receiver_is_ref)
                        Stmt.While(condition, while_body, line):
                            lvarg_collect_receivers(while_body, receiver_names, receiver_types, receiver_is_ref)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            lvarg_collect_receivers(for_body, receiver_names, receiver_types, receiver_is_ref)
                        Stmt.Block(kind, clause, binding, body, line):
                            lvarg_collect_receivers(body, receiver_names, receiver_types, receiver_is_ref)
                        _:
                            pass

        def check_lmut_value_arg_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            value_names: mutable darray[sview] = []
                            value_types: mutable darray[sview] = []
                            receiver_names: mutable darray[sview] = []
                            receiver_types: mutable darray[sview] = []
                            receiver_is_ref: mutable darray[u8] = []
                            for parameter in parameters |value_names, value_types, receiver_names, receiver_types, receiver_is_ref|:
                                parameter_type: sview = lmut_value_type_name(parameter.type_expression)
                                if parameter_type != "":
                                    value_names.push(parameter.name)
                                    value_types.push(parameter_type)
                                base_type: sview = lvarg_base_struct_name(parameter.type_expression)
                                if base_type != "":
                                    receiver_names.push(parameter.name)
                                    receiver_types.push(base_type)
                                    receiver_is_ref.push(lvarg_ref_kind(parameter.type_expression))
                            lmut_collect_value_locals(body, value_names, value_types)
                            lvarg_collect_receivers(body, receiver_names, receiver_types, receiver_is_ref)
                            table <- lmut_value_check_statements(body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_lmut_value_arg_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_lmut_value_arg_walk(scoped_body, table)
                        _:
                            pass

        def check_lmut_value_arg(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_lmut_value_arg_walk(file.top_decls, table)
