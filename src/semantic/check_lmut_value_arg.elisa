# Passing a value literal to an `lmut` parameter. An `lmut T` parameter lowers to a mutable
# reference — it must be given a PLACE (a mutable local/field), never a temporary. Passing a struct
# LITERAL `f(Counter{...})` to such a parameter is rejected ("argument N to f expects mutable T&,
# got T"). SOUND subset: an argument with no mutable place at a parameter position the callee declared
# `lmut` (tracked in lmut_param_owner/pos) — either a construction literal, or an ident naming a
# by-value binding (a param/local whose type is a bare struct Ident: no `mutable`/`&`, non-primitive).
# Such bindings are immutable values, never mutable places.
extend Semantic:
    private:
        # Parameter rows are keyed only by bare function name. A full-program build can
        # legitimately contain the same member name in several modules, so positional
        # facts are sound only when that bare name resolves to one Func declaration.
        def lvarg_signature_is_unique(table: SymbolTable&, callee: sview) -> bool:
            can Abort.Panic:
                return direct_function_count(table, callee) == 1

        # Whether callee's positional parameter at `position` is a `mutable T&` borrow (from the
        # function_param registry). Like an lmut parameter, it needs a mutable PLACE — a value or
        # a temporary is rejected the same way. The sole caller, place_required_position, has
        # already established that the bare callee name resolves to exactly one function.
        def mutable_ref_position_of(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per call argument — see the matching comment on
                # function_parameter_count in resolve_expr.elisa.
                seen: mutable u32 = 0
                cur: mutable u32 = function_param_chain_head(table, callee)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == callee:
                        return table.function_param_mutable_ref[cur.usize()] if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return false

        def place_required_position(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                return false if not lvarg_signature_is_unique(table, callee)
                return lmut_threads_position(table, callee, position) or mutable_ref_position_of(table, callee, position)

        # The declared bare type of callee's positional parameter at `position`, else "".
        def value_param_type_at(table: SymbolTable&, callee: sview, position: u32) -> sview:
            can Abort.Panic:
                return sview("", 0, 0) if not lvarg_signature_is_unique(table, callee)
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per call argument — see the matching comment on
                # function_parameter_count in resolve_expr.elisa.
                seen: mutable u32 = 0
                cur: mutable u32 = function_param_chain_head(table, callee)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == callee:
                        return table.function_param_type[cur.usize()] if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return sview("", 0, 0)

        # Whether a type annotation is a REFERENCE type — carries `&` or `lmut` (a borrow).
        # A plain `mutable T` (no `&`) is a mutable VALUE, NOT a reference, and must not be
        # treated as one (`mutable Handle` local passed by `move` to a value param is fine).
        def lvarg_type_is_ref(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return true if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                        return lvarg_type_is_ref(operand)
                    Expr.Paren(inner, paren_line):
                        return lvarg_type_is_ref(inner)
                    _:
                        return false

        # Whether a type annotation carries `mutable` anywhere outside its base name. This is
        # the whole difference between stage0's `got T&` and its `got mutable T&`.
        def lvarg_type_has_mutable(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return true if operator == TokenKind.Mutable
                        return lvarg_type_has_mutable(operand)
                    Expr.Paren(inner, paren_line):
                        return lvarg_type_has_mutable(inner)
                    _:
                        return false

        # Whether a type annotation is an `lmut` borrow, which stage0 spells `mutable T&`.
        def lvarg_type_is_lmut(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return true if operator == TokenKind.Lmut
                        return lvarg_type_is_lmut(operand)
                    Expr.Paren(inner, paren_line):
                        return lvarg_type_is_lmut(inner)
                    _:
                        return false

        # How a binding is passed: 0 a plain value, 1 a plain `T&`, 2 an explicit
        # writable borrow (`mutable T&` or `lmut T`), and 3 a mutable aggregate local
        # whose initializer aliases an existing reference. Stage0 permits ordinary
        # mutable aggregate values to be copied by value; only the aliasing form is
        # represented as `mutable T&` at a by-value call boundary. The receiver map
        # carries this distinction instead of a bare bool.
        def lvarg_ref_kind(type_expression: Ast::Expr) -> u8:
            can Abort.Panic:
                return 2 if lvarg_type_is_lmut(type_expression) or (lvarg_type_is_ref(type_expression) and lvarg_type_has_mutable(type_expression))
                return 1 if lvarg_type_is_ref(type_expression)
                return 0

        # A mutable aggregate is address-backed for value-parameter assignability, but
        # `&value` is still its first valid borrow and must not be diagnosed as a
        # reference-to-reference. Only explicit reference annotations qualify here.
        def ref_arg_is_explicit(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_is_ref: darray[u16]&) -> bool:
            can Abort.Panic:
                name: sview = match argument:
                    Expr.Ident(ident_name, ident_line): ident_name
                    Expr.Move(operand, move_line): ident_name_of(operand)
                    Expr.Paren(inner, paren_line): ident_name_of(inner)
                    _: sview("", 0, 0)
                return false if name == ""
                index: mutable usize = receiver_names.count
                while index > 0 |index|:
                    index <- index - 1
                    return receiver_is_ref[index] == 1 or receiver_is_ref[index] == 2 if receiver_names[index] == name
                return false

        # The base struct type of a REFERENCE argument — an ident (or `move ident`) naming a
        # binding whose type is a reference (`&`/`lmut`, per `receiver_is_ref`) — else "". Such
        # a borrow cannot satisfy a BY-VALUE parameter: stage0 rejects `expects C, got mutable C&`.
        def ref_arg_base_type(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, receiver_is_ref: darray[u16]&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                name: sview = match argument:
                    Expr.Ident(ident_name, ident_line): ident_name
                    Expr.Move(operand, move_line): ident_name_of(operand)
                    Expr.Paren(inner, paren_line): ident_name_of(inner)
                    _: sview("", 0, 0)
                return "" if name == ""
                index: mutable usize = receiver_names.count
                while index > 0 |index|:
                    index <- index - 1
                    if receiver_names[index] == name:
                        return receiver_types[index] if receiver_is_ref[index] != 0 else ""
                return ""

        # The borrow kind of the binding `ref_arg_base_type` matched — 1 for a plain `T&`, 2
        # for a writable one. Scanned the same way and in the same order, so the kind always
        # belongs to the binding whose type was reported.
        def ref_arg_ref_kind(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, receiver_is_ref: darray[u16]&) -> u8:
            can Memory.Allocate, Abort.Panic:
                name: sview = match argument:
                    Expr.Ident(ident_name, ident_line): ident_name
                    Expr.Move(operand, move_line): ident_name_of(operand)
                    Expr.Paren(inner, paren_line): ident_name_of(inner)
                    _: sview("", 0, 0)
                return 0 if name == ""
                index: mutable usize = receiver_names.count
                while index > 0 |index|:
                    index <- index - 1
                    return receiver_is_ref[index].u8() if receiver_names[index] == name
                return 0

        # Whether a by-value parameter type is one a mutable aggregate borrow cannot inhabit.
        # Stage0 permits sview/dstr borrows through their special assignability rules.
        # cstr is a pointer value: cstr& is a reference to that pointer, not a cstr.
        def lvarg_value_param_is_place(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return match name:
                    "cstr": true
                    "sview" | "dstr": false
                    _: is_registered_type(name, table)

        # Look up a struct FIELD's declared type name in the field registry — the bare type
        # (`bare_type_name`), so a value field `arena: S` yields "S" while a ref-typed field
        # yields "" and is never treated as a placeless value. A field declared `mutable`
        # ALSO yields "": a mutable field of a mutable place is itself a mutable place (a valid
        # borrow target), so only a NON-mutable value field is a placeless copy. This is the
        # distinction between `combine(p.a)` where `a: mutable C` (accepted) and `bump(h.arena)`
        # where `arena: ScratchArena` (rejected — needs `&h.arena`).
        # The pair chain retains declaration order. Exact owner/field checks guard hash collisions;
        # an empty bare type keeps the scan open, matching the prior table walk.
        def lvarg_field_type(table: SymbolTable&, struct_name: sview, field_name: sview) -> sview:
            can Abort.Panic:
                row: mutable u32 = struct_field_pair_head(table, struct_field_pair_hash(struct_name, field_name))
                found: mutable sview = sview("", 0, 0)
                while row != SYMBOL_INDEX_ROW_NONE |row, found, table, struct_name, field_name|:
                    index: usize = row.usize()
                    found <- table.struct_field_type[index] if found == "" and table.struct_field_owner[index] == struct_name and table.struct_field_name[index] == field_name and not table.struct_field_mutable[index]
                    row <- table.struct_field_pair_next[index]
                return found

        # A receiver's base STRUCT type (peeling `mutable`/`&`/`lmut`), from the active lexical
        # receiver map — includes ref params (`h: mutable Holder&` -> "Holder"), which the
        # value-only map deliberately omits.
        def lvarg_receiver_type(name: sview, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&) -> sview @source:
            can Abort.Panic:
                index: mutable usize = receiver_names.count
                while index > 0 |index|:
                    index <- index - 1
                    return receiver_types[index] if receiver_names[index] == name
                return ""

        # The value-binding type of an argument at an lmut call position, else "": a struct
        # LITERAL (a temporary), an ident naming a by-value binding (bare struct type, not mutable/
        # ref) in `value_names`/`value_types`, or a FIELD access `recv.field` whose field is a
        # by-value struct — a copy, not a mutable place, so it needs an explicit `&recv.field`.
        def lmut_value_arg_type(argument: Ast::Expr, value_names: darray[sview]&, value_types: darray[sview @source]&, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, table: SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Construct(type_expression, fields, construct_line):
                        return ident_name_of(type_expression)
                    Expr.Ident(name, line):
                        binding_index: mutable usize = value_names.count
                        while binding_index > 0 |binding_index|:
                            binding_index <- binding_index - 1
                            return value_types[binding_index] if value_names[binding_index] == name
                        return ""
                    Expr.Field(receiver, field_name, field_line):
                        receiver_name: sview = ident_name_of(receiver)
                        return "" if receiver_name == ""
                        receiver_type: sview = lvarg_receiver_type(receiver_name, receiver_names, receiver_types)
                        return "" if receiver_type == ""
                        field_type: sview = lvarg_field_type(table, receiver_type, field_name)
                        return field_type if field_type != "" and lvarg_needs_place_tracking(field_type)
                        return sview("", 0, 0)
                    Expr.Paren(inner, line):
                        return lmut_value_arg_type(inner, value_names, value_types, receiver_names, receiver_types, table)
                    _:
                        return sview("", 0, 0)

        def lmut_assignment_rhs_unwrap(value: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match value:
                    Expr.Paren(inner, line):
                        return lmut_assignment_rhs_unwrap(inner)
                    _:
                        return value

        def lmut_append_assignment_binding(name: sview, assigned_value_type: sview @source, assigned_receiver_type: sview @source, assigned_ref_kind: u16, value_names: mutable darray[sview]&, value_types: mutable darray[sview @source]&, receiver_names: mutable darray[sview]&, receiver_types: mutable darray[sview @source]&, receiver_is_ref: mutable darray[u16]&) -> void:
            can Memory.Allocate, Abort.Panic:
                value_names.push(name)
                value_types.push(assigned_value_type)
                receiver_names.push(name)
                receiver_types.push(assigned_receiver_type)
                receiver_is_ref.push(assigned_ref_kind)

        def lmut_record_assignment_binding(name: sview, value: Ast::Expr, value_names: mutable darray[sview]&, value_types: mutable darray[sview @source]&, receiver_names: mutable darray[sview]&, receiver_types: mutable darray[sview @source]&, receiver_is_ref: mutable darray[u16]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                assigned_value_type: mutable sview @source = lmut_value_arg_type(value, value_names, value_types, receiver_names, receiver_types, table)
                assigned_ref_type: sview @source = ref_arg_base_type(value, receiver_names, receiver_types, receiver_is_ref)
                assigned_ref_kind: u8 = ref_arg_ref_kind(value, receiver_names, receiver_types, receiver_is_ref)
                assigned_receiver_type: mutable sview @source = assigned_value_type
                if assigned_ref_type != "":
                    assigned_value_type <- ""
                    assigned_receiver_type <- assigned_ref_type
                lmut_append_assignment_binding(name, assigned_value_type, assigned_receiver_type, assigned_ref_kind.u16(), value_names, value_types, receiver_names, receiver_types, receiver_is_ref)

        # A single name introduced by a truthy `is`/`as` condition has the
        # scrutinee's by-value type when the target is a bare binder. For
        # conjunctions, the right side's binding shadows a same-named left
        # binding, matching gather_truthy_condition_bindings' source order.
        def lvarg_truthy_binding_type(condition: Ast::Expr, binder: sview, value_names: darray[sview]&, value_types: darray[sview @source]&, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, table: SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, line):
                        return lvarg_truthy_binding_type(inner, binder, value_names, value_types, receiver_names, receiver_types, table)
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.And:
                            right_bindings: mutable darray[sview @source] = []
                            gather_truthy_condition_bindings(right, table, right_bindings)
                            return lvarg_truthy_binding_type(right, binder, value_names, value_types, receiver_names, receiver_types, table) if any name in right_bindings where name == binder
                            return lvarg_truthy_binding_type(left, binder, value_names, value_types, receiver_names, receiver_types, table)
                        if operator == TokenKind.Is or operator == TokenKind.As:
                            match right:
                                Expr.Ident(name, _):
                                    return lmut_value_arg_type(left, value_names, value_types, receiver_names, receiver_types, table) if name == binder
                                _:
                                    pass
                    _:
                        pass
                return ""

        # Collect types in the same occurrence order as gather_pattern: a root binding or
        # as-alias gets the whole scrutinee type, nested payload bindings stay unknown,
        # and a nested TypeBind supplies its own concrete named type. Keeping occurrences
        # separate matters because resolver lookup uses the last same-named binder.
        def lmut_collect_pattern_binding_types(pattern: Ast::Pattern, root_type: sview @source, is_root: bool, types: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        types.push(root_type if is_root else "")
                    Pattern.TypeBind(type_name, binder):
                        types.push(type_name if type_name != "error" and lvarg_needs_place_tracking(type_name) else "")
                    Pattern.Rest(name):
                        types.push("") if name != "" and name != "_"
                    Pattern.As(name, inner):
                        types.push(root_type if is_root else "")
                        for nested in inner:
                            # A direct nested binding in an As wrapper still captures the
                            # same whole value. Composite patterns reset provenance for
                            # their payloads below.
                            lmut_collect_pattern_binding_types(nested, root_type, true, types)
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Field(_, fields) | Pattern.Tuple(fields):
                        for nested in fields:
                            lmut_collect_pattern_binding_types(nested, "", false, types)
                    Pattern.Or(_):
                        # Nested Or patterns bind only the intersection of names. Keep
                        # those binders shadowing, but do not guess a payload type across
                        # alternatives.
                        or_bindings: mutable darray[sview @source] = []
                        gather_pattern(pattern, or_bindings)
                        for _ in or_bindings:
                            types.push("")
                    _:
                        pass

        def lmut_truthy_binding_types(condition: Ast::Expr, bindings: darray[sview @source], value_names: darray[sview]&, value_types: darray[sview @source]&, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, table: SymbolTable&) -> darray[sview @source]:
            can Memory.Allocate, Abort.Panic:
                types: mutable darray[sview @source] = []
                for binder in bindings |types|:
                    types.push(lvarg_truthy_binding_type(condition, binder, value_names, value_types, receiver_names, receiver_types, table))
                return types

        def lmut_pattern_binding_types(pattern: Ast::Pattern, root_type: sview @source) -> darray[sview @source]:
            can Memory.Allocate, Abort.Panic:
                types: mutable darray[sview @source] = []
                return types if arm_or_pattern_binds_names(pattern)
                lmut_collect_pattern_binding_types(pattern, root_type, true, types)
                return types

        def lmut_value_check_expression(expression: Ast::Expr, value_names: darray[sview]&, value_types: darray[sview @source]&, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        if callee_name != "":
                            position: mutable u32 = 0
                            for argument in arguments |table, position| -> table:
                                argument_type: sview = lmut_value_arg_type(argument, value_names, value_types, receiver_names, receiver_types, table)
                                needs_place: mutable bool = false
                                needs_place_checked: mutable bool = false
                                if argument_type != "":
                                    needs_place <- place_required_position(table, callee_name, position)
                                    needs_place_checked <- true
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutValueArg, name: callee_name, pos: Ast::expr_pos(argument), line: line.line, expected: argument_type, actual: "", expected_count: position + 1}) if argument_type != "" and needs_place
                                # `&ref` (an explicit second borrow of a reference binding) is
                                # check_reference_reborrow's: it judges every destination, not
                                # only a place-required parameter of an unqualified callee.
                                # Inverse mismatch: a REFERENCE binding passed to a BY-VALUE param of
                                # the same struct — a borrow cannot inhabit a value slot. Require a
                                # registered value struct (excludes generics) and matching bases, so
                                # this never collides with the place-required check above.
                                ref_base: sview = ref_arg_base_type(argument, receiver_names, receiver_types, receiver_is_ref)
                                value_param: sview = value_param_type_at(table, callee_name, position) if ref_base != "" else ""
                                ref_to_value: mutable bool = false
                                if ref_base != "" and value_param == ref_base and lvarg_value_param_is_place(value_param, table):
                                    if not needs_place_checked:
                                        needs_place <- place_required_position(table, callee_name, position)
                                        needs_place_checked <- true
                                    ref_to_value <- not needs_place
                                # stage0 spells a writable borrow `mutable T&` and a plain one `T&`.
                                # A Diagnostic may only carry source sviews, so the spelling lives in
                                # the kind rather than being concatenated into `actual`.
                                writable_borrow: bool = ref_arg_ref_kind(argument, receiver_names, receiver_types, receiver_is_ref) >= 2
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefArgValueParam, name: callee_name, pos: Ast::expr_pos(argument), line: line.line, expected: value_param, actual: ref_base, expected_count: position + 1}) if ref_to_value and writable_borrow
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PlainRefArgValueParam, name: callee_name, pos: Ast::expr_pos(argument), line: line.line, expected: value_param, actual: ref_base, expected_count: position + 1}) if ref_to_value and not writable_borrow
                                position <- position + 1
                        table <- lmut_value_check_expression(callee, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for argument in arguments |table| -> table:
                            table <- lmut_value_check_expression(argument, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        table <- lmut_value_check_expression(effect_type, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for argument in arguments |table| -> table:
                            table <- lmut_value_check_expression(argument, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Field(object, field, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Scope(base, name, line):
                        table <- lmut_value_check_expression(base, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Index(object, index, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(index, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Slice(object, low, high, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(low, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(high, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.IndexN(object, arguments, line):
                        table <- lmut_value_check_expression(object, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for argument in arguments |table| -> table:
                            table <- lmut_value_check_expression(argument, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Binary(left, operator, right, line):
                        table <- lmut_value_check_expression(left, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        if operator == TokenKind.And:
                            right_bindings: mutable darray[sview @source] = []
                            gather_truthy_condition_bindings(left, table, right_bindings)
                            right_binding_types: darray[sview @source] = lmut_truthy_binding_types(left, right_bindings, value_names, value_types, receiver_names, receiver_types, table)
                            right_statements: darray[Ast::Stmt] = []
                            table <- lmut_value_check_bound_scope_types(right_statements, right, right_bindings, right_binding_types, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        else:
                            table <- lmut_value_check_expression(right, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Unary(operator, operand, line):
                        table <- lmut_value_check_expression(operand, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Move(operand, line):
                        table <- lmut_value_check_expression(operand, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.RegionNew(operand, region, line):
                        table <- lmut_value_check_expression(operand, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Paren(inner, line):
                        table <- lmut_value_check_expression(inner, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- lmut_value_check_expression(element, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- lmut_value_check_expression(entry.key, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_expression(entry.value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- lmut_value_check_expression(type_expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for field in fields |table| -> table:
                            table <- lmut_value_check_expression(field.value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- lmut_value_check_expression(base, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        for field in fields |table| -> table:
                            table <- lmut_value_check_expression(field.value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.If(condition, then_expression, else_expression, line):
                        table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        then_bindings: mutable darray[sview @source] = []
                        gather_truthy_condition_bindings(condition, table, then_bindings)
                        then_binding_types: darray[sview @source] = lmut_truthy_binding_types(condition, then_bindings, value_names, value_types, receiver_names, receiver_types, table)
                        then_statements: darray[Ast::Stmt] = []
                        table <- lmut_value_check_bound_scope_types(then_statements, then_expression, then_bindings, then_binding_types, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(else_expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- lmut_value_check_expression(scrutinee, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        match_type: sview @source = lmut_value_arg_type(scrutinee, value_names, value_types, receiver_names, receiver_types, table)
                        table <- lmut_value_check_match_arms(arms, match_type, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Catch(scrutinee, arms, line):
                        table <- lmut_value_check_expression(scrutinee, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        # Catch's successful-value and error binders do not have the
                        # scrutinee's error-union type. Keep root aliases unknown here;
                        # explicit concrete TypeBind patterns can still seed their own type.
                        table <- lmut_value_check_match_arms(arms, "", value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        table <- lmut_value_check_expression(iterable, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        comprehension_bindings: darray[sview @source] = [variable]
                        comprehension_statements: darray[Ast::Stmt] = []
                        item_type: sview @source = lvarg_literal_iteration_type(iterable, value_names, value_types, receiver_names, receiver_types, table)
                        table <- lmut_value_check_guarded_scope(comprehension_statements, condition, body, comprehension_bindings, item_type, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Refinement(base, predicate, line):
                        table <- lmut_value_check_expression(base, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_expression(predicate, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- lmut_value_check_expression(guarded, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        table <- lmut_value_check_statements(recovery, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Lambda(parameters, body, line):
                        table <- lmut_value_check_bound_scope(body, Expr.Invalid, parameters, "", value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    Expr.Block(statements, value, captures, line):
                        table <- lmut_value_check_scope(statements, value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                    _:
                        pass

        # A by-value binding's struct type name, else "": a bare-Ident type (no `mutable`/`&`/`?`
        # wrapper — those are places or optionals) whose name is not a primitive. Only such value
        # bindings are placeless and thus invalid at an lmut parameter position.
        def lmut_value_type_name(type_expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return name if name != "" and lvarg_needs_place_tracking(name) else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def is_primitive_type_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "usize" | "isize" | "int" | "uint" | "f32" | "f64" | "bool" | "void" | "char" | "cstr" | "dstr" | "sview" -> true
                    _ -> false

        # `is_primitive_type_name` folds `sview`/`cstr`/`dstr` in with the true scalars — correct
        # for its OTHER callers (e.g. `.sview()`/`.cstr()` are real builtin conversion METHOD
        # names, so `check_field_access_type_param.elisa` needs them treated as "primitive-ish"
        # to stay silent). But `sview`/`cstr`/`dstr` are STRUCTS: stage0 requires a mutable place
        # for an `lmut sview`/`lmut cstr`/`lmut dstr` parameter exactly like any other struct
        # ("argument 1 to f expects mutable sview&, got sview" — confirmed against stage0 for all
        # three spellings). So THIS file's own place-tracking logic must NOT treat them as
        # primitive, even though the shared helper above (by design, for its other callers) does.
        def lvarg_needs_place_tracking(name: sview) -> bool:
            can Abort.Panic:
                return not is_primitive_type_name(name) or name == "sview" or name == "cstr" or name == "dstr"

        # Literal array items have one by-value binding type when every item
        # establishes the same aggregate. Other iterable shapes stay unknown here.
        def lvarg_literal_iteration_type(iterable: Ast::Expr, value_names: darray[sview]&, value_types: darray[sview @source]&, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, table: SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match iterable:
                    Expr.Array(elements, line):
                        return "" if elements.count == 0
                        first: sview @source = lmut_value_arg_type(elements[0], value_names, value_types, receiver_names, receiver_types, table)
                        return "" if first == ""
                        for element in elements:
                            return "" if lmut_value_arg_type(element, value_names, value_types, receiver_names, receiver_types, table) != first
                        return first
                    _:
                        return ""

        def lmut_value_check_statements(statements: darray[Ast::Stmt], value_names: darray[sview]&, value_types: darray[sview @source]&, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lmut_value_check_scope(statements, Expr.Invalid, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)

        # Copy the active bindings, then extend them in source order. A nested block
        # cannot expose its locals to siblings or to earlier statements.
        def lmut_value_check_scope(statements: darray[Ast::Stmt], result: Ast::Expr, inherited_value_names: darray[sview]&, inherited_value_types: darray[sview @source]&, inherited_receiver_names: darray[sview]&, inherited_receiver_types: darray[sview @source]&, inherited_receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                empty_bindings: darray[sview @source] = []
                table <- lmut_value_check_bound_scope(statements, result, empty_bindings, "", inherited_value_names, inherited_value_types, inherited_receiver_names, inherited_receiver_types, inherited_receiver_is_ref, table)

        def lmut_value_check_bound_scope(statements: darray[Ast::Stmt], result: Ast::Expr, bindings: darray[sview @source]&, binding_type: sview @source, inherited_value_names: darray[sview]&, inherited_value_types: darray[sview @source]&, inherited_receiver_names: darray[sview]&, inherited_receiver_types: darray[sview @source]&, inherited_receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lmut_value_check_guarded_scope(statements, Expr.Invalid, result, bindings, binding_type, inherited_value_names, inherited_value_types, inherited_receiver_names, inherited_receiver_types, inherited_receiver_is_ref, table)

        def lmut_value_check_bound_scope_types(statements: darray[Ast::Stmt], result: Ast::Expr, bindings: darray[sview @source]&, binding_types: darray[sview @source], inherited_value_names: darray[sview]&, inherited_value_types: darray[sview @source]&, inherited_receiver_names: darray[sview]&, inherited_receiver_types: darray[sview @source]&, inherited_receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lmut_value_check_guarded_scope_types(statements, Expr.Invalid, result, bindings, binding_types, inherited_value_names, inherited_value_types, inherited_receiver_names, inherited_receiver_types, inherited_receiver_is_ref, table)

        def lmut_value_check_guarded_scope(statements: darray[Ast::Stmt], condition: Ast::Expr, result: Ast::Expr, bindings: darray[sview @source]&, binding_type: sview @source, inherited_value_names: darray[sview]&, inherited_value_types: darray[sview @source]&, inherited_receiver_names: darray[sview]&, inherited_receiver_types: darray[sview @source]&, inherited_receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                binding_types: darray[sview @source] = [binding_type for binding in bindings]
                table <- lmut_value_check_guarded_scope_types(statements, condition, result, bindings, binding_types, inherited_value_names, inherited_value_types, inherited_receiver_names, inherited_receiver_types, inherited_receiver_is_ref, table)

        def lmut_value_check_guarded_scope_types(statements: darray[Ast::Stmt], condition: Ast::Expr, result: Ast::Expr, bindings: darray[sview @source]&, binding_types: darray[sview @source], inherited_value_names: darray[sview]&, inherited_value_types: darray[sview @source]&, inherited_receiver_names: darray[sview]&, inherited_receiver_types: darray[sview @source]&, inherited_receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                value_names: mutable darray[sview] = [name for name in inherited_value_names]
                value_types: mutable darray[sview @source] = [type_name for type_name in inherited_value_types]
                receiver_names: mutable darray[sview] = [name for name in inherited_receiver_names]
                receiver_types: mutable darray[sview @source] = [type_name for type_name in inherited_receiver_types]
                receiver_is_ref: mutable darray[u16] = [kind for kind in inherited_receiver_is_ref]
                binding_index: mutable usize = 0
                for binding in bindings |binding_index, value_names, value_types, receiver_names, receiver_types, receiver_is_ref|:
                    binding_type: sview @source = binding_types[binding_index] if binding_index < binding_types.count else ""
                    value_names.push(binding)
                    value_types.push(binding_type)
                    receiver_names.push(binding)
                    receiver_types.push(binding_type)
                    receiver_is_ref.push(0)
                    binding_index <- binding_index + 1
                table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                table <- lmut_value_check_scope_statements(statements, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                table <- lmut_value_check_expression(result, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)

        def lmut_value_check_match_arms(arms: darray[Ast::MatchArm], root_type: sview @source, value_names: darray[sview]&, value_types: darray[sview @source]&, receiver_names: darray[sview]&, receiver_types: darray[sview @source]&, receiver_is_ref: darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in arms |table| -> table:
                    arm_bindings: mutable darray[sview @source] = []
                    gather_arm_pattern(arm.pattern, arm_bindings)
                    arm_binding_types: darray[sview @source] = lmut_pattern_binding_types(arm.pattern, root_type)
                    table <- lmut_value_check_guarded_scope_types(arm.body, arm.guard, Expr.Invalid, arm_bindings, arm_binding_types, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
