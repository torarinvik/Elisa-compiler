# Passing a value literal to an `lmut` parameter. An `lmut T` parameter lowers to a mutable
# reference — it must be given a PLACE (a mutable local/field), never a temporary. Passing a struct
# LITERAL `f(Counter{...})` to such a parameter is rejected ("argument N to f expects mutable T&,
# got T"). SOUND subset: a construction argument (a temporary with no place) at a parameter position
# the callee declared `lmut` (tracked in lmut_param_owner/pos). Value-typed-local args need local
# type tracking and are left out.
extend Semantic:
    private:
        def lmut_position_of(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                found: mutable bool = false
                while index < table.lmut_param_owner.count |found|:
                    found <- true if table.lmut_param_owner[index] == callee and table.lmut_param_pos[index] == position
                    index <- index + 1
                return found

        def lmut_value_check_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        if callee_name != "":
                            position: mutable u32 = 0
                            for argument in arguments |table, position| -> table:
                                if argument is Expr.Construct(type_expression, fields, construct_line):
                                    constructed: sview = ident_name_of(type_expression)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutValueArg, name: callee_name, line: line, expected: constructed, actual: "", expected_count: position + 1}) if constructed != "" and lmut_position_of(table, callee_name, position)
                                position <- position + 1
                        for argument in arguments |table| -> table:
                            table <- lmut_value_check_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- lmut_value_check_expression(left, table)
                        table <- lmut_value_check_expression(right, table)
                    Expr.Paren(inner, line):
                        table <- lmut_value_check_expression(inner, table)
                    _:
                        pass

        def lmut_value_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- lmut_value_check_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- lmut_value_check_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- lmut_value_check_expression(value, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- lmut_value_check_expression(returned, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- lmut_value_check_expression(condition, table)
                            table <- lmut_value_check_statements(then_body, table)
                            table <- lmut_value_check_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- lmut_value_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- lmut_value_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- lmut_value_check_statements(body, table)
                        _:
                            pass

        def check_lmut_value_arg_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- lmut_value_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_lmut_value_arg_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_lmut_value_arg_walk(scoped_body, table)
                        _:
                            pass

        def check_lmut_value_arg(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_lmut_value_arg_walk(file.top_decls, table)
