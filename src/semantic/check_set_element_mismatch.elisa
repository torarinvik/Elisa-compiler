# Set-literal element type mismatch: a `set[T]` VarDecl (`xs: set[i64] = {"s"}`) whose
# annotated element type is a bare primitive, where an element of the set-literal value
# (literal or firm) can NEVER fit that element type. E.g. `xs: set[i64] = {"s"}` fires
# because "s" is a string literal and string literals never fit i64.
# Sound subset: only bare-primitive `set[T]` annotations (`set[i64]`, not `darray[T]` or
# other generics); only literal/firm elements whose family is provably incompatible (same
# oracle as TypeMismatch's check_value_against — literal_never_fits / firm_never_fits).
# Unknown-family elements (calls, constructs, Named-typed locals, ...) never fire.

extend Semantic:
    private:
        # Extract the bare element-type name from a `set[T]` TYPE annotation — i.e.
        # `Expr.Index(object: Expr.Ident("set"), index: Expr.Ident(elem_type_name))`.
        # Returns "" if the annotation is not a `set[Ident]` shape (darray[T], dict[K,V],
        # non-Ident element base, non-"set" head, ... all skip).
        def extract_set_element_type_name(type_expr: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.Index(object, index, line):
                        match object:
                            Expr.Ident(head_name, head_line):
                                if head_name == "set":
                                    match index:
                                        Expr.Ident(elem_name, elem_line):
                                            return elem_name
                                        _:
                                            return ""
                                return ""
                            _:
                                return ""
                    _:
                        return ""

        # Whether `type_name` is a bare primitive eligible for this check (mirrors the
        # gate used by TypeMismatch/check_value_against: integer/float/string types plus
        # bool/char).
        def is_set_element_primitive(type_name: sview) -> bool:
            can Abort.Panic:
                if is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name):
                    return true
                return type_name == "bool" or type_name == "char"

        # Check one set-literal element against the declared element type; push a
        # diagnostic if its literal kind or inferred family can never fit.
        def check_set_element_against(element: Ast::Expr, elem_type_name: sview, line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                literal_kind: sview = literal_kind_of(element)
                if literal_kind != "":
                    if literal_never_fits(literal_kind, elem_type_name):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SetElementTypeMismatch, name: "", line: line, expected: elem_type_name, actual: literal_kind})
                else:
                    element_family: sview = family_of_kind(infer_expression_type(element, var_types, type_names, table))
                    if element_family != "" and firm_never_fits(element_family, elem_type_name):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SetElementTypeMismatch, name: "", line: line, expected: elem_type_name, actual: element_family})

        # Walk through expressions, recursing into nested constructs so set literals in
        # nested positions (not just direct VarDecl values) are still walked for their
        # OWN sub-expressions (this check only fires at the VarDecl site itself, but the
        # recursive walk must still visit every expression so other nested VarDecls are
        # reached via the statement walk below).
        def walk_expression_for_set_element_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_set_element_mismatch(left, table, var_types, type_names)
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            table <- walk_expression_for_set_element_mismatch(right, table, var_types, type_names)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_set_element_mismatch(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_set_element_mismatch(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_set_element_mismatch(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_set_element_mismatch(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_set_element_mismatch(object, table, var_types, type_names)
                        if not index_receiver_is_type_application(object):
                            table <- walk_expression_for_set_element_mismatch(index, table, var_types, type_names)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_set_element_mismatch(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_set_element_mismatch(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_set_element_mismatch(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_set_element_mismatch(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_set_element_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_set_element_mismatch(low, table, var_types, type_names)
                        table <- walk_expression_for_set_element_mismatch(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_set_element_mismatch(object, table, var_types, type_names)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table|:
                                table <- walk_expression_for_set_element_mismatch(argument, table, var_types, type_names)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_set_element_mismatch(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_set_element_mismatch(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_set_element_mismatch(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_set_element_mismatch(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_set_element_mismatch(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_set_element_mismatch(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_set_element_mismatch(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_set_element_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_set_element_mismatch(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_set_element_mismatch(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_set_element_mismatch(iterable, table, var_types, type_names)
                        table <- walk_expression_for_set_element_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_set_element_mismatch(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_set_element_mismatch(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_set_element_mismatch(statements, table, var_types, type_names)
                        table <- walk_expression_for_set_element_mismatch(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_set_element_mismatch(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_set_element_mismatch(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking `set[T]`
        # VarDecls whose value is a set literal.
        def walk_statements_for_set_element_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_set_element_mismatch(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            elem_type_name: sview = extract_set_element_type_name(type_expression)
                            if elem_type_name != "" and is_set_element_primitive(elem_type_name):
                                match value:
                                    Expr.SetLit(elements, set_line):
                                        for element in elements |table|:
                                            table <- check_set_element_against(element, elem_type_name, line, var_types, type_names, table)
                                    _:
                                        pass
                            # Record the local's own type and recurse into the value.
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_set_element_mismatch(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_set_element_mismatch(target, table, var_types, type_names)
                            table <- walk_expression_for_set_element_mismatch(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_set_element_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_set_element_mismatch(then_body, table, var_types, type_names)
                            table <- walk_statements_for_set_element_mismatch(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_set_element_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_set_element_mismatch(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_set_element_mismatch(iterable, table, var_types, type_names)
                            table <- walk_statements_for_set_element_mismatch(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_set_element_mismatch(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_set_element_mismatch(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_set_element_mismatch(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_set_element_mismatch(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_set_element_mismatch(return_value, table, var_types, type_names)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_set_element_mismatch(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_set_element_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_set_element_mismatch(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_set_element_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_set_element_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_set_element_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_set_element_mismatch_declarations(declarations, table)
