# Pure syntactic type-name policy shared by semantic resolution and proofs.
module SemanticPrimitiveTypeName:
    public:
        const INT_PREFIX_LENGTH: usize = 1
        const MIN_INT_NAME_LENGTH: usize = INT_PREFIX_LENGTH + 1
        const INT_LEAD_INDEX: usize = 0
        const INDEX_STEP: usize = 1
        const ASCII_LOWER_I: u8 = 105
        const ASCII_LOWER_U: u8 = 117
        const ASCII_DIGIT_ZERO: u8 = 48
        const ASCII_DIGIT_NINE: u8 = 57

        def is_ascii_digit(byte: u8) -> bool:
            ensure result == (byte >= ASCII_DIGIT_ZERO and byte <= ASCII_DIGIT_NINE)
            return byte >= ASCII_DIGIT_ZERO and byte <= ASCII_DIGIT_NINE

        # This recognizes the lexical `iN`/`uN` form only. Width validity is
        # checked by the width-specific semantic and code-generation paths.
        def is_bit_width_int(name: sview) -> bool:
            ensure result == (
                sview_len(name) >= MIN_INT_NAME_LENGTH and
                (name[INT_LEAD_INDEX] == ASCII_LOWER_I or name[INT_LEAD_INDEX] == ASCII_LOWER_U) and
                (forall digit_index in INT_PREFIX_LENGTH..<sview_len(name): is_ascii_digit(name[digit_index]))
            )
            can Abort.Panic:
                length: usize = sview_len(name)
                false return if length < MIN_INT_NAME_LENGTH
                lead: u8 = name[INT_LEAD_INDEX]
                prefix_is_integer: bool = match lead:
                    ASCII_LOWER_I | ASCII_LOWER_U: true
                    _: false
                false return if not prefix_is_integer
                index: mutable usize = INT_PREFIX_LENGTH
                all_digits: mutable bool = true
                while index < length |all_digits, index, length, name|:
                    decreases length - index
                    invariant index >= INT_PREFIX_LENGTH
                    invariant index <= length
                    invariant all_digits == (forall checked_index in INT_PREFIX_LENGTH..<index: is_ascii_digit(name[checked_index]))
                    all_digits <- false if not is_ascii_digit(name[index])
                    index <- index + INDEX_STEP
                return all_digits

        # A function declaration with one of Stage0's builtin scalar type names is
        # shadowed by type-call syntax. Keep this exact subset separate from the
        # broader primitive set used by type resolution.
        def is_builtin_scalar_type_name(name: sview) -> bool:
            ensure result == (when name:
                "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f16" | "f32" | "f64" | "bool" | "char" -> true
                _ -> is_bit_width_int(name)
            )
            can Abort.Panic:
                return match name:
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f16" | "f32" | "f64" | "bool" | "char": true
                    _: is_bit_width_int(name)

        def is_primitive_type(name: sview) -> bool:
            ensure result == (when name:
                "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f32" | "f64" | "bool" | "char" | "void" | "cstr" | "dstr" | "sview" | "bitset" | "bitfield" -> true
                _ -> is_bit_width_int(name)
            )
            can Abort.Panic:
                return match name:
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f32" | "f64" | "bool" | "char" | "void" | "cstr" | "dstr" | "sview" | "bitset" | "bitfield": true
                    _: is_bit_width_int(name)
