# `@bounds(buf, count)` on an extern (docs/127 §3.3): the parser rewrote the signature and
# recorded either the pairs (`__bounds_owner` / `__bounds_ptr` / `__bounds_len`, per pair,
# in that order) or the first validation failure (`__bounds_odd` + `__bounds_odd_count`,
# `__bounds_unknown`, `__bounds_reused`, `__bounds_badptr`, `__bounds_badlen`). This check
# turns those into stage0's messages: the failures at the `@bounds` decorator, the two
# post-rewrite rules at the extern (it must be `@callconv(c)`; a contract may not name a
# removed length). It also fills the table's (owner, length) list for the D6 hint.
extend Semantic:
    private:
        def bounds_decorator_pos(decorators: darray[Ast::Annotation]&) -> Ast::Pos:
            can Abort.Panic:
                for decorator in decorators:
                    Ast::Pos{line: decorator.line, column: decorator.column, offset: 0, end_line: decorator.line, end_column: decorator.column + 6, end_offset: 0} return if decorator.name == "bounds"
                return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}

        # The OWNER of the first annotation named `name` at `line`, or "" when none.
        def bounds_note(annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.owner return if annotation.name == name and annotation.line == line
                return ""

        def bounds_has_c_callconv(decorators: darray[Ast::Annotation]&, annotation_args: darray[sview]&) -> bool:
            can Abort.Panic:
                for decorator in decorators:
                    continue if decorator.name != "callconv" or decorator.arg_count == 0 or decorator.arg_start.usize() >= annotation_args.count
                    convention: sview = annotation_args[decorator.arg_start.usize()]
                    return convention == "c" or convention == "cdecl"
                return false

        def check_extern_bounds(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, annotation_args: darray[sview]&, signature_contract_lines: darray[u32]&, signature_contract_exprs: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if callable:
                                dpos: Ast::Pos = bounds_decorator_pos(decorators)
                                if bounds_note(annotations, "__bounds_odd", line.line) != "":
                                    odd_count: mutable u32 = 0
                                    for annotation in annotations |odd_count|:
                                        odd_count <- annotation.line if annotation.name == "__bounds_odd_count" and annotation.owner == name
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBoundsOdd, name: name, line: dpos.line, pos: dpos, expected: "", actual: "", expected_count: odd_count})
                                unknown_name: sview = bounds_note(annotations, "__bounds_unknown", line.line)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBoundsUnknown, name: name, line: dpos.line, pos: dpos, expected: unknown_name, actual: ""}) if unknown_name != ""
                                reused_name: sview = bounds_note(annotations, "__bounds_reused", line.line)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBoundsReused, name: name, line: dpos.line, pos: dpos, expected: reused_name, actual: ""}) if reused_name != ""
                                badptr_name: sview = bounds_note(annotations, "__bounds_badptr", line.line)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBoundsBadPtr, name: name, line: dpos.line, pos: dpos, expected: badptr_name, actual: ""}) if badptr_name != ""
                                badlen_name: sview = bounds_note(annotations, "__bounds_badlen", line.line)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBoundsBadLen, name: name, line: dpos.line, pos: dpos, expected: badlen_name, actual: ""}) if badlen_name != ""
                                if bounds_note(annotations, "__bounds_owner", line.line) == name:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBoundsNeedsCallConv, name: name, line: line.line, pos: line, expected: "", actual: ""}) if not bounds_has_c_callconv(decorators, annotation_args)
                                    # Each pair: does any contract clause on this line name the length?
                                    reported: mutable bool = false
                                    for index in 0..<annotations.count |table, reported| -> table:
                                        continue if reported or annotations[index].name != "__bounds_len" or annotations[index].line != line.line
                                        length_name: sview = annotations[index].owner
                                        ptr_name: sview = annotations[index - 1.usize()].owner
                                        for sig_index in 0..<signature_contract_exprs.count |table, reported| -> table:
                                            continue if reported or sig_index >= signature_contract_lines.count or signature_contract_lines[sig_index] != line.line
                                            if predicate_mentions(signature_contract_exprs[sig_index], length_name):
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBoundsLengthInContract, name: name, line: line.line, pos: line, expected: length_name, actual: ptr_name})
                                                reported <- true
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_extern_bounds(module_body, annotations, annotation_args, signature_contract_lines, signature_contract_exprs, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_extern_bounds(scoped_body, annotations, annotation_args, signature_contract_lines, signature_contract_exprs, table)
                        _:
                            pass

        # (owner, length) per pair, read straight off the annotations, for the D6 hint.
        def collect_extern_bounds_hints(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<annotations.count |table| -> table:
                    if annotations[index].name == "__bounds_len" and index >= 2.usize():
                        table.extern_bounds_owner <- table.extern_bounds_owner.push(annotations[index - 2.usize()].owner)
                        table.extern_bounds_length <- table.extern_bounds_length.push(annotations[index].owner)

        def bounds_length_hint(table: SymbolTable&, function_name: sview) -> sview:
            can Abort.Panic:
                for index in 0..<table.extern_bounds_owner.count:
                    table.extern_bounds_length[index] return if table.extern_bounds_owner[index] == function_name
                return ""
