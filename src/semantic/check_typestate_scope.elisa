# Typestate scope-exit conformance (stage0, docs — linear typestate protocols). A typestate
# subject transitioned to a NON-TERMINAL state and left un-consumed at scope exit has an
# unfinished protocol ("typestate value left in non-terminal state X must be consumed before
# scope exit"). The parser retains (typestate -> terminal state) under sentinel 3900000004 and
# (transition -> target state) under 3900000005 on the side-table. SOUND straight-line subset:
# a local `x: Typestate[Init]`, replay the transition calls `trans(x, …)` in order to get x's
# final state; if that state is not the typestate's terminal state and x is not returned/moved,
# flag. (Branchy transitions are a sound miss.)
extend Semantic:
    private:
        def typestate_terminal_of(annotations: darray[Ast::EnumAnnotation]&, typestate: sview) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.line == 3900000004 and annotation.owner == typestate
                return sview("", 0, 0)

        def typestate_transition_target(annotations: darray[Ast::EnumAnnotation]&, transition: sview) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    annotation.name return if annotation.line == 3900000005 and annotation.owner == transition
                return sview("", 0, 0)

        # A typestate-typed local's (typestate name, initial state) from `x: Typestate[Init]`,
        # through mutable/lmut/paren wrappers; ("","") when the type is not a typestate instance.
        def typestate_local_type(type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> (typestate: sview, init: sview):
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return typestate_local_type(operand, annotations)
                    Expr.Paren(inner, paren_line):
                        return typestate_local_type(inner, annotations)
                    Expr.Index(head, argument, index_line):
                        name: sview = ident_name_of(head)
                        has_terminal: bool = any annotation in annotations where annotation.line == 3900000004 and annotation.owner == name
                        return (name, ident_name_of(argument)) if has_terminal else (sview("", 0, 0), sview("", 0, 0))
                    _:
                        return (sview("", 0, 0), sview("", 0, 0))

        # Replay transition calls on SUBJECT through a statement list, returning its final state
        # (starting from INIT) and whether it was consumed (returned or moved).
        def typestate_final_state(statements: darray[Ast::Stmt], subject: sview, init: sview, annotations: darray[Ast::EnumAnnotation]&) -> (state: sview, consumed: bool):
            can Memory.Allocate, Abort.Panic:
                state: mutable sview = init
                consumed: mutable bool = false
                for statement in statements |state, consumed|:
                    match statement:
                        Stmt.Expr(expression, line):
                            match expression:
                                Expr.Call(callee, arguments, argument_names, call_line):
                                    if arguments.count > 0 and ident_name_of(arguments[0]) == subject:
                                        target: sview = typestate_transition_target(annotations, ident_name_of(callee))
                                        state <- target if target != ""
                                _:
                                    pass
                        Stmt.Return(value, line):
                            if value is returned:
                                consumed <- true if ident_name_of(returned) == subject
                        Stmt.Block(kind, clause, binding, body, line):
                            moved: sview = move_block_root(kind, body)
                            consumed <- true if moved == subject
                        _:
                            pass
                return (state, consumed)

        def check_typestate_scope(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- typestate_scope_walk(file.top_decls, file.enum_annotations, table)

        def typestate_scope_walk(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for statement in body |table| -> table:
                                match statement:
                                    Stmt.VarDecl(name, type_expression, value, var_line):
                                        local_type: (typestate: sview, init: sview) = typestate_local_type(type_expression, annotations)
                                        if local_type.typestate != "":
                                            final: (state: sview, consumed: bool) = typestate_final_state(body, name, local_type.init, annotations)
                                            terminal: sview = typestate_terminal_of(annotations, local_type.typestate)
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypestateNonTerminal, name: name, line: var_line.line, expected: "", actual: ""}) if not final.consumed and final.state != "" and final.state != terminal
                                    _:
                                        pass
                        Decl.Module(module_name, module_body, module_line):
                            table <- typestate_scope_walk(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- typestate_scope_walk(scoped_body, annotations, table)
                        _:
                            pass
