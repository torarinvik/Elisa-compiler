# Closed name policy for legacy runtime-carrier diagnostics.
module InternalRuntimeCarrierPolicy:
    public:
        # Empty means the named type is not one of the four error-level or two warning-level
        # internal carriers. Keep the replacement spelling in this single exhaustive table.
        def runtime_carrier_replacement(type_name: sview) -> sview can[Abort.Panic]:
            ensure when type_name:
                "StringView" -> result == ("sview[...]")
                "DynArray" -> result == ("darray[T, shape]")
                "DynArrayView" -> result == ("view[T]")
                "DynDict" -> result == ("dict[K, V]")
                "Arena" -> result == ("region scopes and inferred container regions")
                "ArenaMark" -> result == ("region scopes/checkpoints")
                _ -> result == ("")
            can Abort.Panic:
                return when type_name:
                    "StringView" -> "sview[...]"
                    "DynArray" -> "darray[T, shape]"
                    "DynArrayView" -> "view[T]"
                    "DynDict" -> "dict[K, V]"
                    "Arena" -> "region scopes and inferred container regions"
                    "ArenaMark" -> "region scopes/checkpoints"
                    _ -> ""

        # Stage0 treats only these two legacy carriers as warnings; every other mapped name is
        # an error. The fallback remains false for names outside the closed carrier set.
        def is_warning(type_name: sview) -> bool can[Abort.Panic]:
            ensure when type_name:
                "Arena" | "ArenaMark" -> result == (true)
                _ -> result == (false)
            can Abort.Panic:
                return when type_name:
                    "Arena" | "ArenaMark" -> true
                    _ -> false
