# `lmut` aliasing at a METHOD call: `parser.eat(parser.source)` binds the receiver to an `lmut`
# parameter and names the same place again as another argument. stage0 rejects it with the
# LmutAliasing error ("aliases another argument of the same call") at the later argument; the
# direct-call form is checked during resolution (check_call_lmut_aliasing in resolve_expr.elisa),
# which never saw the receiver-as-argument shape.
#
# This is the `lmut` rule, distinct from check_call_argument_exclusivity (the `mutable T&`
# noalias rule, strict-mode, with an `Unsafe.Alias` opt-out). Same conservatism as the direct
# form: only a method name that is exactly one declared function, with positional arguments
# whose count matches its parameters (receiver included).
extend Semantic:
    private:
        def lma_check_method_call(callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview], function_names: darray[sview]&, function_lookup: dict[u64, usize]&, counts: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, method, field_position):
                        return if any label in argument_names where label != ""
                        function_index: usize = exclusivity_unique_function(function_names, function_lookup, method)
                        return if function_index == function_names.count or counts[function_index] != arguments.count + 1
                        effective: mutable darray[Ast::Expr] = [object]
                        for argument in arguments |effective|:
                            effective.push(argument)
                        first: mutable usize = 0
                        while first < effective.count |first, table|:
                            second: mutable usize = first + 1
                            while second < effective.count |second, table|:
                                if (argument_position_is_lmut(table, method, first) or argument_position_is_lmut(table, method, second)) and places_overlap(effective[first], effective[second]):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutAliasing, name: target_root_ident(effective[second]), pos: Ast::expr_pos(effective[second]), line: Ast::expr_pos(effective[second]).line, expected: "", actual: ""})
                                second <- second + 1
                            first <- first + 1
                    _:
                        pass

        def lma_walk_expression(expression: Ast::Expr, function_names: darray[sview]&, function_lookup: dict[u64, usize]&, counts: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, position):
                        table <- lma_check_method_call(callee, arguments, argument_names, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(callee, function_names, function_lookup, counts, table)
                        for argument in arguments |table| -> table:
                            table <- lma_walk_expression(argument, function_names, function_lookup, counts, table)
                    Expr.Binary(left, operator, right, position):
                        table <- lma_walk_expression(left, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(right, function_names, function_lookup, counts, table)
                    Expr.Unary(operator, operand, position):
                        table <- lma_walk_expression(operand, function_names, function_lookup, counts, table)
                    Expr.Move(operand, position):
                        table <- lma_walk_expression(operand, function_names, function_lookup, counts, table)
                    Expr.RegionNew(operand, region, position):
                        table <- lma_walk_expression(operand, function_names, function_lookup, counts, table)
                    Expr.Paren(inner, position):
                        table <- lma_walk_expression(inner, function_names, function_lookup, counts, table)
                    Expr.Field(object, field, position):
                        table <- lma_walk_expression(object, function_names, function_lookup, counts, table)
                    Expr.Index(object, index, position):
                        table <- lma_walk_expression(object, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(index, function_names, function_lookup, counts, table)
                    Expr.Slice(object, low, high, position):
                        table <- lma_walk_expression(object, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(low, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(high, function_names, function_lookup, counts, table)
                    Expr.IndexN(object, arguments, position):
                        table <- lma_walk_expression(object, function_names, function_lookup, counts, table)
                        for argument in arguments |table| -> table:
                            table <- lma_walk_expression(argument, function_names, function_lookup, counts, table)
                    Expr.Array(elements, position):
                        for element in elements |table| -> table:
                            table <- lma_walk_expression(element, function_names, function_lookup, counts, table)
                    Expr.Tuple(elements, position):
                        for element in elements |table| -> table:
                            table <- lma_walk_expression(element, function_names, function_lookup, counts, table)
                    Expr.SetLit(elements, position):
                        for element in elements |table| -> table:
                            table <- lma_walk_expression(element, function_names, function_lookup, counts, table)
                    Expr.DictLit(entries, position):
                        for entry in entries |table| -> table:
                            table <- lma_walk_expression(entry.key, function_names, function_lookup, counts, table)
                            table <- lma_walk_expression(entry.value, function_names, function_lookup, counts, table)
                    Expr.Construct(type_expression, fields, position):
                        for field in fields |table| -> table:
                            table <- lma_walk_expression(field.value, function_names, function_lookup, counts, table)
                    Expr.RecordUpdate(base, fields, position):
                        table <- lma_walk_expression(base, function_names, function_lookup, counts, table)
                        for field in fields |table| -> table:
                            table <- lma_walk_expression(field.value, function_names, function_lookup, counts, table)
                    Expr.If(condition, then_expression, else_expression, position):
                        table <- lma_walk_expression(condition, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(then_expression, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(else_expression, function_names, function_lookup, counts, table)
                    Expr.Comprehension(variable, iterable, condition, body, position):
                        table <- lma_walk_expression(iterable, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(condition, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(body, function_names, function_lookup, counts, table)
                    Expr.Lambda(lambda_params, body, position):
                        table <- lma_walk_statements(body, function_names, function_lookup, counts, table)
                    Expr.Block(statements, value, captures, position):
                        table <- lma_walk_statements(statements, function_names, function_lookup, counts, table)
                        table <- lma_walk_expression(value, function_names, function_lookup, counts, table)
                    Expr.Match(scrutinee, arms, position):
                        table <- lma_walk_expression(scrutinee, function_names, function_lookup, counts, table)
                        for arm in arms |table| -> table:
                            table <- lma_walk_expression(arm.guard, function_names, function_lookup, counts, table)
                            table <- lma_walk_statements(arm.body, function_names, function_lookup, counts, table)
                    _:
                        pass

        def lma_walk_statements(statements: darray[Ast::Stmt], function_names: darray[sview]&, function_lookup: dict[u64, usize]&, counts: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, position):
                            table <- lma_walk_expression(expression, function_names, function_lookup, counts, table)
                        Stmt.VarDecl(name, type_expression, value, position):
                            table <- lma_walk_expression(value, function_names, function_lookup, counts, table)
                        Stmt.Assign(target, operator, value, position):
                            table <- lma_walk_expression(target, function_names, function_lookup, counts, table)
                            table <- lma_walk_expression(value, function_names, function_lookup, counts, table)
                        Stmt.If(condition, then_body, else_body, position):
                            table <- lma_walk_expression(condition, function_names, function_lookup, counts, table)
                            table <- lma_walk_statements(then_body, function_names, function_lookup, counts, table)
                            table <- lma_walk_statements(else_body, function_names, function_lookup, counts, table)
                        Stmt.While(condition, body, position):
                            table <- lma_walk_expression(condition, function_names, function_lookup, counts, table)
                            table <- lma_walk_statements(body, function_names, function_lookup, counts, table)
                        Stmt.For(binding, variables, iterable, body, position):
                            table <- lma_walk_expression(iterable, function_names, function_lookup, counts, table)
                            table <- lma_walk_statements(body, function_names, function_lookup, counts, table)
                        Stmt.Block(kind, clause, binding, body, position):
                            table <- lma_walk_statements(body, function_names, function_lookup, counts, table)
                        Stmt.Match(scrutinee, arms, position):
                            table <- lma_walk_expression(scrutinee, function_names, function_lookup, counts, table)
                            for arm in arms |table| -> table:
                                table <- lma_walk_expression(arm.guard, function_names, function_lookup, counts, table)
                                table <- lma_walk_statements(arm.body, function_names, function_lookup, counts, table)
                        Stmt.Return(value, position):
                            table <- lma_walk_expression(return_value, function_names, function_lookup, counts, table) if value is return_value
                        _:
                            pass

        def lma_walk_declarations(declarations: darray[Ast::Decl], function_names: darray[sview]&, function_lookup: dict[u64, usize]&, counts: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, position):
                            table <- lma_walk_statements(body, function_names, function_lookup, counts, table)
                        Decl.Module(module_name, module_body, module_position):
                            table <- lma_walk_declarations(module_body, function_names, function_lookup, counts, table)
                        Decl.Scoped(scoped_body, scoped_position):
                            table <- lma_walk_declarations(scoped_body, function_names, function_lookup, counts, table)
                        _:
                            pass

    public:
        def check_lmut_method_aliasing(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if table.lmut_param_owner.count == 0
                function_names: mutable darray[sview] = []
                starts: mutable darray[usize] = []
                counts: mutable darray[usize] = []
                params: mutable darray[Ast::ParamDecl] = []
                exclusivity_collect_functions(file.top_decls, function_names, starts, counts, params)
                function_lookup: dict[u64, usize] = exclusivity_function_lookup(function_names)
                table <- lma_walk_declarations(file.top_decls, function_names, function_lookup, counts, table)
