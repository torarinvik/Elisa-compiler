# Exact portable identity for check_full_diagnostics semantic options.
# Callers pass already-evaluated values; this module reads no environment,
# source headers, defaults, target settings, or compiler identity.
extend Semantic:
    public:
        const INCREMENTAL_SEMANTIC_OPTIONS_VERSION: u8 = 1
        const INCREMENTAL_SEMANTIC_OPTIONS_KEY_LENGTH: usize = 26

        struct IncrementalSemanticOptions:
            enforce_unsafe_permissions: bool
            flow_strict: bool
            runtime_std: bool
            flow_warn: bool
            enable_smt: bool
            warn_discarded: bool
            enforce_progress: bool
            enforce_extern_contracts: bool
            enforce_raw_unsafe: bool
            emit_proof_hole: bool
            region_stack_cap: i64
            enforce_global_permissions: bool
            enforce_mutable_global_grants: bool
            carrier_surface: bool

        # The argument order intentionally matches check_full_diagnostics,
        # including region_stack_cap between the tenth and eleventh booleans.
        def incremental_semantic_options_from_values(enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> IncrementalSemanticOptions:
            return IncrementalSemanticOptions{enforce_unsafe_permissions: enforce_unsafe_permissions, flow_strict: flow_strict, runtime_std: runtime_std, flow_warn: flow_warn, enable_smt: enable_smt, warn_discarded: warn_discarded, enforce_progress: enforce_progress, enforce_extern_contracts: enforce_extern_contracts, enforce_raw_unsafe: enforce_raw_unsafe, emit_proof_hole: emit_proof_hole, region_stack_cap: region_stack_cap, enforce_global_permissions: enforce_global_permissions, enforce_mutable_global_grants: enforce_mutable_global_grants, carrier_surface: carrier_surface}

        # The output belongs to the caller and remains valid after return. The
        # encoder clears it before writing one exact key and bulk-copies fixed
        # byte spans; it never returns a local growable buffer.
        def incremental_semantic_options_encode(options: IncrementalSemanticOptions, output: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                output.clear()
                output.reserve(INCREMENTAL_SEMANTIC_OPTIONS_KEY_LENGTH)
                magic: u8[5]
                magic[0] <- 69
                magic[1] <- 83
                magic[2] <- 79
                magic[3] <- 80
                magic[4] <- INCREMENTAL_SEMANTIC_OPTIONS_VERSION
                if Lexer::make_source_view(&magic[0], 5, 0, 5) is magic_view:
                    output.extend(magic_view)
                else:
                    return false

                flags: u8[13]
                flags[0] <- 1 if options.enforce_unsafe_permissions else 0
                flags[1] <- 1 if options.flow_strict else 0
                flags[2] <- 1 if options.runtime_std else 0
                flags[3] <- 1 if options.flow_warn else 0
                flags[4] <- 1 if options.enable_smt else 0
                flags[5] <- 1 if options.warn_discarded else 0
                flags[6] <- 1 if options.enforce_progress else 0
                flags[7] <- 1 if options.enforce_extern_contracts else 0
                flags[8] <- 1 if options.enforce_raw_unsafe else 0
                flags[9] <- 1 if options.emit_proof_hole else 0
                flags[10] <- 1 if options.enforce_global_permissions else 0
                flags[11] <- 1 if options.enforce_mutable_global_grants else 0
                flags[12] <- 1 if options.carrier_surface else 0
                if Lexer::make_source_view(&flags[0], 13, 0, 13) is flags_view:
                    output.extend(flags_view)
                else:
                    output.clear()
                    return false

                # Signed i64 is encoded as its exact two's-complement bit pattern,
                # little-endian. Masking each shifted byte handles negative caps.
                cap: u8[8]
                cap[0] <- (options.region_stack_cap & 255).u8()
                cap[1] <- ((options.region_stack_cap >> 8) & 255).u8()
                cap[2] <- ((options.region_stack_cap >> 16) & 255).u8()
                cap[3] <- ((options.region_stack_cap >> 24) & 255).u8()
                cap[4] <- ((options.region_stack_cap >> 32) & 255).u8()
                cap[5] <- ((options.region_stack_cap >> 40) & 255).u8()
                cap[6] <- ((options.region_stack_cap >> 48) & 255).u8()
                cap[7] <- ((options.region_stack_cap >> 56) & 255).u8()
                if Lexer::make_source_view(&cap[0], 8, 0, 8) is cap_view:
                    output.extend(cap_view)
                else:
                    output.clear()
                    return false
                return output.count == INCREMENTAL_SEMANTIC_OPTIONS_KEY_LENGTH

        def incremental_semantic_options_key_valid(key: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if key.count != INCREMENTAL_SEMANTIC_OPTIONS_KEY_LENGTH
                return false if key[0] != 69 or key[1] != 83 or key[2] != 79 or key[3] != 80 or key[4] != INCREMENTAL_SEMANTIC_OPTIONS_VERSION
                for index in 0..<13:
                    return false if key[5 + index] > 1
                return true

        def incremental_semantic_options_key_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if not incremental_semantic_options_key_valid(left) or not incremental_semantic_options_key_valid(right)
                for index in 0..<INCREMENTAL_SEMANTIC_OPTIONS_KEY_LENGTH:
                    return false if left[index] != right[index]
                return true
