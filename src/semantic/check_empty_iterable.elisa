extend Semantic:
    private:
        # Check if an expression is a literally-empty collection.
        # Returns true if the iterable is an empty array, set, or dict literal.
        # Unwraps Paren to check the inner expression.
        def is_empty_iterable(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                expr_to_check: mutable Ast::Expr = expression
                # Unwrap Paren to get to the actual expression
                while expr_to_check is Expr.Paren(inner, line):
                    expr_to_check <- inner

                match expr_to_check:
                    Expr.Array(elements, line):
                        return elements.count == 0
                    Expr.SetLit(elements, line):
                        return elements.count == 0
                    Expr.DictLit(entries, line):
                        return entries.count == 0
                    _:
                        pass
                return false

        # Check for for-loops over literally-empty collections.
        # Flags loops like `for x in []:` or `for x in {}:` that never execute.
        def check_empty_iterable_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.For(bind, variables, iterable, body, line):
                            if is_empty_iterable(iterable):
                                loop_var: sview = variables[0] if variables.count > 0 else ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyIterable, name: loop_var, line: line, expected: "", actual: ""})
                            table <- check_empty_iterable_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_empty_iterable_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_empty_iterable_statements(arm.body, table)
                        Stmt.While(condition, body, line):
                            table <- check_empty_iterable_statements(body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_empty_iterable_statements(then_body, table)
                            table <- check_empty_iterable_statements(else_body, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass


        # Check for empty iterables in all declarations (recursing through Func/Module/Scoped).
        def check_empty_iterable(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_empty_iterable_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_empty_iterable(body, table)
                        Decl.Scoped(body, line):
                            table <- check_empty_iterable(body, table)
                        _:
                            pass
