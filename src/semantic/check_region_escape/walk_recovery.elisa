extend Semantic:
    private:
        # Only a formal region parameter whose source interval contains this block can make
        # `in NAME:` a region-parameter storage scope. Display lines can be reused by #line,
        # and an Arena& sibling's `in owner:` block must not borrow another function's region row.
        def region_escape_has_active_region_param(annotations: darray[Ast::LocalRegionAnnotation]&, region: sview, block_offset: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__region_param" and annotation.region == region and annotation.owner_offset <= block_offset and annotation.end_offset != 0 and block_offset < annotation.end_offset

        def region_escape_walk(statements: darray[Ast::Stmt], function_line: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview @source]&, ref_params: darray[sview @source]&, outer_locals: darray[sview @source]&, param_names: darray[sview @source]&, region_locals: mutable darray[sview @source]&, region_local_regions: mutable darray[sview @source]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, local_type_names: mutable darray[sview @source]&, local_type_exprs: mutable darray[Ast::Expr]& @source, container_structs: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                local_type_mark: usize = local_type_names.count
                region_local_mark: usize = region_locals.count
                region_owner_mark: usize = region_local_regions.count
                taint_mark: usize = taint_names.count
                element_taint_mark: usize = element_taint_names.count
                # A child scope may update an enclosing binding even though declarations
                # made in that scope must not leak out. Keep those two kinds of facts apart
                # when restoring the taint environment below.
                scope_declared_names: mutable darray[sview @source] = []
                collect_level_local_names(statements, scope_declared_names)
                entry_local_names: mutable darray[sview @source] = []
                for entry_name in local_type_names |entry_local_names|:
                    entry_local_names.push(entry_name)
                # Locals visible from a child scope = the enclosing set plus every local declared
                # directly at this level. Passed as the `outer_locals` of child region/control blocks
                # so the outlives check can tell a region-enclosed value stored into an enclosing
                # local (escape) from one stored into a region-body local (fine).
                child_outer_locals: mutable darray[sview @source] = [name for name in outer_locals]
                collect_level_local_names(statements, child_outer_locals)
                for statement in statements |table, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, region_locals, region_local_regions| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            # A `region name:` block selects a concrete region.  The special
                            # `in region_param:` form does too, but `in owner:` is also used for
                            # an Arena& scratch allocator and is handled by check_arena_grow_escape
                            # instead.  Only parser-recorded region parameters are safe to add to
                            # this lexical region stack; treating every `in` name as a region
                            # caused false RegionNestedGrowthEscape diagnostics throughout the
                            # compiler's Arena-based runtime.
                            in_region_param: bool = kind == "in" and clause.count > 0 and clause[0] != "auto" and region_escape_has_active_region_param(annotations, clause[0], line.offset)
                            # A user `in auto:` block frees its arena at block exit (stage0
                            # RegionStmt{UserAuto}); a view stored out of it dangles, so it is a
                            # storage block like `region r:` (stage0 checkRegionlessTargetStoreEscape).
                            in_user_auto: bool = kind == "in" and clause.count > 0 and clause[0] == "auto"
                            is_storage_block: bool = (kind == "region" and clause.count > 0) or in_region_param or in_user_auto
                            region_label: sview @source = clause[0] if clause.count > 0 else sview("", 0, 0)
                            # A `can/trusted Unsafe.StaleRef:` grant discharges the
                            # forwarded-ref-into-global escape inside its body.
                            grants_stale: bool = (kind == "can" or kind == "trusted") and (any grant in clause where grant == "Unsafe.StaleRef" or grant == "StaleRef")
                            # Both child lists used to be built for EVERY block, and for a block
                            # that neither opens a region nor grants StaleRef both are identity
                            # copies — `child_stack` equals `nesting` and `granted_ref_params`
                            # equals `ref_params` by construction. Blocks are everywhere in this
                            # compiler (every `can …:` is one), and each copy allocates into the
                            # walker's auto-region, so the pair cost an mmap and an munmap per
                            # block. Pass the originals when nothing changes.
                            block_type_mark: usize = local_type_names.count
                            if binding != "":
                                local_type_names.push(binding)
                                local_type_exprs.push(Ast::Expr.Absent)
                            # Regions are keyed by NAME here and in every region side table, so a
                            # region reopening the name of one still open around it would be
                            # indistinguishable from it (stage0 analyzeRegionDecl).
                            shadows_open_region: bool = kind == "region" and region_label != "" and (any open_region in nesting where open_region == region_label)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionShadowsEnclosing, name: region_label, pos: line, line: line.line, expected: "", actual: ""}) if shadows_open_region
                            if is_storage_block or grants_stale:
                                child_stack: mutable darray[sview @source] = [entry for entry in nesting]
                                child_stack.push(region_label) if is_storage_block
                                child_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                                child_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                                granted_ref_params: darray[sview @source] = [] if grants_stale else [ref_name for ref_name in ref_params]
                                table <- region_escape_walk(body, function_line, child_stack, annotations, mutable_globals, granted_ref_params, child_outer_locals, param_names, child_region_locals, child_region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            else:
                                child_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                                child_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                                table <- region_escape_walk(body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, child_region_locals, child_region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            local_type_names <- local_type_names.truncate(block_type_mark) if local_type_names.count > block_type_mark
                            local_type_exprs <- local_type_exprs.truncate(block_type_mark) if local_type_exprs.count > block_type_mark
                        Stmt.Expr(expression, line):
                            table <- region_escape_check_store(expression, line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, table)
                            # A captured loop WITH a yield (`for … |t| -> t:`) stays an
                            # Expr.Block in the loop view, so its body was never walked: a
                            # growth inside it escaped every rule here (fuzz F14). Walk its
                            # statements as a plain nested scope.
                            match expression:
                                Expr.Block(captured_statements, captured_value, captured_names, captured_pos):
                                    captured_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                                    captured_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                                    captured_scope: mutable darray[Ast::Stmt] @source = [captured_statement for captured_statement in captured_statements]
                                    if not (captured_value is Ast::Expr.Invalid) and not (captured_value is Ast::Expr.Absent):
                                        captured_scope.push(Ast::Stmt.Expr(captured_value, Ast::expr_pos(captured_value)))
                                    table <- region_escape_walk(captured_scope, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, captured_region_locals, captured_region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                                _:
                                    table <- region_escape_walk_get_else_recovery(expression, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                                    region_escape_record_collection_element_mutation(expression, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, region_escape_catch_context(table))
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- region_escape_check_store(value, line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, table)
                            table <- region_escape_walk_get_else_recovery(value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            region_escape_record_collection_element_mutation(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, region_escape_catch_context(table))
                            declared_type: mutable Ast::Expr = type_expression
                            if declared_type is Ast::Expr.Absent:
                                match value:
                                    Expr.Construct(inferred_construct_type, _, _):
                                        declared_type <- inferred_construct_type
                                    _:
                                        pass
                            local_type_names.push(name)
                            local_type_exprs.push(declared_type)
                            declared_region: mutable sview @source = local_region_name(annotations, name, line.line, line.offset, true)
                            declared_region <- nesting[nesting.count - 1] if declared_region == "" and nesting.count > 0
                            if declared_region != "":
                                region_locals.push(name)
                                region_local_regions.push(declared_region)
                            # A local copied/derived from a region value carries that region's taint.
                            var_region: mutable sview @source = region_escape_stored_or_call_region_with_elements(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, region_escape_catch_context(table))
                            # A fresh local container created lexically inside a region block owns
                            # storage from that block even when its empty literal has no borrowed
                            # input from which provenance can be inferred.
                            if var_region == "" and nesting.count > 0 and member_type_is_owned_container(type_expression) and region_escape_is_fresh_container_value(value):
                                var_region <- nesting[nesting.count - 1]
                            # Likewise a struct BUILT inside the block around a fresh container
                            # literal (`h = HU{bytes: [..]}`): its field's buffer comes from the
                            # block's arena, so a view of `h.bytes` stored outside dangles once
                            # the block frees it (fuzz F4; stage0 tracks this).
                            if var_region == "" and nesting.count > 0 and region_escape_construct_holds_fresh_container(value):
                                var_region <- nesting[nesting.count - 1]
                            # An empty marker is significant: a shadowing declaration with
                            # no region taint must hide an enclosing binding's older taint.
                            element_region: sview @source = region_escape_comprehension_element_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, region_escape_catch_context(table))
                            region_escape_element_taint_set(element_taint_names, element_taint_regions, name, element_region)
                            taint_names.push(name)
                            taint_regions.push(var_region)
                        Stmt.Assign(target, operator, value, line):
                            table <- region_escape_walk_get_else_recovery(target, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            target_aborts: bool = expression_evaluation_aborts(target, table)
                            if not target_aborts:
                                if operator == TokenKind.PlusEq:
                                    table <- region_escape_check_store(collection_append_call(target, value, line), line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, table)
                                table <- region_escape_check_store(value, line.line, nesting, annotations, view_fns, container_fns, mutable_globals, outer_locals, param_names, region_locals, region_local_regions, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, table)
                                table <- region_escape_walk_get_else_recovery(value, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                                region_escape_record_collection_element_mutation(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, region_escape_catch_context(table))
                                table <- region_escape_check_assign(target, value, line.line, nesting, annotations, mutable_globals, ref_params, outer_locals, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, table)
                                assignment_source_taint_names: darray[sview @source] = [name for name in taint_names]
                                assignment_source_taint_regions: darray[sview @source] = [region for region in taint_regions]
                                assignment_source_element_taint_names: darray[sview @source] = [name for name in element_taint_names]
                                assignment_source_element_taint_regions: darray[sview @source] = [region for region in element_taint_regions]
                                region_escape_update_assignment_taints(target, value, operator, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, assignment_source_taint_names, assignment_source_taint_regions, assignment_source_element_taint_names, assignment_source_element_taint_regions, line.line, region_escape_catch_context(table))
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- region_escape_walk_get_else_recovery(returned, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                                returned_region: sview @source = region_escape_stored_or_call_region_with_elements(returned, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, region_escape_catch_context(table))
                                returned_position: (found: bool, position: usize) = region_stack_position(nesting, returned_region)
                                carries_region_handle: bool = region_escape_value_carries_handles(returned, annotations, line.line, local_type_names, local_type_exprs, table)
                                # stage0 words an escaping AGGREGATE (a struct carrying containers) as
                                # "value backed by scope-owned region …" (checkRegionAggregateReturnEscape,
                                # gated on typeCarriesRegionStorage) and a bare container as "value
                                # allocated in region …". Same detection here, different family. The
                                # returned local's DECLARED type decides, looked up against the structs
                                # that actually hold containers -- a plain named type that is not one
                                # of those keeps the container wording rather than guessing.
                                returned_is_aggregate: bool = region_escape_returned_is_aggregate(returned, local_type_names, local_type_exprs, container_structs)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAggregateReturnEscape, name: returned_region, line: line.line, expected: "", actual: returned_region}) if returned_region != "" and returned_position.found and carries_region_handle and returned_is_aggregate
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionReturnEscape, name: "", line: line.line, expected: "", actual: returned_region}) if returned_region != "" and returned_position.found and carries_region_handle and not returned_is_aggregate
                        Stmt.If(condition, then_body, else_body, line):
                            table <- region_escape_walk_get_else_recovery(condition, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            condition_terminates: bool = expression_evaluation_aborts(condition, table)
                            condition_literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(condition)
                            then_reachable: bool = not condition_terminates and (not condition_literal.known or condition_literal.value)
                            else_reachable: bool = not condition_terminates and (not condition_literal.known or not condition_literal.value)
                            branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                            branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                            branch_incoming_element_taint_names: darray[sview @source] = [name for name in element_taint_names]
                            branch_incoming_element_taint_regions: darray[sview @source] = [region for region in element_taint_regions]
                            then_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                            then_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                            else_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                            else_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                            then_taint_names: mutable darray[sview @source] = [name for name in branch_incoming_names]
                            then_taint_regions: mutable darray[sview @source] = [region for region in branch_incoming_regions]
                            else_taint_names: mutable darray[sview @source] = [name for name in branch_incoming_names]
                            else_taint_regions: mutable darray[sview @source] = [region for region in branch_incoming_regions]
                            then_element_taint_names: mutable darray[sview @source] = [name for name in branch_incoming_element_taint_names]
                            then_element_taint_regions: mutable darray[sview @source] = [region for region in branch_incoming_element_taint_regions]
                            else_element_taint_names: mutable darray[sview @source] = [name for name in branch_incoming_element_taint_names]
                            else_element_taint_regions: mutable darray[sview @source] = [region for region in branch_incoming_element_taint_regions]
                            table <- region_escape_walk(then_body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, then_region_locals, then_region_local_regions, view_fns, container_fns, then_taint_names, then_taint_regions, then_element_taint_names, then_element_taint_regions, local_type_names, local_type_exprs, container_structs, table) if then_reachable
                            table <- region_escape_walk(else_body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, else_region_locals, else_region_local_regions, view_fns, container_fns, else_taint_names, else_taint_regions, else_element_taint_names, else_element_taint_regions, local_type_names, local_type_exprs, container_structs, table) if else_reachable
                            then_falls_through: bool = then_reachable and not statements_terminate(then_body, table)
                            else_falls_through: bool = else_reachable and not statements_terminate(else_body, table)
                            if then_falls_through:
                                region_escape_merge_recovery_taints(taint_names, taint_regions, then_taint_names, then_taint_regions, nesting, "", [], true)
                                region_escape_merge_element_taints(element_taint_names, element_taint_regions, then_element_taint_names, then_element_taint_regions, nesting, "", [], true)
                            if else_falls_through:
                                region_escape_merge_recovery_taints(taint_names, taint_regions, else_taint_names, else_taint_regions, nesting, "", [], not then_falls_through)
                                region_escape_merge_element_taints(element_taint_names, element_taint_regions, else_element_taint_names, else_element_taint_regions, nesting, "", [], not then_falls_through)
                        Stmt.While(condition, while_body, line):
                            table <- region_escape_walk_get_else_recovery(condition, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            condition_aborts: bool = expression_evaluation_aborts(condition, table)
                            condition_literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(condition)
                            while_reachable: bool = not condition_aborts and not (condition_literal.known and not condition_literal.value)
                            while_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                            while_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                            while_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                            while_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                            while_element_taint_names: mutable darray[sview @source] = [name for name in element_taint_names]
                            while_element_taint_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                            table <- region_escape_walk(while_body, function_line, nesting, annotations, mutable_globals, ref_params, child_outer_locals, param_names, while_region_locals, while_region_local_regions, view_fns, container_fns, while_taint_names, while_taint_regions, while_element_taint_names, while_element_taint_regions, local_type_names, local_type_exprs, container_structs, table) if while_reachable
                            if while_reachable:
                                region_escape_merge_recovery_taints(taint_names, taint_regions, while_taint_names, while_taint_regions, nesting, "", [])
                                region_escape_merge_element_taints(element_taint_names, element_taint_regions, while_element_taint_names, while_element_taint_regions, nesting, "", [])
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- region_escape_walk_get_else_recovery(iterable, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            iterable_aborts: bool = expression_evaluation_aborts(iterable, table)
                            loop_type_names: mutable darray[sview @source] = [name for name in local_type_names]
                            loop_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                            loop_outer_locals: mutable darray[sview @source] = [name for name in child_outer_locals]
                            loop_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                            loop_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                            loop_element_region: sview @source = region_escape_comprehension_element_region(iterable, annotations, view_fns, container_fns, nesting, loop_taint_names, loop_taint_regions, element_taint_names, element_taint_regions, line.line, region_escape_catch_context(table))
                            loop_element_taint_names: mutable darray[sview @source] = [name for name in element_taint_names]
                            loop_element_taint_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                            for variable in variables |loop_type_names, loop_type_exprs, loop_outer_locals, loop_taint_names, loop_taint_regions, loop_element_taint_names, loop_element_taint_regions|:
                                loop_type_names.push(variable)
                                loop_type_exprs.push(Ast::Expr.Absent)
                                loop_outer_locals.push(variable)
                                loop_taint_names.push(variable)
                                loop_taint_regions.push(loop_element_region)
                                # The row binder may itself be a collection; retain the
                                # element summary conservatively for a nested iteration.
                                region_escape_element_taint_set(loop_element_taint_names, loop_element_taint_regions, variable, loop_element_region)
                            loop_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                            loop_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                            table <- region_escape_walk(for_body, function_line, nesting, annotations, mutable_globals, ref_params, loop_outer_locals, param_names, loop_region_locals, loop_region_local_regions, view_fns, container_fns, loop_taint_names, loop_taint_regions, loop_element_taint_names, loop_element_taint_regions, loop_type_names, loop_type_exprs, container_structs, table) if not iterable_aborts
                            if not iterable_aborts:
                                region_escape_merge_recovery_taints(taint_names, taint_regions, loop_taint_names, loop_taint_regions, nesting, "", variables)
                                region_escape_merge_element_taints(element_taint_names, element_taint_regions, loop_element_taint_names, loop_element_taint_regions, nesting, "", variables)
                        Stmt.Match(scrutinee, arms, line):
                            table <- region_escape_walk_get_else_recovery(scrutinee, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                            branch_incoming_names: darray[sview @source] = [name for name in taint_names]
                            branch_incoming_regions: darray[sview @source] = [region for region in taint_regions]
                            branch_incoming_element_taint_names: darray[sview @source] = [name for name in element_taint_names]
                            branch_incoming_element_taint_regions: darray[sview @source] = [region for region in element_taint_regions]
                            is_catch_match: bool = statement_match_is_catch(table, line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_may_raise: bool = expression_may_raise_catchably(scrutinee, table) if is_catch_match else false
                            scrutinee_terminates: bool = expression_catch_terminates(scrutinee, arms, table, line) if is_catch_match else region_escape_recovery_expression_terminates(scrutinee, table)
                            scrutinee_region: sview @source = region_escape_stored_or_call_region(scrutinee, annotations, view_fns, container_fns, nesting, branch_incoming_names, branch_incoming_regions, line.line, region_escape_catch_context(table))
                            has_falling_match_arm: mutable bool = false
                            arm_index: mutable usize = 0.usize()
                            for arm in arms |table, taint_names, taint_regions, element_taint_names, element_taint_regions, has_falling_match_arm, arm_index| -> table:
                                arm_guard_literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(arm.guard)
                                arm_reachable: mutable bool = not (arm_guard_literal.known and not arm_guard_literal.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch_match else progress_match_arm_reachable(scrutinee, arms, arm_index))
                                arm_reachable <- false if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                                arm_bound_names: mutable darray[sview @source] @source = []
                                region_escape_collect_pattern_binding_names(arm.pattern, arm_bound_names)
                                arm_excluded_names: mutable darray[sview @source] = []
                                for bound_name in arm_bound_names |arm_excluded_names|:
                                    arm_excluded_names.push(bound_name)
                                arm_type_names: mutable darray[sview @source] = [name for name in local_type_names]
                                arm_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                                arm_outer_locals: mutable darray[sview @source] = [name for name in child_outer_locals]
                                arm_taint_names: mutable darray[sview @source] = [name for name in branch_incoming_names]
                                arm_taint_regions: mutable darray[sview @source] = [region for region in branch_incoming_regions]
                                arm_element_taint_names: mutable darray[sview @source] = [name for name in branch_incoming_element_taint_names]
                                arm_element_taint_regions: mutable darray[sview @source] = [region for region in branch_incoming_element_taint_regions]
                                for bound_name in arm_bound_names |arm_type_names, arm_type_exprs, arm_outer_locals, arm_taint_names, arm_taint_regions, arm_element_taint_names, arm_element_taint_regions|:
                                    arm_type_names.push(bound_name)
                                    arm_type_exprs.push(Ast::Expr.Absent)
                                    arm_outer_locals.push(bound_name)
                                    arm_taint_names.push(bound_name)
                                    arm_taint_regions.push(scrutinee_region)
                                    region_escape_element_taint_set(arm_element_taint_names, arm_element_taint_regions, bound_name, REGION_ESCAPE_UNKNOWN_ELEMENT_REGION)
                                arm_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                                arm_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                                if arm_reachable:
                                    table <- region_escape_walk_get_else_recovery(arm.guard, function_line, nesting, annotations, mutable_globals, ref_params, arm_outer_locals, param_names, arm_region_locals, arm_region_local_regions, view_fns, container_fns, arm_taint_names, arm_taint_regions, arm_element_taint_names, arm_element_taint_regions, arm_type_names, arm_type_exprs, container_structs, table)
                                arm_guard_terminates: bool = expression_evaluation_aborts(arm.guard, table) if arm_reachable else true
                                table <- region_escape_walk(arm.body, function_line, nesting, annotations, mutable_globals, ref_params, arm_outer_locals, param_names, arm_region_locals, arm_region_local_regions, view_fns, container_fns, arm_taint_names, arm_taint_regions, arm_element_taint_names, arm_element_taint_regions, arm_type_names, arm_type_exprs, container_structs, table) if arm_reachable and not arm_guard_terminates
                                arm_terminates: bool = arm_guard_terminates or statements_terminate(arm.body, table)
                                if arm_reachable and not scrutinee_terminates and not arm_terminates:
                                    region_escape_merge_recovery_taints(taint_names, taint_regions, arm_taint_names, arm_taint_regions, nesting, "", arm_excluded_names, not has_falling_match_arm)
                                    region_escape_merge_element_taints(element_taint_names, element_taint_regions, arm_element_taint_names, arm_element_taint_regions, nesting, "", arm_excluded_names, not has_falling_match_arm)
                                    has_falling_match_arm <- true
                                arm_index <- arm_index + 1.usize()
                        Stmt.Contract(kind, expression, line):
                            table <- region_escape_walk_get_else_recovery(expression, function_line, nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, region_locals, region_local_regions, view_fns, container_fns, taint_names, taint_regions, element_taint_names, element_taint_regions, local_type_names, local_type_exprs, container_structs, table)
                        _:
                            pass
                local_type_names <- local_type_names.truncate(local_type_mark) if local_type_names.count > local_type_mark
                local_type_exprs <- local_type_exprs.truncate(local_type_mark) if local_type_exprs.count > local_type_mark
                region_locals <- region_locals.truncate(region_local_mark) if region_locals.count > region_local_mark
                region_local_regions <- region_local_regions.truncate(region_owner_mark) if region_local_regions.count > region_owner_mark
                exported_names: mutable darray[sview @source] = []
                exported_regions: mutable darray[sview @source] = []
                for index in taint_mark..<taint_names.count:
                    name: sview @source = taint_names[index]
                    belongs_to_entry: bool = any entry_name in entry_local_names where entry_name == name
                    shadowed_here: bool = any declared_name in scope_declared_names where declared_name == name
                    if belongs_to_entry and not shadowed_here:
                        exported_names.push(name)
                        exported_regions.push(taint_regions[index]) if index < taint_regions.count
                        exported_regions.push("") if index >= taint_regions.count
                taint_names <- taint_names.truncate(taint_mark) if taint_names.count > taint_mark
                taint_regions <- taint_regions.truncate(taint_mark) if taint_regions.count > taint_mark
                for index in 0..<exported_names.count |taint_names, taint_regions, exported_names, exported_regions|:
                    taint_names.push(exported_names[index])
                    taint_regions.push(exported_regions[index])
                exported_element_names: mutable darray[sview @source] = []
                exported_element_regions: mutable darray[sview @source] = []
                for index in element_taint_mark..<element_taint_names.count:
                    name: sview @source = element_taint_names[index]
                    belongs_to_entry: bool = any entry_name in entry_local_names where entry_name == name
                    shadowed_here: bool = any declared_name in scope_declared_names where declared_name == name
                    if belongs_to_entry and not shadowed_here:
                        exported_element_names.push(name)
                        exported_element_regions.push(element_taint_regions[index]) if index < element_taint_regions.count
                        exported_element_regions.push("") if index >= element_taint_regions.count
                element_taint_names <- element_taint_names.truncate(element_taint_mark) if element_taint_names.count > element_taint_mark
                element_taint_regions <- element_taint_regions.truncate(element_taint_mark) if element_taint_regions.count > element_taint_mark
                for index in 0..<exported_element_names.count |element_taint_names, element_taint_regions, exported_element_names, exported_element_regions|:
                    element_taint_names.push(exported_element_names[index])
                    element_taint_regions.push(exported_element_regions[index])


        # A GetElse recovery is a separate control-flow path. Walk it with a snapshot of
        # the enclosing facts so its locals and assignments do not leak into the success
        # path, while still reporting stores performed before the recovery exits.
        # Expression-form match/catch/lambda bodies contain statements rather than child
        # expressions, so analyze their statement flow with the same scope rules as functions.
        # A branch value can diverge through the block/if/match forms produced by the
        # parser. Do not export facts from those paths: only a branch that reaches its
        # continuation contributes to the enclosing flow.
        def region_escape_recovery_literal_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            can Abort.Panic:
                return match expression:
                    Expr.BoolLit(value, _):
                        (true, value)
                    Expr.Paren(inner, _):
                        region_escape_recovery_literal_bool(inner)
                    _:
                        (false, false)

        def region_escape_recovery_expression_terminates(expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Paren(inner, _):
                        region_escape_recovery_expression_terminates(inner, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _):
                        region_escape_recovery_expression_terminates(operand, table)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        region_escape_recovery_expression_terminates(object, table)
                    Expr.Binary(left, operator, right, _):
                        left_terminates: bool = region_escape_recovery_expression_terminates(left, table)
                        return true if left_terminates
                        right_required: mutable bool = operator != TokenKind.And and operator != TokenKind.Or
                        literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(left)
                        right_required <- right_required or (operator == TokenKind.And and literal.known and literal.value) or (operator == TokenKind.Or and literal.known and not literal.value)
                        right_required and region_escape_recovery_expression_terminates(right, table)
                    Expr.Block(statements, value, _, _):
                        statements_terminate(statements, table) or region_escape_recovery_expression_terminates(value, table)
                    Expr.If(condition, then_value, else_value, _):
                        condition_terminates: bool = region_escape_recovery_expression_terminates(condition, table)
                        return true if condition_terminates
                        literal: (known: bool, value: bool) = region_escape_recovery_literal_bool(condition)
                        return region_escape_recovery_expression_terminates(then_value, table) if literal.known and literal.value
                        return region_escape_recovery_expression_terminates(else_value, table) if literal.known and not literal.value
                        region_escape_recovery_expression_terminates(then_value, table) and region_escape_recovery_expression_terminates(else_value, table)
                    Expr.Match(scrutinee, arms, _):
                        region_escape_recovery_expression_terminates(scrutinee, table) or (arms_all_terminate(scrutinee, arms, table) and all arm in arms where arm.guard is Ast::Expr.Absent)
                    Expr.Catch(guarded, arms, line):
                        expression_catch_terminates(guarded, arms, table, line)
                    Expr.GetElse(guarded, _, _):
                        region_escape_recovery_expression_terminates(guarded, table)
                    Expr.Call(callee, arguments, _, _):
                        expression_aborts(expression, table) or region_escape_recovery_expression_terminates(callee, table) or any argument in arguments where region_escape_recovery_expression_terminates(argument, table)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        any child in runtime_children where region_escape_recovery_expression_terminates(child, table)
                    Expr.Refinement(left, right, _):
                        region_escape_recovery_expression_terminates(left, table) or region_escape_recovery_expression_terminates(right, table)
                    Expr.Index(object, index, _):
                        region_escape_recovery_expression_terminates(object, table) or region_escape_recovery_expression_terminates(index, table)
                    Expr.Slice(object, low, high, _):
                        region_escape_recovery_expression_terminates(object, table) or region_escape_recovery_expression_terminates(low, table) or region_escape_recovery_expression_terminates(high, table)
                    Expr.IndexN(object, indices, _):
                        region_escape_recovery_expression_terminates(object, table) or any index in indices where region_escape_recovery_expression_terminates(index, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        any element in elements where region_escape_recovery_expression_terminates(element, table)
                    Expr.DictLit(entries, _):
                        any entry in entries where region_escape_recovery_expression_terminates(entry.key, table) or region_escape_recovery_expression_terminates(entry.value, table)
                    Expr.Construct(_, fields, _):
                        any field in fields where region_escape_recovery_expression_terminates(field.value, table)
                    Expr.RecordUpdate(base, fields, _):
                        region_escape_recovery_expression_terminates(base, table) or any field in fields where region_escape_recovery_expression_terminates(field.value, table)
                    Expr.Comprehension(_, iterable, _, _, _, _):
                        region_escape_recovery_expression_terminates(iterable, table)
                    Expr.Ident(_, _):
                        expression_aborts(expression, table)
                    _:
                        false

        # Analyze a mutually exclusive arm with private facts, then conservatively join its
        # region taints back into the enclosing expression/statement flow. The main walker
        # supplies declaration, assignment, and nested block semantics for statement bodies.
        def region_escape_walk_get_else_recovery_branch(expression: Ast::Expr, statements: darray[Ast::Stmt], incoming_taint_names: darray[sview @source]&, incoming_taint_regions: darray[sview @source]&, incoming_element_taint_names: darray[sview @source]&, incoming_element_taint_regions: darray[sview @source]&, excluded_names: darray[sview @source], function_line: u32, nesting: darray[sview @source]&, annotations: darray[Ast::LocalRegionAnnotation]&, mutable_globals: darray[sview @source]&, ref_params: darray[sview @source]&, outer_locals: darray[sview @source]&, param_names: darray[sview @source]&, region_locals: mutable darray[sview @source]&, region_local_regions: mutable darray[sview @source]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, local_type_names: mutable darray[sview @source]&, local_type_exprs: mutable darray[Ast::Expr]& @source, container_structs: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                branch_nesting: mutable darray[sview @source] = [region for region in nesting]
                branch_region_locals: mutable darray[sview @source] = [name for name in region_locals]
                branch_region_local_regions: mutable darray[sview @source] = [region for region in region_local_regions]
                branch_taint_names: mutable darray[sview @source] = [name for name in incoming_taint_names]
                branch_taint_regions: mutable darray[sview @source] = [region for region in incoming_taint_regions]
                branch_element_taint_names: mutable darray[sview @source] = [name for name in incoming_element_taint_names]
                branch_element_taint_regions: mutable darray[sview @source] = [region for region in incoming_element_taint_regions]
                branch_type_names: mutable darray[sview @source] = [name for name in local_type_names]
                branch_type_exprs: mutable darray[Ast::Expr] @source = [type_expression for type_expression in local_type_exprs]
                if not (expression is Ast::Expr.Absent) and not (expression is Ast::Expr.Invalid):
                    table <- region_escape_walk_get_else_recovery(expression, function_line, branch_nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, branch_region_locals, branch_region_local_regions, view_fns, container_fns, branch_taint_names, branch_taint_regions, branch_element_taint_names, branch_element_taint_regions, branch_type_names, branch_type_exprs, container_structs, table)
                table <- region_escape_walk(statements, function_line, branch_nesting, annotations, mutable_globals, ref_params, outer_locals, param_names, branch_region_locals, branch_region_local_regions, view_fns, container_fns, branch_taint_names, branch_taint_regions, branch_element_taint_names, branch_element_taint_regions, branch_type_names, branch_type_exprs, container_structs, table)
                branch_terminates: mutable bool = statements_terminate(statements, table)
                if not (expression is Ast::Expr.Absent) and not (expression is Ast::Expr.Invalid):
                    branch_terminates <- branch_terminates or region_escape_recovery_expression_terminates(expression, table)
                region_escape_merge_recovery_taints(taint_names, taint_regions, branch_taint_names, branch_taint_regions, nesting, "", excluded_names) if not branch_terminates
                region_escape_merge_element_taints(element_taint_names, element_taint_regions, branch_element_taint_names, branch_element_taint_regions, nesting, "", excluded_names) if not branch_terminates
