# Stage1 semantic — builtin/alias law parameters and the check entry point (`extend
# Semantic: public+private:`). Collects the parameters whose refinement resolves to a
# builtin or aliased law, then `check_refinement_arg_unproven` and `unproven_arg_walk`
# drive every rule over the declarations. Continues
# check_refinement_arg_symbolic.elisa; split out to keep each part under 600 lines.

extend Semantic:
    public:
        # The law-application head of a `T is LAW[...]` / `T is LAW` parameter refinement, or "".
        def rau_builtin_law_head(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                if type_expression is Expr.Binary(base, operator, right, binary_line):
                    if operator == TokenKind.Is:
                        match right:
                            Expr.IndexN(object, arguments, indexn_line):
                                return ident_name_of(object)
                            Expr.Index(object, index, index_line):
                                return ident_name_of(object)
                            Expr.Ident(name, ident_line):
                                return name
                            _:
                                return sview("", 0, 0)
                return sview("", 0, 0)

        # The BUILTIN refinement laws that are NOT entailed by `self >= 0` (an unsigned argument does
        # not satisfy them from its type) and that `collect_law_params` cannot fold (they are
        # compiler-known, often parametric — `Aligned[4096]`). Mirrors check_refinement_is_law.
        def rau_is_unsatisfied_builtin(name: sview) -> bool:
            can Abort.Panic:
                return name == "Aligned" or name == "Divides" or name == "Fits" or name == "MaskedZero"

        # The builtin non-nonneg law a parameter type carries, resolving a one-level `type` alias
        # (`type PageAddr = u64 is Aligned[4096]`) to its target first.
        def rau_param_builtin_law(type_expression: Ast::Expr, alias_target_names: darray[sview]&, alias_targets: darray[Ast::Expr]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = rau_builtin_law_head(type_expression)
                direct return if direct != ""
                alias_name: sview = ident_name_of(type_expression)
                if alias_name != "":
                    probe: mutable usize = 0
                    while probe < alias_target_names.count |probe, alias_name, alias_target_names, alias_targets|:
                        rau_builtin_law_head(alias_targets[probe]) return if alias_target_names[probe] == alias_name
                        probe <- probe + 1
                return sview("", 0, 0)

        # Collect parameters typed `T is <builtin non-nonneg law>[...]` (directly or via a `type`
        # alias) so the unsigned-argument pass can flag an unsigned argument that does not satisfy
        # them. Predicate is Absent (never nonneg-entailed), so uns_check fires for an unsigned arg.
        def collect_builtin_law_params(declarations: darray[Ast::Decl], alias_target_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, out_functions: mutable darray[sview]&, out_indices: mutable darray[usize]&, out_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_functions, out_indices, out_predicates|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            index: mutable usize = 0
                            for parameter in parameters |index, out_functions, out_indices, out_predicates, function_name, alias_target_names, alias_targets|:
                                law_head: sview = rau_param_builtin_law(parameter.type_expression, alias_target_names, alias_targets)
                                if rau_is_unsatisfied_builtin(law_head):
                                    out_functions.push(function_name)
                                    out_indices.push(index)
                                    out_predicates.push((Ast::Expr.Absent))
                                index <- index + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_builtin_law_params(module_body, alias_target_names, alias_targets, out_functions, out_indices, out_predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_builtin_law_params(scoped_body, alias_target_names, alias_targets, out_functions, out_indices, out_predicates)
                        _:
                            pass

        # The USER-law predicate a parameter typed via a `type X = T is Law` alias carries, or Absent.
        # (`takes_nn(a: NN)` with `type NN = i64 is NonNeg` resolves NN -> the NonNeg predicate.)
        def rau_alias_law_predicate(type_expression: Ast::Expr, alias_target_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                alias_name: sview = ident_name_of(type_expression)
                (Ast::Expr.Absent) return if alias_name == ""
                probe: mutable usize = 0
                while probe < alias_target_names.count |probe, alias_name, alias_target_names, alias_targets, law_names, law_predicates|:
                    if alias_target_names[probe] == alias_name:
                        law_head: sview = rau_builtin_law_head(alias_targets[probe])
                        law_probe: mutable usize = 0
                        while law_probe < law_names.count |law_probe, law_head, law_names, law_predicates|:
                            law_predicates[law_probe] return if law_names[law_probe] == law_head
                            law_probe <- law_probe + 1
                    probe <- probe + 1
                return (Ast::Expr.Absent)

        # Register parameters refined via a `type`-alias to a user law (so the unproven-arg pass sees
        # them like a directly `T is Law` parameter).
        def collect_alias_law_params(declarations: darray[Ast::Decl], alias_target_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, out_functions: mutable darray[sview]&, out_indices: mutable darray[usize]&, out_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_functions, out_indices, out_predicates, alias_target_names, alias_targets, law_names, law_predicates|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            index: mutable usize = 0
                            for parameter in parameters |index, out_functions, out_indices, out_predicates, function_name, alias_target_names, alias_targets, law_names, law_predicates|:
                                predicate: Ast::Expr = rau_alias_law_predicate(parameter.type_expression, alias_target_names, alias_targets, law_names, law_predicates)
                                has_law: bool = match predicate:
                                    Expr.Absent: false
                                    _: true
                                if has_law:
                                    out_functions.push(function_name)
                                    out_indices.push(index)
                                    out_predicates.push(predicate)
                                index <- index + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_alias_law_params(module_body, alias_target_names, alias_targets, law_names, law_predicates, out_functions, out_indices, out_predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_alias_law_params(scoped_body, alias_target_names, alias_targets, law_names, law_predicates, out_functions, out_indices, out_predicates)
                        _:
                            pass

        def check_refinement_arg_unproven(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, law_names, law_predicates)
                alias_names: mutable darray[sview] = []
                alias_predicates: mutable darray[Ast::Expr] = []
                collect_refine_aliases(file.top_decls, alias_names, alias_predicates)
                param_functions: mutable darray[sview] = []
                param_indices: mutable darray[usize] = []
                param_predicates: mutable darray[Ast::Expr] = []
                no_base_names: darray[sview] = []
                no_base_values: darray[sview] = []
                collect_law_params(file.top_decls, law_names, law_predicates, alias_names, alias_predicates, no_base_names, no_base_values, false, param_functions, param_indices, param_predicates)
                # Parameters refined via a `type X = T is Law` alias (`a: NN` with `type NN = i64 is
                # NonNeg`) are recognized by resolving the alias to its user law before the walk.
                awl_alias_names: mutable darray[sview] = []
                awl_alias_targets: mutable darray[Ast::Expr] = []
                rau_collect_alias_targets(file.top_decls, awl_alias_names, awl_alias_targets)
                collect_alias_law_params(file.top_decls, awl_alias_names, awl_alias_targets, law_names, law_predicates, param_functions, param_indices, param_predicates)
                table <- unproven_arg_walk(file.top_decls, file.signature_contract_exprs, file.signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, param_functions, param_indices, table)
                # Builtin parametric laws (Aligned/Divides/Fits/MaskedZero) are not folded by
                # collect_law_params; add them for the unsigned-argument pass below (appended AFTER
                # unproven_arg_walk so only uns_walk sees them). Resolves `type` aliases to the law.
                blp_alias_names: mutable darray[sview] = []
                blp_alias_targets: mutable darray[Ast::Expr] = []
                rau_collect_alias_targets(file.top_decls, blp_alias_names, blp_alias_targets)
                collect_builtin_law_params(file.top_decls, blp_alias_names, blp_alias_targets, param_functions, param_indices, param_predicates)
                gi_functions: mutable darray[sview] = []
                gi_indices: mutable darray[usize] = []
                gi_los: mutable darray[i64] = []
                gi_his: mutable darray[i64] = []
                collect_refined_param_bounds(file.top_decls, law_names, law_predicates, gi_functions, gi_indices, gi_los, gi_his)
                const_names: mutable darray[sview] = []
                const_values: mutable darray[i64] = []
                rau_collect_int_consts(file.top_decls, const_names, const_values)
                alias_target_names: mutable darray[sview] = []
                alias_targets: mutable darray[Ast::Expr] = []
                rau_collect_alias_targets(file.top_decls, alias_target_names, alias_targets)
                table <- guard_interval_walk(file.top_decls, file.signature_contract_exprs, file.signature_contract_lines, law_names, law_predicates, alias_target_names, alias_targets, const_names, const_values, gi_functions, gi_indices, gi_los, gi_his, table)
                sym_functions: mutable darray[sview] = []
                sym_indices: mutable darray[usize] = []
                collect_symbolic_range_positions(file.top_decls, law_names, law_predicates, sym_functions, sym_indices)
                table <- symbolic_range_walk(file.top_decls, law_names, law_predicates, alias_names, alias_predicates, sym_functions, sym_indices, table)
                table <- uns_walk(file.top_decls, law_names, alias_names, param_functions, param_indices, param_predicates, table)

    private:
        # A SIGNED integer type name (whose modulo can be negative — the sign follows the dividend).
        def rau_is_signed_int_name(name: sview) -> bool:
            can Abort.Panic:
                return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize" or name == "int" or name == "intptr"

        # Locals declared as a SIGNED-typed modulo (`a: i64 = x % c`): the result can be negative, so
        # it is not provably within any lower-bounded refinement (e.g. NonNeg) — exactly stage0's verdict.
        def collect_signed_mod_locals(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, decl_line):
                            if rau_is_signed_int_name(bare_type_name(type_expression)) and value is Expr.Binary(mod_left, mod_operator, mod_right, mod_line):
                                out.push(name) if mod_operator == TokenKind.Percent
                        _:
                            pass

        def unproven_arg_walk(declarations: darray[Ast::Decl], signature_contract_exprs: darray[Ast::Expr], signature_contract_lines: darray[u32], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, param_functions: darray[sview]&, param_indices: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            refinement_free_params: mutable darray[sview] = []
                            for parameter in parameters |refinement_free_params|:
                                refinement_free_params.push(parameter.name) if param_is_warnable(parameter.type_expression, law_names, law_predicates, alias_names, alias_predicates)
                            # A signed-modulo local is as unprovable as an unrefined param for a
                            # lower-bounded refinement; treat it the same (fact_names still exempts it).
                            collect_signed_mod_locals(body, refinement_free_params)
                            fact_names: mutable darray[sview] = []
                            ur_refinement_fact_names(body, fact_names)
                            # Every identifier named by a signature contract of THIS function
                            # carries a potential assumed fact — never warn on it.
                            sig_index: mutable usize = 0
                            while sig_index < signature_contract_exprs.count |fact_names, sig_index|:
                                collect_idents_in_expr(signature_contract_exprs[sig_index], fact_names) if signature_contract_lines[sig_index] == line
                                sig_index <- sig_index + 1
                            table <- unproven_arg_check_statements(body, line, param_functions, param_indices, refinement_free_params, fact_names, table)
                            # A `-> T is R` refinement return whose returned value is an
                            # unconstrained parameter cannot be proven in [lo, hi] — mirror
                            # stage0's "refinement R on the return of F could not be proven".
                            refined_return: bool = match return_type:
                                present_return_type: type_mentions_refinement(present_return_type, law_names, alias_names)
                                _: false
                            return_upper_bounded: bool = match return_type:
                                present_return_bound: ur_return_upper_bounded(present_return_bound, law_names, law_predicates)
                                _: false
                            return_upper_const: u64 = match return_type:
                                present_return_const: ur_refinement_upper_const(present_return_const)
                                _: 0
                            # A builtin non-nonneg refined return (`-> u64 is Aligned[4096]`) is never
                            # entailed by additive param arithmetic (`x + 1`) nor by a bare param.
                            return_builtin_unsatisfied: bool = match return_type:
                                present_builtin_return: rau_is_unsatisfied_builtin(rau_builtin_law_head(present_builtin_return))
                                _: false
                            plain_param_names: mutable darray[sview] = []
                            for plain_parameter in parameters |plain_param_names, law_names, alias_names|:
                                if not type_mentions_refinement(plain_parameter.type_expression, law_names, alias_names) and not rau_is_unsatisfied_builtin(rau_builtin_law_head(plain_parameter.type_expression)):
                                    plain_param_names.push(plain_parameter.name)
                            table <- unproven_return_check(body, refinement_free_params, fact_names, parameters, return_upper_bounded, return_upper_const, plain_param_names, return_builtin_unsatisfied, function_name, table) if refined_return or return_builtin_unsatisfied
                        Decl.Module(module_name, module_body, module_line):
                            table <- unproven_arg_walk(module_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, param_functions, param_indices, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- unproven_arg_walk(scoped_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, param_functions, param_indices, table)
                        _:
                            pass
