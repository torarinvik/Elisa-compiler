extend Semantic:
    private:
        # Build post-collection import views once. Proven-inactive rows have already been
        # removed by the shared PMA selector; unresolved rows retain their original source
        # annotation in the possible channel, while synthetic PMA markers stay selector-only.
        def semantic_build_import_annotation_views(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                active: darray[Ast::EnumAnnotation] = pma_active_import_annotations(file, table)
                table.definite_import_annotations <- []
                table.possible_import_annotations <- []
                for annotation in active |table|:
                    continue if semantic_is_synthetic_unknown_import_marker(annotation)
                    import_row: bool = annotation.owner == "__from_member" or annotation.owner == "__from_src" or annotation.name == "__using_member" or annotation.name == "__using" or annotation.name == "__binding_wildcard_import" or annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                    continue if not import_row
                    if pma_import_row_branch_uncertain(active, annotation.owner, annotation.name, annotation.module, annotation.line, annotation.offset):
                        table.possible_import_annotations <- table.possible_import_annotations.push(annotation)
                    else:
                        table.definite_import_annotations <- table.definite_import_annotations.push(annotation)

        # Seed the table and register every declaration-level fact the checks read: builtins,
        # parse errors, region type names, ranges, enum and protocol metadata, binder and import
        # annotations, using-alias members and struct layouts. Runs before any body pass.
        def prepare_symbol_table[@file, @destination](file: Ast::File& @file, table: mutable SymbolTable& @destination) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- seed_builtins(table) can Global{Read,Write}
                PhaseTimer::minor("sem:seed_builtins") can Global{Read,Write}
                table <- append_parse_errors(file, table)
                PhaseTimer::minor("sem:append_parse_errors") can Global{Read,Write}
                table <- register_region_type_names(file, table)
                PhaseTimer::minor("sem:register_region_type_names") can Global{Read,Write}
                # BEFORE collect_range: the struct field pass needs to know which structs are
                # column-major. Gather all annotation-only collection metadata in one
                # source-ordered pass; each destination column keeps its own matching-row order.
                table.using_alias_rows <- table.using_alias_rows.truncate(0)
                for annotation in file.enum_annotations |table|:
                    table.soa_layout_owners <- table.soa_layout_owners.push(annotation.owner) if annotation.name == "__layout_soa"
                    if annotation.owner == "__for_binder":
                        table.binder_pos_offsets <- table.binder_pos_offsets.push(annotation.offset)
                        table.binder_pos_values <- table.binder_pos_values.push(annotation.pos)
                    table.quantifier_lines <- table.quantifier_lines.push(annotation.line) if annotation.owner == "__contract_quantifier"
                    table.using_alias_rows <- table.using_alias_rows.push(annotation) if annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                    table.protocol_declarations <- table.protocol_declarations.push(annotation) if annotation.owner == "__protocol_decl"
                    table.generic_extern_names <- table.generic_extern_names.push(annotation.name) if annotation.owner == "__extern_generic_name"
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                PhaseTimer::minor("sem:collect_range") can Global{Read,Write}
                table <- collect_extern_bounds_hints(file.enum_annotations, table)
                PhaseTimer::minor("sem:collect_extern_bounds_hints") can Global{Read,Write}
                table <- collect_payload_enum_metadata(file, table) can Global{Read,Write}
                PhaseTimer::minor("sem:collect_payload_enum_metadata") can Global{Read,Write}
                table <- resolve_protocol_state_declarations(file, table)
                PhaseTimer::minor("sem:resolve_protocol_state_declarations") can Global{Read,Write}
                table.generic_param_lines <- file.generic_param_lines
                table.generic_param_names <- file.generic_param_names
                table.generic_param_owner_offsets <- file.generic_param_owner_offsets
                table <- index_generic_param_names(table) can Global{Read,Write}
                table.protocol_annotations <- file.enum_annotations
                table <- semantic_build_import_annotation_views(file, table)
                definite_import_annotations: darray[Ast::EnumAnnotation] = table.definite_import_annotations
                table <- index_wildcard_imports(table, definite_import_annotations)
                table <- index_binder_annotations(table, file.enum_annotations) can Global{Read,Write}
                PhaseTimer::minor("sem:index_binder_annotations") can Global{Read,Write}
                table <- binding_import_metadata(definite_import_annotations, table)
                PhaseTimer::minor("sem:binding_import_metadata") can Global{Read,Write}
                table.packed_enum_names <- file.packed_enum_names
                table <- register_using_alias_members(definite_import_annotations, table) can Global{Read,Write}
                PhaseTimer::minor("sem:register_using_alias_members") can Global{Read,Write}
                for annotation in file.enum_annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NoncanonicalReturnStyle, name: "", line: annotation.detail_line, expected: "", actual: ""}) if annotation.owner == "__return_style" and annotation.name == "__value_first_return" and annotation.line == 3900000145 and annotation.identity_id == 3900000144
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable":
                        local_binding_row: usize = table.local_binding_names.count
                        table <- table.index_local_binding_exact(annotation.owner, annotation.line, annotation.offset, local_binding_row) can Global{Read,Write}
                        table.local_binding_names <- table.local_binding_names.push(annotation.owner)
                        table.local_binding_lines <- table.local_binding_lines.push(annotation.line)
                        table.local_binding_offsets <- table.local_binding_offsets.push(annotation.offset)
                        table.local_binding_modes <- table.local_binding_modes.push(1) if annotation.name == "__local_binding_mutable"
                        table.local_binding_modes <- table.local_binding_modes.push(-1) if annotation.name == "__local_binding_immutable"
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable" or annotation.name == "__loop_header_accumulator":
                        binding_annotation_row: usize = table.binding_annotations.count
                        table <- table.index_binding_annotation_exact(annotation, binding_annotation_row) can Global{Read,Write}
                        table.binding_annotations <- table.binding_annotations.push(annotation)
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.new_construct_offsets <- table.new_construct_offsets.push(annotation.offset) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.forward_arg_offsets <- table.forward_arg_offsets.push(annotation.offset) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.block_if_offsets <- table.block_if_offsets.push(annotation.offset) if annotation.name == "__block_if"
                    table.query_binder_offsets <- table.query_binder_offsets.push(annotation.offset) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.is_variant_alias_lines <- table.is_variant_alias_lines.push(annotation.line) if annotation.name == "__is_variant_alias"
                    table.is_variant_alias_offsets <- table.is_variant_alias_offsets.push(annotation.offset) if annotation.name == "__is_variant_alias"
                    table.is_variant_alias_names <- table.is_variant_alias_names.push(annotation.owner) if annotation.name == "__is_variant_alias"
                    table.declared_packed_names <- table.declared_packed_names.push(annotation.owner) if annotation.name == "__declared_packed"
                    table.qualified_packed_names <- table.qualified_packed_names.push(annotation.owner) if annotation.name == "__packed_qualified"
                    table.ast_refinement_names <- table.ast_refinement_names.push(annotation.owner) if annotation.name == "__ast_refinement"
                    table.foreign_enum_names <- table.foreign_enum_names.push(annotation.owner) if annotation.name == "__extern_enum"
                    table.open_foreign_enum_names <- table.open_foreign_enum_names.push(annotation.owner) if annotation.name == "__extern_enum_open"
                    table.no_storage_foreign_enum_names <- table.no_storage_foreign_enum_names.push(annotation.owner) if annotation.name == "__extern_enum_no_storage"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                for annotation in definite_import_annotations |table|:
                    table.resolver_name_surface.valid <- false if annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.owner == "__from_member"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using" and not semantic_import_using_row_has_alias_pair(annotation, table)
                    if annotation.name == "__using_alias_target":
                        canonical_target: sview = semantic_import_alias_target_canonical_owner(annotation, table)
                        table.imported_modules <- table.imported_modules.push(canonical_target) if canonical_target != ""
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    # `using Mod as M` — register only a proven-active alias as a module
                    # symbol. Possible aliases remain in possible_import_annotations.
                    table <- table.add_symbol(annotation.owner, SymbolKind.Module, annotation.line, 0, 0, sview("", 0, 0), 0, annotation.offset, annotation.pos) can Global{Read,Write} if annotation.name == "__using_alias" and semantic_import_alias_is_global_winner(annotation, table)
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_modules <- file.enum_common_modules
                table.enum_common_counts <- file.enum_common_counts
                # Validate struct layouts (field types + self-recursion) after symbol
                # collection so the symbol table is complete (all structs/enums registered).
                for region_annotation in file.local_region_annotations |table|:
                    table.region_tied_param_names <- table.region_tied_param_names.push(region_annotation.name) if region_annotation.region != "" and region_annotation.name != "__region_local"
                table <- validate_struct_layouts(file, table)
                PhaseTimer::minor("sem:validate_struct_layouts") can Global{Read,Write}
                # Skip name resolution when the parse failed: a partial AST yields cascading,
                # misleading undefined-name diagnostics that bury the real syntax error.
                # Symbol collection (duplicate-declaration) still runs over whatever parsed.
