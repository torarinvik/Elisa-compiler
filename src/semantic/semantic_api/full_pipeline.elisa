                    PhaseTimer::minor("sem:check_local_region_annotation") can Global{Read,Write}
                    table <- check_destroyed_region(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_destroyed_region") can Global{Read,Write}
                    table <- check_region_storage_stability(loop_view, &view_origin_rows, &view_origin_scopes, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_region_storage_stability") can Global{Read,Write}
                    # Append-only passes 208..210, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 208, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 209, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 210, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_45") can Global{Read,Write}
                    # Classic states do not require predicates. The graph pass
                    # validates declared transitions and rejects mixed derived graphs.
                    # Append-only passes 211..218, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 211, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 212, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 213, 4) can Global{Read,Write}
