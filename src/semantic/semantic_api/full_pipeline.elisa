                    table <- check_extern_bounds(loop_view.top_decls, bounds_rows, file.enum_annotations, file.annotation_args, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, table)
                    PhaseTimer::minor("sem:check_extern_bounds") can Global{Read,Write}
                    # Append-only passes 152..153, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 152, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_33") can Global{Read,Write}
                    if enforce_extern_contracts:
                        extern_opaque_names: mutable darray[sview] = []
                        collect_extern_opaque_names(file.top_decls, &extern_opaque_names)
                        table <- check_extern_contract(loop_view.top_decls, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, file.extern_params, file.enum_annotations, extern_opaque_names, table)
                    table <- check_ensures_structural(loop_view, table)
                    PhaseTimer::minor("sem:check_ensures_structural") can Global{Read,Write}
                    # Append-only passes 154..156, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 154, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 155, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 156, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_34") can Global{Read,Write}
                    for new_auto_annotation in file.enum_annotations |table|:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NewAutoDeprecated, name: "", line: new_auto_annotation.line, expected: "", actual: ""}) if new_auto_annotation.owner == "__new_auto"
                    # Append-only passes 157..160, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 157, 2) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 159, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 160, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_35") can Global{Read,Write}
                    table <- check_lmut_mutation_reassignment(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_lmut_mutation_reassignment") can Global{Read,Write}
                    # Append-only passes 161..163, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 161, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 162, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 163, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_36") can Global{Read,Write}
                    table <- check_defer_rules(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_defer_rules") can Global{Read,Write}
                    # Append-only passes 164..166, run concurrently (semantic_parallel.elisa).
