                    PhaseTimer::minor("sem:check_decreases_unmodelable") can Global{Read,Write}
                    # Append-only passes 150..151, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 150, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 151, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_32") can Global{Read,Write}
