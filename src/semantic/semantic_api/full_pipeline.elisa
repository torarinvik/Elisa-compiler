                    table <- check_unknown_field_access(loop_view.top_decls, file.extern_params, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, file.enum_annotations, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_unknown_field_access") can Global{Read,Write}
                    table <- check_is_pattern_field(loop_view.top_decls, table)
