                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 183, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_39") can Global{Read,Write}
                    if flow_strict:
                        flagged_if_lines: mutable darray[u32] = []
                        flow_strict_flagged_if_lines(file.top_decls, table.block_if_lines, flagged_if_lines)
                        for flagged_line in flagged_if_lines |table|:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowStrictBlockIf, name: "", line: flagged_line, expected: "", actual: ""})
                    # PATH-GATED IN STAGE0 (semantic/runtime_carrier_warnings.go,
                    # shouldRejectRuntimeCarrierTypeUse): the whole carrier surface is
                    # silent when the analyzed source has no real on-disk path, sits under
                    # an internal root (elisacore_std/, Code/frontend_elisacore/, ...), or
                    # -- for Arena/ArenaMark -- lives under the system temp directory. The
                    # caller owns that predicate because only it knows the path; a pathless
                    # analysis (stdin, a replayed oracle row) passes false.
                    # Append-only passes 185..190, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 185, 6) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_40") can Global{Read,Write}
                    table <- check_unused_decreases(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_unused_decreases") can Global{Read,Write}
                    # Append-only passes 191..194, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 191, 4) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_41") can Global{Read,Write}
                    table <- check_ambiguous_error_variant(loop_view, table)
                    PhaseTimer::minor("sem:check_ambiguous_error_variant") can Global{Read,Write}
                    table <- check_private_member_access(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_private_member_access") can Global{Read,Write}
                    table <- check_private_fields(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_private_fields") can Global{Read,Write}
                    # Append-only passes 195..196, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 195, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_42") can Global{Read,Write}
                    table <- check_errorset_shadow(loop_view, table)
                    PhaseTimer::minor("sem:check_errorset_shadow") can Global{Read,Write}
                    # Append-only passes 197..203, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 197, 7) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_43") can Global{Read,Write}
                    while suffix_index < file.numeric_suffix_names.count |suffix_index: usize = 0|:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NumericLiteralSuffix, name: file.numeric_suffix_names[suffix_index], line: file.numeric_suffix_lines[suffix_index], expected: "", actual: ""})
                        suffix_index <- suffix_index + 1
                    # Append-only passes 204..207, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 204, 4) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_44") can Global{Read,Write}
                    table <- check_local_region_annotation(loop_view, table)
                    PhaseTimer::minor("sem:check_local_region_annotation") can Global{Read,Write}
                    table <- check_destroyed_region(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_destroyed_region") can Global{Read,Write}
                    table <- check_region_storage_stability(loop_view, &view_origin_rows, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_region_storage_stability") can Global{Read,Write}
                    # Append-only passes 208..210, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 208, 3) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_45") can Global{Read,Write}
                    # Classic states do not require predicates. The graph pass
                    # validates declared transitions and rejects mixed derived graphs.
                    # Append-only passes 211..218, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 211, 8) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_46") can Global{Read,Write}
                    table <- collect_tuple_binding_spellings(file, table)
                    PhaseTimer::minor("sem:collect_tuple_binding_spellings") can Global{Read,Write}
                    table <- check_tuple_var_scalar_mismatch(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_tuple_var_scalar_mismatch") can Global{Read,Write}
                    table <- check_static_string_binding(loop_view, table)
                    PhaseTimer::minor("sem:check_static_string_binding") can Global{Read,Write}
                    table <- check_packed_move_store(loop_view, table)
                    PhaseTimer::minor("sem:check_packed_move_store") can Global{Read,Write}
                    table <- check_packed_match_store(loop_view.top_decls, file.enum_annotations, table)
                    PhaseTimer::minor("sem:check_packed_match_store") can Global{Read,Write}
                    table <- check_unknown_function_annotation(loop_view, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_unknown_function_annotation") can Global{Read,Write}
                    # Append-only passes 219..220, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 219, 2) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_47") can Global{Read,Write}
                    table <- check_atomic_payload(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_atomic_payload") can Global{Read,Write}
                    # LAST: it reads the diagnostics every check above produced.
                    table <- check_call_of_invalid(file, table)
                    PhaseTimer::minor("sem:check_call_of_invalid") can Global{Read,Write}
                    table <- check_poisoned_operand(file, table)
                    PhaseTimer::minor("sem:check_poisoned_operand") can Global{Read,Write}
                return
