                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 144, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_30") can Global{Read,Write}
                    # view_return_origin_rows' fixpoint is shared by two passes; compute it once.
                    view_origin_scopes: mutable darray[u64] = []
                    view_origin_rows: darray[sview @source] = view_return_origin_rows(loop_view, view_origin_scopes) can Global{Read,Write}
                    table <- check_local_view_return_escape(loop_view, &view_origin_rows, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_local_view_return_escape") can Global{Read,Write}
                    # Append-only passes 145..149, run concurrently (semantic_parallel.elisa).
