                    table <- check_region_tied_return(loop_view, runtime_std, table)
                    PhaseTimer::minor("sem:check_region_tied_return") can Global{Read,Write}
                    table <- check_region_param_bare_return(loop_view, table)
                    PhaseTimer::minor("sem:check_region_param_bare_return") can Global{Read,Write}
                    table <- check_quantified_refinement(loop_view.top_decls, table)
