                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 203, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_43") can Global{Read,Write}
                    while suffix_index < file.numeric_suffix_names.count |suffix_index: usize = 0|:
                        suffix_name: sview @source = file.numeric_suffix_names[suffix_index]
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NumericLiteralSuffix, name: suffix_name, line: file.numeric_suffix_lines[suffix_index], expected: "", actual: ""})
                        suffix_index <- suffix_index + 1
                    # Append-only passes 204..207, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 204, 1) can Global{Read,Write}
