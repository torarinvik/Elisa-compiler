                    table <- check_law_refinement_violated(loop_view, table)
                    PhaseTimer::minor("sem:check_law_refinement_violated") can Global{Read,Write}
                    table <- check_ensures_assign_violated(loop_view, table)
                    PhaseTimer::minor("sem:check_ensures_assign_violated") can Global{Read,Write}
                    table <- check_precondition_multiparam(loop_view, table)
                    PhaseTimer::minor("sem:check_precondition_multiparam") can Global{Read,Write}
                    table <- check_struct_field_violated(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_violated") can Global{Read,Write}
                    table <- check_struct_field_law_violated(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_law_violated") can Global{Read,Write}
                    # Append-only passes 183..184, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 183, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 184, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_39") can Global{Read,Write}
                    if flow_strict:
                        flagged_if_lines: mutable darray[u32] = []
                        flow_strict_flagged_if_lines(file.top_decls, table.block_if_lines, table.block_if_offsets, flagged_if_lines)
                        for flagged_line in flagged_if_lines |table|:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowStrictBlockIf, name: "", line: flagged_line, expected: "", actual: ""})
                    # PATH-GATED IN STAGE0 (semantic/runtime_carrier_warnings.go,
                    # shouldRejectRuntimeCarrierTypeUse): the whole carrier surface is
                    # silent when the analyzed source has no real on-disk path, sits under
                    # an internal root (elisacore_std/, Code/frontend_elisacore/, ...), or
                    # -- for Arena/ArenaMark -- lives under the system temp directory. The
                    # caller owns that predicate because only it knows the path; a pathless
                    # analysis (stdin, a replayed oracle row) passes false.
                    # Append-only passes 185..190, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 185, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 186, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 187, 1) can Global{Read,Write}
