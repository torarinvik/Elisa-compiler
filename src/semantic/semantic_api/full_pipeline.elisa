                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 165, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 166, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_37") can Global{Read,Write}
                    table <- check_mutate_while_iterating(loop_view, table)
                    PhaseTimer::minor("sem:check_mutate_while_iterating") can Global{Read,Write}
                    # Append-only passes 167..182, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 167, 3) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 170, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 171, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 172, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 173, 7) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 180, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 181, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 182, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_38") can Global{Read,Write}
                    table <- check_struct_field_where_scope(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_where_scope") can Global{Read,Write}
                    table <- check_struct_field_construct_unproven(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_struct_field_construct_unproven") can Global{Read,Write}
