                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 15, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 16, 6) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 22, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 23, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 24, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 25, 2) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 27, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 28, 1) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 29, 6) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_4") can Global{Read,Write}
                    table <- check_float_equality(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_float_equality") can Global{Read,Write}
                    table <- check_negative_index(loop_view.top_decls, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_negative_index") can Global{Read,Write}
                    # Append-only passes 35..42, run concurrently (semantic_parallel.elisa).
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 35, 7) can Global{Read,Write}
                    table <- par_pass_run(file, flags, table, shared_pool, loop_view, 42, 1) can Global{Read,Write}
                    PhaseTimer::minor("sem:par_run_5") can Global{Read,Write}
                    table <- check_negated_comparison(loop_view.top_decls, table)
                    PhaseTimer::minor("sem:check_negated_comparison") can Global{Read,Write}
                    table <- check_field_access_on_primitive(loop_view.top_decls, file.extern_params, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, file.enum_annotations, table) can Global{Read,Write}
                    PhaseTimer::minor("sem:check_field_access_on_primitive") can Global{Read,Write}
                    table <- check_static_if_condition(file, loop_view.top_decls, file.static_if_conds, file.static_if_lines, file.static_if_offsets, file.static_if_kinds, table)
                    PhaseTimer::minor("sem:check_static_if_condition") can Global{Read,Write}
                    table <- check_index_non_indexable(loop_view.top_decls, table)
                    table <- check_slice_raw_ref(loop_view.top_decls, file.enum_annotations, table)
                    PhaseTimer::minor("sem:check_index_non_indexable") can Global{Read,Write}
                    table <- check_firm_arg_type_mismatch(loop_view, table) can Global{Read,Write}
