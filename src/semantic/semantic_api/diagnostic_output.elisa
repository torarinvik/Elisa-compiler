extend Semantic:
    public:
        # Keep the primary source-backed fields in their source region, and copy the
        # supplemental table-owned text so the result survives the SymbolTable scratch arena.
        def diagnostic_output_text[@r](text: sview, text_buffers: mutable darray[darray[u8] @r]& @r) -> sview @r:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return "" if text.len == 0
                panic("semantic: invalid diagnostic text length") if text.len < 0
                bytes: mutable darray[u8] @r = []
                bytes.extend(text)
                text_buffers.push(bytes)
                stored_index: usize = text_buffers.count - 1.usize()
                return unsafe_sview_bounded_bytes(&text_buffers[stored_index][0], text_buffers[stored_index].count)

        def diagnostic_export[@output](source: Diagnostic, text_buffers: mutable darray[darray[u8] @output]& @output, diagnostics: mutable darray[Diagnostic]& @output) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                diagnostics.push(Diagnostic{
                    # These fields are explicitly source-backed by Diagnostic's type and
                    # remain views into the input source region. Only supplemental fields
                    # can point into the temporary SymbolTable, so copy those below.
                    name: source.name,
                    expected: source.expected,
                    actual: source.actual,
                    detail: diagnostic_output_text(source.detail, text_buffers),
                    const_enum_module_expected: diagnostic_output_text(source.const_enum_module_expected, text_buffers),
                    const_enum_module_actual: diagnostic_output_text(source.const_enum_module_actual, text_buffers),
                    detail2: diagnostic_output_text(source.detail2, text_buffers),
                    detail3: diagnostic_output_text(source.detail3, text_buffers),
                    effect_ref_1: diagnostic_output_text(source.effect_ref_1, text_buffers),
                    effect_ref_2: diagnostic_output_text(source.effect_ref_2, text_buffers),
                    effect_ref_3: diagnostic_output_text(source.effect_ref_3, text_buffers),
                    effect_ref_4: diagnostic_output_text(source.effect_ref_4, text_buffers),
                    effect_ref_5: diagnostic_output_text(source.effect_ref_5, text_buffers),
                    effect_ref_6: diagnostic_output_text(source.effect_ref_6, text_buffers),
                    effect_ref_7: diagnostic_output_text(source.effect_ref_7, text_buffers),
                    effect_ref_8: diagnostic_output_text(source.effect_ref_8, text_buffers),
                    error_set: diagnostic_output_text(source.error_set, text_buffers),
                    line: source.line,
                    pos: source.pos,
                    kind: source.kind,
                    expected_count: source.expected_count,
                    actual_count: source.actual_count,
                    state_code: source.state_code,
                    secondary_line: source.secondary_line,
                    secondary_column: source.secondary_column,
                    secondary_end_column: source.secondary_end_column,
                    effect_ref_count: source.effect_ref_count
                })

        # Compatibility entry for callers that do not supply a validated prior snapshot.
        # It always runs the ordinary full checker.
        def check_full_into[@file, @table](file: Ast::File& @file, table: mutable SymbolTable& @table, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                # Build the canonical empty snapshot through the region-aware constructor.
                # Hand-assembling its nested buffers here made the compatibility bridge
                # appear to pass function-local descriptors through the mutable table call.
                snapshot_slots: mutable darray[IncrementalSemanticSnapshot[table]] @table = [incremental_empty_snapshot[table]()]
                counters: mutable darray[u64] @table = [0, 0, 0, 0]
                table <- check_full_into_with_incremental_snapshot[file, table, table, table](file, table, enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot_slots[0], counters[0], counters[1], counters[2], counters[3]) can Global{Read,Write}


        # Trusted-caller driver bridge: snapshot must come from current-source collection or
        # the opaque session API. Never pass a decoded disk-sidecar snapshot directly here.
        # The full SymbolTable uses a short scratch region; resolver session/context values are
        # borrowed only during the synchronous check and are never retained in the table.
        # to this call: returning it or threading it through the driver's region keeps every
        # semantic side table alive while LLVM builds its module. Only the located diagnostics
        # cross the boundary, so the table's region can be reclaimed before backend emission.
        def check_full_diagnostics_with_incremental_snapshot[@file, @output, @snapshot, @snapshot_borrow](file: Ast::File& @file, diagnostics: mutable darray[Diagnostic]& @output, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool, snapshot: IncrementalSemanticSnapshot[snapshot]& @snapshot_borrow, incremental_skip_count: mutable u64&, effect_source_bodies_skipped: mutable u64&, ungranted_panic_bodies_skipped: mutable u64&, global_permission_axis_scans_skipped: mutable u64&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                # Match the context lifetime to the diagnostics/table region. The resolver
                # walks capture the borrowed context while building the local SymbolTable.
                lookup_contexts: mutable darray[IncrementalSemanticNameLookupContext[output]] @output = []
                lookup_session: mutable IncrementalSemanticSession[output]&? @output = null
                incremental_semantic_name_lookup_context_disabled_push(&lookup_contexts)
                # Keep this output-region context alive while the synchronous checker runs.
                check_full_diagnostics_with_incremental_snapshot_and_lookup_context[file, output, snapshot, snapshot_borrow, output, output, output, output](file, diagnostics, enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot, incremental_skip_count, effect_source_bodies_skipped, ungranted_panic_bodies_skipped, global_permission_axis_scans_skipped, lookup_session, lookup_contexts[0]) can Global{Read,Write}

        def check_full_diagnostics_with_incremental_snapshot_and_lookup_context[@file, @output, @snapshot, @snapshot_borrow, @session, @request, @session_borrow, @request_borrow](file: Ast::File& @file, diagnostics: mutable darray[Diagnostic]& @output, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool, snapshot: IncrementalSemanticSnapshot[snapshot]& @snapshot_borrow, incremental_skip_count: mutable u64&, effect_source_bodies_skipped: mutable u64&, ungranted_panic_bodies_skipped: mutable u64&, global_permission_axis_scans_skipped: mutable u64&, lookup_session: mutable IncrementalSemanticSession[session]&? @session_borrow, lookup_context: mutable IncrementalSemanticNameLookupContext[request]& @request_borrow) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                region semantic_table:
                    tables: mutable darray[SymbolTable] @semantic_table = [SymbolTable()]
                    check_full_into_with_incremental_snapshot_and_lookup_context[file, semantic_table, snapshot, snapshot_borrow, session, request, session_borrow, request_borrow](file, tables[0], enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot, incremental_skip_count, effect_source_bodies_skipped, ungranted_panic_bodies_skipped, global_permission_axis_scans_skipped, lookup_session, lookup_context) can Global{Read,Write}
                    diagnostic_text_buffers: mutable darray[darray[u8] @output] @output = []
                    # A non-exhaustive match makes its function fall through, so stage1 reported
                    # BOTH "missing variants: …" and «"f" must return a value» for one defect;
                    # stage0 reports only the first. Suppressed here rather than at the push site
                    # because the missing-return check runs FIRST — at that point the diagnostic it
                    # should defer to has not been created yet.
                    # Three independent checks decide an `ensure` is unproven -- the strict walk,
                    # the void-result contract pass and the branch-const pass -- and a function whose
                    # postcondition none of them can discharge tripped all three, so one clause warned
                    # up to THREE times. stage0 never reports two ensure findings at one location
                    # (measured over the 928 internal-suite rows that carry the sentence), so the
                    # second and later copies of a (function, line, detail) are dropped here.
                    # Filtering on the way OUT rather than at the push sites keeps the UNION of what
                    # the three can prove -- which is what stage0 reports -- without teaching each
                    # check about the other two. It cannot be done inside the table: a locally built
                    # replacement for `table.diagnostics` escapes its `in auto:` scope, and stage0
                    # rejects that outright.
                    #
                    # A REFUTED postcondition also reads as unproven, so the refuter and the provers
                    # both fired and stage1 printed the violation AND the weaker sentence for one
                    # clause; stage0 prints the violation alone.
                    error_set_lines: mutable darray[u32] = []
                    error_set_names: mutable darray[sview] = []
                    collect_function_error_sets(file.top_decls, file.enum_annotations, error_set_lines, error_set_names)
                    refuted_lines: mutable darray[u32] = []
                    for refuted_line_probe in tables[0].diagnostics |refuted_lines|:
                        refuted_lines.push(refuted_line_probe.line) if diagnostic_refutes_obligation(refuted_line_probe.kind)
                    ensure_violated_names: mutable darray[sview] = []
                    ensure_violated_lines: mutable darray[u32] = []
                    for violated_probe in tables[0].diagnostics |ensure_violated_names, ensure_violated_lines|:
                        if violated_probe.kind == DiagnosticKind.EnsureNotProven and violated_probe.detail == "violated":
                            ensure_violated_names.push(violated_probe.name)
                            ensure_violated_lines.push(violated_probe.line)
                    ensure_seen_names: mutable darray[sview] = []
                    ensure_seen_lines: mutable darray[u32] = []
                    ensure_seen_details: mutable darray[sview] = []
                    diagnostic_count: usize = tables[0].diagnostics.count
                    # Exact-duplicate filter over `diagnostics`, chained by a field hash; the
                    # full field comparison below still decides a match.
                    emitted_heads: mutable dict[u64, usize] = {}
                    emitted_next: mutable darray[usize] = []
                    for existing_index in 0..<diagnostics.count |emitted_heads, emitted_next|:
                        existing_key: u64 = diagnostic_dedupe_key(diagnostics[existing_index])
                        emitted_next.push(head if emitted_heads.get(existing_key) is head else diagnostics.count + diagnostic_count)
                        emitted_heads <- emitted_heads.put(existing_key, existing_index)
                    for diagnostic_index in 0..<diagnostic_count |diagnostic_index, diagnostics, diagnostic_text_buffers, tables, ensure_seen_names, ensure_seen_lines, ensure_seen_details, ensure_violated_names, ensure_violated_lines, refuted_lines, error_set_lines, error_set_names, emitted_heads, emitted_next|:
                        diagnostic: Diagnostic = tables[0].diagnostics[diagnostic_index]
                        skip: mutable bool = diagnostic.kind == DiagnosticKind.MissingReturnValue and line_has_non_exhaustive_diagnostic(tables[0], diagnostic.line)
                        shape_row_has_no_extents: bool = diagnostic.kind == DiagnosticKind.FixedArrayShapeMismatch and diagnostic.name != "return" and diagnostic.expected_count == 0 and diagnostic.actual_count == 0
                        skip <- true if shape_row_has_no_extents and poe_line_has_other_kind(tables[0], diagnostic.line, DiagnosticKind.FixedArrayShapeMismatch)
                        skip <- true if diagnostic.kind == DiagnosticKind.MatchArmEnumType and poe_arm_pair_reported(tables[0], diagnostic.expected, diagnostic.name)
                        skip <- true if diagnostic.kind == DiagnosticKind.ContractEnsureResultVoid and poe_line_has_other_kind(tables[0], diagnostic.line, DiagnosticKind.ContractEnsureResultVoid)
                        skip <- true if diagnostic.kind == DiagnosticKind.GenericOperatorNoBound and poe_line_has_other_kind(tables[0], diagnostic.line, DiagnosticKind.GenericOperatorNoBound)
                        skip <- true if diagnostic.kind == DiagnosticKind.RegionReturnEscape and rre_line_outranked(tables[0], diagnostic.line)
                        # A derived-state literal that fails as a constructor fails as the result too;
                        # stage0 reports the struct-literal sentence alone.
                        skip <- true if diagnostic.kind == DiagnosticKind.DerivedStateResultMismatch and poe_line_has_kind(tables[0], diagnostic.line, DiagnosticKind.DerivedStateConstructorMismatch)
                        # The generic `in auto:` escape restates a named region escape on that return.
                        skip <- true if diagnostic.kind == DiagnosticKind.AutoRegionReturnEscape and rre_line_outranked(tables[0], diagnostic.line)
                        # The raw string-view checks name a reference value just "reference"; when a
                        # precise check reported the same expression with its `T&` type, stage0
                        # prints only that sentence.
                        skip <- true if (diagnostic.actual == "reference" or diagnostic.actual == "raw reference") and poe_pos_has_precise_reference(tables[0], diagnostic)
                        # stage0 stops at the FIRST defect in a construct and never reports what
                        # follows FROM it. Three pairs MEASURED against it, each of which stage1
                        # reported as two rows where stage0 gives one:
                        #   `n: i64 = x + 1` with `x: cstr`  -> the operator error alone
                        #   `for i in lo..10` with `lo: f64` -> the ambiguous-`..` error alone
                        #   `for x, x in pairs` over darray  -> the tuple-iterable error alone
                        # Each is keyed on the SPECIFIC kind that poisons it, never on "some
                        # diagnostic shares this line".
                        skip <- true if diagnostic.kind == DiagnosticKind.TypeMismatch and poe_line_has_operand_poison(tables[0], diagnostic.line)
                        skip <- true if diagnostic.kind == DiagnosticKind.RangeBoundNonIntegral and poe_line_has_kind(tables[0], diagnostic.line, DiagnosticKind.AmbiguousBareRange)
                        skip <- true if diagnostic.kind == DiagnosticKind.DuplicatePatternBinding and poe_line_has_kind(tables[0], diagnostic.line, DiagnosticKind.TupleIterableNotTuple)
                        if diagnostic_leaves_obligation_open(diagnostic.kind):
                            for refuted_line in refuted_lines |skip, diagnostic|:
                                skip <- true if refuted_line == diagnostic.line
                        if diagnostic.kind == DiagnosticKind.EnsureNotProven:
                            ensure_seen: mutable bool = false
                            for ensure_probe in 0..<ensure_seen_names.count |ensure_seen, ensure_seen_names, ensure_seen_lines, ensure_seen_details, diagnostic|:
                                ensure_seen <- true if ensure_seen_names[ensure_probe] == diagnostic.name and ensure_seen_lines[ensure_probe] == diagnostic.line and ensure_seen_details[ensure_probe] == diagnostic.detail
                            if diagnostic.detail != "violated":
                                for refuted_probe in 0..<ensure_violated_names.count |ensure_seen, ensure_violated_names, ensure_violated_lines, diagnostic|:
                                    ensure_seen <- true if ensure_violated_names[refuted_probe] == diagnostic.name and ensure_violated_lines[refuted_probe] == diagnostic.line
                            if not ensure_seen:
                                ensure_seen_names.push(diagnostic.name)
                                ensure_seen_lines.push(diagnostic.line)
                                ensure_seen_details.push(diagnostic.detail)
                            skip <- true if ensure_seen
                        dedupe_key: u64 = diagnostic_dedupe_key(diagnostic)
                        emitted_index: mutable usize = head if emitted_heads.get(dedupe_key) is head else diagnostics.count
                        while emitted_index < diagnostics.count and not skip |emitted_index, skip|:
                            emitted: Diagnostic = diagnostics[emitted_index]
                            skip <- true if emitted.kind == diagnostic.kind and emitted.line == diagnostic.line and emitted.pos.column == diagnostic.pos.column and emitted.pos.end_column == diagnostic.pos.end_column and emitted.name == diagnostic.name and emitted.expected == diagnostic.expected and emitted.actual == diagnostic.actual and emitted.detail == diagnostic.detail
                            emitted_index <- emitted_next[emitted_index]
                        out_row: mutable Diagnostic = diagnostic
                        out_row.error_set <- diag_return_error_set(error_set_lines, error_set_names, diagnostic.name, diagnostic.line)
                        if not skip:
                            emitted_next.push(head if emitted_heads.get(dedupe_key) is head else diagnostics.count + diagnostic_count)
                            emitted_heads <- emitted_heads.put(dedupe_key, diagnostics.count)
                            diagnostic_export(out_row, diagnostic_text_buffers, diagnostics)
                    for table_value in move tables:
                        _ = move table_value


        def diagnostic_dedupe_key(diagnostic: Diagnostic) -> u64:
            can Abort.Panic:
                key: mutable u64 = name_hash(diagnostic.name) ^ (diagnostic.line.u64() * 0x9E3779B97F4A7C15)
                key <- (key ^ name_hash(diagnostic.expected)) * SEMANTIC_HASH_PRIME
                key <- (key ^ name_hash(diagnostic.actual)) * SEMANTIC_HASH_PRIME
                return (key ^ name_hash(diagnostic.detail)) * SEMANTIC_HASH_PRIME

        # Existing diagnostic callers remain explicitly cold until they opt into the
        # snapshot-aware sibling above.
        def check_full_diagnostics[@file, @output](file: Ast::File& @file, diagnostics: mutable darray[Diagnostic]& @output, enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                snapshot_slots: mutable darray[IncrementalSemanticSnapshot[output]] @output = [incremental_empty_snapshot[output]()]
                counters: mutable darray[u64] @output = [0, 0, 0, 0]
                check_full_diagnostics_with_incremental_snapshot[file, output, output, output](file, diagnostics, enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt, warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe, emit_proof_hole, region_stack_cap, enforce_global_permissions, enforce_mutable_global_grants, carrier_surface, snapshot_slots[0], counters[0], counters[1], counters[2], counters[3]) can Global{Read,Write}


        def check(file: Ast::File&) -> SymbolTable:
            can Unsafe.PointerCast:
                can Memory.Allocate, Abort.Panic:
                    return check_with_unsafe_permissions(file, false) can Global{Read,Write}


            # Resolve all references and return the full table (diagnostics included) —
            # the located-findings sibling of `unresolved_references` for harness probes that
            # need per-diagnostic lines, without the parse-error gating of `check`.
        def unresolved_table(file: Ast::File&) -> SymbolTable:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- seed_builtins(table) can Global{Read,Write}
                table <- register_region_type_names(file, table)
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                table.generic_param_lines <- file.generic_param_lines
                table <- resolve_protocol_state_declarations(file, table)
                table.generic_param_names <- file.generic_param_names
                table.generic_param_owner_offsets <- file.generic_param_owner_offsets
                table <- index_generic_param_names(table) can Global{Read,Write}
                table.protocol_annotations <- file.enum_annotations
                semantic_build_import_annotation_views(file, table)
                table.using_alias_rows <- table.using_alias_rows.truncate(0)
                for annotation in file.enum_annotations |table|:
                    table.using_alias_rows <- table.using_alias_rows.push(annotation) if annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                    table.protocol_declarations <- table.protocol_declarations.push(annotation) if annotation.owner == "__protocol_decl"
                    table.generic_extern_names <- table.generic_extern_names.push(annotation.name) if annotation.owner == "__extern_generic_name"
                table <- index_wildcard_imports(table, table.definite_import_annotations)
                table <- index_binder_annotations(table, file.enum_annotations) can Global{Read,Write}
                table <- binding_import_metadata(table.definite_import_annotations, table)
                table.packed_enum_names <- file.packed_enum_names
                table <- register_using_alias_members(table.definite_import_annotations, table) can Global{Read,Write}
                for annotation in file.enum_annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NoncanonicalReturnStyle, name: "", line: annotation.detail_line, expected: "", actual: ""}) if annotation.owner == "__return_style" and annotation.name == "__value_first_return" and annotation.line == 3900000145 and annotation.identity_id == 3900000144
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable":
                        local_binding_row: usize = table.local_binding_names.count
                        table <- table.index_local_binding_exact(annotation.owner, annotation.line, annotation.offset, local_binding_row) can Global{Read,Write}
                        table.local_binding_names <- table.local_binding_names.push(annotation.owner)
                        table.local_binding_lines <- table.local_binding_lines.push(annotation.line)
                        table.local_binding_offsets <- table.local_binding_offsets.push(annotation.offset)
                        table.local_binding_modes <- table.local_binding_modes.push(1) if annotation.name == "__local_binding_mutable"
                        table.local_binding_modes <- table.local_binding_modes.push(-1) if annotation.name == "__local_binding_immutable"
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable" or annotation.name == "__loop_header_accumulator":
                        binding_annotation_row: usize = table.binding_annotations.count
                        table <- table.index_binding_annotation_exact(annotation, binding_annotation_row) can Global{Read,Write}
                        table.binding_annotations <- table.binding_annotations.push(annotation)
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.forward_arg_offsets <- table.forward_arg_offsets.push(annotation.offset) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.query_binder_offsets <- table.query_binder_offsets.push(annotation.offset) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                for annotation in table.definite_import_annotations |table|:
                    table.resolver_name_surface.valid <- false if annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.owner == "__from_member"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using" and not semantic_import_using_row_has_alias_pair(annotation, table)
                    if annotation.name == "__using_alias_target":
                        canonical_target: sview = semantic_import_alias_target_canonical_owner(annotation, table)
                        table.imported_modules <- table.imported_modules.push(canonical_target) if canonical_target != ""
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table <- table.add_symbol(annotation.owner, SymbolKind.Module, annotation.line, 0, 0, sview("", 0, 0), 0, annotation.offset, annotation.pos) can Global{Read,Write} if annotation.name == "__using_alias" and semantic_import_alias_is_global_winner(annotation, table)
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_modules <- file.enum_common_modules
                table.enum_common_counts <- file.enum_common_counts
                table <- validate_struct_layouts(file, table)
                table <- resolve_declarations(file.top_decls, table) can Global{Read,Write}
                return move table


        # Resolve all references in a parsed file; returns the count of unresolved
        # (undefined) value-position identifier references — the number of UndefinedName
        # diagnostics. Anchors the resolver call graph for the smoke harness.
        def unresolved_references(file: Ast::File&) -> u64:
            can Memory.Allocate, Abort.Panic:
                table: mutable SymbolTable = SymbolTable()
                table <- seed_builtins(table) can Global{Read,Write}
                table <- collect_range(file.top_decls, table, file.enum_annotations) can Global{Read,Write}
                table.generic_param_lines <- file.generic_param_lines
                table <- resolve_protocol_state_declarations(file, table)
                table.generic_param_names <- file.generic_param_names
                table.generic_param_owner_offsets <- file.generic_param_owner_offsets
                table <- index_generic_param_names(table) can Global{Read,Write}
                table.protocol_annotations <- file.enum_annotations
                table.using_alias_rows <- table.using_alias_rows.truncate(0)
                for annotation in file.enum_annotations |table|:
                    table.using_alias_rows <- table.using_alias_rows.push(annotation) if annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                    table.protocol_declarations <- table.protocol_declarations.push(annotation) if annotation.owner == "__protocol_decl"
                    table.generic_extern_names <- table.generic_extern_names.push(annotation.name) if annotation.owner == "__extern_generic_name"
                semantic_build_import_annotation_views(file, table)
                table <- index_wildcard_imports(table, table.definite_import_annotations)
                table <- index_binder_annotations(table, file.enum_annotations) can Global{Read,Write}
                table <- binding_import_metadata(table.definite_import_annotations, table)
                table.packed_enum_names <- file.packed_enum_names
                table <- register_using_alias_members(table.definite_import_annotations, table) can Global{Read,Write}
                for annotation in file.enum_annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NoncanonicalReturnStyle, name: "", line: annotation.detail_line, expected: "", actual: ""}) if annotation.owner == "__return_style" and annotation.name == "__value_first_return" and annotation.line == 3900000145 and annotation.identity_id == 3900000144
                    if annotation.name == "__local_binding_mutable" or annotation.name == "__local_binding_immutable" or annotation.name == "__loop_header_accumulator":
                        binding_annotation_row: usize = table.binding_annotations.count
                        table <- table.index_binding_annotation_exact(annotation, binding_annotation_row) can Global{Read,Write}
                        table.binding_annotations <- table.binding_annotations.push(annotation)
                    table.catch_match_lines <- table.catch_match_lines.push(annotation.line) if annotation.name == "__catch_match"
                    table.new_construct_lines <- table.new_construct_lines.push(annotation.line) if annotation.name == "__new_construct"
                    table.forward_arg_lines <- table.forward_arg_lines.push(annotation.line) if annotation.name == "__arg_forward"
                    table.forward_arg_offsets <- table.forward_arg_offsets.push(annotation.offset) if annotation.name == "__arg_forward"
                    table.block_if_lines <- table.block_if_lines.push(annotation.line) if annotation.name == "__block_if"
                    table.query_binder_offsets <- table.query_binder_offsets.push(annotation.offset) if annotation.name == "__query_binder"
                    table.query_binder_names <- table.query_binder_names.push(annotation.owner) if annotation.name == "__query_binder"
                    table.enum_hierarchy_child <- table.enum_hierarchy_child.push(annotation.owner) if annotation.line == 3900000008
                    table.enum_hierarchy_parent <- table.enum_hierarchy_parent.push(annotation.name) if annotation.line == 3900000008
                for annotation in table.definite_import_annotations |table|:
                    table.resolver_name_surface.valid <- false if annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.owner == "__from_member"
                    table.imported_modules <- table.imported_modules.push(annotation.owner) if annotation.name == "__using" and not semantic_import_using_row_has_alias_pair(annotation, table)
                    if annotation.name == "__using_alias_target":
                        canonical_target: sview = semantic_import_alias_target_canonical_owner(annotation, table)
                        table.imported_modules <- table.imported_modules.push(canonical_target) if canonical_target != ""
                    table.imported_members <- table.imported_members.push(annotation.name) if annotation.owner == "__from_member"
                    table <- table.add_symbol(annotation.owner, SymbolKind.Module, annotation.line, 0, 0, sview("", 0, 0), 0, annotation.offset, annotation.pos) can Global{Read,Write} if annotation.name == "__using_alias" and semantic_import_alias_is_global_winner(annotation, table)
                table.enum_common_owners <- file.enum_common_owners
                table.enum_common_modules <- file.enum_common_modules
                table.enum_common_counts <- file.enum_common_counts
                table <- validate_struct_layouts(file, table)
                table <- resolve_declarations(file.top_decls, table) can Global{Read,Write}
                # docs/119 §3: count UndefinedName diagnostics with a loop-expression fold —
                # the accumulator is loop-private and the body is pure over outer state.
                count: u64 =
                    for diagnostic in table.diagnostics |undefined_count = 0| -> undefined_count:
                        undefined_count <- undefined_count + 1 if diagnostic.kind == DiagnosticKind.UndefinedName
                return count
