# Dict-literal key type mismatch: a `dict[K, V]` VarDecl whose annotated KEY type is a bare
# primitive, where a KEY of the dict-literal value (literal or firm) can NEVER fit that key
# type. E.g. `d: dict[i64, i64] = {"s": 2}` fires because "s" is a string literal and string
# literals never fit i64. This check owns ONLY the key position — the value sibling check
# owns dict-literal values.
# Sound subset: only bare-primitive dict KEY annotations (`dict[i64, V]` — the value type V
# is not inspected/constrained here); only literal/firm keys whose family is provably
# incompatible (same oracle as TypeMismatch's check_value_against — literal_never_fits /
# firm_never_fits). Unknown-family keys (calls, constructs, Named-typed locals, ...) never fire.

extend Semantic:
    private:
        # Extract the bare KEY-type name from a `dict[K, V]` TYPE annotation — i.e.
        # `Expr.IndexN(object: Expr.Ident("dict"), arguments: [K, V])` where arguments[0]
        # is a bare `Expr.Ident`. Returns "" if the annotation is not this shape (non-dict
        # heads, non-Ident key type, arity != 2, ... all skip).
        def extract_dict_key_type_name(type_expr: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expr:
                    Expr.IndexN(object, arguments, line):
                        key_name return if object is Expr.Ident(head_name, ident_line) and head_name == "dict" and arguments.count == 2 and arguments[0] is Expr.Ident(key_name, key_line)
                        return ""
                    _:
                        return ""

        # Whether `type_name` is a bare primitive eligible for this check (mirrors the
        # gate used by TypeMismatch/check_value_against: integer/float/string types plus
        # bool/char).
        def is_dict_key_primitive(type_name: sview) -> bool:
            can Abort.Panic:
                true return if is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name)
                return type_name == "bool" or type_name == "char"

        # Check one dict-literal KEY against the declared key type; push a diagnostic if
        # its literal kind or inferred family can never fit.
        def check_dict_key_against(key: Ast::Expr, entry_index: usize, key_type_name: sview, line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                literal_kind: sview = literal_kind_of(key)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictKeyTypeMismatch, name: "", line: line, expected: key_type_name, actual: stage0_literal_spelling(literal_kind), actual_count: entry_index.u32()}) if literal_kind != "" and literal_never_fits(literal_kind, key_type_name)
                key_type: InferType = infer_expression_type(key, var_types, type_names, table)
                key_family: sview = family_of_kind(key_type)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictKeyTypeMismatch, name: "", line: line, expected: key_type_name, actual: stage0_value_spelling(key_type), actual_count: entry_index.u32()}) if literal_kind == "" and key_family != "" and firm_never_fits(key_family, key_type_name)

        def check_dict_runtime_call(callee: Ast::Expr, line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, field_line):
                        receiver_name: sview = ident_name_of(receiver)
                        receiver_type: sview = local_type_of(var_types, type_names, receiver_name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FloatDictRuntimeKey, name: "f64", line: line, expected: method, actual: ""}) if method == "get" and receiver_type == "__float_key_dict"
                    _:
                        pass

        # Walk through expressions, recursing into nested constructs so dict literals in
        # nested positions (not just direct VarDecl values) are still walked for their
        # OWN sub-expressions (this check only fires at the VarDecl site itself, but the
        # recursive walk must still visit every expression so other nested VarDecls are
        # reached via the statement walk below).
        def walk_expression_for_dict_key_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_dict_key_mismatch(left, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_dict_key_mismatch(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_dict_key_mismatch(argument, table, var_types, type_names)
                        table <- check_dict_runtime_call(callee, line, var_types, type_names, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_dict_key_mismatch(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_dict_key_mismatch(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_dict_key_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_dict_key_mismatch(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_dict_key_mismatch(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_dict_key_mismatch(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_dict_key_mismatch(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_dict_key_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(low, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_dict_key_mismatch(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_dict_key_mismatch(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_dict_key_mismatch(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_dict_key_mismatch(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_dict_key_mismatch(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_dict_key_mismatch(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_dict_key_mismatch(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_dict_key_mismatch(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_dict_key_mismatch(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_dict_key_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_dict_key_mismatch(iterable, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_dict_key_mismatch(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_dict_key_mismatch(statements, table, var_types, type_names)
                        table <- walk_expression_for_dict_key_mismatch(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_dict_key_mismatch(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_dict_key_mismatch(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking dict-typed
        # VarDecls whose value is a dict literal.
        def walk_statements_for_dict_key_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_dict_key_mismatch(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            key_type_name: sview = extract_dict_key_type_name(type_expression)
                            if key_type_name != "" and is_dict_key_primitive(key_type_name):
                                match value:
                                    Expr.DictLit(entries, dict_line):
                                        entry_index: mutable usize = 0
                                        for entry in entries |table, entry_index|:
                                            table <- check_dict_key_against(entry.key, entry_index, key_type_name, line, var_types, type_names, table)
                                            entry_index <- entry_index + 1
                                    _:
                                        pass
                            # Record the local's own type and recurse into the value.
                            type_name: mutable sview = bare_type_name(type_expression)
                            type_name <- "__float_key_dict" if is_float_type_name(key_type_name)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_dict_key_mismatch(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_dict_key_mismatch(target, table, var_types, type_names)
                            table <- walk_expression_for_dict_key_mismatch(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_dict_key_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_dict_key_mismatch(then_body, table, var_types, type_names)
                            table <- walk_statements_for_dict_key_mismatch(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_dict_key_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_dict_key_mismatch(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_dict_key_mismatch(iterable, table, var_types, type_names)
                            table <- walk_statements_for_dict_key_mismatch(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_dict_key_mismatch(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_dict_key_mismatch(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_dict_key_mismatch(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_dict_key_mismatch(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_dict_key_mismatch(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_dict_key_mismatch(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_dict_key_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: mutable sview = bare_type_name(param.type_expression)
                                param_key_type: sview = extract_dict_key_type_name(param.type_expression)
                                param_type <- "__float_key_dict" if is_float_type_name(param_key_type)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_dict_key_mismatch(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_dict_key_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_dict_key_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_dict_key_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_dict_key_mismatch_declarations(declarations, table)
