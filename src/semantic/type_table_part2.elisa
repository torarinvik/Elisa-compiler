extend Semantic:
    public:
        # Sound structural compatibility for already-interned types. This is the
        # foundation for assignment/call checking: exact structure is compatible;
        # numeric scalar rows may widen/convert; optionals, refs, tuples, and generic
        # instances require recursively compatible corresponding elements.
        def type_ids_compatible(left_id: u32, right_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if left_id == 0 or right_id == 0
                return true if left_id == right_id
                left_kind: SemTypeKind = interned_kind(left_id, table)
                right_kind: SemTypeKind = interned_kind(right_id, table)
                return false if left_kind == SemTypeKind.Region or right_kind == SemTypeKind.Region
                numeric: bool = (left_kind == SemTypeKind.Int or left_kind == SemTypeKind.Float) and (right_kind == SemTypeKind.Int or right_kind == SemTypeKind.Float)
                return true if numeric
                return false if left_kind != right_kind or interned_name(left_id, table) != interned_name(right_id, table)
                element_count: u32 = interned_elem_count(left_id, table)
                return false if element_count != interned_elem_count(right_id, table)
                for element_position in 0..<element_count.usize():
                    return false if not type_ids_compatible(interned_elem(left_id, element_position, table), interned_elem(right_id, element_position, table), table)
                return true


        # Recursively substitute canonical TypeIds. `from_ids[i]` is replaced by
        # `to_ids[i]`; all other rows are rebuilt with substituted children and
        # re-interned, preserving structural identity and deduplication.
        def substitute_type_id(type_id: u32, from_ids: darray[u32]&, to_ids: darray[u32]&, table: mutable SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                return 0 if from_ids.count != to_ids.count
                for substitution_index in 0..<from_ids.count:
                    return to_ids[substitution_index] if from_ids[substitution_index] == type_id
                return 0 if type_id == 0
                child_count: usize = interned_elem_count(type_id, table).usize()
                return type_id if child_count == 0
                children: mutable darray[u32] = []
                for child_position in 0..<child_count |children, table|:
                    children.push(substitute_type_id(interned_elem(type_id, child_position, table), from_ids, to_ids, table)) can Global{Read,Write}
                return intern_type(interned_kind(type_id, table), interned_name(type_id, table), children, table) can Global{Read,Write}
