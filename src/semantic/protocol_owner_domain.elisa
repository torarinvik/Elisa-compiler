# Necessary type conditions only. Liveness, provenance, effects and transition
# implementation obligations are separate; this predicate is not admission.
module ProtocolOwner:
    def eligible(known_type: bool, borrowed: bool, explicit_borrow: bool, linear_mutable: bool, known_state: bool, protocol: bool, same_family: bool, affine: bool) -> bool:
        ensure result == (known_type and not borrowed and not explicit_borrow and not linear_mutable and known_state and protocol and same_family and affine)
        return known_type and not borrowed and not explicit_borrow and not linear_mutable and known_state and protocol and same_family and affine
