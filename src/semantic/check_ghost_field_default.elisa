# Verification-family diagnostic (structural). A `ghost` struct field is verification-only and
# erased at codegen, so it has no runtime initializer — a default value on it is meaningless.
# stage0 rejects it. Reads the `is_ghost`/`has_default` flags now captured on StructMember;
# a pure per-field shape check, no inference or dataflow.
extend Semantic:
    private:
        def check_ghost_field_default(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Struct(name, members, affinity, _, _, _, line):
                            for member in members |table| -> table:
                                if member.is_ghost and member.has_default:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GhostFieldDefault, name: member.name, line: line, expected: "", actual: ""})
                        Decl.Module(module_name, body, module_line):
                            table <- check_ghost_field_default(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_ghost_field_default(scoped_body, table)
                        _:
                            pass
