extend Semantic:
    private:
        # If EXPRESSION (through a paren) is a direct call to an error-union-returning
        # function, return its name. Resolve the declaration by module and call position
        # so a same-leaf function in a different module does not make this call fallible.
        def error_call_name_from_parts(file: Ast::File&, callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview @source], call_pos: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&, declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], lexical_module: sview @source, shadowed: NameSet&, local_shadowed: NameSet&, caller_params: darray[ErrorUnionBindingFact], table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                callee_name: mutable sview @source = ""
                qualifier: mutable sview @source = ""
                match callee:
                    Expr.Ident(name, _):
                        callee_name <- name
                        return sview("", 0, 0) if name_set_contains(shadowed, name)
                    Expr.Scope(base, name, _):
                        module_root: sview = error_call_module_root(base)
                        return sview("", 0, 0) if module_root != "" and name_set_contains(shadowed, module_root)
                        callee_name <- name
                        qualifier <- error_call_module_path(base, table)
                    Expr.Paren(inner, _):
                        return error_call_name_from_parts(file, inner, arguments, argument_names, call_pos, annotations, declarations, extern_params, lexical_module, shadowed, local_shadowed, caller_params, table)
                    _:
                        return sview("", 0, 0)
                return sview("", 0, 0) if callee_name == ""
                # Every non-empty result passes error_union_declaration_is_fallible_at, which
                # needs an `__error_return` row owned by callee_name.
                if table.error_return_owner_source_count == annotations.count:
                    return sview("", 0, 0) if not (table.error_return_owner_hashes.get(name_hash(callee_name)) is owner_marker)
                forwards_arguments: bool = error_union_call_forwards_args(annotations, call_pos)
                generic_ranking_known: bool = error_union_call_has_primitive_type_evidence(arguments, caller_params)
                if qualifier != "":
                    alias_target: (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]) = catch_module_qualifier_alias_target(annotations, qualifier, lexical_module, call_pos.line, call_pos.offset)
                    return sview("", 0, 0) if alias_target.uncertain
                    requested_module: mutable sview @source = qualifier
                    if alias_target.found:
                        requested_module <- try_noncall_module_path(alias_target.scope, alias_target.module, table)
                        for suffix in alias_target.suffixes |requested_module, table|:
                            requested_module <- try_noncall_module_path(requested_module, suffix, table) if suffix != ""
                    else:
                        declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32) = catch_error_declaration(annotations, callee_name, lexical_module, qualifier, call_pos.line, call_pos.offset)
                        requested_module <- declaration.module if declaration.known
                    selected_module: mutable sview @source = ""
                    selected_length: mutable usize = 0.usize()
                    selected_count: mutable usize = 0.usize()
                    selected_viable_count: mutable usize = 0.usize()
                    selected_generic_specificity: mutable usize = 0.usize()
                    selected_raw_viable_count: mutable usize = 0.usize()
                    selected_specificity_safe: mutable bool = true
                    selected_line: mutable u32 = 0
                    selected_offset: mutable u32 = 0
                    error_union_visible_callable_module(file, declarations, callee_name, lexical_module, "", arguments, argument_names, caller_params, local_shadowed, forwards_arguments, generic_ranking_known, annotations, extern_params, requested_module, selected_module, selected_length, selected_count, selected_viable_count, selected_generic_specificity, selected_raw_viable_count, selected_specificity_safe, selected_line, selected_offset, table)
                    return callee_name if selected_viable_count == 1.usize() and error_union_declaration_is_fallible_at(annotations, callee_name, selected_module, selected_line, selected_offset)
                    return sview("", 0, 0)
                selected_module: mutable sview @source = ""
                selected_length: mutable usize = 0.usize()
                selected_count: mutable usize = 0.usize()
                selected_viable_count: mutable usize = 0.usize()
                selected_generic_specificity: mutable usize = 0.usize()
                selected_raw_viable_count: mutable usize = 0.usize()
                selected_specificity_safe: mutable bool = true
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                error_union_visible_callable_module(file, declarations, callee_name, lexical_module, "", arguments, argument_names, caller_params, local_shadowed, forwards_arguments, generic_ranking_known, annotations, extern_params, "", selected_module, selected_length, selected_count, selected_viable_count, selected_generic_specificity, selected_raw_viable_count, selected_specificity_safe, selected_line, selected_offset, table)
                if selected_count > 0.usize():
                    return callee_name if selected_viable_count == 1.usize() and error_union_declaration_is_fallible_at(annotations, callee_name, selected_module, selected_line, selected_offset)
                    return sview("", 0, 0)
                if selected_count == 0.usize():
                    imported_module: sview = error_imported_module(annotations, callee_name, lexical_module, call_pos, table)
                    if imported_module != "":
                        imported_selected_module: mutable sview @source = ""
                        imported_selected_length: mutable usize = 0.usize()
                        imported_selected_count: mutable usize = 0.usize()
                        imported_viable_count: mutable usize = 0.usize()
                        imported_generic_specificity: mutable usize = 0.usize()
                        imported_raw_viable_count: mutable usize = 0.usize()
                        imported_specificity_safe: mutable bool = true
                        imported_line: mutable u32 = 0
                        imported_offset: mutable u32 = 0
                        error_union_visible_callable_module(file, declarations, callee_name, lexical_module, "", arguments, argument_names, caller_params, local_shadowed, forwards_arguments, generic_ranking_known, annotations, extern_params, imported_module, imported_selected_module, imported_selected_length, imported_selected_count, imported_viable_count, imported_generic_specificity, imported_raw_viable_count, imported_specificity_safe, imported_line, imported_offset, table)
                        return callee_name if imported_viable_count == 1.usize() and error_union_declaration_is_fallible_at(annotations, callee_name, imported_selected_module, imported_line, imported_offset)
                return sview("", 0, 0)


        def error_call_name(file: Ast::File&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], lexical_module: sview @source, shadowed: NameSet&, local_shadowed: NameSet&, caller_params: darray[ErrorUnionBindingFact], table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        return error_call_name_from_parts(file, callee, arguments, argument_names, call_pos, annotations, declarations, extern_params, lexical_module, shadowed, local_shadowed, caller_params, table)
                    Expr.Paren(inner, _):
                        return error_call_name(file, inner, annotations, declarations, extern_params, lexical_module, shadowed, local_shadowed, caller_params, table)
                    _:
                        return sview("", 0, 0)

        # A `try EXPR` (without-else) at LINE records a `__try_without_else` annotation there; its
        # `try` head is dropped so the statement is a bare `Stmt.Expr(Call)`. The marker lets us tell
        # a handled `try f()` from an unhandled bare `f()`.
        def line_is_try_wrapped(try_lines: dict[u64, u8]&, line: u32) -> bool:
            can Abort.Panic:
                return true if try_lines.get(line.u64()) is marker
                return false

        def error_union_static_scope_is_inactive(file: Ast::File&, position: Ast::Pos, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                branch_row: usize = pma_static_if_row_for_position(file, position)
                return false if branch_row >= file.static_if_lines.count
                branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                return branch.known and not branch.selected

        def error_union_unhandled_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], lexical_module: sview @source, shadowed: mutable NameSet&, local_shadowed: mutable NameSet&, caller_params: darray[ErrorUnionBindingFact], try_lines: dict[u64, u8]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                visible_params: mutable darray[ErrorUnionBindingFact] = caller_params
                for statement in statements |table, visible_params, shadowed, local_shadowed| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            bare_name: sview @source = error_call_name(file, expression, annotations, declarations, extern_params, lexical_module, shadowed, local_shadowed, visible_params, table) if not line_is_try_wrapped(try_lines, line.line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: bare_name, line: line.line, expected: "", actual: "bare"}) if bare_name != ""
                        Stmt.Assign(target, operator, value, line):
                            discard_name: sview @source = error_call_name(file, value, annotations, declarations, extern_params, lexical_module, shadowed, local_shadowed, visible_params, table) if ident_name_of(target) == "_" and not line_is_try_wrapped(try_lines, line.line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: discard_name, line: line.line, expected: "", actual: "discard"}) if discard_name != ""
                        Stmt.VarDecl(name, type_expression, value, line):
                            decl_discard: sview @source = error_call_name(file, value, annotations, declarations, extern_params, lexical_module, shadowed, local_shadowed, visible_params, table) if name == "_" and not line_is_try_wrapped(try_lines, line.line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: decl_discard, line: line.line, expected: "", actual: "discard"}) if decl_discard != ""
                            name_set_add(shadowed, name) if name != "_" and name != ""
                            name_set_add(local_shadowed, name) if name != "_" and name != ""
                            visible_params <- error_union_binding_with_local(visible_params, name, error_union_type_expression_name(type_expression))
                        Stmt.If(condition, then_body, else_body, line):
                            then_shadowed: mutable NameSet = error_union_shadow_copy(shadowed)
                            else_shadowed: mutable NameSet = error_union_shadow_copy(shadowed)
                            then_local_shadowed: mutable NameSet = error_union_shadow_copy(local_shadowed)
                            else_local_shadowed: mutable NameSet = error_union_shadow_copy(local_shadowed)
                            table <- error_union_unhandled_statements(then_body, annotations, file, declarations, extern_params, lexical_module, then_shadowed, then_local_shadowed, visible_params, try_lines, table)
                            table <- error_union_unhandled_statements(else_body, annotations, file, declarations, extern_params, lexical_module, else_shadowed, else_local_shadowed, visible_params, try_lines, table)
                        Stmt.While(condition, body, line):
                            loop_shadowed: mutable NameSet = error_union_shadow_copy(shadowed)
                            loop_local_shadowed: mutable NameSet = error_union_shadow_copy(local_shadowed)
                            table <- error_union_unhandled_statements(body, annotations, file, declarations, extern_params, lexical_module, loop_shadowed, loop_local_shadowed, visible_params, try_lines, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            loop_shadowed: mutable NameSet = error_union_shadow_copy(shadowed)
                            loop_local_shadowed: mutable NameSet = error_union_shadow_copy(local_shadowed)
                            loop_params: mutable darray[ErrorUnionBindingFact] = visible_params
                            name_set_add(loop_shadowed, bind) if bind != "" and bind != "_"
                            name_set_add(loop_local_shadowed, bind) if bind != "" and bind != "_"
                            loop_params <- error_union_binding_with_local(loop_params, bind, "") if bind != "" and bind != "_"
                            for variable in variables |loop_shadowed, loop_local_shadowed, loop_params|:
                                name_set_add(loop_shadowed, variable) if variable != "" and variable != "_"
                                name_set_add(loop_local_shadowed, variable) if variable != "" and variable != "_"
                                loop_params <- error_union_binding_with_local(loop_params, variable, "") if variable != "" and variable != "_"
                            table <- error_union_unhandled_statements(body, annotations, file, declarations, extern_params, lexical_module, loop_shadowed, loop_local_shadowed, loop_params, try_lines, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            continue if block_kind == "static" and error_union_static_scope_is_inactive(file, line, lexical_module, table)
                            block_shadowed: mutable NameSet = error_union_shadow_copy(shadowed)
                            block_local_shadowed: mutable NameSet = error_union_shadow_copy(local_shadowed)
                            block_params: mutable darray[ErrorUnionBindingFact] = visible_params
                            name_set_add(block_shadowed, binding) if binding != "" and binding != "_"
                            name_set_add(block_local_shadowed, binding) if binding != "" and binding != "_"
                            block_params <- error_union_binding_with_local(block_params, binding, "") if binding != "" and binding != "_"
                            table <- error_union_unhandled_statements(body, annotations, file, declarations, extern_params, lexical_module, block_shadowed, block_local_shadowed, block_params, try_lines, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, visible_params| -> table:
                                arm_shadowed: mutable NameSet = error_union_shadow_copy(shadowed)
                                arm_local_shadowed: mutable NameSet = error_union_shadow_copy(local_shadowed)
                                arm_params: mutable darray[ErrorUnionBindingFact] = error_union_pattern_parameters(arm.pattern, visible_params)
                                error_union_pattern_shadow_names(arm.pattern, arm_shadowed)
                                error_union_pattern_shadow_names(arm.pattern, arm_local_shadowed)
                                table <- error_union_unhandled_statements(arm.body, annotations, file, declarations, extern_params, lexical_module, arm_shadowed, arm_local_shadowed, arm_params, try_lines, table)
                        _:
                            pass

        def check_error_union_unhandled_decls(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, extern_params: darray[Ast::ExternParam], current_module: sview @source, try_lines: dict[u64, u8]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            shadowed: mutable NameSet = empty_name_set()
                            local_shadowed: mutable NameSet = empty_name_set()
                            caller_params: darray[ErrorUnionBindingFact] = error_union_binding_facts(params)
                            for parameter in params |shadowed|:
                                name_set_add(shadowed, parameter.name) if parameter.name != "" and parameter.name != "_"
                            table <- error_union_unhandled_statements(body, annotations, file, all_declarations, extern_params, current_module, shadowed, local_shadowed, caller_params, try_lines, table)
                        Decl.Module(module_name, module_body, module_line):
                            nested_module: sview @source = module_name
                            table <- check_error_union_unhandled_decls(module_body, all_declarations, annotations, file, extern_params, nested_module, try_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            continue if error_union_static_scope_is_inactive(file, scoped_line, current_module, table)
                            table <- check_error_union_unhandled_decls(scoped_body, all_declarations, annotations, file, extern_params, current_module, try_lines, table)
                        _:
                            pass

    public:
        def check_error_union_unhandled(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                has_fallible_callable: mutable bool = false
                try_lines: mutable dict[u64, u8] = {}
                annotations: mutable darray[Ast::EnumAnnotation] = pma_active_import_annotations(file, table)
                table.error_return_owner_hashes <- {}
                for annotation in annotations |has_fallible_callable, try_lines, table|:
                    has_fallible_callable <- true if annotation.name == "__error_return"
                    table.error_return_owner_hashes <- table.error_return_owner_hashes.put(name_hash(annotation.owner), 1) can Global{Read,Write} if annotation.name == "__error_return"
                    if annotation.name == "__try_without_else":
                        if try_lines.get(annotation.line.u64()) is existing_marker:
                            pass
                        else:
                            try_lines <- try_lines.put(annotation.line.u64(), 1) can Global{Read,Write}
                table.error_return_owner_source_count <- annotations.count
                return if not has_fallible_callable
                table <- check_error_union_unhandled_decls(file.top_decls, file.top_decls, annotations, file, file.extern_params, "", try_lines, table)
