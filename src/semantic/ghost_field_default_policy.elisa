# Exact diagnostic predicate and source-location rule for ghost fields with defaults.
module GhostFieldDefaultPolicy:
    public:
        const MISSING_FIELD_SOURCE_LINE: u32 = 0

        def should_report(is_ghost: bool, has_default: bool) -> bool:
            ensure result == (is_ghost and has_default)
            return is_ghost and has_default

        def diagnostic_line(struct_line: u32, field_type_line: u32) -> u32:
            ensure result == (struct_line if field_type_line == MISSING_FIELD_SOURCE_LINE else field_type_line)
            return struct_line if field_type_line == MISSING_FIELD_SOURCE_LINE else field_type_line
