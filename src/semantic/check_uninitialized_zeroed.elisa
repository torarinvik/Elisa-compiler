# Uninitialized `= zeroed` read (stage0 analyzer_flow_definite_assign). A local declared
# `x: T = zeroed` where zero is an OPERATIONALLY INVALID value for T (a borrowed string cstr/
# dstr/sview, or a handle id[T]) is seeded uninitialized; reading it before any assignment is a
# null-deref / garbage-handle hazard. SOUND syntactic subset: fire when such a local is NEVER
# assigned/field-assigned/address-taken anywhere in the body (stage0's clear-on-assign is not
# branch-scoped, so "assigned anywhere" clears it — this matches) and IS returned. Types with a
# usable zero (scalars/structs/containers/optionals) are never seeded (stage0 keeps FP near zero).
extend Semantic:
    private:
        # Whether `zeroed` produces an operationally invalid value for this type: a borrowed
        # string (cstr/dstr/sview) or a handle id[T]. (Non-null refs also qualify in stage0 but are
        # left out here to keep the subset conservative.)
        def zeroed_invalid_type(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, line):
                        true return if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return base == "cstr" or base == "dstr" or base == "sview"
                    Expr.IndexN(head, arguments, line):
                        true return if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return base == "cstr" or base == "dstr" or base == "sview"
                    Expr.Unary(operator, operand, unary_line):
                        false return if operator == TokenKind.Question
                        return zeroed_invalid_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, paren_line):
                        return zeroed_invalid_type(inner)
                    _:
                        base: sview = bare_type_name(type_expression)
                        return when base:
                            "cstr" | "dstr" | "sview" -> true
                            _ -> false

        # Resolve aliases first so invalid representation families, nullable wrappers, and
        # module-qualified aliases all use the same identity and cycle policy.
        def zeroed_invalid_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                true return if ambiguous_or_cyclic
                return zeroed_invalid_type(resolved)

        # Unlike a C-string/handle local that is overwritten before its first read, a
        # zeroed `sview` is itself an invalid value: its non-null backing invariant is
        # violated immediately. Reject the initializer at its declaration, including a
        # direct alias, rather than waiting for a later name-based read check.
        # A zeroed borrowed view is invalid immediately, so this representation check
        # follows the same exact module-qualified alias identity as non-null references.
        # Nullable views remain valid because the outer optional wrapper stops the walk.
        def zeroed_is_sview_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                true return if ambiguous_or_cyclic
                return bare_type_name(resolved) == "sview"

        # A zero bit pattern is never a valid value for a non-null reference. Optional
        # references are different: zeroed represents the valid absent value. Storage
        # qualifiers and parentheses preserve the reference shape; a top-level `?`
        # makes the value nullable and therefore stops the check.
        def zeroed_is_nonnull_ref_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return false if operator == TokenKind.Question
                        return true if operator == TokenKind.Ampersand
                        return zeroed_is_nonnull_ref_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, paren_line):
                        return zeroed_is_nonnull_ref_type(inner)
                    Expr.Refinement(base_type, predicate, refinement_line):
                        return zeroed_is_nonnull_ref_type(base_type)
                    _:
                        return false

        # Module AST nodes store their full owner (`Outer::Inner`) even when written as
        # indentation-nested declarations. Compare that spelling with the current module
        # prefix plus a relative source path without allocating a joined name.
        def zeroed_qualified_module_name_matches_relative_path(module_name: sview, current_module: sview, prefix_length: usize, module_path: darray[sview]&) -> bool:
            can Abort.Panic:
                module_offset: mutable usize = 0
                false return if prefix_length > sview_len(current_module)
                if prefix_length > 0:
                    while module_offset < prefix_length |module_name, current_module, prefix_length, module_offset|:
                        false return if module_offset >= sview_len(module_name)
                        false return if sview_at(module_name, module_offset) != sview_at(current_module, module_offset)
                        module_offset <- module_offset + 1.usize()
                    false return if module_offset + 1.usize() >= sview_len(module_name)
                    false return if sview_at(module_name, module_offset) != ':' or sview_at(module_name, module_offset + 1.usize()) != ':'
                    module_offset <- module_offset + 2.usize()
                path_index: mutable usize = 0
                while path_index < module_path.count |module_name, current_module, prefix_length, module_path, module_offset, path_index|:
                    if path_index > 0:
                        false return if module_offset + 1.usize() >= sview_len(module_name)
                        false return if sview_at(module_name, module_offset) != ':' or sview_at(module_name, module_offset + 1.usize()) != ':'
                        module_offset <- module_offset + 2.usize()
                    segment: sview = module_path[path_index]
                    segment_offset: mutable usize = 0
                    while segment_offset < sview_len(segment) |module_name, current_module, prefix_length, module_path, module_offset, path_index, segment, segment_offset|:
                        false return if module_offset + segment_offset >= sview_len(module_name)
                        false return if sview_at(module_name, module_offset + segment_offset) != sview_at(segment, segment_offset)
                        segment_offset <- segment_offset + 1.usize()
                    module_offset <- module_offset + sview_len(segment)
                    path_index <- path_index + 1.usize()
                return module_offset == sview_len(module_name)

        # Module extensions are represented as additional Decl.Module nodes with the same
        # qualified owner. Collect aliases across those fragments because aliases inside an
        # extension may refer to names declared in the original module body or another
        # extension fragment.
        def zeroed_collect_module_aliases(declarations: darray[Ast::Decl], local_alias_names: mutable darray[sview]&, local_alias_values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |local_alias_names, local_alias_values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, _):
                            local_alias_names.push(alias_name)
                            local_alias_values.push(alias_value)
                        Decl.Scoped(scoped_body, _):
                            zeroed_collect_module_aliases(scoped_body, local_alias_names, local_alias_values)
                        _:
                            pass

        def zeroed_find_module_local_alias(declarations: darray[Ast::Decl], alias_name: sview, target: mutable Ast::Expr&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |alias_name, target, matches|:
                    match declaration:
                        Decl.Alias(declared_name, alias_target, _):
                            if declared_name == alias_name:
                                matches <- matches + 1.usize()
                                target <- alias_target
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_module_local_alias(scoped_body, alias_name, target, matches)
                        _:
                            pass

        # Bare aliases inherit from their declaring module. Recover that owner from the
        # declaration tree so a relative module path inside an inherited alias target is
        # resolved where the alias was declared, not where its use happens to occur.
        def zeroed_find_alias_in_owner(declarations: darray[Ast::Decl], owner: sview, alias_name: sview, target: mutable Ast::Expr&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner, alias_name, target, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if owner != "" and module_name == owner:
                                zeroed_find_module_local_alias(module_body, alias_name, target, matches)
                            else:
                                zeroed_find_alias_in_owner(module_body, owner, alias_name, target, matches) if owner != ""
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_alias_in_owner(scoped_body, owner, alias_name, target, matches)
                        Decl.Alias(declared_name, alias_target, _):
                            if owner == "" and declared_name == alias_name:
                                matches <- matches + 1.usize()
                                target <- alias_target
                        _:
                            pass

        def zeroed_find_lexical_alias_owner(declarations: darray[Ast::Decl], current_module: sview, alias_name: sview, owner: mutable sview&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = sview_len(current_module)
                while true |declarations, current_module, prefix_length, alias_name, owner, matches|:
                    candidate_owner: sview = string_view_slice(current_module, 0, prefix_length.i64()) if prefix_length > 0 else ""
                    target: mutable Ast::Expr = Expr.Invalid
                    candidate_matches: mutable usize = 0
                    zeroed_find_alias_in_owner(declarations, candidate_owner, alias_name, target, candidate_matches)
                    if candidate_matches > 0:
                        owner <- candidate_owner
                        matches <- candidate_matches
                        return
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if sview_at(current_module, search_offset - 2.usize()) == ':' and sview_at(current_module, search_offset - 1.usize()) == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        def zeroed_find_alias_at_relative_module_path(declarations: darray[Ast::Decl], current_module: sview, prefix_length: usize, module_path: darray[sview]&, alias_name: sview, target: mutable Ast::Expr&, matched_owner: mutable sview&, local_alias_names: mutable darray[sview]&, local_alias_values: mutable darray[Ast::Expr]&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if zeroed_qualified_module_name_matches_relative_path(module_name, current_module, prefix_length, module_path):
                                matched_owner <- module_name
                                zeroed_collect_module_aliases(module_body, local_alias_names, local_alias_values)
                                zeroed_find_module_local_alias(module_body, alias_name, target, matches)
                            else:
                                zeroed_find_alias_at_relative_module_path(module_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_alias_at_relative_module_path(scoped_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        _:
                            pass

        # Resolve a qualified alias from the current module outward, preferring the
        # closest owner and then trying each enclosing module before the root namespace.
        # Ambiguous owner rows remain visible to the caller's fail-closed policy.
        def zeroed_find_qualified_alias_in_declarations(declarations: darray[Ast::Decl], current_module: sview, module_path: darray[sview]&, alias_name: sview, target: mutable Ast::Expr&, matched_owner: mutable sview&, local_alias_names: mutable darray[sview]&, local_alias_values: mutable darray[Ast::Expr]&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = sview_len(current_module)
                while true |declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches|:
                    alias_names_start: usize = local_alias_names.count
                    alias_values_start: usize = local_alias_values.count
                    candidate_matches: mutable usize = 0
                    zeroed_find_alias_at_relative_module_path(declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, candidate_matches)
                    if candidate_matches > 0:
                        matches <- candidate_matches
                        return
                    local_alias_names <- local_alias_names.truncate(alias_names_start)
                    local_alias_values <- local_alias_values.truncate(alias_values_start)
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if sview_at(current_module, search_offset - 2.usize()) == ':' and sview_at(current_module, search_offset - 1.usize()) == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        def zeroed_collect_qualified_type_path(expression: Ast::Expr, names: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        names.push(name)
                        return true
                    Expr.Scope(base, name, _):
                        false return if not zeroed_collect_qualified_type_path(base, names)
                        names.push(name)
                        return true
                    _:
                        return false

        # Resolve storage-transparent wrappers and aliases once for every zero-validity
        # classifier. Optionality is preserved as the final expression so callers can
        # distinguish a valid absent value from an invalid non-null payload.
        # Resolve module import aliases at the nearest lexical owner. Pair metadata by
        # source offset as well as line; malformed/duplicate rows fail closed.
        def zeroed_expand_using_module_path(module_path: mutable darray[sview]&, current_owner: sview, resolved_owner: mutable sview&, table: SymbolTable&, invalid: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                owner: mutable sview = current_owner
                steps: mutable usize = 0
                while steps <= 256.usize() |module_path, owner, resolved_owner, table, invalid, steps|:
                    return if module_path.count == 0
                    prefix_length: mutable usize = sview_len(owner)
                    selected_target: mutable sview = ""
                    selected_owner: mutable sview = owner
                    matches: mutable usize = 0
                    while true |module_path, owner, table, prefix_length, selected_target, selected_owner, matches|:
                        candidate_owner: sview = string_view_slice(owner, 0, prefix_length.i64()) if prefix_length > 0 else ""
                        for annotation in table.protocol_annotations |module_path, table, candidate_owner, selected_target, selected_owner, matches|:
                            if annotation.name == "__using_alias" and annotation.owner == module_path[0] and annotation.module == candidate_owner:
                                for target_row in table.protocol_annotations |annotation, candidate_owner, selected_target, selected_owner, matches|:
                                    if target_row.name == "__using_alias_target" and target_row.line == annotation.line and target_row.offset == annotation.offset and target_row.module == candidate_owner:
                                        selected_target <- target_row.owner
                                        selected_owner <- candidate_owner
                                        matches <- matches + 1.usize()
                        break if matches > 0 or prefix_length == 0
                        search_offset: mutable usize = prefix_length
                        found_parent: mutable bool = false
                        while search_offset >= 2.usize() |owner, prefix_length, search_offset, found_parent|:
                            if sview_at(owner, search_offset - 2.usize()) == ':' and sview_at(owner, search_offset - 1.usize()) == ':':
                                prefix_length <- search_offset - 2.usize()
                                found_parent <- true
                                break
                            search_offset <- search_offset - 1.usize()
                        prefix_length <- 0 if not found_parent
                    return if matches == 0
                    if matches != 1.usize() or selected_target == "":
                        invalid <- true
                        return
                    expanded: mutable darray[sview] = []
                    start: mutable usize = 0
                    offset: mutable usize = 0
                    while offset < sview_len(selected_target) |selected_target, start, offset, expanded|:
                        if offset + 1.usize() < sview_len(selected_target) and sview_at(selected_target, offset) == ':' and sview_at(selected_target, offset + 1.usize()) == ':':
                            expanded.push(string_view_slice(selected_target, start.i64(), offset.i64()))
                            offset <- offset + 2.usize()
                            start <- offset
                        else:
                            offset <- offset + 1.usize()
                    expanded.push(string_view_slice(selected_target, start.i64(), sview_len(selected_target).i64()))
                    index: mutable usize = 1
                    while index < module_path.count |index, module_path, expanded|:
                        expanded.push(module_path[index])
                        index <- index + 1.usize()
                    module_path <- module_path.truncate(0)
                    for segment in expanded |module_path|:
                        module_path.push(segment)
                    owner <- selected_owner
                    resolved_owner <- selected_owner
                    steps <- steps + 1.usize()
                invalid <- true

        def zeroed_resolve_type_alias_chain(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&, resolved: mutable Ast::Expr&, resolved_owner: mutable sview&, ambiguous_or_cyclic: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = type_expression
                resolution_module: mutable sview = current_module
                steps: mutable usize = 0
                while steps <= 256.usize() |current, resolution_module, declarations, alias_declarations, table, resolved, resolved_owner, ambiguous_or_cyclic, steps|:
                    match current:
                        Expr.Unary(operator, operand, _):
                            if operator == TokenKind.Question or operator == TokenKind.Ampersand:
                                resolved <- current
                                resolved_owner <- resolution_module
                                return
                            if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                                current <- operand
                                steps <- steps + 1.usize()
                                continue
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        Expr.Paren(inner, _):
                            current <- inner
                            steps <- steps + 1.usize()
                            continue
                        Expr.Refinement(base_type, _, _):
                            current <- base_type
                            steps <- steps + 1.usize()
                            continue
                        _:
                            pass
                    qualified_names: mutable darray[sview] = []
                    if zeroed_collect_qualified_type_path(current, qualified_names) and qualified_names.count > 1:
                        alias_name: sview = qualified_names[qualified_names.count - 1.usize()]
                        module_path: mutable darray[sview] = []
                        path_index: mutable usize = 0
                        while path_index + 1.usize() < qualified_names.count |path_index, qualified_names, module_path|:
                            module_path.push(qualified_names[path_index])
                            path_index <- path_index + 1.usize()
                        path_invalid: mutable bool = false
                        zeroed_expand_using_module_path(module_path, resolution_module, resolution_module, table, path_invalid)
                        if path_invalid:
                            ambiguous_or_cyclic <- true
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        target: mutable Ast::Expr = Expr.Invalid
                        matched_owner: mutable sview = resolution_module
                        local_alias_names: mutable darray[sview] = []
                        local_alias_values: mutable darray[Ast::Expr] = []
                        matches: mutable usize = 0
                        zeroed_find_qualified_alias_in_declarations(alias_declarations, resolution_module, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        if matches > 1:
                            ambiguous_or_cyclic <- true
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        if matches == 0:
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        resolution_module <- matched_owner
                        current <- target
                        steps <- steps + 1.usize()
                        continue
                    alias_name: sview = bare_type_name(current)
                    if alias_name == "":
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    alias_owner: mutable sview = resolution_module
                    owner_matches: mutable usize = 0
                    zeroed_find_lexical_alias_owner(alias_declarations, resolution_module, alias_name, alias_owner, owner_matches)
                    if owner_matches == 0:
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    if owner_matches != 1.usize():
                        ambiguous_or_cyclic <- true
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    resolution_module <- alias_owner
                    alias_target: mutable Ast::Expr = Expr.Invalid
                    target_matches: mutable usize = 0
                    zeroed_find_alias_in_owner(alias_declarations, alias_owner, alias_name, alias_target, target_matches)
                    current <- alias_target
                    steps <- steps + 1.usize()
                ambiguous_or_cyclic <- true
                resolved <- current
                resolved_owner <- resolution_module


        # Use the same declaration-owner lookup for direct references and aggregates.
        # Ambiguous and cyclic aliases cannot establish a valid zero representation.
        def zeroed_is_nonnull_ref_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                true return if ambiguous_or_cyclic
                return zeroed_is_nonnull_ref_type(resolved)

        def zeroed_is_function_generic_type_name(name: sview, function_line: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if name == "" or function_line == 0
                index: mutable usize = 0
                while index < table.generic_param_lines.count |index, name, function_line, table|:
                    return true if table.generic_param_lines[index] == function_line and table.generic_param_names[index] == name
                    index <- index + 1
                return false

        def zeroed_find_struct_declaration_line(name: sview, declarations: darray[Ast::Decl]) -> u32:
            can Memory.Allocate, Abort.Panic:
                found_line: mutable u32 = 0
                for declaration in declarations |found_line, name|:
                    match declaration:
                        Decl.Struct(struct_name, _, _, _, _, _, line):
                            if struct_name == name:
                                return 0 if found_line != 0
                                found_line <- line.line
                        Decl.Module(_, module_body, _):
                            nested_line: u32 = zeroed_find_struct_declaration_line(name, module_body)
                            if nested_line != 0:
                                return 0 if found_line != 0
                                found_line <- nested_line
                        Decl.Scoped(module_body, _):
                            nested_line: u32 = zeroed_find_struct_declaration_line(name, module_body)
                            if nested_line != 0:
                                return 0 if found_line != 0
                                found_line <- nested_line
                        _:
                            pass
                return found_line

        # Find a non-null reference nested in a tuple, fixed array, or by-value struct.
        # Optional rows stop recursion because their zero representation is the valid absent
        # value. Dynamic containers also stop: a zeroed empty container has no elements yet.
        # Keep this AST-based so alias targets that are themselves references or aggregates
        # remain visible even when the structural type table has no alias row.
        def zeroed_type_expr_contains_nonnull_ref(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, visited: mutable darray[sview]&, offending_field: mutable sview&, table: SymbolTable&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, function_line: u32 = 0, generic_depth: usize = 0, sview_only: bool = false) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if generic_depth > 256.usize()
                resolved_type: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                invalid_alias: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved_type, resolved_owner, invalid_alias)
                true return if invalid_alias
                true return if not sview_only and zeroed_is_nonnull_ref_type(resolved_type)
                true return if bare_type_name(resolved_type) == "sview"
                match resolved_type:
                    Expr.Unary(operator, operand, _):
                        false return if operator == TokenKind.Question
                        false return if sview_only and operator == TokenKind.Ampersand
                        return zeroed_type_expr_contains_nonnull_ref(operand, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, _):
                        return zeroed_type_expr_contains_nonnull_ref(inner, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only)
                    Expr.Refinement(base_type, _, _):
                        return zeroed_type_expr_contains_nonnull_ref(base_type, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only)
                    Expr.Tuple(elements, _):
                        for element in elements |alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth, sview_only|:
                            if zeroed_type_expr_contains_nonnull_ref(element, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only):
                                offending_field <- "tuple element" if offending_field == ""
                                return true
                        return false
                    Expr.Index(head, argument, _):
                        return zeroed_type_expr_contains_nonnull_ref(head, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if argument is Expr.IntLit(_, _)
                        head_name: sview = ident_name_of(head)
                        return zeroed_type_expr_contains_nonnull_ref(argument, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if head_name == "array"
                        struct_line: u32 = zeroed_find_struct_declaration_line(head_name, declarations)
                        if struct_line != 0:
                            return true if generic_depth > table.struct_field_owner.count + 16.usize()
                            type_arguments: mutable darray[Ast::Expr] = [argument]
                            struct_generic_names: mutable darray[sview] = []
                            table_index: mutable usize = 0
                            while table_index < table.generic_param_lines.count |table_index, struct_line, struct_generic_names, table|:
                                struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                                table_index <- table_index + 1
                            # `Type[Extent]` is also Elisa's fixed-array syntax. A
                            # non-generic struct followed by its extent is still the
                            # struct element type; inspect its fields instead of
                            # treating it as an unresolved generic application.
                            return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if struct_generic_names.count == 0
                            return true if type_arguments.count < struct_generic_names.count
                            nested_generic_names: mutable darray[sview] = []
                            nested_generic_values: mutable darray[Ast::Expr] = []
                            nested_generic_names.extend(generic_names)
                            nested_generic_values.extend(generic_values)
                            table_index <- 0
                            while table_index < struct_generic_names.count |table_index, struct_generic_names, type_arguments, nested_generic_names, nested_generic_values|:
                                parameter_name: sview = struct_generic_names[table_index]
                                argument_is_identity: mutable bool = false
                                if type_arguments[table_index] is Expr.Ident(argument_name, _):
                                    argument_is_identity <- argument_name == parameter_name
                                if not argument_is_identity:
                                    nested_generic_names.push(parameter_name)
                                    nested_generic_values.push(type_arguments[table_index])
                                table_index <- table_index + 1
                            found_field: mutable bool = false
                            field_index: mutable usize = 0
                            while field_index < table.struct_field_owner.count |field_index, head_name, found_field, offending_field, table, alias_names, alias_values, visited, declarations, alias_declarations, resolved_owner, nested_generic_names, nested_generic_values, function_line, generic_depth|:
                                if table.struct_field_owner[field_index] == head_name:
                                    found_field <- true
                                    if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, nested_generic_names, nested_generic_values, function_line, generic_depth + 1.usize(), sview_only):
                                        offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                        return true
                                field_index <- field_index + 1
                            return false if found_field
                            return true
                        return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if head_name != ""
                        return false
                    Expr.IndexN(head, arguments, _):
                        head_name: sview = ident_name_of(head)
                        if head_name == "array" and arguments.count > 0:
                            return zeroed_type_expr_contains_nonnull_ref(arguments[0], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only)
                        has_extent: mutable bool = false
                        for argument in arguments |has_extent|:
                            has_extent <- true if argument is Expr.IntLit(_, _)
                        return zeroed_type_expr_contains_nonnull_ref(head, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if has_extent
                        struct_line: u32 = zeroed_find_struct_declaration_line(head_name, declarations)
                        if struct_line != 0:
                            return true if generic_depth > table.struct_field_owner.count + 16.usize()
                            struct_generic_names: mutable darray[sview] = []
                            table_index: mutable usize = 0
                            while table_index < table.generic_param_lines.count |table_index, struct_line, struct_generic_names, table|:
                                struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                                table_index <- table_index + 1
                            return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if struct_generic_names.count == 0
                            return true if arguments.count < struct_generic_names.count
                            nested_generic_names: mutable darray[sview] = []
                            nested_generic_values: mutable darray[Ast::Expr] = []
                            nested_generic_names.extend(generic_names)
                            nested_generic_values.extend(generic_values)
                            table_index <- 0
                            while table_index < struct_generic_names.count |table_index, struct_generic_names, arguments, nested_generic_names, nested_generic_values|:
                                parameter_name: sview = struct_generic_names[table_index]
                                argument_is_identity: mutable bool = false
                                if arguments[table_index] is Expr.Ident(argument_name, _):
                                    argument_is_identity <- argument_name == parameter_name
                                if not argument_is_identity:
                                    nested_generic_names.push(parameter_name)
                                    nested_generic_values.push(arguments[table_index])
                                table_index <- table_index + 1
                            found_field: mutable bool = false
                            field_index: mutable usize = 0
                            while field_index < table.struct_field_owner.count |field_index, head_name, found_field, offending_field, table, alias_names, alias_values, visited, declarations, alias_declarations, resolved_owner, nested_generic_names, nested_generic_values, function_line, generic_depth|:
                                if table.struct_field_owner[field_index] == head_name:
                                    found_field <- true
                                    if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, nested_generic_names, nested_generic_values, function_line, generic_depth + 1.usize(), sview_only):
                                        offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                        return true
                                field_index <- field_index + 1
                            return false if found_field
                            return true
                        return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if head_name != ""
                        return false
                    Expr.Ident(name, _):
                        current_type: mutable Ast::Expr = resolved_type
                        resolution_steps: mutable usize = 0
                        did_resolve: mutable bool = false
                        while current_type is Expr.Ident(current_name, _) |current_type, resolution_steps, generic_names, generic_values|:
                            mapping_index: mutable usize = generic_names.count
                            search_index: mutable usize = generic_names.count
                            while search_index > 0 |search_index, mapping_index, current_name, generic_names|:
                                search_index <- search_index - 1
                                if generic_names[search_index] == current_name:
                                    mapping_index <- search_index
                                    break
                            break if mapping_index == generic_names.count
                            mapped_type: Ast::Expr = generic_values[mapping_index]
                            break if mapped_type is Expr.Ident(mapped_name, _) and mapped_name == current_name
                            current_type <- mapped_type
                            did_resolve <- true
                            resolution_steps <- resolution_steps + 1
                            return true if resolution_steps > generic_names.count
                        return zeroed_type_expr_contains_nonnull_ref(current_type, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only) if did_resolve
                        # An unresolved generic may instantiate to a non-null reference;
                        # reject it in the general zeroed-reference pass. The separate
                        # sview pass only rejects concrete views, avoiding false positives
                        # for generic wrappers whose fields are scalars or optional refs.
                        true return if not sview_only and zeroed_is_function_generic_type_name(name, function_line, table)
                        false return if any visited_name in visited where visited_name == name
                        visited.push(name)
                        field_index: mutable usize = 0
                        while field_index < table.struct_field_owner.count |field_index, name, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth|:
                            if table.struct_field_owner[field_index] == name:
                                if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, function_line, generic_depth + 1.usize(), sview_only):
                                    offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                    return true
                            field_index <- field_index + 1
                        return false
                    _:
                        return false

        def zeroed_reject_reference_initializer(name: sview, type_expression: Ast::Expr, value: Ast::Expr, pos: Ast::Pos, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: lmut SymbolTable, function_line: u32 = 0, allow_invalid_zeroed: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not zeroed_invalid_reference_initializer(value)
                invalid_field: mutable sview = ""
                visited_types: mutable darray[sview] = []
                no_generic_names: darray[sview] = []
                no_generic_values: darray[Ast::Expr] = []
                # The view-backing invariant is unconditional, including within
                # trusted raw-storage blocks. Check nested fields and generic
                # substitutions before allowing inactive non-view payload storage.
                if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, visited_types, invalid_field, table, declarations, alias_declarations, current_module, no_generic_names, no_generic_values, function_line, 0, true):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, pos: pos, line: pos.line, expected: "sview with valid backing", actual: zeroed_reference_initializer_description(value)})
                    return
                # The sview-only walk has already visited every aggregate on its path. The
                # non-null-reference walk uses this same visited set, so leaving those marks
                # in place made ordinary structs appear cycle-complete and skipped all their
                # reference fields (including multi-level nested fields). Each classification
                # is an independent graph walk and needs its own cycle state.
                visited_types <- visited_types.truncate(0)
                # Runtime data structures may use zeroed bytes for an inactive generic
                # payload, but only within an explicit Unsafe.PointerCast block. A direct
                # sview is rejected above regardless: its backing must always be valid.
                return if allow_invalid_zeroed
                if zeroed_is_nonnull_ref_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidNonNullReferenceInitialization, name: name, pos: pos, line: pos.line, expected: "non-null reference", actual: zeroed_reference_initializer_description(value)})
                    return
                if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, visited_types, invalid_field, table, declarations, alias_declarations, current_module, no_generic_names, no_generic_values, function_line):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidZeroedAggregateReference, name: name, pos: pos, line: pos.line, expected: invalid_field, actual: zeroed_reference_initializer_description(value)})

        def zeroed_reject_nonnull_ref_declarations(statements: darray[Ast::Stmt], return_type: Ast::Expr?, function_line: u32, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, table: lmut SymbolTable, allow_invalid_zeroed: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- zeroed_reject_reference_initializer(name, type_expression, value, line, alias_names, alias_values, declarations, alias_declarations, current_module, table, function_line, allow_invalid_zeroed)
                        Stmt.Return(value, line):
                            if value is returned_value and return_type is expected_return:
                                table <- zeroed_reject_reference_initializer("return", expected_return, returned_value, line, alias_names, alias_values, declarations, alias_declarations, current_module, table, function_line, allow_invalid_zeroed) if not (expected_return is Expr.Absent) and not (expected_return is Expr.Invalid)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zeroed_reject_nonnull_ref_declarations(then_body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                            table <- zeroed_reject_nonnull_ref_declarations(else_body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        Stmt.While(_, body, _) | Stmt.For(_, _, _, body, _):
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        Stmt.Block(kind, clause, binding, body, _):
                            grants_raw_zeroed: bool = (kind == "trusted" or kind == "can") and any grant in clause where grant == "Unsafe.PointerCast"
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed or grants_raw_zeroed)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- zeroed_reject_nonnull_ref_declarations(arm.body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        _:
                            pass

        def zeroed_collect_type_aliases(declarations: darray[Ast::Decl], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, alias_line):
                            names.push(alias_name)
                            values.push(alias_value)
                        _:
                            pass

        def zeroed_value_is_zeroed(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, line):
                        return name == "zeroed"
                    _:
                        return false

        def zeroed_invalid_reference_initializer(value: Ast::Expr) -> bool:
            can Abort.Panic:
                return true if zeroed_value_is_zeroed(value)
                return true if value is Expr.Invalid or value is Expr.Absent
                return false

        def zeroed_reference_initializer_description(value: Ast::Expr) -> sview:
            can Abort.Panic:
                return "zeroed" if zeroed_value_is_zeroed(value)
                return "an omitted initializer"

        # Record every name that is initialized somewhere: an assignment target root, or a name
        # whose address is taken (`&x`). Both clear the zeroed-uninitialized seed in stage0.
        def zeroed_collect_initialized(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            root: sview = target_root_ident(target)
                            out.push(root) if root != ""
                            zeroed_collect_addressed_expression(value, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            zeroed_collect_addressed_expression(value, out)
                        Stmt.Expr(expression, line):
                            zeroed_collect_addressed_expression(expression, out)
                        Stmt.Return(value, line):
                            if value is returned:
                                zeroed_collect_addressed_expression(returned, out)
                        Stmt.If(condition, then_body, else_body, line):
                            zeroed_collect_initialized(then_body, out)
                            zeroed_collect_initialized(else_body, out)
                        Stmt.While(condition, body, line):
                            zeroed_collect_initialized(body, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            zeroed_collect_initialized(body, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            zeroed_collect_initialized(body, out)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out|:
                                zeroed_collect_initialized(arm.body, out)
                        _:
                            pass

        # Record the target of every address-of (`&x`) in an expression (initializes x).
        def zeroed_collect_addressed_expression(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        root: sview = ident_name_of(operand)
                        out.push(root) if operator == TokenKind.Ampersand and root != ""
                        zeroed_collect_addressed_expression(operand, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            zeroed_collect_addressed_expression(argument, out)
                    Expr.Binary(left, operator, right, line):
                        zeroed_collect_addressed_expression(left, out)
                        zeroed_collect_addressed_expression(right, out)
                    Expr.Paren(inner, line):
                        zeroed_collect_addressed_expression(inner, out)
                    _:
                        pass

        def zeroed_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # Emit for every `return <ident>` whose ident is an uninitialized zeroed candidate.
        def zeroed_check_returns(statements: darray[Ast::Stmt], candidates: darray[sview]&, initialized: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                returned_name: sview = ident_name_of(returned)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UninitializedZeroedRead, name: returned_name, line: line.line, expected: "", actual: ""}) if returned_name != "" and zeroed_name_present(candidates, returned_name) and not zeroed_name_present(initialized, returned_name)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zeroed_check_returns(then_body, candidates, initialized, table)
                            table <- zeroed_check_returns(else_body, candidates, initialized, table)
                        Stmt.While(condition, body, line):
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- zeroed_check_returns(arm.body, candidates, initialized, table)
                        _:
                            pass

        # Collect must-init `= zeroed` local declarations (recursively).
        def zeroed_collect_candidates(statements: darray[Ast::Stmt], alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if zeroed_value_is_zeroed(value) and zeroed_invalid_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table) and not zeroed_is_sview_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table)
                        Stmt.If(condition, then_body, else_body, line):
                            zeroed_collect_candidates(then_body, alias_names, alias_values, declarations, alias_declarations, current_module, table, out)
                            zeroed_collect_candidates(else_body, alias_names, alias_values, declarations, alias_declarations, current_module, table, out)
                        Stmt.While(condition, body, line):
                            zeroed_collect_candidates(body, alias_names, alias_values, declarations, alias_declarations, current_module, table, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            zeroed_collect_candidates(body, alias_names, alias_values, declarations, alias_declarations, current_module, table, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            zeroed_collect_candidates(body, alias_names, alias_values, declarations, alias_declarations, current_module, table, out)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out|:
                                zeroed_collect_candidates(arm.body, alias_names, alias_values, declarations, alias_declarations, current_module, table, out)
                        _:
                            pass

        def check_uninitialized_zeroed(declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, inherited_alias_names: darray[sview]&, inherited_alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_values: mutable darray[Ast::Expr] = []
                alias_names.extend(inherited_alias_names)
                alias_values.extend(inherited_alias_values)
                zeroed_collect_type_aliases(declarations, alias_names, alias_values)
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, line.line, declarations, alias_declarations, current_module, alias_names, alias_values, table)
                            candidates: mutable darray[sview] = []
                            zeroed_collect_candidates(body, alias_names, alias_values, declarations, alias_declarations, current_module, table, candidates)
                            initialized: mutable darray[sview] = []
                            zeroed_collect_initialized(body, initialized)
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_uninitialized_zeroed(module_body, alias_declarations, module_name, alias_names, alias_values, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_uninitialized_zeroed(scoped_body, alias_declarations, current_module, alias_names, alias_values, table)
                        Decl.Const(name, type_expression, value, is_global, line):
                            table <- zeroed_reject_reference_initializer(name, type_expression, value, line, alias_names, alias_values, declarations, alias_declarations, current_module, table) if is_global
                        _:
                            pass
