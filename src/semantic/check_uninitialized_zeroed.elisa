# Uninitialized `= zeroed` read (stage0 analyzer_flow_definite_assign). A local declared
# `x: T = zeroed` where zero is an OPERATIONALLY INVALID value for T (a C string cstr, borrowed
# view sview, or a handle id[T]) is seeded uninitialized; reading it before any assignment is a
# null-deref / garbage-handle hazard. The checker identifies candidates through resolver binding
# IDs, checks value reads in source order, and intersects initialization facts at `if` joins. It
# remains a conservative subset: loops do not export body writes, and match/expression joins,
# callee write summaries, and broader representation families still need shared flow analysis.
# Types with a usable zero (scalars/structs/containers/optionals) are not seeded by this check.
extend Semantic:
    private:
        # Whether `zeroed` produces an operationally invalid value for this type: a C string,
        # borrowed view, or handle id[T]. A dstr has a valid all-zero empty-header state. (Non-null
        # refs also qualify in stage0 but are left out here to keep the subset conservative.)
        def zeroed_invalid_type(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, line):
                        true return if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return base == "cstr" or base == "sview"
                    Expr.IndexN(head, arguments, line):
                        true return if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return base == "cstr" or base == "sview"
                    Expr.Unary(operator, operand, unary_line):
                        false return if operator == TokenKind.Question
                        return zeroed_invalid_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, paren_line):
                        return zeroed_invalid_type(inner)
                    _:
                        base: sview = bare_type_name(type_expression)
                        return when base:
                            "cstr" | "sview" -> true
                            _ -> false

        # Resolve aliases first so invalid representation families, nullable wrappers, and
        # module-qualified aliases all use the same identity and cycle policy.
        def zeroed_invalid_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                true return if ambiguous_or_cyclic
                return zeroed_invalid_type(resolved)

        # Unlike a C-string/handle local that is overwritten before its first read, a
        # zeroed `sview` is itself an invalid value: its non-null backing invariant is
        # violated immediately. Reject the initializer at its declaration, including a
        # direct alias, rather than waiting for a later name-based read check.
        # A zeroed borrowed view is invalid immediately, so this representation check
        # follows the same exact module-qualified alias identity as non-null references.
        # Nullable views remain valid because the outer optional wrapper stops the walk.
        def zeroed_is_sview_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                true return if ambiguous_or_cyclic
                return bare_type_name(resolved) == "sview"

        # A zero bit pattern is never a valid value for a non-null reference. Optional
        # references are different: zeroed represents the valid absent value. Storage
        # qualifiers and parentheses preserve the reference shape; a top-level `?`
        # makes the value nullable and therefore stops the check.
        def zeroed_is_nonnull_ref_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return false if operator == TokenKind.Question
                        return true if operator == TokenKind.Ampersand
                        return zeroed_is_nonnull_ref_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, paren_line):
                        return zeroed_is_nonnull_ref_type(inner)
                    Expr.Refinement(base_type, predicate, refinement_line):
                        return zeroed_is_nonnull_ref_type(base_type)
                    _:
                        return false

        # Module AST nodes store their full owner (`Outer::Inner`) even when written as
        # indentation-nested declarations. Compare that spelling with the current module
        # prefix plus a relative source path without allocating a joined name.
        def zeroed_qualified_module_name_matches_relative_path(module_name: sview, current_module: sview, prefix_length: usize, module_path: darray[sview]&) -> bool:
            can Abort.Panic:
                module_offset: mutable usize = 0
                false return if prefix_length > sview_len(current_module)
                if prefix_length > 0:
                    while module_offset < prefix_length |module_name, current_module, prefix_length, module_offset|:
                        false return if module_offset >= sview_len(module_name)
                        false return if sview_at(module_name, module_offset) != sview_at(current_module, module_offset)
                        module_offset <- module_offset + 1.usize()
                    false return if module_offset + 1.usize() >= sview_len(module_name)
                    false return if sview_at(module_name, module_offset) != ':' or sview_at(module_name, module_offset + 1.usize()) != ':'
                    module_offset <- module_offset + 2.usize()
                path_index: mutable usize = 0
                while path_index < module_path.count |module_name, current_module, prefix_length, module_path, module_offset, path_index|:
                    if path_index > 0:
                        false return if module_offset + 1.usize() >= sview_len(module_name)
                        false return if sview_at(module_name, module_offset) != ':' or sview_at(module_name, module_offset + 1.usize()) != ':'
                        module_offset <- module_offset + 2.usize()
                    segment: sview = module_path[path_index]
                    segment_offset: mutable usize = 0
                    while segment_offset < sview_len(segment) |module_name, current_module, prefix_length, module_path, module_offset, path_index, segment, segment_offset|:
                        false return if module_offset + segment_offset >= sview_len(module_name)
                        false return if sview_at(module_name, module_offset + segment_offset) != sview_at(segment, segment_offset)
                        segment_offset <- segment_offset + 1.usize()
                    module_offset <- module_offset + sview_len(segment)
                    path_index <- path_index + 1.usize()
                return module_offset == sview_len(module_name)

        # Module extensions are represented as additional Decl.Module nodes with the same
        # qualified owner. Collect aliases across those fragments because aliases inside an
        # extension may refer to names declared in the original module body or another
        # extension fragment.
        def zeroed_collect_module_aliases(declarations: darray[Ast::Decl], local_alias_names: mutable darray[sview]&, local_alias_values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |local_alias_names, local_alias_values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, _):
                            local_alias_names.push(alias_name)
                            local_alias_values.push(alias_value)
                        Decl.Scoped(scoped_body, _):
                            zeroed_collect_module_aliases(scoped_body, local_alias_names, local_alias_values)
                        _:
                            pass

        def zeroed_find_module_local_alias(declarations: darray[Ast::Decl], alias_name: sview, target: mutable Ast::Expr&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |alias_name, target, matches|:
                    match declaration:
                        Decl.Alias(declared_name, alias_target, _):
                            if declared_name == alias_name:
                                matches <- matches + 1.usize()
                                target <- alias_target
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_module_local_alias(scoped_body, alias_name, target, matches)
                        _:
                            pass

        # Bare aliases inherit from their declaring module. Recover that owner from the
        # declaration tree so a relative module path inside an inherited alias target is
        # resolved where the alias was declared, not where its use happens to occur.
        def zeroed_find_alias_in_owner(declarations: darray[Ast::Decl], owner: sview, alias_name: sview, target: mutable Ast::Expr&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner, alias_name, target, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if owner != "" and module_name == owner:
                                zeroed_find_module_local_alias(module_body, alias_name, target, matches)
                            else:
                                zeroed_find_alias_in_owner(module_body, owner, alias_name, target, matches) if owner != ""
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_alias_in_owner(scoped_body, owner, alias_name, target, matches)
                        Decl.Alias(declared_name, alias_target, _):
                            if owner == "" and declared_name == alias_name:
                                matches <- matches + 1.usize()
                                target <- alias_target
                        _:
                            pass

        def zeroed_find_lexical_alias_owner(declarations: darray[Ast::Decl], current_module: sview, alias_name: sview, owner: mutable sview&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = sview_len(current_module)
                while true |declarations, current_module, prefix_length, alias_name, owner, matches|:
                    candidate_owner: sview = string_view_slice(current_module, 0, prefix_length.i64()) if prefix_length > 0 else ""
                    target: mutable Ast::Expr = Expr.Invalid
                    candidate_matches: mutable usize = 0
                    zeroed_find_alias_in_owner(declarations, candidate_owner, alias_name, target, candidate_matches)
                    if candidate_matches > 0:
                        owner <- candidate_owner
                        matches <- candidate_matches
                        return
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if sview_at(current_module, search_offset - 2.usize()) == ':' and sview_at(current_module, search_offset - 1.usize()) == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        def zeroed_find_alias_at_relative_module_path(declarations: darray[Ast::Decl], current_module: sview, prefix_length: usize, module_path: darray[sview]&, alias_name: sview, target: mutable Ast::Expr&, matched_owner: mutable sview&, local_alias_names: mutable darray[sview]&, local_alias_values: mutable darray[Ast::Expr]&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if zeroed_qualified_module_name_matches_relative_path(module_name, current_module, prefix_length, module_path):
                                matched_owner <- module_name
                                zeroed_collect_module_aliases(module_body, local_alias_names, local_alias_values)
                                zeroed_find_module_local_alias(module_body, alias_name, target, matches)
                            else:
                                zeroed_find_alias_at_relative_module_path(module_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_alias_at_relative_module_path(scoped_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        _:
                            pass

        # Resolve a qualified alias from the current module outward, preferring the
        # closest owner and then trying each enclosing module before the root namespace.
        # Ambiguous owner rows remain visible to the caller's fail-closed policy.
        def zeroed_find_qualified_alias_in_declarations(declarations: darray[Ast::Decl], current_module: sview, module_path: darray[sview]&, alias_name: sview, target: mutable Ast::Expr&, matched_owner: mutable sview&, local_alias_names: mutable darray[sview]&, local_alias_values: mutable darray[Ast::Expr]&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = sview_len(current_module)
                while true |declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches|:
                    alias_names_start: usize = local_alias_names.count
                    alias_values_start: usize = local_alias_values.count
                    candidate_matches: mutable usize = 0
                    zeroed_find_alias_at_relative_module_path(declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, candidate_matches)
                    if candidate_matches > 0:
                        matches <- candidate_matches
                        return
                    local_alias_names <- local_alias_names.truncate(alias_names_start)
                    local_alias_values <- local_alias_values.truncate(alias_values_start)
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if sview_at(current_module, search_offset - 2.usize()) == ':' and sview_at(current_module, search_offset - 1.usize()) == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        # Struct/enum identity uses the exact declaration owner, never a basename-only field set.
        def zeroed_find_nominal_in_owner(declarations: darray[Ast::Decl], owner: sview, name: sview, declaration_line: mutable u32&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner, name, declaration_line, matches|:
                    match declaration:
                        Decl.Struct(struct_name, _, _, _, _, _, line):
                            if owner == "" and struct_name == name:
                                declaration_line <- line.line
                                matches <- matches + 1.usize()
                        Decl.Enum(enum_name, _, _, _, line):
                            if owner == "" and enum_name == name:
                                declaration_line <- line.line
                                matches <- matches + 1.usize()
                        Decl.Module(module_name, module_body, _):
                            if owner != "" and module_name == owner:
                                zeroed_find_nominal_in_owner(module_body, "", name, declaration_line, matches)
                            else:
                                zeroed_find_nominal_in_owner(module_body, owner, name, declaration_line, matches) if owner != ""
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_nominal_in_owner(scoped_body, owner, name, declaration_line, matches)
                        _:
                            pass

        def zeroed_find_lexical_nominal_owner(declarations: darray[Ast::Decl], current_module: sview, alias_name: sview, owner: mutable sview&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = sview_len(current_module)
                while true |declarations, current_module, prefix_length, alias_name, owner, matches|:
                    candidate_owner: sview = string_view_slice(current_module, 0, prefix_length.i64()) if prefix_length > 0 else ""
                    target: mutable u32 = 0
                    candidate_matches: mutable usize = 0
                    zeroed_find_nominal_in_owner(declarations, candidate_owner, alias_name, target, candidate_matches)
                    if candidate_matches > 0:
                        owner <- candidate_owner
                        matches <- candidate_matches
                        return
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if sview_at(current_module, search_offset - 2.usize()) == ':' and sview_at(current_module, search_offset - 1.usize()) == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        def zeroed_find_nominal_at_relative_module_path(declarations: darray[Ast::Decl], current_module: sview, prefix_length: usize, module_path: darray[sview]&, alias_name: sview, target: mutable u32&, matched_owner: mutable sview&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |current_module, prefix_length, module_path, alias_name, target, matched_owner, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if zeroed_qualified_module_name_matches_relative_path(module_name, current_module, prefix_length, module_path):
                                matched_owner <- module_name
                                zeroed_find_nominal_in_owner(module_body, "", alias_name, target, matches)
                            else:
                                zeroed_find_nominal_at_relative_module_path(module_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches)
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_nominal_at_relative_module_path(scoped_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches)
                        _:
                            pass

        def zeroed_find_qualified_nominal_in_declarations(declarations: darray[Ast::Decl], current_module: sview, module_path: darray[sview]&, alias_name: sview, target: mutable u32&, matched_owner: mutable sview&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = sview_len(current_module)
                while true |declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches|:
                    candidate_matches: mutable usize = 0
                    zeroed_find_nominal_at_relative_module_path(declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, candidate_matches)
                    if candidate_matches > 0:
                        matches <- candidate_matches
                        return
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if sview_at(current_module, search_offset - 2.usize()) == ':' and sview_at(current_module, search_offset - 1.usize()) == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent


        def zeroed_collect_qualified_type_path(expression: Ast::Expr, names: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        names.push(name)
                        return true
                    Expr.Scope(base, name, _):
                        false return if not zeroed_collect_qualified_type_path(base, names)
                        names.push(name)
                        return true
                    _:
                        return false

        # Resolve storage-transparent wrappers and aliases once for every zero-validity
        # classifier. Optionality is preserved as the final expression so callers can
        # distinguish a valid absent value from an invalid non-null payload.
        # Resolve module import aliases at the nearest lexical owner. Pair metadata by
        # source offset as well as line; malformed/duplicate rows fail closed.
        def zeroed_expand_using_module_path(module_path: mutable darray[sview]&, current_owner: sview, resolved_owner: mutable sview&, table: SymbolTable&, invalid: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                owner: mutable sview = current_owner
                steps: mutable usize = 0
                while steps <= 256.usize() |module_path, owner, resolved_owner, table, invalid, steps|:
                    return if module_path.count == 0
                    prefix_length: mutable usize = sview_len(owner)
                    selected_target: mutable sview = ""
                    selected_owner: mutable sview = owner
                    matches: mutable usize = 0
                    while true |module_path, owner, table, prefix_length, selected_target, selected_owner, matches|:
                        candidate_owner: sview = string_view_slice(owner, 0, prefix_length.i64()) if prefix_length > 0 else ""
                        for annotation in table.protocol_annotations |module_path, table, candidate_owner, selected_target, selected_owner, matches|:
                            if annotation.name == "__using_alias" and annotation.owner == module_path[0] and annotation.module == candidate_owner:
                                for target_row in table.protocol_annotations |annotation, candidate_owner, selected_target, selected_owner, matches|:
                                    if target_row.name == "__using_alias_target" and target_row.line == annotation.line and target_row.offset == annotation.offset and target_row.module == candidate_owner:
                                        selected_target <- target_row.owner
                                        selected_owner <- candidate_owner
                                        matches <- matches + 1.usize()
                        break if matches > 0 or prefix_length == 0
                        search_offset: mutable usize = prefix_length
                        found_parent: mutable bool = false
                        while search_offset >= 2.usize() |owner, prefix_length, search_offset, found_parent|:
                            if sview_at(owner, search_offset - 2.usize()) == ':' and sview_at(owner, search_offset - 1.usize()) == ':':
                                prefix_length <- search_offset - 2.usize()
                                found_parent <- true
                                break
                            search_offset <- search_offset - 1.usize()
                        prefix_length <- 0 if not found_parent
                    return if matches == 0
                    if matches != 1.usize() or selected_target == "":
                        invalid <- true
                        return
                    expanded: mutable darray[sview] = []
                    start: mutable usize = 0
                    offset: mutable usize = 0
                    while offset < sview_len(selected_target) |selected_target, start, offset, expanded|:
                        if offset + 1.usize() < sview_len(selected_target) and sview_at(selected_target, offset) == ':' and sview_at(selected_target, offset + 1.usize()) == ':':
                            expanded.push(string_view_slice(selected_target, start.i64(), offset.i64()))
                            offset <- offset + 2.usize()
                            start <- offset
                        else:
                            offset <- offset + 1.usize()
                    expanded.push(string_view_slice(selected_target, start.i64(), sview_len(selected_target).i64()))
                    index: mutable usize = 1
                    while index < module_path.count |index, module_path, expanded|:
                        expanded.push(module_path[index])
                        index <- index + 1.usize()
                    module_path <- module_path.truncate(0)
                    for segment in expanded |module_path|:
                        module_path.push(segment)
                    owner <- selected_owner
                    resolved_owner <- selected_owner
                    steps <- steps + 1.usize()
                invalid <- true

        def zeroed_resolve_type_alias_chain(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&, resolved: mutable Ast::Expr&, resolved_owner: mutable sview&, ambiguous_or_cyclic: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = type_expression
                resolution_module: mutable sview = current_module
                steps: mutable usize = 0
                while steps <= 256.usize() |current, resolution_module, declarations, alias_declarations, table, resolved, resolved_owner, ambiguous_or_cyclic, steps|:
                    match current:
                        Expr.Unary(operator, operand, _):
                            if operator == TokenKind.Question or operator == TokenKind.Ampersand:
                                resolved <- current
                                resolved_owner <- resolution_module
                                return
                            if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                                current <- operand
                                steps <- steps + 1.usize()
                                continue
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        Expr.Paren(inner, _):
                            current <- inner
                            steps <- steps + 1.usize()
                            continue
                        Expr.Refinement(base_type, _, _):
                            current <- base_type
                            steps <- steps + 1.usize()
                            continue
                        _:
                            pass
                    qualified_names: mutable darray[sview] = []
                    if zeroed_collect_qualified_type_path(current, qualified_names) and qualified_names.count > 1:
                        alias_name: sview = qualified_names[qualified_names.count - 1.usize()]
                        module_path: mutable darray[sview] = []
                        path_index: mutable usize = 0
                        while path_index + 1.usize() < qualified_names.count |path_index, qualified_names, module_path|:
                            module_path.push(qualified_names[path_index])
                            path_index <- path_index + 1.usize()
                        path_invalid: mutable bool = false
                        zeroed_expand_using_module_path(module_path, resolution_module, resolution_module, table, path_invalid)
                        if path_invalid:
                            ambiguous_or_cyclic <- true
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        target: mutable Ast::Expr = Expr.Invalid
                        matched_owner: mutable sview = resolution_module
                        local_alias_names: mutable darray[sview] = []
                        local_alias_values: mutable darray[Ast::Expr] = []
                        matches: mutable usize = 0
                        zeroed_find_qualified_alias_in_declarations(alias_declarations, resolution_module, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        if matches > 1:
                            ambiguous_or_cyclic <- true
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        if matches == 0:
                            struct_line: mutable u32 = 0
                            zeroed_find_qualified_nominal_in_declarations(alias_declarations, resolution_module, module_path, alias_name, struct_line, matched_owner, matches)
                            ambiguous_or_cyclic <- true if matches > 1.usize()
                            resolved <- Expr.Ident(alias_name, Ast::expr_pos(current)) if matches == 1.usize() else current
                            resolved_owner <- matched_owner if matches == 1.usize() else resolution_module
                            return
                        resolution_module <- matched_owner
                        current <- target
                        steps <- steps + 1.usize()
                        continue
                    alias_name: sview = bare_type_name(current)
                    if alias_name == "":
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    if is_primitive_type_name(alias_name):
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    alias_owner: mutable sview = resolution_module
                    owner_matches: mutable usize = 0
                    zeroed_find_lexical_alias_owner(alias_declarations, resolution_module, alias_name, alias_owner, owner_matches)
                    if owner_matches == 0:
                        zeroed_find_lexical_nominal_owner(alias_declarations, resolution_module, alias_name, alias_owner, owner_matches)
                        ambiguous_or_cyclic <- true if owner_matches > 1.usize()
                        resolved <- current
                        resolved_owner <- alias_owner if owner_matches == 1.usize() else resolution_module
                        return
                    if owner_matches != 1.usize():
                        ambiguous_or_cyclic <- true
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    resolution_module <- alias_owner
                    alias_target: mutable Ast::Expr = Expr.Invalid
                    target_matches: mutable usize = 0
                    zeroed_find_alias_in_owner(alias_declarations, alias_owner, alias_name, alias_target, target_matches)
                    current <- alias_target
                    steps <- steps + 1.usize()
                ambiguous_or_cyclic <- true
                resolved <- current
                resolved_owner <- resolution_module


        # Use the same declaration-owner lookup for direct references and aggregates.
        # Ambiguous and cyclic aliases cannot establish a valid zero representation.
        def zeroed_is_nonnull_ref_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                true return if ambiguous_or_cyclic
                return zeroed_is_nonnull_ref_type(resolved)

        def zeroed_is_function_generic_type_name(name: sview, function_line: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if name == "" or function_line == 0
                index: mutable usize = 0
                while index < table.generic_param_lines.count |index, name, function_line, table|:
                    return true if table.generic_param_lines[index] == function_line and table.generic_param_names[index] == name
                    index <- index + 1
                return false

        # Tag zero selects the first payload variant. Inactive variants do not impose
        # representation validity on the zero value; their payload storage is not live.
        def zeroed_collect_active_enum_fields(declarations: darray[Ast::Decl], owner: sview, name: sview, fields: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner, name, fields|:
                    match declaration:
                        Decl.Enum(enum_name, variants, is_const, _, _):
                            if owner == "" and enum_name == name and not is_const and variants.count > 0:
                                fields.extend(variants[0].fields)
                        Decl.Module(module_name, module_body, _):
                            if owner != "" and module_name == owner:
                                zeroed_collect_active_enum_fields(module_body, "", name, fields)
                            else:
                                zeroed_collect_active_enum_fields(module_body, owner, name, fields) if owner != ""
                        Decl.Scoped(scoped_body, _):
                            zeroed_collect_active_enum_fields(scoped_body, owner, name, fields)
                        _:
                            pass

        # Find a non-null reference nested in a tuple, fixed array, or by-value struct.
        # Optional rows stop recursion because their zero representation is the valid absent
        # value. Dynamic containers also stop: a zeroed empty container has no elements yet.
        # Keep this AST-based so alias targets that are themselves references or aggregates
        # remain visible even when the structural type table has no alias row.
        def zeroed_type_expr_contains_nonnull_ref(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, visited: mutable darray[sview]&, offending_field: mutable sview&, table: SymbolTable&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, function_line: u32 = 0, generic_depth: usize = 0, sview_only: bool = false) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if generic_depth > 256.usize()
                # Type arguments retain the lexical owner of the argument expression.
                # Substitution precedes module alias lookup because parameters shadow aliases.
                if type_expression is Expr.Ident(parameter_name, _):
                    mapping_index: mutable usize = generic_names.count
                    while mapping_index > 0 |mapping_index, generic_names, generic_values, generic_owners, parameter_name|:
                        mapping_index <- mapping_index - 1.usize()
                        if generic_names[mapping_index] == parameter_name:
                            mapped_type: Ast::Expr = generic_values[mapping_index]
                            break if mapped_type is Expr.Ident(mapped_name, _) and mapped_name == parameter_name
                            true return if mapping_index >= generic_owners.count
                            return zeroed_type_expr_contains_nonnull_ref(mapped_type, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, generic_owners[mapping_index], generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                resolved_type: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                invalid_alias: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved_type, resolved_owner, invalid_alias)
                true return if invalid_alias
                true return if not sview_only and zeroed_is_nonnull_ref_type(resolved_type)
                true return if bare_type_name(resolved_type) == "sview"
                match resolved_type:
                    Expr.Unary(operator, operand, _):
                        false return if operator == TokenKind.Question
                        false return if sview_only and operator == TokenKind.Ampersand
                        return zeroed_type_expr_contains_nonnull_ref(operand, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, _):
                        return zeroed_type_expr_contains_nonnull_ref(inner, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                    Expr.Refinement(base_type, _, _):
                        return zeroed_type_expr_contains_nonnull_ref(base_type, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                    Expr.Tuple(elements, _):
                        for element in elements |alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth, sview_only|:
                            if zeroed_type_expr_contains_nonnull_ref(element, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                offending_field <- "tuple element" if offending_field == ""
                                return true
                        return false
                    Expr.Index(head, argument, _):
                        return zeroed_type_expr_contains_nonnull_ref(head, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if argument is Expr.IntLit(_, _)
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        true return if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        return zeroed_type_expr_contains_nonnull_ref(argument, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if head_name == "array"
                        struct_line: mutable u32 = 0
                        struct_matches: mutable usize = 0
                        zeroed_find_nominal_in_owner(alias_declarations, head_owner, head_name, struct_line, struct_matches)
                        true return if struct_matches > 1.usize()
                        if struct_line != 0:
                            return true if generic_depth > table.struct_field_owner.count + 16.usize()
                            type_arguments: mutable darray[Ast::Expr] = [argument]
                            struct_generic_names: mutable darray[sview] = []
                            table_index: mutable usize = 0
                            while table_index < table.generic_param_lines.count |table_index, struct_line, struct_generic_names, table|:
                                struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                                table_index <- table_index + 1
                            # `Type[Extent]` is also Elisa's fixed-array syntax. A
                            # non-generic struct followed by its extent is still the
                            # struct element type; inspect its fields instead of
                            # treating it as an unresolved generic application.
                            return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, head_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if struct_generic_names.count == 0
                            return true if type_arguments.count < struct_generic_names.count
                            nested_generic_names: mutable darray[sview] = []
                            nested_generic_values: mutable darray[Ast::Expr] = []
                            nested_generic_owners: mutable darray[sview] = []
                            nested_generic_names.extend(generic_names)
                            nested_generic_values.extend(generic_values)
                            nested_generic_owners.extend(generic_owners)
                            table_index <- 0
                            while table_index < struct_generic_names.count |table_index, struct_generic_names, type_arguments, nested_generic_names, nested_generic_values, nested_generic_owners|:
                                parameter_name: sview = struct_generic_names[table_index]
                                argument_is_identity: mutable bool = false
                                if type_arguments[table_index] is Expr.Ident(argument_name, _):
                                    argument_is_identity <- argument_name == parameter_name
                                if not argument_is_identity:
                                    nested_generic_names.push(parameter_name)
                                    nested_generic_values.push(type_arguments[table_index])
                                    nested_generic_owners.push(resolved_owner)
                                table_index <- table_index + 1
                            found_field: mutable bool = false
                            field_index: mutable usize = 0
                            while field_index < table.struct_field_owner.count |field_index, head_name, head_owner, found_field, offending_field, table, alias_names, alias_values, visited, declarations, alias_declarations, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth|:
                                if table.struct_field_owner[field_index] == head_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner:
                                    found_field <- true
                                    if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, head_owner, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                        offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                        return true
                                field_index <- field_index + 1
                            return false if found_field
                            return true
                        return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if head_name != ""
                        return false
                    Expr.IndexN(head, arguments, _):
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        true return if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        if head_name == "array" and arguments.count > 0:
                            return zeroed_type_expr_contains_nonnull_ref(arguments[0], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                        has_extent: mutable bool = false
                        for argument in arguments |has_extent|:
                            has_extent <- true if argument is Expr.IntLit(_, _)
                        return zeroed_type_expr_contains_nonnull_ref(head, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if has_extent
                        struct_line: mutable u32 = 0
                        struct_matches: mutable usize = 0
                        zeroed_find_nominal_in_owner(alias_declarations, head_owner, head_name, struct_line, struct_matches)
                        true return if struct_matches > 1.usize()
                        if struct_line != 0:
                            return true if generic_depth > table.struct_field_owner.count + 16.usize()
                            struct_generic_names: mutable darray[sview] = []
                            table_index: mutable usize = 0
                            while table_index < table.generic_param_lines.count |table_index, struct_line, struct_generic_names, table|:
                                struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                                table_index <- table_index + 1
                            return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, head_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if struct_generic_names.count == 0
                            return true if arguments.count < struct_generic_names.count
                            nested_generic_names: mutable darray[sview] = []
                            nested_generic_values: mutable darray[Ast::Expr] = []
                            nested_generic_owners: mutable darray[sview] = []
                            nested_generic_names.extend(generic_names)
                            nested_generic_values.extend(generic_values)
                            nested_generic_owners.extend(generic_owners)
                            table_index <- 0
                            while table_index < struct_generic_names.count |table_index, struct_generic_names, arguments, nested_generic_names, nested_generic_values, nested_generic_owners|:
                                parameter_name: sview = struct_generic_names[table_index]
                                argument_is_identity: mutable bool = false
                                if arguments[table_index] is Expr.Ident(argument_name, _):
                                    argument_is_identity <- argument_name == parameter_name
                                if not argument_is_identity:
                                    nested_generic_names.push(parameter_name)
                                    nested_generic_values.push(arguments[table_index])
                                    nested_generic_owners.push(resolved_owner)
                                table_index <- table_index + 1
                            found_field: mutable bool = false
                            field_index: mutable usize = 0
                            while field_index < table.struct_field_owner.count |field_index, head_name, head_owner, found_field, offending_field, table, alias_names, alias_values, visited, declarations, alias_declarations, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth|:
                                if table.struct_field_owner[field_index] == head_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner:
                                    found_field <- true
                                    if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, head_owner, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                        offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                        return true
                                field_index <- field_index + 1
                            return false if found_field
                            return true
                        return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if head_name != ""
                        return false
                    Expr.Ident(name, _):
                        # An unresolved generic may instantiate to a non-null reference;
                        # reject it in the general zeroed-reference pass. The separate
                        # sview pass only rejects concrete views, avoiding false positives
                        # for generic wrappers whose fields are scalars or optional refs.
                        true return if not sview_only and zeroed_is_function_generic_type_name(name, function_line, table)
                        active_enum_fields: mutable darray[Ast::Expr] = []
                        zeroed_collect_active_enum_fields(alias_declarations, resolved_owner, name, active_enum_fields)
                        for payload_type in active_enum_fields |alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth, sview_only|:
                            if zeroed_type_expr_contains_nonnull_ref(payload_type, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                offending_field <- "enum payload" if offending_field == ""
                                return true
                        field_index: mutable usize = 0
                        while field_index < table.struct_field_owner.count |field_index, name, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth|:
                            if table.struct_field_owner[field_index] == name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == resolved_owner:
                                if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                    offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                    return true
                            field_index <- field_index + 1
                        return false
                    _:
                        return false

        def zeroed_reject_reference_initializer(name: sview, type_expression: Ast::Expr, value: Ast::Expr, pos: Ast::Pos, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: lmut SymbolTable, function_line: u32 = 0, allow_invalid_zeroed: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not zeroed_invalid_reference_initializer(value)
                invalid_field: mutable sview = ""
                visited_types: mutable darray[sview] = []
                no_generic_names: darray[sview] = []
                no_generic_values: darray[Ast::Expr] = []
                no_generic_owners: darray[sview] = []
                # The view-backing invariant is unconditional, including within
                # trusted raw-storage blocks. Check nested fields and generic
                # substitutions before allowing inactive non-view payload storage.
                if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, visited_types, invalid_field, table, declarations, alias_declarations, current_module, no_generic_names, no_generic_values, no_generic_owners, function_line, 0, true):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, pos: pos, line: pos.line, expected: "sview with valid backing", actual: zeroed_reference_initializer_description(value)})
                    return
                # The sview-only walk has already visited every aggregate on its path. The
                # non-null-reference walk uses this same visited set, so leaving those marks
                # in place made ordinary structs appear cycle-complete and skipped all their
                # reference fields (including multi-level nested fields). Each classification
                # is an independent graph walk and needs its own cycle state.
                visited_types <- visited_types.truncate(0)
                # Runtime data structures may use zeroed bytes for an inactive generic
                # payload, but only within an explicit Unsafe.PointerCast block. A direct
                # sview is rejected above regardless: its backing must always be valid.
                return if allow_invalid_zeroed
                if zeroed_is_nonnull_ref_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidNonNullReferenceInitialization, name: name, pos: pos, line: pos.line, expected: "non-null reference", actual: zeroed_reference_initializer_description(value)})
                    return
                if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, visited_types, invalid_field, table, declarations, alias_declarations, current_module, no_generic_names, no_generic_values, no_generic_owners, function_line):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidZeroedAggregateReference, name: name, pos: pos, line: pos.line, expected: invalid_field, actual: zeroed_reference_initializer_description(value)})

        def zeroed_reject_nonnull_ref_declarations(statements: darray[Ast::Stmt], return_type: Ast::Expr?, function_line: u32, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, table: lmut SymbolTable, allow_invalid_zeroed: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- zeroed_reject_reference_initializer(name, type_expression, value, line, alias_names, alias_values, declarations, alias_declarations, current_module, table, function_line, allow_invalid_zeroed)
                        Stmt.Return(value, line):
                            if value is returned_value and return_type is expected_return:
                                table <- zeroed_reject_reference_initializer("return", expected_return, returned_value, line, alias_names, alias_values, declarations, alias_declarations, current_module, table, function_line, allow_invalid_zeroed) if not (expected_return is Expr.Absent) and not (expected_return is Expr.Invalid)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zeroed_reject_nonnull_ref_declarations(then_body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                            table <- zeroed_reject_nonnull_ref_declarations(else_body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        Stmt.While(_, body, _) | Stmt.For(_, _, _, body, _):
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        Stmt.Block(kind, clause, binding, body, _):
                            grants_raw_zeroed: bool = (kind == "trusted" or kind == "can") and any grant in clause where grant == "Unsafe.PointerCast"
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed or grants_raw_zeroed)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- zeroed_reject_nonnull_ref_declarations(arm.body, return_type, function_line, declarations, alias_declarations, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        _:
                            pass

        def zeroed_collect_type_aliases(declarations: darray[Ast::Decl], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, alias_line):
                            names.push(alias_name)
                            values.push(alias_value)
                        _:
                            pass

        def zeroed_value_is_zeroed(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, line):
                        return name == "zeroed"
                    _:
                        return false

        def zeroed_invalid_reference_initializer(value: Ast::Expr) -> bool:
            can Abort.Panic:
                return true if zeroed_value_is_zeroed(value)
                return true if value is Expr.Invalid or value is Expr.Absent
                return false

        def zeroed_reference_initializer_description(value: Ast::Expr) -> sview:
            can Abort.Panic:
                return "zeroed" if zeroed_value_is_zeroed(value)
                return "an omitted initializer"

        # Binding identities come from the resolver's parallel reference rows. Matching both
        # owner and source position prevents a same-named shadow in another lexical scope from
        # proving a zeroed binding initialized (or from receiving its diagnostic).
        def zeroed_binding_for_reference(table: SymbolTable&, owner: DeclId, line: u32, name: sview) -> BindingId:
            can Abort.Panic:
                for index in 0..<table.ref_binding_ids.count:
                    if index < table.ref_line.count and index < table.ref_name.count and index < table.ref_kind.count:
                        binding: BindingId = table.ref_binding_ids[index]
                        if binding.owner.value == owner.value and table.ref_line[index] == line and table.ref_name[index] == name and table.ref_kind[index] == 2:
                            return binding
                return BindingId{owner: DeclId{value: 4294967295}, serial: 0}

        def zeroed_binding_equal(left: BindingId, right: BindingId) -> bool:
            can Abort.Panic:
                return left.owner.value == right.owner.value and left.serial == right.serial

        def zeroed_binding_present(bindings: darray[BindingId]&, wanted: BindingId) -> bool:
            can Abort.Panic:
                return any binding in bindings where zeroed_binding_equal(binding, wanted)

        def zeroed_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        def zeroed_candidate_matches(name: sview, binding: BindingId, candidate_names: darray[sview]&, candidates: darray[BindingId]&) -> bool:
            can Abort.Panic:
                unresolved_match: mutable bool = false
                for index in 0..<candidate_names.count:
                    if candidate_names[index] == name:
                        if index >= candidates.count or candidates[index].owner.value == 4294967295 or binding.owner.value == 4294967295:
                            unresolved_match <- true
                        elif zeroed_binding_equal(candidates[index], binding):
                            return true
                return unresolved_match

        def zeroed_add_initialized(initialized: mutable darray[BindingId]&, binding: BindingId) -> void:
            can Memory.Allocate, Abort.Panic:
                if binding.owner.value != 4294967295 and not zeroed_binding_present(initialized, binding):
                    initialized.push(binding)

        def zeroed_remove_initialized(initialized: mutable darray[BindingId]&, binding: BindingId) -> void:
            can Memory.Allocate, Abort.Panic:
                remaining: mutable darray[BindingId] = []
                for existing in initialized |remaining|:
                    remaining.push(existing) if not zeroed_binding_equal(existing, binding)
                initialized.truncate(0)
                for existing in remaining |initialized|:
                    initialized.push(existing)

        def zeroed_replace_initialized(destination: mutable darray[BindingId]&, source: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                destination.truncate(0)
                for binding in source |destination|:
                    destination.push(binding)

        def zeroed_intersect_initialized(initialized: mutable darray[BindingId]&, left: darray[BindingId]&, right: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                joined: mutable darray[BindingId] = []
                for binding in left |joined|:
                    joined.push(binding) if zeroed_binding_present(right, binding) and not zeroed_binding_present(joined, binding)
                initialized.truncate(0)
                for binding in joined |initialized|:
                    initialized.push(binding)

        def zeroed_bool_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        # Check expression reads against the facts valid at this program point. Expression
        # sub-blocks are analyzed on a copy so they cannot unsafely export branch-local writes.
        def zeroed_check_read_expression(expression: Ast::Expr, read_value: bool, owner: DeclId, candidate_names: darray[sview]&, candidates: darray[BindingId]&, initialized: darray[BindingId]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        binding: BindingId = zeroed_binding_for_reference(table, owner, line.line, name)
                        is_candidate: bool = zeroed_candidate_matches(name, binding, candidate_names, candidates)
                        is_initialized: bool = zeroed_binding_present(initialized, binding) if binding.owner.value != 4294967295 else false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UninitializedZeroedRead, name: name, line: line.line, expected: "", actual: ""}) if read_value and is_candidate and not is_initialized
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- zeroed_check_read_expression(callee, read_value, owner, candidate_names, candidates, initialized, table)
                        for argument in arguments |table|:
                            table <- zeroed_check_read_expression(argument, true, owner, candidate_names, candidates, initialized, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates_for_call, arguments, argument_names, line):
                        for argument in arguments |table|:
                            table <- zeroed_check_read_expression(argument, true, owner, candidate_names, candidates, initialized, table)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Index(object, index, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(index, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Slice(object, low, high, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(low, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(high, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.IndexN(object, arguments, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                        for argument in arguments |table|:
                            table <- zeroed_check_read_expression(argument, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Binary(left, operator, right, line):
                        table <- zeroed_check_read_expression(left, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(right, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Unary(operator, operand, line):
                        table <- zeroed_check_read_expression(operand, read_value and operator != TokenKind.Ampersand, owner, candidate_names, candidates, initialized, table)
                    Expr.Move(operand, line) | Expr.Paren(operand, line):
                        table <- zeroed_check_read_expression(operand, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.RegionNew(operand, region, line):
                        table <- zeroed_check_read_expression(operand, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Refinement(base, predicate, line):
                        table <- zeroed_check_read_expression(base, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(predicate, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- zeroed_check_read_expression(element, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- zeroed_check_read_expression(entry.key, read_value, owner, candidate_names, candidates, initialized, table)
                            table <- zeroed_check_read_expression(entry.value, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |table|:
                            table <- zeroed_check_read_expression(field.value, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- zeroed_check_read_expression(base, read_value, owner, candidate_names, candidates, initialized, table)
                        for field in fields |table|:
                            table <- zeroed_check_read_expression(field.value, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.If(condition, then_expression, else_expression, line):
                        table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(then_expression, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(else_expression, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- zeroed_check_read_expression(scrutinee, true, owner, candidate_names, candidates, initialized, table)
                        for arm in arms |table|:
                            table <- zeroed_check_read_expression(arm.guard, true, owner, candidate_names, candidates, initialized, table)
                            arm_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                            arm_falls_through: mutable bool = true
                            table <- zeroed_check_read_statements(arm.body, owner, candidate_names, candidates, arm_initialized, arm_falls_through, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- zeroed_check_read_expression(iterable, true, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(body, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- zeroed_check_read_expression(guarded, true, owner, candidate_names, candidates, initialized, table)
                        recovery_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                        recovery_falls_through: mutable bool = true
                        table <- zeroed_check_read_statements(recovery, owner, candidate_names, candidates, recovery_initialized, recovery_falls_through, table)
                    Expr.Lambda(parameters, body, line):
                        lambda_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                        lambda_falls_through: mutable bool = true
                        table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, lambda_initialized, lambda_falls_through, table)
                    Expr.Block(statements, value, captures, line):
                        block_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                        block_falls_through: mutable bool = true
                        table <- zeroed_check_read_statements(statements, owner, candidate_names, candidates, block_initialized, block_falls_through, table)
                        table <- zeroed_check_read_expression(value, read_value, owner, candidate_names, candidates, block_initialized, table)
                    _:
                        pass

        # Process statements in source order. Branch facts are intersected across every path
        # that reaches the join; loops never establish facts outside the loop because they may
        # execute zero times. Match and expression-level joins remain conservative.
        def zeroed_check_read_statements(statements: darray[Ast::Stmt], owner: DeclId, candidate_names: darray[sview]&, candidates: darray[BindingId]&, initialized: mutable darray[BindingId]&, falls_through: mutable bool&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                falls_through <- true
                for statement in statements |table, initialized, falls_through|:
                    if zeroed_bool_value(falls_through):
                        match statement:
                            Stmt.Expr(expression, line):
                                table <- zeroed_check_read_expression(expression, true, owner, candidate_names, candidates, initialized, table)
                            Stmt.VarDecl(name, type_expression, value, line):
                                table <- zeroed_check_read_expression(value, true, owner, candidate_names, candidates, initialized, table)
                                binding: BindingId = zeroed_binding_for_reference(table, owner, line.line, name)
                                zeroed_remove_initialized(initialized, binding) if zeroed_candidate_matches(name, binding, candidate_names, candidates)
                            Stmt.Assign(target, operator, value, line):
                                if operator != TokenKind.LArrow and operator != TokenKind.Assign:
                                    table <- zeroed_check_read_expression(target, true, owner, candidate_names, candidates, initialized, table)
                                else:
                                    match target:
                                        Expr.Ident(target_name, target_line):
                                            pass
                                        _:
                                            table <- zeroed_check_read_expression(target, true, owner, candidate_names, candidates, initialized, table)
                                table <- zeroed_check_read_expression(value, true, owner, candidate_names, candidates, initialized, table)
                                match target:
                                    Expr.Ident(target_name, target_line):
                                        target_binding: BindingId = zeroed_binding_for_reference(table, owner, target_line.line, target_name)
                                        if operator == TokenKind.LArrow and zeroed_candidate_matches(target_name, target_binding, candidate_names, candidates):
                                            if zeroed_value_is_zeroed(value):
                                                zeroed_remove_initialized(initialized, target_binding)
                                            else:
                                                zeroed_add_initialized(initialized, target_binding)
                                    _:
                                        pass
                            Stmt.If(condition, then_body, else_body, line):
                                table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                                then_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                else_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                then_falls_through: mutable bool = true
                                else_falls_through: mutable bool = true
                                table <- zeroed_check_read_statements(then_body, owner, candidate_names, candidates, then_initialized, then_falls_through, table)
                                table <- zeroed_check_read_statements(else_body, owner, candidate_names, candidates, else_initialized, else_falls_through, table)
                                if then_falls_through and else_falls_through:
                                    zeroed_intersect_initialized(initialized, then_initialized, else_initialized)
                                elif then_falls_through:
                                    zeroed_replace_initialized(initialized, then_initialized)
                                elif else_falls_through:
                                    zeroed_replace_initialized(initialized, else_initialized)
                                else:
                                    falls_through <- false
                            Stmt.While(condition, body, line):
                                table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                                body_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                body_falls_through: mutable bool = true
                                table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, body_initialized, body_falls_through, table)
                            Stmt.For(bind, variables, iterable, body, line):
                                table <- zeroed_check_read_expression(iterable, true, owner, candidate_names, candidates, initialized, table)
                                body_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                body_falls_through: mutable bool = true
                                table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, body_initialized, body_falls_through, table)
                            Stmt.Block(kind, clause, binding, body, line):
                                table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, initialized, falls_through, table)
                            Stmt.Match(scrutinee, arms, line):
                                table <- zeroed_check_read_expression(scrutinee, true, owner, candidate_names, candidates, initialized, table)
                                for arm in arms |table, initialized|:
                                    table <- zeroed_check_read_expression(arm.guard, true, owner, candidate_names, candidates, initialized, table)
                                    arm_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                    arm_falls_through: mutable bool = true
                                    table <- zeroed_check_read_statements(arm.body, owner, candidate_names, candidates, arm_initialized, arm_falls_through, table)
                            Stmt.Return(value, line):
                                table <- zeroed_check_read_expression(returned, true, owner, candidate_names, candidates, initialized, table) if value is returned
                                falls_through <- false
                            Stmt.Break(label, line) | Stmt.Continue(label, line):
                                falls_through <- false
                            Stmt.Contract(kind, expression, line):
                                table <- zeroed_check_read_expression(expression, true, owner, candidate_names, candidates, initialized, table)
                            _:
                                pass

        # Collect must-init `= zeroed` local declarations (recursively).
        def zeroed_collect_candidates(statements: darray[Ast::Stmt], owner: DeclId, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, table: SymbolTable&, out_names: mutable darray[sview]&, out_bindings: mutable darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_bindings|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if zeroed_value_is_zeroed(value) and zeroed_invalid_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table) and not zeroed_is_sview_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table):
                                out_names.push(name)
                                out_bindings.push(zeroed_binding_for_reference(table, owner, line.line, name))
                        Stmt.If(condition, then_body, else_body, line):
                            zeroed_collect_candidates(then_body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                            zeroed_collect_candidates(else_body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.While(condition, body, line):
                            zeroed_collect_candidates(body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.For(bind, variables, iterable, body, line):
                            zeroed_collect_candidates(body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.Block(kind, clause, binding, body, line):
                            zeroed_collect_candidates(body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out_names, out_bindings|:
                                zeroed_collect_candidates(arm.body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        _:
                            pass

        def check_uninitialized_zeroed(declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, inherited_alias_names: darray[sview]&, inherited_alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_values: mutable darray[Ast::Expr] = []
                alias_names.extend(inherited_alias_names)
                alias_values.extend(inherited_alias_values)
                zeroed_collect_type_aliases(declarations, alias_names, alias_values)
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, line.line, declarations, alias_declarations, current_module, alias_names, alias_values, table)
                            function_owner: DeclId = function_declaration_id(table, function_name, line.offset)
                            candidate_names: mutable darray[sview] = []
                            candidates: mutable darray[BindingId] = []
                            zeroed_collect_candidates(body, function_owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, candidate_names, candidates)
                            initialized: mutable darray[BindingId] = []
                            falls_through: mutable bool = true
                            table <- zeroed_check_read_statements(body, function_owner, candidate_names, candidates, initialized, falls_through, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_uninitialized_zeroed(module_body, alias_declarations, module_name, alias_names, alias_values, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_uninitialized_zeroed(scoped_body, alias_declarations, current_module, alias_names, alias_values, table)
                        Decl.Const(name, type_expression, value, is_global, line):
                            table <- zeroed_reject_reference_initializer(name, type_expression, value, line, alias_names, alias_values, declarations, alias_declarations, current_module, table) if is_global
                        _:
                            pass
