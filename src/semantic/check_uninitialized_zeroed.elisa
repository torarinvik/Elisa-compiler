# Uninitialized `= zeroed` read (stage0 analyzer_flow_definite_assign). A local declared
# `x: T = zeroed` where zero is an OPERATIONALLY INVALID value for T (a C string cstr, borrowed
# view sview, or a handle id[T]) is seeded uninitialized; reading it before any assignment is a
# null-deref / garbage-handle hazard. The checker identifies candidates through resolver binding
# IDs, checks value reads in source order, and intersects initialization facts at `if` joins. It
# remains a conservative subset: loops do not export body writes, and match/expression joins,
# callee write summaries, and broader representation families still need shared flow analysis.
# Types with a usable zero (scalars/structs/containers/optionals) are not seeded by this check.
extend Semantic:
    private:
        # Whether `zeroed` produces an operationally invalid value for this type: a C string,
        # borrowed view, or handle id[T]. A dstr has a valid all-zero empty-header state. (Non-null
        # refs also qualify in stage0 but are left out here to keep the subset conservative.)
        def zeroed_invalid_type(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, line):
                        return true if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return match base:
                            "cstr" | "sview": true
                            _: false
                    Expr.IndexN(head, arguments, line):
                        return true if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return match base:
                            "cstr" | "sview": true
                            _: false
                    Expr.Unary(operator, operand, unary_line):
                        return false if operator == TokenKind.Question
                        return zeroed_invalid_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, paren_line):
                        return zeroed_invalid_type(inner)
                    _:
                        base: sview = bare_type_name(type_expression)
                        return when base:
                            "cstr" | "sview" -> true
                            _ -> false

        # Resolve aliases first so invalid representation families, nullable wrappers, and
        # module-qualified aliases all use the same identity and cycle policy.
        def zeroed_invalid_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                return true if ambiguous_or_cyclic
                return zeroed_invalid_type(resolved)

        # Unlike a C-string/handle local that is overwritten before its first read, a
        # zeroed `sview` is itself an invalid value: its non-null backing invariant is
        # violated immediately. Reject the initializer at its declaration, including a
        # direct alias, rather than waiting for a later name-based read check.
        # A zeroed borrowed view is invalid immediately, so this representation check
        # follows the same exact module-qualified alias identity as non-null references.
        # Nullable views remain valid because the outer optional wrapper stops the walk.
        def zeroed_is_sview_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                return true if ambiguous_or_cyclic
                return bare_type_name(resolved) == "sview"

        # A zero bit pattern is never a valid value for a non-null reference. Optional
        # references are different: zeroed represents the valid absent value. Storage
        # qualifiers and parentheses preserve the reference shape; a top-level `?`
        # makes the value nullable and therefore stops the check.
        def zeroed_is_nonnull_ref_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return false if operator == TokenKind.Question
                        return true if operator == TokenKind.Ampersand
                        return zeroed_is_nonnull_ref_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, paren_line):
                        return zeroed_is_nonnull_ref_type(inner)
                    Expr.Refinement(base_type, predicate, refinement_line):
                        return zeroed_is_nonnull_ref_type(base_type)
                    _:
                        return false

        # Module AST nodes store their full owner (`Outer::Inner`) even when written as
        # indentation-nested declarations. Compare that spelling with the current module
        # prefix plus a relative source path without allocating a joined name.
        def zeroed_qualified_module_name_matches_relative_path(module_name: sview, current_module: sview @source, prefix_length: usize, module_path: darray[sview]&) -> bool:
            can Abort.Panic:
                module_offset: mutable usize = 0
                return false if prefix_length > current_module.len
                if prefix_length > 0:
                    while module_offset < prefix_length |module_name, current_module, prefix_length, module_offset|:
                        return false if:
                            module_offset >= module_name.len
                            module_name[module_offset] != current_module[module_offset]
                        module_offset <- module_offset + 1.usize()
                    return false if:
                        module_offset + 1.usize() >= module_name.len
                        module_name[module_offset] != ':' or module_name[module_offset + 1.usize()] != ':'
                    module_offset <- module_offset + 2.usize()
                path_index: mutable usize = 0
                while path_index < module_path.count |module_name, current_module, prefix_length, module_path, module_offset, path_index|:
                    if path_index > 0:
                        return false if:
                            module_offset + 1.usize() >= module_name.len
                            module_name[module_offset] != ':' or module_name[module_offset + 1.usize()] != ':'
                        module_offset <- module_offset + 2.usize()
                    segment: sview = module_path[path_index]
                    segment_offset: mutable usize = 0
                    while segment_offset < segment.len |module_name, current_module, prefix_length, module_path, module_offset, path_index, segment, segment_offset|:
                        return false if:
                            module_offset + segment_offset >= module_name.len
                            module_name[module_offset + segment_offset] != segment[segment_offset]
                        segment_offset <- segment_offset + 1.usize()
                    module_offset <- module_offset + segment.len
                    path_index <- path_index + 1.usize()
                return module_offset == module_name.len

        # Module extensions are represented as additional Decl.Module nodes with the same
        # qualified owner. Collect aliases across those fragments because aliases inside an
        # extension may refer to names declared in the original module body or another
        # extension fragment.
        def zeroed_collect_module_aliases(declarations: darray[Ast::Decl], local_alias_names: mutable darray[sview @source]&, local_alias_values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |local_alias_names, local_alias_values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, _):
                            local_alias_names.push(alias_name)
                            local_alias_values.push(alias_value)
                        Decl.Scoped(scoped_body, _):
                            zeroed_collect_module_aliases(scoped_body, local_alias_names, local_alias_values)
                        _:
                            pass

        def zeroed_find_module_local_alias(declarations: darray[Ast::Decl], alias_name: sview, target: mutable Ast::Expr&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |alias_name, target, matches|:
                    match declaration:
                        Decl.Alias(declared_name, alias_target, _):
                            if declared_name == alias_name:
                                matches <- matches + 1.usize()
                                target <- alias_target
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_module_local_alias(scoped_body, alias_name, target, matches)
                        _:
                            pass

        # Find an alias target through the symbol-name chain and the declaration-id-sorted
        # AST side table. Both indexes are verified while traversing; malformed metadata
        # returns false so callers can use the original declaration-tree walk.
        def zeroed_find_alias_in_owner_index(table: SymbolTable&, owner: sview, alias_name: sview, target: mutable Ast::Expr&, matches: mutable usize&) -> bool:
            can Abort.Panic:
                return false if:
                    not table.type_alias_declarations_index_valid
                    not table.symbol_name_index_valid or table.symbol_name_indexed_rows != table.symbols.count
                    table.symbol_name_next.count != table.symbols.count or table.type_alias_declarations.count != table.type_alias_name.count or table.type_alias_declarations.count != table.type_alias_target.count or table.type_alias_declarations.count != table.type_alias_module.count
                hash: u64 = name_hash(alias_name)
                expected_count: mutable usize = 0.usize()
                if table.symbol_name_count.get(hash) is indexed_count:
                    expected_count <- indexed_count.usize()
                else:
                    return false if:
                        table.symbol_name_head.get(hash) is orphan_head
                        table.symbol_name_tail.get(hash) is orphan_tail
                    return true
                return false if expected_count == 0.usize()
                expected_tail: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.symbol_name_tail.get(hash) is indexed_tail:
                    expected_tail <- indexed_tail
                else:
                    return false
                row: mutable u32 = symbol_chain_head(table, alias_name)
                return false if row == SYMBOL_INDEX_ROW_NONE
                probes: mutable usize = 0.usize()
                last_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                previous_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, probes, last_row, previous_row, expected_count, expected_tail, hash, table, owner, alias_name, target, matches|:
                    return false if probes >= expected_count
                    symbol_index: usize = row.usize()
                    return false if:
                        symbol_index >= table.symbols.count
                        previous_row != SYMBOL_INDEX_ROW_NONE and row <= previous_row
                        name_hash(table.symbols[symbol_index].name) != hash
                    symbol: Symbol = table.symbols[symbol_index]
                    return false if symbol.id.value != row
                    if symbol.name == alias_name and symbol.kind == SymbolKind.Alias and symbol.module_owner == owner:
                        lower: mutable usize = 0.usize()
                        upper: mutable usize = table.type_alias_declarations.count
                        while lower < upper |lower, upper, table, row|:
                            middle: usize = lower + (upper - lower) / 2.usize()
                            if table.type_alias_declarations[middle].declaration_id.value < row:
                                lower <- middle + 1.usize()
                            else:
                                upper <- middle
                        return false if lower >= table.type_alias_declarations.count
                        alias: TypeAliasDeclaration = table.type_alias_declarations[lower]
                        return false if:
                            alias.declaration_id.value != row or alias.module_owner != owner
                            table.type_alias_name[lower] != alias_name or table.type_alias_module[lower] != owner
                        matches <- matches + 1.usize()
                        target <- alias.target
                    last_row <- row
                    previous_row <- row
                    row <- table.symbol_name_next[symbol_index]
                    probes <- probes + 1.usize()
                return row == SYMBOL_INDEX_ROW_NONE and probes == expected_count and last_row == expected_tail


        # Bare aliases inherit from their declaring module. Recover that owner from the
        # declaration index so relative paths in an alias target use the declaration's
        # module; malformed indexes retain the authoritative AST fallback.
        def zeroed_find_alias_in_owner(declarations: darray[Ast::Decl], owner: sview, alias_name: sview, target: mutable Ast::Expr&, matches: mutable usize&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                # Probe the index into scratch slots: a declined probe must leave target and
                # matches untouched. The index writes target only together with matches + 1.
                index_target: mutable Ast::Expr = Expr.Invalid
                index_matches: mutable usize = matches
                if zeroed_find_alias_in_owner_index(table, owner, alias_name, index_target, index_matches):
                    target <- index_target if index_matches != matches
                    matches <- index_matches
                    return
                for declaration in declarations |owner, alias_name, target, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if owner != "" and module_name == owner:
                                zeroed_find_module_local_alias(module_body, alias_name, target, matches)
                            else:
                                zeroed_find_alias_in_owner(module_body, owner, alias_name, target, matches, table) if owner != ""
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_alias_in_owner(scoped_body, owner, alias_name, target, matches, table)
                        Decl.Alias(declared_name, alias_target, _):
                            if owner == "" and declared_name == alias_name:
                                matches <- matches + 1.usize()
                                target <- alias_target
                        _:
                            pass

        def zeroed_find_lexical_alias_owner(declarations: darray[Ast::Decl], current_module: sview @source, alias_name: sview, owner: mutable sview&, matches: mutable usize&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = current_module.len
                while true |declarations, current_module, prefix_length, alias_name, owner, matches|:
                    candidate_owner: sview = string_view_slice(current_module, 0, prefix_length.i64()) if prefix_length > 0 else ""
                    target: mutable Ast::Expr = Expr.Invalid
                    candidate_matches: mutable usize = 0
                    zeroed_find_alias_in_owner(declarations, candidate_owner, alias_name, target, candidate_matches, table)
                    if candidate_matches > 0:
                        owner <- candidate_owner
                        matches <- candidate_matches
                        return
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if current_module[search_offset - 2.usize()] == ':' and current_module[search_offset - 1.usize()] == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        def zeroed_find_alias_at_relative_module_path(declarations: darray[Ast::Decl], current_module: sview @source, prefix_length: usize, module_path: darray[sview]&, alias_name: sview, target: mutable Ast::Expr&, matched_owner: mutable sview&, local_alias_names: mutable darray[sview @source]&, local_alias_values: mutable darray[Ast::Expr]&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if zeroed_qualified_module_name_matches_relative_path(module_name, current_module, prefix_length, module_path):
                                matched_owner <- module_name
                                zeroed_collect_module_aliases(module_body, local_alias_names, local_alias_values)
                                zeroed_find_module_local_alias(module_body, alias_name, target, matches)
                            else:
                                zeroed_find_alias_at_relative_module_path(module_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_alias_at_relative_module_path(scoped_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        _:
                            pass

        # Resolve a qualified alias from the current module outward, preferring the
        # closest owner and then trying each enclosing module before the root namespace.
        # Ambiguous owner rows remain visible to the caller's fail-closed policy.
        def zeroed_find_qualified_alias_in_declarations(declarations: darray[Ast::Decl], current_module: sview @source, module_path: darray[sview]&, alias_name: sview, target: mutable Ast::Expr&, matched_owner: mutable sview&, local_alias_names: mutable darray[sview @source]&, local_alias_values: mutable darray[Ast::Expr]&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = current_module.len
                while true |declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches|:
                    alias_names_start: usize = local_alias_names.count
                    alias_values_start: usize = local_alias_values.count
                    candidate_matches: mutable usize = 0
                    zeroed_find_alias_at_relative_module_path(declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, candidate_matches)
                    if candidate_matches > 0:
                        matches <- candidate_matches
                        return
                    local_alias_names <- local_alias_names.truncate(alias_names_start)
                    local_alias_values <- local_alias_values.truncate(alias_values_start)
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if current_module[search_offset - 2.usize()] == ':' and current_module[search_offset - 1.usize()] == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        # Struct/enum identity uses the exact declaration owner, never a basename-only field set.
        def zeroed_find_nominal_in_owner(declarations: darray[Ast::Decl], owner: sview, name: sview, declaration_line: mutable u32&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner, name, declaration_line, matches|:
                    match declaration:
                        Decl.Struct(name: struct_name, pos: line, _):
                            if owner == "" and struct_name == name:
                                declaration_line <- line.line
                                matches <- matches + 1.usize()
                        Decl.Enum(name: enum_name, pos: line, _):
                            if owner == "" and enum_name == name:
                                declaration_line <- line.line
                                matches <- matches + 1.usize()
                        Decl.Module(module_name, module_body, _):
                            if owner != "" and module_name == owner:
                                zeroed_find_nominal_in_owner(module_body, "", name, declaration_line, matches)
                            else:
                                zeroed_find_nominal_in_owner(module_body, owner, name, declaration_line, matches) if owner != ""
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_nominal_in_owner(scoped_body, owner, name, declaration_line, matches)
                        _:
                            pass


        # The symbol name chain narrows nominal lookup to declarations with this spelling.
        # Ignore the compiler-seeded prefix by row identity rather than line number: user
        # source can also be mapped to line 0. Return false on malformed index state so the
        # caller can fall back to the authoritative declaration walk.
        def zeroed_find_nominal_in_owner_index(table: SymbolTable&, owner: sview, name: sview, declaration_line: mutable u32&, matches: mutable usize&) -> bool:
            can Abort.Panic:
                return false if not table.symbol_name_index_valid or table.symbol_name_indexed_rows != table.symbols.count or table.symbol_name_next.count != table.symbols.count or table.builtin_symbol_count > table.symbols.count
                hash: u64 = name_hash(name)
                expected_count: mutable usize = 0.usize()
                if table.symbol_name_count.get(hash) is indexed_count:
                    expected_count <- indexed_count.usize()
                else:
                    return false if:
                        table.symbol_name_head.get(hash) is orphan_head
                        table.symbol_name_tail.get(hash) is orphan_tail
                    return true
                return false if expected_count == 0.usize()
                expected_tail: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.symbol_name_tail.get(hash) is indexed_tail:
                    expected_tail <- indexed_tail
                else:
                    return false
                row: mutable u32 = symbol_chain_head(table, name)
                return false if row == SYMBOL_INDEX_ROW_NONE
                probes: mutable usize = 0.usize()
                last_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                previous_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, probes, last_row, previous_row, expected_count, expected_tail, hash, table, owner, name, declaration_line, matches|:
                    return false if probes >= expected_count
                    index: usize = row.usize()
                    return false if:
                        index >= table.symbols.count
                        previous_row != SYMBOL_INDEX_ROW_NONE and row <= previous_row
                        name_hash(table.symbols[index].name) != hash
                    symbol: Symbol = table.symbols[index]
                    return false if symbol.id.value != row
                    if index >= table.builtin_symbol_count and symbol.name == name and symbol.module_owner == owner and (symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum):
                        declaration_line <- symbol.line
                        matches <- matches + 1.usize()
                    last_row <- row
                    previous_row <- row
                    row <- table.symbol_name_next[index]
                    probes <- probes + 1.usize()
                return row == SYMBOL_INDEX_ROW_NONE and probes == expected_count and last_row == expected_tail


        def zeroed_find_nominal_in_owner_for_type(declarations: darray[Ast::Decl], index_owner: sview, ast_owner: sview, name: sview, declaration_line: mutable u32&, matches: mutable usize&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                declaration_line <- 0
                matches <- 0
                return if zeroed_find_nominal_in_owner_index(table, index_owner, name, declaration_line, matches)
                # A partial index traversal is not authoritative; clear partial results before
                # falling back so ambiguity and selected-line semantics match the old scan.
                declaration_line <- 0
                matches <- 0
                zeroed_find_nominal_in_owner(declarations, ast_owner, name, declaration_line, matches)

        def zeroed_find_lexical_nominal_owner(declarations: darray[Ast::Decl], current_module: sview @source, alias_name: sview, owner: mutable sview&, matches: mutable usize&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = current_module.len
                while true |declarations, current_module, prefix_length, alias_name, owner, matches, table|:
                    candidate_owner: sview = string_view_slice(current_module, 0, prefix_length.i64()) if prefix_length > 0 else ""
                    target: mutable u32 = 0
                    candidate_matches: mutable usize = 0
                    zeroed_find_nominal_in_owner_for_type(declarations, candidate_owner, candidate_owner, alias_name, target, candidate_matches, table)
                    if candidate_matches > 0:
                        owner <- candidate_owner
                        matches <- candidate_matches
                        return
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if current_module[search_offset - 2.usize()] == ':' and current_module[search_offset - 1.usize()] == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent

        def zeroed_find_nominal_at_relative_module_path_ast(declarations: darray[Ast::Decl], current_module: sview @source, prefix_length: usize, module_path: darray[sview]&, alias_name: sview, target: mutable u32&, matched_owner: mutable sview&, matches: mutable usize&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |current_module, prefix_length, module_path, alias_name, target, matched_owner, matches|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            if zeroed_qualified_module_name_matches_relative_path(module_name, current_module, prefix_length, module_path):
                                matched_owner <- module_name
                                zeroed_find_nominal_in_owner(module_body, "", alias_name, target, matches)
                            else:
                                zeroed_find_nominal_at_relative_module_path_ast(module_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches)
                        Decl.Scoped(scoped_body, _):
                            zeroed_find_nominal_at_relative_module_path_ast(scoped_body, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches)
                        _:
                            pass

        # Match module rows in the compact symbol table, then resolve all declarations with
        # that exact owner through the nominal name chain. Reopened modules share one owner,
        # so their struct/enum declarations are counted together exactly once.
        def zeroed_find_nominal_at_relative_module_path(declarations: darray[Ast::Decl], current_module: sview @source, prefix_length: usize, module_path: darray[sview]&, alias_name: sview, target: mutable u32&, matched_owner: mutable sview&, matches: mutable usize&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                malformed: mutable bool = table.module_symbol_rows.count != table.module_symbol_rows_expected or table.module_symbol_rows.count > table.symbols.count
                selected_module: mutable sview = ""
                previous_module_row: mutable u32 = 0
                have_previous_module_row: mutable bool = false
                for module_row in table.module_symbol_rows |declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches, table, malformed, previous_module_row, have_previous_module_row|:
                    if have_previous_module_row and module_row <= previous_module_row:
                        malformed <- true
                        break
                    index: usize = module_row.usize()
                    if index >= table.symbols.count:
                        malformed <- true
                        break
                    module_symbol: Symbol = table.symbols[index]
                    if module_symbol.id.value != module_row or module_symbol.kind != SymbolKind.Module:
                        malformed <- true
                        break
                    if zeroed_qualified_module_name_matches_relative_path(module_symbol.name, current_module, prefix_length, module_path):
                        selected_module <- module_symbol.name
                    previous_module_row <- module_row
                    have_previous_module_row <- true
                if malformed:
                    target <- 0
                    matched_owner <- ""
                    matches <- 0
                    zeroed_find_nominal_at_relative_module_path_ast(declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches)
                elif selected_module != "":
                    matched_owner <- selected_module
                    zeroed_find_nominal_in_owner_for_type(declarations, selected_module, selected_module, alias_name, target, matches, table)


        def zeroed_find_qualified_nominal_in_declarations(declarations: darray[Ast::Decl], current_module: sview @source, module_path: darray[sview]&, alias_name: sview, target: mutable u32&, matched_owner: mutable sview&, matches: mutable usize&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                prefix_length: mutable usize = current_module.len
                while true |declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, matches, table|:
                    candidate_matches: mutable usize = 0
                    zeroed_find_nominal_at_relative_module_path(declarations, current_module, prefix_length, module_path, alias_name, target, matched_owner, candidate_matches, table)
                    if candidate_matches > 0:
                        matches <- candidate_matches
                        return
                    break if prefix_length == 0
                    search_offset: mutable usize = prefix_length
                    found_parent: mutable bool = false
                    while search_offset >= 2.usize() |current_module, prefix_length, search_offset, found_parent|:
                        if current_module[search_offset - 2.usize()] == ':' and current_module[search_offset - 1.usize()] == ':':
                            prefix_length <- search_offset - 2.usize()
                            found_parent <- true
                            break
                        search_offset <- search_offset - 1.usize()
                    prefix_length <- 0 if not found_parent


        def zeroed_collect_qualified_type_path(expression: Ast::Expr, names: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        names.push(name)
                        return true
                    Expr.Scope(base, name, _):
                        return false if not zeroed_collect_qualified_type_path(base, names)
                        names.push(name)
                        return true
                    _:
                        return false

        # Resolve storage-transparent wrappers and aliases once for every zero-validity
        # classifier. Optionality is preserved as the final expression so callers can
        # distinguish a valid absent value from an invalid non-null payload.
        # Resolve module import aliases at the nearest lexical owner. Pair metadata by
        # source offset as well as line; malformed/duplicate rows fail closed.
        # Return the transformed borrowed descriptor by value, rather than taking
        # overlapping input and mutable-output arguments. No raw view fabrication.
        def zeroed_expand_using_module_path(module_path: mutable darray[sview]&, current_owner: sview, table: SymbolTable&, invalid: mutable bool&) -> sview:
            can Memory.Allocate, Abort.Panic:
                owner: mutable sview = current_owner
                steps: mutable usize = 0
                while steps <= 256.usize() |module_path, owner, table, invalid, steps|:
                    return owner if module_path.count == 0
                    prefix_length: mutable usize = owner.len
                    selected_target: mutable sview = ""
                    selected_owner: mutable sview = owner
                    matches: mutable usize = 0
                    while true |module_path, owner, table, prefix_length, selected_target, selected_owner, matches|:
                        candidate_owner: sview = string_view_slice(owner, 0, prefix_length.i64()) if prefix_length > 0 else ""
                        for annotation in table.using_alias_rows |module_path, table, candidate_owner, selected_target, selected_owner, matches|:
                            if annotation.name == "__using_alias" and annotation.owner == module_path[0] and annotation.module == candidate_owner:
                                for target_row in table.using_alias_rows |annotation, candidate_owner, selected_target, selected_owner, matches|:
                                    if target_row.name == "__using_alias_target" and target_row.line == annotation.line and target_row.offset == annotation.offset and target_row.module == candidate_owner:
                                        selected_target <- target_row.owner
                                        selected_owner <- candidate_owner
                                        matches <- matches + 1.usize()
                        break if matches > 0 or prefix_length == 0
                        search_offset: mutable usize = prefix_length
                        found_parent: mutable bool = false
                        while search_offset >= 2.usize() |owner, prefix_length, search_offset, found_parent|:
                            if owner[search_offset - 2.usize()] == ':' and owner[search_offset - 1.usize()] == ':':
                                prefix_length <- search_offset - 2.usize()
                                found_parent <- true
                                break
                            search_offset <- search_offset - 1.usize()
                        prefix_length <- 0 if not found_parent
                    return owner if matches == 0
                    if matches != 1.usize() or selected_target == "":
                        invalid <- true
                        return owner
                    expanded: mutable darray[sview] = []
                    start: mutable usize = 0
                    offset: mutable usize = 0
                    while offset < selected_target.len |selected_target, start, offset, expanded|:
                        if offset + 1.usize() < selected_target.len and selected_target[offset] == ':' and selected_target[offset + 1.usize()] == ':':
                            expanded.push(string_view_slice(selected_target, start.i64(), offset.i64()))
                            offset <- offset + 2.usize()
                            start <- offset
                        else:
                            offset <- offset + 1.usize()
                    expanded.push(string_view_slice(selected_target, start.i64(), selected_target.len.i64()))
                    index: mutable usize = 1
                    while index < module_path.count |index, module_path, expanded|:
                        expanded.push(module_path[index])
                        index <- index + 1.usize()
                    module_path <- module_path.truncate(0)
                    for segment in expanded |module_path|:
                        module_path.push(segment)
                    owner <- selected_owner
                    steps <- steps + 1.usize()
                invalid <- true
                return owner
