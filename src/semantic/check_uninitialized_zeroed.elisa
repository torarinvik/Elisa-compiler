# Uninitialized `= zeroed` read (stage0 analyzer_flow_definite_assign). A local declared
# `x: T = zeroed` where zero is an OPERATIONALLY INVALID value for T (a borrowed string cstr/
# dstr/sview, or a handle id[T]) is seeded uninitialized; reading it before any assignment is a
# null-deref / garbage-handle hazard. SOUND syntactic subset: fire when such a local is NEVER
# assigned/field-assigned/address-taken anywhere in the body (stage0's clear-on-assign is not
# branch-scoped, so "assigned anywhere" clears it — this matches) and IS returned. Types with a
# usable zero (scalars/structs/containers/optionals) are never seeded (stage0 keeps FP near zero).
extend Semantic:
    private:
        # Whether `zeroed` produces an operationally invalid value for this type: a borrowed
        # string (cstr/dstr/sview) or a handle id[T]. (Non-null refs also qualify in stage0 but are
        # left out here to keep the subset conservative.)
        def zeroed_invalid_type(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, line):
                        true return if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return base == "cstr" or base == "dstr" or base == "sview"
                    Expr.IndexN(head, arguments, line):
                        true return if ident_name_of(head) == "id"
                        base: sview = bare_type_name(type_expression)
                        return base == "cstr" or base == "dstr" or base == "sview"
                    Expr.Unary(operator, operand, unary_line):
                        return zeroed_invalid_type(operand)
                    Expr.Paren(inner, paren_line):
                        return zeroed_invalid_type(inner)
                    _:
                        base: sview = bare_type_name(type_expression)
                        return when base:
                            "cstr" | "dstr" | "sview" -> true
                            _ -> false

        # As zeroed_invalid_type, but first resolves a bare type-alias name one level (e.g.
        # `type ThingId = id[Thing]` — a `h: ThingId = zeroed` is an invalid-zero handle).
        def zeroed_invalid_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                name: sview = bare_type_name(type_expression)
                if name != "":
                    alias_index: mutable usize = 0
                    while alias_index < alias_names.count |alias_index|:
                        zeroed_invalid_type(alias_values[alias_index]) return if alias_names[alias_index] == name
                        alias_index <- alias_index + 1
                return zeroed_invalid_type(type_expression)

        # Unlike a C-string/handle local that is overwritten before its first read, a
        # zeroed `sview` is itself an invalid value: its non-null backing invariant is
        # violated immediately. Reject the initializer at its declaration, including a
        # direct alias, rather than waiting for a later name-based read check.
        def zeroed_is_sview_type(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&) -> bool:
            can Abort.Panic:
                name: sview = bare_type_name(type_expression)
                true return if name == "sview"
                alias_index: mutable usize = 0
                while alias_index < alias_names.count |alias_index|:
                    return bare_type_name(alias_values[alias_index]) == "sview" if alias_names[alias_index] == name
                    alias_index <- alias_index + 1
                return false

        # A zero bit pattern is never a valid value for a non-null reference. Optional
        # references are different: zeroed represents the valid absent value. Storage
        # qualifiers and parentheses preserve the reference shape; a top-level `?`
        # makes the value nullable and therefore stops the check.
        def zeroed_is_nonnull_ref_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return false if operator == TokenKind.Question
                        return true if operator == TokenKind.Ampersand
                        return zeroed_is_nonnull_ref_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, paren_line):
                        return zeroed_is_nonnull_ref_type(inner)
                    Expr.Refinement(base_type, predicate, refinement_line):
                        return zeroed_is_nonnull_ref_type(base_type)
                    _:
                        return false

        # Resolve bare type aliases in lexical collection order. Later declarations shadow
        # earlier ones; the caller supplies inherited aliases before local aliases. The
        # depth bound turns malformed/cyclic metadata into a fail-closed classification.
        def zeroed_is_nonnull_ref_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = type_expression
                steps: mutable usize = 0
                while steps <= alias_names.count |current, steps, alias_names, alias_values|:
                    true return if zeroed_is_nonnull_ref_type(current)
                    alias_name: sview = bare_type_name(current)
                    false return if alias_name == ""
                    alias_index: mutable usize = alias_names.count
                    search_index: mutable usize = alias_names.count
                    while search_index > 0 |search_index, alias_index, alias_names, alias_name|:
                        search_index <- search_index - 1
                        if alias_names[search_index] == alias_name:
                            alias_index <- search_index
                            break
                    false return if alias_index == alias_names.count
                    current <- alias_values[alias_index]
                    steps <- steps + 1
                # A chain longer than its declaration set can only be cyclic. Unknown type
                # identity cannot justify constructing a safe non-null reference.
                return true

        def zeroed_reject_nonnull_ref_declarations(statements: darray[Ast::Stmt], alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidNonNullReferenceInitialization, name: name, pos: line, line: line.line, expected: "non-null reference", actual: zeroed_reference_initializer_description(value)}) if zeroed_invalid_reference_initializer(value) and zeroed_is_nonnull_ref_type_via_alias(type_expression, alias_names, alias_values)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zeroed_reject_nonnull_ref_declarations(then_body, alias_names, alias_values, table)
                            table <- zeroed_reject_nonnull_ref_declarations(else_body, alias_names, alias_values, table)
                        Stmt.While(_, body, _) | Stmt.For(_, _, _, body, _) | Stmt.Block(_, _, _, body, _):
                            table <- zeroed_reject_nonnull_ref_declarations(body, alias_names, alias_values, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- zeroed_reject_nonnull_ref_declarations(arm.body, alias_names, alias_values, table)
                        _:
                            pass

        def zeroed_reject_sview_declarations(statements: darray[Ast::Stmt], alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, pos: line, line: line.line, expected: "sview with valid backing", actual: "zeroed"}) if zeroed_value_is_zeroed(value) and zeroed_is_sview_type(type_expression, alias_names, alias_values)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zeroed_reject_sview_declarations(then_body, alias_names, alias_values, table)
                            table <- zeroed_reject_sview_declarations(else_body, alias_names, alias_values, table)
                        Stmt.While(_, body, _) | Stmt.For(_, _, _, body, _) | Stmt.Block(_, _, _, body, _):
                            table <- zeroed_reject_sview_declarations(body, alias_names, alias_values, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- zeroed_reject_sview_declarations(arm.body, alias_names, alias_values, table)
                        _:
                            pass

        def zeroed_collect_type_aliases(declarations: darray[Ast::Decl], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, alias_line):
                            names.push(alias_name)
                            values.push(alias_value)
                        _:
                            pass

        def zeroed_value_is_zeroed(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, line):
                        return name == "zeroed"
                    _:
                        return false

        def zeroed_invalid_reference_initializer(value: Ast::Expr) -> bool:
            can Abort.Panic:
                return true if zeroed_value_is_zeroed(value)
                return true if value is Expr.Invalid or value is Expr.Absent
                return false

        def zeroed_reference_initializer_description(value: Ast::Expr) -> sview:
            can Abort.Panic:
                return "zeroed" if zeroed_value_is_zeroed(value)
                return "an omitted initializer"

        # Record every name that is initialized somewhere: an assignment target root, or a name
        # whose address is taken (`&x`). Both clear the zeroed-uninitialized seed in stage0.
        def zeroed_collect_initialized(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            root: sview = target_root_ident(target)
                            out.push(root) if root != ""
                            zeroed_collect_addressed_expression(value, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            zeroed_collect_addressed_expression(value, out)
                        Stmt.Expr(expression, line):
                            zeroed_collect_addressed_expression(expression, out)
                        Stmt.Return(value, line):
                            if value is returned:
                                zeroed_collect_addressed_expression(returned, out)
                        Stmt.If(condition, then_body, else_body, line):
                            zeroed_collect_initialized(then_body, out)
                            zeroed_collect_initialized(else_body, out)
                        Stmt.While(condition, body, line):
                            zeroed_collect_initialized(body, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            zeroed_collect_initialized(body, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            zeroed_collect_initialized(body, out)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out|:
                                zeroed_collect_initialized(arm.body, out)
                        _:
                            pass

        # Record the target of every address-of (`&x`) in an expression (initializes x).
        def zeroed_collect_addressed_expression(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        root: sview = ident_name_of(operand)
                        out.push(root) if operator == TokenKind.Ampersand and root != ""
                        zeroed_collect_addressed_expression(operand, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            zeroed_collect_addressed_expression(argument, out)
                    Expr.Binary(left, operator, right, line):
                        zeroed_collect_addressed_expression(left, out)
                        zeroed_collect_addressed_expression(right, out)
                    Expr.Paren(inner, line):
                        zeroed_collect_addressed_expression(inner, out)
                    _:
                        pass

        def zeroed_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # Emit for every `return <ident>` whose ident is an uninitialized zeroed candidate.
        def zeroed_check_returns(statements: darray[Ast::Stmt], candidates: darray[sview]&, initialized: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                returned_name: sview = ident_name_of(returned)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UninitializedZeroedRead, name: returned_name, line: line.line, expected: "", actual: ""}) if returned_name != "" and zeroed_name_present(candidates, returned_name) and not zeroed_name_present(initialized, returned_name)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zeroed_check_returns(then_body, candidates, initialized, table)
                            table <- zeroed_check_returns(else_body, candidates, initialized, table)
                        Stmt.While(condition, body, line):
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- zeroed_check_returns(arm.body, candidates, initialized, table)
                        _:
                            pass

        # Collect must-init `= zeroed` local declarations (recursively).
        def zeroed_collect_candidates(statements: darray[Ast::Stmt], alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if zeroed_value_is_zeroed(value) and zeroed_invalid_type_via_alias(type_expression, alias_names, alias_values) and not zeroed_is_sview_type(type_expression, alias_names, alias_values)
                        Stmt.If(condition, then_body, else_body, line):
                            zeroed_collect_candidates(then_body, alias_names, alias_values, out)
                            zeroed_collect_candidates(else_body, alias_names, alias_values, out)
                        Stmt.While(condition, body, line):
                            zeroed_collect_candidates(body, alias_names, alias_values, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            zeroed_collect_candidates(body, alias_names, alias_values, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            zeroed_collect_candidates(body, alias_names, alias_values, out)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out|:
                                zeroed_collect_candidates(arm.body, alias_names, alias_values, out)
                        _:
                            pass

        def check_uninitialized_zeroed(declarations: darray[Ast::Decl], inherited_alias_names: darray[sview]&, inherited_alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_values: mutable darray[Ast::Expr] = []
                alias_names.extend(inherited_alias_names)
                alias_values.extend(inherited_alias_values)
                zeroed_collect_type_aliases(declarations, alias_names, alias_values)
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            zeroed_reject_sview_declarations(body, alias_names, alias_values, table)
                            table <- zeroed_reject_nonnull_ref_declarations(body, alias_names, alias_values, table)
                            candidates: mutable darray[sview] = []
                            zeroed_collect_candidates(body, alias_names, alias_values, candidates)
                            initialized: mutable darray[sview] = []
                            zeroed_collect_initialized(body, initialized)
                            table <- zeroed_check_returns(body, candidates, initialized, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_uninitialized_zeroed(module_body, alias_names, alias_values, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_uninitialized_zeroed(scoped_body, alias_names, alias_values, table)
                        Decl.Const(name, type_expression, value, is_global, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidNonNullReferenceInitialization, name: name, pos: line, line: line.line, expected: "non-null reference", actual: zeroed_reference_initializer_description(value)}) if is_global and zeroed_invalid_reference_initializer(value) and zeroed_is_nonnull_ref_type_via_alias(type_expression, alias_names, alias_values)
                        _:
                            pass
