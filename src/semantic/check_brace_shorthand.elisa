# Leading-dot enum shorthand without an expected const-enum type. A `.Variant` shorthand only
# resolves when an expected const-enum type is in scope. In a set-membership test its expected
# type comes from the left operand; if that is a primitive, the shorthand cannot resolve:
#
#   def keep(value: i64) -> bool:
#       return value in {.IF}      # error: .IF requires an expected const enum type
#
# SOUND subset: flag a `EXPR in {… .Shorthand …}` where EXPR is a parameter of a primitive
# type (definitely not a const enum). A non-primitive/unknown left operand is a conservative
# miss (it may be a const enum for which the shorthand is valid).
extend Semantic:
    private:
        # The first shorthand member's leading part inside a set literal (`{.IF}` -> "IF"), or
        # "" if the set has no shorthand member.
        def bsh_set_shorthand_part(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                if expression is Expr.SetLit(elements, set_line):
                    for element in elements:
                        if element is Expr.ShorthandMember(parts, shorthand_line):
                            return parts[0] if parts.count > 0 else sview("", 0, 0)
                return sview("", 0, 0)

        def bsh_is_primitive(type_name: sview) -> bool:
            can Abort.Panic:
                return is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name) or type_name == "bool" or type_name == "char"

        def bsh_param_primitive(parameters: darray[Ast::ParamDecl]&, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters:
                    if parameter.name == name:
                        return bsh_is_primitive(bare_type_name(parameter.type_expression))
                return false

        def bsh_check_expression(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.In:
                            shorthand_part: sview = bsh_set_shorthand_part(right)
                            if shorthand_part != "" and left is Expr.Ident(left_name, left_ident_line):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BraceShorthandNoContext, name: shorthand_part, line: binary_line, expected: "", actual: ""}) if bsh_param_primitive(parameters, left_name)
                        table <- bsh_check_expression(left, parameters, table)
                        table <- bsh_check_expression(right, parameters, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- bsh_check_expression(operand, parameters, table)
                    Expr.Paren(inner, paren_line):
                        table <- bsh_check_expression(inner, parameters, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- bsh_check_expression(argument, parameters, table)
                    _:
                        pass

        def bsh_check_statements(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- bsh_check_expression(returned, parameters, table)
                        Stmt.Expr(expression, line):
                            table <- bsh_check_expression(expression, parameters, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- bsh_check_expression(value, parameters, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- bsh_check_expression(value, parameters, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- bsh_check_expression(condition, parameters, table)
                            table <- bsh_check_statements(then_body, parameters, table)
                            table <- bsh_check_statements(else_body, parameters, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- bsh_check_expression(condition, parameters, table)
                            table <- bsh_check_statements(while_body, parameters, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- bsh_check_statements(for_body, parameters, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- bsh_check_statements(body, parameters, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- bsh_check_statements(arm.body, parameters, table)
                        _:
                            pass

        def bsh_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- bsh_check_statements(body, parameters, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- bsh_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- bsh_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_brace_shorthand(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- bsh_check_declarations(file.top_decls, table)
