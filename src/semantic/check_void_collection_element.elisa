# A void value can never be a collection element/key/value. `darray`/`set`/`dict` LITERAL
# elements (`[h()]`, `{h()}`, `{1: h()}`) whose inferred type is Void fire. Sound subset:
# only fires on SemTypeKind.Void (a `-> void` call); Unknown/firm-typed elements never fire.

extend Semantic:
    private:
        # Check one collection-literal element/key/value; push a diagnostic if it infers Void.
        def check_void_collection_element_against(element: Ast::Expr, expected_elem: sview, line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                element_type: InferType = infer_expression_type(element, var_types, type_names, table)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidCollectionElement, name: "", line: line, expected: expected_elem, actual: ""}) if element_type.kind == SemTypeKind.Void

        # Walk through expressions, checking for void collection literal elements.
        def walk_expression_for_void_collection_element(expression: Ast::Expr, expected_void_elem: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_void_collection_element(left, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(right, "", table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_void_collection_element(callee, "", table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_collection_element(argument, "", table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_void_collection_element(object, "", table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_void_collection_element(base, "", table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_void_collection_element(object, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(index, "", table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_void_collection_element(operand, "", table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_void_collection_element(inner, "", table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- check_void_collection_element_against(element, expected_void_elem, line, var_types, type_names, table)
                            table <- walk_expression_for_void_collection_element(element, "", table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_collection_element(element, "", table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_void_collection_element(object, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(low, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(high, "", table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_void_collection_element(object, "", table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_collection_element(argument, "", table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- check_void_collection_element_against(element, expected_void_elem, line, var_types, type_names, table)
                            table <- walk_expression_for_void_collection_element(element, "", table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- check_void_collection_element_against(entry.key, "", line, var_types, type_names, table)
                            table <- check_void_collection_element_against(entry.value, "", line, var_types, type_names, table)
                            table <- walk_expression_for_void_collection_element(entry.key, "", table, var_types, type_names)
                            table <- walk_expression_for_void_collection_element(entry.value, "", table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_void_collection_element(type_expression, "", table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_collection_element(field.value, "", table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_void_collection_element(base, "", table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_collection_element(field.value, "", table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_void_collection_element(condition, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(then_expr, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(else_expr, "", table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_void_collection_element(iterable, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(condition, "", table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(body, "", table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_void_collection_element(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_void_collection_element(statements, table, var_types, type_names)
                        table <- walk_expression_for_void_collection_element(value, "", table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_void_collection_element(scrutinee, "", table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_void_collection_element(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for void collection elements.
        def walk_statements_for_void_collection_element(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_void_collection_element(expression, "", table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_void_collection_element(value, extract_darray_element_type_name(type_expression), table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_void_collection_element(target, "", table, var_types, type_names)
                            table <- walk_expression_for_void_collection_element(value, "", table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_void_collection_element(condition, "", table, var_types, type_names)
                            table <- walk_statements_for_void_collection_element(then_body, table, var_types, type_names)
                            table <- walk_statements_for_void_collection_element(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_void_collection_element(condition, "", table, var_types, type_names)
                            table <- walk_statements_for_void_collection_element(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_void_collection_element(iterable, "", table, var_types, type_names)
                            table <- walk_statements_for_void_collection_element(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_void_collection_element(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_void_collection_element(scrutinee, "", table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_void_collection_element(arm.guard, "", table, var_types, type_names)
                                table <- walk_statements_for_void_collection_element(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_void_collection_element(return_value, "", table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_void_collection_element(expression, "", table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_void_collection_element_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_void_collection_element(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_void_collection_element_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_collection_element_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_void_collection_element(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_void_collection_element_declarations(declarations, table)
