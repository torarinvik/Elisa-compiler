# `zip_map(dst, src..., fn)` requires each SOURCE view to be readonly (produced by
# `readonly(...)`), so the vectorizer can prove no aliasing writes. Decidable subset:
# a source argument that is a SLICE (`buf[2:4]`) or an ident bound to one is provably
# NOT readonly — flag it. readonly(...)/chunks_exact(...)-bound sources stay silent.
extend Semantic:
    private:
        # Whether a value is a `readonly(...)` call.
        def zip_map_is_readonly_call(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return ident_name_of(callee) == "readonly"
                    _:
                        return false

        # Whether the object being sliced is itself readonly — a `readonly(...)` call or an
        # ident already bound to a readonly view. A slice of a readonly view IS readonly.
        def zip_map_slice_object_is_readonly(sliced_object: Ast::Expr, readonly_bound: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if zip_map_is_readonly_call(sliced_object)
                match sliced_object:
                    Expr.Ident(object_name, object_line):
                        return any bound in readonly_bound where bound == object_name
                    _:
                        return false

        def zip_map_walk(statements: darray[Ast::Stmt], slice_bound: mutable darray[sview]&, readonly_bound: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, slice_bound, readonly_bound| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            # A `readonly(...)` result, and a SLICE of an already-readonly view,
                            # are readonly. Only a slice of a non-readonly view taints the binding.
                            if zip_map_is_readonly_call(value):
                                readonly_bound.push(name)
                            else:
                                match value:
                                    Expr.Slice(sliced_object, low, high, slice_line):
                                        if zip_map_slice_object_is_readonly(sliced_object, readonly_bound):
                                            readonly_bound.push(name)
                                        else:
                                            slice_bound.push(name)
                                    _:
                                        pass
                            table <- zip_map_call_check(value, line, slice_bound, table)
                        Stmt.Expr(expression, line):
                            table <- zip_map_call_check(expression, line, slice_bound, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- zip_map_call_check(value, line, slice_bound, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- zip_map_call_check(returned, line, slice_bound, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zip_map_walk(then_body, slice_bound, readonly_bound, table)
                            table <- zip_map_walk(else_body, slice_bound, readonly_bound, table)
                        Stmt.While(condition, body, line):
                            table <- zip_map_walk(body, slice_bound, readonly_bound, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- zip_map_walk(body, slice_bound, readonly_bound, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- zip_map_walk(body, slice_bound, readonly_bound, table)
                        _:
                            pass

        # Whether a zip_map SOURCE argument is provably a mutable slice view.
        def zip_map_source_is_slice(argument: Ast::Expr, slice_bound: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Slice(sliced_object, low, high, slice_line):
                        return true
                    Expr.Ident(source_name, source_line):
                        return any bound in slice_bound where bound == source_name
                    _:
                        return false

        def zip_map_call_check(expression: Ast::Expr, line: u32, slice_bound: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        is_zip_map: bool = callee_name == "zip_map" and arguments.count >= 3
                        # Sources are the args between dst (position 0) and the
                        # trailing callback. Guard the subtraction: `count - 1`
                        # UNDERFLOWS for an empty argument list (usize wraparound
                        # spun this loop ~2^64 times on `f()`).
                        source_limit: usize = arguments.count - 1 if arguments.count > 0 else 0
                        while source_index < source_limit |source_index: usize = 1, table|:
                            source_is_slice: bool = is_zip_map and zip_map_source_is_slice(arguments[source_index], slice_bound)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ZipMapSourceNotReadonly, name: "", line: line, expected: "", actual: "", expected_count: source_index.u32()}) if source_is_slice
                            source_index <- source_index + 1
                    _:
                        pass

        def check_zip_map_readonly(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            slice_bound: mutable darray[sview] = []
                            readonly_bound: mutable darray[sview] = []
                            table <- zip_map_walk(body, slice_bound, readonly_bound, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_zip_map_readonly(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_zip_map_readonly(scoped_body, table)
                        _:
                            pass
