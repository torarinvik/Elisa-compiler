# A view into FRAME-LOCAL storage RETURNED from the function that owns the frame:
#
#     def leak() -> view[i64]:
#         scratch: mutable i64[4] = zeroed
#         return scratch[0:2]      # the array dies with the frame; the caller reads dead stack
#
# Both compilers accepted this (MEASURED 2026-09-07) and the program read a dead frame -- a
# memory-unsafe SILENT miscompile no gate could see. The roots:
#
#   * a `T[N]`/`array[T, N]` local or a by-VALUE `T[N]` parameter (a copy that lives in the
#     callee's frame) -- LocalViewEscapesReturn;
#   * a by-value `darray[T]`/`dstr` local: its buffer lives in this call's inferred region, freed
#     on return -- AutoRegionReturnEscape, stage0's `via return` region escape (MEASURED
#     2026-09-28: stage0 rejected s1e/r2/r6/n4/n9, stage1 accepted and read freed memory).
#
#   * a fixed array held IN a by-value struct local or parameter (`s.buf[0:2]` with `buf: u8[4]`):
#     the field lives in the struct, which lives in the frame -- LocalViewEscapesReturn (stage0
#     sliceViewsFrameArray; MEASURED 2026-09-30: stage1 accepted it and the caller read a
#     clobbered frame);
#   * `d.as_sview()` / `bytes_view(d)` of a by-value container local when the function does not
#     adopt its caller's region (a view-typed result has no hidden region slot in this ABI, so the
#     buffer is freed before the caller reads it; MEASURED 2026-09-30: the caller read zeros).
#
# A value escapes when it is a slice of a root or of a view already carrying one, or a bare name
# of such a view, through parentheses, either arm of an `if`, a struct-literal field or a tuple
# element (`Holder{v: xs[0:2]}` dangles exactly like `xs[0:2]`). Views are tracked
# flow-insensitively: a name ever bound to a dangling view is dangling (stage0 rejects the
# rebind-to-param shape n2 too). A trailing expression statement is a return.
#
# Sound-subset boundaries (every finding is a genuine dangling view; misses are fail-open):
#   * ref parameters (`T[N]&`, `darray[T]&`), by-value darray parameters and globals are
#     caller-owned and stay allowed;
#   * a name declared more than once with differing root-ness is skipped;
#   * container roots are dropped when the function may ADOPT its caller's region (stage0's
#     region-polymorphism): any returned leaf that is not a slice, a non-container name or a
#     literal -- a returned container, a call, a fresh literal -- or an `Arena` parameter. There
#     the buffer lives in the caller's arena and the view is sound (n10: `Both{items: xs,
#     v: xs[0:2]}` runs correctly under both compilers).
extend Semantic:
    private:
        # The declared type behind `mutable` and parentheses.
        def lvre_declared_type(type_expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        return lvre_declared_type(operand) if operator == TokenKind.Mutable else type_expression
                    Expr.Paren(inner, paren_pos):
                        return lvre_declared_type(inner)
                    _:
                        return type_expression

        # A fixed array held IN the frame: the bare `T[N]` / `array[T, N]` node itself. A ref to
        # one (`T[N]&`) is a different node and is NOT a frame array.
        def lvre_frame_array(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                peeled: Ast::Expr = lvre_declared_type(type_expression)
                match peeled:
                    Expr.Index(index_object, index_argument, index_pos):
                        return fixed_array_extent(peeled) > 0
                    Expr.IndexN(indexn_object, indexn_arguments, indexn_pos):
                        return fixed_array_extent(peeled) > 0
                    _:
                        return false

        # A by-value `darray[T]` / `dstr` annotation (optionally `mutable`). The direct head
        # parser strips `mutable` and parentheses while leaving reference/region-qualified
        # shapes unresolved, which is exactly the root classification this pass needs.
        def lvre_container_value(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                head: sview = dd_type_head_arg(type_expression).head
                return head == "darray" or head == "dstr"

        # A by-value numeric/bool annotation: such a local holds a copy, never region storage,
        # so it is not an alias of its initializer even when that initializer is ill-typed
        # (`x: i64 = xs` is reported as the type mismatch alone, as stage0 does).
        def lvre_scalar_value(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match lvre_declared_type(type_expression):
                    Expr.Ident(type_name, type_pos):
                        return when type_name:
                            "i8" | "i16" | "i32" | "i64" | "i128" | "u8" | "u16" | "u32" | "u64" | "u128" | "usize" | "isize" | "int" | "uint" | "f32" | "f64" | "bool" | "char" -> true
                            _ -> false
                    _:
                        return false

        # The caller-region return exception below only handles value arrays of primitive
        # elements. A region-correct array allocation does not establish the provenance of
        # reference-bearing elements (or nested containers), so those remain on the ordinary
        # fail-closed path and must be proven by the region-dependency checks.
        def lvre_scalar_darray_value(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                head_arg: (head: sview, argument: sview) = dd_type_head_arg(type_expression)
                return false if head_arg.head != "darray"
                return is_integer_type_name(head_arg.argument) or is_float_type_name(head_arg.argument) or head_arg.argument == "bool" or head_arg.argument == "char"

        # An `Arena` parameter (by value or by ref): the function manages its own allocation.
        def lvre_arena_param(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                if rvc_ref_pointee(type_expression) is pointee:
                    return dd_type_head_arg(pointee).head == "Arena" if not rvc_is_absent(pointee)
                return dd_type_head_arg(type_expression).head == "Arena"

        def lvre_has(names: darray[sview @source]&, name: sview) -> bool:
            can Abort.Panic:
                for entry in names:
                    return true if entry == name
                return false

        def lvre_pair_has(roots: darray[sview @source]&, fields: darray[sview @source]&, root: sview, field: sview) -> bool:
            can Abort.Panic:
                while index < roots.count |index: usize = 0|:
                    return true if roots[index] == root and fields[index] == field
                    index <- index + 1
                return false

        # Every by-value struct-typed declaration in the body (`s: S = ...`), flow-insensitively.
        def lvre_struct_decls(statements: darray[Ast::Stmt]&, sr_names: mutable darray[sview @source]&, sr_types: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |sr_names, sr_types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, decl_pos):
                            declared: sview = bare_type_name(type_expression)
                            if declared != "":
                                sr_names.push(name)
                                sr_types.push(declared)
                        Stmt.Block(kind, clause, binding, body, block_pos):
                            lvre_struct_decls(body, sr_names, sr_types)
                        Stmt.If(condition, then_body, else_body, if_pos):
                            lvre_struct_decls(then_body, sr_names, sr_types)
                            lvre_struct_decls(else_body, sr_names, sr_types)
                        Stmt.While(condition, while_body, while_pos):
                            lvre_struct_decls(while_body, sr_names, sr_types)
                        Stmt.For(bind, variables, iterable, for_body, for_pos):
                            lvre_struct_decls(for_body, sr_names, sr_types)
                        Stmt.Match(scrutinee, arms, match_pos):
                            for arm in arms |sr_names, sr_types|:
                                lvre_struct_decls(arm.body, sr_names, sr_types)
                        _:
                            pass

        def lvre_count(names: darray[sview @source]&, name: sview) -> usize:
            can Abort.Panic:
                total: mutable usize = 0
                for entry in names |total|:
                    total <- total + 1 if entry == name
                return total

        # (root, field) pairs where `root` is a by-value struct local/parameter (every declaration
        # of the name is one, all of the same struct type) and `field` is a fixed array held IN it:
        # `root.field[a:b]` views the frame.
        def lvre_struct_array_fields(names: darray[sview @source]&, sr_names: darray[sview @source]&, sr_types: darray[sview @source]&, f_struct: darray[sview @source]&, f_name: darray[sview @source]&, f_type: darray[Ast::Expr]&, f_heads: dict[u64, u32]&, f_next: darray[u32]&, sroots: mutable darray[sview @source]&, sfields: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for probe in 0..<sr_names.count |sroots, sfields|:
                    continue if lvre_count(names, sr_names[probe]) != lvre_count(sr_names, sr_names[probe])
                    uniform: mutable bool = true
                    for other in 0..<sr_names.count |uniform|:
                        uniform <- false if sr_names[other] == sr_names[probe] and sr_types[other] != sr_types[probe]
                    continue if not uniform
                    field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    if f_heads.get(name_hash(sr_types[probe])) is field_head:
                        field_row <- field_head
                    while field_row != SYMBOL_INDEX_ROW_NONE |field_row, sroots, sfields, f_struct, f_name, f_type, f_next, sr_names, sr_types, probe|:
                        field_index: usize = field_row.usize()
                        if f_struct[field_index] == sr_types[probe] and lvre_frame_array(f_type[field_index]):
                            sroots.push(sr_names[probe])
                            sfields.push(f_name[field_index])
                        field_row <- f_next[field_index]

        # The bare name a slice is taken of, through parentheses; "" for anything else.
        def lvre_slice_root(object: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match object:
                    Expr.Ident(name, ident_pos):
                        return name
                    Expr.Paren(inner, paren_pos):
                        return lvre_slice_root(inner)
                    _:
                        return sview("", 0, 0)

        # The container a byte-view call borrows: `d.as_sview()` / `d.as_cstr()` (any receiver
        # name) and `bytes_view(d)` / `bytes_view_range(d, ..)`; "" for any other call.
        def lvre_view_call_root(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(receiver, method, method_pos):
                                return lvre_slice_root(receiver) if (method == "as_sview" or method == "as_cstr") and arguments.count == 0
                            Expr.Ident(callee_name, callee_pos):
                                return lvre_slice_root(arguments[0]) if (callee_name == "bytes_view" or callee_name == "bytes_view_range") and arguments.count > 0
                            _:
                                pass
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # The (root, field) a byte-view call borrows when its receiver is `root.field`:
        # `h.bytes.as_sview()` / `h.bytes.as_cstr()` / `bytes_view(h.bytes)`; ("", "") otherwise.
        def lvre_view_call_field(value: Ast::Expr) -> (root: sview, field: sview):
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(Expr.Field(receiver, method, _), arguments, _, _):
                        if (method == "as_sview" or method == "as_cstr") and arguments.count == 0:
                            match receiver:
                                Expr.Field(field_object, field_name, _):
                                    return (lvre_slice_root(field_object), field_name)
                                _:
                                    pass
                        return (sview("", 0, 0), sview("", 0, 0))
                    Expr.Call(Expr.Ident(callee_name, _), arguments, _, _):
                        if (callee_name == "bytes_view" or callee_name == "bytes_view_range") and arguments.count > 0:
                            match arguments[0]:
                                Expr.Field(field_object, field_name, _):
                                    return (lvre_slice_root(field_object), field_name)
                                _:
                                    pass
                        return (sview("", 0, 0), sview("", 0, 0))
                    _:
                        return (sview("", 0, 0), sview("", 0, 0))

        # The root a VALUE carries a dangling view of, if any: a slice of a frame array
        # (`arrays`), of a container local (`containers`) or of a dangling view (`array_views` /
        # `container_views`, by the root they carry); a view
        # named bare; through parens, `if` arms, struct-literal fields and tuple elements (the
        # first escaping one is named). `container` says the root is region-, not frame-owned.

        # (root, field) pairs where `root` is a by-value struct LOCAL (never a parameter: a
        # by-value parameter shares its darray buffers with the caller), every declaration of
        # it of one struct type, and `field` a by-value darray/dstr held in it. A view INTO
        # `root.field` (`h.name()` returning `bytes_view_range(self.buf, ..)`) dangles once the
        # frame's arena is released, exactly like a view of a darray local.
        def lvre_struct_darray_fields(names: darray[sview @source]&, parameters: darray[Ast::ParamDecl]&, sr_names: darray[sview @source]&, sr_types: darray[sview @source]&, f_struct: darray[sview @source]&, f_name: darray[sview @source]&, f_type: darray[Ast::Expr]&, f_heads: dict[u64, u32]&, f_next: darray[u32]&, droots: mutable darray[sview @source]&, dfields: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for probe in 0..<sr_names.count |droots, dfields|:
                    continue if any parameter in parameters where parameter.name == sr_names[probe]
                    continue if lvre_count(names, sr_names[probe]) != lvre_count(sr_names, sr_names[probe])
                    uniform: mutable bool = true
                    for other in 0..<sr_names.count |uniform|:
                        uniform <- false if sr_names[other] == sr_names[probe] and sr_types[other] != sr_types[probe]
                    continue if not uniform or lvre_has(droots, sr_names[probe])
                    field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    if f_heads.get(name_hash(sr_types[probe])) is field_head:
                        field_row <- field_head
                    while field_row != SYMBOL_INDEX_ROW_NONE |field_row, droots, dfields, f_struct, f_name, f_type, f_next, sr_names, sr_types, probe|:
                        field_index: usize = field_row.usize()
                        if f_struct[field_index] == sr_types[probe] and lvre_container_value(f_type[field_index]):
                            droots.push(sr_names[probe])
                            dfields.push(f_name[field_index])
                        field_row <- f_next[field_index]

        def lvre_escaping_name(value: Ast::Expr, arrays: darray[sview @source]&, containers: darray[sview @source]&, array_views: darray[sview @source]&, container_views: darray[sview @source]&, sroots: darray[sview @source]&, sfields: darray[sview @source]&, droots: darray[sview @source]&, dfields: darray[sview @source]&, rows: darray[sview @source]&) -> (name: sview, pos: Ast::Pos, found: bool, container: bool):
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return lvre_escaping_name(inner, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                    # `return move local_container` has the same backing storage as a bare
                    # return; moving the header does not move the auto-region allocation.  The
                    # old walker stopped at Expr.Move, so the local root was invisible here.
                    Expr.Move(inner, move_pos):
                        return lvre_escaping_name(inner, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                    Expr.Slice(slice_object, slice_low, slice_high, slice_pos):
                        match slice_object:
                            Expr.Field(field_object, field_name, field_pos):
                                field_root: sview = lvre_slice_root(field_object)
                                return (field_root, slice_pos, true, false) if lvre_pair_has(sroots, sfields, field_root, field_name)
                                return (field_root, slice_pos, true, true) if lvre_pair_has(droots, dfields, field_root, field_name)
                            _:
                                pass
                        root: sview = lvre_slice_root(slice_object)
                        return (root, slice_pos, true, false) if lvre_has(arrays, root)
                        return (root, slice_pos, true, true) if lvre_has(containers, root)
                        return lvre_escaping_name(slice_object, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                    Expr.Call(call_callee, call_arguments, call_argument_names, call_pos):
                        call_root: sview = lvre_view_call_root(value)
                        return (call_root, call_pos, true, true) if call_root != "" and lvre_has(containers, call_root)
                        # `h.bytes.as_sview()` of a darray/dstr field of a by-value struct local
                        # (fuzz F1): the bytes live in this call's region exactly like a darray
                        # local's, so the view dangles once it is returned.
                        field_view: (root: sview, field: sview) = lvre_view_call_field(value)
                        return (field_view.root, call_pos, true, true) if field_view.root != "" and lvre_pair_has(droots, dfields, field_view.root, field_view.field)
                        # An enum payload is held by value, like a tuple element: `Tok.Word(v)`.
                        if enum_variant_callee(call_callee):
                            for argument in call_arguments:
                                payload_escape: (name: sview, pos: Ast::Pos, found: bool, container: bool) = lvre_escaping_name(argument, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                                return payload_escape if payload_escape.found
                            return (sview("", 0, 0), call_pos, false, false)
                        # A user function returning a view of its argument (`id(xs[0:2])`,
                        # `first_view(&buf)`): the result dangles exactly when that argument does.
                        origin_arguments: darray[Ast::Expr] = vro_origin_arguments(call_callee, call_arguments, rows, true)
                        for origin_argument in origin_arguments:
                            origin_escape: (name: sview, pos: Ast::Pos, found: bool, container: bool) = lvre_escaping_name(origin_argument, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                            return (origin_escape.name, call_pos, true, origin_escape.container) if origin_escape.found
                        into_arguments: darray[Ast::Expr] = vro_origin_arguments(call_callee, call_arguments, rows, false)
                        into_fields: darray[sview @source] = vro_origin_fields(call_callee, call_arguments, rows, false)
                        for into_index in 0..<into_arguments.count:
                            into_argument: Ast::Expr = into_arguments[into_index]
                            into_root: sview = lvre_slice_root(vro_strip_borrow(into_argument))
                            into_field: sview = into_fields[into_index] if into_index < into_fields.count else ""
                            return (into_root, call_pos, true, true) if into_root != "" and into_field != "" and lvre_pair_has(droots, dfields, into_root, into_field)
                            return (into_root, call_pos, true, false) if into_root != "" and lvre_has(arrays, into_root)
                            return (into_root, call_pos, true, true) if into_root != "" and lvre_has(containers, into_root)
                        return (sview("", 0, 0), call_pos, false, false)
                    Expr.Ident(name, ident_pos):
                        return (name, ident_pos, true, false) if lvre_has(array_views, name)
                        # Returning the container value itself is also an escape: moving or
                        # copying its header does not move the backing allocation out of the
                        # function's inferred auto-region. Parameters are not in `containers`,
                        # so caller-owned by-value/ref containers remain valid here.
                        return (name, ident_pos, true, true) if lvre_has(containers, name)
                        return (name, ident_pos, lvre_has(container_views, name), true)
                    Expr.If(condition, then_value, else_value, if_pos):
                        then_arm: (name: sview, pos: Ast::Pos, found: bool, container: bool) = lvre_escaping_name(then_value, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                        return then_arm if then_arm.found else lvre_escaping_name(else_value, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                    Expr.Construct(construct_type, construct_fields, construct_pos):
                        for field in construct_fields:
                            field_escape: (name: sview, pos: Ast::Pos, found: bool, container: bool) = lvre_escaping_name(field.value, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                            return field_escape if field_escape.found
                        return (sview("", 0, 0), construct_pos, false, false)
                    Expr.Tuple(tuple_elements, tuple_pos):
                        for element in tuple_elements:
                            element_escape: (name: sview, pos: Ast::Pos, found: bool, container: bool) = lvre_escaping_name(element, arrays, containers, array_views, container_views, sroots, sfields, droots, dfields, rows)
                            return element_escape if element_escape.found
                        return (sview("", 0, 0), tuple_pos, false, false)
                    _:
                        return (sview("", 0, 0), Ast::pos_at_line(0), false, false)

        # Whether a returned value may make the function ADOPT its caller's region (see header):
        # true unless every leaf -- through parens, `if` arms, struct-literal fields and tuple
        # elements -- is a slice, a literal, or a name that is not a container local.
        def lvre_adopting_value(value: Ast::Expr, containers: darray[sview @source]&, rows: darray[sview @source]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return lvre_adopting_value(inner, containers, rows)
                    Expr.Slice(slice_object, slice_low, slice_high, slice_pos):
                        return false
                    Expr.Ident(name, ident_pos):
                        return lvre_has(containers, name)
                    # A move of a local darray must not make the function adopt the caller's
                    # region: its backing buffer is still owned by this call's inferred region.
                    # Moves of parameters and non-container values retain the existing adoption
                    # behavior because they are not in `containers`.
                    Expr.Move(inner, move_pos):
                        match inner:
                            Expr.Ident(name, ident_pos):
                                return false if lvre_has(containers, name)
                                return true
                            _:
                                return lvre_adopting_value(inner, containers, rows)
                    Expr.IntLit(int_text, int_pos):
                        return false
                    Expr.FloatLit(float_text, float_pos):
                        return false
                    Expr.StringLit(string_text, string_pos):
                        return false
                    Expr.CharLit(char_text, char_pos):
                        return false
                    Expr.BoolLit(bool_value, bool_pos):
                        return false
                    Expr.Call(call_callee, call_arguments, call_argument_names, call_pos):
                        if enum_variant_callee(call_callee):
                            for argument in call_arguments:
                                return true if lvre_adopting_value(argument, containers, rows)
                            return false
                        view_root: sview = lvre_view_call_root(value)
                        return false if:
                            view_root != "" and lvre_has(containers, view_root)
                            # A view of a struct local's darray field (F1) is not an adopted value.
                            lvre_view_call_field(value).root != ""
                        # A summarised user call adopts only what its carried arguments adopt;
                        # an "into" origin borrows the argument's storage and adopts nothing.
                        status: u8 = vro_call_status(call_callee, call_arguments.count, rows)
                        return true if status != 1
                        for carried_argument in vro_origin_arguments(call_callee, call_arguments, rows, true):
                            return true if lvre_adopting_value(carried_argument, containers, rows)
                        return false
                    Expr.If(condition, then_value, else_value, if_pos):
                        return lvre_adopting_value(then_value, containers, rows) or lvre_adopting_value(else_value, containers, rows)
                    Expr.Construct(construct_type, construct_fields, construct_pos):
                        for field in construct_fields:
                            return true if lvre_adopting_value(field.value, containers, rows)
                        return false
                    Expr.Tuple(tuple_elements, tuple_pos):
                        for element in tuple_elements:
                            return true if lvre_adopting_value(element, containers, rows)
                        return false
                    _:
                        return true

        # Every declaration in the body, flow-insensitively: `names[i]` is declared with
        # root-ness `kinds[i]` (0 = not a root, 1 = frame array, 2 = container local). Bindings
        # (`name: T = value` and `name = value` / `name <- value`) land in `bound`/`values`.
        # Assignments are also tracked separately so same-line writes cannot be confused with
        # the declaration's own initializer when validating a caller-region return.
        def lvre_collect(statements: darray[Ast::Stmt]&, names: mutable darray[sview @source]&, name_lines: mutable darray[u32]&, name_values: mutable darray[Ast::Expr]&, kinds: mutable darray[u8]&, bound: mutable darray[sview @source]&, bound_lines: mutable darray[u32]&, writes: mutable darray[sview @source]&, write_lines: mutable darray[u32]&, values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, decl_pos):
                            names.push(name)
                            name_lines.push(decl_pos.line)
                            name_values.push(value)
                            if lvre_frame_array(type_expression):
                                kinds.push(1)
                            else:
                                kinds.push(2 if lvre_container_value(type_expression) else 0)
                            if not lvre_scalar_value(type_expression):
                                bound.push(name)
                                bound_lines.push(decl_pos.line)
                                values.push(value)
                        Stmt.Assign(target, operator, value, assign_pos):
                            match target:
                                Expr.Ident(target_name, target_pos):
                                    # `name = value` defines an unannotated local: never a root.
                                    if operator == TokenKind.Assign:
                                        names.push(target_name)
                                        name_lines.push(assign_pos.line)
                                        name_values.push(value)
                                        kinds.push(0)
                                    bound.push(target_name)
                                    bound_lines.push(assign_pos.line)
                                    writes.push(target_name)
                                    write_lines.push(assign_pos.line)
                                    values.push(value)
                                _:
                                    pass
                        Stmt.Block(kind, clause, binding, body, block_pos):
                            lvre_collect(body, names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values)
                        Stmt.If(condition, then_body, else_body, if_pos):
                            lvre_collect(then_body, names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values)
                            lvre_collect(else_body, names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values)
                        Stmt.While(condition, while_body, while_pos):
                            lvre_collect(while_body, names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values)
                        Stmt.For(bind, variables, iterable, for_body, for_pos):
                            for variable in variables |names, name_lines, name_values, kinds|:
                                names.push(variable)
                                name_lines.push(for_pos.line)
                                name_values.push(Ast::Expr.Invalid)
                                kinds.push(0)
                            lvre_collect(for_body, names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values)
                        Stmt.Match(scrutinee, arms, match_pos):
                            for arm in arms |names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values|:
                                lvre_collect(arm.body, names, name_lines, name_values, kinds, bound, bound_lines, writes, write_lines, values)
                        _:
                            pass

        # Every returned value: `return EXPR` anywhere in the statement tree, plus the function's
        # trailing expression statement (through a trailing clause block).
        def lvre_returns(statements: darray[Ast::Stmt]&, is_tail: bool, out: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while statement_index < statements.count |statement_index: usize = 0, out|:
                    last: bool = is_tail and statement_index + 1 == statements.count
                    statement: Ast::Stmt = statements[statement_index]
                    statement_index <- statement_index + 1
                    match statement:
                        Stmt.Return(value, return_pos):
                            if value is returned:
                                out.push(returned)
                        Stmt.Expr(expression, expression_pos):
                            out.push(expression) if last
                        Stmt.Block(kind, clause, binding, body, block_pos):
                            lvre_returns(body, last, out)
                        Stmt.If(condition, then_body, else_body, if_pos):
                            lvre_returns(then_body, false, out)
                            lvre_returns(else_body, false, out)
                        Stmt.While(condition, while_body, while_pos):
                            lvre_returns(while_body, false, out)
                        Stmt.For(bind, variables, iterable, for_body, for_pos):
                            lvre_returns(for_body, false, out)
                        Stmt.Match(scrutinee, arms, match_pos):
                            for arm in arms |out|:
                                lvre_returns(arm.body, false, out)
                        _:
                            pass

        # The names whose every declaration has root-ness `kind`.
        def lvre_roots(names: darray[sview @source]&, kinds: darray[u8]&, kind: u8) -> darray[sview @source]:
            can Memory.Allocate, Abort.Panic:
                roots: mutable darray[sview @source] = []
                while probe < names.count |probe: usize = 0, roots|:
                    if kinds[probe] == kind and not lvre_has(roots, names[probe]):
                        uniform: mutable bool = true
                        while other < names.count |other: usize = 0, uniform|:
                            uniform <- false if names[other] == names[probe] and kinds[other] != kind
                            other <- other + 1
                        roots.push(names[probe]) if uniform
                    probe <- probe + 1
                return roots

        # `&X` of a frame array or container local is a borrow of X's storage.
        def lvre_address_root(value: Ast::Expr, arrays: darray[sview @source]&, containers: darray[sview @source]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return lvre_address_root(inner, arrays, containers)
                    Expr.Unary(operator, operand, unary_pos):
                        root: sview = lvre_slice_root(operand)
                        if operator == TokenKind.Ampersand and (lvre_has(arrays, root) or lvre_has(containers, root)):
                            return root
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Whether a statement list (a lambda body) mentions any of NAMES outside SHADOWED.
        def lvre_stmts_mention(statements: darray[Ast::Stmt]&, names: darray[sview @source]&, shadowed: darray[sview @source]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    found: sview = lvre_stmt_mention(statement, names, shadowed)
                    return found if found != ""
                return sview("", 0, 0)

        # A name of NAMES outside SHADOWED that EXPRESSION mentions (in expr_mentions_name's
        # sense), or "". One walk tests each identifier against the lists, instead of one
        # walk per name; callers only ask whether the result is empty.
        def lvre_expr_mention(expression: Ast::Expr, names: darray[sview @source]&, shadowed: darray[sview @source]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(ident_name, ident_pos):
                        return ident_name if ident_name != "" and lvre_has(names, ident_name) and not lvre_has(shadowed, ident_name)
                    Expr.Field(object, field, field_pos):
                        return lvre_expr_mention(object, names, shadowed)
                    Expr.Index(object, index, index_pos):
                        found: sview = lvre_expr_mention(object, names, shadowed)
                        return found if found != ""
                        return lvre_expr_mention(index, names, shadowed)
                    Expr.IndexN(object, arguments, index_pos):
                        found: sview = lvre_expr_mention(object, names, shadowed)
                        return found if found != ""
                        return lvre_exprs_mention(arguments, names, shadowed)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        found: sview = lvre_expr_mention(callee, names, shadowed)
                        return found if found != ""
                        return lvre_exprs_mention(arguments, names, shadowed)
                    Expr.Binary(left, operator, right, binary_pos):
                        found: sview = lvre_expr_mention(left, names, shadowed)
                        return found if found != ""
                        return lvre_expr_mention(right, names, shadowed)
                    Expr.Unary(operator, operand, unary_pos):
                        return lvre_expr_mention(operand, names, shadowed)
                    Expr.Paren(inner, paren_pos):
                        return lvre_expr_mention(inner, names, shadowed)
                    Expr.Array(elements, array_pos):
                        return lvre_exprs_mention(elements, names, shadowed)
                    Expr.Tuple(elements, tuple_pos):
                        return lvre_exprs_mention(elements, names, shadowed)
                    Expr.SetLit(elements, set_pos):
                        return lvre_exprs_mention(elements, names, shadowed)
                    _:
                        pass
                return sview("", 0, 0)

        def lvre_exprs_mention(expressions: darray[Ast::Expr]&, names: darray[sview @source]&, shadowed: darray[sview @source]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                for expression in expressions:
                    found: sview = lvre_expr_mention(expression, names, shadowed)
                    return found if found != ""
                return sview("", 0, 0)

        def lvre_stmt_mention(statement: Ast::Stmt, names: darray[sview @source]&, shadowed: darray[sview @source]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, expression_pos):
                        return lvre_expr_mention(expression, names, shadowed)
                    Stmt.Return(value, return_pos):
                        if value is returned:
                            return lvre_expr_mention(returned, names, shadowed)
                    Stmt.VarDecl(name, type_expression, value, decl_pos):
                        return lvre_expr_mention(value, names, shadowed)
                    Stmt.Assign(target, operator, value, assign_pos):
                        found: sview = lvre_expr_mention(value, names, shadowed)
                        return found if found != ""
                        return lvre_expr_mention(target, names, shadowed)
                    Stmt.If(condition, then_body, else_body, if_pos):
                        found: sview = lvre_expr_mention(condition, names, shadowed)
                        return found if found != ""
                        found_then: sview = lvre_stmts_mention(then_body, names, shadowed)
                        return found_then if found_then != ""
                        return lvre_stmts_mention(else_body, names, shadowed)
                    Stmt.While(condition, while_body, while_pos):
                        found: sview = lvre_expr_mention(condition, names, shadowed)
                        return found if found != ""
                        return lvre_stmts_mention(while_body, names, shadowed)
                    _:
                        pass
                return sview("", 0, 0)
