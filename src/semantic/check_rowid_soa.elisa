# `RowId[T]` addresses a row of an SoA (struct-of-arrays) store, so T must be a struct declared
# `layout(soa)`. Using a plain struct (`type PlainRow = RowId[Plain]` where `struct Plain:` has no
# soa layout) is rejected. The parser records soa structs under sentinel marker `__layout_soa`;
# fire when a `RowId[T]` type argument names a known struct that is NOT soa. Unknown types are
# left to the unknown-type check.
extend Semantic:
    private:
        def rowid_is_soa_struct(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__layout_soa" and annotation.owner == name

        # The T of a `RowId[T]` type expression ("" if the expression is not a RowId application).
        def rowid_type_argument(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, line):
                        ident_name_of(index) return if ident_name_of(object) == "RowId"
                        return sview("", 0, 0)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        ident_name_of(arguments_n[0]) return if ident_name_of(object_n) == "RowId" and arguments_n.count == 1
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def rowid_check_declarations(declarations: darray[Ast::Decl], file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Alias(alias_name, target, alias_line):
                            row_type: sview = rowid_type_argument(target)
                            if row_type != "" and is_known_struct(table, row_type) and not rowid_is_soa_struct(file.enum_annotations, row_type):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RowIdNonSoa, name: "", line: alias_line, expected: "", actual: row_type})
                        Decl.Module(module_name, module_body, module_line):
                            table <- rowid_check_declarations(module_body, file, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- rowid_check_declarations(scoped_body, file, table)
                        _:
                            pass

    public:
        def check_rowid_soa(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- rowid_check_declarations(file.top_decls, file, table)
