extend Semantic:
    private:
        def runtime_carrier_replacement(type_name: sview) -> sview:
            can Abort.Panic:
                "sview[...]" return if type_name == "StringView"
                "darray[T, shape]" return if type_name == "DynArray"
                "view[T]" return if type_name == "DynArrayView"
                "region scopes and inferred container regions" return if type_name == "Arena"
                return ""

        # A body that does nothing — every statement is a `pass` (Stmt.Expr of Expr.Invalid) or empty.
        # An `Arena` parameter is only a surfaced carrier when it is not put to work; a function that
        # actually uses `owner` (as a region owner in `Type[owner]`, `@owner`, `new[owner]`, …) has a
        # non-trivial body, so this gate cleanly excludes the legitimate region-owner idiom.
        def irc_body_trivial(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            match expression:
                                Expr.Invalid:
                                    pass
                                _:
                                    return false
                        _:
                            return false
                return true

        # A by-value `Arena` LOCAL is the deprecated `in <arena>:` surface itself, and stage0 warns
        # at the local's type token whatever the body does. MEASURED one spelling at a time:
        # `arena: Arena = zeroed` warns, `arena: mutable Arena = zeroed` warns, `lmut Arena` does
        # NOT, and an `Arena&` local/param is a caller-owned handle, not a carrier. So `mutable`
        # is the only wrapper looked through. Without this, a fixture pinning the arena-grow
        # use-after-free could not pass diagnostics_diff: stage0's warning had no stage1 twin.
        def irc_arena_local_type_ident(type_expression: Ast::Expr) -> (found: bool, pos: Ast::Pos):
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return irc_arena_local_type_ident(operand) if operator == TokenKind.Mutable else (false, Ast::pos_at_line(0))
                    Expr.Paren(inner, paren_line):
                        return irc_arena_local_type_ident(inner)
                    Expr.Ident(type_name, ident_pos):
                        return (type_name == "Arena", ident_pos)
                    _:
                        return (false, Ast::pos_at_line(0))

        def check_carrier_locals(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            arena_ident: (found: bool, pos: Ast::Pos) = irc_arena_local_type_ident(type_expression)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InternalRuntimeCarrier, name: sview("Arena", 0, 5), line: arena_ident.pos.line, pos: arena_ident.pos, expected: sview("region scopes and inferred container regions", 0, 44), actual: ""}) if arena_ident.found
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_carrier_locals(then_body, table)
                            table <- check_carrier_locals(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- check_carrier_locals(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- check_carrier_locals(for_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_carrier_locals(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_carrier_locals(arm.body, table)
                        _:
                            pass

        # An `Arena`-typed parameter in a user-facing function with a trivial (do-nothing) body is an
        # internal runtime carrier surfacing in user code (extern params are handled separately, above).
        def check_carrier_func_params(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- check_carrier_locals(body, table)
                            if irc_body_trivial(body):
                                for parameter in parameters |table| -> table:
                                    if bare_type_name(parameter.type_expression) == "Arena":
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InternalRuntimeCarrier, name: sview("Arena", 0, 5), line: line.line, expected: sview("region scopes and inferred container regions", 0, 44), actual: ""})
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_carrier_func_params(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_carrier_func_params(scoped_body, table)
                        _:
                            pass

        def check_internal_runtime_carrier_declarations(declarations: darray[Ast::Decl], params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, _, decorators, line):
                            while position < arity |position: u32 = 0, table|:
                                index: usize = (param_start + position).usize()
                                if index < params.count:
                                    type_name: sview = params[index].type_name
                                    replacement: sview = runtime_carrier_replacement(type_name)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InternalRuntimeCarrier, name: type_name, line: line.line, expected: replacement, actual: ""}) if replacement != ""
                                position <- position + 1
                        Decl.Module(name, body, line):
                            table <- check_internal_runtime_carrier_declarations(body, params, table)
                        Decl.Scoped(body, line):
                            table <- check_internal_runtime_carrier_declarations(body, params, table)
                        _:
                            pass

    public:
        def check_internal_runtime_carrier(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_internal_runtime_carrier_declarations(file.top_decls, file.extern_params, table)
                table <- check_carrier_func_params(file.top_decls, table)
