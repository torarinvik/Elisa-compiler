extend Semantic:
    private:
        def catch_module_is_ancestor(candidate: sview, module: sview) -> bool:
            can Abort.Panic:
                return true if candidate == module or candidate == ""
                return false if candidate.len + 2.usize() >= module.len
                for index in 0..<candidate.len |candidate, module|:
                    return false if candidate[index] != module[index]
                return module[candidate.len] == 58 and module[candidate.len + 1.usize()] == 58

        # Same-named callees can be declared in separate modules. The Catch parser
        # stores the caller's lexical module, while `__fn_module` rows carry the
        # callee declaration identity. Prefer the closest callee module visible from
        # that caller; if there is no lexical match, accept only a globally unique
        # declaration module and fail closed for unresolved duplicates.
        def catch_error_declaration_with_occurrence(annotations: darray[Ast::EnumAnnotation]&, callee: sview @source, catch_module: sview @source, explicit_module: sview @source, catch_line: u32, catch_offset: u32) -> (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32):
            can Memory.Allocate, Abort.Panic:
                empty_suffixes: darray[sview @source] = []
                alias_target: (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]) = catch_module_qualifier_alias_target(annotations, explicit_module, catch_module, catch_line, catch_offset) if explicit_module != "" else (false, false, "", "", empty_suffixes)
                return (false, callee, 0, 0, 0, 0) if alias_target.uncertain
                only_module: mutable sview @source = ""
                only_line: mutable u32 = 0
                only_offset: mutable u32 = 0
                only_identity_id: mutable u32 = 0
                only_occurrence_offset: mutable u32 = 0
                has_module: mutable bool = false
                modules_ambiguous: mutable bool = false
                fallback_count: mutable usize = 0.usize()
                scoped_module: mutable sview @source = ""
                scoped_length: mutable usize = 0.usize()
                scoped_line: mutable u32 = 0
                scoped_offset: mutable u32 = 0
                scoped_identity_id: mutable u32 = 0
                scoped_occurrence_offset: mutable u32 = 0
                scoped_declaration_count: mutable usize = 0.usize()
                qualified_module: mutable sview @source = ""
                qualified_line: mutable u32 = 0
                qualified_offset: mutable u32 = 0
                qualified_identity_id: mutable u32 = 0
                qualified_occurrence_offset: mutable u32 = 0
                qualified_declaration_count: mutable usize = 0.usize()
                for declaration in annotations |only_module, only_line, only_offset, only_identity_id, only_occurrence_offset, has_module, modules_ambiguous, fallback_count, scoped_module, scoped_length, scoped_line, scoped_offset, scoped_identity_id, scoped_occurrence_offset, scoped_declaration_count, qualified_module, qualified_line, qualified_offset, qualified_identity_id, qualified_occurrence_offset, qualified_declaration_count, callee, catch_module, explicit_module, alias_target|:
                    continue if declaration.owner != callee or declaration.name != "__error_return"
                    fallback_count <- fallback_count + 1.usize()
                    declaration_qualified: mutable bool = false
                    for module_annotation in annotations |declaration, only_module, only_line, only_offset, only_identity_id, only_occurrence_offset, has_module, modules_ambiguous, scoped_module, scoped_length, scoped_line, scoped_offset, scoped_identity_id, scoped_occurrence_offset, scoped_declaration_count, qualified_module, qualified_line, qualified_offset, qualified_identity_id, qualified_occurrence_offset, qualified_declaration_count, declaration_qualified, catch_module, explicit_module, alias_target|:
                        continue if module_annotation.owner != "__fn_module" or module_annotation.line != declaration.line
                        continue if module_annotation.offset != declaration.offset
                        continue if module_annotation.identity_id != declaration.identity_id
                        continue if module_annotation.occurrence_offset != declaration.occurrence_offset
                        candidate_module: sview @source = module_annotation.name
                        if explicit_module != "":
                            qualified_match: bool = catch_module_alias_path_matches_ancestor(alias_target.module, alias_target.scope, alias_target.suffixes, candidate_module) if alias_target.found else catch_module_qualifier_matches(explicit_module, candidate_module)
                            continue if not qualified_match
                            if not declaration_qualified:
                                qualified_module <- candidate_module
                                qualified_line <- declaration.line
                                qualified_offset <- declaration.offset
                                qualified_identity_id <- declaration.identity_id
                                qualified_occurrence_offset <- declaration.occurrence_offset
                                qualified_declaration_count <- qualified_declaration_count + 1.usize()
                                declaration_qualified <- true
                        if not has_module:
                            only_module <- candidate_module
                            only_line <- declaration.line
                            only_offset <- declaration.offset
                            only_identity_id <- declaration.identity_id
                            only_occurrence_offset <- declaration.occurrence_offset
                            has_module <- true
                        elif candidate_module != only_module:
                            modules_ambiguous <- true
                        if catch_module_is_ancestor(candidate_module, catch_module):
                            if scoped_declaration_count == 0.usize() or candidate_module.len > scoped_length:
                                scoped_module <- candidate_module
                                scoped_length <- candidate_module.len
                                scoped_line <- declaration.line
                                scoped_offset <- declaration.offset
                                scoped_identity_id <- declaration.identity_id
                                scoped_occurrence_offset <- declaration.occurrence_offset
                                scoped_declaration_count <- 1.usize()
                            elif candidate_module.len == scoped_length and candidate_module == scoped_module:
                                scoped_declaration_count <- scoped_declaration_count + 1.usize()
                            elif candidate_module.len == scoped_length:
                                scoped_declaration_count <- scoped_declaration_count + 1.usize()
                return (true, qualified_module, qualified_line, qualified_offset, qualified_identity_id, qualified_occurrence_offset) if explicit_module != "" and qualified_declaration_count == 1.usize()
                return (false, callee, 0, 0, 0, 0) if explicit_module != ""
                return (true, scoped_module, scoped_line, scoped_offset, scoped_identity_id, scoped_occurrence_offset) if scoped_declaration_count == 1.usize()
                return (true, only_module, only_line, only_offset, only_identity_id, only_occurrence_offset) if fallback_count == 1.usize() and has_module and not modules_ambiguous
                return (false, callee, 0, 0, 0, 0)

        # Existing consumers that only need declaration identity keep the compact tuple;
        # Catch exhaustiveness uses the extended resolver to filter return-clause rows.
        def catch_error_declaration(annotations: darray[Ast::EnumAnnotation]&, callee: sview @source, catch_module: sview @source, explicit_module: sview @source, catch_line: u32, catch_offset: u32) -> (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32):
            can Memory.Allocate, Abort.Panic:
                declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32) = catch_error_declaration_with_occurrence(annotations, callee, catch_module, explicit_module, catch_line, catch_offset)
                return (declaration.known, declaration.module, declaration.line, declaration.offset, declaration.identity_id)

        # The family spelling alone does not identify Local::Fault when Peer::Fault
        # exists too. Prefer the closest lexical module. If declaration provenance is
        # missing, use a family whose owner is unique across the file; otherwise fail
        # closed instead of merging unrelated variants into the catch's error set.
        def catch_error_family_module(family: sview @source, function_module_known: bool, function_module: sview @source, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, module: sview @source):
            can Abort.Panic:
                only_module: mutable sview @source = ""
                has_module: mutable bool = false
                modules_ambiguous: mutable bool = false
                scoped_module: mutable sview @source = ""
                scoped_length: mutable usize = 0.usize()
                scoped_found: mutable bool = false
                scoped_ambiguous: mutable bool = false
                scoped_unknown: mutable bool = false
                any_unknown: mutable bool = false
                for declaration in annotations |only_module, has_module, modules_ambiguous, scoped_module, scoped_length, scoped_found, scoped_ambiguous, scoped_unknown, any_unknown, family, function_module_known, function_module|:
                    continue if (declaration.owner != "__error_set_decl" and declaration.owner != "__catch_unknown_error_set_decl") or declaration.name != family
                    candidate_module: sview @source = declaration.module
                    candidate_unknown: bool = declaration.owner == "__catch_unknown_error_set_decl"
                    any_unknown <- true if candidate_unknown
                    if not has_module:
                        only_module <- candidate_module
                        has_module <- true
                    elif candidate_module != only_module:
                        modules_ambiguous <- true
                    if function_module_known and catch_module_is_ancestor(candidate_module, function_module):
                        if not scoped_found or candidate_module.len > scoped_length:
                            scoped_module <- candidate_module
                            scoped_length <- candidate_module.len
                            scoped_found <- true
                            scoped_ambiguous <- false
                            scoped_unknown <- candidate_unknown
                        elif candidate_module.len == scoped_length:
                            scoped_ambiguous <- true if candidate_module != scoped_module
                            scoped_unknown <- true if candidate_module == scoped_module and candidate_unknown
                return (false, family) if scoped_found and (scoped_ambiguous or scoped_unknown)
                return (true, scoped_module) if scoped_found
                return (false, family) if any_unknown
                return (true, only_module) if has_module and not modules_ambiguous
                return (false, family)

        # Stage0 stores module aliases in an analyzer-wide map. An ancestor's direct aliases
        # are registered before its descendants. Across scopes, branch aliases have no stable
        # winner unless the ordering is otherwise provable, so they fail closed. Within one
        # block, unconditional aliases register before branch aliases. Branch identity stacks
        # preserve nested static-block prepasses; equal stacks use source order, while divergent
        # stacks use source order only when both same-scope rows are known active.
        def catch_module_alias_annotation_is_unknown(alias: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                return true if alias.owner == "__catch_unknown_static_alias"
                return true if alias.owner == "__pma_unknown_static_import" and alias.detail_name == "__using_alias"
                return alias.owner == "__try_unresolved_static_binding" and alias.name == "__using_alias"

        def catch_module_alias_annotation_name(alias: Ast::EnumAnnotation) -> sview:
            can Abort.Panic:
                return alias.detail_name if alias.owner == "__try_unresolved_static_binding" and alias.name == "__using_alias"
                return alias.name if catch_module_alias_annotation_is_unknown(alias)
                return alias.owner

        def catch_module_alias_is_static_branch(annotations: darray[Ast::EnumAnnotation]&, alias: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                return true if catch_module_alias_annotation_is_unknown(alias)
                return any marker in annotations where marker.owner == "__static_if_branch" and marker.name == "__using_alias_static_branch" and marker.detail_name == alias.owner and marker.module == alias.module and marker.line == alias.line and marker.offset == alias.offset

        def catch_module_alias_order(candidate_scope: sview, candidate_offset: u32, candidate_is_branch: bool, selected_scope: sview, selected_offset: u32, selected_is_branch: bool) -> (known: bool, precedes: bool):
            can Abort.Panic:
                if candidate_scope == selected_scope:
                    return (true, false) if candidate_is_branch and not selected_is_branch
                    return (true, true) if not candidate_is_branch and selected_is_branch
                    return (true, candidate_offset < selected_offset)
                if catch_module_is_ancestor(candidate_scope, selected_scope):
                    return (true, true) if not candidate_is_branch
                    return (false, false)
                if catch_module_is_ancestor(selected_scope, candidate_scope):
                    return (true, false) if not selected_is_branch
                    return (false, false)
                return (false, false) if candidate_is_branch or selected_is_branch
                return (false, false) if candidate_offset == selected_offset
                return (true, candidate_offset < selected_offset)

        def catch_module_alias_branch_stack(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_scope: sview, alias_line: u32, alias_offset: u32, is_branch: bool) -> (known: bool, rows: darray[u32]):
            can Memory.Allocate, Abort.Panic:
                rows: mutable darray[u32] = []
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |rows, found_marker, unknown, alias_name, alias_scope, alias_line, alias_offset|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__using_alias_static_branch" or marker.detail_name != alias_name or marker.module != alias_scope or marker.line != alias_line or marker.offset != alias_offset
                    found_marker <- true
                    if marker.identity_id == 4294967295:
                        unknown <- true
                    else:
                        rows.push(marker.identity_id)
                return (false, rows) if unknown or (is_branch and not found_marker)
                return (true, rows)

        def catch_module_alias_branch_stack_prefix(prefix: darray[u32], path: darray[u32]) -> bool:
            can Abort.Panic:
                return false if prefix.count > path.count
                for index in 0..<prefix.count |prefix, path|:
                    return false if prefix[index] != path[index]
                return true

        def catch_module_alias_is_unresolved(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_scope: sview, alias_line: u32, alias_offset: u32) -> bool:
            can Abort.Panic:
                return any alias in annotations where catch_module_alias_annotation_is_unknown(alias) and catch_module_alias_annotation_name(alias) == alias_name and alias.module == alias_scope and alias.line == alias_line and alias.offset == alias_offset

        # Refine partial scope ordering with the parser's ordered enclosing-branch identities.
        # A strict prefix is an outer branch block whose direct aliases register before its
        # nested branch/module body, even when the outer token appears later in source.
        def catch_module_alias_order_with_branch_context(annotations: darray[Ast::EnumAnnotation]&, candidate: Ast::EnumAnnotation, selected_name: sview, selected_scope: sview, selected_line: u32, selected_offset: u32, selected_is_branch: bool) -> (known: bool, precedes: bool):
            can Memory.Allocate, Abort.Panic:
                candidate_name: sview = catch_module_alias_annotation_name(candidate)
                candidate_is_branch: bool = catch_module_alias_is_static_branch(annotations, candidate)
                if candidate.module == selected_scope and candidate.offset == selected_offset:
                    return (true, false) if candidate.line == selected_line and candidate_name == selected_name
                    return (false, false)
                base_order: (known: bool, precedes: bool) = catch_module_alias_order(candidate.module, candidate.offset, candidate_is_branch, selected_scope, selected_offset, selected_is_branch)
                return base_order if candidate.module == selected_scope and candidate_is_branch != selected_is_branch
                return base_order if not candidate_is_branch and not selected_is_branch
                return base_order if catch_module_is_ancestor(candidate.module, selected_scope) and not candidate_is_branch
                return base_order if catch_module_is_ancestor(selected_scope, candidate.module) and not selected_is_branch
                candidate_stack: (known: bool, rows: darray[u32]) = catch_module_alias_branch_stack(annotations, candidate_name, candidate.module, candidate.line, candidate.offset, candidate_is_branch)
                selected_stack: (known: bool, rows: darray[u32]) = catch_module_alias_branch_stack(annotations, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                return (false, false) if not candidate_stack.known or not selected_stack.known
                if candidate.module == selected_scope:
                    if candidate_is_branch and selected_is_branch:
                        if candidate_stack.rows.count < selected_stack.rows.count and catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows):
                            return (true, true)
                        if selected_stack.rows.count < candidate_stack.rows.count and catch_module_alias_branch_stack_prefix(selected_stack.rows, candidate_stack.rows):
                            return (true, false)
                        if candidate_stack.rows.count == selected_stack.rows.count and catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows):
                            return (false, false) if candidate.offset == selected_offset
                            return (true, candidate.offset < selected_offset)
                        # Inactive aliases were removed before this resolver runs. Two
                        # same-scope branch aliases with divergent stacks that remain here
                        # without an unknown barrier are both active, so they belong to
                        # separate chains and follow Core's source-order registration.
                        return (false, false) if catch_module_alias_is_unresolved(annotations, candidate_name, candidate.module, candidate.line, candidate.offset) or catch_module_alias_is_unresolved(annotations, selected_name, selected_scope, selected_line, selected_offset)
                        return (false, false) if candidate.offset == selected_offset
                        return (true, candidate.offset < selected_offset)
                    return (false, false)
                if catch_module_is_ancestor(candidate.module, selected_scope):
                    if candidate_is_branch and selected_is_branch:
                        return (true, true) if catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows)
                        return (false, false)
                    return (false, false) if candidate.offset == selected_offset
                    return (true, candidate.offset < selected_offset)
                if catch_module_is_ancestor(selected_scope, candidate.module):
                    if candidate_is_branch and selected_is_branch:
                        return (true, false) if catch_module_alias_branch_stack_prefix(selected_stack.rows, candidate_stack.rows)
                        return (false, false)
                    return (false, false) if candidate.offset == selected_offset
                    return (true, candidate.offset < selected_offset)
                if candidate_is_branch and selected_is_branch:
                    return (false, false) if candidate_stack.rows.count != selected_stack.rows.count or not catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows)
                    return (false, false) if candidate.offset == selected_offset
                    return (true, candidate.offset < selected_offset)
                return (false, false) if candidate.offset == selected_offset
                return (true, candidate.offset < selected_offset)

        # Alias-target chains can see only aliases registered before their declaration.
        # This uses Core's block registration order rather than a raw source-offset cutoff:
        # an enclosing block is pre-registered before its nested modules.
        def catch_module_alias_row_is_before(annotations: darray[Ast::EnumAnnotation]&, candidate: Ast::EnumAnnotation, declaration_scope: sview, declaration_line: u32, declaration_offset: u32) -> (known: bool, before: bool):
            can Memory.Allocate, Abort.Panic:
                return (true, true) if declaration_offset == 4294967295
                candidate_is_branch: bool = catch_module_alias_is_static_branch(annotations, candidate)
                for declaration in annotations |candidate_is_branch, annotations, candidate, declaration_scope, declaration_line, declaration_offset|:
                    continue if declaration.name != "__using_alias" or declaration.module != declaration_scope or declaration.line != declaration_line or declaration.offset != declaration_offset
                    declaration_is_branch: bool = catch_module_alias_is_static_branch(annotations, declaration)
                    if candidate.module == declaration.module and candidate.line == declaration.line and candidate.offset == declaration.offset:
                        return (true, false)
                    return (false, false) if candidate.offset == declaration.offset
                    return catch_module_alias_order_with_branch_context(annotations, candidate, declaration.owner, declaration.module, declaration.line, declaration.offset, declaration_is_branch)
                return (false, false)

        # Preserve an explicitly qualified family in `error[Provider::Fault]`. The leaf
        # row is still used for messages and subset matching; this parallel path row selects
        # the enum inventory when the caller module also declares a same-leaf Fault.
        def catch_module_alias_target(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview @source, lexical_module: sview @source, declaration_line: u32, declaration_offset: u32) -> (found: bool, uncertain: bool, module: sview @source, scope: sview @source, line: u32, offset: u32):
            can Memory.Allocate, Abort.Panic:
                selected_target: mutable sview @source = alias_name
                selected_name: mutable sview @source = ""
                selected_scope: mutable sview @source = ""
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                found: mutable bool = false
                ambiguous: mutable bool = false
                selected_unknown: mutable bool = false
                alias_order_unknown: mutable bool = false
                visibility_uncertain: mutable bool = false
                selected_is_branch: mutable bool = false
                for alias in annotations |selected_target, selected_name, selected_scope, selected_line, selected_offset, found, ambiguous, selected_unknown, alias_order_unknown, visibility_uncertain, selected_is_branch, alias_name, lexical_module, declaration_line, declaration_offset|:
                    if catch_module_alias_annotation_is_unknown(alias):
                        continue if not catch_module_path_matches(alias_name, catch_module_alias_annotation_name(alias))
                        alias_visibility: (known: bool, before: bool) = catch_module_alias_row_is_before(annotations, alias, lexical_module, declaration_line, declaration_offset)
                        if not alias_visibility.known:
                            visibility_uncertain <- true
                            continue
                        continue if not alias_visibility.before
                        candidate_order: (known: bool, precedes: bool) = catch_module_alias_order_with_branch_context(annotations, alias, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                        candidate_precedes: bool = candidate_order.known and candidate_order.precedes
                        if not found or candidate_precedes:
                            selected_target <- alias_name
                            selected_name <- catch_module_alias_annotation_name(alias)
                            selected_scope <- alias.module
                            selected_line <- alias.line
                            selected_offset <- alias.offset
                            found <- true
                            ambiguous <- false
                            selected_unknown <- true
                            selected_is_branch <- true
                        elif alias.module == selected_scope and alias.offset == selected_offset and selected_is_branch:
                            selected_unknown <- true
                        continue
                    continue if not catch_module_path_matches(alias_name, alias.owner) or alias.name != "__using_alias"
                    alias_visibility: (known: bool, before: bool) = catch_module_alias_row_is_before(annotations, alias, lexical_module, declaration_line, declaration_offset)
                    if not alias_visibility.known:
                        visibility_uncertain <- true
                        continue
                    continue if not alias_visibility.before
                    target: mutable sview @source = ""
                    target_count: mutable usize = 0.usize()
                    for target_row in annotations |target, target_count, alias|:
                        continue if target_row.name != "__using_alias_target" or target_row.module != alias.module or target_row.line != alias.line or target_row.offset != alias.offset
                        target <- target_row.owner
                        target_count <- target_count + 1.usize()
                    candidate_is_branch: bool = catch_module_alias_is_static_branch(annotations, alias)
                    candidate_order: (known: bool, precedes: bool) = catch_module_alias_order_with_branch_context(annotations, alias, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                    candidate_precedes: bool = candidate_order.known and candidate_order.precedes
                    if target_count != 1.usize():
                        if not found or candidate_precedes:
                            selected_target <- alias_name
                            selected_name <- alias.owner
                            selected_scope <- alias.module
                            selected_line <- alias.line
                            selected_offset <- alias.offset
                            found <- true
                            ambiguous <- false
                            selected_unknown <- true
                            selected_is_branch <- candidate_is_branch
                        continue
                    if not found or candidate_precedes:
                        selected_target <- target
                        selected_name <- alias.owner
                        selected_scope <- alias.module
                        selected_line <- alias.line
                        selected_offset <- alias.offset
                        found <- true
                        ambiguous <- false
                        selected_unknown <- false
                        selected_is_branch <- candidate_is_branch
                    elif alias.module == selected_scope and alias.offset == selected_offset and candidate_is_branch == selected_is_branch:
                        ambiguous <- true if not selected_unknown and selected_target != target
                if visibility_uncertain and not found:
                    alias_order_unknown <- true
                if found:
                    # Decide uncertainty against the final winner, not whichever candidate
                    # happened to be visited first. A later direct ancestor may dominate an
                    # earlier unordered branch candidate.
                    for alias in annotations |alias_order_unknown, alias_name, lexical_module, declaration_line, declaration_offset, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch|:
                        if catch_module_alias_annotation_is_unknown(alias):
                            continue if not catch_module_path_matches(alias_name, catch_module_alias_annotation_name(alias))
                        else:
                            continue if alias.name != "__using_alias" or not catch_module_path_matches(alias_name, alias.owner)
                        alias_visibility: (known: bool, before: bool) = catch_module_alias_row_is_before(annotations, alias, lexical_module, declaration_line, declaration_offset)
                        continue if alias_visibility.known and not alias_visibility.before
                        order: (known: bool, precedes: bool) = catch_module_alias_order_with_branch_context(annotations, alias, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                        alias_order_unknown <- true if not order.known or order.precedes
                return (false, true, alias_name, "", 0, 0) if ambiguous or selected_unknown or alias_order_unknown
                return (true, false, selected_target, selected_scope, selected_line, selected_offset) if found
                return (false, false, alias_name, "", 0, 0)

        # Catch parser metadata stores the module prefix, sometimes including the final
        # `::` depending on the source span boundary. Normalize either spelling.
        def catch_module_qualifier_core(raw_qualifier: sview @source) -> sview @source:
            can Abort.Panic:
                separator: usize = catch_family_separator_start(raw_qualifier, raw_qualifier.len)
                return raw_qualifier if separator == raw_qualifier.len
                second_colon: usize = catch_skip_path_trivia(raw_qualifier, separator + 1.usize())
                return raw_qualifier if second_colon >= raw_qualifier.len or raw_qualifier[second_colon] != 58
                trailing: usize = catch_skip_path_trivia(raw_qualifier, second_colon + 1.usize())
                return raw_qualifier if trailing < raw_qualifier.len
                return raw_qualifier[0:separator]

        def catch_module_qualifier_matches(raw_qualifier: sview @source, canonical_module: sview) -> bool:
            can Abort.Panic:
                return catch_module_path_matches(catch_module_qualifier_core(raw_qualifier), canonical_module)

        # Resolve a `using Target as Alias` from Stage0's global module-alias map. Expand
        # aliases in the head of each target path and carry every untouched suffix forward.
        # Each hop uses that alias declaration's own source position as the visibility cutoff.
        def catch_module_qualifier_alias_target(annotations: darray[Ast::EnumAnnotation]&, raw_qualifier: sview @source, lexical_module: sview @source, catch_line: u32, catch_offset: u32) -> (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]):
            can Memory.Allocate, Abort.Panic:
                suffixes: mutable darray[sview @source] = []
                qualifier_path: sview @source = catch_module_qualifier_core(raw_qualifier)
                separator: usize = catch_first_module_separator_start(qualifier_path)
                alias_name: sview @source = qualifier_path if separator == qualifier_path.len else qualifier_path[0:separator]
                if separator < qualifier_path.len:
                    second_colon: usize = catch_skip_path_trivia(qualifier_path, separator + 1.usize())
                    suffixes.push(qualifier_path[second_colon + 1.usize():qualifier_path.len])
                return (false, false, "", "", suffixes) if alias_name == ""
                # Stage0 flattens the complete file and registers nested-module aliases
                # before checking function bodies, so the first lookup sees all rows.
                # Later chain hops retain the selected declaration's own source cutoff.
                alias_target: mutable (found: bool, uncertain: bool, module: sview @source, scope: sview @source, line: u32, offset: u32) = catch_module_alias_target(annotations, alias_name, lexical_module, catch_line, 4294967295)
                return (false, true, "", "", suffixes) if alias_target.uncertain
                return (false, false, "", "", suffixes) if not alias_target.found
                candidate_path: mutable sview @source = alias_target.module
                candidate_scope: mutable sview @source = alias_target.scope
                candidate_line: mutable u32 = alias_target.line
                candidate_offset: mutable u32 = alias_target.offset
                alias_hops: mutable usize = 0.usize()
                while alias_hops < 16.usize() |candidate_path, candidate_scope, candidate_line, candidate_offset, alias_hops, alias_target, annotations, suffixes|:
                    target_separator: usize = catch_first_module_separator_start(candidate_path)
                    target_alias_name: sview @source = candidate_path if target_separator == candidate_path.len else candidate_path[0:target_separator]
                    target_suffix: sview @source = ""
                    if target_separator < candidate_path.len:
                        second_colon: usize = catch_skip_path_trivia(candidate_path, target_separator + 1.usize())
                        target_suffix <- candidate_path[second_colon + 1.usize():candidate_path.len]
                    alias_target <- catch_module_alias_target(annotations, target_alias_name, candidate_scope, candidate_line, candidate_offset)
                    return (false, true, "", "", suffixes) if alias_target.uncertain
                    break if not alias_target.found
                    if target_suffix != "":
                        expanded_suffixes: mutable darray[sview @source] = []
                        expanded_suffixes.push(target_suffix)
                        for suffix in suffixes |expanded_suffixes|:
                            expanded_suffixes.push(suffix)
                        suffixes <- expanded_suffixes
                    candidate_path <- alias_target.module
                    candidate_scope <- alias_target.scope
                    candidate_line <- alias_target.line
                    candidate_offset <- alias_target.offset
                    alias_hops <- alias_hops + 1.usize()
                return (false, true, "", "", suffixes) if alias_hops == 16.usize() and alias_target.found
                return (true, false, candidate_path, candidate_scope, suffixes)

        # Join the callee qualifier to its Catch marker using the source position and
        # caller module. An unqualified call returns an empty qualifier with its marker
        # offset, which still provides the alias visibility cutoff for shared lookup.
        def catch_callee_module_qualifier(annotations: darray[Ast::EnumAnnotation]&, callee: sview, catch_line: u32, catch_offset: u32, caller_module: sview) -> (found: bool, qualifier: sview @source, offset: u32):
            can Abort.Panic:
                selected: mutable sview @source = ""
                selected_offset: mutable u32 = 0
                marker_count: mutable usize = 0.usize()
                qualifier_count: mutable usize = 0.usize()
                ambiguous: mutable bool = false
                for marker in annotations |selected, selected_offset, marker_count, qualifier_count, ambiguous, callee, catch_line, catch_offset, caller_module|:
                    continue if marker.owner != callee or marker.name != "__catch_expr" or marker.line != catch_line or marker.module != caller_module
                    continue if catch_offset != 0 and marker.offset != catch_offset
                    marker_count <- marker_count + 1.usize()
                    selected_offset <- marker.offset if marker_count == 1.usize()
                    for qualifier in annotations |selected, selected_offset, marker_count, qualifier_count, ambiguous, marker|:
                        continue if qualifier.owner != "__catch_callee_module" or qualifier.line != marker.line or qualifier.offset != marker.offset or qualifier.module != marker.module
                        qualifier_count <- qualifier_count + 1.usize()
                        if qualifier_count == 1.usize():
                            selected <- qualifier.name
                        elif selected != qualifier.name:
                            ambiguous <- true
                return (false, "", 0) if ambiguous or marker_count == 0.usize() or (catch_offset == 0 and marker_count > 1.usize())
                return (true, selected, selected_offset)

        # Comments are omitted from the parser token stream but preserved in this
        # source-backed path row. Skip whitespace, `#` comments, and triple-quoted
        # block comments while comparing against the canonical module spelling.
        def catch_skip_path_trivia(raw_path: sview, start: usize) -> usize:
            can Abort.Panic:
                cursor: mutable usize = start
                while cursor < raw_path.len:
                    if raw_path[cursor] == 32 or raw_path[cursor] == 9 or raw_path[cursor] == 10 or raw_path[cursor] == 13:
                        cursor <- cursor + 1.usize()
                    elif raw_path[cursor] == 35:
                        while cursor < raw_path.len and raw_path[cursor] != 10 and raw_path[cursor] != 13 |cursor, raw_path|:
                            cursor <- cursor + 1.usize()
                    elif raw_path[cursor] == 34 and cursor + 2.usize() < raw_path.len and raw_path[cursor + 1.usize()] == 34 and raw_path[cursor + 2.usize()] == 34:
                        comment_cursor: mutable usize = cursor + 3.usize()
                        comment_closed: mutable bool = false
                        while comment_cursor + 2.usize() < raw_path.len |comment_cursor, comment_closed, raw_path|:
                            if raw_path[comment_cursor] == 34 and raw_path[comment_cursor + 1.usize()] == 34 and raw_path[comment_cursor + 2.usize()] == 34:
                                cursor <- comment_cursor + 3.usize()
                                comment_closed <- true
                                break
                            comment_cursor <- comment_cursor + 1.usize()
                        return raw_path.len if not comment_closed
                    else:
                        break
                return cursor

        # Compare a raw source path such as `Outer /* comment */ :: Provider` with
        # canonical `Outer::Provider`; comments and whitespace are token trivia.
        def catch_module_path_matches(raw_path: sview, canonical_path: sview) -> bool:
            can Abort.Panic:
                raw_index: mutable usize = 0.usize()
                canonical_index: mutable usize = 0.usize()
                while raw_index < raw_path.len or canonical_index < canonical_path.len |raw_index, canonical_index, raw_path, canonical_path|:
                    raw_index <- catch_skip_path_trivia(raw_path, raw_index)
                    return canonical_index == canonical_path.len if raw_index >= raw_path.len
                    return false if canonical_index >= canonical_path.len
                    if raw_path[raw_index] == 58:
                        return false if canonical_index + 1.usize() >= canonical_path.len or canonical_path[canonical_index] != 58 or canonical_path[canonical_index + 1.usize()] != 58
                        raw_index <- catch_skip_path_trivia(raw_path, raw_index + 1.usize())
                        return false if raw_index >= raw_path.len or raw_path[raw_index] != 58
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 2.usize()
                    else:
                        return false if raw_path[raw_index] != canonical_path[canonical_index]
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 1.usize()
                return true

        def catch_module_path_prefix_end(raw_path: sview, canonical_path: sview) -> (found: bool, offset: usize):
            can Abort.Panic:
                raw_index: mutable usize = 0.usize()
                canonical_index: mutable usize = 0.usize()
                while raw_index < raw_path.len |raw_index, canonical_index, raw_path, canonical_path|:
                    raw_index <- catch_skip_path_trivia(raw_path, raw_index)
                    return (true, canonical_index) if raw_index >= raw_path.len
                    return (false, canonical_index) if canonical_index >= canonical_path.len
                    if raw_path[raw_index] == 58:
                        return (false, canonical_index) if canonical_index + 1.usize() >= canonical_path.len or canonical_path[canonical_index] != 58 or canonical_path[canonical_index + 1.usize()] != 58
                        raw_index <- catch_skip_path_trivia(raw_path, raw_index + 1.usize())
                        return (false, canonical_index) if raw_index >= raw_path.len or raw_path[raw_index] != 58
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 2.usize()
                    else:
                        return (false, canonical_index) if raw_path[raw_index] != canonical_path[canonical_index]
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 1.usize()
                return (true, canonical_index)

        # An alias can name a module that has nested modules. Match the resolved alias
        # target followed by the untouched source suffix against the canonical path.
        def catch_module_alias_path_suffixes_match(alias_module: sview, candidate_module: sview, suffixes: darray[sview @source]) -> bool:
            can Abort.Panic:
                prefix: (found: bool, offset: usize) = catch_module_path_prefix_end(alias_module, candidate_module)
                return false if not prefix.found
                suffix_offset: mutable usize = prefix.offset
                for suffix in suffixes |candidate_module, suffix_offset|:
                    continue if suffix == ""
                    return false if candidate_module.len <= suffix_offset + 2.usize()
                    return false if candidate_module[suffix_offset] != 58 or candidate_module[suffix_offset + 1.usize()] != 58
                    suffix_match: (found: bool, offset: usize) = catch_module_path_prefix_end(suffix, candidate_module[suffix_offset + 2.usize():candidate_module.len])
                    return false if not suffix_match.found
                    suffix_offset <- suffix_offset + 2.usize() + suffix_match.offset
                return suffix_offset == candidate_module.len

        def catch_module_alias_path_matches(alias_module: sview, alias_scope: sview, suffixes: darray[sview @source], candidate_module: sview) -> bool:
            can Abort.Panic:
                if alias_scope != "":
                    scope_prefix: (found: bool, offset: usize) = catch_module_path_prefix_end(alias_scope, candidate_module)
                    return false if not scope_prefix.found or scope_prefix.offset + 2.usize() >= candidate_module.len
                    return false if candidate_module[scope_prefix.offset] != 58 or candidate_module[scope_prefix.offset + 1.usize()] != 58
                    relative_candidate: sview @source = candidate_module[scope_prefix.offset + 2.usize():candidate_module.len]
                    return catch_module_alias_path_suffixes_match(alias_module, relative_candidate, suffixes)
                return catch_module_alias_path_suffixes_match(alias_module, candidate_module, suffixes)

        # Relative `using Target as Alias` targets may name a sibling or root module.
        # Retry the resolved target from the alias scope through its lexical parents,
        # preserving suffixes, before deciding the qualified callable cannot match.
        def catch_module_alias_path_matches_ancestor(alias_module: sview, alias_scope: sview, suffixes: darray[sview @source], candidate_module: sview) -> bool:
            can Abort.Panic:
                scope: mutable sview @source = alias_scope
                while true |scope, alias_module, suffixes, candidate_module|:
                    return true if catch_module_alias_path_matches(alias_module, scope, suffixes, candidate_module)
                    break if scope == ""
                    scope <- catch_module_parent_path(scope)
                return false

        # Wildcard import targets are resolved relative to the scope containing the
        # `using` declaration. Keep this form separate from module-alias expansion: the
        # raw target is not rewritten through a `using ... as ...` alias.
        def catch_module_path_matches_relative(import_scope: sview, raw_module: sview, candidate_module: sview) -> bool:
            can Abort.Panic:
                suffixes: darray[sview @source] = []
                return true if catch_module_path_matches(raw_module, candidate_module)
                return catch_module_alias_path_matches(raw_module, import_scope, suffixes, candidate_module)

        def catch_family_separator_start(path: sview, family_start: usize) -> usize:
            can Abort.Panic:
                cursor: mutable usize = 0.usize()
                separator: mutable usize = path.len
                while cursor < family_start |cursor, separator, path, family_start|:
                    cursor <- catch_skip_path_trivia(path, cursor)
                    break if cursor >= family_start
                    if path[cursor] == 58:
                        next_colon: usize = catch_skip_path_trivia(path, cursor + 1.usize())
                        if next_colon < family_start and path[next_colon] == 58:
                            separator <- cursor
                            cursor <- next_colon + 1.usize()
                        else:
                            cursor <- cursor + 1.usize()
                    else:
                        cursor <- cursor + 1.usize()
                return separator

        def catch_first_module_separator_start(path: sview) -> usize:
            can Abort.Panic:
                cursor: mutable usize = 0.usize()
                while cursor < path.len |cursor, path|:
                    cursor <- catch_skip_path_trivia(path, cursor)
                    break if cursor >= path.len
                    if path[cursor] == 58:
                        next_colon: usize = catch_skip_path_trivia(path, cursor + 1.usize())
                        return cursor if next_colon < path.len and path[next_colon] == 58
                        cursor <- cursor + 1.usize()
                    else:
                        cursor <- cursor + 1.usize()
                return path.len

        def catch_module_parent_path(module_path: sview) -> sview:
            can Abort.Panic:
                separator: mutable usize = module_path.len
                offset: mutable usize = 0.usize()
                while offset + 1.usize() < module_path.len |separator, offset, module_path|:
                    separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                    offset <- offset + 1.usize()
                return "" if separator == module_path.len
                return module_path[0:separator]

        # Select family candidates for one qualified-name tier. Relative namespace and
        # alias tiers use the same prefix/suffix matcher; the final raw-spelling tier may
        # additionally compare the source path directly with a canonical module owner.
        def catch_error_family_module_candidate(annotations: darray[Ast::EnumAnnotation]&, family: sview, path_module: sview, path_scope: sview, suffixes: darray[sview @source]&, allow_direct: bool, table: SymbolTable&) -> (found: bool, ambiguous: bool, module: sview @source):
            can Abort.Panic:
                selected_module: mutable sview @source = ""
                found: mutable bool = false
                ambiguous: mutable bool = false
                for declaration in annotations |selected_module, found, ambiguous, annotations, family, path_module, path_scope, suffixes, allow_direct, table|:
                    continue if (declaration.owner != "__error_set_decl" and declaration.owner != "__catch_unknown_error_set_decl") or declaration.name != family
                    candidate_module: sview @source = declaration.module
                    relative_match: bool = catch_module_alias_path_matches(path_module, path_scope, suffixes, candidate_module)
                    direct_match: bool = allow_direct and catch_module_path_matches(path_module, candidate_module)
                    continue if not relative_match and not direct_match
                    if declaration.owner == "__catch_unknown_error_set_decl":
                        ambiguous <- true
                        continue
                    if not found:
                        selected_module <- candidate_module
                        found <- true
                    elif selected_module != candidate_module:
                        ambiguous <- true
                return (found, ambiguous, selected_module)

        # Empty paths and exact bare family names retain legacy leaf lookup. Any other
        # nonempty spelling must resolve to one qualified owner or stay unresolved; callers
        # must not retry malformed or qualified paths with the bare family leaf.
        def catch_explicit_error_family_module(path: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, function_module: sview @source, family: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, uncertain: bool, module: sview @source):
            can Abort.Panic:
                return (false, false, family) if path == ""
                path_end: mutable usize = path.len
                while path_end > 0 and (path[path_end - 1.usize()] == 32 or path[path_end - 1.usize()] == 9) |path_end, path|:
                    path_end <- path_end - 1.usize()
                qualified_separator: usize = catch_first_module_separator_start(path[0:path_end])
                qualified_path: bool = qualified_separator != path_end
                return (false, true, "") if path_end < family.len
                family_start: usize = path_end - family.len
                path_has_family: bool = catch_module_path_matches(path[family_start:path_end], family)
                return (false, true, "") if not path_has_family
                separator: usize = catch_family_separator_start(path, family_start)
                if separator == path.len:
                    return (false, false, family) if catch_module_path_matches(path[0:path_end], family)
                    return (false, true, "")
                return (false, true, "") if not qualified_path
                raw_module: sview @source = path[0:separator]
                empty_suffixes: darray[sview @source] = []
                lexical_scope: mutable sview @source = function_module
                while lexical_scope != "" |lexical_scope, family, raw_module, empty_suffixes, table|:
                    lexical_candidate: (found: bool, ambiguous: bool, module: sview @source) = catch_error_family_module_candidate(annotations, family, raw_module, lexical_scope, empty_suffixes, false, table)
                    return (false, true, "") if lexical_candidate.ambiguous
                    return (true, false, lexical_candidate.module) if lexical_candidate.found
                    lexical_scope <- catch_module_parent_path(lexical_scope)
                alias_target: (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]) = catch_module_qualifier_alias_target(annotations, raw_module, function_module, declaration_line, declaration_offset)
                return (false, true, "") if alias_target.uncertain
                if alias_target.found:
                    alias_scope: mutable sview @source = alias_target.scope
                    while true |alias_scope, family, alias_target, table|:
                        alias_candidate: (found: bool, ambiguous: bool, module: sview @source) = catch_error_family_module_candidate(annotations, family, alias_target.module, alias_scope, alias_target.suffixes, false, table)
                        return (false, true, "") if alias_candidate.ambiguous
                        return (true, false, alias_candidate.module) if alias_candidate.found
                        break if alias_scope == ""
                        alias_scope <- catch_module_parent_path(alias_scope)
                raw_candidate: (found: bool, ambiguous: bool, module: sview @source) = catch_error_family_module_candidate(annotations, family, raw_module, "", empty_suffixes, true, table)
                return (false, true, "") if raw_candidate.ambiguous
                return (true, false, raw_candidate.module) if raw_candidate.found
                return (false, true, "")

        def catch_error_family_module_for_declaration(annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, family: sview @source, family_path: sview @source, function_module_known: bool, function_module: sview @source, table: SymbolTable&) -> (known: bool, module: sview @source):
            can Abort.Panic:
                explicit_module: (found: bool, uncertain: bool, module: sview @source) = catch_explicit_error_family_module(family_path, declaration_line, declaration_offset, declaration_identity_id, function_module, family, annotations, table)
                return (false, family) if explicit_module.uncertain
                if explicit_module.found:
                    # `__error_set_decl` is the family inventory, including an empty set.
                    # Do not require a variant-owner row to confirm a declaration that can
                    # validly have no variants.
                    return (true, explicit_module.module)
                return catch_error_family_module(family, function_module_known, function_module, annotations)

        # Whether the CALLEE narrows `family` to a subset of its variants -- the
        # `error[FooError{Bad1}, ...]` form. Such a catch is exhaustive once it handles the
        # ALLOWED variants, so sweeping the family's full variant list demands arms for errors
        # the call can never raise: an exhaustive subset catch was flagged for a missing
        # `FooError.Bad2` that `error[FooError{Bad1}]` had already excluded, and stage0 is
        # silent on it. check_catch_out_of_set.elisa already does subset-aware exhaustiveness
        # off these same rows (CatchSubsetNonExhaustive), so this check yields the family to it
        # rather than duplicating the subset arithmetic and disagreeing with it. NOTE these
        # rows put the MARKER in `owner` and the payload in `name` -- the opposite of every
        # other row read in this file.
        def catch_family_is_subset(annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview, family_path: sview) -> bool:
            can Abort.Panic:
                for family_index in 0..<annotations.count:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line or family_annotation.name != family
                    continue if family_annotation.offset != declaration_offset
                    continue if family_annotation.identity_id != declaration_identity_id
                    continue if family_annotation.occurrence_offset != occurrence_offset
                    continue if family_index + 2.usize() >= annotations.count
                    family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != occurrence_offset
                    continue if family_path != "" and not catch_module_path_matches(family_path_annotation.name, family_path)
                    subset_annotation: Ast::EnumAnnotation = annotations[family_index + 2.usize()]
                    return true if subset_annotation.owner == "__error_variant_family" and subset_annotation.line == declaration_line and subset_annotation.name == family and subset_annotation.offset == family_annotation.offset and subset_annotation.identity_id == family_annotation.identity_id and subset_annotation.occurrence_offset == occurrence_offset
                # Old parser producers without family/path rows remain supported only when
                # both rows still carry concrete source identity. An absent legacy offset
                # cannot be treated as a wildcard because byte zero is a valid position.
                return any annotation in annotations where occurrence_offset == 0 and family_path == "" and declaration_offset != 0 and declaration_identity_id != 0 and annotation.owner == "__error_variant_family" and annotation.line == declaration_line and annotation.name == family and annotation.offset == declaration_offset and annotation.identity_id == declaration_identity_id

        # A restricted family occurrence contributes only its listed variants to the
        # caught union. The rows after the family/path pair stay adjacent until the next
        # family row, so repeated short names in excluded variants must not make a valid
        # fallback arm ambiguous.
        def catch_family_row_allows_variant(annotations: darray[Ast::EnumAnnotation]&, family_index: usize, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview, variant: sview) -> bool:
            can Abort.Panic:
                return false if family_index >= annotations.count
                family_annotation: Ast::EnumAnnotation = annotations[family_index]
                return false if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line or family_annotation.name != family
                return false if family_annotation.offset != declaration_offset
                return false if family_annotation.identity_id != declaration_identity_id
                return false if family_annotation.occurrence_offset != occurrence_offset
                return true if family_index + 2.usize() >= annotations.count
                family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                return true if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != occurrence_offset
                subset_annotation: Ast::EnumAnnotation = annotations[family_index + 2.usize()]
                return true if subset_annotation.owner != "__error_variant_family" or subset_annotation.line != declaration_line or subset_annotation.name != family or subset_annotation.offset != family_annotation.offset or subset_annotation.identity_id != family_annotation.identity_id or subset_annotation.occurrence_offset != occurrence_offset
                allow_index: mutable usize = family_index + 3.usize()
                while allow_index < annotations.count |allow_index, annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family_annotation, variant|:
                    allow_annotation: Ast::EnumAnnotation = annotations[allow_index]
                    # The next family occurrence is a hard boundary even when it belongs
                    # to a different declaration on the same source line.
                    if allow_annotation.owner == "__error_set_family" and allow_annotation.line == declaration_line:
                        break
                    return true if allow_annotation.owner == "__error_variant_allow" and allow_annotation.line == declaration_line and allow_annotation.name == variant and allow_annotation.offset == family_annotation.offset and allow_annotation.identity_id == family_annotation.identity_id and allow_annotation.occurrence_offset == occurrence_offset
                    allow_index <- allow_index + 1.usize()
                return false

        def catch_error_family(annotations: darray[Ast::EnumAnnotation]&, callee: sview, declaration_line: u32) -> sview:
            can Abort.Panic:
                # SKIP EVERY RESERVED MARKER, not the two that existed when this was
                # written. The parser records several rows against a function at its
                # declaration line; `__lsp_func_name` is pushed BEFORE `__error_return`,
                # so the old two-name denylist returned "__lsp_func_name" as the error
                # FAMILY for every `def`. No enum owns that name, so the variant sweep
                # below matched nothing and `non-exhaustive catch` could never fire on a
                # catch of an ordinary function -- stage0 reports it. A family is a type
                # name and can never begin with `__`, so the prefix is the right test.
                for annotation in annotations:
                    continue if annotation.owner != callee or annotation.line != declaration_line
                    return annotation.name if not catch_name_is_reserved_marker(annotation.name)
                return ""

        # A reserved parser marker (`__error_return`, `__lsp_func_name`, `__export_array`, …)
        # rather than a user-visible name.
        def catch_name_is_reserved_marker(name: sview) -> bool:
            can Abort.Panic:
                return false if name.len < 2
                return name[0] == 95 and name[1] == 95

        def catch_line_has(annotations: darray[Ast::EnumAnnotation]&, callee: sview, line: u32, offset: u32, module: sview, name: sview) -> bool:
            for annotation in annotations:
                return true if annotation.owner == callee and annotation.line == line and annotation.offset == offset and annotation.module == module and annotation.name == name
            return false

        def catch_variant_path_is_exact(path: sview, family: sview, variant: sview, family_module: sview) -> bool:
            can Abort.Panic:
                cursor: mutable usize = 0.usize()
                if family_module != "":
                    return false if path.len < family_module.len + 2.usize()
                    for index in 0..<family_module.len |path, family_module|:
                        return false if path[index] != family_module[index]
                    cursor <- family_module.len
                    return false if path[cursor] != 58 or path[cursor + 1.usize()] != 58
                    cursor <- cursor + 2.usize()
                return false if path.len - cursor != family.len + 1.usize() + variant.len
                for index in 0..<family.len |path, family, cursor|:
                    return false if path[cursor + index] != family[index]
                cursor <- cursor + family.len
                return false if path[cursor] != 46
                cursor <- cursor + 1.usize()
                for index in 0..<variant.len |path, variant, cursor|:
                    return false if path[cursor + index] != variant[index]
                return true

        # Stage0 normalizes `::` to `.` and MatchErrorTag falls back to the suffix after the
        # first dot. Compare that normalized short tag without allocating. This accepts one
        # arbitrary leading module component (`Wrong::Fault.Bad` for `Local::Fault.Bad`) but
        # rejects extra noncanonical components (`Wrong::Other::Fault.Bad`).
        def catch_variant_path_matches(path: sview, family: sview, variant: sview, family_module: sview) -> bool:
            can Abort.Panic:
                # Stage0's short name for a root `Fault.Bad` tag is just `Bad`.
                # Module-scoped tags retain the family component (`Fault.Bad`), so
                # a bare `Bad` arm must not match `Local::Fault.Bad`.
                return true if path == variant and family_module == ""
                short_start: mutable usize = 0.usize()
                for index in 0..<path.len |short_start, path|:
                    if path[index] == 58 and index + 1.usize() < path.len and path[index + 1.usize()] == 58:
                        short_start <- index + 2.usize()
                        break
                    if path[index] == 46:
                        short_start <- index + 1.usize()
                        break
                cursor: mutable usize = short_start
                if family_module == "":
                    return path[cursor:path.len] == variant
                module_separator: mutable usize = family_module.len
                for index in 0..<family_module.len |family_module, module_separator|:
                    if family_module[index] == 58 and index + 1.usize() < family_module.len and family_module[index + 1.usize()] == 58:
                        module_separator <- index
                        break
                if module_separator < family_module.len:
                    module_tail: sview = family_module[module_separator + 2.usize():family_module.len]
                    return false if path.len - cursor < module_tail.len + 2.usize()
                    for index in 0..<module_tail.len |path, module_tail, cursor|:
                        return false if path[cursor + index] != module_tail[index]
                    cursor <- cursor + module_tail.len
                    return false if path[cursor] != 58 or path[cursor + 1.usize()] != 58
                    cursor <- cursor + 2.usize()
                return false if path.len - cursor < family.len + 1.usize() + variant.len
                for index in 0..<family.len |path, family, cursor|:
                    return false if path[cursor + index] != family[index]
                cursor <- cursor + family.len
                return false if path[cursor] != 46
                cursor <- cursor + 1.usize()
                return path[cursor:path.len] == variant

        # `table.enum_variant_*` flattens every declaration, including inactive static-if
        # arms, and does not retain declaration identity. Rewalk the AST to classify the
        # matching ErrorSet declaration by its exact keyword/name metadata join. A missing
        # or unresolved join is uncertainty, not evidence that a branch is inactive.
        def catch_error_set_variant_branch_state(declarations: darray[Ast::Decl], lexical_module: sview @source, family: sview, family_module: sview, variant_filter: sview, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (found: bool, active: bool, uncertain: bool):
            can Abort.Panic:
                found: mutable bool = false
                active: mutable bool = false
                uncertain: mutable bool = false
                for declaration in declarations |found, active, uncertain, lexical_module, family, family_module, variant_filter, annotations, file, table|:
                    match declaration:
                        Decl.Module(module_name, body, _):
                            nested: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(body, module_name, family, family_module, variant_filter, annotations, file, table)
                            found <- true if nested.found
                            active <- true if nested.active
                            uncertain <- true if nested.uncertain
                        Decl.Scoped(body, _):
                            nested: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(body, lexical_module, family, family_module, variant_filter, annotations, file, table)
                            found <- true if nested.found
                            active <- true if nested.active
                            uncertain <- true if nested.uncertain
                        Decl.Enum(name, variants, _, _, declaration_pos):
                            continue if name != family or lexical_module != family_module
                            variant_found: mutable bool = variant_filter == ""
                            for enum_variant in variants |variant_found, variant_filter|:
                                variant_found <- true if enum_variant.name == variant_filter
                            continue if not variant_found
                            synthetic_marker_count: mutable usize = 0.usize()
                            for marker in annotations |synthetic_marker_count, name, lexical_module, declaration_pos|:
                                continue if marker.owner != "__error_set_synthetic" or marker.name != name or marker.module != lexical_module or marker.line != declaration_pos.line or marker.offset != declaration_pos.offset
                                synthetic_marker_count <- synthetic_marker_count + 1.usize()
                            name_row_count: mutable usize = 0.usize()
                            name_offset: mutable u32 = 0
                            for name_row in annotations |name_row_count, name_offset, name, declaration_pos|:
                                continue if name_row.owner != "__lsp_decl_name" or name_row.name != name or name_row.line != declaration_pos.line or name_row.offset != declaration_pos.offset
                                name_row_count <- name_row_count + 1.usize()
                                name_offset <- name_row.pos.offset
                            if name_row_count == 0.usize() and synthetic_marker_count == 1.usize():
                                # Generated ForeignEnum has an exact synthetic-provenance marker
                                # at the Decl position rather than a source name token.
                                name_offset <- declaration_pos.offset
                            elif name_row_count == 1.usize() and synthetic_marker_count == 0.usize():
                                continue if not any row in annotations where row.owner == "__error_set_decl" and row.name == name and row.module == lexical_module and row.line == declaration_pos.line and row.offset == name_offset
                            else:
                                found <- true
                                uncertain <- true
                                continue
                            continue if not any row in annotations where row.owner == "__error_set_decl" and row.name == name and row.module == lexical_module and row.line == declaration_pos.line and row.offset == name_offset
                            found <- true
                            if synthetic_marker_count != 0.usize() and (name_row_count != 0.usize() or synthetic_marker_count != 1.usize()):
                                uncertain <- true
                                continue
                            declaration_rows: mutable usize = 0.usize()
                            selected_declaration: mutable Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "", name: ""}
                            for row in annotations |declaration_rows, selected_declaration, name, lexical_module, declaration_pos, name_offset|:
                                continue if row.owner != "__error_set_decl" or row.name != name or row.module != lexical_module or row.line != declaration_pos.line or row.offset != name_offset
                                selected_declaration <- row
                                declaration_rows <- declaration_rows + 1.usize()
                            if declaration_rows != 1.usize():
                                uncertain <- true
                                continue
                            branch: (known: bool, active: bool) = catch_error_set_declaration_branch_selection(selected_declaration, annotations, file, table)
                            active <- true if branch.known and branch.active
                            uncertain <- true if not branch.known
                        _:
                            pass
                return (found, active, uncertain)

        # Branches can contribute duplicate flattened rows for the same canonical tag.
        # Count that tag once, even when an inactive declaration precedes an active one.
        def catch_error_variant_table_row_is_first(table: SymbolTable&, row: usize, family: sview, family_module: sview, variant: sview) -> bool:
            can Abort.Panic:
                return false if row >= table.enum_variant_owner.count or row >= table.enum_variant_name.count or row >= table.enum_variant_module.count
                for previous in 0..<row |table, row, family, family_module, variant|:
                    return false if table.enum_variant_owner[previous] == family and table.enum_variant_module[previous] == family_module and table.enum_variant_name[previous] == variant
                return true

        def catch_path_has_variant(path: sview, function_module: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview, variant: sview, family_module: sview, include_only_caught_variants: bool, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                target_state: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, family_module, variant, file.enum_annotations, file, table)
                return false if target_state.uncertain or (target_state.found and not target_state.active)
                return true if catch_variant_path_is_exact(path, family, variant, family_module)
                return false if not catch_variant_path_matches(path, family, variant, family_module)
                matching_union_tags: mutable usize = 0.usize()
                matched_target: mutable bool = false
                for family_index in 0..<annotations.count |matching_union_tags, matched_target, annotations, family_index, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module, table, path|:
                    family_annotation: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_annotation.owner != "__error_set_family" or family_annotation.line != declaration_line
                    continue if family_annotation.offset != declaration_offset
                    continue if family_annotation.identity_id != declaration_identity_id
                    continue if family_annotation.occurrence_offset != occurrence_offset
                    continue if family_index + 1.usize() >= annotations.count
                    family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != occurrence_offset
                    candidate_family: sview = family_annotation.name
                    candidate_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, declaration_offset, declaration_identity_id, candidate_family, family_path_annotation.name, true, function_module, table)
                    continue if not candidate_module.known
                for candidate_index in 0..<table.enum_variant_owner.count |matching_union_tags, matched_target, table, path, candidate_family, candidate_module, family, variant, family_module, include_only_caught_variants, annotations, family_index, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, file|:
                        candidate_variant: sview = table.enum_variant_name[candidate_index]
                        continue if table.enum_variant_owner[candidate_index] != candidate_family
                        continue if candidate_index >= table.enum_variant_module.count or table.enum_variant_module[candidate_index] != candidate_module.module
                        continue if not catch_error_variant_table_row_is_first(table, candidate_index, candidate_family, candidate_module.module, candidate_variant)
                        candidate_state: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", candidate_family, candidate_module.module, candidate_variant, file.enum_annotations, file, table)
                        continue if candidate_state.uncertain or (candidate_state.found and not candidate_state.active)
                        continue if include_only_caught_variants and not catch_family_row_allows_variant(annotations, family_index, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, candidate_family, candidate_variant)
                        if catch_variant_path_matches(path, candidate_family, candidate_variant, candidate_module.module):
                            matching_union_tags <- matching_union_tags + 1.usize()
                            matched_target <- true if candidate_family == family and candidate_variant == variant and candidate_module.module == family_module
                return matching_union_tags == 1.usize() and matched_target

        def catch_line_has_variant(annotations: darray[Ast::EnumAnnotation]&, callee: sview, catch_line: u32, catch_offset: u32, catch_module: sview @source, function_module: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview, variant: sview, family_module: sview, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    continue if annotation.owner != callee or annotation.line != catch_line or annotation.offset != catch_offset or annotation.module != catch_module
                    return true if catch_path_has_variant(annotation.name, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module, true, annotations, file, table)
                return false

        # Lexicographic `a < b` over sviews, byte by byte. stage0 runs the missing tags through
        # `sort.Strings` before joining them (analyzer_flow_match_core.go:610), so "the first
        # missing variant" means the alphabetically first one, NOT the declaration-order first.
        # Without this the two compilers name different variants the moment an enum declares its
        # members out of alphabetical order -- a divergence no probe with an already-sorted enum
        # can show. Go's sort compares raw bytes and so does this, so the orders agree for every
        # byte string rather than only for ASCII.
        def catch_name_before(a: sview, b: sview) -> bool:
            can Abort.Panic:
                limit: usize = a.len if a.len < b.len else b.len
                verdict: mutable i32 = 0
                for index in 0..<limit |verdict, a, b|:
                    verdict <- 1 if verdict == 0 and a[index] < b[index]
                    verdict <- 2 if verdict == 0 and a[index] > b[index]
                return true if verdict == 1
                return false if verdict == 2
                return a.len < b.len

        def catch_error_tag_before(left_module: sview, left_family: sview, left_variant: sview, right_module: sview, right_family: sview, right_variant: sview) -> bool:
            can Abort.Panic:
                return catch_name_before(left_module, right_module) if left_module != right_module
                return catch_name_before(left_family, right_family) if left_family != right_family
                return catch_name_before(left_variant, right_variant)

        # The caught error set may contain several families. Return the first missing tag
        # from one family; the caller selects the first across the full union.
        def catch_family_first_missing(annotations: darray[Ast::EnumAnnotation]&, callee: sview @source, catch_line: u32, catch_offset: u32, catch_module: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32, family: sview @source, family_path: sview @source, function_module: sview @source, file: Ast::File&, table: SymbolTable&) -> (known: bool, module: sview @source, variant: sview @source):
            can Abort.Panic:
                return (false, family, "") if family == "" or catch_family_is_subset(annotations, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, family_path)
                family_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, declaration_line, declaration_offset, declaration_identity_id, family, family_path, true, function_module, table)
                return (false, family, "") if not family_module.known
                family_branch: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, family_module.module, "", file.enum_annotations, file, table)
                return (false, family, "") if not family_branch.found or family_branch.uncertain or not family_branch.active
                missing_first: mutable sview @source = ""
                while variant_index < table.enum_variant_owner.count |variant_index: usize = 0, table, missing_first, annotations, callee, catch_line, catch_offset, catch_module, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, family_module, family_branch, file|:
                    variant: sview = table.enum_variant_name[variant_index]
                    belongs_to_family: bool = table.enum_variant_owner[variant_index] == family and variant_index < table.enum_variant_module.count and table.enum_variant_module[variant_index] == family_module.module
                    variant_branch: (found: bool, active: bool, uncertain: bool) = catch_error_set_variant_branch_state(file.top_decls, "", family, family_module.module, variant, file.enum_annotations, file, table) if belongs_to_family else (false, false, false)
                    unique_tag: bool = catch_error_variant_table_row_is_first(table, variant_index, family, family_module.module, variant) if belongs_to_family else false
                    variant_active: bool = variant_branch.found and variant_branch.active and not variant_branch.uncertain
                    missing_first <- variant if belongs_to_family and unique_tag and variant_active and not catch_line_has_variant(annotations, callee, catch_line, catch_offset, catch_module, function_module, declaration_line, declaration_offset, declaration_identity_id, occurrence_offset, family, variant, family_module.module, file, table) and (missing_first == "" or catch_name_before(variant, missing_first))
                    variant_index <- variant_index + 1
                return (true, family_module.module, missing_first)

        def check_catch_exhaustive_rows(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for tail_annotation in annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmTail, name: "", line: tail_annotation.line, expected: "", actual: ""}) if tail_annotation.name == "__catch_arm_tail"
                for annotation in annotations |table|:
                    if annotation.name == "__catch_expr" and not catch_line_has(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module, "__catch_all"):
                        callee_module: (found: bool, qualifier: sview @source, offset: u32) = catch_callee_module_qualifier(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module)
                        continue if not callee_module.found
                        function_declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32) = catch_error_declaration_with_occurrence(annotations, annotation.owner, annotation.module, callee_module.qualifier, annotation.line, callee_module.offset)
                        continue if not function_declaration.known
                        missing_variant: mutable sview = ""
                        missing_family: mutable sview = ""
                        missing_module: mutable sview = ""
                        family_row_count: mutable usize = 0.usize()
                        for family_index in 0..<annotations.count |table, missing_variant, missing_family, missing_module, family_row_count, annotation, function_declaration, file, family_index|:
                            family_annotation: Ast::EnumAnnotation = annotations[family_index]
                            continue if family_annotation.owner != "__error_set_family" or family_annotation.line != function_declaration.line
                            continue if family_annotation.offset != function_declaration.offset
                            continue if family_annotation.identity_id != function_declaration.identity_id
                            continue if family_annotation.occurrence_offset != function_declaration.occurrence_offset
                            continue if family_index + 1.usize() >= annotations.count
                            family_path_annotation: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                            continue if family_path_annotation.owner != "__error_set_family_path" or family_path_annotation.line != family_annotation.line or family_path_annotation.offset != family_annotation.offset or family_path_annotation.identity_id != family_annotation.identity_id or family_path_annotation.occurrence_offset != function_declaration.occurrence_offset
                            family_row_count <- family_row_count + 1.usize()
                            family: sview = family_annotation.name
                            first: (known: bool, module: sview @source, variant: sview @source) = catch_family_first_missing(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module, function_declaration.line, function_declaration.offset, function_declaration.identity_id, function_declaration.occurrence_offset, family, family_path_annotation.name, function_declaration.module, file, table)
                            if first.known and first.variant != "" and (missing_variant == "" or catch_error_tag_before(first.module, family, first.variant, missing_module, missing_family, missing_variant)):
                                missing_variant <- first.variant
                                missing_family <- family
                                missing_module <- first.module
                        # Older declaration producers may only have the family on their
                        # `__error_return` annotation. Keep a conservative single-family fallback.
                        if family_row_count == 0.usize():
                            family: sview = catch_error_family(annotations, annotation.owner, function_declaration.line)
                            first: (known: bool, module: sview @source, variant: sview @source) = catch_family_first_missing(annotations, annotation.owner, annotation.line, annotation.offset, annotation.module, function_declaration.line, function_declaration.offset, function_declaration.identity_id, function_declaration.occurrence_offset, family, "", function_declaration.module, file, table)
                            missing_variant <- first.variant if first.known
                            missing_family <- family if first.known
                        # Stage0 combines every missing tag into one error. Diagnostic stores
                        # source-backed pieces only, so report the first missing tag in sorted order
                        # while still checking every family in the caught union.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveCatch, name: missing_variant, line: annotation.line, expected: missing_family, actual: ""}) if missing_variant != ""

        # Catch's parser markers retain branch identity at the catch token. Remove a
        # marker only when one enclosing branch is proven inactive; unresolved branches
        # remain visible to the conservative annotation pass.
        def catch_annotation_branch_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, selected: bool):
            can Abort.Panic:
                marker_name: sview = ""
                marker_detail: sview = ""
                if annotation.name == "__catch_expr":
                    marker_name <- "__catch_expr_static_branch"
                    marker_detail <- annotation.owner
                elif annotation.name == "__catch_arm_tail":
                    marker_name <- "__catch_arm_tail_static_branch"
                    marker_detail <- "__catch_arm_tail"
                else:
                    return (true, true)
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, annotation, file, table, marker_name, marker_detail|:
                    continue if marker.owner != "__static_if_branch" or marker.name != marker_name or marker.detail_name != marker_detail
                    continue if marker.module != annotation.module or marker.line != annotation.line or marker.offset != annotation.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- ewr_static_if_row_selection(file, marker.identity_id.usize(), annotation.module, table) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (false, false) if found_marker and unknown
                return (true, true)

        # Empty ErrorSets still need their declaration to resolve a qualified family
        # path. Like enum metadata consumers, ignore a declaration only when an exact
        # metadata marker proves one enclosing static-if branch inactive. Unknown marker
        # rows remain candidates, but are projected as an uncertainty barrier below.
        # The file-shared ForeignEnum family instead reduces the branch states of every
        # closed extern-enum origin; one active producer is enough to keep the family.
        def catch_synthetic_error_set_origin_branch_selection(origin: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                # `offset` on both the declaration-name row and branch marker is the
                # `enum` keyword; the identifier token is kept separately in `pos.offset`.
                origin_name_rows: mutable usize = 0.usize()
                for name_row in annotations |origin_name_rows, origin|:
                    continue if name_row.owner != "__lsp_decl_name" or name_row.name != origin.detail_name or name_row.line != origin.line or name_row.offset != origin.offset
                    origin_name_rows <- origin_name_rows + 1.usize()
                return (false, false) if origin_name_rows != 1.usize()
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, origin, file, table|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__nominal_type_static_branch" or marker.detail_name != origin.detail_name or marker.module != origin.module or marker.line != origin.line or marker.offset != origin.offset
                    found_marker <- true
                    if marker.identity_id == 4294967295:
                        unknown <- true
                        continue
                    branch: (known: bool, selected: bool) = ewr_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if not branch.known
                return (false, false) if found_marker and unknown
                return (true, true)

        def catch_error_set_declaration_branch_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                synthetic_marker_count: mutable usize = 0.usize()
                for marker in annotations |synthetic_marker_count, annotation|:
                    continue if marker.owner != "__error_set_synthetic" or marker.name != annotation.name or marker.module != annotation.module or marker.line != annotation.line or marker.offset != annotation.offset
                    synthetic_marker_count <- synthetic_marker_count + 1.usize()
                if synthetic_marker_count > 0.usize():
                    return (false, false) if annotation.owner != "__error_set_decl" or annotation.name != "ForeignEnum" or synthetic_marker_count != 1.usize()
                    origin_count: mutable usize = 0.usize()
                    unknown_origin: mutable bool = false
                    active_origin: mutable bool = false
                    for origin in annotations |origin_count, unknown_origin, active_origin, annotations, file, table, annotation|:
                        continue if origin.owner != "__error_set_synthetic_origin" or origin.name != annotation.name
                        origin_count <- origin_count + 1.usize()
                        origin_branch: (known: bool, active: bool) = catch_synthetic_error_set_origin_branch_selection(origin, annotations, file, table)
                        active_origin <- true if origin_branch.known and origin_branch.active
                        unknown_origin <- true if not origin_branch.known
                    return (true, true) if active_origin
                    return (false, false) if origin_count == 0.usize() or unknown_origin
                    return (true, false)
                found_marker: mutable bool = false
                unknown: mutable bool = false
                declaration_keyword_offset: mutable u32 = 0
                declaration_name_rows: mutable usize = 0
                for name_row in annotations |declaration_keyword_offset, declaration_name_rows, annotation|:
                    continue if name_row.owner != "__lsp_decl_name" or name_row.name != annotation.name or name_row.line != annotation.line or name_row.pos.offset != annotation.offset
                    declaration_keyword_offset <- name_row.offset
                    declaration_name_rows <- declaration_name_rows + 1.usize()
                return (false, false) if declaration_name_rows != 1.usize()
                for marker in annotations |found_marker, unknown, annotation, file, table, declaration_keyword_offset|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__nominal_type_static_branch" or marker.detail_name != annotation.name or marker.module != annotation.module or marker.line != annotation.line or marker.offset != declaration_keyword_offset
                    found_marker <- true
                    if marker.identity_id == 4294967295:
                        unknown <- true
                        continue
                    branch: (known: bool, selected: bool) = ewr_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if not branch.known
                return (false, false) if found_marker and unknown
                return (true, true)

        # Remove aliases whose static-if arm is definitely inactive. Retain an explicit
        # barrier for unresolved arms so they cannot supply a speculative module path.
        def catch_active_alias_annotations(file: Ast::File&, table: SymbolTable&) -> darray[Ast::EnumAnnotation]:
            can Memory.Allocate, Abort.Panic:
                active: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |active, file, table|:
                    if annotation.name == "__catch_expr" or annotation.name == "__catch_arm_tail":
                        branch: (known: bool, selected: bool) = catch_annotation_branch_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.selected
                    if annotation.owner == "__error_set_decl":
                        branch: (known: bool, active: bool) = catch_error_set_declaration_branch_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.active
                        if not branch.known:
                            active.push(Ast::EnumAnnotation{owner: "__catch_unknown_error_set_decl", name: annotation.name, module: annotation.module, line: annotation.line, offset: annotation.offset, identity_id: annotation.identity_id})
                            continue
                    if annotation.name == "__using_alias":
                        branch: (known: bool, active: bool) = ewr_static_import_annotation_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.active
                        if not branch.known:
                            active.push(Ast::EnumAnnotation{owner: "__catch_unknown_static_alias", name: annotation.owner, module: annotation.module, line: annotation.line, offset: annotation.offset})
                    active.push(annotation)
                return active

    public:
        def check_catch_exhaustive(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                annotations: mutable darray[Ast::EnumAnnotation] = catch_active_alias_annotations(file, table)
                table <- check_catch_exhaustive_rows(annotations, file, table)
