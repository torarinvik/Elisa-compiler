extend Semantic:
    private:
        def catch_module_is_ancestor(candidate: sview, module: sview) -> bool:
            can Abort.Panic:
                return true if candidate == module or candidate == ""
                return false if candidate.len + 2.usize() >= module.len
                for index in 0..<candidate.len |candidate, module|:
                    return false if candidate[index] != module[index]
                return module[candidate.len] == 58 and module[candidate.len + 1.usize()] == 58

        # Same-named callees can be declared in separate modules. The Catch parser
        # stores the caller's lexical module, while `__fn_module` rows carry the
        # callee declaration identity. Prefer the closest callee module visible from
        # that caller; if there is no lexical match, accept only a globally unique
        # declaration module and fail closed for unresolved duplicates.
        def catch_error_declaration_with_occurrence(annotations: darray[Ast::EnumAnnotation]&, callee: sview @source, catch_module: sview @source, explicit_module: sview @source, catch_line: u32, catch_offset: u32) -> (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32):
            can Memory.Allocate, Abort.Panic:
                empty_suffixes: darray[sview @source] = []
                alias_target: (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]) = catch_module_qualifier_alias_target(annotations, explicit_module, catch_module, catch_line, catch_offset) if explicit_module != "" else (false, false, "", "", empty_suffixes)
                return (false, callee, 0, 0, 0, 0) if alias_target.uncertain
                only_module: mutable sview @source = ""
                only_line: mutable u32 = 0
                only_offset: mutable u32 = 0
                only_identity_id: mutable u32 = 0
                only_occurrence_offset: mutable u32 = 0
                has_module: mutable bool = false
                modules_ambiguous: mutable bool = false
                fallback_count: mutable usize = 0.usize()
                scoped_module: mutable sview @source = ""
                scoped_length: mutable usize = 0.usize()
                scoped_line: mutable u32 = 0
                scoped_offset: mutable u32 = 0
                scoped_identity_id: mutable u32 = 0
                scoped_occurrence_offset: mutable u32 = 0
                scoped_declaration_count: mutable usize = 0.usize()
                qualified_module: mutable sview @source = ""
                qualified_line: mutable u32 = 0
                qualified_offset: mutable u32 = 0
                qualified_identity_id: mutable u32 = 0
                qualified_occurrence_offset: mutable u32 = 0
                qualified_declaration_count: mutable usize = 0.usize()
                for declaration in annotations |only_module, only_line, only_offset, only_identity_id, only_occurrence_offset, has_module, modules_ambiguous, fallback_count, scoped_module, scoped_length, scoped_line, scoped_offset, scoped_identity_id, scoped_occurrence_offset, scoped_declaration_count, qualified_module, qualified_line, qualified_offset, qualified_identity_id, qualified_occurrence_offset, qualified_declaration_count, callee, catch_module, explicit_module, alias_target|:
                    continue if declaration.owner != callee or declaration.name != "__error_return"
                    fallback_count <- fallback_count + 1.usize()
                    declaration_qualified: mutable bool = false
                    for module_annotation in annotations |declaration, only_module, only_line, only_offset, only_identity_id, only_occurrence_offset, has_module, modules_ambiguous, scoped_module, scoped_length, scoped_line, scoped_offset, scoped_identity_id, scoped_occurrence_offset, scoped_declaration_count, qualified_module, qualified_line, qualified_offset, qualified_identity_id, qualified_occurrence_offset, qualified_declaration_count, declaration_qualified, catch_module, explicit_module, alias_target|:
                        continue if module_annotation.owner != "__fn_module" or module_annotation.line != declaration.line
                        continue if module_annotation.offset != declaration.offset
                        continue if module_annotation.identity_id != declaration.identity_id
                        continue if module_annotation.occurrence_offset != declaration.occurrence_offset
                        candidate_module: sview @source = module_annotation.name
                        if explicit_module != "":
                            qualified_match: bool = catch_module_alias_path_matches_ancestor(alias_target.module, alias_target.scope, alias_target.suffixes, candidate_module) if alias_target.found else catch_module_qualifier_matches(explicit_module, candidate_module)
                            continue if not qualified_match
                            if not declaration_qualified:
                                qualified_module <- candidate_module
                                qualified_line <- declaration.line
                                qualified_offset <- declaration.offset
                                qualified_identity_id <- declaration.identity_id
                                qualified_occurrence_offset <- declaration.occurrence_offset
                                qualified_declaration_count <- qualified_declaration_count + 1.usize()
                                declaration_qualified <- true
                        if not has_module:
                            only_module <- candidate_module
                            only_line <- declaration.line
                            only_offset <- declaration.offset
                            only_identity_id <- declaration.identity_id
                            only_occurrence_offset <- declaration.occurrence_offset
                            has_module <- true
                        elif candidate_module != only_module:
                            modules_ambiguous <- true
                        if catch_module_is_ancestor(candidate_module, catch_module):
                            if scoped_declaration_count == 0.usize() or candidate_module.len > scoped_length:
                                scoped_module <- candidate_module
                                scoped_length <- candidate_module.len
                                scoped_line <- declaration.line
                                scoped_offset <- declaration.offset
                                scoped_identity_id <- declaration.identity_id
                                scoped_occurrence_offset <- declaration.occurrence_offset
                                scoped_declaration_count <- 1.usize()
                            elif candidate_module.len == scoped_length and candidate_module == scoped_module:
                                scoped_declaration_count <- scoped_declaration_count + 1.usize()
                            elif candidate_module.len == scoped_length:
                                scoped_declaration_count <- scoped_declaration_count + 1.usize()
                return (true, qualified_module, qualified_line, qualified_offset, qualified_identity_id, qualified_occurrence_offset) if explicit_module != "" and qualified_declaration_count == 1.usize()
                return (false, callee, 0, 0, 0, 0) if explicit_module != ""
                return (true, scoped_module, scoped_line, scoped_offset, scoped_identity_id, scoped_occurrence_offset) if scoped_declaration_count == 1.usize()
                return (true, only_module, only_line, only_offset, only_identity_id, only_occurrence_offset) if fallback_count == 1.usize() and has_module and not modules_ambiguous
                return (false, callee, 0, 0, 0, 0)

        # Existing consumers that only need declaration identity keep the compact tuple;
        # Catch exhaustiveness uses the extended resolver to filter return-clause rows.
        def catch_error_declaration(annotations: darray[Ast::EnumAnnotation]&, callee: sview @source, catch_module: sview @source, explicit_module: sview @source, catch_line: u32, catch_offset: u32) -> (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32):
            can Memory.Allocate, Abort.Panic:
                declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, occurrence_offset: u32) = catch_error_declaration_with_occurrence(annotations, callee, catch_module, explicit_module, catch_line, catch_offset)
                return (declaration.known, declaration.module, declaration.line, declaration.offset, declaration.identity_id)

        # The family spelling alone does not identify Local::Fault when Peer::Fault
        # exists too. Prefer the closest lexical module. If declaration provenance is
        # missing, use a family whose owner is unique across the file; otherwise fail
        # closed instead of merging unrelated variants into the catch's error set.
        def catch_error_family_module(family: sview @source, function_module_known: bool, function_module: sview @source, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, module: sview @source):
            can Abort.Panic:
                only_module: mutable sview @source = ""
                has_module: mutable bool = false
                modules_ambiguous: mutable bool = false
                scoped_module: mutable sview @source = ""
                scoped_length: mutable usize = 0.usize()
                scoped_found: mutable bool = false
                scoped_ambiguous: mutable bool = false
                scoped_unknown: mutable bool = false
                any_unknown: mutable bool = false
                for declaration in annotations |only_module, has_module, modules_ambiguous, scoped_module, scoped_length, scoped_found, scoped_ambiguous, scoped_unknown, any_unknown, family, function_module_known, function_module|:
                    continue if (declaration.owner != "__error_set_decl" and declaration.owner != "__catch_unknown_error_set_decl") or declaration.name != family
                    candidate_module: sview @source = declaration.module
                    candidate_unknown: bool = declaration.owner == "__catch_unknown_error_set_decl"
                    any_unknown <- true if candidate_unknown
                    if not has_module:
                        only_module <- candidate_module
                        has_module <- true
                    elif candidate_module != only_module:
                        modules_ambiguous <- true
                    if function_module_known and catch_module_is_ancestor(candidate_module, function_module):
                        if not scoped_found or candidate_module.len > scoped_length:
                            scoped_module <- candidate_module
                            scoped_length <- candidate_module.len
                            scoped_found <- true
                            scoped_ambiguous <- false
                            scoped_unknown <- candidate_unknown
                        elif candidate_module.len == scoped_length:
                            scoped_ambiguous <- true if candidate_module != scoped_module
                            scoped_unknown <- true if candidate_module == scoped_module and candidate_unknown
                return (false, family) if scoped_found and (scoped_ambiguous or scoped_unknown)
                return (true, scoped_module) if scoped_found
                return (false, family) if any_unknown
                return (true, only_module) if has_module and not modules_ambiguous
                return (false, family)

        # Stage0 stores module aliases in an analyzer-wide map. An ancestor's direct aliases
        # are registered before its descendants. Across scopes, branch aliases have no stable
        # winner unless the ordering is otherwise provable, so they fail closed. Within one
        # block, unconditional aliases register before branch aliases. Branch identity stacks
        # preserve nested static-block prepasses; equal stacks use source order, while divergent
        # stacks use source order only when both same-scope rows are known active.
        def catch_module_alias_annotation_is_unknown(alias: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                return true if alias.owner == "__catch_unknown_static_alias"
                return true if alias.owner == "__pma_unknown_static_import" and alias.detail_name == "__using_alias"
                return alias.owner == "__try_unresolved_static_binding" and alias.name == "__using_alias"

        def catch_module_alias_annotation_name(alias: Ast::EnumAnnotation) -> sview:
            can Abort.Panic:
                return alias.detail_name if alias.owner == "__try_unresolved_static_binding" and alias.name == "__using_alias"
                return alias.name if catch_module_alias_annotation_is_unknown(alias)
                return alias.owner

        def catch_module_alias_is_static_branch(annotations: darray[Ast::EnumAnnotation]&, alias: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                return true if catch_module_alias_annotation_is_unknown(alias)
                return any marker in annotations where marker.owner == "__static_if_branch" and marker.name == "__using_alias_static_branch" and marker.detail_name == alias.owner and marker.module == alias.module and marker.line == alias.line and marker.offset == alias.offset

        def catch_module_alias_order(candidate_scope: sview, candidate_offset: u32, candidate_is_branch: bool, selected_scope: sview, selected_offset: u32, selected_is_branch: bool) -> (known: bool, precedes: bool):
            can Abort.Panic:
                if candidate_scope == selected_scope:
                    return (true, false) if candidate_is_branch and not selected_is_branch
                    return (true, true) if not candidate_is_branch and selected_is_branch
                    return (true, candidate_offset < selected_offset)
                if catch_module_is_ancestor(candidate_scope, selected_scope):
                    return (true, true) if not candidate_is_branch
                    return (false, false)
                if catch_module_is_ancestor(selected_scope, candidate_scope):
                    return (true, false) if not selected_is_branch
                    return (false, false)
                return (false, false) if candidate_is_branch or selected_is_branch
                return (false, false) if candidate_offset == selected_offset
                return (true, candidate_offset < selected_offset)

        def catch_module_alias_branch_stack(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_scope: sview, alias_line: u32, alias_offset: u32, is_branch: bool) -> (known: bool, rows: darray[u32]):
            can Memory.Allocate, Abort.Panic:
                rows: mutable darray[u32] = []
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |rows, found_marker, unknown, alias_name, alias_scope, alias_line, alias_offset|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__using_alias_static_branch" or marker.detail_name != alias_name or marker.module != alias_scope or marker.line != alias_line or marker.offset != alias_offset
                    found_marker <- true
                    if marker.identity_id == 4294967295:
                        unknown <- true
                    else:
                        rows.push(marker.identity_id)
                return (false, rows) if unknown or (is_branch and not found_marker)
                return (true, rows)

        def catch_module_alias_branch_stack_prefix(prefix: darray[u32], path: darray[u32]) -> bool:
            can Abort.Panic:
                return false if prefix.count > path.count
                for index in 0..<prefix.count |prefix, path|:
                    return false if prefix[index] != path[index]
                return true

        def catch_module_alias_is_unresolved(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, alias_scope: sview, alias_line: u32, alias_offset: u32) -> bool:
            can Abort.Panic:
                return any alias in annotations where catch_module_alias_annotation_is_unknown(alias) and catch_module_alias_annotation_name(alias) == alias_name and alias.module == alias_scope and alias.line == alias_line and alias.offset == alias_offset

        # Refine partial scope ordering with the parser's ordered enclosing-branch identities.
        # A strict prefix is an outer branch block whose direct aliases register before its
        # nested branch/module body, even when the outer token appears later in source.
        def catch_module_alias_order_with_branch_context(annotations: darray[Ast::EnumAnnotation]&, candidate: Ast::EnumAnnotation, selected_name: sview, selected_scope: sview, selected_line: u32, selected_offset: u32, selected_is_branch: bool) -> (known: bool, precedes: bool):
            can Memory.Allocate, Abort.Panic:
                candidate_name: sview = catch_module_alias_annotation_name(candidate)
                candidate_is_branch: bool = catch_module_alias_is_static_branch(annotations, candidate)
                if candidate.module == selected_scope and candidate.offset == selected_offset:
                    return (true, false) if candidate.line == selected_line and candidate_name == selected_name
                    return (false, false)
                base_order: (known: bool, precedes: bool) = catch_module_alias_order(candidate.module, candidate.offset, candidate_is_branch, selected_scope, selected_offset, selected_is_branch)
                return base_order if candidate.module == selected_scope and candidate_is_branch != selected_is_branch
                return base_order if not candidate_is_branch and not selected_is_branch
                return base_order if catch_module_is_ancestor(candidate.module, selected_scope) and not candidate_is_branch
                return base_order if catch_module_is_ancestor(selected_scope, candidate.module) and not selected_is_branch
                candidate_stack: (known: bool, rows: darray[u32]) = catch_module_alias_branch_stack(annotations, candidate_name, candidate.module, candidate.line, candidate.offset, candidate_is_branch)
                selected_stack: (known: bool, rows: darray[u32]) = catch_module_alias_branch_stack(annotations, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                return (false, false) if not candidate_stack.known or not selected_stack.known
                if candidate.module == selected_scope:
                    if candidate_is_branch and selected_is_branch:
                        if candidate_stack.rows.count < selected_stack.rows.count and catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows):
                            return (true, true)
                        if selected_stack.rows.count < candidate_stack.rows.count and catch_module_alias_branch_stack_prefix(selected_stack.rows, candidate_stack.rows):
                            return (true, false)
                        if candidate_stack.rows.count == selected_stack.rows.count and catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows):
                            return (false, false) if candidate.offset == selected_offset
                            return (true, candidate.offset < selected_offset)
                        # Inactive aliases were removed before this resolver runs. Two
                        # same-scope branch aliases with divergent stacks that remain here
                        # without an unknown barrier are both active, so they belong to
                        # separate chains and follow Core's source-order registration.
                        return (false, false) if catch_module_alias_is_unresolved(annotations, candidate_name, candidate.module, candidate.line, candidate.offset) or catch_module_alias_is_unresolved(annotations, selected_name, selected_scope, selected_line, selected_offset)
                        return (false, false) if candidate.offset == selected_offset
                        return (true, candidate.offset < selected_offset)
                    return (false, false)
                if catch_module_is_ancestor(candidate.module, selected_scope):
                    if candidate_is_branch and selected_is_branch:
                        return (true, true) if catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows)
                        return (false, false)
                    return (false, false) if candidate.offset == selected_offset
                    return (true, candidate.offset < selected_offset)
                if catch_module_is_ancestor(selected_scope, candidate.module):
                    if candidate_is_branch and selected_is_branch:
                        return (true, false) if catch_module_alias_branch_stack_prefix(selected_stack.rows, candidate_stack.rows)
                        return (false, false)
                    return (false, false) if candidate.offset == selected_offset
                    return (true, candidate.offset < selected_offset)
                if candidate_is_branch and selected_is_branch:
                    return (false, false) if candidate_stack.rows.count != selected_stack.rows.count or not catch_module_alias_branch_stack_prefix(candidate_stack.rows, selected_stack.rows)
                    return (false, false) if candidate.offset == selected_offset
                    return (true, candidate.offset < selected_offset)
                return (false, false) if candidate.offset == selected_offset
                return (true, candidate.offset < selected_offset)

        # Alias-target chains can see only aliases registered before their declaration.
        # This uses Core's block registration order rather than a raw source-offset cutoff:
        # an enclosing block is pre-registered before its nested modules.
        def catch_module_alias_row_is_before(annotations: darray[Ast::EnumAnnotation]&, candidate: Ast::EnumAnnotation, declaration_scope: sview, declaration_line: u32, declaration_offset: u32) -> (known: bool, before: bool):
            can Memory.Allocate, Abort.Panic:
                return (true, false) if not semantic_import_scope_visible(candidate.module, declaration_scope)
                return (true, true) if declaration_offset == 4294967295
                candidate_is_branch: bool = catch_module_alias_is_static_branch(annotations, candidate)
                for declaration in annotations |candidate_is_branch, annotations, candidate, declaration_scope, declaration_line, declaration_offset|:
                    continue if declaration.name != "__using_alias" or declaration.module != declaration_scope or declaration.line != declaration_line or declaration.offset != declaration_offset
                    declaration_is_branch: bool = catch_module_alias_is_static_branch(annotations, declaration)
                    if candidate.module == declaration.module and candidate.line == declaration.line and candidate.offset == declaration.offset:
                        return (true, false)
                    return (false, false) if candidate.offset == declaration.offset
                    return catch_module_alias_order_with_branch_context(annotations, candidate, declaration.owner, declaration.module, declaration.line, declaration.offset, declaration_is_branch)
                return (false, false)

        # Preserve an explicitly qualified family in `error[Provider::Fault]`. The leaf
        # row is still used for messages and subset matching; this parallel path row selects
        # the enum inventory when the caller module also declares a same-leaf Fault.
        def catch_module_alias_target(annotations: darray[Ast::EnumAnnotation]&, alias_name: sview @source, lexical_module: sview @source, declaration_line: u32, declaration_offset: u32) -> (found: bool, uncertain: bool, module: sview @source, scope: sview @source, line: u32, offset: u32):
            can Memory.Allocate, Abort.Panic:
                selected_target: mutable sview @source = alias_name
                selected_name: mutable sview @source = ""
                selected_scope: mutable sview @source = ""
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                found: mutable bool = false
                ambiguous: mutable bool = false
                selected_unknown: mutable bool = false
                alias_order_unknown: mutable bool = false
                visibility_uncertain: mutable bool = false
                selected_is_branch: mutable bool = false
                for alias in annotations |selected_target, selected_name, selected_scope, selected_line, selected_offset, found, ambiguous, selected_unknown, alias_order_unknown, visibility_uncertain, selected_is_branch, alias_name, lexical_module, declaration_line, declaration_offset|:
                    if catch_module_alias_annotation_is_unknown(alias):
                        continue if not catch_module_path_matches(alias_name, catch_module_alias_annotation_name(alias))
                        alias_visibility: (known: bool, before: bool) = catch_module_alias_row_is_before(annotations, alias, lexical_module, declaration_line, declaration_offset)
                        if not alias_visibility.known:
                            visibility_uncertain <- true
                            continue
                        continue if not alias_visibility.before
                        candidate_order: (known: bool, precedes: bool) = catch_module_alias_order_with_branch_context(annotations, alias, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                        candidate_precedes: bool = alias.module.len > selected_scope.len if alias.module != selected_scope else candidate_order.known and candidate_order.precedes
                        if not found or candidate_precedes:
                            selected_target <- alias_name
                            selected_name <- catch_module_alias_annotation_name(alias)
                            selected_scope <- alias.module
                            selected_line <- alias.line
                            selected_offset <- alias.offset
                            found <- true
                            ambiguous <- false
                            selected_unknown <- true
                            selected_is_branch <- true
                        elif alias.module == selected_scope and alias.offset == selected_offset and selected_is_branch:
                            selected_unknown <- true
                        continue
                    continue if not catch_module_path_matches(alias_name, alias.owner) or alias.name != "__using_alias"
                    alias_visibility: (known: bool, before: bool) = catch_module_alias_row_is_before(annotations, alias, lexical_module, declaration_line, declaration_offset)
                    if not alias_visibility.known:
                        visibility_uncertain <- true
                        continue
                    continue if not alias_visibility.before
                    target: mutable sview @source = ""
                    target_count: mutable usize = 0.usize()
                    for target_row in annotations |target, target_count, alias|:
                        continue if target_row.name != "__using_alias_target" or target_row.module != alias.module or target_row.line != alias.line or target_row.offset != alias.offset
                        target <- target_row.owner
                        target_count <- target_count + 1.usize()
                    candidate_is_branch: bool = catch_module_alias_is_static_branch(annotations, alias)
                    candidate_order: (known: bool, precedes: bool) = catch_module_alias_order_with_branch_context(annotations, alias, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                    candidate_precedes: bool = alias.module.len > selected_scope.len if alias.module != selected_scope else candidate_order.known and candidate_order.precedes
                    if target_count != 1.usize():
                        if not found or candidate_precedes:
                            selected_target <- alias_name
                            selected_name <- alias.owner
                            selected_scope <- alias.module
                            selected_line <- alias.line
                            selected_offset <- alias.offset
                            found <- true
                            ambiguous <- false
                            selected_unknown <- true
                            selected_is_branch <- candidate_is_branch
                        continue
                    if not found or candidate_precedes:
                        selected_target <- target
                        selected_name <- alias.owner
                        selected_scope <- alias.module
                        selected_line <- alias.line
                        selected_offset <- alias.offset
                        found <- true
                        ambiguous <- false
                        selected_unknown <- false
                        selected_is_branch <- candidate_is_branch
                    elif alias.module == selected_scope and alias.offset == selected_offset and candidate_is_branch == selected_is_branch:
                        ambiguous <- true if not selected_unknown and selected_target != target
                if visibility_uncertain and not found:
                    alias_order_unknown <- true
                if found:
                    # Decide uncertainty against the final winner, not whichever candidate
                    # happened to be visited first. A later direct ancestor may dominate an
                    # earlier unordered branch candidate.
                    for alias in annotations |alias_order_unknown, alias_name, lexical_module, declaration_line, declaration_offset, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch|:
                        if catch_module_alias_annotation_is_unknown(alias):
                            continue if not catch_module_path_matches(alias_name, catch_module_alias_annotation_name(alias))
                        else:
                            continue if alias.name != "__using_alias" or not catch_module_path_matches(alias_name, alias.owner)
                        alias_visibility: (known: bool, before: bool) = catch_module_alias_row_is_before(annotations, alias, lexical_module, declaration_line, declaration_offset)
                        continue if alias_visibility.known and not alias_visibility.before
                        continue if alias.module.len < selected_scope.len
                        order: (known: bool, precedes: bool) = catch_module_alias_order_with_branch_context(annotations, alias, selected_name, selected_scope, selected_line, selected_offset, selected_is_branch)
                        alias_order_unknown <- true if alias.module.len > selected_scope.len or not order.known or order.precedes
                return (false, true, alias_name, "", 0, 0) if ambiguous or selected_unknown or alias_order_unknown
                return (true, false, selected_target, selected_scope, selected_line, selected_offset) if found
                return (false, false, alias_name, "", 0, 0)

        # Catch parser metadata stores the module prefix, sometimes including the final
        # `::` depending on the source span boundary. Normalize either spelling.
        def catch_module_qualifier_core(raw_qualifier: sview @source) -> sview @source:
            can Abort.Panic:
                separator: usize = catch_family_separator_start(raw_qualifier, raw_qualifier.len)
                return raw_qualifier if separator == raw_qualifier.len
                second_colon: usize = catch_skip_path_trivia(raw_qualifier, separator + 1.usize())
                return raw_qualifier if second_colon >= raw_qualifier.len or raw_qualifier[second_colon] != 58
                trailing: usize = catch_skip_path_trivia(raw_qualifier, second_colon + 1.usize())
                return raw_qualifier if trailing < raw_qualifier.len
                return raw_qualifier[0:separator]

        def catch_module_qualifier_matches(raw_qualifier: sview @source, canonical_module: sview) -> bool:
            can Abort.Panic:
                return catch_module_path_matches(catch_module_qualifier_core(raw_qualifier), canonical_module)

        # Resolve a `using Target as Alias` from Stage0's global module-alias map. Expand
        # aliases in the head of each target path and carry every untouched suffix forward.
        # Each hop uses that alias declaration's own source position as the visibility cutoff.
        def catch_module_qualifier_alias_target(annotations: darray[Ast::EnumAnnotation]&, raw_qualifier: sview @source, lexical_module: sview @source, catch_line: u32, catch_offset: u32) -> (found: bool, uncertain: bool, module: sview @source, scope: sview @source, suffixes: darray[sview @source]):
            can Memory.Allocate, Abort.Panic:
                suffixes: mutable darray[sview @source] = []
                qualifier_path: sview @source = catch_module_qualifier_core(raw_qualifier)
                separator: usize = catch_first_module_separator_start(qualifier_path)
                alias_name: sview @source = qualifier_path if separator == qualifier_path.len else qualifier_path[0:separator]
                if separator < qualifier_path.len:
                    second_colon: usize = catch_skip_path_trivia(qualifier_path, separator + 1.usize())
                    suffixes.push(qualifier_path[second_colon + 1.usize():qualifier_path.len])
                return (false, false, "", "", suffixes) if alias_name == ""
                # Stage0 flattens the complete file and registers nested-module aliases
                # before checking function bodies, so the first lookup sees all rows.
                # Later chain hops retain the selected declaration's own source cutoff.
                alias_target: mutable (found: bool, uncertain: bool, module: sview @source, scope: sview @source, line: u32, offset: u32) = catch_module_alias_target(annotations, alias_name, lexical_module, catch_line, 4294967295)
                return (false, true, "", "", suffixes) if alias_target.uncertain
                return (false, false, "", "", suffixes) if not alias_target.found
                candidate_path: mutable sview @source = alias_target.module
                candidate_scope: mutable sview @source = alias_target.scope
                candidate_line: mutable u32 = alias_target.line
                candidate_offset: mutable u32 = alias_target.offset
                alias_hops: mutable usize = 0.usize()
                while alias_hops < 16.usize() |candidate_path, candidate_scope, candidate_line, candidate_offset, alias_hops, alias_target, annotations, suffixes|:
                    target_separator: usize = catch_first_module_separator_start(candidate_path)
                    target_alias_name: sview @source = candidate_path if target_separator == candidate_path.len else candidate_path[0:target_separator]
                    target_suffix: mutable sview @source = ""
                    if target_separator < candidate_path.len:
                        second_colon: usize = catch_skip_path_trivia(candidate_path, target_separator + 1.usize())
                        target_suffix <- candidate_path[second_colon + 1.usize():candidate_path.len]
                    alias_target <- catch_module_alias_target(annotations, target_alias_name, candidate_scope, candidate_line, candidate_offset)
                    return (false, true, "", "", suffixes) if alias_target.uncertain
                    break if not alias_target.found
                    if target_suffix != "":
                        expanded_suffixes: mutable darray[sview @source] = []
                        expanded_suffixes.push(target_suffix)
                        for suffix in suffixes |expanded_suffixes|:
                            expanded_suffixes.push(suffix)
                        suffixes <- expanded_suffixes
                    candidate_path <- alias_target.module
                    candidate_scope <- alias_target.scope
                    candidate_line <- alias_target.line
                    candidate_offset <- alias_target.offset
                    alias_hops <- alias_hops + 1.usize()
                return (false, true, "", "", suffixes) if alias_hops == 16.usize() and alias_target.found
                return (true, false, candidate_path, candidate_scope, suffixes)

        # Join the callee qualifier to its Catch marker using the source position and
        # caller module. An unqualified call returns an empty qualifier with its marker
        # offset, which still provides the alias visibility cutoff for shared lookup.
        def catch_callee_module_qualifier(annotations: darray[Ast::EnumAnnotation]&, callee: sview, catch_line: u32, catch_offset: u32, caller_module: sview) -> (found: bool, qualifier: sview @source, offset: u32):
            can Abort.Panic:
                selected: mutable sview @source = ""
                selected_offset: mutable u32 = 0
                marker_count: mutable usize = 0.usize()
                qualifier_count: mutable usize = 0.usize()
                ambiguous: mutable bool = false
                for marker in annotations |selected, selected_offset, marker_count, qualifier_count, ambiguous, callee, catch_line, catch_offset, caller_module|:
                    continue if marker.owner != callee or marker.name != "__catch_expr" or marker.line != catch_line or marker.module != caller_module
                    continue if catch_offset != 0 and marker.offset != catch_offset
                    marker_count <- marker_count + 1.usize()
                    selected_offset <- marker.offset if marker_count == 1.usize()
                    for qualifier in annotations |selected, selected_offset, marker_count, qualifier_count, ambiguous, marker|:
                        continue if qualifier.owner != "__catch_callee_module" or qualifier.line != marker.line or qualifier.offset != marker.offset or qualifier.module != marker.module
                        qualifier_count <- qualifier_count + 1.usize()
                        if qualifier_count == 1.usize():
                            selected <- qualifier.name
                        elif selected != qualifier.name:
                            ambiguous <- true
                return (false, "", 0) if ambiguous or marker_count == 0.usize() or (catch_offset == 0 and marker_count > 1.usize())
                return (true, selected, selected_offset)

