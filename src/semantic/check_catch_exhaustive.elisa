extend Semantic:
    private:
        def catch_error_family(annotations: darray[Ast::EnumAnnotation]&, callee: sview) -> sview:
            can Abort.Panic:
                declaration_line: mutable u32 = 0
                for annotation in annotations |declaration_line|:
                    declaration_line <- annotation.line if annotation.owner == callee and annotation.name == "__error_return" else declaration_line
                "" return if declaration_line == 0
                for annotation in annotations:
                    annotation.name return if annotation.owner == callee and annotation.line == declaration_line and annotation.name != "__error_return" and annotation.name != "__export_array"
                return ""

        def catch_line_has(annotations: darray[Ast::EnumAnnotation]&, callee: sview, line: u32, name: sview) -> bool:
            for annotation in annotations:
                true return if annotation.owner == callee and annotation.line == line and annotation.name == name
            return false

        # A qualified catch arm records its source path (`Family.Variant`), while
        # the enum registry stores the variant name separately from its family.
        # Exhaustiveness must accept both spellings: bare `Variant:` when the
        # family is unambiguous and qualified `Family.Variant:` when it is not.
        def catch_line_has_variant(annotations: darray[Ast::EnumAnnotation]&, callee: sview, line: u32, family: sview, variant: sview) -> bool:
            for annotation in annotations:
                continue if annotation.owner != callee or annotation.line != line
                true return if annotation.name == variant
                path_length: usize = sview_len(family) + 1 + sview_len(variant)
                continue if sview_len(annotation.name) != path_length
                continue if sview_at(annotation.name, sview_len(family)) != 46
                family_matches: mutable bool = true
                for family_index in 0..<sview_len(family) |family_matches, annotation, family|:
                    family_matches <- false if sview_at(annotation.name, family_index) != sview_at(family, family_index)
                continue if not family_matches
                variant_matches: mutable bool = true
                for variant_index in 0..<sview_len(variant) |variant_matches, annotation, family, variant|:
                    variant_matches <- false if sview_at(annotation.name, sview_len(family) + 1 + variant_index) != sview_at(variant, variant_index)
                true return if variant_matches
            return false

        def check_catch_exhaustive_rows(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for tail_annotation in annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmTail, name: "", line: tail_annotation.line, expected: "", actual: ""}) if tail_annotation.name == "__catch_arm_tail"
                for annotation in annotations |table|:
                    if annotation.name == "__catch_expr" and not catch_line_has(annotations, annotation.owner, annotation.line, "__catch_all"):
                        family: sview = catch_error_family(annotations, annotation.owner)
                        if family != "":
                            while variant_index < table.enum_variant_owner.count |variant_index: usize = 0, table|:
                                variant: sview = table.enum_variant_name[variant_index]
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveCatch, name: variant, line: annotation.line, expected: family, actual: ""}) if table.enum_variant_owner[variant_index] == family and not catch_line_has_variant(annotations, annotation.owner, annotation.line, family, variant)
                                variant_index <- variant_index + 1

    public:
        def check_catch_exhaustive(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_catch_exhaustive_rows(file.enum_annotations, table)
