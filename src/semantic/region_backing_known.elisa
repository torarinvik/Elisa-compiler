# Closed set of region allocation strategies accepted by region-backing validation.
# Keep the classifier standalone so Elisa-proof can verify its exact production contract.
module RegionBackingKnown:
    public:
        def is_known(name: sview) -> bool can[Abort.Panic]:
            ensure result == (when name: "malloc" -> true "reserve_commit" -> true "fixed" -> true "chained" -> true "scratch" -> true _ -> false)
            return when name:
                "malloc" -> true
                "reserve_commit" -> true
                "fixed" -> true
                "chained" -> true
                "scratch" -> true
                _ -> false
