extend Semantic:
    private:
        # Record whole-local moves at the point lexical scopes and IDs are known.
        # Projections and complex operands require place modeling, never a guessed root.
        def record_resolved_binding_move(operand: Ast::Expr, position: Ast::Pos, bound: darray[sview]&, bound_ids: darray[BindingId]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = operand
                depth: mutable u32 = 0
                while depth < EXPRESSION_ANALYSIS_DEPTH_LIMIT |current, depth, table|:
                    match current:
                        Expr.Paren(inner, _):
                            current <- inner
                            depth <- depth + 1
                        Expr.Ident(name, operand_pos):
                            index: int = bound_last_index(bound, name)
                            if index >= 0 and index.usize() < bound_ids.count:
                                table.binding_moves <- table.binding_moves.push(ResolvedBindingMove{resolved: true, binding_id: bound_ids[index.usize()], pos: position, operand_pos: operand_pos})
                                return
                            break
                        _:
                            break
                table.binding_moves <- table.binding_moves.push(ResolvedBindingMove{resolved: false, binding_id: BindingId{owner: DeclId{value: 4294967295}, serial: 0}, pos: position, operand_pos: Ast::pos_at_line(0)})
