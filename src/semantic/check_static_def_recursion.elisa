# Static-function recursion discipline (stage0). A `static def` is evaluated at compile
# time, so its recursion must be provably terminating:
#   * INDIRECT recursion (a cycle A -> B -> A among static functions) is unsupported;
#   * a DIRECT self-call must decrease a parameter by a positive constant (`f(n - 1)`),
#     otherwise it is a non-terminating partial recursion.
#
# Static functions are recorded by the parser on __static_fn. This walks each static
# function's body, collecting the static functions it calls and inspecting its self-calls.
extend Semantic:
    private:
        def sdr_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for entry in names:
                    true return if entry == wanted
                return false

        def sdr_collect_static_fns(annotations: darray[Ast::EnumAnnotation]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.extend([annotation.name for annotation in annotations if annotation.owner == "__static_fn" and not sdr_name_in(out, annotation.name)])
        # A valid decrease argument: `param - positive_int_literal` or `param - CONST` (a
        # named positive step constant, e.g. `n - Step`).
        def sdr_is_decrease(argument: Ast::Expr, param: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.Minus and left is Expr.Ident(left_name, left_line) and left_name == param:
                            if right is Expr.IntLit(int_value):
                                return int_value > 0
                            if right is Expr.Ident(step_name, step_line):
                                return true
                            return false
                        return false
                    Expr.Paren(inner, paren_line):
                        return sdr_is_decrease(inner, param)
                    _:
                        return false

        # Collect calls to static functions in an expression: the callee names into
        # `called`, and — for self-calls — whether any had a valid decrease.
        def sdr_scan_calls(expression: Ast::Expr, static_fns: darray[sview]&, self_name: sview, self_param: sview, called: mutable darray[sview]&, self_calls: mutable bool&, self_decreases: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        if sdr_name_in(static_fns, callee_name):
                            called.push(callee_name) if not sdr_name_in(called, callee_name)
                            if callee_name == self_name:
                                self_calls <- true
                                self_decreases <- true if arguments.count > 0 and sdr_is_decrease(arguments[0], self_param)
                        for argument in arguments |static_fns, called, self_calls, self_decreases|:
                            sdr_scan_calls(argument, static_fns, self_name, self_param, called, self_calls, self_decreases)
                    Expr.Binary(left, operator, right, binary_line):
                        sdr_scan_calls(left, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        sdr_scan_calls(right, static_fns, self_name, self_param, called, self_calls, self_decreases)
                    Expr.Unary(operator, operand, unary_line):
                        sdr_scan_calls(operand, static_fns, self_name, self_param, called, self_calls, self_decreases)
                    Expr.Paren(inner, paren_line):
                        sdr_scan_calls(inner, static_fns, self_name, self_param, called, self_calls, self_decreases)
                    _:
                        pass

        def sdr_scan_body(statements: darray[Ast::Stmt], static_fns: darray[sview]&, self_name: sview, self_param: sview, called: mutable darray[sview]&, self_calls: mutable bool&, self_decreases: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |static_fns, called, self_calls, self_decreases|:
                    match statement:
                        Stmt.Return(value, line):
                            sdr_scan_calls(returned, static_fns, self_name, self_param, called, self_calls, self_decreases) if value is returned
                        Stmt.Expr(expression, line):
                            sdr_scan_calls(expression, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        Stmt.VarDecl(name, type_expression, value, line):
                            sdr_scan_calls(value, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        Stmt.Assign(target, operator, value, line):
                            sdr_scan_calls(value, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        Stmt.If(condition, then_body, else_body, line):
                            sdr_scan_body(then_body, static_fns, self_name, self_param, called, self_calls, self_decreases)
                            sdr_scan_body(else_body, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        Stmt.While(condition, while_body, while_line):
                            sdr_scan_body(while_body, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            sdr_scan_body(for_body, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            sdr_scan_body(body, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |static_fns, called, self_calls, self_decreases|:
                                sdr_scan_body(arm.body, static_fns, self_name, self_param, called, self_calls, self_decreases)
                        _:
                            pass

        # Whether static function `callee` (in program order) calls `target`.
        def sdr_calls(declarations: darray[Ast::Decl]&, static_fns: darray[sview]&, caller: sview, target: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            if name == caller:
                                called: mutable darray[sview] = []
                                self_calls: mutable bool = false
                                self_decreases: mutable bool = false
                                first_param: sview = params[0].name if params.count > 0 else sview("", 0, 0)
                                sdr_scan_body(body, static_fns, caller, first_param, called, self_calls, self_decreases)
                                return sdr_name_in(called, target)
                        Decl.Module(module_name, module_body, module_line) | Decl.Scoped(module_body, module_line):
                            true return if sdr_calls(module_body, static_fns, caller, target)
                        _:
                            pass
                return false

        # Whether a type names a SIGNED integer (so a parameter can go negative and slip
        # past an `== 0` base case).
        def sdr_is_signed_int(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                name: sview = bare_type_name(type_expression)
                return when name:
                    "i64" | "int" | "i32" | "i16" | "i8" | "isize" -> true
                    _ -> false

        # Record the base-case shape a guard reveals about PARAM: an `== 0` equality, and/or a
        # lower-bound comparison (`param <= L` / `param < L`, or mirrored) that also stops a
        # negative descent.
        def sdr_note_guard(condition: Ast::Expr, param: sview, has_eq_zero: mutable bool&, has_lower: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, line):
                        sdr_note_guard(inner, param, has_eq_zero, has_lower)
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.And or operator == TokenKind.Or:
                            sdr_note_guard(left, param, has_eq_zero, has_lower)
                            sdr_note_guard(right, param, has_eq_zero, has_lower)
                            return
                        left_name: sview = ident_name_of(left)
                        right_name: sview = ident_name_of(right)
                        left_zero: (found: bool, value: i64) = fold_const_int(left)
                        right_zero: (found: bool, value: i64) = fold_const_int(right)
                        left_is_zero: bool = left_zero.found and left_zero.value == 0
                        right_is_zero: bool = right_zero.found and right_zero.value == 0
                        has_eq_zero <- true if operator == TokenKind.EqEq and ((left_name == param and right_is_zero) or (right_name == param and left_is_zero))
                        has_lower <- true if (operator == TokenKind.LtEq or operator == TokenKind.Lt) and left_name == param
                        has_lower <- true if (operator == TokenKind.GtEq or operator == TokenKind.Gt) and right_name == param
                    _:
                        pass

        def sdr_scan_guards(statements: darray[Ast::Stmt], param: sview, has_eq_zero: mutable bool&, has_lower: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |param, has_eq_zero, has_lower|:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            sdr_note_guard(condition, param, has_eq_zero, has_lower)
                            sdr_scan_guards(then_body, param, has_eq_zero, has_lower)
                            sdr_scan_guards(else_body, param, has_eq_zero, has_lower)
                        Stmt.While(condition, while_body, while_line):
                            sdr_note_guard(condition, param, has_eq_zero, has_lower)
                            sdr_scan_guards(while_body, param, has_eq_zero, has_lower)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            sdr_scan_guards(for_body, param, has_eq_zero, has_lower)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            sdr_scan_guards(body, param, has_eq_zero, has_lower)
                        _:
                            pass

        def sdr_check_declarations(all_declarations: darray[Ast::Decl]&, declarations: darray[Ast::Decl], static_fns: darray[sview]&, reported_cycle: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                reported_cycle.reserve(reported_cycle.count + declarations.count)
                for declaration in declarations |reported_cycle, table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if sdr_name_in(static_fns, function_name):
                                called: mutable darray[sview] = []
                                self_calls: mutable bool = false
                                self_decreases: mutable bool = false
                                first_param: sview = parameters[0].name if parameters.count > 0 else sview("", 0, 0)
                                sdr_scan_body(body, static_fns, function_name, first_param, called, self_calls, self_decreases)
                                # Partial self-recursion: self-calls with no valid decrease.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticPartialRecursion, name: function_name, line: line.line, expected: "", actual: ""}) if self_calls and not self_decreases
                                # A DECREASING signed recursion whose only base case is `== 0`
                                # never terminates for a negative start — stage0 demands a
                                # lower-bound guard (`n <= 0`).
                                if self_calls and self_decreases and parameters.count > 0 and sdr_is_signed_int(parameters[0].type_expression):
                                    has_eq_zero: mutable bool = false
                                    has_lower: mutable bool = false
                                    sdr_scan_guards(body, first_param, has_eq_zero, has_lower)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticSignedBaseCase, name: function_name, line: line.line, expected: first_param, actual: ""}) if has_eq_zero and not has_lower
                                # Indirect recursion: this fn calls B and B calls back here.
                                for callee in called |reported_cycle, table| -> table:
                                    is_cycle: bool = callee != function_name and sdr_calls(all_declarations, static_fns, callee, function_name) and not sdr_name_in(reported_cycle, function_name) and not sdr_name_in(reported_cycle, callee)
                                    if is_cycle:
                                        reported_cycle.push(function_name)
                                        reported_cycle.push(callee)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticIndirectRecursion, name: function_name, line: line.line, expected: "", actual: callee})
                        Decl.Module(module_name, module_body, module_line):
                            table <- sdr_check_declarations(all_declarations, module_body, static_fns, reported_cycle, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- sdr_check_declarations(all_declarations, scoped_body, static_fns, reported_cycle, table)
                        _:
                            pass

    public:
        def check_static_def_recursion(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                static_fns: mutable darray[sview] = []
                sdr_collect_static_fns(file.enum_annotations, static_fns)
                if static_fns.count > 0:
                    reported_cycle: mutable darray[sview] = []
                    table <- sdr_check_declarations(file.top_decls, file.top_decls, static_fns, reported_cycle, table)
