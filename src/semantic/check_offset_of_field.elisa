# `offset_of(Struct, FIELD)` validation. The second argument is a field SELECTOR (not resolved
# as a value — see resolve_expr's offset_of skip), so this check confirms it names a real field:
#   - a primitive first argument (`offset_of(i64, x)`) has no fields → "field access requires
#     struct type, got i64";
#   - a known struct whose field set does NOT contain the name → "struct \"S\" has no field \"f\"".
# An unknown first-argument type is left alone (another check owns undefined-type reporting).
extend Semantic:
    private:
        # `sview` and `dstr` are STRUCTS with real, addressable fields — confirmed against
        # stage0: `offset_of(sview, len)` and `offset_of(dstr, count)` both ACCEPT. `cstr` is a
        # bare opaque pointer with no fields — stage0 rejects `offset_of(cstr, ...)` exactly like
        # a numeric primitive ("field access requires struct type, got cstr"). So the shared
        # `is_primitive_type_name` (which folds all three together for its OTHER callers, e.g.
        # the `.sview()`/`.cstr()` builtin-cast-method check) is wrong for THIS check specifically
        # — narrow it here rather than touching the shared helper.
        def oof_is_fieldless_type_name(name: sview) -> bool:
            can Abort.Panic:
                return is_primitive_type_name(name) and name != "sview" and name != "dstr"

        def offset_of_check_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        is_offsetof: bool = ident_name_of(callee) == "offset_of" or ident_name_of(callee) == "offsetof"
                        if is_offsetof and arguments.count == 2:
                            struct_name: sview = ident_name_of(arguments[0])
                            field_name: sview = ident_name_of(arguments[1])
                            if struct_name != "" and field_name != "":
                                if oof_is_fieldless_type_name(struct_name):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FieldAccessOnPrimitive, name: "", line: line, expected: "", actual: struct_name})
                                elif is_known_struct(table, struct_name) and not struct_has_field(table, struct_name, field_name):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LetDestructureUnknownField, name: field_name, line: line, expected: struct_name, actual: ""})
                        for argument in arguments |table| -> table:
                            table <- offset_of_check_expression(argument, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- offset_of_check_expression(left, table)
                        table <- offset_of_check_expression(right, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- offset_of_check_expression(operand, table)
                    Expr.Paren(inner, paren_line):
                        table <- offset_of_check_expression(inner, table)
                    _:
                        pass

        # Whether NAME is a user-declared struct with a registered field set.
        def is_known_struct(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return any owner in table.struct_field_owner where owner == name

        def offset_of_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- offset_of_check_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- offset_of_check_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- offset_of_check_expression(value, table)
                        Stmt.Return(value, line):
                            table <- offset_of_check_expression(returned, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- offset_of_check_expression(condition, table)
                            table <- offset_of_check_statements(then_body, table)
                            table <- offset_of_check_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- offset_of_check_expression(condition, table)
                            table <- offset_of_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- offset_of_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- offset_of_check_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- offset_of_check_statements(arm.body, table)
                        _:
                            pass

        def offset_of_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- offset_of_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- offset_of_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- offset_of_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_offset_of_field(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- offset_of_walk(file.top_decls, table)
