extend Semantic:
    private:
        def lambda_marker_at(annotations: darray[Ast::EnumAnnotation]&, marker: sview, line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == marker and annotation.line == line

        def check_block_lambda_context_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            lambda_line: u32 = block_line.line if value is Expr.Lambda(parameters, body, block_line) else 0
                            discarded: bool = ident_name_of(target) == "_"
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BlockLambdaMissingContext, name: "", line: lambda_line, expected: "", actual: ""}) if discarded and lambda_marker_at(annotations, "__block_lambda", lambda_line) and not lambda_marker_at(annotations, "__typed_lambda", lambda_line)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_block_lambda_context_statements(then_body, annotations, table)
                            table <- check_block_lambda_context_statements(else_body, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- check_block_lambda_context_statements(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_block_lambda_context_statements(body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_block_lambda_context_statements(body, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_block_lambda_context_statements(arm.body, annotations, table)
                        _:
                            pass

        def check_block_lambda_context_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_block_lambda_context_statements(body, annotations, table)
                        Decl.Module(name, body, line):
                            table <- check_block_lambda_context_declarations(body, annotations, table)
                        Decl.Scoped(body, line):
                            table <- check_block_lambda_context_declarations(body, annotations, table)
                        _:
                            pass

    public:
        def check_block_lambda_context(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_block_lambda_context_declarations(file.top_decls, file.enum_annotations, table)
