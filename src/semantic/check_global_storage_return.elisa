# A GLOBAL's owning container returned BY VALUE (stage0 checkGlobalStorageReturnEscape):
#
#     global store: mutable Box
#     def items_of() -> darray[i64]:
#         return store.items        # the copy shares store.items' buffer
#
# A darray/dstr/dict/set copy is a shallow header copy, so the caller's value points at the
# global's buffer; the global's next growth reallocates and frees it under the caller (verified
# by running: the copy read the global's later write, 9). This is the global-rooted analogue of
# the parameter rule (a parameter's storage cannot be returned with a region-less type).
#
# Decidable subset, mirroring stage0:
# - the function's declared return type is a bare owned container (darray/dstr/dict/set) or a
#   struct that (transitively) holds one; a `@r`, reference or view return is not this rule;
# - the returned value (a `return`, or the trailing expression) is a place rooted at a
#   `global` through parens, fields and indexes (a slice is a view, not a copy), or a local
#   initialised / `<-`-assigned from such a place (flow-insensitive: never cleared);
# - a parameter or local of the global's name shadows it.
extend Semantic:
    private:
        def gsr_container_struct_index(name: sview, owner_path: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&) -> i64:
            return -1 if container_names.count != starts.count or container_names.count != counts.count
            for index in 0..<container_names.count:
                continue if container_names[index] != name or counts[index] != owner_path.count
                start: usize = starts[index]
                return -1 if start > segments.count or counts[index] > segments.count - start
                same_path: mutable bool = true
                for segment in 0..<owner_path.count:
                    same_path <- false if segments[start + segment] != owner_path[segment]
                return index.i64() if same_path
            return -1


        def gsr_add_container_struct(name: sview, owner_path: darray[sview]&, names: mutable darray[sview]&, starts: mutable darray[usize]&, counts: mutable darray[usize]&, segments: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                names.push(name)
                starts.push(segments.count)
                counts.push(owner_path.count)
                segments.extend([segment for segment in owner_path])


        # A qualified type's scope is a chain in the AST. Keep its segments separate so
        # nested modules cannot collide just because their leaf module names are equal.
        def gsr_scope_segments(expression: Ast::Expr, out: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        out.push(name)
                        return true
                    Expr.Scope(base, member, _):
                        return false if not gsr_scope_segments(base, out)
                        out.push(member)
                        return true
                    _:
                        return false


        def gsr_scope_matches_owner(scope: darray[sview]&, owner_path: darray[sview]&) -> bool:
            can Abort.Panic:
                return false if scope.count == 0 or scope.count > owner_path.count
                offset: usize = owner_path.count - scope.count
                for index in 0..<scope.count:
                    return false if scope[index] != owner_path[offset + index]
                return true


        def gsr_module_name_matches_path(name: sview, path: darray[sview]&) -> bool:
            can Abort.Panic:
                return name == "" if path.count == 0
                cursor: mutable usize = 0
                for index in 0..<path.count |cursor, path, name|:
                    segment: sview = path[index]
                    segment_length: usize = segment.len
                    return false if cursor > name.len or segment_length > name.len - cursor
                    return false if name[cursor:cursor + segment_length] != segment
                    cursor <- cursor + segment_length
                    if index + 1 < path.count:
                        return false if cursor + 2 > name.len or name[cursor:cursor + 2] != "::"
                        cursor <- cursor + 2
                return cursor == name.len


        def gsr_module_path_prefix_matches(name: sview, path: darray[sview]&) -> bool:
            can Abort.Panic:
                return false if path.count == 0
                cursor: mutable usize = 0
                for index in 0..<path.count |cursor, path, name|:
                    segment: sview = path[index]
                    segment_length: usize = segment.len
                    return false if cursor > name.len or segment_length > name.len - cursor
                    return false if name[cursor:cursor + segment_length] != segment
                    cursor <- cursor + segment_length
                    return true if index + 1 == path.count and cursor == name.len
                    return false if cursor + 2 > name.len or name[cursor:cursor + 2] != "::"
                    cursor <- cursor + 2
                return false


        def gsr_has_module_separator(name: sview) -> bool:
            can Abort.Panic:
                for index in 0..<name.len:
                    return true if index + 1 < name.len and name[index:index + 2] == "::"
                return false


        def gsr_module_child_path(parent: darray[sview]&, module_name: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                path: mutable darray[sview] = []
                offset: mutable usize = 0
                if parent.count > 0 and not gsr_has_module_separator(module_name):
                    path.extend(parent)
                    path.push(module_name)
                    return path
                if gsr_module_path_prefix_matches(module_name, parent):
                    path.extend(parent)
                    for segment in parent:
                        offset <- offset + segment.len
                    offset <- offset + ((parent.count - 1) * 2) if parent.count > 0
                    offset <- offset + 2 if offset + 2 <= module_name.len and module_name[offset:offset + 2] == "::"
                start: mutable usize = offset
                cursor: mutable usize = offset
                while cursor < module_name.len |path, start, cursor, module_name|:
                    if cursor + 1 < module_name.len and module_name[cursor:cursor + 2] == "::":
                        path.push(module_name[start:cursor])
                        cursor <- cursor + 2
                        start <- cursor
                    else:
                        cursor <- cursor + 1
                path.push(module_name[start:module_name.len]) if start < module_name.len
                return path


        def gsr_module_path_exists(path: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if path.count == 0
                matches: mutable usize = 0
                for symbol in table.symbols |matches, path|:
                    matches <- matches + 1 if symbol.kind == SymbolKind.Module and gsr_module_name_matches_path(symbol.name, path)
                return matches == 1


        def gsr_qualified_container_index(name: sview, scope: darray[sview]&, owner_path: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, table: SymbolTable&) -> i64:
            can Memory.Allocate, Abort.Panic:
                return -1 if scope.count == 0
                local_index: mutable i64 = -1
                if gsr_scope_matches_owner(scope, owner_path):
                    local_index <- gsr_container_struct_index(name, owner_path, container_names, starts, counts, segments)
                    return local_index if local_index >= 0
                    return 0 if gsr_alias_resolves_to_container(name, owner_path, container_names, starts, counts, segments, table)
                    return -1
                relative_path: mutable darray[sview] = []
                relative_path.extend(owner_path)
                relative_path.extend(scope)
                if gsr_module_path_exists(relative_path, table):
                    local_index <- gsr_container_struct_index(name, relative_path, container_names, starts, counts, segments)
                    return local_index if local_index >= 0
                    return 0 if gsr_alias_resolves_to_container(name, relative_path, container_names, starts, counts, segments, table)
                    return -1
                if gsr_module_path_exists(scope, table):
                    local_index <- gsr_container_struct_index(name, scope, container_names, starts, counts, segments)
                    return local_index if local_index >= 0
                    return 0 if gsr_alias_resolves_to_container(name, scope, container_names, starts, counts, segments, table)
                return -1


        # Resolve an unqualified return/member type in the declaration's lexical owner
        # before consulting the container-struct closure. The closure is owner-qualified:
        # a same-spelled struct in another module cannot make a scalar enum look heap-backed.
        def gsr_named_container_struct(name: sview, owner_path: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if gsr_container_struct_index(name, owner_path, container_names, starts, counts, segments) >= 0
                local_type_seen: mutable bool = false
                local_alias_seen: mutable bool = false
                owner: sview = owner_path[owner_path.count - 1] if owner_path.count > 0 else ""
                for symbol in table.symbols:
                    if symbol.name == name and (symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias):
                        if gsr_module_name_matches_path(symbol.module_owner, owner_path) or (owner_path.count == 0 and symbol.module_owner == ""):
                            local_type_seen <- true
                            local_alias_seen <- true if symbol.kind == SymbolKind.Alias
                if local_type_seen:
                    return gsr_alias_resolves_to_container(name, owner_path, container_names, starts, counts, segments, table) if local_alias_seen
                    return false
                if owner_path.count > 0:
                    return true if gsr_container_or_alias_in_ancestors(name, owner_path, container_names, starts, counts, segments, table)
                    return false
                resolved_owner: sview = struct_owner_module_for(table, owner, name)
                resolved_path: mutable darray[sview] = []
                resolved_path.push(resolved_owner) if resolved_owner != ""
                return gsr_container_struct_index(name, resolved_path, container_names, starts, counts, segments) >= 0


        def gsr_alias_resolves_to_container(name: sview, owner_path: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                current_name: mutable sview = name
                current_owner: mutable darray[sview] = []
                current_owner.extend(owner_path)
                steps: mutable usize = 0
                while steps <= table.type_alias_declarations.count |current_name, steps, owner_path, container_names, starts, counts, segments, table|:
                    return true if current_name == "dstr" or current_name == "darray" or current_name == "dict" or current_name == "set"
                    return true if gsr_container_struct_index(current_name, current_owner, container_names, starts, counts, segments) >= 0
                    selected_symbol: mutable usize = table.symbols.count
                    selected_owner: mutable darray[sview] = []
                    found: mutable bool = false
                    owner_depth: mutable usize = current_owner.count
                    while owner_depth <= current_owner.count |selected_symbol, selected_owner, found, owner_depth, current_owner, current_name, table|:
                        candidate_owner: mutable darray[sview] = []
                        for index in 0..<owner_depth |candidate_owner, current_owner|:
                            candidate_owner.push(current_owner[index])
                        matches: mutable usize = 0
                        for index in 0..<table.symbols.count |selected_symbol, matches, candidate_owner, current_name, table|:
                            symbol: Symbol = table.symbols[index]
                            if symbol.kind == SymbolKind.Alias and symbol.name == current_name and gsr_module_name_matches_path(symbol.module_owner, candidate_owner):
                                selected_symbol <- index
                                matches <- matches + 1
                        if matches == 1:
                            selected_owner <- candidate_owner
                            found <- true
                            break
                        return false if matches > 1 or owner_depth == 0
                        owner_depth <- owner_depth - 1
                    return false if not found
                    alias_target: mutable sview = ""
                    for declaration in table.type_alias_declarations |selected_symbol, alias_target, table|:
                        symbol: Symbol = table.symbols[selected_symbol]
                        if declaration.declaration_id.value == symbol.id.value and gsr_module_name_matches_path(declaration.module_owner, selected_owner):
                            match declaration.target:
                                Expr.Ident(target_name, _):
                                    alias_target <- target_name
                                Expr.Paren(target_inner, _):
                                    if target_inner is Expr.Ident(paren_target, _):
                                        alias_target <- paren_target
                                    else:
                                        return false
                                Expr.Unary(operator, target_inner, _):
                                    if operator == TokenKind.Mutable and target_inner is Expr.Ident(mutable_target, _):
                                        alias_target <- mutable_target
                                    else:
                                        return false
                                Expr.Scope(scope_base, scope_name, _):
                                    target_scope: mutable darray[sview] = []
                                    return false if not gsr_scope_segments(scope_base, target_scope)
                                    target_owner: mutable darray[sview] = []
                                    if gsr_scope_matches_owner(target_scope, selected_owner):
                                        target_owner.extend(selected_owner)
                                    else:
                                        relative_target: mutable darray[sview] = []
                                        relative_target.extend(selected_owner)
                                        relative_target.extend(target_scope)
                                        if gsr_module_path_exists(relative_target, table):
                                            target_owner.extend(relative_target)
                                        else:
                                            return false if not gsr_module_path_exists(target_scope, table)
                                            target_owner.extend(target_scope)
                                    alias_target <- scope_name
                                    selected_owner <- target_owner
                                _:
                                    return false
                    return false if alias_target == ""
                    current_name <- alias_target
                    current_owner <- selected_owner
                    steps <- steps + 1
                return false


        def gsr_container_or_alias_in_ancestors(name: sview, owner_path: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                depth: mutable usize = owner_path.count
                while depth > 0 |depth, name, owner_path, container_names, starts, counts, segments, table|:
                    candidate_owner: mutable darray[sview] = []
                    for index in 0..<depth |candidate_owner, owner_path|:
                        candidate_owner.push(owner_path[index])
                    return true if gsr_container_struct_index(name, candidate_owner, container_names, starts, counts, segments) >= 0
                    return true if gsr_alias_resolves_to_container(name, candidate_owner, container_names, starts, counts, segments, table)
                    depth <- depth - 1
                root_owner: mutable darray[sview] = []
                return true if gsr_container_struct_index(name, root_owner, container_names, starts, counts, segments) >= 0
                return gsr_alias_resolves_to_container(name, root_owner, container_names, starts, counts, segments, table)


        def gsr_owned_type(type_expression: Ast::Expr, owner_path: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        return gsr_owned_type(operand, owner_path, container_names, starts, counts, segments, table) if operator == TokenKind.Mutable
                        return false
                    Expr.Paren(inner, paren_pos):
                        return gsr_owned_type(inner, owner_path, container_names, starts, counts, segments, table)
                    Expr.Ident(name, ident_pos):
                        return name == "dstr" or gsr_named_container_struct(name, owner_path, container_names, starts, counts, segments, table)
                    Expr.Scope(scope_base, scope_name, scope_pos):
                        scope_parts: mutable darray[sview] = []
                        return false if not gsr_scope_segments(scope_base, scope_parts)
                        return gsr_qualified_container_index(scope_name, scope_parts, owner_path, container_names, starts, counts, segments, table) >= 0
                    Expr.Index(object, element, index_pos):
                        head: sview = ident_name_of(object)
                        return when head:
                            "darray" | "set" | "dict" -> true
                            _ -> false
                    Expr.IndexN(object_n, arguments_n, index_n_pos):
                        head_n: sview = ident_name_of(object_n)
                        return when head_n:
                            "darray" | "set" | "dict" -> true
                            _ -> false
                    _:
                        return false


        # collect_container_structs closed over struct members: a struct holding a container
        # struct by value shares that struct's buffers too.
        def gsr_collect_container_structs(declarations: darray[Ast::Decl], owner_path: mutable darray[sview]&, names: mutable darray[sview]&, starts: mutable darray[usize]&, counts: mutable darray[usize]&, segments: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner_path, names, starts, counts, segments|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_pos):
                            if any member in members where member_type_is_owned_container(member.type_expression):
                                gsr_add_container_struct(struct_name, owner_path, names, starts, counts, segments)
                        Decl.Module(module_name, module_body, module_pos):
                            child_path: mutable darray[sview] = gsr_module_child_path(owner_path, module_name)
                            gsr_collect_container_structs(module_body, child_path, names, starts, counts, segments)
                        Decl.Scoped(scoped_body, scoped_pos):
                            gsr_collect_container_structs(scoped_body, owner_path, names, starts, counts, segments)
                        _:
                            pass


        def gsr_close_container_structs(declarations: darray[Ast::Decl], owner_path: mutable darray[sview]&, names: mutable darray[sview]&, starts: mutable darray[usize]&, counts: mutable darray[usize]&, segments: mutable darray[sview]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner_path, names, starts, counts, segments, table|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_pos):
                            continue if gsr_container_struct_index(struct_name, owner_path, names, starts, counts, segments) >= 0
                            if any member in members where gsr_owned_type(member.type_expression, owner_path, names, starts, counts, segments, table):
                                gsr_add_container_struct(struct_name, owner_path, names, starts, counts, segments)
                        Decl.Module(module_name, module_body, module_pos):
                            child_path: mutable darray[sview] = gsr_module_child_path(owner_path, module_name)
                            gsr_close_container_structs(module_body, child_path, names, starts, counts, segments, table)
                        Decl.Scoped(scoped_body, scoped_pos):
                            gsr_close_container_structs(scoped_body, owner_path, names, starts, counts, segments, table)
                        _:
                            pass

        def gsr_container_structs(declarations: darray[Ast::Decl], names: mutable darray[sview]&, starts: mutable darray[usize]&, counts: mutable darray[usize]&, segments: mutable darray[sview]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                owner_path: mutable darray[sview] = []
                gsr_collect_container_structs(declarations, owner_path, names, starts, counts, segments)
                changed: mutable bool = true
                while changed |changed, names, starts, counts, segments, table|:
                    changed <- false
                    before: usize = names.count
                    gsr_close_container_structs(declarations, owner_path, names, starts, counts, segments, table)
                    changed <- names.count != before


        def gsr_collect_globals(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Const(name, type_expression, value, is_mutable, const_pos):
                            out.push(name) if is_mutable
                        Decl.Module(module_name, module_body, module_pos):
                            gsr_collect_globals(module_body, out)
                        Decl.Scoped(scoped_body, scoped_pos):
                            gsr_collect_globals(scoped_body, out)
                        _:
                            pass


        # Every name a function body binds (locals and for binders), anywhere.
        def gsr_collect_locals(statements: darray[Ast::Stmt]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, decl_pos):
                            out.push(name)
                        Stmt.Block(kind, clause, binding, body, block_pos):
                            out.push(binding) if binding != ""
                            gsr_collect_locals(body, out)
                        Stmt.If(condition, then_body, else_body, if_pos):
                            gsr_collect_locals(then_body, out)
                            gsr_collect_locals(else_body, out)
                        Stmt.While(condition, while_body, while_pos):
                            gsr_collect_locals(while_body, out)
                        Stmt.For(bind, variables, iterable, for_body, for_pos):
                            out.push(bind) if bind != ""
                            for variable in variables |out|:
                                out.push(variable)
                            gsr_collect_locals(for_body, out)
                        Stmt.Match(scrutinee, arms, match_pos):
                            for arm in arms |out|:
                                gsr_collect_locals(arm.body, out)
                        _:
                            pass


        # The global a by-value expression shares storage with, or "".
        def gsr_root(value: Ast::Expr, globals: darray[sview]&, shadowed: darray[sview]&, alias_names: darray[sview]&, alias_roots: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_pos):
                        return gsr_root(inner, globals, shadowed, alias_names, alias_roots)
                    Expr.Field(object, field_name, field_pos):
                        return gsr_place_root(object, globals, shadowed)
                    Expr.Index(object, index, index_pos):
                        return gsr_place_root(object, globals, shadowed)
                    Expr.Ident(name, ident_pos):
                        for alias_index in 0..<alias_names.count:
                            return alias_roots[alias_index] if alias_names[alias_index] == name
                        return gsr_place_root(value, globals, shadowed)
                    _:
                        return sview("", 0, 0)


        def gsr_place_root(place: Ast::Expr, globals: darray[sview]&, shadowed: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Paren(inner, paren_pos):
                        return gsr_place_root(inner, globals, shadowed)
                    Expr.Field(object, field_name, field_pos):
                        return gsr_place_root(object, globals, shadowed)
                    Expr.Index(object, index, index_pos):
                        return gsr_place_root(object, globals, shadowed)
                    Expr.Ident(name, ident_pos):
                        return sview("", 0, 0) if any local in shadowed where local == name
                        return name if any global_name in globals where global_name == name
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        # Locals that share a global's storage: `x: darray[T] = g` / `x <- g`, to a fixpoint.
        def gsr_collect_aliases(statements: darray[Ast::Stmt]&, owner_path: darray[sview]&, globals: darray[sview]&, shadowed: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |owner_path, alias_names, alias_roots, table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, decl_pos):
                            if gsr_owned_type(type_expression, owner_path, container_names, starts, counts, segments, table) and not (any known in alias_names where known == name):
                                root: sview = gsr_root(value, globals, shadowed, alias_names, alias_roots)
                                if root != "":
                                    alias_names.push(name)
                                    alias_roots.push(root)
                        Stmt.Assign(target, operator, value, assign_pos):
                            target_name: sview = ident_name_of(target)
                            if target_name != "" and (operator == TokenKind.LArrow or operator == TokenKind.Assign) and not (any known in alias_names where known == target_name):
                                assigned_root: sview = gsr_root(value, globals, shadowed, alias_names, alias_roots)
                                if assigned_root != "" and (any local in shadowed where local == target_name):
                                    alias_names.push(target_name)
                                    alias_roots.push(assigned_root)
                        Stmt.Block(kind, clause, binding, body, block_pos):
                            gsr_collect_aliases(body, owner_path, globals, shadowed, container_names, starts, counts, segments, alias_names, alias_roots, table)
                        Stmt.If(condition, then_body, else_body, if_pos):
                            gsr_collect_aliases(then_body, owner_path, globals, shadowed, container_names, starts, counts, segments, alias_names, alias_roots, table)
                            gsr_collect_aliases(else_body, owner_path, globals, shadowed, container_names, starts, counts, segments, alias_names, alias_roots, table)
                        Stmt.While(condition, while_body, while_pos):
                            gsr_collect_aliases(while_body, owner_path, globals, shadowed, container_names, starts, counts, segments, alias_names, alias_roots, table)
                        Stmt.For(bind, variables, iterable, for_body, for_pos):
                            gsr_collect_aliases(for_body, owner_path, globals, shadowed, container_names, starts, counts, segments, alias_names, alias_roots, table)
                        Stmt.Match(scrutinee, arms, match_pos):
                            for arm in arms |owner_path, alias_names, alias_roots, table|:
                                gsr_collect_aliases(arm.body, owner_path, globals, shadowed, container_names, starts, counts, segments, alias_names, alias_roots, table)
                        _:
                            pass


        def gsr_check_function(parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt], owner_path: darray[sview]&, globals: darray[sview @source]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                shadowed: mutable darray[sview] = []
                for parameter in parameters |shadowed|:
                    shadowed.push(parameter.name)
                gsr_collect_locals(body, shadowed)
                alias_names: mutable darray[sview] = []
                alias_roots: mutable darray[sview] = []
                while true |alias_names, alias_roots|:
                    before: usize = alias_names.count
                    gsr_collect_aliases(body, owner_path, globals, shadowed, container_names, starts, counts, segments, alias_names, alias_roots, table)
                    break if alias_names.count == before
                returned_values: mutable darray[Ast::Expr] = []
                lvre_returns(body, true, returned_values)
                for returned in returned_values |table|:
                    root: sview = gsr_root(returned, globals, shadowed, alias_names, alias_roots)
                    continue if root == ""
                    position: Ast::Pos = Ast::expr_pos(returned)
                    # Name the global through the caller-owned `globals` row, not the local alias table.
                    for global_name in globals |table|:
                        continue if global_name != root
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GlobalStorageReturnEscape, name: global_name, line: position.line, pos: position, expected: "", actual: ""})
                        break


        def gsr_walk(declarations: darray[Ast::Decl], owner_path: mutable darray[sview]&, globals: darray[sview]&, container_names: darray[sview]&, starts: darray[usize]&, counts: darray[usize]&, segments: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owner_path, table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, func_pos):
                            if return_type is declared_return:
                                if gsr_owned_type(declared_return, owner_path, container_names, starts, counts, segments, table):
                                    table <- gsr_check_function(parameters, body, owner_path, globals, container_names, starts, counts, segments, table)
                        Decl.Module(module_name, module_body, module_pos):
                            child_path: mutable darray[sview] = gsr_module_child_path(owner_path, module_name)
                            table <- gsr_walk(module_body, child_path, globals, container_names, starts, counts, segments, table)
                        Decl.Scoped(scoped_body, scoped_pos):
                            table <- gsr_walk(scoped_body, owner_path, globals, container_names, starts, counts, segments, table)
                        _:
                            pass

    public:
        def check_global_storage_return(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                globals: mutable darray[sview] = []
                gsr_collect_globals(file.top_decls, globals)
                return if globals.count == 0
                container_names: mutable darray[sview] = []
                container_starts: mutable darray[usize] = []
                container_counts: mutable darray[usize] = []
                container_segments: mutable darray[sview] = []
                gsr_container_structs(file.top_decls, container_names, container_starts, container_counts, container_segments, table)
                owner_path: mutable darray[sview] = []
                table <- gsr_walk(file.top_decls, owner_path, globals, container_names, container_starts, container_counts, container_segments, table)
