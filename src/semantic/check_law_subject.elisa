# A value/predicate law (`law N(...) = pred`) must take at least one value parameter — its
# SUBJECT (conventionally `self`) — otherwise the refinement has nothing to constrain. The
# parser records sentinel 3900000032 (owner=law name) for a value law declared with an empty
# parameter list; turn each into the diagnostic.
extend Semantic:
    public:
        def check_law_subject(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.line == 3900000032 and annotation.owner != "":
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LawNeedsSubject, name: annotation.owner, line: 0, expected: "", actual: ""})
