# Termination-family diagnostic (structural, no call-graph). A `decreases` clause states a
# well-founded measure for a recursive (or looping) function; if the function makes NO calls at
# all, the clause is unused. stage0 warns on the broader "no direct RECURSIVE call" condition
# (which needs a call graph); we port the strict, provably-sound SUBSET "zero calls anywhere" —
# zero calls trivially implies no recursive call, so we can never fire where stage0 is silent.
#
# INVERTED SOUNDNESS: here MISSING a call is a false positive (we'd flag a function that really
# calls). So call detection is CONSERVATIVE — any expression/statement shape not positively known
# to be call-free is treated as possibly containing a call, suppressing the warning.
extend Semantic:
    private:
        # Whether an expression may contain a call. Leaves are call-free; common compound shapes
        # recurse; anything else conservatively "may contain a call" (never a sound miss).
        def expr_has_call(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Call(callee, arguments, argument_names, line):
                    return true
                Expr.Ident(name, ident_line):
                    return false
                Expr.IntLit(value):
                    return false
                Expr.FloatLit(text):
                    return false
                Expr.StringLit(text):
                    return false
                Expr.CharLit(text):
                    return false
                Expr.BoolLit(value):
                    return false
                Expr.Invalid:
                    return false
                Expr.Binary(left, operator, right, binary_line):
                    return expr_has_call(left) or expr_has_call(right)
                Expr.Unary(operator, operand, unary_line):
                    return expr_has_call(operand)
                Expr.Paren(inner, paren_line):
                    return expr_has_call(inner)
                Expr.Field(object, field, field_line):
                    return expr_has_call(object)
                Expr.Index(object, index, index_line):
                    return expr_has_call(object) or expr_has_call(index)
                _:
                    return true


        def stmts_have_call(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    if stmt_has_call(statement):
                        return true
                return false


        def stmt_has_call(statement: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, line):
                        return expr_has_call(expression)
                    Stmt.VarDecl(name, type_expression, value, line):
                        return expr_has_call(value)
                    Stmt.Assign(target, operator, value, line):
                        return expr_has_call(target) or expr_has_call(value)
                    Stmt.Return(value, line):
                        if value is return_value:
                            return expr_has_call(return_value)
                        return false
                    Stmt.If(condition, then_body, else_body, line):
                        return expr_has_call(condition) or stmts_have_call(then_body) or stmts_have_call(else_body)
                    Stmt.While(condition, body, line):
                        return expr_has_call(condition) or stmts_have_call(body)
                    Stmt.For(bind, variables, iterable, body, line):
                        return expr_has_call(iterable) or stmts_have_call(body)
                    Stmt.Block(kind, clause, binding, body, line):
                        return stmts_have_call(body)
                    Stmt.Match(scrutinee, arms, line):
                        if expr_has_call(scrutinee):
                            return true
                        for arm in arms:
                            if stmts_have_call(arm.body):
                                return true
                        return false
                    Stmt.Contract(kind, expression, line):
                        return expr_has_call(expression)
                    Stmt.Break(label, line):
                        return false
                    Stmt.Continue(label, line):
                        return false
                    Stmt.Invalid:
                        return false
                    _:
                        return true


        # Flag each top-level `decreases` in a function proven to make zero calls.
        def flag_unused_decreases(function_name: sview, statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            if contract_kind == "decreases":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnusedDecreases, name: function_name, line: line, expected: "", actual: ""})
                        _:
                            pass


        def check_unused_decreases(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if not stmts_have_call(body):
                                table <- flag_unused_decreases(name, body, table)
                        Decl.Module(module_name, body, module_line):
                            table <- check_unused_decreases(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_unused_decreases(scoped_body, table)
                        _:
                            pass
