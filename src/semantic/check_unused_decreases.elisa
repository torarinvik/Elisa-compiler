# Termination-family diagnostic (structural, no call-graph). A `decreases` clause states a
# well-founded measure for a recursive (or looping) function; if the function makes NO calls at
# all, the clause is unused. stage0 warns on the broader "no direct RECURSIVE call" condition
# (which needs a call graph); we port the strict, provably-sound SUBSET "zero calls anywhere" —
# zero calls trivially implies no recursive call, so we can never fire where stage0 is silent.
#
# INVERTED SOUNDNESS: here MISSING a call is a false positive (we'd flag a function that really
# calls). So call detection is CONSERVATIVE — any expression/statement shape not positively known
# to be call-free is treated as possibly containing a call, suppressing the warning.
extend Semantic:
    private:
        # Whether an expression may contain a call. Leaves are call-free; common compound shapes
        # recurse; anything else conservatively "may contain a call" (never a sound miss).
        def expr_has_call(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Call(callee, arguments, argument_names, line):
                    return true
                Expr.Ident(name, ident_line):
                    return false
                Expr.IntLit(value):
                    return false
                Expr.FloatLit(text):
                    return false
                Expr.StringLit(text):
                    return false
                Expr.CharLit(text):
                    return false
                Expr.BoolLit(value):
                    return false
                Expr.Invalid:
                    return false
                Expr.Absent:
                    return false
                Expr.Binary(left, operator, right, binary_line):
                    return expr_has_call(left) or expr_has_call(right)
                Expr.Unary(operator, operand, unary_line):
                    return expr_has_call(operand)
                Expr.Paren(inner, paren_line):
                    return expr_has_call(inner)
                Expr.Field(object, field, field_line):
                    return expr_has_call(object)
                Expr.Index(object, index, index_line):
                    return expr_has_call(object) or expr_has_call(index)
                _:
                    return true


        def stmts_have_call(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    true return if stmt_has_call(statement)
                return false


        def stmt_has_call(statement: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, line):
                        return expr_has_call(expression)
                    Stmt.VarDecl(name, type_expression, value, line):
                        return expr_has_call(value)
                    Stmt.Assign(target, operator, value, line):
                        return expr_has_call(target) or expr_has_call(value)
                    Stmt.Return(value, line):
                        if value is return_value:
                            return expr_has_call(return_value)
                        return false
                    Stmt.If(condition, then_body, else_body, line):
                        return expr_has_call(condition) or stmts_have_call(then_body) or stmts_have_call(else_body)
                    Stmt.While(condition, body, line):
                        return expr_has_call(condition) or stmts_have_call(body)
                    Stmt.For(bind, variables, iterable, body, line):
                        return expr_has_call(iterable) or stmts_have_call(body)
                    Stmt.Block(kind, clause, binding, body, line):
                        return stmts_have_call(body)
                    Stmt.Match(scrutinee, arms, line):
                        true return if expr_has_call(scrutinee)
                        for arm in arms:
                            true return if stmts_have_call(arm.body)
                        return false
                    Stmt.Contract(kind, expression, line):
                        return expr_has_call(expression)
                    Stmt.Break(label, line):
                        return false
                    Stmt.Continue(label, line):
                        return false
                    Stmt.Invalid:
                        return false
                    _:
                        return true


        # Flag each leading-prologue `decreases` in a function proven to make zero calls.
        # A `decreases` is a termination clause ONLY in the leading contract prologue (mirrors
        # check_contract_position); a mid-body `decreases` is dropped by stage0 with no warning,
        # so scanning past the prologue would false-positive. We bound the scan to the prologue.
        def flag_unused_decreases(function_name: sview, statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                prologue_length: usize = leading_contract_count(statements)
                for statement in statements |table, position: usize = 0| -> table:
                    if position < prologue_length:
                        match statement:
                            Stmt.Contract(kind, expression, line):
                                contract_kind: sview = kind
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnusedDecreases, name: function_name, line: line, expected: "", actual: ""}) if contract_kind == "decreases"
                            _:
                                pass
                    position <- position + 1


        # The measure IDENT of a leading-prologue `decreases n` clause ("" otherwise).
        def prologue_decreases_measure(statements: darray[Ast::Stmt]) -> sview:
            can Memory.Allocate, Abort.Panic:
                prologue_length: usize = leading_contract_count(statements)
                for statement in statements |position: usize = 0| -> position:
                    break if position >= prologue_length
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            ident_name_of(expression) return if contract_kind == "decreases"
                        _:
                            pass
                    position <- position + 1
                return ""

        # Whether EXPRESSION is a direct recursive call to FUNCTION_NAME passing the
        # measure ident UNCHANGED at its own position (so it can never strictly decrease).
        def recursive_call_keeps_measure(expression: Ast::Expr, function_name: sview, measure: sview, measure_position: i64) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Ident(callee_name, callee_line):
                                in_range: bool = callee_name == function_name and measure_position >= 0 and measure_position.usize() < arguments.count
                                return in_range and ident_name_of(arguments[measure_position.usize()]) == measure
                            _:
                                return false
                    _:
                        return false

        # A sound SUBSET of stage0's termination prover: a direct recursive call
        # passing the measure param UNCHANGED at its own position can never
        # strictly decrease — flag it, whether it appears in a return, a binding,
        # an assignment, or a bare expression statement. Any other shape stays silent.
        def flag_non_decreasing_calls(function_name: sview, measure: sview, measure_position: i64, statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonDecreasingMeasure, name: function_name, line: line, expected: measure, actual: ""}) if recursive_call_keeps_measure(returned, function_name, measure, measure_position)
                        Stmt.VarDecl(declared_name, type_expression, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonDecreasingMeasure, name: function_name, line: line, expected: measure, actual: ""}) if recursive_call_keeps_measure(value, function_name, measure, measure_position)
                        Stmt.Assign(target, operator, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonDecreasingMeasure, name: function_name, line: line, expected: measure, actual: ""}) if recursive_call_keeps_measure(value, function_name, measure, measure_position)
                        Stmt.Expr(expression, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonDecreasingMeasure, name: function_name, line: line, expected: measure, actual: ""}) if recursive_call_keeps_measure(expression, function_name, measure, measure_position)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- flag_non_decreasing_calls(function_name, measure, measure_position, then_body, table)
                            table <- flag_non_decreasing_calls(function_name, measure, measure_position, else_body, table)
                        Stmt.While(condition, body, line):
                            table <- flag_non_decreasing_calls(function_name, measure, measure_position, body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- flag_non_decreasing_calls(function_name, measure, measure_position, body, table)
                        _:
                            pass

        def check_unused_decreases(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- flag_unused_decreases(name, body, table) if not stmts_have_call(body)
                            measure: sview = prologue_decreases_measure(body)
                            measure_position: mutable i64 = (-1)
                            for parameter in parameters |measure_position, parameter_index: usize = 0| -> measure_position:
                                measure_position <- parameter_index.i64() if parameter.name == measure and measure_position < 0
                                parameter_index <- parameter_index + 1
                            table <- flag_non_decreasing_calls(name, measure, measure_position, body, table) if measure != "" and measure_position >= 0
                        Decl.Module(module_name, body, module_line):
                            table <- check_unused_decreases(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_unused_decreases(scoped_body, table)
                        _:
                            pass
