# Decode explicit target triples for semantic static-branch selection. Match the
# Stage0 target normalization without inheriting the host for unknown components.
extend Semantic:
    private:
        def semantic_target_has_text(triple: sview) -> bool:
            can Abort.Panic:
                for byte in triple:
                    return true if byte != 32 and byte != 9 and byte != 10 and byte != 13
                return false

        def semantic_target_contains(triple: sview, needle: sview) -> bool:
            can Abort.Panic:
                return false if needle.len > triple.len
                for start in 0..<(triple.len - needle.len + 1):
                    matches: mutable bool = true
                    for offset in 0..<needle.len |matches, triple, needle, start|:
                        byte: mutable u8 = triple[start + offset]
                        byte <- byte + 32 if byte >= 65 and byte <= 90
                        matches <- false if byte != needle[offset]
                    return true if matches
                return false

        def semantic_explicit_target_constant(name: sview, triple: sview) -> (known: bool, value: i64):
            can Abort.Panic:
                start: mutable usize = 0
                end: mutable usize = triple.len
                while start < end and (triple[start] == 32 or triple[start] == 9 or triple[start] == 10 or triple[start] == 13) |start, end, triple|:
                    start <- start + 1
                while end > start and (triple[end - 1] == 32 or triple[end - 1] == 9 or triple[end - 1] == 10 or triple[end - 1] == 13) |start, end, triple|:
                    end <- end - 1
                return (false, 0) if start == end
                normalized: sview = triple[start:end]
                macos: bool = semantic_target_contains(normalized, "darwin") or semantic_target_contains(normalized, "macos")
                linux: bool = not macos and semantic_target_contains(normalized, "linux")
                windows: bool = not macos and not linux and (semantic_target_contains(normalized, "windows") or semantic_target_contains(normalized, "win32") or semantic_target_contains(normalized, "mingw"))
                freebsd: bool = not macos and not linux and not windows and semantic_target_contains(normalized, "freebsd")
                wasm_prefix: bool = normalized.len >= 4 and (normalized[0] == 119 or normalized[0] == 87) and (normalized[1] == 97 or normalized[1] == 65) and (normalized[2] == 115 or normalized[2] == 83) and (normalized[3] == 109 or normalized[3] == 77)
                wasi: bool = not macos and not linux and not windows and not freebsd and (semantic_target_contains(normalized, "wasi") or semantic_target_contains(normalized, "emscripten") or wasm_prefix)
                x86: bool = semantic_target_contains(normalized, "x86_64") or semantic_target_contains(normalized, "amd64")
                arm: bool = not x86 and (semantic_target_contains(normalized, "aarch64") or semantic_target_contains(normalized, "arm64"))
                wasm64: bool = not x86 and not arm and semantic_target_contains(normalized, "wasm64")
                wasm32: bool = not x86 and not arm and not wasm64 and semantic_target_contains(normalized, "wasm32")
                if name == "ELISA_TARGET_OS_MACOS" or name == "PLATFORM_APPLE" or name == "PLATFORM_DARWIN":
                    return (true, 1 if macos else 0)
                if name == "ELISA_TARGET_OS_LINUX" or name == "PLATFORM_LINUX":
                    return (true, 1 if linux else 0)
                if name == "ELISA_TARGET_OS_WINDOWS" or name == "PLATFORM_WINDOWS":
                    return (true, 1 if windows else 0)
                if name == "ELISA_TARGET_OS_FREEBSD" or name == "PLATFORM_FREEBSD":
                    return (true, 1 if freebsd else 0)
                if name == "ELISA_TARGET_OS_POSIX":
                    return (true, 1 if macos or linux or freebsd or wasi else 0)
                if name == "ELISA_TARGET_OS_WASI":
                    return (true, 1 if wasi else 0)
                if name == "ELISA_TARGET_OS_WASM" or name == "ELISA_TARGET_ARCH_WASM" or name == "PLATFORM_WASM":
                    return (true, 1 if wasm32 or wasm64 else 0)
                if name == "ELISA_TARGET_ARCH_WASM32" or name == "ARCH_WASM32":
                    return (true, 1 if wasm32 else 0)
                if name == "ELISA_TARGET_ARCH_WASM64":
                    return (true, 1 if wasm64 else 0)
                if name == "ELISA_TARGET_ARCH_X86_64" or name == "ARCH_X86_64":
                    return (true, 1 if x86 else 0)
                if name == "ELISA_TARGET_ARCH_ARM64" or name == "ARCH_ARM64":
                    return (true, 1 if arm else 0)
                return (false, 0)
