# Stage1 semantic — inline grants and the ungranted-call walk (`extend Semantic:
# private:`). Decides whether a line is covered by an inline `can ...:` grant or a
# permission parameter, collects the names a body binds, and reports the calls that need
# an effect nobody granted. Continues check_ungranted_panic.elisa; split out to keep each
# part file under 600 lines.

extend Semantic:
    private:
        struct ConcreteEffectWrapperIndex:
            names: mutable darray[sview]
            lines: mutable darray[u32]
            offsets: mutable darray[u32] = []
            effect_parameter_lines: mutable darray[u32]
            effect_parameter_offsets: mutable darray[u32] = []
            permission_parameter_lines: mutable darray[u32]
            permission_parameter_offsets: mutable darray[u32] = []
            invalid_console_lines: mutable darray[u32]

        def wrapper_index_has_line(lines: darray[u32]&, line: u32) -> bool:
            return any known_line in lines where known_line == line

        def wrapper_index_has_position(lines: darray[u32]&, offsets: darray[u32]&, line: u32, offset: u32) -> bool:
            return false if lines.count != offsets.count
            for row in 0..<lines.count |lines, offsets, line, offset|:
                return true if lines[row] == line and offsets[row] == offset
            return false

        def build_concrete_effect_wrapper_index(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, index: mutable ConcreteEffectWrapperIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                function_names: mutable darray[sview] = []
                function_has_wrappers: mutable darray[bool] = []
                function_all_wrappers: mutable darray[bool] = []
                for annotation in annotations:
                    if annotation.owner == "__invalid_console" and not wrapper_index_has_line(index.invalid_console_lines, annotation.line):
                        index.invalid_console_lines.push(annotation.line)
                    if annotation.owner == "__effect_param" and annotation.offset != 4294967295 and not wrapper_index_has_position(index.effect_parameter_lines, index.effect_parameter_offsets, annotation.line, annotation.offset):
                        index.effect_parameter_lines.push(annotation.line)
                        index.effect_parameter_offsets.push(annotation.offset)
                    if annotation.owner == "__permission_param_decl" and not wrapper_index_has_position(index.permission_parameter_lines, index.permission_parameter_offsets, annotation.line, annotation.offset):
                        index.permission_parameter_lines.push(annotation.line)
                        index.permission_parameter_offsets.push(annotation.offset)
                for symbol in table.symbols |index, function_names, function_has_wrappers, function_all_wrappers|:
                    continue if symbol.kind != SymbolKind.Func
                    is_wrapper: bool = wrapper_index_has_position(index.effect_parameter_lines, index.effect_parameter_offsets, symbol.line, symbol.offset) and not wrapper_index_has_position(index.permission_parameter_lines, index.permission_parameter_offsets, symbol.line, symbol.offset)
                    if is_wrapper and not wrapper_index_has_position(index.lines, index.offsets, symbol.line, symbol.offset):
                        index.lines.push(symbol.line)
                        index.offsets.push(symbol.offset)
                    name_row: mutable usize = 0
                    while name_row < function_names.count |name_row, function_names, symbol|:
                        break if function_names[name_row] == symbol.name
                        name_row <- name_row + 1.usize()
                    if name_row == function_names.count:
                        function_names.push(symbol.name)
                        function_has_wrappers.push(is_wrapper)
                        function_all_wrappers.push(is_wrapper)
                    else:
                        function_has_wrappers[name_row] <- true if is_wrapper
                        function_all_wrappers[name_row] <- false if not is_wrapper
                for name_row in 0..<function_names.count |index, function_names, function_has_wrappers, function_all_wrappers|:
                    index.names.push(function_names[name_row]) if function_has_wrappers[name_row] and function_all_wrappers[name_row]

        def concrete_effect_wrapper_line_index(index: ConcreteEffectWrapperIndex&, line: u32, offset: u32) -> bool:
            return wrapper_index_has_position(index.lines, index.offsets, line, offset)

        def concrete_effect_wrapper_name_index(index: ConcreteEffectWrapperIndex&, name: sview) -> bool:
            return any wrapper_name in index.names where wrapper_name == name

        def concrete_invalid_console_line_index(index: ConcreteEffectWrapperIndex&, line: u32) -> bool:
            return wrapper_index_has_line(index.invalid_console_lines, line)

        # Whether `target` is one of `names` (content equality on the copied spans). Used to
        # suppress the effect-call fire when the callee is shadowed by a local/param binder.
        def names_contains(names: darray[sview], target: sview) -> bool:
            for candidate in names:
                candidate_name: sview = candidate
                return true if candidate_name == target
            return false


        # The effect owner hash remains leaf-keyed. Name-only readers fail closed when a
        # leaf belongs to multiple modules; resolved callers filter the parallel effect rows
        # by the selected module. Same-module overload aggregation remains the legacy rule.
        def effect_name_has_multiple_module_owners(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                found: mutable bool = false
                first_module: mutable sview = ""
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE |row, first_module, found, table, name|:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.name == name and symbol.kind == SymbolKind.Func:
                        if found:
                            return true if symbol.module_owner != first_module
                        first_module <- symbol.module_owner
                        found <- true
                    row <- table.symbol_name_next[row.usize()]
                return false


        # Whether the postfix grant on `line` covers a required effect reference. Preserve
        # the existing family behavior for ordinary refs; a grouped grant is member-selective.
        def line_inline_grant_covers(names: darray[sview]&, lines: darray[u32]&, line: u32, required_ref: sview) -> bool:
            can Abort.Panic:
                required_family: sview = effect_ref_family(required_ref)
                required_member: sview = effect_ref_member(required_ref)
                required_group_open: usize = effect_ref_group_open(required_ref)
                return false if required_family == ""
                while index < lines.count |index: usize = 0|:
                    if lines[index] == line and names[index] != "__inline_can":
                        grant_ref: sview = names[index]
                        grant_group_open: usize = effect_ref_group_open(grant_ref)
                        if grant_group_open > 0:
                                if effect_ref_family(grant_ref) == required_family:
                                    if required_group_open > 0:
                                        group_covers: mutable bool = true
                                        for member_index in 0..<effect_ref_group_member_count_at(required_ref, required_group_open) |member_index, required_ref, required_group_open, grant_ref, group_covers|:
                                            group_covers <- false if not effect_ref_group_has_member(grant_ref, effect_ref_group_member_at(required_ref, required_group_open, member_index))
                                        return true if group_covers
                                return true if required_member != "" and effect_ref_group_has_member(grant_ref, required_member)
                        else:
                            return true if effect_ref_family(grant_ref) == required_family
                    index <- index + 1
                return false

        # The first DECLARED effect ref of `owner` whose family is NOT covered by
        # the postfix grant on `line` ("" when every declared family is granted).
        def first_uncovered_declared_ref(table: SymbolTable&, owner: sview, module: sview, module_known: bool, names: darray[sview]&, lines: darray[u32]&, line: u32) -> sview:
            can Abort.Panic:
                return "" if effect_name_has_multiple_module_owners(table, owner) and not module_known
                while declared_index < table.function_effect_owner.count |declared_index: usize = 0|:
                    module_matches: bool = not module_known or declared_index < table.function_effect_module.count and table.function_effect_module[declared_index] == module
                    if table.function_effect_owner[declared_index] == owner and module_matches:
                        candidate: sview = table.function_effect_name[declared_index]
                        return candidate if not line_inline_grant_covers(names, lines, line, candidate)
                    declared_index <- declared_index + 1
                return ""

        def first_uncovered_extern_ref(module: sview, owner: sview, names: darray[sview]&, lines: darray[u32]&, line: u32, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                refs: darray[sview] = extern_effect_index_refs(module, owner, table)
                for candidate in refs |names, lines, line|:
                    return candidate if not line_inline_grant_covers(names, lines, line, candidate)
                return ""

        # line_has_inline_grant over rows sorted by line (check_ungranted_panic sorts them).
        def sorted_line_has_inline_grant(names: darray[sview]&, lines: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                low: mutable usize = 0
                high: mutable usize = min(lines.count, names.count)
                while low < high |low, high, lines, line|:
                    middle: usize = low + (high - low) / 2
                    if lines[middle] < line:
                        low <- middle + 1
                    else:
                        high <- middle
                while low < lines.count and low < names.count and lines[low] == line |low, lines, names, line|:
                    return true if names[low] == "__inline_can"
                    low <- low + 1
                return false

        def line_has_inline_grant(names: darray[sview]&, lines: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                while index < lines.count |index: usize = 0|:
                    return true if lines[index] == line and names[index] == "__inline_can"
                    index <- index + 1
                return false


        def effect_param_on_line(effect_parameters: darray[Ast::EnumAnnotation]&, name: sview, function_line: u32, function_offset: u32) -> bool:
            for annotation in effect_parameters:
                return true if annotation.owner == "__effect_param" and annotation.name == name and annotation.line == function_line and annotation.offset == function_offset
            return false


        def concrete_effect_wrapper_line(annotations: darray[Ast::EnumAnnotation]&, line: u32, offset: u32) -> bool:
            has_effect_parameter: mutable bool = false
            has_permission_parameter: mutable bool = false
            index: mutable usize = annotations.count
            while index > 0 |index, annotations, line, offset, has_effect_parameter, has_permission_parameter|:
                index <- index - 1.usize()
                annotation: Ast::EnumAnnotation = annotations[index]
                has_effect_parameter <- true if annotation.owner == "__effect_param" and annotation.line == line and annotation.offset == offset
                has_permission_parameter <- true if annotation.owner == "__permission_param_decl" and annotation.line == line and annotation.offset == offset
                break if has_effect_parameter and has_permission_parameter
            return has_effect_parameter and not has_permission_parameter


        def concrete_effect_wrapper_name(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            found: mutable bool = false
            all_wrappers: mutable bool = true
            for symbol in table.symbols:
                if symbol.kind == SymbolKind.Func and symbol.name == name:
                    found <- true
                    all_wrappers <- false if not concrete_effect_wrapper_line(annotations, symbol.line, symbol.offset)
            return found and all_wrappers


        def calls_concrete_effect_wrapper(expression: Ast::Expr, wrapper_index: ConcreteEffectWrapperIndex&, table: lmut SymbolTable) -> bool:
            can Memory.Allocate, Abort.Panic:
                rebind target: (name: sview @source, qualifier: sview @source), table = extern_call_target(expression, table)
                callee_name: sview = target.name
                return callee_name != "" and concrete_effect_wrapper_name_index(wrapper_index, callee_name)


        def unknown_permission_member_diagnostics(annotations: darray[Ast::EnumAnnotation]&) -> darray[Diagnostic]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[Diagnostic] = []
                for annotation in annotations |result|:
                    result.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: "Console", pos: annotation.pos, line: annotation.line, expected: "", actual: annotation.name}) if annotation.owner == "__invalid_console"
                    result.push(Diagnostic{kind: DiagnosticKind.PermissionParamMemberAccess, name: annotation.name, line: annotation.line, expected: "", actual: ""}) if annotation.owner == "__permission_param_member"
                return result


        # Collect every name a pattern binds (recursively), pushing into `names` in place.
        def pattern_bound_names(pattern: Ast::Pattern, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        names.push(name)
                    Pattern.TypeBind(type_name, binder):
                        names.push(binder)
                    Pattern.As(name, inner):
                        names.push(name)
                        for sub in inner:
                            pattern_bound_names(sub, names)
                    Pattern.Variant(path, fields):
                        for sub in fields:
                            pattern_bound_names(sub, names)
                    Pattern.Struct(path, fields):
                        for sub in fields:
                            pattern_bound_names(sub, names)
                    Pattern.Field(selector, inner):
                        for sub in inner:
                            pattern_bound_names(sub, names)
                    Pattern.Tuple(elements):
                        for sub in elements:
                            pattern_bound_names(sub, names)
                    Pattern.Or(options):
                        for sub in options:
                            pattern_bound_names(sub, names)
                    _:
                        pass


        # Collect every name bound anywhere in a statement list (params handled by the caller):
        # local var-decls, for-loop variables, block bindings, and match-arm pattern bindings.
        # Over-collection is sound here — it only ever SUPPRESSES the effect-call fire, so a name
        # bound in any scope of the function shadows the top-level callee for the whole function.
        def collect_bound_names(statements: darray[Ast::Stmt], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            names.push(name)
                        Stmt.For(bind, variables, iterable, body, line):
                            names.extend(variables)
                            collect_bound_names(body, names)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_bound_names(then_body, names)
                            collect_bound_names(else_body, names)
                        Stmt.While(condition, body, line):
                            collect_bound_names(body, names)
                        Stmt.Block(kind, clause, binding, body, line):
                            names.push(binding)
                            collect_bound_names(body, names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                pattern_bound_names(arm.pattern, names)
                                collect_bound_names(arm.body, names)
                        _:
                            pass


        # Walk a statement list tracking whether a conservative enclosing grant is active.
        # Concrete effect-bearing callback parameters are the precision exception: invoking
        # one (or a wrapper carrying one) still requires a local grant, while permission-row
        # polymorphic callbacks retain Stage0's generic-context suppression.
        def check_ungranted_call_expression(expression: Ast::Expr, line: u32, function_line: u32, function_offset: u32, caller_module: sview @source, effect_parameters: darray[Ast::EnumAnnotation]&, bound_names: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                rebind target: (name: sview @source, qualifier: sview @source), table = extern_call_target(expression, table)
                callee_name: sview = target.name
                return if target.qualifier == "" and names_contains(bound_names, callee_name)
                call_position: Ast::Pos = called_function_position(expression, line)
                call_line: u32 = call_position.line if call_position.line != 0 else line
                selected_extern: mutable bool = false
                selected_function: mutable bool = false
                selected_function_module: mutable sview @source = ""
                required_effects: mutable darray[sview] = []
                requester: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__call_site", name: "", module: caller_module, line: call_position.line, offset: call_position.offset, pos: call_position}
                if target.qualifier != "":
                    rebind resolved: (resolved: bool, module: sview @source), table = extern_qualified_module(target.qualifier, caller_module, requester, table)
                    return if not resolved.resolved
                    if extern_effect_index_has_declaration(resolved.module, callee_name, table):
                        return if not extern_module_owner_is_extern_only(resolved.module, callee_name, table)
                        selected_extern <- true
                        required_effects <- extern_effect_index_refs(resolved.module, callee_name, table)
                    else:
                        return if not extern_regular_function_owner_is_unique(resolved.module, callee_name, table)
                        selected_function <- true
                        selected_function_module <- resolved.module
                        required_effects <- function_effect_refs(table, callee_name, resolved.module, true)
                else:
                    selected_module: (resolved: bool, module: sview) = extern_bare_module_for_call(callee_name, caller_module, requester, table)
                    return if not selected_module.resolved
                    if extern_effect_index_has_declaration(selected_module.module, callee_name, table):
                        return if not extern_module_owner_is_extern_only(selected_module.module, callee_name, table)
                        selected_extern <- true
                        required_effects <- extern_effect_index_refs(selected_module.module, callee_name, table)
                    else:
                        return if not extern_regular_function_owner_is_unique(selected_module.module, callee_name, table)
                        selected_function <- true
                        selected_function_module <- selected_module.module
                        required_effects <- function_effect_refs(table, callee_name, selected_module.module, true)
                first_effect: sview = required_effects[0] if required_effects.count > 0 else (function_first_effect_ref(table, callee_name, selected_function_module, true) if selected_function else "")
                first_family: sview = effect_ref_family(first_effect)
                effect_count: u32 = required_effects.count.u32() if required_effects.count < 8.usize() else 8
                effect_ref_1: sview = required_effects[0] if required_effects.count > 0 else ""
                effect_ref_2: sview = required_effects[1] if required_effects.count > 1 else ""
                effect_ref_3: sview = required_effects[2] if required_effects.count > 2 else ""
                effect_ref_4: sview = required_effects[3] if required_effects.count > 3 else ""
                effect_ref_5: sview = required_effects[4] if required_effects.count > 4 else ""
                effect_ref_6: sview = required_effects[5] if required_effects.count > 5 else ""
                effect_ref_7: sview = required_effects[6] if required_effects.count > 6 else ""
                effect_ref_8: sview = required_effects[7] if required_effects.count > 7 else ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedPanic, name: "", line: call_line, pos: call_position, expected: "", actual: ""}) if callee_name == "panic"
                return if callee_name == "panic" or callee_name == ""
                is_effect_parameter_call: bool = target.qualifier == "" and effect_param_on_line(effect_parameters, callee_name, function_line, function_offset)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: callee_name, line: call_line, pos: call_position, expected: first_effect, actual: first_family, effect_ref_count: effect_count, effect_ref_1: effect_ref_1, effect_ref_2: effect_ref_2, effect_ref_3: effect_ref_3, effect_ref_4: effect_ref_4, effect_ref_5: effect_ref_5, effect_ref_6: effect_ref_6, effect_ref_7: effect_ref_7, effect_ref_8: effect_ref_8}) if is_effect_parameter_call
                return if is_effect_parameter_call
                has_effect_call: bool = selected_extern and required_effects.count > 0 or selected_function and function_has_effect(table, callee_name, selected_function_module, true)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: callee_name, line: call_line, pos: call_position, expected: first_effect, actual: first_family, effect_ref_count: effect_count, effect_ref_1: effect_ref_1, effect_ref_2: effect_ref_2, effect_ref_3: effect_ref_3, effect_ref_4: effect_ref_4, effect_ref_5: effect_ref_5, effect_ref_6: effect_ref_6, effect_ref_7: effect_ref_7, effect_ref_8: effect_ref_8}) if has_effect_call


        # Recurse through compound expression shapes so a call NESTED in an
        # operand (`1 + emit(2)`) is checked like a top-level one. Unhandled
        # shapes stay un-walked (sound miss, never a false fire).
        def check_ungranted_expression_deep(expression: Ast::Expr, line: u32, function_line: u32, function_offset: u32, caller_module: sview @source, effect_parameters: darray[Ast::EnumAnnotation]&, bound_names: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- check_ungranted_call_expression(expression, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                        # The CALLEE is an expression too. A method chain on an effectful call
                        # -- `return leak_block().count.i64()` -- is Call(Field(Field(Call(leak_block)…)))
                        # and only the arguments were walked, so the inner call was never
                        # visited and stage0's warning (`call to "leak_block" requires can[Abort,
                        # Memory] and has no explicit local effect grant; …`) never fired.
                        table <- check_ungranted_expression_deep(callee, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                        for argument in arguments |table| -> table:
                            table <- check_ungranted_expression_deep(argument, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                    Expr.Field(object, field, field_line):
                        table <- check_ungranted_expression_deep(object, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- check_ungranted_expression_deep(left, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                        table <- check_ungranted_expression_deep(right, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- check_ungranted_expression_deep(operand, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- check_ungranted_expression_deep(inner, line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                    _:
                        pass


        def check_ungranted_panic_statements(statements: darray[Ast::Stmt], allocation_names: darray[sview]&, allocation_lines: darray[u32]&, annotations: darray[Ast::EnumAnnotation]&, effect_parameters: darray[Ast::EnumAnnotation]&, wrapper_index: ConcreteEffectWrapperIndex&, function_line: u32, function_offset: u32, caller_module: sview @source, in_grant: bool, strict_unsafe: bool, bound_names: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            if not in_grant and not sorted_line_has_inline_grant(allocation_names, allocation_lines, line.line):
                                table <- check_ungranted_expression_deep(expression, line.line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                            # A postfix grant that OMITS a required family still leaves
                            # the call ungranted for that family (stage0 parity).
                            if not in_grant and sorted_line_has_inline_grant(allocation_names, allocation_lines, line.line):
                                rebind grant_target: (name: sview @source, qualifier: sview @source), table = extern_call_target(expression, table)
                                grant_callee: sview = grant_target.name
                                continue if grant_target.qualifier == "" and names_contains(bound_names, grant_callee)
                                # A grant naming an UNKNOWN permission member (`can
                                # Console.Read`) does not cover anything (stage0 still
                                # warns with the callee's declared ref as the suggestion).
                                invalid_member_grant: bool = concrete_invalid_console_line_index(wrapper_index, line.line)
                                selected_extern: mutable bool = false
                                selected_regular: mutable bool = false
                                selected_regular_module: mutable sview = ""
                                uncovered_ref: mutable sview = ""
                                call_position: Ast::Pos = called_function_position(expression, line.line)
                                requester: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__call_site", name: "", module: caller_module, line: call_position.line, offset: call_position.offset, pos: call_position}
                                if grant_target.qualifier != "":
                                    rebind resolved: (resolved: bool, module: sview @source), table = extern_qualified_module(grant_target.qualifier, caller_module, requester, table)
                                    if resolved.resolved and extern_effect_index_has_declaration(resolved.module, grant_callee, table):
                                        continue if not extern_module_owner_is_extern_only(resolved.module, grant_callee, table)
                                        selected_extern <- true
                                        uncovered_ref <- first_uncovered_extern_ref(resolved.module, grant_callee, allocation_names, allocation_lines, line.line, table)
                                        scoped_refs: darray[sview] = extern_effect_index_refs(resolved.module, grant_callee, table)
                                        uncovered_ref <- scoped_refs[0] if invalid_member_grant and scoped_refs.count > 0
                                    elif resolved.resolved and extern_regular_function_owner_is_unique(resolved.module, grant_callee, table):
                                        selected_regular <- true
                                        selected_regular_module <- resolved.module
                                else:
                                    selected_module: (resolved: bool, module: sview) = extern_bare_module_for_call(grant_callee, caller_module, requester, table)
                                    if selected_module.resolved and extern_effect_index_has_declaration(selected_module.module, grant_callee, table):
                                        continue if not extern_module_owner_is_extern_only(selected_module.module, grant_callee, table)
                                        selected_extern <- true
                                        uncovered_ref <- first_uncovered_extern_ref(selected_module.module, grant_callee, allocation_names, allocation_lines, line.line, table)
                                        scoped_refs: darray[sview] = extern_effect_index_refs(selected_module.module, grant_callee, table)
                                        uncovered_ref <- scoped_refs[0] if invalid_member_grant and scoped_refs.count > 0
                                    elif selected_module.resolved and extern_regular_function_owner_is_unique(selected_module.module, grant_callee, table):
                                        selected_regular <- true
                                        selected_regular_module <- selected_module.module
                                if selected_regular:
                                    uncovered_ref <- first_uncovered_declared_ref(table, grant_callee, selected_regular_module, true, allocation_names, allocation_lines, line.line)
                                    uncovered_ref <- function_first_declared_effect_ref(table, grant_callee, selected_regular_module, true) if invalid_member_grant
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: grant_callee, line: line.line, expected: uncovered_ref, actual: effect_ref_family(uncovered_ref)}) if uncovered_ref != "" and (strict_unsafe or effect_ref_family(uncovered_ref) != "Unsafe")
                        Stmt.Block(kind, clause, binding, body, line):
                            block_grant: bool = in_grant or kind == "can" or kind == "trusted"
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, annotations, effect_parameters, wrapper_index, function_line, function_offset, caller_module, block_grant, strict_unsafe, bound_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            # Postfix `return ... if f()` lowers to an If too. Its condition
                            # evaluates before either branch and needs the same local grant.
                            if not in_grant and not sorted_line_has_inline_grant(allocation_names, allocation_lines, line.line):
                                table <- check_ungranted_expression_deep(condition, line.line, function_line, function_offset, caller_module, effect_parameters, bound_names, table)
                            table <- check_ungranted_panic_statements(then_body, allocation_names, allocation_lines, annotations, effect_parameters, wrapper_index, function_line, function_offset, caller_module, in_grant, strict_unsafe, bound_names, table)
                            table <- check_ungranted_panic_statements(else_body, allocation_names, allocation_lines, annotations, effect_parameters, wrapper_index, function_line, function_offset, caller_module, in_grant, strict_unsafe, bound_names, table)
                        Stmt.While(condition, body, line):
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, annotations, effect_parameters, wrapper_index, function_line, function_offset, caller_module, in_grant, strict_unsafe, bound_names, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, annotations, effect_parameters, wrapper_index, function_line, function_offset, caller_module, in_grant, strict_unsafe, bound_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_ungranted_panic_statements(arm.body, allocation_names, allocation_lines, annotations, effect_parameters, wrapper_index, function_line, function_offset, caller_module, in_grant, strict_unsafe, bound_names, table)
                        Stmt.Return(value, line):
                            if value is return_expression:
                                concrete_wrapper_call: mutable bool = false
                                rebind concrete_wrapper_call, table = calls_concrete_effect_wrapper(return_expression, wrapper_index, table)
                                needs_local_grant: bool = not in_grant or concrete_wrapper_call
                                table <- check_ungranted_expression_deep(return_expression, line.line, function_line, function_offset, caller_module, effect_parameters, bound_names, table) if needs_local_grant and not sorted_line_has_inline_grant(allocation_names, allocation_lines, line.line)
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass
