# A `(sparse)` enum layout stores variant payloads in per-variant columns, which only the SoA
# backing supports — so `layout(aos, sparse)` (or any `sparse` without `soa`) is rejected. The
# parser records `__layout_sparse` and `__layout_soa` markers per enum; fire for an enum that has
# the sparse marker but not the soa marker.
extend Semantic:
    private:
        def sparse_enum_has_soa(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__layout_soa" and annotation.owner == name

    public:
        def check_sparse_requires_soa(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.name == "__layout_sparse" and annotation.owner != "" and not sparse_enum_has_soa(file.enum_annotations, annotation.owner):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SparseRequiresSoa, name: annotation.owner, line: annotation.line, expected: "", actual: ""})
