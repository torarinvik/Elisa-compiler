extend Semantic:
    private:
        # The root of the container addressed by `&place` when PLACE is an index into it:
        # `&xs[i]` -> "xs", `&bag.items[i]` -> "bag" (stage0 keys the latter on "bag.items"
        # and matches a mutation of "bag"; keying on the root is the conservative superset).
        # Parentheses and `move` are transparent here, matching stage0's optimization-paren
        # stripping before it classifies an interior borrow.
        def interior_reference_place(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Paren(inner, line):
                    return interior_reference_place(inner)
                Expr.Move(inner, line):
                    return interior_reference_place(inner)
                Expr.Index(object, index, index_line):
                    return storage_view_place_root(object)
                _:
                    pass
            return ""

        def interior_reference_source(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Unary(operator, operand, line):
                    return interior_reference_place(operand) if operator == TokenKind.Ampersand else ""
                Expr.Paren(inner, line):
                    return interior_reference_source(inner)
                Expr.Move(inner, line):
                    return interior_reference_source(inner)
                _:
                    pass
            return ""

        def storage_view_place_root(expression: Ast::Expr) -> sview:
            current: mutable Ast::Expr = expression
            while true:
                match current:
                    Expr.Ident(name, line): return name
                    Expr.Field(object, field, line):
                        current <- object
                    Expr.Index(object, index, line):
                        current <- object
                    Expr.IndexN(object, indices, line):
                        current <- object
                    Expr.Slice(object, start, end, line):
                        current <- object
                    Expr.Paren(inner, line) | Expr.Move(inner, line) | Expr.Unary(TokenKind.Ampersand, inner, line):
                        current <- inner
                    _:
                        return ""
            return ""

        def storage_view_root_is_param(root: sview, alias_names: darray[sview]&, alias_sources: darray[sview]&) -> bool:
            can Abort.Panic:
                for index in 0..<alias_names.count |root, alias_names, alias_sources|:
                    return true if alias_names[index] == "[param]" and index < alias_sources.count and alias_sources[index] == root
                return false

        def storage_view_push_source(source: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.push(source) if source != "" and source != "[held]" and not any existing in out where existing == source

        def storage_view_append_value_sources(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line) | Expr.Field(_, _, line) | Expr.Index(_, _, line) | Expr.IndexN(_, _, line) | Expr.Slice(_, _, _, line) | Expr.Paren(_, line) | Expr.Move(_, line) | Expr.Unary(_, _, line):
                        storage_view_sources_from_argument(expression, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    # A tuple literal holding a view keeps that view's backing alive under the
                    # tuple's name: `t = (1, buf[0:1])` then `buf <- [..]` leaves `t.f`
                    # dangling (fuzz F5), exactly as a struct field does. (An ARRAY literal
                    # copies its elements into a fresh buffer, so it is not included.)
                    Expr.Tuple(elements, line):
                        for element in elements |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(element, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.RecordUpdate(base, fields, line):
                        storage_view_append_value_sources(base, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        # A value-returning helper can preserve an input container's backing.
                        # Until a verified return-alias summary exists, every place argument is
                        # a possible source; this only adds conservative invalidations.
                        for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_sources_from_argument(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_append_value_sources(then_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                        storage_view_append_value_sources(else_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    _:
                        storage_view_collect_sources(expression, alias_names, alias_sources, alias_is_view, view_fns, out)

        # A view-producing call inherits dependencies from its source arguments. An argument
        # already recorded as a view alias contributes its original backing containers.
        def storage_view_sources_from_argument(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        found_alias: mutable bool = false
                        for alias_index in 0..<alias_names.count |found_alias, alias_names, alias_sources, name, out|:
                            if alias_names[alias_index] == name and alias_index < alias_sources.count:
                                storage_view_push_source(alias_sources[alias_index], out)
                                found_alias <- true
                        storage_view_push_source(name, out) if not found_alias
                    Expr.Unary(operator, operand, line):
                        borrowed_place: sview = storage_view_place_root(operand) if operator == TokenKind.Ampersand else ""
                        storage_view_push_source(borrowed_place, out) if borrowed_place != ""
                        storage_view_collect_sources(operand, alias_names, alias_sources, alias_is_view, view_fns, out) if borrowed_place == ""
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                        root: sview = storage_view_place_root(expression)
                        storage_view_push_source(root, out) if root != ""
                        storage_view_collect_sources(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        storage_view_sources_from_argument(inner, alias_names, alias_sources, alias_is_view, view_fns, out)
                    _:
                        storage_view_collect_sources(expression, alias_names, alias_sources, alias_is_view, view_fns, out)

        def storage_view_existing_alias_is_view(name: sview, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&) -> bool:
            found: mutable bool = false
            # A "[held]"-marked row (a view stored INTO the container) does not make the
            # container itself a view.
            for index in 0..<alias_names.count |found, alias_names, alias_sources, alias_is_view, name|:
                held_row: bool = index > 0 and alias_names[index - 1] == name and index - 1 < alias_sources.count and alias_sources[index - 1] == "[held]"
                found <- true if alias_names[index] == name and index < alias_is_view.count and alias_is_view[index] and not held_row
            return found

        def storage_view_expr_carries_borrow(expression: Ast::Expr, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                pending: mutable darray[Ast::Expr] = [expression]
                carries_borrow: mutable bool = false
                while index < pending.count and not carries_borrow |index: usize = 0, pending, carries_borrow, alias_names, alias_sources, alias_is_view|:
                    current: Ast::Expr = pending[index]
                    index <- index + 1
                    match current:
                        Expr.Ident(name, line):
                            carries_borrow <- storage_view_existing_alias_is_view(name, alias_names, alias_sources, alias_is_view)
                        Expr.Unary(operator, operand, line):
                            carries_borrow <- true if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                            pending.push(operand) if not carries_borrow
                        Expr.Paren(inner, line) | Expr.Move(inner, line):
                            pending.push(inner)
                        Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                            pending.push(object)
                        Expr.Call(callee, arguments, argument_names, line):
                            called: sview = ident_name_of(callee)
                            returns_view: mutable bool = called in {"bytes_view", "bytes_view_range", "bytes_view_range_ref", "sview", "string_view_slice", "string_view_prefix", "string_view_suffix", "darray_view", "arena_da_view", "readonly", "arena_da_view_slice", "arena_da_view_prefix", "arena_da_view_suffix", "slice", "read_view", "split"}
                            match callee:
                                Expr.Field(receiver, method, field_line):
                                    returns_view <- true if method == "view" or method == "as_sview" or method == "as_cstr"
                                _:
                                    pass
                            carries_borrow <- returns_view
                            if not carries_borrow:
                                for argument in arguments |pending|:
                                    pending.push(argument)
                        Expr.Binary(left, operator, right, line):
                            pending.push(left)
                            pending.push(right)
                        Expr.If(condition, then_value, else_value, line):
                            pending.push(then_value)
                            pending.push(else_value)
                        Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                            for element in elements |pending|:
                                pending.push(element)
                        Expr.DictLit(entries, line):
                            for entry in entries |pending|:
                                pending.push(entry.key)
                                pending.push(entry.value)
                        Expr.Comprehension(variable, iterable, condition, body, line):
                            pending.push(body)
                        Expr.Construct(type_expression, fields, line):
                            for field in fields |pending|:
                                pending.push(field.value)
                        Expr.RecordUpdate(base, fields, line):
                            pending.push(base)
                            for field in fields |pending|:
                                pending.push(field.value)
                        _:
                            pass
                return carries_borrow

        def storage_view_record_alias(name: sview, value: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                sources: mutable darray[sview] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                is_view_alias: bool = storage_view_existing_alias_is_view(name, alias_names, alias_sources, alias_is_view) or sources.count > 0
                # Rebinding a known view/container alias to a plain place keeps that owner's
                # dependency too. Retain old rows conservatively for uncertain control flow.
                if sources.count == 0 and any existing in alias_names where existing == name:
                    storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                origin_value: Ast::Expr = storage_view_call_field_value(value, view_fns)
                for source in sources |alias_names, alias_sources, alias_is_view, name, value, origin_value|:
                    storage_view_push_origin_rows(origin_value, name, source, is_view_alias, alias_names, alias_sources, alias_is_view)

        def storage_view_type_is_darray(type_expression: Ast::Expr) -> bool:
            current: mutable Ast::Expr = type_expression
            while true:
                match current:
                    Expr.Unary(TokenKind.Mutable, operand, line) | Expr.Paren(operand, line):
                        current <- operand
                    Expr.Index(head, argument, line) | Expr.IndexN(head, arguments, line):
                        return ident_name_of(head) == "darray"
                    _:
                        return false
            return false

        def storage_view_type_is_reference(type_expression: Ast::Expr) -> bool:
            return match type_expression:
                Expr.Unary(operator, operand, line):
                    operator == TokenKind.Ampersand or operator == TokenKind.Lmut or storage_view_type_is_reference(operand)
                Expr.Paren(inner, line):
                    storage_view_type_is_reference(inner)
                _:
                    false

        # `t: i64 = r` copies the referent out of a view: the scalar local owns its value and
        # survives any later growth or replacement of the view's container (stage0:
        # storageViewScalarBindingType). `uintptr` is excluded: it may carry an address.
        def storage_view_type_is_scalar_copy(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                name: sview = ident_name_of(type_expression)
                return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "isize" or name == "usize" or name == "f32" or name == "f64" or name == "bool" or name == "char"

        def storage_view_record_typed_alias(name: sview, type_expression: Ast::Expr, value: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                if storage_view_element_is_replaceable(type_expression):
                    alias_names.push(name)
                    alias_sources.push("[]")
                    alias_is_view.push(false)
                # A fresh borrow-free result (`args: darray[ValueType] = infer(scope)`) owns its
                # storage: it neither views nor shares the arguments' buffers.
                return if storage_view_owned_call(value, view_fns)
                sources: mutable darray[sview] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                # Only copied darrays need a value-alias row for relocation invalidation.
                # Inferring that arbitrary user structs carry borrowed storage without
                # field-layout/return-alias summaries makes ordinary parser state look like
                # view provenance and rejects valid Stage1 source. View-typed locals already
                # get their explicit source dependencies from collect_sources above.
                if storage_view_type_is_darray(type_expression) and sources.count == 0:
                    storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                # A container reference `r: darray[T]& = &b.items` names b's buffer without being a
                # view itself: record it as a non-view alias of the place (and of itself, so growth
                # through `r` still reaches views of it) for interior refs `&r[i]` to inherit.
                if sources.count == 0 and storage_view_type_is_reference(type_expression):
                    container_place: sview = storage_view_whole_borrow_root(value)
                    if container_place != "":
                        alias_names.push(name)
                        alias_sources.push(container_place)
                        alias_is_view.push(false)
                        alias_names.push(name)
                        alias_sources.push(name)
                        alias_is_view.push(false)
                        return
                captures_storage: bool = value is Expr.Lambda(_, _, _) and sources.count > 0
                # An enum value whose payload holds a view carries that view's borrow.
                payload_view: bool = storage_view_is_enum_construct(value) and sources.count > 0
                # A summarised helper returning an enum whose payload holds a view
                # (`t: Tok = wrap(buf)`) carries its arguments' borrow (stage0
                # storageViewDependencyForUserCall on an EnumType that carries borrowed storage).
                summarised_call: bool = sources.count > 0 and storage_view_is_summarised_call(value, view_fns)
                # A tuple / struct LITERAL with a field initialised straight from a view
                # (`(1, buf[0:1])`, `S{f: s.as_sview()}`) holds that view: replacing or growing
                # `buf` leaves `t.f` dangling (fuzz F5; stage0 tracks it). Only a literal whose
                # field IS a view-producing expression counts -- no layout guessing for other
                # struct values, which the comment above warns about.
                literal_view: bool = storage_view_literal_holds_view(value)
                storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources) if literal_view and sources.count == 0
                origin_value: Ast::Expr = storage_view_call_field_value(value, view_fns)
                for source in sources |alias_names, alias_sources, alias_is_view, name, value, origin_value, summarised_call, literal_view|:
                    row_is_view: bool = return_type_is_view(type_expression) or storage_view_type_is_reference(type_expression) or captures_storage or payload_view or summarised_call or literal_view or (storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view) and not storage_view_type_is_scalar_copy(type_expression))
                    storage_view_push_origin_rows(origin_value, name, source, row_is_view, alias_names, alias_sources, alias_is_view)

        def storage_view_invalidate_rebound_views(root: sview, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if root == ""
                for index in 0..<alias_sources.count |root, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by|:
                    source: sview = alias_sources[index]
                    under_root: bool = source == root or (sview_starts_with(source, root) and sview_len(source) > sview_len(root) and (source[sview_len(root)] == 46.u8() or source[sview_len(root)] == 91.u8()))
                    if under_root and index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and alias_names[index] != root and not fresh_wrapper_name_exists(invalidated, alias_names[index]):
                        invalidated.push(alias_names[index])
                        invalidated_by.push("") if invalidated.count > invalidated_by.count

        def storage_view_literal_holds_view(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_literal_holds_view(inner)
                    Expr.Tuple(elements, _):
                        return any element in elements where storage_view_is_direct_view(element)
                    Expr.Construct(_, fields, _):
                        return any field in fields where storage_view_is_direct_view(field.value)
                    _:
                        return false

        def storage_view_is_direct_view(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_is_direct_view(inner)
                    Expr.Slice(_, _, _, _):
                        return true
                    Expr.Unary(TokenKind.Ampersand, operand, _):
                        return operand is Expr.Index(_, _, _)
                    Expr.Call(Expr.Field(_, method, _), _, _, _):
                        return method in {"as_sview", "as_view", "as_slice", "as_cstr"}
                    _:
                        return false

        def storage_view_is_summarised_call(value: Ast::Expr, view_fns: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_is_summarised_call(inner, view_fns)
                    Expr.Call(Expr.Ident(called, _), arguments, _, _):
                        return vro_status(view_fns, called, arguments.count) == 1
                    _:
                        return false

        def storage_view_is_enum_construct(value: Ast::Expr) -> bool:
            match value:
                Expr.Paren(inner, line):
                    return storage_view_is_enum_construct(inner)
                Expr.Call(callee, arguments, argument_names, line):
                    return enum_variant_callee(callee)
                _:
                    return false

        # `vs.push(s)`, `vs.extend([s])`, `keep(&vs, s)`: a container that receives a view (or a
        # closure/aggregate carrying one) depends on that view's sources. stage1 grows darrays by
        # realloc (no reserve_commit stable base), so a later growth of the source leaves the
        # stored view stale: record the container as a view alias of those sources.
        def storage_view_record_container_store(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        sources: mutable darray[sview] = []
                        for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, sources|:
                            # Only a stored VIEW (or a closure capturing one) keeps its source's
                            # storage reachable through the holder; owned values are copied.
                            stores_view: bool = storage_view_stored_value_holds_view(argument, alias_names, alias_sources, alias_is_view)
                            if stores_view and storage_view_whole_borrow_root(argument) == "":
                                storage_view_collect_sources(argument, alias_names, alias_sources, alias_is_view, view_fns, sources)
                        return if sources.count == 0
                        holders: mutable darray[sview] = []
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                if method == "push" or method == "extend" or method == "insert" or method == "append" or method == "push_back" or method == "add" or method == "put" or method == "set":
                                    holders.push(storage_view_place_root(receiver))
                            _:
                                pass
                        for argument in arguments |holders|:
                            holders.push(storage_view_whole_borrow_root(argument))
                        for holder in holders |sources, alias_names, alias_sources, alias_is_view|:
                            if holder != "":
                                for source in sources |alias_names, alias_sources, alias_is_view, holder|:
                                    if source != holder:
                                        # The "[held]" marker row tells growth of the HOLDER not to
                                        # treat this row as a borrow the holder itself relocates.
                                        alias_names.push(holder)
                                        alias_sources.push("[held]")
                                        alias_is_view.push(false)
                                        alias_names.push(holder)
                                        alias_sources.push(source)
                                        alias_is_view.push(true)
                    Expr.Paren(inner, line):
                        storage_view_record_container_store(inner, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        def storage_view_push_held(holder: sview, source: sview, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if holder == "" or source == "" or source == holder or source == "[held]"
                alias_names.push(holder)
                alias_sources.push("[held]")
                alias_is_view.push(false)
                alias_names.push(holder)
                alias_sources.push(source)
                alias_is_view.push(true)

        # `h.s <- buf.as_sview()`, `vs[0] <- view`: a view stored into a field or element makes
        # the holder's root carry it, exactly like `vs.push(view)` (stage0 recordStorageViewPlaceStore).
        def storage_view_record_place_store(target: Ast::Expr, value: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                holder: sview = storage_view_place_root(target)
                return if holder == ""
                return if not storage_view_stored_value_holds_view(value, alias_names, alias_sources, alias_is_view) or storage_view_whole_borrow_root(value) != ""
                sources: mutable darray[sview] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                for source in sources |holder, alias_names, alias_sources, alias_is_view|:
                    storage_view_push_held(holder, source, alias_names, alias_sources, alias_is_view)

        # `ws: darray[sview] = vs`, `g: Holder = h`, `ws <- move vs`: a by-value copy of a holder
        # copies the views stored in it, so the copy inherits the holder's "[held]" rows.
        def storage_view_inherit_held(name: sview, value: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        storage_view_inherit_held(name, inner, alias_names, alias_sources, alias_is_view)
                    Expr.Ident(source_name, _):
                        return if source_name == name or name == ""
                        held: mutable darray[sview] = []
                        for alias_index in 1..<alias_names.count |held, alias_names, alias_sources, source_name|:
                            held.push(alias_sources[alias_index]) if alias_index < alias_sources.count and alias_names[alias_index] == source_name and alias_names[alias_index - 1] == source_name and alias_sources[alias_index - 1] == "[held]"
                        for source in held |name, alias_names, alias_sources, alias_is_view|:
                            storage_view_push_held(name, source, alias_names, alias_sources, alias_is_view)
                    _:
                        pass

        # A stored value holds a view: a borrow-carrying expression, a closure, or an
        # aggregate (struct/tuple/array literal) with such a part.
        def storage_view_stored_value_holds_view(value: Ast::Expr, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Lambda(_, _, _):
                        return true
                    Expr.Construct(_, fields, _):
                        return any field in fields where storage_view_stored_value_holds_view(field.value, alias_names, alias_sources, alias_is_view)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        return any element in elements where storage_view_stored_value_holds_view(element, alias_names, alias_sources, alias_is_view)
                    _:
                        return storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view)

        # The root of `&place` when PLACE is a whole container (`&b.items`, `&buf`), not an element.
        def storage_view_whole_borrow_root(value: Ast::Expr) -> sview:
            match value:
                Expr.Paren(inner, line):
                    return storage_view_whole_borrow_root(inner)
                Expr.Unary(operator, operand, line):
                    return "" if operator != TokenKind.Ampersand or interior_reference_place(operand) != ""
                    return match operand:
                        Expr.Ident(_, _) | Expr.Field(_, _, _):
                            storage_view_place_root(operand)
                        _:
                            ""
                _:
                    return ""

        def storage_view_collect_statement(statement: Ast::Stmt, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        storage_view_record_typed_alias(name, type_expression, value, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Assign(target, operator, value, line):
                        # Nested bodies record only `=`: stage0 does not track a `<-` rebind made
                        # inside a loop/branch body (the top-level walk does).
                        storage_view_record_alias(storage_view_place_root(target), value, alias_names, alias_sources, alias_is_view, view_fns) if operator == TokenKind.Assign
                    Stmt.If(condition, then_body, else_body, line):
                        for nested in then_body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                        for nested in else_body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.While(condition, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.For(bind, variables, iterable, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Match(scrutinee, arms, line):
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns|:
                            for nested in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        # A lambda's storage dependencies are its lexically resolved free variables,
        # not every identifier spelling in its body. Declarations are visited in source
        # order and nested scopes restore their binders so same-named lambda parameters,
        # locals, loop variables, and pattern bindings cannot be mistaken for outer views.
        def storage_view_lambda_capture_name(name: sview, bound_names: mutable darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or any bound_name in bound_names where bound_name == name
                had_source: mutable bool = false
                for alias_index in 0..<alias_names.count |alias_names, alias_sources, name, out, had_source|:
                    if alias_names[alias_index] == name and alias_index < alias_sources.count:
                        storage_view_push_source(alias_sources[alias_index], out)
                        had_source <- true
                # A closure may capture a container owner directly and build a view only
                # when invoked. Preserve that owner as a relocation dependency too.
                storage_view_push_source(name, out) if not had_source

        def storage_view_lambda_capture_unknown_pattern(alias_names: darray[sview]&, alias_sources: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for alias_index in 0..<alias_names.count |alias_names, alias_sources, out|:
                    storage_view_push_source(alias_names[alias_index], out)
                    storage_view_push_source(alias_sources[alias_index], out) if alias_index < alias_sources.count

        def storage_view_lambda_bind_pattern_expression(expression: Ast::Expr, bound_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        bound_names.push(name) if name != ""
                    Expr.Call(callee, arguments, argument_names, line):
                        storage_view_lambda_bind_pattern_expression(callee, bound_names)
                        for argument in arguments |bound_names|:
                            storage_view_lambda_bind_pattern_expression(argument, bound_names)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        storage_view_lambda_bind_pattern_expression(object, bound_names)
                    Expr.Paren(inner, line) | Expr.Unary(_, inner, line) | Expr.Move(inner, line):
                        storage_view_lambda_bind_pattern_expression(inner, bound_names)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line):
                        for element in elements |bound_names|:
                            storage_view_lambda_bind_pattern_expression(element, bound_names)
                    Expr.Binary(left, operator, right, line):
                        storage_view_lambda_bind_pattern_expression(left, bound_names)
                        storage_view_lambda_bind_pattern_expression(right, bound_names)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |bound_names|:
                            storage_view_lambda_bind_pattern_expression(field.value, bound_names)
                    _:
                        pass

        def storage_view_lambda_bind_condition(condition: Ast::Expr, bound_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        storage_view_lambda_bind_condition(left, bound_names)
                        storage_view_lambda_bind_pattern_expression(right, bound_names) if operator == TokenKind.Is
                        storage_view_lambda_bind_condition(right, bound_names) if operator != TokenKind.Is
                    _:
                        pass

        def storage_view_lambda_bind_pattern(pattern: Ast::Pattern, bound_names: mutable darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name) | Pattern.Rest(name):
                        bound_names.push(name) if name != ""
                    Pattern.Pin(name):
                        storage_view_lambda_capture_name(name, bound_names, alias_names, alias_sources, out)
                    Pattern.As(name, inner):
                        bound_names.push(name) if name != ""
                        for nested in inner |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_bind_pattern(nested, bound_names, alias_names, alias_sources, out)
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Field(_, fields) | Pattern.Tuple(fields) | Pattern.Or(fields):
                        for nested in fields |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_bind_pattern(nested, bound_names, alias_names, alias_sources, out)
                    Pattern.Other(_):
                        # Unknown pattern syntax could bind or pin a name not represented
                        # structurally. Fail closed by retaining every known storage root.
                        storage_view_lambda_capture_unknown_pattern(alias_names, alias_sources, out)
                    _:
                        pass

        def storage_view_lambda_statements(statements: darray[Ast::Stmt], bound_names: mutable darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |bound_names, alias_names, alias_sources, out|:
                    match statement:
                        Stmt.Expr(expression, line):
                            storage_view_lambda_expression(expression, bound_names, alias_names, alias_sources, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            storage_view_lambda_expression(type_expression, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                            bound_names.push(name) if name != ""
                        Stmt.Assign(target, operator, value, line):
                            if operator == TokenKind.Assign:
                                storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                                assigned_name: sview = ident_name_of(target)
                                if assigned_name != "":
                                    bound_names.push(assigned_name)
                                else:
                                    storage_view_lambda_expression(target, bound_names, alias_names, alias_sources, out)
                            else:
                                storage_view_lambda_expression(target, bound_names, alias_names, alias_sources, out)
                                storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            mark: usize = bound_names.count
                            bound_names.push(binding) if binding != ""
                            storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(mark) if bound_names.count > mark
                        Stmt.If(condition, then_body, else_body, line):
                            storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                            then_mark: usize = bound_names.count
                            storage_view_lambda_bind_condition(condition, bound_names)
                            storage_view_lambda_statements(then_body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(then_mark) if bound_names.count > then_mark
                            else_mark: usize = bound_names.count
                            storage_view_lambda_statements(else_body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(else_mark) if bound_names.count > else_mark
                        Stmt.While(condition, body, line):
                            storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                            loop_mark: usize = bound_names.count
                            storage_view_lambda_bind_condition(condition, bound_names)
                            storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(loop_mark) if bound_names.count > loop_mark
                        Stmt.For(bind, variables, iterable, body, line):
                            storage_view_lambda_expression(iterable, bound_names, alias_names, alias_sources, out)
                            loop_mark: usize = bound_names.count
                            for variable in variables |bound_names|:
                                bound_names.push(variable) if variable != ""
                            storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(loop_mark) if bound_names.count > loop_mark
                        Stmt.Return(value, line):
                            if value is returned:
                                storage_view_lambda_expression(returned, bound_names, alias_names, alias_sources, out)
                        Stmt.Match(scrutinee, arms, line):
                            storage_view_lambda_expression(scrutinee, bound_names, alias_names, alias_sources, out)
                            for arm in arms |bound_names, alias_names, alias_sources, out|:
                                arm_mark: usize = bound_names.count
                                storage_view_lambda_bind_pattern(arm.pattern, bound_names, alias_names, alias_sources, out)
                                storage_view_lambda_expression(arm.guard, bound_names, alias_names, alias_sources, out)
                                storage_view_lambda_statements(arm.body, bound_names, alias_names, alias_sources, out)
                                bound_names <- bound_names.truncate(arm_mark) if bound_names.count > arm_mark
                        Stmt.Contract(kind, expression, line):
                            storage_view_lambda_expression(expression, bound_names, alias_names, alias_sources, out)
                        _:
                            pass

        def storage_view_lambda_expression(expression: Ast::Expr, bound_names: mutable darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        storage_view_lambda_capture_name(name, bound_names, alias_names, alias_sources, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(callable_name, callable_line):
                                # A bare declaration call does not capture a value. A local
                                # callable can carry storage only when it has an alias row.
                                if any alias_name in alias_names where alias_name == callable_name:
                                    storage_view_lambda_capture_name(callable_name, bound_names, alias_names, alias_sources, out)
                            _:
                                storage_view_lambda_expression(callee, bound_names, alias_names, alias_sources, out)
                        for argument in arguments |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(argument, bound_names, alias_names, alias_sources, out)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        storage_view_lambda_expression(effect_type, bound_names, alias_names, alias_sources, out)
                        for argument in arguments |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(argument, bound_names, alias_names, alias_sources, out)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                    Expr.Index(object, index, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(index, bound_names, alias_names, alias_sources, out)
                    Expr.Slice(object, low, high, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(low, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(high, bound_names, alias_names, alias_sources, out)
                    Expr.IndexN(object, arguments, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                        for argument in arguments |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(argument, bound_names, alias_names, alias_sources, out)
                    Expr.Binary(left, operator, right, line):
                        storage_view_lambda_expression(left, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(right, bound_names, alias_names, alias_sources, out)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line) | Expr.RegionNew(operand, _, line):
                        storage_view_lambda_expression(operand, bound_names, alias_names, alias_sources, out)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(element, bound_names, alias_names, alias_sources, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(entry.key, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_expression(entry.value, bound_names, alias_names, alias_sources, out)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        storage_view_lambda_expression(type_expression, bound_names, alias_names, alias_sources, out)
                        for field in fields |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(field.value, bound_names, alias_names, alias_sources, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                        then_mark: usize = bound_names.count
                        storage_view_lambda_bind_condition(condition, bound_names)
                        storage_view_lambda_expression(then_value, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(then_mark) if bound_names.count > then_mark
                        else_mark: usize = bound_names.count
                        storage_view_lambda_expression(else_value, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(else_mark) if bound_names.count > else_mark
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        storage_view_lambda_expression(scrutinee, bound_names, alias_names, alias_sources, out)
                        for arm in arms |bound_names, alias_names, alias_sources, out|:
                            arm_mark: usize = bound_names.count
                            storage_view_lambda_bind_pattern(arm.pattern, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_expression(arm.guard, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_statements(arm.body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(arm_mark) if bound_names.count > arm_mark
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        storage_view_lambda_expression(iterable, bound_names, alias_names, alias_sources, out)
                        comp_mark: usize = bound_names.count
                        bound_names.push(variable) if variable != ""
                        storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(body, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(comp_mark) if bound_names.count > comp_mark
                    Expr.Refinement(base, predicate, line):
                        storage_view_lambda_expression(base, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(predicate, bound_names, alias_names, alias_sources, out)
                    Expr.GetElse(guarded, recovery, line):
                        storage_view_lambda_expression(guarded, bound_names, alias_names, alias_sources, out)
                        recovery_mark: usize = bound_names.count
                        storage_view_lambda_statements(recovery, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(recovery_mark) if bound_names.count > recovery_mark
                    Expr.Lambda(parameters, body, line):
                        lambda_mark: usize = bound_names.count
                        for parameter in parameters |bound_names|:
                            bound_names.push(parameter) if parameter != ""
                        storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(lambda_mark) if bound_names.count > lambda_mark
                    Expr.Block(statements, value, captures, line):
                        block_mark: usize = bound_names.count
                        for capture in captures |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_capture_name(capture, bound_names, alias_names, alias_sources, out)
                            bound_names.push(capture) if capture != ""
                        storage_view_lambda_statements(statements, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(block_mark) if bound_names.count > block_mark
                    _:
                        pass

        # The call's sources through the callee's return-origin rows: an "into" origin depends on
        # the argument place itself, a "carry" origin on what the argument already borrows, and
        # a thread handle on every argument. Receiver form `h.name()` passes `h` as parameter 0;
        # the static form `T.name(x)` passes no receiver. Unknown or unsummarised: no sources.
        def storage_view_call_origin_sources(callee: Ast::Expr, arguments: darray[Ast::Expr]&, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                name: mutable sview = ident_name_of(callee)
                receiver: mutable Ast::Expr = Ast::Expr.Absent
                shift: mutable usize = 0
                if name == "":
                    match callee:
                        Expr.Field(object, method, field_line):
                            if vro_status(view_fns, method, arguments.count + 1) != 0:
                                name <- method
                                receiver <- object
                                shift <- 1
                            elif vro_status(view_fns, method, arguments.count) != 0:
                                name <- method
                        _:
                            pass
                arity: usize = arguments.count + shift
                return if vro_status(view_fns, name, arity) != 1
                arity_tag: sview = vro_tag(arity)
                while row + 4 < view_fns.count |row: usize = 0, alias_names, alias_sources, alias_is_view, out|:
                    if view_fns[row] == name and view_fns[row + 1] == arity_tag:
                        mode: sview = view_fns[row + 3]
                        if mode == "thread":
                            storage_view_collect_sources(receiver, alias_names, alias_sources, alias_is_view, view_fns, out) if shift == 1
                            for argument in arguments |alias_names, alias_sources, alias_is_view, out|:
                                storage_view_collect_sources(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                        elif mode == "into" or mode == "carry":
                            position: mutable usize = 16
                            for candidate in 0..<16 |position, view_fns, row|:
                                position <- candidate if vro_tag(candidate) == view_fns[row + 2]
                            if position < arity:
                                plain_argument: Ast::Expr = receiver if shift == 1 and position == 0 else arguments[position - shift]
                                # A view a callee derives from a borrowed PARAMETER's storage is tracked
                                # like a local's: growing that parameter in this frame relocates the
                                # caller's buffer (stage0 rejects the same shape).
                                argument_root: sview = storage_view_place_root(plain_argument)
                                # `return bytes_view_range(p.buf, ..)` views FIELD buf of the argument:
                                # key it on that field so a sibling's growth stays harmless.
                                field_name: sview = view_fns[row + 4]
                                argument: Ast::Expr = Ast::Expr.Field(vro_strip_borrow(plain_argument), field_name, Ast::expr_pos(plain_argument)) if field_name != "" else plain_argument
                                if mode == "into":
                                    storage_view_sources_from_argument(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                                else:
                                    storage_view_collect_sources(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                    row <- row + vro_row()

        def storage_view_collect_sources(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        # A container's "[held]" rows (views stored INTO it) are not inherited by a
                        # copy of the container's place: they describe its elements, not its buffer.
                        for alias_index in 0..<alias_names.count |alias_names, alias_sources, name, out|:
                            held_row: bool = alias_index > 0 and alias_names[alias_index - 1] == name and alias_sources[alias_index - 1] == "[held]"
                            storage_view_push_source(alias_sources[alias_index], out) if alias_names[alias_index] == name and alias_index < alias_sources.count and not held_row and alias_sources[alias_index] != "[held]"
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        storage_view_collect_sources(inner, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Unary(operator, operand, line):
                        borrowed_place: sview = interior_reference_place(operand) if operator == TokenKind.Ampersand else ""
                        storage_view_push_source(borrowed_place, out) if borrowed_place != ""
                        # `&r[0]` through a container reference `r = &b.items` also depends on
                        # what `r` borrows: growing `b.items` relocates the buffer `r` names.
                        if borrowed_place != "":
                            for alias_index in 0..<alias_names.count |alias_names, alias_sources, borrowed_place, out|:
                                storage_view_push_source(alias_sources[alias_index], out) if alias_names[alias_index] == borrowed_place and alias_index < alias_sources.count
                        storage_view_collect_sources(operand, alias_names, alias_sources, alias_is_view, view_fns, out) if borrowed_place == ""
                    Expr.Call(callee, arguments, argument_names, line):
                        called: sview = ident_name_of(callee)
                        # An enum payload holds its arguments by value: `Tok.Word(buf.as_sview())`
                        # carries the view, so it depends on what the view borrows (stage0:
                        # isEnumVariantConstructorCall).
                        if enum_variant_callee(callee):
                            for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                                storage_view_collect_sources(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                        # Match Stage0's explicit borrowed-storage contracts. Do not infer
                        # backing from every sview-returning user function: helpers such as
                        # Lexer.text_or_empty borrow the source argument, not every mutable
                        # parser argument supplied to the helper.
                        returns_view: bool = called in {"arena_dict_get", "arena_dict_get_mut", "arena_dict_get_cstr_view", "arena_dict_get_cstr_view_mut", "bytes_view", "bytes_view_range", "bytes_view_range_ref", "sview", "string_view_slice", "string_view_prefix", "string_view_suffix", "darray_view", "arena_da_view", "readonly", "arena_da_view_slice", "arena_da_view_prefix", "arena_da_view_suffix", "slice", "read_view", "split"}
                        if returns_view:
                            for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                                storage_view_sources_from_argument(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                # `m.get(k)` / `m.get_mut(k)` on a dict yield a reference into the
                                # bucket array, which an insert may rehash (stage0
                                # storageViewOriginsOfExpr arena_dict_get*).
                                is_view_method: bool = method == "view" or method == "as_sview" or method == "as_cstr" or ((method == "get" or method == "get_mut") and arguments.count == 1)
                                storage_view_sources_from_argument(receiver, alias_names, alias_sources, alias_is_view, view_fns, out) if is_view_method
                            _:
                                pass
                        # A user function whose result borrows from its parameters (stage0
                        # storageViewDependencyForUserCall): see view_return_origins.elisa.
                        storage_view_call_origin_sources(callee, arguments, alias_names, alias_sources, alias_is_view, view_fns, out) if not returns_view and not enum_variant_callee(callee)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        # Every element is a value of BODY: `[buf.as_sview() for i in r]` holds views of buf.
                        storage_view_collect_sources(body, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Slice(object, start, end, line):
                        storage_view_sources_from_argument(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line):
                        storage_view_collect_sources(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_collect_sources(then_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                        storage_view_collect_sources(else_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Tuple(elements, line) | Expr.Array(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(element, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(entry.key, alias_names, alias_sources, alias_is_view, view_fns, out)
                            storage_view_collect_sources(entry.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.RecordUpdate(base, fields, line):
                        storage_view_collect_sources(base, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Block(statements, value, captures, line):
                        for statement in statements |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                        storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Match(scrutinee, arms, line):
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            for statement in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                            # The arm's value is its trailing expression (`v: sview = match n: 1: buf.as_sview()`).
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(arm_value, arm_value_line):
                                        storage_view_collect_sources(arm_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                                    _:
                                        pass
                    Expr.Catch(guarded, arms, line):
                        storage_view_collect_sources(guarded, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            for statement in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                    Expr.GetElse(guarded, recovery, line):
                        storage_view_collect_sources(guarded, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for statement in recovery |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                    Expr.Lambda(parameters, body, line):
                        bound_names: mutable darray[sview] = []
                        for parameter in parameters |bound_names|:
                            bound_names.push(parameter) if parameter != ""
                        storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                    _:
                        pass

        def growth_call_target(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(callee, arguments, argument_names, line):
                    match callee:
                        Expr.Field(receiver, method, field_line):
                            root: sview = storage_view_place_root(receiver)
                            return root if method in {"push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop", "as_cstr", "put", "put_checked", "put_or_panic", "get_or_insert", "get_or_insert_with"} else ""
                        Expr.Ident(method, ident_line):
                            if method in {"darray_push", "darray_extend", "darray_append", "darray_append_many", "darray_insert", "darray_reserve", "darray_resize", "darray_clear", "darray_truncate", "darray_pop", "arena_dict_put", "arena_dict_put_checked", "arena_dict_put_or_panic", "arena_dict_get_or_insert", "arena_dict_reserve", "push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop"} and arguments.count > 0:
                                return storage_view_place_root(arguments[0])
                        _:
                            pass
                _:
                    pass
            return ""

        # The direct field `f` of a growth receiver `root.f` (`p.lines.push(x)`), or "".
        def growth_call_target_field(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(callee, arguments, argument_names, line):
                    match callee:
                        Expr.Field(receiver, method, field_line):
                            return storage_view_direct_field(receiver) if method in {"push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop", "as_cstr", "put", "put_checked", "put_or_panic", "get_or_insert", "get_or_insert_with"} else ""
                        Expr.Ident(method, ident_line):
                            if method in {"darray_push", "darray_extend", "darray_append", "darray_append_many", "darray_insert", "darray_reserve", "darray_resize", "darray_clear", "darray_truncate", "darray_pop", "arena_dict_put", "arena_dict_put_checked", "arena_dict_put_or_panic", "arena_dict_get_or_insert", "arena_dict_reserve", "push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop"} and arguments.count > 0:
                                return storage_view_direct_field(arguments[0])
                        _:
                            pass
                _:
                    pass
            return ""

        # `f` when PLACE is exactly `root.f` (through parens, `move` and `&`), else "".
        def storage_view_direct_field(place: Ast::Expr) -> sview:
            match place:
                Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Unary(TokenKind.Ampersand, inner, _):
                    return storage_view_direct_field(inner)
                Expr.Field(object, field, _):
                    return field if object is Expr.Ident(_, _) else ""
                _:
                    return ""

        # Field-path keys. Rows key on the root, so a view of `p.storage` is preceded by a
        # ("[field]", "storage") marker row when every mention of `p` in its value goes through
        # that one field. Growth through a sibling `p.lines` spares the view only when both
        # fields are darrays of DIFFERENT concrete element types: same-typed siblings may share
        # a buffer after a shallow copy (`P{storage: buf, lines: buf}`), so they still overlap
        # (stage0 storageViewSiblingSpare).
        def storage_view_row_spared(index: usize, target: sview, target_field: sview, field_elems: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&) -> bool:
            can Abort.Panic:
                return false if target_field == "" or index == 0 or index >= alias_sources.count or alias_sources[index] != target
                return false if alias_names[index - 1] != "[field]"
                view_field: sview = alias_sources[index - 1]
                return false if view_field == target_field
                target_elem: sview = storage_view_field_elem(target, target_field, field_elems)
                view_elem: sview = storage_view_field_elem(target, view_field, field_elems)
                return target_elem != "" and view_elem != "" and target_elem != view_elem

        def storage_view_field_elem(root: sview, field: sview, field_elems: darray[sview]&) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                while index + 2 < field_elems.count |index, field_elems, root, field|:
                    return field_elems[index + 2] if field_elems[index] == root and field_elems[index + 1] == field
                    index <- index + 3
                return ""

        # The single field through which VALUE mentions ROOT: "" when it never does, "[bare]"
        # when it mentions ROOT whole, through two different fields, through a known alias, or
        # in a shape this walk does not model.
        # A summarised call whose result views exactly one argument THROUGH a field
        # (`name(&h)` returning `bytes_view_range(self.buf, ..)`) is spelled as that field path
        # (`h.buf`) for field-origin keying, so growing a sibling field keeps the view.
        def storage_view_call_field_value(value: Ast::Expr, view_fns: darray[sview]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_call_field_value(inner, view_fns)
                    Expr.Call(callee, arguments, _, _):
                        into_arguments: darray[Ast::Expr] = vro_origin_arguments(callee, arguments, view_fns, false)
                        carry_arguments: darray[Ast::Expr] = vro_origin_arguments(callee, arguments, view_fns, true)
                        value return if into_arguments.count + carry_arguments.count == 0
                        into_fields: darray[sview] = vro_origin_fields(callee, arguments, view_fns, false)
                        carry_fields: darray[sview] = vro_origin_fields(callee, arguments, view_fns, true)
                        value return if into_fields.count != into_arguments.count or carry_fields.count != carry_arguments.count
                        # Several origins (`name return if ..` beside `return bytes_view_range(p.buf, ..)`):
                        # spell each as its field path and let storage_view_field_origins key them per
                        # root, so an origin through another root does not widen `p`'s to "[bare]".
                        origins: mutable darray[Ast::Expr] = []
                        for index in 0..<into_arguments.count |origins, into_arguments, into_fields|:
                            origins.push(storage_view_origin_spelling(into_arguments[index], into_fields[index]))
                        for index in 0..<carry_arguments.count |origins, carry_arguments, carry_fields|:
                            origins.push(storage_view_origin_spelling(carry_arguments[index], carry_fields[index]))
                        return origins[0] if origins.count == 1
                        names: darray[sview] = []
                        return Ast::Expr.Call(Ast::Expr.Ident("", Ast::expr_pos(value)), origins, names, Ast::expr_pos(value))
                    _:
                        return value

        def storage_view_origin_spelling(argument: Ast::Expr, field: sview) -> Ast::Expr:
            can Memory.Allocate:
                argument return if field == ""
                return Ast::Expr.Field(vro_strip_borrow(argument), field, Ast::expr_pos(argument))

        # One (marker, alias) row pair per field through which VALUE mentions SOURCE, or a single
        # unmarked (whole-root) row. A view of `p.a` or `p.b` is two marked rows; growth or
        # replacement kills it when ANY of its rows is not spared, so this is exact, not wider.
        def storage_view_push_origin_rows(origin_value: Ast::Expr, name: sview, source: sview, is_view: bool, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                origins: mutable darray[sview] = []
                storage_view_field_origins(origin_value, source, alias_names, alias_sources, origins)
                whole: bool = origins.count == 0 or any origin in origins where origin == "[bare]"
                if whole:
                    alias_names.push(name)
                    alias_sources.push(source)
                    alias_is_view.push(is_view)
                    return
                for origin in origins |alias_names, alias_sources, alias_is_view, name, source, is_view|:
                    alias_names.push("[field]")
                    alias_sources.push(origin)
                    alias_is_view.push(false)
                    alias_names.push(name)
                    alias_sources.push(source)
                    alias_is_view.push(is_view)

        def storage_view_add_origin(origin: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if origin == "" or any existing in out where existing == origin
                out.push(origin)

        # Every field through which VALUE mentions ROOT ("[bare]" for a whole-root mention or a
        # shape the walk does not model); nothing when it never mentions ROOT. An alias
        # contributes the fields of its own rows against ROOT.
        def storage_view_field_origins(value: Ast::Expr, root: sview, alias_names: darray[sview]&, alias_sources: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Absent:
                        pass
                    Expr.Ident(name, _):
                        if name == root:
                            storage_view_add_origin("[bare]", out)
                        else:
                            known: mutable bool = false
                            found: mutable bool = false
                            for i in 0..<alias_names.count |known, found, out, name, root, alias_names, alias_sources|:
                                if alias_names[i] == name:
                                    known <- true
                                    if alias_sources[i] == root:
                                        found <- true
                                        storage_view_add_origin(alias_sources[i - 1] if i > 0 and alias_names[i - 1] == "[field]" else "[bare]", out)
                            storage_view_add_origin("[bare]", out) if known and not found
                    Expr.Field(object, field, _):
                        match object:
                            Expr.Ident(name, _):
                                if name == root:
                                    storage_view_add_origin(field, out)
                                elif any alias in alias_names where alias == name:
                                    storage_view_add_origin("[bare]", out)
                            _:
                                storage_view_field_origins(object, root, alias_names, alias_sources, out)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Unary(_, inner, _):
                        storage_view_field_origins(inner, root, alias_names, alias_sources, out)
                    Expr.Binary(left, _, right, _):
                        storage_view_field_origins(left, root, alias_names, alias_sources, out)
                        storage_view_field_origins(right, root, alias_names, alias_sources, out)
                    Expr.Index(object, index, _):
                        storage_view_field_origins(object, root, alias_names, alias_sources, out)
                        storage_view_field_origins(index, root, alias_names, alias_sources, out)
                    Expr.Call(callee, arguments, _, _):
                        storage_view_field_origins(callee, root, alias_names, alias_sources, out)
                        for argument in arguments |out, root, alias_names, alias_sources|:
                            storage_view_field_origins(argument, root, alias_names, alias_sources, out)
                    _:
                        storage_view_add_origin("[bare]", out)

        # (root, field, element key) triples for every local or param whose declared struct
        # type is unambiguous, over each darray field with a concrete element type.
        def storage_view_collect_field_elems(local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<local_names.count |local_names, local_types, table, out|:
                    root: sview = local_names[index]
                    seen: mutable bool = false
                    for seen_index in 0..<index |seen, local_names, root|:
                        seen <- true if local_names[seen_index] == root
                    continue if seen
                    owner: mutable sview = ""
                    ambiguous: mutable bool = false
                    for other in 0..<local_names.count |owner, ambiguous, local_names, local_types, root|:
                        if local_names[other] == root and other < local_types.count:
                            declared: sview = storage_view_declared_type_name(local_types[other])
                            ambiguous <- true if declared == "" or (owner != "" and owner != declared)
                            owner <- declared
                    continue if owner == "" or ambiguous
                    for row in 0..<table.struct_field_owner.count |out, table, owner, root|:
                        if table.struct_field_owner[row] == owner and row < table.struct_field_type_id.count and row < table.struct_field_name.count:
                            interned_elem_key: sview = storage_view_concrete_darray_elem(table.struct_field_type_id[row], table)
                            elem: sview = storage_view_qualified_darray_elem(table.private_field_types[row], table) if interned_elem_key == "" and row < table.private_field_types.count else interned_elem_key
                            if elem != "":
                                out.push(root)
                                out.push(table.struct_field_name[row])
                                out.push(elem)

        # The element of a `darray[E]` field type when E is a builtin scalar/string type or a
        # declared struct or non-generic enum, else "". Named rows key on their last `::` segment, so two structs
        # sharing a name compare equal: a collision only costs precision.
        def storage_view_concrete_darray_elem(type_id: u32, table: SymbolTable&) -> sview:
            can Abort.Panic:
                current: mutable u32 = type_id
                while current != 0 and interned_kind(current, table) == SemTypeKind.Ref |current, table|:
                    current <- interned_elem(current, 0, table)
                return "" if current == 0 or interned_kind(current, table) != SemTypeKind.Container or interned_name(current, table) != "darray" or interned_elem_count(current, table) != 1
                elem: u32 = interned_elem(current, 0, table)
                kind: SemTypeKind = interned_kind(elem, table)
                return interned_name(elem, table) if kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char or kind == SemTypeKind.String
                return "" if kind != SemTypeKind.Named
                name: sview = storage_view_last_segment(interned_name(elem, table))
                return name if name != "" and any owner in table.struct_field_owner where storage_view_segment_is(owner, name)
                # A non-generic declared enum is as concrete as a struct: a darray of it can never
                # share a buffer with a darray[u8] (stage0 storageViewConcreteElemKey).
                return "" if name == "" or interned_elem_count(elem, table) != 0
                return name if any owner in table.enum_variant_owner where storage_view_segment_is(owner, name)
                return ""

        # `darray[M::T]`: annotation_type_id has no `Expr.Scope` arm, so a module-qualified
        # element interns to 0 and the interned path above yields "". Read the field's
        # annotation directly: the element counts only when its last segment names a
        # declared struct or enum, keyed like the interned path (a name collision across
        # modules only merges keys, which costs precision, never soundness).
        def storage_view_qualified_darray_elem(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        storage_view_qualified_darray_elem(operand, table) return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return ""
                    Expr.Index(indexed_head, index_argument, _):
                        return "" if ident_name_of(indexed_head) != "darray"
                        match index_argument:
                            Expr.Scope(_, element_name, _):
                                return element_name if element_name != "" and any owner in table.struct_field_owner where storage_view_segment_is(owner, element_name)
                                return element_name if element_name != "" and any owner in table.enum_variant_owner where storage_view_segment_is(owner, element_name)
                                return ""
                            _:
                                return ""
                    _:
                        return ""

        # `storage_view_last_segment(owner) == name` without walking OWNER: true exactly when
        # OWNER ends in NAME at a `:` boundary (or is NAME) and NAME itself holds no `:`. The
        # callers probe every struct-field / enum-variant owner row per darray element, so the
        # byte walk of each owner showed up in self-host profiles.
        def storage_view_segment_is(owner: sview, name: sview) -> bool:
            can Abort.Panic:
                owner_length: usize = sview_len(owner)
                name_length: usize = sview_len(name)
                false return if name_length > owner_length
                prefix: usize = owner_length - name_length
                false return if prefix > 0 and owner[prefix - 1] != ':'
                false return if string_view_slice(owner, i64(prefix), i64(owner_length)) != name
                for position in 0..<name_length |name|:
                    false return if name[position] == ':'
                return true

        def storage_view_last_segment(name: sview) -> sview:
            can Abort.Panic:
                start: mutable usize = 0
                length: usize = sview_len(name)
                for position in 0..<length |start, name|:
                    start <- position + 1 if name[position] == ':'
                return string_view_slice(name, i64(start), i64(length))

        # Whether CALLEE's positional parameter POSITION is a `mutable T&` borrow whose type can
        # hold relocatable storage. Only a scalar pointee is known not to: a darray, a struct
        # with a darray field or a generic may be grown by the callee through the borrow.
        def storage_callee_param_may_relocate(table: SymbolTable&, callee: sview, position: usize) -> bool:
            can Abort.Panic:
                seen: mutable usize = 0
                result: mutable bool = false
                cur: mutable u32 = function_param_chain_head(table, callee)
                while cur != 4294967295:
                    row: usize = cur.usize()
                    if table.function_param_owner[row] == callee:
                        result <- table.function_param_mutable_ref[row] and not storage_scalar_pointee(table.function_param_type_id[row], table) if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[row]
                return result

        # Whether TYPE_ID, seen through reference/optional layers, is a scalar. Unknown (0) is
        # NOT scalar: an unmodeled parameter type must keep invalidating. Optional scalar
        # pointers (for example `u8&?&`) carry a pointer value, not a relocatable container.
        def storage_scalar_pointee(type_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                current: mutable u32 = type_id
                while current != 0 and (interned_kind(current, table) == SemTypeKind.Ref or interned_kind(current, table) == SemTypeKind.Optional) and interned_elem_count(current, table) == 1:
                    current <- interned_elem(current, 0, table)
                kind: SemTypeKind = interned_kind(current, table)
                return current != 0 and (kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char)

        # Container roots a call relocates through a user function's `mutable T&` parameters
        # (`grow(&xs)` where `def grow(ys: mutable darray[i64]&)` pushes). The callee is
        # analysed in its own scope, so the call site is the only place that can see an
        # interior reference into `xs` outlive the growth. Nested calls in arguments count.
        def callee_relocation_targets(expression: Ast::Expr, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        for argument in arguments |position: usize = 0, out, callee_name, table|:
                            callee_relocation_targets(argument, table, out)
                            root: sview = storage_view_place_root(argument) if callee_name != "" else ""
                            callee_relocation_summarised(root, argument, callee_name, position, table, out) if root != "" and storage_callee_param_may_relocate(table, callee_name, position)
                            position <- position + 1
                        # Receiver form `xs.grow()` / `b.add(v)`: the receiver is the callee's
                        # first parameter, so the arguments shift by one.
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                if callee_name == "" and function_param_chain_head(table, method) != 4294967295:
                                    callee_relocation_targets(receiver, table, out)
                                    receiver_root: sview = storage_view_place_root(receiver)
                                    callee_relocation_summarised(receiver_root, receiver, method, 0, table, out) if receiver_root != "" and storage_callee_param_may_relocate(table, method, 0)
                                    for argument in arguments |shifted: usize = 1, out, method, table|:
                                        argument_root: sview = storage_view_place_root(argument)
                                        callee_relocation_summarised(argument_root, argument, method, shifted, table, out) if argument_root != "" and storage_callee_param_may_relocate(table, method, shifted)
                                        shifted <- shifted + 1
                            _:
                                pass
                    Expr.Paren(inner, line):
                        callee_relocation_targets(inner, table, out)
                    Expr.Unary(operator, operand, line):
                        callee_relocation_targets(operand, table, out)
                    Expr.Binary(left, operator, right, line):
                        callee_relocation_targets(left, table, out)
                        callee_relocation_targets(right, table, out)
                    _:
                        pass

        # A relocating argument mapped through the callee's field-growth summary: a bare
        # root invalidates only the fields the callee grows; `root.f` (or a deeper place)
        # survives a callee that grows nothing. Unsummarised callees keep the old pairs.
        def callee_relocation_summarised(root: sview, argument: Ast::Expr, callee: sview, position: usize, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[sview] = []
                if not param_growth_fields(table, callee, position, fields):
                    callee_relocation_push(root, storage_view_direct_field(argument), out)
                    return
                return if fields.count == 0
                if storage_view_place_root(argument) == root and pgs_top_field(argument, root) == "" and storage_view_direct_field(argument) == "" and pgs_is_bare(argument, root):
                    for field in fields |root, out|:
                        callee_relocation_push(root, field, out)
                    return
                callee_relocation_push(root, storage_view_direct_field(argument), out)

        # Flat (root, field) pairs: FIELD is the direct field `f` when the relocating argument is
        # exactly `root.f` (the callee can only grow that field), else "" for the whole root.
        def callee_relocation_push(root: sview, field: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if root == "" or root == "[held]"
                pair: mutable usize = 0
                while pair + 1 < out.count |pair, out, root, field|:
                    return if out[pair] == root and out[pair + 1] == field
                    pair <- pair + 2
                out.push(root)
                out.push(field)

        def invalidate_callee_relocations(expression: Ast::Expr, field_elems: darray[sview]&, function_line: u32, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&, stable_regions: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                targets: mutable darray[sview] = []
                callee_relocation_targets(expression, table, targets)
                pair: mutable usize = 0
                while pair + 1 < targets.count |pair, targets, field_elems, invalidated, invalidated_by|:
                    invalidate_growth_aliases(targets[pair], targets[pair + 1], field_elems, function_line, line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                    pair <- pair + 2

        def invalidated_alias_in_expression(expression: Ast::Expr, invalidated: darray[sview]&) -> sview can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.Ident(name, line):
                    return name if fresh_wrapper_name_exists(invalidated, name) else ""
                Expr.Field(receiver, field, line):
                    return invalidated_alias_in_expression(receiver, invalidated)
                Expr.Index(object, index, line):
                    return invalidated_alias_in_expression(object, invalidated)
                Expr.IndexN(object, arguments, line):
                    return invalidated_alias_in_expression(object, invalidated)
                Expr.Unary(operator, operand, line):
                    return invalidated_alias_in_expression(operand, invalidated)
                Expr.Paren(inner, line) | Expr.Move(inner, line):
                    return invalidated_alias_in_expression(inner, invalidated)
                # `match t:` in value position reads the scrutinee (an enum holding a view).
                Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                    return invalidated_alias_in_expression(scrutinee, invalidated)
                Expr.Call(callee, arguments, argument_names, line):
                    from_callee: sview = invalidated_alias_in_expression(callee, invalidated)
                    return from_callee if from_callee != ""
                    return invalidated_alias_in_arguments(arguments, invalidated)
                Expr.Binary(left, operator, right, line):
                    found_left: sview = invalidated_alias_in_expression(left, invalidated)
                    return found_left if found_left != ""
                    return invalidated_alias_in_expression(right, invalidated)
                Expr.If(condition, then_value, else_value, line):
                    # The condition is evaluated first: `x if v[0] == 1 else y` reads `v`.
                    found_condition: sview = invalidated_alias_in_expression(condition, invalidated)
                    return found_condition if found_condition != ""
                    found_then: sview = invalidated_alias_in_expression(then_value, invalidated)
                    return found_then if found_then != ""
                    return invalidated_alias_in_expression(else_value, invalidated)
                Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                    return invalidated_alias_in_arguments(elements, invalidated)
                # `submit f(v)` / `await t` parse as a statement-less value block around the
                # operand; without this arm a stale view handed to a task was never seen.
                Expr.Block(block_statements, block_value, block_captures, line):
                    return invalidated_alias_in_expression(block_value, invalidated) if block_statements.count == 0
                    return ""
                _:
                    return ""

        def invalidated_alias_in_arguments(arguments: darray[Ast::Expr]&, invalidated: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = ""
                for argument in arguments |found, invalidated|:
                    found <- invalidated_alias_in_expression(argument, invalidated) if found == ""
                return found

        def diagnose_invalidated_alias(expression: Ast::Expr, invalidated: darray[sview]&, invalidated_by: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias: sview = invalidated_alias_in_expression(expression, invalidated)
                by: sview =
                    for candidate_index in 0..<invalidated.count |by: sview = ""| -> by:
                        by <- invalidated_by[candidate_index] if invalidated[candidate_index] == alias and candidate_index < invalidated_by.count
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StorageDependencyInvalidated, name: alias, pos: ident_extent_or_line(expression, line), line: line, expected: by, actual: ""}) if alias != ""

        # A plain darray and a darray in malloc/chained/scratch storage can move its backing
        # buffer when it grows. Only reserve_commit and fixed are single-block backings whose
        # base remains stable. This mirrors stage0's storage-view dependency rule: an absent
        # region is deliberately treated as relocatable rather than silently accepted.
        def storage_backing_is_stable(region: sview, stable_regions: darray[sview]&) -> bool:
            return region != "" and destroyed_region_contains(stable_regions, region)

        def invalidate_growth_aliases(target: sview, target_field: sview, field_elems: darray[sview]&, function_line: u32, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&, stable_regions: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                region: sview = function_region_of_name(annotations, target, function_line, line)
                return if target == "" or storage_backing_is_stable(region, stable_regions)
                # `target` itself is tested directly below, so the list holds only the
                # target's alias sources and stays empty (allocation-free) in the common case.
                # The `[target]` literal used to be allocated on every call, and in a function
                # with mutable darray& params it lands in the caller's arena and never dies:
                # ~106 MB of a 1.6 GB peak (tools/memprof --live, stage1-built compiler).
                target_sources: mutable darray[sview] = []
                for alias_index in 0..<alias_names.count |target_sources, alias_names, alias_sources, target|:
                    held_row: bool = alias_index > 0 and alias_names[alias_index - 1] == target and alias_sources[alias_index - 1] == "[held]"
                    storage_view_push_source(alias_sources[alias_index], target_sources) if alias_names[alias_index] == target and alias_index < alias_sources.count and not held_row and alias_sources[alias_index] != "[held]"
                for source in alias_sources |index: usize = 0, invalidated, target_sources, alias_names, alias_is_view, invalidated_by, target|:
                    if (source == target or any owner_source in target_sources where owner_source == source) and not storage_view_row_spared(index, target, target_field, field_elems, alias_names, alias_sources):
                        invalidated.push(alias_names[index]) if index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and not fresh_wrapper_name_exists(invalidated, alias_names[index])
                        invalidated_by.push(target) if index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and invalidated.count > invalidated_by.count
                    index <- index + 1

        # A whole assignment `xs <- [..]` of a darray/dict/set frees the buffer every interior
        # view of `xs` points into (stage0: invalidateStorageViewsForWholeAssignment). Only
        # names whose declared type is the container itself qualify, or a by-reference param
        # with an immutable binding (`<-` then writes the caller's container). A mutable ref
        # binding rebinds instead, and a name also declared with another type is left out:
        # the walk has no scope-accurate type, so an ambiguous name is a sound miss.
        def storage_view_type_is_replaceable(type_expression: Ast::Expr, allow_reference: bool) -> bool:
            can Abort.Panic:
                current: mutable Ast::Expr = type_expression
                through_reference: mutable bool = false
                while true |current, through_reference|:
                    match current:
                        Expr.Unary(operator, operand, line):
                            return false if operator != TokenKind.Mutable and operator != TokenKind.Ampersand
                            return false if operator == TokenKind.Ampersand and (through_reference or not allow_reference)
                            through_reference <- true if operator == TokenKind.Ampersand
                            current <- operand
                        Expr.Paren(operand, line):
                            current <- operand
                        Expr.Index(head, argument, line) | Expr.IndexN(head, arguments, line):
                            head_name: sview = ident_name_of(head)
                            return head_name == "darray" or head_name == "dict" or head_name == "set"
                        # `out <- "..."` on a dstr frees the bytes `out.as_sview()` pointed at.
                        Expr.Ident(type_name, line):
                            return type_name == "dstr"
                        _:
                            return false
                return false

        def storage_view_element_is_replaceable(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line) | Expr.Paren(operand, line):
                        return storage_view_element_is_replaceable(operand)
                    Expr.Index(head, argument, line):
                        return ident_name_of(head) == "darray" and storage_view_type_is_replaceable(argument, false)
                    _:
                        return false

        # `grid: darray[darray[T]]` records a (grid, "[]") row: replacing an element
        # `grid[i] <- ..` frees that row's buffer, so it invalidates views of grid too.
        def storage_view_has_element_marker(alias_names: darray[sview]&, alias_sources: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                for index in 0..<alias_names.count |alias_names, alias_sources, name|:
                    return true if alias_names[index] == name and index < alias_sources.count and alias_sources[index] == "[]"
                return false

        def storage_view_collect_replaceable(statements: darray[Ast::Stmt]&, names: mutable darray[sview]&, others: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, others|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if storage_view_type_is_replaceable(type_expression, false):
                                names.push(name)
                            else:
                                others.push(name)
                            storage_view_collect_replaceable_expr(value, names, others)
                        Stmt.Expr(expression, line):
                            storage_view_collect_replaceable_expr(expression, names, others)
                        Stmt.If(condition, then_body, else_body, line):
                            storage_view_collect_replaceable(then_body, names, others)
                            storage_view_collect_replaceable(else_body, names, others)
                        Stmt.While(condition, body, line):
                            storage_view_collect_replaceable(body, names, others)
                        Stmt.For(bind, variables, iterable, body, line):
                            others.push(bind)
                            for variable in variables |others|:
                                others.push(variable)
                            storage_view_collect_replaceable(body, names, others)
                        Stmt.Block(kind, clause, binding, body, line):
                            others.push(binding) if binding != ""
                            storage_view_collect_replaceable(body, names, others)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |names, others|:
                                storage_view_collect_replaceable(arm.body, names, others)
                        _:
                            pass

        def storage_view_collect_replaceable_expr(expression: Ast::Expr, names: mutable darray[sview]&, others: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Block(statements, value, captures, line):
                        storage_view_collect_replaceable(statements, names, others)
                    _:
                        pass

        def storage_view_drop_shadowed(names: mutable darray[sview]&, others: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                kept: mutable darray[sview] = []
                for name in names |kept, others|:
                    kept.push(name) if name != "" and not fresh_wrapper_name_exists(others, name) and not fresh_wrapper_name_exists(kept, name)
                names.truncate(0)
                for name in kept |names|:
                    names.push(name)

        # `&s.items[i]` borrows an element of a darray held in a struct field. Its alias row is
        # keyed on the root "s", which cannot tell it from `&s.n`, so replacing `s` or
        # `s.items` (the old buffer is released) needs the field chain the view indexes.
        # Collect such views, and plain copies of them, with that chain; a chain that does not
        # resolve through the struct field rows to a darray is left out.
        def storage_view_collect_local_types(statements: darray[Ast::Stmt]&, names: mutable darray[sview]&, types: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            names.push(name)
                            types.push(type_expression)
                        Stmt.If(condition, then_body, else_body, line):
                            storage_view_collect_local_types(then_body, names, types)
                            storage_view_collect_local_types(else_body, names, types)
                        Stmt.While(condition, body, line):
                            storage_view_collect_local_types(body, names, types)
                        Stmt.For(bind, variables, iterable, body, line):
                            storage_view_collect_local_types(body, names, types)
                        Stmt.Block(kind, clause, binding, body, line):
                            storage_view_collect_local_types(body, names, types)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |names, types|:
                                storage_view_collect_local_types(arm.body, names, types)
                        _:
                            pass

        # The struct type named by OBJECT: a local whose every declaration names the same
        # type, or a field whose row is a named type. "" when it is not known.
        def storage_view_field_owner(object: Ast::Expr, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match object:
                    Expr.Ident(name, line):
                        owner: mutable sview = ""
                        for index in 0..<local_names.count |owner, local_names, local_types, name|:
                            if local_names[index] == name and index < local_types.count:
                                declared: sview = storage_view_declared_type_name(local_types[index])
                                return "" if declared == "" or (owner != "" and owner != declared)
                                owner <- declared
                        return owner
                    Expr.Field(inner, field, line):
                        type_id: u32 = storage_view_field_chain_type_id(object, local_names, local_types, table)
                        return interned_name(type_id, table) if type_id != 0 and interned_kind(type_id, table) == SemTypeKind.Named else ""
                    _:
                        return ""

        # `S`, `mutable S`, `S&` and `mutable S&` all name S: a reference root reaches the same
        # struct storage.
        def storage_view_declared_type_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                current: mutable Ast::Expr = type_expression
                while true:
                    match current:
                        Expr.Unary(operator, operand, line):
                            return "" if operator != TokenKind.Mutable and operator != TokenKind.Ampersand and operator != TokenKind.Lmut
                            current <- operand
                        Expr.Paren(inner, line):
                            current <- inner
                        _:
                            return ident_name_of(current)
                return ""

        def storage_view_field_chain_type_id(chain: Ast::Expr, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match chain:
                    Expr.Field(object, field, line):
                        owner: sview = storage_view_field_owner(object, local_names, local_types, table)
                        return 0 if owner == ""
                        return pag_struct_field_type_id(owner, field, table)
                    _:
                        return 0

        # The field chain `s.items` indexed by `&s.items[i]`, when VALUE is that borrow.
        def storage_view_field_element_head(value: Ast::Expr, head: mutable Ast::Expr&) -> bool:
            current: mutable Ast::Expr = value
            borrowed: mutable bool = false
            while true:
                match current:
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        current <- inner
                    Expr.Unary(operator, operand, line):
                        return false if operator != TokenKind.Ampersand or borrowed
                        borrowed <- true
                        current <- operand
                    Expr.Index(object, index, line):
                        return false if not borrowed
                        match object:
                            Expr.Field(inner, field, field_line):
                                head <- object
                                return true
                            _:
                                return false
                    _:
                        return false
            return false

        # `p.name.as_sview()` over a dstr field: replacing `p.name` frees the bytes the view reads
        # (stage0 invalidateStorageViewsForSourceScoped on the field place).
        def storage_view_dstr_field_view_head(value: Ast::Expr, head: mutable Ast::Expr&) -> bool:
            match storage_view_strip_paren_move(value):
                Expr.Call(callee, arguments, argument_names, line):
                    return false if arguments.count != 0
                    match callee:
                        Expr.Field(object, method, field_line):
                            return false if method != "as_sview" and method != "as_cstr" and method != "as_view" and method != "as_slice" and method != "as_str"
                            match object:
                                Expr.Field(inner, field, inner_line):
                                    head <- object
                                    return true
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false
            return false

        def storage_view_collect_field_element_views(statements: darray[Ast::Stmt]&, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, table: SymbolTable&, views: mutable darray[sview]&, heads: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |local_names, local_types, table, views, heads|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            head: mutable Ast::Expr = value
                            if storage_view_field_element_head(value, head):
                                type_id: u32 = storage_view_field_chain_type_id(head, local_names, local_types, table)
                                if type_id != 0 and interned_kind(type_id, table) == SemTypeKind.Container and interned_name(type_id, table) == "darray":
                                    views.push(name)
                                    heads.push(head)
                            elif storage_view_dstr_field_view_head(value, head):
                                type_id: u32 = storage_view_field_chain_type_id(head, local_names, local_types, table)
                                if type_id != 0 and interned_name(type_id, table) == "dstr":
                                    views.push(name)
                                    heads.push(head)
                            else:
                                copied: sview = ident_name_of(storage_view_strip_paren_move(value))
                                for index in 0..<views.count |views, heads, copied, name|:
                                    if copied != "" and views[index] == copied and index < heads.count:
                                        views.push(name)
                                        heads.push(heads[index])
                                        break
                        Stmt.If(condition, then_body, else_body, line):
                            storage_view_collect_field_element_views(then_body, local_names, local_types, table, views, heads)
                            storage_view_collect_field_element_views(else_body, local_names, local_types, table, views, heads)
                        Stmt.While(condition, body, line):
                            storage_view_collect_field_element_views(body, local_names, local_types, table, views, heads)
                        Stmt.For(bind, variables, iterable, body, line):
                            storage_view_collect_field_element_views(body, local_names, local_types, table, views, heads)
                        Stmt.Block(kind, clause, binding, body, line):
                            storage_view_collect_field_element_views(body, local_names, local_types, table, views, heads)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |local_names, local_types, table, views, heads|:
                                storage_view_collect_field_element_views(arm.body, local_names, local_types, table, views, heads)
                        _:
                            pass

        def storage_view_strip_paren_move(expression: Ast::Expr) -> Ast::Expr:
            current: mutable Ast::Expr = expression
            while true:
                match current:
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        current <- inner
                    _:
                        return current
            return current

        def storage_view_same_place(left: Ast::Expr, right: Ast::Expr) -> bool:
            can Abort.Panic:
                match left:
                    Expr.Ident(left_name, left_line):
                        match right:
                            Expr.Ident(right_name, right_line):
                                return left_name == right_name
                            _:
                                return false
                    Expr.Field(left_object, left_field, left_line):
                        match right:
                            Expr.Field(right_object, right_field, right_line):
                                return left_field == right_field and storage_view_same_place(left_object, right_object)
                            _:
                                return false
                    _:
                        return false

        # Whether PLACE is CHAIN or one of its receivers: replacing `s` or `s.items` releases
        # the buffer `s.items` points at; replacing `s.n` does not.
        def storage_view_place_encloses(place: Ast::Expr, chain: Ast::Expr) -> bool:
            can Abort.Panic:
                current: mutable Ast::Expr = chain
                while true:
                    return true if storage_view_same_place(place, current)
                    match current:
                        Expr.Field(object, field, line):
                            current <- object
                        _:
                            return false
                return false

        def invalidate_replaced_field_element_views(target: Ast::Expr, operator: TokenKind, field_views: darray[sview]&, field_view_heads: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if operator != TokenKind.Assign and operator != TokenKind.LArrow
                return if not (target is Expr.Ident(_, _)) and not (target is Expr.Field(_, _, _))
                root: sview = storage_view_place_root(target)
                return if root == ""
                for index in 0..<field_views.count |field_views, field_view_heads, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, target, root|:
                    view: sview = field_views[index]
                    if index < field_view_heads.count and not fresh_wrapper_name_exists(invalidated, view) and storage_view_place_encloses(target, field_view_heads[index]):
                        live: mutable bool = false
                        for row in 0..<alias_names.count |live, alias_names, alias_sources, alias_is_view, view, root|:
                            live <- true if alias_names[row] == view and row < alias_sources.count and alias_sources[row] == root and row < alias_is_view.count and alias_is_view[row]
                        if live:
                            invalidated.push(view)
                            invalidated_by.push("") if invalidated.count > invalidated_by.count

        # Unlike growth, a replacement is not saved by a stable backing (the old buffer is
        # released, not extended) and does not follow value aliases: `ys <- xs_copy` replaces
        # `ys` only. The target's own row is skipped, since `xs <- [h for h in xs]` rebuilds it.
        # `p <- P{..}` / `p.storage <- []` releases the buffer a view of the darray field
        # `p.storage` points into (stage0 invalidateStorageViewsForSourceScoped on a
        # reassignment). Only rows carrying a "[field]" marker over a darray field with a
        # concrete element type qualify, so a view read out of an sview field (`t: sview =
        # p.name`) does not depend on the root. Replacing a sibling field spares the view under
        # the same disjoint-element rule as growth. A value that mentions the root keeps it.
        def invalidate_replaced_field_views(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, field_elems: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if operator != TokenKind.Assign and operator != TokenKind.LArrow
                root: mutable sview = ident_name_of(target)
                target_field: sview = storage_view_direct_field(target)
                match target:
                    Expr.Field(object, field, field_line):
                        root <- ident_name_of(object)
                    _:
                        pass
                return if root == "" or expr_mentions_name(value, root)
                for index in 1..<alias_sources.count |alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, field_elems, root, target_field|:
                    if alias_sources[index] == root and alias_names[index - 1] == "[field]" and index < alias_is_view.count and alias_is_view[index] and alias_names[index] != root:
                        view_field: sview = alias_sources[index - 1]
                        if storage_view_field_elem(root, view_field, field_elems) != "" and not storage_view_row_spared(index, root, target_field, field_elems, alias_names, alias_sources) and not fresh_wrapper_name_exists(invalidated, alias_names[index]):
                            invalidated.push(alias_names[index])
                            invalidated_by.push("") if invalidated.count > invalidated_by.count

        def invalidate_replaced_container_views(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, replace_names: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if operator != TokenKind.Assign and operator != TokenKind.LArrow
                container: mutable sview =
                    match target:
                        Expr.Ident(name, line):
                            name
                        _:
                            sview("", 0, 0)
                # An element replacement `grid[i] <- [..]` of a darray whose elements own a buffer.
                match target:
                    Expr.Index(object, index_value, index_line):
                        element_owner: sview = ident_name_of(object)
                        container <- element_owner if element_owner != "" and storage_view_has_element_marker(alias_names, alias_sources, element_owner)
                    _:
                        pass
                return if container == "" or not fresh_wrapper_name_exists(replace_names, container)
                return if storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view)
                for source in alias_sources |index: usize = 0, invalidated, invalidated_by, alias_names, alias_is_view, container|:
                    if source == container and index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and alias_names[index] != container and not fresh_wrapper_name_exists(invalidated, alias_names[index]):
                        invalidated.push(alias_names[index])
                        # An empty invalidator renders the replacement-neutral wording; the
                        # "darray push of" sentence would name the wrong mutation.
                        invalidated_by.push("") if invalidated.count > invalidated_by.count
                    index <- index + 1

        # A declaration introduces a new binding, so an invalidation recorded against an earlier
        # binding of the same name no longer applies to later uses. The walk that owns the
        # declaring body restores the marks on exit (`storage_view_restore_invalidated`), so an
        # inner shadowing declaration cannot hide an invalidated outer binding.
        def storage_view_forget_invalidated(name: sview, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not fresh_wrapper_name_exists(invalidated, name)
                kept: mutable darray[sview] = []
                kept_by: mutable darray[sview] = []
                for index in 0..<invalidated.count |kept, kept_by, invalidated, invalidated_by, name|:
                    if invalidated[index] != name:
                        kept.push(invalidated[index])
                        kept_by.push(invalidated_by[index]) if index < invalidated_by.count
                invalidated.truncate(0)
                invalidated_by.truncate(0)
                for index in 0..<kept.count |kept, kept_by, invalidated, invalidated_by|:
                    invalidated.push(kept[index])
                    invalidated_by.push(kept_by[index]) if index < kept_by.count

        def storage_view_restore_invalidated(saved: darray[sview]&, saved_by: darray[sview]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<saved.count |saved, saved_by, invalidated, invalidated_by|:
                    if not fresh_wrapper_name_exists(invalidated, saved[index]):
                        invalidated.push(saved[index])
                        invalidated_by.push(saved_by[index]) if index < saved_by.count and invalidated.count > invalidated_by.count

        # Whether control never reaches the end of STATEMENTS and never loops back from them:
        # the last statement returns, breaks or raises (or is an `if` whose branches both do)
        # and no `continue` of this loop appears. A `continue` is a back edge, not a leave.
        def storage_view_body_leaves(statements: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic:
                return false if statements.count == 0 or storage_view_body_continues(statements)
                return match statements[statements.count - 1]:
                    Stmt.Return(_, _): true
                    Stmt.Break(_, _): true
                    Stmt.Expr(exit_expression, _): affine_is_raise(exit_expression)
                    Stmt.If(_, then_body, else_body, _): storage_view_body_leaves(then_body) and storage_view_body_leaves(else_body)
                    Stmt.Block(_, _, _, block_body, _): storage_view_body_leaves(block_body)
                    _: false

        # Whether a `continue` of the enclosing loop appears in STATEMENTS (nested loops own
        # their own `continue`s).
        def storage_view_body_continues(statements: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Continue(_, _):
                            return true
                        Stmt.If(_, then_body, else_body, _):
                            true return if storage_view_body_continues(then_body) or storage_view_body_continues(else_body)
                        Stmt.Block(_, _, _, block_body, _):
                            true return if storage_view_body_continues(block_body)
                        Stmt.Match(_, arms, _):
                            for arm in arms:
                                true return if storage_view_body_continues(arm.body)
                        _:
                            pass
                return false

        # `r <- &xs[0]`: a plain assignment to a name whose value takes a fresh borrow rebinds the
        # view, so it is not a use of the old referent and clears the old invalidation.
        def storage_view_rebind_target(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return "" if operator != TokenKind.Assign and operator != TokenKind.LArrow
                match target:
                    Expr.Ident(name, line):
                        return name if storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view) else ""
                    _:
                        return ""

        def storage_view_borrow_is_local(value: Ast::Expr) -> bool:
            match value:
                Expr.Ident(_, _):
                    return true
                Expr.Field(object, _, _):
                    return storage_view_borrow_is_local(object)
                Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Unary(TokenKind.Ampersand, inner, _):
                    return storage_view_borrow_is_local(inner)
                Expr.Index(object, _, _):
                    match object:
                        Expr.Field(cast_object, method, _):
                            return method == "cast" and storage_view_borrow_is_local(cast_object)
                        Expr.Ident(_, _):
                            return true
                        _:
                            return false
                Expr.Call(callee, arguments, _, _):
                    match callee:
                        Expr.Field(receiver, _, _):
                            return false if not storage_view_borrow_is_local(receiver)
                        _:
                            pass
                    for argument in arguments:
                        match argument:
                            Expr.Unary(operator, operand, _):
                                return false if operator == TokenKind.Ampersand and not storage_view_borrow_is_local(operand)
                            _:
                                pass
                    return true
                _:
                    return false

        def storage_view_value_rebind_target(target: Ast::Expr, operator: TokenKind, value_names: darray[sview]&) -> sview:
            return "" if operator != TokenKind.Assign and operator != TokenKind.LArrow
            return match target:
                Expr.Ident(name, _):
                    name if fresh_wrapper_name_exists(value_names, name) else ""
                _:
                    ""

        # Locals and params declared with an explicit non-reference type. A name also bound
        # with a reference or inferred type anywhere in the function is left out.
        def storage_view_collect_value_names(names: darray[sview]&, types: darray[Ast::Expr]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                others: mutable darray[sview] = []
                for index in 0..<names.count |names, types, out, others|:
                    if index < types.count and not (types[index] is Expr.Absent) and not storage_view_type_is_reference(types[index]):
                        out.push(names[index])
                    else:
                        others.push(names[index])
                storage_view_drop_shadowed(out, others)

        def storage_view_snapshot(invalidated: darray[sview]&, invalidated_by: darray[sview]&, out: mutable darray[sview]&, out_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.truncate(0)
                out_by.truncate(0)
                for index in 0..<invalidated.count |invalidated, invalidated_by, out, out_by|:
                    out.push(invalidated[index])
                    out_by.push(invalidated_by[index]) if index < invalidated_by.count

        # Walk a branch that leaves the loop (or function): its invalidations never reach the
        # code after the branch or the loop's back edge, only the code after the loop, so they
        # are parked in EXIT_MARKS until the enclosing loop ends.
        def walk_region_storage_branch(body: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, view_fns: darray[sview]&, replace_names: darray[sview]&, value_names: darray[sview]&, field_elems: darray[sview]&, field_views: darray[sview]&, field_view_heads: darray[Ast::Expr]&, stable_regions: mutable darray[sview]&, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&, exit_marks: mutable darray[sview]&, exit_marks_by: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if not storage_view_body_leaves(body):
                    table <- walk_region_storage_stability(body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                    return
                before: mutable darray[sview] = []
                before_by: mutable darray[sview] = []
                storage_view_snapshot(invalidated, invalidated_by, before, before_by)
                table <- walk_region_storage_stability(body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                for index in 0..<invalidated.count |invalidated, invalidated_by, before, exit_marks, exit_marks_by|:
                    if not fresh_wrapper_name_exists(before, invalidated[index]) and not fresh_wrapper_name_exists(exit_marks, invalidated[index]):
                        exit_marks.push(invalidated[index])
                        exit_marks_by.push(invalidated_by[index]) if index < invalidated_by.count and exit_marks.count > exit_marks_by.count
                storage_view_snapshot(before, before_by, invalidated, invalidated_by)

        def storage_view_already_reported(name: sview, line: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for diagnostic in table.diagnostics:
                    true return if diagnostic.kind == DiagnosticKind.StorageDependencyInvalidated and diagnostic.name == name and diagnostic.line == line
                return false

        # Record EXPRESSION's position in FOUND if it reads the view PROBE[0]; 1 when it does.
        def storage_view_loop_use(expression: Ast::Expr, probe: darray[sview]&, line: u32, found_pos: mutable darray[Ast::Pos]&, found_line: mutable darray[u32]&) -> u8:
            can Memory.Allocate, Abort.Panic:
                return 0 if invalidated_alias_in_expression(expression, probe) == ""
                found_pos.push(ident_extent_or_line(expression, line))
                found_line.push(line)
                return 1

        # Find the first read of the view PROBE[0] in STATEMENTS, in walk order: 1 = found (its
        # position is in FOUND), 2 = a declaration or rebind of the name ends this list first,
        # 0 = neither. A nested list's 2 only ends that list (the other path still continues).
        def storage_view_loop_first_use(statements: darray[Ast::Stmt], probe: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, found_pos: mutable darray[Ast::Pos]&, found_line: mutable darray[u32]&) -> u8:
            can Memory.Allocate, Abort.Panic:
                result: mutable u8 = 0
                for statement in statements |result, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line|:
                    break if result != 0
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            result <- storage_view_loop_use(value, probe, line.line, found_pos, found_line)
                            result <- 2 if result == 0 and name == probe[0]
                        Stmt.Expr(expression, line):
                            result <- storage_view_loop_use(expression, probe, line.line, found_pos, found_line)
                            match expression:
                                Expr.Block(block_statements, value, captures, block_line):
                                    result <- 1 if result == 0 and storage_view_loop_first_use(block_statements, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) == 1
                                _:
                                    pass
                        Stmt.Assign(target, operator, value, line):
                            rebound: sview = storage_view_rebind_target(target, operator, value, alias_names, alias_sources, alias_is_view)
                            result <- storage_view_loop_use(target, probe, line.line, found_pos, found_line) if rebound == ""
                            result <- storage_view_loop_use(value, probe, line.line, found_pos, found_line) if result == 0
                            result <- 2 if result == 0 and rebound == probe[0]
                        Stmt.Return(value, line):
                            result <- storage_view_loop_use(returned, probe, line.line, found_pos, found_line) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            result <- storage_view_loop_use(condition, probe, line.line, found_pos, found_line)
                            result <- 1 if result == 0 and storage_view_loop_first_use(then_body, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) == 1
                            result <- 1 if result == 0 and storage_view_loop_first_use(else_body, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) == 1
                        Stmt.While(condition, while_body, line):
                            result <- storage_view_loop_use(condition, probe, line.line, found_pos, found_line)
                            result <- 1 if result == 0 and storage_view_loop_first_use(while_body, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) == 1
                        Stmt.For(bind, variables, iterable, for_body, line):
                            result <- storage_view_loop_use(iterable, probe, line.line, found_pos, found_line)
                            result <- 1 if result == 0 and storage_view_loop_first_use(for_body, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) == 1
                        Stmt.Match(scrutinee, arms, line):
                            result <- storage_view_loop_use(scrutinee, probe, line.line, found_pos, found_line)
                            for arm in arms |result, probe, alias_names, alias_is_view, found_pos, found_line|:
                                result <- 1 if result == 0 and storage_view_loop_first_use(arm.body, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) == 1
                        Stmt.Block(kind, clause, binding, block_body, line):
                            result <- 1 if storage_view_loop_first_use(block_body, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) == 1
                        _:
                            pass
                return result

        # A loop body runs again after its last statement: a view that the body invalidated (and
        # did not rebind afterwards) is stale when the next iteration reaches its first read. The
        # walk sees that read once, before the growth, so the back edge is checked here. BEFORE
        # holds the marks at loop entry; CONDITION is re-evaluated each iteration (a `while`).
        def check_storage_view_loop_back_edge(body: darray[Ast::Stmt], condition: Ast::Expr, has_condition: bool, loop_line: u32, before: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: darray[sview]&, invalidated_by: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if storage_view_body_leaves(body)
                for index in 0..<invalidated.count |table, body, condition, before, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by|:
                    if not fresh_wrapper_name_exists(before, invalidated[index]):
                        probe: mutable darray[sview] = [invalidated[index]]
                        found_pos: mutable darray[Ast::Pos] = []
                        found_line: mutable darray[u32] = []
                        found: u8 = storage_view_loop_use(condition, probe, loop_line, found_pos, found_line) if has_condition else 0
                        rest: u8 = storage_view_loop_first_use(body, probe, alias_names, alias_sources, alias_is_view, found_pos, found_line) if found == 0 else 0
                        by: sview = invalidated_by[index] if index < invalidated_by.count else ""
                        if found_pos.count > 0 and not storage_view_already_reported(probe[0], found_line[0], table):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StorageDependencyInvalidated, name: probe[0], pos: found_pos[0], line: found_line[0], expected: by, actual: ""})

        # The task operands submitted anywhere inside a `nursery:`/`pool:` body. `submit f(v)`
        # parses as a statement-less value block around the call (so does `await t`, whose
        # operand is a task handle rather than a view, so including it cannot add a report).
        def storage_view_collect_submits(statements: darray[Ast::Stmt]&, out: mutable darray[Ast::Expr]&, out_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out, out_lines|:
                    match statement:
                        Stmt.Expr(expression, line):
                            storage_view_collect_submit_expr(expression, line.line, out, out_lines)
                        Stmt.VarDecl(name, type_expression, value, line):
                            storage_view_collect_submit_expr(value, line.line, out, out_lines)
                        Stmt.Assign(target, operator, value, line):
                            storage_view_collect_submit_expr(value, line.line, out, out_lines)
                        Stmt.If(condition, then_body, else_body, line):
                            storage_view_collect_submits(then_body, out, out_lines)
                            storage_view_collect_submits(else_body, out, out_lines)
                        Stmt.While(condition, while_body, line):
                            storage_view_collect_submits(while_body, out, out_lines)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            storage_view_collect_submits(for_body, out, out_lines)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out, out_lines|:
                                storage_view_collect_submits(arm.body, out, out_lines)
                        Stmt.Block(kind, clause, binding, body, line):
                            storage_view_collect_submits(body, out, out_lines)
                        _:
                            pass

        def storage_view_collect_submit_expr(expression: Ast::Expr, line: u32, out: mutable darray[Ast::Expr]&, out_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Block(block_statements, block_value, block_captures, block_line):
                        if block_statements.count == 0:
                            out.push(block_value)
                            out_lines.push(line)
                    _:
                        pass

        # A payload binder of an enum value that carries a view (`t: Tok =
        # Tok.Word(buf.as_sview())`, then `match t: Tok.Word(text)` or `t is
        # Tok.Word(text)`) borrows the same storage, so it inherits the scrutinee's view
        # rows (stage0 enterVariantPayloadPattern). Scalar payload fields copy out.
        def storage_view_payload_field_is_scalar(variant: sview, position: usize, table: SymbolTable&) -> bool:
            can Abort.Panic:
                seen: mutable bool = false
                for row in 0..<table.enum_payload_owner.count |seen, variant, position, table|:
                    if row < table.enum_payload_variant.count and table.enum_payload_variant[row] == variant and row < table.enum_payload_position.count and table.enum_payload_position[row].usize() == position:
                        type_id: u32 = table.enum_payload_type_id[row] if row < table.enum_payload_type_id.count else 0
                        return false if not storage_scalar_pointee(type_id, table)
                        seen <- true
                return seen

        def storage_view_bind_payload_name(name: sview, root: sview, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or root == "" or name == root
                count: usize = alias_names.count
                for index in 0..<count |name, root, alias_names, alias_sources, alias_is_view|:
                    if alias_names[index] == root and index < alias_sources.count and index < alias_is_view.count and alias_is_view[index]:
                        alias_names.push(name)
                        alias_sources.push(alias_sources[index])
                        alias_is_view.push(true)

        def storage_view_bind_payload_pattern(pattern: Ast::Pattern, root: sview, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Variant(path, fields):
                        variant: sview = pag_pattern_terminal_name(path)
                        for position in 0..<fields.count |fields, variant, root, alias_names, alias_sources, alias_is_view, table|:
                            match fields[position]:
                                Pattern.Binding(name):
                                    storage_view_bind_payload_name(name, root, alias_names, alias_sources, alias_is_view) if not storage_view_payload_field_is_scalar(variant, position, table)
                                _:
                                    storage_view_bind_payload_pattern(fields[position], root, alias_names, alias_sources, alias_is_view, table)
                    Pattern.As(name, inner):
                        storage_view_bind_payload_name(name, root, alias_names, alias_sources, alias_is_view)
                        for nested in inner |root, alias_names, alias_sources, alias_is_view, table|:
                            storage_view_bind_payload_pattern(nested, root, alias_names, alias_sources, alias_is_view, table)
                    Pattern.Or(options):
                        for nested in options |root, alias_names, alias_sources, alias_is_view, table|:
                            storage_view_bind_payload_pattern(nested, root, alias_names, alias_sources, alias_is_view, table)
                    _:
                        pass

        def storage_view_callee_terminal(callee: Ast::Expr) -> sview:
            match callee:
                Expr.Ident(name, _): return name
                Expr.Field(_, field, _) | Expr.Scope(_, field, _): return field
                _: return ""

        def storage_view_bind_payload_condition(condition: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Is:
                            match right:
                                Expr.Call(callee, arguments, argument_names, call_line):
                                    variant: sview = storage_view_callee_terminal(callee)
                                    root: sview = storage_view_place_root(left)
                                    for position in 0..<arguments.count |arguments, variant, root, alias_names, alias_sources, alias_is_view, table|:
                                        match arguments[position]:
                                            Expr.Ident(name, _):
                                                storage_view_bind_payload_name(name, root, alias_names, alias_sources, alias_is_view) if not storage_view_payload_field_is_scalar(variant, position, table)
                                            _:
                                                pass
                                _:
                                    pass
                        else:
                            storage_view_bind_payload_condition(left, alias_names, alias_sources, alias_is_view, table)
                            storage_view_bind_payload_condition(right, alias_names, alias_sources, alias_is_view, table)
                    _:
                        pass

        def walk_region_storage_stability(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, view_fns: darray[sview]&, replace_names: darray[sview]&, value_names: darray[sview]&, field_elems: darray[sview]&, field_views: darray[sview]&, field_view_heads: darray[Ast::Expr]&, stable_regions: mutable darray[sview]&, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&, exit_marks: mutable darray[sview]&, exit_marks_by: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                loop_entry: mutable darray[sview] = []
                loop_entry_by: mutable darray[sview] = []
                saved_invalidated: mutable darray[sview] = []
                saved_invalidated_by: mutable darray[sview] = []
                for index in 0..<invalidated.count |saved_invalidated, saved_invalidated_by, invalidated, invalidated_by|:
                    saved_invalidated.push(invalidated[index])
                    saved_invalidated_by.push(invalidated_by[index]) if index < invalidated_by.count
                for statement in statements |stable_regions, alias_names, alias_sources, alias_is_view, invalidated, table, exit_marks, exit_marks_by, loop_entry, loop_entry_by|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            has_stable_backing: bool = kind == "region" and (destroyed_region_contains(clause, "reserve_commit") or destroyed_region_contains(clause, "fixed"))
                            stable_region: mutable sview = binding
                            # Block-form regions keep the name in clause[0] and leave the
                            # generic binding slot empty; statement-form regions do the reverse.
                            stable_region <- clause[0] if stable_region == "" and has_stable_backing and clause.count > 0
                            stable_regions.push(stable_region) if stable_region != "" and has_stable_backing and not destroyed_region_contains(stable_regions, stable_region)
                            table <- walk_region_storage_stability(body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                            # A view handed to a task stays live until the nursery/pool joins, so
                            # growing its backing anywhere later in the body (even after the
                            # submit) races the worker's read. Re-check every submitted operand
                            # against the state at the join and report at the submit site
                            # (stage0 analyzePoolStmt JoinedViews).
                            if kind == "nursery" or kind == "pool":
                                submitted: mutable darray[Ast::Expr] = []
                                submitted_lines: mutable darray[u32] = []
                                storage_view_collect_submits(body, submitted, submitted_lines)
                                for submit_index in 0..<submitted.count |table, submitted, submitted_lines|:
                                    stale: sview = invalidated_alias_in_expression(submitted[submit_index], invalidated)
                                    table <- diagnose_invalidated_alias(submitted[submit_index], invalidated, invalidated_by, submitted_lines[submit_index], table) if stale != "" and not storage_view_already_reported(stale, submitted_lines[submit_index], table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- diagnose_invalidated_alias(value, invalidated, invalidated_by, line.line, table)
                            invalidate_growth_aliases(growth_call_target(value), growth_call_target_field(value), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                            invalidate_callee_relocations(value, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            storage_view_forget_invalidated(name, invalidated, invalidated_by)
                            storage_view_record_typed_alias(name, type_expression, value, alias_names, alias_sources, alias_is_view, view_fns)
                            storage_view_inherit_held(name, value, alias_names, alias_sources, alias_is_view)
                        Stmt.Expr(expression, line):
                            table <- diagnose_invalidated_alias(expression, invalidated, invalidated_by, line.line, table)
                            invalidate_growth_aliases(growth_call_target(expression), growth_call_target_field(expression), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                            invalidate_callee_relocations(expression, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            storage_view_record_container_store(expression, alias_names, alias_sources, alias_is_view, view_fns)
                            match expression:
                                Expr.Block(statements, value, captures, block_line):
                                    table <- walk_region_storage_stability(statements, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                                _:
                                    pass
                        Stmt.Assign(target, operator, value, line):
                            invalidate_growth_aliases(growth_call_target(target), growth_call_target_field(target), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                            invalidate_growth_aliases(growth_call_target(value), growth_call_target_field(value), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                            invalidate_callee_relocations(value, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            invalidate_growth_aliases(growth_call_target(collection_append_call(target, value, line)), growth_call_target_field(collection_append_call(target, value, line)), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if operator == TokenKind.PlusEq
                            rebound: sview = storage_view_rebind_target(target, operator, value, alias_names, alias_sources, alias_is_view)
                            # `<-` into a local declared with a non-reference type (`name: mutable
                            # cstr`) always rebinds it: there is no referent to write through, so a
                            # stale old value is not used (`name <- fill(storage)` after growth).
                            value_rebound: sview = storage_view_value_rebind_target(target, operator, value_names)
                            table <- diagnose_invalidated_alias(target, invalidated, invalidated_by, line.line, table) if rebound == "" and value_rebound == ""
                            table <- diagnose_invalidated_alias(value, invalidated, invalidated_by, line.line, table)
                            storage_view_forget_invalidated(rebound, invalidated, invalidated_by) if rebound != ""
                            storage_view_forget_invalidated(value_rebound, invalidated, invalidated_by) if value_rebound != "" and rebound == ""
                            invalidate_replaced_container_views(target, operator, value, replace_names, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if rebound == ""
                            invalidate_replaced_field_views(target, operator, value, field_elems, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if rebound == ""
                            invalidate_replaced_field_element_views(target, operator, field_views, field_view_heads, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if rebound == ""
                            # `rebind n: i64, p = p.lgrow()` lowers to `[n, p] = call`: every bare
                            # target is REPLACED by the threaded result exactly as `p <- p.lgrow()`
                            # replaces `p`, so views into the old value die (fuzz F6). The
                            # replacement helpers key on a bare Ident target; feed them each one.
                            match target:
                                Expr.Array(rebind_targets, rebind_line):
                                    for rebind_target in rebind_targets |replace_names, field_elems, field_views, field_view_heads, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by|:
                                        invalidate_replaced_container_views(rebind_target, TokenKind.LArrow, value, replace_names, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                        invalidate_replaced_field_views(rebind_target, TokenKind.LArrow, value, field_elems, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                        invalidate_replaced_field_element_views(rebind_target, TokenKind.LArrow, field_views, field_view_heads, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                        # The threaded result mentions the target (`lgrow(p)`), which
                                        # the helpers above read as "the new value still borrows it"
                                        # and skip. An lmut call may reallocate every buffer of the old
                                        # value, so drop each view of it outright.
                                        storage_view_invalidate_rebound_views(ident_name_of(rebind_target), alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                _:
                                    pass
                            # `<-` of a plain value into a whole local (`t <- s`, `vs <- [s]`) re-aliases
                            # it; a field/element store is not a rebind of the root. A
                            # `<-` of a view-producing CALL is left untracked: the walk cannot tell a
                            # loop body from straight-line code, and stage0 skips loop-body rebinds.
                            # A `<-` whose value takes a fresh borrow of a local or a field path
                            # (`s <- buf.as_sview()`, `c <- (&buf[0]).cast[cstr]`, `name <-
                            # bytes_view_range(p.storage, ..)`) rebinds the view onto it. A field
                            # path carries a "[field]" marker so a sibling of another element
                            # type (`p.names.push`) does not invalidate it.
                            larrow_alias: bool = operator == TokenKind.LArrow and (target is Expr.Ident(_, _)) and (value is Expr.Ident(_, _) or value is Expr.Array(_, _) or value is Expr.Tuple(_, _) or (storage_view_borrow_is_local(value) and storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view)))
                            storage_view_record_alias(storage_view_place_root(target), value, alias_names, alias_sources, alias_is_view, view_fns) if operator == TokenKind.Assign or larrow_alias
                            if operator == TokenKind.Assign or operator == TokenKind.LArrow:
                                match target:
                                    Expr.Ident(target_name, _):
                                        storage_view_inherit_held(target_name, value, alias_names, alias_sources, alias_is_view)
                                    _:
                                        storage_view_record_place_store(target, value, alias_names, alias_sources, alias_is_view, view_fns)
                        Stmt.Return(value, line):
                            table <- diagnose_invalidated_alias(returned, invalidated, invalidated_by, line.line, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- diagnose_invalidated_alias(condition, invalidated, invalidated_by, line.line, table)
                            storage_view_bind_payload_condition(condition, alias_names, alias_sources, alias_is_view, table)
                            table <- walk_region_storage_branch(then_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                            table <- walk_region_storage_branch(else_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                        Stmt.While(condition, while_body, line):
                            table <- diagnose_invalidated_alias(condition, invalidated, invalidated_by, line.line, table)
                            storage_view_snapshot(invalidated, invalidated_by, loop_entry, loop_entry_by)
                            loop_exit: mutable darray[sview] = []
                            loop_exit_by: mutable darray[sview] = []
                            aliases_before: usize = alias_names.count
                            table <- walk_region_storage_stability(while_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, loop_exit, loop_exit_by, table)
                            table <- check_storage_view_loop_back_edge(while_body, condition, true, line.line, loop_entry, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            table <- storage_view_rewalk_loop_body(while_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, aliases_before, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            storage_view_restore_invalidated(loop_exit, loop_exit_by, invalidated, invalidated_by)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- diagnose_invalidated_alias(iterable, invalidated, invalidated_by, line.line, table)
                            storage_view_snapshot(invalidated, invalidated_by, loop_entry, loop_entry_by)
                            loop_exit: mutable darray[sview] = []
                            loop_exit_by: mutable darray[sview] = []
                            aliases_before: usize = alias_names.count
                            table <- walk_region_storage_stability(for_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, loop_exit, loop_exit_by, table)
                            table <- check_storage_view_loop_back_edge(for_body, iterable, false, line.line, loop_entry, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            table <- storage_view_rewalk_loop_body(for_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, aliases_before, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            storage_view_restore_invalidated(loop_exit, loop_exit_by, invalidated, invalidated_by)
                        Stmt.Match(scrutinee, arms, line):
                            table <- diagnose_invalidated_alias(scrutinee, invalidated, invalidated_by, line.line, table)
                            for arm in arms |table, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by| -> table:
                                storage_view_bind_payload_pattern(arm.pattern, storage_view_place_root(scrutinee), alias_names, alias_sources, alias_is_view, table)
                                table <- walk_region_storage_branch(arm.body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                        _:
                            pass
                storage_view_restore_invalidated(saved_invalidated, saved_invalidated_by, invalidated, invalidated_by)

        def check_region_storage_stability_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            stable_regions: mutable darray[sview] = []
                            alias_names: mutable darray[sview] = []
                            alias_sources: mutable darray[sview] = []
                            alias_is_view: mutable darray[bool] = []
                            invalidated: mutable darray[sview] = []
                            invalidated_by: mutable darray[sview] = []
                            exit_marks: mutable darray[sview] = []
                            exit_marks_by: mutable darray[sview] = []
                            replace_names: mutable darray[sview] = []
                            other_names: mutable darray[sview] = []
                            # ("[param]", name) marker rows: a call-derived view whose origin is a
                            # borrowed PARAMETER is not tracked (see storage_view_call_origin_sources).
                            for param in params |alias_names, alias_sources, alias_is_view|:
                                alias_names.push("[param]")
                                alias_sources.push(param.name)
                                alias_is_view.push(false)
                            for param in params |replace_names, other_names|:
                                if not param.is_mutable and storage_view_type_is_replaceable(param.type_expression, true):
                                    replace_names.push(param.name)
                                else:
                                    other_names.push(param.name)
                            storage_view_collect_replaceable(body, replace_names, other_names)
                            storage_view_drop_shadowed(replace_names, other_names)
                            local_names: mutable darray[sview] = []
                            local_types: mutable darray[Ast::Expr] = []
                            for param in params |local_names, local_types|:
                                local_names.push(param.name)
                                local_types.push(param.type_expression)
                            storage_view_collect_local_types(body, local_names, local_types)
                            value_names: mutable darray[sview] = []
                            storage_view_collect_value_names(local_names, local_types, value_names)
                            field_views: mutable darray[sview] = []
                            field_view_heads: mutable darray[Ast::Expr] = []
                            storage_view_collect_field_element_views(body, local_names, local_types, table, field_views, field_view_heads)
                            field_elems: mutable darray[sview] = []
                            storage_view_collect_field_elems(local_names, local_types, table, field_elems)
                            table <- walk_region_storage_stability(body, annotations, line.line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table)
                        Decl.Module(name, body, line):
                            table <- check_region_storage_stability_declarations(body, annotations, view_fns, table)
                        Decl.Scoped(body, line):
                            table <- check_region_storage_stability_declarations(body, annotations, view_fns, table)
                        _:
                            pass

    public:
        def check_region_storage_stability(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                view_fns: mutable darray[sview] = view_return_origin_rows(file)
                # `[owned-fn]` rows: functions returning a fresh borrow-free value (not view summaries).
                storage_owned_fn_rows(file, &view_fns)
                # The summary lives in this call's inferred region, so each row's bytes are
                # copied into text_storage (which never reallocates). If they do not all
                # fit, no callee is summarised and every call keeps the whole-root rule.
                growth_rows: darray[sview] = param_growth_rows(file, table)
                needed: mutable usize = 0
                for row in growth_rows |needed|:
                    needed <- needed + row.len
                fits: bool = table.text_storage.count + needed <= 65536.usize()
                # Copy every row first (offsets), then view them once text_storage stops growing.
                row_starts: mutable darray[usize] = []
                for row in growth_rows |table, row_starts| -> table:
                    if fits:
                        row_starts.push(table.text_storage.count)
                        for index in 0..<row.len |table| -> table:
                            table.text_storage.push(row[index])
                for row_index in 0..<row_starts.count |table| -> table:
                    table.param_growth_rows <- table.param_growth_rows.push(bytes_view_range(table.text_storage, row_starts[row_index], growth_rows[row_index].len))
                table <- check_region_storage_stability_declarations(file.top_decls, file.local_region_annotations, view_fns, table)
