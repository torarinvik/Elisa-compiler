extend Semantic:
    private:
        def interior_reference_source(expression: Ast::Expr) -> sview:
            if expression is Expr.Unary(operator, operand, line):
                "" return if operator != TokenKind.Ampersand
                if operand is Expr.Index(object, index, index_line):
                    if object is Expr.Ident(name, ident_line):
                        return name
            return ""

        def growth_call_target(expression: Ast::Expr) -> sview:
            if expression is Expr.Call(callee, arguments, argument_names, line):
                if callee is Expr.Field(receiver, method, field_line):
                    if receiver is Expr.Ident(name, ident_line):
                        return name if method in {"push", "append", "append_many", "resize"} else ""
            return ""

        def invalidated_alias_in_expression(expression: Ast::Expr, invalidated: darray[sview]&) -> sview:
            if expression is Expr.Ident(name, line):
                return name if fresh_wrapper_name_exists(invalidated, name) else ""
            if expression is Expr.Field(receiver, field, line):
                return invalidated_alias_in_expression(receiver, invalidated)
            if expression is Expr.Index(object, index, line):
                return invalidated_alias_in_expression(object, invalidated)
            if expression is Expr.IndexN(object, arguments, line):
                return invalidated_alias_in_expression(object, invalidated)
            if expression is Expr.Unary(operator, operand, line):
                return invalidated_alias_in_expression(operand, invalidated)
            if expression is Expr.Paren(inner, line):
                return invalidated_alias_in_expression(inner, invalidated)
            return ""

        def diagnose_invalidated_alias(expression: Ast::Expr, invalidated: darray[sview]&, invalidated_by: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias: sview = invalidated_alias_in_expression(expression, invalidated)
                by: sview =
                    for candidate_index in 0..<invalidated.count |by: sview = ""| -> by:
                        by <- invalidated_by[candidate_index] if invalidated[candidate_index] == alias and candidate_index < invalidated_by.count
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StorageDependencyInvalidated, name: alias, line: line, expected: by, actual: ""}) if alias != ""

        def invalidate_growth_aliases(target: sview, function_line: u32, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&, chained_regions: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                region: sview = function_region_of_name(annotations, target, function_line, line)
                return if target == "" or not destroyed_region_contains(chained_regions, region)
                for source in alias_sources |index: usize = 0, invalidated|:
                    invalidated.push(alias_names[index]) if source == target and not fresh_wrapper_name_exists(invalidated, alias_names[index])
                    invalidated_by.push(target) if source == target and invalidated_by.count < invalidated.count
                    index <- index + 1

        def walk_region_storage_stability(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, chained_regions: mutable darray[sview]&, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |chained_regions, alias_names, alias_sources, invalidated, table|:
                    match statement:
                        Stmt.Block("region", clause, binding, body, line):
                            chained_regions.push(binding) if destroyed_region_contains(clause, "chained") and not destroyed_region_contains(chained_regions, binding)
                            table <- walk_region_storage_stability(body, annotations, function_line, chained_regions, alias_names, alias_sources, invalidated, invalidated_by, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- diagnose_invalidated_alias(value, invalidated, invalidated_by, line, table)
                            source: sview = interior_reference_source(value)
                            alias_names.push(name) if source != ""
                            alias_sources.push(source) if source != ""
                        Stmt.Expr(expression, line):
                            table <- diagnose_invalidated_alias(expression, invalidated, invalidated_by, line, table)
                            invalidate_growth_aliases(growth_call_target(expression), function_line, line, annotations, chained_regions, alias_names, alias_sources, invalidated, invalidated_by)
                        Stmt.Assign(target, operator, value, line):
                            table <- diagnose_invalidated_alias(value, invalidated, invalidated_by, line, table)
                        Stmt.Return(value, line):
                            table <- diagnose_invalidated_alias(returned, invalidated, invalidated_by, line, table) if value is returned
                        _:
                            pass

        def check_region_storage_stability_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    if declaration is Decl.Func(name, params, return_type, body, effects, decorators, line):
                        chained_regions: mutable darray[sview] = []
                        alias_names: mutable darray[sview] = []
                        alias_sources: mutable darray[sview] = []
                        invalidated: mutable darray[sview] = []
                        invalidated_by: mutable darray[sview] = []
                        table <- walk_region_storage_stability(body, annotations, line, chained_regions, alias_names, alias_sources, invalidated, invalidated_by, table)
                    elif declaration is Decl.Module(name, body, line):
                        table <- check_region_storage_stability_declarations(body, annotations, table)
                    elif declaration is Decl.Scoped(body, line):
                        table <- check_region_storage_stability_declarations(body, annotations, table)

    public:
        def check_region_storage_stability(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_region_storage_stability_declarations(file.top_decls, file.local_region_annotations, table)
