extend Semantic:
    private:
        # A semantic projection of call origins; this is an ordinary record, not an AST node.
        struct StorageViewOriginProjection:
            value: Ast::Expr
            into_arguments: darray[Ast::Expr]
            carry_arguments: darray[Ast::Expr]
            into_fields: darray[sview @source]
            carry_fields: darray[sview @source]
            projected: bool

        # The root of the container addressed by `&place` when PLACE is an index into it:
        # `&xs[i]` -> "xs", `&bag.items[i]` -> "bag" (stage0 keys the latter on "bag.items"
        # and matches a mutation of "bag"; keying on the root is the conservative superset).
        # Parentheses and `move` are transparent here, matching stage0's optimization-paren
        # stripping before it classifies an interior borrow.
        def interior_reference_place(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Paren(inner, line):
                    return interior_reference_place(inner)
                Expr.Move(inner, line):
                    return interior_reference_place(inner)
                Expr.Index(object, index, index_line):
                    return storage_view_place_root(object)
                _:
                    pass
            return ""

        def interior_reference_source(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Unary(operator, operand, line):
                    return interior_reference_place(operand) if operator == TokenKind.Ampersand else ""
                Expr.Paren(inner, line):
                    return interior_reference_source(inner)
                Expr.Move(inner, line):
                    return interior_reference_source(inner)
                _:
                    pass
            return ""

        def storage_view_place_root(expression: Ast::Expr) -> sview:
            current: mutable Ast::Expr = expression
            while true:
                match current:
                    Expr.Ident(name, line): return name
                    Expr.Field(object, field, line):
                        current <- object
                    Expr.Index(object, index, line):
                        current <- object
                    Expr.IndexN(object, indices, line):
                        current <- object
                    Expr.Slice(object, start, end, line):
                        current <- object
                    Expr.Paren(inner, line) | Expr.Move(inner, line) | Expr.Unary(TokenKind.Ampersand, inner, line):
                        current <- inner
                    _:
                        return ""
            return ""

        def storage_view_root_is_param(root: sview, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&) -> bool:
            can Abort.Panic:
                for index in 0..<alias_names.count |root, alias_names, alias_sources|:
                    return true if alias_names[index] == "[param]" and index < alias_sources.count and alias_sources[index] == root
                return false

        def storage_view_push_source(source: sview @source, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.push(source) if source != "" and source != "[held]" and not any existing in out where existing == source

        def storage_view_append_value_sources(expression: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line) | Expr.Field(_, _, line) | Expr.Index(_, _, line) | Expr.IndexN(_, _, line) | Expr.Slice(_, _, _, line) | Expr.Paren(_, line) | Expr.Move(_, line) | Expr.Unary(_, _, line):
                        storage_view_sources_from_argument(expression, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    # A tuple literal holding a view keeps that view's backing alive under the
                    # tuple's name: `t = (1, buf[0:1])` then `buf <- [..]` leaves `t.f`
                    # dangling (fuzz F5), exactly as a struct field does. (An ARRAY literal
                    # copies its elements into a fresh buffer, so it is not included.)
                    Expr.Tuple(elements, line):
                        for element in elements |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(element, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.RecordUpdate(base, fields, line):
                        storage_view_append_value_sources(base, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        # A value-returning helper can preserve an input container's backing.
                        # Until a verified return-alias summary exists, every place argument is
                        # a possible source; this only adds conservative invalidations.
                        for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_sources_from_argument(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_append_value_sources(then_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                        storage_view_append_value_sources(else_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    _:
                        storage_view_collect_sources(expression, alias_names, alias_sources, alias_is_view, view_fns, out)

        # A view-producing call inherits dependencies from its source arguments. An argument
        # already recorded as a view alias contributes its original backing containers.
        def storage_view_sources_from_argument(expression: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        found_alias: mutable bool = false
                        for alias_index in 0..<alias_names.count |found_alias, alias_names, alias_sources, name, out|:
                            if alias_names[alias_index] == name and alias_index < alias_sources.count:
                                storage_view_push_source(alias_sources[alias_index], out)
                                found_alias <- true
                        storage_view_push_source(name, out) if not found_alias
                    Expr.Unary(operator, operand, line):
                        borrowed_place: sview = storage_view_place_root(operand) if operator == TokenKind.Ampersand else ""
                        storage_view_push_source(borrowed_place, out) if borrowed_place != ""
                        storage_view_collect_sources(operand, alias_names, alias_sources, alias_is_view, view_fns, out) if borrowed_place == ""
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                        root: sview = storage_view_place_root(expression)
                        storage_view_push_source(root, out) if root != ""
                        storage_view_collect_sources(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        storage_view_sources_from_argument(inner, alias_names, alias_sources, alias_is_view, view_fns, out)
                    _:
                        storage_view_collect_sources(expression, alias_names, alias_sources, alias_is_view, view_fns, out)

        def storage_view_existing_alias_is_view(name: sview, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, alias_is_view: darray[bool]&) -> bool:
            # A "[held]"-marked row (a view stored INTO the container) does not make the
            # container itself a view. The result is existential, so a qualifying row can
            # return immediately instead of scanning the remaining alias history.
            for index in 0..<alias_names.count |alias_names, alias_sources, alias_is_view, name|:
                held_row: bool = index > 0 and alias_names[index - 1] == name and index - 1 < alias_sources.count and alias_sources[index - 1] == "[held]"
                return true if alias_names[index] == name and index < alias_is_view.count and alias_is_view[index] and not held_row
            return false

        def storage_view_expr_carries_borrow(expression: Ast::Expr, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, alias_is_view: darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                pending: mutable darray[Ast::Expr] = [expression]
                carries_borrow: mutable bool = false
                while index < pending.count and not carries_borrow |index: usize = 0, pending, carries_borrow, alias_names, alias_sources, alias_is_view|:
                    current: Ast::Expr = pending[index]
                    index <- index + 1
                    match current:
                        Expr.Ident(name, line):
                            carries_borrow <- storage_view_existing_alias_is_view(name, alias_names, alias_sources, alias_is_view)
                        Expr.Unary(operator, operand, line):
                            carries_borrow <- true if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                            pending.push(operand) if not carries_borrow
                        Expr.Paren(inner, line) | Expr.Move(inner, line):
                            pending.push(inner)
                        Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                            pending.push(object)
                        Expr.Call(callee, arguments, argument_names, line):
                            called: sview = ident_name_of(callee)
                            returns_view: mutable bool = called in {"bytes_view", "bytes_view_range", "bytes_view_range_ref", "sview", "string_view_slice", "string_view_prefix", "string_view_suffix", "darray_view", "arena_da_view", "readonly", "arena_da_view_slice", "arena_da_view_prefix", "arena_da_view_suffix", "slice", "read_view", "split"}
                            match callee:
                                Expr.Field(receiver, method, field_line):
                                    returns_view <- true if method == "view" or method == "as_sview" or method == "as_cstr"
                                _:
                                    pass
                            carries_borrow <- returns_view
                            if not carries_borrow:
                                for argument in arguments |pending|:
                                    pending.push(argument)
                        Expr.Binary(left, operator, right, line):
                            pending.push(left)
                            pending.push(right)
                        Expr.If(condition, then_value, else_value, line):
                            pending.push(then_value)
                            pending.push(else_value)
                        Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                            for element in elements |pending|:
                                pending.push(element)
                        Expr.DictLit(entries, line):
                            for entry in entries |pending|:
                                pending.push(entry.key)
                                pending.push(entry.value)
                        Expr.Comprehension(variable, iterable, condition, body, line, _):
                            pending.push(body)
                        Expr.Construct(type_expression, fields, line):
                            for field in fields |pending|:
                                pending.push(field.value)
                        Expr.RecordUpdate(base, fields, line):
                            pending.push(base)
                            for field in fields |pending|:
                                pending.push(field.value)
                        _:
                            pass
                return carries_borrow

        def storage_view_record_alias(name: sview @source, value: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                sources: mutable darray[sview @source] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                is_view_alias: bool = storage_view_existing_alias_is_view(name, alias_names, alias_sources, alias_is_view) or sources.count > 0
                # Rebinding a known view/container alias to a plain place keeps that owner's
                # dependency too. Retain old rows conservatively for uncertain control flow.
                if sources.count == 0 and any existing in alias_names where existing == name:
                    storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                origin_value: StorageViewOriginProjection = storage_view_call_field_value(value, view_fns)
                for source in sources |alias_names, alias_sources, alias_is_view, name, value, origin_value|:
                    storage_view_push_origin_rows(origin_value, name, source, is_view_alias, alias_names, alias_sources, alias_is_view)

        def storage_view_type_is_darray(type_expression: Ast::Expr) -> bool:
            current: mutable Ast::Expr = type_expression
            while true:
                match current:
                    Expr.Unary(TokenKind.Mutable, operand, line) | Expr.Paren(operand, line):
                        current <- operand
                    Expr.Index(head, argument, line) | Expr.IndexN(head, arguments, line):
                        return ident_name_of(head) == "darray"
                    _:
                        return false
            return false

        def storage_view_type_is_reference(type_expression: Ast::Expr) -> bool:
            return match type_expression:
                Expr.Unary(operator, operand, line):
                    operator == TokenKind.Ampersand or operator == TokenKind.Lmut or storage_view_type_is_reference(operand)
                Expr.Paren(inner, line):
                    storage_view_type_is_reference(inner)
                _:
                    false

        # `t: i64 = r` copies the referent out of a view: the scalar local owns its value and
        # survives any later growth or replacement of the view's container (stage0:
        # storageViewScalarBindingType). `uintptr` is excluded: it may carry an address.
        def storage_view_type_is_scalar_copy(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                name: sview = ident_name_of(type_expression)
                return when name:
                    "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "isize" | "usize" | "f32" | "f64" | "bool" | "char" -> true
                    _ -> false

        def storage_view_record_typed_alias(name: sview @source, type_expression: Ast::Expr, value: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                if storage_view_element_is_replaceable(type_expression):
                    alias_names.push(name)
                    alias_sources.push("[]")
                    alias_is_view.push(false)
                # A fresh borrow-free result (`args: darray[ValueType] = infer(scope)`) owns its
                # storage: it neither views nor shares the arguments' buffers.
                return if:
                    storage_view_owned_call(value, view_fns)
                    # A builtin scalar (`exchanged: i64 = atomic_exchange_acqrel(&cell, 5)`) is a copy:
                    # it can hold no view of anything, whatever the callee's summary says about a
                    # generic `-> T` result.
                    storage_view_type_is_scalar_copy(type_expression)
                sources: mutable darray[sview @source] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                # Only copied darrays need a value-alias row for relocation invalidation.
                # Inferring that arbitrary user structs carry borrowed storage without
                # field-layout/return-alias summaries makes ordinary parser state look like
                # view provenance and rejects valid Stage1 source. View-typed locals already
                # get their explicit source dependencies from collect_sources above.
                if storage_view_type_is_darray(type_expression) and sources.count == 0:
                    storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                # A container reference `r: darray[T]& = &b.items` names b's buffer without being a
                # view itself: record it as a non-view alias of the place (and of itself, so growth
                # through `r` still reaches views of it) for interior refs `&r[i]` to inherit.
                if sources.count == 0 and storage_view_type_is_reference(type_expression):
                    container_place: sview = storage_view_whole_borrow_root(value)
                    if container_place != "":
                        alias_names.push(name)
                        alias_sources.push(container_place)
                        alias_is_view.push(false)
                        alias_names.push(name)
                        alias_sources.push(name)
                        alias_is_view.push(false)
                        return
                captures_storage: bool = value is Expr.Lambda(_, _, _) and sources.count > 0
                # An enum value whose payload holds a view carries that view's borrow.
                payload_view: bool = storage_view_is_enum_construct(value) and sources.count > 0
                # A summarised helper returning an enum whose payload holds a view
                # (`t: Tok = wrap(buf)`) carries its arguments' borrow (stage0
                # storageViewDependencyForUserCall on an EnumType that carries borrowed storage).
                # A scalar annotation copies the result out: a generic helper summarised for its
                # `-> T` return (`x: i64 = atomic_exchange_acqrel(&cell, 5)`) holds no borrow once
                # T is a scalar, so a later mutation of the argument cannot invalidate it.
                summarised_call: bool = sources.count > 0 and storage_view_is_summarised_call(value, view_fns) and not storage_view_type_is_scalar_copy(type_expression)
                # A tuple / struct LITERAL with a field initialised straight from a view
                # (`(1, buf[0:1])`, `S{f: s.as_sview()}`) holds that view: replacing or growing
                # `buf` leaves `t.f` dangling (fuzz F5; stage0 tracks it). Only a literal whose
                # field IS a view-producing expression counts -- no layout guessing for other
                # struct values, which the comment above warns about.
                literal_view: bool = storage_view_literal_holds_view(value)
                storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources) if literal_view and sources.count == 0
                origin_value: StorageViewOriginProjection = storage_view_call_field_value(value, view_fns)
                for source in sources |alias_names, alias_sources, alias_is_view, name, value, origin_value, summarised_call, literal_view|:
                    row_is_view: bool = return_type_is_view(type_expression) or storage_view_type_is_reference(type_expression) or captures_storage or payload_view or summarised_call or literal_view or (storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view) and not storage_view_type_is_scalar_copy(type_expression))
                    storage_view_push_origin_rows(origin_value, name, source, row_is_view, alias_names, alias_sources, alias_is_view)

        def storage_view_invalidate_rebound_views(root: sview, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview @source]&, invalidated_by: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if root == ""
                for index in 0..<alias_sources.count |root, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by|:
                    source: sview = alias_sources[index]
                    under_root: bool = source == root or (sview_starts_with(source, root) and source.len > root.len and (source[root.len] == 46.u8() or source[root.len] == 91.u8()))
                    if under_root and index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and alias_names[index] != root and not fresh_wrapper_name_exists(invalidated, alias_names[index]):
                        invalidated.push(alias_names[index])
                        invalidated_by.push("") if invalidated.count > invalidated_by.count

        def storage_view_literal_holds_view(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_literal_holds_view(inner)
                    Expr.Tuple(elements, _):
                        return any element in elements where storage_view_is_direct_view(element)
                    Expr.Construct(_, fields, _):
                        return any field in fields where storage_view_is_direct_view(field.value)
                    _:
                        return false

        def storage_view_is_direct_view(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_is_direct_view(inner)
                    Expr.Slice(_, _, _, _):
                        return true
                    Expr.Unary(TokenKind.Ampersand, operand, _):
                        return operand is Expr.Index(_, _, _)
                    Expr.Call(Expr.Field(_, method, _), _, _, _):
                        return method in {"as_sview", "as_view", "as_slice", "as_cstr"}
                    _:
                        return false

        def storage_view_is_summarised_call(value: Ast::Expr, view_fns: darray[sview @source]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_is_summarised_call(inner, view_fns)
                    Expr.Call(Expr.Ident(called, _), arguments, _, _):
                        return vro_status(view_fns, called, arguments.count) == 1
                    _:
                        return false

        def storage_view_is_enum_construct(value: Ast::Expr) -> bool:
            match value:
                Expr.Paren(inner, line):
                    return storage_view_is_enum_construct(inner)
                Expr.Call(callee, arguments, argument_names, line):
                    return enum_variant_callee(callee)
                _:
                    return false

        # `vs.push(s)`, `vs.extend([s])`, `keep(&vs, s)`: a container that receives a view (or a
        # closure/aggregate carrying one) depends on that view's sources. stage1 grows darrays by
        # realloc (no reserve_commit stable base), so a later growth of the source leaves the
        # stored view stale: record the container as a view alias of those sources.
        def storage_view_record_container_store(expression: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        sources: mutable darray[sview @source] = []
                        for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, sources|:
                            # Only a stored VIEW (or a closure capturing one) keeps its source's
                            # storage reachable through the holder; owned values are copied.
                            stores_view: bool = storage_view_stored_value_holds_view(argument, alias_names, alias_sources, alias_is_view)
                            if stores_view and storage_view_whole_borrow_root(argument) == "":
                                storage_view_collect_sources(argument, alias_names, alias_sources, alias_is_view, view_fns, sources)
                        return if sources.count == 0
                        holders: mutable darray[sview @source] = []
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                is_storage_method: bool = match method:
                                    "push" | "extend" | "insert" | "append" | "push_back" | "add" | "put" | "set": true
                                    _: false
                                if is_storage_method:
                                    holders.push(storage_view_place_root(receiver))
                            _:
                                pass
                        for argument in arguments |holders|:
                            holders.push(storage_view_whole_borrow_root(argument))
                        for holder in holders |sources, alias_names, alias_sources, alias_is_view|:
                            if holder != "":
                                for source in sources |alias_names, alias_sources, alias_is_view, holder|:
                                    if source != holder:
                                        # The "[held]" marker row tells growth of the HOLDER not to
                                        # treat this row as a borrow the holder itself relocates.
                                        alias_names.push(holder)
                                        alias_sources.push("[held]")
                                        alias_is_view.push(false)
                                        alias_names.push(holder)
                                        alias_sources.push(source)
                                        alias_is_view.push(true)
                    Expr.Paren(inner, line):
                        storage_view_record_container_store(inner, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        def storage_view_push_held(holder: sview @source, source: sview @source, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if holder == "" or source == "" or source == holder or source == "[held]"
                alias_names.push(holder)
                alias_sources.push("[held]")
                alias_is_view.push(false)
                alias_names.push(holder)
                alias_sources.push(source)
                alias_is_view.push(true)

        # `h.s <- buf.as_sview()`, `vs[0] <- view`: a view stored into a field or element makes
        # the holder's root carry it, exactly like `vs.push(view)` (stage0 recordStorageViewPlaceStore).
        def storage_view_record_place_store(target: Ast::Expr, value: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                holder: sview = storage_view_place_root(target)
                return if:
                    holder == ""
                    not storage_view_stored_value_holds_view(value, alias_names, alias_sources, alias_is_view) or storage_view_whole_borrow_root(value) != ""
                sources: mutable darray[sview @source] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                for source in sources |holder, alias_names, alias_sources, alias_is_view|:
                    storage_view_push_held(holder, source, alias_names, alias_sources, alias_is_view)

        # `ws: darray[sview @source] = vs`, `g: Holder = h`, `ws <- move vs`: a by-value copy of a holder
        # copies the views stored in it, so the copy inherits the holder's "[held]" rows.
        def storage_view_inherit_held(name: sview @source, value: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        storage_view_inherit_held(name, inner, alias_names, alias_sources, alias_is_view)
                    Expr.Ident(source_name, _):
                        return if source_name == name or name == ""
                        held: mutable darray[sview @source] = []
                        for alias_index in 1..<alias_names.count |held, alias_names, alias_sources, source_name|:
                            held.push(alias_sources[alias_index]) if alias_index < alias_sources.count and alias_names[alias_index] == source_name and alias_names[alias_index - 1] == source_name and alias_sources[alias_index - 1] == "[held]"
                        for source in held |name, alias_names, alias_sources, alias_is_view|:
                            storage_view_push_held(name, source, alias_names, alias_sources, alias_is_view)
                    _:
                        pass

        # A stored value holds a view: a borrow-carrying expression, a closure, or an
        # aggregate (struct/tuple/array literal) with such a part.
        def storage_view_stored_value_holds_view(value: Ast::Expr, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, alias_is_view: darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Lambda(_, _, _):
                        return true
                    Expr.Construct(_, fields, _):
                        return any field in fields where storage_view_stored_value_holds_view(field.value, alias_names, alias_sources, alias_is_view)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        return any element in elements where storage_view_stored_value_holds_view(element, alias_names, alias_sources, alias_is_view)
                    _:
                        return storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view)

        # The root of `&place` when PLACE is a whole container (`&b.items`, `&buf`), not an element.
        def storage_view_whole_borrow_root(value: Ast::Expr) -> sview:
            match value:
                Expr.Paren(inner, line):
                    return storage_view_whole_borrow_root(inner)
                Expr.Unary(operator, operand, line):
                    return "" if operator != TokenKind.Ampersand or interior_reference_place(operand) != ""
                    return match operand:
                        Expr.Ident(_, _) | Expr.Field(_, _, _):
                            storage_view_place_root(operand)
                        _:
                            ""
                _:
                    return ""

        def storage_view_collect_statement(statement: Ast::Stmt, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        storage_view_record_typed_alias(name, type_expression, value, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Assign(target, operator, value, line):
                        # Nested bodies record only `=`: stage0 does not track a `<-` rebind made
                        # inside a loop/branch body (the top-level walk does).
                        storage_view_record_alias(storage_view_place_root(target), value, alias_names, alias_sources, alias_is_view, view_fns) if operator == TokenKind.Assign
                    Stmt.If(condition, then_body, else_body, line):
                        for nested in then_body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                        for nested in else_body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.While(condition, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.For(bind, variables, iterable, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Match(scrutinee, arms, line):
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns|:
                            for nested in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        # A lambda's storage dependencies are its lexically resolved free variables,
        # not every identifier spelling in its body. Declarations are visited in source
        # order and nested scopes restore their binders so same-named lambda parameters,
        # locals, loop variables, and pattern bindings cannot be mistaken for outer views.
        def storage_view_lambda_capture_name(name: sview @source, bound_names: mutable darray[sview @source]&, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or any bound_name in bound_names where bound_name == name
                had_source: mutable bool = false
                for alias_index in 0..<alias_names.count |alias_names, alias_sources, name, out, had_source|:
                    if alias_names[alias_index] == name and alias_index < alias_sources.count:
                        storage_view_push_source(alias_sources[alias_index], out)
                        had_source <- true
                # A closure may capture a container owner directly and build a view only
                # when invoked. Preserve that owner as a relocation dependency too.
                storage_view_push_source(name, out) if not had_source

        def storage_view_lambda_capture_unknown_pattern(alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for alias_index in 0..<alias_names.count |alias_names, alias_sources, out|:
                    storage_view_push_source(alias_names[alias_index], out)
                    storage_view_push_source(alias_sources[alias_index], out) if alias_index < alias_sources.count

        def storage_view_lambda_bind_pattern_expression(expression: Ast::Expr, bound_names: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        bound_names.push(name) if name != ""
                    Expr.Call(callee, arguments, argument_names, line):
                        storage_view_lambda_bind_pattern_expression(callee, bound_names)
                        for argument in arguments |bound_names|:
                            storage_view_lambda_bind_pattern_expression(argument, bound_names)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        storage_view_lambda_bind_pattern_expression(object, bound_names)
                    Expr.Paren(inner, line) | Expr.Unary(_, inner, line) | Expr.Move(inner, line):
                        storage_view_lambda_bind_pattern_expression(inner, bound_names)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line):
                        for element in elements |bound_names|:
                            storage_view_lambda_bind_pattern_expression(element, bound_names)
                    Expr.Binary(left, operator, right, line):
                        storage_view_lambda_bind_pattern_expression(left, bound_names)
                        storage_view_lambda_bind_pattern_expression(right, bound_names)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |bound_names|:
                            storage_view_lambda_bind_pattern_expression(field.value, bound_names)
                    _:
                        pass

        def storage_view_lambda_bind_condition(condition: Ast::Expr, bound_names: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        storage_view_lambda_bind_condition(left, bound_names)
                        storage_view_lambda_bind_pattern_expression(right, bound_names) if operator == TokenKind.Is
                        storage_view_lambda_bind_condition(right, bound_names) if operator != TokenKind.Is
                    _:
                        pass

        def storage_view_lambda_bind_pattern(pattern: Ast::Pattern, bound_names: mutable darray[sview @source]&, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name) | Pattern.Rest(name):
                        bound_names.push(name) if name != ""
                    Pattern.Pin(name):
                        storage_view_lambda_capture_name(name, bound_names, alias_names, alias_sources, out)
                    Pattern.As(name, inner):
                        bound_names.push(name) if name != ""
                        for nested in inner |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_bind_pattern(nested, bound_names, alias_names, alias_sources, out)
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Field(_, fields) | Pattern.Tuple(fields) | Pattern.Or(fields):
                        for nested in fields |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_bind_pattern(nested, bound_names, alias_names, alias_sources, out)
                    Pattern.Other(_):
                        # Unknown pattern syntax could bind or pin a name not represented
                        # structurally. Fail closed by retaining every known storage root.
                        storage_view_lambda_capture_unknown_pattern(alias_names, alias_sources, out)
                    _:
                        pass
