extend Semantic:
    private:
        # The place addressed by `&place` when PLACE is an index into a named container.
        # Parentheses and `move` are transparent here, matching stage0's optimization-paren
        # stripping before it classifies an interior borrow.
        def interior_reference_place(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Paren(inner, line):
                    return interior_reference_place(inner)
                Expr.Move(inner, line):
                    return interior_reference_place(inner)
                Expr.Index(object, index, index_line):
                    match object:
                        Expr.Ident(name, ident_line):
                            return name
                        _:
                            pass
                _:
                    pass
            return ""

        def interior_reference_source(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Unary(operator, operand, line):
                    return interior_reference_place(operand) if operator == TokenKind.Ampersand else ""
                Expr.Paren(inner, line):
                    return interior_reference_source(inner)
                Expr.Move(inner, line):
                    return interior_reference_source(inner)
                _:
                    pass
            return ""

        def storage_view_place_root(expression: Ast::Expr) -> sview:
            current: mutable Ast::Expr = expression
            while true:
                match current:
                    Expr.Ident(name, line): return name
                    Expr.Field(object, field, line):
                        current <- object
                    Expr.Index(object, index, line):
                        current <- object
                    Expr.IndexN(object, indices, line):
                        current <- object
                    Expr.Slice(object, start, end, line):
                        current <- object
                    Expr.Paren(inner, line) | Expr.Move(inner, line) | Expr.Unary(TokenKind.Ampersand, inner, line):
                        current <- inner
                    _:
                        return ""
            return ""

        def storage_view_push_source(source: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.push(source) if source != "" and not any existing in out where existing == source

        def storage_view_append_value_sources(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line) | Expr.Field(_, _, line) | Expr.Index(_, _, line) | Expr.IndexN(_, _, line) | Expr.Slice(_, _, _, line) | Expr.Paren(_, line) | Expr.Move(_, line) | Expr.Unary(_, _, line):
                        storage_view_sources_from_argument(expression, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.RecordUpdate(base, fields, line):
                        storage_view_append_value_sources(base, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_append_value_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        # A value-returning helper can preserve an input container's backing.
                        # Until a verified return-alias summary exists, every place argument is
                        # a possible source; this only adds conservative invalidations.
                        for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_sources_from_argument(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_append_value_sources(then_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                        storage_view_append_value_sources(else_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    _:
                        storage_view_collect_sources(expression, alias_names, alias_sources, alias_is_view, view_fns, out)

        # A view-producing call inherits dependencies from its source arguments. An argument
        # already recorded as a view alias contributes its original backing containers.
        def storage_view_sources_from_argument(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        found_alias: mutable bool = false
                        for alias_index in 0..<alias_names.count |found_alias, alias_names, alias_sources, name, out|:
                            if alias_names[alias_index] == name and alias_index < alias_sources.count:
                                storage_view_push_source(alias_sources[alias_index], out)
                                found_alias <- true
                        storage_view_push_source(name, out) if not found_alias
                    Expr.Unary(operator, operand, line):
                        borrowed_place: sview = storage_view_place_root(operand) if operator == TokenKind.Ampersand else ""
                        storage_view_push_source(borrowed_place, out) if borrowed_place != ""
                        storage_view_collect_sources(operand, alias_names, alias_sources, alias_is_view, view_fns, out) if borrowed_place == ""
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                        root: sview = storage_view_place_root(expression)
                        storage_view_push_source(root, out) if root != ""
                        storage_view_collect_sources(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        storage_view_sources_from_argument(inner, alias_names, alias_sources, alias_is_view, view_fns, out)
                    _:
                        storage_view_collect_sources(expression, alias_names, alias_sources, alias_is_view, view_fns, out)

        def storage_view_existing_alias_is_view(name: sview, alias_names: darray[sview]&, alias_is_view: darray[bool]&) -> bool:
            found: mutable bool = false
            for index in 0..<alias_names.count |found, alias_names, alias_is_view, name|:
                found <- true if alias_names[index] == name and index < alias_is_view.count and alias_is_view[index]
            return found

        def storage_view_record_alias(name: sview, value: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                sources: mutable darray[sview] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                is_view_alias: bool = storage_view_existing_alias_is_view(name, alias_names, alias_is_view) or sources.count > 0
                # Rebinding a known view/container alias to a plain place keeps that owner's
                # dependency too. Retain old rows conservatively for uncertain control flow.
                if sources.count == 0 and any existing in alias_names where existing == name:
                    storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                for source in sources |alias_names, alias_sources, alias_is_view, name|:
                    alias_names.push(name)
                    alias_sources.push(source)
                    alias_is_view.push(is_view_alias)

        def storage_view_type_is_darray(type_expression: Ast::Expr) -> bool:
            current: mutable Ast::Expr = type_expression
            while true:
                match current:
                    Expr.Unary(TokenKind.Mutable, operand, line) | Expr.Paren(operand, line):
                        current <- operand
                    Expr.Index(head, argument, line) | Expr.IndexN(head, arguments, line):
                        return ident_name_of(head) == "darray"
                    _:
                        return false
            return false

        def storage_view_type_is_reference(type_expression: Ast::Expr) -> bool:
            return match type_expression:
                Expr.Unary(operator, operand, line):
                    operator == TokenKind.Ampersand or operator == TokenKind.Lmut or storage_view_type_is_reference(operand)
                Expr.Paren(inner, line):
                    storage_view_type_is_reference(inner)
                _:
                    false

        def storage_view_record_typed_alias(name: sview, type_expression: Ast::Expr, value: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                sources: mutable darray[sview] = []
                storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                # Only copied darrays need a value-alias row for relocation invalidation.
                # Inferring that arbitrary user structs carry borrowed storage without
                # field-layout/return-alias summaries makes ordinary parser state look like
                # view provenance and rejects valid Stage1 source. View-typed locals already
                # get their explicit source dependencies from collect_sources above.
                if storage_view_type_is_darray(type_expression) and sources.count == 0:
                    storage_view_append_value_sources(value, alias_names, alias_sources, alias_is_view, view_fns, sources)
                for source in sources |alias_names, alias_sources, alias_is_view, name|:
                    alias_names.push(name)
                    alias_sources.push(source)
                    alias_is_view.push(return_type_is_view(type_expression) or storage_view_type_is_reference(type_expression))

        def storage_view_collect_statement(statement: Ast::Stmt, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        storage_view_record_typed_alias(name, type_expression, value, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Assign(target, operator, value, line):
                        storage_view_record_alias(storage_view_place_root(target), value, alias_names, alias_sources, alias_is_view, view_fns) if operator == TokenKind.Assign
                    Stmt.If(condition, then_body, else_body, line):
                        for nested in then_body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                        for nested in else_body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.While(condition, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.For(bind, variables, iterable, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    Stmt.Match(scrutinee, arms, line):
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns|:
                            for nested in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(nested, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        def storage_view_collect_sources(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        for alias_index in 0..<alias_names.count |alias_names, alias_sources, name, out|:
                            storage_view_push_source(alias_sources[alias_index], out) if alias_names[alias_index] == name and alias_index < alias_sources.count
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        storage_view_collect_sources(inner, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Unary(operator, operand, line):
                        borrowed_place: sview = interior_reference_place(operand) if operator == TokenKind.Ampersand else ""
                        storage_view_push_source(borrowed_place, out) if borrowed_place != ""
                        storage_view_collect_sources(operand, alias_names, alias_sources, alias_is_view, view_fns, out) if borrowed_place == ""
                    Expr.Call(callee, arguments, argument_names, line):
                        called: sview = ident_name_of(callee)
                        # Match Stage0's explicit borrowed-storage contracts. Do not infer
                        # backing from every sview-returning user function: helpers such as
                        # Lexer.text_or_empty borrow the source argument, not every mutable
                        # parser argument supplied to the helper.
                        returns_view: bool = called in {"bytes_view", "bytes_view_range", "bytes_view_range_ref", "sview", "string_view_slice", "string_view_prefix", "string_view_suffix", "darray_view", "arena_da_view", "readonly", "arena_da_view_slice", "arena_da_view_prefix", "arena_da_view_suffix", "slice", "read_view", "split"}
                        if returns_view:
                            for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                                storage_view_sources_from_argument(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                is_view_method: bool = method == "view" or method == "as_sview" or method == "as_cstr"
                                storage_view_sources_from_argument(receiver, alias_names, alias_sources, alias_is_view, view_fns, out) if is_view_method
                            _:
                                pass
                    Expr.Slice(object, start, end, line):
                        storage_view_sources_from_argument(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line):
                        storage_view_collect_sources(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_collect_sources(then_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                        storage_view_collect_sources(else_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Tuple(elements, line) | Expr.Array(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(element, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(entry.key, alias_names, alias_sources, alias_is_view, view_fns, out)
                            storage_view_collect_sources(entry.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.RecordUpdate(base, fields, line):
                        storage_view_collect_sources(base, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Block(statements, value, captures, line):
                        for statement in statements |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                        storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Match(scrutinee, arms, line):
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            for statement in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                    Expr.Catch(guarded, arms, line):
                        storage_view_collect_sources(guarded, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            for statement in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                    Expr.GetElse(guarded, recovery, line):
                        storage_view_collect_sources(guarded, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for statement in recovery |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                    _:
                        pass

        def growth_call_target(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(callee, arguments, argument_names, line):
                    match callee:
                        Expr.Field(receiver, method, field_line):
                            root: sview = storage_view_place_root(receiver)
                            return root if method in {"push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate"} else ""
                        Expr.Ident(method, ident_line):
                            if method in {"darray_push", "darray_extend", "darray_append", "darray_append_many", "darray_insert", "darray_reserve", "darray_resize", "darray_clear", "darray_truncate", "push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate"} and arguments.count > 0:
                                return storage_view_place_root(arguments[0])
                        _:
                            pass
                _:
                    pass
            return ""

        def invalidated_alias_in_expression(expression: Ast::Expr, invalidated: darray[sview]&) -> sview can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.Ident(name, line):
                    return name if fresh_wrapper_name_exists(invalidated, name) else ""
                Expr.Field(receiver, field, line):
                    return invalidated_alias_in_expression(receiver, invalidated)
                Expr.Index(object, index, line):
                    return invalidated_alias_in_expression(object, invalidated)
                Expr.IndexN(object, arguments, line):
                    return invalidated_alias_in_expression(object, invalidated)
                Expr.Unary(operator, operand, line):
                    return invalidated_alias_in_expression(operand, invalidated)
                Expr.Paren(inner, line):
                    return invalidated_alias_in_expression(inner, invalidated)
                Expr.Call(callee, arguments, argument_names, line):
                    from_callee: sview = invalidated_alias_in_expression(callee, invalidated)
                    return from_callee if from_callee != ""
                    return invalidated_alias_in_arguments(arguments, invalidated)
                Expr.Binary(left, operator, right, line):
                    found_left: sview = invalidated_alias_in_expression(left, invalidated)
                    return found_left if found_left != ""
                    return invalidated_alias_in_expression(right, invalidated)
                Expr.If(condition, then_value, else_value, line):
                    found_then: sview = invalidated_alias_in_expression(then_value, invalidated)
                    return found_then if found_then != ""
                    return invalidated_alias_in_expression(else_value, invalidated)
                Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                    return invalidated_alias_in_arguments(elements, invalidated)
                _:
                    return ""

        def invalidated_alias_in_arguments(arguments: darray[Ast::Expr]&, invalidated: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = ""
                for argument in arguments |found, invalidated|:
                    found <- invalidated_alias_in_expression(argument, invalidated) if found == ""
                return found

        def diagnose_invalidated_alias(expression: Ast::Expr, invalidated: darray[sview]&, invalidated_by: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias: sview = invalidated_alias_in_expression(expression, invalidated)
                by: sview =
                    for candidate_index in 0..<invalidated.count |by: sview = ""| -> by:
                        by <- invalidated_by[candidate_index] if invalidated[candidate_index] == alias and candidate_index < invalidated_by.count
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StorageDependencyInvalidated, name: alias, pos: ident_extent_or_line(expression, line), line: line, expected: by, actual: ""}) if alias != ""

        # A plain darray and a darray in malloc/chained/scratch storage can move its backing
        # buffer when it grows. Only reserve_commit and fixed are single-block backings whose
        # base remains stable. This mirrors stage0's storage-view dependency rule: an absent
        # region is deliberately treated as relocatable rather than silently accepted.
        def storage_backing_is_stable(region: sview, stable_regions: darray[sview]&) -> bool:
            return region != "" and destroyed_region_contains(stable_regions, region)

        def invalidate_growth_aliases(target: sview, function_line: u32, line: u32, annotations: darray[Ast::LocalRegionAnnotation]&, stable_regions: darray[sview]&, alias_names: darray[sview]&, alias_sources: darray[sview]&, alias_is_view: darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                region: sview = function_region_of_name(annotations, target, function_line, line)
                return if target == "" or storage_backing_is_stable(region, stable_regions)
                target_sources: mutable darray[sview] = [target]
                for alias_index in 0..<alias_names.count |target_sources, alias_names, alias_sources, target|:
                    storage_view_push_source(alias_sources[alias_index], target_sources) if alias_names[alias_index] == target and alias_index < alias_sources.count
                for source in alias_sources |index: usize = 0, invalidated, target_sources, alias_names, alias_is_view, invalidated_by, target|:
                    if any owner_source in target_sources where owner_source == source:
                        invalidated.push(alias_names[index]) if index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and not fresh_wrapper_name_exists(invalidated, alias_names[index])
                        invalidated_by.push(target) if index < alias_names.count and index < alias_is_view.count and alias_is_view[index] and invalidated.count > invalidated_by.count
                    index <- index + 1

        def walk_region_storage_stability(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, view_fns: darray[sview]&, stable_regions: mutable darray[sview]&, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |stable_regions, alias_names, alias_sources, alias_is_view, invalidated, table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            has_stable_backing: bool = kind == "region" and (destroyed_region_contains(clause, "reserve_commit") or destroyed_region_contains(clause, "fixed"))
                            stable_region: mutable sview = binding
                            # Block-form regions keep the name in clause[0] and leave the
                            # generic binding slot empty; statement-form regions do the reverse.
                            stable_region <- clause[0] if stable_region == "" and has_stable_backing and clause.count > 0
                            stable_regions.push(stable_region) if stable_region != "" and has_stable_backing and not destroyed_region_contains(stable_regions, stable_region)
                            table <- walk_region_storage_stability(body, annotations, function_line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- diagnose_invalidated_alias(value, invalidated, invalidated_by, line.line, table)
                            storage_view_record_typed_alias(name, type_expression, value, alias_names, alias_sources, alias_is_view, view_fns)
                        Stmt.Expr(expression, line):
                            table <- diagnose_invalidated_alias(expression, invalidated, invalidated_by, line.line, table)
                            invalidate_growth_aliases(growth_call_target(expression), function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                            match expression:
                                Expr.Block(statements, value, captures, block_line):
                                    table <- walk_region_storage_stability(statements, annotations, function_line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                                _:
                                    pass
                        Stmt.Assign(target, operator, value, line):
                            invalidate_growth_aliases(growth_call_target(target), function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                            invalidate_growth_aliases(growth_call_target(value), function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                            invalidate_growth_aliases(growth_call_target(collection_append_call(target, value, line)), function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if operator == TokenKind.PlusEq
                            table <- diagnose_invalidated_alias(target, invalidated, invalidated_by, line.line, table)
                            table <- diagnose_invalidated_alias(value, invalidated, invalidated_by, line.line, table)
                            storage_view_record_alias(storage_view_place_root(target), value, alias_names, alias_sources, alias_is_view, view_fns) if operator == TokenKind.Assign
                        Stmt.Return(value, line):
                            table <- diagnose_invalidated_alias(returned, invalidated, invalidated_by, line.line, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- diagnose_invalidated_alias(condition, invalidated, invalidated_by, line.line, table)
                            table <- walk_region_storage_stability(then_body, annotations, function_line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            table <- walk_region_storage_stability(else_body, annotations, function_line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                        Stmt.While(condition, while_body, line):
                            table <- diagnose_invalidated_alias(condition, invalidated, invalidated_by, line.line, table)
                            table <- walk_region_storage_stability(while_body, annotations, function_line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- diagnose_invalidated_alias(iterable, invalidated, invalidated_by, line.line, table)
                            table <- walk_region_storage_stability(for_body, annotations, function_line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- diagnose_invalidated_alias(scrutinee, invalidated, invalidated_by, line.line, table)
                            for arm in arms |table, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by| -> table:
                                table <- walk_region_storage_stability(arm.body, annotations, function_line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                        _:
                            pass

        def check_region_storage_stability_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            stable_regions: mutable darray[sview] = []
                            alias_names: mutable darray[sview] = []
                            alias_sources: mutable darray[sview] = []
                            alias_is_view: mutable darray[bool] = []
                            invalidated: mutable darray[sview] = []
                            invalidated_by: mutable darray[sview] = []
                            table <- walk_region_storage_stability(body, annotations, line.line, view_fns, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                        Decl.Module(name, body, line):
                            table <- check_region_storage_stability_declarations(body, annotations, view_fns, table)
                        Decl.Scoped(body, line):
                            table <- check_region_storage_stability_declarations(body, annotations, view_fns, table)
                        _:
                            pass

    public:
        def check_region_storage_stability(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                view_fns: mutable darray[sview] = []
                table <- check_region_storage_stability_declarations(file.top_decls, file.local_region_annotations, view_fns, table)
