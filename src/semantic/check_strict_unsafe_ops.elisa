# Strict-mode (`-strict` / EnforceUnsafePermissions) Unsafe-family obligations that are
# decidable structurally (stage0 parity; the bounds/alias PROVERS stay stage0's job):
#
#   1. Unchecked index: `arr[idx]` where `arr` is a fixed-array param and `idx` a plain
#      integer param no requires-clause constrains — the access is provably unproven, so
#      it needs `can Unsafe.UncheckedIndex` (or `get arr[i]` / `arr[i] else ...`).
#   2. Mutable alias: a call whose arguments name the same `mutable T&` param twice
#      (directly or through a ref-returning call over it) creates two live mutable
#      borrows — needs `can Unsafe.Alias`.
#
# Both stay SILENT inside any `can`/`trusted` block (conservative over-grant, zero
# false positives) and outside strict mode.
extend Semantic:
    private:
        # Whether TYPE_EXPRESSION spells an indexable whose subscripts stage0's
        # strict mode bounds-checks: `array[T, N]`, `T[N]` suffix arrays, `darray[T]`,
        # or a raw ref over a scalar (`u8&`), each optionally `&`/`mutable`-wrapped.
        def is_fixed_array_annotation(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, line):
                        head: sview = ident_name_of(object)
                        elem: sview = ident_name_of(index)
                        # Generic elements (`darray[T]` in an impl[T] member) keep
                        # stage0's generic-context suppression — primitives only.
                        (is_integer_type_name(elem) or is_float_type_name(elem) or elem == "bool" or elem == "char") return if head == "array" or head == "darray"
                        # `i32[4]` — a primitive scalar name subscripted by a length.
                        return is_integer_type_name(head) or is_float_type_name(head)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        first_elem: sview = ident_name_of(arguments_n[0]) if arguments_n.count > 0 else sview("", 0, 0)
                        (is_integer_type_name(first_elem) or is_float_type_name(first_elem) or first_elem == "bool" or first_elem == "char") return if head_n == "array" or head_n == "darray"
                        return is_integer_type_name(head_n) or is_float_type_name(head_n)
                    Expr.Unary(operator, operand, line):
                        # A raw scalar ref (`u8&`) indexes unchecked memory directly.
                        operand_name: sview = ident_name_of(operand)
                        true return if operator == TokenKind.Ampersand and (is_integer_type_name(operand_name) or is_float_type_name(operand_name))
                        return is_fixed_array_annotation(operand)
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_head: sview = ident_name_of(callee)
                        true return if callee_head == "array"
                        return false
                    _:
                        return false

        # The declared EXTENT of a fixed-array annotation (`array[u32, 128]`, `i32[16]`),
        # or -1. Looks through `&`/`mutable`.
        def fixed_array_extent(type_expression: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        (-1) return if head_n != "array" or arguments_n.count != 2
                        extent: (found: bool, value: i64) = fold_const_int(arguments_n[1])
                        return extent.value if extent.found else -1
                    Expr.Index(object, index, line):
                        head: sview = ident_name_of(object)
                        (-1) return if not (is_integer_type_name(head) or is_float_type_name(head))
                        length: (found: bool, value: i64) = fold_const_int(index)
                        return length.value if length.found else -1
                    Expr.Unary(operator, operand, line):
                        return fixed_array_extent(operand)
                    Expr.Paren(inner, paren_line):
                        return fixed_array_extent(inner)
                    _:
                        return (-1)


        # The [lo, hi] window a refined annotation guarantees (`u32 is InRange[0, 126]`),
        # via the shared law machinery; found=false for an unbounded law (`is Even`) —
        # the REFINED marker still reports whether an `is` refinement is present at all.
        def index_annotation_window(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (refined: bool, found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                spec: (found: bool, law_name: sview, lo: i64, hi: i64) = refinement_bound_spec(type_expression, law_names, law_predicates)
                is_refined: bool = match type_expression:
                    Expr.Binary(base, operator, right, line): operator == TokenKind.Is
                    _: false
                return (is_refined, spec.found, spec.lo, spec.hi)


        # The annotation of STRUCT.FIELD, via the collected struct tables ((Absent, false)
        # when unknown).
        def struct_field_annotation(struct_name: sview, field: sview, sm_struct_names: darray[sview]&, sm_field_starts: darray[usize]&, sm_field_counts: darray[usize]&, all_sm_field_names: darray[sview]&, all_sm_field_types: darray[Ast::Expr]&) -> (found: bool, annotation: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                slot: mutable i64 = -1
                probe: mutable usize = 0
                while probe < sm_struct_names.count |slot, probe, struct_name, sm_struct_names|:
                    slot <- probe.i64() if sm_struct_names[probe] == struct_name and slot < 0
                    probe <- probe + 1
                (false, Ast::Expr.Absent) return if slot < 0
                index: usize = slot.usize()
                offset: mutable usize = 0
                while offset < sm_field_counts[index] |offset, index, field, sm_field_starts, all_sm_field_names, all_sm_field_types|:
                    (true, all_sm_field_types[sm_field_starts[index] + offset]) return if all_sm_field_names[sm_field_starts[index] + offset] == field
                    offset <- offset + 1
                return (false, Ast::Expr.Absent)


        # The base mutable-param ident an ARGUMENT expression aliases: the ident itself,
        # or the single mutable-param ident among a direct call's arguments (a
        # ref-returning wrapper like `get_ref(x)` forwards the borrow of `x`).
        def argument_alias_base(argument: Ast::Expr, mutable_params: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = ident_name_of(argument)
                direct return if direct != "" and (any p in mutable_params where p == direct)
                match argument:
                    Expr.Call(callee, arguments, argument_names, line):
                        for inner in arguments:
                            inner_name: sview = ident_name_of(inner)
                            inner_name return if inner_name != "" and (any p in mutable_params where p == inner_name)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Whether BODY does anything that could break a bounds proof about NAME: reassigning
        # the index, or any call (which may mutate the container the bound was taken from).
        def body_invalidates_bounds(body: darray[Ast::Stmt], name: sview) -> bool:
            can Abort.Panic, Memory.Allocate:
                false return if name == ""
                for statement in body:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            true return if ident_name_of(target) == name
                        Stmt.Expr(expression, line):
                            true return if expression_contains_call(expression)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            true return if body_invalidates_bounds(block_body, name)
                        _:
                            pass
                return false


        # Whether EXPRESSION performs a call anywhere within it.
        def expression_contains_call(expression: Ast::Expr) -> bool:
            can Abort.Panic, Memory.Allocate:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return true
                    Expr.Binary(left, operator, right, line):
                        return expression_contains_call(left) or expression_contains_call(right)
                    Expr.Paren(inner, line):
                        return expression_contains_call(inner)
                    Expr.Index(object, index, line):
                        return expression_contains_call(object) or expression_contains_call(index)
                    _:
                        return false


        # The local a `&x` address-of borrows, or "". `(&x)` through parens counts.
        def address_of_target(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, line):
                        return ident_name_of(operand) if operator == TokenKind.Ampersand else sview("", 0, 0)
                    Expr.Paren(inner, line):
                        return address_of_target(inner)
                    _:
                        return sview("", 0, 0)


        # `idx < recv.count` (or `recv.count > idx`) proves IDX in bounds for the rest of the
        # guarded region; `idx >= recv.count` proves it for the code AFTER an early return.
        # Returns the index NAME the comparison bounds, or "".
        #
        # The comparison must be against a `.count` FIELD, not a literal: stage0 proves
        # `index < items.count` and does NOT prove `index < 3` even for `array[T, 3]`
        # (verified against `-emit unsafe` both ways). Matching that exactly is what keeps
        # this from silently over-proving.
        # `name >= 0` / `0 <= name` — the lower-bound half of a signed guard.
        def signed_lower_bound_name(condition: Ast::Expr) -> sview:
            can Abort.Panic, Memory.Allocate:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        left_name: sview = ident_name_of(left)
                        right_name: sview = ident_name_of(right)
                        left_const: (found: bool, value: i64) = fold_const_int(left)
                        right_const: (found: bool, value: i64) = fold_const_int(right)
                        left_zero: bool = left_const.found and left_const.value == 0
                        right_zero: bool = right_const.found and right_const.value == 0
                        left_name return if operator == TokenKind.GtEq and right_zero and left_name != ""
                        right_name return if operator == TokenKind.LtEq and left_zero and right_name != ""
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        # `name < recv.count` / `recv.count > name` — the upper-bound half.
        def upper_count_bound_name(condition: Ast::Expr) -> sview:
            can Abort.Panic, Memory.Allocate:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        left_name: sview = ident_name_of(left)
                        right_name: sview = ident_name_of(right)
                        left_name return if operator == TokenKind.Lt and expression_is_count_field(right) and left_name != ""
                        right_name return if operator == TokenKind.Gt and expression_is_count_field(left) and right_name != ""
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        def bounds_guard_name(condition: Ast::Expr, want_less: bool, unsigned_indexes: darray[sview]&) -> sview:
            can Abort.Panic, Memory.Allocate:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        # SIGNED indexes narrow through the two-sided conjunction
                        # `i >= 0 and i < xs.count` (either conjunct order) — the lower
                        # bound supplies what the unsigned-only rule lacks.
                        if operator == TokenKind.And and want_less:
                            left_lower: sview = signed_lower_bound_name(left)
                            right_lower: sview = signed_lower_bound_name(right)
                            left_upper: sview = upper_count_bound_name(left)
                            right_upper: sview = upper_count_bound_name(right)
                            left_upper return if left_upper != "" and left_upper == right_lower
                            right_upper return if right_upper != "" and right_upper == left_lower
                            return sview("", 0, 0)
                        left_name: sview = ident_name_of(left)
                        right_is_count: bool = expression_is_count_field(right)
                        left_is_count: bool = expression_is_count_field(left)
                        right_name: sview = ident_name_of(right)
                        # `idx < recv.count` / `idx >= recv.count`
                        # A SIGNED index is not proven by an upper bound alone: `i < xs.count`
                        # says nothing about `i >= 0`. stage0 flags `i: int` here and accepts
                        # `i: usize` (verified both ways) -- only unsigned narrows.
                        wanted: TokenKind = TokenKind.Lt if want_less else TokenKind.GtEq
                        left_unsigned: bool = any u in unsigned_indexes where u == left_name
                        right_unsigned: bool = any u in unsigned_indexes where u == right_name
                        left_name return if operator == wanted and right_is_count and left_name != "" and left_unsigned
                        # Mirrored: `recv.count > idx` / `recv.count <= idx`
                        mirrored: TokenKind = TokenKind.Gt if want_less else TokenKind.LtEq
                        right_name return if operator == mirrored and left_is_count and right_name != "" and right_unsigned
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)


        # Whether EXPRESSION is a `.count` field access (`items.count`).
        def expression_is_count_field(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(object, field, line):
                        return field == "count"
                    _:
                        return false


        # Whether a body ENDS in a terminator, so control cannot reach the statements after
        # the `if` on that path -- which is what makes an `idx >= count` guard a proof for
        # everything below it.
        def body_terminates(body: darray[Ast::Stmt]) -> bool:
            can Abort.Panic, Memory.Allocate:
                false return if body.count == 0
                match body[body.count - 1]:
                    Stmt.Return(value, line):
                        return true
                    Stmt.Break(label, line):
                        return true
                    Stmt.Continue(label, line):
                        return true
                    _:
                        return false


        # The index list with NAME removed -- the name is now proven in bounds, so an access
        # through it is no longer unchecked.
        def index_params_without(index_params: darray[sview]&, name: sview) -> darray[sview]:
            can Abort.Panic, Memory.Allocate:
                kept: mutable darray[sview] = []
                for candidate in index_params |kept, name|:
                    kept.push(candidate) if candidate != name
                return kept


        def strict_unsafe_walk(statements: darray[Ast::Stmt], array_params: darray[sview]&, index_params: darray[sview]&, unsigned_indexes: darray[sview]&, mutable_params: darray[sview]&, ref_params: darray[sview]&, mutable_globals: darray[sview]&, local_names: darray[sview]&, checked_get_lines: darray[u32]&, mr_fns: darray[sview]&, mr_positions: darray[usize]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Shrinks as bounds guards prove index names: `if i >= xs.count: return`
                # makes `i` proven for every statement below it.
                live_index_params: mutable darray[sview] = []
                for carried in index_params |live_index_params|:
                    live_index_params.push(carried)
                # Locals already MUTABLY borrowed in this statement list. A second mutable
                # borrow of the same local creates two live mutable references to it, which
                # is `Unsafe.Alias` -- stage0 flags exactly this and accepts one borrow,
                # borrows of DIFFERENT locals, and immutable borrows (all verified).
                mutably_borrowed: mutable darray[sview] = []
                # ALL live borrows (stack/& bindings) of locals, with the borrowing
                # binding's mutability: a second borrow where EITHER side is mutable, a
                # rebind adding one, or a mutable-ref CALL on a borrowed local is
                # Unsafe.Alias (stage0's strict rule; pinned four shapes).
                borrow_targets: mutable darray[sview] = []
                borrow_mut: mutable darray[bool] = []
                borrow_binders: mutable darray[sview] = []
                for statement in statements |table, live_index_params, mutably_borrowed, borrow_targets, borrow_mut, borrow_binders| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- strict_unsafe_expression(expression, line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                            table <- strict_borrowed_call_check(expression, line, borrow_targets, mr_fns, mr_positions, in_grant, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- strict_unsafe_expression(value, line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                            borrow_target: sview = address_of_target(value)
                            takes_mutable_borrow: bool = borrow_target != "" and type_marker_present(type_expression, TokenKind.Mutable) and type_marker_present(type_expression, TokenKind.Ampersand)
                            already_borrowed: bool = takes_mutable_borrow and (any b in mutably_borrowed where b == borrow_target)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if already_borrowed and not in_grant
                            mutably_borrowed.push(borrow_target) if takes_mutable_borrow
                            # Stack/& borrows generally: mixing with a MUTABLE-flavored
                            # binding of the same local aliases it.
                            takes_any_borrow: bool = borrow_target != "" and type_marker_present(type_expression, TokenKind.Ampersand)
                            binding_mut: bool = type_marker_present(type_expression, TokenKind.Mutable)
                            if takes_any_borrow:
                                mixed: mutable bool = false
                                borrow_probe: mutable usize = 0
                                while borrow_probe < borrow_targets.count |mixed, borrow_probe, borrow_target, binding_mut, borrow_targets, borrow_mut|:
                                    same_target: bool = borrow_targets[borrow_probe] == borrow_target
                                    mixed <- true if same_target and (binding_mut or borrow_mut[borrow_probe])
                                    borrow_probe <- borrow_probe + 1
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if mixed and not in_grant and not already_borrowed
                                borrow_targets.push(borrow_target)
                                borrow_mut.push(binding_mut)
                                borrow_binders.push(name)
                        Stmt.Assign(target, operator, value, line):
                            table <- strict_unsafe_expression(target, line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                            table <- strict_unsafe_expression(value, line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                            # A REBIND storing `&node` into a ref slot adds a live borrow.
                            rebind_target: sview = address_of_target(value)
                            if rebind_target != "":
                                # Rebinding a SLOT releases its previous borrow first.
                                slot_name: sview = ident_name_of(target)
                                release_probe: mutable usize = 0
                                while release_probe < borrow_binders.count |release_probe, slot_name, borrow_targets, borrow_binders|:
                                    borrow_targets[release_probe] <- sview("", 0, 0) if slot_name != "" and borrow_binders[release_probe] == slot_name
                                    release_probe <- release_probe + 1
                                rebind_mixed: mutable bool = false
                                rebind_probe: mutable usize = 0
                                while rebind_probe < borrow_targets.count |rebind_mixed, rebind_probe, rebind_target, borrow_targets|:
                                    rebind_mixed <- true if borrow_targets[rebind_probe] == rebind_target
                                    rebind_probe <- rebind_probe + 1
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if rebind_mixed and not in_grant
                                borrow_targets.push(rebind_target)
                                borrow_mut.push(true)
                                borrow_binders.push(slot_name)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- strict_unsafe_expression(returned, line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- strict_unsafe_expression(condition, line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                            # Inside the THEN arm, `i < xs.count` holds.
                            # The proof survives only a body that neither REASSIGNS the index
                            # nor CALLS anything: `i <- i + 99` moves the index out of range,
                            # and `xs.truncate(0)` shrinks the container the bound was about.
                            # stage0 flags both (verified); this is the conservative form of
                            # its dataflow -- it can lose a benign call, never over-prove.
                            guarded_now: mutable sview = bounds_guard_name(condition, true, unsigned_indexes)
                            guarded_now <- sview("", 0, 0) if body_invalidates_bounds(then_body, guarded_now)
                            then_index_params: darray[sview] = index_params_without(live_index_params, guarded_now)
                            table <- strict_unsafe_walk(then_body, array_params, then_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, in_grant, table)
                            table <- strict_unsafe_walk(else_body, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, in_grant, table)
                            # `if i >= xs.count: return` — below the guard, `i` is in bounds
                            # on the only path that reaches there.
                            early_guarded: sview = bounds_guard_name(condition, false, unsigned_indexes)
                            live_index_params <- index_params_without(live_index_params, early_guarded) if early_guarded != "" and body_terminates(then_body)
                        Stmt.While(condition, body, line):
                            table <- strict_unsafe_expression(condition, line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                            table <- strict_unsafe_walk(body, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, in_grant, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            grant_here: bool = in_grant or block_kind == "can" or block_kind == "trusted"
                            table <- strict_unsafe_walk(body, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, grant_here, table)
                            # An `assert i < xs.count` INSIDE the block is an established
                            # fact for the statements after it (`can Abort.Panic: assert
                            # i < xs.count` then `return xs[i]` — stage0 accepts).
                            for block_statement in body |live_index_params, unsigned_indexes|:
                                match block_statement:
                                    Stmt.Contract(contract_kind, contract_expression, contract_line):
                                        asserted: sview = bounds_guard_name(contract_expression, true, unsigned_indexes) if contract_kind == "assert" else sview("", 0, 0)
                                        live_index_params <- index_params_without(live_index_params, asserted) if asserted != ""
                                    _:
                                        pass
                        Stmt.Contract(contract_kind, contract_expression, contract_line):
                            asserted_here: sview = bounds_guard_name(contract_expression, true, unsigned_indexes) if contract_kind == "assert" else sview("", 0, 0)
                            live_index_params <- index_params_without(live_index_params, asserted_here) if asserted_here != ""
                        _:
                            pass

        # Mutable-ref parameter POSITIONS of every declared function.
        def collect_mutable_ref_positions(declarations: darray[Ast::Decl], out_fns: mutable darray[sview]&, out_positions: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_fns, out_positions|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            position: mutable usize = 0
                            for parameter in parameters |out_fns, out_positions, position, name|:
                                out_fns.push(name) if param_is_mutable_ref(parameter)
                                out_positions.push(position) if param_is_mutable_ref(parameter)
                                position <- position + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_mutable_ref_positions(module_body, out_fns, out_positions)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_mutable_ref_positions(scoped_body, out_fns, out_positions)
                        _:
                            pass


        # A call passing a BORROWED local at a mutable-ref position aliases the borrow.
        def strict_borrowed_call_check(expression: Ast::Expr, line: u32, borrow_targets: darray[sview]&, mr_fns: darray[sview]&, mr_positions: darray[usize]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if in_grant
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        called: sview = ident_name_of(callee)
                        return if called == ""
                        row: mutable usize = 0
                        while row < mr_fns.count |row, table| -> table:
                            applies: bool = mr_fns[row] == called and mr_positions[row] < arguments.count
                            if applies:
                                passed: sview = ident_name_of(arguments[mr_positions[row]])
                                aliased: bool = passed != "" and (any b in borrow_targets where b == passed)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if aliased
                            row <- row + 1
                    _:
                        pass


        # An access (read or write) to a mutable global (`global`/`global mutable`) requires
        # `can Unsafe.MutableGlobal`. A name shadowed by a param/local is excluded (it is not
        # the global). `const` values (immutable) never require the grant.
        def is_ungranted_mutable_global(name: sview, mutable_globals: darray[sview]&, local_names: darray[sview]&) -> bool:
            can Abort.Panic:
                false return if name == ""
                false return if any local_name in local_names where local_name == name
                return any global_name in mutable_globals where global_name == name

        # Whether an operand is provably an integer: a literal, or an identifier bound to a
        # plain-integer parameter. Used to confirm `ref +/- <int>` is pointer arithmetic.
        def is_int_operand(expression: Ast::Expr, index_params: darray[sview]&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(value):
                        return true
                    Expr.Ident(name, line):
                        return any integer_param in index_params where integer_param == name
                    _:
                        return false

        # A FREE-FUNCTION call as an index carries no range facts, so the access cannot be
        # proven in bounds -- `t[g()]`. stage0 flags this for both `array` and `darray`
        # receivers (verified against `-emit unsafe` both ways).
        #
        # A METHOD-STYLE call is excluded: `table[c.u32()]` is an enum-TAG index, and stage0
        # proves it in bounds from the variant count (check_enum_tag_index carries the
        # too-many-variants half). Treating those as unproven reported two enum lookups
        # stage0 accepts, which is what made a blanket call rule net-negative.
        def index_is_call(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return match callee:
                            Expr.Field(object, field, field_line): false
                            _: true
                    _:
                        return false


        # Scan an expression for mutable-global reads ONLY (never unchecked-index / pointer
        # arithmetic), for positions where the enclosing access is already checked.
        def strict_global_only(expression: Ast::Expr, line: u32, mutable_globals: darray[sview]&, local_names: darray[sview]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if in_grant
                match expression:
                    Expr.Ident(name, ident_line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalUngranted, name: name, line: line, expected: "", actual: ""}) if is_ungranted_mutable_global(name, mutable_globals, local_names)
                    Expr.Field(object, field, field_line):
                        table <- strict_global_only(object, line, mutable_globals, local_names, in_grant, table)
                    Expr.Paren(inner, paren_line):
                        table <- strict_global_only(inner, line, mutable_globals, local_names, in_grant, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- strict_global_only(operand, line, mutable_globals, local_names, in_grant, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- strict_global_only(left, line, mutable_globals, local_names, in_grant, table)
                        table <- strict_global_only(right, line, mutable_globals, local_names, in_grant, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- strict_global_only(object, line, mutable_globals, local_names, in_grant, table)
                        table <- strict_global_only(index_argument, line, mutable_globals, local_names, in_grant, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- strict_global_only(callee, line, mutable_globals, local_names, in_grant, table)
                        for argument in arguments |table| -> table:
                            table <- strict_global_only(argument, line, mutable_globals, local_names, in_grant, table)
                    _:
                        pass

        def strict_unsafe_expression(expression: Ast::Expr, line: u32, array_params: darray[sview]&, index_params: darray[sview]&, mutable_params: darray[sview]&, ref_params: darray[sview]&, mutable_globals: darray[sview]&, local_names: darray[sview]&, checked_get_lines: darray[u32]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if in_grant
                match expression:
                    Expr.Ident(name, ident_line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalUngranted, name: name, line: line, expected: "", actual: ""}) if is_ungranted_mutable_global(name, mutable_globals, local_names)
                    Expr.Index(object, index, index_line):
                        object_name: sview = ident_name_of(object)
                        index_name: sview = ident_name_of(index)
                        # A bare `get xs[i]` parses to a plain Index (the recovery-less
                        # checked read binding an optional); the parser records its line
                        # so the CHECKED access is exempt here.
                        checked_get: bool = any g in checked_get_lines where g == line
                        index_unproven: bool = ((any i in index_params where i == index_name) or index_is_call(index)) and not checked_get
                        is_unproven: bool = (any a in array_params where a == object_name) and index_unproven
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UncheckedIndexUngranted, name: object_name, line: line, expected: "", actual: ""}) if is_unproven and object_name != ""
                        table <- strict_unsafe_expression(object, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        seen: mutable darray[sview] = []
                        aliased: mutable bool = false
                        for argument in arguments |seen, aliased|:
                            base: sview = argument_alias_base(argument, mutable_params)
                            continue if base == ""
                            aliased <- true if any s in seen where s == base
                            seen.push(base)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if aliased
                        for argument in arguments |table| -> table:
                            table <- strict_unsafe_expression(argument, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                    Expr.Binary(left, operator, right, binary_line):
                        # `xs[i] else FALLBACK` — Binary(Index, Else, fallback) is the
                        # inline CHECKED access: the left index never flags; only the
                        # fallback is walked.
                        if operator == TokenKind.Else:
                            table <- strict_unsafe_expression(right, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                            return
                        # Pointer arithmetic: `ref +/- int` or `int + ref` (matching stage0's
                        # binaryExprRequiresUnsafePointerArithmetic — note `int - ref` is NOT).
                        left_ref: bool = any r in ref_params where r == ident_name_of(left)
                        right_ref: bool = any r in ref_params where r == ident_name_of(right)
                        is_add: bool = operator == TokenKind.Plus
                        pointer_arith: bool = ((is_add or operator == TokenKind.Minus) and left_ref and is_int_operand(right, index_params)) or (is_add and right_ref and is_int_operand(left, index_params))
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PointerArithmeticUngranted, name: "", line: line, expected: "", actual: ""}) if pointer_arith
                        table <- strict_unsafe_expression(left, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                        table <- strict_unsafe_expression(right, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- strict_unsafe_expression(operand, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                    Expr.Paren(inner, paren_line):
                        table <- strict_unsafe_expression(inner, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                    # `get xs[i] else 0` — Refinement(fallback, guarded): the guarded
                    # access is CHECKED (absence propagates to the fallback), never an
                    # unchecked index. The fallback itself is still walked.
                    Expr.Refinement(fallback_base, guarded_predicate, refinement_line):
                        table <- strict_unsafe_expression(fallback_base, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, in_grant, table)
                        # The GUARDED value of a `get EXPR else FALLBACK` is a CHECKED access
                        # (absence propagates), so it must NOT be walked for unchecked-index —
                        # but a mutable-global READ inside it (`get counter else 0`) still
                        # requires the grant. Scan it for mutable-global only.
                        table <- strict_global_only(guarded_predicate, line, mutable_globals, local_names, in_grant, table)
                    # `get xs[i] else return/break` — same: the guarded access is checked.
                    Expr.GetElse(guarded_value, recovery_body, getelse_line):
                        pass
                    _:
                        pass

        # Whether PRED is a STRICT `.count` upper bound for NAME (`name < recv.count`,
        # mirrored, or an and-conjunct containing one).
        def requires_predicate_bounds(predicate: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, line):
                        return requires_predicate_bounds(inner, name)
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.And:
                            true return if requires_predicate_bounds(left, name)
                            return requires_predicate_bounds(right, name)
                        (ident_name_of(left) == name and expression_is_count_field(right)) return if operator == TokenKind.Lt
                        (ident_name_of(right) == name and expression_is_count_field(left)) return if operator == TokenKind.Gt
                        return false
                    _:
                        return false


        # The guaranteed MINIMUM `.count` a requires predicate establishes for any
        # container (`regs.count >= 32` → 32, `regs.count > 31` → 32, mirrored forms
        # too); -1 when the predicate says nothing about a count. Conjunctions take the
        # strongest (largest) floor. Used to prove a refined index `[0, hi]` is in
        # bounds: it is safe iff floor >= hi + 1 (worst index hi must be < count).
        def requires_count_floor(predicate: Ast::Expr) -> i64:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, line):
                        return requires_count_floor(inner)
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.And:
                            a: i64 = requires_count_floor(left)
                            b: i64 = requires_count_floor(right)
                            return a if a > b else b
                        if expression_is_count_field(left):
                            literal: (found: bool, value: i64) = fold_const_int(right)
                            if literal.found and operator == TokenKind.GtEq:
                                return literal.value
                            if literal.found and operator == TokenKind.Gt:
                                return literal.value + 1
                            return (-1)
                        if expression_is_count_field(right):
                            mirror: (found: bool, value: i64) = fold_const_int(left)
                            if mirror.found and operator == TokenKind.LtEq:
                                return mirror.value
                            if mirror.found and operator == TokenKind.Lt:
                                return mirror.value + 1
                            return (-1)
                        return (-1)
                    _:
                        return (-1)

        # Whether a refined integer index NAME (its refinement window bounds it to
        # `[lo, hi]`) is PROVABLY in bounds for every array subscript it can reach, so
        # stage0's strict unchecked-index pass stays silent. Sound, structural subset:
        #   - a reassignment of NAME in the body invalidates the window (`idx <- 200`);
        #   - a FIXED-array param (`array[T, N]`) whose extent N > hi bounds it;
        #   - otherwise a `requires C.count >= K` with K > hi bounds it, but ONLY when no
        #     MUTABLE container param is present (a `mutable darray&` can be resized, so the
        #     count fact is not stable — stage0 flags those).
        # Anything else (unknown extent, insufficient bound) leaves it UNPROVEN, so it is
        # treated like a plain integer index and needs `can Unsafe.UncheckedIndex`.
        def refined_index_bounded(name: sview, hi: i64, parameters: darray[Ast::ParamDecl], requires_predicates: darray[Ast::Expr]&, body: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if body_invalidates_bounds(body, name)
                for parameter in parameters |hi|:
                    true return if fixed_array_extent(parameter.type_expression) > hi
                has_mutable_container: bool = any parameter in parameters where is_fixed_array_annotation(parameter.type_expression) and param_is_mutable_ref(parameter)
                if not has_mutable_container:
                    best_floor: mutable i64 = -1
                    for predicate in requires_predicates |best_floor|:
                        floor: i64 = requires_count_floor(predicate)
                        best_floor <- floor if floor > best_floor
                    true return if best_floor >= hi + 1
                return false

        # Whether every requires clause mentioning NAME is a `.count` COMPARISON (the
        # shapes whose non-strict forms stage0 still flags). A requires that constrains
        # the index some OTHER way (`i * 2 < n`, a law application, ...) keeps the
        # original conservative mention-clears-it behavior.
        def requires_only_count_comparisons(predicates: darray[Ast::Expr]&, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for predicate in predicates |name|:
                    mentioned2: mutable darray[sview] = []
                    collect_expression_idents(predicate, mentioned2)
                    continue if not (any m in mentioned2 where m == name)
                    false return if not requires_count_comparison_shape(predicate, name)
                return true


        def requires_count_comparison_shape(predicate: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, line):
                        return requires_count_comparison_shape(inner, name)
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.And:
                            false return if not requires_count_comparison_shape(left, name)
                            return requires_count_comparison_shape(right, name)
                        is_comparison: bool = is_comparison_operator(operator)
                        left_is_name: bool = ident_name_of(left) == name
                        right_is_name: bool = ident_name_of(right) == name
                        (expression_is_count_field(right)) return if is_comparison and left_is_name
                        (expression_is_count_field(left)) return if is_comparison and right_is_name
                        return not (left_is_name or right_is_name)
                    _:
                        return false


        # Whether PARAM is spelled `mutable T&`: the canonical borrow spelling keeps
        # BOTH markers in the type expression (a Mutable unary and an Ampersand unary;
        # see canonical-mutable-borrow-syntax — never trust ParamDecl.is_mutable alone).
        def param_is_mutable_ref(parameter: Ast::ParamDecl) -> bool:
            can Memory.Allocate, Abort.Panic:
                return type_marker_present(parameter.type_expression, TokenKind.Mutable) and type_marker_present(parameter.type_expression, TokenKind.Ampersand)

        def type_marker_present(type_expression: Ast::Expr, marker: TokenKind) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        true return if operator == marker
                        return type_marker_present(operand, marker)
                    _:
                        return false

        # Names of `global`/`global mutable` bindings (Decl.Const with is_mutable) anywhere in
        # the tree. `const` (is_mutable == false) is immutable and never requires the grant.
        def collect_mutable_globals(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Const(name, type_expression, value, is_mutable, line):
                            out.push(name) if is_mutable
                        Decl.Module(module_name, module_body, module_line):
                            collect_mutable_globals(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_mutable_globals(scoped_body, out)
                        _:
                            pass

        # Every local binding introduced in a function body (recursively), so a mutable-global
        # name shadowed by a local is not misreported.
        def collect_local_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_local_names(then_body, out)
                            collect_local_names(else_body, out)
                        Stmt.While(condition, body, line):
                            collect_local_names(body, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            collect_local_names(body, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            collect_local_names(body, out)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out|:
                                collect_local_names(arm.body, out)
                        _:
                            pass

        def strict_unsafe_decls(declarations: darray[Ast::Decl], mutable_globals: darray[sview]&, checked_get_lines: darray[u32]&, mr_fns: darray[sview]&, mr_positions: darray[usize]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # Signature `can[...]` effects conservatively grant everything.
                            continue if effects.count > 0
                            # Generic contexts (impl[T] members, generic fns) keep
                            # stage0's generic-context suppression.
                            continue if any generic_line in table.generic_param_lines where generic_line == line or generic_line == line + 2147483648
                            array_params: mutable darray[sview] = []
                            index_params: mutable darray[sview] = []
                            unsigned_indexes: mutable darray[sview] = []
                            mutable_params: mutable darray[sview] = []
                            ref_params: mutable darray[sview] = []
                            local_names: mutable darray[sview] = []
                            requires_names: mutable darray[sview] = []
                            requires_predicates2: mutable darray[Ast::Expr] = []
                            for statement in body |requires_names, requires_predicates2|:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        contract_kind: sview = kind
                                        collect_expression_idents(expression, requires_names) if contract_kind == "requires"
                                        requires_predicates2.push(expression) if contract_kind == "requires"
                                    _:
                                        pass
                            for parameter in parameters |array_params, index_params, unsigned_indexes, mutable_params, ref_params, local_names, parameters, body, requires_predicates2, law_names, law_predicates|:
                                array_params.push(parameter.name) if is_fixed_array_annotation(parameter.type_expression)
                                is_plain_integer: bool = bare_type_name(parameter.type_expression) == "i64" or bare_type_name(parameter.type_expression) == "usize" or bare_type_name(parameter.type_expression) == "u64" or bare_type_name(parameter.type_expression) == "int" or bare_type_name(parameter.type_expression) == "u32" or bare_type_name(parameter.type_expression) == "i32"
                                # A `requires` MENTION alone no longer clears an index: the
                                # clause must be a proper STRICT upper bound against a
                                # `.count` (`requires i <= xs.count` still leaves i one past
                                # the end — stage0 flags it).
                                mentioned: bool = any r in requires_names where r == parameter.name
                                strictly_bounded: bool = any pred in requires_predicates2 where requires_predicate_bounds(pred, parameter.name)
                                unconstrained: bool = (not mentioned) or (mentioned and not strictly_bounded and requires_only_count_comparisons(requires_predicates2, parameter.name))
                                index_params.push(parameter.name) if is_plain_integer and unconstrained
                                # A REFINED integer index (`idx: u32 is InRange[0, hi]`) is a
                                # plain integer to bare_type_name (its type is `Binary(u32, Is,
                                # ...)`), so it slips past the check above. stage0's strict pass
                                # ignores the refinement UNLESS it provably bounds the index
                                # below every reachable extent — otherwise it still needs the
                                # grant. Treat an UNPROVEN refined index like a plain one.
                                refined_window: (refined: bool, found: bool, lo: i64, hi: i64) = index_annotation_window(parameter.type_expression, law_names, law_predicates)
                                index_params.push(parameter.name) if refined_window.refined and refined_window.found and not refined_index_bounded(parameter.name, refined_window.hi, parameters, requires_predicates2, body)
                                is_unsigned: bool = bare_type_name(parameter.type_expression) == "usize" or bare_type_name(parameter.type_expression) == "u64" or bare_type_name(parameter.type_expression) == "u32"
                                unsigned_indexes.push(parameter.name) if is_unsigned
                                mutable_params.push(parameter.name) if param_is_mutable_ref(parameter)
                                ref_params.push(parameter.name) if type_marker_present(parameter.type_expression, TokenKind.Ampersand)
                                local_names.push(parameter.name)
                            collect_local_names(body, local_names)
                            table <- strict_unsafe_walk(body, array_params, index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- strict_unsafe_decls(module_body, mutable_globals, checked_get_lines, mr_fns, mr_positions, law_names, law_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- strict_unsafe_decls(scoped_body, mutable_globals, checked_get_lines, mr_fns, mr_positions, law_names, law_predicates, table)
                        _:
                            pass

        # Names of every `extern` function anywhere in the tree. stage0 marks each extern
        # fnType with an unconditional `Unsafe.RawExtern` permission ref (markRawExternFuncType,
        # gated only on enforceUnsafePermissions), so EVERY call to one requires the grant.
        def collect_extern_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            out.push(name)
                        Decl.Module(module_name, module_body, module_line):
                            collect_extern_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_extern_names(scoped_body, out)
                        _:
                            pass

        # Flag a direct call to a raw extern (`c_puts(text)`) outside any effect grant. A
        # METHOD/UFCS callee (`x.f()`) is not a bare extern name; only Ident callees match.
        def strict_extern_call_expression(expression: Ast::Expr, line: u32, extern_names: darray[sview]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        called: sview = ident_name_of(callee)
                        is_extern: bool = called != "" and (any e in extern_names where e == called)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: called, line: line, expected: "Unsafe.RawExtern", actual: "Unsafe"}) if is_extern and not in_grant
                        for argument in arguments |table| -> table:
                            table <- strict_extern_call_expression(argument, line, extern_names, in_grant, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- strict_extern_call_expression(left, line, extern_names, in_grant, table)
                        table <- strict_extern_call_expression(right, line, extern_names, in_grant, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- strict_extern_call_expression(operand, line, extern_names, in_grant, table)
                    Expr.Paren(inner, paren_line):
                        table <- strict_extern_call_expression(inner, line, extern_names, in_grant, table)
                    Expr.Index(object, index, index_line):
                        table <- strict_extern_call_expression(object, line, extern_names, in_grant, table)
                        table <- strict_extern_call_expression(index, line, extern_names, in_grant, table)
                    _:
                        pass

        def strict_extern_call_walk(statements: darray[Ast::Stmt], extern_names: darray[sview]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- strict_extern_call_expression(expression, line, extern_names, in_grant, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- strict_extern_call_expression(value, line, extern_names, in_grant, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- strict_extern_call_expression(target, line, extern_names, in_grant, table)
                            table <- strict_extern_call_expression(value, line, extern_names, in_grant, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- strict_extern_call_expression(returned, line, extern_names, in_grant, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- strict_extern_call_expression(condition, line, extern_names, in_grant, table)
                            table <- strict_extern_call_walk(then_body, extern_names, in_grant, table)
                            table <- strict_extern_call_walk(else_body, extern_names, in_grant, table)
                        Stmt.While(condition, body, line):
                            table <- strict_extern_call_expression(condition, line, extern_names, in_grant, table)
                            table <- strict_extern_call_walk(body, extern_names, in_grant, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- strict_extern_call_walk(body, extern_names, in_grant, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            grant_here: bool = in_grant or kind == "can" or kind == "trusted"
                            table <- strict_extern_call_walk(body, extern_names, grant_here, table)
                        _:
                            pass

        # Every raw-extern call obligation: skip functions with signature effects (a
        # conservative over-grant, mirroring the bounds/alias pass) and grant blocks.
        def strict_extern_call_decls(declarations: darray[Ast::Decl], extern_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            continue if effects.count > 0
                            table <- strict_extern_call_walk(body, extern_names, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- strict_extern_call_decls(module_body, extern_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- strict_extern_call_decls(scoped_body, extern_names, table)
                        _:
                            pass

        # Whether TYPE_EXPRESSION spells a `view[T]` / `sview` — a borrowed window whose
        # backing can be invalidated out from under it.
        def is_view_annotation(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, line):
                        head: sview = ident_name_of(object)
                        return head == "view" or head == "sview"
                    Expr.Ident(name, line):
                        return name == "sview" or name == "view"
                    Expr.Unary(operator, operand, line):
                        return is_view_annotation(operand)
                    Expr.Paren(inner, line):
                        return is_view_annotation(inner)
                    _:
                        return false

        # The CONTAINER a slice/index initializer borrows from, when it is one of the known
        # mutable containers; "" otherwise. `items[0:items.count]` and `items[i]` both borrow.
        def slice_source_container(value: Ast::Expr, containers: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Slice(object, low, high, line):
                        name: sview = ident_name_of(object)
                        return name if (any c in containers where c == name) else sview("", 0, 0)
                    Expr.Index(object, index, line):
                        iname: sview = ident_name_of(object)
                        return iname if (any c in containers where c == iname) else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Definite darray mutators — a call to one of these invalidates every live view of
        # the receiver. A conservative whitelist (never a read accessor), so marking a view
        # stale is always sound.
        def is_container_mutator(method: sview) -> bool:
            can Abort.Panic:
                return method == "clear" or method == "push" or method == "pop" or method == "truncate" or method == "insert" or method == "remove" or method == "extend" or method == "resize" or method == "sort" or method == "reverse" or method == "append" or method == "drain" or method == "retain" or method == "swap_remove"

        # The receiver container an expression MUTATES (`items.clear()`), or "".
        def mutating_container(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                return ident_name_of(object) if is_container_mutator(field) else sview("", 0, 0)
                            _:
                                return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Whether EXPRESSION reads through a now-stale view: an index over it (`view[0]`) or a
        # bare mention (returning/forwarding the stale window).
        def expression_reads_stale_view(expression: Ast::Expr, stale_views: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return any s in stale_views where s == name
                    Expr.Index(object, index, line):
                        return expression_reads_stale_view(object, stale_views) or expression_reads_stale_view(index, stale_views)
                    Expr.Slice(object, low, high, line):
                        return expression_reads_stale_view(object, stale_views) or expression_reads_stale_view(low, stale_views) or expression_reads_stale_view(high, stale_views)
                    Expr.Binary(left, operator, right, line):
                        return expression_reads_stale_view(left, stale_views) or expression_reads_stale_view(right, stale_views)
                    Expr.Unary(operator, operand, line):
                        return expression_reads_stale_view(operand, stale_views)
                    Expr.Paren(inner, line):
                        return expression_reads_stale_view(inner, stale_views)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments:
                            true return if expression_reads_stale_view(argument, stale_views)
                        return false
                    _:
                        return false

        # Linear staleness walk: register `view[T]` locals sliced from a mutable container,
        # mark them stale at the container's first mutator call, and flag any read through a
        # stale view NOT covered by a `Unsafe.StaleRef` grant. `stale_granted` is inherited
        # from an enclosing `can/trusted Unsafe.StaleRef:` (a DIFFERENT grant does not
        # discharge it). view_names/view_srcs/view_stale are parallel; state is
        # function-scoped, so nested blocks share and mutate it.
        def stale_view_walk(statements: darray[Ast::Stmt], containers: darray[sview]&, view_names: mutable darray[sview]&, view_srcs: mutable darray[sview]&, view_stale: mutable darray[bool]&, stale_granted: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                stale_now: mutable darray[sview] = []
                probe0: mutable usize = 0
                while probe0 < view_names.count |stale_now, probe0, view_names, view_stale|:
                    stale_now.push(view_names[probe0]) if view_stale[probe0]
                    probe0 <- probe0 + 1
                for statement in statements |table, view_names, view_srcs, view_stale, stale_now| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and expression_reads_stale_view(value, stale_now)
                            source: sview = slice_source_container(value, containers)
                            if is_view_annotation(type_expression) and source != "":
                                view_names.push(name)
                                view_srcs.push(source)
                                view_stale.push(false)
                        Stmt.Assign(target, operator, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and (expression_reads_stale_view(value, stale_now) or expression_reads_stale_view(target, stale_now))
                        Stmt.Expr(expression, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and expression_reads_stale_view(expression, stale_now)
                            mutated: sview = mutating_container(expression)
                            if mutated != "":
                                mark_probe: mutable usize = 0
                                while mark_probe < view_names.count |mark_probe, mutated, view_srcs, view_stale, stale_now|:
                                    if view_srcs[mark_probe] == mutated:
                                        view_stale[mark_probe] <- true
                                        stale_now.push(view_names[mark_probe])
                                    mark_probe <- mark_probe + 1
                        Stmt.Return(value, line):
                            if value is returned:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and expression_reads_stale_view(returned, stale_now)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- stale_view_walk(then_body, containers, view_names, view_srcs, view_stale, stale_granted, table)
                            table <- stale_view_walk(else_body, containers, view_names, view_srcs, view_stale, stale_granted, table)
                        Stmt.While(condition, body, line):
                            table <- stale_view_walk(body, containers, view_names, view_srcs, view_stale, stale_granted, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- stale_view_walk(body, containers, view_names, view_srcs, view_stale, stale_granted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            grants_stale: bool = stale_granted or ((kind == "can" or kind == "trusted") and (any grant in clause where grant == "Unsafe.StaleRef" or grant == "StaleRef"))
                            table <- stale_view_walk(body, containers, view_names, view_srcs, view_stale, grants_stale, table)
                        _:
                            pass

        def stale_view_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            continue if effects.count > 0
                            containers: mutable darray[sview] = []
                            for parameter in parameters |containers|:
                                containers.push(parameter.name) if param_is_mutable_ref(parameter)
                            continue if containers.count == 0
                            view_names: mutable darray[sview] = []
                            view_srcs: mutable darray[sview] = []
                            view_stale: mutable darray[bool] = []
                            table <- stale_view_walk(body, containers, view_names, view_srcs, view_stale, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- stale_view_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- stale_view_decls(scoped_body, table)
                        _:
                            pass

        # `enforce_raw_unsafe` is stage0's pure EnforceUnsafePermissions (NOT the strict-proofs
        # union): the raw-extern obligation fires only under it.
        def check_strict_unsafe_ops(file: Ast::File&, enforce_raw_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                mutable_globals: mutable darray[sview] = []
                collect_mutable_globals(file.top_decls, mutable_globals)
                extern_names: mutable darray[sview] = []
                collect_extern_names(file.top_decls, extern_names)
                table <- strict_extern_call_decls(file.top_decls, extern_names, table) if enforce_raw_unsafe and extern_names.count > 0
                table <- stale_view_decls(file.top_decls, table) if enforce_raw_unsafe
                checked_get_lines: mutable darray[u32] = []
                for annotation in file.enum_annotations |checked_get_lines|:
                    checked_get_lines.push(annotation.line) if annotation.owner == "__checked_get"
                mr_fns: mutable darray[sview] = []
                mr_positions: mutable darray[usize] = []
                collect_mutable_ref_positions(file.top_decls, mr_fns, mr_positions)
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, law_names, law_predicates)
                table <- strict_unsafe_decls(file.top_decls, mutable_globals, checked_get_lines, mr_fns, mr_positions, law_names, law_predicates, table)

        # Append every ident name in EXPRESSION to OUT (requires-mention collection).
        def collect_expression_idents(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Binary(left, operator, right, line):
                        collect_expression_idents(left, out)
                        collect_expression_idents(right, out)
                    Expr.Unary(operator, operand, line):
                        collect_expression_idents(operand, out)
                    Expr.Paren(inner, line):
                        collect_expression_idents(inner, out)
                    Expr.Index(object, index, line):
                        collect_expression_idents(object, out)
                        collect_expression_idents(index, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            collect_expression_idents(argument, out)
                    _:
                        pass
