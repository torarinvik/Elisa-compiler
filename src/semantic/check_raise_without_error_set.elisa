# Error-union diagnostic (docs/62 §3.3): a `raise` statement requires the enclosing
# function to declare an error-union return set (`-> T error[E]`). Stage0 emits "raise
# requires the current function to return an error union" at each such `raise` whose
# function declares no error set.
#
# In stage1 the `raise` keyword parses to a bare `Expr.Ident("raise")` leaf (its operand
# is not modeled yet), so a `raise` statement surfaces as `Stmt.Expr(Expr.Ident("raise"))`.
# `raise` is a reserved keyword (lexed to TokenKind.Raise), so no user identifier can spell
# it — every such leaf is a genuine raise.
#
# SOUNDNESS (zero false positives is the prime directive): fire ONLY on a statement-position
# `raise` inside a function whose signature declared NO `error[...]` set. The declared-set
# presence is recorded by the parser (File.error_set_func_lines) exhaustively — every
# error-set function's line is pushed — so a function that has an error set is NEVER flagged.
# A `raise` buried in a sub-expression (e.g. a lambda body) is not at statement position and
# is a sound miss, never a fire. `error[...]` is the only error-union return spelling
# (docs/62), so exemption is complete.
extend Semantic:
    private:
        # Whether a source line is among the recorded error-set-declaring function lines.
        def line_declares_error_set(lines: darray[u32], target: u32) -> bool:
            for candidate in lines:
                candidate_line: u32 = candidate
                true return if candidate_line == target
            return false


        # Whether an expression is a statement-position `raise` leaf. The match-bound name
        # is copied to a local before comparison (stage1 codegen mis-lowers a match-bound
        # sview field compared to a literal inside a plain `for`).
        def is_raise_expression(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Ident(name, ident_line):
                    ident_name: sview = name
                    return ident_name == "raise"
                Expr.Call(callee, arguments, argument_names, call_line):
                    return is_raise_expression(callee)
                _:
                    return false


        def raised_error_owner(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(Expr.Ident(head, head_line), arguments, argument_names, call_line):
                    if arguments.count > 0:
                        match arguments[0]:
                            Expr.Field(object, tag, tag_line):
                                match object:
                                    Expr.Ident(owner, owner_line):
                                        return owner
                                    _:
                                        pass
                            _:
                                pass
                _:
                    pass
            return ""


        def raised_error_tag(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(Expr.Ident(head, head_line), arguments, argument_names, call_line):
                    if arguments.count > 0:
                        match arguments[0]:
                            Expr.Field(object, tag, tag_line):
                                match object:
                                    Expr.Ident(owner, owner_line):
                                        return tag
                                    _:
                                        pass
                            _:
                                pass
                _:
                    pass
            return ""


        def error_family_symbol_position(table: SymbolTable&, family: sview) -> usize:
            can Abort.Panic:
                # Was an O(symbols.count) scan of every declaration in the whole program — see
                # the matching comment on direct_function_count in resolve_expr.elisa.
                cur: mutable u32 = symbol_chain_head(table, family)
                while cur != 4294967295:
                    cur.usize() return if table.symbols[cur.usize()].name == family
                    cur <- table.symbol_name_next[cur.usize()]
                return table.symbols.count


        def check_raise_destination(expression: Ast::Expr, line: u32, function_line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                source_owner: sview = raised_error_owner(expression)
                source_tag: sview = raised_error_tag(expression)
                return if source_owner == "" or source_tag == ""
                # Variant-subset restriction: `error[FooError{Bad1}]` allows only Bad1, so a
                # raise of another FooError variant cannot propagate.
                family_restricted: bool = any restriction in annotations where restriction.owner == "__error_variant_family" and restriction.name == source_owner and restriction.line == function_line
                if family_restricted:
                    variant_allowed: bool = any allow in annotations where allow.owner == "__error_variant_allow" and allow.name == source_tag and allow.line == function_line
                    if not variant_allowed:
                        allowed_variant: mutable sview = source_tag
                        for allow in annotations |allowed_variant|:
                            allowed_variant <- allow.name if allow.owner == "__error_variant_allow" and allow.line == function_line
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RaiseVariantNotAllowed, name: source_owner, line: line, expected: source_owner, actual: source_tag, detail: allowed_variant})
                        return
                families: mutable darray[sview] = []
                families.extend([annotation.name for annotation in annotations if annotation.owner == "__error_set_family" and annotation.line == function_line])
                return if families.count < 2
                source_is_destination: bool = any family in families where family == source_owner
                # The raised VARIANT itself may be listed bare in the destination set
                # (`error[IndentError, …]` accepts `raise LexError.IndentError` because
                # `IndentError` is a member). stage0 matches the tag nominally, not just
                # the owning family.
                tag_is_destination: bool = any family in families where family == source_tag
                return if source_is_destination or tag_is_destination
                first: mutable sview = families[0]
                second: mutable sview = families[1]
                swap: bool = error_family_symbol_position(table, second) < error_family_symbol_position(table, first)
                first, second <- second, first if swap
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RaiseDestinationMismatch, name: source_owner, line: line, expected: first, actual: source_tag, detail: second})


        # Descend into a value expression's `try … else e: BLOCK` recovery (Expr.GetElse):
        # its statements can raise, and must be checked with the enclosing function context.
        def check_raise_expr_recovery(expression: Ast::Expr, func_exempt: bool, function_line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.GetElse(guarded, recovery, getelse_line):
                        table <- check_raise_statements(recovery, func_exempt, function_line, annotations, table)
                        table <- check_raise_expr_recovery(guarded, func_exempt, function_line, annotations, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- check_raise_expr_recovery(argument, func_exempt, function_line, annotations, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- check_raise_expr_recovery(left, func_exempt, function_line, annotations, table)
                        table <- check_raise_expr_recovery(right, func_exempt, function_line, annotations, table)
                    Expr.Paren(inner, paren_line):
                        table <- check_raise_expr_recovery(inner, func_exempt, function_line, annotations, table)
                    _:
                        pass

        # Walk statement-position raises: require an error set, then validate that a
        # cross-family tag has an unambiguous destination in multi-family sets. Descends
        # every block-bearing statement, mirroring check_ungranted_panic_statements.
        def check_raise_statements(statements: darray[Ast::Stmt], func_exempt: bool, function_line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RaiseWithoutErrorSet, name: "", line: line.line, expected: "", actual: ""}) if not func_exempt and is_raise_expression(expression)
                            table <- check_raise_destination(expression, line.line, function_line, annotations, table) if func_exempt and is_raise_expression(expression)
                            table <- check_raise_expr_recovery(expression, func_exempt, function_line, annotations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_raise_statements(body, func_exempt, function_line, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_raise_statements(then_body, func_exempt, function_line, annotations, table)
                            table <- check_raise_statements(else_body, func_exempt, function_line, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- check_raise_statements(body, func_exempt, function_line, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_raise_statements(body, func_exempt, function_line, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_raise_statements(arm.body, func_exempt, function_line, annotations, table)
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_raise_expr_recovery(value, func_exempt, function_line, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_raise_expr_recovery(value, func_exempt, function_line, annotations, table)


        # Recurse through every function body (descending Module/Scoped). A function whose
        # signature declared an `error[...]` set (its line is in `error_set_lines`) is exempt.
        def check_raise_without_error_set_decls(declarations: darray[Ast::Decl], error_set_lines: darray[u32], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            func_exempt: bool = line_declares_error_set(error_set_lines, line.line)
                            table <- check_raise_statements(body, func_exempt, line.line, annotations, table)
                        Decl.Module(name, body, line):
                            table <- check_raise_without_error_set_decls(body, error_set_lines, annotations, table)
                        Decl.Scoped(body, line):
                            table <- check_raise_without_error_set_decls(body, error_set_lines, annotations, table)
                        _:
                            pass


        def check_raise_without_error_set(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_raise_without_error_set_decls(file.top_decls, file.error_set_func_lines, file.enum_annotations, table)
