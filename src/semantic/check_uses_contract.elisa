# `uses CONTRACT(args)` obligations (docs/85 named contracts). A `contract C(p, q):`
# declaration parses as a Decl.Func tagged `__contract_decl`; a function's leading
# `uses C(x, k)` clause instantiates C's requires/ensure over its own parameters.
# Two decidable subsets are checked here (stage0 parity; the general prover stays
# stage0's job):
#   1. Explicit-generic argument typing: `uses C[bool](0, 100)` — an integer literal
#      argument can never inhabit an explicit non-numeric type argument.
#   2. Caller precondition violation: a contract `requires PARAM CMP INTLIT` clause
#      threaded through `uses C(param)` becomes the using function's own requires;
#      a DIRECT call passing an integer literal that provably fails it is an error.
extend Semantic:
    private:
        # Rows describing `requires PARAM CMP INTLIT` clauses of contract decls:
        # parallel arrays (contract name, contract-param index, operator, bound).
        def collect_contract_requires(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, names: mutable darray[sview]&, positions: mutable darray[i64]&, operators: mutable darray[TokenKind]&, bounds: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, positions, operators, bounds|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            continue if not (any row in annotations where row.owner == function_name and row.name == "__contract_decl")
                            for statement in body |names, positions, operators, bounds|:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        contract_kind: sview = kind
                                        continue if contract_kind != "requires"
                                        match expression:
                                            Expr.Binary(left, operator, right, binary_line):
                                                bound_param: sview = ident_name_of(left)
                                                continue if bound_param == ""
                                                right_known: mutable bool = false
                                                bound_value: i64 = int_literal_value(right, right_known)
                                                continue if not right_known
                                                for parameter in parameters |names, positions, operators, bounds, parameter_index: i64 = 0|:
                                                    if parameter.name == bound_param:
                                                        names.push(function_name)
                                                        positions.push(parameter_index)
                                                        operators.push(operator)
                                                        bounds.push(bound_value)
                                                    parameter_index <- parameter_index + 1
                                            _:
                                                pass
                                    _:
                                        pass
                        Decl.Module(module_name, module_body, module_line):
                            collect_contract_requires(module_body, annotations, names, positions, operators, bounds)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_contract_requires(scoped_body, annotations, names, positions, operators, bounds)
                        _:
                            pass

        # Rows for contract `ensure result CMP PARAM` clauses: (contract name,
        # contract-param index, operator).
        def collect_contract_ensures(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, names: mutable darray[sview]&, positions: mutable darray[i64]&, operators: mutable darray[TokenKind]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, positions, operators|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            continue if not (any row in annotations where row.owner == function_name and row.name == "__contract_decl")
                            for statement in body |names, positions, operators|:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        contract_kind: sview = kind
                                        continue if contract_kind != "ensure"
                                        match expression:
                                            Expr.Binary(left, operator, right, binary_line):
                                                continue if ident_name_of(left) != "result"
                                                target_param: sview = ident_name_of(right)
                                                continue if target_param == ""
                                                for parameter in parameters |names, positions, operators, ensure_param_index: i64 = 0|:
                                                    if parameter.name == target_param:
                                                        names.push(function_name)
                                                        positions.push(ensure_param_index)
                                                        operators.push(operator)
                                                    ensure_param_index <- ensure_param_index + 1
                                            _:
                                                pass
                                    _:
                                        pass
                        Decl.Module(module_name, module_body, module_line):
                            collect_contract_ensures(module_body, annotations, names, positions, operators)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_contract_ensures(scoped_body, annotations, names, positions, operators)
                        _:
                            pass

        # Whether BODY's sole return is `PARAM_NAME +/- INTLIT`; OFFSET receives the
        # signed constant when so.
        def return_offset_from_param(body: darray[Ast::Stmt], param_name: sview, offset: mutable i64&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in body:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                match returned:
                                    Expr.Binary(left, operator, right, binary_line):
                                        false return if ident_name_of(left) != param_name
                                        amount_known: mutable bool = false
                                        amount: i64 = int_literal_value(right, amount_known)
                                        false return if not amount_known
                                        if operator == TokenKind.Plus:
                                            offset <- amount
                                            return true
                                        if operator == TokenKind.Minus:
                                            offset <- 0 - amount
                                            return true
                                        return false
                                    _:
                                        return false
                        _:
                            pass
                return false

        # The contract param NAME at POSITION ("" out of range).
        def contract_param_name_at(declarations: darray[Ast::Decl], contract_name: sview, position: usize) -> sview:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            parameters[position].name return if function_name == contract_name and position < parameters.count
                        Decl.Module(module_name, module_body, module_line):
                            nested: sview = contract_param_name_at(module_body, contract_name, position)
                            nested return if nested != ""
                        Decl.Scoped(scoped_body, scoped_line):
                            nested_scoped: sview = contract_param_name_at(scoped_body, contract_name, position)
                            nested_scoped return if nested_scoped != ""
                        _:
                            pass
                return sview("", 0, 0)

        # Decompose a `uses` clause expression `C(args)` / `C[T](args)` into its
        # contract name and explicit type-argument name ("" when ungeneric).
        def uses_contract_name(expression: Ast::Expr, type_argument: mutable sview&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Ident(direct_name, direct_line):
                                type_argument <- sview("", 0, 0)
                                return direct_name
                            Expr.Index(indexed, index, index_line):
                                type_argument <- ident_name_of(index)
                                return ident_name_of(indexed)
                            _:
                                return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Per-function constraint rows derived from `uses`: (function, param index,
        # operator, bound) — a caller passing a literal violating one is flagged.
        def check_uses_contract(declarations: darray[Ast::Decl], file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                contract_names: mutable darray[sview] = []
                contract_positions: mutable darray[i64] = []
                contract_operators: mutable darray[TokenKind] = []
                contract_bounds: mutable darray[i64] = []
                collect_contract_requires(declarations, file.enum_annotations, contract_names, contract_positions, contract_operators, contract_bounds)
                ensure_names: mutable darray[sview] = []
                ensure_positions: mutable darray[i64] = []
                ensure_operators: mutable darray[TokenKind] = []
                collect_contract_ensures(declarations, file.enum_annotations, ensure_names, ensure_positions, ensure_operators)
                function_names: mutable darray[sview] = []
                function_positions: mutable darray[i64] = []
                function_operators: mutable darray[TokenKind] = []
                function_bounds: mutable darray[i64] = []
                table <- collect_uses_constraints(declarations, declarations, contract_names, contract_positions, contract_operators, contract_bounds, ensure_names, ensure_positions, ensure_operators, function_names, function_positions, function_operators, function_bounds, table)
                table <- flag_violating_callers(declarations, function_names, function_positions, function_operators, function_bounds, table)

        def collect_uses_constraints(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl], contract_names: darray[sview]&, contract_positions: darray[i64]&, contract_operators: darray[TokenKind]&, contract_bounds: darray[i64]&, ensure_names: darray[sview]&, ensure_positions: darray[i64]&, ensure_operators: darray[TokenKind]&, function_names: mutable darray[sview]&, function_positions: mutable darray[i64]&, function_operators: mutable darray[TokenKind]&, function_bounds: mutable darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, function_names, function_positions, function_operators, function_bounds| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for statement in body |table, function_names, function_positions, function_operators, function_bounds| -> table:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        contract_kind: sview = kind
                                        continue if contract_kind != "uses"
                                        type_argument: mutable sview = sview("", 0, 0)
                                        used_contract: sview = uses_contract_name(expression, type_argument)
                                        continue if used_contract == ""
                                        match expression:
                                            Expr.Call(callee, arguments, argument_names, call_line):
                                                # Subset 1: an explicit non-numeric type argument
                                                # (`C[bool](0, 100)`) can never take integer literals.
                                                if type_argument == "bool":
                                                    for argument in arguments |table, argument_index: usize = 0| -> table:
                                                        argument_known: mutable bool = false
                                                        _ = int_literal_value(argument, argument_known)
                                                        if argument_known:
                                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContractArgTypeMismatch, name: used_contract, line: contract_line, expected: type_argument, actual: "int", expected_count: (argument_index + 1).u32(), detail: contract_param_name_at(all_declarations, used_contract, argument_index)})
                                                        argument_index <- argument_index + 1
                                                # Subset 3: a uses-derived `ensure result CMP PARAM`
                                                # against a sole `return PARAM +/- LIT` evaluates to
                                                # OFFSET CMP 0 — flag when provably false.
                                                while ensure_index < ensure_names.count |ensure_index: usize = 0, table|:
                                                    ensure_applies: bool = ensure_names[ensure_index] == used_contract and ensure_positions[ensure_index].usize() < arguments.count
                                                    bound_function_param: sview = ident_name_of(arguments[ensure_positions[ensure_index].usize()]) if ensure_applies else sview("", 0, 0)
                                                    return_offset: mutable i64 = 0
                                                    offset_known: bool = return_offset_from_param(body, bound_function_param, return_offset) if ensure_applies and bound_function_param != "" else false
                                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnsureNotProven, name: function_name, line: contract_line, expected: "", actual: ""}) if offset_known and not integer_comparison_holds(return_offset, ensure_operators[ensure_index], 0)
                                                    ensure_index <- ensure_index + 1
                                                # Subset 2: thread `requires PARAM CMP LIT` rows onto
                                                # this function's params via the uses arguments.
                                                while row_index < contract_names.count |row_index: usize = 0, function_names, function_positions, function_operators, function_bounds|:
                                                    if contract_names[row_index] == used_contract and contract_positions[row_index].usize() < arguments.count:
                                                        used_argument: sview = ident_name_of(arguments[contract_positions[row_index].usize()])
                                                        for parameter in parameters |function_names, function_positions, function_operators, function_bounds, parameter_position: i64 = 0|:
                                                            if parameter.name == used_argument and used_argument != "":
                                                                function_names.push(function_name)
                                                                function_positions.push(parameter_position)
                                                                function_operators.push(contract_operators[row_index])
                                                                function_bounds.push(contract_bounds[row_index])
                                                            parameter_position <- parameter_position + 1
                                                    row_index <- row_index + 1
                                            _:
                                                pass
                                    _:
                                        pass
                        Decl.Module(module_name, module_body, module_line):
                            table <- collect_uses_constraints(module_body, all_declarations, contract_names, contract_positions, contract_operators, contract_bounds, ensure_names, ensure_positions, ensure_operators, function_names, function_positions, function_operators, function_bounds, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- collect_uses_constraints(scoped_body, all_declarations, contract_names, contract_positions, contract_operators, contract_bounds, ensure_names, ensure_positions, ensure_operators, function_names, function_positions, function_operators, function_bounds, table)
                        _:
                            pass

        # Walk every function body; a direct call `f(..., LIT, ...)` where LIT
        # provably fails one of f's uses-derived requires rows is an error.
        def flag_violating_callers(declarations: darray[Ast::Decl], function_names: darray[sview]&, function_positions: darray[i64]&, function_operators: darray[TokenKind]&, function_bounds: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- flag_violating_calls_in(body, function_names, function_positions, function_operators, function_bounds, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- flag_violating_callers(module_body, function_names, function_positions, function_operators, function_bounds, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- flag_violating_callers(scoped_body, function_names, function_positions, function_operators, function_bounds, table)
                        _:
                            pass

        def flag_violating_calls_in(statements: darray[Ast::Stmt], function_names: darray[sview]&, function_positions: darray[i64]&, function_operators: darray[TokenKind]&, function_bounds: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- flag_violating_call(expression, line, function_names, function_positions, function_operators, function_bounds, table)
                        Stmt.VarDecl(declared_name, type_expression, value, line):
                            table <- flag_violating_call(value, line, function_names, function_positions, function_operators, function_bounds, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- flag_violating_call(value, line, function_names, function_positions, function_operators, function_bounds, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- flag_violating_call(returned, line, function_names, function_positions, function_operators, function_bounds, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- flag_violating_calls_in(then_body, function_names, function_positions, function_operators, function_bounds, table)
                            table <- flag_violating_calls_in(else_body, function_names, function_positions, function_operators, function_bounds, table)
                        Stmt.While(condition, body, line):
                            table <- flag_violating_calls_in(body, function_names, function_positions, function_operators, function_bounds, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- flag_violating_calls_in(body, function_names, function_positions, function_operators, function_bounds, table)
                        _:
                            pass

        def flag_violating_call(expression: Ast::Expr, line: u32, function_names: darray[sview]&, function_positions: darray[i64]&, function_operators: darray[TokenKind]&, function_bounds: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        return if callee_name == ""
                        while row_index < function_names.count |row_index: usize = 0, table|:
                            row_matches: bool = function_names[row_index] == callee_name and function_positions[row_index].usize() < arguments.count
                            argument_known: mutable bool = false
                            argument_value: i64 = int_literal_value(arguments[function_positions[row_index].usize()], argument_known) if row_matches else 0
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UsesPreconditionViolated, name: callee_name, line: line, expected: "", actual: ""}) if row_matches and argument_known and not integer_comparison_holds(argument_value, function_operators[row_index], function_bounds[row_index])
                            row_index <- row_index + 1
                    _:
                        pass
