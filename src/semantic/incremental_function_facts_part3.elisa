extend Semantic:
    private:
        # Persist one canonical layout so records do not depend on the order in which
        # their owned key, body, and freshly scanned fact spans were appended.
        def ifc_canonical_layout[@input_region, @output, @hits_region](snapshot: IncrementalSemanticSnapshot[input_region], validated_body_query_hits: mutable darray[IncrementalSemanticBodyQueryHitMarker]& @hits_region) -> IncrementalSemanticSnapshot[output] @output:
            can Memory.Allocate, Abort.Panic:
                # Copy scalar metadata and allocate every pool in the declared output region.
                # No descriptor from the input snapshot may escape through this return value.
                options_key: mutable darray[u8] @output = []
                bytes: mutable darray[u8] @output = []
                functions: mutable darray[IncrementalFunctionFactRecord] @output = []
                current_anchors: mutable darray[IncrementalFunctionSourceAnchor] @output = []
                direct_facts: mutable darray[IncrementalDirectFact] @output = []
                active_grants: mutable darray[IncrementalActiveGrant] @output = []
                self_assignment_ranges: mutable darray[IncrementalSelfAssignmentFactRange] @output = []
                self_assignment_facts: mutable darray[IncrementalSelfAssignmentFact] @output = []
                current_self_assignment_anchors: mutable darray[IncrementalSelfAssignmentAnchor] @output = []
                ordered: mutable IncrementalSemanticSnapshot[output] = IncrementalSemanticSnapshot{schema_version: snapshot.schema_version, semantic_fingerprint: snapshot.semantic_fingerprint, options_fingerprint: snapshot.options_fingerprint, options_key: options_key, bytes: bytes, source_path_start: snapshot.source_path_start, source_path_length: snapshot.source_path_length, declaration_surface_start: snapshot.declaration_surface_start, declaration_surface_length: snapshot.declaration_surface_length, declaration_surface_hash: snapshot.declaration_surface_hash, functions: functions, current_anchors: current_anchors, direct_facts: direct_facts, active_grants: active_grants, self_assignment_ranges: self_assignment_ranges, self_assignment_facts: self_assignment_facts, current_self_assignment_anchors: current_self_assignment_anchors, bodies_visited: snapshot.bodies_visited, bodies_matched: snapshot.bodies_matched, bodies_rejected: snapshot.bodies_rejected, self_assignment_bodies_scanned: snapshot.self_assignment_bodies_scanned, self_assignment_bodies_reused: snapshot.self_assignment_bodies_reused, declaration_surface_valid: snapshot.declaration_surface_valid, surface_compatible: snapshot.surface_compatible}
                ordered.options_key.reserve(snapshot.options_key.count)
                ordered.options_key.extend(snapshot.options_key)
                ordered.bytes.reserve(snapshot.bytes.count)
                ordered.functions.reserve(snapshot.functions.count)
                ordered.current_anchors.reserve(snapshot.current_anchors.count)
                ordered.current_anchors.extend(snapshot.current_anchors)
                ordered.direct_facts.reserve(snapshot.direct_facts.count)
                ordered.active_grants.reserve(snapshot.active_grants.count)
                ordered.self_assignment_ranges.reserve(snapshot.functions.count)
                ordered.self_assignment_facts.reserve(snapshot.self_assignment_facts.count)
                ordered.current_self_assignment_anchors.reserve(snapshot.current_self_assignment_anchors.count)
                ordered.source_path_start <- ordered.bytes.count
                if ifc_byte_span(snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length) is source_path:
                    ordered.bytes.extend(source_path)
                for record in snapshot.functions |ordered|:
                    key_start: usize = ordered.bytes.count
                    if ifc_byte_span(snapshot.bytes, record.key_start, record.key_length) is key:
                        ordered.bytes.extend(key)
                    body_start: usize = ordered.bytes.count
                    if ifc_byte_span(snapshot.bytes, record.body_start, record.body_length) is body:
                        ordered.bytes.extend(body)
                    ordered.functions.push(IncrementalFunctionFactRecord{key_start: key_start, key_length: record.key_length, body_start: body_start, body_length: record.body_length, body_hash: record.body_hash, direct_fact_start: 0, direct_fact_count: 0, cacheable: record.cacheable, complete_empty_body: record.complete_empty_body, matched_previous: record.matched_previous, reject_reason: record.reject_reason})
                for owner in 0..<snapshot.functions.count |ordered|:
                    record: IncrementalFunctionFactRecord = snapshot.functions[owner]
                    fact_start: usize = ordered.direct_facts.count
                    for index in 0..<record.direct_fact_count |ordered|:
                        fact: IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + index]
                        subject_start: usize = ordered.bytes.count
                        if ifc_byte_span(snapshot.bytes, fact.subject_start, fact.subject_length) is subject:
                            ordered.bytes.extend(subject)
                        grant_start: usize = ordered.active_grants.count
                        for grant_index in 0..<fact.active_grant_count |ordered|:
                            grant: IncrementalActiveGrant = snapshot.active_grants[fact.active_grant_start + grant_index]
                            name_start: usize = ordered.bytes.count
                            if ifc_byte_span(snapshot.bytes, grant.name_start, grant.name_length) is name:
                                ordered.bytes.extend(name)
                            ordered.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name_length})
                        ordered.direct_facts.push(IncrementalDirectFact{owner: owner, kind: fact.kind, subject_start: subject_start, subject_length: fact.subject_length, anchor_token: fact.anchor_token, active_grant_start: grant_start, active_grant_count: fact.active_grant_count})
                    ordered.functions[owner].direct_fact_start <- fact_start
                    ordered.functions[owner].direct_fact_count <- record.direct_fact_count
                    self_start: usize = ordered.self_assignment_facts.count
                    self_complete: mutable bool = owner < snapshot.self_assignment_ranges.count
                    self_reused: mutable bool = false
                    if self_complete:
                        source_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[owner]
                        self_complete <- source_range.complete
                        self_reused <- source_range.reused_previous
                        self_complete <- false if source_range.start > snapshot.self_assignment_facts.count or source_range.count > snapshot.self_assignment_facts.count - source_range.start
                        if self_complete:
                            self_complete <- false if source_range.start > snapshot.current_self_assignment_anchors.count or source_range.count > snapshot.current_self_assignment_anchors.count - source_range.start
                        if self_complete:
                            for relative in 0..<source_range.count |self_complete|:
                                source_fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[source_range.start + relative]
                                self_complete <- false if not ifc_self_assignment_name_span(&snapshot, record, source_fact).valid
                        if self_complete:
                            for relative in 0..<source_range.count |ordered|:
                                source_fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[source_range.start + relative]
                                ordered.self_assignment_facts.push(IncrementalSelfAssignmentFact{target_anchor_token: source_fact.target_anchor_token, statement_anchor_token: source_fact.statement_anchor_token, name_body_offset: source_fact.name_body_offset, name_length: source_fact.name_length})
                                ordered.current_self_assignment_anchors.push(snapshot.current_self_assignment_anchors[source_range.start + relative])
                    self_count: usize = ordered.self_assignment_facts.count - self_start
                    ordered.self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: self_start, count: self_count, complete: self_complete, reused_previous: self_reused and self_complete})
                ordered.declaration_surface_start <- ordered.bytes.count
                if ifc_byte_span(snapshot.bytes, snapshot.declaration_surface_start, snapshot.declaration_surface_length) is declaration_surface:
                    ordered.bytes.extend(declaration_surface)
                ordered.declaration_surface_valid <- snapshot.declaration_surface_valid
                # Query-hit evidence is captured before layout rebasing. Rebase its body
                # spans to the copied records so publication validates the canonical bytes.
                for marker_index in 0..<validated_body_query_hits.count:
                    marker: IncrementalSemanticBodyQueryHitMarker = validated_body_query_hits[marker_index]
                    continue if marker.function_record_index >= ordered.functions.count
                    record: IncrementalFunctionFactRecord = ordered.functions[marker.function_record_index]
                    validated_body_query_hits[marker_index] <- IncrementalSemanticBodyQueryHitMarker{function_record_index: marker.function_record_index, query_id: marker.query_id, query_result_generation: marker.query_result_generation, source_result_generation: marker.source_result_generation, requires_source_input: marker.requires_source_input, graph_generation: marker.graph_generation, body_start: record.body_start, body_length: record.body_length, direct_facts_restored: marker.direct_facts_restored}
                return ordered

        def ifc_surface_equal[@previous_region, @current_region](previous: IncrementalSemanticSnapshot[previous_region]&, current: IncrementalSemanticSnapshot[current_region]) -> bool:
            can Abort.Panic:
                return false if:
                    previous.schema_version != current.schema_version
                    previous.semantic_fingerprint != current.semantic_fingerprint
                    previous.options_fingerprint != current.options_fingerprint
                # The 64-bit fingerprint can collide; reuse requires exact key equality.
                return false if:
                    not incremental_semantic_options_key_equal(previous.options_key, current.options_key)
                    not ifc_equal(previous.bytes, previous.source_path_start, previous.source_path_length, current.bytes, current.source_path_start, current.source_path_length)
                return ifc_equal(previous.bytes, previous.declaration_surface_start, previous.declaration_surface_length, current.bytes, current.declaration_surface_start, current.declaration_surface_length)

        def ifc_equal_view(bytes: darray[u8]&, start: usize, length: usize, value: sview) -> bool:
            can Abort.Panic:
                return false if length != value.len or start > bytes.count or length > bytes.count - start
                for offset in 0..<length:
                    return false if bytes[start + offset] != value[offset]
                return true

        def ifc_surface_matches_bytes[@previous_region](previous: IncrementalSemanticSnapshot[previous_region]&, schema_version: u32, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, source_path: sview, declaration_surface: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if:
                    previous.schema_version != schema_version
                    previous.semantic_fingerprint != semantic_fingerprint
                    previous.options_fingerprint != options_fingerprint
                    not incremental_semantic_options_key_equal(previous.options_key, options_key)
                    not ifc_equal_view(previous.bytes, previous.source_path_start, previous.source_path_length, source_path)
                    previous.declaration_surface_length != declaration_surface.count
                    previous.declaration_surface_start > previous.bytes.count
                    previous.declaration_surface_length > previous.bytes.count - previous.declaration_surface_start
                for offset in 0..<declaration_surface.count:
                    return false if previous.bytes[previous.declaration_surface_start + offset] != declaration_surface[offset]
                return true

        def ifc_append_declaration_surface[@snapshot_region](surface: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, candidates: darray[IncrementalFactCandidate]&, snapshot: IncrementalSemanticSnapshot[snapshot_region]&, use_previous_cacheability: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                token_index: mutable usize = 0
                candidate_index: mutable usize = 0
                while token_index < tokens.count |token_index, candidate_index, tokens, candidates, snapshot, surface|:
                    while candidate_index < candidates.count and candidates[candidate_index].skip_start < token_index:
                        candidate_index <- candidate_index + 1
                    if candidate_index < candidates.count:
                        candidate: IncrementalFactCandidate = candidates[candidate_index]
                        if candidate.skip_start == token_index:
                            skip_body: bool = candidate.header_supported and candidate.prior_record_cacheable if use_previous_cacheability else candidate.header_supported and snapshot.functions[candidate.owner].cacheable
                            if skip_body and candidate.skip_start <= candidate.skip_end and candidate.skip_end <= tokens.count:
                                token_index <- candidate.skip_end
                                candidate_index <- candidate_index + 1
                                continue
                    return false if not ifc_append_token_bytes(surface, source, source_length, tokens[token_index])
                    token_index <- token_index + 1
                return true

        def ifc_reuse_previous_candidate_facts[@previous_region, @snapshot_region, @candidate_borrow, @previous_borrow](index: usize, candidates: darray[IncrementalFactCandidate]& @candidate_borrow, previous: IncrementalSemanticSnapshot[previous_region]& @previous_borrow, snapshot: mutable IncrementalSemanticSnapshot[snapshot_region]& @snapshot_region) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if index >= candidates.count
                candidate: IncrementalFactCandidate = candidates[index]
                return false if candidate.prior_record >= previous.functions.count or not candidate.prior_record_cacheable
                old: IncrementalFunctionFactRecord = previous.functions[candidate.prior_record]
                current: IncrementalFunctionFactRecord = snapshot.functions[candidate.owner]
                return false if not old.cacheable or old.key_start > previous.bytes.count or old.key_length > previous.bytes.count - old.key_start
                return false if current.key_start > snapshot.bytes.count or current.key_length > snapshot.bytes.count - current.key_start
                return false if not ifc_equal(snapshot.bytes, current.key_start, current.key_length, previous.bytes, old.key_start, old.key_length)
                # Candidate matching already did this exact body comparison before
                # declaration-surface admission. Reuse that result instead of walking
                # every unchanged body a second time here.
                return false if not candidate.prior_body_matches
                return false if old.direct_fact_start > previous.direct_facts.count or old.direct_fact_count > previous.direct_facts.count - old.direct_fact_start
                # Validate every nested byte span before copying anything. A malformed
                # in-process image therefore falls back to the current AST walker.
                for relative in 0..<old.direct_fact_count |previous|:
                    fact: IncrementalDirectFact = previous.direct_facts[old.direct_fact_start + relative]
                    return false if fact.owner != candidate.prior_record
                    return false if fact.subject_start > previous.bytes.count or fact.subject_length > previous.bytes.count - fact.subject_start
                    return false if fact.active_grant_start > previous.active_grants.count or fact.active_grant_count > previous.active_grants.count - fact.active_grant_start
                    for grant_relative in 0..<fact.active_grant_count |previous|:
                        grant: IncrementalActiveGrant = previous.active_grants[fact.active_grant_start + grant_relative]
                        return false if grant.name_start > previous.bytes.count or grant.name_length > previous.bytes.count - grant.name_start

                fact_start: usize = snapshot.direct_facts.count
                for relative in 0..<old.direct_fact_count |previous, snapshot|:
                    fact: IncrementalDirectFact = previous.direct_facts[old.direct_fact_start + relative]
                    subject_start: usize = snapshot.bytes.count
                    if fact.subject_length > 0 and ifc_byte_span(previous.bytes, fact.subject_start, fact.subject_length) is subject:
                        snapshot.bytes.extend(subject)
                    grant_start: usize = snapshot.active_grants.count
                    for grant_relative in 0..<fact.active_grant_count |previous, snapshot|:
                        grant: IncrementalActiveGrant = previous.active_grants[fact.active_grant_start + grant_relative]
                        name_start: usize = snapshot.bytes.count
                        if grant.name_length > 0 and ifc_byte_span(previous.bytes, grant.name_start, grant.name_length) is name:
                            snapshot.bytes.extend(name)
                        snapshot.active_grants.push(IncrementalActiveGrant{kind: grant.kind, name_start: name_start, name_length: grant.name_length})
                    snapshot.direct_facts.push(IncrementalDirectFact{owner: candidate.owner, kind: fact.kind, subject_start: subject_start, subject_length: fact.subject_length, anchor_token: fact.anchor_token, active_grant_start: grant_start, active_grant_count: fact.active_grant_count})
                snapshot.functions[candidate.owner].direct_fact_start <- fact_start
                snapshot.functions[candidate.owner].direct_fact_count <- snapshot.direct_facts.count - fact_start
                snapshot.functions[candidate.owner].cacheable <- true
                snapshot.functions[candidate.owner].matched_previous <- true
                snapshot.functions[candidate.owner].reject_reason <- IncrementalRejectReason.None
                snapshot.bodies_matched <- snapshot.bodies_matched + 1
                return true

    public:
        # Replay only fully rebound syntax facts. Unsupported or malformed entries fall
        # back to the checker's streaming walk for that body, preserving cold behavior.
        def check_self_assignment_with_snapshot[@snapshot_region, @table](declarations: darray[Ast::Decl], table: mutable SymbolTable& @table, snapshot: IncrementalSemanticSnapshot[snapshot_region]&) -> void:
            can Memory.Allocate, Abort.Panic:
                function_index: mutable usize = 0
                # Reuse one table-region scratch buffer for all replayed names. Each result
                # is copied into SymbolTable.joined_text before this buffer is cleared.
                name_bytes: mutable darray[u8] @table = []
                for declaration in declarations |table, function_index, name_bytes|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            replay: mutable bool = function_index < snapshot.functions.count and function_index < snapshot.self_assignment_ranges.count and function_index < snapshot.current_anchors.count
                            if replay:
                                fact_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[function_index]
                                body_anchor: IncrementalFunctionSourceAnchor = snapshot.current_anchors[function_index]
                                # A complete fresh scan is already current-source data;
                                # reused_previous is not a semantic replay requirement.
                                replay <- fact_range.complete
                                replay <- false if fact_range.start > snapshot.self_assignment_facts.count or fact_range.count > snapshot.self_assignment_facts.count - fact_range.start
                                replay <- false if fact_range.start > snapshot.current_self_assignment_anchors.count or fact_range.count > snapshot.current_self_assignment_anchors.count - fact_range.start
                                replay <- false if body_anchor.body_token_start > body_anchor.body_token_end
                                if replay:
                                    for relative in 0..<fact_range.count |replay|:
                                        index: usize = fact_range.start + relative
                                        fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[index]
                                        anchor: IncrementalSelfAssignmentAnchor = snapshot.current_self_assignment_anchors[index]
                                        name_span: (valid: bool, start: usize, length: usize) = ifc_self_assignment_name_span(snapshot, snapshot.functions[function_index], fact)
                                        replay <- false if:
                                            fact.target_anchor_token == INCREMENTAL_NO_ANCHOR or fact.statement_anchor_token == INCREMENTAL_NO_ANCHOR
                                            fact.target_anchor_token.usize() >= body_anchor.body_token_end - body_anchor.body_token_start
                                            fact.statement_anchor_token.usize() >= body_anchor.body_token_end - body_anchor.body_token_start
                                            not name_span.valid or anchor.target_position.line == 0 or anchor.statement_line == 0
                            if replay:
                                fact_range: IncrementalSelfAssignmentFactRange = snapshot.self_assignment_ranges[function_index]
                                if fact_range.count > 0:
                                    for relative in 0..<fact_range.count |table, name_bytes|:
                                        fact: IncrementalSelfAssignmentFact = snapshot.self_assignment_facts[fact_range.start + relative]
                                        anchor: IncrementalSelfAssignmentAnchor = snapshot.current_self_assignment_anchors[fact_range.start + relative]
                                        name_span: (valid: bool, start: usize, length: usize) = ifc_self_assignment_name_span(snapshot, snapshot.functions[function_index], fact)
                                        name_bytes.truncate(0)
                                        if ifc_byte_span(snapshot.bytes, name_span.start, name_span.length) is name_view:
                                            name_bytes.extend(name_view)
                                        diagnostic_name: sview @source = intern_joined_text(name_bytes, table)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SelfAssignment, name: diagnostic_name, pos: anchor.target_position, line: anchor.statement_line, expected: "", actual: ""})
                            else:
                                table <- check_self_assignment_statements(body, table)
                            function_index <- function_index + 1
                        Decl.Module(name, body, line):
                            table <- check_self_assignment(body, table)
                        Decl.Scoped(body, line):
                            table <- check_self_assignment(body, table)
                        _:
                            pass

        # Resolve a portable direct-call fact back to its current source-level name.
        # The serialized subject is a length-prefixed (path, name) key; callers must
        # still resolve that name against the current declaration/index inventory.
        def incremental_direct_call_name[@snapshot_region](snapshot: IncrementalSemanticSnapshot[snapshot_region]&, fact: IncrementalDirectFact) -> sview?:
            can Abort.Panic:
                return null if fact.kind != IncrementalFactKind.DirectCall
                return null if fact.subject_start > snapshot.bytes.count or fact.subject_length > snapshot.bytes.count - fact.subject_start
                return null if snapshot.source_path_start > snapshot.bytes.count or snapshot.source_path_length > snapshot.bytes.count - snapshot.source_path_start
                return null if fact.subject_length < 8
                path_length: usize = ifc_read_u32(snapshot.bytes, fact.subject_start).usize()
                return null if path_length > fact.subject_length - 8
                path_start: usize = fact.subject_start + 4
                return null if path_length != snapshot.source_path_length
                return null if not ifc_equal(snapshot.bytes, path_start, path_length, snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length)
                name_length_start: usize = path_start + path_length
                name_length: usize = ifc_read_u32(snapshot.bytes, name_length_start).usize()
                name_start: usize = name_length_start + 4
                return null if name_length == 0 or name_length != fact.subject_length - (path_length + 8)
                if ifc_byte_span(snapshot.bytes, name_start, name_length) is name:
                    return name
                return null

        # Supported functions are unique, top-level, nongeneric defs with ordinary block
        # bodies and scalar builtin return types. Calls must be direct, zero-argument, and
        # unambiguous. Locals are untyped literals; local identifier reads stay cold because
        # they can hide mutable places or callback values. Nested blocks and parenthesized
        # expressions stay cold until their walker depth behavior is modeled. Disk snapshots
        # remain hints only; only a caller-owned in-process session can authorize collector
        # fact reuse after exact body checks and either a trusted declaration surface
        # or a prior successful zero-fact scan of that exact body.
        def ifc_collect_function_facts[@session, @input_source, @output, @previous_region, @path_region, @metrics_borrow, @hits_region](file: Ast::File& @input_source, source: u8& @input_source, source_length: usize, tokens: darray[Lexer::Token]& @input_source, source_path: sview @path_region, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, identity_key: darray[u8]&, previous: IncrementalSemanticSnapshot[previous_region]& @previous_region, has_previous: bool, allow_session_reuse: bool, request_metrics: mutable IncrementalFunctionFactsRequestMetrics& @metrics_borrow, validated_body_query_hits: mutable darray[IncrementalSemanticBodyQueryHitMarker]& @hits_region, session: mutable IncrementalSemanticSession[session]&? @session) -> IncrementalSemanticSnapshot[output] @output:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                request_metrics.function_body_facts_restored <- 0
                request_metrics.body_query_publish_skips <- 0
                request_metrics.prior_snapshot_fact_fallbacks <- 0
                request_metrics.cold_body_scans <- 0
                request_metrics.source_input_admitted <- false
                request_metrics.validated_body_query_generation <- 0
                request_metrics.complete_empty_body_eligible <- 0
                request_metrics.complete_empty_body_restored <- 0
                request_metrics.complete_empty_body_publish_skips <- 0
                request_metrics.complete_empty_body_commits <- 0
                request_metrics.zero_fact_body_eligible <- 0
                request_metrics.zero_fact_body_restored <- 0
                request_metrics.zero_fact_body_publish_skips <- 0
                request_metrics.zero_fact_body_commits <- 0
                validated_body_query_hits.truncate(0)
                snapshot_slots: mutable darray[IncrementalSemanticSnapshot[input_source]] @input_source = [IncrementalSemanticSnapshot{schema_version: INCREMENTAL_FUNCTION_FACTS_SCHEMA, semantic_fingerprint: semantic_fingerprint, options_fingerprint: options_fingerprint, options_key: [], bytes: [], source_path_start: 0, source_path_length: 0, declaration_surface_start: 0, declaration_surface_length: 0, declaration_surface_hash: INCREMENTAL_FACT_HASH_OFFSET, functions: [], current_anchors: [], direct_facts: [], active_grants: [], self_assignment_ranges: [], self_assignment_facts: [], current_self_assignment_anchors: [], bodies_visited: 0, bodies_matched: 0, bodies_rejected: 0, self_assignment_bodies_scanned: 0, self_assignment_bodies_reused: 0, declaration_surface_valid: false, surface_compatible: false}]
                owned_path_bytes: mutable darray[u8] @input_source = []
                owned_path_bytes.extend(source_path)
                owned_source_path: mutable sview @input_source = ""
                if ifc_byte_span(owned_path_bytes, 0, owned_path_bytes.count) is path_view:
                    owned_source_path <- path_view
                snapshot_slots[0].options_key.extend(options_key)
                snapshot_slots[0].source_path_start <- snapshot_slots[0].bytes.count
                snapshot_slots[0].source_path_length <- owned_source_path.len
                ifc_append_view[input_source, input_source](&snapshot_slots[0], owned_source_path)

                candidates: mutable darray[IncrementalFactCandidate] @input_source = []
                all_globals: mutable darray[sview @input_source] @input_source = []
                mutable_globals: mutable darray[sview @input_source] @input_source = []
                all_aliases: mutable darray[sview @input_source] @input_source = []
                for declaration in file.top_decls |all_aliases|:
                    match declaration:
                        Decl.Alias(name, _, _):
                            all_aliases.push(name)
                        _:
                            pass
                definition_cursor: mutable usize = 0
                previous_span_end: mutable usize = 0
                all_spans_ordered: mutable bool = true
                for declaration in file.top_decls |all_globals, mutable_globals, tokens, snapshot_slots, source, source_length|:
                    match declaration:
                        Decl.Const(name: name, is_mutable: is_global, _):
                            all_globals.push(name) if is_global
                        Decl.Func(name, parameters, return_type, body, _, _, position):
                            while definition_cursor < tokens.count and (tokens[definition_cursor].kind != TokenKind.Def or tokens[definition_cursor].start != position.offset):
                                definition_cursor <- definition_cursor + 1
                            span: IncrementalFactTokenSpan = ifc_token_span(tokens, definition_cursor)
                            if span.found:
                                definition_cursor <- span.skip_end
                            elif definition_cursor < tokens.count:
                                definition_cursor <- definition_cursor + 1
                            span_ordered: bool = not span.found or span.skip_start >= previous_span_end
                            if span.found:
                                all_spans_ordered <- false if not span_ordered
                                previous_span_end <- span.skip_end if span.skip_end > previous_span_end
                            generic_header: bool = span.found and ifc_generic_header(tokens, span.definition_token)
                            inline_grant: bool = span.found and ifc_has_inline_grant(file.enum_annotations, tokens, span.body_start, span.body_end)
                            signature_supported: bool = ifc_signature_supported(parameters, return_type, all_aliases)
                            key_span: (start: usize, length: usize) = ifc_append_name[input_source, input_source, input_source](&snapshot_slots[0], owned_source_path, name)
                            body_start: usize = snapshot_slots[0].bytes.count
                            body_valid: bool = span.found and ifc_append_tokens(&snapshot_slots[0], source, source_length, tokens, span.body_start, span.body_end)
                            body_length: usize = snapshot_slots[0].bytes.count - body_start if body_valid else 0
                            owner: usize = snapshot_slots[0].functions.count
                            snapshot_slots[0].functions.push(IncrementalFunctionFactRecord{key_start: key_span.start, key_length: key_span.length, body_start: body_start, body_length: body_length, body_hash: ifc_hash(snapshot_slots[0].bytes, body_start, body_length), direct_fact_start: 0, direct_fact_count: 0, cacheable: false, complete_empty_body: false, matched_previous: false, reject_reason: IncrementalRejectReason.MissingBlockBody if not span.found else IncrementalRejectReason.None})
                            snapshot_slots[0].self_assignment_ranges.push(IncrementalSelfAssignmentFactRange{start: snapshot_slots[0].self_assignment_facts.count, count: 0, complete: false, reused_previous: false})
                            snapshot_slots[0].current_anchors.push(IncrementalFunctionSourceAnchor{definition_offset: position.offset, body_token_start: span.body_start, body_token_end: span.body_end})
                            candidates.push(IncrementalFactCandidate{name: name, parameters: parameters, return_type: return_type, body: body, definition_offset: position.offset, definition_token: span.definition_token, generic_header: generic_header, span_ordered: span_ordered, body_token_start: span.body_start, body_token_end: span.body_end, skip_start: span.skip_start, skip_end: span.skip_end, owner: owner, header_supported: span.found and body_valid and owned_source_path != "" and not generic_header and not inline_grant and span_ordered and signature_supported, prior_record: 0, prior_record_cacheable: false, prior_body_matches: false, prior_zero_fact_body: false})
                            snapshot_slots[0].functions[owner].reject_reason <- IncrementalRejectReason.MissingStablePath if owned_source_path == ""
                            snapshot_slots[0].functions[owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan if span.found and not body_valid
                            snapshot_slots[0].functions[owner].reject_reason <- IncrementalRejectReason.UnsupportedBodySyntax if inline_grant
                            snapshot_slots[0].functions[owner].reject_reason <- IncrementalRejectReason.UnsupportedSignature if not signature_supported
                        _:
                            pass

                if not all_spans_ordered:
                    for candidate_index in 0..<candidates.count |snapshot_slots|:
                        candidates[candidate_index].header_supported <- false
                        snapshot_slots[0].functions[candidates[candidate_index].owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan

                # Decl.Const distinguishes globals from consts; mutability lives in the
                # parser's __global_mutable annotation side table.
                all_globals_index_slots: mutable darray[IncrementalStringNameIndex[input_source]] @input_source = [IncrementalStringNameIndex[input_source]{}]
                ifc_string_name_index(all_globals, &all_globals_index_slots[0]) if all_globals.count >= INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT
                for annotation in file.enum_annotations:
                    if annotation.name == "__global_mutable" and annotation.module == "" and ifc_string_name_contains(all_globals, annotation.owner, &all_globals_index_slots[0]):
                        mutable_globals.push(annotation.owner)
                mutable_globals_index_slots: mutable darray[IncrementalStringNameIndex[input_source]] @input_source = [IncrementalStringNameIndex[input_source]{}]
                ifc_string_name_index(mutable_globals, &mutable_globals_index_slots[0]) if mutable_globals.count >= INCREMENTAL_STRING_NAME_INDEX_MIN_COUNT

                candidate_name_slots: mutable darray[IncrementalCandidateNameIndex[input_source]] @input_source = [IncrementalCandidateNameIndex[input_source]{}]
                ifc_candidate_name_index(candidates, &candidate_name_slots[0])
                prior_key_slots: mutable darray[IncrementalPriorKeyIndex[input_source]] @input_source = [IncrementalPriorKeyIndex[input_source]{}]
                if has_previous and previous.schema_version == INCREMENTAL_FUNCTION_FACTS_SCHEMA:
                    ifc_prior_key_index(previous, &prior_key_slots[0])
                locals_scratch: mutable darray[sview @input_source] @input_source = []
                requires_ordinary_surface: mutable bool = false
                for index in 0..<candidates.count |snapshot_slots, previous, requires_ordinary_surface|:
                    unique: bool = ifc_name_unique(candidates, candidates[index].name, &candidate_name_slots[0])
                    generic: bool = candidates[index].generic_header
                    candidates[index].header_supported <- candidates[index].header_supported and unique
                    if not unique or generic:
                        snapshot_slots[0].functions[candidates[index].owner].reject_reason <- IncrementalRejectReason.NonUniqueOrGenericFunction
                    elif not candidates[index].span_ordered:
                        snapshot_slots[0].functions[candidates[index].owner].reject_reason <- IncrementalRejectReason.InvalidTokenSpan
                    if candidates[index].header_supported and has_previous and previous.schema_version == INCREMENTAL_FUNCTION_FACTS_SCHEMA:
                        current: IncrementalFunctionFactRecord = snapshot_slots[0].functions[candidates[index].owner]
                        old_index: usize = ifc_prior_index(previous, snapshot_slots[0].bytes, current.key_start, current.key_length, &prior_key_slots[0])
                        if old_index < previous.functions.count:
                            old: IncrementalFunctionFactRecord = previous.functions[old_index]
                            # Length and hash reject unequal bodies cheaply; exact bytes remain authoritative on a match.
                            same_body: bool = current.body_length == old.body_length and current.body_hash == old.body_hash and ifc_equal(snapshot_slots[0].bytes, current.body_start, current.body_length, previous.bytes, old.body_start, old.body_length)
                            candidates[index].prior_record <- old_index
                            candidates[index].prior_record_cacheable <- old.cacheable
                            candidates[index].prior_body_matches <- same_body
                            candidates[index].prior_zero_fact_body <- same_body and ifc_record_is_zero_fact_surface_independent(previous, old_index)
                            requires_ordinary_surface <- true if old.cacheable and same_body and not ifc_candidate_is_complete_empty_body(candidates[index], tokens) and not candidates[index].prior_zero_fact_body

                trusted_surface_admitted: mutable bool = false
                proposed_surface: mutable darray[u8] @input_source = []
                proposed_surface_valid: mutable bool = false
                # The gate above needs an exact, cacheable prior body with declaration
                # reads (a nonempty fact set). Zero-fact prior records have already
                # completed a successful scanner walk over this exact body and can be
                # reused without declaration-surface admission. Once admitted, preflight
                # deliberately uses each prior record's cacheability for every candidate,
                # including changed bodies; exact body bytes still govern reuse.
                if allow_session_reuse and has_previous and all_spans_ordered and requires_ordinary_surface:
                    proposed_surface_valid <- ifc_append_declaration_surface(proposed_surface, tokens, source, source_length, candidates, &snapshot_slots[0], true)
                    trusted_surface_admitted <- proposed_surface_valid and ifc_surface_matches_bytes(previous, snapshot_slots[0].schema_version, snapshot_slots[0].semantic_fingerprint, snapshot_slots[0].options_fingerprint, snapshot_slots[0].options_key, owned_source_path, proposed_surface)
                source_query_handle: mutable IncrementalSemanticQueryHandle = ifq_query_handle_invalid()
                graph_surface_admitted: mutable bool = false
                if allow_session_reuse and requires_ordinary_surface and session != null and session.enabled and session.query_graph_enabled and session.valid and not session.query_graph_poisoned and proposed_surface_valid and ifq_source_query_key_fits(identity_key, owned_source_path) and ifq_source_query_value_fits(options_key.count, proposed_surface.count):
                    session.query_probe_key_scratch.truncate(0)
                    ifq_source_query_key_into(session.query_probe_key_scratch, identity_key, owned_source_path)
                    source_query_handle <- incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.SourceInput, session.query_probe_key_scratch)
                    session.query_probe_key_scratch.truncate(0)
                    source_query_value: mutable darray[u8] @input_source = []
                    _ = ifq_source_query_value_from_span_into(source_query_value, options_key, proposed_surface, 0, proposed_surface.count)
                    session.query_dependencies_scratch.truncate(0)
                    source_evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate(session, source_query_handle, source_query_value, session.query_dependencies_scratch)
                    graph_surface_admitted <- source_evaluation.hit and ifq_query_value_equals(session, source_evaluation.result_start, source_evaluation.result_length, source_query_value)
                    request_metrics.source_input_admitted <- graph_surface_admitted and trusted_surface_admitted
                for index in 0..<candidates.count |snapshot_slots, request_metrics|:
                    complete_empty_body: bool = candidates[index].header_supported and ifc_candidate_is_complete_empty_body(candidates[index], tokens)
                    snapshot_slots[0].functions[candidates[index].owner].complete_empty_body <- complete_empty_body
                    if complete_empty_body:
                        ifc_increment_candidate_metric(&request_metrics.complete_empty_body_eligible, candidates.count)
                        snapshot_slots[0].functions[candidates[index].owner].direct_fact_start <- snapshot_slots[0].direct_facts.count
                        snapshot_slots[0].functions[candidates[index].owner].direct_fact_count <- 0
                        snapshot_slots[0].functions[candidates[index].owner].cacheable <- true
                        snapshot_slots[0].functions[candidates[index].owner].matched_previous <- false
                        snapshot_slots[0].functions[candidates[index].owner].reject_reason <- IncrementalRejectReason.None
                    current: IncrementalFunctionFactRecord = snapshot_slots[0].functions[candidates[index].owner]
                    source_independent_body: bool = complete_empty_body or candidates[index].prior_zero_fact_body
                    if allow_session_reuse and session != null and session.enabled and session.valid and candidates[index].header_supported and candidates[index].prior_record_cacheable and candidates[index].prior_body_matches and (source_independent_body or trusted_surface_admitted):
                        graph_reused: mutable bool = false
                        if session.query_graph_enabled and not session.query_graph_poisoned and (source_independent_body or graph_surface_admitted):
                            session.query_dependencies_scratch.truncate(0)
                            session.query_dependencies_scratch.push(source_query_handle) if not source_independent_body and graph_surface_admitted
                            if ifq_function_query_key_fits(current) and current.body_length <= INCREMENTAL_SEMANTIC_QUERY_VALUE_BYTES_LIMIT and ifq_function_query_key_into(session.query_probe_key_scratch, &snapshot_slots[0], current):
                                query_handle: IncrementalSemanticQueryHandle = incremental_semantic_query_for_key(session, IncrementalSemanticQueryKind.FunctionBodyFacts, session.query_probe_key_scratch)
                                session.query_probe_key_scratch.truncate(0)
                                evaluation: IncrementalSemanticQueryEvaluation = ifq_query_evaluate_span_with_hash(session, query_handle, snapshot_slots[0].bytes, current.body_start, current.body_length, current.body_hash, session.query_dependencies_scratch)
                                if evaluation.hit:
                                    graph_reused <- ifq_restore_direct_facts_from_result[session, session, previous_region, input_source](session, evaluation.result_start, evaluation.result_length, previous, candidates[index].prior_record, &snapshot_slots[0], candidates[index].owner)
                                    if not graph_reused:
                                        _ = ifq_query_mark_stale(session, query_handle.node)
                                    else:
                                        # Snapshot bytes remain request-local and unchanged
                                        # through session_store; retain only scalar identity
                                        # evidence, never the old request-scoped handles.
                                        if not session.query_graph_poisoned and ifq_query_handle_is_valid(session, query_handle) and (source_independent_body or ifq_query_handle_is_valid(session, source_query_handle)):
                                            if request_metrics.validated_body_query_generation != session.query_graph_generation:
                                                validated_body_query_hits.truncate(0)
                                                request_metrics.validated_body_query_generation <- session.query_graph_generation
                                            body_node: IncrementalSemanticQueryNode = session.query_nodes[query_handle.node.value.usize()]
                                            if body_node.status == IncrementalSemanticQueryStatus.Green and body_node.has_committed_value:
                                                source_result_generation: mutable u64 = 0
                                                source_is_green: mutable bool = source_independent_body
                                                if not source_independent_body:
                                                    source_node: IncrementalSemanticQueryNode = session.query_nodes[source_query_handle.node.value.usize()]
                                                    source_result_generation <- source_node.result_generation
                                                    source_is_green <- source_node.status == IncrementalSemanticQueryStatus.Green and source_node.has_committed_value
                                                if source_is_green:
                                                    validated_body_query_hits.push(IncrementalSemanticBodyQueryHitMarker{function_record_index: candidates[index].owner, query_id: query_handle.node, query_result_generation: body_node.result_generation, source_result_generation: source_result_generation, requires_source_input: not source_independent_body, graph_generation: session.query_graph_generation, body_start: current.body_start, body_length: current.body_length, direct_facts_restored: true})
                        if graph_reused:
                            if complete_empty_body:
                                ifc_increment_candidate_metric(&request_metrics.complete_empty_body_restored, candidates.count)
                            elif candidates[index].prior_zero_fact_body:
                                ifc_increment_candidate_metric(&request_metrics.zero_fact_body_restored, candidates.count)
                            else:
                                ifc_increment_candidate_metric(&request_metrics.function_body_facts_restored, candidates.count)
                        elif complete_empty_body:
                            # The exact closed AST shape itself proves an empty direct-fact
                            # result. When the broad surface is still trusted, preserve the
                            # established graph-off comparison by accounting for the typed
                            # snapshot fallback; across a changed surface, rely on this
                            # complete local proof instead.
                            reused_previous: mutable bool = false
                            if trusted_surface_admitted:
                                reused_previous <- ifc_reuse_previous_candidate_facts[previous_region, input_source, input_source, previous_region](index, candidates, previous, &snapshot_slots[0])
                            if reused_previous:
                                ifc_increment_candidate_metric(&request_metrics.prior_snapshot_fact_fallbacks, candidates.count)
                        else:
                            reused_previous: mutable bool = false
                            reused_previous <- ifc_reuse_previous_candidate_facts[previous_region, input_source, input_source, previous_region](index, candidates, previous, &snapshot_slots[0])
                            if reused_previous:
                                ifc_increment_candidate_metric(&request_metrics.prior_snapshot_fact_fallbacks, candidates.count)
                                if candidates[index].prior_zero_fact_body:
                                    ifc_increment_candidate_metric(&request_metrics.zero_fact_body_restored, candidates.count)
                            else:
                                ifc_increment_candidate_metric(&request_metrics.cold_body_scans, candidates.count)
                                ifc_scan_candidate[input_source, input_source, input_source, input_source](index, candidates, &candidate_name_slots[0], owned_source_path, tokens, all_globals, &all_globals_index_slots[0], mutable_globals, &mutable_globals_index_slots[0], locals_scratch, &snapshot_slots[0])
                    elif complete_empty_body:
                        pass
                    else:
                        ifc_increment_candidate_metric(&request_metrics.cold_body_scans, candidates.count)
                        ifc_scan_candidate[input_source, input_source, input_source, input_source](index, candidates, &candidate_name_slots[0], owned_source_path, tokens, all_globals, &all_globals_index_slots[0], mutable_globals, &mutable_globals_index_slots[0], locals_scratch, &snapshot_slots[0])
                    if ifc_record_is_zero_fact_surface_independent(&snapshot_slots[0], candidates[index].owner):
                        ifc_increment_candidate_metric(&request_metrics.zero_fact_body_eligible, candidates.count)

                snapshot_slots[0].declaration_surface_start <- snapshot_slots[0].bytes.count
                surface_valid: mutable bool = true
                declaration_surface: mutable darray[u8] @input_source = []
                surface_valid <- ifc_append_declaration_surface(declaration_surface, tokens, source, source_length, candidates, &snapshot_slots[0], false)
                snapshot_slots[0].declaration_surface_length <- declaration_surface.count
                snapshot_slots[0].declaration_surface_hash <- ifc_hash(declaration_surface, 0, declaration_surface.count)
                snapshot_slots[0].declaration_surface_valid <- surface_valid
                snapshot_slots[0].surface_compatible <- has_previous and surface_valid and all_spans_ordered and ifc_surface_matches_bytes(previous, snapshot_slots[0].schema_version, snapshot_slots[0].semantic_fingerprint, snapshot_slots[0].options_fingerprint, snapshot_slots[0].options_key, owned_source_path, declaration_surface)
                if not surface_valid:
                    snapshot_slots[0].bytes.extend(declaration_surface)
                    snapshot_slots[0].direct_facts.truncate(0)
                    snapshot_slots[0].active_grants.truncate(0)
                    snapshot_slots[0].bodies_matched <- 0
                    for record_index in 0..<snapshot_slots[0].functions.count |snapshot_slots, record_index|:
                        snapshot_slots[0].functions[record_index].cacheable <- false
                        snapshot_slots[0].functions[record_index].matched_previous <- false
                        snapshot_slots[0].functions[record_index].direct_fact_start <- 0
                        snapshot_slots[0].functions[record_index].direct_fact_count <- 0
                        snapshot_slots[0].functions[record_index].reject_reason <- IncrementalRejectReason.InvalidTokenSpan
                    return ifc_canonical_layout[input_source, output, hits_region](snapshot_slots[0], validated_body_query_hits)

                # This syntax-only query needs no declaration lookup. Collect it after the
                # portable snapshot size is known so the process-local facts share the same
                # bounded storage budget. Disk snapshots omit these facts and stay cold.
                if allow_session_reuse:
                    for index in 0..<candidates.count |snapshot_slots, previous|:
                        reused_self_assignment: mutable bool = false
                        reused_self_assignment <- has_previous and ifc_reuse_previous_self_assignment_candidate[previous_region, input_source, input_source, previous_region](index, candidates, previous, tokens, &snapshot_slots[0])
                        if not reused_self_assignment:
                            ifc_scan_self_assignment_candidate[input_source, input_source](index, candidates, tokens, &snapshot_slots[0])

                if snapshot_slots[0].surface_compatible:
                    for index in 0..<candidates.count |snapshot_slots|:
                        continue if not candidates[index].prior_body_matches
                        current: IncrementalFunctionFactRecord = snapshot_slots[0].functions[candidates[index].owner]
                        # For sidecars this records an exact-body match after a full scan.
                        # Trusted session copies set the bit and count at the copy site.
                        if current.cacheable and not current.matched_previous:
                            snapshot_slots[0].functions[candidates[index].owner].matched_previous <- true
                            snapshot_slots[0].bodies_matched <- snapshot_slots[0].bodies_matched + 1

                snapshot_slots[0].bytes.extend(declaration_surface)
                return ifc_canonical_layout[input_source, output, hits_region](snapshot_slots[0], validated_body_query_hits)

        def incremental_collect_function_facts[@input_source, @output, @previous_region](file: Ast::File& @input_source, source: u8& @input_source, source_length: usize, tokens: darray[Lexer::Token]& @input_source, source_path: sview @output, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&, previous: IncrementalSemanticSnapshot[previous_region]& @previous_region, has_previous: bool) -> IncrementalSemanticSnapshot[output] @output:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast:
                request_metrics_hits: mutable darray[IncrementalSemanticBodyQueryHitMarker] @input_source = []
                request_metrics_slots: mutable darray[IncrementalFunctionFactsRequestMetrics] @output = [IncrementalFunctionFactsRequestMetrics{function_body_facts_restored: 0, body_query_publish_skips: 0, prior_snapshot_fact_fallbacks: 0, cold_body_scans: 0, source_input_admitted: false, validated_body_query_generation: 0, complete_empty_body_eligible: 0, complete_empty_body_restored: 0, complete_empty_body_publish_skips: 0, complete_empty_body_commits: 0, zero_fact_body_eligible: 0, zero_fact_body_restored: 0, zero_fact_body_publish_skips: 0, zero_fact_body_commits: 0}]
                empty_identity: darray[u8] @output = []
                return ifc_collect_function_facts[output, input_source, output, previous_region, output, output, input_source](file, source, source_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, empty_identity, previous, has_previous, false, &request_metrics_slots[0], request_metrics_hits, null)

        # Exact session identity, path and source-byte equality prove that the parser and
        # lexer see the same input as the prior request. Project each declaration into
        # scalar identity data before building the request-owned reanchor plan, so the
        # plan never retains a source-backed AST value.
    private:
        def ifc_exact_reanchor_declaration_projection[@snapshot_region](declaration: Ast::Decl, snapshot: IncrementalSemanticSnapshot[snapshot_region]&, record_index: usize) -> (valid: bool, is_function: bool, definition_offset: u32):
            can Abort.Panic:
                match declaration:
                    Decl.Func(name: name, pos: position, _):
                        return (false, true, 0) if record_index >= snapshot.functions.count
                        record: IncrementalFunctionFactRecord = snapshot.functions[record_index]
                        return (false, true, 0) if record.key_start > snapshot.bytes.count or record.key_length > snapshot.bytes.count - record.key_start or record.key_length < 8
                        path_length: usize = ifc_read_u32(snapshot.bytes, record.key_start).usize()
                        return (false, true, 0) if path_length > record.key_length - 8 or path_length != snapshot.source_path_length
                        path_start: usize = record.key_start + 4
                        return (false, true, 0) if not ifc_equal(snapshot.bytes, path_start, path_length, snapshot.bytes, snapshot.source_path_start, snapshot.source_path_length)
                        name_length_start: usize = path_start + path_length
                        name_length: usize = ifc_read_u32(snapshot.bytes, name_length_start).usize()
                        name_start: usize = name_length_start + 4
                        return (false, true, 0) if name_length != record.key_length - path_length - 8 or name_length != name.len
                        name_offset: mutable usize = 0
                        while name_offset < name_length:
                            return (false, true, 0) if snapshot.bytes[name_start + name_offset] != name[name_offset]
                            name_offset <- name_offset + 1
                        return (true, true, position.offset)
                    _:
                        return (true, false, 0)
