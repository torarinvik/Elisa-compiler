# Named-argument validation (stage0 named-call checks). Two structural errors:
#   * a POSITIONAL argument after a NAMED one — `consume(x: 1, 7)` — always illegal;
#   * a named argument whose name is not a parameter of the callee — `consume(z: 7, ...)`.
#
# The positional-after-named rule needs no callee resolution (it is a pure argument-order
# property). The unknown-parameter rule fires only when the callee's full parameter list is
# known (a top-level function via the symbol table, or an extern via file.extern_params);
# an unresolved callee (method, import, generic, callback) is skipped so no false unknowns.
extend Semantic:
    private:
        def nca_param_names_of(callee: sview, table: SymbolTable&, extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, out: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                # A unique zero-parameter function is resolved even though its
                # parameter chain has no rows.
                resolved: mutable bool = direct_function_count(table, callee) == 1
                probe: mutable u32 = function_param_chain_head(table, callee)
                while probe != SYMBOL_INDEX_ROW_NONE |probe, out, resolved|:
                    if table.function_param_owner[probe.usize()] == callee:
                        out.push(table.function_param_name[probe.usize()])
                        resolved <- true
                    probe <- table.function_param_name_next[probe.usize()]
                extern_probe: mutable usize = 0
                while extern_probe < extern_names.count |extern_probe, out, resolved|:
                    if extern_names[extern_probe] == callee:
                        start: usize = extern_starts[extern_probe].usize()
                        arity: usize = extern_arities[extern_probe].usize()
                        slot: mutable usize = 0
                        while slot < arity and (start + slot) < extern_params.count |slot, out|:
                            out.push(extern_params[start + slot].name)
                            slot <- slot + 1
                        resolved <- true
                    extern_probe <- extern_probe + 1
                return resolved

        def nca_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for entry in names:
                    return true if entry == wanted
                return false

        def nca_check_call(file: Ast::File&, callee: sview @source, argument_names: darray[sview @source]&, call_pos: Ast::Pos, extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                has_named: bool = any entry in argument_names where entry != ""
                return if not has_named
                is_forwarded: bool = forwarding_marker_matches(table.forward_arg_lines, table.forward_arg_offsets, call_pos)
                if not is_forwarded and nca_selected_variadic(file, callee, table):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedArgError, name: callee, pos: call_pos, line: call_pos.line, expected: "variadic", actual: ""})
                    return
                # The resolver checks ordinary unique direct calls, including labels and
                # ordering. Keep this fallback for externs, forwarding, and zero-parameter
                # declarations that the resolver's binder does not handle.
                resolver_checks_shape: bool = direct_function_count(table, callee) == 1 and function_parameter_count(table, callee) > 0 and not forwarding_marker_matches(table.forward_arg_lines, table.forward_arg_offsets, call_pos)
                return if resolver_checks_shape
                line: u32 = call_pos.line
                # Positional-after-named: once a named arg appears, any later "" is illegal.
                seen_named: mutable bool = false
                flagged_positional: mutable bool = false
                order_index: mutable usize = 0
                while order_index < argument_names.count |order_index, seen_named, flagged_positional, table| -> table:
                    entry: sview = argument_names[order_index]
                    if entry != "":
                        seen_named <- true
                    elif seen_named and not flagged_positional:
                        flagged_positional <- true
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedArgError, name: callee, line: line, expected: "positional", actual: ""})
                    order_index <- order_index + 1
                # Unknown parameter: only when the callee's params are fully known.
                params: mutable darray[sview] = []
                resolved: bool = nca_param_names_of(callee, table, extern_names, extern_starts, extern_arities, extern_params, params)
                if resolved:
                    name_index: mutable usize = 0
                    while name_index < argument_names.count |name_index, table| -> table:
                        arg_name: sview = argument_names[name_index]
                        if arg_name != "" and not nca_name_in(params, arg_name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedArgError, name: callee, line: line, expected: "unknown", actual: arg_name})
                        name_index <- name_index + 1


        def nca_walk_expr(file: Ast::File&, caller_params: darray[Ast::ParamDecl], expression: Ast::Expr, line: u32, bound: mutable darray[sview]&, extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, position):
                        ambiguous: bool = not (any local_name in bound where local_name == name) and callable_wildcard_ambiguous(file, name, table.current_module, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AmbiguousReference, name: name, pos: position, line: position.line, expected: "", actual: ""}) if ambiguous
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        table <- nca_check_call(file, callee_name, argument_names, call_line, extern_names, extern_starts, extern_arities, extern_params, table) if callee_name != "" and not (any local_name in bound where local_name == callee_name)
                        if callee is Expr.Scope(_, _, _):
                            callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(callee, table)
                            table <- qualified_overload_argument_check(file, callable.qualifier, callable.name, arguments, argument_names, call_line, caller_params, bound, table) if callable.known
                        table <- nca_walk_expr(file, caller_params, callee, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        for argument in arguments |table| -> table:
                            table <- nca_walk_expr(file, caller_params, argument, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- nca_walk_expr(file, caller_params, left, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, right, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Paren(inner, paren_line):
                        table <- nca_walk_expr(file, caller_params, inner, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- nca_walk_expr(file, caller_params, operand, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Move(inner, move_line):
                        table <- nca_walk_expr(file, caller_params, inner, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Field(object, field, field_line):
                        table <- nca_walk_expr(file, caller_params, object, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Scope(object, field, field_line):
                        pass
                    Expr.Index(object, index, index_line):
                        table <- nca_walk_expr(file, caller_params, object, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, index, line, bound, extern_names, extern_starts, extern_arities, extern_params, table) if not index_receiver_is_type_application(object)
                    Expr.IndexN(object, arguments, index_line):
                        table <- nca_walk_expr(file, caller_params, object, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        for argument in arguments |table|:
                            table <- nca_walk_expr(file, caller_params, argument, line, bound, extern_names, extern_starts, extern_arities, extern_params, table) if not index_receiver_is_type_application(object)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table|:
                            table <- nca_walk_expr(file, caller_params, element, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table|:
                            table <- nca_walk_expr(file, caller_params, entry.key, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            table <- nca_walk_expr(file, caller_params, entry.value, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- nca_walk_expr(file, caller_params, object, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, low, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, high, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- nca_walk_expr(file, caller_params, condition, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, then_value, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, else_value, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Construct(base, fields, construct_line) | Expr.RecordUpdate(base, fields, construct_line):
                        table <- nca_walk_expr(file, caller_params, base, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        for field in fields |table|:
                            table <- nca_walk_expr(file, caller_params, field.value, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, comprehension_line, _):
                        table <- nca_walk_expr(file, caller_params, iterable, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        mark: usize = bound.count
                        bound.push(loop_variable) if loop_variable != ""
                        table <- nca_walk_expr(file, caller_params, condition, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, body, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        bound <- bound.truncate(mark)
                    Expr.Block(statements, value, captures, block_line):
                        mark: usize = bound.count
                        table <- nca_walk_stmts(file, caller_params, statements, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(file, caller_params, value, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        bound <- bound.truncate(mark)
                    Expr.Lambda(parameters, body, lambda_line):
                        mark: usize = bound.count
                        for parameter in parameters |bound|:
                            bound.push(parameter)
                        table <- nca_walk_stmts(file, caller_params, body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        bound <- bound.truncate(mark)
                    Expr.Match(scrutinee, arms, match_line):
                        table <- nca_walk_expr(file, caller_params, scrutinee, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        for arm in arms |table, bound|:
                            mark: usize = bound.count
                            collect_pattern_binding_names(arm.pattern, bound)
                            table <- nca_walk_expr(file, caller_params, arm.guard, line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            table <- nca_walk_stmts(file, caller_params, arm.body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            bound <- bound.truncate(mark)
                    _:
                        pass


        def nca_walk_stmts(file: Ast::File&, caller_params: darray[Ast::ParamDecl], statements: darray[Ast::Stmt], bound: mutable darray[sview]&, extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, bound| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- nca_walk_expr(file, caller_params, expression, line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- nca_walk_expr(file, caller_params, value, line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            bound.push(name)
                        Stmt.Assign(target, operator, value, line):
                            table <- nca_walk_expr(file, caller_params, target, line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            table <- nca_walk_expr(file, caller_params, value, line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            ewr_collect_target_names(target, bound) if operator == TokenKind.Assign
                        Stmt.Return(value, line):
                            table <- nca_walk_expr(file, caller_params, returned, line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- nca_walk_expr(file, caller_params, condition, line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            mark: usize = bound.count
                            table <- nca_walk_stmts(file, caller_params, then_body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            bound <- bound.truncate(mark)
                            table <- nca_walk_stmts(file, caller_params, else_body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            bound <- bound.truncate(mark)
                        Stmt.While(condition, while_body, while_line):
                            table <- nca_walk_expr(file, caller_params, condition, while_line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            mark: usize = bound.count
                            table <- nca_walk_stmts(file, caller_params, while_body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            bound <- bound.truncate(mark)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- nca_walk_expr(file, caller_params, iterable, for_line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            mark: usize = bound.count
                            for variable in variables |bound|:
                                bound.push(variable)
                            table <- nca_walk_stmts(file, caller_params, for_body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            bound <- bound.truncate(mark)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            mark: usize = bound.count
                            bound.push(binding) if binding != ""
                            table <- nca_walk_stmts(file, caller_params, body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            bound <- bound.truncate(mark)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- nca_walk_expr(file, caller_params, scrutinee, match_line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                            for arm in arms |table, bound| -> table:
                                mark: usize = bound.count
                                collect_pattern_binding_names(arm.pattern, bound)
                                table <- nca_walk_expr(file, caller_params, arm.guard, match_line.line, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                                table <- nca_walk_stmts(file, caller_params, arm.body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                                bound <- bound.truncate(mark)
                        _:
                            pass


        def nca_collect_externs(declarations: darray[Ast::Decl], names: mutable darray[sview]&, starts: mutable darray[u32]&, arities: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, starts, arities|:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, has_params, return_type, decorators, line):
                            names.push(name)
                            starts.push(param_start)
                            arities.push(arity)
                        Decl.Module(module_name, module_body, module_line):
                            nca_collect_externs(module_body, names, starts, arities)
                        Decl.Scoped(scoped_body, scoped_line):
                            nca_collect_externs(scoped_body, names, starts, arities)
                        _:
                            pass

        def nca_walk_declarations(file: Ast::File&, declarations: darray[Ast::Decl], extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            bound: mutable darray[sview] = [parameter.name for parameter in parameters]
                            table <- nca_walk_stmts(file, parameters, body, bound, extern_names, extern_starts, extern_arities, extern_params, table)
                        Decl.Module(module_name, module_body, module_line):
                            previous_module: sview @source = table.current_module
                            table.current_module <- module_name
                            table <- nca_walk_declarations(file, module_body, extern_names, extern_starts, extern_arities, extern_params, table)
                            table.current_module <- previous_module
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- nca_walk_declarations(file, scoped_body, extern_names, extern_starts, extern_arities, extern_params, table)
                        _:
                            pass


    public:
        def check_named_call_args(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                extern_names: mutable darray[sview] = []
                extern_starts: mutable darray[u32] = []
                extern_arities: mutable darray[u32] = []
                nca_collect_externs(file.top_decls, extern_names, extern_starts, extern_arities)
                previous_module: sview @source = table.current_module
                table.current_module <- ""
                table <- nca_walk_declarations(file, file.top_decls, extern_names, extern_starts, extern_arities, file.extern_params, table)
                table.current_module <- previous_module
