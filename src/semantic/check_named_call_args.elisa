# Named-argument validation (stage0 named-call checks). Two structural errors:
#   * a POSITIONAL argument after a NAMED one — `consume(x: 1, 7)` — always illegal;
#   * a named argument whose name is not a parameter of the callee — `consume(z: 7, ...)`.
#
# The positional-after-named rule needs no callee resolution (it is a pure argument-order
# property). The unknown-parameter rule fires only when the callee's full parameter list is
# known (a top-level function via the symbol table, or an extern via file.extern_params);
# an unresolved callee (method, import, generic, callback) is skipped so no false unknowns.
extend Semantic:
    private:
        def nca_param_names_of(callee: sview, param_owner: darray[sview]&, param_name: darray[sview]&, extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, out: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable bool = false
                probe: mutable usize = 0
                while probe < param_owner.count |probe, out, resolved|:
                    if param_owner[probe] == callee:
                        out.push(param_name[probe])
                        resolved <- true
                    probe <- probe + 1
                extern_probe: mutable usize = 0
                while extern_probe < extern_names.count |extern_probe, out, resolved|:
                    if extern_names[extern_probe] == callee:
                        start: usize = extern_starts[extern_probe].usize()
                        arity: usize = extern_arities[extern_probe].usize()
                        slot: mutable usize = 0
                        while slot < arity and (start + slot) < extern_params.count |slot, out|:
                            out.push(extern_params[start + slot].name)
                            slot <- slot + 1
                        resolved <- true
                    extern_probe <- extern_probe + 1
                return resolved

        def nca_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for entry in names:
                    true return if entry == wanted
                return false

        def nca_check_call(callee: sview, argument_names: darray[sview]&, line: u32, extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                has_named: bool = any entry in argument_names where entry != ""
                return if not has_named
                # Positional-after-named: once a named arg appears, any later "" is illegal.
                seen_named: mutable bool = false
                flagged_positional: mutable bool = false
                order_index: mutable usize = 0
                while order_index < argument_names.count |order_index, seen_named, flagged_positional, table| -> table:
                    entry: sview = argument_names[order_index]
                    if entry != "":
                        seen_named <- true
                    elif seen_named and not flagged_positional:
                        flagged_positional <- true
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedArgError, name: callee, line: line, expected: "positional", actual: ""})
                    order_index <- order_index + 1
                # Unknown parameter: only when the callee's params are fully known.
                params: mutable darray[sview] = []
                resolved: bool = nca_param_names_of(callee, table.function_param_owner, table.function_param_name, extern_names, extern_starts, extern_arities, extern_params, params)
                if resolved:
                    name_index: mutable usize = 0
                    while name_index < argument_names.count |name_index, table| -> table:
                        arg_name: sview = argument_names[name_index]
                        if arg_name != "" and not nca_name_in(params, arg_name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedArgError, name: callee, line: line, expected: "unknown", actual: arg_name})
                        name_index <- name_index + 1


        def nca_walk_expr(expression: Ast::Expr, line: u32, extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        table <- nca_check_call(callee_name, argument_names, call_line, extern_names, extern_starts, extern_arities, extern_params, table) if callee_name != ""
                        for argument in arguments |table| -> table:
                            table <- nca_walk_expr(argument, line, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- nca_walk_expr(left, line, extern_names, extern_starts, extern_arities, extern_params, table)
                        table <- nca_walk_expr(right, line, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Paren(inner, paren_line):
                        table <- nca_walk_expr(inner, line, extern_names, extern_starts, extern_arities, extern_params, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- nca_walk_expr(operand, line, extern_names, extern_starts, extern_arities, extern_params, table)
                    _:
                        pass


        def nca_walk_stmts(statements: darray[Ast::Stmt], extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- nca_walk_expr(expression, line, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- nca_walk_expr(value, line, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- nca_walk_expr(value, line, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.Return(value, line):
                            table <- nca_walk_expr(returned, line, extern_names, extern_starts, extern_arities, extern_params, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- nca_walk_stmts(then_body, extern_names, extern_starts, extern_arities, extern_params, table)
                            table <- nca_walk_stmts(else_body, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- nca_walk_stmts(while_body, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- nca_walk_stmts(for_body, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- nca_walk_stmts(body, extern_names, extern_starts, extern_arities, extern_params, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- nca_walk_stmts(arm.body, extern_names, extern_starts, extern_arities, extern_params, table)
                        _:
                            pass


        def nca_collect_externs(declarations: darray[Ast::Decl], names: mutable darray[sview]&, starts: mutable darray[u32]&, arities: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, starts, arities|:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, has_params, return_type, decorators, line):
                            names.push(name)
                            starts.push(param_start)
                            arities.push(arity)
                        Decl.Module(module_name, module_body, module_line):
                            nca_collect_externs(module_body, names, starts, arities)
                        Decl.Scoped(scoped_body, scoped_line):
                            nca_collect_externs(scoped_body, names, starts, arities)
                        _:
                            pass

        def nca_walk_declarations(declarations: darray[Ast::Decl], extern_names: darray[sview]&, extern_starts: darray[u32]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- nca_walk_stmts(body, extern_names, extern_starts, extern_arities, extern_params, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- nca_walk_declarations(module_body, extern_names, extern_starts, extern_arities, extern_params, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- nca_walk_declarations(scoped_body, extern_names, extern_starts, extern_arities, extern_params, table)
                        _:
                            pass


    public:
        def check_named_call_args(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                extern_names: mutable darray[sview] = []
                extern_starts: mutable darray[u32] = []
                extern_arities: mutable darray[u32] = []
                nca_collect_externs(file.top_decls, extern_names, extern_starts, extern_arities)
                table <- nca_walk_declarations(file.top_decls, extern_names, extern_starts, extern_arities, file.extern_params, table)
