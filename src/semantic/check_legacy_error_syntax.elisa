extend Semantic:
    public:
        def check_legacy_error_syntax(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LegacyErrorSyntax, name: "wildcard", line: annotation.line, expected: "", actual: ""}) if annotation.name == "__legacy_error_wildcard"
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LegacyErrorSyntax, name: "pipe", line: annotation.line, expected: "", actual: ""}) if annotation.name == "__legacy_error_pipe"
