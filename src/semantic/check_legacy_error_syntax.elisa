extend Semantic:
    public:
        def check_legacy_error_syntax(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    diagnostic_name: sview = LegacyErrorSyntaxName::diagnostic_name(annotation.name)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LegacyErrorSyntax, name: diagnostic_name, line: annotation.line, expected: "", actual: ""}) if diagnostic_name != ""
