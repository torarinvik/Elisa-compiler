# Check for a void value used as an operand of an arithmetic, logical, or
# comparison binary operator, or as the operand of unary `not`. A void value
# (the result of calling a `-> void` function) is never a valid operand of any
# operator. Message is ONE generic static text (unlike stage0, which varies
# wording by operator family): "operand of this operator cannot be void".
#
# Disjoint from the other batch-9 void checks: VoidFieldAccess owns
# `Expr.Field(object,...)`, VoidIndex owns `Expr.Index/IndexN(object,...)`,
# VoidCondition owns if/while CONDITIONS. This check owns only the
# operator-operand positions of arithmetic/logical/comparison binaries and
# unary `not`. Shift/bitwise operators (`<< >> & | ^`) are out of scope.
# Never fires on SemTypeKind.Unknown — only a firm SemTypeKind.Void triggers.

extend Semantic:
    private:
        # Walk through expressions, checking for void operands of operators.
        def walk_expression_for_void_operand(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        is_arith: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
                        is_logical: bool = operator == TokenKind.And or operator == TokenKind.Or
                        is_comparison: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
                        # An operator position rejects a void operand. Type inference is pure,
                        # so computing operand types unconditionally and guarding the push
                        # keeps the decision one guarded statement each (no block if).
                        is_operator_operand: bool = is_arith or is_logical or is_comparison
                        left_type: InferType = infer_expression_type(left, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidOperand, name: "", line: line, expected: "", actual: ""}) if is_operator_operand and left_type.kind == SemTypeKind.Void
                        right_type: InferType = infer_expression_type(right, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidOperand, name: "", line: line, expected: "", actual: ""}) if is_operator_operand and right_type.kind == SemTypeKind.Void
                        # Recursively walk both sides
                        table <- walk_expression_for_void_operand(left, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Unary(operator, operand, line):
                        operand_type: InferType = infer_expression_type(operand, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidOperand, name: "", line: line, expected: "", actual: ""}) if operator == TokenKind.Not and operand_type.kind == SemTypeKind.Void
                        table <- walk_expression_for_void_operand(operand, table, var_types, type_names)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_void_operand(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_operand(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_void_operand(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_void_operand(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_void_operand(object, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_void_operand(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_operand(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_operand(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_void_operand(object, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(low, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_void_operand(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_operand(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_operand(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_void_operand(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_void_operand(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_void_operand(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_operand(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_void_operand(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_operand(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_void_operand(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_void_operand(iterable, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_void_operand(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_void_operand(statements, table, var_types, type_names)
                        table <- walk_expression_for_void_operand(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_void_operand(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_void_operand(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for void operands.
        def walk_statements_for_void_operand(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_void_operand(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_void_operand(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_void_operand(target, table, var_types, type_names)
                            table <- walk_expression_for_void_operand(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_void_operand(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_operand(then_body, table, var_types, type_names)
                            table <- walk_statements_for_void_operand(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_void_operand(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_operand(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_void_operand(iterable, table, var_types, type_names)
                            table <- walk_statements_for_void_operand(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_void_operand(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_void_operand(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_void_operand(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_void_operand(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_void_operand(return_value, table, var_types, type_names)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_void_operand(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_void_operand_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_void_operand(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_void_operand_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_operand_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_void_operand(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_void_operand_declarations(declarations, table)
