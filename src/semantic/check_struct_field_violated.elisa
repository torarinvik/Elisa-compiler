# Struct-field where-refinement violation by a constant. A field `f: T where PRED` carries PRED;
# a construction `S{f: V}` or field assignment `s.f <- V` with a constant V that provably breaks
# PRED is rejected. Construction cites "of S"; a bare field assign does not. Decidable subset
# (reuses the check_where_reassign evaluator): PRED binds the field name, V is an integer literal.
extend Semantic:
    private:
        # Struct field where-predicates as parallel (struct, field, predicate) rows.
        def collect_struct_field_predicates(declarations: darray[Ast::Decl], struct_names: mutable darray[sview]&, field_names: mutable darray[sview]&, predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |struct_names, field_names, predicates|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            for member in members |struct_names, field_names, predicates|:
                                predicate: Ast::Expr = where_predicate_of_type(member.type_expression)
                                has_predicate: bool = match predicate:
                                    Expr.Absent: false
                                    _: true
                                if has_predicate:
                                    struct_names.push(struct_name)
                                    field_names.push(member.name)
                                    predicates.push(predicate)
                        Decl.Module(module_name, module_body, module_line):
                            collect_struct_field_predicates(module_body, struct_names, field_names, predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_struct_field_predicates(scoped_body, struct_names, field_names, predicates)
                        _:
                            pass

        # Whether (struct, field) constant value provably violates that field's predicate.
        def struct_field_constant_violates(struct_name: sview, field: sview, value: i64, struct_names: darray[sview]&, field_names: darray[sview]&, predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                probe: mutable usize = 0
                violated: mutable bool = false
                while probe < struct_names.count |probe, violated|:
                    matched: bool = struct_names[probe] == struct_name and field_names[probe] == field
                    violated <- true if matched and predicate_violated_by(predicates[probe], field, value)
                    probe <- probe + 1
                return violated

        # Evaluate an operand against a field->constant environment: an int literal, or a field
        # whose value is known in ENV. found=false when it is neither (so the predicate stays
        # undecidable and never emits).
        def eval_operand_env(operand: Ast::Expr, env_names: darray[sview]&, env_values: darray[i64]&) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                literal: (found: bool, value: i64) = where_signed_literal(operand)
                literal return if literal.found
                name: sview = ident_name_of(operand)
                (false, 0) return if name == ""
                probe: mutable usize = 0
                got: mutable bool = false
                result: mutable i64 = 0
                while probe < env_names.count |probe, got, result|:
                    matched: bool = env_names[probe] == name
                    got <- true if matched
                    result <- env_values[probe] if matched
                    probe <- probe + 1
                return (got, result)

        # Whether PREDICATE is provably FALSE under the field->constant environment. Handles
        # `a <op> b` where both operands resolve (literals or known fields) and and/or of them.
        def predicate_violated_env(predicate: Ast::Expr, env_names: darray[sview]&, env_values: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, line):
                        return predicate_violated_env(inner, env_names, env_values)
                    Expr.Binary(left, operator, right, line):
                        (predicate_violated_env(left, env_names, env_values) or predicate_violated_env(right, env_names, env_values)) return if operator == TokenKind.And
                        (predicate_violated_env(left, env_names, env_values) and predicate_violated_env(right, env_names, env_values)) return if operator == TokenKind.Or
                        false return if not is_where_comparison(operator)
                        left_operand: (found: bool, value: i64) = eval_operand_env(left, env_names, env_values)
                        right_operand: (found: bool, value: i64) = eval_operand_env(right, env_names, env_values)
                        return left_operand.found and right_operand.found and not evaluate_comparison(left_operand.value, operator, right_operand.value)
                    _:
                        return false

        # The bare struct type name of a param/local declared type, stripping mutable/&/paren.
        def bare_struct_type(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return name
                    Expr.Paren(inner, paren_line):
                        return bare_struct_type(inner)
                    Expr.Unary(operator, operand, unary_line):
                        return bare_struct_type(operand)
                    Expr.Refinement(base, predicate, refinement_line):
                        return bare_struct_type(base)
                    _:
                        return sview("", 0, 0)

        def struct_field_violated_expression(expression: Ast::Expr, receiver_types: darray[sview]&, receiver_names: darray[sview]&, struct_names: darray[sview]&, field_names: darray[sview]&, predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Construct(type_expression, fields, construct_line):
                        struct_name: sview = bare_struct_type(type_expression)
                        # Build the field->constant environment so a multi-field predicate like
                        # `hi > lo` can be evaluated with every constant field value substituted.
                        env_names: mutable darray[sview] = []
                        env_values: mutable darray[i64] = []
                        for field in fields |env_names, env_values|:
                            field_constant: (found: bool, value: i64) = fold_const_int(field.value)
                            if field_constant.found:
                                env_names.push(field.name)
                                env_values.push(field_constant.value)
                        for field in fields |env_names, env_values, table| -> table:
                            predicate: Ast::Expr = struct_law_field_type_of(struct_name, field.name, struct_names, field_names, predicates)
                            has_predicate: bool = match predicate:
                                Expr.Absent: false
                                _: true
                            violates: bool = struct_name != "" and has_predicate and predicate_violated_env(predicate, env_names, env_values)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldRefinementViolated, name: field.name, line: construct_line.line, expected: struct_name, actual: ""}) if violates
                        for field_value in fields |table| -> table:
                            table <- struct_field_violated_expression(field_value.value, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                    Expr.Paren(inner, paren_line):
                        table <- struct_field_violated_expression(inner, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- struct_field_violated_expression(argument, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                    _:
                        pass

        # `s.f <- V`: resolve s's struct type, then check V against field f's predicate.
        def struct_field_violated_assign(target: Ast::Expr, value: Ast::Expr, line: u32, receiver_types: darray[sview]&, receiver_names: darray[sview]&, struct_names: darray[sview]&, field_names: darray[sview]&, predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Field(object, field, field_line):
                        receiver: sview = ident_name_of(object)
                        return if receiver == ""
                        value_literal: (found: bool, value: i64) = fold_const_int(value)
                        return if not value_literal.found
                        probe: mutable usize = 0
                        receiver_struct: mutable sview = sview("", 0, 0)
                        while probe < receiver_names.count |probe, receiver_struct|:
                            receiver_struct <- receiver_types[probe] if receiver_names[probe] == receiver
                            probe <- probe + 1
                        return if receiver_struct == ""
                        violates: bool = struct_field_constant_violates(receiver_struct, field, value_literal.value, struct_names, field_names, predicates)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldRefinementViolated, name: field, line: line, expected: "", actual: ""}) if violates
                    _:
                        pass

        def struct_field_violated_statements(statements: darray[Ast::Stmt], receiver_types: mutable darray[sview]&, receiver_names: mutable darray[sview]&, struct_names: darray[sview]&, field_names: darray[sview]&, predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |receiver_types, receiver_names, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            struct_type: sview = bare_struct_type(type_expression)
                            if struct_type != "":
                                receiver_names.push(name)
                                receiver_types.push(struct_type)
                            table <- struct_field_violated_expression(value, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- struct_field_violated_assign(target, value, line.line, receiver_types, receiver_names, struct_names, field_names, predicates, table) if operator == TokenKind.LArrow
                            table <- struct_field_violated_expression(value, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Stmt.Expr(expression, line):
                            table <- struct_field_violated_expression(expression, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- struct_field_violated_expression(returned, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- struct_field_violated_statements(then_body, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                            table <- struct_field_violated_statements(else_body, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Stmt.While(condition, body, line):
                            table <- struct_field_violated_statements(body, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- struct_field_violated_statements(body, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- struct_field_violated_statements(body, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        _:
                            pass

        def struct_field_violated_walk(declarations: darray[Ast::Decl], struct_names: darray[sview]&, field_names: darray[sview]&, predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            receiver_types: mutable darray[sview] = []
                            receiver_names: mutable darray[sview] = []
                            for parameter in parameters |receiver_types, receiver_names|:
                                param_struct: sview = bare_struct_type(parameter.type_expression)
                                if param_struct != "":
                                    receiver_names.push(parameter.name)
                                    receiver_types.push(param_struct)
                            table <- struct_field_violated_statements(body, receiver_types, receiver_names, struct_names, field_names, predicates, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- struct_field_violated_walk(module_body, struct_names, field_names, predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- struct_field_violated_walk(scoped_body, struct_names, field_names, predicates, table)
                        _:
                            pass

        def check_struct_field_violated(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                struct_names: mutable darray[sview] = []
                field_names: mutable darray[sview] = []
                predicates: mutable darray[Ast::Expr] = []
                collect_struct_field_predicates(declarations, struct_names, field_names, predicates)
                table <- struct_field_violated_walk(declarations, struct_names, field_names, predicates, table) if struct_names.count > 0
