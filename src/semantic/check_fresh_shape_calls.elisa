# Fresh logical-shape provenance across CALLS (stage0 parity). A function whose
# return type is `darray[T, shape_x]` with the implicit `shape_` prefix returns a
# FRESH shape instance at every call site (numbered #1, #2, ... in analysis
# order). Passing such a fresh instance — or a param with a DIFFERENT named
# shape — where a named-shape parameter is expected is a mismatch; the fresh
# case adds stage0's provenance note ("note: grow returns a fresh logical shape
# for shape_after"). Sound subset: two-argument `darray[elem, shape]` types with
# bare-ident arguments only.

extend Semantic:
    private:
        # The (elem, shape) pair of a `darray[elem, shape]` type expression;
        # ("", "") when the expression has another shape.
        def darray_shape_pair_of(type_expression: Ast::Expr) -> (elem: sview, shape: sview):
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.IndexN(object, arguments, index_line):
                        ("", "") return if ident_name_of(object) != "darray" or arguments.count < 2
                        return (ident_name_of(arguments[0]), ident_name_of(arguments[1]))
                    _:
                        return ("", "")

        # Rows: function name -> declared (elem, shape) of its darray return,
        # collected from defs and extern annotations. Parallel arrays.
        def collect_fresh_shape_returns(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, fn_names: mutable darray[sview]&, fn_elems: mutable darray[sview]&, fn_shapes: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |fn_names, fn_elems, fn_shapes|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if return_type is return_expression:
                                pair: (elem: sview, shape: sview) = darray_shape_pair_of(return_expression)
                                # A return shape that ALSO names a parameter's shape is
                                # shape-PRESERVING (identity-style), not a fresh producer.
                                shape_is_param: mutable bool = false
                                for parameter in parameters |shape_is_param|:
                                    param_pair: (elem: sview, shape: sview) = darray_shape_pair_of(parameter.type_expression)
                                    shape_is_param <- true if param_pair.shape == pair.shape and pair.shape != ""
                                if pair.shape != "" and not shape_is_param:
                                    fn_names.push(name)
                                    fn_elems.push(pair.elem)
                                    fn_shapes.push(pair.shape)
                        Decl.Module(module_name, body, module_line):
                            collect_fresh_shape_returns(body, annotations, fn_names, fn_elems, fn_shapes)
                        _:
                            pass
                # Extern producers: the parser records paired
                # __extern_return_shape / __extern_return_shape_fn rows.
                annotation_index: mutable usize = 0
                while annotation_index < annotations.count |annotation_index, fn_names, fn_elems, fn_shapes|:
                    if annotations[annotation_index].owner == "__extern_return_shape" and annotation_index + 1 < annotations.count and annotations[annotation_index + 1].owner == "__extern_return_shape_fn":
                        fn_names.push(annotations[annotation_index + 1].name)
                        fn_elems.push("")
                        fn_shapes.push(annotations[annotation_index].name)
                    annotation_index <- annotation_index + 1

        # The declared return shape of `fn_name` ("" when not a shape returner).
        def fresh_return_shape_of(fn_name: sview, fn_names: darray[sview]&, fn_shapes: darray[sview]&) -> sview:
            can Abort.Panic:
                row: mutable usize = 0
                while row < fn_names.count |row|:
                    fn_shapes[row] return if fn_names[row] == fn_name
                    row <- row + 1
                return ""

        # Analyze one call argument against a shape-annotated parameter.
        def check_fresh_shape_argument(fn_name: sview, argument: Ast::Expr, argument_index: usize, expected_elem: sview, expected_shape: sview, line: u32, fn_names: darray[sview]&, fn_shapes: darray[sview]&, param_names: darray[sview]&, param_shapes: darray[sview]&, counter: mutable usize&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Case A: argument is a CALL to a fresh-shape returner.
                if argument is Expr.Call(inner_callee, inner_arguments, inner_names, inner_line):
                    if inner_callee is Expr.Ident(inner_name, inner_name_line):
                        inner_shape: sview = fresh_return_shape_of(inner_name, fn_names, fn_shapes)
                        if inner_shape != "" and shape_name_is_implicit(inner_shape):
                            counter <- counter + 1
                            if not shape_name_is_implicit(expected_shape):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FreshShapeArgMismatch, name: fn_name, line: line, expected: expected_elem, actual: expected_shape, detail: inner_shape, expected_count: (argument_index + 1).u32(), actual_count: counter.u32()})
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FreshShapeNote, name: inner_name, line: line, expected: inner_shape, actual: ""})
                            return
                # Case B: argument is a PARAM with a different NAMED shape.
                if argument is Expr.Ident(argument_name, argument_name_line):
                    param_row: mutable usize = 0
                    while param_row < param_names.count |param_row, table|:
                        if param_names[param_row] == argument_name:
                            argument_shape: sview = param_shapes[param_row]
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FreshShapeArgMismatch, name: fn_name, line: line, expected: expected_elem, actual: expected_shape, detail: argument_shape, expected_count: (argument_index + 1).u32(), actual_count: 0}) if argument_shape != "" and not shape_name_is_implicit(argument_shape) and not shape_name_is_implicit(expected_shape) and argument_shape != expected_shape
                        param_row <- param_row + 1

        # Walk a function body: seed the fresh counter at fresh-returner calls in
        # RETURN/decl positions too (each call takes an instance number), and check
        # call arguments against callee parameter shapes.
        def walk_fresh_shape_statements(statements: darray[Ast::Stmt], declarations: darray[Ast::Decl]&, fn_names: darray[sview]&, fn_shapes: darray[sview]&, enclosing_params: darray[sview]&, enclosing_param_shapes: darray[sview]&, return_elem: sview, return_shape: sview, counter: mutable usize&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |counter, table|:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                if returned is Expr.Call(return_callee, return_arguments, return_argument_names, return_call_line):
                                    if return_callee is Expr.Ident(returned_fn, returned_fn_line):
                                        returned_shape: sview = fresh_return_shape_of(returned_fn, fn_names, fn_shapes)
                                        if shape_name_is_implicit(returned_shape):
                                            counter <- counter + 1
                                            # Returning a fresh instance where the function
                                            # declares a NAMED shape is a mismatch with
                                            # provenance (stage0's return + note pair).
                                            if return_shape != "" and not shape_name_is_implicit(return_shape):
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FreshShapeArgMismatch, name: "return", line: line, expected: return_elem, actual: return_shape, detail: returned_shape, expected_count: 0, actual_count: counter.u32()})
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FreshShapeNote, name: returned_fn, line: line, expected: returned_shape, actual: ""})
                        Stmt.Expr(expression, line):
                            if expression is Expr.Call(callee, arguments, argument_names, call_line):
                                if callee is Expr.Ident(callee_name, callee_name_line):
                                    table <- check_fresh_shape_call(callee_name, arguments, line, declarations, fn_names, fn_shapes, enclosing_params, enclosing_param_shapes, counter, table)
                        _:
                            pass

        # Check the arguments of a direct call against the callee's declared
        # darray-shape parameters (from its Decl.Func).
        def check_fresh_shape_call(callee_name: sview, arguments: darray[Ast::Expr], line: u32, declarations: darray[Ast::Decl]&, fn_names: darray[sview]&, fn_shapes: darray[sview]&, enclosing_params: darray[sview]&, enclosing_param_shapes: darray[sview]&, counter: mutable usize&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |counter, table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, decl_line):
                            if name == callee_name:
                                argument_index: mutable usize = 0
                                while argument_index < arguments.count and argument_index < parameters.count |argument_index, counter, table|:
                                    pair: (elem: sview, shape: sview) = darray_shape_pair_of(parameters[argument_index].type_expression)
                                    table <- check_fresh_shape_argument(callee_name, arguments[argument_index], argument_index, pair.elem, pair.shape, line, fn_names, fn_shapes, enclosing_params, enclosing_param_shapes, counter, table) if pair.shape != ""
                                    argument_index <- argument_index + 1
                        _:
                            pass

    public:
        def check_fresh_shape_calls(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                fn_names: mutable darray[sview] = []
                fn_elems: mutable darray[sview] = []
                fn_shapes: mutable darray[sview] = []
                collect_fresh_shape_returns(file.top_decls, file.enum_annotations, fn_names, fn_elems, fn_shapes)
                return if fn_names.count == 0
                counter: mutable usize = 0
                for declaration in file.top_decls |counter, table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            enclosing_params: mutable darray[sview] = []
                            enclosing_param_shapes: mutable darray[sview] = []
                            for parameter in parameters |enclosing_params, enclosing_param_shapes|:
                                pair: (elem: sview, shape: sview) = darray_shape_pair_of(parameter.type_expression)
                                enclosing_params.push(parameter.name)
                                enclosing_param_shapes.push(pair.shape)
                            return_pair: (elem: sview, shape: sview) = darray_shape_pair_of(return_expression) if return_type is return_expression else ("", "")
                            table <- walk_fresh_shape_statements(body, file.top_decls, fn_names, fn_shapes, enclosing_params, enclosing_param_shapes, return_pair.elem, return_pair.shape, counter, table)
                        _:
                            pass
