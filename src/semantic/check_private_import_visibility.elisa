extend Semantic:
    private:
        def pma_static_if_row_selection(file: Ast::File&, branch_row: usize, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (known: bool, selected: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64 or branch_row >= file.static_if_lines.count or branch_row >= file.static_if_kinds.count
                branch_depth: u32 = file.static_if_depths[branch_row] if branch_row < file.static_if_depths.count else StaticIfBranch::TOP_LEVEL_DEPTH
                chain_start: mutable usize = file.static_if_lines.count
                row: mutable usize = branch_row + 1.usize()
                while row > 0 |row, chain_start, branch_depth, file|:
                    row <- row - 1.usize()
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    if file.static_if_kinds[row] == StaticIfBranch::Kind.ChainHead:
                        chain_start <- row
                        break
                return (false, false) if chain_start >= file.static_if_lines.count
                for row in chain_start..<(branch_row + 1.usize()) |row, branch_row, branch_depth, file|:
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    branch_kind: StaticIfBranch::Kind = file.static_if_kinds[row]
                    if branch_kind == StaticIfBranch::Kind.Fallback:
                        return (true, row == branch_row)
                    return (false, false) if row >= file.static_if_conds.count or row >= file.static_if_modules.count
                    condition_module: sview = file.static_if_modules[row]
                    condition: (known: bool, value: i64) = pma_static_if_condition_value(file.static_if_conds[row], condition_module, file, table, depth + 1)
                    return (false, false) if not condition.known
                    if condition.known and condition.value != 0:
                        return (true, row == branch_row)
                    return (true, false) if row == branch_row
                return (true, false)

        # Statement static-if blocks retain the source line used by the parser's
        # condition-row projection. Refuse duplicate matches rather than filtering a
        # block with another branch's selection result.
        def pma_static_if_row_for_position(file: Ast::File&, position: Ast::Pos) -> usize:
            can Abort.Panic:
                selected: mutable usize = file.static_if_lines.count
                for row in 0..<file.static_if_lines.count |selected, position, file|:
                    if row < file.static_if_offsets.count and file.static_if_lines[row] == position.line and file.static_if_offsets[row] == position.offset:
                        return file.static_if_lines.count if selected < file.static_if_lines.count
                        selected <- row
                return selected

        def pma_static_scope_is_inactive(file: Ast::File&, position: Ast::Pos, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                branch_row: usize = pma_static_if_row_for_position(file, position)
                return false if branch_row >= file.static_if_lines.count
                branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                return branch.known and not branch.selected

        def pma_import_member_for_branch_annotation(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&) -> (found: bool, member: sview, module: sview):
            can Abort.Panic:
                return (true, annotation.name, annotation.module) if annotation.owner == "__from_member"
                return (false, "", "") if annotation.owner != "__from_src" and annotation.name != "__using_member"
                for member_annotation in annotations:
                    continue if member_annotation.owner != "__from_member" or member_annotation.line != annotation.line or member_annotation.offset != annotation.offset
                    continue if annotation.owner == "__from_src" and member_annotation.module != annotation.module
                    continue if annotation.name == "__using_member" and member_annotation.name != annotation.module
                    return (true, member_annotation.name, member_annotation.module)
                return (false, "", "")

        def pma_import_branch_selection(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&, marker_owner: sview, marker_name: sview, marker_detail: sview, module: sview, line: u32, offset: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, file, marker_owner, marker_name, marker_detail, module, line, offset|:
                    # Source positions are cheap and nearly unique; check them before
                    # comparing annotation strings while scanning the annotation table.
                    continue if marker.line != line or marker.offset != offset or marker.module != module or marker.name != marker_name or marker.owner != marker_owner or marker.detail_name != marker_detail
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- pma_static_if_row_selection(file, marker.identity_id.usize(), module, table) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        def pma_using_alias_for_using_row(annotations: darray[Ast::EnumAnnotation]&, using_row: Ast::EnumAnnotation) -> (found: bool, alias: sview, alias_offset: u32):
            can Abort.Panic:
                next_using_offset: mutable u32 = 4294967295
                for candidate in annotations |next_using_offset, using_row|:
                    continue if candidate.name != "__using" or candidate.module != using_row.module or candidate.line != using_row.line or candidate.offset <= using_row.offset
                    next_using_offset <- candidate.offset if candidate.offset < next_using_offset
                selected_alias: mutable sview = ""
                selected_alias_offset: mutable u32 = 4294967295
                for target_row in annotations |selected_alias, selected_alias_offset, using_row, next_using_offset|:
                    continue if target_row.name != "__using_alias_target" or target_row.owner != using_row.owner or target_row.module != using_row.module or target_row.line != using_row.line or target_row.offset <= using_row.offset or target_row.offset >= next_using_offset
                    for alias_row in annotations |selected_alias, selected_alias_offset, target_row|:
                        if alias_row.name == "__using_alias" and alias_row.module == target_row.module and alias_row.line == target_row.line and alias_row.offset == target_row.offset and target_row.offset < selected_alias_offset:
                            selected_alias <- alias_row.owner
                            selected_alias_offset <- target_row.offset
                return (selected_alias != "", selected_alias, selected_alias_offset)

        def pma_import_annotation_branch_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            return pma_import_annotation_branch_selection_indexed(annotation, annotations, annotations, file, table)

        def pma_import_annotation_branch_selection_indexed(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, markers: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                if annotation.name == "__binding_wildcard_import":
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__binding_wildcard_import_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset)
                if annotation.name == "__using":
                    alias_pair: (found: bool, alias: sview, alias_offset: u32) = pma_using_alias_for_using_row(annotations, annotation)
                    if alias_pair.found:
                        return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__using_alias_static_branch", alias_pair.alias, annotation.module, annotation.line, alias_pair.alias_offset)
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__binding_wildcard_import_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset)
                if annotation.name == "__using_alias":
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__using_alias_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset)
                if annotation.name == "__using_alias_target":
                    alias_name: mutable sview = ""
                    for alias in annotations |alias_name, annotation|:
                        alias_name <- alias.owner if alias.name == "__using_alias" and alias.module == annotation.module and alias.line == annotation.line and alias.offset == annotation.offset
                    return (true, true) if alias_name == ""
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__using_alias_static_branch", alias_name, annotation.module, annotation.line, annotation.offset)
                if annotation.owner == "__private_member":
                    member_module: mutable sview @source = ""
                    found_module: mutable bool = false
                    for module_annotation in annotations |member_module, found_module, annotation|:
                        continue if module_annotation.owner != "__private_member_module" or module_annotation.line != annotation.line or module_annotation.offset != annotation.offset
                        member_module <- module_annotation.name
                        found_module <- true
                        break
                    return (true, true) if not found_module
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__private_member_static_branch", annotation.name, member_module, annotation.line, annotation.offset)
                marker_member: (found: bool, member: sview, module: sview) = pma_import_member_for_branch_annotation(annotation, annotations)
                return (true, true) if not marker_member.found
                return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__from_member_static_branch", marker_member.member, marker_member.module, annotation.line, annotation.offset)

        def pma_import_annotation_in_inactive_static_branch(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(annotation, annotations, file, table)
                return branch.known and not branch.active

        def pma_import_row_branch_uncertain(annotations: darray[Ast::EnumAnnotation]&, import_owner: sview, import_name: sview, import_scope: sview, line: u32, offset: u32) -> bool:
            can Abort.Panic:
                return any marker in annotations where marker.owner == "__pma_unknown_static_import" and marker.name == import_owner and marker.detail_name == import_name and marker.module == import_scope and marker.line == line and marker.offset == offset

        def pma_active_import_annotations(file: Ast::File&, table: SymbolTable&, imports_only: bool = false) -> darray[Ast::EnumAnnotation]:
            can Memory.Allocate, Abort.Panic:
                active: mutable darray[Ast::EnumAnnotation] = []
                markers: mutable darray[Ast::EnumAnnotation] = []
                relevant: mutable darray[Ast::EnumAnnotation] = []
                has_alias_marker: mutable bool = false
                for candidate in file.enum_annotations |markers, relevant, has_alias_marker|:
                    if candidate.owner == "__static_if_branch" and (candidate.name == "__from_member_static_branch" or candidate.name == "__private_member_static_branch" or candidate.name == "__using_alias_static_branch" or candidate.name == "__binding_wildcard_import_static_branch"):
                        markers.push(candidate)
                        has_alias_marker <- true if candidate.name == "__using_alias_static_branch"
                    relevant.push(candidate) if candidate.owner == "__from_member" or candidate.owner == "__private_member_module" or candidate.name == "__using" or candidate.name == "__using_alias" or candidate.name == "__using_alias_target"
                for annotation in file.enum_annotations |active, markers, relevant, has_alias_marker, file, table|:
                    import_row: bool = annotation.owner == "__from_member" or annotation.owner == "__from_src" or annotation.name == "__using_member" or annotation.name == "__using" or annotation.name == "__binding_wildcard_import" or annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                    continue if imports_only and not import_row
                    private_member_row: bool = annotation.owner == "__private_member"
                    branch_row: bool = import_row or private_member_row
                    branch: mutable (known: bool, active: bool) = (true, true)
                    # A using target may resolve to an alias at a different offset.
                    # Every other marker lookup uses the annotation's own offset.
                    if branch_row:
                        marked: bool = any marker in markers where marker.offset == annotation.offset and marker.line == annotation.line
                        branch <- pma_import_annotation_branch_selection_indexed(annotation, relevant, markers, file, table) if marked or (annotation.name == "__using" and has_alias_marker)
                    continue if branch_row and branch.known and not branch.active
                    active.push(annotation)
                    if import_row and not branch.known:
                        active.push(Ast::EnumAnnotation{owner: "__pma_unknown_static_import", name: annotation.owner, detail_name: annotation.name, module: annotation.module, line: annotation.line, offset: annotation.offset})
                return active

        def pma_indexed_import_row_uncertain(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, annotation: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                for row in index.uncertain_rows:
                    marker: Ast::EnumAnnotation = annotations[row]
                    if marker.line == annotation.line and marker.offset == annotation.offset and marker.name == annotation.owner and marker.detail_name == annotation.name and marker.module == annotation.module:
                        return true
                return false

        def pma_selective_annotation_is_using_member(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, member_annotation: Ast::EnumAnnotation, source_annotation: Ast::EnumAnnotation, member: sview) -> bool:
            can Abort.Panic:
                for row in index.selective_rows:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    if annotation.line == member_annotation.line and annotation.offset == member_annotation.offset and annotation.name == "__using_member" and annotation.owner == source_annotation.name and annotation.module == member:
                        return true
                return false

        def pma_selective_import_target_status(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> (found: bool, known: bool, first: bool):
            can Abort.Panic:
                selected_owner: mutable sview = ""
                selected_scope: mutable sview = ""
                selected_offset: mutable u32 = 4294967295
                selected_is_using: mutable bool = false
                found_owner: mutable bool = false
                known_order: mutable bool = true
                for member_row in index.selective_rows |index, annotations, current_module, owner, member|:
                    member_annotation: Ast::EnumAnnotation = annotations[member_row]
                    continue if member_annotation.owner != "__from_member" or member_annotation.name != member
                    continue if not pma_import_scope_visible(current_module, member_annotation.module)
                    known_order <- false if pma_indexed_import_row_uncertain(index, annotations, member_annotation)
                    for source_row in index.selective_rows |index, annotations, current_module, owner, member, member_annotation|:
                        source_annotation: Ast::EnumAnnotation = annotations[source_row]
                        continue if source_annotation.owner != "__from_src" or source_annotation.line != member_annotation.line or source_annotation.offset != member_annotation.offset or source_annotation.module != member_annotation.module
                        found_owner <- true if source_annotation.name == owner
                        candidate_is_using: bool = pma_selective_annotation_is_using_member(index, annotations, member_annotation, source_annotation, member)
                        if selected_owner == "":
                            selected_owner <- source_annotation.name
                            selected_scope <- member_annotation.module
                            selected_offset <- member_annotation.offset
                            selected_is_using <- candidate_is_using
                        elif selected_owner != source_annotation.name:
                            # Core registers the first alias in one scope. Cross-scope
                            # conflicts do not carry enough ordered metadata here, so keep
                            # the private path fail-closed instead of guessing a winner.
                            if selected_scope != member_annotation.module:
                                known_order <- false
                            elif candidate_is_using and not selected_is_using:
                                selected_owner <- source_annotation.name
                                selected_offset <- member_annotation.offset
                                selected_is_using <- true
                            elif selected_is_using and not candidate_is_using:
                                pass
                            elif member_annotation.offset < selected_offset:
                                selected_owner <- source_annotation.name
                                selected_offset <- member_annotation.offset
                                selected_is_using <- candidate_is_using
                            elif member_annotation.offset == selected_offset:
                                known_order <- false
                return (found_owner, known_order, selected_owner == owner)

        # Keep original row identities: public visibility must still consult the exact
        # unknown-static-branch marker, and private visibility remains conservative.
        def pma_index_import_visibility_rows(annotations: darray[Ast::EnumAnnotation]&, index: mutable PrivateMemberIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<annotations.count |annotations, index|:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    index.wildcard_rows.push(row) if annotation.name == "__binding_wildcard_import"
                    index.selective_rows.push(row) if annotation.owner == "__from_member" or annotation.owner == "__from_src" or annotation.name == "__using_member"
                    index.uncertain_rows.push(row) if annotation.owner == "__pma_unknown_static_import"

        def pma_visible_wildcard_import(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, require_definite: bool) -> bool:
            can Abort.Panic:
                for row in index.wildcard_rows:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    continue if annotation.owner != owner or not pma_import_scope_visible(current_module, annotation.module)
                    return true if not require_definite or not pma_indexed_import_row_uncertain(index, annotations, annotation)
                return false

        # Selective imports are registered program-wide by Core. Resolve their
        # source relative to the declaring module before comparing the canonical
        # owner, and decline when the selected registration is conditional.
        def pma_program_selective_import(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                for row in index.selective_rows:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    if annotation.owner == "__from_member" and annotation.name == member:
                        return false if pma_indexed_import_row_uncertain(index, annotations, annotation)
                        return callable_program_selective_import_row(annotations, member, owner)
                return false

        def pma_private_imported_module_member_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if pma_visible_wildcard_import(index, annotations, current_module, owner, false)
                if pma_selective_imports(index, owner, member):
                    target: (found: bool, known: bool, first: bool) = pma_selective_import_target_status(index, annotations, current_module, owner, member)
                    return not target.known or target.first if target.found
                return pma_program_selective_import(index, annotations, owner, member)

        def pma_public_imported_module_member_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if pma_visible_wildcard_import(index, annotations, current_module, owner, true)
                if pma_selective_imports(index, owner, member):
                    target: (found: bool, known: bool, first: bool) = pma_selective_import_target_status(index, annotations, current_module, owner, member)
                    return target.known and target.first if target.found
                return pma_program_selective_import(index, annotations, owner, member)

        def pma_imported_module_member_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                return pma_public_imported_module_member_visible(index, annotations, current_module, owner, member)

        # Is the accessing module INSIDE the owner's privacy boundary? A nested module is:
        # `module A::Paint` may call `A::helper` even when `helper` is private to `A`, which is
        # what stage0 allows. This was a plain `!=` on the module names, so every child module
        # counted as outside its own parent and internal helpers had to be made public to be
        # callable from a submodule of the module that declared them.
        def pma_within_module(current_module: sview, owner: sview) -> bool:
            can Abort.Panic:
                return SemanticPrivateModuleBoundary::within_module(current_module, owner)

        # A candidate can join Core's unqualified receiver set when it is in the
        # current lexical module/one of its ancestors, at file scope, or imported into
        # the caller's scope. Do not count a public member in a private module path as a
        # usable sibling: Core can select it, but access checking will reject it.
        def pma_unqualified_candidate_module_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, candidate_module: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if candidate_module == "" or pma_within_module(current_module, candidate_module)
                return false if not pma_imported_module_member_visible(index, annotations, current_module, candidate_module, member)
                segment_start: mutable usize = 0.usize()
                while segment_start < candidate_module.len |segment_start, candidate_module, current_module, index, member|:
                    segment_end: mutable usize = segment_start
                    while segment_end < candidate_module.len and candidate_module[segment_end] != 58 |segment_end, candidate_module|:
                        segment_end <- segment_end + 1.usize()
                    segment: sview = candidate_module[segment_start:segment_end]
                    owner: sview = candidate_module[0:segment_start - 2.usize()] if segment_start >= 2.usize() else ""
                    return false if pma_is_private(index, owner, segment) and not pma_within_module(current_module, owner)
                    break if segment_end == candidate_module.len
                    next_start: usize = segment_end + 2.usize()
                    return false if next_start >= candidate_module.len or candidate_module[segment_end + 1.usize()] != 58
                    segment_start <- next_start
                return true

        # Return the owning module when an unqualified name resolves to a private
        # member imported into the current file. Qualified access was the original
        # check, but `using M` makes `M::hidden` and `hidden` the same visibility
        # boundary. Keep the caller's lexical bindings in the query so a parameter
        # or local that shadows a private imported member is not misdiagnosed.
        def pma_has_lexical_callable(file: Ast::File&, table: SymbolTable&, current_module: sview, member: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = symbol_chain_head(table, member)
                while row != SYMBOL_INDEX_ROW_NONE:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == member and ewr_module_is_lexical_ancestor(symbol.module_owner, current_module):
                        branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, member, symbol, table, 0)
                        return false if not branch.known
                        return true if branch.active
                    row <- table.symbol_name_next[row.usize()]
                return false

        def pma_unqualified_owner(file: Ast::File&, table: SymbolTable&, current_module: sview, private_index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, bound: darray[sview @source]&, member: sview) -> sview @source:
            can Abort.Panic:
                return "" if:
                    any bound_name in bound where bound_name == member
                    pma_has_global_value(table, member)
                    pma_has_lexical_callable(file, table, current_module, member)
                owner: sview @source = pma_unqualified_private_import_owner(table, current_module, private_index, annotations, member)
                return "" if owner != "" and pma_has_public_imported_function_value(table, private_index, annotations, current_module, member, owner)
                return owner

        def pma_unqualified_call_owner(table: SymbolTable&, current_module: sview, private_index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, bound: darray[sview @source]&, member: sview) -> sview @source:
            can Abort.Panic:
                return "" if:
                    any bound_name in bound where bound_name == member
                    pma_has_global_non_callable_value(table, member)
                return pma_unqualified_private_import_owner(table, current_module, private_index, annotations, member)

        def pma_unqualified_private_import_owner(table: SymbolTable&, current_module: sview, private_index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, member: sview) -> sview @source:
            can Abort.Panic:
                row: mutable u32 = member_chain_head(table, member)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, current_module, member|:
                    index: usize = row.usize()
                    if table.module_member_name[index] == member:
                        owner: sview @source = table.module_member_owner[index]
                        # The indexed privacy test runs first: the import test scans annotations.
                        if not pma_within_module(current_module, owner) and pma_is_private(private_index, owner, member):
                            imported: bool = pma_private_imported_module_member_visible(private_index, annotations, current_module, owner, member)
                            local_target: (found: bool, known: bool, first: bool) = pma_selective_import_target_status(private_index, annotations, current_module, owner, member)
                            public_binding_wins: bool = imported and not local_target.found and pma_has_public_imported_function_value(table, private_index, annotations, current_module, member, owner)
                            return owner if imported and not public_binding_wins and pma_module_owns(table, owner, member)
                    row <- table.member_name_next[index]
                return ""

        # The private-section marker is attached to the declaration-head offset, which is
        # also Symbol.offset. Match it back to the exact overload before using its signature;
        # name_pos.offset is the identifier token and does not identify the marker.
        def pma_symbol_has_private_marker(index: PrivateMemberIndex&, symbol: Symbol) -> bool:
            can Abort.Panic:
                row: mutable u32 = pma_member_head(index, symbol.name)
                while row != SYMBOL_INDEX_ROW_NONE |row, index, symbol|:
                    index_position: usize = row.usize()
                    return true if index.names[index_position] == symbol.name and index.modules[index_position] == symbol.module_owner and index.declaration_offsets[index_position] == symbol.offset
                    row <- index.name_next[index_position]
                return false

        # A private wildcard candidate is removed before a function value is resolved.
        # If the source also imports a public callable of the same spelling explicitly,
        # that selective binding is the visible value and the private wildcard row must
        # not trigger a name-only diagnostic. Calls use the overload-aware path below.
        def pma_has_public_imported_function_value(table: SymbolTable&, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, member: sview, hidden_owner: sview) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |table, index, annotations, current_module, member, hidden_owner|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != member or symbol.module_owner == "" or symbol.module_owner == hidden_owner
                    continue if not pma_module_owns(table, symbol.module_owner, member) or not pma_unqualified_candidate_module_visible(index, annotations, current_module, symbol.module_owner, member)
                    return true if not pma_symbol_has_private_marker(index, symbol)
                return false

        def pma_bound_type_name(bound: darray[sview @source]&, bound_types: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                index: mutable usize = bound.count
                while index > 0 |index, bound, bound_types, name|:
                    index <- index - 1
                    return bound_types[index] if bound[index] == name and index < bound_types.count
                    return "" if bound[index] == name
                return ""

        def pma_argument_type_name(argument: Ast::Expr, bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> sview @source:
            can Abort.Panic:
                match argument:
                    Expr.IntLit(_, _):
                        return "int"
                    Expr.FloatLit(_, _):
                        return "f64"
                    Expr.BoolLit(_, _):
                        return "bool"
                    Expr.CharLit(_, _):
                        return "char"
                    Expr.StringLit(_, _):
                        return "string"
                    Expr.Ident(name, _):
                        return pma_bound_type_name(bound, bound_types, name)
                    Expr.Paren(inner, _):
                        return pma_argument_type_name(inner, bound, bound_types)
                    _:
                        return ""

        def pma_symbol_first_parameter_type(table: SymbolTable&, symbol: Symbol) -> (found: bool, kind: SemTypeKind, name: sview @source):
            can Abort.Panic:
                parameter_index: mutable usize = 0.usize()
                for row in 0..<table.function_param_declaration_id.count |parameter_index, table, symbol|:
                    continue if table.function_param_declaration_id[row].value != symbol.id.value
                    if parameter_index == 0.usize():
                        return (true, interned_kind(table.function_param_type_id[row], table), table.function_param_type[row]) if row < table.function_param_type_id.count and row < table.function_param_type.count
                        return (false, SemTypeKind.Unknown, "")
                    parameter_index <- parameter_index + 1.usize()
                return (false, SemTypeKind.Unknown, "")

        def pma_generic_parameter_identity(annotations: darray[Ast::EnumAnnotation]&, parameter_name: sview, symbol: Symbol) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == parameter_name and annotation.name == "__generic_param_identity" and annotation.detail_line == symbol.line and annotation.offset == symbol.offset and annotation.module == symbol.module_owner

        # The call-site type probe carries a bare spelling, not a resolved nominal
        # owner. Only compare named formals when that spelling identifies one declared
        # type across the complete symbol table; same-spelled module-local types must
        # leave the privacy check fail-closed.
        def pma_named_type_spelling_is_unique(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                found: mutable bool = false
                for symbol in table.symbols |found, name|:
                    continue if symbol.name != name
                    type_symbol: bool = symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)
                    continue if not type_symbol
                    return false if found
                    found <- true
                return found

        # Mirror Core's receiver-ranking arity range exactly. Defaulted parameters lower
        # arity_min; they do not make every argument count viable, and variadic signatures
        # still require their non-defaulted minimum.
        def pma_symbol_core_accepts_receiver_arity(symbol: Symbol, argument_count: usize) -> bool:
            can Abort.Panic:
                return argument_count.u32() >= symbol.arity_min and argument_count.u32() <= symbol.arity_max

        # Rank only the public cases this checker can prove from source facts: an exact
        # known builtin or uniquely-spelled named formal, or Core's untyped-int-to-integral
        # receiver case, outranks a bare type parameter. A generic formal can still be the
        # only visible sibling; unknown conversions fail closed.
        def pma_public_call_sibling_rank(file: Ast::File&, index: PrivateMemberIndex&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, member: sview, current_module: sview, unqualified_call: bool, arguments: darray[Ast::Expr], bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> (found: bool, rank: usize):
            can Abort.Panic:
                return (false, 0.usize()) if arguments.count == 0.usize()
                actual_type: sview @source = pma_argument_type_name(arguments[0], bound, bound_types)
                return (false, 0.usize()) if actual_type == ""
                best_found: mutable bool = false
                best_rank: mutable usize = 0.usize()
                for symbol in table.symbols |best_found, best_rank, file, index, table, annotations, owner, member, current_module, unqualified_call, arguments, actual_type|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != member or pma_symbol_has_private_marker(index, symbol)
                    branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, member, symbol, table, 0)
                    continue if not branch.known or not branch.active
                    if not unqualified_call:
                        continue if symbol.module_owner != owner
                    continue if unqualified_call and not pma_unqualified_candidate_module_visible(index, annotations, current_module, symbol.module_owner, member)
                    continue if not pma_symbol_core_accepts_receiver_arity(symbol, arguments.count)
                    first_parameter: (found: bool, kind: SemTypeKind, name: sview @source) = pma_symbol_first_parameter_type(table, symbol)
                    continue if not first_parameter.found
                    candidate_rank: mutable usize = 0.usize()
                    if first_parameter.kind == SemTypeKind.Named and pma_generic_parameter_identity(annotations, first_parameter.name, symbol):
                        candidate_rank <- 0.usize()
                    elif (first_parameter.kind == SemTypeKind.Bool or first_parameter.kind == SemTypeKind.Int or first_parameter.kind == SemTypeKind.Float or first_parameter.kind == SemTypeKind.Char or first_parameter.kind == SemTypeKind.String) and first_parameter.name == actual_type:
                        candidate_rank <- 1.usize()
                    elif first_parameter.kind == SemTypeKind.Named and first_parameter.name == actual_type and pma_named_type_spelling_is_unique(table, first_parameter.name):
                        candidate_rank <- 1.usize()
                    elif actual_type == "int" and (first_parameter.kind == SemTypeKind.Int or first_parameter.kind == SemTypeKind.Char):
                        candidate_rank <- 1.usize()
                    else:
                        continue
                    # Core prefers a directly declared lexical candidate over an imported
                    # overload, even when the direct candidate is generic and the imported
                    # private candidate is concrete. Preserve that precedence before
                    # comparing formal-type specificity.
                    if unqualified_call and (symbol.module_owner == "" or pma_within_module(current_module, symbol.module_owner)):
                        candidate_rank <- 2.usize()
                    if not best_found or candidate_rank > best_rank:
                        best_found <- true
                        best_rank <- candidate_rank
                return (best_found, best_rank)

