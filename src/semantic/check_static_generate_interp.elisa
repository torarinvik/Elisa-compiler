# Static-generate interpolation must evaluate at compile time. An `emit def is_${runtime_name()}`
# template interpolates the result of a CALL; when that call targets an ordinary (runtime) function
# rather than a `static` compile-time one, it cannot be evaluated while expanding the template —
# stage0 errors "static generate interpolation must evaluate at compile time". The parser records
# each interpolation call head on `__static_gen_interp_call`; this flags the ones that name a
# declared non-`static` function. Unknown / static-fn / non-call interpolations decline (sound).
extend Semantic:
    private:
        def sgi_static_fn_branch_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, annotation, file, table|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__function_static_branch" or marker.detail_name != annotation.name
                    continue if marker.module != annotation.module or marker.line != annotation.line or marker.offset != annotation.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- pma_static_if_row_selection(file, marker.identity_id.usize(), annotation.module, table) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        # The interpolation annotation keeps the caller's lexical module. Match
        # lexical declarations and active wildcard/selective imports from that scope;
        # unresolved import or declaration markers keep the result uncertain.
        def sgi_function_visible(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, symbol: Symbol, current_module: sview) -> (known: bool, visible: bool, lexical: bool):
            can Memory.Allocate, Abort.Panic:
                return (true, true, true) if try_noncall_module_is_ancestor(symbol.module_owner, current_module) and callable_function_declaration_visible(annotations, symbol.name, symbol.module_owner, symbol.line, symbol.offset, current_module)
                return (true, false, false) if not callable_function_declaration_visible(annotations, symbol.name, symbol.module_owner, symbol.line, symbol.offset, current_module)
                import_uncertain: mutable bool = false
                for import_annotation in annotations |file, table, symbol, current_module, import_uncertain|:
                    continue if not try_noncall_module_is_ancestor(import_annotation.module, current_module)
                    if import_annotation.name == "__binding_wildcard_import":
                        target_module: sview = try_noncall_module_path(import_annotation.module, import_annotation.owner, table)
                        continue if target_module != symbol.module_owner
                        branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(import_annotation, annotations, file, table)
                        return (true, true, false) if branch.known and branch.active
                        import_uncertain <- true if not branch.known
                    if import_annotation.owner == "__from_member" and import_annotation.name == symbol.name:
                        for source in annotations |file, table, import_annotation, symbol, current_module, import_uncertain|:
                            continue if source.owner != "__from_src" or source.module != import_annotation.module or source.line != import_annotation.line or source.offset != import_annotation.offset
                            target_module: sview = try_noncall_module_path(import_annotation.module, source.name, table)
                            continue if target_module != symbol.module_owner
                            branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(import_annotation, annotations, file, table)
                            return (true, true, false) if branch.known and branch.active
                            import_uncertain <- true if not branch.known
                return (false, true, false) if import_uncertain
                return (true, false, false)

        # Decline when overloads or unresolved branch/import rows make the call
        # target uncertain, or when a same-spelled function is in an unrelated module.
        def sgi_interpolation_function_kind(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, name: sview, current_module: sview) -> (known: bool, runtime: bool):
            can Memory.Allocate, Abort.Panic:
                row: mutable u32 = symbol_chain_head(table, name)
                lexical_found: mutable bool = false
                lexical_depth: mutable usize = 0.usize()
                lexical_count: mutable u32 = 0
                lexical_runtime_count: mutable u32 = 0
                lexical_uncertain: mutable bool = false
                import_count: mutable u32 = 0
                import_runtime_count: mutable u32 = 0
                import_uncertain: mutable bool = false
                while row != 4294967295 |row, file, annotations, table, name, current_module, lexical_found, lexical_depth, lexical_count, lexical_runtime_count, lexical_uncertain, import_count, import_runtime_count, import_uncertain|:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.name == name and symbol.kind == SymbolKind.Func:
                        visibility: (known: bool, visible: bool, lexical: bool) = sgi_function_visible(file, annotations, table, symbol, current_module)
                        if visibility.visible:
                            branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, name, symbol, table, 0)
                            if not branch.known or branch.active:
                                candidate_uncertain: mutable bool = not visibility.known or not branch.known
                                is_static: mutable bool = false
                                static_uncertain: mutable bool = false
                                for annotation in annotations |file, table, name, symbol, is_static, static_uncertain, candidate_uncertain|:
                                    continue if annotation.owner != "__static_fn" or annotation.name != name or annotation.module != symbol.module_owner or annotation.line != symbol.line or annotation.offset != symbol.offset
                                    static_branch: (known: bool, active: bool) = sgi_static_fn_branch_selection(annotation, annotations, file, table)
                                    is_static <- true if static_branch.known and static_branch.active
                                    static_uncertain <- true if not static_branch.known
                                candidate_uncertain <- true if static_uncertain
                                is_runtime: bool = not is_static and not static_uncertain
                                if visibility.lexical:
                                    if not lexical_found or symbol.module_owner.len > lexical_depth:
                                        lexical_found <- true
                                        lexical_depth <- symbol.module_owner.len
                                        lexical_count <- 0
                                        lexical_runtime_count <- 0
                                        lexical_uncertain <- false
                                    if symbol.module_owner.len == lexical_depth:
                                        lexical_count <- lexical_count + 1
                                        lexical_runtime_count <- lexical_runtime_count + 1 if is_runtime
                                        lexical_uncertain <- true if candidate_uncertain
                                else:
                                    import_count <- import_count + 1
                                    import_runtime_count <- import_runtime_count + 1 if is_runtime
                                    import_uncertain <- true if candidate_uncertain
                    row <- table.symbol_name_next[row.usize()]
                return (lexical_count == 1 and not lexical_uncertain, lexical_count == 1 and lexical_runtime_count == 1 and not lexical_uncertain) if lexical_found
                return (import_count == 1 and not import_uncertain, import_count == 1 and import_runtime_count == 1 and not import_uncertain)

    public:
        def check_static_generate_interp(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.owner == "__static_gen_interp_call":
                        callee: sview = annotation.name
                        function_kind: (known: bool, runtime: bool) = sgi_interpolation_function_kind(file, file.enum_annotations, table, callee, annotation.module)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticGenerateInterpRuntime, name: callee, line: annotation.line, pos: annotation.pos, expected: "", actual: ""}) if function_kind.known and function_kind.runtime
