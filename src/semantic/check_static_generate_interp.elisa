# Static-generate interpolation must evaluate at compile time. An `emit def is_${runtime_name()}`
# template interpolates the result of a CALL; when that call targets an ordinary (runtime) function
# rather than a `static` compile-time one, it cannot be evaluated while expanding the template —
# stage0 errors "static generate interpolation must evaluate at compile time". The parser records
# each interpolation call head on `__static_gen_interp_call`; this flags the ones that name a
# declared non-`static` function. Unknown / static-fn / non-call interpolations decline (sound).
extend Semantic:
    private:
        def sgi_is_static_fn(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    true return if annotation.owner == "__static_fn" and annotation.name == name
                return false

    public:
        def check_static_generate_interp(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.owner == "__static_gen_interp_call":
                        callee: sview = annotation.name
                        runtime_fn: bool = direct_function_count(table, callee) > 0 and not sgi_is_static_fn(file.enum_annotations, callee)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticGenerateInterpRuntime, name: callee, line: annotation.line, expected: "", actual: ""}) if runtime_fn
