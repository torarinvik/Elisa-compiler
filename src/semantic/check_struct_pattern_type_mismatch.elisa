# Check for a `match` struct pattern (`Q{...}`) whose named struct differs from the
# scrutinee's REGISTERED struct type. E.g. `p: P` matched against `Q{b: x}` where
# `Q != P` can never succeed — parity with stage0's `struct pattern expects struct
# "Q", got "P"`. SOUND SUBSET: fires only when the scrutinee's inferred type is
# firmly `Named` AND that name is a registered struct (has a field row — i.e. it's
# a struct, not an enum), AND the arm's struct pattern names a DIFFERENT registered
# struct. Anything looser (Unknown scrutinee, enum scrutinee, unregistered pattern
# struct name, or a matching name) is silent.

extend Semantic:
    private:
        # Every `Expr.Ident` naming one of `wanted`, reported as an undefined identifier at
        # the REFERENCE's own extent. stage0 reports a mismatched arm's bindings where they
        # are USED, not where they are bound: a binding the body never mentions stays silent
        # (measured: a `Qsecond{y}` arm whose body is `return 7` draws ONE diagnostic from
        # stage0, not two), and a name used twice is reported twice. `Expr.Ident`'s pos is
        # exactly the name's extent, so the reference carries its own span.
        def struct_pattern_unbound_expression(expression: Ast::Expr, wanted: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(ident_name, ident_pos):
                        for wanted_name in wanted |table|:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: ident_name, line: ident_pos.line, pos: ident_pos, expected: "", actual: ""}) if ident_name == wanted_name
                    Expr.Field(object, field_name, field_pos):
                        table <- struct_pattern_unbound_expression(object, wanted, table)
                    Expr.Index(object, index, index_pos):
                        table <- struct_pattern_unbound_expression(object, wanted, table)
                        table <- struct_pattern_unbound_expression(index, wanted, table)
                    Expr.IndexN(object, index_arguments, indexn_pos):
                        table <- struct_pattern_unbound_expression(object, wanted, table)
                        for index_argument in index_arguments |table| -> table:
                            table <- struct_pattern_unbound_expression(index_argument, wanted, table)
                    Expr.Call(callee, call_arguments, argument_names, call_pos):
                        table <- struct_pattern_unbound_expression(callee, wanted, table)
                        for call_argument in call_arguments |table| -> table:
                            table <- struct_pattern_unbound_expression(call_argument, wanted, table)
                    Expr.Binary(left, binary_operator, right, binary_pos):
                        table <- struct_pattern_unbound_expression(left, wanted, table)
                        table <- struct_pattern_unbound_expression(right, wanted, table)
                    Expr.Unary(unary_operator, operand, unary_pos):
                        table <- struct_pattern_unbound_expression(operand, wanted, table)
                    Expr.Paren(inner, paren_pos):
                        table <- struct_pattern_unbound_expression(inner, wanted, table)
                    Expr.Array(array_elements, array_pos):
                        for array_element in array_elements |table| -> table:
                            table <- struct_pattern_unbound_expression(array_element, wanted, table)
                    Expr.Tuple(tuple_elements, tuple_pos):
                        for tuple_element in tuple_elements |table| -> table:
                            table <- struct_pattern_unbound_expression(tuple_element, wanted, table)
                    Expr.SetLit(set_elements, setlit_pos):
                        for set_element in set_elements |table| -> table:
                            table <- struct_pattern_unbound_expression(set_element, wanted, table)
                    _:
                        pass

        # The arm-body statement forms that can carry a reference to a pattern binding.
        def struct_pattern_unbound_statements(statements: darray[Ast::Stmt], wanted: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if wanted.count == 0
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, statement_pos):
                            table <- struct_pattern_unbound_expression(expression, wanted, table)
                        Stmt.VarDecl(declared_name, declared_type, declared_value, vardecl_pos):
                            table <- struct_pattern_unbound_expression(declared_value, wanted, table)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_pos):
                            table <- struct_pattern_unbound_expression(assign_target, wanted, table)
                            table <- struct_pattern_unbound_expression(assign_value, wanted, table)
                        Stmt.Return(return_value, return_pos):
                            if return_value is returned:
                                table <- struct_pattern_unbound_expression(returned, wanted, table)
                        Stmt.If(condition, then_body, else_body, if_pos):
                            table <- struct_pattern_unbound_expression(condition, wanted, table)
                            table <- struct_pattern_unbound_statements(then_body, wanted, table)
                            table <- struct_pattern_unbound_statements(else_body, wanted, table)
                        Stmt.While(condition, while_body, while_pos):
                            table <- struct_pattern_unbound_expression(condition, wanted, table)
                            table <- struct_pattern_unbound_statements(while_body, wanted, table)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            table <- struct_pattern_unbound_statements(block_body, wanted, table)
                        _:
                            pass

        # Check one arm's pattern against the scrutinee's known struct type, recursing
        # through `Or`/`As` wrappers (parity is checked per leaf struct pattern).
        def check_struct_pattern_arm(pattern: Ast::Pattern, scrutinee_struct: sview, line: u32, arm_pos: Ast::Pos, unbound: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Struct(struct_path, struct_fields):
                        if struct_path != "" and struct_path != scrutinee_struct and is_registered_struct(table, struct_path):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructPatternTypeMismatch, name: scrutinee_struct, line: line, pos: arm_pos, expected: struct_path, actual: ""})
                            # The pattern binds nothing once its type is rejected, so every
                            # REFERENCE to one of these names in the arm body is undefined.
                            # The caller owns that walk: it is the one holding the body.
                            pattern_bound_names(pattern, unbound)
                        for struct_field in struct_fields |table, unbound| -> table:
                            table <- check_struct_pattern_arm(struct_field, scrutinee_struct, line, arm_pos, unbound, table)
                    Pattern.Field(selector, inner):
                        for inner_pattern in inner |table, unbound| -> table:
                            table <- check_struct_pattern_arm(inner_pattern, scrutinee_struct, line, arm_pos, unbound, table)
                    Pattern.Or(options):
                        for option in options |table|:
                            table <- check_struct_pattern_arm(option, scrutinee_struct, line, arm_pos, unbound, table)
                    Pattern.As(as_name, as_inner):
                        for inner_pattern in as_inner |table|:
                            table <- check_struct_pattern_arm(inner_pattern, scrutinee_struct, line, arm_pos, unbound, table)
                    _:
                        pass

        # Check a match's arms once the scrutinee is confirmed a registered struct.
        def check_struct_pattern_arms(scrutinee_struct: sview, arms: darray[Ast::MatchArm], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                before: usize = table.diagnostics.count
                for arm in arms |table|:
                    # The arm's own line; a desugared arm has none and keeps the match's.
                    arm_unbound: mutable darray[sview] = []
                    table <- check_struct_pattern_arm(arm.pattern, scrutinee_struct, line if arm.pos.line == 0 else arm.pos.line, arm.pos, arm_unbound, table)
                    table <- struct_pattern_unbound_statements(arm.body, arm_unbound, table)
                # stage0 companion: the mismatched arm's body types <invalid>, so the
                # match expression additionally reports arm incompatibility against
                # another arm's firm literal family.
                if table.diagnostics.count > before:
                    other_family: mutable sview = ""
                    # stage0 reports this companion at the ARM whose value gives the firm
                    # family, not at the `match` head — it is that arm the mismatched one is
                    # incompatible WITH.
                    other_line: mutable u32 = 0
                    other_pos: mutable Ast::Pos = zeroed
                    for arm in arms |other_family, other_line, other_pos|:
                        continue if arm.body.count != 1
                        match arm.body[0]:
                            Stmt.Expr(arm_value, arm_value_line):
                                if other_family == "":
                                    arm_family: sview = literal_kind_of(arm_value)
                                    other_line <- arm_value_line.line if arm_family != ""
                                    # stage0 spans that arm's HEAD token. Take it only when it
                                    # sits on the line being reported; a span borrowed from
                                    # another line would point at the wrong text.
                                    other_pos <- arm.pos if arm_family != "" and arm.pos.line == arm_value_line.line
                                    other_family <- arm_family
                            _:
                                pass
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MatchArmsIncompatible, name: "", line: line if other_line == 0 else other_line, pos: other_pos, expected: "", actual: other_family}) if other_family != ""

        # If `scrutinee` infers to a firmly-known registered struct type, check the match's
        # arms for a struct pattern naming a different registered struct.
        def check_struct_pattern_match(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], line: u32, var_types: darray[sview]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                scrutinee_type: InferType = infer_expression_type(scrutinee, var_types, type_names, table)
                return if scrutinee_type.kind != SemTypeKind.Named
                return if not is_registered_struct(table, scrutinee_type.name)
                table <- check_struct_pattern_arms(scrutinee_type.name, arms, line, table)

        # Walk through expressions, checking for struct-pattern type mismatches.
        def walk_expression_for_struct_pattern_type_mismatch(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(left, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(object, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(low, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_struct_pattern_type_mismatch(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_struct_pattern_type_mismatch(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(iterable, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(condition, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_struct_pattern_type_mismatch(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_struct_pattern_type_mismatch(statements, table, var_types, type_names)
                        table <- walk_expression_for_struct_pattern_type_mismatch(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_struct_pattern_type_mismatch(scrutinee, table, var_types, type_names)
                        table <- check_struct_pattern_match(scrutinee, arms, line.line, var_types, type_names, table)
                        for arm in arms |table|:
                            table <- walk_statements_for_struct_pattern_type_mismatch(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for struct-pattern
        # type mismatches.
        def walk_statements_for_struct_pattern_type_mismatch(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_struct_pattern_type_mismatch(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(target, table, var_types, type_names)
                            table <- walk_expression_for_struct_pattern_type_mismatch(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_struct_pattern_type_mismatch(then_body, table, var_types, type_names)
                            table <- walk_statements_for_struct_pattern_type_mismatch(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(condition, table, var_types, type_names)
                            table <- walk_statements_for_struct_pattern_type_mismatch(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(iterable, table, var_types, type_names)
                            table <- walk_statements_for_struct_pattern_type_mismatch(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_struct_pattern_type_mismatch(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(scrutinee, table, var_types, type_names)
                            table <- check_struct_pattern_match(scrutinee, arms, line.line, var_types, type_names, table)
                            for arm in arms |table|:
                                table <- walk_expression_for_struct_pattern_type_mismatch(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_struct_pattern_type_mismatch(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_struct_pattern_type_mismatch(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_struct_pattern_type_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_struct_pattern_type_mismatch(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_struct_pattern_type_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_struct_pattern_type_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_struct_pattern_type_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_struct_pattern_type_mismatch_declarations(declarations, table)
