# Flow-shape lints (stage0 analyzer_flow_function / analyzer_flow_complexity, docs/121/125
# -Wflow). Runs under `# flow` (FlowLintMode 1) and `# flow-strict` (mode 2). A `can ComplexFlow:`
# block is the escape hatch — its body is exempt (in_complex_flow). Lints ported:
#  - Shadow-elif table: an if/elif chain of >= 3 arms all testing the same bare-ident scrutinee
#    for equality against int/char/string literals — a decision table; use `when`.
#  - Nesting budget (R1): a loop body whose conditional nesting exceeds 3 levels — a decision
#    tree hiding a state machine. `if`-chains/`match`/block-wrappers collapse; nested loops reset;
#    an `if true:` scoped-loop wrapper is transparent.
# SOUND syntactic subsets: enum-tag literals + field-path scrutinees are sound misses.
extend Semantic:
    private:
        def flow_line_seen(seen: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                return any seen_line in seen where seen_line == line

        def flow_is_literal(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(value):
                        return true
                    Expr.CharLit(text):
                        return true
                    Expr.StringLit(text):
                        return true
                    _:
                        return false

        def flow_is_const_true(condition: Ast::Expr) -> bool:
            can Abort.Panic:
                match condition:
                    Expr.BoolLit(value):
                        return value
                    Expr.Ident(name, line):
                        return name == "true"
                    Expr.Paren(inner, paren_line):
                        return flow_is_const_true(inner)
                    _:
                        return false

        def flow_clause_grants_complex_flow(clause: darray[sview]&) -> bool:
            can Abort.Panic:
                return any grant in clause where grant == "ComplexFlow"

        # The bare-identifier scrutinee a condition tests for equality against a literal, for
        # `X == LIT` / `LIT == X` and or-chains `X == L1 or X == L2` over one X; "" otherwise.
        def flow_equality_scrutinee(condition: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, paren_line):
                        return flow_equality_scrutinee(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.EqEq:
                            left_lit: bool = flow_is_literal(left)
                            right_lit: bool = flow_is_literal(right)
                            return ident_name_of(left) if right_lit and not left_lit else (ident_name_of(right) if left_lit and not right_lit else sview("", 0, 0))
                        if operator == TokenKind.Or:
                            left_scrutinee: sview = flow_equality_scrutinee(left)
                            return left_scrutinee if left_scrutinee != "" and left_scrutinee == flow_equality_scrutinee(right) else sview("", 0, 0)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def flow_elif_chain(condition: Ast::Expr, else_body: darray[Ast::Stmt], head_line: u32, member_lines: mutable darray[u32]&) -> (length: usize, scrutinee: sview):
            can Memory.Allocate, Abort.Panic:
                scrutinee: sview = flow_equality_scrutinee(condition)
                (0, sview("", 0, 0)) return if scrutinee == ""
                length: mutable usize = 1
                member_lines.push(head_line)
                current_else: mutable darray[Ast::Stmt] = []
                current_else.extend(else_body)
                while continuing |continuing: bool = true, length, current_else, member_lines|:
                    continuing <- false
                    if current_else.count == 1:
                        match current_else[0]:
                            Stmt.If(next_condition, next_then, next_else, next_line):
                                next_scrutinee: sview = flow_equality_scrutinee(next_condition)
                                if next_scrutinee == scrutinee:
                                    length <- length + 1
                                    member_lines.push(next_line)
                                    next_else_copy: mutable darray[Ast::Stmt] = []
                                    next_else_copy.extend(next_else)
                                    current_else <- next_else_copy
                                    continuing <- true
                            _:
                                pass
                return (length, scrutinee)

        # (is_bool, value) of a boolean-literal expression (`true`/`false`), through parens.
        def flow_bool_literal(expression: Ast::Expr) -> (is_bool: bool, value: bool):
            can Abort.Panic:
                match expression:
                    Expr.BoolLit(value):
                        return (true, value)
                    Expr.Ident(name, line):
                        return (name == "true" or name == "false", name == "true")
                    Expr.Paren(inner, paren_line):
                        return flow_bool_literal(inner)
                    _:
                        return (false, false)

        # Whether NAME is tested as a bare boolean or against a bool literal in any if/while
        # condition of a statement list (the boolTests signal for a flag).
        def flow_name_bool_compared(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            true return if flow_condition_tests_bool(condition, name)
                            true return if flow_name_bool_compared(then_body, name)
                            true return if flow_name_bool_compared(else_body, name)
                        Stmt.While(condition, body, line):
                            true return if flow_condition_tests_bool(condition, name)
                            true return if flow_name_bool_compared(body, name)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if flow_name_bool_compared(body, name)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if flow_name_bool_compared(body, name)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if flow_name_bool_compared(arm.body, name)
                        _:
                            pass
                return false

        def flow_condition_tests_bool(condition: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Ident(ident_name, line):
                        return ident_name == name
                    Expr.Paren(inner, paren_line):
                        return flow_condition_tests_bool(inner, name)
                    Expr.Unary(operator, operand, unary_line):
                        return flow_condition_tests_bool(operand, name)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.EqEq or operator == TokenKind.BangEq:
                            left_bool: (is_bool: bool, value: bool) = flow_bool_literal(right)
                            right_bool: (is_bool: bool, value: bool) = flow_bool_literal(left)
                            true return if ident_name_of(left) == name and left_bool.is_bool
                            true return if ident_name_of(right) == name and right_bool.is_bool
                            return false
                        return flow_condition_tests_bool(left, name) or flow_condition_tests_bool(right, name)
                    _:
                        return false

        # Whether an arm body DIRECTLY (top-level, not nested) assigns NAME a bool literal, and
        # which values it wrote — records into acc[0] (assigning-arm count), acc[1] (saw true),
        # acc[2] (saw false).
        def flow_arm_bool_assign(body: darray[Ast::Stmt], name: sview, acc: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                assigns: mutable bool = false
                for statement in body |assigns, acc|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            if ident_name_of(target) == name:
                                literal: (is_bool: bool, value: bool) = flow_bool_literal(value)
                                assigns <- true if literal.is_bool
                                acc[1] <- 1 if literal.is_bool and literal.value
                                acc[2] <- 1 if literal.is_bool and not literal.value
                        _:
                            pass
                acc[0] <- acc[0] + 1 if assigns

        # Accumulate assigning-arm count + true/false-value presence for NAME across every
        # if-branch body in a statement list (recursively). acc = [arm_count, saw_true, saw_false].
        def flow_accumulate_flag_arms(statements: darray[Ast::Stmt], name: sview, acc: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |acc|:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            flow_arm_bool_assign(then_body, name, acc)
                            flow_arm_bool_assign(else_body, name, acc)
                            flow_accumulate_flag_arms(then_body, name, acc)
                            flow_accumulate_flag_arms(else_body, name, acc)
                        Stmt.While(condition, body, line):
                            flow_accumulate_flag_arms(body, name, acc)
                        Stmt.For(bind, variables, iterable, body, line):
                            flow_accumulate_flag_arms(body, name, acc)
                        Stmt.Block(kind, clause, binding, body, line):
                            flow_accumulate_flag_arms(body, name, acc)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |acc|:
                                flow_accumulate_flag_arms(arm.body, name, acc)
                        _:
                            pass

        # State-flag check (R2, bool subset): a loop-carried capture set to BOTH `true` and
        # `false` across >= 2 distinct branch arms and tested as a bool is a 2-state machine.
        def flow_state_flag_check(loop_body: darray[Ast::Stmt], captures: darray[sview], loop_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for capture in captures |table| -> table:
                    acc: mutable darray[u32] = [0, 0, 0]
                    flow_accumulate_flag_arms(loop_body, capture, acc)
                    flagged: bool = acc[0] >= 2 and acc[1] == 1 and acc[2] == 1 and flow_name_bool_compared(loop_body, capture)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowStateFlag, name: capture, line: loop_line, expected: "", actual: ""}) if flagged

        # R5 progress helpers ---------------------------------------------------------------
        # Whether an expression performs a call (Call/Move/Paren-wrapped call).
        def flow_expr_performs_call(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return true
                    Expr.Move(operand, line):
                        return flow_expr_performs_call(operand)
                    Expr.Paren(inner, line):
                        return flow_expr_performs_call(inner)
                    _:
                        return false

        # An assignment, exit, or call-bearing statement is progress.
        def flow_is_progress_stmt(statement: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Assign(target, operator, value, line):
                        return true
                    Stmt.Return(value, line):
                        return true
                    Stmt.Break(label, line):
                        return true
                    Stmt.Continue(label, line):
                        return true
                    Stmt.Expr(expression, line):
                        return flow_expr_performs_call(expression)
                    Stmt.VarDecl(name, type_expression, value, line):
                        return flow_expr_performs_call(value)
                    _:
                        return false

        # Whether a statement list makes progress on some path: any assign/call/exit, a nested
        # loop, or progress inside any branch.
        def flow_stmts_make_progress(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    true return if flow_is_progress_stmt(statement)
                    match statement:
                        Stmt.While(condition, body, line):
                            return true
                        Stmt.For(bind, variables, iterable, body, line):
                            return true
                        Stmt.If(condition, then_body, else_body, line):
                            true return if flow_stmts_make_progress(then_body)
                            true return if flow_stmts_make_progress(else_body)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if flow_stmts_make_progress(arm.body)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if flow_stmts_make_progress(body)
                        _:
                            pass
                return false

        # Whether a top-level statement makes UNCONDITIONAL progress: assign to a carried name,
        # an exit, or a bare call (a plain read `c = f()` VarDecl does NOT — it does not advance).
        def flow_is_unconditional_progress(statement: Ast::Stmt, carried: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Assign(target, operator, value, line):
                        return any name in carried where name == target_root_ident(target)
                    Stmt.Return(value, line):
                        return true
                    Stmt.Break(label, line):
                        return true
                    Stmt.Continue(label, line):
                        return true
                    Stmt.Expr(expression, line):
                        return flow_expr_performs_call(expression)
                    _:
                        return false

        def flow_has_direct_progress(statements: darray[Ast::Stmt], carried: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any statement in statements where flow_is_unconditional_progress(statement, carried)

        # Whether any expression is a call whose RECEIVER is a carried name (`carried.method(...)`)
        # — the erasure-proof marker of a thread-slot loop.
        def flow_expr_call_on_names(expression: Ast::Expr, names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                true return if any name in names where name == ident_name_of(object)
                            _:
                                pass
                        true return if flow_expr_call_on_names(callee, names)
                        return any argument in arguments where flow_expr_call_on_names(argument, names)
                    Expr.Field(object, field, field_line):
                        return flow_expr_call_on_names(object, names)
                    Expr.Binary(left, operator, right, binary_line):
                        return flow_expr_call_on_names(left, names) or flow_expr_call_on_names(right, names)
                    Expr.Unary(operator, operand, unary_line):
                        return flow_expr_call_on_names(operand, names)
                    Expr.Paren(inner, paren_line):
                        return flow_expr_call_on_names(inner, names)
                    Expr.Index(object, index, index_line):
                        return flow_expr_call_on_names(object, names) or flow_expr_call_on_names(index, names)
                    _:
                        return false

        def flow_stmts_call_on_carried(statements: darray[Ast::Stmt], names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if flow_expr_call_on_names(expression, names)
                        Stmt.Assign(target, operator, value, line):
                            true return if flow_expr_call_on_names(value, names) or flow_expr_call_on_names(target, names)
                        Stmt.VarDecl(decl_name, decl_type, decl_value, decl_line):
                            true return if flow_expr_call_on_names(decl_value, names)
                        Stmt.Return(value, line):
                            if value is returned:
                                true return if flow_expr_call_on_names(returned, names)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if flow_expr_call_on_names(condition, names)
                            true return if flow_stmts_call_on_carried(then_body, names)
                            true return if flow_stmts_call_on_carried(else_body, names)
                        Stmt.While(condition, body, line):
                            true return if flow_expr_call_on_names(condition, names)
                            true return if flow_stmts_call_on_carried(body, names)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if flow_stmts_call_on_carried(body, names)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if flow_stmts_call_on_carried(body, names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if flow_stmts_call_on_carried(arm.body, names)
                        _:
                            pass
                return false

        # R5: an inert branch arm (no progress on any path) in a while whose loop as a whole isn't a
        # threaded-cursor loop and has no unconditional top-level progress.
        def flow_progress_check(loop_body: darray[Ast::Stmt], carried: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if flow_stmts_call_on_carried(loop_body, carried)
                return if flow_has_direct_progress(loop_body, carried)
                for statement in loop_body |table| -> table:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowProgress, name: "", line: line, expected: "", actual: ""}) if not flow_stmts_make_progress(then_body)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowProgress, name: "", line: line, expected: "", actual: ""}) if else_body.count > 0 and not flow_stmts_make_progress(else_body)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowProgress, name: "", line: line, expected: "", actual: ""}) if not flow_stmts_make_progress(arm.body)
                        _:
                            pass

        # The structural shape of a returned value as (category, int_value, name). Categories:
        # 1=ctor call, 2=int literal (value distinguishes -1 vs 0), 3=bool, 4=char, 5=binding
        # (all idents collapse), 8=other. Two returns share a shape iff same category and, for
        # ctor/char, same name; for int, same value.
        def flow_return_shape(value: Ast::Expr) -> (category: u8, int_value: i64, name: sview):
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, paren_line):
                        return flow_return_shape(inner)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        head: sview = ident_name_of(callee)
                        return (1, 0, head if head != "" else sview("__call", 0, 0))
                    Expr.IntLit(literal_value):
                        return (2, literal_value, sview("", 0, 0))
                    Expr.BoolLit(bool_value):
                        return (3, 1 if bool_value else 0, sview("", 0, 0))
                    Expr.CharLit(text):
                        return (4, 0, text)
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Minus:
                            match operand:
                                Expr.IntLit(neg_value):
                                    return (2, 0 - neg_value, sview("", 0, 0))
                                _:
                                    return (8, 0, sview("", 0, 0))
                        return (8, 0, sview("", 0, 0))
                    Expr.Ident(ident_name, ident_line):
                        return (5, 0, sview("", 0, 0))
                    _:
                        return (8, 0, sview("", 0, 0))

        def flow_shape_present(categories: darray[u8]&, int_values: darray[i64]&, names: darray[sview]&, category: u8, int_value: i64, name: sview) -> bool:
            can Abort.Panic:
                while probe < categories.count |probe: usize = 0|:
                    same: bool = categories[probe] == category and (category != 2 or int_values[probe] == int_value) and ((category != 1 and category != 4) or names[probe] == name)
                    true return if same
                    probe <- probe + 1
                return false

        def flow_add_shape(categories: mutable darray[u8]&, int_values: mutable darray[i64]&, names: mutable darray[sview]&, category: u8, int_value: i64, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if flow_shape_present(categories, int_values, names, category, int_value, name)
                categories.push(category)
                int_values.push(int_value)
                names.push(name)

        # Collect the distinct exit shapes of a loop body (break + return shapes). Recurses through
        # if/match/block but NOT nested loops (their breaks are their own; returns there undercount).
        def flow_collect_exits(statements: darray[Ast::Stmt], categories: mutable darray[u8]&, int_values: mutable darray[i64]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |categories, int_values, names|:
                    match statement:
                        Stmt.Break(label, line):
                            flow_add_shape(categories, int_values, names, 0, 0, sview("", 0, 0))
                        Stmt.Return(value, line):
                            if value is returned:
                                shape: (category: u8, int_value: i64, name: sview) = flow_return_shape(returned)
                                flow_add_shape(categories, int_values, names, shape.category, shape.int_value, shape.name)
                            else:
                                flow_add_shape(categories, int_values, names, 7, 0, sview("", 0, 0))
                        Stmt.If(condition, then_body, else_body, line):
                            flow_collect_exits(then_body, categories, int_values, names)
                            flow_collect_exits(else_body, categories, int_values, names)
                        Stmt.Block(kind, clause, binding, body, line):
                            flow_collect_exits(body, categories, int_values, names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |categories, int_values, names|:
                                flow_collect_exits(arm.body, categories, int_values, names)
                        _:
                            pass

        def flow_exit_budget_check(loop_body: darray[Ast::Stmt], loop_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                categories: mutable darray[u8] = []
                int_values: mutable darray[i64] = []
                names: mutable darray[sview] = []
                flow_collect_exits(loop_body, categories, int_values, names)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowExitBudget, name: "", line: loop_line, expected: "", actual: ""}) if categories.count > 2

        # Whether a block's last statement unconditionally diverts control (return/break/continue).
        def flow_body_ends_in_exit(body: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                false return if body.count == 0
                match body[body.count - 1]:
                    Stmt.Return(value, line):
                        return true
                    Stmt.Break(label, line):
                        return true
                    Stmt.Continue(label, line):
                        return true
                    _:
                        return false

        # Whether NAME is assigned anywhere in a statement list (any depth).
        def flow_body_assigns_name(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            true return if target_root_ident(target) == name
                        Stmt.If(condition, then_body, else_body, line):
                            true return if flow_body_assigns_name(then_body, name)
                            true return if flow_body_assigns_name(else_body, name)
                        Stmt.While(condition, body, line):
                            true return if flow_body_assigns_name(body, name)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if flow_body_assigns_name(body, name)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if flow_body_assigns_name(body, name)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if flow_body_assigns_name(arm.body, name)
                        _:
                            pass
                return false

        # An arm body mutates NAME and falls through (does not end in an exit).
        def flow_arm_mutates_and_falls_through(body: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if flow_body_ends_in_exit(body)
                return flow_body_assigns_name(body, name)

        # Whether any arm of an if/elif/else chain mutates NAME and falls through. The elif chain
        # is `else_body == [If]`; each nested then is an arm, the final else is the tail arm.
        def flow_if_has_fallthrough_mutation(then_body: darray[Ast::Stmt], else_body: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if flow_arm_mutates_and_falls_through(then_body, name)
                scan_else: mutable darray[Ast::Stmt] = []
                scan_else.extend(else_body)
                while scanning |scanning: bool = true, scan_else|:
                    scanning <- false
                    if scan_else.count == 1:
                        match scan_else[0]:
                            Stmt.If(elif_condition, elif_then, elif_else, elif_line):
                                true return if flow_arm_mutates_and_falls_through(elif_then, name)
                                next_else: mutable darray[Ast::Stmt] = []
                                next_else.extend(elif_else)
                                scan_else <- next_else
                                scanning <- true
                            _:
                                pass
                return flow_arm_mutates_and_falls_through(scan_else, name)

        # R6: count top-level sequential branches that conditionally mutate NAME and fall through.
        def flow_sequential_branch_mutations(loop_body: darray[Ast::Stmt], name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                count: mutable usize = 0
                for statement in loop_body |count|:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            count <- count + 1 if flow_if_has_fallthrough_mutation(then_body, else_body, name)
                        _:
                            pass
                return count

        def flow_single_mutation_check(loop_body: darray[Ast::Stmt], carried: darray[sview], loop_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for capture in carried |table| -> table:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowSingleMutation, name: capture, line: loop_line, expected: "", actual: ""}) if flow_sequential_branch_mutations(loop_body, capture) >= 2

        # The probed value of an `X is PATTERN` condition (ident_name_of(X)), or "" if the
        # condition is not an is-probe.
        def flow_probe_value(condition: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, paren_line):
                        return flow_probe_value(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        return ident_name_of(left) if operator == TokenKind.Is else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Collect the bare-identifier binding names introduced by an `is`-pattern RHS
        # (`Foo(a, Bar(b))` binds a, b); literals/wildcards bind nothing.
        def flow_collect_is_binds(pattern: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Expr.Ident(name, line):
                        out.push(name) if name != "_" and name != ""
                    Expr.Paren(inner, paren_line):
                        flow_collect_is_binds(inner, out)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |out|:
                            flow_collect_is_binds(argument, out)
                    Expr.Construct(type_expression, fields, construct_line):
                        for field in fields |out|:
                            flow_collect_is_binds(field.value, out)
                    _:
                        pass

        # Nested-is-probe depth of an if whose condition is `X is PATTERN`: 1 + the deepest
        # nested `if Y is PATTERN2:` in its then-body where Y is a name the outer pattern bound.
        def flow_probe_depth(condition: Ast::Expr, then_body: darray[Ast::Stmt], head_line: u32, member_lines: mutable darray[u32]&) -> usize:
            can Memory.Allocate, Abort.Panic:
                0 return if flow_probe_value(condition) == ""
                member_lines.push(head_line)
                binds: mutable darray[sview] = []
                match condition:
                    Expr.Binary(left, operator, right, binary_line):
                        flow_collect_is_binds(right, binds)
                    _:
                        pass
                best: mutable usize = 0
                for statement in then_body |best, member_lines|:
                    match statement:
                        Stmt.If(inner_condition, inner_then, inner_else, inner_line):
                            inner_probed: sview = flow_probe_value(inner_condition)
                            if inner_probed != "" and (any bind in binds where bind == inner_probed):
                                d: usize = flow_probe_depth(inner_condition, inner_then, inner_line, member_lines)
                                best <- d if d > best
                        _:
                            pass
                return 1 + best

        # Maximum conditional-nesting depth of a statement list. An if-chain/`match` collapses to
        # one level plus its deepest body; block wrappers and `if true:` are transparent; nested
        # loops reset to 0.
        def flow_block_depth(statements: darray[Ast::Stmt]) -> usize:
            can Memory.Allocate, Abort.Panic:
                deepest: mutable usize = 0
                for statement in statements |deepest|:
                    d: usize = flow_stmt_depth(statement)
                    deepest <- d if d > deepest
                return deepest

        def flow_stmt_depth(statement: Ast::Stmt) -> usize:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.If(condition, then_body, else_body, line):
                        if flow_is_const_true(condition):
                            then_depth: usize = flow_block_depth(then_body)
                            else_depth: usize = flow_block_depth(else_body)
                            return then_depth if then_depth > else_depth else else_depth
                        inner: mutable usize = flow_block_depth(then_body)
                        current_else: mutable darray[Ast::Stmt] = []
                        current_else.extend(else_body)
                        while continuing |continuing: bool = true, inner, current_else|:
                            continuing <- false
                            if current_else.count == 1:
                                match current_else[0]:
                                    Stmt.If(chain_condition, chain_then, chain_else, chain_line):
                                        chain_then_depth: usize = flow_block_depth(chain_then)
                                        inner <- chain_then_depth if chain_then_depth > inner
                                        chain_else_copy: mutable darray[Ast::Stmt] = []
                                        chain_else_copy.extend(chain_else)
                                        current_else <- chain_else_copy
                                        continuing <- true
                                    _:
                                        pass
                        tail_depth: usize = flow_block_depth(current_else)
                        inner <- tail_depth if tail_depth > inner
                        return 1 + inner
                    Stmt.Match(scrutinee, arms, line):
                        deepest_arm: mutable usize = 0
                        for arm in arms |deepest_arm|:
                            d: usize = flow_block_depth(arm.body)
                            deepest_arm <- d if d > deepest_arm
                        return deepest_arm
                    Stmt.Block(kind, clause, binding, body, line):
                        return flow_block_depth(body)
                    Stmt.Expr(expression, line):
                        # A scoped-loop header desugars to `Stmt.Expr(Expr.Block([decls, loop]))`;
                        # the value-block wrapper is transparent to nesting.
                        match expression:
                            Expr.Block(block_statements, value, captures, block_line):
                                return flow_block_depth(block_statements)
                            _:
                                return 0
                    _:
                        return 0

        def flow_shapes_walk(statements: darray[Ast::Stmt], in_complex_flow: bool, seen: mutable darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |seen, table| -> table:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            if not in_complex_flow and not flow_line_seen(seen, line):
                                member_lines: mutable darray[u32] = []
                                chain: (length: usize, scrutinee: sview) = flow_elif_chain(condition, else_body, line, member_lines)
                                for member_line in member_lines |seen|:
                                    seen.push(member_line)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowElifLadder, name: chain.scrutinee, line: line, expected: "", actual: "", expected_count: chain.length.u32()}) if chain.length >= 3
                                probe_lines: mutable darray[u32] = []
                                probe_depth: usize = flow_probe_depth(condition, then_body, line, probe_lines)
                                for probe_line in probe_lines |seen|:
                                    seen.push(probe_line)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowRetestLadder, name: "", line: line, expected: "", actual: "", expected_count: probe_depth.u32()}) if probe_depth >= 3
                            table <- flow_shapes_walk(then_body, in_complex_flow, seen, table)
                            table <- flow_shapes_walk(else_body, in_complex_flow, seen, table)
                        Stmt.While(condition, body, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowNestingDepth, name: "", line: line, expected: "", actual: ""}) if not in_complex_flow and flow_block_depth(body) > 3
                            table <- flow_exit_budget_check(body, line, table) if not in_complex_flow
                            table <- flow_shapes_walk(body, in_complex_flow, seen, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlowNestingDepth, name: "", line: line, expected: "", actual: ""}) if not in_complex_flow and flow_block_depth(body) > 3
                            table <- flow_exit_budget_check(body, line, table) if not in_complex_flow
                            table <- flow_shapes_walk(body, in_complex_flow, seen, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_complex_flow: bool = in_complex_flow or (kind == "can" and flow_clause_grants_complex_flow(clause))
                            table <- flow_shapes_walk(body, block_complex_flow, seen, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |seen, table| -> table:
                                table <- flow_shapes_walk(arm.body, in_complex_flow, seen, table)
                        Stmt.Expr(expression, line):
                            # Descend into a scoped-loop header wrapper `Stmt.Expr(Expr.Block([...]))`
                            # so the loop/ladders inside a value block are still checked, and run the
                            # state-flag check over the loop body using the header captures.
                            match expression:
                                Expr.Block(block_statements, value, captures, block_line):
                                    # Loop-carried names = bare captures PLUS accumulator decls
                                    # (`|acc = init|` desugars to a VarDecl before the loop).
                                    carried_names: mutable darray[sview] = []
                                    carried_names.extend(captures)
                                    for block_statement in block_statements |carried_names|:
                                        match block_statement:
                                            Stmt.VarDecl(decl_name, decl_type, decl_value, decl_line):
                                                carried_names.push(decl_name)
                                            _:
                                                pass
                                    for block_statement in block_statements |table| -> table:
                                        match block_statement:
                                            Stmt.While(loop_condition, loop_body, loop_line):
                                                table <- flow_state_flag_check(loop_body, carried_names, loop_line, table) if not in_complex_flow
                                                table <- flow_single_mutation_check(loop_body, carried_names, loop_line, table) if not in_complex_flow
                                                table <- flow_progress_check(loop_body, carried_names, table) if not in_complex_flow
                                            Stmt.For(loop_bind, loop_variables, loop_iterable, loop_body, loop_line):
                                                table <- flow_state_flag_check(loop_body, carried_names, loop_line, table) if not in_complex_flow
                                                table <- flow_single_mutation_check(loop_body, carried_names, loop_line, table) if not in_complex_flow
                                            _:
                                                pass
                                    table <- flow_shapes_walk(block_statements, in_complex_flow, seen, table)
                                _:
                                    pass
                        _:
                            pass

        def check_flow_shapes(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            seen: mutable darray[u32] = []
                            table <- flow_shapes_walk(body, false, seen, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_flow_shapes(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_flow_shapes(scoped_body, table)
                        _:
                            pass
