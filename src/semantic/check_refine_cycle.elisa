# Recursive / mutually-recursive refine-alias detection (docs/80). A `refine A = B where …`
# names A as a refinement of base B. When the base chain cycles back — `refine A = A`,
# `refine A = B; refine B = A`, or a longer loop — the alias has no well-founded base and
# stage0 rejects it ("refine alias X has a recursive or mutually-recursive base"). Purely
# structural: collect each alias's base ident and follow the chain to a repeat.
extend Semantic:
    private:
        # The base type NAME an alias target resolves to: unwrap the `where`-refinement and
        # any generic application / parens down to the head identifier.
        def alias_base_ident(target: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Refinement(base, predicate, line):
                        return alias_base_ident(base)
                    Expr.Paren(inner, paren_line):
                        return alias_base_ident(inner)
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Index(object, index, index_line):
                        return alias_base_ident(object)
                    Expr.IndexN(object_n, arguments_n, indexn_line):
                        return alias_base_ident(object_n)
                    _:
                        return sview("", 0, 0)

        def collect_aliases(declarations: darray[Ast::Decl], alias_names: mutable darray[sview]&, alias_bases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Alias(name, target, line):
                            alias_names.push(name)
                            alias_bases.push(alias_base_ident(target))
                        Decl.Module(module_name, module_body, module_line):
                            collect_aliases(module_body, alias_names, alias_bases)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_aliases(scoped_body, alias_names, alias_bases)
                        _:
                            pass

        # The base ident of alias NAME, or "" when NAME is not a registered alias (the chain
        # ends at a concrete type).
        def alias_base_of(name: sview, alias_names: darray[sview]&, alias_bases: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                while probe < alias_names.count |probe: usize = 0|:
                    alias_bases[probe] return if alias_names[probe] == name
                    probe <- probe + 1
                return sview("", 0, 0)

        # Whether following START's base chain returns to START (a cycle). Bounded by the
        # alias count so a non-START loop terminates without revisiting START.
        def alias_chain_cycles(start: sview, alias_names: darray[sview]&, alias_bases: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                current: mutable sview = alias_base_of(start, alias_names, alias_bases)
                bound: usize = alias_names.count + 1
                while step < bound |step: usize = 0, current|:
                    false return if current == ""
                    true return if current == start
                    current <- alias_base_of(current, alias_names, alias_bases)
                    step <- step + 1
                return false

        def check_refine_cycle_walk(declarations: darray[Ast::Decl], alias_names: darray[sview]&, alias_bases: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Alias(name, target, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasCycle, name: name, line: line, expected: "", actual: ""}) if alias_chain_cycles(name, alias_names, alias_bases)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_refine_cycle_walk(module_body, alias_names, alias_bases, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_refine_cycle_walk(scoped_body, alias_names, alias_bases, table)
                        _:
                            pass

        def check_refine_cycle(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_bases: mutable darray[sview] = []
                collect_aliases(declarations, alias_names, alias_bases)
                table <- check_refine_cycle_walk(declarations, alias_names, alias_bases, table)
