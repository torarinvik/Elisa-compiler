# Recursive / mutually-recursive refine-alias detection (docs/80). A `refine A = B where …`
# names A as a refinement of base B. When the base chain cycles back — `refine A = A`,
# `refine A = B; refine B = A`, or a longer loop — the alias has no well-founded base.
#
# stage0 resolves a refine alias ON DEMAND, from a BINDER that uses it
# (`resolveRefineAliasFully`), never from the declaration. Four consequences, all measured
# against the oracle rather than assumed:
#   * A cyclic alias NOBODY USES draws nothing at all. Reporting per declaration, as this
#     check used to, invented a diagnostic stage0 does not have.
#   * The cycle is reported ONCE however many binders use it, at the alias holding the BACK
#     EDGE, naming the alias the chain re-entered: for `refine A = B; refine B = A` that is
#     `refine alias "B" … (cycle through "A")`, on B's line — not one report per member.
#   * The bail-out hands back the back edge's base UNRESOLVED, so that base is then resolved
#     as an ordinary type and draws the binder-position error on the same line.
#   * Every predicate gathered along the chain is then analysed with `self` typed invalid,
#     giving one "comparison requires numeric operands" per ORDERING comparison over `self`.
#     `==` is silent (stage0 compares an invalid for equality without complaint), and a
#     comparison that never mentions `self` — `where 0 < 1` — is fine.
# Only REFINE aliases take part: a plain `alias A = B; alias B = A` cycle is stage0's
# "unknown type", a different diagnostic from a different check.
extend Semantic:
    private:
        # The base type NAME an alias target resolves to: unwrap the `where`-refinement and
        # any generic application / parens down to the head identifier.
        def alias_base_ident(target: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Refinement(base, predicate, line):
                        return alias_base_ident(base)
                    Expr.Paren(inner, paren_line):
                        return alias_base_ident(inner)
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Index(object, index, index_line):
                        return alias_base_ident(object)
                    Expr.IndexN(object_n, arguments_n, indexn_line):
                        return alias_base_ident(object_n)
                    _:
                        return sview("", 0, 0)

        # Whether an alias target carries a `where` predicate -- i.e. whether the
        # declaration is `refine X = T where P` and not a plain `alias X = T`.
        def alias_has_refinement(target: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Refinement(base, predicate, line):
                        return true
                    Expr.Paren(inner, paren_line):
                        return alias_has_refinement(inner)
                    _:
                        return false

        # Does this predicate sub-expression read the refinement subject? The subject is what
        # types as invalid once the chain is cut, so only a comparison that reaches it draws
        # the operand diagnostic.
        def refine_mentions_self(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return name == "self"
                    Expr.Field(object, field, field_line):
                        return refine_mentions_self(object)
                    Expr.Index(indexed_object, index_expression, index_line):
                        return refine_mentions_self(indexed_object) or refine_mentions_self(index_expression)
                    Expr.Paren(inner, paren_line):
                        return refine_mentions_self(inner)
                    Expr.Unary(operator, operand, unary_line):
                        return refine_mentions_self(operand)
                    Expr.Binary(left, operator, right, binary_line):
                        return refine_mentions_self(left) or refine_mentions_self(right)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return any argument in arguments where refine_mentions_self(argument)
                    _:
                        return false

        # Record (owning alias, line) for every ordering comparison over `self` in a
        # predicate. Flattened into two parallel rows rather than kept per alias: the
        # reporting loop wants them in declaration order anyway, which is stage0's order.
        def refine_ordering_rows(predicate: Ast::Expr, owner_index: usize, cmp_owner: mutable darray[usize]&, cmp_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Binary(left, operator, right, binary_line):
                        if poe_is_ordering(operator) and (refine_mentions_self(left) or refine_mentions_self(right)):
                            cmp_owner.push(owner_index)
                            cmp_lines.push(binary_line.line)
                        refine_ordering_rows(left, owner_index, cmp_owner, cmp_lines)
                        refine_ordering_rows(right, owner_index, cmp_owner, cmp_lines)
                    Expr.Unary(operator, operand, unary_line):
                        refine_ordering_rows(operand, owner_index, cmp_owner, cmp_lines)
                    Expr.Paren(inner, paren_line):
                        refine_ordering_rows(inner, owner_index, cmp_owner, cmp_lines)
                    _:
                        pass

        def alias_ordering_rows(target: Ast::Expr, owner_index: usize, cmp_owner: mutable darray[usize]&, cmp_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Refinement(base, predicate, refinement_line):
                        refine_ordering_rows(predicate, owner_index, cmp_owner, cmp_lines)
                    Expr.Paren(inner, paren_line):
                        alias_ordering_rows(inner, owner_index, cmp_owner, cmp_lines)
                    _:
                        pass

        def collect_refine_cycle_aliases(declarations: darray[Ast::Decl], alias_names: mutable darray[sview]&, alias_bases: mutable darray[sview]&, alias_lines: mutable darray[u32]&, cmp_owner: mutable darray[usize]&, cmp_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |alias_names, alias_bases, alias_lines, cmp_owner, cmp_lines|:
                    match declaration:
                        Decl.Alias(name, target, line):
                            if alias_has_refinement(target):
                                alias_ordering_rows(target, alias_names.count, cmp_owner, cmp_lines)
                                alias_names.push(name)
                                alias_bases.push(alias_base_ident(target))
                                alias_lines.push(line.line)
                        Decl.Module(module_name, module_body, module_line):
                            collect_refine_cycle_aliases(module_body, alias_names, alias_bases, alias_lines, cmp_owner, cmp_lines)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_refine_cycle_aliases(scoped_body, alias_names, alias_bases, alias_lines, cmp_owner, cmp_lines)
                        _:
                            pass

        # The row of alias NAME, or `alias_names.count` when NAME is not a refine alias --
        # which is how the chain walk learns it has reached a concrete type.
        def refine_alias_index(name: sview, alias_names: darray[sview]&) -> usize:
            can Memory.Allocate, Abort.Panic:
                while probe < alias_names.count |probe: usize = 0|:
                    probe return if alias_names[probe] == name
                    probe <- probe + 1
                return alias_names.count

        # Every refine alias named by a BINDER: a parameter type, a return type, or a local
        # declaration's type. These are the resolution entry points, and an alias reachable
        # from none of them is never resolved and never diagnosed.
        def refine_alias_binder_uses_body(statements: darray[Ast::Stmt], alias_names: darray[sview]&, used: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |alias_names, used|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            local_use: sview = type_mentions_refine_alias(type_expression, alias_names)
                            used.push(local_use) if local_use != ""
                        Stmt.If(condition, then_body, else_body, line):
                            refine_alias_binder_uses_body(then_body, alias_names, used)
                            refine_alias_binder_uses_body(else_body, alias_names, used)
                        Stmt.While(condition, while_body, while_line) | Stmt.For(_, _, _, while_body, while_line):
                            refine_alias_binder_uses_body(while_body, alias_names, used)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            refine_alias_binder_uses_body(body, alias_names, used)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |alias_names, used|:
                                refine_alias_binder_uses_body(arm.body, alias_names, used)
                        _:
                            pass

        def refine_alias_binder_uses(declarations: darray[Ast::Decl], alias_names: darray[sview]&, used: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |alias_names, used|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for parameter in parameters |alias_names, used|:
                                param_use: sview = type_mentions_refine_alias(parameter.type_expression, alias_names)
                                used.push(param_use) if param_use != ""
                            if return_type is return_type_expression:
                                return_use: sview = type_mentions_refine_alias(return_type_expression, alias_names)
                                used.push(return_use) if return_use != ""
                            refine_alias_binder_uses_body(body, alias_names, used)
                        Decl.Module(module_name, module_body, module_line):
                            refine_alias_binder_uses(module_body, alias_names, used)
                        Decl.Scoped(scoped_body, scoped_line):
                            refine_alias_binder_uses(scoped_body, alias_names, used)
                        _:
                            pass

        # Resolve ENTRY's base chain exactly as stage0 does, and report the moment it
        # re-enters an alias already on the chain. `reported` keeps a second binder over the
        # same cycle silent, which is what stage0's in-place binder rewrite achieves.
        def refine_cycle_report(entry: sview, alias_names: darray[sview]&, alias_bases: darray[sview]&, alias_lines: darray[u32]&, cmp_owner: darray[usize]&, cmp_lines: darray[u32]&, reported: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                entry_index: usize = refine_alias_index(entry, alias_names)
                return if entry_index >= alias_names.count
                return if reported[entry_index]
                visited: mutable darray[usize] = []
                visited.push(entry_index)
                current: mutable usize = entry_index
                closed: mutable bool = false
                back_edge: mutable usize = 0
                while step < alias_names.count |step: usize = 0, current, visited, closed, back_edge|:
                    base_index: usize = refine_alias_index(alias_bases[current], alias_names)
                    break if base_index >= alias_names.count
                    if any seen in visited where seen == base_index:
                        closed <- true
                        back_edge <- base_index
                        break
                    visited.push(base_index)
                    current <- base_index
                    step <- step + 1
                return if not closed
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasCycle, name: alias_names[current], line: alias_lines[current], expected: alias_names[back_edge], actual: ""})
                # The unresolved base the bail-out returns is then resolved as an ordinary
                # type, at the back edge's own line.
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasNonBinder, name: alias_names[back_edge], line: alias_lines[current], expected: "", actual: ""})
                while row < cmp_owner.count |row: usize = 0, visited, table| -> table:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrderingNonNumeric, name: "", line: cmp_lines[row], expected: "", actual: ""}) if any seen in visited where seen == cmp_owner[row]
                    row <- row + 1
                for seen in visited |reported|:
                    reported[seen] <- true

        def check_refine_cycle(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_bases: mutable darray[sview] = []
                alias_lines: mutable darray[u32] = []
                cmp_owner: mutable darray[usize] = []
                cmp_lines: mutable darray[u32] = []
                collect_refine_cycle_aliases(declarations, alias_names, alias_bases, alias_lines, cmp_owner, cmp_lines)
                return if alias_names.count == 0
                used: mutable darray[sview] = []
                refine_alias_binder_uses(declarations, alias_names, used)
                return if used.count == 0
                reported: mutable darray[bool] = []
                while filled < alias_names.count |filled: usize = 0, reported|:
                    reported.push(false)
                    filled <- filled + 1
                for entry in used |reported, table| -> table:
                    table <- refine_cycle_report(entry, alias_names, alias_bases, alias_lines, cmp_owner, cmp_lines, reported, table)
