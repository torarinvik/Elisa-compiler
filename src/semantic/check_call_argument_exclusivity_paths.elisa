# Pure path-overlap decision used by same-call reference exclusivity. Only
# sibling fields and distinct literal indices prove disjointness; a prefix,
# unknown index, or slice may still alias.
module CallArgumentExclusivityPaths:
    public:
        def path_span_valid(start: usize, count: usize, length: usize) -> bool:
            return false if start > length
            return count <= length - start

        def inputs_well_formed(kinds: darray[u8]&, names: darray[sview]&, values: darray[i64]&, a_start: usize, a_count: usize, b_start: usize, b_count: usize) -> bool:
            ensure result == (
                path_span_valid(a_start, a_count, kinds.count)
                and path_span_valid(a_start, a_count, names.count)
                and path_span_valid(a_start, a_count, values.count)
                and path_span_valid(b_start, b_count, kinds.count)
                and path_span_valid(b_start, b_count, names.count)
                and path_span_valid(b_start, b_count, values.count)
            )
            return (
                path_span_valid(a_start, a_count, kinds.count)
                and path_span_valid(a_start, a_count, names.count)
                and path_span_valid(a_start, a_count, values.count)
                and path_span_valid(b_start, b_count, kinds.count)
                and path_span_valid(b_start, b_count, names.count)
                and path_span_valid(b_start, b_count, values.count)
            )

        def steps_provably_disjoint(a_kind: u8, a_name: sview, a_value: i64, b_kind: u8, b_name: sview, b_value: i64) -> bool:
            ensure result == (
                (a_kind == 0 and b_kind == 0 and a_name != b_name)
                or (a_kind == 1 and b_kind == 1 and a_value != b_value)
            )
            return (a_kind == 0 and b_kind == 0 and a_name != b_name) or (a_kind == 1 and b_kind == 1 and a_value != b_value)

        # Reference semantics: two paths overlap unless some step in their
        # common prefix proves disjointness.
        ghost def overlap_reference_from(kinds: darray[u8]&, names: darray[sview]&, values: darray[i64]&, a_start: usize, a_count: usize, b_start: usize, b_count: usize, step: usize) -> bool:
            requires inputs_well_formed(kinds, names, values, a_start, a_count, b_start, b_count)
            requires step <= a_count and step <= b_count
            decreases a_count - step
            ensure (step == a_count or step == b_count) implies result == true
            ensure step < a_count and step < b_count and steps_provably_disjoint(kinds[a_start + step], names[a_start + step], values[a_start + step], kinds[b_start + step], names[b_start + step], values[b_start + step]) implies result == false
            ensure step < a_count and step < b_count and not steps_provably_disjoint(kinds[a_start + step], names[a_start + step], values[a_start + step], kinds[b_start + step], names[b_start + step], values[b_start + step]) implies result == overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step + 1)
            return true if step == a_count or step == b_count
            a_index: usize = a_start + step
            b_index: usize = b_start + step
            return false if steps_provably_disjoint(kinds[a_index], names[a_index], values[a_index], kinds[b_index], names[b_index], values[b_index])
            return overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step + 1)

        # Invalid parallel-array spans cannot prove disjointness, so the
        # reference result also fails closed for malformed metadata.
        ghost def overlap_reference(kinds: darray[u8]&, names: darray[sview]&, values: darray[i64]&, a_start: usize, a_count: usize, b_start: usize, b_count: usize) -> bool:
            ensure not inputs_well_formed(kinds, names, values, a_start, a_count, b_start, b_count) implies result == true
            ensure inputs_well_formed(kinds, names, values, a_start, a_count, b_start, b_count) implies result == overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)
            return true if not inputs_well_formed(kinds, names, values, a_start, a_count, b_start, b_count)
            return overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)

        def paths_overlap(kinds: darray[u8]&, names: darray[sview]&, values: darray[i64]&, a_start: usize, a_count: usize, b_start: usize, b_count: usize) -> bool:
            ensure result == overlap_reference(kinds, names, values, a_start, a_count, b_start, b_count)
            can Abort.Panic:
                return true if not inputs_well_formed(kinds, names, values, a_start, a_count, b_start, b_count)
                overlap_limit: usize = a_count if a_count < b_count else b_count
                assert overlap_limit <= a_count and overlap_limit <= b_count
                assert overlap_limit == a_count or overlap_limit == b_count
                for step in 0..<overlap_limit:
                    invariant step <= a_count and step <= b_count
                    invariant overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step)
                        == overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)
                    a_index: usize = a_start + step
                    b_index: usize = b_start + step
                    if steps_provably_disjoint(kinds[a_index], names[a_index], values[a_index], kinds[b_index], names[b_index], values[b_index]):
                        assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step) == false
                        assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step)
                            == overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)
                        assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)
                            == overlap_reference(kinds, names, values, a_start, a_count, b_start, b_count)
                        return false
                    assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step) == overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step + 1)
                    assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, step + 1)
                        == overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)
                assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, overlap_limit) == true
                assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, overlap_limit)
                    == overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)
                assert overlap_reference_from(kinds, names, values, a_start, a_count, b_start, b_count, 0)
                    == overlap_reference(kinds, names, values, a_start, a_count, b_start, b_count)
                return true
