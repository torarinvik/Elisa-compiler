# Extern/implementation signature mismatch. When an `extern f(...)` and another same-named
# declaration (a `def f` implementation, or a second `extern f`) disagree on a parameter type or
# the return type, stage0 rejects it: "extern function 'f' declaration does not match
# implementation". stage0 compares by CANONICAL TYPE NAME — i32, i64, u32, u64 and `int` are all
# DISTINCT (verified: even `int` vs `i64` mismatches), so this is decidable structurally. SOUND
# subset: only same-arity pairs where at least one side is `extern`, and a differing type is
# flagged ONLY when BOTH spellings are primitives (a differing NON-primitive is likely a type
# alias — `type T = i32` — that stage0 resolves, so it is left as a conservative miss). A single
# trailing `&` is normalized so a ref param and its extern spelling compare equal.
extend Semantic:
    private:
        # Two type spellings equal, ignoring at most one trailing `&` on each (the extern side
        # keeps the ref marker; the def side's bare_type_name strips it).
        def extern_type_names_equal(a: sview, b: sview) -> bool:
            can Abort.Panic:
                a_len: usize = sview_len(a)
                b_len: usize = sview_len(b)
                a_effective: usize = a_len - 1 if a_len > 0 and sview_at(a, a_len - 1) == '&' else a_len
                b_effective: usize = b_len - 1 if b_len > 0 and sview_at(b, b_len - 1) == '&' else b_len
                false return if a_effective != b_effective
                equal: bool =
                    for index in 0..<a_effective |match_so_far: bool = true| -> match_so_far:
                        match_so_far <- false if sview_at(a, index) != sview_at(b, index)
                return equal

        # Whether a type spelling names a primitive (ignoring one trailing `&`). Non-primitive
        # names (structs, type aliases, generics) are excluded so alias-vs-underlying pairs the
        # extern-matcher resolves are never falsely flagged.
        def extern_name_is_primitive(name: sview) -> bool:
            can Abort.Panic:
                return extern_type_names_equal(name, "i8") or extern_type_names_equal(name, "i16") or extern_type_names_equal(name, "i32") or extern_type_names_equal(name, "i64") or extern_type_names_equal(name, "u8") or extern_type_names_equal(name, "u16") or extern_type_names_equal(name, "u32") or extern_type_names_equal(name, "u64") or extern_type_names_equal(name, "usize") or extern_type_names_equal(name, "isize") or extern_type_names_equal(name, "int") or extern_type_names_equal(name, "uint") or extern_type_names_equal(name, "uintptr") or extern_type_names_equal(name, "f32") or extern_type_names_equal(name, "f64") or extern_type_names_equal(name, "bool") or extern_type_names_equal(name, "char") or extern_type_names_equal(name, "void")

        # A definite type mismatch: the spellings differ AND both are primitives.
        def extern_types_mismatch(a: sview, b: sview) -> bool:
            can Abort.Panic:
                return not extern_type_names_equal(a, b) and extern_name_is_primitive(a) and extern_name_is_primitive(b)

        # Signature name of a callable declaration (extern or def), else "".
        def extern_decl_sig_name(declaration: Ast::Decl) -> sview:
            can Abort.Panic:
                return match declaration:
                    Ast::Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line): name
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, line): name
                    _: sview("", 0, 0)

        def extern_decl_is_extern(declaration: Ast::Decl) -> bool:
            can Abort.Panic:
                return match declaration:
                    Ast::Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line): true
                    _: false

        def extern_decl_arity(declaration: Ast::Decl) -> u32:
            can Memory.Allocate, Abort.Panic:
                return match declaration:
                    Ast::Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line): arity
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, line): params.count.u32()
                    _: 0

        def extern_decl_variadic(declaration: Ast::Decl) -> bool:
            can Abort.Panic:
                return match declaration:
                    Ast::Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line): variadic
                    _: false

        def extern_decl_return_name(declaration: Ast::Decl) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match declaration:
                    Ast::Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line): return_type_name
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, line): bare_type_name(get return_type else (Ast::Expr.Absent))
                    _: sview("", 0, 0)

        # The i-th parameter's type spelling (extern params live in the `extern_params` side table).
        def extern_decl_param_type(declaration: Ast::Decl, position: usize, extern_params: darray[Ast::ExternParam]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match declaration:
                    Ast::Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line): extern_params[param_start.usize() + position].type_name if position < arity.usize() else sview("", 0, 0)
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, line): bare_type_name(params[position].type_expression) if position < params.count else sview("", 0, 0)
                    _: sview("", 0, 0)

        # Whether two same-named callables have a conflicting signature. Only same-arity,
        # non-variadic pairs are compared (a conservative cut); a differing primitive param or
        # return type is a conflict.
        def extern_signatures_conflict(a: Ast::Decl, b: Ast::Decl, extern_params: darray[Ast::ExternParam]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if extern_decl_variadic(a) or extern_decl_variadic(b)
                a_arity: u32 = extern_decl_arity(a)
                false return if a_arity != extern_decl_arity(b)
                param_conflict: bool =
                    for position in 0..<a_arity.usize() |conflict: bool = false| -> conflict:
                        conflict <- true if extern_types_mismatch(extern_decl_param_type(a, position, extern_params), extern_decl_param_type(b, position, extern_params))
                true return if param_conflict
                return extern_types_mismatch(extern_decl_return_name(a), extern_decl_return_name(b))

        # Whether some declaration at an index < `before` is an extern with signature name `name`
        # (used so only the FIRST extern of a given name anchors the report — stateless dedup).
        def extern_earlier_extern_named(declarations: darray[Ast::Decl], before: usize, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return for earlier in 0..<before |seen: bool = false| -> seen:
                    seen <- true if extern_decl_is_extern(declarations[earlier]) and extern_decl_sig_name(declarations[earlier]) == name

        def extern_mismatch_list(declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for anchor_index in 0..<declarations.count |table| -> table:
                    anchor: Ast::Decl = declarations[anchor_index]
                    anchor_name: sview = extern_decl_sig_name(anchor)
                    is_first_extern: bool = extern_decl_is_extern(anchor) and anchor_name != "" and not extern_earlier_extern_named(declarations, anchor_index, anchor_name)
                    conflict_found: bool =
                        for other_index in 0..<declarations.count |hit: bool = false| -> hit:
                            hit <- true if other_index != anchor_index and extern_decl_sig_name(declarations[other_index]) == anchor_name and extern_signatures_conflict(anchor, declarations[other_index], extern_params)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternImplMismatch, name: anchor_name, line: 0, expected: "", actual: ""}) if is_first_extern and conflict_found

        def check_extern_signature_mismatch_decls(declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- extern_mismatch_list(declarations, extern_params, table)
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_extern_signature_mismatch_decls(module_body, extern_params, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_extern_signature_mismatch_decls(scoped_body, extern_params, table)
                        _:
                            pass

    public:
        def check_extern_signature_mismatch(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_extern_signature_mismatch_decls(file.top_decls, file.extern_params, table)
