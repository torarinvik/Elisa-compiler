# Stage1 semantic — goal-shape provers (`extend Semantic: private:`). Each decides one
# recognizable ensure shape against the requires facts: differences and their underflow
# guards, or-disjuncts, swapped equalities, `% == 0` and alignment goals.
# Continues check_ensure_strict_linear_deep.elisa; split out to keep each part file
# under 600 lines.

extend Semantic:
    private:
        # Whether OPERATOR is a comparison whose reflexive form (`A op A`) is TRUE.
        def is_reflexively_true_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        # RELATIONAL requires facts: `a >= b` / `a > b` between two variables. The goal's
        # affine form D is decided when it is exactly ±(a - b) + k.
        def ensure_difference_proves(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool, requires_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                coeffs: mutable darray[i64] = []
                konst: mutable i64 = 0
                false return if not lin_add(goal_left, 1, names, coeffs, konst, return_expression, has_return, 0)
                false return if not lin_add(goal_right, -1, names, coeffs, konst, return_expression, has_return, 0)
                plus_var: mutable sview = sview("", 0, 0)
                minus_var: mutable sview = sview("", 0, 0)
                shape_ok: mutable bool = true
                term: mutable usize = 0
                while term < names.count |plus_var, minus_var, shape_ok, term, names, coeffs|:
                    coefficient: i64 = coeffs[term]
                    if coefficient == 1:
                        shape_ok <- false if plus_var != ""
                        plus_var <- names[term]
                    if coefficient == (0 - 1):
                        shape_ok <- false if minus_var != ""
                        minus_var <- names[term]
                    shape_ok <- false if coefficient != 0 and coefficient != 1 and coefficient != (0 - 1)
                    term <- term + 1
                false return if not shape_ok or plus_var == "" or minus_var == ""
                # A requires `plus_var >= minus_var` (or >) gives D >= k (or >= k+1).
                strict_gap: mutable bool = false
                found_fact: mutable bool = false
                for required in requires_predicates |strict_gap, found_fact, plus_var, minus_var|:
                    match required:
                        Expr.Binary(req_left, req_operator, req_right, req_line):
                            forward: bool = ident_name_of(req_left) == plus_var and ident_name_of(req_right) == minus_var and (req_operator == TokenKind.GtEq or req_operator == TokenKind.Gt)
                            mirrored: bool = ident_name_of(req_right) == plus_var and ident_name_of(req_left) == minus_var and (req_operator == TokenKind.LtEq or req_operator == TokenKind.Lt)
                            if forward or mirrored:
                                found_fact <- true
                                strict_gap <- true if req_operator == TokenKind.Gt or req_operator == TokenKind.Lt
                        _:
                            pass
                false return if not found_fact
                minimum: i64 = konst + 1 if strict_gap else konst
                (minimum >= 1) return if operator == TokenKind.Gt
                (minimum >= 0) return if operator == TokenKind.GtEq
                return false


        # UNDERFLOW-SAFETY of an unsigned difference `return X - Y`: a `requires X >= Y`
        # (or `X > Y`, or the mirrored `Y <= X` / `Y < X`) proves the subtraction cannot
        # wrap, so its affine form equals its true integer value. This lets the interval
        # tier decide goals like `ensure result <= X` (D = -Y, bounded below by Y's
        # unsigned zero) that the raw box gate would reject — `X` carries no upper bound,
        # yet it CANCELS in the goal. A pure subtraction has no addition, hence no
        # overflow risk, so the fact alone is sufficient.
        def return_diff_underflow_safe(return_expression: Ast::Expr, requires_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match return_expression:
                    Expr.Binary(left, operator, right, line):
                        false return if operator != TokenKind.Minus
                        minuend: sview = ident_name_of(left)
                        subtrahend: sview = ident_name_of(right)
                        false return if minuend == "" or subtrahend == ""
                        for required in requires_predicates |minuend, subtrahend|:
                            match required:
                                Expr.Binary(req_left, req_operator, req_right, req_line):
                                    forward: bool = ident_name_of(req_left) == minuend and ident_name_of(req_right) == subtrahend and (req_operator == TokenKind.GtEq or req_operator == TokenKind.Gt)
                                    mirrored: bool = ident_name_of(req_right) == minuend and ident_name_of(req_left) == subtrahend and (req_operator == TokenKind.LtEq or req_operator == TokenKind.Lt)
                                    true return if forward or mirrored
                                _:
                                    pass
                        return false
                    _:
                        return false


        # A provably NON-NEGATIVE expression: a non-negative literal, an int parameter
        # whose box lower bound is >= 0 (every unsigned type, or a `requires`-lowered
        # signed one), or a container-size field (`.count`/`.length`/`.len`, always >= 0).
        def expr_is_nonneg(expression: Ast::Expr, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return expr_is_nonneg(inner, int_params, has_lo, lo)
                    Expr.IntLit(value):
                        return value >= 0
                    Expr.Ident(name, ident_line):
                        probe: mutable usize = 0
                        while probe < int_params.count |probe, name, int_params, has_lo, lo|:
                            (has_lo[probe] and lo[probe] >= 0) return if int_params[probe] == name
                            probe <- probe + 1
                        return false
                    Expr.Field(object, field, field_line):
                        return field == "count" or field == "length" or field == "len"
                    _:
                        return false

        # RELATIONAL upper-bound tier over ARBITRARY minuend expressions: a goal
        # `ensure result <= M` on `return M - S` holds when (a) some `requires` proves
        # `S <= M` (so the unsigned subtraction cannot underflow — its value is M - S in
        # ℤ) and (b) `S` is provably non-negative (so M - S <= M). M and S may be field or
        # method expressions the linear tier cannot box (`r.data.count - used`).
        def ensure_guarded_diff_upper(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool, requires_predicates: darray[Ast::Expr]&, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                false return if operator != TokenKind.LtEq
                false return if ident_name_of(goal_left) != "result"
                match return_expression:
                    Expr.Binary(minuend, minus_operator, subtrahend, binary_line):
                        false return if minus_operator != TokenKind.Minus
                        false return if not expressions_equal(goal_right, minuend)
                        false return if not expr_is_nonneg(subtrahend, int_params, has_lo, lo)
                        for required in requires_predicates |minuend, subtrahend|:
                            match required:
                                Expr.Binary(req_left, req_operator, req_right, req_line):
                                    forward: bool = expressions_equal(req_left, subtrahend) and expressions_equal(req_right, minuend) and (req_operator == TokenKind.LtEq or req_operator == TokenKind.Lt)
                                    mirrored: bool = expressions_equal(req_left, minuend) and expressions_equal(req_right, subtrahend) and (req_operator == TokenKind.GtEq or req_operator == TokenKind.Gt)
                                    true return if forward or mirrored
                                _:
                                    pass
                        return false
                    _:
                        return false


        # PROPOSITIONAL disjunction: `ensure A or B` holds when either disjunct restates
        # a `requires` clause verbatim.
        def ensure_or_disjunct_proves(predicate: Ast::Expr, requires_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, line):
                        return ensure_or_disjunct_proves(inner, requires_predicates)
                    Expr.Binary(left, operator, right, line):
                        false return if operator != TokenKind.Or
                        true return if any required in requires_predicates where expressions_equal(left, required)
                        true return if any required2 in requires_predicates where expressions_equal(right, required2)
                        true return if ensure_or_disjunct_proves(left, requires_predicates)
                        return ensure_or_disjunct_proves(right, requires_predicates)
                    _:
                        return false


        # EQUALITY under a variable identification: `requires p == q` makes
        # `ensure (p != null) == (q != null)` hold — the two sides are structurally
        # equal after renaming p to q.
        def ensure_swap_equality_proves(predicate: Ast::Expr, requires_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, line):
                        return ensure_swap_equality_proves(inner, requires_predicates)
                    Expr.Binary(left, operator, right, line):
                        false return if operator != TokenKind.EqEq
                        for required in requires_predicates |left, right|:
                            match required:
                                Expr.Binary(req_left, req_operator, req_right, req_line):
                                    continue if req_operator != TokenKind.EqEq
                                    p: sview = ident_name_of(req_left)
                                    q: sview = ident_name_of(req_right)
                                    continue if p == "" or q == ""
                                    true return if ensure_equal_modulo_swap(left, right, p, q, 0)
                                _:
                                    pass
                        return false
                    _:
                        return false


        def ensure_equal_modulo_swap(a: Ast::Expr, b: Ast::Expr, p: sview, q: sview, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 12
                match a:
                    Expr.Ident(a_name, a_line):
                        b_name: sview = ident_name_of(b)
                        false return if b_name == ""
                        true return if a_name == b_name
                        true return if a_name == p and b_name == q
                        return a_name == q and b_name == p
                    Expr.IntLit(a_value):
                        return match b:
                            Expr.IntLit(b_value): a_value == b_value
                            _: false
                    Expr.Paren(a_inner, a_paren):
                        return ensure_equal_modulo_swap(a_inner, b, p, q, depth + 1)
                    Expr.Binary(a_left, a_operator, a_right, a_bin):
                        match b:
                            Expr.Paren(b_inner, b_paren):
                                return ensure_equal_modulo_swap(a, b_inner, p, q, depth + 1)
                            Expr.Binary(b_left, b_operator, b_right, b_bin):
                                false return if a_operator != b_operator
                                false return if not ensure_equal_modulo_swap(a_left, b_left, p, q, depth + 1)
                                return ensure_equal_modulo_swap(a_right, b_right, p, q, depth + 1)
                            _:
                                return false
                    Expr.Unary(a_operator, a_operand, a_un):
                        match b:
                            Expr.Unary(b_operator, b_operand, b_un):
                                false return if a_operator != b_operator
                                return ensure_equal_modulo_swap(a_operand, b_operand, p, q, depth + 1)
                            _:
                                return false
                    _:
                        return false


        # Rename identifiers of EXPRESSION per the parallel from/to name lists (rebuilding the
        # affine-relevant nodes). Used to map a callee's ensure `result == E` into caller space
        # when the call arguments are bare identifiers.
        def csp_rename_idents(expression: Ast::Expr, from_names: darray[sview]&, to_names: darray[sview]&, depth: u32) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                (expression) return if depth > 40
                match expression:
                    Expr.Ident(name, line):
                        probe: mutable usize = 0
                        while probe < from_names.count |probe, name, from_names, to_names|:
                            (Ast::Expr.Ident(to_names[probe], line)) return if from_names[probe] == name
                            probe <- probe + 1
                        return expression
                    Expr.Paren(inner, line):
                        return (Ast::Expr.Paren(csp_rename_idents(inner, from_names, to_names, depth + 1), line))
                    Expr.Unary(operator, operand, line):
                        return (Ast::Expr.Unary(operator, csp_rename_idents(operand, from_names, to_names, depth + 1), line))
                    Expr.Binary(binary_left, operator, binary_right, line):
                        return (Ast::Expr.Binary(csp_rename_idents(binary_left, from_names, to_names, depth + 1), operator, csp_rename_idents(binary_right, from_names, to_names, depth + 1), line))
                    _:
                        return expression

        # Unwrap parentheses to the inner expression.
        def emz_unparen(expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return emz_unparen(inner)
                    _:
                        return expression

        # MODULAR-ZERO identity: `ensure (result % D) == 0` on `return X - (X % D)` holds for
        # every integer — `X - (X % D)` is the largest multiple of D not exceeding X, hence
        # divisible by D. `result` resolves to the return expression; D and X are matched
        # structurally so the divisor and dividend agree.
        def ensure_mod_zero_proven(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                false return if operator != TokenKind.EqEq
                false return if not int_literal_is(emz_unparen(goal_right), 0)
                mod_goal: Ast::Expr = emz_unparen(goal_left)
                match mod_goal:
                    Expr.Binary(mod_of, mod_operator, mod_by, mod_line):
                        false return if mod_operator != TokenKind.Percent
                        false return if ident_name_of(emz_unparen(mod_of)) != "result"
                        difference: Ast::Expr = emz_unparen(return_expression)
                        match difference:
                            Expr.Binary(minuend, difference_operator, subtrahend, difference_line):
                                false return if difference_operator != TokenKind.Minus
                                inner_mod: Ast::Expr = emz_unparen(subtrahend)
                                match inner_mod:
                                    Expr.Binary(sub_of, sub_operator, sub_by, sub_line):
                                        false return if sub_operator != TokenKind.Percent
                                        return expressions_equal(emz_unparen(minuend), emz_unparen(sub_of)) and expressions_equal(emz_unparen(mod_by), emz_unparen(sub_by))
                                    _:
                                        return false
                            _:
                                return false
                    _:
                        return false

        # ALIGN-DOWN identity: `ensure (result % D) == 0` on `return (E / D) * D` — integer
        # floor-division then re-multiplication yields a multiple of D (round-up idiom
        # `((v + a - 1) / a) * a`, divisor == multiplier).
        def ensure_align_mod_zero(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                false return if operator != TokenKind.EqEq
                false return if not int_literal_is(emz_unparen(goal_right), 0)
                mod_goal: Ast::Expr = emz_unparen(goal_left)
                match mod_goal:
                    Expr.Binary(mod_of, mod_operator, mod_by, mod_line):
                        false return if mod_operator != TokenKind.Percent
                        false return if ident_name_of(emz_unparen(mod_of)) != "result"
                        product: Ast::Expr = emz_unparen(return_expression)
                        match product:
                            Expr.Binary(product_left, product_operator, product_right, product_line):
                                false return if product_operator != TokenKind.Star
                                false return if not expressions_equal(emz_unparen(product_right), emz_unparen(mod_by))
                                dividend: Ast::Expr = emz_unparen(product_left)
                                match dividend:
                                    Expr.Binary(div_of, div_operator, div_by, div_line):
                                        false return if div_operator != TokenKind.Slash
                                        return expressions_equal(emz_unparen(div_by), emz_unparen(mod_by))
                                    _:
                                        return false
                            _:
                                return false
                    _:
                        return false

        # Shape `((VALUE + ALIGN - 1) / ALIGN) * ALIGN` -> (ok, VALUE, ALIGN). Divisor == multiplier.
        def es_align_shape(expression: Ast::Expr) -> (ok: bool, value: Ast::Expr, align: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                product: Ast::Expr = emz_unparen(expression)
                match product:
                    Expr.Binary(product_left, product_operator, product_right, product_line):
                        (false, Ast::Expr.Invalid, Ast::Expr.Invalid) return if product_operator != TokenKind.Star
                        align: Ast::Expr = emz_unparen(product_right)
                        dividend: Ast::Expr = emz_unparen(product_left)
                        match dividend:
                            Expr.Binary(div_of, div_operator, div_by, div_line):
                                (false, Ast::Expr.Invalid, Ast::Expr.Invalid) return if div_operator != TokenKind.Slash
                                (false, Ast::Expr.Invalid, Ast::Expr.Invalid) return if not expressions_equal(emz_unparen(div_by), align)
                                numerator: Ast::Expr = emz_unparen(div_of)
                                match numerator:
                                    Expr.Binary(sum, minus_operator, one, minus_line):
                                        (false, Ast::Expr.Invalid, Ast::Expr.Invalid) return if minus_operator != TokenKind.Minus
                                        (false, Ast::Expr.Invalid, Ast::Expr.Invalid) return if not int_literal_is(emz_unparen(one), 1)
                                        inner_sum: Ast::Expr = emz_unparen(sum)
                                        match inner_sum:
                                            Expr.Binary(add_v, add_operator, add_a, add_line):
                                                (false, Ast::Expr.Invalid, Ast::Expr.Invalid) return if add_operator != TokenKind.Plus
                                                (true, emz_unparen(add_v), align) return if expressions_equal(emz_unparen(add_a), align)
                                                (true, emz_unparen(add_a), align) return if expressions_equal(emz_unparen(add_v), align)
                                                return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                                            _:
                                                return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                                    _:
                                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                            _:
                                return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                    _:
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)

        # ROUND-UP LOWER BOUND: `ensure result >= V` on `return ((V + A - 1) / A) * A` where A is a
        # `>= 1` param (refined type / `type` alias `AlignAmount = u64 is Bounded[1, 4096]`).
        def ensure_align_ge(goal: Ast::Expr, return_expression: Ast::Expr, has_return: bool, parameters: darray[Ast::ParamDecl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                goal_unwrapped: Ast::Expr = emz_unparen(goal)
                match goal_unwrapped:
                    Expr.Binary(goal_left, operator, goal_right, goal_line):
                        false return if operator != TokenKind.GtEq
                        false return if ident_name_of(emz_unparen(goal_left)) != "result"
                        shape: (ok: bool, value: Ast::Expr, align: Ast::Expr) = es_align_shape(return_expression)
                        false return if not shape.ok
                        false return if not expressions_equal(shape.value, emz_unparen(goal_right))
                        align_name: sview = ident_name_of(shape.align)
                        false return if align_name == ""
                        bounded: mutable bool = false
                        for parameter in parameters |bounded, align_name, law_names, law_predicates, alias_names, alias_targets|:
                            if parameter.name == align_name:
                                resolved: Ast::Expr = cpu_resolve_alias(parameter.type_expression, alias_names, alias_targets)
                                bounds: (found: bool, lo: i64, hi: i64) = refined_param_bounds(resolved, law_names, law_predicates)
                                bounded <- true if bounds.found and bounds.lo >= 1
                        return bounded
                    _:
                        return false


        # `x % C` for positive literal C: result range [0, C-1] when x is non-negative
        # (unsigned, or boxed with lo >= 0). Decides `ensure result < 8` on `return n % 8`.
        def mod_goal_is_proven(return_expression: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match return_expression:
                    Expr.Paren(inner, line):
                        return mod_goal_is_proven(inner, operator, goal_right, int_params, has_lo, lo)
                    Expr.Binary(left, mod_operator, right, line):
                        false return if mod_operator != TokenKind.Percent
                        modulus: (found: bool, value: i64) = fold_const_int(right)
                        false return if not modulus.found or modulus.value <= 0
                        # Operand must be provably non-negative.
                        operand_name: sview = ident_name_of(left)
                        false return if operand_name == ""
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < int_params.count |slot, probe, operand_name, int_params|:
                            slot <- probe.i64() if int_params[probe] == operand_name and slot < 0
                            probe <- probe + 1
                        false return if slot < 0
                        false return if not (has_lo[slot.usize()] and lo[slot.usize()] >= 0)
                        bound: (found: bool, value: i64) = fold_const_int(goal_right)
                        false return if not bound.found
                        (modulus.value - 1 < bound.value) return if operator == TokenKind.Lt
                        (modulus.value - 1 <= bound.value) return if operator == TokenKind.LtEq
                        return false
                    _:
                        return false


        # The local a REF binding aliases (`r: mutable i64& = &y` -> "y"), or "".
        def ensure_env_alias_of(body: darray[Ast::Stmt], ref_name: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for statement in body |found, ref_name|:
                    match statement:
                        Stmt.VarDecl(local_name, local_type, local_value, local_line):
                            continue if local_name != ref_name
                            match local_value:
                                Expr.Unary(operator, operand, unary_line):
                                    found <- ident_name_of(operand) if operator == TokenKind.Ampersand and found == ""
                                _:
                                    pass
                        _:
                            pass
                return found


