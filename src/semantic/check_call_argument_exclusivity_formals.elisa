# Same-call exclusivity, formal half: a bare reference PARAMETER passed to a call that returns
# a reference lends its referent to the result. `alias = same(source); f(source, alias)` hands
# `f` two names for one referent, although `source` is passed bare and `alias` reached through
# a ref row: the comparison in check_call_argument_exclusivity.elisa pairs them here.
extend Semantic:
    private:
        # The name of the reference parameter ARGUMENT names bare (through parentheses), or ""
        # when it is anything else, including a ref local with rows of its own.
        def exclusivity_formal_ref(argument: Ast::Expr, refs: ExclusivityRefs&) -> sview:
            can Memory.Allocate, Abort.Panic:
                name: sview = exclusivity_ident_name(exclusivity_strip_parens(argument))
                return "" if name == "" or not exclusivity_name_listed(refs.ref_params, name)
                return "" if exclusivity_ref_slot(refs.names, name) < refs.names.count
                return name

        # Whether entry FORMAL is a bare reference formal and entry ROUTED a whole-referent
        # borrow of that same formal reached through a ref local or a returned reference.
        def exclusivity_formal_meets_route(entries: ExclusivityEntries&, formal: usize, routed: usize, step_counts: darray[usize]&, refs: ExclusivityRefs&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if entries.addressed[formal] or not entries.addressed[routed] or entries.held[routed]
                false return if entries.via_kind[routed] == "" or step_counts[formal] != 0 or step_counts[routed] != 0
                return exclusivity_formal_ref(entries.places[formal], refs) != ""

        def exclusivity_strip_parens(argument: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, _):
                        return exclusivity_strip_parens(inner)
                    _:
                        return argument

        # Whether one of the entries is a bare reference formal and the other a whole-referent
        # borrow routed from it (a ref local or a returned reference): the same referent.
        def exclusivity_formal_pair(entries: ExclusivityEntries&, later: usize, earlier: usize, step_counts: darray[usize]&, refs: ExclusivityRefs&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return exclusivity_formal_meets_route(entries, later, earlier, step_counts, refs) or exclusivity_formal_meets_route(entries, earlier, later, step_counts, refs)
