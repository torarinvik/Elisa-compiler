# Error-set wrapper return analysis.
extend Semantic:
    private:
        # Resolve a callable in the wrapper call's module and lexical parents. A name-only lookup
        # can otherwise borrow a same-named declaration (and its errorset parameter) from a sibling
        # module. Unknown caller scope declines this narrow diagnostic rather than guessing.
        def ewr_callable_family(file: Ast::File&, all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, name: sview @source, qualifier: sview @source, caller_module: sview @source, caller_module_known: bool, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> EwrFamilyRef:
            can Memory.Allocate, Abort.Panic:
                return ewr_empty_family_ref() if not caller_module_known
                return ewr_empty_family_ref() if ewr_unknown_static_import_affects_call(annotations, all_declarations, name, qualifier, caller_module, table)
                parameter_name_shadow: bool = any parameter in caller_parameters where parameter.name == name
                local_name_shadow: bool = any local_name in caller_local_names where local_name == name
                return ewr_empty_family_ref() if qualifier == "" and (parameter_name_shadow or local_name_shadow)
                receiver_rank_gate: bool = ewr_receiver_rank_gate(all_declarations, name, qualifier, caller_module, call_arity_known, call_arguments, call_argument_names, has_argument_forward, annotations, table)
                return ewr_empty_family_ref() if qualifier == "" and not receiver_rank_gate and callable_wildcard_ambiguous(file, name, caller_module, table)
                if receiver_rank_gate:
                    receiver_type: (known: bool, kind: u8, name: sview) = ewr_actual_primitive_type(call_arguments[0.usize()], caller_parameters, caller_local_names)
                    return ewr_empty_family_ref() if not receiver_type.known
                receiver_rank_active: bool = receiver_rank_gate
                selected: mutable EwrFamilyRef = ewr_empty_family_ref()
                selected_scope_length: mutable usize = 0
                selected_scope_known: mutable bool = false
                selected_is_local: mutable bool = false
                selected_specificity: mutable usize = 0.usize()
                selected_match_known: mutable bool = false
                ambiguous: mutable bool = false
                uncertain: mutable bool = false
                inaccessible_rank_found: mutable bool = false
                inaccessible_rank_unknown: mutable bool = false
                inaccessible_specificity: mutable usize = 0.usize()
                row: mutable u32 = callable_error_index_head(error_index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, annotations, module_annotations, module_index, error_index, table, all_declarations, extern_params, name, qualifier, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, receiver_rank_active, selected, selected_scope_length, selected_is_local, selected_specificity, selected_match_known, ambiguous, uncertain, inaccessible_rank_found, inaccessible_rank_unknown, inaccessible_specificity|:
                    source_row: usize = error_index.source_rows[row.usize()]
                    annotation: Ast::EnumAnnotation = annotations[source_row]
                    declaration_arity: (found: bool, accepts: bool) = ewr_declaration_accepts_arity(all_declarations, annotation.line, annotation.offset, call_arity) if call_arity_known and receiver_rank_active else (true, true)
                    candidate_arity_viable: bool = not declaration_arity.found or declaration_arity.accepts
                    if annotation.owner == name and callable_error_family_row(annotations, source_row) and candidate_arity_viable:
                        candidate_module_known: bool = fallible_fn_module_known(module_annotations, annotation.offset, annotation.line)
                        candidate_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                        candidate_match: (known: bool, viable: bool, specificity: usize) = ewr_declaration_call_match(all_declarations, annotation.line, annotation.offset, candidate_module, call_arguments, call_argument_names, extern_params, annotations, caller_parameters, caller_local_names) if call_arity_known and receiver_rank_active else (false, true, 0.usize())
                        # Core's direct-name path keeps the bound return type after argument
                        # diagnostics. Only its receiver-rank rewrite selects by this type.
                        candidate_type_viable: bool = candidate_match.viable if receiver_rank_active else true
                        candidate_is_local: bool = candidate_module_known and ewr_module_is_lexical_ancestor(candidate_module, caller_module) if qualifier == "" else false
                        imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(table.ewr_import_rows, name, candidate_module, caller_module) if qualifier == "" and candidate_module_known and not candidate_is_local else (false, 0.usize())
                        candidate_visible: mutable bool = ewr_qualified_module_matches(candidate_module, qualifier, caller_module, annotations, table) if qualifier != "" and candidate_module_known else candidate_is_local or imported_scope.visible
                        candidate_in_rank_set: bool = candidate_visible
                        candidate_accessible: bool = ewr_callable_name_visible(annotations, name, candidate_module, caller_module, annotation.line, annotation.offset) if candidate_in_rank_set else false
                        inaccessible_candidate: bool = candidate_in_rank_set and not candidate_accessible
                        if receiver_rank_active and inaccessible_candidate and candidate_type_viable:
                            if not candidate_match.known:
                                inaccessible_rank_unknown <- true
                            elif not inaccessible_rank_found or candidate_match.specificity > inaccessible_specificity:
                                inaccessible_rank_found <- true
                                inaccessible_specificity <- candidate_match.specificity
                        candidate_visible <- false if inaccessible_candidate
                        candidate_scope_length: mutable usize = imported_scope.scope_length
                        candidate_scope_length <- ewr_qualified_module_rank(candidate_module, qualifier, caller_module, annotations, table) if qualifier != ""
                        candidate_scope_length <- ewr_local_scope_rank(candidate_module, caller_module) if qualifier == "" and candidate_is_local
                        if candidate_visible and candidate_type_viable:
                            captured_family: (found: bool, ambiguous: bool, row_index: usize) = ewr_single_captured_family_row(annotations, annotation, candidate_module_known, candidate_module, table)
                            family_path: sview @source = ewr_family_path_for_occurrence(annotations, captured_family.row_index, annotation.name, annotation.line, annotation.offset, annotation.identity_id, annotation.occurrence_offset) if captured_family.found and not captured_family.ambiguous else ""
                            path_resolves: bool = ewr_family_path_resolves(family_path, annotation.name, annotation.line, annotation.offset, annotation.identity_id, candidate_module, annotations, table) if captured_family.found and not captured_family.ambiguous else false
                            if captured_family.found and not captured_family.ambiguous and path_resolves:
                                captured_row: Ast::EnumAnnotation = annotations[captured_family.row_index]
                                family: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, captured_row, family_path, candidate_module_known, candidate_module, table)
                                candidate: EwrFamilyRef = EwrFamilyRef{family: family.family, family_path: family_path, source_name: family.source_name, variant_override: family.variant_override, module: family.module, module_known: family.module_known, family_row_index: captured_family.row_index, has_family_row: true, function_name: annotation.owner, function_module: candidate_module, function_module_known: candidate_module_known, declaration_line: captured_row.line, declaration_offset: captured_row.offset, declaration_identity_id: captured_row.identity_id, occurrence_offset: captured_row.occurrence_offset}
                                if receiver_rank_active:
                                    if not candidate_match.known:
                                        ambiguous <- true
                                        uncertain <- true
                                    elif not selected_scope_known:
                                        selected <- candidate
                                        selected_scope_length <- candidate_scope_length
                                        selected_scope_known <- true
                                        selected_is_local <- candidate_is_local
                                        selected_specificity <- candidate_match.specificity
                                        selected_match_known <- true
                                        ambiguous <- false if not uncertain
                                    elif candidate_match.specificity > selected_specificity:
                                        selected <- candidate
                                        selected_scope_length <- candidate_scope_length
                                        selected_is_local <- candidate_is_local
                                        selected_specificity <- candidate_match.specificity
                                        selected_match_known <- true
                                        ambiguous <- false if not uncertain
                                    elif candidate_match.specificity == selected_specificity:
                                        ambiguous <- true if not ewr_family_refs_match(selected, candidate)
                                elif not selected_scope_known or candidate_scope_length > selected_scope_length or (candidate_scope_length == selected_scope_length and candidate_is_local and not selected_is_local):
                                    selected <- candidate
                                    selected_scope_length <- candidate_scope_length
                                    selected_scope_known <- true
                                    selected_is_local <- candidate_is_local
                                    selected_specificity <- candidate_match.specificity
                                    selected_match_known <- candidate_match.known
                                    ambiguous <- false
                                    uncertain <- not candidate_match.known
                                elif candidate_scope_length == selected_scope_length and candidate_is_local == selected_is_local:
                                    # With the receiver-rank rewrite disabled, same-scope
                                    # overloads do not get selected by argument-zero
                                    # specificity. Keep a family only when every same-scope
                                    # declaration names that same family.
                                    ambiguous <- true if not ewr_family_refs_match(selected, candidate)
                            elif receiver_rank_active:
                                if not candidate_match.known:
                                    ambiguous <- true
                                    uncertain <- true
                                elif not selected_scope_known or not selected_match_known or candidate_match.specificity > selected_specificity:
                                    selected <- ewr_empty_family_ref()
                                    selected_scope_length <- candidate_scope_length
                                    selected_scope_known <- true
                                    selected_is_local <- candidate_is_local
                                    selected_specificity <- candidate_match.specificity
                                    selected_match_known <- true
                                    ambiguous <- true
                                    uncertain <- true
                                elif candidate_match.specificity == selected_specificity:
                                    ambiguous <- true
                            elif not selected_scope_known or candidate_scope_length > selected_scope_length or (candidate_scope_length == selected_scope_length and candidate_is_local and not selected_is_local):
                                selected <- ewr_empty_family_ref()
                                selected_scope_length <- candidate_scope_length
                                selected_scope_known <- true
                                selected_is_local <- candidate_is_local
                                selected_specificity <- candidate_match.specificity
                                selected_match_known <- candidate_match.known
                                ambiguous <- true
                                uncertain <- true
                            elif candidate_scope_length == selected_scope_length and candidate_is_local == selected_is_local:
                                ambiguous <- true
                                uncertain <- true
                    row <- error_index.next[row.usize()]
                return ewr_empty_family_ref() if ambiguous
                return ewr_empty_family_ref() if receiver_rank_active and inaccessible_rank_unknown
                return ewr_empty_family_ref() if receiver_rank_active and inaccessible_rank_found and selected.family != "" and inaccessible_specificity >= selected_specificity
                # An identifier used as a function value has no call arity here. Ordinary
                # name lookup already filtered inaccessible candidates, so a hidden overload
                # must not outrank the visible selected binding through the call-only barrier.
                if not receiver_rank_active and call_arity_known and selected.family != "":
                    inaccessible_binding: EwrCallableBinding = ewr_first_inaccessible_callable_binding(all_declarations, name, qualifier, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table)
                    inaccessible_may_win: mutable bool = inaccessible_binding.scope_length > selected_scope_length
                    inaccessible_may_win <- inaccessible_binding.match_known and selected_match_known and inaccessible_binding.specificity >= selected_specificity if inaccessible_binding.scope_length == selected_scope_length
                    inaccessible_may_win <- true if inaccessible_binding.scope_length == selected_scope_length and (not inaccessible_binding.match_known or not selected_match_known)
                    return ewr_empty_family_ref() if inaccessible_binding.found and inaccessible_may_win
                    name_binding: EwrCallableBinding = ewr_first_visible_callable_binding(all_declarations, name, qualifier, caller_module, annotations, table)
                    return ewr_empty_family_ref() if not name_binding.found
                    return ewr_empty_family_ref() if selected_scope_length != name_binding.scope_length
                if selected.family != "":
                    return ewr_empty_family_ref() if ewr_infallible_callable_shadows(all_declarations, name, qualifier, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, receiver_rank_active, selected_scope_length, selected_is_local, selected_specificity, annotations, table)
                    if call_arity_known:
                        call_resolution: (found: bool, resolvable: bool) = ewr_declaration_call_arguments_resolvable(all_declarations, selected.declaration_line, selected.declaration_offset, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names)
                        return ewr_empty_family_ref() if not call_resolution.found or not call_resolution.resolvable
                    return selected
                if call_arity_known:
                    infallible_found: mutable bool = false
                    infallible_unknown_found: mutable bool = false
                    infallible_scope_length: mutable usize = 0.usize()
                    infallible_is_local: mutable bool = false
                    infallible_specificity: mutable usize = 0.usize()
                    infallible_unknown_scope_length: mutable usize = 0.usize()
                    infallible_unknown_is_local: mutable bool = false
                    ewr_infallible_callable_scope(all_declarations, name, qualifier, "", caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, annotations, table, receiver_rank_active, infallible_found, infallible_unknown_found, infallible_scope_length, infallible_is_local, infallible_specificity, infallible_unknown_scope_length, infallible_unknown_is_local)
                    unknown_blocks_known: bool = infallible_unknown_found and (receiver_rank_active or infallible_unknown_scope_length > infallible_scope_length or (infallible_unknown_scope_length == infallible_scope_length and (infallible_unknown_is_local == infallible_is_local or infallible_unknown_is_local)))
                    if infallible_found and not unknown_blocks_known:
                        return EwrFamilyRef{family: "", family_path: "", source_name: "", variant_override: "", module: "", module_known: false, family_row_index: 0.usize(), has_family_row: false, function_name: name, function_module: "", function_module_known: true, declaration_line: 0, declaration_offset: 0, declaration_identity_id: 0, occurrence_offset: 0}
                return selected

        def ewr_family_refs_match(left: EwrFamilyRef, right: EwrFamilyRef) -> bool:
            return false if left.family == "" or right.family == "" or left.family != right.family
            return false if left.variant_override != right.variant_override
            return false if left.module_known and right.module_known and left.module != right.module
            return false if left.function_name != right.function_name or left.function_module_known != right.function_module_known
            return false if left.function_module_known and left.function_module != right.function_module
            return left.declaration_line == right.declaration_line and left.declaration_offset == right.declaration_offset and left.declaration_identity_id == right.declaration_identity_id and left.occurrence_offset == right.occurrence_offset

        # The generic parameter row is keyed to the exact declaration, so overloads and
        # multiple functions on one line cannot lend each other an errorset parameter.
        def ewr_errorset_parameter(errorset_rows: darray[Ast::EnumAnnotation]&, function_line: u32, function_offset: u32, identity_id: u32) -> (ambiguous: bool, found: bool, name: sview @source):
            can Abort.Panic:
                count: mutable usize = 0
                name: mutable sview @source = ""
                for row in errorset_rows |count, name, function_line, function_offset, identity_id|:
                    if row.owner == "__errorset_param" and row.line == function_line and row.offset == function_offset and row.identity_id == identity_id:
                        count <- count + 1.usize()
                        name <- row.name
                return (count > 1.usize(), count == 1.usize(), name)

        # G returns `error[R]` where R is G's OWN errorset parameter — i.e. a polymorphic wrapper.
        def ewr_poly_wrapper(file: Ast::File&, all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, name: sview @source, qualifier: sview @source, caller_module: sview @source, caller_module_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (is_poly: bool, family: EwrFamilyRef, errorset_name: sview @source):
            can Memory.Allocate, Abort.Panic:
                family: EwrFamilyRef = ewr_callable_family(file, all_declarations, extern_params, annotations, module_annotations, module_index, error_index, table, name, qualifier, caller_module, caller_module_known, true, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names)
                return (false, ewr_empty_family_ref(), "") if family.family == ""
                parameter: (ambiguous: bool, found: bool, name: sview @source) = ewr_errorset_parameter(errorset_rows, family.declaration_line, family.declaration_offset, family.declaration_identity_id)
                return (false, ewr_empty_family_ref(), "") if parameter.ambiguous
                return (false, family, "") if not parameter.found or family.family != parameter.name
                return (true, family, parameter.name)

        # The CONCRETE error family of a function reference (a real enum, not an errorset parameter).
        def ewr_concrete_family(file: Ast::File&, all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, name: sview @source, qualifier: sview @source, caller_module: sview @source, caller_module_known: bool) -> EwrFamilyRef:
            can Memory.Allocate, Abort.Panic:
                family: EwrFamilyRef = ewr_callable_family(file, all_declarations, extern_params, annotations, module_annotations, module_index, error_index, table, name, qualifier, caller_module, caller_module_known, false, 0.usize(), [], [], false, [], [])
                return ewr_empty_family_ref() if family.family == "" or not family.module_known
                parameter: (ambiguous: bool, found: bool, name: sview @source) = ewr_errorset_parameter(errorset_rows, family.declaration_line, family.declaration_offset, family.declaration_identity_id)
                return ewr_empty_family_ref() if parameter.ambiguous or (parameter.found and family.family == parameter.name)
                return family

        def ewr_function_identity_matches(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef) -> bool:
            can Abort.Panic:
                matches: mutable usize = 0.usize()
                for row in annotations |matches, family|:
                    if row.owner == family.function_name and row.name == "__error_return" and row.line == family.declaration_line and row.offset == family.declaration_offset and row.identity_id == family.declaration_identity_id and row.occurrence_offset == family.occurrence_offset:
                        matches <- matches + 1.usize()
                return matches == 1.usize()

        def ewr_find_function_parameters(declarations: darray[Ast::Decl], family: EwrFamilyRef, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> (matches: usize, parameters: darray[Ast::ParamDecl]):
            can Memory.Allocate, Abort.Panic:
                matches: mutable usize = 0.usize()
                result_parameters: mutable darray[Ast::ParamDecl] = []
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, candidate_parameters, return_type, body, effects, decorators, line):
                            declaration_module_matches: bool = family.function_module_known and current_module == family.function_module
                            declaration_identity_matches: bool = ewr_function_identity_matches(annotations, family)
                            if declaration_module_matches and function_name == family.function_name and line.line == family.declaration_line and line.offset == family.declaration_offset and declaration_identity_matches:
                                result_parameters <- candidate_parameters if matches == 0.usize()
                                matches <- matches + 1.usize()
                        Decl.Module(module_name, module_body, module_line):
                            nested_module: sview @source = module_name
                            nested: (matches: usize, parameters: darray[Ast::ParamDecl]) = ewr_find_function_parameters(module_body, family, nested_module, annotations, table)
                            result_parameters <- nested.parameters if matches == 0.usize() and nested.matches > 0.usize()
                            matches <- matches + nested.matches
                        Decl.Scoped(scoped_body, scoped_line):
                            nested: (matches: usize, parameters: darray[Ast::ParamDecl]) = ewr_find_function_parameters(scoped_body, family, current_module, annotations, table)
                            result_parameters <- nested.parameters if matches == 0.usize() and nested.matches > 0.usize()
                            matches <- matches + nested.matches
                        _:
                            pass
                return (matches, result_parameters)

        # Only formals whose own type contains this wrapper's R participate in binding.
        # Annotation occurrence offsets place nested callback errorsets between their
        # parameter name and the next formal (or the enclosing return type).
        def ewr_parameter_carries_errorset(parameters: darray[Ast::ParamDecl], parameter_index: usize, family: EwrFamilyRef, errorset_name: sview, return_occurrence_offset: u32, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                return false if parameter_index >= parameters.count
                parameter_start: u32 = parameters[parameter_index].name_pos.offset
                return false if parameter_start == 0
                parameter_end: mutable u32 = return_occurrence_offset
                if parameter_index + 1.usize() < parameters.count:
                    next_start: u32 = parameters[parameter_index + 1.usize()].name_pos.offset
                    return false if next_start == 0
                    parameter_end <- next_start
                return false if parameter_end <= parameter_start
                for row in annotations |parameter_start, parameter_end, family, errorset_name|:
                    if row.owner == "__error_set_family" and row.name == errorset_name and row.line == family.declaration_line and row.offset == family.declaration_offset and row.identity_id == family.declaration_identity_id and row.occurrence_offset >= parameter_start and row.occurrence_offset < parameter_end:
                        return true
                return false

        # Bind call arguments to formal positions using the same positional/named rules as
        # semantic call checking. Invalid or ambiguous calls decline this diagnostic.
        def ewr_argument_for_parameter(arguments: darray[Ast::Expr], argument_names: darray[sview @source], parameters: darray[Ast::ParamDecl], target_parameter: usize) -> (argument: Ast::Expr?, from_default: bool):
            can Abort.Panic:
                return (null, false) if target_parameter >= parameters.count
                assigned: mutable darray[bool] = []
                for _ in 0..<parameters.count |assigned|:
                    assigned.push(false)
                positional_index: mutable usize = 0.usize()
                seen_named: mutable bool = false
                found: mutable bool = false
                selected: mutable Ast::Expr? = null
                for argument_index in 0..<arguments.count |assigned, positional_index, seen_named, found, selected, parameters, argument_names, target_parameter|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    parameter_index: mutable i64 = -1
                    if argument_name == "":
                        return (null, false) if seen_named
                        if positional_index < parameters.count:
                            parameter_index <- positional_index.i64()
                            positional_index <- positional_index + 1.usize()
                    else:
                        seen_named <- true
                        for index in 0..<parameters.count |parameter_index, parameters, argument_name|:
                            parameter_index <- index.i64() if parameters[index].name == argument_name
                        return (null, false) if parameter_index < 0
                    if parameter_index >= 0:
                        slot: usize = parameter_index.usize()
                        return (null, false) if assigned[slot]
                        assigned[slot] <- true
                        if slot == target_parameter:
                            found <- true
                            selected <- arguments[argument_index]
                if not found and parameters[target_parameter].has_default:
                    return (parameters[target_parameter].default_value, true)
                return (selected, false)

        def ewr_span_contains(span: sview, needle: sview) -> bool:
            can Abort.Panic:
                return false if needle.len == 0 or span.len < needle.len
                last_start: usize = span.len - needle.len
                start: mutable usize = 0.usize()
                while start <= last_start |start, span, needle, last_start|:
                    matched: mutable bool = true
                    offset: mutable usize = 0.usize()
                    while offset < needle.len |offset, matched, span, needle, start|:
                        matched <- false if span[start + offset] != needle[offset]
                        offset <- offset + 1.usize()
                    return true if matched
                    start <- start + 1.usize()
                return false

        # A unique top-level declaration with no fallible metadata is known to contribute the
        # empty errorset. Restrict this fallback to unqualified top-level calls; module imports,
        # sibling scopes, and overloaded names remain unknown rather than being guessed.
        # Externs require complete return spelling so a fallible external signature is never
        # silently treated as an empty errorset.
        def ewr_extern_return_is_known_infallible(annotations: darray[Ast::EnumAnnotation]&, extern_name: sview, extern_line: u32, extern_offset: u32, return_type_name: sview) -> bool:
            can Abort.Panic:
                if return_type_name == "":
                    for row in annotations:
                        return false if row.line == extern_line and row.offset == extern_offset and (row.owner == "__extern_return" or row.owner == "__extern_return_text" or row.name == "__extern_return_text_complete")
                    return true
                complete_count: mutable usize = 0.usize()
                text_count: mutable usize = 0.usize()
                extern_return_count: mutable usize = 0.usize()
                return_text: mutable sview @source = ""
                for row in annotations |complete_count, text_count, extern_return_count, return_text, extern_name, extern_line, extern_offset|:
                    complete_count <- complete_count + 1.usize() if row.owner == extern_name and row.name == "__extern_return_text_complete" and row.line == extern_line and row.offset == extern_offset
                    if row.owner == "__extern_return_text" and row.line == extern_line and row.offset == extern_offset:
                        text_count <- text_count + 1.usize()
                        return_text <- row.name
                    extern_return_count <- extern_return_count + 1.usize() if row.owner == "__extern_return" and row.line == extern_line and row.offset == extern_offset
                return complete_count == 1.usize() and text_count == 1.usize() and extern_return_count == 1.usize() and not ewr_span_contains(return_text, "error")

        def ewr_unique_top_level_callable(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, name: sview, qualifier: sview @source, caller_module: sview) -> bool:
            can Abort.Panic:
                return false if caller_module != "" or qualifier != ""
                count: mutable usize = 0
                extern_line: mutable u32 = 0
                extern_offset: mutable u32 = 0
                is_extern: mutable bool = false
                extern_return_type_name: mutable sview @source = ""
                for declaration in declarations |count, extern_line, extern_offset, is_extern, extern_return_type_name, name|:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            count <- count + 1.usize() if function_name == name
                        Decl.Extern(extern_name, _, _, _, callable, return_type_name, _, position):
                            if callable and extern_name == name:
                                count <- count + 1.usize()
                                extern_line <- position.line
                                extern_offset <- position.offset
                                is_extern <- true
                                extern_return_type_name <- return_type_name
                        _:
                            pass
                return false if count != 1.usize()
                return ewr_extern_return_is_known_infallible(annotations, name, extern_line, extern_offset, extern_return_type_name) if is_extern
                return true

        def ewr_append_module_path(expression: Ast::Expr, bytes: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Scope(base, name, _):
                        return false if not ewr_append_module_path(base, bytes)
                        bytes.push(58)
                        bytes.push(58)
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Paren(inner, _):
                        return ewr_append_module_path(inner, bytes)
                    _:
                        return false

        def ewr_callable_parts(expression: Ast::Expr, table: mutable SymbolTable&) -> (known: bool, qualifier: sview @source, name: sview @source):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return (true, "", name)
                    Expr.Scope(base, name, _):
                        path_bytes: mutable darray[u8] = []
                        return (false, "", "") if not ewr_append_module_path(base, path_bytes)
                        qualifier: sview @source = intern_joined_text(path_bytes, table)
                        return (qualifier != "", qualifier, name)
                    Expr.Paren(inner, _):
                        return ewr_callable_parts(inner, table)
                    _:
                        return (false, "", "")

        def ewr_concrete_family_of_expression(file: Ast::File&, expression: Ast::Expr, all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, caller_module: sview @source, caller_module_known: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, family: EwrFamilyRef):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return ewr_callable_concrete_family(file, name, "", false, 0.usize(), [], [], false, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known)
                    Expr.Scope(base, name, _):
                        callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(expression, table)
                        return ewr_callable_concrete_family(file, callable.name, callable.qualifier, false, 0.usize(), [], [], false, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known) if callable.known
                        return (false, ewr_empty_family_ref())
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(callee, table)
                        has_argument_forward: bool = ewr_call_has_argument_forward(annotations, call_line.line, call_line.offset)
                        return ewr_callable_concrete_family(file, callable.name, callable.qualifier, true, arguments.count, arguments, argument_names, has_argument_forward, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known) if callable.known
                        return (false, ewr_empty_family_ref())
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        return ewr_concrete_family_of_expression(file, inner, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known, caller_parameters, caller_local_names)
                    _:
                        return (false, ewr_empty_family_ref())

        def ewr_callable_concrete_family(file: Ast::File&, name: sview @source, qualifier: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, caller_module: sview @source, caller_module_known: bool) -> (known: bool, family: EwrFamilyRef):
            can Memory.Allocate, Abort.Panic:
                resolved: EwrFamilyRef = ewr_callable_family(file, all_declarations, extern_params, annotations, module_annotations, module_index, error_index, table, name, qualifier, caller_module, caller_module_known, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names)
                if resolved.family != "":
                    return (false, ewr_empty_family_ref()) if not resolved.module_known
                    parameter: (ambiguous: bool, found: bool, name: sview @source) = ewr_errorset_parameter(errorset_rows, resolved.declaration_line, resolved.declaration_offset, resolved.declaration_identity_id)
                    return (false, ewr_empty_family_ref()) if parameter.ambiguous or (parameter.found and resolved.family == parameter.name)
                    return (true, resolved)
                return (true, ewr_empty_family_ref()) if resolved.function_name == name
                if ewr_unique_top_level_callable(all_declarations, annotations, name, qualifier, caller_module):
                    return (true, ewr_empty_family_ref())
                return (false, ewr_empty_family_ref())

        # A parameter can shadow a global callable with the same spelling. Until local
        # binding resolution is available here, decline that identifier instead of borrowing
        # the global function's family.
        def ewr_expression_is_shadowed_by_parameter(expression: Ast::Expr, caller_parameters: darray[Ast::ParamDecl]) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return any parameter in caller_parameters where parameter.name == name
                    Expr.Call(callee, _, _, _):
                        return ewr_expression_is_shadowed_by_parameter(callee, caller_parameters)
                    Expr.Scope(base, _, _) | Expr.Field(base, _, _):
                        return ewr_expression_is_shadowed_by_parameter(base, caller_parameters)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ewr_expression_is_shadowed_by_parameter(inner, caller_parameters)
                    _:
                        return false

        def ewr_expression_name_is_local(expression: Ast::Expr, local_names: darray[sview]) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return any local_name in local_names where local_name == name
                    Expr.Call(callee, _, _, _):
                        return ewr_expression_name_is_local(callee, local_names)
                    Expr.Scope(base, _, _) | Expr.Field(base, _, _):
                        return ewr_expression_name_is_local(base, local_names)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ewr_expression_name_is_local(inner, local_names)
                    _:
                        return false

        def ewr_collect_target_names(expression: Ast::Expr, names: mutable darray[sview]&) -> void:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        names.push(name)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        for element in elements |names|:
                            ewr_collect_target_names(element, names)
                    Expr.Paren(inner, _):
                        ewr_collect_target_names(inner, names)
                    _:
                        pass

        def ewr_collect_local_names(statements: darray[Ast::Stmt], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names|:
                    match statement:
                        Stmt.VarDecl(name, _, _, _):
                            names.push(name)
                        Stmt.Assign(target, operator, _, _):
                            ewr_collect_target_names(target, names) if operator == TokenKind.Assign
                        Stmt.If(_, then_body, else_body, _):
                            ewr_collect_local_names(then_body, names)
                            ewr_collect_local_names(else_body, names)
                        Stmt.Block(_, _, binding, body, _):
                            names.push(binding) if binding != ""
                            ewr_collect_local_names(body, names)
                        Stmt.While(_, body, _):
                            ewr_collect_local_names(body, names)
                        Stmt.For(_, variables, _, body, _):
                            for variable in variables |names|:
                                names.push(variable)
                            ewr_collect_local_names(body, names)
                        Stmt.Match(_, arms, _):
                            for arm in arms |names|:
                                collect_pattern_binding_names(arm.pattern, names)
                                ewr_collect_local_names(arm.body, names)
                        _:
                            pass

        # Resolve only actual arguments bound to formals that carry R. Other callback or
        # value parameters cannot accidentally supply R or make a valid binding ambiguous.
        def ewr_arg_family(file: Ast::File&, arguments: darray[Ast::Expr], argument_names: darray[sview @source], parameters: darray[Ast::ParamDecl], caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], wrapper: EwrFamilyRef, errorset_name: sview, return_occurrence_offset: u32, all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, caller_module: sview @source, caller_module_known: bool) -> (known: bool, families: darray[EwrFamilyRef]):
            can Memory.Allocate, Abort.Panic:
                families: mutable darray[EwrFamilyRef] = []
                saw_errorset_parameter: mutable bool = false
                for parameter_index in 0..<parameters.count |families, saw_errorset_parameter, arguments, argument_names, parameters, caller_parameters, caller_local_names, wrapper, errorset_name, return_occurrence_offset, all_declarations, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known|:
                    continue if not ewr_parameter_carries_errorset(parameters, parameter_index, wrapper, errorset_name, return_occurrence_offset, annotations)
                    saw_errorset_parameter <- true
                    actual_argument: (argument: Ast::Expr?, from_default: bool) = ewr_argument_for_parameter(arguments, argument_names, parameters, parameter_index)
                    if actual_argument.argument is argument:
                        return (false, []) if not actual_argument.from_default and ewr_expression_is_shadowed_by_parameter(argument, caller_parameters)
                        return (false, []) if not actual_argument.from_default and ewr_expression_name_is_local(argument, caller_local_names)
                        binding_module: sview @source = wrapper.function_module if actual_argument.from_default else caller_module
                        binding_module_known: bool = wrapper.function_module_known if actual_argument.from_default else caller_module_known
                        resolved: (known: bool, family: EwrFamilyRef) = ewr_concrete_family_of_expression(file, argument, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, binding_module, binding_module_known, caller_parameters, caller_local_names)
                        return (false, []) if not resolved.known
                        families.push(resolved.family) if resolved.family.family != ""
                    else:
                        return (false, [])
                return (false, []) if not saw_errorset_parameter
                return (true, families)

        def ewr_family_row_matches_ref(annotations: darray[Ast::EnumAnnotation]&, row_index: usize, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not family.has_family_row or row_index + 1.usize() >= annotations.count
                family_row: Ast::EnumAnnotation = annotations[row_index]
                expected_source_name: sview = family.source_name if family.source_name != "" else family.family
                return false if family_row.owner != "__error_set_family" or family_row.name != expected_source_name or family_row.line != family.declaration_line or family_row.offset != family.declaration_offset or family_row.identity_id != family.declaration_identity_id or family_row.occurrence_offset != family.occurrence_offset
                path_row: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                return false if path_row.owner != "__error_set_family_path" or path_row.line != family_row.line or path_row.offset != family_row.offset or path_row.identity_id != family_row.identity_id or path_row.occurrence_offset != family_row.occurrence_offset
                candidate_ref: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, family_row, path_row.name, family.function_module_known, family.function_module, table)
                return candidate_ref.family == family.family and candidate_ref.module_known == family.module_known and candidate_ref.module == family.module

        def ewr_subset_marker_matches_family(annotations: darray[Ast::EnumAnnotation]&, marker_index: usize, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if marker_index >= annotations.count
                marker: Ast::EnumAnnotation = annotations[marker_index]
                return false if marker.owner != "__error_variant_family" or marker.name != family.family or marker.line != family.declaration_line or marker.offset != family.declaration_offset or marker.identity_id != family.declaration_identity_id or marker.occurrence_offset != family.occurrence_offset
                for row_index in 0..<annotations.count |annotations, marker_index, family, marker, table|:
                    continue if not ewr_family_row_matches_ref(annotations, row_index, family, table)
                    continue if marker_index <= row_index + 1.usize()
                    cursor: mutable usize = row_index + 2.usize()
                    while cursor < marker_index |cursor, annotations, marker_index, family|:
                        break if annotations[cursor].owner == "__error_set_family"
                        cursor <- cursor + 1.usize()
                    return true if cursor == marker_index
                return false

        def ewr_family_path_metadata_valid(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return ewr_family_row_matches_ref(annotations, family.family_row_index, family, table)

        # A marker at the declaration position makes the occurrence restricted even when its
        # identity is malformed. Allows are accepted only for the exact declaration identity.
        def ewr_family_is_restricted(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                for marker_index in 0..<annotations.count |annotations, family, table|:
                    return true if ewr_subset_marker_matches_family(annotations, marker_index, family, table)
                return false
