# A local `VarDecl` whose binding type resolves to `void` is rejected: `void` is not a
# bindable type. Covers a plain `x: void` and single-element containers whose element is
# void (`darray[void]`, `set[void]`) — the parser models both as `Index(Ident(head), Ident("void"))`.
# Reported at the variable declaration.
#
# Purely syntactic: `void` is a reserved primitive name, so no type inference is needed — a
# literal `void` in binding position can never be a user type shadowing it.
extend Semantic:
    private:
        # Whether a VarDecl type annotation binds `void`: either `void` itself, or a
        # single-argument container (`darray[void]`/`set[void]`) whose element is `void`.
        def vb_binds_void(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                if type_expression is Expr.Ident(name, ident_line):
                    return name == "void"
                if type_expression is Expr.Index(object, index, index_line):
                    if index is Expr.Ident(element_name, element_line):
                        return element_name == "void"
                return false

        def vb_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidNotBindable, name: name, line: line.line, expected: "", actual: ""}) if vb_binds_void(type_expression)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- vb_check_statements(then_body, table)
                            table <- vb_check_statements(else_body, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- vb_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- vb_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- vb_check_statements(body, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- vb_check_statements(arm.body, table)
                        _:
                            pass

        def vb_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- vb_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- vb_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- vb_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_void_bindable(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- vb_check_declarations(file.top_decls, table)
