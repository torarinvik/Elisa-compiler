extend Semantic:
    private:
        # Stage1 semantic layer — symbol collection (internal helpers, module-private).
        #
        # Walk the declaration tree (File.top_decls and each Module's body), collecting every
        # top-level and module-scoped declaration into a SymbolTable and flagging duplicates.
        # Each child list is a `darray` side-table on its node's payload (docs/76), so we walk
        # it directly with `match` — no flat store, no index ranges.


        # FNV-1a hash of a name's bytes — the key into the SymbolTable name index. u64
        # multiplication wraps (unsigned), which is the intended hashing behavior.
        def name_hash(name: sview) -> u64:
            h: mutable u64 = 14695981039346656037
            for b in name:
                h <- (h ^ b.u64()) * 1099511628211
            return h


        # Whether `name` is already in the table's name index — O(1) expected (one hash probe
        # plus a scan of the tiny collision overflow), replacing an O(n) scan of `symbols`.
        def name_indexed(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                if table.name_primary.get(name_hash(name)) is primary:
                    if primary == name:
                        return true
                # Primary slot empty or holding a different name (a hash collision) — the
                # queried name, if present, is in the overflow list. Must run in BOTH cases,
                # so this is deliberately outside the `if` (no `else`).
                return any n in table.name_overflow where n == name


        # Whether a name is already stored at hash `h` in the primary slot. Read through a
        # const `table` so `dict.get` yields a const (not mutable) interior ref — a mutable
        # `.get` would surface an Unsafe.PointerCast the safe read does not need.
        def hash_occupied(table: SymbolTable&, h: u64) -> bool:
            can Abort.Panic:
                return true if table.name_primary.get(h) is occupant else false
                    
        # Record `name` in the index (idempotent). The first name at a given hash lands in
        # `name_primary`; a colliding different name goes to `name_overflow`.
        def index_name(table: mutable SymbolTable&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name_indexed(table, name)
                h: u64 = name_hash(name)
                # `name` is known-absent (guard above), so an occupied slot here is a different
                # name sharing the hash — a collision that goes to the overflow list.
                if hash_occupied(table, h):
                    table.name_overflow.push(name)
                else:
                    table.name_primary.put(h, name)


        # Seed the table with language builtins and keyword-leaf identifiers that the parser
        # surfaces as bare `Expr.Ident` leaves (`null`, `zeroed`, `sizeof`, `panic`, …) plus the
        # few runtime externs the frontend calls unqualified. These are always in scope, so they
        # must not count as unresolved references.
        def seed_builtins(table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                names: darray[sview] = ["null", "zeroed", "sizeof", "size_of", "alignof", "align_of", "offsetof", "offset_of", "panic", "raise", "abort", "assert", "print", "println", "eprint", "runtime_strlen", "sview", "sview_len", "sview_at", "__fstr"]
                # Push directly into the caller-owned table: a `[... for n in names]`
                # comprehension would build the rows in a short-lived auto-region, and
                # extending the longer-lived table from it trips the region checker.
                for n in names:
                    table.symbols.push(Symbol{name: n, kind: SymbolKind.Unknown, line: 0, arity_min: 0, arity_max: 0})
                    index_name(table, n)


        # Append a symbol into the (flat, whole-program) resolution index. Duplicate
        # DIAGNOSTICS are NOT raised here — a flat index conflates overloads, reopened
        # modules, and cross-module names; duplicate detection is done per-scope by
        # check_scope_duplicates instead. This just makes every declared name resolvable.
        def add_symbol(table: mutable SymbolTable&, name: sview, kind: SymbolKind, line: u32, arity_min: u32 = 0, arity_max: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                table.symbols.push(Symbol{name: name, kind: kind, line: line, arity_min: arity_min, arity_max: arity_max})
                index_name(table, name)


        # Count the statements in `stmts`, recursing into nested blocks and match arms.
        def count_stmts(stmts: darray[Ast::Stmt], table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    table.statements <- table.statements + 1
                    match stmt:
                        Stmt.If(cond, then_body, else_body, line):
                            count_stmts(then_body, table)
                            count_stmts(else_body, table)
                        Stmt.While(cond, body, line):
                            count_stmts(body, table)
                        Stmt.For(bind, vars, iter, body, line):
                            count_stmts(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            count_stmts(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                count_stmts(arm.body, table)
                        # Leaf statements with no nested block. Explicit (no wildcard) so a new
                        # Stmt variant forces a decision here rather than being silently uncounted.
                        Stmt.Invalid:
                            pass
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.VarDecl(name, type_expr, value, line):
                            pass
                        Stmt.Assign(target, op, value, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Conservative structural equality over the small set of type-expression forms
        # that appear in signatures (`i64`, `Mod::T`, `darray[T]`, `mutable T&`, …).
        # Any form not modeled here compares UNequal — so two signatures are only ever
        # judged identical when we are certain, keeping overloads (judged distinct) from
        # being flagged as duplicates.
        def same_type_expr(a: Ast::Expr, b: Ast::Expr) -> bool:
            can Abort.Panic:
                result: mutable bool = false
                match a:
                    Ast::Expr.Ident(an, aline):
                        match b:
                            Ast::Expr.Ident(bn, bline):
                                result <- an == bn
                            _:
                                pass
                    Ast::Expr.Scope(abase, aname, aline):
                        match b:
                            Ast::Expr.Scope(bbase, bname, bline):
                                result <- aname == bname and same_type_expr(abase, bbase)
                            _:
                                pass
                    Ast::Expr.Index(aobj, aidx, aline):
                        match b:
                            Ast::Expr.Index(bobj, bidx, bline):
                                result <- same_type_expr(aobj, bobj) and same_type_expr(aidx, bidx)
                            _:
                                pass
                    Ast::Expr.Unary(aop, aoperand, aline):
                        match b:
                            Ast::Expr.Unary(bop, boperand, bline):
                                result <- aop == bop and same_type_expr(aoperand, boperand)
                            _:
                                pass
                    Ast::Expr.Paren(ainner, aline):
                        match b:
                            Ast::Expr.Paren(binner, bline):
                                result <- same_type_expr(ainner, binner)
                            _:
                                pass
                    _:
                        pass
                return result


        # Two parameter lists have identical types (names/mutability/defaults ignored —
        # they are not part of a function's signature for overload purposes).
        def same_params(pa: darray[Ast::ParamDecl]&, pb: darray[Ast::ParamDecl]&) -> bool:
            can Abort.Panic:
                if pa.count != pb.count:
                    return false
                i: mutable usize = 0
                while i < pa.count:
                    if not same_type_expr(pa[i].type_expr, pb[i].type_expr):
                        return false
                    i <- i + 1
                return true


        # Optional return-type equality (both absent == equal; one absent == unequal).
        def same_ret_type(a: Ast::Expr?, b: Ast::Expr?) -> bool:
            can Abort.Panic:
                result: mutable bool = false
                if a is av:
                    if b is bv:
                        result <- same_type_expr(av, bv)
                else:
                    if not (b is bv2):
                        result <- true
                return result


        # Whether two Func decls share a signature (params + return type). Same name +
        # same signature == a real duplicate; a different signature is a legal overload.
        def func_decls_same_sig(a: Ast::Decl, b: Ast::Decl) -> bool:
            can Abort.Panic:
                result: mutable bool = false
                match a:
                    Ast::Decl.Func(an, ap, art, abody, aeff, adec, aline):
                        match b:
                            Ast::Decl.Func(bn, bp, brt, bbody, beff, bdec, bline):
                                result <- same_params(ap, bp) and same_ret_type(art, brt)
                            _:
                                pass
                    _:
                        pass
                return result


        # Duplicate-detection category of a decl: 1 = TYPE namespace (struct/enum — these
        # cannot overload or reopen), 2 = FUNCTION namespace (overloadable by signature),
        # 0 = skipped. Const/Alias/Module/Import/Extern/Law are skipped: they legitimately
        # repeat via `static if` conditional branches, module reopening, associated-type
        # aliases, extern forward decls, or imports — none of which stage1 can currently
        # distinguish from a true redefinition, so flagging them would be a false positive.
        def decl_dup_category(d: Ast::Decl) -> int:
            can Abort.Panic:
                result: mutable int = 0
                match d:
                    Ast::Decl.Struct(name, members, affinity, line):
                        result <- 1
                    Ast::Decl.Enum(name, variants, line):
                        result <- 1
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, line):
                        result <- 2
                    _:
                        pass
                return result


        # Declared name of a decl (empty for Invalid).
        def decl_dup_name(d: Ast::Decl) -> sview:
            can Abort.Panic:
                result: mutable sview = ""
                match d:
                    Ast::Decl.Struct(name, members, affinity, line):
                        result <- name
                    Ast::Decl.Enum(name, variants, line):
                        result <- name
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, line):
                        result <- name
                    _:
                        pass
                return result


        # Source line of a decl (0 for Invalid).
        def decl_dup_line(d: Ast::Decl) -> u32:
            can Abort.Panic:
                result: mutable u32 = 0
                match d:
                    Ast::Decl.Struct(name, members, affinity, line):
                        result <- line
                    Ast::Decl.Enum(name, variants, line):
                        result <- line
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, line):
                        result <- line
                    _:
                        pass
                return result


        # Per-scope duplicate detection over ONE declaration list (top-level, or a single
        # module body). Only compares decls WITHIN this scope, so a name reused across
        # different modules (`Lexer::get` vs `Parser::get`) never collides. A type
        # redeclaration is always a duplicate; two same-named functions are a duplicate
        # only when their signatures match (an overload is not). Reported at the second
        # occurrence's line.
        def check_scope_duplicates(decls: darray[Ast::Decl]&, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                i: mutable usize = 0
                while i < decls.count:
                    di: Ast::Decl = decls[i]
                    icat: int = decl_dup_category(di)
                    iname: sview = decl_dup_name(di)
                    if icat != 0 and iname != "":
                        j: mutable usize = 0
                        is_dup: mutable bool = false
                        while j < i:
                            dj: Ast::Decl = decls[j]
                            if not is_dup and decl_dup_category(dj) == icat and decl_dup_name(dj) == iname:
                                if icat == 1:
                                    is_dup <- true
                                elif func_decls_same_sig(di, dj):
                                    is_dup <- true
                            j <- j + 1
                        if is_dup:
                            table.duplicates <- table.duplicates + 1
                            # Types (category 1) and functions (2) use distinct messages,
                            # matching stage0's `duplicate type` vs `duplicate declaration`.
                            dkind: mutable DiagnosticKind = DiagnosticKind.DuplicateDecl
                            if icat == 1:
                                dkind <- DiagnosticKind.DuplicateType
                            table.diagnostics.push(Diagnostic{kind: dkind, name: iname, line: decl_dup_line(di), expected: "", actual: ""})
                    i <- i + 1


        # Collect the declarations in `decls` into `table`, recursing into module bodies. The
        # element type is Decl, so the match handles exactly Decl's variants directly — no Node
        # subtype-narrowing and no wildcard category arm.
        def collect_range(decls: darray[Ast::Decl], table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                # Duplicate detection is PER-SCOPE (this decl list only); name resolution's
                # global index is built separately by add_symbol below.
                check_scope_duplicates(decls, table)
                for decl in decls:
                    match decl:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            required: mutable u32 = 0
                            for p in params:
                                if not p.has_default:
                                    required <- required + 1
                            table.add_symbol(name, SymbolKind.Func, line, required, params.count.u32())
                            count_stmts(body, table)
                        Decl.Struct(name, members, affinity, line):
                            table.add_symbol(name, SymbolKind.Struct, line)
                            # Duplicate field names within the struct (parity with stage0).
                            seen_fields: mutable darray[sview] = []
                            seen_required: mutable darray[bool] = []
                            # An anonymous/positional member means the parser could not
                            # fully model this struct's field set — leave it UNregistered
                            # so UnknownField bails rather than flagging against a partial
                            # set (sound: only cleanly-named structs get a closed set).
                            has_anon: mutable bool = false
                            for m in members:
                                # Skip anonymous/positional members (empty name) so two of them
                                # never collide as a spurious duplicate.
                                if m.name == "":
                                    has_anon <- true
                                    continue
                                dup_f: mutable bool = false
                                for sf in seen_fields:
                                    if sf == m.name:
                                        dup_f <- true
                                if dup_f:
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateField, name: m.name, line: line, expected: name, actual: ""})
                                else:
                                    seen_fields.push(m.name)
                                    seen_required.push(not m.omittable)
                            # Record the named fields for UnknownField / MissingField
                            # construction checks, but only when every member was cleanly
                            # named (so the field set is known-complete).
                            if not has_anon:
                                fi: mutable usize = 0
                                while fi < seen_fields.count:
                                    table.struct_field_owner.push(name)
                                    table.struct_field_name.push(seen_fields[fi])
                                    table.struct_field_required.push(seen_required[fi])
                                    fi <- fi + 1
                        Decl.Enum(name, variants, line):
                            table.add_symbol(name, SymbolKind.Enum, line)
                            seen_variants: mutable darray[sview] = []
                            for v in variants:
                                # Duplicate variant names within the enum (parity with stage0).
                                dup_v: mutable bool = false
                                for sv in seen_variants:
                                    if sv == v.name:
                                        dup_v <- true
                                if dup_v:
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateVariant, name: v.name, line: line, expected: name, actual: ""})
                                else:
                                    seen_variants.push(v.name)
                                table.enum_variant_owner.push(name)
                                table.enum_variant_name.push(v.name)
                                table.enum_variant_arity.push(v.fields.count.u32())
                        Decl.Const(name, type_expr, value, is_mutable, line):
                            table.add_symbol(name, SymbolKind.Const, line)
                            if not is_mutable:
                                table.immutable_const_names.push(name)
                        Decl.Alias(name, target, line):
                            table.add_symbol(name, SymbolKind.Alias, line)
                        Decl.Law(name, predicate, line):
                            table.add_symbol(name, SymbolKind.Law, line)
                        Decl.Import(module_path, line):
                            table.add_symbol(module_path, SymbolKind.Import, line)
                        Decl.Extern(name, line):
                            table.add_symbol(name, SymbolKind.Extern, line)
                        Decl.Module(name, body, line):
                            table.add_symbol(name, SymbolKind.Module, line)
                            collect_range(body, table)
                        Decl.Scoped(body, line):
                            # A static-if branch or impl body: an isolated scope. Register
                            # its decls for resolution, but its own duplicate detection runs
                            # in isolation, so same-name decls in sibling scopes (other
                            # branches / other impls) never collide.
                            collect_range(body, table)
                        Decl.Invalid:
                            pass
