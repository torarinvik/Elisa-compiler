# Refine-alias binder-position restriction (stage0 analyzer_named_refinement_alias). A `refine X =
# T where P` alias may appear ONLY as the DIRECT type of a binder (parameter, return, or local
# declaration); using it as a struct field type, or nested inside a container (`darray[X]`), is
# rejected ("refine alias X may only be used in a binder position ...").
#
# The parser records refine-alias names (owner "__refine_alias"). SOUND subset: a struct field type
# that mentions a refine alias (fields are never binders), or a param/return/local type that
# mentions a refine alias NESTED (the bare direct type is the one allowed binder use).
extend Semantic:
    private:
        def is_refine_alias(refine_names: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any refine_name in refine_names where refine_name == name

        # The refine-alias name mentioned anywhere in a type expression, else "".
        def type_mentions_refine_alias(type_expression: Ast::Expr, refine_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return name if is_refine_alias(refine_names, name) else sview("", 0, 0)
                    Expr.Unary(operator, operand, line):
                        return type_mentions_refine_alias(operand, refine_names)
                    Expr.Paren(inner, line):
                        return type_mentions_refine_alias(inner, refine_names)
                    Expr.Index(head, argument, line):
                        head_hit: sview = type_mentions_refine_alias(head, refine_names)
                        return head_hit if head_hit != "" else type_mentions_refine_alias(argument, refine_names)
                    Expr.IndexN(head, arguments, line):
                        head_hit: sview = type_mentions_refine_alias(head, refine_names)
                        head_hit return if head_hit != ""
                        argument_hit: mutable sview = sview("", 0, 0)
                        for argument in arguments |argument_hit|:
                            candidate: sview = type_mentions_refine_alias(argument, refine_names)
                            argument_hit <- candidate if argument_hit == "" and candidate != ""
                        return argument_hit
                    _:
                        return sview("", 0, 0)

        # The refine-alias name used as a CONTAINER ELEMENT (`darray[X]`, `dict[K, X]`) anywhere in
        # a type — looking through mutable/&/?/paren wrappers to find a container. A DIRECT binder
        # (`n: X`, `n: mutable X&`, `n: X?`) is NOT a container element and is allowed; only nesting
        # inside an Index/IndexN argument is illegal in a binder position.
        def refine_alias_container_element(type_expression: Ast::Expr, refine_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return refine_alias_container_element(operand, refine_names)
                    Expr.Paren(inner, line):
                        return refine_alias_container_element(inner, refine_names)
                    Expr.Index(head, argument, line):
                        return type_mentions_refine_alias(argument, refine_names)
                    Expr.IndexN(head, arguments, line):
                        argument_hit: mutable sview = sview("", 0, 0)
                        for argument in arguments |argument_hit|:
                            candidate: sview = type_mentions_refine_alias(argument, refine_names)
                            argument_hit <- candidate if argument_hit == "" and candidate != ""
                        return argument_hit
                    _:
                        return sview("", 0, 0)

        # A pure refine-alias argument: an identifier, literal, field path, or signed literal.
        def is_pure_refine_arg(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(name, line): true
                    Expr.IntLit(value): true
                    Expr.FloatLit(text): true
                    Expr.StringLit(text): true
                    Expr.CharLit(text): true
                    Expr.BoolLit(value): true
                    Expr.Field(object, field, line): is_pure_refine_arg(object)
                    Expr.Paren(inner, line): is_pure_refine_arg(inner)
                    Expr.Unary(operator, operand, line): is_pure_refine_arg(operand) if operator == TokenKind.Minus or operator == TokenKind.Plus else false
                    _: false

        # Whether a type carries a refine-alias APPLICATION `Alias[arg]` with an impure/complex arg
        # (e.g. `BoundedBy[darray[i64]]`). Looks through mutable/&/?/paren wrappers.
        def refine_alias_impure_arg(type_expression: Ast::Expr, refine_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return refine_alias_impure_arg(operand, refine_names)
                    Expr.Paren(inner, line):
                        return refine_alias_impure_arg(inner, refine_names)
                    Expr.Index(head, argument, line):
                        return is_refine_alias(refine_names, ident_name_of(head)) and not is_pure_refine_arg(argument)
                    Expr.IndexN(head, arguments, line):
                        head_is_refine: bool = is_refine_alias(refine_names, ident_name_of(head))
                        return head_is_refine and (any argument in arguments where not is_pure_refine_arg(argument))
                    _:
                        return false

        # A refine alias used as a `.cast[Alias]` target is an ordinary-type (non-binder)
        # position: `x.cast[Positive]` reinterprets a value AS the refinement without a checked
        # binder. Walk value expressions for `recv.cast[Ident]` where Ident is a refine alias.
        def refine_alias_cast_walk(expression: Ast::Expr, refine_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index, index_line):
                        if object is Expr.Field(cast_receiver, cast_field, cast_field_line):
                            if cast_field == "cast":
                                if index is Expr.Ident(type_name, type_name_line):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasNonBinder, name: type_name, pos: index_line, line: index_line.line, expected: "", actual: ""}) if is_refine_alias(refine_names, type_name)
                        table <- refine_alias_cast_walk(object, refine_names, table)
                        table <- refine_alias_cast_walk(index, refine_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- refine_alias_cast_walk(left, refine_names, table)
                        table <- refine_alias_cast_walk(right, refine_names, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- refine_alias_cast_walk(operand, refine_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- refine_alias_cast_walk(inner, refine_names, table)
                    Expr.Field(field_object, field_name, field_line):
                        table <- refine_alias_cast_walk(field_object, refine_names, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- refine_alias_cast_walk(callee, refine_names, table)
                        for argument in arguments |table| -> table:
                            table <- refine_alias_cast_walk(argument, refine_names, table)
                    _:
                        pass

        def refine_binder_walk_body(statements: darray[Ast::Stmt], refine_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            nested_alias: sview = refine_alias_container_element(type_expression, refine_names)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasNonBinder, name: nested_alias, line: line.line, expected: "", actual: ""}) if nested_alias != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasImpureArg, name: "", line: line.line, expected: "", actual: ""}) if refine_alias_impure_arg(type_expression, refine_names)
                            table <- refine_alias_cast_walk(value, refine_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- refine_alias_cast_walk(value, refine_names, table)
                        Stmt.Expr(expression, line):
                            table <- refine_alias_cast_walk(expression, refine_names, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- refine_alias_cast_walk(returned, refine_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- refine_binder_walk_body(then_body, refine_names, table)
                            table <- refine_binder_walk_body(else_body, refine_names, table)
                        Stmt.While(condition, while_body, line):
                            table <- refine_binder_walk_body(while_body, refine_names, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- refine_binder_walk_body(for_body, refine_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- refine_binder_walk_body(body, refine_names, table)
                        _:
                            pass

        def check_refine_alias_binder_walk(declarations: darray[Ast::Decl], refine_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # Param/return: nested refine-alias use is illegal (a bare one is the binder).
                            for parameter in parameters |table| -> table:
                                param_nested: sview = refine_alias_container_element(parameter.type_expression, refine_names)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasNonBinder, name: param_nested, line: line.line, expected: "", actual: ""}) if param_nested != ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasImpureArg, name: "", line: line.line, expected: "", actual: ""}) if refine_alias_impure_arg(parameter.type_expression, refine_names)
                            if return_type is return_type_expression:
                                return_nested: sview = refine_alias_container_element(return_type_expression, refine_names)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasNonBinder, name: return_nested, line: line.line, expected: "", actual: ""}) if return_nested != ""
                            table <- refine_binder_walk_body(body, refine_names, table)
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, line):
                            # A struct field is never a binder: ANY refine-alias mention is illegal.
                            for member in members |table| -> table:
                                field_alias: sview = type_mentions_refine_alias(member.type_expression, refine_names)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefineAliasNonBinder, name: field_alias, line: line.line, expected: "", actual: ""}) if field_alias != ""
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_refine_alias_binder_walk(module_body, refine_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_refine_alias_binder_walk(scoped_body, refine_names, table)
                        _:
                            pass

        def check_refine_alias_binder(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                refine_names: mutable darray[sview] = []
                for annotation in file.enum_annotations |refine_names|:
                    refine_names.push(annotation.name) if annotation.owner == "__refine_alias"
                table <- check_refine_alias_binder_walk(file.top_decls, refine_names, table) if refine_names.count > 0
