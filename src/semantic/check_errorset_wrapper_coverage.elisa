# Error-set wrapper return analysis.
extend Semantic:
    private:
        def ewr_variant_allowed(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, variant: sview, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return variant == family.variant_override and ewr_family_path_metadata_valid(annotations, family, table) if family.variant_override != ""
                subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, family, table)
                return false if not subset.valid
                return true if not subset.restricted
                return false if not subset.has_allowed
                for marker_index in 0..<annotations.count |annotations, family, variant, table|:
                    continue if not ewr_subset_marker_matches_family(annotations, marker_index, family, table)
                    marker: Ast::EnumAnnotation = annotations[marker_index]
                    return false if not ewr_family_path_metadata_valid(annotations, family, table) or marker.identity_id != family.declaration_identity_id or marker_index + 1.usize() >= annotations.count
                    allow: Ast::EnumAnnotation = annotations[marker_index + 1.usize()]
                    if allow.owner == "__error_variant_allow" and allow.line == marker.line and allow.offset == marker.offset and allow.identity_id == marker.identity_id and allow.occurrence_offset == marker.occurrence_offset and allow.name == variant:
                        return true
                return false

        # Read one adjacent family/path row's marker/allow payload. Repeated family rows
        # are unioned by ewr_family_subset_state below.
        def ewr_family_row_subset_state(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, family_row_index: usize, table: mutable SymbolTable&) -> (valid: bool, restricted: bool, has_allowed: bool):
            can Abort.Panic:
                return (false, false, false) if not ewr_family_row_matches_ref(annotations, family_row_index, family, table)
                scan: mutable usize = family_row_index + 2.usize()
                restricted: mutable bool = false
                has_allowed: mutable bool = false
                marker_count: mutable usize = 0.usize()
                allow_count: mutable usize = 0.usize()
                while scan < annotations.count |scan, annotations, family, restricted, has_allowed, marker_count, allow_count|:
                    row: Ast::EnumAnnotation = annotations[scan]
                    break if row.owner == "__error_set_family"
                    # The parser closes the subset payload with a canonical key
                    # before emitting module and return metadata for this occurrence.
                    break if row.owner == "__error_set_key" and row.line == family.declaration_line and row.offset == family.declaration_offset and row.identity_id == family.declaration_identity_id and row.occurrence_offset == family.occurrence_offset
                    break if row.name == "__error_return" and row.line == family.declaration_line and row.offset == family.declaration_offset and row.identity_id == family.declaration_identity_id
                    if row.owner == "__error_variant_family":
                        restricted <- true
                        marker_count <- marker_count + 1.usize()
                        return (false, true, has_allowed) if row.name != family.family or row.line != family.declaration_line or row.offset != family.declaration_offset or row.identity_id != family.declaration_identity_id or row.occurrence_offset != family.occurrence_offset
                        if scan + 1.usize() < annotations.count and annotations[scan + 1.usize()].owner == "__error_variant_allow":
                            allow: Ast::EnumAnnotation = annotations[scan + 1.usize()]
                            return (false, true, has_allowed) if allow.line != row.line or allow.offset != row.offset or allow.identity_id != row.identity_id or allow.occurrence_offset != row.occurrence_offset or allow.name == ""
                            has_allowed <- true
                            allow_count <- allow_count + 1.usize()
                            scan <- scan + 2.usize()
                        else:
                            # The only well-formed marker-only shape is one empty-set
                            # marker immediately before the next family or end of rows.
                            return (false, true, has_allowed) if marker_count != 1.usize() or allow_count != 0.usize()
                            next_is_boundary: mutable bool = scan + 1.usize() >= annotations.count
                            if scan + 1.usize() < annotations.count:
                                next_row: Ast::EnumAnnotation = annotations[scan + 1.usize()]
                                next_is_boundary <- next_row.owner == "__error_set_family" or ((next_row.owner == "__error_set_key" or next_row.name == "__error_return") and next_row.line == family.declaration_line and next_row.offset == family.declaration_offset and next_row.identity_id == family.declaration_identity_id and next_row.occurrence_offset == family.occurrence_offset)
                            return (true, true, false) if next_is_boundary
                            return (false, true, false)
                    elif row.owner == "__error_variant_allow":
                        return (false, restricted, has_allowed)
                    elif restricted:
                        return (false, true, has_allowed)
                    else:
                        scan <- scan + 1.usize()
                return (true, restricted, has_allowed) if marker_count == allow_count or not restricted
                return (false, restricted, has_allowed)

        # Parser subset rows are stored as marker/allow pairs after each family/path
        # pair. Union repeated same-family/path occurrences on the same return clause:
        # an unrestricted row covers the full family; otherwise allowed variants add.
        # A marker-only `Fault{}` remains a primary type error and stays neutral here.
        def ewr_family_subset_state(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, table: mutable SymbolTable&) -> (valid: bool, restricted: bool, has_allowed: bool):
            can Abort.Panic:
                return (true, true, true) if family.variant_override != "" and ewr_family_path_metadata_valid(annotations, family, table)
                return (false, false, false) if not ewr_family_path_metadata_valid(annotations, family, table)
                family_count: mutable usize = 0.usize()
                saw_restricted: mutable bool = false
                saw_unrestricted: mutable bool = false
                has_allowed: mutable bool = false
                for row_index in 0..<annotations.count |family_count, saw_restricted, saw_unrestricted, has_allowed, annotations, family, table|:
                    continue if not ewr_family_row_matches_ref(annotations, row_index, family, table)
                    family_count <- family_count + 1.usize()
                    row_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_row_subset_state(annotations, family, row_index, table)
                    return (false, row_subset.restricted, has_allowed or row_subset.has_allowed) if not row_subset.valid
                    saw_restricted <- true if row_subset.restricted
                    saw_unrestricted <- true if not row_subset.restricted
                    has_allowed <- true if row_subset.has_allowed
                return (false, false, false) if family_count == 0.usize()
                return (true, saw_restricted and not saw_unrestricted, has_allowed)

        def ewr_family_covers(annotations: darray[Ast::EnumAnnotation]&, source: EwrFamilyRef, destination: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not source.module_known or not destination.module_known
                source_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, source, table)
                return true if not source_subset.valid
                # `error[Fault{}]` is rejected by check_empty_error_set_subset. It has no
                # defined propagation family, so suppress only this pass's second opinion.
                return true if source_subset.restricted and not source_subset.has_allowed
                destination_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, destination, table)
                return true if not destination_subset.valid or (destination_subset.restricted and not destination_subset.has_allowed)
                saw_source_tag: mutable bool = false
                for variant_index in 0..<table.enum_variant_owner.count |saw_source_tag, source, destination, annotations, table|:
                    belongs_to_source: bool = table.enum_variant_owner[variant_index] == source.family and variant_index < table.enum_variant_module.count and table.enum_variant_module[variant_index] == source.module
                    if belongs_to_source and ewr_variant_allowed(annotations, source, table.enum_variant_name[variant_index], table):
                        saw_source_tag <- true
                        destination_has_tag: mutable bool = false
                        for destination_index in 0..<table.enum_variant_owner.count |destination_has_tag, source, destination, annotations, table, variant_index|:
                            belongs_to_destination: bool = table.enum_variant_owner[destination_index] == destination.family and destination_index < table.enum_variant_module.count and table.enum_variant_module[destination_index] == destination.module
                            destination_has_tag <- true if belongs_to_destination and table.enum_variant_name[destination_index] == table.enum_variant_name[variant_index] and ewr_variant_allowed(annotations, destination, table.enum_variant_name[destination_index], table)
                        return false if not destination_has_tag
                return saw_source_tag

        # Match each concrete source tag against the complete declared destination
        # union, as Core's MatchErrorTag does: an exact family/module/tag wins; absent
        # that, exactly one allowed destination tag may share its short name.
        def ewr_family_covers_destination_union(annotations: darray[Ast::EnumAnnotation]&, source: EwrFamilyRef, destinations: darray[EwrFamilyRef]&, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not source.module_known
                source_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, source, table)
                return true if not source_subset.valid or (source_subset.restricted and not source_subset.has_allowed)
                for destination in destinations |annotations, source|:
                    return true if destination.family == "" or not destination.module_known
                    destination_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, destination, table)
                    return true if not destination_subset.valid or (destination_subset.restricted and not destination_subset.has_allowed)
                saw_source_tag: mutable bool = false
                for source_index in 0..<table.enum_variant_owner.count |saw_source_tag, source, destinations, annotations, table|:
                    continue if source_index >= table.enum_variant_name.count or source_index >= table.enum_variant_module.count
                    continue if table.enum_variant_owner[source_index] != source.family or table.enum_variant_module[source_index] != source.module
                    if ewr_variant_allowed(annotations, source, table.enum_variant_name[source_index], table):
                        saw_source_tag <- true
                        exact_destination_match: mutable bool = false
                        short_destination_matches: mutable usize = 0.usize()
                        for candidate_index in 0..<table.enum_variant_owner.count |exact_destination_match, short_destination_matches, source, destinations, annotations, table, source_index|:
                            continue if candidate_index >= table.enum_variant_name.count or candidate_index >= table.enum_variant_module.count
                            duplicate_tag: mutable bool = false
                            for prior_index in 0..<candidate_index |duplicate_tag, table, candidate_index|:
                                continue if prior_index >= table.enum_variant_name.count or prior_index >= table.enum_variant_module.count
                                duplicate_tag <- true if table.enum_variant_owner[prior_index] == table.enum_variant_owner[candidate_index] and table.enum_variant_module[prior_index] == table.enum_variant_module[candidate_index] and table.enum_variant_name[prior_index] == table.enum_variant_name[candidate_index]
                            continue if duplicate_tag
                            candidate_allowed: mutable bool = false
                            for destination in destinations |candidate_allowed, annotations, table, candidate_index|:
                                continue if destination.family != table.enum_variant_owner[candidate_index] or destination.module != table.enum_variant_module[candidate_index]
                                candidate_allowed <- true if ewr_variant_allowed(annotations, destination, table.enum_variant_name[candidate_index], table)
                            continue if not candidate_allowed or table.enum_variant_name[candidate_index] != table.enum_variant_name[source_index]
                            short_destination_matches <- short_destination_matches + 1.usize()
                            exact_destination_match <- true if table.enum_variant_owner[candidate_index] == source.family and table.enum_variant_module[candidate_index] == source.module
                        return false if not exact_destination_match and short_destination_matches != 1.usize()
                return saw_source_tag

        def ewr_destination_covers(annotations: darray[Ast::EnumAnnotation]&, actual: EwrFamilyRef, destination: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if actual.family == "" or destination.family == ""
                return ewr_family_covers(annotations, actual, destination, table)

        # The caller's first declared error family (for the diagnostic), or "".
        def ewr_declared_first(annotations: darray[Ast::EnumAnnotation]&, function_line: u32, function_offset: u32, occurrence_offset: u32, identity_id: u32) -> sview:
            first: mutable sview = ""
            for row in annotations |first, function_line, function_offset, occurrence_offset, identity_id|:
                first <- row.name if first == "" and row.owner == "__error_set_family" and row.line == function_line and row.offset == function_offset and row.identity_id == identity_id and row.occurrence_offset == occurrence_offset
            return first

        # Return the first actual family not covered by the caller's declared set. A caller with
        # NO declared set is treated as covering (a distinct diagnostic handles that shape).
        # Keeping each contributor separate preserves unions from multiple R-bearing formals.
        def ewr_first_uncovered_family(annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, function_line: u32, function_offset: u32, occurrence_offset: u32, return_identity_id: u32, actuals: darray[EwrFamilyRef]) -> sview:
            can Memory.Allocate, Abort.Panic:
                caller_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, function_offset, function_line)
                caller_module_known: bool = fallible_fn_module_known(module_annotations, function_offset, function_line)
                for actual in actuals:
                    has_family: mutable bool = false
                    unresolved_destination: mutable bool = false
                    destinations: mutable darray[EwrFamilyRef] = []
                    for row_index in 0..<annotations.count |has_family, unresolved_destination, destinations, annotations, table, caller_module, caller_module_known, function_line, function_offset, occurrence_offset, return_identity_id, actual|:
                        row: Ast::EnumAnnotation = annotations[row_index]
                        if row.owner == "__error_set_family" and row.line == function_line and row.offset == function_offset and row.identity_id == return_identity_id and row.occurrence_offset == occurrence_offset:
                            has_family <- true
                            family_path: mutable sview @source = ""
                            if row_index + 1.usize() < annotations.count:
                                path_annotation: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                                family_path <- path_annotation.name if path_annotation.owner == "__error_set_family_path" and path_annotation.line == row.line and path_annotation.offset == row.offset and path_annotation.identity_id == row.identity_id and path_annotation.occurrence_offset == row.occurrence_offset
                            path_resolves: bool = ewr_family_path_resolves(family_path, row.name, row.line, row.offset, row.identity_id, caller_module, annotations, table)
                            if not path_resolves:
                                unresolved_destination <- true
                                continue
                            destination_base: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, row, family_path, caller_module_known, caller_module, table)
                            destination: EwrFamilyRef = EwrFamilyRef{family: destination_base.family, family_path: family_path, source_name: destination_base.source_name, variant_override: destination_base.variant_override, module: destination_base.module, module_known: destination_base.module_known, family_row_index: row_index, has_family_row: true, function_name: "", function_module: caller_module, function_module_known: caller_module_known, declaration_line: row.line, declaration_offset: row.offset, declaration_identity_id: row.identity_id, occurrence_offset: row.occurrence_offset}
                            unresolved_destination <- true if not destination.module_known
                            destinations.push(destination) if destination.module_known
                    if has_family:
                        covered: bool = unresolved_destination or ewr_family_covers_destination_union(annotations, actual, destinations, table)
                        return actual.family if not covered
                return ""

        def ewr_check_returned_call(value: Ast::Expr, function_line: u32, function_offset: u32, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, return_markers: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                caller_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, function_offset, function_line)
                caller_module_known: bool = fallible_fn_module_known(module_annotations, function_offset, function_line)
                return_occurrence: (found: bool, ambiguous: bool, occurrence_offset: u32, identity_id: u32) = ewr_return_occurrence(return_markers, function_line, function_offset)
                return if not return_occurrence.found or return_occurrence.ambiguous
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(callee, table)
                        return if not callable.known
                        return if ewr_expression_is_shadowed_by_parameter(callee, caller_parameters)
                        return if ewr_expression_name_is_local(callee, caller_local_names)
                        has_argument_forward: bool = ewr_call_has_argument_forward(annotations, call_line.line, call_line.offset)
                        wrapper: (is_poly: bool, family: EwrFamilyRef, errorset_name: sview @source) = ewr_poly_wrapper(all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, callable.name, callable.qualifier, caller_module, caller_module_known, arguments.count, arguments, argument_names, has_argument_forward, caller_parameters, caller_local_names)
                        if not wrapper.is_poly and wrapper.family.module_known:
                            actual_families: darray[EwrFamilyRef] = [wrapper.family]
                            uncovered: sview = ewr_first_uncovered_family(annotations, table, module_annotations, module_index, function_line, function_offset, return_occurrence.occurrence_offset, return_occurrence.identity_id, actual_families)
                            if uncovered != "":
                                expected: sview = ewr_declared_first(annotations, function_line, function_offset, return_occurrence.occurrence_offset, return_occurrence.identity_id)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryPropagationMismatch, name: uncovered, pos: call_line, line: call_line.line, expected: expected, actual: ""})
                        if wrapper.is_poly:
                            wrapper_signature: (matches: usize, parameters: darray[Ast::ParamDecl]) = ewr_find_function_parameters(all_declarations, wrapper.family, "", annotations, table)
                            return if wrapper_signature.matches != 1.usize()
                            actual: (known: bool, families: darray[EwrFamilyRef]) = ewr_arg_family(arguments, argument_names, wrapper_signature.parameters, caller_parameters, caller_local_names, wrapper.family, wrapper.errorset_name, wrapper.family.occurrence_offset, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known)
                            uncovered: sview = ewr_first_uncovered_family(annotations, table, module_annotations, module_index, function_line, function_offset, return_occurrence.occurrence_offset, return_occurrence.identity_id, actual.families) if actual.known else ""
                            if uncovered != "":
                                expected: sview = ewr_declared_first(annotations, function_line, function_offset, return_occurrence.occurrence_offset, return_occurrence.identity_id)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryPropagationMismatch, name: uncovered, pos: call_line, line: call_line.line, expected: expected, actual: ""})
                    _:
                        pass

        def ewr_walk(statements: darray[Ast::Stmt], function_line: u32, function_offset: u32, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, return_markers: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            table <- ewr_check_returned_call(returned, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- ewr_walk(then_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                            table <- ewr_walk(else_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- ewr_walk(body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.While(condition, while_body, line):
                            table <- ewr_walk(while_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- ewr_walk(for_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- ewr_walk(arm.body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        _:
                            pass

        def ewr_check_declarations(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, return_markers: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            local_names: mutable darray[sview] = []
                            ewr_collect_local_names(body, local_names)
                            table <- ewr_walk(body, line.line, line.offset, parameters, local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- ewr_check_declarations(module_body, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- ewr_check_declarations(scoped_body, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        _:
                            pass

        # Each function's start line paired with its first declared error family, in
        # source order. `return type expects T | Bad, got ...` spells the RETURN TYPE, so
        # the set is the enclosing function's -- not a property of whichever check found
        # the mismatch. Five separate checks emit that sentence, so the pairing is
        # collected once here and applied where the rows leave the table.
        # The annotation table holds every enum annotation of the unit, so it is filtered
        # to the error-set rows ONCE; scanning it per function was ~8% of a self-host compile.
        def collect_function_error_sets(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, lines: mutable darray[u32]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                family_rows: mutable darray[Ast::EnumAnnotation] = []
                return_rows: mutable darray[Ast::EnumAnnotation] = []
                for row in annotations |family_rows, return_rows|:
                    family_rows.push(row) if row.owner == "__error_set_family"
                    return_rows.push(row) if row.name == "__error_return"
                collect_function_error_sets_from(declarations, family_rows, return_rows, lines, names)

        def collect_function_error_sets_from(declarations: darray[Ast::Decl], family_rows: darray[Ast::EnumAnnotation]&, return_rows: darray[Ast::EnumAnnotation]&, lines: mutable darray[u32]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |lines, names, family_rows, return_rows|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            lines.push(line.line)
                            return_occurrence: (found: bool, ambiguous: bool, occurrence_offset: u32, identity_id: u32) = ewr_return_occurrence(return_rows, line.line, line.offset)
                            names.push(ewr_declared_first(family_rows, line.line, line.offset, return_occurrence.occurrence_offset, return_occurrence.identity_id) if return_occurrence.found else "")
                        Decl.Module(module_name, module_body, module_line):
                            collect_function_error_sets_from(module_body, family_rows, return_rows, lines, names)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_function_error_sets_from(scoped_body, family_rows, return_rows, lines, names)
                        _:
                            pass

        # The enclosing function's error set for a `name == "return"` row, or "". The pairs
        # arrive in source order, so the last start at or before the line wins.
        def diag_return_error_set(lines: darray[u32]&, names: darray[sview]&, diagnostic_name: sview, diagnostic_line: u32) -> sview:
            return "" if diagnostic_name != "return"
            found: mutable sview = ""
            for index in 0..<lines.count |found|:
                found <- names[index] if diagnostic_name == "return" and lines[index] <= diagnostic_line
            return found

    public:
        def check_errorset_wrapper_return(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                module_annotations: mutable darray[Ast::EnumAnnotation] = []
                lookup_annotations: mutable darray[Ast::EnumAnnotation] = ewr_static_import_annotations(file, table)
                module_index: mutable FallibleFunctionModuleIndex = FallibleFunctionModuleIndex{by_line: {}, by_offset: {}, unknown_offset_by_line: {}, ready: false}
                error_index: mutable CallableErrorAnnotationIndex = CallableErrorAnnotationIndex{heads: {}, tails: {}, next: [], source_rows: [], extern_line_heads: {}, extern_line_tails: {}, extern_line_next: [], extern_source_rows: [], ready: false}
                # Keep only generic-parameter rows for the exact declaration lookup performed
                # above; declaration offsets and identities distinguish same-line overloads.
                errorset_rows: mutable darray[Ast::EnumAnnotation] = []
                return_markers: mutable darray[Ast::EnumAnnotation] = []
                for annotation in lookup_annotations |module_annotations, errorset_rows, return_markers|:
                    module_annotations.push(annotation) if annotation.owner == "__fn_module"
                    errorset_rows.push(annotation) if annotation.owner == "__errorset_param"
                    return_markers.push(annotation) if annotation.name == "__error_return"
                fallible_function_module_index_build(module_index, module_annotations) can Global{Read,Write} if module_annotations.count > 0
                callable_error_index_build(lookup_annotations, error_index, false) can Global{Read,Write}
                table.ewr_import_rows <- ewr_import_scope_rows(lookup_annotations)
                table <- ewr_check_declarations(file.top_decls, file.top_decls, file.extern_params, lookup_annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
