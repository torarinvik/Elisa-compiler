# Region-family diagnostic (structural). A `@region` written on a type that has no region of its
# own is meaningless, and stage0 rejects it in `resolveType` (analyzer_resolve_types.go) with one
# of TWO sentences, chosen by how the type resolves:
#   - a NAMED type -- a scalar, or a declared struct, enum, alias or extern type -- gets
#     RegionAnnotationOnScalarField: `@r` "is only valid on a function return type";
#   - a BUILTIN type with no region field (`typeCanCarryRegion` is false), which in practice is a
#     fixed array, gets RegionAnnotationOnFixedArray: "array[i64, 4] cannot carry a region".
# The field check lives here; `check_local_region_annotation` applies the same predicates to
# parameters, locals and return types.
extend Semantic:
    private:
        # The Capitalised bare name a carrier-less annotation sits on (`Point` in `Point @r`),
        # or "" when the type is a scalar or a fixed array.
        def region_carrierless_named_head(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        region_carrierless_named_head(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return ""
                    Expr.Ident(name, name_pos):
                        "" return if sview_len(name) == 0
                        head_byte: u8 = sview_at(name, 0)
                        name return if head_byte >= 65 and head_byte <= 90
                        return ""
                    _:
                        return ""


        # Whether stage0 REJECTS a `@r` written on this type. `local_type_cannot_carry_region`
        # is the syntactic half, and it alone decides whether the annotation adds a region
        # DEPENDENCY. A Capitalised bare name is rejected only when it names a declared type,
        # because stage0 errors once the name RESOLVES: a generic parameter `T @r` resolves on
        # another path and is accepted with the region dropped, and an unknown `Nope @r` reports
        # `unknown type "Nope"` and nothing else. stage1 flagged both.
        def region_annotation_rejected(type_expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if not local_type_cannot_carry_region(type_expression)
                named: sview = region_carrierless_named_head(type_expression)
                true return if named == ""
                return is_registered_type(named, table)


        def region_type_is_fixed_array(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        region_type_is_fixed_array(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return false
                    Expr.Index(object, argument, index_pos):
                        return ident_name_of(object) == "array"
                    Expr.IndexN(object_n, arguments, index_n_pos):
                        return ident_name_of(object_n) == "array"
                    _:
                        return false


        # A fixed array's length as stage0 spells it: a name (`N`) or a literal.
        def fixed_array_length_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return ident_name_of(expression)

        def fixed_array_length_value(expression: Ast::Expr) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(length_value, length_pos):
                        return length_value.u32()
                    _:
                        return 0


        # RegionAnnotationOnFixedArray for a `@REGION` on the fixed array TYPE_EXPRESSION. A
        # Diagnostic may only hold views into the SOURCE, so stage0's spelling of the type is
        # carried in pieces for the renderer to join: the element in `expected`, the length in
        # `detail` when it is a name (`array[i64, N]`) or `expected_count` when it is a literal,
        # and the same three in `detail2`/`detail3`/`actual_count` for an element that is itself
        # a fixed array. Any other element (`array[Box[i64], 2]`) prints as its head name only,
        # where stage0 prints the whole type.
        def fixed_array_region_diagnostic(type_expression: Ast::Expr, name: sview, region: sview, line: u32) -> Diagnostic:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_pos):
                        return fixed_array_region_diagnostic(operand, name, region, line)
                    _:
                        pass
                element: mutable sview = sview("", 0, 0)
                length_name: mutable sview = sview("", 0, 0)
                length_value: mutable u32 = 0
                inner_element: mutable sview = sview("", 0, 0)
                inner_length_name: mutable sview = sview("", 0, 0)
                inner_length_value: mutable u32 = 0
                match type_expression:
                    Expr.IndexN(object_n, arguments, index_n_pos):
                        if arguments.count == 2:
                            length_name <- fixed_array_length_name(arguments[1])
                            length_value <- fixed_array_length_value(arguments[1])
                            element <- ident_name_of(arguments[0])
                            match arguments[0]:
                                Expr.IndexN(inner_object, inner_arguments, inner_pos):
                                    element <- ident_name_of(inner_object)
                                    if inner_arguments.count == 2 and ident_name_of(inner_object) == "array":
                                        inner_element <- ident_name_of(inner_arguments[0])
                                        inner_length_name <- fixed_array_length_name(inner_arguments[1])
                                        inner_length_value <- fixed_array_length_value(inner_arguments[1])
                                Expr.Index(element_object, element_argument, element_index_pos):
                                    element <- ident_name_of(element_object)
                                _:
                                    pass
                    _:
                        pass
                return Diagnostic{kind: DiagnosticKind.RegionAnnotationOnFixedArray, name: name, pos: region_type_head_pos(type_expression), line: line, expected: element, actual: region, expected_count: length_value, actual_count: inner_length_value, detail: length_name, detail2: inner_element, detail3: inner_length_name}


        def check_region_annotation_scalar(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |table| -> table:
                                # Copy the match-bound field to a local sview before comparing to
                                # a string literal in this plain `for` (codegen lowering quirk).
                                region_name: sview = member.region
                                continue if region_name == ""
                                # The FIELD's line, which both of this file's sentences point
                                # at; `StructMember` carries no position, but its type
                                # expression does, and that is where the field is written.
                                member_line: u32 = line.line if Ast::expr_pos(member.type_expression).line == 0 else Ast::expr_pos(member.type_expression).line
                                # stage0 rejects the annotation whether or not the struct
                                # declares a region param: it is the TYPE that has no region.
                                rejected: bool = region_annotation_rejected(member.type_expression, table)
                                fixed_array: bool = region_type_is_fixed_array(member.type_expression)
                                table.diagnostics <- table.diagnostics.push(fixed_array_region_diagnostic(member.type_expression, member.name, region_name, member_line)) if rejected and fixed_array
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAnnotationOnScalarField, name: member.name, line: member_line, pos: region_type_head_pos(member.type_expression), expected: "", actual: region_name}) if rejected and not fixed_array
                                continue if rejected
                                # Any other field's qualifier must name a declared region
                                # param; a struct declaring NO generic/region params has no
                                # valid qualifiers at all (stage0's "unknown region qualifier").
                                struct_declares_params: mutable bool = false
                                for generic_line in table.generic_param_lines |struct_declares_params|:
                                    struct_declares_params <- true if generic_line == line.line
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownRegionQualifier, name: member.name, line: member_line, expected: "", actual: region_name}) if not struct_declares_params
                        Decl.Module(module_name, body, module_line):
                            table <- check_region_annotation_scalar(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_region_annotation_scalar(scoped_body, table)
                        _:
                            pass
