# Region-family diagnostic (structural). A `@region` provenance qualifier on a struct field
# whose type is a bare scalar primitive (`x: i32 @r`) is meaningless: scalars carry no region,
# so stage0 rejects it (`typeCanCarryRegion` is false for scalars). Reads the `region` qualifier
# now captured on StructMember and gates on `bare_type_name` — which is non-empty ONLY for a bare
# (or `mutable`-wrapped) Ident type, never containers/refs/generics/optionals. Restricted to the
# closed integer/float/bool/char primitive set, so it can never fire on a region-carrying type
# (containers, refs, region-parameterized generics) — a pure per-field shape check, zero FP.
extend Semantic:
    private:
        def region_scalar_type_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                bare: sview = bare_type_name(type_expression)
                "" return if bare == ""
                bare return if is_integer_type_name(bare) or is_float_type_name(bare) or bare == "bool" or bare == "char"
                return ""

        def check_region_annotation_scalar(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |table| -> table:
                                # Copy the match-bound field to a local sview before comparing to
                                # a string literal in this plain `for` (codegen lowering quirk).
                                region_name: sview = member.region
                                scalar_name: sview = region_scalar_type_name(member.type_expression)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionAnnotationOnScalarField, name: member.name, line: line, expected: scalar_name, actual: region_name}) if region_name != "" and scalar_name != ""
                        Decl.Module(module_name, body, module_line):
                            table <- check_region_annotation_scalar(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_region_annotation_scalar(scoped_body, table)
                        _:
                            pass
