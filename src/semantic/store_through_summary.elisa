# Which arguments a call may store THROUGH a `mutable T&` parameter. `ea(out, r)` with
# `out.push(r)` stores the second argument into the first one's pointee, so a caller that
# passes its own reference parameter as `out` and `&local` as `r` leaves the caller's caller
# holding a pointer into a dead frame. The callee's own checks accept the store (both are
# its parameters), so the CALLER checks it: stage0's queueCallArgumentStoreChecks with the
# callArgNeverReaches summary.
#
# Rows are flat triples (function, target position, source position): the source argument's
# contents may reach the target parameter's pointee. Only a "writable" target is summarised:
# a `mutable T&` parameter whose pointee type can hold a reference. Within one function the
# flow is a flow-INSENSITIVE union of names -- every assignment, declaration, method call and
# unknown call unifies the names it mentions, a call to a summarised function unifies just
# the argument pairs its rows name -- so the summary over-approximates and never misses a
# store this walk can see. A summary is used only when the identifier resolves to a top-level
# function at that exact source site and the call is positional; other calls conservatively
# unify every runtime name in their arguments.
#
# The summary is the LEAST fixpoint over all functions: every function starts with no rows
# and rounds add rows until none is added. Rows only grow and are bounded, so it terminates;
# mutual recursion (`eb -> ea -> eb`) converges to the same rows in any declaration order.
extend Semantic:
    private:
        const STS_NO_ROW: u32 = 4294967295
        const STS_CLASS_HASH_THRESHOLD: usize = 8

        struct StoreThroughSummary:
            # Function names carrying summary rows. Repeated function names are
            # conservatively represented by the union of their writable and pair rows.
            declared: mutable darray[sview @source] @source
            # name_hash chains over `declared` (newest first); only valid while
            # declared_next.count == declared.count, i.e. every push went through sts_declare.
            declared_heads: mutable dict[u64, u32] @source = {}
            declared_next: mutable darray[u32] @source = []
            # One row per writable parameter: (function, position).
            writable_function: mutable darray[sview @source] @source
            writable_position: mutable darray[usize] @source
            # One row per (function, target, source) that may store through the target.
            pair_function: mutable darray[sview @source] @source
            pair_target: mutable darray[usize] @source
            pair_source: mutable darray[usize] @source
            # name_hash chains over the writable and pair rows, oldest first (head, tail,
            # next); only valid while the chain arrays are as long as their rows, i.e. every
            # row was added through sts_add_writable / sts_add_pair. Otherwise the scans below
            # fall back to reading every row.
            writable_heads: mutable dict[u64, u32] @source = {}
            writable_tails: mutable dict[u64, u32] @source = {}
            writable_next: mutable darray[u32] @source = []
            pair_heads: mutable dict[u64, u32] @source = {}
            pair_tails: mutable dict[u64, u32] @source = {}
            pair_next: mutable darray[u32] @source = []
            # Every global name in the file: a store into one outlives any function frame
            # (stage0 lvalueStorageOutlivesFunction), so `g <- &local` dangles.
            globals: mutable darray[sview @source] @source = []

        def sts_declare(summary: mutable StoreThroughSummary&, name: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                row: u32 = summary.declared.count.u32()
                hash: u64 = name_hash(name)
                previous: mutable u32 = STS_NO_ROW
                if summary.declared_heads.get(hash) is head:
                    previous <- head
                summary.declared_next.push(previous)
                summary.declared_heads <- summary.declared_heads.put(hash, row) can Global{Read,Write}
                summary.declared.push(name)

        def sts_is_declared(summary: StoreThroughSummary&, name: sview) -> bool:
            can Abort.Panic:
                if summary.declared_next.count != summary.declared.count:
                    return any declared_name in summary.declared where declared_name == name
                row: mutable u32 = STS_NO_ROW
                if summary.declared_heads.get(name_hash(name)) is head:
                    row <- head
                while row != STS_NO_ROW |row|:
                    return true if summary.declared[row.usize()] == name
                    row <- summary.declared_next[row.usize()]
                return false

        def sts_empty() -> StoreThroughSummary:
            can Memory.Allocate, Abort.Panic:
                return StoreThroughSummary{declared: [], writable_function: [], writable_position: [], pair_function: [], pair_target: [], pair_source: []}

        def sts_add_writable(summary: mutable StoreThroughSummary&, function_name: sview @source, position: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                row: u32 = summary.writable_function.count.u32()
                hash: u64 = name_hash(function_name)
                summary.writable_next.push(STS_NO_ROW)
                if summary.writable_tails.get(hash) is tail_row:
                    summary.writable_next[tail_row.usize()] <- row
                else:
                    summary.writable_heads <- summary.writable_heads.put(hash, row) can Global{Read,Write}
                summary.writable_tails <- summary.writable_tails.put(hash, row) can Global{Read,Write}
                summary.writable_function.push(function_name)
                summary.writable_position.push(position)

        def sts_add_pair(summary: mutable StoreThroughSummary&, function_name: sview @source, target: usize, source_parameter: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                row: u32 = summary.pair_function.count.u32()
                hash: u64 = name_hash(function_name)
                summary.pair_next.push(STS_NO_ROW)
                if summary.pair_tails.get(hash) is tail_row:
                    summary.pair_next[tail_row.usize()] <- row
                else:
                    summary.pair_heads <- summary.pair_heads.put(hash, row) can Global{Read,Write}
                summary.pair_tails <- summary.pair_tails.put(hash, row) can Global{Read,Write}
                summary.pair_function.push(function_name)
                summary.pair_target.push(target)
                summary.pair_source.push(source_parameter)

        # The first writable row that may belong to FUNCTION_NAME (STS_NO_ROW: none); with
        # sts_writable_after, a walk over exactly the rows a full scan would match, in order.
        def sts_writable_first(summary: StoreThroughSummary&, function_name: sview) -> u32:
            can Abort.Panic:
                return 0 if summary.writable_next.count != summary.writable_function.count and summary.writable_function.count > 0
                return STS_NO_ROW if summary.writable_function.count == 0
                return head if summary.writable_heads.get(name_hash(function_name)) is head else STS_NO_ROW

        def sts_writable_after(summary: StoreThroughSummary&, row: u32) -> u32:
            can Abort.Panic:
                if summary.writable_next.count != summary.writable_function.count:
                    return STS_NO_ROW if row.usize() + 1 >= summary.writable_function.count
                    return row + 1
                return summary.writable_next[row.usize()]

        def sts_pair_first(summary: StoreThroughSummary&, function_name: sview) -> u32:
            can Abort.Panic:
                return 0 if summary.pair_next.count != summary.pair_function.count and summary.pair_function.count > 0
                return STS_NO_ROW if summary.pair_function.count == 0
                return head if summary.pair_heads.get(name_hash(function_name)) is head else STS_NO_ROW

        def sts_pair_after(summary: StoreThroughSummary&, row: u32) -> u32:
            can Abort.Panic:
                if summary.pair_next.count != summary.pair_function.count:
                    return STS_NO_ROW if row.usize() + 1 >= summary.pair_function.count
                    return row + 1
                return summary.pair_next[row.usize()]

        def sts_is_writable(summary: StoreThroughSummary&, function_name: sview, position: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                row: mutable u32 = sts_writable_first(summary, function_name)
                while row != STS_NO_ROW |row|:
                    return true if summary.writable_function[row.usize()] == function_name and summary.writable_position[row.usize()] == position
                    row <- sts_writable_after(summary, row)
                return false

        def sts_has_writable(summary: StoreThroughSummary&, function_name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                row: mutable u32 = sts_writable_first(summary, function_name)
                while row != STS_NO_ROW |row|:
                    return true if summary.writable_function[row.usize()] == function_name
                    row <- sts_writable_after(summary, row)
                return false

        def sts_has_pair(summary: StoreThroughSummary&, function_name: sview, target: usize, source: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                row: mutable u32 = sts_pair_first(summary, function_name)
                while row != STS_NO_ROW |row|:
                    return true if summary.pair_function[row.usize()] == function_name and summary.pair_target[row.usize()] == target and summary.pair_source[row.usize()] == source
                    row <- sts_pair_after(summary, row)
                return false

        # Every runtime name an expression or nested statement mentions, at any depth
        # (`f(a.b[i], &c)` -> f, a, i, c). Type names and binding labels are selectors,
        # not runtime values. This collector feeds a conservative fallback: omitting a
        # runtime child can make a store-through summary unsound.
        def sts_collect_statement_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Expr(expression, _):
                            sts_collect_names(expression, out)
                        Stmt.Block(body: body, _):
                            sts_collect_statement_names(body, out)
                        Stmt.VarDecl(value: value, _):
                            sts_collect_names(value, out)
                        Stmt.Assign(target, _, value, _):
                            sts_collect_names(target, out)
                            sts_collect_names(value, out)
                        Stmt.If(condition, then_body, else_body, _):
                            sts_collect_names(condition, out)
                            sts_collect_statement_names(then_body, out)
                            sts_collect_statement_names(else_body, out)
                        Stmt.While(condition, body, _):
                            sts_collect_names(condition, out)
                            sts_collect_statement_names(body, out)
                        Stmt.For(iterable: iterable, body: body, _):
                            sts_collect_names(iterable, out)
                            sts_collect_statement_names(body, out)
                        Stmt.Return(value, _):
                            sts_collect_names(return_value, out) if value is return_value
                        Stmt.Match(scrutinee, arms, _):
                            sts_collect_names(scrutinee, out)
                            for arm in arms |out|:
                                sts_collect_names(arm.guard, out)
                                sts_collect_statement_names(arm.body, out)
                        Stmt.Contract(_, expression, _):
                            sts_collect_names(expression, out)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(_, _):
                            pass
                        Stmt.Continue(_, _):
                            pass

        def sts_collect_names(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                    Expr.IntLit(_, _):
                        pass
                    Expr.FloatLit(_, _):
                        pass
                    Expr.StringLit(_, _):
                        pass
                    Expr.CharLit(_, _):
                        pass
                    Expr.BoolLit(_, _):
                        pass
                    Expr.Ident(name, _):
                        out.push(name) if name != ""
                    Expr.Call(callee, arguments, _, _):
                        sts_collect_names(callee, out)
                        for argument in arguments |out|:
                            sts_collect_names(argument, out)
                    Expr.StaticEffectCall(candidates: candidates, arguments: arguments, _):
                        for candidate in candidates |out|:
                            for capture in candidate.captures |out|:
                                sts_collect_names(capture, out)
                        for argument in arguments |out|:
                            sts_collect_names(argument, out)
                    Expr.Field(object, _, _):
                        sts_collect_names(object, out)
                    Expr.Scope(_, _, _):
                        # `::` selects a namespace/type member; the path base is not a runtime value.
                        pass
                    Expr.ShorthandMember(_, _):
                        pass
                    Expr.Index(object, index, _):
                        sts_collect_names(object, out)
                        sts_collect_names(index, out)
                    Expr.Slice(object, low, high, _):
                        sts_collect_names(object, out)
                        sts_collect_names(low, out)
                        sts_collect_names(high, out)
                    Expr.IndexN(object, arguments, _):
                        sts_collect_names(object, out)
                        for argument in arguments |out|:
                            sts_collect_names(argument, out)
                    Expr.Binary(left, _, right, _):
                        sts_collect_names(left, out)
                        sts_collect_names(right, out)
                    Expr.Unary(_, operand, _):
                        sts_collect_names(operand, out)
                    Expr.Move(operand, _):
                        sts_collect_names(operand, out)
                    Expr.RegionNew(operand, _, _):
                        sts_collect_names(operand, out)
                    Expr.Paren(inner, _):
                        sts_collect_names(inner, out)
                    Expr.Array(elements, _):
                        for element in elements |out|:
                            sts_collect_names(element, out)
                    Expr.Tuple(elements, _):
                        for element in elements |out|:
                            sts_collect_names(element, out)
                    Expr.SetLit(elements, _):
                        for element in elements |out|:
                            sts_collect_names(element, out)
                    Expr.DictLit(entries, _):
                        for entry in entries |out|:
                            sts_collect_names(entry.key, out)
                            sts_collect_names(entry.value, out)
                    Expr.Construct(_, fields, _):
                        for field in fields |out|:
                            sts_collect_names(field.value, out)
                    Expr.RecordUpdate(base, fields, _):
                        sts_collect_names(base, out)
                        for field in fields |out|:
                            sts_collect_names(field.value, out)
                    Expr.If(condition, then_value, else_value, _):
                        sts_collect_names(condition, out)
                        sts_collect_names(then_value, out)
                        sts_collect_names(else_value, out)
                    Expr.Match(scrutinee, arms, _):
                        sts_collect_names(scrutinee, out)
                        for arm in arms |out|:
                            sts_collect_names(arm.guard, out)
                            sts_collect_statement_names(arm.body, out)
                    Expr.Catch(guarded, arms, _):
                        sts_collect_names(guarded, out)
                        for arm in arms |out|:
                            sts_collect_names(arm.guard, out)
                            sts_collect_statement_names(arm.body, out)
                    Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                        sts_collect_names(iterable, out)
                        sts_collect_names(condition, out)
                        sts_collect_names(body, out)
                    Expr.Refinement(base, predicate, _):
                        sts_collect_names(base, out)
                        sts_collect_names(predicate, out)
                    Expr.GetElse(guarded, recovery, _):
                        sts_collect_names(guarded, out)
                        sts_collect_statement_names(recovery, out)
                    Expr.Lambda(_, body, _):
                        sts_collect_statement_names(body, out)
                    Expr.Block(statements, value, captures, _):
                        for capture in captures |out|:
                            out.push(capture) if capture != ""
                        sts_collect_statement_names(statements, out)
                        sts_collect_names(value, out)

        struct StoreThroughClasses:
            # NameSet keeps insertion order and a hash index; parents uses the same
            # zero-based name rows with 1-based parent labels.
            names: mutable NameSet
            parents: mutable darray[usize]
            ranks: mutable darray[u8]

        def sts_classes_empty() -> StoreThroughClasses:
            can Memory.Allocate, Abort.Panic:
                return StoreThroughClasses{names: empty_name_set(), parents: [], ranks: []}

        # The class of NAME (registering it as its own class). Classes are a union-find
        # forest: parents[row] is the 1-based row of the parent, a root points at itself.
        # Callers only ever compare two classes for equality, so the partition -- which
        # does not depend on the order of the unions -- is the whole answer; relabelling
        # every row per union made each function quadratic in the names it mentions. The
        # hash-backed NameSet avoids a linear name search for larger functions, while
        # union-by-rank bounds tree
        # height before path compression.
        def sts_class_of(classes: mutable StoreThroughClasses&, name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                row: mutable i64 = -1
                if classes.names.slots.count == 0:
                    candidate: mutable usize = 0
                    while candidate < classes.names.names.count |candidate, classes|:
                        if classes.names.names[candidate] == name:
                            row <- candidate.i64()
                            break
                        candidate <- candidate + 1
                else:
                    row <- name_set_index(classes.names, name)
                return sts_class_root(classes, row.usize() + 1) if row >= 0
                label: usize = classes.parents.count + 1
                if classes.names.slots.count == 0 and classes.names.names.count < STS_CLASS_HASH_THRESHOLD:
                    classes.names.names.push(name)
                else:
                    name_set_grow(&classes.names) if classes.names.slots.count == 0
                    name_set_add(&classes.names, name)
                classes.parents.push(label)
                classes.ranks.push(0)
                return label

        def sts_class_root(classes: mutable StoreThroughClasses&, label: usize) -> usize:
            can Memory.Allocate, Abort.Panic:
                root: mutable usize = label
                while classes.parents[root - 1] != root |root, classes|:
                    root <- classes.parents[root - 1]
                # Path compression.
                walk: mutable usize = label
                while classes.parents[walk - 1] != root |walk, classes, root|:
                    parent: usize = classes.parents[walk - 1]
                    classes.parents[walk - 1] <- root
                    walk <- parent
                return root

        def sts_unify(classes: mutable StoreThroughClasses&, first: sview, second: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                kept: usize = sts_class_of(classes, first)
                merged: usize = sts_class_of(classes, second)
                return if kept == merged
                kept_rank: u8 = classes.ranks[kept - 1]
                merged_rank: u8 = classes.ranks[merged - 1]
                if kept_rank < merged_rank:
                    classes.parents[kept - 1] <- merged
                elif kept_rank > merged_rank:
                    classes.parents[merged - 1] <- kept
                else:
                    classes.parents[merged - 1] <- kept
                    classes.ranks[kept - 1] <- kept_rank + 1

        def sts_unify_all(classes: mutable StoreThroughClasses&, mentioned: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if mentioned.count < 2
                for other in mentioned |classes|:
                    sts_unify(classes, mentioned[0], other)

        # A generic direct call is represented as an Index/IndexN callee in the AST.
        # Resolve it only when the head names one unique function and is not shadowed
        # by a local binding; runtime indexing and ambiguous function values stay on
        # the conservative unknown-call path.
        def sts_generic_direct_callee_name(callee: Ast::Expr, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match callee:
                    Expr.Index(Expr.Ident(name, position), _, _) | Expr.IndexN(Expr.Ident(name, position), _, _):
                        return "" if has_unreadable_binder or name == "" or direct_function_count(table, name) != 1
                        return "" if borrow_reference_site_is_local(reference_sites, function_owner, position, table)
                        return name
                    Expr.Index(Expr.Scope(_, name, position), _, _) | Expr.IndexN(Expr.Scope(_, name, position), _, _):
                        return "" if has_unreadable_binder or name == "" or direct_function_count(table, name) != 1
                        return "" if borrow_reference_site_is_local(reference_sites, function_owner, position, table)
                        return name
                    _:
                        return ""

        # Apply the known callee's target/source rows to the corresponding actuals.
        def sts_unify_call_pairs(callee_name: sview, arguments: darray[Ast::Expr], summary: StoreThroughSummary&, classes: mutable StoreThroughClasses&) -> void:
            can Memory.Allocate, Abort.Panic:
                pair_row: mutable u32 = sts_pair_first(summary, callee_name)
                while pair_row != STS_NO_ROW |pair_row, classes|:
                    row: usize = pair_row.usize()
                    if summary.pair_function[row] == callee_name and summary.pair_target[row] < arguments.count and summary.pair_source[row] < arguments.count:
                        pair_names: mutable darray[sview] = []
                        sts_collect_names(arguments[summary.pair_target[row]], pair_names)
                        sts_collect_names(arguments[summary.pair_source[row]], pair_names)
                        sts_unify_all(classes, pair_names)
                    pair_row <- sts_pair_after(summary, pair_row)

        # Calls anywhere inside EXPRESSION: a summarised callee unifies its stored argument
        # pairs, a method call or any other call unifies everything it was handed.
        def sts_unify_calls(expression: Ast::Expr, summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, classes: mutable StoreThroughClasses&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Call(callee, arguments, argument_names, _):
                        sts_unify_calls(callee, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        for argument in arguments |classes, reference_sites|:
                            sts_unify_calls(argument, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        match callee:
                            Expr.Ident(callee_name, callee_position):
                                shadowed: bool = borrow_reference_site_is_local(reference_sites, function_owner, callee_position, table) or has_unreadable_binder
                                if sts_is_declared(summary, callee_name) and not shadowed and not (any argument_name in argument_names where argument_name != ""):
                                    pair_row: mutable u32 = sts_pair_first(summary, callee_name)
                                    while pair_row != STS_NO_ROW |pair_row, classes|:
                                        row: usize = pair_row.usize()
                                        if summary.pair_function[row] == callee_name and summary.pair_target[row] < arguments.count and summary.pair_source[row] < arguments.count:
                                            pair_names: mutable darray[sview] = []
                                            sts_collect_names(arguments[summary.pair_target[row]], pair_names)
                                            sts_collect_names(arguments[summary.pair_source[row]], pair_names)
                                            sts_unify_all(classes, pair_names)
                                        pair_row <- sts_pair_after(summary, pair_row)
                                    return
                            Expr.Index(Expr.Ident(generic_name, generic_position), _, _) | Expr.IndexN(Expr.Ident(generic_name, generic_position), _, _):
                                if not (any argument_name in argument_names where argument_name != ""):
                                    generic_callee: sview = sts_generic_direct_callee_name(callee, has_unreadable_binder, function_owner, reference_sites, table)
                                    if generic_callee != "" and sts_is_declared(summary, generic_callee):
                                        sts_unify_call_pairs(generic_callee, arguments, summary, classes)
                                        return
                            _:
                                pass
                        call_names: mutable darray[sview] = []
                        match callee:
                            Expr.Ident(callee_name, callee_position):
                                call_names.push(callee_name) if borrow_reference_site_is_local(reference_sites, function_owner, callee_position, table) or has_unreadable_binder
                            Expr.Field(receiver, _, _):
                                sts_collect_names(receiver, call_names)
                            _:
                                pass
                        for argument in arguments |call_names|:
                            sts_collect_names(argument, call_names)
                        sts_unify_all(classes, call_names)
                    Expr.Field(object, _, _):
                        sts_unify_calls(object, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.Index(object, index, _):
                        sts_unify_calls(object, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        sts_unify_calls(index, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.Binary(left, _, right, _):
                        sts_unify_calls(left, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        sts_unify_calls(right, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.Unary(_, operand, _):
                        sts_unify_calls(operand, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.Move(operand, _):
                        sts_unify_calls(operand, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.Paren(inner, _):
                        sts_unify_calls(inner, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.If(condition, then_value, else_value, _):
                        sts_unify_calls(condition, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        sts_unify_calls(then_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        sts_unify_calls(else_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    _:
                        # Anything this walk does not open (a lambda, a block or match value)
                        # may store anything it mentions anywhere.
                        hidden_names: mutable darray[sview] = []
                        sts_collect_names(expression, hidden_names)
                        sts_unify_all(classes, hidden_names)

        # Returning a constructed aggregate does not store its fields through any writable
        # parameter. Walk field expressions for calls with real store effects, but do not
        # alias unrelated values merely because they are packaged into the same result.
        # This matters for backend carrier structs such as PropagatingTryCall, whose fields
        # include independent LLVM handles and compiler-state views.
        def sts_unify_return_calls(expression: Ast::Expr, summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, classes: mutable StoreThroughClasses&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Construct(_, fields, _):
                        for field in fields |classes, reference_sites|:
                            sts_unify_return_calls(field.value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.RecordUpdate(base, fields, _):
                        sts_unify_return_calls(base, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        for field in fields |classes, reference_sites|:
                            sts_unify_return_calls(field.value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        sts_unify_return_calls(inner, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                    _:
                        sts_unify_calls(expression, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)

        # LLVM-C opaque handles are host compiler objects, not Elisa references. Keep
        # this whitelist exact: arbitrary extern/nominal types remain unknown and retain
        # the conservative initializer alias union. Structural wrappers are safe only
        # when every contained element is one of these handles.
        def sts_type_is_llvm_handle(type_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                kind: SemTypeKind = interned_kind(type_id, table)
                if kind == SemTypeKind.Named:
                    name: sview = interned_name(type_id, table)
                    return name == "LLVMContextRef" or name == "LLVMModuleRef" or name == "LLVMTypeRef" or name == "LLVMValueRef" or name == "LLVMBuilderRef" or name == "LLVMBasicBlockRef" or name == "LLVMTargetRef" or name == "LLVMTargetMachineRef" or name == "LLVMMemoryBufferRef" or name == "LLVMDiagnosticInfoRef"
                return false if:
                    kind != SemTypeKind.Optional and kind != SemTypeKind.Tuple and kind != SemTypeKind.Container
                    interned_elem_count(type_id, table) == 0
                for position in 0 ..< interned_elem_count(type_id, table) |table|:
                    return false if not sts_type_is_llvm_handle(interned_elem(type_id, position, table), table)
                return true

        def sts_unify_bound(name: sview, declared_type: Ast::Expr, value: Ast::Expr, summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&, classes: mutable StoreThroughClasses&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                declared_type_id: u32 = annotation_type_id(declared_type, table) can Global{Read,Write}
                bound_type_is_reference_free: mutable bool = false
                can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                    bound_type_is_reference_free <- bam_type_is_proven_reference_free_cached(declared_type_id, reference_sites, table) if declared_type_id != 0
                # A value whose declared type is proven not to contain references cannot
                # carry a borrow from the initializer into this binding. Keep the broad
                # alias union for unknown/inferred or reference-bearing types, and always
                # walk calls so their store-through effects still reach the summary.
                bound_type_id: u32 = declared_type_id
                bound_type_is_host_handle: bool = sts_type_is_llvm_handle(bound_type_id, table)
                if not bound_type_is_reference_free and not bound_type_is_host_handle:
                    bound_names: mutable darray[sview] = []
                    bound_names.push(name) if name != ""
                    sts_collect_names(value, bound_names)
                    sts_unify_all(classes, bound_names)
                sts_unify_calls(value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)

        def sts_lmut_parameter_at(table: SymbolTable&, callee: sview, position: u32) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < table.lmut_param_owner.count:
                    return true if table.lmut_param_owner[index] == callee and table.lmut_param_pos[index] == position
                    index <- index + 1
                return false

        # A plain assignment from a uniquely resolved local/parameter identifier of a
        # proven reference-free type cannot carry reference contents into its target. Keep
        # this optimization deliberately syntactic: calls, operators, unknown bindings, and
        # every compound assignment retain the conservative alias union. Call traversal is
        # still performed by the caller for both sides of the assignment.
        def sts_assignment_rhs_is_reference_free(value: Ast::Expr, operator: TokenKind, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return false if operator != TokenKind.LArrow or has_unreadable_binder
                match value:
                    Expr.Ident(_, position):
                        binding: (known: bool, binding_id: BindingId) = borrow_reference_site_binding(reference_sites, function_owner, position, table)
                        return false if not binding.known
                        type_id: u32 = bam_binding_declared_type_id(binding.binding_id, reference_sites, table)
                        return false if type_id == 0
                        return bam_type_is_proven_reference_free_cached(type_id, reference_sites, table)
                    _:
                        return false

        # A direct `x <- f(..., x, ...)` call that uniquely resolves to an lmut formal at
        # that argument position threads x's successor back into x. The call's summary still
        # records any actual store-through relationships; do not also treat every argument
        # name as an alias merely because the threaded result is rebound to its input place.
        # Keep this narrow: named arguments, overloads, wrapped callees/places, and ordinary
        # value assignments retain the conservative assignment union below.
        def sts_same_target_lmut_rebind(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return false if:
                    operator != TokenKind.LArrow
                    has_unreadable_binder
                match target:
                    Expr.Ident(target_name, _):
                        match value:
                            Expr.Call(callee, arguments, argument_names, _):
                                match callee:
                                    Expr.Ident(callee_name, callee_position):
                                        return false if:
                                            callee_name == "" or direct_function_count(table, callee_name) != 1
                                            borrow_reference_site_is_local(reference_sites, function_owner, callee_position, table)
                                            any argument_name in argument_names where argument_name != ""
                                        position: mutable u32 = 0
                                        for argument in arguments |position, target_name, callee_name, table|:
                                            if sts_lmut_parameter_at(table, callee_name, position) and argument is Expr.Ident(argument_name, _) and argument_name == target_name:
                                                return true
                                            position <- position + 1
                                    _:
                                        pass
                            _:
                                pass
                    _:
                        pass
                return false

        def sts_statements(statements: darray[Ast::Stmt], summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&, classes: mutable StoreThroughClasses&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |classes, reference_sites|:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, _):
                            sts_unify_bound(declared_name, declared_type, declared_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Assign(assign_target, assign_operator, assign_value, _):
                            if not sts_same_target_lmut_rebind(assign_target, assign_operator, assign_value, has_unreadable_binder, function_owner, reference_sites, table) and not sts_assignment_rhs_is_reference_free(assign_value, assign_operator, has_unreadable_binder, function_owner, reference_sites, table):
                                assign_names: mutable darray[sview] = []
                                sts_collect_names(assign_target, assign_names)
                                sts_collect_names(assign_value, assign_names)
                                sts_unify_all(classes, assign_names)
                            sts_unify_calls(assign_target, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_unify_calls(assign_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Expr(statement_value, _):
                            sts_unify_calls(statement_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Return(returned, _):
                            if returned is returned_value:
                                sts_unify_return_calls(returned_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.If(condition, then_body, else_body, _):
                            sts_unify_calls(condition, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(then_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(else_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.While(condition, loop_body, _):
                            sts_unify_calls(condition, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(loop_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.For(_, loop_variables, iterable, loop_body, _):
                            for loop_variable in loop_variables |classes, reference_sites|:
                                sts_unify_bound(loop_variable, Expr.Invalid, iterable, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_unify_calls(iterable, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(loop_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Block(body: block_body, _):
                            sts_statements(block_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Match(scrutinee, arms, _):
                            # Arm binders are not read here: they join the scrutinee through
                            # any later statement that mentions both, and a binder stored into a
                            # parameter is unified with that parameter by the store itself.
                            sts_unify_calls(scrutinee, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            for arm in arms |classes, reference_sites|:
                                sts_unify_calls(arm.guard, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                                sts_statements(arm.body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Contract(_, expression, _):
                            sts_unify_calls(expression, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        _:
                            pass

        def sts_collect_functions(declarations: darray[Ast::Decl], functions: mutable darray[Ast::Decl]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |functions|:
                    match declaration:
                        Decl.Func(name: function_name, _):
                            functions.push(declaration)
                        Decl.Module(_, module_body, _):
                            sts_collect_functions(module_body, functions)
                        Decl.Scoped(scoped_body, _):
                            sts_collect_functions(scoped_body, functions)
                        _:
                            pass

        # The rows one function adds under SUMMARY; true when any row is new.
        def sts_summarise_function(function_name: sview, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&, summary: mutable StoreThroughSummary&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                classes: mutable StoreThroughClasses = sts_classes_empty()
                sts_statements(body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                added: mutable bool = false
                target: mutable usize = 0
                while target < parameters.count |target, classes, added, summary|:
                    if sts_is_writable(summary, function_name, target):
                        target_class: usize = sts_class_of(classes, parameters[target].name)
                        source: mutable usize = 0
                        while source < parameters.count |source, classes, added, summary|:
                            if source != target and sts_class_of(classes, parameters[source].name) == target_class and not sts_has_pair(summary, function_name, target, source):
                                sts_add_pair(summary, function_name, target, source) can Global{Read,Write}
                                added <- true
                            source <- source + 1
                    target <- target + 1
                return added

    public:
        def build_store_through_summary(declarations: darray[Ast::Decl], reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&) -> StoreThroughSummary:
            can Memory.Allocate, Abort.Panic:
                summary: mutable StoreThroughSummary = sts_empty()
                functions: mutable darray[Ast::Decl] = []
                sts_collect_functions(declarations, functions)
                summarised: mutable darray[Ast::Decl] = []
                summarised_unreadable: mutable darray[bool] = []
                for function in functions |summary, summarised, summarised_unreadable, table, reference_sites|:
                    match function:
                        Decl.Func(name: function_name, params: function_parameters, body: function_body, _):
                            if function_name != "" and function_name != "_":
                                if not sts_is_declared(summary, function_name):
                                    sts_declare(summary, function_name) can Global{Read,Write}
                                position: mutable usize = 0
                                writable_found: mutable bool = false
                                for parameter in function_parameters |position, writable_found, summary, table, reference_sites|:
                                    if param_is_mutable_ref(parameter):
                                        pointee: u32 = bam_strip_ref(annotation_type_id(parameter.type_expression, table), table) can Global{Read,Write}
                                        contains_reference: mutable bool = false
                                        can Global{Read,Write}:
                                            contains_reference <- bam_type_may_contain_reference(pointee, reference_sites, table)
                                        if contains_reference:
                                            sts_add_writable(summary, function_name, position) can Global{Read,Write}
                                            writable_found <- true
                                    position <- position + 1
                                if writable_found and function_parameters.count > 1:
                                    has_unreadable_binder: bool = borrow_function_has_unreadable_binder(function_parameters, function_body)
                                    summarised.push(function)
                                    summarised_unreadable.push(has_unreadable_binder)
                        _:
                            pass
                # Only functions with a writable parameter carry rows; every other declared
                # function is summarised as storing nothing through a writable parameter.
                more_rows: mutable bool = summarised.count > 0
                while more_rows |more_rows, summary, reference_sites|:
                    more_rows <- false
                    for function_index in 0..<summarised.count |more_rows, summary, summarised, summarised_unreadable, reference_sites, table|:
                        match summarised[function_index]:
                            Decl.Func(name: function_name, params: function_parameters, body: function_body, pos: function_pos, _):
                                function_owner: DeclId = function_declaration_id(table, function_name, function_pos.offset)
                                more_rows <- true if (sts_summarise_function(function_name, function_parameters, function_body, summarised_unreadable[function_index], function_owner, reference_sites, table, summary) can Global{Read,Write})
                            _:
                                pass
                file_globals: mutable darray[sview @source] = []
                collect_mutable_globals(declarations, file_globals)
                summary.globals.extend(file_globals)
                return summary
