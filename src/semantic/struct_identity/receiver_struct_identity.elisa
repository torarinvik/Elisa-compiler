# The struct a field-access receiver denotes, with its module, for the unknown-field check.
#
# The check's own inference is name-only: a receiver typed `Outer::Thing` has no bare name,
# so it was skipped and the backend declined the function, and a bare `Thing` checked the
# union of every module's `Thing`. Here a local's annotation is resolved where it is
# declared, and a field chain follows each field's own annotation, resolved in the module
# that declares the field's struct.
#
# The identities live in `table.local_struct_identities`, one row per transient local row:
# every row push records an empty identity (so binders shadow), close_type_scope truncates
# it, and lookups scan by name, innermost first.

extend Semantic:
    private:
        # Give the newest local row the struct identity its annotation names in the current
        # module. Call right after note_local_type_id for the same binding.
        def note_local_struct_identity(type_expression: Ast::Expr, table: mutable SymbolTable&) -> void:
            can Abort.Panic:
                return if table.local_struct_identities.count == 0
                last: usize = table.local_struct_identities.count - 1
                identity: (found: bool, owner: sview @source, module: sview @source) = annotation_struct_identity(type_expression, table.current_module, table)
                return if not identity.found
                table.local_struct_identities[last] <- LocalStructIdentity{name: table.local_struct_identities[last].name, owner: identity.owner, module: identity.module}

        # Give each parameter row that seed_local_type_ids pushed its struct identity. The
        # rows are the parameters, in order.
        def seed_local_struct_identities(parameters: darray[Ast::ParamDecl]&, table: mutable SymbolTable&) -> void:
            can Abort.Panic:
                for parameter_index in 0..<parameters.count |table|:
                    continue if parameter_index >= table.local_struct_identities.count or table.local_struct_identities[parameter_index].name != parameters[parameter_index].name
                    identity: (found: bool, owner: sview @source, module: sview @source) = annotation_struct_identity(parameters[parameter_index].type_expression, table.current_module, table)
                    continue if not identity.found
                    table.local_struct_identities[parameter_index] <- LocalStructIdentity{name: parameters[parameter_index].name, owner: identity.owner, module: identity.module}

        # The struct identity of the innermost local named NAME; not found when that local
        # has none (a binder, a non-struct annotation) or there is no such local.
        def local_struct_identity_of(name: sview, table: SymbolTable&) -> (found: bool, owner: sview @source, module: sview @source):
            can Abort.Panic:
                while row_index > 0 |row_index: usize = table.local_struct_identities.count|:
                    row_index <- row_index - 1
                    row: LocalStructIdentity& = &table.local_struct_identities[row_index]
                    return (row.owner != "", row.owner, row.module) if row.name == name
                return (false, "", "")

        # The struct a receiver expression denotes: a local by its annotation, `object.field`
        # by the field's annotation in the module declaring OBJECT's struct.
        def receiver_struct_identity(receiver: Ast::Expr, table: SymbolTable&) -> (found: bool, owner: sview @source, module: sview @source):
            can Abort.Panic:
                match receiver:
                    Expr.Ident(name, _):
                        return local_struct_identity_of(name, table)
                    Expr.Paren(inner, _):
                        return receiver_struct_identity(inner, table)
                    Expr.Field(object, field, _):
                        base: (found: bool, owner: sview @source, module: sview @source) = receiver_struct_identity(object, table)
                        return (false, "", "") if not base.found
                        row: i64 = struct_field_row_in(table, base.module, base.owner, field)
                        return (false, "", "") if row < 0 or row.usize() >= table.private_field_types.count
                        return annotation_struct_identity(table.private_field_types[row.usize()], base.module, table)
                    _:
                        return (false, "", "")
