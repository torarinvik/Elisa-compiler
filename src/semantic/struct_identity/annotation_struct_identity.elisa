# Which struct a type annotation names, and the module that declares it.
#
# TypeIds and the struct field rows key a struct by its bare name, so `Cipher::State` and
# `Sheet::State` share one key and a name-only lookup sees the union of both field lists.
# The annotation still says which struct is meant. These helpers resolve it and read the
# field rows of that one struct (`struct_field_module` says which module declared a row).

extend Semantic:
    private:
        # The struct a type annotation names, and the module declaring it: the written path
        # for `M::T`; for a bare `T` written in MODULE, MODULE's own struct, then a top-level
        # one, then the only module declaring one. Anything else is unresolved.
        def annotation_struct_identity(type_expression: Ast::Expr, module: sview, table: SymbolTable&) -> (found: bool, owner: sview @source, module: sview @source):
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _) if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return annotation_struct_identity(operand, module, table)
                    Expr.Paren(inner, _):
                        return annotation_struct_identity(inner, module, table)
                    Expr.Ident(name, _):
                        return (false, "", "") if any generic_name in table.generic_param_names where generic_name == name
                        return struct_identity_by_name(name, module, Expr.Invalid, false, table)
                    Expr.Scope(path, name, _):
                        return struct_identity_by_name(name, module, path, true, table)
                    _:
                        return (false, "", "")

        # The row walk behind annotation_struct_identity. A same-named enum, alias or
        # opaque handle in a candidate module leaves the name unresolved.
        def struct_identity_by_name(name: sview @source, module: sview, path: Ast::Expr, qualified: bool, table: SymbolTable&) -> (found: bool, owner: sview @source, module: sview @source):
            can Abort.Panic:
                declared_here: mutable bool = false
                here_module: mutable sview @source = ""
                declared_top: mutable bool = false
                other_module: mutable sview @source = ""
                other_count: mutable u32 = 0
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE |row, declared_here, here_module, declared_top, other_module, other_count, name, module, path, qualified, table|:
                    symbol: Symbol& = &table.symbols[row.usize()]
                    row <- table.symbol_name_next[row.usize()]
                    continue if symbol.name != name or (qualified and not module_path_spells(path, symbol.module_owner))
                    return (false, "", "") if symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)
                    continue if symbol.kind != SymbolKind.Struct
                    if not qualified and symbol.module_owner == module:
                        declared_here <- true
                        here_module <- symbol.module_owner
                    elif not qualified and symbol.module_owner == "":
                        declared_top <- true
                    elif other_count == 0 or symbol.module_owner != other_module:
                        other_module <- symbol.module_owner
                        other_count <- other_count + 1
                return (true, name, here_module) if declared_here
                return (true, name, "") if declared_top
                return (true, name, other_module) if other_count == 1
                return (false, "", "")

        # The field row of MODULE's struct OWNER named FIELD_NAME, or -1.
        def struct_field_row_in(table: SymbolTable&, owner_module: sview, owner: sview, field_name: sview) -> i64:
            can Abort.Panic:
                field_row: mutable u32 = struct_field_owner_head(table, owner)
                while field_row != SYMBOL_INDEX_ROW_NONE |field_row|:
                    field_index: usize = field_row.usize()
                    return field_row.i64() if table.struct_field_owner[field_index] == owner and table.struct_field_name[field_index] == field_name and struct_field_module_at(table, field_index) == owner_module
                    field_row <- table.struct_field_owner_next[field_index]
                return -1

        # Whether MODULE's struct OWNER has a known, closed field set: struct_is_registered
        # for one module's struct. Field rows are recorded only for a struct whose members
        # are all cleanly named.
        def struct_declares_fields_in(table: SymbolTable&, owner_module: sview, owner: sview) -> bool:
            can Abort.Panic:
                field_row: mutable u32 = struct_field_owner_head(table, owner)
                while field_row != SYMBOL_INDEX_ROW_NONE |field_row|:
                    field_index: usize = field_row.usize()
                    return true if table.struct_field_owner[field_index] == owner and struct_field_module_at(table, field_index) == owner_module
                    field_row <- table.struct_field_owner_next[field_index]
                return false
