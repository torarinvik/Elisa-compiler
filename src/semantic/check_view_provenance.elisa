# View provenance escape: a view of a LOCAL owner reaches caller-owned storage through a
# local CONTAINER (a filled local `caps`, a literal `[bytes_view(xs)]`, a comprehension, or a
# call result), and an element read out of that container is stored into a `mutable` ref
# parameter.
#
#     caps: mutable darray[sview] = []
#     fill(caps)                 # fill pushes bytes_view(<its local>) into `caps`
#     for c in caps:
#         dst.push(c)            # the bytes die with this frame
#
# A DIRECT push of a local view into a parameter (`dst.push(bytes_view(xs))`) is accepted by
# stage0 (the receiver ADOPTS the region), so only values that travelled through a local
# container are reported. Mirrors stage0's region_local_container_elements.go /
# region_return_element_summary.go, syntactically. Summaries (which top-level function fills
# which parameter with local data, which returns local-derived elements) are computed by
# fixpoint. Everything unclear stays silent.
#
# Per-local flags: 1 owns fresh storage, 2 direct view of a local owner, 4 element of a
# container that holds local views, 8 poisoned (redeclared/reassigned), 16 store target,
# 32 parameter, 64 local, 128 container param, 256 local bound to an `as_sview()` of a local owner.
extend Semantic:
    private:
        def vp_idx(sn: darray[sview]&, name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                i: mutable usize = sn.count
                while i > 0:
                    i <- i - 1
                    return i if sn[i] == name
                return sn.count

        def vp_flags(sn: darray[sview]&, sf: darray[u32]&, name: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                idx: usize = vp_idx(sn, name)
                return 0 if idx >= sn.count
                return 0 if (sf[idx] & 8) != 0
                return sf[idx]

        def vp_set(sn: mutable darray[sview]&, sf: mutable darray[u32]&, sp: mutable darray[u32]&, sa: mutable darray[sview]&, name: sview, flag: u32, mask: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                idx: usize = vp_idx(sn, name)
                if idx >= sn.count:
                    sn.push(name)
                    sf.push(flag)
                    sp.push(mask)
                    sa.push("")
                else:
                    sf[idx] <- sf[idx] | flag
                    sp[idx] <- sp[idx] | mask

        def vp_target(sn: darray[sview]&, sf: darray[u32]&, sa: darray[sview]&, name: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                idx: usize = vp_idx(sn, name)
                return "" if idx >= sn.count
                return "" if (sf[idx] & 8) != 0
                return sa[idx] if sa[idx] != ""
                return name if (sf[idx] & 16) != 0
                return ""

        def vp_param_index(pn: darray[sview]&, name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                i: mutable usize = 0
                while i < pn.count:
                    return i if pn[i] == name
                    i <- i + 1
                return pn.count

        # The whole-program summaries the fixpoint accumulates: which function fills which
        # parameter with local data (filln/filli), which function stores argument `stj` into
        # argument `sti` (stn/sti/stj), and the return flags per function (retn/retf). Each
        # list is chained by a hash of its key (newest row first) so the per-call questions
        # below read one chain instead of every row; every step compares the real key, the
        # hash only narrows the candidates. The lists hold one row per distinct key, so
        # chain order cannot change an answer.
        struct VpFacts:
            filln: mutable darray[sview]
            filli: mutable darray[usize]
            fill_heads: mutable dict[u64, u32] = {}
            fill_next: mutable darray[u32] = []
            stn: mutable darray[sview]
            sti: mutable darray[usize]
            stj: mutable darray[usize]
            store_heads: mutable dict[u64, u32] = {}
            store_next: mutable darray[u32] = []
            retn: mutable darray[sview]
            retf: mutable darray[u32]
            ret_heads: mutable dict[u64, u32] = {}
            ret_next: mutable darray[u32] = []

        def vp_fill_hash(name: sview, index: usize) -> u64:
            can Abort.Panic:
                return (name_hash(name) ^ index.u64()) * SEMANTIC_HASH_PRIME

        def vp_store_hash(name: sview, dst_i: usize, src_i: usize) -> u64:
            can Abort.Panic:
                return (((name_hash(name) ^ dst_i.u64()) * SEMANTIC_HASH_PRIME) ^ src_i.u64()) * SEMANTIC_HASH_PRIME

        def vp_ret_flags(facts: VpFacts&, name: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                row: mutable u32 = head if facts.ret_heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, facts, name|:
                    return facts.retf[row.usize()] if facts.retn[row.usize()] == name
                    row <- facts.ret_next[row.usize()]
                return 0

        def vp_has_fill(facts: VpFacts&, name: sview, index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                row: mutable u32 = head if facts.fill_heads.get(vp_fill_hash(name, index)) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, facts, name, index|:
                    return true if facts.filln[row.usize()] == name and facts.filli[row.usize()] == index
                    row <- facts.fill_next[row.usize()]
                return false

        def vp_record_fill(cur: sview, index: usize, pn: darray[sview]&, facts: mutable VpFacts&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if cur == "" or index >= pn.count
                return if vp_has_fill(facts, cur, index)
                hash: u64 = vp_fill_hash(cur, index)
                row: u32 = facts.filln.count.u32()
                previous: u32 = head if facts.fill_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                facts.fill_next.push(previous)
                facts.fill_heads <- facts.fill_heads.put(hash, row)
                facts.filln.push(cur)
                facts.filli.push(index)

        def vp_has_store(facts: VpFacts&, name: sview, dst_i: usize, src_i: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                row: mutable u32 = head if facts.store_heads.get(vp_store_hash(name, dst_i, src_i)) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, facts, name, dst_i, src_i|:
                    return true if facts.stn[row.usize()] == name and facts.sti[row.usize()] == dst_i and facts.stj[row.usize()] == src_i
                    row <- facts.store_next[row.usize()]
                return false

        # Append the (name, dst_i, src_i) store fact; the caller has tested vp_has_store.
        def vp_record_store(facts: mutable VpFacts&, name: sview, dst_i: usize, src_i: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = vp_store_hash(name, dst_i, src_i)
                row: u32 = facts.stn.count.u32()
                previous: u32 = head if facts.store_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                facts.store_next.push(previous)
                facts.store_heads <- facts.store_heads.put(hash, row)
                facts.stn.push(name)
                facts.sti.push(dst_i)
                facts.stj.push(src_i)

        def vp_record_ret(cur: sview, flags: u32, facts: mutable VpFacts&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if cur == "" or flags == 0
                hash: u64 = name_hash(cur)
                row: mutable u32 = head if facts.ret_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, facts, cur, flags|:
                    if facts.retn[row.usize()] == cur:
                        facts.retf[row.usize()] <- facts.retf[row.usize()] | flags
                        return
                    row <- facts.ret_next[row.usize()]
                fresh: u32 = facts.retn.count.u32()
                previous: u32 = head if facts.ret_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                facts.ret_next.push(previous)
                facts.ret_heads <- facts.ret_heads.put(hash, fresh)
                facts.retn.push(cur)
                facts.retf.push(flags)

        def vp_root_flags(expression: Ast::Expr, sn: darray[sview]&, sf: darray[u32]&) -> u32:
            can Memory.Allocate, Abort.Panic:
                root: sview = auto_escape_place_root(expression)
                return 0 if root == ""
                return vp_flags(sn, sf, root)

        def vp_fresh(expression: Ast::Expr, fr: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Array(elements, array_pos):
                        return true
                    Expr.Construct(type_expression, fields, construct_pos):
                        return true
                    Expr.Paren(inner, paren_pos):
                        return vp_fresh(inner, fr)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        callee_name: sview = ident_name_of(callee)
                        return false if callee_name == ""
                        return true if callee_name == "__fstr"
                        return any fresh_name in fr where fresh_name == callee_name
                    _:
                        return false

        # 0 none, 1 direct view of a local owner, 2 value that travelled through a local container.
        def vp_kind(expression: Ast::Expr, sn: darray[sview]&, sf: darray[u32]&, facts: VpFacts&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        flags: u32 = vp_flags(sn, sf, name)
                        return 2 if (flags & 4) != 0
                        return 1 if (flags & 2) != 0
                        return 0
                    Expr.Paren(inner, paren_pos):
                        return vp_kind(inner, sn, sf, facts)
                    Expr.Unary(operator, operand, unary_pos):
                        return vp_kind(operand, sn, sf, facts)
                    Expr.Index(object, index, index_pos):
                        return 2 if vp_kind(object, sn, sf, facts) == 2
                        return 0
                    Expr.Field(object, field, field_pos):
                        return 2 if vp_kind(object, sn, sf, facts) == 2
                        return 0
                    Expr.Array(elements, array_pos):
                        for element in elements:
                            return 2 if vp_kind(element, sn, sf, facts) > 0
                        return 0
                    Expr.Construct(type_expression, fields, construct_pos):
                        for field in fields:
                            return 1 if vp_kind(field.value, sn, sf, facts) > 0
                        return 0
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos):
                        return 2 if vp_kind(iterable, sn, sf, facts) == 2
                        return 0
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Ident(callee_name, callee_pos):
                                if (callee_name == "bytes_view" or callee_name == "bytes_view_range") and arguments.count > 0:
                                    return 1 if (vp_root_flags(arguments[0], sn, sf) & 1) != 0
                                    return 0
                                ret: u32 = vp_ret_flags(facts, callee_name)
                                return 2 if (ret & 1) != 0
                                j: mutable usize = 0
                                while j < arguments.count and j < 15:
                                    if (ret & (2 << j)) != 0:
                                        k: u32 = vp_kind(arguments[j], sn, sf, facts)
                                        return k if k > 0
                                    j <- j + 1
                                return 0
                            Expr.Field(receiver, method, method_pos):
                                if method == "as_sview" and arguments.count == 0:
                                    return 1 if (vp_root_flags(receiver, sn, sf) & 1) != 0
                                if method == "pop" and arguments.count == 0:
                                    return 2 if vp_kind(receiver, sn, sf, facts) == 2
                                return 0
                            _:
                                return 0
                    _:
                        return 0

        # Bitmask of the parameters an expression's value is derived from.
        def vp_pm(expression: Ast::Expr, sn: darray[sview]&, sf: darray[u32]&, sp: darray[u32]&, facts: VpFacts&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_pos):
                        idx: usize = vp_idx(sn, name)
                        return 0 if idx >= sn.count
                        return 0 if (sf[idx] & 8) != 0
                        return sp[idx]
                    Expr.Paren(inner, paren_pos):
                        return vp_pm(inner, sn, sf, sp, facts)
                    Expr.Unary(operator, operand, unary_pos):
                        return vp_pm(operand, sn, sf, sp, facts)
                    Expr.Index(object, index, index_pos):
                        return vp_pm(object, sn, sf, sp, facts)
                    Expr.Field(object, field, field_pos):
                        return vp_pm(object, sn, sf, sp, facts)
                    Expr.Array(elements, array_pos):
                        mask: mutable u32 = 0
                        for element in elements |mask|:
                            mask <- mask | vp_pm(element, sn, sf, sp, facts)
                        return mask
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos):
                        return vp_pm(iterable, sn, sf, sp, facts)
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Ident(callee_name, callee_pos):
                                if (callee_name == "bytes_view" or callee_name == "bytes_view_range") and arguments.count > 0:
                                    return vp_pm(arguments[0], sn, sf, sp, facts)
                                ret: u32 = vp_ret_flags(facts, callee_name)
                                mask: mutable u32 = 0
                                j: mutable usize = 0
                                while j < arguments.count and j < 15:
                                    mask <- mask | vp_pm(arguments[j], sn, sf, sp, facts) if (ret & (2 << j)) != 0
                                    j <- j + 1
                                return mask
                            Expr.Field(receiver, method, method_pos):
                                return vp_pm(receiver, sn, sf, sp, facts) if (method == "pop" or method == "as_sview") and arguments.count == 0
                                return 0
                            _:
                                return 0
                    _:
                        return 0

        # `xs.as_sview()` of an owned local, possibly wrapped in a struct literal.
        def vp_direct_as_sview(expression: Ast::Expr, sn: darray[sview]&, sf: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_pos):
                        return vp_direct_as_sview(inner, sn, sf)
                    Expr.Construct(type_expression, fields, construct_pos):
                        for field in fields:
                            return true if vp_direct_as_sview(field.value, sn, sf)
                        return false
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(receiver, method, method_pos):
                                return method == "as_sview" and arguments.count == 0 and (vp_root_flags(receiver, sn, sf) & 1) != 0
                            _:
                                return false
                    _:
                        return false

        def vp_report(line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # A store already reported on this line with stage0's region text (handler capture
                # escape's element-store line, or its "via a fresh container" pair) covers it;
                # stage0 prints no extra column-less `in auto:` line there.
                duplicate: bool = any existing in table.diagnostics where (existing.kind == DiagnosticKind.AutoRegionStoreEscape or existing.kind == DiagnosticKind.RegionStoreEscapeVia or (existing.kind == DiagnosticKind.RegionStoreEscape and existing.pos.line != 0)) and existing.line == line
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AutoRegionStoreEscape, name: "", line: line, expected: "", actual: ""}) if not duplicate

        # Effects of a call statement: pushes into targets/locals, fill callees.
        def vp_call(expression: Ast::Expr, line: u32, cur: sview, cs: sview, pn: darray[sview]&, sn: mutable darray[sview]&, sf: mutable darray[u32]&, sp: mutable darray[u32]&, sa: mutable darray[sview]&, facts: mutable VpFacts&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(receiver, method, method_pos):
                                return if (method != "push" and method != "extend") or arguments.count != 1
                                receiver_name: sview = ident_name_of(receiver)
                                return if receiver_name == ""
                                target: sview = vp_target(sn, sf, sa, receiver_name)
                                kind: u32 = vp_kind(arguments[0], sn, sf, facts)
                                mask: u32 = vp_pm(arguments[0], sn, sf, sp, facts)
                                if target != "":
                                    table <- vp_report(line, table) if kind == 2
                                    table <- vp_report(line, table) if method == "push" and vp_direct_as_sview(arguments[0], sn, sf)
                                    # The same view bound to a LOCAL first (`v: sview = xs.as_sview()`,
                                    # `w: sview = v`) then pushed: stage0 keeps the local's region.
                                    table <- vp_report(line, table) if method == "push" and (vp_flags(sn, sf, ident_name_of(arguments[0])) & 256) != 0
                                    if method == "push" and (vp_flags(sn, sf, target) & 128) != 0:
                                        match arguments[0]:
                                            Expr.Array(literal_elements, literal_pos):
                                                table <- vp_report(line, table) if literal_elements.count > 0
                                            _:
                                                pass
                                    j_store: usize = vp_param_index(pn, target)
                                    if j_store < pn.count and cs != "":
                                        from_bit: mutable usize = 0
                                        while from_bit < pn.count and from_bit < 15:
                                            if ((mask >> from_bit.u32()) & 1.u32()) != 0.u32() and from_bit != j_store and not vp_has_store(facts, cs, j_store + (pn.count << 16), from_bit):
                                                vp_record_store(facts, cs, j_store + (pn.count << 16), from_bit)
                                            from_bit <- from_bit + 1
                                    vp_record_fill(cur, vp_param_index(pn, target), pn, facts) if kind > 0
                                else:
                                    receiver_flags: u32 = vp_flags(sn, sf, receiver_name)
                                    if (receiver_flags & 64) != 0:
                                        vp_set(sn, sf, sp, sa, receiver_name, 4 if kind > 0 else 0, mask)
                            Expr.Ident(callee_name, callee_pos):
                                j: mutable usize = 0
                                while j < arguments.count:
                                    arg_name: sview = ident_name_of(arguments[j])
                                    if arg_name != "" and vp_has_fill(facts, callee_name, j):
                                        target: sview = vp_target(sn, sf, sa, arg_name)
                                        if target != "":
                                            vp_record_fill(cur, vp_param_index(pn, target), pn, facts)
                                        else:
                                            arg_flags: u32 = vp_flags(sn, sf, arg_name)
                                            vp_set(sn, sf, sp, sa, arg_name, 4, 0) if (arg_flags & 64) != 0
                                    j <- j + 1
                                # Call-store: the callee pushes argument `src_i` into argument `dst_i`.
                                dst_i: mutable usize = 0
                                while dst_i < arguments.count |dst_i, facts, table| -> table:
                                    into_target: sview = vp_target(sn, sf, sa, ident_name_of(arguments[dst_i]))
                                    if into_target != "":
                                        src_i: mutable usize = 0
                                        while src_i < arguments.count |src_i, facts, table| -> table:
                                            if src_i != dst_i and vp_has_store(facts, callee_name, dst_i + (arguments.count << 16), src_i):
                                                stored_kind: u32 = vp_kind(arguments[src_i], sn, sf, facts)
                                                table <- vp_report(line, table) if stored_kind > 0
                                                vp_record_fill(cur, vp_param_index(pn, into_target), pn, facts) if stored_kind > 0
                                            src_i <- src_i + 1
                                    dst_i <- dst_i + 1
                            _:
                                pass
                    _:
                        pass

        def vp_collect_decls(body: darray[Ast::Stmt], sn: mutable darray[sview]&, sf: mutable darray[u32]&, sp: mutable darray[u32]&, sa: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |sn, sf, sp, sa|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if vp_idx(sn, name) < sn.count:
                                vp_set(sn, sf, sp, sa, name, 8, 0)
                            else:
                                vp_set(sn, sf, sp, sa, name, 0, 0)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                            loop_var: sview = for_variables[0] if for_variables.count > 0 else for_bind
                            if vp_idx(sn, loop_var) < sn.count:
                                vp_set(sn, sf, sp, sa, loop_var, 8, 0)
                            else:
                                vp_set(sn, sf, sp, sa, loop_var, 0, 0)
                            vp_collect_decls(for_body, sn, sf, sp, sa)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            vp_collect_decls(block_body, sn, sf, sp, sa)
                        Stmt.If(condition, then_body, else_body, if_line):
                            vp_collect_decls(then_body, sn, sf, sp, sa)
                            vp_collect_decls(else_body, sn, sf, sp, sa)
                        Stmt.While(condition, while_body, while_line):
                            vp_collect_decls(while_body, sn, sf, sp, sa)
                        Stmt.Match(match_scrutinee, match_arms, match_line):
                            for arm in match_arms |sn, sf, sp, sa|:
                                vp_collect_decls(arm.body, sn, sf, sp, sa)
                        _:
                            pass

        def vp_walk(body: darray[Ast::Stmt], cur: sview, cs: sview, pn: darray[sview]&, fr: darray[sview]&, sn: mutable darray[sview]&, sf: mutable darray[u32]&, sp: mutable darray[u32]&, sa: mutable darray[sview]&, facts: mutable VpFacts&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |sn, sf, sp, sa, facts, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- vp_call(value, line.line, cur, cs, pn, sn, sf, sp, sa, facts, table)
                            kind: u32 = vp_kind(value, sn, sf, facts)
                            mask: u32 = vp_pm(value, sn, sf, sp, facts)
                            flags: mutable u32 = 64
                            flags <- flags | 2 if kind == 1
                            flags <- flags | 4 if kind == 2
                            flags <- flags | 1 if vp_fresh(value, fr)
                            as_sview_local: mutable bool = vp_direct_as_sview(value, sn, sf)
                            alias_flags: u32 = vp_flags(sn, sf, ident_name_of(value))
                            as_sview_local <- true if (alias_flags & 256) != 0
                            flags <- flags | 256 if as_sview_local
                            vp_set(sn, sf, sp, sa, name, flags, mask)
                            alias_target: sview = vp_target(sn, sf, sa, ident_name_of(value))
                            if alias_target != "":
                                idx: usize = vp_idx(sn, name)
                                sa[idx] <- alias_target
                        Stmt.Expr(expression, line):
                            table <- vp_call(expression, line.line, cur, cs, pn, sn, sf, sp, sa, facts, table)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_pos):
                            table <- vp_call(assign_value, assign_pos.line, cur, cs, pn, sn, sf, sp, sa, facts, table)
                            assigned: sview = ident_name_of(assign_target)
                            if assigned != "" and (vp_flags(sn, sf, assigned) & 32) == 0:
                                vp_set(sn, sf, sp, sa, assigned, 8, 0)
                        Stmt.Return(return_value, return_pos):
                            if return_value is returned:
                                table <- vp_call(returned, return_pos.line, cur, cs, pn, sn, sf, sp, sa, facts, table)
                                kind: u32 = vp_kind(returned, sn, sf, facts)
                                mask: u32 = vp_pm(returned, sn, sf, sp, facts)
                                vp_record_ret(cur, (1 if kind == 2 else 0) | ((mask & 32767) << 1), facts)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_line):
                            loop_var: sview = for_variables[0] if for_variables.count > 0 else for_bind
                            kind: u32 = vp_kind(for_iterable, sn, sf, facts)
                            mask: u32 = vp_pm(for_iterable, sn, sf, sp, facts)
                            flags: mutable u32 = 64
                            flags <- flags | 4 if kind == 2
                            owned_iterable: bool = (vp_root_flags(for_iterable, sn, sf) & 1) != 0
                            flags <- flags | 1 if owned_iterable
                            vp_set(sn, sf, sp, sa, loop_var, flags, mask)
                            table <- vp_walk(for_body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                            table <- vp_walk(for_body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- vp_walk(block_body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- vp_walk(then_body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                            table <- vp_walk(else_body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- vp_walk(while_body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                            table <- vp_walk(while_body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                        Stmt.Match(match_scrutinee, match_arms, match_line):
                            for arm in match_arms |sn, sf, sp, sa, facts, table| -> table:
                                table <- vp_walk(arm.body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                        _:
                            pass

        # Same-named declaration counts, built ONCE per check. The checks below ask "is this the
        # only function with this name (and arity)" for every declaration in every fixpoint
        # round; a fresh walk of the whole declaration tree per question was quadratic. One
        # entry per distinct (name, arity), chained by name hash and compared exactly.
        struct VpCounts:
            heads: mutable dict[u64, u32]
            tails: mutable dict[u64, u32]
            next: mutable darray[u32]
            names: mutable darray[sview]
            arities: mutable darray[usize]
            counts: mutable darray[u32]

        def vp_counts_add(index: mutable VpCounts&, name: sview, arity: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = name_hash(name)
                row: mutable u32 = head if index.heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, index, name, arity|:
                    if index.names[row.usize()] == name and index.arities[row.usize()] == arity:
                        index.counts[row.usize()] <- index.counts[row.usize()] + 1
                        return
                    row <- index.next[row.usize()]
                fresh: u32 = index.names.count.u32()
                index.names <- index.names.push(name)
                index.arities <- index.arities.push(arity)
                index.counts <- index.counts.push(1)
                index.next <- index.next.push(SYMBOL_INDEX_ROW_NONE)
                if index.tails.get(hash) is previous:
                    index.next[previous.usize()] <- fresh
                else:
                    index.heads <- index.heads.put(hash, fresh)
                index.tails <- index.tails.put(hash, fresh)

        def vp_counts_build(declarations: darray[Ast::Decl], index: mutable VpCounts&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |index|:
                    match declaration:
                        Decl.Func(fname, parameters, return_type, body, effects, decorators, line):
                            vp_counts_add(index, fname, parameters.count)
                        Decl.Module(module_name, module_body, module_line):
                            vp_counts_build(module_body, index)
                        Decl.Scoped(scoped_body, scoped_line):
                            vp_counts_build(scoped_body, index)
                        _:
                            pass

        def vp_count_names(index: VpCounts&, name: sview) -> u32:
            can Abort.Panic:
                total: mutable u32 = 0
                row: mutable u32 = head if index.heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, total, index, name|:
                    total <- total + index.counts[row.usize()] if index.names[row.usize()] == name
                    row <- index.next[row.usize()]
                return total

        # Same-named declarations with this many parameters (call-store summaries are arity-keyed).
        def vp_count_arity(index: VpCounts&, name: sview, arity: usize) -> u32:
            can Abort.Panic:
                total: mutable u32 = 0
                row: mutable u32 = head if index.heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, total, index, name, arity|:
                    total <- total + index.counts[row.usize()] if index.names[row.usize()] == name and index.arities[row.usize()] == arity
                    row <- index.next[row.usize()]
                return total

        def vp_collect_fresh(all_decls: VpCounts&, declarations: darray[Ast::Decl], fr: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |fr|:
                    match declaration:
                        Decl.Func(fname, parameters, return_type, body, effects, decorators, line):
                            takes_container: bool = any parameter in parameters where annotation_is_container(parameter.type_expression)
                            if return_type is declared_return:
                                fr.push(fname) if annotation_is_scalar_darray(declared_return) and not takes_container and vp_count_names(all_decls, fname) == 1
                                plain_struct: bool = ident_name_of(declared_return) != "" and ident_name_of(declared_return) != "sview" and parameters.count == 0
                                fr.push(fname) if plain_struct and vp_count_names(all_decls, fname) == 1
                        Decl.Module(module_name, module_body, module_line):
                            vp_collect_fresh(all_decls, module_body, fr)
                        Decl.Scoped(scoped_body, scoped_line):
                            vp_collect_fresh(all_decls, scoped_body, fr)
                        _:
                            pass

        def vp_pass(all_decls: VpCounts&, declarations: darray[Ast::Decl], fr: darray[sview]&, facts: mutable VpFacts&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |facts, table| -> table:
                    match declaration:
                        Decl.Func(fname, parameters, return_type, body, effects, decorators, line):
                            cur: sview = fname if vp_count_names(all_decls, fname) == 1 else ""
                            cs: sview = fname if vp_count_arity(all_decls, fname, parameters.count) == 1 else ""
                            pn: mutable darray[sview] = []
                            sn: mutable darray[sview] = []
                            sf: mutable darray[u32] = []
                            sp: mutable darray[u32] = []
                            sa: mutable darray[sview] = []
                            for parameter in parameters |pn, sn, sf, sp, sa, table|:
                                region_tied: bool = any tied_name in table.region_tied_param_names where tied_name == parameter.name
                                flags: mutable u32 = 32
                                flags <- flags | 16 if param_is_mutable_ref(parameter) and not region_tied and annotation_is_container(parameter.type_expression)
                                flags <- flags | 128 if param_is_mutable_ref(parameter) and not region_tied and annotation_is_container(parameter.type_expression) and not annotation_is_scalar_darray(parameter.type_expression)
                                bit: u32 = (1.u32() << pn.count.u32()) if pn.count < 15 else 0.u32()
                                pn.push(parameter.name)
                                vp_set(sn, sf, sp, sa, parameter.name, flags, bit)
                            vp_collect_decls(body, sn, sf, sp, sa)
                            table <- vp_walk(body, cur, cs, pn, fr, sn, sf, sp, sa, facts, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- vp_pass(all_decls, module_body, fr, facts, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- vp_pass(all_decls, scoped_body, fr, facts, table)
                        _:
                            pass

    public:
        def check_view_provenance(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                fr: mutable darray[sview] = []
                facts: mutable VpFacts = VpFacts{filln: [], filli: [], stn: [], sti: [], stj: [], retn: [], retf: []}
                counts: mutable VpCounts = VpCounts{heads: {}, tails: {}, next: [], names: [], arities: [], counts: []}
                vp_counts_build(declarations, counts)
                vp_collect_fresh(counts, declarations, fr)
                round: mutable u32 = 0
                while round < 6 |round, facts, table| -> table:
                    before: mutable u32 = facts.filln.count.u32() + facts.stn.count.u32()
                    for flag in facts.retf |before|:
                        before <- before + flag + 1
                    table <- vp_pass(counts, declarations, fr, facts, table)
                    after: mutable u32 = facts.filln.count.u32() + facts.stn.count.u32()
                    for flag in facts.retf |after|:
                        after <- after + flag + 1
                    round <- 6 if after == before else round + 1
