# Errorset-parameter shadowing. A `def f[errorset E](...)` parameter whose name E is also a
# declared error set (`error E:`) shadows that set — inside f, `error[E]` refers to the
# parameter, not the declared set, which is almost always a mistake:
#
#   error IoErr: Bad
#   def shady[errorset IoErr](f: fn() -> i64 error[IoErr]) -> i64 error[IoErr]: ...
#
# Errorset parameters are recorded by the parser on __errorset_param (name, keyed by the
# function's line). Declared error sets lower to enums, so their names appear as
# enum_variant owners. A warning fires when the two coincide.
extend Semantic:
    private:
        def esh_is_error_set(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                for owner in table.enum_variant_owner:
                    true return if owner == name
                return false

        def esh_func_at_line(declarations: darray[Ast::Decl]&, target_line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            name return if line == target_line
                        Decl.Module(module_name, module_body, module_line) | Decl.Scoped(module_body, module_line):
                            nested: sview = esh_func_at_line(module_body, target_line)
                            nested return if nested != ""
                        _:
                            pass
                return sview("", 0, 0)

    public:
        def check_errorset_shadow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.owner == "__errorset_param" and esh_is_error_set(table, annotation.name):
                        function_name: sview = esh_func_at_line(file.top_decls, annotation.line)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorsetParamShadow, name: annotation.name, line: annotation.line, expected: "", actual: function_name}) if function_name != ""
