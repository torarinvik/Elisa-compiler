# Errorset-parameter shadowing. A `def f[errorset E](...)` parameter whose name E is also a
# declared error set (`error E:`) shadows that set — inside f, `error[E]` refers to the
# parameter, not the declared set, which is almost always a mistake:
#
#   error IoErr: Bad
#   def shady[errorset IoErr](f: fn() -> i64 error[IoErr]) -> i64 error[IoErr]: ...
#
# Errorset parameters are recorded by the parser on __errorset_param (name, keyed by the
# function's line and source offset). Compare them with error-set declarations that are
# visible from that function's module; a sibling module's same-leaf declaration is unrelated.
extend Semantic:
    private:
        def esh_static_scope_is_inactive(file: Ast::File&, position: Ast::Pos, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                branch_row: usize = pma_static_if_row_for_position(file, position)
                return false if branch_row >= file.static_if_lines.count
                branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                return branch.known and not branch.selected

        # Count declarations on TARGET_LINE and those at the exact source offset. Rows
        # with a nonzero offset must resolve exactly; offsetless legacy rows may use the
        # line only when it identifies one declaration.
        def esh_function_position_counts(declarations: darray[Ast::Decl]&, target_line: u32, target_offset: u32, current_module: sview @source, file: Ast::File&, table: mutable SymbolTable&) -> (exact_count: usize, exact_name: sview @source, exact_module: sview @source, line_count: usize, line_name: sview @source, line_module: sview @source):
            can Memory.Allocate, Abort.Panic:
                exact_count: mutable usize = 0.usize()
                exact_name: mutable sview @source = ""
                exact_module: mutable sview @source = ""
                line_count: mutable usize = 0.usize()
                line_name: mutable sview @source = ""
                line_module: mutable sview @source = ""
                for declaration in declarations |exact_count, exact_name, exact_module, line_count, line_name, line_module, current_module, table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            if line.line == target_line:
                                line_count <- line_count + 1.usize()
                                line_name <- name
                                line_module <- current_module
                                if line.offset == target_offset:
                                    exact_count <- exact_count + 1.usize()
                                    exact_name <- name
                                    exact_module <- current_module
                        Decl.Module(module_name, module_body, module_line):
                            # Decl.Module names are canonical qualified AST paths;
                            # try_noncall_module_path remains for relative import strings.
                            nested_module: sview = module_name
                            nested: (exact_count: usize, exact_name: sview @source, exact_module: sview @source, line_count: usize, line_name: sview @source, line_module: sview @source) = esh_function_position_counts(module_body, target_line, target_offset, nested_module, file, table)
                            exact_count <- exact_count + nested.exact_count
                            exact_name <- nested.exact_name if nested.exact_count > 0.usize()
                            exact_module <- nested.exact_module if nested.exact_count > 0.usize()
                            line_count <- line_count + nested.line_count
                            line_name <- nested.line_name if nested.line_count > 0.usize()
                            line_module <- nested.line_module if nested.line_count > 0.usize()
                        Decl.Scoped(module_body, module_line):
                            continue if esh_static_scope_is_inactive(file, module_line, current_module, table)
                            nested: (exact_count: usize, exact_name: sview @source, exact_module: sview @source, line_count: usize, line_name: sview @source, line_module: sview @source) = esh_function_position_counts(module_body, target_line, target_offset, current_module, file, table)
                            exact_count <- exact_count + nested.exact_count
                            exact_name <- nested.exact_name if nested.exact_count > 0.usize()
                            exact_module <- nested.exact_module if nested.exact_count > 0.usize()
                            line_count <- line_count + nested.line_count
                            line_name <- nested.line_name if nested.line_count > 0.usize()
                            line_module <- nested.line_module if nested.line_count > 0.usize()
                        _:
                            pass
                return (exact_count, exact_name, exact_module, line_count, line_name, line_module)

        def esh_func_at_position(declarations: darray[Ast::Decl]&, target_line: u32, target_offset: u32, file: Ast::File&, table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                matches: (exact_count: usize, exact_name: sview @source, exact_module: sview @source, line_count: usize, line_name: sview @source, line_module: sview @source) = esh_function_position_counts(declarations, target_line, target_offset, "", file, table)
                return matches.exact_name if matches.exact_count == 1.usize()
                return "" if matches.exact_count > 1.usize()
                return matches.line_name if target_offset == 0 and matches.line_count == 1.usize()
                return ""

        def esh_func_metadata_at_position(declarations: darray[Ast::Decl]&, target_line: u32, target_offset: u32, file: Ast::File&, table: mutable SymbolTable&) -> (found: bool, name: sview @source, module: sview @source):
            can Memory.Allocate, Abort.Panic:
                matches: (exact_count: usize, exact_name: sview @source, exact_module: sview @source, line_count: usize, line_name: sview @source, line_module: sview @source) = esh_function_position_counts(declarations, target_line, target_offset, "", file, table)
                return (true, matches.exact_name, matches.exact_module) if matches.exact_count == 1.usize()
                return (true, matches.line_name, matches.line_module) if target_offset == 0 and matches.line_count == 1.usize()
                return (false, "", "")

        def esh_error_set_decl_is_private(annotations: darray[Ast::EnumAnnotation]&, declaration: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                for index in 0..<annotations.count:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    if annotation.owner == "__private_member" and annotation.name == declaration.name and index + 1.usize() < annotations.count:
                        module_row: Ast::EnumAnnotation = annotations[index + 1.usize()]
                        return true if module_row.owner == "__private_member_module" and module_row.name == declaration.module
                    return true if annotation.owner == "__section_private" and annotation.name == declaration.name and annotation.module == declaration.module
                return false

        def esh_error_set_decl_has_owner(annotations: darray[Ast::EnumAnnotation]&, name: sview, module: sview) -> bool:
            can Abort.Panic:
                return any declaration in annotations where declaration.owner == "__error_set_decl" and declaration.name == name and declaration.module == module

        def esh_root_error_set_is_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                for declaration in annotations:
                    continue if declaration.owner != "__error_set_decl" or declaration.name != name or declaration.module != ""
                    # Core treats the file-scope owner as globally accessible; private
                    # sections only gate members owned by a named module.
                    return true
                return false

        def esh_module_parent(module_path: sview @source) -> sview @source:
            can Abort.Panic:
                separator: mutable usize = module_path.len
                offset: mutable usize = 0
                while offset + 1.usize() < module_path.len |separator, offset, module_path|:
                    separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                    offset <- offset + 1.usize()
                return "" if separator == module_path.len
                return module_path[0:separator]

        def esh_local_symbol_shadows_family(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, scope_module: sview @source, function_module: sview @source, symbol: Symbol, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> bool:
            can Abort.Panic:
                if symbol.kind == SymbolKind.Alias:
                    return false if try_error_alias_is_private(annotations, name, scope_module) and not catch_module_is_ancestor(scope_module, function_module)
                    alias: (found: bool, index: usize) = try_error_alias_index(name, scope_module, table)
                    return not alias.found or not esh_alias_index_targets_error_set(annotations, alias.index, table, visited)
                return true if symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum
                return true if symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type
                return false

        # Core checks a module's local nominal types before imports. Error-set declarations
        # stay distinct from ordinary enums, and visible root ErrorSets keep precedence over
        # every lexical/import candidate. Snapshot counts keep alias resolution safe if it
        # interns additional semantic data in the symbol table.
        def esh_local_nominal_type_shadows_family(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, function_module: sview @source, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> bool:
            can Abort.Panic:
                root_count: usize = table.symbols.count
                root_index: mutable usize = 0.usize()
                while root_index < root_count |root_index, annotations, name, function_module, table, visited|:
                    symbol: Symbol = table.symbols[root_index]
                    if symbol.name == name and symbol.module_owner == "":
                        if symbol.kind == SymbolKind.Enum and esh_error_set_decl_has_owner(annotations, name, ""):
                            pass
                        elif symbol.kind == SymbolKind.Alias and try_error_alias_is_private(annotations, name, "") and not catch_module_is_ancestor("", function_module):
                            pass
                        else:
                            return esh_local_symbol_shadows_family(annotations, name, "", function_module, symbol, table, visited)
                    root_index <- root_index + 1.usize()
                scope_module: mutable sview @source = function_module
                while true |scope_module, annotations, name, table, visited|:
                    return false if esh_error_set_decl_has_owner(annotations, name, scope_module)
                    scope_count: usize = table.symbols.count
                    scope_index: mutable usize = 0.usize()
                    while scope_index < scope_count |scope_index, annotations, name, scope_module, table, visited|:
                        symbol: Symbol = table.symbols[scope_index]
                        if symbol.name == name and symbol.module_owner == scope_module:
                            if symbol.kind == SymbolKind.Alias and try_error_alias_is_private(annotations, name, scope_module) and not catch_module_is_ancestor(scope_module, function_module):
                                pass
                            else:
                                return esh_local_symbol_shadows_family(annotations, name, scope_module, function_module, symbol, table, visited)
                        scope_index <- scope_index + 1.usize()
                    break if scope_module == ""
                    scope_module <- esh_module_parent(scope_module)
                return false

        # An alias whose target is an ErrorSet keeps that identity in type position.
        # Check root aliases first, then the nearest lexical parent, matching Try's local
        # alias precedence and respecting private module boundaries.
        def esh_local_alias_names_error_set(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, function_module: sview @source, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> bool:
            can Abort.Panic:
                root_count: usize = table.symbols.count
                root_index: mutable usize = 0.usize()
                while root_index < root_count |root_index, annotations, name, function_module, table, visited|:
                    symbol: Symbol = table.symbols[root_index]
                    if symbol.name == name and symbol.module_owner == "" and symbol.kind == SymbolKind.Alias:
                        if try_error_alias_is_private(annotations, name, "") and not catch_module_is_ancestor("", function_module):
                            pass
                        else:
                            alias: (found: bool, index: usize) = try_error_alias_index(name, "", table)
                            return esh_alias_index_targets_error_set(annotations, alias.index, table, visited) if alias.found
                    root_index <- root_index + 1.usize()
                scope_module: mutable sview @source = function_module
                while true |scope_module, annotations, name, table, visited|:
                    scope_count: usize = table.symbols.count
                    scope_index: mutable usize = 0.usize()
                    while scope_index < scope_count |scope_index, annotations, name, scope_module, table, visited|:
                        symbol: Symbol = table.symbols[scope_index]
                        if symbol.name == name and symbol.module_owner == scope_module and symbol.kind == SymbolKind.Alias:
                            if try_error_alias_is_private(annotations, name, scope_module) and not catch_module_is_ancestor(scope_module, function_module):
                                pass
                            else:
                                alias: (found: bool, index: usize) = try_error_alias_index(name, scope_module, table)
                                return esh_alias_index_targets_error_set(annotations, alias.index, table, visited) if alias.found
                        scope_index <- scope_index + 1.usize()
                    break if scope_module == ""
                    scope_module <- esh_module_parent(scope_module)
                return false

        def esh_import_type_candidate(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, raw_module: sview @source, import_module: sview @source, import_line: u32, function_module: sview @source, scope_bound: bool, table: mutable SymbolTable&) -> (found: bool, is_error_set: bool):
            can Abort.Panic:
                return (false, false) if scope_bound and not catch_module_is_ancestor(import_module, function_module)
                # An imported ErrorSet declared under this spelling is the candidate
                # identity directly; root-owned private names remain globally visible.
                for declaration in annotations:
                    continue if declaration.owner != "__error_set_decl" or declaration.name != name
                    continue if not try_error_alias_module_visible(annotations, declaration.module, function_module) or not try_error_alias_name_visible(annotations, name, declaration.module, function_module)
                    continue if esh_error_set_decl_is_private(annotations, declaration) and not catch_module_is_ancestor(declaration.module, function_module)
                    return (true, true) if esh_import_path_matches(annotations, raw_module, import_module, import_line, function_module, declaration.module, scope_bound)
                # A type alias imported under a distinct name has no matching
                # __error_set_decl row. Resolve its retained target AST instead.
                alias_count: usize = table.type_alias_name.count
                alias_index: mutable usize = 0.usize()
                matching_alias_count: mutable usize = 0.usize()
                matching_alias_index: mutable usize = 0.usize()
                while alias_index < alias_count |alias_index, annotations, name, raw_module, import_module, import_line, function_module, scope_bound, table|:
                    if table.type_alias_name[alias_index] == name and alias_index < table.type_alias_declarations.count:
                        alias: TypeAliasDeclaration = table.type_alias_declarations[alias_index]
                        if try_error_alias_module_visible(annotations, alias.module_owner, function_module) and try_error_alias_name_visible(annotations, name, alias.module_owner, function_module) and esh_import_path_matches(annotations, raw_module, import_module, import_line, function_module, alias.module_owner, scope_bound):
                            matching_alias_count <- matching_alias_count + 1.usize()
                            matching_alias_index <- alias_index
                    alias_index <- alias_index + 1.usize()
                return (true, false) if matching_alias_count > 1.usize()
                if matching_alias_count == 1.usize():
                    identity: (found: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_alias_identity_for_index(annotations, matching_alias_index, table)
                    return (true, identity.found and not identity.ambiguous)
                # A local nominal type reached through the import path owns the bare
                # spelling even when it is not an ErrorSet.
                for symbol in table.symbols |annotations, name, raw_module, import_module, import_line, function_module, scope_bound|:
                    continue if symbol.name != name or (symbol.kind != SymbolKind.Struct and symbol.kind != SymbolKind.Enum and not (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type))
                    continue if not try_error_alias_module_visible(annotations, symbol.module_owner, function_module) or not try_error_alias_name_visible(annotations, name, symbol.module_owner, function_module)
                    return (true, false) if esh_import_path_matches(annotations, raw_module, import_module, import_line, function_module, symbol.module_owner, scope_bound)
                return (false, false)

        # Try resolves ordinary local alias chains itself. If a local alias's bare
        # target is a program-wide selective import recorded in another module, finish
        # that target lookup with ESH's Core-compatible import candidate path.
        def esh_alias_index_targets_error_set(annotations: darray[Ast::EnumAnnotation]&, alias_index: usize, table: mutable SymbolTable&, visited: mutable darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if alias_index >= table.type_alias_declarations.count
                declaration: TypeAliasDeclaration = table.type_alias_declarations[alias_index]
                return false if any prior_id in visited where prior_id == declaration.declaration_id.value
                visited <- visited.push(declaration.declaration_id.value)
                identity: (found: bool, family: sview @source, module: sview @source, ambiguous: bool) = try_error_alias_identity_for_index(annotations, alias_index, table)
                result: mutable bool = false
                if identity.found and not identity.ambiguous:
                    result <- true
                else:
                    target_path: sview @source = try_error_alias_target_path(declaration.target, table)
                    if target_path != "" and catch_first_module_separator_start(target_path) == target_path.len:
                        target_name: sview @source = target_path
                        if esh_root_error_set_is_visible(annotations, target_name):
                            result <- true
                        elif not esh_local_nominal_type_shadows_family(annotations, target_name, declaration.module_owner, table, visited):
                            if esh_local_alias_names_error_set(annotations, target_name, declaration.module_owner, table, visited):
                                result <- true
                            elif esh_local_error_set_is_visible(annotations, target_name, declaration.module_owner):
                                result <- true
                            else:
                                imported: (found: bool, is_error_set: bool) = esh_imported_name_candidate(annotations, target_name, declaration.module_owner, table)
                                result <- imported.found and imported.is_error_set
                _ = visited.pop()
                return result

        # Local ErrorSets are lexical namespace candidates and therefore precede imports.
        # Root ErrorSets are handled separately because Core gives them root precedence.
        def esh_local_error_set_is_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, function_module: sview @source) -> bool:
            can Abort.Panic:
                for declaration in annotations:
                    continue if declaration.owner != "__error_set_decl" or declaration.name != name
                    return true if declaration.module == function_module
                    if catch_module_is_ancestor(declaration.module, function_module):
                        return true if declaration.module != "" or not esh_error_set_decl_is_private(annotations, declaration)
                return false

        # Lexical wildcard `using` candidates precede the program-wide selective import
        # alias. A selective import's first bare-name row owns the name across modules.
        # Preserve whether a non-ErrorSet candidate claimed the name so it can shadow
        # lower-precedence imported ErrorSets.
        def esh_imported_name_candidate(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, function_module: sview @source, table: mutable SymbolTable&) -> (found: bool, is_error_set: bool):
            can Abort.Panic:
                scope_module: mutable sview @source = function_module
                while true |scope_module, annotations, name, function_module, table|:
                    for import_row in annotations:
                        if import_row.name == "__binding_wildcard_import" and import_row.module == scope_module:
                            candidate: (found: bool, is_error_set: bool) = esh_import_type_candidate(annotations, name, import_row.owner, import_row.module, import_row.line, function_module, true, table)
                            return candidate if candidate.found
                    break if scope_module == ""
                    scope_module <- esh_module_parent(scope_module)
                for import_row in annotations:
                    if import_row.owner == "__from_member" and import_row.name == name:
                        for source_row in annotations:
                            continue if source_row.owner != "__from_src" or source_row.module != import_row.module or source_row.line != import_row.line or source_row.offset != import_row.offset
                            candidate: (found: bool, is_error_set: bool) = esh_import_type_candidate(annotations, name, source_row.name, import_row.module, import_row.line, function_module, false, table)
                            return candidate if candidate.found
                            return (false, false)
                return (false, false)

        def esh_import_path_matches(annotations: darray[Ast::EnumAnnotation]&, raw_module: sview @source, import_module: sview @source, import_line: u32, function_module: sview @source, declaration_module: sview @source, scope_bound: bool) -> bool:
            can Abort.Panic:
                return false if scope_bound and not catch_module_is_ancestor(import_module, function_module)
                # Core qualifies an import's raw module path against its enclosing
                # namespace. A separate `using ... as ...` alias does not rewrite the
                # import target, even when it has the same spelling.
                return catch_module_alias_path_matches(import_module, raw_module, declaration_module) if import_module != ""
                return catch_module_path_matches(raw_module, declaration_module)

        def esh_error_set_imported(annotations: darray[Ast::EnumAnnotation]&, declaration: Ast::EnumAnnotation, function_module: sview @source) -> bool:
            can Abort.Panic:
                # Core tries lexical `using` candidates before the program-wide
                # selective-import alias, regardless of source order.
                for import_row in annotations:
                    if import_row.name == "__binding_wildcard_import":
                        return true if esh_import_path_matches(annotations, import_row.owner, import_row.module, import_row.line, function_module, declaration.module, true)
                # Selective imports share one bare-name alias. The first row is the
                # winner; later conflicting imports do not add another candidate.
                for import_row in annotations:
                    if import_row.owner == "__from_member" and import_row.name == declaration.name:
                        for source_row in annotations:
                            continue if source_row.owner != "__from_src" or source_row.module != import_row.module or source_row.line != import_row.line or source_row.offset != import_row.offset
                            return esh_import_path_matches(annotations, source_row.name, import_row.module, import_row.line, function_module, declaration.module, false)
                return false

        # The shared import projection retains unresolved static arms and marks them.
        # They may provide an ErrorSet with this leaf, so imported visibility cannot be
        # decided from only the first definite candidate. Defer the shadow diagnostic
        # whenever such a visible import could contribute the queried name.
        def esh_unknown_static_import_may_define(annotations: darray[Ast::EnumAnnotation]&, name: sview, function_module: sview) -> bool:
            can Abort.Panic:
                for marker in annotations:
                    continue if marker.owner != "__pma_unknown_static_import" or not catch_module_is_ancestor(marker.module, function_module)
                    return true if marker.name == "__from_member" and marker.detail_name == name
                    return true if marker.detail_name == "__binding_wildcard_import"
                return false

        def esh_is_error_set_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview @source, function_module: sview @source, function_offset: u32, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                # Core resolves a visible local nominal type before imported type
                # candidates. An imported ErrorSet with the same bare name is therefore
                # not visible as that name when a local non-ErrorSet type shadows it.
                # A visible root ErrorSet has priority over lexical module types.
                return true if esh_root_error_set_is_visible(annotations, name)
                visited: mutable darray[u32] = []
                return false if esh_local_nominal_type_shadows_family(annotations, name, function_module, table, visited)
                return true if esh_local_alias_names_error_set(annotations, name, function_module, table, visited)
                return true if esh_local_error_set_is_visible(annotations, name, function_module)
                return false if esh_unknown_static_import_may_define(annotations, name, function_module)
                imported: (found: bool, is_error_set: bool) = esh_imported_name_candidate(annotations, name, function_module, table)
                return imported.is_error_set if imported.found
                for declaration in annotations:
                    continue if declaration.owner != "__error_set_decl" or declaration.name != name
                    is_private: bool = esh_error_set_decl_is_private(annotations, declaration)
                    return true if declaration.module == function_module
                    if catch_module_is_ancestor(declaration.module, function_module):
                        # Nested modules remain inside a named module's private boundary.
                        # The empty top-level owner has no such descendant boundary.
                        return true if declaration.module != "" or not is_private
                    return true if not is_private and try_error_alias_module_visible(annotations, declaration.module, function_module) and esh_error_set_imported(annotations, declaration, function_module)
                return false

    public:
        def check_errorset_shadow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Imported ErrorSet candidates participate in shadow diagnostics. A
                # proven-inactive static arm is not a visible candidate and must not
                # create or suppress this diagnostic.
                annotations: darray[Ast::EnumAnnotation] = pma_active_import_annotations(file, table)
                for annotation in annotations |table| -> table:
                    if annotation.owner == "__errorset_param":
                        function: (found: bool, name: sview @source, module: sview @source) = esh_func_metadata_at_position(file.top_decls, annotation.line, annotation.offset, file, table)
                        is_visible_set: bool = function.found and esh_is_error_set_visible(annotations, annotation.name, function.module, annotation.offset, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorsetParamShadow, name: annotation.name, line: annotation.line, expected: "", actual: function.name}) if is_visible_set
