# Variant pattern against an enumerate index. `coll.enumerate()` yields (usize, element); its
# first binder is always a `usize`, so testing it with a variant pattern can never match:
#
#   any index, item in items.enumerate() where index is Expr.Int(value): ...
#   # error: nested variant pattern "Expr.Int" requires an enum or const enum payload, got usize
#
# Fully syntactic: a Comprehension whose iterable is `X.enumerate()` and whose condition is
# `firstBinder is Variant(...)` (Binary `is` on the comprehension's binder). The enumerate
# index is unconditionally usize, so no type inference is needed.
extend Semantic:
    private:
        def eiv_is_enumerate(iterable: Ast::Expr) -> bool:
            can Abort.Panic:
                if iterable is Expr.Call(callee, arguments, argument_names, call_line):
                    if callee is Expr.Field(object, field, field_line):
                        return field == "enumerate"
                return false

        # The (base, variant) of an `is`-pattern right operand `Base.Variant(...)`, else ("","").
        def eiv_variant_path(pattern: Ast::Expr) -> (base: sview, variant: sview):
            can Memory.Allocate, Abort.Panic:
                head: mutable Ast::Expr = pattern
                if pattern is Expr.Call(callee, arguments, argument_names, call_line):
                    head <- callee
                if head is Expr.Field(object, field, field_line):
                    return (ident_name_of(object), field)
                if head is Expr.Scope(scope_base, name, scope_line):
                    return (ident_name_of(scope_base), name)
                return (sview("", 0, 0), sview("", 0, 0))

        def eiv_check_comprehension(binder: sview, iterable: Ast::Expr, condition: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not eiv_is_enumerate(iterable)
                if condition is Expr.Binary(left, operator, right, binary_line):
                    if operator == TokenKind.Is and left is Expr.Ident(left_name, left_ident_line) and left_name == binder:
                        path: (base: sview, variant: sview) = eiv_variant_path(right)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnumerateIndexVariant, name: path.base, line: line, expected: "", actual: path.variant}) if path.base != "" and path.variant != ""

        def eiv_check_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Comprehension(var, iterable, condition, body, line):
                        table <- eiv_check_comprehension(var, iterable, condition, line.line, table)
                        table <- eiv_check_expression(body, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- eiv_check_expression(left, table)
                        table <- eiv_check_expression(right, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- eiv_check_expression(operand, table)
                    Expr.Paren(inner, paren_line):
                        table <- eiv_check_expression(inner, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- eiv_check_expression(argument, table)
                    _:
                        pass

        def eiv_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- eiv_check_expression(returned, table)
                        Stmt.Expr(expression, line):
                            table <- eiv_check_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- eiv_check_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- eiv_check_expression(value, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- eiv_check_expression(condition, table)
                            table <- eiv_check_statements(then_body, table)
                            table <- eiv_check_statements(else_body, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- eiv_check_expression(condition, table)
                            table <- eiv_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- eiv_check_expression(iterable, table)
                            table <- eiv_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- eiv_check_statements(body, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- eiv_check_statements(arm.body, table)
                        _:
                            pass

        def eiv_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- eiv_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- eiv_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- eiv_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_enumerate_index_variant(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- eiv_check_declarations(file.top_decls, table)
