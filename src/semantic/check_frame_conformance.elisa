# Frame-condition conformance (stage0 impl-vs-protocol changes check, docs/87). An impl method
# may not declare a broader `changes` frame than the interface method it implements — every field
# it changes must be in the protocol method's changes set. The parser records each method's
# signature `changes self.FIELD` fields on the side-table (owner=method, name=field): protocol
# methods under line-sentinel 3900000002, impl/plain methods under 3900000003 (the signature
# clause is otherwise skipped). SOUND for the common case (unique protocol method names); matches
# impl→protocol by method name.
extend Semantic:
    private:
        def frame_proto_field_present(owners: darray[sview]&, fields: darray[sview]&, method: sview, field: sview) -> bool:
            can Abort.Panic:
                while probe < owners.count |probe: usize = 0|:
                    true return if owners[probe] == method and fields[probe] == field
                    probe <- probe + 1
                return false

        def frame_method_has_protocol(owners: darray[sview]&, method: sview) -> bool:
            can Abort.Panic:
                return any owner in owners where owner == method

        def check_frame_conformance(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Protocol-method changes: (method, field) pairs under sentinel 3900000002.
                proto_methods: mutable darray[sview] = []
                proto_fields: mutable darray[sview] = []
                for annotation in file.enum_annotations |proto_methods, proto_fields|:
                    if annotation.line == 3900000002:
                        proto_methods.push(annotation.owner)
                        proto_fields.push(annotation.name)
                # Impl-method changes: (method, field) under sentinel 3900000003 — flag a field not
                # in the same-named protocol method's set (only when such a protocol method exists).
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.line == 3900000003:
                        offending: bool = frame_method_has_protocol(proto_methods, annotation.owner) and not frame_proto_field_present(proto_methods, proto_fields, annotation.owner, annotation.name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FrameConditionConformance, name: annotation.owner, line: annotation.line, expected: annotation.name, actual: ""}) if offending
