extend Semantic:
    private:
        def clause_grants_pool(clause: darray[sview]&) -> bool:
            can Abort.Panic:
                return any name in clause where name == "Pool" or (sview_len(name) >= 4 and name[0:4] == "Pool")

        def parallel_body_mutations(statements: darray[Ast::Stmt], outer_names: darray[sview]&, local_names: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, local_names|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            local_names.push(name)
                        Stmt.Assign(target, operator, value, line):
                            root: sview = target_root_ident(target)
                            mutates_outer: bool = root != "" and (any outer_name in outer_names where outer_name == root) and not (any local_name in local_names where local_name == root)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ParallelOuterMutation, name: root, line: line.line, expected: "", actual: ""}) if mutates_outer
                        Stmt.Block(kind, clause, binding, body, line):
                            nested_locals: mutable darray[sview] = [local_name for local_name in local_names]
                            nested_locals.push(binding) if binding != ""
                            table <- parallel_body_mutations(body, outer_names, nested_locals, table)
                        Stmt.If(condition, then_body, else_body, line):
                            then_locals: mutable darray[sview] = [local_name for local_name in local_names]
                            else_locals: mutable darray[sview] = [local_name for local_name in local_names]
                            table <- parallel_body_mutations(then_body, outer_names, then_locals, table)
                            table <- parallel_body_mutations(else_body, outer_names, else_locals, table)
                        Stmt.While(condition, body, line):
                            nested_locals: mutable darray[sview] = [local_name for local_name in local_names]
                            table <- parallel_body_mutations(body, outer_names, nested_locals, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            nested_locals: mutable darray[sview] = [local_name for local_name in local_names]
                            nested_locals.extend([variable for variable in variables])
                            table <- parallel_body_mutations(body, outer_names, nested_locals, table)
                        _:
                            pass

        def check_parallel_capture_scopes(statements: darray[Ast::Stmt], visible_names: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, visible_names|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            visible_names.push(name)
                        Stmt.For(bind, variables, iterable, body, line):
                            match bind:
                                "parallel":
                                    loop_locals: mutable darray[sview] = [variable for variable in variables]
                                    table <- parallel_body_mutations(body, visible_names, loop_locals, table)
                                _:
                                    nested_names: mutable darray[sview] = [visible_name for visible_name in visible_names]
                                    nested_names.extend([variable for variable in variables])
                                    table <- check_parallel_capture_scopes(body, nested_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            nested_names: mutable darray[sview] = [visible_name for visible_name in visible_names]
                            nested_names.push(binding) if binding != ""
                            table <- check_parallel_capture_scopes(body, nested_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            then_names: mutable darray[sview] = [visible_name for visible_name in visible_names]
                            else_names: mutable darray[sview] = [visible_name for visible_name in visible_names]
                            table <- check_parallel_capture_scopes(then_body, then_names, table)
                            table <- check_parallel_capture_scopes(else_body, else_names, table)
                        Stmt.While(condition, body, line):
                            nested_names: mutable darray[sview] = [visible_name for visible_name in visible_names]
                            table <- check_parallel_capture_scopes(body, nested_names, table)
                        _:
                            pass

        def check_parallel_for_grant_statements(statements: darray[Ast::Stmt], granted: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.For(bind, variables, iterable, body, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedParallelFor, name: "", line: line.line, expected: "", actual: ""}) if bind == "parallel" and not granted
                            table <- check_parallel_for_grant_statements(body, granted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_granted: bool = granted or kind == "trusted" or (kind == "can" and clause_grants_pool(clause))
                            table <- check_parallel_for_grant_statements(body, block_granted, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_parallel_for_grant_statements(then_body, granted, table)
                            table <- check_parallel_for_grant_statements(else_body, granted, table)
                        Stmt.While(condition, body, line):
                            table <- check_parallel_for_grant_statements(body, granted, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_parallel_for_grant_statements(arm.body, granted, table)
                        _:
                            pass

        def check_parallel_for_grant_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            signature_granted: bool = any effect in effects where effect == "Pool" or (sview_len(effect) >= 4 and effect[0:4] == "Pool")
                            table <- check_parallel_for_grant_statements(body, signature_granted, table)
                            visible_names: mutable darray[sview] = [parameter.name for parameter in parameters]
                            table <- check_parallel_capture_scopes(body, visible_names, table)
                        Decl.Module(name, body, line):
                            table <- check_parallel_for_grant_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_parallel_for_grant_declarations(body, table)
                        _:
                            pass

    public:
        def check_parallel_for_grant(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_parallel_for_grant_declarations(file.top_decls, table)
