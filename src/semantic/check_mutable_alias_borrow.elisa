# Mutable-alias through a second LOCAL borrow (strict mode). Taking a `mutable T& = &X` borrow of a
# local `X` that is ALREADY borrowed elsewhere (`shared: T& = &X` earlier, still in scope) creates
# two live borrows of X, one mutable — a mutable alias that needs `can Unsafe.Alias`. This complements
# check_mutable_alias_local (which catches aliasing THROUGH CALL ARGUMENTS); here the alias is the
# borrow-creation itself.
#
# SOUND subset: the new borrow's value is a direct address-of `&X` (an ident), its type is a mutable
# ref, and X carries an EARLIER address-of borrow visible in scope. Borrows are threaded in program
# order and copied into nested blocks (a borrow declared later, or inside a sibling block, is not
# visible), so only genuinely-overlapping borrows collide. A `can`/`trusted` block grants the effect.
extend Semantic:
    private:
        # The base ident of an address-of borrow `&X` (through parens), or "".
        def mab_borrow_base(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Ampersand:
                            return ident_name_of(operand)
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return mab_borrow_base(inner)
                    _:
                        return sview("", 0, 0)

        def mab_walk(statements: darray[Ast::Stmt], borrowed: darray[sview]&, in_grant: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Borrows visible here = inherited (enclosing + earlier-sibling) plus each borrow
                # declared as we walk this level in order.
                running: mutable darray[sview] = [entry for entry in borrowed]
                for statement in statements |table, running| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            borrow_base: sview = mab_borrow_base(value)
                            is_ref: bool = type_marker_present(type_expression, TokenKind.Ampersand)
                            is_mutable_ref: bool = is_ref and type_marker_present(type_expression, TokenKind.Mutable)
                            if borrow_base != "" and is_ref:
                                already_borrowed: bool = any prior in running where prior == borrow_base
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if is_mutable_ref and already_borrowed and not in_grant
                                running.push(borrow_base)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- mab_walk(then_body, running, in_grant, table)
                            table <- mab_walk(else_body, running, in_grant, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- mab_walk(while_body, running, in_grant, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- mab_walk(for_body, running, in_grant, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            grant_here: bool = in_grant or kind == "can" or kind == "trusted"
                            table <- mab_walk(block_body, running, grant_here, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- mab_walk(arm.body, running, in_grant, table)
                        _:
                            pass

        def check_mutable_alias_borrow_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            # A signature effect list may grant Unsafe.Alias, so exempt those
                            # functions (mirrors check_mutable_alias_local).
                            if effects.count == 0:
                                empty_borrowed: darray[sview] = []
                                table <- mab_walk(body, empty_borrowed, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_mutable_alias_borrow_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_mutable_alias_borrow_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_mutable_alias_borrow(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_mutable_alias_borrow_decls(declarations, table)
