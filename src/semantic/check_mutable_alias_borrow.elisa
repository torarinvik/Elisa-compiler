# The base ident of an address-of borrow `&X`. The mutable-alias-through-a-second-borrow pass that
# used to live here was removed: check_strict_unsafe_ops_walk's VarDecl borrow rule runs under the
# same `enforce_unsafe_permissions` gate, compares full FIELD PATHS rather than root idents, releases
# a slot's borrow on rebind, and now inherits outer borrows into nested scopes -- a strict superset.
extend Semantic:
    private:
        # The base ident of an address-of borrow `&X` (through parens), or "".
        def borrowed_ident_of(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, unary_line):
                        ident_name_of(operand) return if operator == TokenKind.Ampersand
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return borrowed_ident_of(inner)
                    _:
                        return sview("", 0, 0)
