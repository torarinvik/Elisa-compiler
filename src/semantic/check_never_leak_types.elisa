# never-leak lint (-Wnever-leak) — the BORROW CLASS of a type or an initializer.
#
# The rule exempts a local that a still-live local may borrow from: nesting `s` in
# `s = load(); v = s.view(); use(v)` would leave `v` dangling. stage1's region and borrow facts
# live inside individual checks (check_view_provenance, region_escape_*, check_borrow_*), keyed
# to their own questions, and none of them is a reusable "Y borrows X" table. So this lint
# approximates, always toward NOT flagging. A class is two flags:
#
#   OWNS   the value owns storage a view can point into: dstr, containers, structs, fixed
#          arrays, unknown types.
#   HOLDS  the value may hold a borrow: sview/cstr, `T&`, opaque extern handles, generic
#          parameters, function values, unknown types, aggregates with such parts.
#
# SCALAR (neither) are integers, floats, bool, char, plain enums; only `&x` borrows one.
# Struct/enum/alias classes are a monotone fixpoint over the file's declarations (recursive
# types converge). Each function name maps to the join of its declarations' return classes, and
# to masks of the parameters that are `mutable`/`lmut` (a call may store into that argument) or
# HOLD (a call may borrow that argument); methods of different types share one bare name.
extend Semantic:
    private:
        # Classes are two flags plus one (so 0 can mean "unknown name"): OWNS (bit 0 of
        # class - 1: the value owns storage a view can point into) and HOLDS (bit 1: the value
        # may hold a borrow). Joining two classes unions the flags.
        const NL_SCALAR: u8 = 1
        const NL_OWNED: u8 = 2
        const NL_VIEW: u8 = 3
        const NL_BORROW: u8 = 4
        const NL_TYPE_ROW_NONE: u32 = 4294967295

        struct NeverLeakTypes:
            heads: mutable dict[u64, u32] = {}
            next: mutable darray[u32] = []
            names: mutable darray[sview] = []
            # 1 struct, 2 payload-free enum, 3 payload enum, 4 alias, 5 opaque extern type (a
            # foreign handle: it owns no Elisa storage)
            kinds: mutable darray[u8] = []
            member_starts: mutable darray[u32] = []
            member_counts: mutable darray[u32] = []
            members: mutable darray[Ast::Expr] = []
            classes: mutable darray[u8] = []
            functions: mutable dict[u64, u8] = {}
            # name_hash -> bit k set when parameter k of some declaration of that name is
            # `mutable`/`lmut` (a call may store a borrow into that argument).
            mutable_params: mutable dict[u64, u64] = {}
            # name_hash -> bit k set when parameter k of some declaration of that name has a type
            # that may hold a borrow (`sview`, `T&`, a generic or unknown type): an argument
            # passed there may be borrowed by the callee.
            holding_params: mutable dict[u64, u64] = {}
            # name_hash -> 1 for `extern` declarations (foreign code holds no Elisa borrow).
            externs: mutable dict[u64, u8] = {}

        # A binding's class byte packs two classes: the low nibble is the class of the binding's
        # own value (a `T&` is BORROW), the high nibble the class of what a write THROUGH it can
        # store (a `mutable darray[u8]&` holds only bytes: SCALAR/OWNED). 0 in the high nibble
        # means "same as the value".
        def nl_pack(value_class: u8, content_class: u8) -> u8:
            return value_class | (content_class << 4)

        def nl_full(class_byte: u8) -> u8:
            return class_byte & 15

        def nl_content(class_byte: u8) -> u8:
            content: u8 = class_byte >> 4
            return class_byte & 15 if content == 0 else content

        # The class of what a write through a binding of this type can store: the reference,
        # `mutable` and `lmut` layers are stripped.
        def nl_type_content_class(types: NeverLeakTypes&, type_expression: Ast::Expr) -> u8:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, pos):
                        return nl_type_content_class(types, operand) if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return nl_type_class(types, type_expression)
                    Expr.Paren(inner, pos):
                        return nl_type_content_class(types, inner)
                    _:
                        return nl_type_class(types, type_expression)

        # The join of two classes (flag union). A 0 operand (no class yet) is the identity.
        def nl_max(left: u8, right: u8) -> u8:
            return right if left == 0 else (left if right == 0 else ((left - 1) | (right - 1)) + 1)

        def nl_owns(class_value: u8) -> bool:
            return class_value != 0 and ((class_value - 1) & 1) != 0

        def nl_holds(class_value: u8) -> bool:
            return class_value != 0 and ((class_value - 1) & 2) != 0

        # The class of a builtin type name, or 0 when the name is not a builtin.
        def nl_builtin_class(name: sview) -> u8:
            can Abort.Panic:
                return when name:
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f32" | "f64" | "bool" | "char" | "void" -> NL_SCALAR
                    "dstr" -> NL_OWNED
                    "sview" | "cstr" -> NL_VIEW
                    _ -> 0

        def nl_container_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "darray" | "dict" | "set" | "array" | "list" -> true
                    _ -> false

        def nl_add_type(types: mutable NeverLeakTypes&, name: sview, kind: u8, members: darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = name_hash(name)
                row: u32 = types.names.count.u32()
                previous: u32 = head if types.heads.get(hash) is head else NL_TYPE_ROW_NONE
                types.next.push(previous)
                types.heads <- types.heads.put(hash, row) can Global{Read,Write}
                types.names.push(name)
                types.kinds.push(kind)
                types.member_starts.push(types.members.count.u32())
                types.member_counts.push(members.count.u32())
                for member in members |types|:
                    types.members.push(member)
                types.classes.push(0)

        def nl_collect_types(declarations: darray[Ast::Decl], types: mutable NeverLeakTypes&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |types|:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            member_types: mutable darray[Ast::Expr] = []
                            for member in members |member_types|:
                                member_types.push(member.type_expression)
                            nl_add_type(types, name, 1, member_types) can Global{Read,Write}
                        Decl.Enum(name, variants, is_const, storage_type, line):
                            payload: mutable darray[Ast::Expr] = []
                            for variant in variants |payload|:
                                for field in variant.fields |payload|:
                                    payload.push(field)
                            enum_kind: mutable u8 = 2
                            enum_kind <- 3 if payload.count > 0
                            nl_add_type(types, name, enum_kind, payload) can Global{Read,Write}
                        Decl.Alias(name, target, line):
                            alias_target: mutable darray[Ast::Expr] = []
                            alias_target.push(target)
                            nl_add_type(types, name, 4, alias_target) can Global{Read,Write}
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if not callable:
                                no_members: darray[Ast::Expr] = []
                                nl_add_type(types, name, 5, no_members) can Global{Read,Write}
                        Decl.Module(name, body, line):
                            nl_collect_types(body, types) can Global{Read,Write}
                        Decl.Scoped(body, line):
                            nl_collect_types(body, types) can Global{Read,Write}
                        _:
                            pass

        # The class a user type name currently has (BORROW when the file does not declare it).
        # A name declared more than once answers with the worst of its declarations.
        def nl_named_class(types: NeverLeakTypes&, name: sview) -> u8:
            can Abort.Panic:
                builtin: u8 = nl_builtin_class(name)
                builtin return if builtin != 0
                row: mutable u32 = head if types.heads.get(name_hash(name)) is head else NL_TYPE_ROW_NONE
                found: mutable u8 = 0
                while row != NL_TYPE_ROW_NONE |row, found|:
                    if types.names[row.usize()] == name:
                        current: u8 = types.classes[row.usize()]
                        # A row the fixpoint has not reached yet contributes nothing; the
                        # fixpoint only grows, so the final answer still covers it.
                        found <- nl_max(found, current)
                        found <- nl_max(found, NL_SCALAR) if current == 0
                    row <- types.next[row.usize()]
                return NL_BORROW if found == 0 else found

        def nl_type_class(types: NeverLeakTypes&, type_expression: Ast::Expr) -> u8:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, pos):
                        return nl_named_class(types, name)
                    Expr.Scope(base, name, pos):
                        return nl_named_class(types, name)
                    Expr.Unary(operator, operand, pos):
                        # A reference owns nothing and is itself a borrow.
                        NL_VIEW return if operator == TokenKind.Ampersand
                        return nl_type_class(types, operand)
                    Expr.Paren(inner, pos):
                        return nl_type_class(types, inner)
                    Expr.Refinement(base, predicate, pos):
                        return nl_type_class(types, base)
                    Expr.Index(head, argument, pos):
                        head_name: sview = ident_name_of(head)
                        # `T[4]` is a fixed array of T; `darray[T]` a container of T.
                        fixed: bool = match argument:
                            Expr.IntLit(value, literal_pos): true
                            _: false
                        if fixed or nl_container_name(head_name):
                            element: u8 = nl_type_class(types, head) if fixed else nl_type_class(types, argument)
                            return nl_max(NL_OWNED, element)
                        return NL_BORROW
                    Expr.IndexN(head, arguments, pos):
                        NL_BORROW return if not nl_container_name(ident_name_of(head))
                        worst: mutable u8 = NL_OWNED
                        for argument in arguments |worst, types|:
                            worst <- nl_max(worst, nl_type_class(types, argument))
                        return worst
                    Expr.Tuple(elements, pos):
                        worst: mutable u8 = NL_SCALAR
                        for element in elements |worst, types|:
                            worst <- nl_max(worst, nl_type_class(types, element))
                        return worst
                    _:
                        return NL_BORROW

        # One fixpoint round over every declared type; answers whether any class grew.
        def nl_type_round(types: mutable NeverLeakTypes&) -> bool:
            can Abort.Panic:
                changed: mutable bool = false
                for row in 0..<types.names.count |types, changed|:
                    kind: u8 = types.kinds[row]
                    row_class: mutable u8 = NL_OWNED
                    row_class <- NL_SCALAR if kind == 2 or kind == 4
                    row_class <- NL_VIEW if kind == 5
                    start: u32 = types.member_starts[row]
                    for offset in 0..<types.member_counts[row] |row_class, types, start|:
                        row_class <- nl_max(row_class, nl_type_class(types, types.members[(start + offset).usize()]))
                    merged: u8 = nl_max(types.classes[row], row_class)
                    if merged != types.classes[row]:
                        types.classes[row] <- merged
                        changed <- true
                return changed

        def nl_type_mutates(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, pos):
                        true return if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return nl_type_mutates(operand)
                    Expr.Paren(inner, pos):
                        return nl_type_mutates(inner)
                    Expr.Refinement(base, predicate, pos):
                        return nl_type_mutates(base)
                    _:
                        return false

        def nl_collect_functions(declarations: darray[Ast::Decl], types: mutable NeverLeakTypes&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |types|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            return_class: mutable u8 = NL_SCALAR
                            if return_type is returned:
                                return_class <- nl_type_class(types, returned)
                            hash: u64 = name_hash(name)
                            if types.functions.get(hash) is previous:
                                return_class <- nl_max(return_class, previous)
                            types.functions <- types.functions.put(hash, return_class) can Global{Read,Write}
                            mask: mutable u64 = 0
                            holding: mutable u64 = 0
                            for parameter_index in 0..<parameters.count |mask, holding, parameters, types|:
                                if parameter_index < 64:
                                    bit: u64 = 1.u64() << parameter_index.u64()
                                    parameter_type: Ast::Expr = parameters[parameter_index].type_expression
                                    mask <- mask | bit if parameters[parameter_index].is_mutable or nl_type_mutates(parameter_type)
                                    holding <- holding | bit if nl_holds(nl_type_class(types, parameter_type))
                            if types.mutable_params.get(hash) is previous_mask:
                                mask <- mask | previous_mask
                            types.mutable_params <- types.mutable_params.put(hash, mask) can Global{Read,Write}
                            if types.holding_params.get(hash) is previous_holding:
                                holding <- holding | previous_holding
                            types.holding_params <- types.holding_params.put(hash, holding) can Global{Read,Write}
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            hash: u64 = name_hash(name)
                            types.externs <- types.externs.put(hash, 1) can Global{Read,Write}
                            extern_class: mutable u8 = NL_SCALAR
                            extern_class <- nl_named_class(types, return_type_name) if return_type_name != ""
                            if types.functions.get(hash) is previous:
                                extern_class <- nl_max(extern_class, previous)
                            types.functions <- types.functions.put(hash, extern_class) can Global{Read,Write}
                        Decl.Module(name, body, line):
                            nl_collect_functions(body, types) can Global{Read,Write}
                        Decl.Scoped(body, line):
                            nl_collect_functions(body, types) can Global{Read,Write}
                        _:
                            pass

        def nl_build_types(file: Ast::File&, types: mutable NeverLeakTypes&) -> void:
            can Memory.Allocate, Abort.Panic:
                nl_collect_types(file.top_decls, types) can Global{Read,Write}
                rounds: mutable i64 = 0
                while rounds < 16 |rounds, types|:
                    break if not nl_type_round(types)
                    rounds <- rounds + 1
                nl_collect_functions(file.top_decls, types) can Global{Read,Write}

        # The class of a call's result, from the callee's bare name.
        def nl_call_class(types: NeverLeakTypes&, callee: Ast::Expr) -> u8:
            can Abort.Panic:
                match callee:
                    Expr.Ident(name, pos):
                        return nl_function_name_class(types, name)
                    Expr.Scope(base, name, pos):
                        return nl_function_name_class(types, name)
                    Expr.Field(object, name, pos):
                        return nl_function_name_class(types, name)
                    Expr.Index(head, argument, pos):
                        # `x.cast[T]()` / `f[T](...)`: a cast answers with T's class.
                        match head:
                            Expr.Field(object, name, field_pos):
                                return nl_type_class(types, argument) if name == "cast"
                            _:
                                pass
                        return nl_call_class(types, head)
                    _:
                        return NL_BORROW

        def nl_function_name_class(types: NeverLeakTypes&, name: sview) -> u8:
            can Abort.Panic:
                builtin: u8 = nl_builtin_class(name)
                builtin return if builtin == NL_SCALAR
                known: u8 = found if types.functions.get(name_hash(name)) is found else NL_BORROW
                return known
