# Check for field access on a firm scalar primitive (Int/Float/Bool/Char), which
# has no fields. E.g. `x: i64 = 3; y = x.foo` — `x.foo` can never resolve.
# Strings/structs/enums (Named) have fields/methods and Unknown is bottom, so both
# are deliberately excluded. Method calls `recv.foo()` parse as
# `Expr.Call(callee=Expr.Field(recv,"foo"))`; the check only fires on a bare,
# non-called Field, never on a Field that is the callee of an enclosing Call.

extend Semantic:
    private:
        # Walk through expressions, checking for field access on primitives.
        def walk_expression_for_field_access_on_primitive(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_field_access_on_primitive(left, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        # A Field callee is a method call (`recv.foo()`); walk the receiver
                        # only, not the field-access check itself.
                        if callee is Expr.Field(call_object, call_field, call_line):
                            table <- walk_expression_for_field_access_on_primitive(call_object, table, var_types, type_names)
                        else:
                            table <- walk_expression_for_field_access_on_primitive(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_field_access_on_primitive(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_field_access_on_primitive(object, table, var_types, type_names)
                        object_type: InferType = infer_expression_type(object, var_types, type_names, table)
                        actual: sview = stage0_value_spelling(object_type)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FieldAccessOnPrimitive, name: "", line: line, expected: "", actual: actual}) if object_type.kind == TypeKind.Int or object_type.kind == TypeKind.Float or object_type.kind == TypeKind.Bool or object_type.kind == TypeKind.Char
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_field_access_on_primitive(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        if index_receiver_is_type_application(object):
                            # `object[...]` is a type application (e.g. `x.cast[T]`); the
                            # bracket is a type, not a value index. If `object` is itself a
                            # bare Field (`.cast`), that Field is part of the cast syntax, not
                            # a real field access — walk its receiver only, don't fire on it.
                            match object:
                                Expr.Field(cast_object, cast_field, cast_line):
                                    table <- walk_expression_for_field_access_on_primitive(cast_object, table, var_types, type_names)
                                _:
                                    table <- walk_expression_for_field_access_on_primitive(object, table, var_types, type_names)
                        else:
                            table <- walk_expression_for_field_access_on_primitive(object, table, var_types, type_names)
                            table <- walk_expression_for_field_access_on_primitive(index, table, var_types, type_names)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_field_access_on_primitive(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_field_access_on_primitive(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_field_access_on_primitive(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_field_access_on_primitive(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_field_access_on_primitive(object, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(low, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        if index_receiver_is_type_application(object):
                            match object:
                                Expr.Field(cast_object_n, cast_field_n, cast_line_n):
                                    table <- walk_expression_for_field_access_on_primitive(cast_object_n, table, var_types, type_names)
                                _:
                                    table <- walk_expression_for_field_access_on_primitive(object, table, var_types, type_names)
                        else:
                            table <- walk_expression_for_field_access_on_primitive(object, table, var_types, type_names)
                            for argument in arguments |table|:
                                table <- walk_expression_for_field_access_on_primitive(argument, table, var_types, type_names)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_field_access_on_primitive(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_field_access_on_primitive(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_field_access_on_primitive(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_field_access_on_primitive(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_field_access_on_primitive(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_field_access_on_primitive(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_field_access_on_primitive(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_field_access_on_primitive(condition, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_field_access_on_primitive(iterable, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(condition, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_field_access_on_primitive(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_field_access_on_primitive(statements, table, var_types, type_names)
                        table <- walk_expression_for_field_access_on_primitive(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_field_access_on_primitive(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_field_access_on_primitive(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for field access on primitives.
        def walk_statements_for_field_access_on_primitive(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_field_access_on_primitive(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_field_access_on_primitive(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_field_access_on_primitive(target, table, var_types, type_names)
                            table <- walk_expression_for_field_access_on_primitive(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_field_access_on_primitive(condition, table, var_types, type_names)
                            table <- walk_statements_for_field_access_on_primitive(then_body, table, var_types, type_names)
                            table <- walk_statements_for_field_access_on_primitive(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_field_access_on_primitive(condition, table, var_types, type_names)
                            table <- walk_statements_for_field_access_on_primitive(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_field_access_on_primitive(iterable, table, var_types, type_names)
                            table <- walk_statements_for_field_access_on_primitive(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_field_access_on_primitive(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_field_access_on_primitive(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_field_access_on_primitive(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_field_access_on_primitive(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_field_access_on_primitive(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_field_access_on_primitive(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_field_access_on_primitive_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_field_access_on_primitive(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_field_access_on_primitive_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_field_access_on_primitive_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_field_access_on_primitive(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_field_access_on_primitive_declarations(declarations, table)
