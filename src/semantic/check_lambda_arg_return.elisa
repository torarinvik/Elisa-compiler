# Lambda argument return-type mismatch. A lambda passed for an `fn(...) -> RetT` parameter
# whose body returns a literal that can never be RetT is rejected:
#
#   def apply(f: fn(i64) -> i64, x: i64) -> i64: return f(x)
#   def use() -> i64: return apply(fn(n) => "hi", 3)   # error: expects i64, got static u8&
#
# A `fn(...) -> RetT` type annotation is an `Expr.Lambda` whose return type the AST drops, so
# the parser records the return-type head on `__lambda_return` keyed by the lambda's line.
# SOUND subset: only a `fn(...) => <literal>` argument (body is a single `return <literal>`)
# matched to such a parameter is flagged, via the impossible-pair matrix (literal_never_fits).
extend Semantic:
    private:
        def lar_literal_type_spelling(kind: sview) -> sview:
            can Abort.Panic:
                return when kind:
                    "string" -> "static u8&"
                    "int" -> "int"
                    "float" -> "f64"
                    "bool" -> "bool"
                    "char" -> "char"
                    _ -> sview("", 0, 0)

        # The recorded return-type head of an `fn(...) -> RetT` parameter type (an Expr.Lambda
        # in type position, whose line keys the `__lambda_return` annotation), else "".
        def lar_fn_return_name(type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                if type_expression is Expr.Lambda(lambda_params, lambda_body, lambda_line):
                    for annotation in annotations:
                        annotation.name return if annotation.owner == "__lambda_return" and annotation.line == lambda_line.line
                return sview("", 0, 0)

        def lar_lambda_literal_kind(body: darray[Ast::Stmt]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                sview("", 0, 0) return if body.count != 1
                if body[0] is Stmt.Return(value, return_line):
                    if value is returned:
                        return literal_kind_of(returned)
                return sview("", 0, 0)

        def lar_check_args(arguments: darray[Ast::Expr]&, parameters: darray[Ast::ParamDecl]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                argument_index: mutable usize = 0
                while argument_index < arguments.count and argument_index < parameters.count |argument_index, table| -> table:
                    if arguments[argument_index] is Expr.Lambda(lambda_params, lambda_body, lambda_line):
                        return_name: sview = lar_fn_return_name(parameters[argument_index].type_expression, annotations)
                        literal_kind: sview = lar_lambda_literal_kind(lambda_body)
                        if return_name != "" and literal_kind != "" and literal_never_fits(literal_kind, return_name):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LambdaReturnTypeMismatch, name: "", line: lambda_line.line, expected: return_name, actual: lar_literal_type_spelling(literal_kind)})
                    argument_index <- argument_index + 1

        def lar_check_call(declarations: darray[Ast::Decl]&, callee_name: sview, arguments: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- lar_check_args(arguments, parameters, annotations, table) if function_name == callee_name
                        Decl.Module(module_name, module_body, module_line):
                            table <- lar_check_call(module_body, callee_name, arguments, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- lar_check_call(scoped_body, callee_name, arguments, annotations, table)
                        _:
                            pass

        def lar_check_expression(expression: Ast::Expr, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        table <- lar_check_call(declarations, callee_name, arguments, annotations, table) if callee_name != ""
                        for argument in arguments |table| -> table:
                            table <- lar_check_expression(argument, declarations, annotations, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- lar_check_expression(left, declarations, annotations, table)
                        table <- lar_check_expression(right, declarations, annotations, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- lar_check_expression(operand, declarations, annotations, table)
                    Expr.Paren(inner, paren_line):
                        table <- lar_check_expression(inner, declarations, annotations, table)
                    _:
                        pass

        def lar_check_statements(statements: darray[Ast::Stmt], declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- lar_check_expression(returned, declarations, annotations, table)
                        Stmt.Expr(expression, line):
                            table <- lar_check_expression(expression, declarations, annotations, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- lar_check_expression(value, declarations, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- lar_check_expression(value, declarations, annotations, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- lar_check_statements(then_body, declarations, annotations, table)
                            table <- lar_check_statements(else_body, declarations, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- lar_check_statements(while_body, declarations, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- lar_check_statements(for_body, declarations, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- lar_check_statements(body, declarations, annotations, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- lar_check_statements(arm.body, declarations, annotations, table)
                        _:
                            pass

        def lar_check_declarations(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- lar_check_statements(body, all_declarations, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- lar_check_declarations(module_body, all_declarations, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- lar_check_declarations(scoped_body, all_declarations, annotations, table)
                        _:
                            pass

    public:
        def check_lambda_arg_return(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lar_check_declarations(file.top_decls, file.top_decls, file.enum_annotations, table)
