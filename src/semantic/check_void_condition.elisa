# Check for `if`/`while` conditions that directly infer to void (a call to a
# `-> void` function used as a condition). Disjoint from NonBoolCondition (which
# fires on FIRM non-bool families and explicitly skips void, family "") and from
# the other batch-9 void checks (VoidFieldAccess/VoidIndex/VoidOperand), which key
# on different syntactic positions.

extend Semantic:
    private:
        # Walk through expressions, recursing into sub-expressions so nested
        # if/while conditions (inside lambdas, blocks, matches, etc.) are covered.
        def walk_expression_for_void_condition(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_void_condition(left, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_void_condition(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_condition(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_void_condition(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_void_condition(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_void_condition(object, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_void_condition(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_void_condition(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_condition(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_condition(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_void_condition(object, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(low, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_void_condition(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_condition(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_condition(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_void_condition(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_void_condition(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_void_condition(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_condition(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_void_condition(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_condition(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        # Ternary condition is a DIFFERENT syntactic position — not ours to flag.
                        table <- walk_expression_for_void_condition(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_void_condition(iterable, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_void_condition(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_void_condition(statements, table, var_types, type_names)
                        table <- walk_expression_for_void_condition(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_void_condition(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_void_condition(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and flagging void if/while conditions.
        def walk_statements_for_void_condition(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_void_condition(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_void_condition(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_void_condition(target, table, var_types, type_names)
                            table <- walk_expression_for_void_condition(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            condition_type: InferType = infer_expression_type(condition, var_types, type_names, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidCondition, name: "if", line: line, expected: "", actual: ""}) if condition_type.kind == TypeKind.Void
                            table <- walk_expression_for_void_condition(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_condition(then_body, table, var_types, type_names)
                            table <- walk_statements_for_void_condition(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            condition_type: InferType = infer_expression_type(condition, var_types, type_names, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidCondition, name: "while", line: line, expected: "", actual: ""}) if condition_type.kind == TypeKind.Void
                            table <- walk_expression_for_void_condition(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_condition(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_void_condition(iterable, table, var_types, type_names)
                            table <- walk_statements_for_void_condition(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_void_condition(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_void_condition(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_void_condition(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_void_condition(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_void_condition(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_void_condition(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_void_condition_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_void_condition(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_void_condition_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_condition_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_void_condition(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_void_condition_declarations(declarations, table)
