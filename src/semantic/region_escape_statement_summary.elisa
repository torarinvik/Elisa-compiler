extend Semantic:
    private:
        def region_escape_provenance_catchable_raise_statements(statements: darray[Ast::Stmt]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                empty_catch_context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}
                region_escape_provenance_catchable_raise_statements_with_metadata(statements, empty_catch_context)


        def region_escape_provenance_catchable_raise_statements_with_metadata(statements: darray[Ast::Stmt]&, catch_context: RegionEscapeCatchContext) -> bool:
            can Memory.Allocate, Abort.Panic:
                region_escape_provenance_catchable_raise_statements_summary(statements, catch_context).found_raise


        def region_escape_provenance_catchable_raise_statements_summary(statements: darray[Ast::Stmt]&, catch_context: RegionEscapeCatchContext) -> (reaches_end: bool, found_raise: bool):
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    statement_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statement_summary(statement, catch_context)
                    return (false, true) if statement_facts.found_raise
                    return (false, false) if not statement_facts.reaches_end
                return (true, false)


        def region_escape_provenance_catchable_raise_statement_summary(statement: Ast::Stmt, catch_context: RegionEscapeCatchContext) -> (reaches_end: bool, found_raise: bool):
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, _):
                        found_raise: bool = region_escape_provenance_catchable_raise_with_metadata(expression, catch_context)
                        return (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), found_raise)
                    Stmt.Return(value, _):
                        found_raise: mutable bool = false
                        if value is present_value:
                            found_raise <- region_escape_provenance_catchable_raise_with_metadata(present_value, catch_context)
                        return (false, found_raise)
                    Stmt.VarDecl(_, type_expression, value, _):
                        found_raise: bool = region_escape_provenance_catchable_raise_with_metadata(type_expression, catch_context) or region_escape_provenance_catchable_raise_with_metadata(value, catch_context)
                        return (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), found_raise)
                    Stmt.Assign(target, _, value, _):
                        target_raise: bool = region_escape_provenance_catchable_raise_with_metadata(target, catch_context)
                        return (false, true) if target_raise
                        return (false, false) if region_escape_provenance_expression_terminates_with_metadata(target, catch_context)
                        value_raise: bool = region_escape_provenance_catchable_raise_with_metadata(value, catch_context)
                        return (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), value_raise)
                    Stmt.If(condition, then_body, else_body, _):
                        condition_raise: bool = region_escape_provenance_catchable_raise_with_metadata(condition, catch_context)
                        return (false, true) if condition_raise
                        return (false, false) if region_escape_provenance_expression_terminates_with_metadata(condition, catch_context)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known and literal.value:
                            region_escape_provenance_catchable_raise_statements_summary(then_body, catch_context)
                        elif literal.known:
                            region_escape_provenance_catchable_raise_statements_summary(else_body, catch_context)
                        else:
                            then_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(then_body, catch_context)
                            else_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(else_body, catch_context)
                            (then_facts.reaches_end or else_facts.reaches_end, then_facts.found_raise or else_facts.found_raise)
                    Stmt.While(condition, body, _):
                        condition_raise: bool = region_escape_provenance_catchable_raise_with_metadata(condition, catch_context)
                        return (false, true) if condition_raise
                        return (false, false) if region_escape_provenance_expression_terminates_with_metadata(condition, catch_context)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return (true, false) if literal.known and not literal.value
                        body_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(body, catch_context)
                        (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), body_facts.found_raise)
                    Stmt.For(_, _, iterable, body, _):
                        iterable_raise: bool = region_escape_provenance_catchable_raise_with_metadata(iterable, catch_context)
                        return (false, true) if iterable_raise
                        return (false, false) if region_escape_provenance_expression_terminates_with_metadata(iterable, catch_context)
                        return (true, false) if progress_empty_iterable(iterable)
                        body_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(body, catch_context)
                        (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), body_facts.found_raise)
                    Stmt.Block(_, _, _, body, _):
                        body_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(body, catch_context)
                        (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), body_facts.found_raise)
                    Stmt.Match(scrutinee, arms, match_line):
                        is_catch_match: bool = region_escape_catch_marker_matches(match_line, catch_context)
                        scrutinee_may_raise: bool = region_escape_provenance_catchable_raise_with_metadata(scrutinee, catch_context)
                        scrutinee_aborts: bool = region_escape_provenance_expression_terminates_with_metadata(scrutinee, catch_context)
                        if not is_catch_match:
                            return (false, true) if scrutinee_may_raise
                            return (false, false) if scrutinee_aborts
                            arm_raise: bool = region_escape_provenance_catchable_raise_match_arms_with_metadata(scrutinee, arms, catch_context)
                            return (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), arm_raise)
                        errors_handled: mutable bool = false
                        handler_raise: mutable bool = false
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |errors_handled, handler_raise, arm_index|:
                            arm: Ast::MatchArm = arms[arm_index]
                            reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index)
                            reachable <- false if scrutinee_aborts and arm_index == 0
                            reachable <- false if scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                            if reachable:
                                handler_raise <- true if region_escape_provenance_catchable_raise_with_metadata(arm.guard, catch_context)
                                guard: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                                if not ((guard.known and not guard.value) or region_escape_provenance_expression_terminates_with_metadata(arm.guard, catch_context)):
                                    body_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(arm.body, catch_context)
                                    handler_raise <- true if body_facts.found_raise
                                    if arm_index > 0 and (arm.guard is Ast::Expr.Absent or (guard.known and guard.value)) and region_escape_provenance_pattern_is_error_catchall(arm.pattern):
                                        errors_handled <- true
                            arm_index <- arm_index + 1.usize()
                        unhandled_raise: bool = scrutinee_may_raise and not errors_handled
                        (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), handler_raise or unhandled_raise)
                    Stmt.Contract(_, expression, _):
                        found_raise: bool = region_escape_provenance_catchable_raise_with_metadata(expression, catch_context)
                        (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), found_raise)
                    _:
                        (not region_escape_provenance_statement_terminates_with_metadata(statement, catch_context), false)

include "./region_escape_provenance/catchable_raises.elisa"
include "./region_escape_provenance/loop_control.elisa"
include "./region_escape_provenance/body_flow.elisa"
include "./region_escape_provenance/element_flow.elisa"
include "./region_escape_provenance/stored_regions.elisa"
