# Closed TokenKind set for equality and ordering comparisons.
module ComparisonOperatorPolicy:
    public:
        def is_comparison(operator: Lexer::TokenKind) -> bool:
            matches: bool = when operator:
                Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq -> true
                _ -> false
            assert when operator:
                Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq -> (matches) == (true)
                _ -> (matches) == (false)
            can Abort.Panic:
                return matches
