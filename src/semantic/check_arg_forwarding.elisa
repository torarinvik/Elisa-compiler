# `f(..)` forwards the ENCLOSING function's parameters (by name) into the call. Validate it
# (arity is skipped for forwarded calls in resolve_expr): a variadic callee cannot be forwarded
# into, and every REQUIRED callee parameter must be satisfied by a same-named caller parameter or
# a default. The `..` is recorded per call line under `__from`... via forward_arg_lines; a call
# whose line is in that set is a forwarding call.
extend Semantic:
    private:
        # Whether callee NAME is a variadic function (its symbol's max arity is the sentinel).
        def forwarding_callee_is_variadic(table: SymbolTable&, callee: sview) -> bool:
            can Abort.Panic:
                # Was an O(symbols.count) scan of every declaration in the whole program, per
                # forwarding (`..`) call site — see the matching comment on
                # direct_function_count in resolve_expr.elisa.
                variadic: mutable bool = false
                cur: mutable u32 = symbol_chain_head(table, callee)
                while cur != 4294967295:
                    variadic <- true if table.symbols[cur.usize()].name == callee and table.symbols[cur.usize()].arity_max == 4294967295
                    cur <- table.symbol_name_next[cur.usize()]
                return variadic

        # The first REQUIRED (non-default) parameter of `callee` NOT covered by a same-named
        # caller parameter ("" when every required parameter is covered).
        def forwarding_uncovered_param(table: SymbolTable&, callee: sview, caller_params: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per forwarding (`..`) call site — see the matching comment on
                # function_parameter_count in resolve_expr.elisa.
                uncovered: mutable sview = sview("", 0, 0)
                cur: mutable u32 = function_param_chain_head(table, callee)
                while cur != 4294967295 |uncovered, cur, callee, caller_params, table|:
                    if table.function_param_owner[cur.usize()] == callee and not table.function_param_has_default[cur.usize()] and uncovered == "":
                        param_name: sview = table.function_param_name[cur.usize()]
                        covered: bool = any caller_param in caller_params where caller_param == param_name
                        uncovered <- param_name if not covered
                    cur <- table.function_param_name_next[cur.usize()]
                return uncovered

        def forwarding_check_expression(expression: Ast::Expr, caller_params: darray[sview]&, forward_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(callee_name, callee_line):
                                is_forwarding: bool = any forward_line in forward_lines where forward_line == line.line
                                if is_forwarding and callee_name != "":
                                    if forwarding_callee_is_variadic(table, callee_name):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ForwardingVariadic, name: callee_name, line: line.line, expected: "", actual: ""})
                                    else:
                                        uncovered: sview = forwarding_uncovered_param(table, callee_name, caller_params)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: callee_name, line: line.line, expected: "missing", actual: uncovered}) if uncovered != ""
                            _:
                                pass
                        for argument in arguments |table| -> table:
                            table <- forwarding_check_expression(argument, caller_params, forward_lines, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- forwarding_check_expression(left, caller_params, forward_lines, table)
                        table <- forwarding_check_expression(right, caller_params, forward_lines, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- forwarding_check_expression(operand, caller_params, forward_lines, table)
                    Expr.Paren(inner, paren_line):
                        table <- forwarding_check_expression(inner, caller_params, forward_lines, table)
                    _:
                        pass

        def forwarding_check_statements(statements: darray[Ast::Stmt], caller_params: darray[sview]&, forward_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- forwarding_check_expression(expression, caller_params, forward_lines, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- forwarding_check_expression(value, caller_params, forward_lines, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- forwarding_check_expression(value, caller_params, forward_lines, table)
                        Stmt.Return(value, line):
                            table <- forwarding_check_expression(returned, caller_params, forward_lines, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- forwarding_check_expression(condition, caller_params, forward_lines, table)
                            table <- forwarding_check_statements(then_body, caller_params, forward_lines, table)
                            table <- forwarding_check_statements(else_body, caller_params, forward_lines, table)
                        Stmt.While(condition, while_body, line):
                            table <- forwarding_check_statements(while_body, caller_params, forward_lines, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- forwarding_check_statements(for_body, caller_params, forward_lines, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- forwarding_check_statements(body, caller_params, forward_lines, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- forwarding_check_statements(arm.body, caller_params, forward_lines, table)
                        _:
                            pass

        def forwarding_walk(declarations: darray[Ast::Decl], forward_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            caller_params: darray[sview] = [parameter.name for parameter in parameters]
                            table <- forwarding_check_statements(body, caller_params, forward_lines, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- forwarding_walk(module_body, forward_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- forwarding_walk(scoped_body, forward_lines, table)
                        _:
                            pass

    public:
        def check_arg_forwarding(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                forward_lines: darray[u32] = table.forward_arg_lines
                table <- forwarding_walk(file.top_decls, forward_lines, table)
