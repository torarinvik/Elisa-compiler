# Flow-sensitive single-use validation for affine values. The parser retains `move`
# as a transparent unary node so this pass can distinguish ownership transfer from use.

extend Semantic:
    private:
        def packed_enum_contains_affine(owner: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if not (any packed_name in table.packed_enum_names where packed_name == owner)
                while index < table.enum_payload_owner.count |index: usize = 0|:
                    if table.enum_payload_owner[index] == owner:
                        payload_type: sview = table.enum_payload_type[index]
                        true return if payload_type in {"Thread", "Task", "MutexGuard", "ThreadPool", "TaskGroup"} or struct_is_affine(table, payload_type)
                    index <- index + 1
                return false


        def affine_type_expression(expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                owner: sview = bare_type_name_through_ref(expression)
                true return if struct_is_affine(table, owner) or packed_enum_contains_affine(owner, table)
                match expression:
                    Expr.Index(head, argument, line):
                        return affine_type_expression(argument, table)
                    Expr.IndexN(head, arguments, line):
                        return any argument in arguments where affine_type_expression(argument, table)
                    Expr.Unary(operator, operand, line):
                        return affine_type_expression(operand, table)
                    Expr.Paren(inner, line):
                        return affine_type_expression(inner, table)
                    _:
                        return false


        def affine_root(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Ident(name, line):
                    return name
                Expr.Field(object, field, line):
                    return affine_root(object)
                Expr.Index(object, index, line):
                    return affine_root(object)
                Expr.IndexN(object, arguments, line):
                    return affine_root(object)
                Expr.Paren(inner, line):
                    return affine_root(inner)
                _:
                    return ""


        def affine_match_root(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Binary(value, operator, store, line):
                    return affine_root(value) if operator == TokenKind.In else ""
                _:
                    return affine_root(expression)


        def affine_local(names: darray[sview]&, flags: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    flags[index] return if names[index] == name
                return false


        def affine_consumed(consumed: darray[sview]&, name: sview) -> bool:
            return any item in consumed where item == name


        def lifecycle_alias_root(alias_names: darray[sview]&, alias_roots: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while index > 0 |index: usize = alias_names.count|:
                    index <- index - 1
                    alias_roots[index] return if alias_names[index] == name
                return name


        def lifecycle_root(expression: Ast::Expr, alias_names: darray[sview]&, alias_roots: darray[sview]&) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return lifecycle_alias_root(alias_names, alias_roots, name)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        return lifecycle_root(operand, alias_names, alias_roots)
                    Expr.Field(object, field, line):
                        return lifecycle_root(object, alias_names, alias_roots)
                    Expr.Index(Expr.Field(object, field, field_line), argument, line):
                        return lifecycle_root(object, alias_names, alias_roots)
                    Expr.Index(object, argument, line):
                        return lifecycle_root(object, alias_names, alias_roots)
                    _:
                        return ""


        def lifecycle_set_alias(alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&, name: sview, root: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                while index > 0 |index: usize = alias_names.count|:
                    index <- index - 1
                    if alias_names[index] == name:
                        alias_roots[index] <- root
                        return
                alias_names.push(name)
                alias_roots.push(root)


        def lifecycle_is_shutdown(shutdown_names: darray[sview]&, shutdown_flags: darray[bool]&, root: sview) -> bool:
            can Abort.Panic:
                while index > 0 |index: usize = shutdown_names.count|:
                    index <- index - 1
                    shutdown_flags[index] return if shutdown_names[index] == root
                return false


        def lifecycle_set_shutdown(shutdown_names: mutable darray[sview]&, shutdown_flags: mutable darray[bool]&, root: sview, value: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                while index > 0 |index: usize = shutdown_names.count|:
                    index <- index - 1
                    if shutdown_names[index] == root:
                        shutdown_flags[index] <- value
                        return
                shutdown_names.push(root)
                shutdown_flags.push(value)


        def report_shutdown_use(root: sview, line: u32, shutdown_names: darray[sview]&, shutdown_flags: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineUseAfterConsume, name: root, line: line, expected: "", actual: ""}) if root != "" and lifecycle_is_shutdown(shutdown_names, shutdown_flags, root)


        def type_contains_named_state(expression: Ast::Expr, wanted: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return sview_equal(name, wanted)
                    Expr.Index(head, argument, line):
                        return type_contains_named_state(head, wanted) or type_contains_named_state(argument, wanted)
                    Expr.IndexN(head, arguments, line):
                        true return if type_contains_named_state(head, wanted)
                        for argument in arguments:
                            true return if type_contains_named_state(argument, wanted)
                        return false
                    Expr.Unary(operator, operand, line):
                        return type_contains_named_state(operand, wanted)
                    Expr.Paren(inner, line):
                        return type_contains_named_state(inner, wanted)
                    _:
                        return false


        def aggregate_exit_obligation(owner: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                while index < table.struct_field_owner.count |index: usize = 0|:
                    if table.struct_field_owner[index] == owner:
                        field_head: sview = interned_name(table.struct_field_type_id[index], table)
                        "joinable thread" return if field_head == "Thread"
                        "held mutex guard" return if field_head == "MutexGuard"
                    index <- index + 1
                return ""


        def exit_obligation(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                owner: sview = bare_type_name_through_ref(type_expression)
                "joinable thread" return if owner == "Thread" and type_contains_named_state(type_expression, "Joinable")
                "pending task" return if owner == "Task" and type_contains_named_state(type_expression, "Pending")
                "held mutex guard" return if owner == "MutexGuard" and type_contains_named_state(type_expression, "Held")
                return aggregate_exit_obligation(owner, table)


        def report_affine_consumed(root: sview, line: u32, consumed: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate:
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineUseAfterConsume, name: root, line: line, expected: "", actual: ""}) if root != "" and affine_consumed(consumed, root)


        def move_block_root(kind: sview, body: darray[Ast::Stmt]&) -> sview:
            can Abort.Panic:
                "" return if kind != "move" or body.count == 0
                return match body[0]:
                    Stmt.Match(scrutinee, arms, line): affine_root(scrutinee)
                    _: ""


        def body_is_empty_pass(body: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic:
                false return if body.count != 1
                return match body[0]:
                    Stmt.Expr(Expr.Invalid, line): true
                    _: false


        def lifecycle_expression_flags(expression: Ast::Expr) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        flags: mutable u32 = lifecycle_expression_flags(callee)
                        match callee:
                            Expr.Ident(call_name, call_line):
                                flags <- flags | 1 if call_name == "task_group_add"
                                flags <- flags | 4 if call_name == "pool_new"
                                flags <- flags | 8 if call_name == "pool_shutdown"
                            _:
                                pass
                        for argument in arguments |flags|:
                            flags <- flags | lifecycle_expression_flags(argument)
                        return flags
                    # `wait all group` lowers to a value-transparent block expression.
                    Expr.Block(statements, value, captures, line):
                        return 2 | lifecycle_statement_flags(statements) | lifecycle_expression_flags(value)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        return lifecycle_expression_flags(operand)
                    Expr.Binary(left, operator, right, line):
                        return lifecycle_expression_flags(left) | lifecycle_expression_flags(right)
                    Expr.Field(object, field, line):
                        return lifecycle_expression_flags(object)
                    Expr.Index(object, index, line):
                        return lifecycle_expression_flags(object) | lifecycle_expression_flags(index)
                    _:
                        return 0


        def lifecycle_statement_flags(statements: darray[Ast::Stmt]) -> u32:
            can Abort.Panic:
                flags: mutable u32 = 0
                for statement in statements |flags|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            flags <- flags | lifecycle_expression_flags(value)
                        Stmt.Assign(target, operator, value, line):
                            flags <- flags | lifecycle_expression_flags(value)
                        Stmt.Expr(expression, line):
                            flags <- flags | lifecycle_expression_flags(expression)
                        Stmt.Return(value, line):
                            flags <- flags | lifecycle_expression_flags(returned) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            flags <- flags | lifecycle_expression_flags(condition) | lifecycle_statement_flags(then_body) | lifecycle_statement_flags(else_body)
                        Stmt.Block(kind, clause, binding, body, line):
                            flags <- flags | lifecycle_statement_flags(body)
                        Stmt.While(condition, body, line):
                            flags <- flags | lifecycle_expression_flags(condition) | lifecycle_statement_flags(body)
                        Stmt.Match(scrutinee, arms, line):
                            flags <- flags | lifecycle_expression_flags(scrutinee)
                            for arm in arms |flags|:
                                flags <- flags | lifecycle_statement_flags(arm.body)
                        _:
                            pass
                return flags


        def lifecycle_alias_source(expression: Ast::Expr, alias_names: darray[sview]&, alias_roots: darray[sview]&) -> sview:
            can Abort.Panic:
                direct: sview = lifecycle_root(expression, alias_names, alias_roots)
                direct return if direct != ""
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        while index > 0 |index: usize = arguments.count|:
                            index <- index - 1
                            argument_root: sview = lifecycle_root(arguments[index], alias_names, alias_roots)
                            argument_root return if argument_root != ""
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        lifecycle_root(fields[0].value, alias_names, alias_roots) return if fields.count > 0
                    _:
                        pass
                return ""


        def walk_lifecycle_expression(expression: Ast::Expr, alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&, shutdown_names: mutable darray[sview]&, shutdown_flags: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        call_name: sview = match callee:
                            Expr.Ident(name, call_line): name
                            _: ""
                        if call_name == "pool_shutdown" and arguments.count > 0:
                            root: sview = lifecycle_root(arguments[0], alias_names, alias_roots)
                            table <- report_shutdown_use(root, line, shutdown_names, shutdown_flags, table)
                            lifecycle_set_shutdown(shutdown_names, shutdown_flags, root, true) if root != ""
                        for argument in arguments |alias_names, alias_roots, shutdown_names, shutdown_flags, table| -> table:
                            argument_root: sview = lifecycle_root(argument, alias_names, alias_roots)
                            table <- report_shutdown_use(argument_root, line, shutdown_names, shutdown_flags, table) if call_name != "pool_shutdown"
                            table <- walk_lifecycle_expression(argument, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        table <- walk_lifecycle_expression(operand, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_lifecycle_expression(left, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                        table <- walk_lifecycle_expression(right, alias_names, alias_roots, shutdown_names, shutdown_flags, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields |alias_names, alias_roots, shutdown_names, shutdown_flags, table| -> table:
                            table <- walk_lifecycle_expression(field.value, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |alias_names, alias_roots, shutdown_names, shutdown_flags, table| -> table:
                            table <- walk_lifecycle_expression(element, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                    _:
                        pass


        def walk_thread_pool_lifecycle(statements: darray[Ast::Stmt], alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&, shutdown_names: mutable darray[sview]&, shutdown_flags: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |alias_names, alias_roots, shutdown_names, shutdown_flags, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_lifecycle_expression(value, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                            source: sview = lifecycle_alias_source(value, alias_names, alias_roots)
                            lifecycle_set_alias(alias_names, alias_roots, name, source) if source != ""
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_lifecycle_expression(value, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                            target_root: sview = lifecycle_root(target, alias_names, alias_roots)
                            source: sview = lifecycle_alias_source(value, alias_names, alias_roots)
                            lifecycle_set_alias(alias_names, alias_roots, affine_root(target), source) if source != "" and affine_root(target) != ""
                            lifecycle_set_shutdown(shutdown_names, shutdown_flags, target_root, false) if lifecycle_expression_flags(value) & 4 != 0
                        Stmt.Expr(expression, line):
                            table <- walk_lifecycle_expression(expression, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                        Stmt.Return(value, line):
                            table <- walk_lifecycle_expression(returned, alias_names, alias_roots, shutdown_names, shutdown_flags, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_lifecycle_expression(condition, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                            table <- walk_thread_pool_lifecycle(then_body, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                            table <- walk_thread_pool_lifecycle(else_body, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_thread_pool_lifecycle(body, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                        Stmt.While(condition, body, line):
                            table <- walk_lifecycle_expression(condition, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_lifecycle_expression(scrutinee, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                            for arm in arms |table| -> table:
                                table <- walk_thread_pool_lifecycle(arm.body, alias_names, alias_roots, shutdown_names, shutdown_flags, table)
                        _:
                            pass
