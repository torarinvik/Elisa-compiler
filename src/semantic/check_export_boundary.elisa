extend Semantic:
    private:
        def export_annotation_exists(annotations: darray[Ast::EnumAnnotation]&, owner: sview, marker: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == owner and annotation.name == marker

        def immutable_export_target(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return any immutable_name in table.immutable_const_names where immutable_name == name

        # Is `name` declared in THIS file as a function? A positive answer only; a name this
        # file does not declare says nothing, because a single file is not the whole program.
        def function_export_target(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return any symbol in table.symbols where symbol.kind == SymbolKind.Func and symbol.name == name

        # The symbol an `export` row publishes: the `as` alias when one was written, else the
        # target itself. stage0 quotes this name, never the local declaration's.
        def exported_symbol_name(annotation: Ast::EnumAnnotation&) -> sview:
            can Abort.Panic:
                return annotation.owner if annotation.detail_name == "" else annotation.detail_name

    public:
        def check_export_boundary(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: exported_symbol_name(annotation), line: annotation.line, pos: annotation.pos, expected: "type", actual: ""}) if annotation.name == "__export_type" and not export_annotation_exists(file.enum_annotations, annotation.owner, "__layout_c")
                    # A const target: with an `as` alias stage0 names the kind it found; without
                    # one the published symbol IS the const's own name, and stage0 reports the
                    # collision instead.
                    aliased: bool = annotation.detail_name != "" and annotation.detail_name != annotation.owner
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: exported_symbol_name(annotation), line: annotation.line, pos: annotation.pos, expected: "global", actual: "", detail: "const"}) if annotation.name == "__export_global" and immutable_export_target(table, annotation.owner) and aliased
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: annotation.owner, line: annotation.line, pos: annotation.pos, expected: "collision", actual: ""}) if annotation.name == "__export_global" and immutable_export_target(table, annotation.owner) and not aliased
                    # A function is not a global. Only an unqualified target is checked: a
                    # `Mod::name` target belongs to another module's namespace.
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: exported_symbol_name(annotation), line: annotation.line, pos: annotation.pos, expected: "global", actual: "", detail: "func"}) if annotation.name == "__export_global" and annotation.arg_count == 1 and function_export_target(table, annotation.owner)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: annotation.owner, line: annotation.line, expected: "function", actual: ""}) if annotation.name == "__export_array"
