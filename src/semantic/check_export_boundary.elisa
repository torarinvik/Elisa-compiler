extend Semantic:
    private:
        def export_annotation_exists(annotations: darray[Ast::EnumAnnotation]&, owner: sview, marker: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == owner and annotation.name == marker

        def immutable_export_target(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return any immutable_name in table.immutable_const_names where immutable_name == name

    public:
        def check_export_boundary(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: annotation.owner, line: annotation.line, expected: "type", actual: ""}) if annotation.name == "__export_type" and not export_annotation_exists(file.enum_annotations, annotation.owner, "__layout_c")
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: annotation.owner, line: annotation.line, expected: "global", actual: ""}) if annotation.name == "__export_global" and immutable_export_target(table, annotation.owner)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidExportBoundary, name: annotation.owner, line: annotation.line, expected: "function", actual: ""}) if annotation.name == "__export_array"
