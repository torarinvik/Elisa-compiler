# Plain `T&` is a readonly reference capability. Field mutability describes whether a
# mutable owner may update the field; it does not make a readonly reference writable.
extend Semantic:
    private:
        def type_contains_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        return true if operator == TokenKind.Ampersand
                        return type_contains_ref(operand)
                    Expr.Paren(inner, line):
                        return type_contains_ref(inner)
                    Expr.Refinement(base, predicate, line):
                        return type_contains_ref(base)
                    _:
                        return false


        def type_contains_heap(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        return true if operator == TokenKind.Heap
                        return type_contains_heap(operand)
                    Expr.Paren(inner, line):
                        return type_contains_heap(inner)
                    Expr.Refinement(base, predicate, line):
                        return type_contains_heap(base)
                    _:
                        return false


        def type_is_readonly_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                # Heap references carry their own writable allocation capability in
                # Stage0. Plain, non-heap T& is the readonly borrow form.
                return type_contains_ref(expression) and not type_contains_heap(expression) and not type_is_mutable(expression) and not type_is_lmut(expression)


        def readonly_root_name(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Ident(name, line):
                    return name
                Expr.Field(object, field, line):
                    return readonly_root_name(object)
                Expr.Index(object, index, line):
                    return readonly_root_name(object)
                Expr.IndexN(object, arguments, line):
                    return readonly_root_name(object)
                Expr.Slice(object, low, high, line):
                    return readonly_root_name(object)
                Expr.Paren(inner, line):
                    return readonly_root_name(inner)
                _:
                    return ""


        def readonly_name_index(names: darray[sview]&, name: sview) -> i64:
            while index < names.count |index: usize = 0|:
                index.i64() return if names[index] == name
                index <- index + 1
            return -1


        const READONLY_FUNCTION_ROW: u32 = 4294967295


        def readonly_function_declared(callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, callee: sview, owner: sview) -> bool:
            can Abort.Panic:
                while index < callee_names.count |index: usize = 0|:
                    true return if positions[index] == READONLY_FUNCTION_ROW and callee_names[index] == callee and callee_owners[index] == owner
                    index <- index + 1
                return false


        def readonly_unqualified_owner_visible(table: SymbolTable&, caller_owner: sview, callee: sview, candidate_owner: sview) -> bool:
            can Abort.Panic:
                true return if candidate_owner == "" or candidate_owner == caller_owner
                true return if any imported_owner in table.imported_modules where imported_owner == candidate_owner
                true return if any imported_member in table.imported_members where imported_member == callee
                return false


        # Resolve a direct call before consulting its reference-parameter rows.
        # Module-local declarations shadow top-level functions; a top-level declaration
        # is next; among module members only imports visible to this source are candidates.
        def readonly_resolve_callee_owner(callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, callee: sview, caller_owner: sview, qualified_owner: sview, is_qualified: bool, resolved_owner: mutable sview&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                if is_qualified:
                    false return if not readonly_function_declared(callee_names, callee_owners, positions, callee, qualified_owner)
                    resolved_owner <- qualified_owner
                    return true
                if caller_owner != "" and readonly_function_declared(callee_names, callee_owners, positions, callee, caller_owner):
                    resolved_owner <- caller_owner
                    return true
                if readonly_function_declared(callee_names, callee_owners, positions, callee, ""):
                    resolved_owner <- ""
                    return true
                distinct_owners: mutable usize = 0
                selected_owner: mutable sview = ""
                while index < callee_names.count |index: usize = 0, distinct_owners, selected_owner|:
                    if positions[index] == READONLY_FUNCTION_ROW and callee_names[index] == callee and readonly_unqualified_owner_visible(table, caller_owner, callee, callee_owners[index]):
                        first_for_owner: mutable bool = true
                        while earlier < index |earlier: usize = 0, first_for_owner, callee_names, callee_owners, positions|:
                            first_for_owner <- false if positions[earlier] == READONLY_FUNCTION_ROW and callee_names[earlier] == callee and callee_owners[earlier] == callee_owners[index]
                            earlier <- earlier + 1
                        if first_for_owner:
                            distinct_owners <- distinct_owners + 1
                            selected_owner <- callee_owners[index]
                    index <- index + 1
                false return if distinct_owners != 1
                resolved_owner <- selected_owner
                return true


        def readonly_callee_target(expression: Ast::Expr, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, caller_owner: sview, callee_name: mutable sview&, callee_owner: mutable sview&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        callee_name <- name
                        return readonly_resolve_callee_owner(callee_names, callee_owners, positions, name, caller_owner, "", false, callee_owner, table)
                    Expr.Scope(base, name, line):
                        if base is Expr.Ident(module_name, module_line):
                            callee_name <- name
                            return readonly_resolve_callee_owner(callee_names, callee_owners, positions, name, caller_owner, module_name, true, callee_owner, table)
                    _:
                        pass
                return false


        # Cache includes both namespace owner and function name: the same spelling in
        # two modules can have different reference contracts at the same argument slot.
        def mutable_ref_param_type(callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, callee: sview, owner: sview, position: usize) -> sview:
            can Abort.Panic:
                for cache_index in 0..<cache_callees.count |cache_callees, cache_owners, cache_positions, cache_types|:
                    return cache_types[cache_index] if cache_callees[cache_index] == callee and cache_owners[cache_index] == owner and cache_positions[cache_index] == position.u32()
                result: mutable sview = ""
                while index < callee_names.count |index: usize = 0|:
                    if positions[index] != READONLY_FUNCTION_ROW and callee_names[index] == callee and callee_owners[index] == owner and positions[index] == position.u32():
                        # A readonly overload makes the call safe without granting writes.
                        if type_names[index] == "":
                            cache_callees.push(callee)
                            cache_owners.push(owner)
                            cache_positions.push(position.u32())
                            cache_types.push("")
                            return ""
                        result <- type_names[index]
                    index <- index + 1
                cache_callees.push(callee)
                cache_owners.push(owner)
                cache_positions.push(position.u32())
                cache_types.push(result)
                return result


        def collect_mutable_ref_params(declarations: darray[Ast::Decl], owner: sview, callee_names: mutable darray[sview]&, callee_owners: mutable darray[sview]&, positions: mutable darray[u32]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Keep every function declaration, including by-value signatures,
                            # so a same-named module-local function can shadow another module's
                            # mutable-reference contract.
                            callee_names.push(name)
                            callee_owners.push(owner)
                            positions.push(READONLY_FUNCTION_ROW)
                            type_names.push("")
                            while position < params.count |position: usize = 0|:
                                mutable_ref: bool = type_contains_ref(params[position].type_expression) and (type_is_mutable(params[position].type_expression) or type_is_lmut(params[position].type_expression))
                                ref_param: bool = type_contains_ref(params[position].type_expression)
                                if ref_param:
                                    callee_names.push(name)
                                    callee_owners.push(owner)
                                    positions.push(position.u32())
                                    type_names.push(bare_type_name_through_ref(params[position].type_expression) if mutable_ref else "")
                                position <- position + 1
                        Decl.Module(name, body, line):
                            collect_mutable_ref_params(body, name, callee_names, callee_owners, positions, type_names)
                        Decl.Scoped(body, line):
                            collect_mutable_ref_params(body, owner, callee_names, callee_owners, positions, type_names)
                        _:
                            pass


        def check_readonly_call(expression: Ast::Expr, readonly_names: darray[sview]&, readonly_types: darray[sview]&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        target_name: mutable sview = ""
                        target_owner: mutable sview = ""
                        if readonly_callee_target(callee, callee_names, callee_owners, positions, table.current_module, &target_name, &target_owner, table):
                            while argument_index < arguments.count |table, cache_callees, cache_owners, cache_positions, cache_types, argument_index: usize = 0| -> table:
                                argument_root: sview = readonly_root_name(arguments[argument_index])
                                readonly_index: i64 = readonly_name_index(readonly_names, argument_root)
                                # Only positional readonly arguments can produce this diagnostic.
                                # Avoid scanning all parameter metadata for unrelated arguments.
                                if readonly_index >= 0 and argument_names[argument_index] == "":
                                    expected_type: sview = mutable_ref_param_type(callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, target_name, target_owner, argument_index)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyRefArgument, name: target_name, pos: Ast::expr_pos(arguments[argument_index]), line: line.line, expected: expected_type, actual: readonly_types[readonly_index.usize()], expected_count: argument_index.u32() + 1}) if expected_type != ""
                                argument_index <- argument_index + 1
                        table <- check_readonly_call(callee, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        for argument in arguments |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                            table <- check_readonly_call(argument, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Field(object, field, line):
                        table <- check_readonly_call(object, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Index(object, index, line):
                        table <- check_readonly_call(object, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        table <- check_readonly_call(index, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_readonly_call(left, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        table <- check_readonly_call(right, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_readonly_call(operand, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Paren(inner, line):
                        table <- check_readonly_call(inner, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    _:
                        pass


        def check_readonly_statements(statements: darray[Ast::Stmt], readonly_names: darray[sview]&, readonly_types: darray[sview]&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            root: sview = readonly_root_name(target)
                            readonly_index: i64 = readonly_name_index(readonly_names, root)
                            mutating: bool = is_mutating_assign_operator(operator)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyRefMutation, name: root, line: line.line, expected: readonly_types[readonly_index.usize()], actual: ""}) if readonly_index >= 0 and mutating
                            table <- check_readonly_call(value, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Expr(expression, line):
                            table <- check_readonly_call(expression, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Return(value, line):
                            table <- check_readonly_call(return_value, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table) if value is return_value
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_readonly_call(value, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_readonly_call(condition, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table <- check_readonly_statements(then_body, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table <- check_readonly_statements(else_body, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.While(condition, body, line):
                            table <- check_readonly_call(condition, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_readonly_call(iterable, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_readonly_call(scrutinee, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            for arm in arms |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                                table <- check_readonly_statements(arm.body, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        _:
                            pass


        def check_readonly_ref_declarations(declarations: darray[Ast::Decl], callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            readonly_names: mutable darray[sview] = []
                            readonly_types: mutable darray[sview] = []
                            for param in params |readonly_names, readonly_types|:
                                if type_is_readonly_ref(param.type_expression):
                                    readonly_names.push(param.name)
                                    readonly_types.push(bare_type_name_through_ref(param.type_expression))
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Decl.Module(name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- name
                            table <- check_readonly_ref_declarations(body, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- check_readonly_ref_declarations(body, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        _:
                            pass

        # Whether struct STRUCT_NAME's field FIELD_NAME is declared `mutable`.
        def readonly_field_is_mutable(table: SymbolTable&, struct_name: sview, field_name: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                result: mutable bool = false
                found: mutable bool = false
                while index < table.struct_field_owner.count |index, result, found|:
                    if not found and table.struct_field_owner[index] == struct_name and table.struct_field_name[index] == field_name:
                        result <- table.struct_field_mutable[index]
                        found <- true
                    index <- index + 1
                return result

        # The base scalar type of a `&recv.field` argument that yields a READONLY reference —
        # `&p.x` where `x` is a NON-mutable field of `p`'s struct type produces a plain `T&`,
        # which cannot satisfy a `mutable T&` parameter. Returns the field's bare type, else "".
        # `&mutable-field` produces a writable borrow and is never flagged.
        def readonly_amp_field_type(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Ampersand:
                            match operand:
                                Expr.Field(receiver, field_name, field_line):
                                    receiver_name: sview = ident_name_of(receiver)
                                    "" return if receiver_name == ""
                                    receiver_type: sview = readonly_receiver_type(receiver_name, receiver_names, receiver_types)
                                    "" return if receiver_type == "" or readonly_field_is_mutable(table, receiver_type, field_name)
                                    return readonly_struct_field_bare_type(table, receiver_type, field_name)
                                _:
                                    pass
                    _:
                        pass
                return sview("", 0, 0)

        def readonly_receiver_type(name: sview, receiver_names: darray[sview]&, receiver_types: darray[sview]&) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                result: mutable sview = sview("", 0, 0)
                while index < receiver_names.count |index, result|:
                    result <- receiver_types[index] if result == "" and receiver_names[index] == name
                    index <- index + 1
                return result

        def readonly_struct_field_bare_type(table: SymbolTable&, struct_name: sview, field_name: sview) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                result: mutable sview = sview("", 0, 0)
                while index < table.struct_field_owner.count |index, result|:
                    result <- table.struct_field_type[index] if result == "" and table.struct_field_owner[index] == struct_name and table.struct_field_name[index] == field_name
                    index <- index + 1
                return result

        # Flag `f(&recv.field)` where the field is non-mutable and the parameter is `mutable T&`.
        def readonly_amp_check_expr(expression: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview]&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        target_name: mutable sview = ""
                        target_owner: mutable sview = ""
                        if readonly_callee_target(callee, callee_names, callee_owners, positions, table.current_module, &target_name, &target_owner, table):
                            while argument_index < arguments.count |table, cache_callees, cache_owners, cache_positions, cache_types, argument_index: usize = 0| -> table:
                                field_type: sview = readonly_amp_field_type(arguments[argument_index], receiver_names, receiver_types, table)
                                expected_type: sview = mutable_ref_param_type(callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, target_name, target_owner, argument_index)
                                mismatch: bool = field_type != "" and expected_type != "" and argument_names[argument_index] == ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyRefArgument, name: target_name, pos: Ast::expr_pos(arguments[argument_index]), line: line.line, expected: expected_type, actual: field_type, expected_count: argument_index.u32() + 1}) if mismatch
                                argument_index <- argument_index + 1
                        for argument in arguments |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                            table <- readonly_amp_check_expr(argument, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Paren(inner, paren_line):
                        table <- readonly_amp_check_expr(inner, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- readonly_amp_check_expr(left, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        table <- readonly_amp_check_expr(right, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                    _:
                        pass

        def readonly_amp_check_stmts(statements: darray[Ast::Stmt], receiver_names: darray[sview]&, receiver_types: darray[sview]&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- readonly_amp_check_expr(expression, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- readonly_amp_check_expr(value, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- readonly_amp_check_expr(value, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Return(value, line):
                            table <- readonly_amp_check_expr(return_value, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table) if value is return_value
                        Stmt.If(condition, then_body, else_body, line):
                            table <- readonly_amp_check_stmts(then_body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table <- readonly_amp_check_stmts(else_body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.While(condition, body, line):
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                                table <- readonly_amp_check_stmts(arm.body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        _:
                            pass

        def readonly_amp_check_declarations(declarations: darray[Ast::Decl], callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            receiver_names: mutable darray[sview] = []
                            receiver_types: mutable darray[sview] = []
                            for param in params |receiver_names, receiver_types|:
                                base_type: sview = lvarg_base_struct_name(param.type_expression)
                                if base_type != "":
                                    receiver_names.push(param.name)
                                    receiver_types.push(base_type)
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Decl.Module(name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- name
                            table <- readonly_amp_check_declarations(body, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- readonly_amp_check_declarations(body, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                        _:
                            pass

    public:
        def check_readonly_refs(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callee_names: mutable darray[sview] = []
                callee_owners: mutable darray[sview] = []
                positions: mutable darray[u32] = []
                type_names: mutable darray[sview] = []
                cache_callees: mutable darray[sview] = []
                cache_owners: mutable darray[sview] = []
                cache_positions: mutable darray[u32] = []
                cache_types: mutable darray[sview] = []
                collect_mutable_ref_params(declarations, "", callee_names, callee_owners, positions, type_names)
                table <- check_readonly_ref_declarations(declarations, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
                table <- readonly_amp_check_declarations(declarations, callee_names, callee_owners, positions, type_names, cache_callees, cache_owners, cache_positions, cache_types, table)
