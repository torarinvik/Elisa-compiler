# Plain `T&` is a readonly reference capability. Field mutability describes whether a
# mutable owner may update the field; it does not make a readonly reference writable.
extend Semantic:
    private:
        def type_contains_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                if expression is Expr.Unary(operator, operand, line):
                    true return if operator == TokenKind.Ampersand
                    return type_contains_ref(operand)
                if expression is Expr.Paren(inner, line):
                    return type_contains_ref(inner)
                if expression is Expr.Refinement(base, predicate, line):
                    return type_contains_ref(base)
                return false


        def type_contains_heap(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                if expression is Expr.Unary(operator, operand, line):
                    true return if operator == TokenKind.Heap
                    return type_contains_heap(operand)
                if expression is Expr.Paren(inner, line):
                    return type_contains_heap(inner)
                if expression is Expr.Refinement(base, predicate, line):
                    return type_contains_heap(base)
                return false


        def type_is_readonly_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                # Heap references carry their own writable allocation capability in
                # Stage0. Plain, non-heap T& is the readonly borrow form.
                return type_contains_ref(expression) and not type_contains_heap(expression) and not type_is_mutable(expression) and not type_is_lmut(expression)


        def readonly_root_name(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Ident(name, line):
                    return name
                Expr.Field(object, field, line):
                    return readonly_root_name(object)
                Expr.Index(object, index, line):
                    return readonly_root_name(object)
                Expr.IndexN(object, arguments, line):
                    return readonly_root_name(object)
                Expr.Slice(object, low, high, line):
                    return readonly_root_name(object)
                Expr.Paren(inner, line):
                    return readonly_root_name(inner)
                _:
                    return ""


        def readonly_name_index(names: darray[sview]&, name: sview) -> i64:
            while index < names.count |index: usize = 0|:
                index.i64() return if names[index] == name
                index <- index + 1
            return -1


        def mutable_ref_param_type(callee_names: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, callee: sview, position: usize) -> sview:
            can Abort.Panic:
                result: mutable sview = ""
                while index < callee_names.count |index: usize = 0|:
                    if callee_names[index] == callee and positions[index] == position.u32():
                        # A readonly overload makes a bare reference call valid;
                        # overload resolution can select it without granting writes.
                        "" return if type_names[index] == ""
                        result <- type_names[index]
                    index <- index + 1
                return result


        def collect_mutable_ref_params(declarations: darray[Ast::Decl], callee_names: mutable darray[sview]&, positions: mutable darray[u32]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            while position < params.count |position: usize = 0|:
                                mutable_ref: bool = type_contains_ref(params[position].type_expression) and (type_is_mutable(params[position].type_expression) or type_is_lmut(params[position].type_expression))
                                ref_param: bool = type_contains_ref(params[position].type_expression)
                                if ref_param:
                                    callee_names.push(name)
                                    positions.push(position.u32())
                                    type_names.push(bare_type_name_through_ref(params[position].type_expression) if mutable_ref else "")
                                position <- position + 1
                        Decl.Module(name, body, line):
                            collect_mutable_ref_params(body, callee_names, positions, type_names)
                        Decl.Scoped(body, line):
                            collect_mutable_ref_params(body, callee_names, positions, type_names)
                        _:
                            pass


        def check_readonly_call(expression: Ast::Expr, readonly_names: darray[sview]&, readonly_types: darray[sview]&, callee_names: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        if callee is Expr.Ident(callee_name, callee_line):
                            while argument_index < arguments.count |table, argument_index: usize = 0| -> table:
                                argument_root: sview = readonly_root_name(arguments[argument_index])
                                readonly_index: i64 = readonly_name_index(readonly_names, argument_root)
                                expected_type: sview = mutable_ref_param_type(callee_names, positions, type_names, callee_name, argument_index)
                                mismatch: bool = readonly_index >= 0 and expected_type != "" and argument_names[argument_index] == ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyRefArgument, name: callee_name, line: line, expected: expected_type, actual: readonly_types[readonly_index.usize()], expected_count: argument_index.u32() + 1}) if mismatch
                                argument_index <- argument_index + 1
                        table <- check_readonly_call(callee, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        for argument in arguments |table| -> table:
                            table <- check_readonly_call(argument, readonly_names, readonly_types, callee_names, positions, type_names, table)
                    Expr.Field(object, field, line):
                        table <- check_readonly_call(object, readonly_names, readonly_types, callee_names, positions, type_names, table)
                    Expr.Index(object, index, line):
                        table <- check_readonly_call(object, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        table <- check_readonly_call(index, readonly_names, readonly_types, callee_names, positions, type_names, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_readonly_call(left, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        table <- check_readonly_call(right, readonly_names, readonly_types, callee_names, positions, type_names, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_readonly_call(operand, readonly_names, readonly_types, callee_names, positions, type_names, table)
                    Expr.Paren(inner, line):
                        table <- check_readonly_call(inner, readonly_names, readonly_types, callee_names, positions, type_names, table)
                    _:
                        pass


        def check_readonly_statements(statements: darray[Ast::Stmt], readonly_names: darray[sview]&, readonly_types: darray[sview]&, callee_names: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            root: sview = readonly_root_name(target)
                            readonly_index: i64 = readonly_name_index(readonly_names, root)
                            mutating: bool = is_mutating_assign_operator(operator)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyRefMutation, name: root, line: line, expected: readonly_types[readonly_index.usize()], actual: ""}) if readonly_index >= 0 and mutating
                            table <- check_readonly_call(value, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Stmt.Expr(expression, line):
                            table <- check_readonly_call(expression, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Stmt.Return(value, line):
                            table <- check_readonly_call(return_value, readonly_names, readonly_types, callee_names, positions, type_names, table) if value is return_value
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_readonly_call(value, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_readonly_call(condition, readonly_names, readonly_types, callee_names, positions, type_names, table)
                            table <- check_readonly_statements(then_body, readonly_names, readonly_types, callee_names, positions, type_names, table)
                            table <- check_readonly_statements(else_body, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Stmt.While(condition, body, line):
                            table <- check_readonly_call(condition, readonly_names, readonly_types, callee_names, positions, type_names, table)
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_readonly_call(iterable, readonly_names, readonly_types, callee_names, positions, type_names, table)
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_readonly_call(scrutinee, readonly_names, readonly_types, callee_names, positions, type_names, table)
                            for arm in arms |table| -> table:
                                table <- check_readonly_statements(arm.body, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        _:
                            pass


        def check_readonly_ref_declarations(declarations: darray[Ast::Decl], callee_names: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            readonly_names: mutable darray[sview] = []
                            readonly_types: mutable darray[sview] = []
                            for param in params |readonly_names, readonly_types|:
                                if type_is_readonly_ref(param.type_expression):
                                    readonly_names.push(param.name)
                                    readonly_types.push(bare_type_name_through_ref(param.type_expression))
                            table <- check_readonly_statements(body, readonly_names, readonly_types, callee_names, positions, type_names, table)
                        Decl.Module(name, body, line):
                            table <- check_readonly_ref_declarations(body, callee_names, positions, type_names, table)
                        Decl.Scoped(body, line):
                            table <- check_readonly_ref_declarations(body, callee_names, positions, type_names, table)
                        _:
                            pass

    public:
        def check_readonly_refs(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callee_names: mutable darray[sview] = []
                positions: mutable darray[u32] = []
                type_names: mutable darray[sview] = []
                collect_mutable_ref_params(declarations, callee_names, positions, type_names)
                table <- check_readonly_ref_declarations(declarations, callee_names, positions, type_names, table)
