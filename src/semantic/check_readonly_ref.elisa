# Plain `T&` is a readonly reference capability. Field mutability describes whether a
# mutable owner may update the field; it does not make a readonly reference writable.
extend Semantic:
    private:
        def type_contains_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        return true if operator == TokenKind.Ampersand
                        return type_contains_ref(operand)
                    Expr.Paren(inner, line):
                        return type_contains_ref(inner)
                    Expr.Refinement(base, predicate, line):
                        return type_contains_ref(base)
                    _:
                        return false


        def type_contains_heap(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        return true if operator == TokenKind.Heap
                        return type_contains_heap(operand)
                    Expr.Paren(inner, line):
                        return type_contains_heap(inner)
                    Expr.Refinement(base, predicate, line):
                        return type_contains_heap(base)
                    _:
                        return false


        def readonly_root_name(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Ident(name, line):
                    return name
                Expr.Field(object, field, line):
                    # `p.cast[T]` and `p.call_as[...]` REINTERPRET the value: the result's
                    # type is what the bracket says, not the binding's. Walking through them
                    # made `current_ptr.cast[mutable void&]` report as the readonly binding
                    # `current_ptr`, so a `mutable void&` parameter looked like it was being
                    # handed a readonly ref. stage0 accepts the cast -- it is the explicit,
                    # capability-gated escape hatch -- and its own vendored runtime
                    # (elisacore_std/stores_core.elisa) is written that way, so stage1
                    # refusing it meant stage1 could not compile the canonical runtime.
                    return "" if field == "cast" or field == "call_as"
                    return readonly_root_name(object)
                Expr.Index(object, index, line):
                    return readonly_root_name(object)
                Expr.IndexN(object, arguments, line):
                    return readonly_root_name(object)
                Expr.Slice(object, low, high, line):
                    return readonly_root_name(object)
                Expr.Paren(inner, line):
                    return readonly_root_name(inner)
                _:
                    return ""


        const READONLY_FUNCTION_ROW: u32 = 4294967295

        # The readonly-reference pass keeps a compact parallel declaration table because the
        # parser AST does not carry module ownership on each function call. Build a hash-chain
        # projection over that table once: resolver and parameter-contract queries otherwise
        # rescan every declaration for every call in the imported proof system.
        struct ReadonlyFunctionIndex:
            heads: mutable dict[u64, u32]
            next: mutable darray[u32]
            declaration_heads: mutable dict[u64, u32]
            declaration_next: mutable darray[u32]

        def readonly_function_index_head(index: ReadonlyFunctionIndex&, name: sview) -> u32:
            can Abort.Panic:
                return head if index.heads.get(name_hash(name)) is head else READONLY_FUNCTION_ROW

        def build_readonly_function_index(names: darray[sview]&, index: mutable ReadonlyFunctionIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<names.count |row, names, index|:
                    previous: u32 = readonly_function_index_head(index, names[row])
                    index.next <- index.next.push(previous)
                    index.heads <- index.heads.put(name_hash(names[row]), row.u32())


        def readonly_declaration_index_head(index: ReadonlyFunctionIndex&, name: sview) -> u32:
            can Abort.Panic:
                return head if index.declaration_heads.get(name_hash(name)) is head else READONLY_FUNCTION_ROW


        def build_readonly_declaration_index(names: darray[sview]&, index: mutable ReadonlyFunctionIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<names.count |row, names, index|:
                    previous: u32 = readonly_declaration_index_head(index, names[row])
                    index.declaration_next <- index.declaration_next.push(previous)
                    index.declaration_heads <- index.declaration_heads.put(name_hash(names[row]), row.u32())

        def record_readonly_function(table: lmut SymbolTable, name: sview, owner: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                table.readonly_function_names <- table.readonly_function_names.push(name)
                table.readonly_function_owners <- table.readonly_function_owners.push(owner)


        # The readonly pass builds a hash-chain index over both the mutable-reference
        # parameter table and the declared readonly-function table. Keep declaration
        # membership queries on the matching table; using the parameter index here is
        # unsound because those arrays have different lengths and meanings.
        def readonly_function_declared(table: SymbolTable&, lookup: ReadonlyFunctionIndex&, callee: sview, owner: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = readonly_declaration_index_head(lookup, callee)
                while row != READONLY_FUNCTION_ROW |row, table, callee, owner|:
                    true return if table.readonly_function_names[row.usize()] == callee and table.readonly_function_owners[row.usize()] == owner
                    row <- lookup.declaration_next[row.usize()]
                return false


        def readonly_unqualified_owner_visible(table: SymbolTable&, caller_owner: sview, callee: sview, candidate_owner: sview) -> bool:
            can Abort.Panic:
                true return if candidate_owner == "" or candidate_owner == caller_owner
                true return if any imported_owner in table.imported_modules where imported_owner == candidate_owner
                true return if any imported_member in table.imported_members where imported_member == callee
                return false


        # Resolve a direct call before consulting its reference-parameter rows.
        # Module-local declarations shadow top-level functions; a top-level declaration
        # is next; among module members only imports visible to this source are candidates.
        def readonly_resolve_callee_owner(callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, lookup: ReadonlyFunctionIndex&, callee: sview, caller_owner: sview, qualified_owner: sview, is_qualified: bool, resolved_owner: mutable sview&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                if is_qualified:
                    false return if not readonly_function_declared(table, lookup, callee, qualified_owner)
                    resolved_owner <- qualified_owner
                    return true
                if caller_owner != "" and readonly_function_declared(table, lookup, callee, caller_owner):
                    resolved_owner <- caller_owner
                    return true
                if readonly_function_declared(table, lookup, callee, ""):
                    resolved_owner <- ""
                    return true
                distinct_owners: mutable usize = 0
                selected_owner: mutable sview = ""
                row: mutable u32 = readonly_function_index_head(lookup, callee)
                while row != READONLY_FUNCTION_ROW |row, distinct_owners, selected_owner|:
                    if positions[row.usize()] == READONLY_FUNCTION_ROW and callee_names[row.usize()] == callee and readonly_unqualified_owner_visible(table, caller_owner, callee, callee_owners[row.usize()]):
                        first_for_owner: mutable bool = true
                        earlier: mutable u32 = readonly_function_index_head(lookup, callee)
                        while earlier != row |earlier, first_for_owner, callee_names, callee_owners, positions|:
                            first_for_owner <- false if positions[earlier.usize()] == READONLY_FUNCTION_ROW and callee_names[earlier.usize()] == callee and callee_owners[earlier.usize()] == callee_owners[row.usize()]
                            earlier <- lookup.next[earlier.usize()]
                        if first_for_owner:
                            distinct_owners <- distinct_owners + 1
                            selected_owner <- callee_owners[row.usize()]
                    row <- lookup.next[row.usize()]
                false return if distinct_owners != 1
                resolved_owner <- selected_owner
                return true


        def readonly_callee_target(expression: Ast::Expr, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, lookup: ReadonlyFunctionIndex&, caller_owner: sview, callee_name: mutable sview&, callee_owner: mutable sview&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        callee_name <- name
                        return readonly_resolve_callee_owner(callee_names, callee_owners, positions, lookup, name, caller_owner, "", false, callee_owner, table)
                    Expr.Scope(base, name, line):
                        if base is Expr.Ident(module_name, module_line):
                            callee_name <- name
                            return readonly_resolve_callee_owner(callee_names, callee_owners, positions, lookup, name, caller_owner, module_name, true, callee_owner, table)
                    _:
                        pass
                return false


        # Cache includes both namespace owner and function name: the same spelling in
        # two modules can have different reference contracts at the same argument slot.
        def mutable_ref_param_type(callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, lookup: ReadonlyFunctionIndex&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, callee: sview, owner: sview, position: usize) -> sview:
            can Abort.Panic:
                # Entries are appended as the declaration walk proceeds. Repeated calls
                # in the same expression/tree tend to reuse the newest keys, so search
                # newest-first and avoid traversing the entire accumulated cache for the
                # common hit case. The key is still verified field-by-field; this is only
                # a locality optimization and cannot turn a miss into a false hit.
                cache_index: mutable usize = cache_callees.count
                while cache_index > 0 |cache_callees, cache_owners, cache_positions, cache_types|:
                    cache_index <- cache_index - 1.usize()
                    return cache_types[cache_index] if cache_callees[cache_index] == callee and cache_owners[cache_index] == owner and cache_positions[cache_index] == position.u32()
                result: mutable sview = ""
                found: mutable bool = false
                ambiguous: mutable bool = false
                row: mutable u32 = readonly_function_index_head(lookup, callee)
                while row != READONLY_FUNCTION_ROW |row|:
                    if callee_names[row.usize()] == callee and callee_owners[row.usize()] == owner and positions[row.usize()] == position.u32():
                        # This pre-check has no module/overload-resolution context. Only report
                        # readonly-to-mutable when EVERY same-named declaration seen at this
                        # position requires the SAME mutable referent. A value/readonly-ref
                        # candidate makes the mismatch inconclusive; a differently typed
                        # mutable candidate may belong to a sibling module with the same member
                        # name. The ordinary resolver owns the exact call target.
                        if type_names[row.usize()] == "":
                            ambiguous <- true
                        elif not found:
                            result <- type_names[row.usize()]
                            found <- true
                        elif result != type_names[row.usize()]:
                            ambiguous <- true
                    row <- lookup.next[row.usize()]
                resolved: sview = "" if ambiguous or not found else result
                cache_callees.push(callee)
                cache_owners.push(owner)
                cache_positions.push(position.u32())
                cache_types.push(resolved)
                return resolved


        def collect_mutable_ref_params(table: lmut SymbolTable, declarations: darray[Ast::Decl], owner: sview, callee_names: mutable darray[sview]&, callee_owners: mutable darray[sview]&, positions: mutable darray[u32]&, type_names: mutable darray[sview]&, bindings: mutable RefBindingScope&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |bindings|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Keep every function declaration, including by-value signatures,
                            # so a same-named module-local function can shadow another module's
                            # mutable-reference contract. `bindings.call_*` carries each row's
                            # spelled type in lockstep: the return type on the function row.
                            generic: bool = rbm_function_is_generic(line.line, table)
                            returned: RefSpelling = rbm_signature_spelling(declared_return, generic) if return_type is declared_return else rbm_decline()
                            callee_names.push(name)
                            callee_owners.push(owner)
                            positions.push(READONLY_FUNCTION_ROW)
                            type_names.push("")
                            bindings.call_elems <- bindings.call_elems.push(returned.elem)
                            bindings.call_flags <- bindings.call_flags.push(returned.flags)
                            table <- table.record_readonly_function(name, owner)
                            while position < params.count |bindings, position: usize = 0|:
                                mutable_ref: bool = type_contains_ref(params[position].type_expression) and (type_is_mutable(params[position].type_expression) or type_is_lmut(params[position].type_expression))
                                parameter_type: RefSpelling = rbm_signature_spelling(params[position].type_expression, generic)
                                callee_names.push(name)
                                callee_owners.push(owner)
                                positions.push(position.u32())
                                type_names.push(bare_type_name_through_ref(params[position].type_expression) if mutable_ref else "")
                                bindings.call_elems <- bindings.call_elems.push(parameter_type.elem)
                                bindings.call_flags <- bindings.call_flags.push(parameter_type.flags)
                                position <- position + 1
                        Decl.Module(name, body, line):
                            table <- table.collect_mutable_ref_params(body, name, callee_names, callee_owners, positions, type_names, bindings)
                        Decl.Scoped(body, line):
                            table <- table.collect_mutable_ref_params(body, owner, callee_names, callee_owners, positions, type_names, bindings)
                        _:
                            pass


        def check_readonly_call(expression: Ast::Expr, bindings: RefBindingScope&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, lookup: ReadonlyFunctionIndex&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        target_name: mutable sview = ""
                        target_owner: mutable sview = ""
                        if readonly_callee_target(callee, callee_names, callee_owners, positions, lookup, table.current_module, &target_name, &target_owner, table):
                            while argument_index < arguments.count |table, cache_callees, cache_owners, cache_positions, cache_types, argument_index: usize = 0| -> table:
                                # Only positional arguments can produce this diagnostic.
                                table <- rbm_check_argument(arguments[argument_index], argument_index, target_name, target_owner, line.line, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table) if argument_names[argument_index] == ""
                                argument_index <- argument_index + 1
                        table <- check_readonly_call(callee, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        for argument in arguments |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                            table <- check_readonly_call(argument, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Field(object, field, line):
                        table <- check_readonly_call(object, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Index(object, index, line):
                        table <- check_readonly_call(object, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        table <- check_readonly_call(index, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_readonly_call(left, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        table <- check_readonly_call(right, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_readonly_call(operand, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Paren(inner, line):
                        table <- check_readonly_call(inner, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    _:
                        pass


        # EVERY BINDING HAS A CAPABILITY FOR THE REST OF ITS BLOCK (rule R).
        #
        # A reference binding is readonly (R), writable through a fixed slot (W), rebindable
        # but readonly (RB), writable and rebindable (WR), or -- the legacy `x: mutable T& =
        # readonly_source` form -- rebindable and demoted to readonly (RL). check_ref_binding_
        # modes.elisa classifies; check_ref_binding_rules.elisa checks.
        #
        # The walk pushes each declaration AFTER its own initializer is checked (a declaration
        # is not in scope for the value it binds) and truncates back to its mark when the block
        # ends, so nothing leaks out of a block. A binding this pass does not type (`x = v`, a
        # loop variable, a pattern name) is pushed OPAQUE so it hides any outer binding of the
        # same name instead of inheriting its capability.
        def check_readonly_statements(statements: darray[Ast::Stmt], bindings: mutable RefBindingScope&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, lookup: ReadonlyFunctionIndex&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                block_mark: usize = bindings.names.count
                for statement in statements |table, cache_callees, cache_owners, cache_positions, cache_types, bindings| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            if is_mutating_assign_operator(operator):
                                table <- rbm_check_assign(target, operator, value, line, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            else:
                                table <- check_readonly_call(value, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                                rbm_push_defined(target, bindings)
                        Stmt.Expr(expression, line):
                            table <- check_readonly_call(expression, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Return(value, line):
                            table <- check_readonly_call(return_value, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table) if value is return_value
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_readonly_call(value, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            declared: RefBinding = rbm_local_binding(name, type_expression, value, line, bindings, callee_names, callee_owners, positions, lookup, table)
                            rbm_push(bindings, name, declared)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_readonly_call(condition, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            branch_mark: usize = bindings.names.count
                            rbm_push_is_binders(condition, bindings)
                            nonnull: mutable darray[sview] = []
                            rbm_gather_nonnull(condition, &nonnull)
                            rbm_push_proven(nonnull, bindings, table)
                            table <- check_readonly_statements(then_body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            rbm_truncate(bindings, branch_mark)
                            table <- check_readonly_statements(else_body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            # `if x == null: return` proves `x` for the rest of the block.
                            if else_body.count == 0 and rbm_body_exits(then_body):
                                exits: mutable darray[sview] = []
                                rbm_gather_null_exit(condition, &exits)
                                rbm_push_proven(exits, bindings, table)
                        Stmt.While(condition, body, line):
                            table <- check_readonly_call(condition, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            loop_mark: usize = bindings.names.count
                            rbm_push_is_binders(condition, bindings)
                            table <- check_readonly_statements(body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            rbm_truncate(bindings, loop_mark)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_readonly_call(iterable, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            for_mark: usize = bindings.names.count
                            for variable in variables |bindings|:
                                rbm_push_opaque(bindings, variable)
                            table <- check_readonly_statements(body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            rbm_truncate(bindings, for_mark)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_binding_mark: usize = bindings.names.count
                            rbm_push_opaque(bindings, binding)
                            table <- check_readonly_statements(body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            rbm_truncate(bindings, block_binding_mark)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_readonly_call(scrutinee, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            for arm in arms |table, cache_callees, cache_owners, cache_positions, cache_types, bindings| -> table:
                                arm_mark: usize = bindings.names.count
                                arm_names: mutable darray[sview] = []
                                gather_pattern_names(arm.pattern, &arm_names)
                                for arm_name in arm_names |bindings|:
                                    rbm_push_opaque(bindings, arm_name)
                                table <- check_readonly_statements(arm.body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                                rbm_truncate(bindings, arm_mark)
                        _:
                            pass
                rbm_truncate(bindings, block_mark)


        def check_readonly_ref_declarations(declarations: darray[Ast::Decl], bindings: mutable RefBindingScope&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, lookup: ReadonlyFunctionIndex&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, cache_callees, cache_owners, cache_positions, cache_types, bindings| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            function_mark: usize = bindings.names.count
                            for param in params |bindings|:
                                rbm_push(bindings, param.name, rbm_param_binding(param))
                            table <- check_readonly_statements(body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            rbm_truncate(bindings, function_mark)
                        Decl.Const(name, type_expression, value, is_global, const_pos):
                            table <- rbm_check_global_init(name, type_expression, value, const_pos, bindings, callee_names, callee_owners, positions, lookup, table) if is_global
                        Decl.Module(name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- name
                            table <- check_readonly_ref_declarations(body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- check_readonly_ref_declarations(body, bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        _:
                            pass

        # Whether struct STRUCT_NAME's field FIELD_NAME is declared `mutable`.
        def readonly_field_is_mutable(table: SymbolTable&, struct_name: sview, field_name: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                result: mutable bool = false
                found: mutable bool = false
                while index < table.struct_field_owner.count |index, result, found|:
                    if not found and table.struct_field_owner[index] == struct_name and table.struct_field_name[index] == field_name:
                        result <- table.struct_field_mutable[index]
                        found <- true
                    index <- index + 1
                return result

        # The base scalar type of a `&recv.field` argument that yields a READONLY reference —
        # `&p.x` where `x` is a NON-mutable field of `p`'s struct type produces a plain `T&`,
        # which cannot satisfy a `mutable T&` parameter. Returns the field's bare type, else "".
        # `&mutable-field` produces a writable borrow and is never flagged.
        def readonly_amp_field_type(argument: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Ampersand:
                            match operand:
                                Expr.Field(receiver, field_name, field_line):
                                    receiver_name: sview = ident_name_of(receiver)
                                    "" return if receiver_name == ""
                                    receiver_type: sview = readonly_receiver_type(receiver_name, receiver_names, receiver_types)
                                    "" return if receiver_type == "" or readonly_field_is_mutable(table, receiver_type, field_name)
                                    return readonly_struct_field_bare_type(table, receiver_type, field_name)
                                _:
                                    pass
                    _:
                        pass
                return sview("", 0, 0)

        def readonly_receiver_type(name: sview, receiver_names: darray[sview]&, receiver_types: darray[sview]&) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                result: mutable sview = sview("", 0, 0)
                while index < receiver_names.count |index, result|:
                    result <- receiver_types[index] if result == "" and receiver_names[index] == name
                    index <- index + 1
                return result

        def readonly_struct_field_bare_type(table: SymbolTable&, struct_name: sview, field_name: sview) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                result: mutable sview = sview("", 0, 0)
                while index < table.struct_field_owner.count |index, result|:
                    result <- table.struct_field_type[index] if result == "" and table.struct_field_owner[index] == struct_name and table.struct_field_name[index] == field_name
                    index <- index + 1
                return result

        # Flag `f(&recv.field)` where the field is non-mutable and the parameter is `mutable T&`.
        def readonly_amp_check_expr(expression: Ast::Expr, receiver_names: darray[sview]&, receiver_types: darray[sview]&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, lookup: ReadonlyFunctionIndex&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        target_name: mutable sview = ""
                        target_owner: mutable sview = ""
                        if readonly_callee_target(callee, callee_names, callee_owners, positions, lookup, table.current_module, &target_name, &target_owner, table):
                            while argument_index < arguments.count |table, cache_callees, cache_owners, cache_positions, cache_types, argument_index: usize = 0| -> table:
                                field_type: sview = readonly_amp_field_type(arguments[argument_index], receiver_names, receiver_types, table)
                                expected_type: sview = mutable_ref_param_type(callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, target_name, target_owner, argument_index)
                                mismatch: bool = field_type != "" and expected_type != "" and argument_names[argument_index] == ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyRefArgument, name: target_name, pos: Ast::expr_pos(arguments[argument_index]), line: line.line, expected: expected_type, actual: field_type, expected_count: argument_index.u32() + 1}) if mismatch
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyRefArgumentNote, name: target_name, pos: Ast::expr_pos(arguments[argument_index]), line: line.line, expected: expected_type, actual: field_type, expected_count: argument_index.u32() + 1}) if mismatch and expected_type == field_type
                                argument_index <- argument_index + 1
                        for argument in arguments |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                            table <- readonly_amp_check_expr(argument, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Paren(inner, paren_line):
                        table <- readonly_amp_check_expr(inner, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- readonly_amp_check_expr(left, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        table <- readonly_amp_check_expr(right, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                    _:
                        pass

        def readonly_amp_check_stmts(statements: darray[Ast::Stmt], receiver_names: darray[sview]&, receiver_types: darray[sview]&, callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, lookup: ReadonlyFunctionIndex&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- readonly_amp_check_expr(expression, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- readonly_amp_check_expr(value, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- readonly_amp_check_expr(value, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Return(value, line):
                            table <- readonly_amp_check_expr(return_value, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table) if value is return_value
                        Stmt.If(condition, then_body, else_body, line):
                            table <- readonly_amp_check_stmts(then_body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table <- readonly_amp_check_stmts(else_body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.While(condition, body, line):
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                                table <- readonly_amp_check_stmts(arm.body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        _:
                            pass

        def readonly_amp_check_declarations(declarations: darray[Ast::Decl], callee_names: darray[sview]&, callee_owners: darray[sview]&, positions: darray[u32]&, type_names: darray[sview]&, lookup: ReadonlyFunctionIndex&, cache_callees: mutable darray[sview]&, cache_owners: mutable darray[sview]&, cache_positions: mutable darray[u32]&, cache_types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, cache_callees, cache_owners, cache_positions, cache_types| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            receiver_names: mutable darray[sview] = []
                            receiver_types: mutable darray[sview] = []
                            for param in params |receiver_names, receiver_types|:
                                base_type: sview = lvarg_base_struct_name(param.type_expression)
                                if base_type != "":
                                    receiver_names.push(param.name)
                                    receiver_types.push(base_type)
                            table <- readonly_amp_check_stmts(body, receiver_names, receiver_types, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        Decl.Module(name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- name
                            table <- readonly_amp_check_declarations(body, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- readonly_amp_check_declarations(body, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                        _:
                            pass

    public:
        def check_readonly_refs(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callee_names: mutable darray[sview] = []
                callee_owners: mutable darray[sview] = []
                positions: mutable darray[u32] = []
                type_names: mutable darray[sview] = []
                cache_callees: mutable darray[sview] = []
                cache_owners: mutable darray[sview] = []
                cache_positions: mutable darray[u32] = []
                cache_types: mutable darray[sview] = []
                lookup: mutable ReadonlyFunctionIndex = ReadonlyFunctionIndex{heads: {}, next: [], declaration_heads: {}, declaration_next: []}
                bindings: mutable RefBindingScope = RefBindingScope{names: [], elems: [], bares: [], modes: [], kinds: [], declared: [], current: [], proven: [], global_names: [], global_owners: [], global_elems: [], global_bares: [], global_modes: [], global_kinds: [], global_declared: [], global_heads: {}, global_next: [], field_heads: {}, field_next: [], call_elems: [], call_flags: []}
                global_mutable_names: mutable darray[sview] = []
                global_mutable_lines: mutable darray[u32] = []
                for annotation in table.protocol_annotations |global_mutable_names, global_mutable_lines|:
                    if annotation.name == "__global_mutable":
                        global_mutable_names.push(annotation.owner)
                        global_mutable_lines.push(annotation.line)
                rbm_collect_globals(declarations, "", global_mutable_names, global_mutable_lines, &bindings)
                rbm_build_field_index(&bindings, table)
                table <- table.collect_mutable_ref_params(declarations, "", callee_names, callee_owners, positions, type_names, &bindings)
                build_readonly_function_index(callee_names, &lookup)
                build_readonly_declaration_index(table.readonly_function_names, &lookup)
                table <- check_readonly_ref_declarations(declarations, &bindings, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
                table <- readonly_amp_check_declarations(declarations, callee_names, callee_owners, positions, type_names, lookup, cache_callees, cache_owners, cache_positions, cache_types, table)
