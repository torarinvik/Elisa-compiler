# Contract-family diagnostic (deep tier, non-prover / structural). `requires` and `ensure`
# contracts must be the LEADING statements of a function body (they state a precondition /
# postcondition of the whole function). Once an ordinary statement has run, a later
# `requires`/`ensure` is misplaced — stage0 rejects it. `decreases`/`invariant`/`changes` are
# NOT position-restricted (verified against stage0: a mid-body `decreases` is legal), so only
# `requires`/`ensure` fire. Purely positional — no symbols, types, or prover involved.
extend Semantic:
    private:
        # Whether a statement is any design-by-contract statement (requires/ensure/decreases/
        # invariant/changes) — all share the Stmt.Contract shape.
        def statement_is_contract(statement: Ast::Stmt) -> bool:
            match statement:
                Stmt.Contract(kind, expression, line):
                    return true
                _:
                    return false


        # The number of LEADING contract statements — i.e. the index of the first
        # non-contract statement (= the length of the legal contract prologue).
        def leading_contract_count(statements: darray[Ast::Stmt]) -> usize:
            can Abort.Panic:
                while scan_index < statements.count |scan_index: usize = 0|:
                    if not statement_is_contract(statements[scan_index]):
                        return scan_index
                    scan_index <- scan_index + 1
                return statements.count


        # Flag any `requires`/`ensure` that appears AFTER the contract prologue (i.e. after the
        # first ordinary statement). Scans only the post-prologue tail.
        def check_contract_position_body(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                prologue_length: usize = leading_contract_count(statements)
                while statement_index < statements.count |statement_index: usize = prologue_length|:
                    match statements[statement_index]:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            is_precondition_or_postcondition: mutable bool = false
                            if contract_kind == "requires":
                                is_precondition_or_postcondition <- true
                            if contract_kind == "ensure":
                                is_precondition_or_postcondition <- true
                            if is_precondition_or_postcondition:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContractNotFirst, name: "", line: line, expected: "", actual: ""})
                        _:
                            pass
                    statement_index <- statement_index + 1


        # Recurse through every function body (descending Module/Scoped).
        def check_contract_position(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_contract_position_body(body, table)
                        Decl.Module(name, body, line):
                            table <- check_contract_position(body, table)
                        Decl.Scoped(body, line):
                            table <- check_contract_position(body, table)
                        _:
                            pass
