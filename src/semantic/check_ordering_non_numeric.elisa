# Check for ordering-comparison (`< > <= >=`) operands that are firm non-numeric
# (bool/string). Numeric (int/float/char), Unknown, and Named operands never fire.
# Disjoint from IncompatibleComparison, which owns `==`/`!=` cross-group mismatches.

extend Semantic:
    private:
        # Walk through expressions, checking ordering comparisons for non-numeric operands.
        def ordering_operand_is_primitive_field(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match expression:
                    # A field on a firm scalar is poisoned to Unknown by the field-access
                    # diagnostic, but Stage0 still reports the enclosing ordering comparison.
                    # Preserve that second diagnostic without treating arbitrary Unknown or
                    # named fields as non-numeric.
                    Expr.Field(object, field, line):
                        object_type: InferType = infer_expression_type(object, var_types, type_names, table)
                        return object_type.kind == SemTypeKind.Int or object_type.kind == SemTypeKind.Float or object_type.kind == SemTypeKind.Bool or object_type.kind == SemTypeKind.Char
                    Expr.Paren(inner, line):
                        return ordering_operand_is_primitive_field(inner, var_types, type_names, table)
                    _:
                        return false

        def walk_expression_for_ordering_non_numeric(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        is_ordering: bool = operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
                        # Both operand types are inferred unconditionally (pure, read-only
                        # lookups) then folded into the guard, per docs/125 flow-flag discipline.
                        left_type: InferType = infer_expression_type(left, var_types, type_names, table)
                        right_type: InferType = infer_expression_type(right, var_types, type_names, table)
                        # ONE report per operator: `a < b` with two bools is one error, not two.
                        left_poisoned_field: bool = ordering_operand_is_primitive_field(left, var_types, type_names, table)
                        right_poisoned_field: bool = ordering_operand_is_primitive_field(right, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrderingNonNumeric, name: "", pos: line, line: line.line, expected: "", actual: ""}) if is_ordering and (kind_is_firm_non_numeric(left_type) or kind_is_firm_non_numeric(right_type) or left_poisoned_field or right_poisoned_field)
                        # Recursively walk both sides
                        table <- walk_expression_for_ordering_non_numeric(left, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_ordering_non_numeric(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_ordering_non_numeric(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_ordering_non_numeric(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_ordering_non_numeric(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_ordering_non_numeric(object, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_ordering_non_numeric(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_ordering_non_numeric(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_ordering_non_numeric(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_ordering_non_numeric(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_ordering_non_numeric(object, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(low, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_ordering_non_numeric(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_ordering_non_numeric(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_ordering_non_numeric(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_ordering_non_numeric(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_ordering_non_numeric(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_ordering_non_numeric(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_ordering_non_numeric(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_ordering_non_numeric(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_ordering_non_numeric(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_ordering_non_numeric(condition, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_ordering_non_numeric(iterable, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(condition, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_ordering_non_numeric(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_ordering_non_numeric(statements, table, var_types, type_names)
                        table <- walk_expression_for_ordering_non_numeric(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_ordering_non_numeric(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_ordering_non_numeric(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking ordering comparisons.
        def walk_statements_for_ordering_non_numeric(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_ordering_non_numeric(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_ordering_non_numeric(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_ordering_non_numeric(target, table, var_types, type_names)
                            table <- walk_expression_for_ordering_non_numeric(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_ordering_non_numeric(condition, table, var_types, type_names)
                            table <- walk_statements_for_ordering_non_numeric(then_body, table, var_types, type_names)
                            table <- walk_statements_for_ordering_non_numeric(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_ordering_non_numeric(condition, table, var_types, type_names)
                            table <- walk_statements_for_ordering_non_numeric(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_ordering_non_numeric(iterable, table, var_types, type_names)
                            table <- walk_statements_for_ordering_non_numeric(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_ordering_non_numeric(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_ordering_non_numeric(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_ordering_non_numeric(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_ordering_non_numeric(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_ordering_non_numeric(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_ordering_non_numeric(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_ordering_non_numeric_declarations(declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, contract_lines: darray[u32]&, contract_kinds: darray[sview]&, contract_exprs: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_ordering_non_numeric(body, table, var_types, type_names)
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, extern_return, extern_decorators, line):
                            # Extern contracts are stored in the file-level signature tables,
                            # not in a statement body. They still contain ordinary ordering
                            # expressions and must receive the same diagnostic walk as a
                            # function body. Stage0 reports `buf.count > 0` on the contract
                            # line; omitting this path makes Stage1 silently miss that error.
                            extern_var_types: mutable darray[sview] = []
                            extern_type_names: mutable darray[sview] = []
                            for extern_index in param_start.usize()..<(param_start.usize() + arity.usize()) |extern_var_types, extern_type_names|:
                                continue if extern_index >= extern_params.count
                                note_local_type(extern_var_types, extern_type_names, extern_params[extern_index].name, extern_params[extern_index].type_name)
                            for contract_index in 0..<contract_exprs.count |table, extern_var_types, extern_type_names| -> table:
                                continue if contract_index >= contract_lines.count or contract_index >= contract_kinds.count
                                continue if contract_lines[contract_index] != line.line or contract_kinds[contract_index] != "requires"
                                table <- walk_expression_for_ordering_non_numeric(contract_exprs[contract_index], table, extern_var_types, extern_type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_ordering_non_numeric_declarations(body, extern_params, contract_lines, contract_kinds, contract_exprs, table)
                        Decl.Scoped(body, line):
                            table <- check_ordering_non_numeric_declarations(body, extern_params, contract_lines, contract_kinds, contract_exprs, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_ordering_non_numeric(declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, contract_lines: darray[u32]&, contract_kinds: darray[sview]&, contract_exprs: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_ordering_non_numeric_declarations(declarations, extern_params, contract_lines, contract_kinds, contract_exprs, table)
