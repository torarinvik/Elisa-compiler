# Preserves/changes overlap (docs/87 §7: `preserves Y ⟺ Y ∩ changes(f) = ∅`). A place that is both
# `preserves`d and `changes`d is rejected ("`preserves b.items` conflicts with `changes b`: a place
# cannot be both preserved and changed"). The parser records, per function, whole-`changes ROOT`
# roots (sentinel 3900000010) and each `preserves ROOT.field` root+field (3900000011/12, index-paired
# in push order). This check flags a preserves target whose root is a whole-changes root.
extend Semantic:
    private:
        def preserves_owner_has_whole_change(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, root: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.line == 3900000010 and annotation.owner == function_name and annotation.name == root

        def check_preserves_conflict(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Rebuild the index-paired (root, field) preserves targets per push order.
                preserves_owners: mutable darray[sview] = []
                preserves_roots: mutable darray[sview] = []
                preserves_fields: mutable darray[sview] = []
                for annotation in file.enum_annotations |preserves_owners, preserves_roots, preserves_fields|:
                    if annotation.line == 3900000011:
                        preserves_owners.push(annotation.owner)
                        preserves_roots.push(annotation.name)
                    preserves_fields.push(annotation.name) if annotation.line == 3900000012
                index: mutable usize = 0
                while index < preserves_roots.count |table, index| -> table:
                    owner: sview = preserves_owners[index]
                    root: sview = preserves_roots[index]
                    field: sview = preserves_fields[index] if index < preserves_fields.count else sview("", 0, 0)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreservesChangesConflict, name: root, line: 0, expected: "", actual: field}) if preserves_owner_has_whole_change(file.enum_annotations, owner, root)
                    index <- index + 1

        # Whether (root, field) is a preserved place of FUNCTION (an index-paired 3900000011/12 row).
        def is_preserved_place(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, root: sview, field: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                roots: mutable darray[sview] = []
                fields: mutable darray[sview] = []
                for annotation in annotations |roots, fields|:
                    roots.push(annotation.name) if annotation.line == 3900000011 and annotation.owner == function_name
                    fields.push(annotation.name) if annotation.line == 3900000012 and annotation.owner == function_name
                found: mutable bool = false
                pair_index: mutable usize = 0
                while pair_index < roots.count |found|:
                    found <- true if roots[pair_index] == root and pair_index < fields.count and fields[pair_index] == field
                    pair_index <- pair_index + 1
                return found

        # A direct write to a preserved place `p.f <- v` / `p.f.push(...)` is a preserves violation.
        def preserves_write_walk(statements: darray[Ast::Stmt], function_name: sview, annotations: darray[Ast::EnumAnnotation]&, params: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            write: (found: bool, root: sview, field: sview) = frame_write_target(target, params)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesPreservedPlace, name: write.root, line: line.line, expected: function_name, actual: write.field}) if write.found and is_preserved_place(annotations, function_name, write.root, write.field)
                        Stmt.Expr(expression, line):
                            match expression:
                                Expr.Call(callee, arguments, argument_names, call_line):
                                    match callee:
                                        Expr.Field(receiver, method, field_line):
                                            if frame_mutating_method(method):
                                                method_write: (found: bool, root: sview, field: sview) = frame_write_target(receiver, params)
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesPreservedPlace, name: method_write.root, line: line.line, expected: function_name, actual: method_write.field}) if method_write.found and is_preserved_place(annotations, function_name, method_write.root, method_write.field)
                                        _:
                                            pass
                                _:
                                    pass
                        Stmt.If(condition, then_body, else_body, line):
                            table <- preserves_write_walk(then_body, function_name, annotations, params, table)
                            table <- preserves_write_walk(else_body, function_name, annotations, params, table)
                        Stmt.While(condition, while_body, line):
                            table <- preserves_write_walk(while_body, function_name, annotations, params, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- preserves_write_walk(for_body, function_name, annotations, params, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- preserves_write_walk(body, function_name, annotations, params, table)
                        _:
                            pass

        def check_preserves_write(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in file.top_decls |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            params: mutable darray[sview] = [parameter.name for parameter in parameters]
                            table <- preserves_write_walk(body, function_name, file.enum_annotations, params, table)
                        _:
                            pass
