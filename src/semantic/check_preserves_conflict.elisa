# Preserves/changes overlap (docs/87 §7: `preserves Y ⟺ Y ∩ changes(f) = ∅`). A place that is both
# `preserves`d and `changes`d is rejected ("`preserves b.items` conflicts with `changes b`: a place
# cannot be both preserved and changed"). The parser records, per function, whole-`changes ROOT`
# roots (sentinel 3900000010) and each `preserves ROOT.field` root+field (3900000011/12, index-paired
# in push order). This check flags a preserves target whose root is a whole-changes root.
extend Semantic:
    private:
        def preserves_owner_has_whole_change(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, root: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.line == 3900000010 and annotation.owner == function_name and annotation.name == root

        def check_preserves_conflict(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Rebuild the index-paired (root, field) preserves targets per push order.
                preserves_owners: mutable darray[sview] = []
                preserves_roots: mutable darray[sview] = []
                preserves_fields: mutable darray[sview] = []
                for annotation in file.enum_annotations |preserves_owners, preserves_roots, preserves_fields|:
                    if annotation.line == 3900000011:
                        preserves_owners.push(annotation.owner)
                        preserves_roots.push(annotation.name)
                    preserves_fields.push(annotation.name) if annotation.line == 3900000012
                index: mutable usize = 0
                while index < preserves_roots.count |table, index| -> table:
                    owner: sview = preserves_owners[index]
                    root: sview = preserves_roots[index]
                    field: sview = preserves_fields[index] if index < preserves_fields.count else sview("", 0, 0)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreservesChangesConflict, name: root, line: 0, expected: "", actual: field}) if preserves_owner_has_whole_change(file.enum_annotations, owner, root)
                    index <- index + 1
