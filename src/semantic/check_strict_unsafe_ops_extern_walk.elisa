# Stage1 semantic — raw extern call traversal over all executable expression shapes.

extend Semantic:
    private:
        # Flag a direct call to a raw extern (`c_puts(text)`) outside its Unsafe.RawExtern grant. A
        # METHOD/UFCS callee (`x.f()`) is not a bare extern name; only Ident callees match.
        def strict_extern_call_expression(expression: Ast::Expr, line: u32, extern_names: darray[sview]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        called: sview = ident_name_of(callee)
                        is_extern: bool = called != "" and (any e in extern_names where e == called)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: called, line: line, expected: "Unsafe.RawExtern", actual: "Unsafe"}) if is_extern and not strict_unsafe_grant_covers(active_grants, "Unsafe.RawExtern")
                        table <- strict_extern_call_expression(callee, line, extern_names, active_grants, table)
                        for argument in arguments |table| -> table:
                            table <- strict_extern_call_expression(argument, line, extern_names, active_grants, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- strict_extern_call_expression(left, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(right, line, extern_names, active_grants, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.RegionNew(operand, _, unary_line) | Expr.Paren(operand, unary_line):
                        table <- strict_extern_call_expression(operand, line, extern_names, active_grants, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- strict_extern_call_expression(argument, line, extern_names, active_grants, table)
                        for candidate in candidates |table|:
                            for capture in candidate.captures |table| -> table:
                                table <- strict_extern_call_expression(capture, line, extern_names, active_grants, table)
                    Expr.Field(object, field, field_line):
                        table <- strict_extern_call_expression(object, line, extern_names, active_grants, table)
                    Expr.Scope(base, name, scope_line):
                        if base is not Expr.Ident(_, _):
                            table <- strict_extern_call_expression(base, line, extern_names, active_grants, table)
                    Expr.Index(object, index, index_line):
                        table <- strict_extern_call_expression(object, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(index, line, extern_names, active_grants, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- strict_extern_call_expression(object, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(low, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(high, line, extern_names, active_grants, table)
                    Expr.IndexN(object, indices, index_line):
                        table <- strict_extern_call_expression(object, line, extern_names, active_grants, table)
                        for index in indices |table| -> table:
                            table <- strict_extern_call_expression(index, line, extern_names, active_grants, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- strict_extern_call_expression(element, line, extern_names, active_grants, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- strict_extern_call_expression(entry.key, line, extern_names, active_grants, table)
                            table <- strict_extern_call_expression(entry.value, line, extern_names, active_grants, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        for field in fields |table| -> table:
                            table <- strict_extern_call_expression(field.value, line, extern_names, active_grants, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        table <- strict_extern_call_expression(base, line, extern_names, active_grants, table)
                        for field in fields |table| -> table:
                            table <- strict_extern_call_expression(field.value, line, extern_names, active_grants, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- strict_extern_call_expression(condition, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(then_value, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(else_value, line, extern_names, active_grants, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- strict_extern_call_expression(scrutinee, line, extern_names, active_grants, table)
                        for arm in arms |table|:
                            table <- strict_extern_call_expression(arm.guard, line, extern_names, active_grants, table)
                            table <- strict_extern_call_walk(arm.body, extern_names, active_grants, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- strict_extern_call_expression(iterable, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(condition, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(body, line, extern_names, active_grants, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- strict_extern_call_expression(base, line, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(predicate, line, extern_names, active_grants, table)
                    Expr.GetElse(guarded, recovery, getelse_line):
                        table <- strict_extern_call_expression(guarded, line, extern_names, active_grants, table)
                        table <- strict_extern_call_walk(recovery, extern_names, active_grants, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- strict_extern_call_walk(statements, extern_names, active_grants, table)
                        table <- strict_extern_call_expression(value, line, extern_names, active_grants, table)
                    Expr.Lambda(parameters, body, lambda_line):
                        no_outer_grants: darray[sview] = []
                        table <- strict_extern_call_walk(body, extern_names, no_outer_grants, table)
                    _:
                        pass

        def strict_extern_call_walk(statements: darray[Ast::Stmt], extern_names: darray[sview]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- strict_extern_call_expression(expression, line.line, extern_names, active_grants, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- strict_extern_call_expression(value, line.line, extern_names, active_grants, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- strict_extern_call_expression(target, line.line, extern_names, active_grants, table)
                            table <- strict_extern_call_expression(value, line.line, extern_names, active_grants, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- strict_extern_call_expression(returned, line.line, extern_names, active_grants, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- strict_extern_call_expression(condition, line.line, extern_names, active_grants, table)
                            table <- strict_extern_call_walk(then_body, extern_names, active_grants, table)
                            table <- strict_extern_call_walk(else_body, extern_names, active_grants, table)
                        Stmt.While(condition, body, line):
                            table <- strict_extern_call_expression(condition, line.line, extern_names, active_grants, table)
                            table <- strict_extern_call_walk(body, extern_names, active_grants, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- strict_extern_call_expression(iterable, line.line, extern_names, active_grants, table)
                            table <- strict_extern_call_walk(body, extern_names, active_grants, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- strict_extern_call_expression(scrutinee, line.line, extern_names, active_grants, table)
                            for arm in arms |table, line, extern_names, active_grants|:
                                table <- strict_extern_call_expression(arm.guard, line.line, extern_names, active_grants, table)
                                table <- strict_extern_call_walk(arm.body, extern_names, active_grants, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            grant_here: mutable darray[sview] = []
                            grant_here.extend(active_grants)
                            grant_here.extend(clause) if kind == "can" or kind == "trusted"
                            table <- strict_extern_call_walk(body, extern_names, grant_here, table)
                        Stmt.Contract(kind, expression, line):
                            table <- strict_extern_call_expression(expression, line.line, extern_names, active_grants, table)
                        _:
                            pass

        # Every raw-extern call obligation. Signature effects satisfy only the matching
        # capability, just like lexical grant blocks.
        def strict_extern_call_decls(declarations: darray[Ast::Decl], extern_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            no_local_grants: darray[sview] = []
                            table <- strict_extern_call_walk(body, extern_names, no_local_grants, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- strict_extern_call_decls(module_body, extern_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- strict_extern_call_decls(scoped_body, extern_names, table)
                        _:
                            pass
