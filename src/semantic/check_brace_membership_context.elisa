# A brace set literal `{a, b, c}` (comma-separated, no `:`) is only valid on the right-hand side
# of `in` (`x in {a, b}`) or as the initializer of a set-typed binding (`s: set[T] = {..}`).
# Using one as a bare value — a `return {1,2,3}` when the return type is not a set, a non-set
# `x: T = {..}`, or a standalone expression statement — is rejected. SOUND subset: fires only when
# a SetLit is the DIRECT value of one of those positions and the declared/return type head (if
# any) is not `set` (an `x in {..}` set stays nested inside a Binary and is never the direct value).
extend Semantic:
    private:
        def bmc_type_is_set(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, line):
                        return ident_name_of(object) == "set"
                    Expr.IndexN(object_n, arguments_n, line_n):
                        return ident_name_of(object_n) == "set"
                    Expr.Ident(name, ident_line):
                        return name == "set"
                    Expr.Unary(operator, operand, unary_line):
                        return bmc_type_is_set(operand)
                    Expr.Paren(inner, paren_line):
                        return bmc_type_is_set(inner)
                    _:
                        return false

        def bmc_check_statements(statements: darray[Ast::Stmt], return_is_set: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                match returned:
                                    Expr.SetLit(elements, set_line):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BraceMembershipMisuse, name: "", line: line.line, expected: "", actual: ""}) if not return_is_set
                                    _:
                                        pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            match value:
                                Expr.SetLit(vd_elements, vd_line):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BraceMembershipMisuse, name: "", line: line.line, expected: "", actual: ""}) if not bmc_type_is_set(type_expression)
                                _:
                                    pass
                        Stmt.Expr(expression, line):
                            match expression:
                                Expr.SetLit(e_elements, e_line):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BraceMembershipMisuse, name: "", line: line.line, expected: "", actual: ""})
                                _:
                                    pass
                        Stmt.If(condition, then_body, else_body, line):
                            table <- bmc_check_statements(then_body, return_is_set, table)
                            table <- bmc_check_statements(else_body, return_is_set, table)
                        Stmt.While(condition, while_body, line):
                            table <- bmc_check_statements(while_body, return_is_set, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- bmc_check_statements(for_body, return_is_set, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- bmc_check_statements(body, return_is_set, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- bmc_check_statements(arm.body, return_is_set, table)
                        _:
                            pass

        def bmc_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            return_is_set: bool = bmc_type_is_set(return_type_expr) if return_type is return_type_expr else false
                            table <- bmc_check_statements(body, return_is_set, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- bmc_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- bmc_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_brace_membership_context(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- bmc_walk(file.top_decls, table)
