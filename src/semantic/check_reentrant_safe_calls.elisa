# `@reentrant_safe` transitivity (stage0 validateReentrantSafeExpr). Code inside a
# `@reentrant_safe` function may only call other `@reentrant_safe` functions — an interrupt
# path must be transitively reentrant. SOUND decidable subset: a call whose callee is a bare
# identifier naming a user-defined function that is NOT `@reentrant_safe` provably violates
# (builtins/externs/method calls are left to the fuller analysis as sound misses).
extend Semantic:
    private:
        def reentrant_name_exists(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # Names of every user function, and of those carrying `@reentrant_safe`.
        def collect_reentrant_sets(declarations: darray[Ast::Decl], all_funcs: mutable darray[sview]&, safe_funcs: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            all_funcs.push(function_name)
                            safe_funcs.push(function_name) if func_has_decorator(decorators, "reentrant_safe")
                        Decl.Module(module_name, module_body, module_line):
                            collect_reentrant_sets(module_body, all_funcs, safe_funcs)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_reentrant_sets(scoped_body, all_funcs, safe_funcs)
                        _:
                            pass

        def reentrant_check_expression(expression: Ast::Expr, all_funcs: darray[sview]&, safe_funcs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        offending: bool = callee_name != "" and reentrant_name_exists(all_funcs, callee_name) and not reentrant_name_exists(safe_funcs, callee_name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReentrantSafeCall, name: callee_name, line: call_line.line, expected: "", actual: ""}) if offending
                        for argument in arguments |table| -> table:
                            table <- reentrant_check_expression(argument, all_funcs, safe_funcs, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- reentrant_check_expression(left, all_funcs, safe_funcs, table)
                        table <- reentrant_check_expression(right, all_funcs, safe_funcs, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- reentrant_check_expression(operand, all_funcs, safe_funcs, table)
                    Expr.Paren(inner, paren_line):
                        table <- reentrant_check_expression(inner, all_funcs, safe_funcs, table)
                    _:
                        pass

        def reentrant_check_statements(statements: darray[Ast::Stmt], all_funcs: darray[sview]&, safe_funcs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- reentrant_check_expression(expression, all_funcs, safe_funcs, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- reentrant_check_expression(value, all_funcs, safe_funcs, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- reentrant_check_expression(value, all_funcs, safe_funcs, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- reentrant_check_expression(returned, all_funcs, safe_funcs, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- reentrant_check_expression(condition, all_funcs, safe_funcs, table)
                            table <- reentrant_check_statements(then_body, all_funcs, safe_funcs, table)
                            table <- reentrant_check_statements(else_body, all_funcs, safe_funcs, table)
                        Stmt.While(condition, while_body, line):
                            table <- reentrant_check_expression(condition, all_funcs, safe_funcs, table)
                            table <- reentrant_check_statements(while_body, all_funcs, safe_funcs, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- reentrant_check_statements(block_body, all_funcs, safe_funcs, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- reentrant_check_expression(iterable, all_funcs, safe_funcs, table)
                            table <- reentrant_check_statements(for_body, all_funcs, safe_funcs, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- reentrant_check_expression(scrutinee, all_funcs, safe_funcs, table)
                            for arm in arms |table| -> table:
                                table <- reentrant_check_statements(arm.body, all_funcs, safe_funcs, table)
                        _:
                            pass

        def reentrant_check_walk(declarations: darray[Ast::Decl], all_funcs: darray[sview]&, safe_funcs: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- reentrant_check_statements(body, all_funcs, safe_funcs, table) if func_has_decorator(decorators, "reentrant_safe")
                        Decl.Module(module_name, module_body, module_line):
                            table <- reentrant_check_walk(module_body, all_funcs, safe_funcs, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- reentrant_check_walk(scoped_body, all_funcs, safe_funcs, table)
                        _:
                            pass

        def check_reentrant_safe_calls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                all_funcs: mutable darray[sview] = []
                safe_funcs: mutable darray[sview] = []
                collect_reentrant_sets(declarations, all_funcs, safe_funcs)
                table <- reentrant_check_walk(declarations, all_funcs, safe_funcs, table)
