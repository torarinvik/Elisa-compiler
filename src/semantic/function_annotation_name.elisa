# Closed Stage0-compatible allowlists for ordinary and extern function annotations.
module FunctionAnnotationName:
    public:
        def is_function_annotation(name: sview) -> bool:
            ensure result == (
                when name:
                    "test" | "bench" | "property" | "differential" | "lockstep" | "fixture" | "skip" | "inline" | "fast_math" | "norecurse" | "hot" | "cold" | "callconv" | "guard_nonnull" | "guard_variant" | "internal" | "main_thread" | "init" | "async_entry" | "segment_agnostic" | "segment_establishing" | "segment_transition" | "reentrant_safe" | "deprecated" | "noalloc" | "inbounds" | "nolock" | "link_name" | "boundary_pointer_args" -> true
                    _ -> false
            )
            return when name:
                "test" | "bench" | "property" | "differential" | "lockstep" | "fixture" | "skip" | "inline" | "fast_math" | "norecurse" | "hot" | "cold" | "callconv" | "guard_nonnull" | "guard_variant" | "internal" | "main_thread" | "init" | "async_entry" | "segment_agnostic" | "segment_establishing" | "segment_transition" | "reentrant_safe" | "deprecated" | "noalloc" | "inbounds" | "nolock" | "link_name" | "boundary_pointer_args" -> true
                _ -> false

        def is_extern_function_annotation(name: sview) -> bool:
            ensure result == (
                when name:
                    "borrows_return" | "link_name" | "intrinsic" | "wasm_import_module" | "callconv" | "internal" | "blocking" | "nonblocking" | "segment_transition" | "reentrant_safe" | "deprecated" | "trusted" | "bounds" -> true
                    _ -> false
            )
            return when name:
                "borrows_return" | "link_name" | "intrinsic" | "wasm_import_module" | "callconv" | "internal" | "blocking" | "nonblocking" | "segment_transition" | "reentrant_safe" | "deprecated" | "trusted" | "bounds" -> true
                _ -> false
