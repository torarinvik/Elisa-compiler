# Interprocedural frame propagation. A function that declares `changes P.f` may only write those
# param fields — including THROUGH a call. When it calls `g(P)` and g declares `changes Q.h`, the
# caller may write `P.h`; if `h` is not in the caller's own `changes` set that is a violation
# ("may write P.h, which is outside the `changes` set of caller"). SOUND subset: fires only when
# BOTH caller and callee declare a `changes` clause, the argument is one of the caller's params,
# and the callee receives it in a `mutable T&` position (so it can write it). A callee with NO
# `changes` clause may write anything ("may write P" whole) but that broader case is left out here
# to keep over-fire near zero. Field registries: sentinel 3900000003 (owner=fn, name=field).
extend Semantic:
    private:
        def frame_interproc_changes_fields(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |out|:
                    out.push(annotation.name) if annotation.owner == function_name and annotation.line == 3900000003 and annotation.name != ""
                # A `fulfills SUBJECT is FrameLaw` (sentinel 3900000029) contributes the frame
                # law's own `changes` fields (sentinel 3900000028) — so `step` whose only
                # `changes` come from `fulfills s is MovesPlayerOnly` still has a KNOWN set.
                for fulfill in annotations |out, function_name, annotations|:
                    if fulfill.owner == function_name and fulfill.line == 3900000029 and fulfill.name != "":
                        for law_field in annotations |out, fulfill|:
                            out.push(law_field.name) if law_field.owner == fulfill.name and law_field.line == 3900000028 and law_field.name != ""

        def frame_interproc_field_present(fields: darray[sview]&, field: sview) -> bool:
            can Abort.Panic:
                return any present in fields where present == field

        def frame_interproc_param_present(params: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any parameter in params where parameter == name

        # Whether callee's positional parameter at `position` is a `mutable T&` borrow.
        def frame_interproc_param_mutable_ref(table: SymbolTable&, callee: sview, position: usize) -> bool:
            can Abort.Panic:
                seen: mutable usize = 0
                result: mutable bool = false
                index: mutable usize = 0
                while index < table.function_param_owner.count |seen, result, index|:
                    if table.function_param_owner[index] == callee:
                        result <- table.function_param_mutable_ref[index] if seen == position
                        seen <- seen + 1
                    index <- index + 1
                return result

        def frame_interproc_check_call(callee: sview, arguments: darray[Ast::Expr], caller_name: sview, caller_changes: darray[sview]&, caller_params: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callee_changes: mutable darray[sview] = []
                frame_interproc_changes_fields(annotations, callee, callee_changes)
                # A callee with a `changes` clause writes only those fields; one WITHOUT any is
                # unconstrained and may write the whole param.
                callee_declares_changes: bool = callee_changes.count > 0
                callee_is_known: bool = direct_function_count(table, callee) > 0
                return if not callee_is_known
                position: mutable usize = 0
                for argument in arguments |table, position| -> table:
                    root: sview = ident_name_of(argument)
                    if root != "" and frame_interproc_param_present(caller_params, root) and frame_interproc_param_mutable_ref(table, callee, position):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesOutsideChanges, name: root, line: 0, expected: caller_name, actual: "", expected_count: 1}) if not callee_declares_changes
                        for changed_field in callee_changes |table| -> table:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesOutsideChanges, name: root, line: 0, expected: caller_name, actual: changed_field, expected_count: 1}) if callee_declares_changes and not frame_interproc_field_present(caller_changes, changed_field)
                    position <- position + 1

        def frame_interproc_walk(statements: darray[Ast::Stmt], caller_name: sview, caller_changes: darray[sview]&, caller_params: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            if expression is Expr.Call(callee, arguments, argument_names, call_line):
                                if callee is Expr.Ident(callee_name, ident_line):
                                    table <- frame_interproc_check_call(callee_name, arguments, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- frame_interproc_walk(then_body, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk(else_body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- frame_interproc_walk(body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- frame_interproc_walk(body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- frame_interproc_walk(body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- frame_interproc_walk(arm.body, caller_name, caller_changes, caller_params, annotations, table)
                        _:
                            pass

        def check_frame_interproc_decls(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            caller_changes: mutable darray[sview] = []
                            frame_interproc_changes_fields(annotations, name, caller_changes)
                            if caller_changes.count > 0:
                                caller_params: darray[sview] = [parameter.name for parameter in params]
                                table <- frame_interproc_walk(body, name, caller_changes, caller_params, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_frame_interproc_decls(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_frame_interproc_decls(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_frame_interproc(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_frame_interproc_decls(file.top_decls, file.enum_annotations, table)
