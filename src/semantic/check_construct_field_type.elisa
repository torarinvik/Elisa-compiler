# Check for struct literal fields whose value can never inhabit the field's
# declared primitive type. E.g. `P{a: "hi"}` where `P.a: i64`.

extend Semantic:
    private:
        # Whether `struct_name` is a registered struct with a known field set
        # (at least one row in the struct field registry).
        def is_registered_struct(table: SymbolTable&, struct_name: sview) -> bool:
            can Abort.Panic:
                while field_row_index < table.struct_field_owner.count |field_row_index: usize = 0|:
                    true return if table.struct_field_owner[field_row_index] == struct_name
                    field_row_index <- field_row_index + 1
                return false

        # Whether `type_name` is a bare primitive (int/float/string/bool/char).
        def is_bare_primitive_type(type_name: sview) -> bool:
            can Abort.Panic:
                return is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name) or type_name == "bool" or type_name == "char"

        # Check one labeled field of a struct literal against its declared type.
        def check_construct_field(struct_name: sview, field: Ast::FieldInit, line: u32, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if field.name == ""
                field_type: sview = field_type_of(table, struct_name, field.name)
                return if field_type == ""
                return if not is_bare_primitive_type(field_type)
                # A literal value is checked against the field type's fixed range; a firm
                # (non-literal) value against its family. The two are mutually exclusive on
                # `literal_kind`; infer_family is pure, so compute it unconditionally.
                literal_kind: sview = literal_kind_of(field.value)
                value_family: sview = infer_family(field.value, var_types, type_names, table)
                # A `null` field value. null has no literal kind and no inferred family, so
                # both walls below stayed silent on `P{x: null}`, which stage0 rejects.
                # No optional test needed: the `is_bare_primitive_type` gate above already
                # excludes an optional field — `field_type_of` keeps the `?` (verified: an
                # `i64?` field is silent even for a plainly-wrong value).
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, line: line, expected: field_type, actual: "null"}) if expression_is_null(field.value)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, line: line, expected: field_type, actual: stage0_literal_spelling(literal_kind)}) if literal_kind != "" and literal_never_fits(literal_kind, field_type)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, line: line, expected: field_type, actual: value_family}) if literal_kind == "" and value_family != "" and firm_never_fits(value_family, field_type)

        # Walk through expressions, checking struct-literal field types.
        def walk_expression_for_construct_field_type(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_construct_field_type(left, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_construct_field_type(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_construct_field_type(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_construct_field_type(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_construct_field_type(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_construct_field_type(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_construct_field_type(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_construct_field_type(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(low, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_construct_field_type(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_construct_field_type(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_construct_field_type(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_construct_field_type(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_construct_field_type(type_expression, table, var_types, type_names)
                        struct_name: mutable sview = ""
                        struct_name <- ident_name if type_expression is Expr.Ident(ident_name, ident_line)
                        registered: bool = struct_name != "" and is_registered_struct(table, struct_name)
                        for field in fields |table|:
                            table <- check_construct_field(struct_name, field, line.line, table, var_types, type_names) if registered
                            table <- walk_expression_for_construct_field_type(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_construct_field_type(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_construct_field_type(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_construct_field_type(iterable, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_construct_field_type(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_construct_field_type(statements, table, var_types, type_names)
                        table <- walk_expression_for_construct_field_type(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_construct_field_type(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_construct_field_type(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking struct-literal fields.
        def walk_statements_for_construct_field_type(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_construct_field_type(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_construct_field_type(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_construct_field_type(target, table, var_types, type_names)
                            table <- walk_expression_for_construct_field_type(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names)
                            table <- walk_statements_for_construct_field_type(then_body, table, var_types, type_names)
                            table <- walk_statements_for_construct_field_type(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names)
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_construct_field_type(iterable, table, var_types, type_names)
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_construct_field_type(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_construct_field_type(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_construct_field_type(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_construct_field_type(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_construct_field_type(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_construct_field_type_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_construct_field_type_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_construct_field_type_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_construct_field_type(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_construct_field_type_declarations(declarations, table)
