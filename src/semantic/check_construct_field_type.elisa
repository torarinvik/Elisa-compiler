# Check for struct literal fields whose value can never inhabit the field's
# declared primitive type. E.g. `P{a: "hi"}` where `P.a: i64`.

extend Semantic:
    private:
        # Whether `struct_name` is a registered struct with a known field set
        # (at least one row in the struct field registry).
        def is_registered_struct(table: SymbolTable&, struct_name: sview) -> bool:
            can Abort.Panic:
                while field_row_index < table.struct_field_owner.count |field_row_index: usize = 0|:
                    true return if table.struct_field_owner[field_row_index] == struct_name
                    field_row_index <- field_row_index + 1
                return false

        # Whether `type_name` is a bare primitive (int/float/string/bool/char).
        def is_bare_primitive_type(type_name: sview) -> bool:
            can Abort.Panic:
                return is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name) or type_name == "bool" or type_name == "char"

        def construct_local_type_id_of(names: darray[sview]&, type_ids: darray[u32]&, name: sview) -> u32:
            can Abort.Panic:
                available: usize = names.count if names.count < type_ids.count else type_ids.count
                while probe > 0 |probe: usize = available|:
                    probe <- probe - 1
                    type_ids[probe] return if names[probe] == name
                return 0

        def construct_type_id_is_nullable_ref(type_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return interned_kind(type_id, table) == SemTypeKind.Optional and interned_elem_count(type_id, table) == 1 and interned_kind(interned_elem(type_id, 0, table), table) == SemTypeKind.Ref


        def construct_value_is_raw_reference(value: Ast::Expr, names: darray[sview]&, type_names: darray[sview]&, type_ids: darray[u32]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match value:
                    Expr.StringLit(_, _):
                        return false
                    Expr.Unary(operator, operand, _):
                        return true if operator == TokenKind.Ampersand
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return construct_value_is_raw_reference(inner, names, type_names, type_ids, table)
                    Expr.Ident(name, _):
                        local_id: u32 = construct_local_type_id_of(names, type_ids, name)
                        local_kind: SemTypeKind = interned_kind(local_id, table)
                        true return if local_kind == SemTypeKind.Ref
                        return construct_type_id_is_nullable_ref(local_id, table)
                    _:
                        pass
                value_id: u32 = structural_type_id_of(value, names, type_names, table)
                true return if interned_kind(value_id, table) == SemTypeKind.Ref
                return construct_type_id_is_nullable_ref(value_id, table)

        # A non-null reference field must not receive an optional ref through a
        # conditional, field/index projection, or view-producing call.
        def construct_value_may_be_nullable_ref(value: Ast::Expr, names: darray[sview]&, type_names: darray[sview]&, type_ids: darray[u32]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, line): return construct_type_id_is_nullable_ref(construct_local_type_id_of(names, type_ids, name), table)
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        return construct_value_may_be_nullable_ref(inner, names, type_names, type_ids, table)
                    Expr.Call(_, _, _, _):
                        return construct_type_id_is_nullable_ref(structural_type_id_of(value, names, type_names, table), table)
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                        return construct_type_id_is_nullable_ref(structural_type_id_of(value, names, type_names, table), table)
                    Expr.If(condition, then_value, else_value, line):
                        return construct_value_may_be_nullable_ref(then_value, names, type_names, type_ids, table) or construct_value_may_be_nullable_ref(else_value, names, type_names, type_ids, table)
                    Expr.Block(statements, block_value, captures, line):
                        return construct_value_may_be_nullable_ref(block_value, names, type_names, type_ids, table)
                    Expr.Match(scrutinee, arms, line):
                        for arm in arms:
                            continue if arm.body.count == 0
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    return true if construct_value_may_be_nullable_ref(arm_value, names, type_names, type_ids, table)
                                _:
                                    pass
                        return false
                    _:
                        return false

        def construct_value_may_be_null(value: Ast::Expr, names: darray[sview]&, type_names: darray[sview]&, type_ids: darray[u32]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if expression_is_null(value)
                return match value:
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        construct_value_may_be_null(inner, names, type_names, type_ids, table)
                    Expr.If(condition, then_value, else_value, line):
                        construct_value_may_be_null(then_value, names, type_names, type_ids, table) or construct_value_may_be_null(else_value, names, type_names, type_ids, table)
                    Expr.Block(statements, block_value, captures, line):
                        construct_value_may_be_null(block_value, names, type_names, type_ids, table)
                    Expr.Match(scrutinee, arms, line):
                        for arm in arms:
                            continue if arm.body.count == 0
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    return true if construct_value_may_be_null(arm_value, names, type_names, type_ids, table)
                                _:
                                    pass
                        false
                    _:
                        false

        # The value type represented by an annotation, removing reference wrappers. A call
        # may pass a darray place by reference even though its value type is the darray itself.
        def darray_referent_type_id(type_id: u32, table: SymbolTable&) -> u32:
            can Abort.Panic:
                normalized: mutable u32 = type_id
                while interned_kind(normalized, table) == SemTypeKind.Ref and interned_elem_count(normalized, table) == 1 |normalized, table|:
                    normalized <- interned_elem(normalized, 0, table)
                return normalized


        # Two darray types whose elements are different known scalar/string types (for
        # example, `darray[u8]` and `darray[sview]`). A darray is a buffer handle, so letting
        # one flow into the other aliases a buffer under a different element layout. Peel
        # refs on both sides: `darray[T]&` parameters still have value type `darray[T]`.
        # Unknown, aggregate, and generic elements remain conservative until their full type
        # substitution is available; scalar-to-scalar value conversions are unaffected.
        def darray_element_conflict(expected_id: u32, actual_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                expected_value: u32 = darray_referent_type_id(expected_id, table)
                actual_value: u32 = darray_referent_type_id(actual_id, table)
                false return if interned_kind(expected_value, table) != SemTypeKind.Container or interned_kind(actual_value, table) != SemTypeKind.Container
                false return if interned_name(expected_value, table) != "darray" or interned_name(actual_value, table) != "darray"
                false return if interned_elem_count(expected_value, table) != 1 or interned_elem_count(actual_value, table) != 1
                expected_elem: u32 = interned_elem(expected_value, 0, table)
                actual_elem: u32 = interned_elem(actual_value, 0, table)
                false return if expected_elem == actual_elem
                expected_kind: SemTypeKind = interned_kind(expected_elem, table)
                actual_kind: SemTypeKind = interned_kind(actual_elem, table)
                expected_scalar: bool = expected_kind == SemTypeKind.Int or expected_kind == SemTypeKind.Float or expected_kind == SemTypeKind.Bool or expected_kind == SemTypeKind.Char or expected_kind == SemTypeKind.String
                actual_scalar: bool = actual_kind == SemTypeKind.Int or actual_kind == SemTypeKind.Float or actual_kind == SemTypeKind.Bool or actual_kind == SemTypeKind.Char or actual_kind == SemTypeKind.String
                false return if not expected_scalar or not actual_scalar
                return diagnostic_name_of_row(expected_elem, table) != diagnostic_name_of_row(actual_elem, table)

        # A diagnostic's text must not be a temporary buffer: spell `darray[elem]` from a
        # static table of the scalar/string element names darray_element_conflict admits.
        def darray_type_spelling(type_id: u32, table: SymbolTable&) -> sview:
            can Abort.Panic:
                container_id: u32 = darray_referent_type_id(type_id, table)
                element_id: u32 = interned_elem(container_id, 0, table)
                element: sview = diagnostic_name_of_row(element_id, table)
                elements: darray[sview] = ["u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "usize", "isize", "uintptr", "f32", "f64", "bool", "char", "cstr", "sview", "darray[u8]"]
                spellings: darray[sview] = ["darray[u8]", "darray[u16]", "darray[u32]", "darray[u64]", "darray[i8]", "darray[i16]", "darray[i32]", "darray[i64]", "darray[usize]", "darray[isize]", "darray[uintptr]", "darray[f32]", "darray[f64]", "darray[bool]", "darray[char]", "darray[cstr]", "darray[sview]", "darray[darray[u8]]"]
                for index in 0..<elements.count:
                    spellings[index] return if elements[index] == element
                return "darray"

        # Resolve a direct function call to one canonical declaration. Bare names are scoped
        # to the current module; qualified names must match a declared module path exactly.
        # Anything ambiguous, aliased-but-unresolved, or non-function remains unknown.
        def darray_call_declaration_id(callee: Ast::Expr, bound_names: darray[sview]&, table: SymbolTable&) -> DeclId:
            can Memory.Allocate, Abort.Panic:
                function_name: mutable sview = ""
                module_name: mutable sview = ""
                qualified_names: mutable darray[sview] = []
                qualified: mutable bool = false
                match callee:
                    Expr.Ident(name, _):
                        return DeclId{value: SYMBOL_INDEX_ROW_NONE} if any bound_name in bound_names where bound_name == name
                        return DeclId{value: SYMBOL_INDEX_ROW_NONE} if any imported_name in table.imported_members where imported_name == name
                        imported_member_row: mutable u32 = member_chain_head(table, name)
                        while imported_member_row != SYMBOL_INDEX_ROW_NONE |imported_member_row, table, name|:
                            member_index: usize = imported_member_row.usize()
                            if table.module_member_name[member_index] == name and (any imported_module in table.imported_modules where imported_module == table.module_member_owner[member_index]):
                                return DeclId{value: SYMBOL_INDEX_ROW_NONE}
                            imported_member_row <- table.member_name_next[member_index]
                        function_name <- name
                        module_name <- table.current_module
                    Expr.Scope(scope_base, name, _):
                        dotted: mutable darray[bool] = []
                        return DeclId{value: SYMBOL_INDEX_ROW_NONE} if not type_path_collect(scope_base, qualified_names, dotted)
                        return DeclId{value: SYMBOL_INDEX_ROW_NONE} if qualified_names.count == 0 or (any separator_is_dot in dotted where separator_is_dot)
                        return DeclId{value: SYMBOL_INDEX_ROW_NONE} if any bound_name in bound_names where bound_name == qualified_names[0]
                        qualified <- true
                        function_name <- name
                    _:
                        return DeclId{value: SYMBOL_INDEX_ROW_NONE}

                found: mutable DeclId = DeclId{value: SYMBOL_INDEX_ROW_NONE}
                candidate_count: mutable usize = 0
                function_row: mutable u32 = symbol_chain_head(table, function_name)
                while function_row != SYMBOL_INDEX_ROW_NONE |found, candidate_count, function_row, table, function_name, module_name, qualified_names, qualified|:
                    symbol: Symbol& = &table.symbols[function_row.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == function_name:
                        owner_matches: bool = module_symbol_matches(symbol.module_owner, "", qualified_names, 0, qualified_names.count) or (table.current_module != "" and module_symbol_matches_relative(symbol.module_owner, table.current_module, qualified_names, qualified_names.count)) if qualified else symbol.module_owner == module_name
                        if owner_matches:
                            found <- symbol.id
                            candidate_count <- candidate_count + 1
                    function_row <- table.symbol_name_next[function_row.usize()]
                return DeclId{value: SYMBOL_INDEX_ROW_NONE} if candidate_count != 1
                return found

        # Resolve a formal index within this exact function declaration. The declaration ID
        # prevents signatures in other modules with the same bare name from contaminating the
        # lookup; -1 means the argument label is not a formal of this declaration.
        def darray_param_index_for_call(table: SymbolTable&, function_name: sview, declaration_id: DeclId, parameter_name: sview) -> int:
            can Abort.Panic:
                seen: mutable usize = 0
                cur: mutable u32 = function_param_chain_head(table, function_name)
                while cur != SYMBOL_INDEX_ROW_NONE:
                    if table.function_param_owner[cur.usize()] == function_name and cur.usize() < table.function_param_declaration_id.count and table.function_param_declaration_id[cur.usize()].value == declaration_id.value:
                        return seen.int() if table.function_param_name[cur.usize()] == parameter_name
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return -1

        # The declared TypeId at a formal index of this exact function declaration.
        def darray_param_type_id_at(table: SymbolTable&, function_name: sview, declaration_id: DeclId, position: usize) -> u32:
            can Abort.Panic:
                seen: mutable usize = 0
                cur: mutable u32 = function_param_chain_head(table, function_name)
                while cur != SYMBOL_INDEX_ROW_NONE:
                    if table.function_param_owner[cur.usize()] == function_name and cur.usize() < table.function_param_declaration_id.count and table.function_param_declaration_id[cur.usize()].value == declaration_id.value:
                        if seen == position:
                            type_id: u32 = table.function_param_type_id[cur.usize()] if cur.usize() < table.function_param_type_id.count else 0
                            return darray_referent_type_id(type_id, table)
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return 0

        # A direct darray argument may not flow to a formal with a different known scalar or
        # string element type. Resolve the declaration first, then map each actual argument to
        # its formal using the source argument label or the next positional slot.
        def check_darray_call_arguments(callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview], table: lmut SymbolTable, var_types: darray[sview]&, var_type_ids: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                declaration_id: DeclId = darray_call_declaration_id(callee, var_types, table)
                return if declaration_id.value == SYMBOL_INDEX_ROW_NONE
                return if declaration_id.value.usize() >= table.symbols.count
                function_name: sview = table.symbols[declaration_id.value.usize()].name
                function_arity_max: u32 = table.symbols[declaration_id.value.usize()].arity_max
                positional_index: mutable usize = 0
                seen_named: mutable bool = false
                formal_count: mutable usize = function_arity_max.usize()
                if function_arity_max == SYMBOL_INDEX_ROW_NONE:
                    formal_count <- 0
                    formal_row: mutable u32 = function_param_chain_head(table, function_name)
                    while formal_row != SYMBOL_INDEX_ROW_NONE |formal_count, formal_row, table, function_name, declaration_id|:
                        row: usize = formal_row.usize()
                        formal_count <- formal_count + 1 if table.function_param_owner[row] == function_name and row < table.function_param_declaration_id.count and table.function_param_declaration_id[row].value == declaration_id.value
                        formal_row <- table.function_param_name_next[row]
                filled: mutable darray[bool] = []
                while filled.count < formal_count |filled, formal_count|:
                    filled <- filled.push(false)
                for index in 0..<arguments.count |table, positional_index, seen_named, function_name, declaration_id, argument_names, filled|:
                    parameter_name: sview = argument_names[index] if index < argument_names.count else ""
                    parameter_index: mutable int = 0
                    if parameter_name != "":
                        seen_named <- true
                        parameter_index <- darray_param_index_for_call(table, function_name, declaration_id, parameter_name)
                        return if parameter_index < 0
                    else:
                        return if seen_named
                        parameter_index <- positional_index.int()
                        positional_index <- positional_index + 1
                    return if parameter_index.usize() >= filled.count or filled[parameter_index.usize()]
                    filled[parameter_index.usize()] <- true
                    actual_id: u32 = construct_ident_type_id(arguments[index], var_types, var_type_ids)
                    if actual_id != 0:
                        expected_id: u32 = darray_param_type_id_at(table, function_name, declaration_id, parameter_index.usize())
                        if expected_id != 0:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: function_name, pos: Ast::expr_pos(arguments[index]), line: Ast::expr_pos(arguments[index]).line, expected: darray_type_spelling(expected_id, table), actual: darray_type_spelling(actual_id, table), expected_count: (index + 1).u32()}) if darray_element_conflict(expected_id, actual_id, table)

        # The annotated TypeId of a bare local `name` (innermost wins), 0 when unknown or
        # when the name and id channels are not in step.
        def construct_ident_type_id(value: Ast::Expr, names: darray[sview]&, type_ids: darray[u32]&) -> u32:
            can Abort.Panic:
                0 return if names.count != type_ids.count
                match value:
                    Expr.Ident(name, _):
                        found: mutable u32 = 0
                        for index in 0..<names.count |found, names, type_ids, name|:
                            found <- type_ids[index] if names[index] == name
                        return found
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return construct_ident_type_id(inner, names, type_ids)
                    _:
                        return 0

        # Check one labeled field of a struct literal against its declared type.
        def check_construct_field(struct_name: sview, field: Ast::FieldInit, line: u32, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, var_type_ids: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if field.name == ""
                field_type: sview = field_type_of(table, struct_name, field.name)
                field_type_id: u32 = field_type_id_of(table, struct_name, field.name)
                nonnull_ref_field: bool = interned_kind(field_type_id, table) == SemTypeKind.Ref
                nullable_ref_value: bool = construct_value_may_be_nullable_ref(field.value, var_types, type_names, var_type_ids, table)
                null_value: bool = construct_value_may_be_null(field.value, var_types, type_names, var_type_ids, table)
                if nonnull_ref_field and (null_value or nullable_ref_value):
                    actual_ref: sview = "null" if null_value else "nullable reference"
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: "non-null reference", actual: actual_ref})
                string_payload: u32 = string_payload_type_id(field_type_id, table)
                raw_reference_value: bool = construct_value_is_raw_reference(field.value, var_types, type_names, var_type_ids, table)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: diagnostic_name_of_row(string_payload, table), actual: "reference"}) if interned_kind(field_type_id, table) == SemTypeKind.Optional and string_payload != 0 and raw_reference_value
                value_type_id: u32 = construct_ident_type_id(field.value, var_types, var_type_ids)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: darray_type_spelling(field_type_id, table), actual: darray_type_spelling(value_type_id, table)}) if darray_element_conflict(field_type_id, value_type_id, table)
                field_enum: sview = enum_value_never_fits(field.value, field_type, var_types, type_names, table) if field_type != "" else ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: field_type, actual: field_enum}) if field_enum != ""
                return if field_type == "" or not is_bare_primitive_type(field_type)
                # A literal value is checked against the field type's fixed range; a firm
                # (non-literal) value against its family. The two are mutually exclusive on
                # `literal_kind`; infer_family is pure, so compute it unconditionally.
                literal_kind: sview = literal_kind_of(field.value)
                value_family: sview = infer_family(field.value, var_types, type_names, table)
                # A `null` field value. null has no literal kind and no inferred family, so
                # both walls below stayed silent on `P{x: null}`, which stage0 rejects.
                # No optional test needed: the `is_bare_primitive_type` gate above already
                # excludes an optional field — `field_type_of` keeps the `?` (verified: an
                # `i64?` field is silent even for a plainly-wrong value).
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: field_type, actual: "null"}) if expression_is_null(field.value)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: field_type, actual: stage0_literal_spelling(literal_kind)}) if literal_kind != "" and literal_never_fits(literal_kind, field_type)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: field_type, actual: value_family}) if literal_kind == "" and value_family != "" and firm_never_fits(value_family, field_type)
                # S1g: a firm cstr/sview/dstr into a field of another string representation.
                field_value_type: InferType = infer_expression_type(field.value, var_types, type_names, table) if literal_kind == "" else primitive_type(SemTypeKind.Unknown)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: field_type, actual: "reference"}) if raw_reference_value and is_string_type_name(field_type)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: line, expected: diagnostic_type_spelling(field_type), actual: stage0_index_spelling(field_value_type)}) if string_member_never_fits(field_value_type, field_type)

        # Walk through expressions, checking struct-literal field types.
        def walk_expression_for_construct_field_type(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, var_type_ids: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_construct_field_type(left, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(right, table, var_types, type_names, var_type_ids) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_darray_call_arguments(callee, arguments, argument_names, table, var_types, var_type_ids)
                        table <- walk_expression_for_construct_field_type(callee, table, var_types, type_names, var_type_ids)
                        for argument in arguments |table|:
                            table <- walk_expression_for_construct_field_type(argument, table, var_types, type_names, var_type_ids)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names, var_type_ids)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_construct_field_type(base, table, var_types, type_names, var_type_ids)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(index, table, var_types, type_names, var_type_ids) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_construct_field_type(operand, table, var_types, type_names, var_type_ids)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_construct_field_type(inner, table, var_types, type_names, var_type_ids)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_construct_field_type(element, table, var_types, type_names, var_type_ids)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_construct_field_type(element, table, var_types, type_names, var_type_ids)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(low, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(high, table, var_types, type_names, var_type_ids)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_construct_field_type(object, table, var_types, type_names, var_type_ids)
                        for argument in arguments |table|:
                            table <- walk_expression_for_construct_field_type(argument, table, var_types, type_names, var_type_ids) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_construct_field_type(element, table, var_types, type_names, var_type_ids)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_construct_field_type(entry.key, table, var_types, type_names, var_type_ids)
                            table <- walk_expression_for_construct_field_type(entry.value, table, var_types, type_names, var_type_ids)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_construct_field_type(type_expression, table, var_types, type_names, var_type_ids)
                        struct_name: mutable sview = ""
                        match type_expression:
                            Expr.Ident(ident_name, _):
                                struct_name <- ident_name
                            _:
                                pass
                        registered: bool = struct_name != "" and is_registered_struct(table, struct_name)
                        for field in fields |table|:
                            table <- check_construct_field(struct_name, field, line.line, table, var_types, type_names, var_type_ids) if registered
                            table <- walk_expression_for_construct_field_type(field.value, table, var_types, type_names, var_type_ids)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_construct_field_type(base, table, var_types, type_names, var_type_ids)
                        for field in fields |table|:
                            table <- walk_expression_for_construct_field_type(field.value, table, var_types, type_names, var_type_ids)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(then_expr, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(else_expr, table, var_types, type_names, var_type_ids)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_construct_field_type(iterable, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(body, table, var_types, type_names, var_type_ids)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_construct_field_type(body, table, var_types, type_names, var_type_ids)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_construct_field_type(statements, table, var_types, type_names, var_type_ids)
                        table <- walk_expression_for_construct_field_type(value, table, var_types, type_names, var_type_ids)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_construct_field_type(scrutinee, table, var_types, type_names, var_type_ids)
                        for arm in arms |table|:
                            table <- walk_statements_for_construct_field_type(arm.body, table, var_types, type_names, var_type_ids)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking struct-literal fields.
        def walk_statements_for_construct_field_type(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, var_type_ids: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_construct_field_type(expression, table, var_types, type_names, var_type_ids)
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            declared_type_id: u32 = annotation_type_id(type_expression, table)
                            initializer_type_id: u32 = construct_ident_type_id(value, var_types, var_type_ids)
                            note_local_type(var_types, type_names, name, type_name)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: name, pos: Ast::expr_pos(value), line: line.line, expected: "darray", detail: diagnostic_name_of_row(interned_elem(darray_referent_type_id(declared_type_id, table), 0, table), table), actual: darray_type_spelling(initializer_type_id, table)}) if darray_element_conflict(declared_type_id, initializer_type_id, table)
                            var_type_ids.push(declared_type_id)
                            table <- walk_expression_for_construct_field_type(value, table, var_types, type_names, var_type_ids)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_construct_field_type(target, table, var_types, type_names, var_type_ids)
                            table <- walk_expression_for_construct_field_type(value, table, var_types, type_names, var_type_ids)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names, var_type_ids)
                            table <- walk_statements_for_construct_field_type(then_body, table, var_types, type_names, var_type_ids)
                            table <- walk_statements_for_construct_field_type(else_body, table, var_types, type_names, var_type_ids)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_construct_field_type(condition, table, var_types, type_names, var_type_ids)
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names, var_type_ids)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_construct_field_type(iterable, table, var_types, type_names, var_type_ids)
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names, var_type_ids)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names, var_type_ids)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_construct_field_type(scrutinee, table, var_types, type_names, var_type_ids)
                            for arm in arms |table|:
                                table <- walk_expression_for_construct_field_type(arm.guard, table, var_types, type_names, var_type_ids)
                                table <- walk_statements_for_construct_field_type(arm.body, table, var_types, type_names, var_type_ids)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_construct_field_type(return_value, table, var_types, type_names, var_type_ids) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_construct_field_type(expression, table, var_types, type_names, var_type_ids)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_construct_field_type_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            var_type_ids: mutable darray[u32] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                                var_type_ids.push(annotation_type_id(param.type_expression, table))
                            table <- walk_statements_for_construct_field_type(body, table, var_types, type_names, var_type_ids)
                        Decl.Module(module_name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- check_construct_field_type_declarations(body, table)
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- check_construct_field_type_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_construct_field_type(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_construct_field_type_declarations(declarations, table)
