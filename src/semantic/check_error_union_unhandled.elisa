# An error-union call result silently dropped. A call to a function that returns `T error[E]`
# whose result is discarded — as a bare statement `f()` or an explicit `_ = f()` — swallows the
# error; stage0 requires it be handled with `try`/`match`/`catch` (or propagated with `return`).
# A result bound to a real local (`x = f()`) or wrapped in `try`/`match` is fine. The callee's
# error-returning-ness comes from the `__error_return` side-table annotation (owner = fn name).
extend Semantic:
    private:
        # If EXPRESSION (through a paren) is a direct call to an error-union-returning function,
        # its callee name, else "".
        def error_call_name(expression: Ast::Expr, fallible_callables: NameSet&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview @source = ident_name_of(callee)
                        if callee_name != "" and name_set_contains(fallible_callables, callee_name):
                            return callee_name
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return error_call_name(inner, fallible_callables)
                    _:
                        return sview("", 0, 0)

        # A `try EXPR` (without-else) at LINE records a `__try_without_else` annotation there; its
        # `try` head is dropped so the statement is a bare `Stmt.Expr(Call)`. The marker lets us tell
        # a handled `try f()` from an unhandled bare `f()`.
        def line_is_try_wrapped(try_lines: dict[u64, u8]&, line: u32) -> bool:
            can Abort.Panic:
                return true if try_lines.get(line.u64()) is marker
                return false

        def error_union_unhandled_statements(statements: darray[Ast::Stmt], fallible_callables: NameSet&, try_lines: dict[u64, u8]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            bare_name: sview @source = error_call_name(expression, fallible_callables) if not line_is_try_wrapped(try_lines, line.line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: bare_name, line: line.line, expected: "", actual: "bare"}) if bare_name != ""
                        Stmt.Assign(target, operator, value, line):
                            discard_name: sview @source = error_call_name(value, fallible_callables) if ident_name_of(target) == "_" and not line_is_try_wrapped(try_lines, line.line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: discard_name, line: line.line, expected: "", actual: "discard"}) if discard_name != ""
                        Stmt.VarDecl(name, type_expression, value, line):
                            decl_discard: sview @source = error_call_name(value, fallible_callables) if name == "_" and not line_is_try_wrapped(try_lines, line.line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: decl_discard, line: line.line, expected: "", actual: "discard"}) if decl_discard != ""
                        Stmt.If(condition, then_body, else_body, line):
                            table <- error_union_unhandled_statements(then_body, fallible_callables, try_lines, table)
                            table <- error_union_unhandled_statements(else_body, fallible_callables, try_lines, table)
                        Stmt.While(condition, body, line):
                            table <- error_union_unhandled_statements(body, fallible_callables, try_lines, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- error_union_unhandled_statements(body, fallible_callables, try_lines, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- error_union_unhandled_statements(body, fallible_callables, try_lines, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- error_union_unhandled_statements(arm.body, fallible_callables, try_lines, table)
                        _:
                            pass

        def check_error_union_unhandled_decls(declarations: darray[Ast::Decl], fallible_callables: NameSet&, try_lines: dict[u64, u8]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- error_union_unhandled_statements(body, fallible_callables, try_lines, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_error_union_unhandled_decls(module_body, fallible_callables, try_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_error_union_unhandled_decls(scoped_body, fallible_callables, try_lines, table)
                        _:
                            pass

    public:
        def check_error_union_unhandled(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # This call path ultimately accepts any exact-name __error_return marker;
                # a name set preserves that result without a marker scan per discarded call.
                fallible_callables: mutable NameSet = empty_name_set()
                try_lines: mutable dict[u64, u8] = {}
                for annotation in file.enum_annotations |fallible_callables, try_lines|:
                    name_set_add(fallible_callables, annotation.owner) if annotation.name == "__error_return"
                    if annotation.name == "__try_without_else":
                        if try_lines.get(annotation.line.u64()) is existing_marker:
                            pass
                        else:
                            try_lines <- try_lines.put(annotation.line.u64(), 1) can Global{Read,Write}
                return if fallible_callables.names.count == 0
                table <- check_error_union_unhandled_decls(file.top_decls, fallible_callables, try_lines, table)
