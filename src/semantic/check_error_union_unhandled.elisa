# An error-union call result silently dropped. A call to a function that returns `T error[E]`
# whose result is discarded — as a bare statement `f()` or an explicit `_ = f()` — swallows the
# error; stage0 requires it be handled with `try`/`match`/`catch` (or propagated with `return`).
# A result bound to a real local (`x = f()`) or wrapped in `try`/`match` is fine. The callee's
# error-returning-ness comes from the `__error_return` side-table annotation (owner = fn name).
extend Semantic:
    private:
        # If EXPRESSION (through a paren) is a direct call to an error-union-returning function,
        # its callee name, else "".
        def error_call_name(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        return callee_name if callee_name != "" and callable_returns_error(annotations, callee_name) else sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return error_call_name(inner, annotations)
                    _:
                        return sview("", 0, 0)

        # A `try EXPR` (without-else) at LINE records a `__try_without_else` annotation there; its
        # `try` head is dropped so the statement is a bare `Stmt.Expr(Call)`. The marker lets us tell
        # a handled `try f()` from an unhandled bare `f()`.
        def line_is_try_wrapped(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__try_without_else" and annotation.line == line

        def error_union_unhandled_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            bare_name: sview = error_call_name(expression, annotations) if not line_is_try_wrapped(annotations, line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: bare_name, line: line, expected: "", actual: "bare"}) if bare_name != ""
                        Stmt.Assign(target, operator, value, line):
                            discard_name: sview = error_call_name(value, annotations) if ident_name_of(target) == "_" and not line_is_try_wrapped(annotations, line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: discard_name, line: line, expected: "", actual: "discard"}) if discard_name != ""
                        Stmt.VarDecl(name, type_expression, value, line):
                            decl_discard: sview = error_call_name(value, annotations) if name == "_" and not line_is_try_wrapped(annotations, line) else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ErrorUnionUnhandled, name: decl_discard, line: line, expected: "", actual: "discard"}) if decl_discard != ""
                        Stmt.If(condition, then_body, else_body, line):
                            table <- error_union_unhandled_statements(then_body, annotations, table)
                            table <- error_union_unhandled_statements(else_body, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- error_union_unhandled_statements(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- error_union_unhandled_statements(body, annotations, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- error_union_unhandled_statements(body, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- error_union_unhandled_statements(arm.body, annotations, table)
                        _:
                            pass

        def check_error_union_unhandled_decls(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- error_union_unhandled_statements(body, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_error_union_unhandled_decls(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_error_union_unhandled_decls(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_error_union_unhandled(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_error_union_unhandled_decls(file.top_decls, file.enum_annotations, table)
