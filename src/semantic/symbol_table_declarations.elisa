            symbols: mutable darray[Symbol]
            # Number of compiler-owned rows inserted before source symbol collection.
            # Keep the boundary explicit because source declarations may also have line 0.
            builtin_symbol_count: mutable usize = 0
            resolved_state_families: mutable darray[ResolvedStateFamily] = []
            # File.struct_copy_bases, copied in by the semantic entry (check_struct_copy_base).
            struct_copy_bases: mutable darray[Ast::StructCopyBase] = []
            state_family_declarations: mutable darray[Ast::StateFamily] = []
            state_transition_declarations: mutable darray[Ast::StateTransitionEdge] = []
            derived_state_declarations: mutable darray[Ast::DerivedStateRule] = []
            resolved_derived_state_rules: mutable darray[ResolvedDerivedStateRule] = []
            resolved_state_edges: mutable darray[ResolvedStateEdge] = []
            # Exact source positions of reserved graph-transition calls and the
            # subset admitted by semantic ownership/edge checks.
            protocol_transition_candidates: mutable darray[Ast::Pos] = []
            protocol_transition_admitted: mutable darray[Ast::Pos] = []
            binding_declared_types: mutable darray[BindingDeclaredType] = []
            # Per-target rule-R decision for bare `LArrow` reference assignments. The borrow
            # pass consumes this exact source-site fact to distinguish a pointee store from a
            # reference-slot rebind.
            ref_assignment_modes: mutable dict[u64, u32] = {}
            inline_pointer_grant_spans: mutable darray[Ast::Pos] = []
            storage_owned_candidates: mutable darray[StorageOwnedCandidate] = []
            # Name chains over storage_owned_candidates (ascending rows), built once the
            # candidate list is complete; used only while its count still matches.
            storage_owned_candidate_heads: mutable dict[u64, u32] = {}
            storage_owned_candidate_tails: mutable dict[u64, u32] = {}
            storage_owned_candidate_next: mutable darray[u32] = []
            storage_owned_candidates_indexed: mutable usize = 0
            storage_owned_candidates_index_built: mutable bool = false
            # ref_pos rows chained by start offset, for the storage pass's "is this callee
            # span a lexical reference" probes (one per owned call; each scanned all refs).
            storage_ref_pos_heads: mutable dict[u64, u32] = {}
            storage_ref_pos_next: mutable darray[u32] = []
            storage_ref_pos_indexed: mutable usize = 0
            storage_ref_pos_index_built: mutable bool = false
            # Innermost module of the function check_region_storage_stability is walking.
            storage_owned_module: mutable sview = ""
            # Last `:` segments of struct_field_owner / enum_variant_owner rows, hashed, for
            # check_region_storage_stability's "is NAME a declared struct/enum" probes (one per
            # darray element type), which scanned every owner row. Each index remembers the
            # owner count it was built from; a stale index is ignored (full scan).
            storage_struct_segments: mutable darray[sview @source] = []
            storage_struct_segment_next: mutable darray[u32] = []
            storage_struct_segment_heads: mutable dict[u64, u32] = {}
            storage_struct_segment_source_count: mutable usize = 0
            storage_struct_segments_built: mutable bool = false
            storage_enum_segments: mutable darray[sview @source] = []
            storage_enum_segment_next: mutable darray[u32] = []
            storage_enum_segment_heads: mutable dict[u64, u32] = {}
            storage_enum_segment_source_count: mutable usize = 0
            storage_enum_segments_built: mutable bool = false
            binding_moves: mutable darray[ResolvedBindingMove] = []
            ownership_occurrences: mutable darray[OwnershipOccurrence] = []
            ownership_function_flows: mutable darray[OwnershipFunctionFlow] = []
            ownership_exit_facts: mutable darray[OwnershipBindingFact] = []
            type_alias_declarations: mutable darray[TypeAliasDeclaration] = []
            # Exact value-identifier references whose resolver target is a unique file symbol.
            definition_references: mutable darray[DefinitionReference]
            # Source lines of catch-desugared Match statements (the scalar-match arm
            # check exempts them; their arms are error-set members, not scalars).
            catch_match_lines: mutable darray[u32]
            # Exact AST target positions of `new`-form constructions (the keyword is erased
            # at parse time; semantic consumers join the marker to the target node).
            new_construct_lines: mutable darray[u32]
            new_construct_offsets: mutable darray[u32] = []
            # Positions of calls carrying a `..` forward-args placeholder (exempt from the
            # missing-argument check — the unspecified params fill from the caller).
            forward_arg_lines: mutable darray[u32]
            forward_arg_offsets: mutable darray[u32]
            # Source lines of statement-position block `if`s (flow-strict targets).
            block_if_lines: mutable darray[u32]
            # Source offsets paired with block_if_lines so #line aliases cannot cross-tag
            # a ComplexFlow-exempt statement at the same logical line.
            block_if_offsets: mutable darray[u32] = []
            # Declared `region NAME(...)` names — legal in type position.
            region_names: mutable darray[sview @source]
            # Lexical region binders, in parser/source order. Region spellings are
            # deliberately not identities: nested scopes and separate functions may
            # bind the same spelling to different lifetimes.
            region_binding_names: mutable darray[sview @source] = []
            region_binding_lines: mutable darray[u32] = []
            region_binding_owner_offsets: mutable darray[u32] = []
            region_binding_end_lines: mutable darray[u32] = []
            region_binding_end_offsets: mutable darray[u32] = []
            region_binding_ids: mutable darray[u32] = []
            # Extra comma binders of a query expression (`each k, v in m` / `count a, b in …`).
            # The stored offsets are the raw `for` token positions; walkers normalize them
            # to the Comprehension's `query_scope_id` while retaining `pos` for diagnostics.
            query_binder_offsets: mutable darray[u32]
            query_binder_names: mutable darray[sview @source]
            # Explicit `mutable name:` / `const name:` local binding modes, keyed
            # by source name and line. These control slot rebinding independently
            # of `mutable` on the local's reference type (write-through capability).
            local_binding_names: mutable darray[sview @source] = []
            local_binding_lines: mutable darray[u32] = []
            local_binding_offsets: mutable darray[u32] = []
            local_binding_modes: mutable darray[i64] = []
            # Collision-safe exact-key projection for local binding mode rows. The row arrays
            # remain authoritative; each hash-chain candidate is checked against name/line/
            # offset before use.
            local_binding_exact_heads: mutable dict[u64, u32] = {}
            local_binding_exact_next: mutable darray[u32] = []
            # The same rows chained by (name, line) only: local_binding_explicit_mode's
            # offset-free fallback probes this instead of scanning every row.
            local_binding_line_heads: mutable dict[u64, u32] = {}
            local_binding_line_next: mutable darray[u32] = []
            # `node is Expr.Pair as pair` — the VARIANT-test alias, line-paired to the alias
            # token. Defaulted so the SymbolTable literal above needs no edit.
            # Owners of `struct S layout(soa)` — every field of one is a COLUMN (a darray of
            # the declared type), which is what stage0 lowers it to.
            soa_layout_owners: mutable darray[sview @source] = []
            # Lines carrying a `forall`/`exists` head (`__contract_quantifier`). A spec
            # pseudo-field such as `.indices` is legal as a quantifier DOMAIN and illegal
            # in a body; this is what tells the two apart without threading a flag.
            quantifier_lines: mutable darray[u32] = []
            # Lines of a `x.ref[T]` shorthand whose target REINTERPRETS (the `(&x).cast[T]`
            # wording, not `&x`). stage0 reports the removal AND the pointer cast there.
            ref_reinterpret_lines: mutable darray[u32] = []
            # Source extents for names that live in a bare `darray[sview]` AST field, keyed by
            # the OWNING statement's byte offset (see Ast::EnumAnnotation.pos).
            binder_pos_offsets: mutable darray[u32] = []
            binder_pos_values: mutable darray[Ast::Pos] = []
            is_variant_alias_lines: mutable darray[u32] = []
            is_variant_alias_offsets: mutable darray[u32] = []
            is_variant_alias_names: mutable darray[sview @source] = []
            # Number of declarations whose name duplicates an earlier one in the same
            # collection. Kept as a quick count; `diagnostics` carries the located findings.
            duplicates: mutable u32
            # Total statements across all function bodies (incl. nested blocks/arms). Walks the
            # per-node `darray[Stmt]` side-tables, matching each entry as a Stmt directly.
            statements: mutable u32
            # Located semantic findings accumulated during collection (duplicate decls) and
            # resolution (undefined names).
            diagnostics: mutable darray[Diagnostic]
            # O(1) membership index over `symbols` names, so resolution (called once per
            # referenced identifier) and duplicate detection avoid an O(n) scan of `symbols`
            # — the whole table was O(n^2) in a file's symbol count. Keyed by an FNV hash of
            # the name's bytes; `name_primary` holds one name per hash and `name_overflow`
            # the rare hash collisions. sview is not a valid dict/set key (no value-equality),
            # hence the hand-rolled hash index. `symbols` stays the source of truth for
            # iteration/metadata; these two mirror only its names.
            name_primary: mutable dict[u64, sview]
            name_overflow: mutable darray[sview @source]
            # Forward singly-linked hash chain over `symbols` ITSELF (as opposed to
            # name_primary/name_overflow above, which only answer "does this name exist" —
            # not "give me every Symbol row named X"). Same shape as function_param_name_
            # head/tail/next (see that field group's comment and index_function_param/
            # symbol_chain_head in symbols.elisa): turns "every declaration named NAME"
            # (direct_function_count, check_call_arity, the lmut-aliasing poison check,
            # forwarding_callee_is_variadic — all called once per direct-call expression)
            # from an O(symbols.count) scan of every declaration in the WHOLE PROGRAM into
            # an O(this name's own overload count) walk.
            symbol_name_head: mutable dict[u64, u32]
            symbol_name_tail: mutable dict[u64, u32]
            symbol_name_next: mutable darray[u32]
            # Resolver-side evidence that a NameLookup hit bypassed classification chains.
            incremental_name_lookup_chain_visits: mutable u64 = 0
            incremental_name_lookup_metrics_enabled: mutable bool = false
            # Independent bucket counts let indexed readers reject truncated chains.
            symbol_name_count: mutable dict[u64, u32] = {}
            # Set false only when a complete rebuild cannot represent the symbol rows.
            # Ordinary append-order mismatches are repaired from `symbols` during collection.
            symbol_name_index_valid: mutable bool = true
            symbol_name_indexed_rows: mutable usize = 0
            # The module_member_name analogue of the symbol chain above: every row of
            # module_member_name named X, reachable in O(X's own member count). Built for
            # name_known, whose per-identifier visibility count scanned EVERY module member
            # in the program (with an sview compare each) once per resolved name.
            member_name_head: mutable dict[u64, u32]
            member_name_tail: mutable dict[u64, u32]
            member_name_next: mutable darray[u32]
            module_member_owner: mutable darray[sview @source] = []
            module_member_name: mutable darray[sview @source] = []
            # Finalized resolver input index. Open-addressed slots contain row IDs into the
            # exact-spelling surface arrays below; collisions always compare complete sviews.
            resolver_name_surface: mutable ResolverNameSurfaceIndex = ResolverNameSurfaceIndex{}
            imported_modules: mutable darray[sview @source]
            # Members brought into unqualified scope by a `from Mod import a, b` selective
            # import (docs module-visibility). A module member is visible unqualified iff
            # its whole module is imported OR its own name appears here.
            imported_members: mutable darray[sview @source]
            # Import rows in static-if arms whose selector is unresolved stay separate from
            # definite visibility. The original annotations retain source identity for
            # conservative lookups and diagnostics.
            definite_import_annotations: mutable darray[Ast::EnumAnnotation] = []
            possible_import_annotations: mutable darray[Ast::EnumAnnotation] = []
            # Section-visibility and inactive-function rows of enum_annotations, set once per
            # affine flow (see affine_visibility_annotations) so call lookups scan only these.
            visibility_annotations: mutable darray[Ast::EnumAnnotation] = []
            # Wildcard-import, `__from_member` and `__from_src` rows of the errorset-wrapper
            # lookup annotations, set once per file (see ewr_import_scope_rows).
            ewr_import_rows: mutable darray[Ast::EnumAnnotation] = []
            # `__static_if_branch` rows of enum_annotations, filled once per file by the
            # pipeline; static_if_branch_source_count records the annotation count they came
            # from so a lookup against any other annotation list falls back to a full scan.
            static_if_branch_annotations: mutable darray[Ast::EnumAnnotation] = []
            static_if_branch_source_count: mutable usize = 0
            # name_hash of every `__error_return` owner in the error-union checker's annotation
            # list, and that list's length. A callee missing from it cannot be fallible.
            error_return_owner_hashes: mutable dict[u64, u8] = {}
            error_return_owner_source_count: mutable usize = 0
            # (line << 32 | offset) of each `__catch_match` protocol row, with the row count it
            # was built from, so a match statement that is not a catch skips the row scan.
            catch_match_keys: mutable dict[u64, u8] = {}
            catch_match_source_count: mutable usize = 0
            current_module: mutable sview @source
            # Enum variant registry (parallel arrays — sview can't key a dict):
            # entry i says enum `enum_variant_owner[i]` declares variant
            # `enum_variant_name[i]`. Scanned linearly (per-file scale).
            enum_variant_owner: mutable darray[sview @source]
            enum_variant_name: mutable darray[sview @source]
            # The (qualified) module that declared entry i's enum. Owners are registered BARE, so
            # `Other::Message` and `Outer::Right::Message` share rows; coverage narrows by this.
            enum_variant_module: mutable darray[sview @source] = []
            # enum_variant_owner rows chained per owner-name hash in ascending row order
            # (index_enum_variant_owner, one call per push), for bare_enum_module.
            enum_owner_heads: mutable dict[u64, u32] = {}
            enum_owner_tails: mutable dict[u64, u32] = {}
            enum_owner_next: mutable darray[u32] = []
            # Enum hierarchy: `enum Child is Parent` — parallel (child, parent) rows so the
            # match-exhaustiveness check can treat a parent root's coverage as the union of its
            # children's variants (docs/81 tree/enum-hierarchy).
            enum_hierarchy_child: mutable darray[sview @source]
            enum_hierarchy_parent: mutable darray[sview @source]
            # Declared payload field count of entry i's variant.
            enum_variant_arity: mutable darray[u32]
            # Enum variant payload field labels. Each entry records one payload field
            # in declaration order; empty names mark positional-only payload fields.
            enum_payload_owner: mutable darray[sview @source]
            enum_payload_module: mutable darray[sview @source] = []
            enum_payload_variant: mutable darray[sview @source]
            enum_payload_name: mutable darray[sview @source]
            # Bare declared payload type at the same index (empty for structural types).
            enum_payload_type: mutable darray[sview @source]
            # Full structural payload TypeId at the same index (0 when unsupported).
            enum_payload_type_id: mutable darray[u32]
            # Zero-based field offset within the declaring enum variant.
            enum_payload_position: mutable darray[u32]
            enum_common_owners: mutable darray[sview @source]
            enum_common_modules: mutable darray[sview @source]
            enum_common_counts: mutable darray[u32]
            # Struct field registry (parallel arrays, same shape as the enum one):
            # entry i says struct `struct_field_owner[i]` declares NAMED field
            # `struct_field_name[i]`. Anonymous/positional members are not recorded
            # (they have no label to check a construction against). A struct with
            # >=1 entry here has a KNOWN, closed field set (Elisa structs do not
            # inherit fields), so a `Name{label: ...}` construction can be checked.
            struct_field_owner: mutable darray[sview @source]
            # The MODULE that owner was declared in, "" for a top-level struct. Parallel to
            # struct_field_owner, and deliberately a SECOND column rather than a qualified
            # name in the first: 37 sites compare struct_field_owner by bare name, and
            # making them all namespace-aware at once is a far larger change than the bug
            # needs. The construct-site checks consult both; everything else is unchanged.
            #
            # Without it, two modules each declaring a `Work` share one owner key, so
            # `Grade::Work{total: 3}` sees Score::Work's fields too and reports
            # `struct literal "Work" is missing field "tally"` -- for a program stage0
            # compiles and runs.
            private_field_types: mutable darray[Ast::Expr]
            struct_field_private: mutable darray[bool]
            struct_field_module: mutable darray[sview @source] = []
            struct_field_name: mutable darray[sview @source]
            # Whether entry i's field is REQUIRED in a by-label construction (not an
            # optional `name?: T` nor a defaulted `name: T = v` field). Drives MissingField.
            struct_field_required: mutable darray[bool]
            # Entry i's field's declared bare TYPE name ("" when not a bare ident/primitive
            # — refs/generics/optionals skipped). Feeds the type-inference engine's field-
            # access typing (`p.x` gets field x's type when p is a known struct).
            struct_field_type: mutable darray[sview @source]
            # Entry i's field's declared mutability (true iff the field's type_expression was
            # wrapped `mutable T`). Feeds FieldImmutableAssign: assigning through `<-`/compound
            # to a field that is present but NOT mutable is an error.
            struct_field_mutable: mutable darray[bool]
            # Entry i's field's STRUCTURAL interned TypeId (0 when unmodeled) — the
            # Phase C sibling of struct_field_type, so `p.items` on a registered
            # struct infers Container/Optional where the bare name is "".
            struct_field_type_id: mutable darray[u32]
            # Entry i's explicit `@region` storage qualifier, separate from its
            # structural type (`StructMember.region` is not part of TypeId).
            struct_field_region: mutable darray[sview @source] = []
            # Region suffixes on nested type arguments, keyed by the exact AST
            # argument offset. A duplicate offset with conflicting names is unknown.
            type_region_suffix_heads: mutable dict[u64, u32] = {}
            type_region_suffix_names: mutable darray[sview @source] = []
            # Qualified type ownership: parallel module/type names for direct
            # `Module::Type` declarations. Keeps namespace ownership separate from
            # the flat symbol index used by ordinary value resolution.
            qualified_type_module: mutable darray[sview @source]
            qualified_type_name: mutable darray[sview @source]
            # Type-alias targets used by tooling consumers that need to preserve
            # semantic identity through an alias (for example, enum-variant
            # highlighting). Each row records the alias name, its bare target
            # spelling, and the module that owns the alias. Empty targets are
            # deliberately retained as an explicit "not a bare alias" result.
            type_alias_name: mutable darray[sview @source] = []
            type_alias_target: mutable darray[sview @source] = []
            type_alias_module: mutable darray[sview @source] = []
            # TypeAliasDeclaration rows are normally in symbol/source order. The zeroed
            # alias lookup uses binary search by declaration id and falls back to AST walks
            # if collection ever violates that append-order invariant.
            type_alias_declarations_index_valid: mutable bool = true
            # Exact-name row chains for the thread-shareability type walk. This pass often
            # checks the same aliases from many parameter/local types; keep every same-name
            # row in insertion order and compare spellings after hashing to handle collisions.
            thread_alias_name_heads: mutable dict[u64, u32] = {}
            thread_alias_name_tails: mutable dict[u64, u32] = {}
            thread_alias_name_counts: mutable dict[u64, u32] = {}
            thread_alias_name_next: mutable darray[u32] = []
            thread_alias_name_index_count: mutable usize = 0
            thread_alias_name_index_built: mutable bool = false
            # `lmut` parameter registry (parallel arrays, same shape as the struct/enum
            # ones): entry i says function `lmut_param_owner[i]` declares an `lmut`
            # parameter at positional index `lmut_param_pos[i]`. Feeds the call-site
            # aliasing check (`check_call_lmut_aliasing`) — an `lmut` argument may not
            # name the same place as another argument of the same call. Only recorded
            # for uniquely-named functions (the check poisons overloaded names).
            lmut_param_owner: mutable darray[sview @source]
            lmut_param_pos: mutable darray[u32]
            # Function parameter registry for conservative named-call checking. Each
            # entry records one explicit parameter of a Func declaration in declaration
            # order, with the default flag copied from the parser.
            function_param_owner: mutable darray[sview @source]
            # Canonical declaration identity for each parameter row. The bare-name owner
            # above is a lookup key, not enough to distinguish same-named functions in
            # different modules.
            function_param_declaration_id: mutable darray[DeclId] = []
            function_param_name: mutable darray[sview @source]
            function_param_has_default: mutable darray[bool]
            # Declared bare TYPE name of each parameter, parallel to function_param_name
            # ("" when the type is not a bare ident/primitive). Feeds literal-argument
            # type checking at direct call sites.
            function_param_type: mutable darray[sview @source]
            # Interned structural TypeId for each parameter annotation, parallel to
            # function_param_type. Zero means an unmodeled/ambiguous annotation.
            function_param_type_id: mutable darray[u32]
            # Region ties declared on function parameters, keyed by the owning function
            # header line and formal parameter name. These instantiate generic call results
            # such as `parse(&arena) -> JsonValue[r]`.
            function_param_region_line: mutable darray[u32] = []
            function_param_region_name: mutable darray[sview @source] = []
            function_param_region: mutable darray[sview @source] = []
            # Aggregate-state markers of each parameter annotation (`Holder[&]`,
            # `Holder[?, !]`), parallel to function_param_type: 2 bits per slot, slot i at
            # bits 2i..2i+1, `?` = 1, `&` = 2, `!` = 3; 0 when the annotation has no markers.
            function_param_state_code: mutable darray[u32]
            # Whether each parameter is spelled `mutable T&` (a mutable borrow), parallel to
            # function_param_type. `bare_type_name` above strips the markers, so this preserves
            # the borrow-ness for call-site checks (e.g. value-block outer mutation via a call).
            function_param_mutable_ref: mutable darray[bool]
            # Forward singly-linked hash chain over function_param_owner, keyed by FNV hash of
            # the owner name (same hash as name_primary/name_overflow above) — turns "every
            # parameter of function NAME" from an O(function_param_owner.count) scan of every
            # parameter in the WHOLE PROGRAM into an O(this function's own parameter/overload
            # count) walk. `function_param_name_head[hash]` is the index of the FIRST entry
            # with that hash; `function_param_name_next[i]` is the index of the NEXT entry
            # sharing entry i's owner hash, sentinel 4294967295 for "no next" (mirrors the
            # arity_max variadic sentinel already used elsewhere in this table). `..._tail`
            # is the running last-entry index per hash, so a new push is an O(1) append to the
            # chain rather than a rewalk. See index_function_param/symbols.elisa. Populated
            # ONLY at that one push site — every reader below is unaffected if unindexed
            # (an absent hash simply yields an empty chain).
            function_param_name_head: mutable dict[u64, u32]
            function_param_name_tail: mutable dict[u64, u32]
            function_param_name_next: mutable darray[u32]
            # Function-only projection used by readonly-reference resolution. The general
            # parameter table contains one row per parameter, so checking whether a callee
            # exists should not scan that entire table just to test the sentinel rows.
            readonly_function_names: mutable darray[sview @source] = []
            readonly_function_owners: mutable darray[sview @source] = []
