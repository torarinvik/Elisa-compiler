# Optional-vs-literal comparison (stage0 optional comparison check). Comparing an optional-typed
# local (`x: T?`) directly to a non-optional LITERAL with `==`/`!=` is rejected — the optional must
# be unwrapped first (compared against `null`, or bound with `if EXPR is NAME:`).
#
# SOUND subset: fires only when one operand is a local whose declared type is `T?` (Unary(Question))
# and the OTHER is a bare literal (int/float/string/char/bool — never `null`, which is the valid
# comparison). Comparing two optionals, or an optional to a non-literal, is not flagged here.
extend Semantic:
    private:
        # Type-family name of a bare literal operand, else "" (not a literal).
        def literal_family_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(value):
                        return "int"
                    Expr.FloatLit(text):
                        return "f64"
                    Expr.StringLit(text):
                        return "cstr"
                    Expr.CharLit(text):
                        return "char"
                    Expr.BoolLit(value):
                        return "bool"
                    _:
                        return sview("", 0, 0)

        # The declared optional base spelling for an ident naming an optional local, else "".
        def optional_base_of(expression: Ast::Expr, optional_names: darray[sview]&, optional_bases: darray[sview]&) -> sview:
            can Abort.Panic:
                name: sview = ident_name_of(expression)
                "" return if name == ""
                index: mutable usize = 0
                found: mutable sview = sview("", 0, 0)
                while index < optional_names.count |found|:
                    found <- optional_bases[index] if optional_names[index] == name and found == ""
                    index <- index + 1
                return found

        def report_optional_compare(expression: Ast::Expr, optional_names: darray[sview]&, optional_bases: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.EqEq or operator == TokenKind.BangEq:
                            left_base: sview = optional_base_of(left, optional_names, optional_bases)
                            right_base: sview = optional_base_of(right, optional_names, optional_bases)
                            left_lit: sview = literal_family_name(left)
                            right_lit: sview = literal_family_name(right)
                            # optional on the LEFT, literal on the RIGHT.
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OptionalLiteralCompare, name: left_base, line: line.line, expected: right_lit, actual: "L"}) if left_base != "" and right_lit != ""
                            # optional on the RIGHT, literal on the LEFT.
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OptionalLiteralCompare, name: right_base, line: line.line, expected: left_lit, actual: "R"}) if right_base != "" and left_lit != ""
                        table <- report_optional_compare(left, optional_names, optional_bases, table)
                        table <- report_optional_compare(right, optional_names, optional_bases, table)
                    Expr.Paren(inner, paren_line):
                        table <- report_optional_compare(inner, optional_names, optional_bases, table)
                    Expr.Unary(unary_operator, operand, unary_line):
                        table <- report_optional_compare(operand, optional_names, optional_bases, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- report_optional_compare(argument, optional_names, optional_bases, table)
                    _:
                        pass

        # Collect locals declared with an optional type `T?` (Unary(Question, base)): name -> base spelling.
        def collect_optional_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, bases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, bases|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if type_expression is Expr.Unary(operator, operand, unary_line):
                                if operator == TokenKind.Question:
                                    base: sview = ident_name_of(operand)
                                    names.push(name) if base != ""
                                    bases.push(base) if base != ""
                        Stmt.If(condition, then_body, else_body, line):
                            collect_optional_locals(then_body, names, bases)
                            collect_optional_locals(else_body, names, bases)
                        Stmt.While(condition, while_body, line):
                            collect_optional_locals(while_body, names, bases)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            collect_optional_locals(for_body, names, bases)
                        Stmt.Block(kind, clause, binding, body, line):
                            collect_optional_locals(body, names, bases)
                        _:
                            pass

        def optional_compare_walk(statements: darray[Ast::Stmt], optional_names: darray[sview]&, optional_bases: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- report_optional_compare(value, optional_names, optional_bases, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- report_optional_compare(value, optional_names, optional_bases, table)
                        Stmt.Expr(expression, line):
                            table <- report_optional_compare(expression, optional_names, optional_bases, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- report_optional_compare(returned, optional_names, optional_bases, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- report_optional_compare(condition, optional_names, optional_bases, table)
                            table <- optional_compare_walk(then_body, optional_names, optional_bases, table)
                            table <- optional_compare_walk(else_body, optional_names, optional_bases, table)
                        Stmt.While(condition, while_body, line):
                            table <- report_optional_compare(condition, optional_names, optional_bases, table)
                            table <- optional_compare_walk(while_body, optional_names, optional_bases, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- optional_compare_walk(for_body, optional_names, optional_bases, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- optional_compare_walk(body, optional_names, optional_bases, table)
                        _:
                            pass

        def check_optional_compare_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            optional_names: mutable darray[sview] = []
                            optional_bases: mutable darray[sview] = []
                            collect_optional_locals(body, optional_names, optional_bases)
                            table <- optional_compare_walk(body, optional_names, optional_bases, table) if optional_names.count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_optional_compare_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_optional_compare_walk(scoped_body, table)
                        _:
                            pass

        def check_optional_compare(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_optional_compare_walk(file.top_decls, table)
