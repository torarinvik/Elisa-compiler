extend Semantic:
    private:
        # A direct `x <- f(..., x, ...)` call that uniquely resolves to an lmut formal at
        # that argument position threads x's successor back into x. The call's summary still
        # records any actual store-through relationships; do not also treat every argument
        # name as an alias merely because the threaded result is rebound to its input place.
        # Keep this narrow: named arguments, overloads, wrapped callees/places, and ordinary
        # value assignments retain the conservative assignment union below.
        # `t <- f(a, t)` where `f` returns void only threads `t` through the call: no value
        # is assigned, so the call's own summary rows are all it can store.
        def sts_void_threading_call(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return false if:
                    operator != TokenKind.LArrow
                    has_unreadable_binder
                if target is Expr.Ident(target_name, _) and value is Expr.Call(callee, arguments, argument_names, _):
                    callee_name: mutable sview = ""
                    match callee:
                        Expr.Ident(direct_name, direct_position):
                            callee_name <- direct_name if not borrow_reference_site_is_local(reference_sites, function_owner, direct_position, table)
                        _:
                            callee_name <- sts_generic_direct_callee_name(callee, has_unreadable_binder, function_owner, reference_sites, table)
                    return false if:
                        callee_name == "" or direct_function_count(table, callee_name) != 1
                        any argument_name in argument_names where argument_name != ""
                    threads_target: mutable bool = false
                    for argument in arguments |threads_target, target_name|:
                        if argument is Expr.Ident(threaded_name, _) and threaded_name == target_name:
                            threads_target <- true
                    return false if not threads_target
                    if find_symbol(table, callee_name) is callee_symbol:
                        return callee_symbol.kind == SymbolKind.Func and callee_symbol.return_type == "void"
                return false

        def sts_same_target_lmut_rebind(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return false if:
                    operator != TokenKind.LArrow
                    has_unreadable_binder
                match target:
                    Expr.Ident(target_name, _):
                        match value:
                            Expr.Call(callee, arguments, argument_names, _):
                                match callee:
                                    Expr.Ident(callee_name, callee_position):
                                        return false if:
                                            callee_name == "" or direct_function_count(table, callee_name) != 1
                                            borrow_reference_site_is_local(reference_sites, function_owner, callee_position, table)
                                            any argument_name in argument_names where argument_name != ""
                                        position: mutable u32 = 0
                                        for argument in arguments |position, target_name, callee_name, table|:
                                            if sts_lmut_parameter_at(table, callee_name, position) and argument is Expr.Ident(argument_name, _) and argument_name == target_name:
                                                return true
                                            position <- position + 1
                                    _:
                                        pass
                            _:
                                pass
                    _:
                        pass
                return false

        # Reading a field whose every declaration is proven reference-free copies data, so it
        # cannot carry a borrow of the object it was read from into the assignment target.
        def sts_value_copies_reference_free_field(value: Ast::Expr, reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match value:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _):
                        return true
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return sts_value_copies_reference_free_field(inner, reference_sites, table)
                    Expr.Index(object, _, _):
                        return sts_value_copies_reference_free_field(object, reference_sites, table)
                    Expr.Binary(left, operator, right, _) if operator == TokenKind.And or operator == TokenKind.Or:
                        return sts_value_copies_reference_free_field(left, reference_sites, table) and sts_value_copies_reference_free_field(right, reference_sites, table)
                    Expr.Field(_, field, _):
                        return false if table.struct_field_name.count != table.struct_field_type_id.count
                        found: mutable bool = false
                        for row in 0..<table.struct_field_name.count |found, reference_sites, table, field|:
                            if table.struct_field_name[row] == field:
                                return false if not bam_type_is_proven_reference_free_cached(table.struct_field_type_id[row], reference_sites, table)
                                found <- true
                        return found
                    _:
                        return false

        def sts_statements(statements: darray[Ast::Stmt], summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&, classes: mutable StoreThroughClasses&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |classes, reference_sites|:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, _):
                            sts_unify_bound(declared_name, declared_type, declared_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Assign(assign_target, assign_operator, assign_value, _):
                            if not sts_value_copies_reference_free_field(assign_value, reference_sites, table) and not sts_same_target_lmut_rebind(assign_target, assign_operator, assign_value, has_unreadable_binder, function_owner, reference_sites, table) and not sts_void_threading_call(assign_target, assign_operator, assign_value, has_unreadable_binder, function_owner, reference_sites, table) and not sts_assignment_rhs_is_reference_free(assign_value, assign_operator, has_unreadable_binder, function_owner, reference_sites, table):
                                assign_names: mutable darray[sview] = []
                                sts_collect_names(assign_target, assign_names)
                                sts_collect_names_except(assign_value, assign_names, classes.copy_safe, classes.copy_values)
                                sts_unify_all(classes, assign_names)
                            sts_unify_calls(assign_target, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_unify_calls(assign_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Expr(statement_value, _):
                            sts_unify_calls(statement_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Return(returned, _):
                            if returned is returned_value:
                                sts_unify_return_calls(returned_value, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.If(condition, then_body, else_body, _):
                            sts_unify_calls(condition, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(then_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(else_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.While(condition, loop_body, _):
                            sts_unify_calls(condition, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(loop_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.For(_, loop_variables, iterable, loop_body, _):
                            if sts_projects_copy_safe(iterable, classes.copy_safe):
                                # Elements of a reference-free collection are plain copies.
                                for loop_variable in loop_variables |classes|:
                                    classes.copy_safe.push(loop_variable)
                                    classes.copy_values.push(loop_variable)
                            for loop_variable in loop_variables |classes, reference_sites|:
                                continue if any value_name in classes.copy_values where value_name == loop_variable
                                sts_unify_bound(loop_variable, Expr.Invalid, iterable, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_unify_calls(iterable, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            sts_statements(loop_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Block(body: block_body, _):
                            sts_statements(block_body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Match(scrutinee, arms, _):
                            # Arm binders are not read here: they join the scrutinee through
                            # any later statement that mentions both, and a binder stored into a
                            # parameter is unified with that parameter by the store itself.
                            sts_unify_calls(scrutinee, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                            for arm in arms |classes, reference_sites|:
                                sts_unify_calls(arm.guard, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                                sts_statements(arm.body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        Stmt.Contract(_, expression, _):
                            sts_unify_calls(expression, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                        _:
                            pass

        def sts_collect_functions(declarations: darray[Ast::Decl], functions: mutable darray[Ast::Decl]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |functions|:
                    match declaration:
                        Decl.Func(name: function_name, _):
                            functions.push(declaration)
                        Decl.Module(_, module_body, _):
                            sts_collect_functions(module_body, functions)
                        Decl.Scoped(scoped_body, _):
                            sts_collect_functions(scoped_body, functions)
                        _:
                            pass

        # The rows one function adds under SUMMARY; true when any row is new.
        # ADDRESS RETENTION. The classes above ask whether anything reachable from a parameter
        # may reach a writable one. These walks ask the narrower question for `&local`: may the
        # reference ITSELF be kept? Reading through it (`x.f <- p.g`, `for e in p`) cannot
        # leave a pointer to the caller's frame behind.
        def sts_address_bare_root(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Paren(inner, _):
                        return sts_address_bare_root(inner)
                    Expr.Move(inner, _):
                        return sts_address_bare_root(inner)
                    Expr.Unary(TokenKind.Ampersand, operand, _):
                        return bam_place_root(operand)
                    _:
                        return ""

        def sts_address_visit(expression: Ast::Expr, summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, marked: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: mutable sview = ""
                        match callee:
                            Expr.Ident(direct_name, direct_position):
                                callee_name <- direct_name if not has_unreadable_binder and not borrow_reference_site_is_local(reference_sites, function_owner, direct_position, table)
                            Expr.Field(receiver, _, _):
                                sts_collect_names(receiver, marked)
                            _:
                                callee_name <- sts_generic_direct_callee_name(callee, has_unreadable_binder, function_owner, reference_sites, table)
                        named: bool = any argument_name in argument_names where argument_name != ""
                        known: bool = callee_name != "" and not named and sts_is_declared(summary, callee_name)
                        position: mutable usize = 0
                        for argument in arguments |position, marked, reference_sites, callee_name, known|:
                            sts_address_visit(argument, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                            root: sview = sts_address_bare_root(argument)
                            if root != "" and (not known or sts_retains_address(summary, callee_name, position)):
                                marked.push(root)
                            position <- position + 1
                    Expr.Field(object, _, _):
                        sts_address_visit(object, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                    Expr.Index(object, index, _):
                        sts_address_visit(object, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                        sts_address_visit(index, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                    Expr.Binary(left, _, right, _):
                        sts_address_visit(left, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                        sts_address_visit(right, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                    Expr.Unary(_, operand, _):
                        sts_address_visit(operand, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                    Expr.Paren(inner, _):
                        sts_address_visit(inner, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                    Expr.Ident(_, _):
                        pass
                    _:
                        # Aggregates, lambdas and block values may keep anything they mention.
                        sts_collect_names(expression, marked)

        def sts_address_stored(expression: Ast::Expr, summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, marked: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                root: sview = sts_address_bare_root(expression)
                marked.push(root) if root != ""
                sts_address_visit(expression, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                # A returned value may alias any reference the call was given.
                if expression is Expr.Call(_, arguments, _, _):
                    for argument in arguments |marked|:
                        call_root: sview = sts_address_bare_root(argument)
                        marked.push(call_root) if call_root != ""

        def sts_address_statements(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, summary: StoreThroughSummary&, has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, marked: mutable darray[sview]&, alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |marked, alias_names, alias_roots, reference_sites|:
                    match statement:
                        Stmt.VarDecl(declared_name, _, declared_value, _):
                            sts_address_visit(declared_value, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                            alias_root: sview = sts_address_bare_root(declared_value)
                            if alias_root != "":
                                alias_names.push(declared_name)
                                alias_roots.push(alias_root)
                        Stmt.Assign(assign_target, assign_operator, assign_value, _):
                            sts_address_visit(assign_target, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                            threaded: bool = sts_void_threading_call(assign_target, assign_operator, assign_value, has_unreadable_binder, function_owner, reference_sites, table) or sts_same_target_lmut_rebind(assign_target, assign_operator, assign_value, has_unreadable_binder, function_owner, reference_sites, table)
                            local_target: mutable bool = false
                            if assign_target is Expr.Ident(target_name, _):
                                local_target <- not (any parameter in parameters where parameter.name == target_name)
                            if threaded or local_target:
                                sts_address_visit(assign_value, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                                value_root: sview = sts_address_bare_root(assign_value)
                                if local_target and value_root != "":
                                    alias_names.push(ident_name_of(assign_target))
                                    alias_roots.push(value_root)
                            else:
                                sts_address_stored(assign_value, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                        Stmt.Expr(statement_value, _):
                            sts_address_visit(statement_value, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                        Stmt.Return(returned, _):
                            if returned is returned_value:
                                sts_address_stored(returned_value, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                        Stmt.If(condition, then_body, else_body, _):
                            sts_address_visit(condition, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                            sts_address_statements(then_body, parameters, summary, has_unreadable_binder, function_owner, reference_sites, table, marked, alias_names, alias_roots)
                            sts_address_statements(else_body, parameters, summary, has_unreadable_binder, function_owner, reference_sites, table, marked, alias_names, alias_roots)
                        Stmt.While(condition, loop_body, _):
                            sts_address_visit(condition, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                            sts_address_statements(loop_body, parameters, summary, has_unreadable_binder, function_owner, reference_sites, table, marked, alias_names, alias_roots)
                        Stmt.For(_, _, iterable, loop_body, _):
                            sts_address_visit(iterable, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                            sts_address_statements(loop_body, parameters, summary, has_unreadable_binder, function_owner, reference_sites, table, marked, alias_names, alias_roots)
                        Stmt.Block(body: block_body, _):
                            sts_address_statements(block_body, parameters, summary, has_unreadable_binder, function_owner, reference_sites, table, marked, alias_names, alias_roots)
                        Stmt.Match(scrutinee, arms, _):
                            sts_address_visit(scrutinee, summary, has_unreadable_binder, function_owner, reference_sites, table, marked)
                            for arm in arms |marked, alias_names, alias_roots, reference_sites|:
                                sts_address_statements(arm.body, parameters, summary, has_unreadable_binder, function_owner, reference_sites, table, marked, alias_names, alias_roots)
                        Stmt.Contract(_, _, _):
                            pass
                        _:
                            sts_collect_statement_names([statement], marked)

        def sts_summarise_addresses(function_name: sview, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, summary: mutable StoreThroughSummary&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                marked: mutable darray[sview] = []
                alias_names: mutable darray[sview] = []
                alias_roots: mutable darray[sview] = []
                sts_address_statements(body, parameters, summary, has_unreadable_binder, function_owner, reference_sites, table, marked, alias_names, alias_roots)
                grew: mutable bool = true
                while grew |grew, marked, alias_names, alias_roots|:
                    grew <- false
                    for alias_index in 0..<alias_names.count |grew, marked, alias_names, alias_roots|:
                        alias_marked: bool = any name in marked where name == alias_names[alias_index]
                        root_marked: bool = any name in marked where name == alias_roots[alias_index]
                        if alias_marked and not root_marked:
                            marked.push(alias_roots[alias_index])
                            grew <- true
                added: mutable bool = false
                position: mutable usize = 0
                for parameter in parameters |position, added, marked, summary|:
                    if (any name in marked where name == parameter.name) and not sts_retains_address(summary, function_name, position):
                        summary.address_rows <- summary.address_rows.put(sts_address_key(function_name, position), true)
                        added <- true
                    position <- position + 1
                return added

        def sts_summarise_function(function_name: sview @source, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], has_unreadable_binder: bool, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&, summary: mutable StoreThroughSummary&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                classes: mutable StoreThroughClasses = sts_classes_empty()
                for parameter in parameters |classes, reference_sites, table|:
                    continue if not type_marker_present_here(parameter.type_expression, TokenKind.Ampersand)
                    pointee: u32 = bam_strip_ref(annotation_type_id(parameter.type_expression, table), table) can Global{Read,Write}
                    visited: mutable dict[u32, bool] = {}
                    classes.copy_safe.push(parameter.name) if bam_type_has_no_direct_reference(pointee, visited, reference_sites, table)
                sts_statements(body, summary, has_unreadable_binder, function_owner, reference_sites, table, classes)
                added: mutable bool = false
                target: mutable usize = 0
                while target < parameters.count |target, classes, added, summary|:
                    if sts_is_writable(summary, function_name, target):
                        target_class: usize = sts_class_of(classes, parameters[target].name)
                        source: mutable usize = 0
                        while source < parameters.count |source, classes, added, summary|:
                            if source != target and sts_class_of(classes, parameters[source].name) == target_class and not sts_has_pair(summary, function_name, target, source):
                                sts_add_pair(summary, function_name, target, source) can Global{Read,Write}
                                added <- true
                            source <- source + 1
                    target <- target + 1
                added <- true if sts_summarise_addresses(function_name, parameters, body, has_unreadable_binder, function_owner, reference_sites, table, summary)
                return added

    public:
        def build_store_through_summary(declarations: darray[Ast::Decl], reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&) -> StoreThroughSummary:
            can Memory.Allocate, Abort.Panic:
                summary: mutable StoreThroughSummary = sts_empty()
                functions: mutable darray[Ast::Decl] = []
                sts_collect_functions(declarations, functions)
                summarised: mutable darray[Ast::Decl] = []
                summarised_unreadable: mutable darray[bool] = []
                for function in functions |summary, summarised, summarised_unreadable, table, reference_sites|:
                    match function:
                        Decl.Func(name: function_name, params: function_parameters, body: function_body, _):
                            if function_name != "" and function_name != "_":
                                if not sts_is_declared(summary, function_name):
                                    sts_declare(summary, function_name) can Global{Read,Write}
                                position: mutable usize = 0
                                writable_found: mutable bool = false
                                for parameter in function_parameters |position, writable_found, summary, table, reference_sites|:
                                    if param_is_mutable_ref(parameter):
                                        pointee: u32 = bam_strip_ref(annotation_type_id(parameter.type_expression, table), table) can Global{Read,Write}
                                        contains_reference: mutable bool = false
                                        can Global{Read,Write}:
                                            contains_reference <- bam_type_may_contain_reference(pointee, reference_sites, table)
                                        if contains_reference:
                                            sts_add_writable(summary, function_name, position) can Global{Read,Write}
                                            writable_found <- true
                                    position <- position + 1
                                if writable_found and function_parameters.count > 1:
                                    has_unreadable_binder: bool = borrow_function_has_unreadable_binder(function_parameters, function_body)
                                    summarised.push(function)
                                    summarised_unreadable.push(has_unreadable_binder)
                        _:
                            pass
                # Only functions with a writable parameter carry rows; every other declared
                # function is summarised as storing nothing through a writable parameter.
                more_rows: mutable bool = summarised.count > 0
                while more_rows |more_rows, summary, reference_sites|:
                    more_rows <- false
                    for function_index in 0..<summarised.count |more_rows, summary, summarised, summarised_unreadable, reference_sites, table|:
                        match summarised[function_index]:
                            Decl.Func(name: function_name, params: function_parameters, body: function_body, pos: function_pos, _):
                                function_owner: DeclId = function_declaration_id(table, function_name, function_pos.offset)
                                more_rows <- true if (sts_summarise_function(function_name, function_parameters, function_body, summarised_unreadable[function_index], function_owner, reference_sites, table, summary) can Global{Read,Write})
                            _:
                                pass
                file_globals: mutable darray[sview @source] = []
                collect_mutable_globals(declarations, file_globals)
                summary.globals.extend(file_globals)
                return summary
