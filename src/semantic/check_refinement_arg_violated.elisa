# Law-refinement argument-violation at call sites. A parameter `v: T is Law` (a no-argument
# refinement whose bound is a constant in the law body, e.g. `law AtMost10(self) = self<=10`)
# constrains its argument; a call passing a CONSTANT — a literal, or a local bound to a
# constant — that provably breaks the law is rejected by stage0 ("refinement X is violated:
# argument N does not satisfy it"). SOUND, decidable subset: evaluate the law body with
# self = the constant; emit only on a provable violation. Reuses collect_laws /
# predicate_violated_by / where_signed_literal.
extend Semantic:
    private:
        # The no-argument refinement law name of a parameter type `T is Law`, or "".
        def param_law_name(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Binary(base, operator, right, line):
                        return ident_name_of(right) if operator == TokenKind.Is else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # The predicate body of the named law, or Absent.
        def law_predicate_by_name(name: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                while probe < law_names.count |probe: usize = 0|:
                    law_predicates[probe] return if law_names[probe] == name
                    probe <- probe + 1
                return (Ast::Expr.Absent)

        # The self-bound refinement predicate of a parameter type: a `T is Law` no-arg law body,
        # OR a refine-alias name (`refine Positive = i64 where self > 0`). Absent otherwise.
        def param_refinement_predicate(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                # A `where` refinement carries its predicate structurally
                # (`x: i64 where x > 0` — the fact stage0's prover consumes directly).
                match type_expression:
                    Expr.Refinement(refined_base, refined_predicate, refinement_line):
                        return refined_predicate
                    _:
                        pass
                law_name: sview = param_law_name(type_expression)
                law_predicate: Ast::Expr = law_predicate_by_name(law_name, law_names, law_predicates) if law_name != "" else (Ast::Expr.Absent)
                law_usable: bool = match law_predicate:
                    Expr.Absent: false
                    _: true
                law_predicate return if law_usable
                return alias_predicate_of_type(type_expression, alias_names, alias_predicates)

        # The BASE type name a refine alias refines: `refine SmallPositive = Positive where …`
        # -> "Positive". "" for non-refinement alias decls.
        def collect_refine_alias_bases(declarations: darray[Ast::Decl], names: mutable darray[sview]&, bases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, bases|:
                    match declaration:
                        Decl.Alias(alias_name, target, alias_line):
                            if target is Expr.Refinement(refined_base, refined_predicate, refinement_line):
                                names.push(alias_name)
                                bases.push(ident_name_of(refined_base))
                        Decl.Module(module_name, module_body, module_line):
                            collect_refine_alias_bases(module_body, names, bases)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_refine_alias_bases(scoped_body, names, bases)
                        _:
                            pass

        # The refine-alias base of NAME, or "".
        def refarg_alias_base_of(name: sview, base_names: darray[sview]&, base_values: darray[sview]&) -> sview:
            can Abort.Panic:
                probe: mutable usize = 0
                result: mutable sview = sview("", 0, 0)
                while probe < base_names.count |probe, result|:
                    result <- base_values[probe] if base_names[probe] == name and result == ""
                    probe <- probe + 1
                return result

        # Push each INHERITED base predicate of an alias-typed parameter as its own
        # (function, index, predicate) row — so a chain `SmallPositive = Positive where …`
        # enforces Positive's `self > 0` too. No AST is built (each row reuses an existing
        # alias-predicate node), so this stays non-region-polymorphic. Depth-bounded.
        def push_alias_chain(function_name: sview, index: usize, type_expression: Ast::Expr, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, base_names: darray[sview]&, base_values: darray[sview]&, param_functions: mutable darray[sview]&, param_indices: mutable darray[usize]&, param_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                current: mutable sview = ident_name_of(type_expression)
                depth: mutable u32 = 0
                while depth < 16 and current != "" |current, depth, param_functions, param_indices, param_predicates|:
                    base: sview = refarg_alias_base_of(current, base_names, base_values)
                    break if base == "" or not (any alias_name in alias_names where alias_name == base)
                    base_predicate: Ast::Expr = alias_predicate_of_type((Ast::Expr.Ident(base, 0)), alias_names, alias_predicates)
                    base_usable: bool = match base_predicate:
                        Expr.Absent: false
                        _: true
                    if base_usable:
                        param_functions.push(function_name)
                        param_indices.push(index)
                        param_predicates.push(base_predicate)
                    current <- base
                    depth <- depth + 1

        # Collect (function, param-index, self-bound predicate) for each parameter carrying a
        # no-argument law refinement or a refine-alias type. When `expand_chain`, an alias
        # parameter also contributes one row per inherited base predicate.
        def collect_law_params(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, base_names: darray[sview]&, base_values: darray[sview]&, expand_chain: bool, param_functions: mutable darray[sview]&, param_indices: mutable darray[usize]&, param_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            while probe < parameters.count |probe: usize = 0, param_functions, param_indices, param_predicates|:
                                law_predicate: Ast::Expr = param_refinement_predicate(parameters[probe].type_expression, law_names, law_predicates, alias_names, alias_predicates)
                                usable: bool = match law_predicate:
                                    Expr.Absent: false
                                    _: true
                                param_functions.push(function_name) if usable
                                param_indices.push(probe) if usable
                                param_predicates.push(law_predicate) if usable
                                push_alias_chain(function_name, probe, parameters[probe].type_expression, alias_names, alias_predicates, base_names, base_values, param_functions, param_indices, param_predicates) if expand_chain
                                probe <- probe + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_law_params(module_body, law_names, law_predicates, alias_names, alias_predicates, base_names, base_values, expand_chain, param_functions, param_indices, param_predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_law_params(scoped_body, law_names, law_predicates, alias_names, alias_predicates, base_names, base_values, expand_chain, param_functions, param_indices, param_predicates)
                        _:
                            pass

        # Fold a constant integer expression: a signed literal, or `a + b` / `a - b` / `a * b`
        # over folded constant operands. Non-constant sub-terms yield found=false (sound).
        def fold_const_int(expression: Ast::Expr) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                literal: (found: bool, value: i64) = where_signed_literal(expression)
                literal return if literal.found
                match expression:
                    Expr.BoolLit(bool_value):
                        return (true, 1) if bool_value else (true, 0)
                    Expr.Paren(inner, paren_line):
                        return fold_const_int(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        left_value: (found: bool, value: i64) = fold_const_int(left)
                        right_value: (found: bool, value: i64) = fold_const_int(right)
                        (false, 0) return if not (left_value.found and right_value.found)
                        return when operator:
                            TokenKind.Plus -> (true, left_value.value + right_value.value)
                            TokenKind.Minus -> (true, left_value.value - right_value.value)
                            TokenKind.Star -> (true, left_value.value * right_value.value)
                            _ -> (false, 0)
                    _:
                        return (false, 0)

        # The constant value of an argument — a folded constant expression, or a local bound to a
        # constant — with found=false otherwise.
        def argument_constant(argument: Ast::Expr, const_names: darray[sview]&, const_values: darray[i64]&) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                direct: (found: bool, value: i64) = fold_const_int(argument)
                direct return if direct.found
                match argument:
                    Expr.Ident(name, line):
                        found_here: mutable bool = false
                        value_here: mutable i64 = 0
                        while probe < const_names.count |probe: usize = 0, found_here, value_here|:
                            matched: bool = const_names[probe] == name
                            found_here <- true if matched
                            value_here <- const_values[probe] if matched
                            probe <- probe + 1
                        return (found_here, value_here)
                    _:
                        return (false, 0)

        def law_arg_violated_at(probe: usize, callee_name: sview, arguments: darray[Ast::Expr]&, param_functions: darray[sview]&, param_indices: darray[usize]&, param_predicates: darray[Ast::Expr]&, const_names: darray[sview]&, const_values: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if param_functions[probe] != callee_name
                false return if param_indices[probe] >= arguments.count
                argument_value: (found: bool, value: i64) = argument_constant(arguments[param_indices[probe]], const_names, const_values)
                false return if not argument_value.found
                return predicate_violated_by(param_predicates[probe], "self", argument_value.value)

        def law_arg_check_expression(expression: Ast::Expr, line: u32, param_functions: darray[sview]&, param_indices: darray[usize]&, param_predicates: darray[Ast::Expr]&, const_names: darray[sview]&, const_values: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        while probe < param_functions.count |probe: usize = 0, table| -> table:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementArgNotProven, name: callee_name, line: line, expected: "", actual: "", expected_count: (param_indices[probe] + 1).u32()}) if callee_name != "" and law_arg_violated_at(probe, callee_name, arguments, param_functions, param_indices, param_predicates, const_names, const_values)
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- law_arg_check_expression(argument, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- law_arg_check_expression(left, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        table <- law_arg_check_expression(right, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                    Expr.Paren(inner, paren_line):
                        table <- law_arg_check_expression(inner, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                    _:
                        pass

        def law_arg_check_statements(statements: darray[Ast::Stmt], param_functions: darray[sview]&, param_indices: darray[usize]&, param_predicates: darray[Ast::Expr]&, const_names: mutable darray[sview]&, const_values: mutable darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, const_names, const_values| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            constant: (found: bool, value: i64) = where_signed_literal(value)
                            const_names.push(name) if constant.found
                            const_values.push(constant.value) if constant.found
                            table <- law_arg_check_expression(value, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Stmt.Expr(expression, line):
                            table <- law_arg_check_expression(expression, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- law_arg_check_expression(value, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- law_arg_check_expression(returned, line, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- law_arg_check_statements(then_body, param_functions, param_indices, param_predicates, const_names, const_values, table)
                            table <- law_arg_check_statements(else_body, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Stmt.While(condition, while_body, line):
                            table <- law_arg_check_statements(while_body, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- law_arg_check_statements(block_body, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- law_arg_check_statements(for_body, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        _:
                            pass

        def law_arg_check_walk(declarations: darray[Ast::Decl], param_functions: darray[sview]&, param_indices: darray[usize]&, param_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            const_names: mutable darray[sview] = []
                            const_values: mutable darray[i64] = []
                            table <- law_arg_check_statements(body, param_functions, param_indices, param_predicates, const_names, const_values, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- law_arg_check_walk(module_body, param_functions, param_indices, param_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- law_arg_check_walk(scoped_body, param_functions, param_indices, param_predicates, table)
                        _:
                            pass

        def check_refinement_arg_violated(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, law_names, law_predicates)
                alias_names: mutable darray[sview] = []
                alias_predicates: mutable darray[Ast::Expr] = []
                collect_refine_aliases(declarations, alias_names, alias_predicates)
                base_names: mutable darray[sview] = []
                base_values: mutable darray[sview] = []
                collect_refine_alias_bases(declarations, base_names, base_values)
                param_functions: mutable darray[sview] = []
                param_indices: mutable darray[usize] = []
                param_predicates: mutable darray[Ast::Expr] = []
                collect_law_params(declarations, law_names, law_predicates, alias_names, alias_predicates, base_names, base_values, true, param_functions, param_indices, param_predicates)
                table <- law_arg_check_walk(declarations, param_functions, param_indices, param_predicates, table)
