# Contract-clause purity (stage0 analyzer_functions contract-purity check). A `requires`/`ensure`
# clause must be a pure, deterministic predicate; reading a mutable global incurs the `Global.Read`
# effect, so a clause that references a `global`/`global mutable` is rejected. SOUND syntactic
# subset: fire when the clause predicate names a mutable-global that is not shadowed by a parameter
# (reading a `const` is pure — is_mutable distinguishes them; other effect sources need the effect
# engine and are left alone).
extend Semantic:
    private:
        def contract_param_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # The first mutable-global identifier referenced in EXPRESSION that is not a parameter,
        # or "" if none.
        def contract_global_reference(expression: Ast::Expr, globals: darray[sview]&, params: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name if (any global_name in globals where global_name == name) and not contract_param_name_present(params, name) else sview("", 0, 0)
                    Expr.Binary(left, operator, right, binary_line):
                        left_ref: sview = contract_global_reference(left, globals, params)
                        left_ref return if left_ref != ""
                        return contract_global_reference(right, globals, params)
                    Expr.Unary(operator, operand, unary_line):
                        return contract_global_reference(operand, globals, params)
                    Expr.Paren(inner, paren_line):
                        return contract_global_reference(inner, globals, params)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments:
                            found: sview = contract_global_reference(argument, globals, params)
                            found return if found != ""
                        return sview("", 0, 0)
                    Expr.Field(object, field, field_line):
                        return contract_global_reference(object, globals, params)
                    Expr.Index(object, index, index_line):
                        object_ref: sview = contract_global_reference(object, globals, params)
                        object_ref return if object_ref != ""
                        return contract_global_reference(index, globals, params)
                    _:
                        return sview("", 0, 0)

        def contract_purity_walk(declarations: darray[Ast::Decl], globals: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            params: mutable darray[sview] = []
                            for parameter in parameters |params|:
                                params.push(parameter.name)
                            for statement in body |table| -> table:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        clause: sview = kind
                                        global_ref: sview = contract_global_reference(expression, globals, params) if clause == "requires" or clause == "ensure" else sview("", 0, 0)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ContractImpureGlobalRead, name: global_ref, line: contract_line.line, expected: clause, actual: ""}) if global_ref != ""
                                    _:
                                        pass
                        Decl.Module(module_name, module_body, module_line):
                            table <- contract_purity_walk(module_body, globals, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- contract_purity_walk(scoped_body, globals, table)
                        _:
                            pass

        def check_contract_purity(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                globals: mutable darray[sview] = []
                collect_mutable_globals(declarations, globals)
                table <- contract_purity_walk(declarations, globals, table)
