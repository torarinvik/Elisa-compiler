# Ghost-field read by real code. A `ghost NAME: T` struct field is verification-only and
# erased from codegen, so it may be read only inside contracts or ghost code. Reading it
# from real code (`return self.model`) is rejected.
#
#   struct Counter:
#       concrete: i64
#       ghost model: i64
#   def leak(self: Counter&) -> i64:
#       return self.model            # ghost field read by real code -> error
#
# Ghost fields are collected from struct declarations (StructMember.is_ghost). A field
# read `X.field` is resolved by mapping the receiver `X` (a parameter or local) to its
# struct type; if that struct's `field` is ghost, and the read is not inside a ghost
# VarDecl initializer, it is flagged. Contract statements are never walked.
extend Semantic:
    private:
        def gfr_collect_ghost_fields(declarations: darray[Ast::Decl], owners: mutable darray[sview]&, fields: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |owners, fields|:
                    match declaration:
                        Decl.Struct(name, members, affinity, is_const, is_packed, invariants, line):
                            for member in members |owners, fields, name|:
                                if member.is_ghost:
                                    owners.push(name)
                                    fields.push(member.name)
                        Decl.Module(module_name, module_body, module_line):
                            gfr_collect_ghost_fields(module_body, owners, fields)
                        Decl.Scoped(scoped_body, scoped_line):
                            gfr_collect_ghost_fields(scoped_body, owners, fields)
                        _:
                            pass

        def gfr_type_of(local_names: darray[sview]&, local_types: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                while index < local_names.count |index|:
                    local_types[index] return if local_names[index] == name
                    index <- index + 1
                return sview("", 0, 0)

        def gfr_is_ghost_field(owners: darray[sview]&, fields: darray[sview]&, owner: sview, field: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < owners.count |index|:
                    true return if owners[index] == owner and fields[index] == field
                    index <- index + 1
                return false

        # Report the first ghost-field read in an expression.
        def gfr_report(expression: Ast::Expr, local_names: darray[sview]&, local_types: darray[sview]&, ghost_owners: darray[sview]&, ghost_fields: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(object, field, field_line):
                        if object is Expr.Ident(receiver, ident_line):
                            receiver_type: sview = gfr_type_of(local_names, local_types, receiver)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GhostFieldRead, name: field, line: line, expected: "", actual: ""}) if receiver_type != "" and gfr_is_ghost_field(ghost_owners, ghost_fields, receiver_type, field)
                        table <- gfr_report(object, local_names, local_types, ghost_owners, ghost_fields, line, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- gfr_report(left, local_names, local_types, ghost_owners, ghost_fields, line, table)
                        table <- gfr_report(right, local_names, local_types, ghost_owners, ghost_fields, line, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- gfr_report(operand, local_names, local_types, ghost_owners, ghost_fields, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- gfr_report(inner, local_names, local_types, ghost_owners, ghost_fields, line, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- gfr_report(argument, local_names, local_types, ghost_owners, ghost_fields, line, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- gfr_report(object, local_names, local_types, ghost_owners, ghost_fields, line, table)
                        table <- gfr_report(index_argument, local_names, local_types, ghost_owners, ghost_fields, line, table)
                    _:
                        pass

        def gfr_walk(statements: darray[Ast::Stmt], local_names: darray[sview]&, local_types: darray[sview]&, ghost_owners: darray[sview]&, ghost_fields: darray[sview]&, ghost_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            table <- gfr_report(returned, local_names, local_types, ghost_owners, ghost_fields, line, table) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- gfr_report(value, local_names, local_types, ghost_owners, ghost_fields, line, table) if not (any ghost_line in ghost_lines where ghost_line == line)
                        Stmt.Assign(target, operator, value, line):
                            table <- gfr_report(value, local_names, local_types, ghost_owners, ghost_fields, line, table)
                        Stmt.Expr(expression, line):
                            table <- gfr_report(expression, local_names, local_types, ghost_owners, ghost_fields, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- gfr_report(condition, local_names, local_types, ghost_owners, ghost_fields, line, table)
                            table <- gfr_walk(then_body, local_names, local_types, ghost_owners, ghost_fields, ghost_lines, table)
                            table <- gfr_walk(else_body, local_names, local_types, ghost_owners, ghost_fields, ghost_lines, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- gfr_report(condition, local_names, local_types, ghost_owners, ghost_fields, while_line, table)
                            table <- gfr_walk(while_body, local_names, local_types, ghost_owners, ghost_fields, ghost_lines, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- gfr_report(iterable, local_names, local_types, ghost_owners, ghost_fields, for_line, table)
                            table <- gfr_walk(for_body, local_names, local_types, ghost_owners, ghost_fields, ghost_lines, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- gfr_walk(body, local_names, local_types, ghost_owners, ghost_fields, ghost_lines, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- gfr_report(scrutinee, local_names, local_types, ghost_owners, ghost_fields, match_line, table)
                            for arm in arms |table| -> table:
                                table <- gfr_walk(arm.body, local_names, local_types, ghost_owners, ghost_fields, ghost_lines, table)
                        _:
                            pass

        def gfr_collect_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, types: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            names.push(name)
                            types.push(bare_type_name_through_ref(type_expression))
                        Stmt.If(condition, then_body, else_body, line):
                            gfr_collect_locals(then_body, names, types)
                            gfr_collect_locals(else_body, names, types)
                        Stmt.While(condition, while_body, while_line):
                            gfr_collect_locals(while_body, names, types)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            gfr_collect_locals(for_body, names, types)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            gfr_collect_locals(body, names, types)
                        _:
                            pass

        def gfr_check_declarations(declarations: darray[Ast::Decl], ghost_owners: darray[sview]&, ghost_fields: darray[sview]&, ghost_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            local_names: mutable darray[sview] = []
                            local_types: mutable darray[sview] = []
                            for parameter in parameters |local_names, local_types|:
                                local_names.push(parameter.name)
                                local_types.push(bare_type_name_through_ref(parameter.type_expression))
                            gfr_collect_locals(body, local_names, local_types)
                            table <- gfr_walk(body, local_names, local_types, ghost_owners, ghost_fields, ghost_lines, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- gfr_check_declarations(module_body, ghost_owners, ghost_fields, ghost_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- gfr_check_declarations(scoped_body, ghost_owners, ghost_fields, ghost_lines, table)
                        _:
                            pass

    public:
        def check_ghost_field_read(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                ghost_owners: mutable darray[sview] = []
                ghost_fields: mutable darray[sview] = []
                gfr_collect_ghost_fields(file.top_decls, ghost_owners, ghost_fields)
                if ghost_owners.count > 0:
                    table <- gfr_check_declarations(file.top_decls, ghost_owners, ghost_fields, file.ghost_local_lines, table)
