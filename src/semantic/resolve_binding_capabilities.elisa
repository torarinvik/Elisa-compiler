include "./binding_capability_unary_policy.elisa"

extend Semantic:
    private:
        const BINDING_CAPABILITY_MAX_RESOLUTION_DEPTH: u32 = 128
        const BINDING_MODULE_ALIAS_ROW_AMBIGUOUS: u32 = 4294967294

        def binding_import_metadata(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |table| -> table:
                    if not semantic_is_synthetic_unknown_import_marker(annotation) and (annotation.owner == "__from_member" or annotation.owner == "__from_src" or annotation.name == "__using_alias" or annotation.name == "__using_alias_target" or annotation.name == "__binding_wildcard_import"):
                        normalized: mutable Ast::EnumAnnotation = annotation
                        if annotation.name == "__using_alias_target":
                            rebind canonical_target: sview @source, table = binding_resolve_module_alias_target(annotation.owner, annotation.module, annotation.offset, table)
                            normalized <- annotation{owner = canonical_target}
                        table.binding_import_annotations <- table.binding_import_annotations.push(normalized)

        def unknown_binding_capabilities() -> BindingCapabilities:
            BindingCapabilities{known: false, borrowed: false, writable: false, linear_mutable: false, declaration_id: DeclId{value: INVALID_DECL_ID_VALUE}}

        # Select an alias in the nearest lexical scope. The two parser rows must
        # agree on scope AND byte offset, not merely line number. Duplicate alias
        # declarations remain ambiguous even when their targets happen to agree.
        def binding_module_alias_row(name: sview, scope: sview, table: SymbolTable&) -> u32:
            can Abort.Panic:
                best: mutable u32 = SYMBOL_INDEX_ROW_NONE
                best_rank: mutable usize = 0
                ambiguous: mutable bool = false
                for index in 0..<table.binding_import_annotations.count |best, best_rank, ambiguous|:
                    annotation: Ast::EnumAnnotation = table.binding_import_annotations[index]
                    continue if annotation.name != "__using_alias" or annotation.owner != name or not named_type_owner_is_lexical(annotation.module, scope)
                    rank: usize = annotation.module.len + 1
                    if best == SYMBOL_INDEX_ROW_NONE or rank > best_rank:
                        best <- index.u32()
                        best_rank <- rank
                        ambiguous <- false
                    elif rank == best_rank:
                        ambiguous <- true
                for annotation in table.possible_import_annotations |best, best_rank, ambiguous, name, scope|:
                    continue if annotation.name != "__using_alias" or annotation.owner != name or not named_type_owner_is_lexical(annotation.module, scope)
                    rank: usize = annotation.module.len + 1
                    return BINDING_MODULE_ALIAS_ROW_AMBIGUOUS if best == SYMBOL_INDEX_ROW_NONE or rank >= best_rank
                return BINDING_MODULE_ALIAS_ROW_AMBIGUOUS if ambiguous else best

        # Alias declarations canonicalize through earlier aliases only. Parser
        # annotations carry the source offset that separates an earlier alias from a
        # later declaration with the same visible name.
        def binding_module_alias_row_before(name: sview, scope: sview, before_offset: u32, table: SymbolTable&) -> u32:
            can Abort.Panic:
                best: mutable u32 = SYMBOL_INDEX_ROW_NONE
                best_rank: mutable usize = 0
                ambiguous: mutable bool = false
                for index in 0..<table.binding_import_annotations.count |best, best_rank, ambiguous, before_offset|:
                    annotation: Ast::EnumAnnotation = table.binding_import_annotations[index]
                    continue if annotation.name != "__using_alias" or annotation.owner != name or annotation.offset >= before_offset or not named_type_owner_is_lexical(annotation.module, scope)
                    rank: usize = annotation.module.len + 1
                    if best == SYMBOL_INDEX_ROW_NONE or rank > best_rank:
                        best <- index.u32()
                        best_rank <- rank
                        ambiguous <- false
                    elif rank == best_rank:
                        ambiguous <- true
                for annotation in table.possible_import_annotations |best, best_rank, ambiguous, name, scope, before_offset|:
                    continue if annotation.name != "__using_alias" or annotation.owner != name or annotation.offset >= before_offset or not named_type_owner_is_lexical(annotation.module, scope)
                    rank: usize = annotation.module.len + 1
                    return BINDING_MODULE_ALIAS_ROW_AMBIGUOUS if best == SYMBOL_INDEX_ROW_NONE or rank >= best_rank
                return BINDING_MODULE_ALIAS_ROW_AMBIGUOUS if ambiguous else best

        # FNV-1a (name_hash) of `prefix[0..prefix_length) ++ "::" ++ target`, or of `target`
        # alone when prefix_length is 0, hashed piecewise so no candidate name is allocated.
        def binding_module_candidate_hash(prefix: sview, prefix_length: usize, target: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = SEMANTIC_HASH_OFFSET
                for offset in 0..<prefix_length |hash, prefix|:
                    hash <- (hash ^ prefix[offset].u64()) * SEMANTIC_HASH_PRIME
                if prefix_length > 0:
                    hash <- (hash ^ 58.u64()) * SEMANTIC_HASH_PRIME
                    hash <- (hash ^ 58.u64()) * SEMANTIC_HASH_PRIME
                for offset in 0..<target.len |hash, target|:
                    hash <- (hash ^ target[offset].u64()) * SEMANTIC_HASH_PRIME
                return hash

        def binding_module_path_join(parent: sview, child: sview @source, table: lmut SymbolTable) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                return child if parent == ""
                bytes: mutable darray[u8] = []
                for offset in 0..<parent.len |bytes, parent|:
                    bytes.push(parent[offset])
                bytes.push(58)
                bytes.push(58)
                for offset in 0..<child.len |bytes, child|:
                    bytes.push(child[offset])
                return intern_joined_text(bytes, table)

        def binding_module_symbol_is_using_alias(symbol: Symbol, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for annotation in table.binding_import_annotations:
                    # Alias symbols are appended after declaration collection, when
                    # `table.current_module` has been restored to the root. Their module
                    # provenance therefore lives in the parser annotation, while the
                    # symbol's source token identity is its name/line/offset.
                    return true if annotation.name == "__using_alias" and annotation.owner == symbol.name and annotation.line == symbol.line and annotation.offset == symbol.offset
                return false

        def binding_module_path_matches_child(candidate: sview, parent: sview, child: sview) -> bool:
            can Abort.Panic:
                expected_length: usize = parent.len + 2.usize() + child.len
                return false if parent == "" or child == "" or candidate.len != expected_length
                for index in 0..<parent.len |candidate, parent|:
                    return false if candidate[index] != parent[index]
                return false if candidate[parent.len] != 58 or candidate[parent.len + 1.usize()] != 58
                for index in 0..<child.len |candidate, parent, child|:
                    return false if candidate[parent.len + 2.usize() + index] != child[index]
                return true

        # A module symbol matches `target` only when its name is `target` itself or
        # `ANCESTOR::target` for `scope` or one of its `::` ancestors. That is a handful of
        # candidate names, so probe the symbol name index for each instead of scanning every
        # symbol in the unit (this ran once per import annotation per nominal lookup). Each
        # chain row is still checked with the original predicates, and a row is counted only
        # under the candidate whose LENGTH equals its name's, so a hash collision between two
        # candidates can neither drop nor double-count a module.
        def binding_import_module_owner(target: sview, scope: sview, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return "" if target == ""
                # Built on the first row that survives the kind/length test: most calls find
                # none, and allocating here cost a region setup and teardown per call.
                target_parts: mutable darray[sview] = []
                target_length: usize = target.len
                scope_length: usize = scope.len
                owner: mutable sview = ""
                best_rank: mutable usize = 0
                ambiguous: mutable bool = false
                # Candidate prefix lengths: 0 (absolute), every `::` boundary inside scope, and scope itself.
                prefix_length: mutable usize = 0
                done: mutable bool = false
                while not done |prefix_length, done, owner, best_rank, ambiguous, target_parts, target, target_length, scope, scope_length, table|:
                    candidate_length: usize = (prefix_length + 2.usize() + target_length) if prefix_length > 0 else target_length
                    row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    row <- head if table.symbol_name_head.get(binding_module_candidate_hash(scope, prefix_length, target)) is head
                    while row != SYMBOL_INDEX_ROW_NONE |row, owner, best_rank, ambiguous, target_parts, target, scope, candidate_length, table|:
                        symbol: Symbol = table.symbols[row.usize()]
                        concrete_module: bool = symbol.kind == SymbolKind.Module and not binding_module_symbol_is_using_alias(symbol, table)
                        target_parts.push(target) if target_parts.count == 0 and concrete_module and symbol.name.len == candidate_length
                        if concrete_module and symbol.name.len == candidate_length and (module_symbol_matches(symbol.name, "", target_parts, 0, 1) or module_symbol_matches_relative(symbol.name, scope, target_parts, 1)):
                            rank: usize = symbol.name.len + 1
                            if owner == "" or rank > best_rank:
                                owner <- symbol.name
                                best_rank <- rank
                                ambiguous <- false
                            elif rank == best_rank:
                                ambiguous <- true
                        row <- table.symbol_name_next[row.usize()]
                    # Advance to the next `::` boundary of scope, then scope itself, then stop.
                    if prefix_length >= scope_length:
                        done <- true
                    else:
                        next: mutable usize = prefix_length + 1.usize()
                        found: mutable bool = false
                        while not found and next < scope_length |next, found, scope, scope_length|:
                            if next + 1.usize() < scope_length and scope[next] == 58 and scope[next + 1.usize()] == 58:
                                found <- true
                            else:
                                next <- next + 1.usize()
                        prefix_length <- next
                return "" if ambiguous else owner

        # Canonicalize a `using ... as Alias` target from its declaration scope. Only
        # aliases declared earlier may expand; an ordinary module target remains scoped
        # even when only a same-named root module exists. Keeping that canonical path lets
        # a missing alias candidate fall through to the raw qualifier spelling.
        def binding_resolve_module_alias_target(target: sview @source, scope: sview, before_offset: u32, table: lmut SymbolTable, depth: u32 = 0) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                return "" if target == "" or depth >= BINDING_CAPABILITY_MAX_RESOLUTION_DEPTH
                separator: mutable usize = target.len
                while index + 1.usize() < target.len |index: mutable usize = 0.usize(), separator, target|:
                    if target[index] == 58 and target[index + 1.usize()] == 58:
                        separator <- index
                        break
                    index <- index + 1.usize()
                alias_name: sview = string_view_slice(target, 0, separator.i64())
                alias_row: u32 = binding_module_alias_row_before(alias_name, scope, before_offset, table)
                return "" if alias_row == BINDING_MODULE_ALIAS_ROW_AMBIGUOUS
                if alias_row == SYMBOL_INDEX_ROW_NONE:
                    rebind scoped_target: sview @source, table = binding_module_path_join(scope, target, table)
                    return scoped_target
                alias: Ast::EnumAnnotation = table.binding_import_annotations[alias_row.usize()]
                alias_target: mutable sview @source = ""
                alias_target_count: mutable usize = 0
                for annotation in table.binding_import_annotations |alias, alias_target, alias_target_count|:
                    if annotation.name == "__using_alias_target" and annotation.module == alias.module and annotation.line == alias.line and annotation.offset == alias.offset:
                        alias_target <- annotation.owner
                        alias_target_count <- alias_target_count + 1.usize()
                return "" if alias_target_count != 1 or alias_target == ""
                rebind resolved_target: sview @source, table = binding_resolve_module_alias_target(alias_target, alias.module, alias.offset, table, depth + 1)
                return "" if resolved_target == ""
                return resolved_target if separator == target.len
                suffix: sview @source = string_view_slice(target, separator + 2.usize(), target.len.i64())
                rebind joined_target: sview @source, table = binding_module_path_join(resolved_target, suffix, table)
                return joined_target

        # Resolve a qualified nominal through one stage of name lookup. Stage0 checks
        # enclosing namespaces first, then a visible alias, then the raw root spelling.
        # Keeping those stages separate matters when a root alias and a nearer concrete
        # module share a name.
        def binding_nominal_qualified_candidate(name: sview, qualifier_parts: darray[sview]&, scope: sview, table: SymbolTable&, include_constants: bool, match_kind: u32, alias_owner: sview, out_ambiguous: mutable bool&) -> u32:
            can Abort.Panic:
                best: mutable u32 = SYMBOL_INDEX_ROW_NONE
                best_rank: mutable usize = 0
                out_ambiguous <- false
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE |row, best, best_rank, out_ambiguous|:
                    symbol: Symbol = table.symbols[row.usize()]
                    nominal: bool = symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (include_constants and symbol.kind == SymbolKind.Const)
                    visible: mutable bool = false
                    if match_kind == 0:
                        visible <- module_symbol_matches_relative(symbol.module_owner, scope, qualifier_parts, qualifier_parts.count)
                    elif match_kind == 1:
                        visible <- symbol.module_owner == alias_owner if qualifier_parts.count == 1
                        visible <- module_symbol_matches(symbol.module_owner, alias_owner, qualifier_parts, 1, qualifier_parts.count) if qualifier_parts.count > 1
                    else:
                        visible <- module_symbol_matches(symbol.module_owner, "", qualifier_parts, 0, qualifier_parts.count)
                    if nominal and symbol.name == name and visible:
                        rank: usize = symbol.module_owner.len + 1
                        if best == SYMBOL_INDEX_ROW_NONE or rank > best_rank:
                            best <- row
                            best_rank <- rank
                            out_ambiguous <- false
                        elif rank == best_rank:
                            out_ambiguous <- true
                    row <- table.symbol_name_next[row.usize()]
                return SYMBOL_INDEX_ROW_NONE if out_ambiguous == true else best

        # Resolve a nominal head, never guess through equal-rank declarations.
        # Generic-alias applications still need substitution metadata.
        def binding_nominal_declaration(expression: Ast::Expr, scope: sview, table: SymbolTable&, include_constants: bool = false) -> u32:
            can Memory.Allocate, Abort.Panic:
                name: mutable sview = ""
                qualifier_parts: mutable darray[sview] = []
                qualifier_dots: mutable darray[bool] = []
                qualified: mutable bool = false
                match expression:
                    Expr.Ident(ident, _):
                        name <- ident
                    Expr.Scope(base, member, _):
                        name <- member
                        return SYMBOL_INDEX_ROW_NONE if:
                            not type_path_collect(base, qualifier_parts, qualifier_dots)
                            qualifier_parts.count == 0 or any dotted in qualifier_dots where dotted
                        qualified <- true
                    _:
                        return SYMBOL_INDEX_ROW_NONE
                if qualified:
                    lexical_ambiguous: mutable bool = false
                    lexical_row: u32 = binding_nominal_qualified_candidate(name, qualifier_parts, scope, table, include_constants, 0, "", lexical_ambiguous)
                    return SYMBOL_INDEX_ROW_NONE if lexical_ambiguous
                    return lexical_row if lexical_row != SYMBOL_INDEX_ROW_NONE
                    alias_row: u32 = binding_module_alias_row(qualifier_parts[0], scope, table)
                    return SYMBOL_INDEX_ROW_NONE if alias_row == BINDING_MODULE_ALIAS_ROW_AMBIGUOUS
                    if alias_row != SYMBOL_INDEX_ROW_NONE:
                        alias: Ast::EnumAnnotation = table.binding_import_annotations[alias_row.usize()]
                        target: mutable sview = ""
                        target_count: mutable usize = 0
                        for annotation in table.binding_import_annotations |target, target_count|:
                            if annotation.name == "__using_alias_target" and annotation.module == alias.module and annotation.line == alias.line and annotation.offset == alias.offset:
                                target <- annotation.owner
                                target_count <- target_count + 1
                        return SYMBOL_INDEX_ROW_NONE if target_count != 1 or target == ""
                        # Metadata already stores the declaration-scope canonical target,
                        # including when that target has no matching module declaration.
                        alias_owner: sview = target
                        return SYMBOL_INDEX_ROW_NONE if alias_owner == ""
                        alias_ambiguous: mutable bool = false
                        alias_candidate: u32 = binding_nominal_qualified_candidate(name, qualifier_parts, scope, table, include_constants, 1, alias_owner, alias_ambiguous)
                        return SYMBOL_INDEX_ROW_NONE if alias_ambiguous
                        return alias_candidate if alias_candidate != SYMBOL_INDEX_ROW_NONE
                    raw_ambiguous: mutable bool = false
                    raw_candidate: u32 = binding_nominal_qualified_candidate(name, qualifier_parts, scope, table, include_constants, 2, "", raw_ambiguous)
                    return SYMBOL_INDEX_ROW_NONE if raw_ambiguous else raw_candidate
                row: mutable u32 = symbol_chain_head(table, name)
                best: mutable u32 = SYMBOL_INDEX_ROW_NONE
                best_rank: mutable usize = 0
                ambiguous: mutable bool = false
                while row != SYMBOL_INDEX_ROW_NONE |row, best, best_rank, ambiguous|:
                    symbol: Symbol = table.symbols[row.usize()]
                    nominal: bool = symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (include_constants and symbol.kind == SymbolKind.Const)
                    visible: bool = named_type_owner_is_lexical(symbol.module_owner, scope)
                    if nominal and symbol.name == name and visible:
                        rank: usize = symbol.module_owner.len + 1
                        if best == SYMBOL_INDEX_ROW_NONE or rank > best_rank:
                            best <- row
                            best_rank <- rank
                            ambiguous <- false
                        elif rank == best_rank:
                            ambiguous <- true
                    row <- table.symbol_name_next[row.usize()]
                # Non-root lexical declarations win before imports. Root declarations
                # remain fallback candidates; unresolved import conflicts fail closed.
                return SYMBOL_INDEX_ROW_NONE if not qualified and best_rank > 1 and ambiguous
                return best if not qualified and best_rank > 1
                possible_import_match: bool =
                    semantic_possible_import_may_select_type(table, name, SymbolKind.Struct, scope, include_constants) or
                    semantic_possible_import_may_select_type(table, name, SymbolKind.Enum, scope, include_constants) or
                    semantic_possible_import_may_select_type(table, name, SymbolKind.Alias, scope, include_constants)
                return SYMBOL_INDEX_ROW_NONE if not qualified and possible_import_match
                if not qualified:
                    for annotation in table.binding_import_annotations |best, best_rank, ambiguous|:
                        wildcard: bool = annotation.name == "__binding_wildcard_import"
                        selective: bool = annotation.owner == "__from_member" and annotation.name == name
                        continue if (not wildcard and not selective) or not named_type_owner_is_lexical(annotation.module, scope)
                        # Imports are combined across visible lexical scopes, not
                        # overridden by a nearer wildcard. Root names are fallback.
                        rank: usize = 2
                        continue if rank < best_rank
                        target: mutable sview = ""
                        target_count: mutable usize = 0
                        for source in table.binding_import_annotations |target, target_count|:
                            if source.owner == "__from_src" and source.module == annotation.module and source.line == annotation.line and source.offset == annotation.offset:
                                target <- source.name
                                target_count <- target_count + 1
                        if wildcard:
                            target <- annotation.owner
                            target_count <- 1
                        owner: sview = binding_import_module_owner(target, annotation.module, table)
                        candidate: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        duplicate: mutable bool = false
                        imported_row: mutable u32 = symbol_chain_head(table, name)
                        while imported_row != SYMBOL_INDEX_ROW_NONE |candidate, duplicate, imported_row|:
                            symbol: Symbol = table.symbols[imported_row.usize()]
                            if target_count == 1 and owner != "" and symbol.module_owner == owner and symbol.name == name and (symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (include_constants and symbol.kind == SymbolKind.Const)):
                                duplicate <- true if candidate != SYMBOL_INDEX_ROW_NONE
                                candidate <- imported_row
                            imported_row <- table.symbol_name_next[imported_row.usize()]
                        candidate <- SYMBOL_INDEX_ROW_NONE if duplicate
                        # A resolved wildcard module that does not declare this member
                        # contributes nothing; it must not mask another import or local.
                        continue if wildcard and owner != "" and candidate == SYMBOL_INDEX_ROW_NONE and not duplicate
                        if rank > best_rank:
                            best <- candidate
                            best_rank <- rank
                            ambiguous <- candidate == SYMBOL_INDEX_ROW_NONE
                        elif rank == best_rank:
                            ambiguous <- true if candidate == SYMBOL_INDEX_ROW_NONE or candidate != best
                return SYMBOL_INDEX_ROW_NONE if ambiguous else best

        def resolve_binding_capabilities(expression: Ast::Expr, scope: sview, visited: mutable darray[u32]&, table: lmut SymbolTable, depth: u32 = 0) -> BindingCapabilities:
            can Memory.Allocate, Abort.Panic:
                return unknown_binding_capabilities() if depth >= BINDING_CAPABILITY_MAX_RESOLUTION_DEPTH
                match expression:
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        rebind inner_caps: BindingCapabilities, table = resolve_binding_capabilities(inner, scope, visited, table, depth + 1)
                        return inner_caps
                    Expr.Unary(operator, inner, _):
                        rebind result: BindingCapabilities, table = resolve_binding_capabilities(inner, scope, visited, table, depth + 1)
                        flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(result.borrowed, result.writable, result.linear_mutable, operator == TokenKind.Ampersand, operator == TokenKind.Lmut, operator == TokenKind.Mutable, type_is_mutable(inner))
                        return BindingCapabilities{known: result.known, borrowed: flags.borrowed, writable: flags.writable, linear_mutable: flags.linear_mutable, declaration_id: result.declaration_id}
                    _:
                        pass
                head: mutable Ast::Expr = expression
                applied: mutable bool = false
                match expression:
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _):
                        head <- base
                        applied <- true
                    Expr.Ident(name, _):
                        primitive: InferType = type_of_name(name)
                        if primitive.kind != SemTypeKind.Named and primitive.kind != SemTypeKind.Unknown:
                            return BindingCapabilities{known: true, borrowed: false, writable: false, linear_mutable: false, declaration_id: DeclId{value: INVALID_DECL_ID_VALUE}}
                    _:
                        pass
                row: u32 = binding_nominal_declaration(head, scope, table)
                return unknown_binding_capabilities() if row == SYMBOL_INDEX_ROW_NONE
                symbol: Symbol = table.symbols[row.usize()]
                if symbol.kind != SymbolKind.Alias:
                    return BindingCapabilities{known: true, borrowed: false, writable: false, linear_mutable: false, declaration_id: symbol.id}
                return unknown_binding_capabilities() if applied or any previous in visited where previous == symbol.id.value
                visited.push(symbol.id.value)
                alias_count: usize = table.type_alias_declarations.count
                for index in 0..<alias_count |table, visited, index|:
                    alias: TypeAliasDeclaration = table.type_alias_declarations[index]
                    if alias.declaration_id.value == symbol.id.value:
                        rebind target_caps: BindingCapabilities, table = resolve_binding_capabilities(alias.target, alias.module_owner, visited, table, depth + 1)
                        return target_caps
                return unknown_binding_capabilities()
