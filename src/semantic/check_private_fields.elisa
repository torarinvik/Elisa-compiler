extend Semantic:
    private:
        def pft_walk_expression(expression: Ast::Expr, scope: sview, declarations: darray[Ast::Decl]&, table: lmut SymbolTable, bindings: mutable darray[PrivateFieldBinding]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- pft_walk_expression(left, scope, declarations, table, bindings)
                        table <- pft_walk_expression(right, scope, declarations, table, bindings) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- pft_walk_expression(callee, scope, declarations, table, bindings)
                        for argument in arguments |table|:
                            table <- pft_walk_expression(argument, scope, declarations, table, bindings)
                    Expr.Field(object, field, line):
                        row: i64 = pft_field(pft_value(object, bindings, scope, declarations, table), field, declarations, table)
                        table <- pft_report(row, line, scope, table)
                        table <- pft_walk_expression(object, scope, declarations, table, bindings)
                    Expr.Scope(base, name, line):
                        table <- pft_walk_expression(base, scope, declarations, table, bindings)
                    Expr.Index(object, index, line):
                        table <- pft_walk_expression(object, scope, declarations, table, bindings)
                        table <- pft_walk_expression(index, scope, declarations, table, bindings) if not index_receiver_is_type_application(object)
                    Expr.Move(operand, line) | Expr.RegionNew(operand, _, line):
                        table <- pft_walk_expression(operand, scope, declarations, table, bindings)
                    Expr.Unary(operator, operand, line):
                        table <- pft_walk_expression(operand, scope, declarations, table, bindings)
                    Expr.Paren(inner, line):
                        table <- pft_walk_expression(inner, scope, declarations, table, bindings)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- pft_walk_expression(element, scope, declarations, table, bindings)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- pft_walk_expression(element, scope, declarations, table, bindings)
                    Expr.Slice(object, low, high, line):
                        table <- pft_walk_expression(object, scope, declarations, table, bindings)
                        table <- pft_walk_expression(low, scope, declarations, table, bindings)
                        table <- pft_walk_expression(high, scope, declarations, table, bindings)
                    Expr.IndexN(object, arguments, line):
                        table <- pft_walk_expression(object, scope, declarations, table, bindings)
                        for argument in arguments |table|:
                            table <- pft_walk_expression(argument, scope, declarations, table, bindings) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- pft_walk_expression(element, scope, declarations, table, bindings)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- pft_walk_expression(entry.key, scope, declarations, table, bindings)
                            table <- pft_walk_expression(entry.value, scope, declarations, table, bindings)
                    Expr.Construct(type_expression, fields, line):
                        target: PrivateFieldType = pft_resolve(PrivateFieldType{expression: type_expression, owner: scope}, declarations, table)
                        for index in 0..<table.struct_field_owner.count |table|:
                            if pft_owner_matches(target.expression, table.struct_field_owner[index], struct_field_module_at(table, index), target.owner, table):
                                table <- pft_report(index.i64(), line, scope, table)
                        for field in fields |table|:
                            table <- pft_walk_expression(field.value, scope, declarations, table, bindings)
                    Expr.RecordUpdate(base, fields, line):
                        table <- pft_walk_expression(base, scope, declarations, table, bindings)
                        for field in fields |table|:
                            row: i64 = pft_field(pft_value(base, bindings, scope, declarations, table), field.name, declarations, table)
                            table <- pft_report(row, line, scope, table)
                            table <- pft_walk_expression(field.value, scope, declarations, table, bindings)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- pft_walk_expression(condition, scope, declarations, table, bindings)
                        table <- pft_walk_expression(then_expr, scope, declarations, table, bindings)
                        table <- pft_walk_expression(else_expr, scope, declarations, table, bindings)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- pft_walk_expression(iterable, scope, declarations, table, bindings)
                        table <- pft_walk_expression(condition, scope, declarations, table, bindings)
                        table <- pft_walk_expression(body, scope, declarations, table, bindings)
                    Expr.Lambda(parameters, body, line):
                        mark: usize = bindings.count
                        for parameter in parameters |bindings|:
                            bindings.push(PrivateFieldBinding{name: parameter, value_type: pft_unknown()})
                        table <- pft_walk_statements(body, scope, declarations, table, bindings)
                        bindings <- bindings.truncate(mark)
                    Expr.Block(statements, value, captures, line):
                        mark: usize = bindings.count
                        table <- pft_walk_statements(statements, scope, declarations, table, bindings)
                        table <- pft_walk_expression(value, scope, declarations, table, bindings)
                        bindings <- bindings.truncate(mark)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- pft_walk_expression(scrutinee, scope, declarations, table, bindings)
                        value_type: PrivateFieldType = pft_value(scrutinee, bindings, scope, declarations, table)
                        for arm in arms |table, bindings|:
                            mark: usize = bindings.count
                            table <- pft_pattern(arm.pattern, value_type, arm.pos, scope, declarations, table, bindings)
                            table <- pft_walk_expression(arm.guard, scope, declarations, table, bindings)
                            table <- pft_walk_statements(arm.body, scope, declarations, table, bindings)
                            bindings <- bindings.truncate(mark)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        def pft_walk_scoped(statements: darray[Ast::Stmt], scope: sview, declarations: darray[Ast::Decl]&, table: lmut SymbolTable, bindings: mutable darray[PrivateFieldBinding]&) -> void:
            can Memory.Allocate, Abort.Panic:
                mark: usize = bindings.count
                table <- pft_walk_statements(statements, scope, declarations, table, bindings)
                bindings <- bindings.truncate(mark)

        # `zeroed` bypasses every field initializer, so it must not provide a side door
        # around a module-private field's constructor boundary. Check the annotated nominal
        # type directly; unlike an ordinary field read, this reports the private member even
        # when the source subsequently touches only a public field.
        def pft_check_zeroed_private_fields(type_expression: Ast::Expr, position: Ast::Pos, scope: sview, declarations: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                target: PrivateFieldType = pft_resolve(PrivateFieldType{expression: type_expression, owner: scope}, declarations, table)
                for row in 0..<table.struct_field_owner.count |table|:
                    if table.struct_field_private[row] and pft_owner_matches(target.expression, table.struct_field_owner[row], struct_field_module_at(table, row), target.owner, table):
                        table <- pft_report(row.i64(), position, scope, table)

        def pft_walk_statements(statements: darray[Ast::Stmt], scope: sview, declarations: darray[Ast::Decl]&, table: lmut SymbolTable, bindings: mutable darray[PrivateFieldBinding]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, bindings|:
                    match statement:
                        Stmt.Expr(expression, _):
                            table <- pft_walk_expression(expression, scope, declarations, table, bindings)
                        Stmt.VarDecl(name, annotation, value, line):
                            if zeroed_value_is_zeroed(value):
                                table <- pft_check_zeroed_private_fields(annotation, line, scope, declarations, table)
                            table <- pft_walk_expression(value, scope, declarations, table, bindings)
                            value_type: PrivateFieldType = pft_value(value, bindings, scope, declarations, table) if annotation is Expr.Absent or annotation is Expr.Invalid else PrivateFieldType{expression: annotation, owner: scope}
                            bindings.push(PrivateFieldBinding{name: name, value_type: value_type})
                        Stmt.Assign(target, operator, value, _):
                            table <- pft_walk_expression(value, scope, declarations, table, bindings)
                            if operator == TokenKind.Assign:
                                if target is Expr.Ident(name, _):
                                    value_type: PrivateFieldType = pft_value(value, bindings, scope, declarations, table)
                                    bindings.push(PrivateFieldBinding{name: name, value_type: value_type})
                            else:
                                table <- pft_walk_expression(target, scope, declarations, table, bindings)
                        Stmt.Return(value, _):
                            table <- pft_walk_expression(returned, scope, declarations, table, bindings) if value is returned
                        Stmt.Contract(_, value, _):
                            table <- pft_walk_expression(value, scope, declarations, table, bindings)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- pft_walk_expression(condition, scope, declarations, table, bindings)
                            table <- pft_walk_scoped(then_body, scope, declarations, table, bindings)
                            table <- pft_walk_scoped(else_body, scope, declarations, table, bindings)
                        Stmt.While(condition, body, _):
                            table <- pft_walk_expression(condition, scope, declarations, table, bindings)
                            table <- pft_walk_scoped(body, scope, declarations, table, bindings)
                        Stmt.For(_, variables, iterable, body, _):
                            table <- pft_walk_expression(iterable, scope, declarations, table, bindings)
                            mark: usize = bindings.count
                            element: PrivateFieldType = pft_element(pft_value(iterable, bindings, scope, declarations, table))
                            for name in variables |bindings|:
                                bindings.push(PrivateFieldBinding{name: name, value_type: element})
                            table <- pft_walk_statements(body, scope, declarations, table, bindings)
                            bindings <- bindings.truncate(mark)
                        Stmt.Block(_, _, binding, body, _):
                            mark: usize = bindings.count
                            bindings.push(PrivateFieldBinding{name: binding, value_type: pft_unknown()}) if binding != ""
                            table <- pft_walk_statements(body, scope, declarations, table, bindings)
                            bindings <- bindings.truncate(mark)
                        Stmt.Match(value, arms, _):
                            table <- pft_walk_expression(value, scope, declarations, table, bindings)
                            value_type: PrivateFieldType = pft_value(value, bindings, scope, declarations, table)
                            for arm in arms |table, bindings|:
                                mark: usize = bindings.count
                                table <- pft_pattern(arm.pattern, value_type, arm.pos, scope, declarations, table, bindings)
                                table <- pft_walk_expression(arm.guard, scope, declarations, table, bindings)
                                table <- pft_walk_statements(arm.body, scope, declarations, table, bindings)
                                bindings <- bindings.truncate(mark)
                        _:
                            pass

        def pft_walk_declarations(items: darray[Ast::Decl]&, scope: sview, declarations: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for item in items |table|:
                    match item:
                        Decl.Func(_, parameters, _, body, _, _, _):
                            bindings: mutable darray[PrivateFieldBinding] = []
                            for parameter in parameters |bindings|:
                                bindings.push(PrivateFieldBinding{name: parameter.name, value_type: PrivateFieldType{expression: parameter.type_expression, owner: scope}})
                            table <- pft_walk_statements(body, scope, declarations, table, bindings)
                        Decl.Const(_, _, value, _, _):
                            bindings: mutable darray[PrivateFieldBinding] = []
                            table <- pft_walk_expression(value, scope, declarations, table, bindings)
                        Decl.Struct(_, members, _, _, _, invariants, _):
                            bindings: mutable darray[PrivateFieldBinding] = []
                            for member in members |table, bindings|:
                                table <- pft_walk_expression(member.default_value, scope, declarations, table, bindings) if member.has_default
                        Decl.Module(name, body, _):
                            table <- pft_walk_declarations(body, name, declarations, table)
                        Decl.Scoped(body, _):
                            table <- pft_walk_declarations(body, scope, declarations, table)
                        _:
                            pass

    public:
        def check_private_fields(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if any is_private in table.struct_field_private where is_private:
                    table <- pft_walk_declarations(file.top_decls, "", file.top_decls, table)
