# Stage1 semantic — statement bodies nested inside expression nodes. Kept separate from
# the top-level statement walk so the unsafe-operation visitor remains small enough to audit.

extend Semantic:
    private:
        def strict_unsafe_expression_statements(statements: darray[Ast::Stmt], array_params: darray[sview]&, index_params: darray[sview]&, mutable_params: darray[sview]&, ref_params: darray[sview]&, mutable_globals: darray[sview]&, local_names: darray[sview]&, checked_get_lines: darray[u32]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, position):
                            table <- strict_unsafe_expression(expression, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        Stmt.VarDecl(name, type_expression, value, position):
                            table <- strict_unsafe_expression(value, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        Stmt.Assign(target, operator, value, position):
                            table <- strict_unsafe_expression(target, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_unsafe_expression(value, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        Stmt.Return(value, position):
                            if value is returned:
                                table <- strict_unsafe_expression(returned, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        Stmt.If(condition, then_body, else_body, position):
                            table <- strict_unsafe_expression(condition, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_unsafe_expression_statements(then_body, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_unsafe_expression_statements(else_body, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        Stmt.While(condition, body, position):
                            table <- strict_unsafe_expression(condition, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_unsafe_expression_statements(body, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        Stmt.For(binding, variables, iterable, body, position):
                            table <- strict_unsafe_expression(iterable, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            loop_locals: mutable darray[sview] = [name for name in local_names]
                            loop_locals.extend(variables)
                            table <- strict_unsafe_expression_statements(body, array_params, index_params, mutable_params, ref_params, mutable_globals, loop_locals, checked_get_lines, active_grants, table)
                        Stmt.Match(scrutinee, arms, position):
                            table <- strict_unsafe_expression(scrutinee, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            for arm in arms |table|:
                                arm_locals: mutable darray[sview] = [name for name in local_names]
                                collect_pattern_binding_names(arm.pattern, arm_locals)
                                table <- strict_unsafe_expression(arm.guard, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, arm_locals, checked_get_lines, active_grants, table)
                                table <- strict_unsafe_expression_statements(arm.body, array_params, index_params, mutable_params, ref_params, mutable_globals, arm_locals, checked_get_lines, active_grants, table)
                        Stmt.Block(kind, clause, binding, body, position):
                            nested_grants: mutable darray[sview] = [grant for grant in active_grants]
                            block_locals: mutable darray[sview] = [name for name in local_names]
                            block_locals.push(binding) if binding != ""
                            nested_grants.extend(clause) if kind == "can" or kind == "trusted"
                            table <- strict_unsafe_expression_statements(body, array_params, index_params, mutable_params, ref_params, mutable_globals, block_locals, checked_get_lines, nested_grants, table)
                        Stmt.Contract(kind, expression, position):
                            table <- strict_unsafe_expression(expression, position.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        _:
                            pass
