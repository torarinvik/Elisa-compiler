# Packed-bit-group diagnostic (structural). A `flags: bitset:` / `layout: bitfield:` block
# whose captured members include two of the same name is rejected by stage0
# (`duplicate packed group member "X" in Struct.field`). The parser captures each group's
# members verbatim (`StructMember.bit_group_members`), so this is a pure name comparison —
# no type resolution, so it cannot false-fire.
#
# SOUND SUBSET: fires only on an exact byte-equal member-name collision within one group.
# The first occurrence of each name is kept; every later duplicate is reported once, matching
# stage0's per-duplicate placement. Groups with all-distinct names stay silent.
extend Semantic:
    private:
        def check_bit_group_of_struct(struct_name: sview, members: darray[Ast::StructMember], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for member in members |table| -> table:
                    group_kind: sview = member.bit_group_kind
                    if group_kind != "":
                        field_name: sview = member.name
                        group_members: darray[Ast::BitGroupMember] = member.bit_group_members
                        count: int = group_members.count
                        outer: mutable int = 0
                        while outer < count |table, outer|:
                            current_name: sview = group_members[outer].name
                            current_line: u32 = group_members[outer].line
                            # A duplicate is reported only against an *earlier* member so each
                            # collision fires exactly once (on the later occurrence).
                            is_dup: mutable bool = false
                            prior: mutable int = 0
                            while prior < outer |is_dup, prior|:
                                earlier_name: sview = group_members[prior].name
                                if earlier_name == current_name:
                                    is_dup <- true
                                prior <- prior + 1
                            if is_dup:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateBitGroupMember, name: current_name, line: current_line, expected: struct_name, actual: field_name})
                            outer <- outer + 1


        def check_duplicate_bit_group_member(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            table <- check_bit_group_of_struct(name, members, table)
                        Decl.Module(module_name, body, module_line):
                            table <- check_duplicate_bit_group_member(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_duplicate_bit_group_member(scoped_body, table)
                        _:
                            pass
