# A value `match` (`n = match k: 0: 100  _: "hello"`) requires all arms to yield the same type.
# When two arms produce LITERALS of incompatible categories — a string vs a number, or a bool vs
# a number — stage0 rejects the match. SOUND subset: only literal-result arms are compared, and
# only across category boundaries (numeric int/float/char are mutually adaptive, so never flagged
# against each other); any non-literal arm is skipped (its type is left to full inference).
extend Semantic:
    private:
        # The literal type NAME for a literal kind, as stage0 renders it in the arm-mismatch
        # message ("" for a non-literal / unknown).
        def match_literal_type_name(kind: sview) -> sview:
            can Abort.Panic:
                return when kind:
                    "int" -> "int"
                    "float" -> "f64"
                    "bool" -> "bool"
                    "char" -> "char"
                    "string" -> "static u8&"
                    _ -> sview("", 0, 0)

        # The comparability category of a literal kind: numeric kinds share one category (mutually
        # adaptive), string and bool are their own. "" for a non-literal.
        def match_literal_category(kind: sview) -> sview:
            can Abort.Panic:
                return when kind:
                    "int" -> "num"
                    "float" -> "num"
                    "char" -> "num"
                    "bool" -> "bool"
                    "string" -> "string"
                    _ -> sview("", 0, 0)

        # The literal kind an arm body yields: the last statement, if it is a bare literal
        # expression ("" otherwise).
        def match_arm_literal_kind(body: darray[Ast::Stmt]) -> sview:
            can Memory.Allocate, Abort.Panic:
                sview("", 0, 0) return if body.count == 0
                last: Ast::Stmt = body[body.count - 1]
                match last:
                    Stmt.Expr(expression, line):
                        return literal_kind_of(expression)
                    _:
                        return sview("", 0, 0)

        def match_literal_check_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Match(scrutinee, arms, line):
                        first_kind: mutable sview = sview("", 0, 0)
                        for arm in arms |first_kind, table|:
                            arm_kind: sview = match_arm_literal_kind(arm.body)
                            if arm_kind != "":
                                if first_kind == "":
                                    first_kind <- arm_kind
                                elif match_literal_category(arm_kind) != match_literal_category(first_kind):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MatchArmsIncompatible, name: "", line: line, expected: match_literal_type_name(first_kind), actual: match_literal_type_name(arm_kind), expected_count: 1})
                        table <- match_literal_check_expression(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- match_literal_check_statements(arm.body, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- match_literal_check_expression(left, table)
                        table <- match_literal_check_expression(right, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- match_literal_check_expression(operand, table)
                    Expr.Paren(inner, paren_line):
                        table <- match_literal_check_expression(inner, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- match_literal_check_expression(argument, table)
                    _:
                        pass

        def match_literal_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- match_literal_check_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- match_literal_check_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- match_literal_check_expression(value, table)
                        Stmt.Return(value, line):
                            table <- match_literal_check_expression(returned, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- match_literal_check_expression(condition, table)
                            table <- match_literal_check_statements(then_body, table)
                            table <- match_literal_check_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- match_literal_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- match_literal_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- match_literal_check_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- match_literal_check_statements(arm.body, table)
                        _:
                            pass

        def match_literal_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- match_literal_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- match_literal_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- match_literal_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_match_literal_arms(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- match_literal_walk(file.top_decls, table)
