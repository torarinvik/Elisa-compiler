# Effect rows on FUNCTION VALUES (stage0 FuncType.Permissions / AssignableTo).
#
# A function used as a VALUE carries its effect row — the sorted set of permission
# FAMILIES it declares (`can[Memory.Allocate]` -> Memory) or is inferred to use. stage0
# infers the row as a fixpoint over the body: every `can E:` block grant, every direct
# callee's row (externs included, through their declared `can[...]`), and the Global
# family whenever the body reads or writes a `global`. A `fn(...) -> R [can[...]]` TYPE
# carries its own row, and the two are compared wherever a function value meets such a
# type:
#
#   g: fn(i64) -> i64 = bump            # variable "g" expects fn(i64) -> i64, got fn(i64) -> i64 can[Global]
#   g <- bump                           # cannot assign fn(i64) -> i64 can[Global] to fn(i64) -> i64
#   return bump                         # return type expects fn(i64) -> i64, got ...
#   Holder{f: bump}                     # struct literal field "f" expects ..., got ...
#   apply(bump, 3)                      # argument 1 to "apply" expects ..., got ...
#
# Measured against stage0 (probes 2026-10-05): a binding, assignment, return and struct
# literal field require the rows to be EQUAL in both directions (a plain function is NOT
# accepted where `fn(...) can[Memory]` is expected); a CALL ARGUMENT accepts a narrower
# row (the value needs a SUBSET of what the parameter permits) and rejects a wider one.
# `can[Global]`, `can[Global.Write]` and `can[Global.Read]` all spell the one Global
# family. An operation without a grant (a bare `assert`, an undeclared darray literal,
# an index) adds nothing; a `can` block adds its clause even when its body never uses it.
# Method calls (`s.push(..)`) are not followed, matching the probes.
#
# stage1 had no effect row on function values at all, so every one of the shapes above
# built and ran (fuzz_findings/fn_value_effect_row_ignored*.elisa). The checker is purely
# syntactic: fn TYPES are `Expr.Lambda` nodes in type position whose row is recorded by
# the parser on `__fn_type_effect` (keyed by the lambda token's offset), and a function
# value is a bare identifier (or `M::name`) naming exactly one declared function, or a
# lambda literal (whose row is inferred from its body; stage0 spells it with the
# EXPECTED signature). Anything else is left to the other checks.
#
# The inferred rows live on the table (`fn_value_effect_owner`/`_ref`, one row per
# (function, ref) pair; `fn_value_effect_done` = functions whose rows are complete), like
# function_effect_source_*. A site reads its value's row as INDICES into those rows, so
# no table-owned sview is ever stored into a frame-local list — stage0's region analysis
# rejects that (a caller-owned darray memo tripped it three different ways).
extend Semantic:
    private:
        # The reserved memo owner under which a lambda literal's row is computed; the rows
        # are dropped again once the site has read them (see fver_check_site).
        def fver_lambda_owner() -> sview:
            return "__fn_value_lambda"

        # ---- family sets ---------------------------------------------------------------

        # Rows hold the effect REF as written (`Memory.Allocate`) and are read as FAMILIES
        # through effect_ref_family; one row per family (a computed family is a call result,
        # so storing it would be a region escape — the ref is stored instead).
        def fver_add_family(out: mutable darray[sview]&, effect_ref: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                family: sview = effect_ref_family(effect_ref)
                return if family == ""
                present: bool = any existing in out where existing == effect_ref
                out.push(effect_ref) if not present

        # Sort IN PLACE, lexically by family (stage0's sort.Strings over the family names).
        def fver_sort_families(families: mutable darray[sview]&) -> void:
            can Abort.Panic:
                for outer in 0..<families.count |families|:
                    position: mutable usize = outer
                    while position > 0.usize() |position, families|:
                        break if not effect_ref_less(effect_ref_family(families[position]), effect_ref_family(families[position - 1.usize()]))
                        swap: sview = families[position - 1.usize()]
                        families[position - 1.usize()] <- families[position]
                        families[position] <- swap
                        position <- position - 1.usize()

        # The memo rows of OWNER (indices into the table's fn_value_effect rows at or past
        # FIRST), sorted by family.
        def fver_owner_rows(owner: sview, first: usize, table: SymbolTable&, out: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while row < table.fn_value_effect_owner.count |row: usize = first, out|:
                    out.push(row) if table.fn_value_effect_owner[row] == owner and not (any previous in out where effect_ref_family(table.fn_value_effect_ref[previous]) == effect_ref_family(table.fn_value_effect_ref[row]))
                    row <- row + 1
                for outer in 0..<out.count |out|:
                    position: mutable usize = outer
                    while position > 0.usize() |position, out|:
                        break if not effect_ref_less(effect_ref_family(table.fn_value_effect_ref[out[position]]), effect_ref_family(table.fn_value_effect_ref[out[position - 1.usize()]]))
                        swap: usize = out[position - 1.usize()]
                        out[position - 1.usize()] <- out[position]
                        out[position] <- swap
                        position <- position - 1.usize()

        def fver_expected_has(expected: darray[sview]&, family: sview) -> bool:
            can Abort.Panic:
                return any existing in expected where effect_ref_family(existing) == family

        def fver_actual_has(actual: darray[usize]&, table: SymbolTable&, family: sview) -> bool:
            can Abort.Panic:
                return any row in actual where effect_ref_family(table.fn_value_effect_ref[row]) == family

        # actual ⊆ expected.
        def fver_actual_within(actual: darray[usize]&, expected: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for row in actual:
                    false return if not fver_expected_has(expected, effect_ref_family(table.fn_value_effect_ref[row]))
                return true

        # expected ⊆ actual.
        def fver_expected_within(expected: darray[sview]&, actual: darray[usize]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for existing in expected:
                    false return if not fver_actual_has(actual, table, effect_ref_family(existing))
                return true

        # ---- declaration lookups -------------------------------------------------------

        # ---- declaration name index (built once per pass) ------------------------------

        def fver_decl_row(table: SymbolTable&, name: sview) -> u32:
            can Abort.Panic:
                row: mutable u32 = head if table.fver_decl_heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, table, name|:
                    row return if table.fver_decl_names[row.usize()] == name
                    row <- table.fver_decl_next[row.usize()]
                return SYMBOL_INDEX_ROW_NONE

        # A new row's function slot holds DECLARATION as a placeholder until
        # fver_decl_has_function marks a real function declaration.
        def fver_decl_row_for(table: lmut SymbolTable, name: sview, declaration: Ast::Decl) -> u32:
            can Memory.Allocate, Abort.Panic:
                existing: u32 = fver_decl_row(table, name)
                existing return if existing != SYMBOL_INDEX_ROW_NONE
                hash: u64 = name_hash(name)
                row: u32 = table.fver_decl_names.count.u32()
                previous: u32 = head if table.fver_decl_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                table.fver_decl_names <- table.fver_decl_names.push(name)
                table.fver_decl_function_counts <- table.fver_decl_function_counts.push(0)
                table.fver_decl_struct_counts <- table.fver_decl_struct_counts.push(0)
                table.fver_decl_function <- table.fver_decl_function.push(declaration)
                table.fver_decl_struct <- table.fver_decl_struct.push(declaration)
                table.fver_decl_has_function <- table.fver_decl_has_function.push(false)
                table.fver_decl_next <- table.fver_decl_next.push(previous)
                table.fver_decl_heads <- table.fver_decl_heads.put(hash, row)
                return row

        # Same traversal as the per-name scans it replaces: functions and callable externs
        # count as functions, structs as structs, recursing through modules and scopes.
        def fver_index_declarations(declarations: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            row: u32 = fver_decl_row_for(table, name, declaration)
                            table.fver_decl_function_counts[row.usize()] <- table.fver_decl_function_counts[row.usize()] + 1
                            if not table.fver_decl_has_function[row.usize()]:
                                table.fver_decl_function[row.usize()] <- declaration
                                table.fver_decl_has_function[row.usize()] <- true
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if callable:
                                row: u32 = fver_decl_row_for(table, name, declaration)
                                table.fver_decl_function_counts[row.usize()] <- table.fver_decl_function_counts[row.usize()] + 1
                                if not table.fver_decl_has_function[row.usize()]:
                                    table.fver_decl_function[row.usize()] <- declaration
                                    table.fver_decl_has_function[row.usize()] <- true
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            row: u32 = fver_decl_row_for(table, name, declaration)
                            table.fver_decl_struct[row.usize()] <- declaration if table.fver_decl_struct_counts[row.usize()] == 0
                            table.fver_decl_struct_counts[row.usize()] <- table.fver_decl_struct_counts[row.usize()] + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- fver_index_declarations(&module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fver_index_declarations(&scoped_body, table)
                        _:
                            pass

        def fver_function_count(table: SymbolTable&, wanted: sview) -> u32:
            can Abort.Panic:
                row: u32 = fver_decl_row(table, wanted)
                0 return if row == SYMBOL_INDEX_ROW_NONE
                return table.fver_decl_function_counts[row.usize()]

        def fver_struct_count(table: SymbolTable&, wanted: sview) -> u32:
            can Abort.Panic:
                row: u32 = fver_decl_row(table, wanted)
                0 return if row == SYMBOL_INDEX_ROW_NONE
                return table.fver_decl_struct_counts[row.usize()]

        # ---- the inferred row of a function (table memo) -------------------------------

        # One row for TARGET, deduplicated by exact member ref. Every ref stored here is a literal, an
        # AST node's own text, or a table element bound to a local first (an element passed
        # beside the `lmut` table would alias it).
        def fver_add_memo(target: sview, effect_ref: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if target == ""
                family: sview = effect_ref_family(effect_ref)
                return if family == ""
                while row < table.fn_value_effect_owner.count |row: usize = 0|:
                    return if table.fn_value_effect_owner[row] == target and table.fn_value_effect_ref[row] == effect_ref
                    row <- row + 1
                table.fn_value_effect_owner <- table.fn_value_effect_owner.push(target)
                table.fn_value_effect_ref <- table.fn_value_effect_ref.push(effect_ref)

        # `can` block clauses anywhere in STATEMENTS, as TARGET's rows.
        def fver_inline_grants(expression: Ast::Expr, target: sview, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, firewalls: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                at: Ast::Pos = Ast::expr_pos(expression)
                while next_row > 0 |next_row: usize = inline_effect_limit(at.offset, inline_index), table| -> table:
                    row: usize = next_row - 1
                    next_row <- row
                    break if inline_index.prefix_ends[row] <= at.offset
                    continue if inline_index.ends[row] <= at.offset
                    grant: sview = annotations[inline_index.rows[row]].name
                    table <- fver_add_memo(target, grant, table) if not cov_ref_covered(annotations, firewalls, grant, 0)
                match expression:
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _) | Expr.Field(operand, _, _):
                        table <- fver_inline_grants(operand, target, annotations, inline_index, firewalls, table)
                    Expr.Binary(left, _, right, _) | Expr.Index(left, right, _) | Expr.Refinement(left, right, _):
                        table <- fver_inline_grants(left, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(right, target, annotations, inline_index, firewalls, table)
                    Expr.Call(base, arguments, _, _) | Expr.IndexN(base, arguments, _):
                        table <- fver_inline_grants(base, target, annotations, inline_index, firewalls, table)
                        for argument in arguments |table| -> table:
                            table <- fver_inline_grants(argument, target, annotations, inline_index, firewalls, table)
                    Expr.Slice(base, low, high, _):
                        table <- fver_inline_grants(base, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(low, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(high, target, annotations, inline_index, firewalls, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- fver_inline_grants(element, target, annotations, inline_index, firewalls, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- fver_inline_grants(entry.key, target, annotations, inline_index, firewalls, table)
                            table <- fver_inline_grants(entry.value, target, annotations, inline_index, firewalls, table)
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        match expression:
                            Expr.RecordUpdate(base, _, _):
                                table <- fver_inline_grants(base, target, annotations, inline_index, firewalls, table)
                            _:
                                pass
                        for field in fields |table| -> table:
                            table <- fver_inline_grants(field.value, target, annotations, inline_index, firewalls, table)
                    Expr.If(condition, yes, no, _):
                        table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(yes, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(no, target, annotations, inline_index, firewalls, table)
                    Expr.Match(value, arms, _) | Expr.Catch(value, arms, _):
                        table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        for arm in arms |table| -> table:
                            table <- fver_inline_grants(arm.guard, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&arm.body, target, annotations, inline_index, firewalls, table)
                    Expr.GetElse(value, recovery, _):
                        table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        table <- fver_block_grants(&recovery, target, annotations, inline_index, firewalls, table)
                    Expr.Comprehension(_, iterable, condition, body, _):
                        table <- fver_inline_grants(iterable, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(body, target, annotations, inline_index, firewalls, table)
                    Expr.Block(statements, value, _, _):
                        table <- fver_block_grants(&statements, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                    _:
                        pass

        def fver_block_grants(statements: darray[Ast::Stmt]&, target: sview, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, firewalls: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(value, _) | Stmt.Contract(_, value, _) | Stmt.VarDecl(_, _, value, _):
                            table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        Stmt.Return(value, _):
                            table <- fver_inline_grants(expression, target, annotations, inline_index, firewalls, table) if value is expression
                        Stmt.Assign(place, _, value, _):
                            table <- fver_inline_grants(place, target, annotations, inline_index, firewalls, table)
                            table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "can":
                                while index < clause.count |index: usize = 0, table| -> table:
                                    table <- fver_add_memo(target, clause[index], table) if not cov_ref_covered(annotations, firewalls, clause[index], 0)
                                    index <- index + 1
                            nested_firewalls: mutable darray[sview] = []
                            nested_firewalls.extend(firewalls)
                            nested_firewalls.extend(clause) if kind == "trusted"
                            table <- fver_block_grants(&body, target, annotations, inline_index, nested_firewalls, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&then_body, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&else_body, target, annotations, inline_index, firewalls, table)
                        Stmt.While(condition, body, line):
                            table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&body, target, annotations, inline_index, firewalls, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- fver_inline_grants(iterable, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&body, target, annotations, inline_index, firewalls, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- fver_inline_grants(scrutinee, target, annotations, inline_index, firewalls, table)
                            for arm in arms |table| -> table:
                                table <- fver_inline_grants(arm.guard, target, annotations, inline_index, firewalls, table)
                                table <- fver_block_grants(&arm.body, target, annotations, inline_index, firewalls, table)
                        _:
                            pass

        # TARGET's rows from one BODY: Global when it reads or writes a global, and every
        # unique direct callee's row. (The declared `can[...]` and the `can` block clauses
        # are recorded by the caller, which holds them rooted at the AST.)
        def fver_body_rows(body: darray[Ast::Stmt], locals: darray[sview]&, target: sview, declarations: darray[Ast::Decl]&, globals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, firewalls: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |table| -> table:
                    callees: mutable darray[sview] = []
                    direct: mutable darray[Ast::Stmt] = []
                    match statement:
                        Stmt.Block(_, _, _, _, _):
                            pass
                        Stmt.If(condition, _, _, at) | Stmt.While(condition, _, at):
                            direct.push(Stmt.Expr(condition, at))
                        Stmt.For(_, _, iterable, _, at):
                            direct.push(Stmt.Expr(iterable, at))
                        Stmt.Match(value, arms, at):
                            direct.push(Stmt.Expr(value, at))
                            for arm in arms |direct|:
                                direct.push(Stmt.Expr(arm.guard, at))
                        _:
                            direct.push(statement)
                    if globals.count > 0:
                        table <- fver_add_memo(target, "Global.Read", table) if gp_body_reads(direct, globals, locals) and not cov_ref_covered(annotations, firewalls, "Global.Read", 0)
                        table <- fver_add_memo(target, "Global.Write", table) if gp_body_writes(direct, globals, locals) and not cov_ref_covered(annotations, firewalls, "Global.Write", 0)
                    match statement:
                        Stmt.Block(kind, clause, _, nested_body, _):
                            nested_firewalls: mutable darray[sview] = []
                            nested_firewalls.extend(firewalls)
                            nested_firewalls.extend(clause) if kind == "trusted"
                            table <- fver_body_rows(nested_body, locals, target, declarations, globals, annotations, inline_index, nested_firewalls, table)
                        Stmt.If(condition, then_body, else_body, _):
                            gp_expression_calls(condition, callees)
                            table <- fver_body_rows(then_body, locals, target, declarations, globals, annotations, inline_index, firewalls, table)
                            table <- fver_body_rows(else_body, locals, target, declarations, globals, annotations, inline_index, firewalls, table)
                        Stmt.While(condition, nested_body, _):
                            gp_expression_calls(condition, callees)
                            table <- fver_body_rows(nested_body, locals, target, declarations, globals, annotations, inline_index, firewalls, table)
                        Stmt.For(_, _, iterable, nested_body, _):
                            gp_expression_calls(iterable, callees)
                            table <- fver_body_rows(nested_body, locals, target, declarations, globals, annotations, inline_index, firewalls, table)
                        Stmt.Match(scrutinee, arms, _):
                            gp_expression_calls(scrutinee, callees)
                            for arm in arms |table| -> table:
                                table <- fver_body_rows(arm.body, locals, target, declarations, globals, annotations, inline_index, firewalls, table)
                        _:
                            single_statement: darray[Ast::Stmt] = [statement]
                            gp_body_calls(single_statement, false, callees)
                    for callee in callees |table| -> table:
                        continue if any local in locals where local == callee
                        table <- fver_function_rows(callee, "", declarations, globals, annotations, inline_index, table)
                        limit: usize = table.fn_value_effect_owner.count
                        while row < limit |row: usize = 0, table| -> table:
                            if table.fn_value_effect_owner[row] == callee:
                                effect: sview = table.fn_value_effect_ref[row]
                                table <- fver_add_memo(target, effect, table) if not cov_ref_covered(annotations, firewalls, effect, 0)
                            row <- row + 1

        # Complete the rows of the function NAME (a free function or callable extern
        # declared exactly once) and merge them into TARGET's. An ambiguous or unknown name
        # contributes nothing. A function is marked done BEFORE its body is read, so a
        # recursive call graph terminates (a cycle member sees the partial row — never a
        # wider one than stage0's).
        def fver_function_rows(name: sview, target: sview, declarations: darray[Ast::Decl]&, globals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                finished: bool = any done in table.fn_value_effect_done where done == name
                if not finished:
                    return if fver_function_count(table, name) != 1
                    table <- fver_declared_rows(name, declarations, globals, annotations, inline_index, table)
                return if target == "" or target == name
                # The memo grows while it is read (TARGET's rows), so the scan is bounded by
                # the count at entry.
                limit: usize = table.fn_value_effect_owner.count
                while row < limit |row: usize = 0, table| -> table:
                    if table.fn_value_effect_owner[row] == name:
                        merged_ref: sview = table.fn_value_effect_ref[row]
                        table <- fver_add_memo(target, merged_ref, table)
                    row <- row + 1

        # NAME's own rows from its declaration (the memo stores the DECLARATION's name).
        def fver_declared_rows(name: sview, declarations: darray[Ast::Decl]&, globals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if function_name == name:
                                canonical_slot: usize = canonical_effect_function(function_name, module_scope, line.offset, table)
                                if canonical_slot < table.effect_canonical_function_name.count:
                                    table.fn_value_effect_done <- table.fn_value_effect_done.push(function_name)
                                    start: usize = table.effect_canonical_function_row_start[canonical_slot]
                                    end: usize = start + table.effect_canonical_function_row_count[canonical_slot]
                                    for row in start..<end |table| -> table:
                                        effect_ref: sview = table.effect_canonical_refs[table.effect_canonical_row_ref[row]]
                                        table <- fver_add_memo(function_name, effect_ref, table)
                                    continue
                                firewalls: darray[sview] = []
                                table.fn_value_effect_done <- table.fn_value_effect_done.push(function_name)
                                while index < effects.count |index: usize = 0, table| -> table:
                                    table <- fver_add_memo(function_name, effects[index], table)
                                    index <- index + 1
                                table <- fver_block_grants(&body, function_name, annotations, inline_index, firewalls, table)
                                locals: mutable darray[sview] = []
                                for parameter in parameters |locals|:
                                    locals.push(parameter.name)
                                collect_local_names(body, locals)
                                table <- fver_body_rows(body, locals, function_name, declarations, globals, annotations, inline_index, firewalls, table)
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if extern_name == name:
                                table.fn_value_effect_done <- table.fn_value_effect_done.push(extern_name)
                                # An extern's `can[...]` lives in the table's declared-effect rows
                                # (collect_extern_effects); "Permission" is its unknown placeholder.
                                while row < table.function_effect_owner.count |row: usize = 0, table| -> table:
                                    if table.function_effect_owner[row] == extern_name:
                                        extern_ref: sview = table.function_effect_name[row]
                                        table <- fver_add_memo(extern_name, extern_ref, table) if extern_ref != "Permission"
                                    row <- row + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- fver_declared_rows(name, module_body, globals, annotations, inline_index, table, canonical_effect_module(module_scope, module_name, table))
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fver_declared_rows(name, scoped_body, globals, annotations, inline_index, table, module_scope)
                        _:
                            pass

        # ---- fn TYPES ------------------------------------------------------------------

        # The `Expr.Lambda` a type position denotes, through `mutable` and parentheses.
        def fver_type_lambda(type_expression: Ast::Expr) -> Ast::Expr?:
            can Abort.Panic:
                match type_expression:
                    Expr.Lambda(params, body, pos):
                        return type_expression
                    Expr.Unary(operator, operand, pos):
                        if operator == TokenKind.Mutable:
                            return fver_type_lambda(operand)
                        return null
                    Expr.Paren(inner, pos):
                        return fver_type_lambda(inner)
                    _:
                        return null

        # The declared row of a fn TYPE: the `__fn_type_effect` rows the parser recorded at
        # the lambda token's offset.
        def fver_fn_type_families(lambda_pos: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while index < annotations.count |index: usize = 0, out|:
                    fver_add_family(out, annotations[index].name) if annotations[index].owner == "__fn_type_effect" and annotations[index].offset == lambda_pos.offset and annotations[index].line == lambda_pos.line
                    index <- index + 1

        def fver_push_expected_row(families: darray[sview]&, out: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if families.count == 0
                push_str(out, " can[")
                for index in 0..<families.count |out|:
                    push_str(out, ", ") if index > 0
                    push_sview(out, effect_ref_family(families[index]))
                push_str(out, "]")

        def fver_push_actual_row(rows: darray[usize]&, table: SymbolTable&, out: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if rows.count == 0
                push_str(out, " can[")
                for index in 0..<rows.count |out|:
                    push_str(out, ", ") if index > 0
                    push_sview(out, effect_ref_family(table.fn_value_effect_ref[rows[index]]))
                push_str(out, "]")

        # Spell a fn TYPE node as stage0 does (`fn(i64, u8&) -> void`), from the parser's
        # line-keyed side tables; the bare parameter heads stand in when the line holds
        # more than one fn type and the rows cannot be told apart. False when a parameter
        # type cannot be rendered.
        def fver_render_fn_type(lambda_params: darray[sview]&, lambda_pos: Ast::Pos, file: Ast::File&, out: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                rows: mutable darray[usize] = []
                while row < file.fn_type_param_lines.count |row: usize = 0, rows|:
                    rows.push(row) if file.fn_type_param_lines[row] == lambda_pos.line
                    row <- row + 1
                push_str(out, "fn(")
                for index in 0..<lambda_params.count |out|:
                    push_str(out, ", ") if index > 0
                    if rows.count == lambda_params.count:
                        false return if not affine_type_render(file.fn_type_param_exprs[rows[index]], out)
                    else:
                        push_sview(out, lambda_params[index])
                push_str(out, ") -> ")
                return_rows: mutable usize = 0
                return_row: mutable usize = 0
                while row2 < file.fn_type_return_lines.count |row2: usize = 0, return_rows, return_row|:
                    if file.fn_type_return_lines[row2] == lambda_pos.line:
                        return_rows <- return_rows + 1
                        return_row <- row2
                    row2 <- row2 + 1
                if return_rows == 1:
                    false return if not affine_type_render(file.fn_type_return_exprs[return_row], out)
                else:
                    head: mutable sview = ""
                    while index2 < file.enum_annotations.count |index2: usize = 0, head|:
                        head <- file.enum_annotations[index2].name if head == "" and file.enum_annotations[index2].owner == "__lambda_return" and file.enum_annotations[index2].line == lambda_pos.line
                        index2 <- index2 + 1
                    push_sview(out, head) if head != ""
                    push_str(out, "void") if head == ""
                return true

        # Spell a declared function's signature (`fn(i64) -> i64`). False when a type cannot
        # be rendered.
        def fver_render_function_signature(name: sview, declarations: darray[Ast::Decl]&, out: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if function_name == name:
                                push_str(out, "fn(")
                                for index in 0..<parameters.count |out|:
                                    push_str(out, ", ") if index > 0
                                    false return if not affine_type_render(parameters[index].type_expression, out)
                                push_str(out, ") -> ")
                                if return_type is declared_return:
                                    false return if not affine_type_render(declared_return, out)
                                else:
                                    push_str(out, "void")
                                return true
                        Decl.Module(module_name, module_body, module_line):
                            true return if fver_render_function_signature(name, module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            true return if fver_render_function_signature(name, scoped_body, out)
                        _:
                            pass
                return false

        # ---- function VALUES -----------------------------------------------------------

        # The declared function a value expression names (`bump`, `M::bump`), or "" — never
        # a local, a parameter, an extern, or an ambiguous name.
        def fver_value_function(value: Ast::Expr, locals: darray[sview]&, declarations: darray[Ast::Decl]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                name: sview = match value:
                    Expr.Ident(ident_name, pos): ident_name
                    Expr.Scope(base, scoped_name, pos): scoped_name
                    Expr.Paren(inner, pos): fver_value_function(inner, locals, declarations, table)
                    _: sview("", 0, 0)
                "" return if name == ""
                shadowed: bool = any local in locals where local == name
                "" return if shadowed
                "" return if fver_function_count(table, name) != 1
                # Only a declared FUNCTION has a signature to spell; an extern value keeps
                # the status quo.
                probe: mutable darray[u8] = []
                "" return if not fver_render_function_signature(name, declarations, &probe)
                return name

        def fver_index_canonical(declarations: darray[Ast::Decl]&, module_scope: usize, context: mutable GlobalAuthority&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |context|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, pos):
                            slot: usize = canonical_effect_function(name, module_scope, pos.offset, table)
                            context.canonical_declarations[slot] <- declaration if slot < context.canonical_declarations.count
                        Decl.Module(name, body, pos):
                            fver_index_canonical(&body, canonical_effect_module(module_scope, name, table), context, table)
                        Decl.Scoped(body, pos):
                            fver_index_canonical(&body, module_scope, context, table)
                        _:
                            pass

        def fver_render_canonical(slot: usize, context: GlobalAuthority&, out: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if slot >= context.canonical_declarations.count
                if context.canonical_declarations[slot] is declaration:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, pos):
                            push_str(out, "fn(")
                            for index in 0..<parameters.count |out|:
                                push_str(out, ", ") if index > 0
                                false return if not affine_type_render(parameters[index].type_expression, out)
                            push_str(out, ") -> ")
                            if return_type is declared_return:
                                return affine_type_render(declared_return, out)
                            push_str(out, "void")
                            return true
                        _:
                            pass
                return false

        def fver_canonical_value(value: Ast::Expr, locals: darray[sview]&, module_scope: usize, context: GlobalAuthority&, table: SymbolTable&) -> usize:
            can Memory.Allocate, Abort.Panic:
                name: mutable sview = ""
                owner: mutable usize = module_scope
                qualified: mutable bool = false
                match value:
                    Expr.Paren(inner, pos):
                        return fver_canonical_value(inner, locals, module_scope, context, table)
                    Expr.Lambda(parameters, body, pos):
                        return canonical_effect_function("", module_scope, pos.offset, table)
                    Expr.Ident(ident_name, pos):
                        GLOBAL_AUTHORITY_NONE return if any local in locals where local == ident_name
                        name <- ident_name
                    Expr.Scope(base, scoped_name, pos):
                        owner <- ga_module(base, context, module_scope)
                        name <- scoped_name
                        qualified <- true
                    _:
                        return GLOBAL_AUTHORITY_NONE
                slot: usize = ga_resolve_function(name, owner, qualified, context)
                return GLOBAL_AUTHORITY_NONE if slot >= table.effect_canonical_function_name.count
                # Probe only the matching name chain, preserving exact module identity.
                other: mutable usize = ga_function_head(name, context)
                while other < context.functions.count |other|:
                    GLOBAL_AUTHORITY_NONE return if other != slot and context.functions[other] == name and context.function_scopes[other] == context.function_scopes[slot]
                    other <- context.function_next[other]
                return slot

        def fver_value_pos(value: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                match value:
                    Expr.Ident(ident_name, pos):
                        return pos
                    Expr.Scope(base, scoped_name, pos):
                        return pos
                    Expr.Lambda(params, body, pos):
                        return pos
                    Expr.Paren(inner, pos):
                        return fver_value_pos(inner)
                    _:
                        return Ast::pos_at_line(0)

        # One site: VALUE meets the fn TYPE `type_lambda`. `form` 1 variable, 2 return,
        # 3 assignment, 4 struct literal field, 5 call argument (`ordinal` = its index).
        def fver_type_families(ref: sview, origin_scope: usize, context: GlobalAuthority&, out: mutable darray[sview]&, scopes: mutable darray[usize]&, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth > 32
                alias: usize = ga_capability_slot(ref, origin_scope, context)
                if alias < context.capability_names.count:
                    for row in 0..<context.capability_names.count |out, scopes|:
                        if context.capability_names[row] == context.capability_names[alias] and context.capability_scopes[row] == context.capability_scopes[alias]:
                            fver_type_families(context.capability_refs[row], context.capability_scopes[row], context, out, scopes, depth + 1)
                    return
                out.push(ga_ref_head(ref))
                scopes.push(origin_scope)

        def fver_canonical_within(slot: usize, expected: darray[sview]&, expected_scope: usize, context: GlobalAuthority&, table: SymbolTable&, reverse: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                actual_refs: mutable darray[sview] = []
                actual_scopes: mutable darray[usize] = []
                expected_refs: mutable darray[sview] = []
                expected_scopes: mutable darray[usize] = []
                for ref in expected |expected_refs, expected_scopes|:
                    fver_type_families(ref, expected_scope, context, expected_refs, expected_scopes)
                start: usize = table.effect_canonical_function_row_start[slot]
                end: usize = start + table.effect_canonical_function_row_count[slot]
                for row in start..<end |actual_refs, actual_scopes|:
                    ref: sview = table.effect_canonical_refs[table.effect_canonical_row_ref[row]]
                    origin_scope: usize = table.effect_canonical_row_scope[row]
                    family: sview = ga_ref_head(ref)
                    false return if not ga_refs_cover(expected_refs, expected_scopes, family, origin_scope, context)
                    actual_refs.push(family)
                    actual_scopes.push(origin_scope)
                if reverse:
                    for row in 0..<expected_refs.count:
                        false return if not ga_refs_cover(actual_refs, actual_scopes, expected_refs[row], expected_scopes[row], context)
                return true

        def fver_check_site(form: u32, site_name: sview, ordinal: u32, report_pos: Ast::Pos, type_lambda: Ast::Expr, value: Ast::Expr, locals: darray[sview]&, declarations: darray[Ast::Decl]&, globals: darray[sview]&, file: Ast::File&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_lambda:
                    Expr.Lambda(type_params, type_body, type_pos):
                        actual_signature: mutable darray[u8] = []
                        rendered: mutable bool = false
                        actual_owner: mutable sview = ""
                        first_row: mutable usize = 0
                        rows_before: usize = table.fn_value_effect_owner.count
                        done_before: usize = table.fn_value_effect_done.count
                        canonical_slot: usize = fver_canonical_value(value, locals, module_scope, context, table)
                        if canonical_slot < table.effect_canonical_function_name.count:
                            function_name: sview = table.effect_canonical_function_name[canonical_slot]
                            if function_name == "":
                                rendered <- fver_render_fn_type(type_params, type_pos, file, &actual_signature)
                            else:
                                rendered <- fver_render_canonical(canonical_slot, context, &actual_signature)
                            actual_owner <- fver_lambda_owner()
                            first_row <- rows_before
                            start: usize = table.effect_canonical_function_row_start[canonical_slot]
                            end: usize = start + table.effect_canonical_function_row_count[canonical_slot]
                            for row in start..<end |table| -> table:
                                effect_ref: sview = table.effect_canonical_refs[table.effect_canonical_row_ref[row]]
                                table <- fver_add_memo(actual_owner, effect_ref, table)
                        else:
                            match value:
                                Expr.Lambda(value_params, value_body, value_pos):
                                    # A lambda literal: its row is its body's, computed under the
                                    # reserved owner and dropped again below. stage0 spells it with
                                    # the EXPECTED signature (its parameter types come from the
                                    # context, not from the literal).
                                    firewalls: darray[sview] = []
                                    lambda_locals: mutable darray[sview] = []
                                    for local in locals |lambda_locals|:
                                        lambda_locals.push(local)
                                    for value_param in value_params |lambda_locals|:
                                        lambda_locals.push(value_param)
                                    collect_local_names(value_body, lambda_locals)
                                    table <- fver_block_grants(&value_body, fver_lambda_owner(), file.enum_annotations, inline_index, firewalls, table)
                                    table <- fver_body_rows(value_body, lambda_locals, fver_lambda_owner(), declarations, globals, file.enum_annotations, inline_index, firewalls, table)
                                    rendered <- fver_render_fn_type(type_params, type_pos, file, &actual_signature)
                                    actual_owner <- fver_lambda_owner()
                                    first_row <- rows_before
                                _:
                                    pass
                        if rendered:
                            expected: mutable darray[sview] = []
                            fver_fn_type_families(type_pos, file.enum_annotations, expected)
                            fver_sort_families(expected)
                            actual: mutable darray[usize] = []
                            fver_owner_rows(actual_owner, first_row, table, actual)
                            expected_scope: mutable usize = module_scope
                            for annotation in file.enum_annotations |expected_scope|:
                                expected_scope <- canonical_effect_module(0, annotation.module, table) if annotation.owner == "__fn_type_effect" and annotation.offset == type_pos.offset and annotation.line == type_pos.line
                            narrower_ok: bool = fver_actual_within(actual, expected, table)
                            accepted: mutable bool = narrower_ok if form == 5 else (narrower_ok and fver_expected_within(expected, actual, table))
                            if canonical_slot < table.effect_canonical_function_name.count:
                                accepted <- fver_canonical_within(canonical_slot, expected, expected_scope, context, table, form != 5)
                            if not accepted:
                                expected_spelling: mutable darray[u8] = []
                                if fver_render_fn_type(type_params, type_pos, file, &expected_spelling):
                                    fver_push_expected_row(expected, &expected_spelling)
                                    fver_push_actual_row(actual, table, &actual_signature)
                                    expected_text: sview = Parser::persist_name_bytes(&expected_spelling, 0) can Global{Read,Write}
                                    actual_text: sview = Parser::persist_name_bytes(&actual_signature, 0) can Global{Read,Write}
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FnValueEffectRow, name: site_name, pos: report_pos, line: report_pos.line, expected: expected_text, actual: actual_text, expected_count: ordinal, state_code: form})
                        # A lambda's rows (and whatever the walk completed meanwhile) are
                        # dropped: the reserved owner must not accumulate across literals.
                        if actual_owner == fver_lambda_owner():
                            table.fn_value_effect_owner <- table.fn_value_effect_owner.truncate(rows_before)
                            table.fn_value_effect_ref <- table.fn_value_effect_ref.truncate(rows_before)
                            table.fn_value_effect_done <- table.fn_value_effect_done.truncate(done_before)
                    _:
                        pass

        # ---- the walk ------------------------------------------------------------------

        # The declared type of FIELD_NAME in the struct STRUCT_NAME when that name is declared exactly once: that declaration,
        # recorded by fver_index_declarations, is the only one the walk could match.
        def fver_unique_struct_field_type(table: SymbolTable&, struct_name: sview, field_name: sview) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                row: u32 = fver_decl_row(table, struct_name)
                return null if row == SYMBOL_INDEX_ROW_NONE or table.fver_decl_struct_counts[row.usize()] != 1
                match table.fver_decl_struct[row.usize()]:
                    Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                        for member in members:
                            if member.name == field_name:
                                return member.type_expression
                    _:
                        pass
                return null

        # The call-argument sites of one call: ARGUMENTS against the parameters of the
        # declared function CALLEE (positional arguments only).
        def fver_check_call_args(callee_slot: usize, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, declarations: darray[Ast::Decl]&, locals: darray[sview]&, all_declarations: darray[Ast::Decl]&, globals: darray[sview]&, file: Ast::File&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if callee_slot >= context.canonical_declarations.count
                callee: sview = table.effect_canonical_function_name[callee_slot]
                if context.canonical_declarations[callee_slot] is callee_declaration:
                    match callee_declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for index in 0..<arguments.count |table| -> table:
                                parameter_index: mutable usize = index
                                if index < argument_names.count and argument_names[index] != "":
                                    parameter_index <- parameters.count
                                    for candidate in 0..<parameters.count |parameter_index|:
                                        parameter_index <- candidate if parameters[candidate].name == argument_names[index]
                                if parameter_index < parameters.count:
                                    parameter_lambda: Ast::Expr? = fver_type_lambda(parameters[parameter_index].type_expression)
                                    if parameter_lambda is type_lambda:
                                        table <- fver_check_site(5, callee, (parameter_index + 1.usize()).u32(), fver_value_pos(arguments[index]), type_lambda, arguments[index], locals, all_declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        _:
                            pass


        def fver_check_expression(expression: Ast::Expr, locals: darray[sview]&, declarations: darray[Ast::Decl]&, globals: darray[sview]&, file: Ast::File&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        callee_slot: usize = fver_canonical_value(callee, locals, module_scope, context, table)
                        if callee_slot < table.effect_canonical_function_name.count:
                            table <- fver_check_call_args(callee_slot, arguments, argument_names, declarations, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        for argument in arguments |table| -> table:
                            table <- fver_check_expression(argument, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                    Expr.Construct(type_expression, fields, construct_pos):
                        struct_name: sview = ident_name_of(type_expression)
                        for field in fields |table| -> table:
                            if struct_name != "" and fver_struct_count(table, struct_name) == 1:
                                field_type: Ast::Expr? = fver_unique_struct_field_type(table, struct_name, field.name)
                                if field_type is declared_type:
                                    field_lambda: Ast::Expr? = fver_type_lambda(declared_type)
                                    if field_lambda is type_lambda:
                                        table <- fver_check_site(4, field.name, 0, fver_value_pos(field.value), type_lambda, field.value, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                            table <- fver_check_expression(field.value, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- fver_check_expression(left, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        table <- fver_check_expression(right, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                    Expr.Unary(operator, operand, unary_pos):
                        table <- fver_check_expression(operand, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                    Expr.Paren(inner, paren_pos):
                        table <- fver_check_expression(inner, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        table <- fver_check_expression(condition, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        table <- fver_check_expression(then_expr, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        table <- fver_check_expression(else_expr, locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                    _:
                        pass

        # Fn-typed LOCALS of the enclosing function (name -> its type's lambda node), so a
        # later `name <- value` can be judged against the declared row.
        def fver_collect_fn_locals(statements: darray[Ast::Stmt]&, names: mutable darray[sview]&, types: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, pos):
                            declared: Ast::Expr? = fver_type_lambda(type_expression)
                            if declared is type_lambda:
                                names.push(name)
                                types.push(type_lambda)
                        Stmt.If(condition, then_body, else_body, pos):
                            fver_collect_fn_locals(&then_body, names, types)
                            fver_collect_fn_locals(&else_body, names, types)
                        Stmt.While(condition, body, pos):
                            fver_collect_fn_locals(&body, names, types)
                        Stmt.For(bind, variables, iterable, body, pos):
                            fver_collect_fn_locals(&body, names, types)
                        Stmt.Block(kind, clause, binding, body, pos):
                            fver_collect_fn_locals(&body, names, types)
                        Stmt.Match(scrutinee, arms, pos):
                            for arm in arms |names, types|:
                                fver_collect_fn_locals(&arm.body, names, types)
                        _:
                            pass

        def fver_check_statements(statements: darray[Ast::Stmt]&, return_lambda: Ast::Expr?, locals: darray[sview]&, fn_local_names: darray[sview]&, fn_local_types: darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, globals: darray[sview]&, file: Ast::File&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                scoped_locals: mutable darray[sview] = []
                for local in locals |scoped_locals|:
                    scoped_locals.push(local)
                for statement in statements |table, scoped_locals| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, pos):
                            declared: Ast::Expr? = fver_type_lambda(type_expression)
                            if declared is type_lambda:
                                table <- fver_check_site(1, name, 0, pos, type_lambda, value, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                            table <- fver_check_expression(value, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                            scoped_locals.push(name)
                        Stmt.Assign(target, operator, value, pos):
                            if operator == TokenKind.LArrow:
                                target_name: sview = ident_name_of(target)
                                while slot < fn_local_names.count |slot: usize = 0, table| -> table:
                                    if target_name != "" and fn_local_names[slot] == target_name:
                                        table <- fver_check_site(3, target_name, 0, fver_value_pos(target), fn_local_types[slot], value, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                                        slot <- fn_local_names.count
                                    else:
                                        slot <- slot + 1
                            table <- fver_check_expression(value, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Stmt.Return(value, pos):
                            if value is returned:
                                if return_lambda is type_lambda:
                                    table <- fver_check_site(2, "", 0, pos, type_lambda, returned, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                                table <- fver_check_expression(returned, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Stmt.Expr(expression, pos):
                            table <- fver_check_expression(expression, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, pos):
                            table <- fver_check_expression(condition, scoped_locals, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                            table <- fver_check_statements(&then_body, return_lambda, scoped_locals, fn_local_names, fn_local_types, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                            table <- fver_check_statements(&else_body, return_lambda, scoped_locals, fn_local_names, fn_local_types, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Stmt.While(condition, body, pos):
                            table <- fver_check_statements(&body, return_lambda, scoped_locals, fn_local_names, fn_local_types, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, body, pos):
                            table <- fver_check_statements(&body, return_lambda, scoped_locals, fn_local_names, fn_local_types, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Stmt.Block(kind, clause, binding, body, pos):
                            table <- fver_check_statements(&body, return_lambda, scoped_locals, fn_local_names, fn_local_types, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Stmt.Match(scrutinee, arms, pos):
                            for arm in arms |table| -> table:
                                table <- fver_check_statements(&arm.body, return_lambda, scoped_locals, fn_local_names, fn_local_types, declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        _:
                            pass

        def fver_check_declarations(declarations: darray[Ast::Decl]&, all_declarations: darray[Ast::Decl]&, globals: darray[sview]&, file: Ast::File&, inline_index: InlineEffectIndex&, table: lmut SymbolTable, module_scope: usize, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, pos):
                            locals: mutable darray[sview] = []
                            for parameter in parameters |locals|:
                                locals.push(parameter.name)
                            fn_local_names: mutable darray[sview] = []
                            fn_local_types: mutable darray[Ast::Expr] = []
                            fver_collect_fn_locals(&body, fn_local_names, fn_local_types)
                            return_lambda: mutable Ast::Expr? = null
                            if return_type is declared_return:
                                return_lambda <- fver_type_lambda(declared_return)
                            table <- fver_check_statements(&body, return_lambda, locals, fn_local_names, fn_local_types, all_declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        Decl.Module(module_name, module_body, module_pos):
                            table <- fver_check_declarations(&module_body, all_declarations, globals, file, inline_index, table, canonical_effect_module(module_scope, module_name, table), context) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_pos):
                            table <- fver_check_declarations(&scoped_body, all_declarations, globals, file, inline_index, table, module_scope, context) can Global{Read,Write}
                        _:
                            pass

    public:
        def check_fn_value_effect_row(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                inline_index: InlineEffectIndex = inline_effect_index(file.enum_annotations)
                globals: mutable darray[sview] = []
                collect_mutable_globals(file.top_decls, globals)
                table.fver_decl_names <- []
                table.fver_decl_function_counts <- []
                table.fver_decl_struct_counts <- []
                table.fver_decl_function <- []
                table.fver_decl_struct <- []
                table.fver_decl_has_function <- []
                table.fver_decl_next <- []
                table.fver_decl_heads <- {}
                table <- fver_index_declarations(&file.top_decls, table)
                context: mutable GlobalAuthority = GlobalAuthority{annotations: file.enum_annotations}
                canonical_effect_context(table, context)
                for slot in 0..<table.effect_canonical_function_name.count |context|:
                    context.canonical_declarations.push(null)
                fver_index_canonical(&file.top_decls, 0, context, table)
                table <- fver_check_declarations(&file.top_decls, &file.top_decls, globals, file, inline_index, table, 0, context) can Global{Read,Write}
