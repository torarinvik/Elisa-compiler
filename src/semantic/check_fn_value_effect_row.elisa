# Effect rows on FUNCTION VALUES (stage0 FuncType.Permissions / AssignableTo).
#
# A function used as a VALUE carries its effect row — the sorted set of permission
# FAMILIES it declares (`can[Memory.Allocate]` -> Memory) or is inferred to use. stage0
# infers the row as a fixpoint over the body: every `can E:` block grant, every direct
# callee's row (externs included, through their declared `can[...]`), and the Global
# family whenever the body reads or writes a `global`. A `fn(...) -> R [can[...]]` TYPE
# carries its own row, and the two are compared wherever a function value meets such a
# type:
#
#   g: fn(i64) -> i64 = bump            # variable "g" expects fn(i64) -> i64, got fn(i64) -> i64 can[Global]
#   g <- bump                           # cannot assign fn(i64) -> i64 can[Global] to fn(i64) -> i64
#   return bump                         # return type expects fn(i64) -> i64, got ...
#   Holder{f: bump}                     # struct literal field "f" expects ..., got ...
#   apply(bump, 3)                      # argument 1 to "apply" expects ..., got ...
#
# Measured against stage0 (probes 2026-10-05): a binding, assignment, return and struct
# literal field require the rows to be EQUAL in both directions (a plain function is NOT
# accepted where `fn(...) can[Memory]` is expected); a CALL ARGUMENT accepts a narrower
# row (the value needs a SUBSET of what the parameter permits) and rejects a wider one.
# `can[Global]`, `can[Global.Write]` and `can[Global.Read]` all spell the one Global
# family. An operation without a grant (a bare `assert`, an undeclared darray literal,
# an index) adds nothing; a `can` block adds its clause even when its body never uses it.
# Method calls (`s.push(..)`) are not followed, matching the probes.
#
# stage1 had no effect row on function values at all, so every one of the shapes above
# built and ran (fuzz_findings/fn_value_effect_row_ignored*.elisa). The checker is purely
# syntactic: fn TYPES are `Expr.Lambda` nodes in type position whose row is recorded by
# the parser on `__fn_type_effect` (keyed by the lambda token's offset), and a function
# value is a bare identifier (or `M::name`) naming exactly one declared function, or a
# lambda literal (whose row is inferred from its body; stage0 spells it with the
# EXPECTED signature). Anything else is left to the other checks.
#
# The inferred rows live on the table (`fn_value_effect_owner`/`_ref`, one row per
# (function, ref) pair; `fn_value_effect_done` = functions whose rows are complete), like
# function_effect_source_*. A site reads its value's row as INDICES into those rows, so
# no table-owned sview is ever stored into a frame-local list — stage0's region analysis
# rejects that (a caller-owned darray memo tripped it three different ways).
extend Semantic:
    private:
        # The reserved memo owner under which a lambda literal's row is computed; the rows
        # are dropped again once the site has read them (see fver_check_site).
        def fver_lambda_owner() -> sview:
            return "__fn_value_lambda"

        # ---- family sets ---------------------------------------------------------------

        # Rows hold the effect REF as written (`Memory.Allocate`) and are read as FAMILIES
        # through effect_ref_family; one row per family (a computed family is a call result,
        # so storing it would be a region escape — the ref is stored instead).
        def fver_add_family(out: mutable darray[sview]&, effect_ref: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                family: sview = effect_ref_family(effect_ref)
                return if family == ""
                present: bool = any existing in out where existing == effect_ref
                out.push(effect_ref) if not present

        # Sort IN PLACE, lexically by family (stage0's sort.Strings over the family names).
        def fver_sort_families(families: mutable darray[sview]&) -> void:
            can Abort.Panic:
                for outer in 0..<families.count |families|:
                    position: mutable usize = outer
                    while position > 0.usize() |position, families|:
                        break if not effect_ref_less(effect_ref_family(families[position]), effect_ref_family(families[position - 1.usize()]))
                        swap: sview = families[position - 1.usize()]
                        families[position - 1.usize()] <- families[position]
                        families[position] <- swap
                        position <- position - 1.usize()

        # The memo rows of OWNER (indices into the table's fn_value_effect rows at or past
        # FIRST), sorted by family.
        def fver_owner_rows(owner: sview, first: usize, table: SymbolTable&, out: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while row < table.fn_value_effect_owner.count |row: usize = first, out|:
                    out.push(row) if table.fn_value_effect_owner[row] == owner and not (any previous in out where effect_ref_family(table.fn_value_effect_ref[previous]) == effect_ref_family(table.fn_value_effect_ref[row]))
                    row <- row + 1
                for outer in 0..<out.count |out|:
                    position: mutable usize = outer
                    while position > 0.usize() |position, out|:
                        break if not effect_ref_less(effect_ref_family(table.fn_value_effect_ref[out[position]]), effect_ref_family(table.fn_value_effect_ref[out[position - 1.usize()]]))
                        swap: usize = out[position - 1.usize()]
                        out[position - 1.usize()] <- out[position]
                        out[position] <- swap
                        position <- position - 1.usize()

        def fver_expected_has(expected: darray[sview]&, family: sview) -> bool:
            can Abort.Panic:
                return any existing in expected where effect_ref_family(existing) == family

        def fver_actual_has(actual: darray[usize]&, table: SymbolTable&, family: sview) -> bool:
            can Abort.Panic:
                return any row in actual where effect_ref_family(table.fn_value_effect_ref[row]) == family

        # actual ⊆ expected.
        def fver_actual_within(actual: darray[usize]&, expected: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for row in actual:
                    return false if not fver_expected_has(expected, effect_ref_family(table.fn_value_effect_ref[row]))
                return true

        # expected ⊆ actual.
        def fver_expected_within(expected: darray[sview]&, actual: darray[usize]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for existing in expected:
                    return false if not fver_actual_has(actual, table, effect_ref_family(existing))
                return true

        # ---- declaration lookups -------------------------------------------------------

        # ---- declaration name index (built once per pass) ------------------------------

        def fver_decl_row(table: SymbolTable&, name: sview) -> u32:
            can Abort.Panic:
                row: mutable u32 = head if table.fver_decl_heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE |row, table, name|:
                    return row if table.fver_decl_names[row.usize()] == name
                    row <- table.fver_decl_next[row.usize()]
                return SYMBOL_INDEX_ROW_NONE

        # A new row's function slot holds DECLARATION as a placeholder until
        # fver_decl_has_function marks a real function declaration.
        def fver_decl_row_for(table: lmut SymbolTable, name: sview @source, declaration: Ast::Decl) -> u32:
            can Memory.Allocate, Abort.Panic:
                existing: u32 = fver_decl_row(table, name)
                return existing if existing != SYMBOL_INDEX_ROW_NONE
                hash: u64 = name_hash(name)
                row: u32 = table.fver_decl_names.count.u32()
                previous: u32 = head if table.fver_decl_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE
                table.fver_decl_names <- table.fver_decl_names.push(name)
                table.fver_decl_function_counts <- table.fver_decl_function_counts.push(0)
                table.fver_decl_struct_counts <- table.fver_decl_struct_counts.push(0)
                table.fver_decl_function <- table.fver_decl_function.push(declaration)
                table.fver_decl_struct <- table.fver_decl_struct.push(declaration)
                table.fver_decl_has_function <- table.fver_decl_has_function.push(false)
                table.fver_decl_next <- table.fver_decl_next.push(previous)
                table.fver_decl_heads <- table.fver_decl_heads.put(hash, row) can Global{Read,Write}
                return row

        # Same traversal as the per-name scans it replaces: functions and callable externs
        # count as functions, structs as structs, recursing through modules and scopes.
        def fver_index_declarations(declarations: darray[Ast::Decl]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            row: u32 = fver_decl_row_for(table, name, declaration) can Global{Read,Write}
                            table.fver_decl_function_counts[row.usize()] <- table.fver_decl_function_counts[row.usize()] + 1
                            if not table.fver_decl_has_function[row.usize()]:
                                table.fver_decl_function[row.usize()] <- declaration
                                table.fver_decl_has_function[row.usize()] <- true
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if callable:
                                row: u32 = fver_decl_row_for(table, name, declaration) can Global{Read,Write}
                                table.fver_decl_function_counts[row.usize()] <- table.fver_decl_function_counts[row.usize()] + 1
                                if not table.fver_decl_has_function[row.usize()]:
                                    table.fver_decl_function[row.usize()] <- declaration
                                    table.fver_decl_has_function[row.usize()] <- true
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            row: u32 = fver_decl_row_for(table, name, declaration) can Global{Read,Write}
                            table.fver_decl_struct[row.usize()] <- declaration if table.fver_decl_struct_counts[row.usize()] == 0
                            table.fver_decl_struct_counts[row.usize()] <- table.fver_decl_struct_counts[row.usize()] + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- fver_index_declarations(&module_body, table) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fver_index_declarations(&scoped_body, table) can Global{Read,Write}
                        _:
                            pass

        def fver_function_count(table: SymbolTable&, wanted: sview) -> u32:
            can Abort.Panic:
                row: u32 = fver_decl_row(table, wanted)
                return 0 if row == SYMBOL_INDEX_ROW_NONE
                return table.fver_decl_function_counts[row.usize()]

        def fver_struct_count(table: SymbolTable&, wanted: sview) -> u32:
            can Abort.Panic:
                row: u32 = fver_decl_row(table, wanted)
                return 0 if row == SYMBOL_INDEX_ROW_NONE
                return table.fver_decl_struct_counts[row.usize()]

        # ---- the inferred row of a function (table memo) -------------------------------

        # One row for TARGET, deduplicated by exact member ref. Every ref stored here is a literal, an
        # AST node's own text, or a table element bound to a local first (an element passed
        # beside the `lmut` table would alias it).
        def fver_add_memo(target: sview @source, effect_ref: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if target == ""
                family: sview = effect_ref_family(effect_ref)
                return if family == ""
                while row < table.fn_value_effect_owner.count |row: usize = 0|:
                    return if table.fn_value_effect_owner[row] == target and table.fn_value_effect_ref[row] == effect_ref
                    row <- row + 1
                table.fn_value_effect_owner <- table.fn_value_effect_owner.push(target)
                table.fn_value_effect_ref <- table.fn_value_effect_ref.push(effect_ref)

        # `trusted` is an Unsafe tracking boundary only. A Global, Memory, or other
        # permission inside its clause must remain in a function value's inferred row.
        def fver_trusted_covers_unsafe(annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, required_ref: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if effect_ref_family(required_ref) != "Unsafe"
                return cov_ref_covered(annotations, firewalls, required_ref, 0)

        # `can` block clauses anywhere in STATEMENTS, as TARGET's rows.
        def fver_inline_grants(expression: Ast::Expr, target: sview @source, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, firewalls: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                at: Ast::Pos = Ast::expr_pos(expression)
                while next_row > 0 |next_row: usize = inline_effect_limit(at.offset, inline_index), table| -> table:
                    row: usize = next_row - 1
                    next_row <- row
                    break if inline_index.prefix_ends[row] <= at.offset
                    continue if inline_index.ends[row] <= at.offset
                    grant: sview = annotations[inline_index.rows[row]].name
                    table <- fver_add_memo(target, grant, table) if not fver_trusted_covers_unsafe(annotations, firewalls, grant)
                match expression:
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _) | Expr.Field(operand, _, _):
                        table <- fver_inline_grants(operand, target, annotations, inline_index, firewalls, table)
                    Expr.Binary(left, _, right, _) | Expr.Index(left, right, _) | Expr.Refinement(left, right, _):
                        table <- fver_inline_grants(left, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(right, target, annotations, inline_index, firewalls, table)
                    Expr.Call(base, arguments, _, _) | Expr.IndexN(base, arguments, _):
                        table <- fver_inline_grants(base, target, annotations, inline_index, firewalls, table)
                        for argument in arguments |table| -> table:
                            table <- fver_inline_grants(argument, target, annotations, inline_index, firewalls, table)
                    Expr.Slice(base, low, high, _):
                        table <- fver_inline_grants(base, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(low, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(high, target, annotations, inline_index, firewalls, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- fver_inline_grants(element, target, annotations, inline_index, firewalls, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- fver_inline_grants(entry.key, target, annotations, inline_index, firewalls, table)
                            table <- fver_inline_grants(entry.value, target, annotations, inline_index, firewalls, table)
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        match expression:
                            Expr.RecordUpdate(base, _, _):
                                table <- fver_inline_grants(base, target, annotations, inline_index, firewalls, table)
                            _:
                                pass
                        for field in fields |table| -> table:
                            table <- fver_inline_grants(field.value, target, annotations, inline_index, firewalls, table)
                    Expr.If(condition, yes, no, _):
                        table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(yes, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(no, target, annotations, inline_index, firewalls, table)
                    Expr.Match(value, arms, _) | Expr.Catch(value, arms, _):
                        table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        for arm in arms |table| -> table:
                            table <- fver_inline_grants(arm.guard, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&arm.body, target, annotations, inline_index, firewalls, table)
                    Expr.GetElse(value, recovery, _):
                        table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        table <- fver_block_grants(&recovery, target, annotations, inline_index, firewalls, table)
                    Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                        table <- fver_inline_grants(iterable, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(body, target, annotations, inline_index, firewalls, table)
                    Expr.Block(statements, value, _, _):
                        table <- fver_block_grants(&statements, target, annotations, inline_index, firewalls, table)
                        table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                    _:
                        pass

        def fver_block_grants(statements: darray[Ast::Stmt]&, target: sview @source, annotations: darray[Ast::EnumAnnotation]&, inline_index: InlineEffectIndex&, firewalls: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(value, _) | Stmt.Contract(_, value, _) | Stmt.VarDecl(_, _, value, _):
                            table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        Stmt.Return(value, _):
                            table <- fver_inline_grants(expression, target, annotations, inline_index, firewalls, table) if value is expression
                        Stmt.Assign(place, _, value, _):
                            table <- fver_inline_grants(place, target, annotations, inline_index, firewalls, table)
                            table <- fver_inline_grants(value, target, annotations, inline_index, firewalls, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "can":
                                while index < clause.count |index: usize = 0, table| -> table:
                                    table <- fver_add_memo(target, clause[index], table) if not fver_trusted_covers_unsafe(annotations, firewalls, clause[index])
                                    index <- index + 1
                            nested_firewalls: mutable darray[sview] = []
                            nested_firewalls.extend(firewalls)
                            nested_firewalls.extend(clause) if kind == "trusted"
                            table <- fver_block_grants(&body, target, annotations, inline_index, nested_firewalls, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&then_body, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&else_body, target, annotations, inline_index, firewalls, table)
                        Stmt.While(condition, body, line):
                            table <- fver_inline_grants(condition, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&body, target, annotations, inline_index, firewalls, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- fver_inline_grants(iterable, target, annotations, inline_index, firewalls, table)
                            table <- fver_block_grants(&body, target, annotations, inline_index, firewalls, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- fver_inline_grants(scrutinee, target, annotations, inline_index, firewalls, table)
                            for arm in arms |table| -> table:
                                table <- fver_inline_grants(arm.guard, target, annotations, inline_index, firewalls, table)
                                table <- fver_block_grants(&arm.body, target, annotations, inline_index, firewalls, table)
                        _:
                            pass

        # Build the global-name index used by the shared GP walkers. The canonical effect
        # context already owns the module tree and function slots; add declaration-scoped
        # globals without recollecting and duplicating that function inventory.
        def fver_collect_gp_globals(declarations: darray[Ast::Decl]&, module_scope: usize, context: mutable GlobalAuthority&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |context|:
                    match declaration:
                        Decl.Const(name, type_expression, value, is_global, _):
                            if is_global:
                                context.globals.push(name)
                                context.global_scopes.push(module_scope)
                                context.global_types.push(type_expression)
                                context.writable.push(false)
                        Decl.Module(module_name, module_body, _):
                            fver_collect_gp_globals(module_body, canonical_effect_module(module_scope, module_name, table), context, table)
                        Decl.Scoped(scoped_body, _):
                            fver_collect_gp_globals(scoped_body, module_scope, context, table)
                        _:
                            pass

        # Rebuild the lexical module path for source-row joins. Canonical scopes store
        # path components plus parent links, while function_effect_source_module stores
        # the joined spelling used by the effect-source collector.
        def fver_module_scope_path(module_scope: usize, context: GlobalAuthority&, table: lmut SymbolTable) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                return "" if module_scope == 0
                return "" if module_scope >= context.modules.count or module_scope >= context.parents.count
                parts: mutable darray[sview] = []
                cursor: mutable usize = module_scope
                while cursor != 0 |cursor, parts, context|:
                    return "" if cursor >= context.modules.count or cursor >= context.parents.count or cursor >= context.module_starts.count or cursor >= context.module_lengths.count
                    start: usize = context.module_starts[cursor]
                    length: usize = context.module_lengths[cursor]
                    return "" if start > context.modules[cursor].len or length > context.modules[cursor].len - start
                    parts.push(context.modules[cursor][start:start + length])
                    cursor <- context.parents[cursor]
                bytes: mutable darray[u8] = []
                for index in 0..<parts.count |bytes, parts|:
                    push_str(bytes, "::") if index > 0
                    segment: sview = parts[parts.count - index - 1.usize()]
                    push_sview(bytes, segment)
                return intern_joined_text(bytes, table)

        # Collect exact, owner-scoped extern effects from expressions in a lambda or
        # callback body. The resolver observes import/alias source order at each call;
        # local/global roots are excluded before the lookup so a callback cannot borrow
        # a same-named extern row.
        def fver_external_call_effects(file: Ast::File&, callee: Ast::Expr, call_pos: Ast::Pos, current_module: sview, locals: darray[sview]&, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> bool:
            can Memory.Allocate, Abort.Panic:
                name: sview = typestate_call_leaf(callee)
                return false if name == "" or gp_namespace_root_is_local(callee, locals) or gp_namespace_root_is_global(callee, context, locals)
                rebind qualifier: sview, table = typestate_call_qualifier(callee, table)
                rebind selected: (found: bool, owner: sview), table = typestate_resolve_callable_owner(name, current_module, qualifier, call_pos, file, table)
                return false if not selected.found or not extern_module_owner_is_extern_only(selected.owner, name, table)
                unknown_row: mutable bool = false
                for effect_ref in extern_effect_index_refs(selected.owner, name, table) |table, unknown_row| -> table:
                    unknown_row <- true if effect_ref == "Permission"
                    table <- fver_add_memo(target, effect_ref, table) if effect_ref != "" and effect_ref != "Permission" and not fver_trusted_covers_unsafe(annotations, firewalls, effect_ref)
                return not unknown_row

        # Match GP's short-circuit and pattern-binding rules when a call appears in a
        # condition. This keeps an `is`/`as`/pattern-bound local from resolving as an
        # imported extern in the right side of a condition or its selected branch.
        def fver_external_condition_calls(file: Ast::File&, condition: Ast::Expr, locals: mutable darray[sview]&, current_module: sview, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> usize:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        rebind result: usize, table = fver_external_condition_calls(file, inner, locals, current_module, target, context, annotations, firewalls, table)
                        return result
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And:
                            rebind left_count: usize, table = fver_external_condition_calls(file, left, locals, current_module, target, context, annotations, firewalls, table)
                            rebind right_count: usize, table = fver_external_condition_calls(file, right, locals, current_module, target, context, annotations, firewalls, table)
                            return left_count + right_count
                        if operator == TokenKind.Or:
                            left_locals: mutable darray[sview] = []
                            gp_call_locals_copy(locals, left_locals)
                            rebind left_count: usize, table = fver_external_condition_calls(file, left, left_locals, current_module, target, context, annotations, firewalls, table)
                            right_locals: mutable darray[sview] = []
                            gp_call_locals_copy(locals, right_locals)
                            rebind right_count: usize, table = fver_external_condition_calls(file, right, right_locals, current_module, target, context, annotations, firewalls, table)
                            gp_condition_bindings(condition, locals)
                            return left_count + right_count
                        if operator == TokenKind.Is or operator == TokenKind.As:
                            rebind left_count: usize, table = fver_external_expr_calls(file, left, locals, current_module, target, context, annotations, firewalls, table)
                            gp_condition_target_bindings(right, locals)
                            return left_count
                        rebind left_count: usize, table = fver_external_expr_calls(file, left, locals, current_module, target, context, annotations, firewalls, table)
                        rebind right_count: usize, table = fver_external_expr_calls(file, right, locals, current_module, target, context, annotations, firewalls, table)
                        return left_count + right_count
                    _:
                        rebind result: usize, table = fver_external_expr_calls(file, condition, locals, current_module, target, context, annotations, firewalls, table)
                        return result

        def fver_external_filter_calls(file: Ast::File&, condition: Ast::Expr, locals: mutable darray[sview]&, current_module: sview, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> usize:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And and gp_is_bare_pattern_filter(left):
                            gp_condition_target_bindings(left, locals)
                            rebind result: usize, table = fver_external_condition_calls(file, right, locals, current_module, target, context, annotations, firewalls, table)
                            return result
                    _:
                        pass
                if gp_is_bare_pattern_filter(condition):
                    gp_condition_target_bindings(condition, locals)
                    return 0.usize()
                rebind result: usize, table = fver_external_condition_calls(file, condition, locals, current_module, target, context, annotations, firewalls, table)
                return result

        def fver_external_for_calls(file: Ast::File&, iterable: Ast::Expr, variables: darray[sview]&, locals: darray[sview]&, current_module: sview, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> usize:
            can Memory.Allocate, Abort.Panic:
                base_expression: mutable Ast::Expr = iterable
                filter_expression: mutable Ast::Expr? = null
                filter_guard: mutable Ast::Expr? = null
                match iterable:
                    Expr.Refinement(filter_base, filter_predicate, _):
                        match filter_base:
                            Expr.Refinement(inner_base, inner_predicate, _):
                                base_expression <- inner_base
                                filter_expression <- inner_predicate
                                filter_guard <- filter_predicate
                            _:
                                base_expression <- filter_base
                                filter_expression <- filter_predicate
                    _:
                        pass
                rebind base_count: usize, table = fver_external_expr_calls(file, base_expression, locals, current_module, target, context, annotations, firewalls, table)
                resolved: mutable usize = base_count
                loop_locals: mutable darray[sview] = []
                gp_call_locals_copy(locals, loop_locals)
                loop_locals.extend(variables)
                if filter_expression is filter_value:
                    rebind filter_count: usize, table = fver_external_filter_calls(file, filter_value, loop_locals, current_module, target, context, annotations, firewalls, table)
                    resolved <- resolved + filter_count
                if filter_guard is guard_value:
                    guard_locals: mutable darray[sview] = []
                    gp_call_locals_copy(loop_locals, guard_locals)
                    rebind guard_count: usize, table = fver_external_condition_calls(file, guard_value, guard_locals, current_module, target, context, annotations, firewalls, table)
                    resolved <- resolved + guard_count
                return resolved

        def fver_external_callback_argument_calls(file: Ast::File&, argument: Ast::Expr, locals: darray[sview]&, current_module: sview, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> usize:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Lambda(parameters, body, _):
                        lambda_locals: mutable darray[sview] = []
                        gp_call_locals_copy(locals, lambda_locals)
                        lambda_locals.extend(parameters)
                        rebind result: usize, table = fver_external_body_calls(file, body, lambda_locals, current_module, target, context, annotations, firewalls, table)
                        return result
                    Expr.Paren(inner, _):
                        rebind result: usize, table = fver_external_callback_argument_calls(file, inner, locals, current_module, target, context, annotations, firewalls, table)
                        return result
                    _:
                        rebind result: usize, table = fver_external_expr_calls(file, argument, locals, current_module, target, context, annotations, firewalls, table)
                        return result

        def fver_external_body_calls(file: Ast::File&, body: darray[Ast::Stmt], locals: darray[sview]&, current_module: sview, target: sview @source, context: GlobalAuthority&, annotations: darray[Ast::EnumAnnotation]&, firewalls: darray[sview]&, table: lmut SymbolTable) -> usize:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable usize = 0
                scoped_locals: mutable darray[sview] = []
                gp_call_locals_copy(locals, scoped_locals)
                for statement in body |resolved, scoped_locals, table|:
                    match statement:
                        Stmt.Expr(expression, _):
                            rebind statement_count: usize, table = fver_external_expr_calls(file, expression, scoped_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + statement_count
                        Stmt.VarDecl(name, _, value, _):
                            rebind statement_count: usize, table = fver_external_expr_calls(file, value, scoped_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + statement_count
                            scoped_locals.push(name)
                        Stmt.Assign(place, operator, value, _):
                            rebind place_count: usize, table = fver_external_expr_calls(file, place, scoped_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + place_count
                            rebind value_count: usize, table = fver_external_expr_calls(file, value, scoped_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + value_count
                            if operator == TokenKind.Assign and place is Expr.Ident(binding_name, _):
                                scoped_locals.push(binding_name) if not gp_call_name_is_local(binding_name, scoped_locals)
                        Stmt.Return(value, _):
                            if value is returned:
                                rebind return_count: usize, table = fver_external_expr_calls(file, returned, scoped_locals, current_module, target, context, annotations, firewalls, table)
                                resolved <- resolved + return_count
                        Stmt.If(condition, then_body, else_body, _):
                            then_locals: mutable darray[sview] = []
                            gp_call_locals_copy(scoped_locals, then_locals)
                            rebind condition_count: usize, table = fver_external_condition_calls(file, condition, then_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + condition_count
                            gp_condition_bindings(condition, then_locals)
                            rebind then_count: usize, table = fver_external_body_calls(file, then_body, then_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + then_count
                            else_locals: mutable darray[sview] = []
                            gp_call_locals_copy(scoped_locals, else_locals)
                            rebind else_count: usize, table = fver_external_body_calls(file, else_body, else_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + else_count
                        Stmt.While(condition, nested_body, _):
                            while_locals: mutable darray[sview] = []
                            gp_call_locals_copy(scoped_locals, while_locals)
                            rebind condition_count: usize, table = fver_external_condition_calls(file, condition, while_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + condition_count
                            gp_condition_bindings(condition, while_locals)
                            rebind body_count: usize, table = fver_external_body_calls(file, nested_body, while_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + body_count
                        Stmt.For(_, variables, iterable, nested_body, _):
                            rebind iterable_count: usize, table = fver_external_for_calls(file, iterable, variables, scoped_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + iterable_count
                            loop_locals: mutable darray[sview] = []
                            gp_call_locals_copy(scoped_locals, loop_locals)
                            loop_locals.extend(variables)
                            rebind body_count: usize, table = fver_external_body_calls(file, nested_body, loop_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + body_count
                        Stmt.Block(kind, clause, binding, nested_body, _):
                            block_locals: mutable darray[sview] = []
                            gp_call_locals_copy(scoped_locals, block_locals)
                            block_locals.push(binding) if binding != ""
                            nested_firewalls: mutable darray[sview] = []
                            nested_firewalls.extend(firewalls)
                            nested_firewalls.extend(clause) if kind == "trusted"
                            rebind body_count: usize, table = fver_external_body_calls(file, nested_body, block_locals, current_module, target, context, annotations, nested_firewalls, table)
                            resolved <- resolved + body_count
                        Stmt.Match(scrutinee, arms, _):
                            rebind scrutinee_count: usize, table = fver_external_expr_calls(file, scrutinee, scoped_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + scrutinee_count
                            for arm in arms |resolved, scoped_locals, table|:
                                arm_locals: mutable darray[sview] = []
                                gp_call_locals_copy(scoped_locals, arm_locals)
                                arm_names: mutable darray[sview] = []
                                collect_pattern_binding_names(arm.pattern, arm_names)
                                arm_locals.extend(arm_names)
                                rebind guard_count: usize, table = fver_external_condition_calls(file, arm.guard, arm_locals, current_module, target, context, annotations, firewalls, table)
                                resolved <- resolved + guard_count
                                gp_condition_bindings(arm.guard, arm_locals)
                                rebind arm_count: usize, table = fver_external_body_calls(file, arm.body, arm_locals, current_module, target, context, annotations, firewalls, table)
                                resolved <- resolved + arm_count
                        Stmt.Contract(_, expression, _):
                            rebind contract_count: usize, table = fver_external_expr_calls(file, expression, scoped_locals, current_module, target, context, annotations, firewalls, table)
                            resolved <- resolved + contract_count
                        _:
                            pass
                return resolved

