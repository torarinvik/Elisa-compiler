# Threading-slot exemption for the affine move-site check (continues
# check_affine_collection.elisa). `a, b <- if c: a, f(b) else: g(a), b` hands each
# target back to itself: a branch-tail element that is the bare name of ITS OWN target
# slot copies nothing, so stage0 accepts it (the self-hosted parser threads its affine
# `Parser` this way). The exemption is positional and name-exact: another name, the
# target's name in a different slot, and every real array literal keep the check.
extend Semantic:
    private:
        # The bare name of target slot `index` of a multi-target `<-`, or "".
        def affine_thread_slot_name(targets: darray[Ast::Expr]&, index: usize) -> sview:
            can Abort.Panic:
                return "" if index >= targets.count
                return target_name if targets[index] is Ast::Expr.Ident(target_name, _) else ""

        # `value` is the right side of `targets <- value`; walks `if` branches down to
        # their tails and checks each tail element as an array literal element, unless
        # it threads its own slot.
        def check_affine_threading_value(targets: darray[Ast::Expr]&, value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.If(condition, then_expr, else_expr, if_line):
                        table <- check_affine_moves(condition, "array element", names, types, elems, refs, table)
                        table <- check_affine_threading_value(targets, then_expr, names, types, elems, refs, table)
                        table <- check_affine_threading_value(targets, else_expr, names, types, elems, refs, table)
                    Expr.Paren(inner, paren_line):
                        table <- check_affine_threading_value(targets, inner, names, types, elems, refs, table)
                    Expr.Array(elements, array_line):
                        if elements.count != targets.count:
                            table <- check_affine_moves(value, "array element", names, types, elems, refs, table)
                            return
                        element_index: mutable usize = 0
                        for element in elements |element_index, table| -> table:
                            slot_name: sview = affine_thread_slot_name(targets, element_index)
                            threads_own_slot: mutable bool = false
                            if element is Ast::Expr.Ident(element_name, _):
                                threads_own_slot <- slot_name != "" and element_name == slot_name
                            table <- check_affine_move_site(element, "array element", "", names, types, elems, refs, table) if not threads_own_slot
                            table <- check_affine_moves(element, "array element", names, types, elems, refs, table)
                            element_index <- element_index + 1
                    _:
                        table <- check_affine_moves(value, "array element", names, types, elems, refs, table)
