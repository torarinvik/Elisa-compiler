# `owned T` ownership discipline. An owned region is a linear resource: it must be consumed
# exactly once, by `destroy R` or by `move R` into a new owner.
#
#   def f() -> void:
#       r: owned Arena = new_arena(64)      # never consumed -> must be consumed before exit
#
#   s: owned Arena = move r; destroy r      # r already moved   -> already destroyed
#   s: owned Arena = r                      # copy, not a move  -> move-only
#
# All three are decidable from the statement order; no prover is involved. Verified against
# stage0 for each shape.
#
# NOTE this check only became reachable once the parser learned the `owned` qualifier: while
# `owned Arena` mis-parsed, stage1 emitted a bogus "unknown type 'owned'" that happened to
# make the accept/reject class match. Fixing the parse removed that accidental cover, so the
# rules below are what actually earns the agreement.
extend Semantic:
    private:
        # Whether a type annotation carries the `owned` qualifier.
        def annotation_is_owned(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        true return if operator == TokenKind.Owned
                        return annotation_is_owned(operand)
                    Expr.Paren(inner, paren_line):
                        return annotation_is_owned(inner)
                    _:
                        return false


        # The name a `move X` transfers, or "".
        def owned_move_source(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Move(operand, line):
                        return ident_name_of(operand)
                    Expr.Paren(inner, paren_line):
                        return owned_move_source(inner)
                    _:
                        return sview("", 0, 0)


        # Every name a `move X` consumes anywhere in an expression -- notably a CALL ARGUMENT
        # (`sink(move r)`), which transfers ownership just as an initializer does.
        def owned_collect_moves(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Move(operand, line):
                        moved: sview = ident_name_of(operand)
                        out.push(moved) if moved != ""
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |out|:
                            owned_collect_moves(argument, out)
                    Expr.Binary(left, operator, right, binary_line):
                        owned_collect_moves(left, out)
                        owned_collect_moves(right, out)
                    Expr.Paren(inner, paren_line):
                        owned_collect_moves(inner, out)
                    Expr.Unary(operator, operand, unary_line):
                        owned_collect_moves(operand, out)
                    Expr.Index(object, index_argument, index_line):
                        owned_collect_moves(object, out)
                        owned_collect_moves(index_argument, out)
                    Expr.Field(object, field, field_line):
                        owned_collect_moves(object, out)
                    # `submit[...] worker(move r)` parses to a value Block wrapping the call.
                    Expr.Block(block_statements, block_value, block_captures, block_line):
                        owned_collect_moves(block_value, out)
                    _:
                        pass


        # Collect every region/owner name that is EXPLICITLY consumed anywhere in a body --
        # by `destroy NAME` or by `move NAME` (in an initializer, call argument, or return).
        # A bare `region NAME(size)` is only a linear obligation once it is manually consumed
        # on SOME path: a region used purely as allocation backing (`new[NAME] ...`) auto-frees
        # at scope exit and needs no explicit teardown -- so it must NOT be tracked as a leak.
        # Tracking only names that appear in a consume yields exactly stage0's PARTIAL-
        # consumption diagnostic (consumed on one branch, live on another) without flagging
        # the fully-automatic allocation regions that stage0 accepts.
        def collect_region_consumes(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            owned_collect_moves(value, out)
                        Stmt.Expr(expression, line):
                            owned_collect_moves(expression, out)
                        Stmt.Return(value, line):
                            if value is returned_value:
                                owned_collect_moves(returned_value, out)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            if kind == "destroy":
                                out.extend(clause)
                            else:
                                collect_region_consumes(block_body, out)
                        Stmt.If(condition, then_body, else_body, if_line):
                            collect_region_consumes(then_body, out)
                            collect_region_consumes(else_body, out)
                        Stmt.While(while_condition, while_body, while_line):
                            collect_region_consumes(while_body, out)
                        Stmt.For(bind, variables, iterable, body, for_line):
                            collect_region_consumes(body, out)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |out|:
                                collect_region_consumes(arm.body, out)
                        _:
                            pass


        # Collect the names of bare `region NAME(size)` declarations (empty-body region blocks)
        # anywhere in a body — the LOCAL regions a function owns.
        def collect_region_decl_names(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Block(kind, clause, binding, block_body, line):
                            out.push(binding) if kind == "region" and block_body.count == 0 and binding != ""
                            collect_region_decl_names(block_body, out) if kind != "region"
                        Stmt.If(condition, then_body, else_body, if_line):
                            collect_region_decl_names(then_body, out)
                            collect_region_decl_names(else_body, out)
                        Stmt.While(while_condition, while_body, while_line):
                            collect_region_decl_names(while_body, out)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            collect_region_decl_names(for_body, out)
                        _:
                            pass

        # Every name a `return move X` transfers out of a body.
        def collect_return_moves(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Return(value, line):
                            owned_collect_moves(returned, out) if value is returned
                        Stmt.If(condition, then_body, else_body, if_line):
                            collect_return_moves(then_body, out)
                            collect_return_moves(else_body, out)
                        Stmt.While(while_condition, while_body, while_line):
                            collect_return_moves(while_body, out)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            collect_return_moves(for_body, out)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            collect_return_moves(block_body, out)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |out|:
                                collect_return_moves(arm.body, out)
                        _:
                            pass

        # Whether a function `return move X`s a LOCAL region it declared — such a function
        # hands an OWNED region to its caller, so the caller's binding must be consumed. A
        # function that returns a borrowed param (`return owner`, no move of a local region)
        # is NOT owned-returning, so callers of it stay unflagged.
        def fn_returns_owned_region(body: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                region_names: mutable darray[sview] = []
                collect_region_decl_names(body, region_names)
                false return if region_names.count == 0
                return_moves: mutable darray[sview] = []
                collect_return_moves(body, return_moves)
                return any region_name in region_names where (any moved in return_moves where moved == region_name)

        # The set of functions that return an owned local region (by name).
        def collect_owned_region_returning_fns(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            out.push(function_name) if function_name != "" and fn_returns_owned_region(body)
                        Decl.Module(module_name, module_body, module_line):
                            collect_owned_region_returning_fns(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_owned_region_returning_fns(scoped_body, out)
                        _:
                            pass

        # Whether a VarDecl initializer is a direct call to an owned-region-returning function,
        # so the bound local inherits the consumption obligation.
        def value_calls_owned_returning_fn(value: Ast::Expr, owned_returning_fns: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        return callee_name != "" and (any fn_name in owned_returning_fns where fn_name == callee_name)
                    Expr.Paren(inner, paren_line):
                        return value_calls_owned_returning_fn(inner, owned_returning_fns)
                    _:
                        return false

        # Walk a body in order, tracking which owned names are still live. `live` carries the
        # names; `consumed` the ones already destroyed or moved out. `tracked_regions` names the
        # bare regions that are manually consumed somewhere and so bear a linear obligation.
        # `owned_returning_fns` names functions whose result is an owned region.
        def owned_walk(statements: darray[Ast::Stmt], live: mutable darray[sview]&, consumed: mutable darray[sview]&, tracked_regions: darray[sview]&, owned_returning_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |live, consumed, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            moved_from: sview = owned_move_source(value)
                            source_name: sview = ident_name_of(value)
                            declares_owned: bool = annotation_is_owned(type_expression)
                            # `s: owned T = r` — a bare owned source is a COPY of a move-only
                            # value. stage0 names both sides in the message.
                            copies_owned: bool = declares_owned and moved_from == "" and source_name != "" and (any l in live where l == source_name)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OwnedRegionMoveOnly, name: source_name, line: line, expected: name, actual: ""}) if copies_owned
                            # A move CONSUMES its source.
                            if moved_from != "":
                                already: bool = any c in consumed where c == moved_from
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OwnedRegionAlreadyDestroyed, name: moved_from, line: line, expected: "", actual: ""}) if already
                                consumed.push(moved_from)
                            # A local bound to a call returning an owned region inherits the
                            # linear obligation, even when its annotation is a bare `Arena`.
                            returns_owned_region: bool = moved_from == "" and value_calls_owned_returning_fn(value, owned_returning_fns)
                            live.push(name) if declares_owned or returns_owned_region
                        Stmt.Expr(expression, line):
                            call_moves: mutable darray[sview] = []
                            owned_collect_moves(expression, call_moves)
                            for call_moved in call_moves |consumed, table| -> table:
                                moved_twice: bool = any c in consumed where c == call_moved
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OwnedRegionAlreadyDestroyed, name: call_moved, line: line, expected: "", actual: ""}) if moved_twice
                                consumed.push(call_moved)
                        # `_ = submit[...] worker(move r)` — a DISCARD (`_ =`) whose value consumes
                        # owned regions exactly like a bare call statement. Restricted to the `_`
                        # discard target: a real `x <- move y` reassignment has its own re-
                        # establishment semantics the runtime relies on, so only the discard form
                        # (which cannot re-establish anything) is treated as a plain consume.
                        Stmt.Assign(target, operator, value, line):
                            is_discard: bool = ident_name_of(target) == "_"
                            assign_moves: mutable darray[sview] = []
                            owned_collect_moves(value, assign_moves) if is_discard
                            for assign_moved in assign_moves |consumed, table| -> table:
                                assign_moved_twice: bool = any c in consumed where c == assign_moved
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OwnedRegionAlreadyDestroyed, name: assign_moved, line: line, expected: "", actual: ""}) if assign_moved_twice
                                consumed.push(assign_moved)
                        # `return submit[...] worker(move r)` — a RETURN's expression can
                        # consume owned regions exactly like a call statement.
                        Stmt.Return(value, line):
                            if value is returned_value:
                                return_moves: mutable darray[sview] = []
                                owned_collect_moves(returned_value, return_moves)
                                for return_moved in return_moves |consumed, table| -> table:
                                    returned_twice: bool = any c in consumed where c == return_moved
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OwnedRegionAlreadyDestroyed, name: return_moved, line: line, expected: "", actual: ""}) if returned_twice
                                    consumed.push(return_moved)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            block_kind: sview = kind
                            if block_kind == "destroy":
                                for destroyed in clause |live, consumed, table| -> table:
                                    already_destroyed: bool = any c in consumed where c == destroyed
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OwnedRegionAlreadyDestroyed, name: destroyed, line: line, expected: "", actual: ""}) if already_destroyed
                                    consumed.push(destroyed)
                            elif block_kind == "region" and block_body.count == 0 and binding != "" and (any r in tracked_regions where r == binding):
                                # A BARE `region NAME(size)` (no `:`-block) that is MANUALLY
                                # consumed somewhere (`tracked_regions`) is a linear owner: it
                                # must be consumed on EVERY path, else it leaks (consumed on one
                                # branch, live on another). A region consumed on no path is pure
                                # allocation backing -- auto-freed at scope exit -- and is never
                                # tracked here, so the fresh-allocation regions stage0 accepts
                                # stay clean. Parity: stage0's PARTIAL-consumption leak.
                                live.push(binding)
                            else:
                                table <- owned_walk(block_body, live, consumed, tracked_regions, owned_returning_fns, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            # The arms are MUTUALLY EXCLUSIVE, so each starts from the
                            # consumption state at the `if` -- `if c: release(move g) else:
                            # release(move g)` consumes `g` once on either path, not twice.
                            # Both arms' consumptions then merge into the parent, since after
                            # the `if` the value is gone on every path that ran a branch.
                            then_consumed: mutable darray[sview] = []
                            else_consumed: mutable darray[sview] = []
                            for carried in consumed |then_consumed, else_consumed|:
                                then_consumed.push(carried)
                                else_consumed.push(carried)
                            table <- owned_walk(then_body, live, then_consumed, tracked_regions, owned_returning_fns, table)
                            table <- owned_walk(else_body, live, else_consumed, tracked_regions, owned_returning_fns, table)
                            # A value is gone after the `if` only if EVERY path consumed it:
                            # merge the INTERSECTION of the two arms. A consume on just one
                            # branch (`if c: destroy g`) leaves `g` live -> leaks at exit,
                            # matching stage0. Both arms start from `consumed`, so the
                            # intersection already contains everything consumed before the `if`.
                            for from_then in then_consumed |consumed, else_consumed|:
                                in_else: bool = any e in else_consumed where e == from_then
                                consumed.push(from_then) if in_else and not (any c in consumed where c == from_then)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- owned_walk(while_body, live, consumed, tracked_regions, owned_returning_fns, table)
                        _:
                            pass


        def check_owned_region_walk(declarations: darray[Ast::Decl], owned_returning_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            live: mutable darray[sview] = []
                            consumed: mutable darray[sview] = []
                            # An `owned` PARAMETER is handed over to this function, so it
                            # carries the same obligation as a local.
                            for parameter in parameters |live|:
                                live.push(parameter.name) if annotation_is_owned(parameter.type_expression)
                            # Pre-scan: which bare regions are manually consumed anywhere in the
                            # body. Only those bear a linear obligation (partial-consumption leak);
                            # pure allocation-backing regions auto-free and stay untracked.
                            tracked_regions: mutable darray[sview] = []
                            collect_region_consumes(body, tracked_regions)
                            table <- owned_walk(body, live, consumed, tracked_regions, owned_returning_fns, table)
                            # Anything declared owned and never consumed leaks. `live` is
                            # append-only; subtracting `consumed` here avoids rebuilding it
                            # per event (a fresh darray from a helper is region-polymorphic
                            # and cannot be returned into this scope).
                            leak_line: mutable u32 = line
                            leak_index: mutable usize = 0
                            while leak_index < live.count |leak_index, live, consumed, table, leak_line| -> table:
                                leaked: sview = live[leak_index]
                                still_owned: bool = not (any c in consumed where c == leaked)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OwnedRegionNotConsumed, name: leaked, line: leak_line, expected: "", actual: ""}) if still_owned
                                leak_index <- leak_index + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_owned_region_walk(module_body, owned_returning_fns, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_owned_region_walk(scoped_body, owned_returning_fns, table)
                        _:
                            pass

    public:
        def check_owned_region(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owned_returning_fns: mutable darray[sview] = []
                collect_owned_region_returning_fns(declarations, owned_returning_fns)
                table <- check_owned_region_walk(declarations, owned_returning_fns, table)
