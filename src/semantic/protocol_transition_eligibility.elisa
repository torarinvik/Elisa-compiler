# Canonical graph/type prerequisites for consuming transitions. Neither query
# authorizes a transition: the caller must additionally prove ownership,
# provenance, module authority, successful transfer and native-effect obligations.
extend Semantic:
    private:
        def protocol_family_source_index(table: SymbolTable&, id: DeclId) -> u32 can[Abort.Panic]:
            return SYMBOL_INDEX_ROW_NONE if id.value.usize() >= table.symbols.count
            symbol: Symbol = table.symbols[id.value.usize()]
            return SYMBOL_INDEX_ROW_NONE if symbol.kind != SymbolKind.Struct or symbol.id.value != id.value
            found: mutable u32 = SYMBOL_INDEX_ROW_NONE
            for resolved in table.resolved_state_families |found|:
                if resolved.declaration_id.value == id.value:
                    return SYMBOL_INDEX_ROW_NONE if found != SYMBOL_INDEX_ROW_NONE or resolved.source_index.usize() >= table.state_family_declarations.count
                    found <- resolved.source_index
            return SYMBOL_INDEX_ROW_NONE if found == SYMBOL_INDEX_ROW_NONE
            family: Ast::StateFamily = table.state_family_declarations[found.usize()]
            return SYMBOL_INDEX_ROW_NONE if family.has_derive or family.states.count == 0 or family.owner != symbol.name or family.module_name != symbol.module_owner or family.declaration_line != symbol.line or family.pos.offset != symbol.offset
            for index in 0..<family.states.count:
                for previous in 0..<index:
                    return SYMBOL_INDEX_ROW_NONE if family.states[index] == family.states[previous]
            return found

    public:
        def protocol_state_edge_allowed(table: SymbolTable&, id: DeclId, source: u32, target: u32) -> bool can[Abort.Panic]:
            family_index: u32 = protocol_family_source_index(table, id)
            return false if family_index == SYMBOL_INDEX_ROW_NONE
            family: Ast::StateFamily = table.state_family_declarations[family_index.usize()]
            return false if source.usize() >= family.states.count or target.usize() >= family.states.count
            allowed: mutable bool = source == target
            # Validate every attached row before returning even a preservation edge.
            for resolved in table.resolved_state_edges:
                if resolved.declaration_id.value == id.value:
                    return false if resolved.source_index.usize() >= table.state_transition_declarations.count
                    edge: Ast::StateTransitionEdge = table.state_transition_declarations[resolved.source_index.usize()]
                    return false if not protocol_edge_belongs_to(&edge, &family)
            for index in 0..<table.state_transition_declarations.count |allowed|:
                edge: Ast::StateTransitionEdge = table.state_transition_declarations[index]
                continue if not protocol_edge_belongs_to(&edge, &family)
                return false if not protocol_family_has_state(&family, edge.source_state) or not protocol_family_has_state(&family, edge.target_state)
                matches: mutable usize = 0
                for resolved in table.resolved_state_edges |matches|:
                    if resolved.source_index.usize() == index:
                        return false if resolved.declaration_id.value != id.value
                        matches <- matches + 1
                return false if matches != 1
                for previous in 0..<index:
                    peer: Ast::StateTransitionEdge = table.state_transition_declarations[previous]
                    return false if protocol_edge_belongs_to(&peer, &family) and peer.source_state == edge.source_state and peer.target_state == edge.target_state
                allowed <- true if edge.source_state == family.states[source.usize()] and edge.target_state == family.states[target.usize()]
            return allowed

        def protocol_binding_owned_type(table: SymbolTable&, id: BindingId) -> bool can[Abort.Panic]:
            return false if id.owner.value.usize() >= table.symbols.count
            owner: Symbol = table.symbols[id.owner.value.usize()]
            return false if owner.kind != SymbolKind.Func or owner.id.value != id.owner.value
            found: mutable bool = false
            eligible: mutable bool = false
            for declaration in table.binding_declared_types |found, eligible|:
                if ownership_binding_ids_equal(declaration.binding_id, id):
                    return false if found
                    found <- true
                    state: BindingStateIdentity = declaration.state_identity
                    family_index: u32 = protocol_family_source_index(table, state.family_id)
                    return false if family_index == SYMBOL_INDEX_ROW_NONE
                    family: Ast::StateFamily = table.state_family_declarations[family_index.usize()]
                    return false if state.state_index.usize() >= family.states.count
                    caps: BindingCapabilities = declaration.capabilities
                    eligible <- ProtocolOwner::eligible(caps.known, caps.borrowed, declaration.explicit_borrow, declaration.linear_mutable or caps.linear_mutable, state.known, state.protocol, caps.declaration_id.value == state.family_id.value, family.affinity == "affine" or family.affinity == "linear")
            return found and eligible
