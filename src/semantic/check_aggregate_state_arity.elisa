extend Semantic:
    private:
        def aggregate_state_marker(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name in {"?", "&", "!"}
                    _:
                        return false

        def declared_aggregate_state_arity(annotations: darray[Ast::EnumAnnotation]&, owner: sview) -> u32:
            count: mutable u32 = 0
            for annotation in annotations |count|:
                count <- count + 1 if annotation.owner == owner and annotation.name == "__aggregate_state"
            return count

        def check_aggregate_state_application(head: Ast::Expr, arguments: darray[Ast::Expr]&, line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                head_name: sview = ident_name_of(head)
                actual: mutable u32 = 0
                for argument in arguments |actual|:
                    actual <- actual + 1 if aggregate_state_marker(argument)
                return if head_name == "" or actual == 0
                expected: u32 = declared_aggregate_state_arity(annotations, head_name)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AggregateStateArity, name: head_name, line: line, expected: "", actual: "", expected_count: expected, actual_count: actual}) if expected != actual

        def check_aggregate_state_type(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(head, argument, line):
                        arguments: darray[Ast::Expr] = [argument]
                        table <- check_aggregate_state_application(head, arguments, line.line, annotations, table)
                    Expr.IndexN(head, arguments, line):
                        argument_handles: mutable darray[Ast::Expr] = []
                        argument_handles.extend(arguments)
                        table <- check_aggregate_state_application(head, argument_handles, line.line, annotations, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_aggregate_state_type(operand, annotations, table)
                    _:
                        pass

        def check_aggregate_state_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_aggregate_state_type(type_expression, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_aggregate_state_statements(then_body, annotations, table)
                            table <- check_aggregate_state_statements(else_body, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- check_aggregate_state_statements(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_aggregate_state_statements(body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_aggregate_state_statements(body, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_aggregate_state_statements(arm.body, annotations, table)
                        _:
                            pass

        def check_aggregate_state_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            for parameter in parameters |table|:
                                table <- check_aggregate_state_type(parameter.type_expression, annotations, table)
                            table <- check_aggregate_state_type(return_value, annotations, table) if return_type is return_value
                            table <- check_aggregate_state_statements(body, annotations, table)
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |table|:
                                table <- check_aggregate_state_type(member.type_expression, annotations, table)
                        Decl.Module(name, body, line):
                            table <- check_aggregate_state_declarations(body, annotations, table)
                        Decl.Scoped(body, line):
                            table <- check_aggregate_state_declarations(body, annotations, table)
                        _:
                            pass

    public:
        def check_aggregate_state_arity(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_aggregate_state_declarations(file.top_decls, file.enum_annotations, table)
