# Ghost-local read by real code. A `ghost NAME: T = v` local is verification-only and erased
# from codegen, so it may be read only inside contracts (requires/ensure/invariant/assert) or
# another `ghost` declaration. Reading it from real code (a return, a real local's initializer,
# an assignment value, a call argument, a branch condition) is rejected.
#
# The parser drops the `ghost` keyword but records each ghost binding's line on the dedicated
# File.ghost_local_lines side-table. Within a function body a VarDecl is ghost iff its line is
# one of those; ghost VarDecl initializers are themselves exempt (a ghost may read another
# ghost). Contract statements are never walked, so `old(g)` / `invariant g>=0` stay clean.
extend Semantic:
    private:
        # First ghost name read anywhere in EXPRESSION, else "".
        def expression_reads_ghost(expression: Ast::Expr, ghost_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return name if (any ghost_name in ghost_names where ghost_name == name) else sview("", 0, 0)
                    Expr.Paren(inner, line):
                        return expression_reads_ghost(inner, ghost_names)
                    Expr.Move(inner, line):
                        return expression_reads_ghost(inner, ghost_names)
                    Expr.Unary(operator, operand, line):
                        return expression_reads_ghost(operand, ghost_names)
                    Expr.Binary(left, operator, right, line):
                        found_left: sview = expression_reads_ghost(left, ghost_names)
                        return found_left if found_left != "" else expression_reads_ghost(right, ghost_names)
                    Expr.Field(object, field, line):
                        return expression_reads_ghost(object, ghost_names)
                    Expr.Index(head, argument, line):
                        found_head: sview = expression_reads_ghost(head, ghost_names)
                        return found_head if found_head != "" else expression_reads_ghost(argument, ghost_names)
                    Expr.Slice(object, low, high, line):
                        return expression_reads_ghost(object, ghost_names)
                    Expr.Call(callee, arguments, argument_names, line):
                        found_callee: sview = expression_reads_ghost(callee, ghost_names)
                        found_callee return if found_callee != ""
                        argument_hit: mutable sview = sview("", 0, 0)
                        for argument in arguments |argument_hit|:
                            candidate: sview = expression_reads_ghost(argument, ghost_names)
                            argument_hit <- candidate if argument_hit == "" and candidate != ""
                        return argument_hit
                    Expr.Array(elements, line):
                        element_hit: mutable sview = sview("", 0, 0)
                        for element in elements |element_hit|:
                            candidate: sview = expression_reads_ghost(element, ghost_names)
                            element_hit <- candidate if element_hit == "" and candidate != ""
                        return element_hit
                    Expr.If(condition, then_expression, else_expression, line):
                        found_condition: sview = expression_reads_ghost(condition, ghost_names)
                        found_condition return if found_condition != ""
                        found_then: sview = expression_reads_ghost(then_expression, ghost_names)
                        return found_then if found_then != "" else expression_reads_ghost(else_expression, ghost_names)
                    _:
                        return sview("", 0, 0)

        def report_ghost_read(expression: Ast::Expr, ghost_names: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                hit: sview = expression_reads_ghost(expression, ghost_names)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GhostLocalRead, name: hit, line: line, expected: "", actual: ""}) if hit != ""

        # Names of ghost locals in a body (VarDecls whose line is a ghost line).
        def collect_ghost_local_names(statements: darray[Ast::Stmt], ghost_lines: darray[u32]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if any ghost_line in ghost_lines where ghost_line == line
                        Stmt.If(condition, then_body, else_body, line):
                            collect_ghost_local_names(then_body, ghost_lines, out)
                            collect_ghost_local_names(else_body, ghost_lines, out)
                        Stmt.While(condition, while_body, line):
                            collect_ghost_local_names(while_body, ghost_lines, out)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            collect_ghost_local_names(for_body, ghost_lines, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            collect_ghost_local_names(body, ghost_lines, out)
                        _:
                            pass

        def ghost_read_walk(statements: darray[Ast::Stmt], ghost_names: darray[sview]&, ghost_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- report_ghost_read(returned, ghost_names, line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # A ghost VarDecl's own initializer is exempt (ghost may read ghost).
                            table <- report_ghost_read(value, ghost_names, line, table) if not (any ghost_line in ghost_lines where ghost_line == line)
                        Stmt.Assign(target, operator, value, line):
                            table <- report_ghost_read(value, ghost_names, line, table)
                        Stmt.Expr(expression, line):
                            table <- report_ghost_read(expression, ghost_names, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- report_ghost_read(condition, ghost_names, line, table)
                            table <- ghost_read_walk(then_body, ghost_names, ghost_lines, table)
                            table <- ghost_read_walk(else_body, ghost_names, ghost_lines, table)
                        Stmt.While(condition, while_body, line):
                            table <- report_ghost_read(condition, ghost_names, line, table)
                            table <- ghost_read_walk(while_body, ghost_names, ghost_lines, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- report_ghost_read(iterable, ghost_names, line, table)
                            table <- ghost_read_walk(for_body, ghost_names, ghost_lines, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- ghost_read_walk(body, ghost_names, ghost_lines, table)
                        _:
                            pass

        def check_ghost_local_read_walk(declarations: darray[Ast::Decl], ghost_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            ghost_names: mutable darray[sview] = []
                            collect_ghost_local_names(body, ghost_lines, ghost_names)
                            table <- ghost_read_walk(body, ghost_names, ghost_lines, table) if ghost_names.count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_ghost_local_read_walk(module_body, ghost_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_ghost_local_read_walk(scoped_body, ghost_lines, table)
                        _:
                            pass

        def check_ghost_local_read(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_ghost_local_read_walk(file.top_decls, file.ghost_local_lines, table) if file.ghost_local_lines.count > 0
