# `else void` is a NO-OP recovery, valid only when the guarded value's result is itself void
# (a `try void_call() else void` statement). Used where a VALUE is expected — as a `return`
# in a non-void function, or a non-void-typed `let` initializer — it cannot yield the required
# type. The parser lowers `EXPR else void` to `Refinement(Ident("void"), guarded)`; this pass
# flags that shape in a value context. (Resolution already skips the `void` base as a keyword.)
extend Semantic:
    private:
        # Whether an expression is the `… else void` recovery form `Refinement(void, guarded)`.
        def else_void_is_void_recovery(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Refinement(base, predicate, line):
                        match base:
                            Expr.Ident(base_name, base_line):
                                return base_name == "void"
                            _:
                                return false
                    _:
                        return false

        # The bare type name of a type expression (strips `?`/`&`/paren wrappers to the head).
        def else_void_type_name(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, line):
                        return name
                    Expr.Paren(inner, line):
                        return else_void_type_name(inner)
                    Expr.Unary(operator, operand, line):
                        return else_void_type_name(operand)
                    _:
                        return sview("", 0, 0)

        def else_void_statements(statements: darray[Ast::Stmt], return_type_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned_value:
                                if else_void_is_void_recovery(returned_value) and return_type_name != "" and return_type_name != "void":
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GetFallbackVoidNonVoid, name: "", line: line.line, expected: return_type_name, actual: "", detail: "void"})
                        Stmt.VarDecl(name, type_expression, value, line):
                            declared_type: sview = else_void_type_name(type_expression)
                            if else_void_is_void_recovery(value) and declared_type != "" and declared_type != "void":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GetFallbackVoidNonVoid, name: "", line: line.line, expected: declared_type, actual: "", detail: "void"})
                        Stmt.If(condition, then_body, else_body, line):
                            table <- else_void_statements(then_body, return_type_name, table)
                            table <- else_void_statements(else_body, return_type_name, table)
                        Stmt.While(condition, body, line):
                            table <- else_void_statements(body, return_type_name, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- else_void_statements(body, return_type_name, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- else_void_statements(body, return_type_name, table)
                        _:
                            pass

        def check_else_void_context(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            return_type_name: mutable sview = "void"
                            if return_type is present_return_type:
                                return_type_name <- else_void_type_name(present_return_type)
                            table <- else_void_statements(body, return_type_name, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_else_void_context(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_else_void_context(scoped_body, table)
                        _:
                            pass
