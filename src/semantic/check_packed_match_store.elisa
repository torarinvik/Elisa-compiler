extend Semantic:
    private:
        def packed_enum_name(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any packed_name in table.packed_enum_names where packed_name == name


        def match_scrutinee_without_store(expression: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                left return if expression is Expr.Binary(left, operator, right, line) and operator == TokenKind.In
                return expression


        def match_has_store_clause(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                true return if expression is Expr.Binary(left, operator, right, line) and operator == TokenKind.In
                return false


        def packed_owner_available(owners: darray[sview]&, owner: sview) -> bool:
            can Abort.Panic:
                return any available in owners where available == owner


        def check_one_match_store(scrutinee: Ast::Expr, line: u32, names: darray[sview]&, types: darray[sview]&, store_owners: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                base: Ast::Expr = match_scrutinee_without_store(scrutinee)
                inferred: InferType = infer_expression_type(base, names, types, table)
                return if inferred.kind != TypeKind.Named
                is_packed: bool = packed_enum_name(inferred.name, table)
                has_clause: bool = match_has_store_clause(scrutinee)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedMatchMissingStore, name: inferred.name, line: line, expected: "", actual: ""}) if is_packed and not has_clause and not packed_owner_available(store_owners, inferred.name)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrdinaryMatchWithStore, name: inferred.name, line: line, expected: "", actual: ""}) if not is_packed and has_clause


        def walk_packed_match_store(statements: darray[Ast::Stmt], names: mutable darray[sview]&, types: mutable darray[sview]&, store_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, types, store_owners, table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            note_local_type(names, types, name, bare_type_name_through_ref(type_expression))
                            store_owners.push(packed_store_owner_of_type(type_expression))
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_packed_match_store(then_body, names, types, store_owners, table)
                            table <- walk_packed_match_store(else_body, names, types, store_owners, table)
                        Stmt.While(condition, body, line):
                            table <- walk_packed_match_store(body, names, types, store_owners, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_packed_match_store(body, names, types, store_owners, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_packed_match_store(body, names, types, store_owners, table) if kind != "move"
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_one_match_store(scrutinee, line, names, types, store_owners, table)
                            for arm in arms |names, types, store_owners, table|:
                                table <- walk_packed_match_store(arm.body, names, types, store_owners, table)
                        _:
                            pass


        def check_packed_match_store_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            types: mutable darray[sview] = []
                            store_owners: mutable darray[sview] = []
                            for param in params |names, types, store_owners|:
                                note_local_type(names, types, param.name, bare_type_name_through_ref(param.type_expression))
                                store_owners.push(packed_store_owner_of_type(param.type_expression))
                            table <- walk_packed_match_store(body, names, types, store_owners, table)
                        Decl.Module(name, body, line):
                            table <- check_packed_match_store_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_packed_match_store_declarations(body, table)
                        _:
                            pass

    public:
        def check_packed_match_store(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_packed_match_store_declarations(declarations, table)
