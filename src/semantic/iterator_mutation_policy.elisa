# Source-level policy for operations that may mutate or invalidate a collection while its
# iteration snapshot is live. Keep this list proof-bound: adding a backend mutator without
# classifying it here can invalidate the iterator's saved storage or observed values.
module SemanticIteratorMutationPolicy:
    public:
        ghost def forbidden_during_iteration_spec(method: sview) -> bool:
            ensure result == (method == "push" or method == "extend" or method == "insert" or method == "append" or method == "reserve" or method == "clear" or method == "truncate" or method == "resize")
            return method == "push" or method == "extend" or method == "insert" or method == "append" or method == "reserve" or method == "clear" or method == "truncate" or method == "resize"

        def forbidden_during_iteration(method: sview) -> bool:
            ensure result == forbidden_during_iteration_spec(method)
            return method == "push" or method == "extend" or method == "insert" or method == "append" or method == "reserve" or method == "clear" or method == "truncate" or method == "resize"
