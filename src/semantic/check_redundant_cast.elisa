# Check for redundant `.cast[T]` where the operand already has type T.
# E.g., x: i32; y: i32 = x.cast[i32] — the cast is a no-op, remove it.
# Disjoint from InvalidCast (resolve_types.elisa): that check owns recv_type != target_type
# for different numeric primitives. This check owns ONLY the recv_type == target_type case.

extend Semantic:
    private:
        # Walk through expressions, checking for redundant casts.
        def walk_expression_for_redundant_cast(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        # Recursively walk both sides
                        table <- walk_expression_for_redundant_cast(left, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LegacyCastCallSyntax, name: "cast", line: line, expected: "", actual: ""}) if arguments.count == 0 and callee is Expr.Index(Expr.Field(receiver, field_name, field_line), target_type, index_line) and field_name == "cast"
                        table <- walk_expression_for_redundant_cast(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_redundant_cast(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_redundant_cast(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_redundant_cast(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RemovedRefShorthand, name: "ref", line: line, expected: "", actual: ""}) if object is Expr.Field(receiver_for_ref, ref_field, ref_line) and ref_field == "ref"
                        # Detect redundant `.cast[T]`: object is `recv.cast`, index is the target
                        # type name. The receiver's type is inferred, so arithmetic operands
                        # (`(i - 1).cast[u64]` where i is u64) are covered, not just bare idents.
                        if object is Expr.Field(receiver, field_name, field_line) and field_name == "cast" and index is Expr.Ident(target_type_name, target_line):
                            recv_type: sview = infer_expression_type(receiver, var_types, type_names, table).name
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantCast, name: recv_type, line: line, expected: "", actual: ""}) if recv_type != "" and target_type_name != "" and recv_type == target_type_name
                        table <- walk_expression_for_redundant_cast(object, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_redundant_cast(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_redundant_cast(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_redundant_cast(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_redundant_cast(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_redundant_cast(object, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(low, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_redundant_cast(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_redundant_cast(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_redundant_cast(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_redundant_cast(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_redundant_cast(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_redundant_cast(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_redundant_cast(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_redundant_cast(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_redundant_cast(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_redundant_cast(condition, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_redundant_cast(iterable, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(condition, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_redundant_cast(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_redundant_cast(statements, table, var_types, type_names)
                        table <- walk_expression_for_redundant_cast(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_redundant_cast(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_redundant_cast(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for impossible comparisons.
        def walk_statements_for_redundant_cast(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_redundant_cast(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_redundant_cast(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_redundant_cast(target, table, var_types, type_names)
                            table <- walk_expression_for_redundant_cast(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_redundant_cast(condition, table, var_types, type_names)
                            table <- walk_statements_for_redundant_cast(then_body, table, var_types, type_names)
                            table <- walk_statements_for_redundant_cast(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_redundant_cast(condition, table, var_types, type_names)
                            table <- walk_statements_for_redundant_cast(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_redundant_cast(iterable, table, var_types, type_names)
                            table <- walk_statements_for_redundant_cast(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_redundant_cast(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_redundant_cast(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_redundant_cast(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_redundant_cast(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_redundant_cast(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_redundant_cast(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_redundant_cast_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_redundant_cast(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_redundant_cast_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_redundant_cast_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_redundant_cast(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_redundant_cast_declarations(declarations, table)
