# Impl-vs-protocol conformance — missing members (stage0 impl conformance). An
# `impl P for T:` must provide every method and associated type that protocol P declares,
# including those inherited from a supertype (`protocol Ord is Eq`). A missing member is
# rejected:
#
#   protocol Container:
#       type Elem
#       def size(self: Self) -> i64
#   impl Container for IntBuf:
#       def size(self: IntBuf) -> i64: ...   # missing `type Elem` -> error
#
# The parser records protocol member names on the side-table: methods at 3900000060 and
# associated types at 3900000061 (owner = protocol), the supertype at 3900000013, and the
# impl body's line via __impl_scope (name = interface) + __impl_concrete (name = concrete).
# The impl body is a `Decl.Scoped` whose line matches __impl_scope; its provided members are
# its `def` (method) and `type X = ...` alias declarations.
extend Semantic:
    private:
        def imc_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for entry in names:
                    return true if entry == wanted
                return false

        def imc_annotation_value(annotations: darray[Ast::EnumAnnotation]&, owner: sview, sentinel: u32) -> sview:
            can Abort.Panic:
                for annotation in annotations:
                    return annotation.name if annotation.owner == owner and annotation.line == sentinel
                return sview("", 0, 0)

        # The annotation rows chained per owner name in ascending order: a lookup by owner
        # visits exactly the rows the full scan matches, in the same order.
        struct ImcIndex:
            heads: mutable dict[u64, u32] = {}
            chain_next: mutable darray[u32] = []

        struct ImcErrorFamily:
            family: sview @source
            path: sview @source
            module: sview @source
            module_known: bool
            subset_restricted: bool
            # Fresh checker buffer; only the spelling views point into source storage.
            subset_variants: darray[sview @source] @source

        struct ImcErrorSubset:
            restricted: bool
            # Fresh checker buffer; the variant spellings themselves are source-backed.
            variants: darray[sview @source] @source

        def imc_build_index(annotations: darray[Ast::EnumAnnotation]&, owner_index: mutable ImcIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                tails: mutable dict[u64, u32] = {}
                for row in 0..<annotations.count |owner_index, tails, annotations|:
                    hash: u64 = name_hash(annotations[row].owner)
                    owner_index.chain_next.push(SYMBOL_INDEX_ROW_NONE)
                    if tails.get(hash) is owner_tail:
                        owner_index.chain_next[owner_tail.usize()] <- row.u32()
                    else:
                        owner_index.heads <- owner_index.heads.put(hash, row.u32()) can Global{Read,Write}
                    tails <- tails.put(hash, row.u32()) can Global{Read,Write}

        def imc_index_head(owner_index: ImcIndex&, owner: sview) -> u32:
            can Abort.Panic:
                return head if owner_index.heads.get(name_hash(owner)) is head else SYMBOL_INDEX_ROW_NONE

        # imc_annotation_value over the owner chain.
        def imc_indexed_value(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, owner: sview, sentinel: u32) -> sview:
            can Abort.Panic:
                row: mutable u32 = imc_index_head(owner_index, owner)
                while row != SYMBOL_INDEX_ROW_NONE |row|:
                    annotation: Ast::EnumAnnotation = annotations[row.usize()]
                    return annotation.name if annotation.owner == owner and annotation.line == sentinel
                    row <- owner_index.chain_next[row.usize()]
                return sview("", 0, 0)

        # The names of `owner`'s rows at `sentinel`, in table order, appended to OUT unless OUT
        # already held them before this call (the former comprehension's filter, evaluated
        # against OUT as it was) -- over the owner chain instead of every row.
        def imc_owner_names(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, owner: sview, sentinel: u32, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                prior: usize = out.count
                row: mutable u32 = imc_index_head(owner_index, owner)
                while row != SYMBOL_INDEX_ROW_NONE |row, out, prior|:
                    annotation: Ast::EnumAnnotation = annotations[row.usize()]
                    if annotation.owner == owner and annotation.line == sentinel:
                        already: mutable bool = false
                        for prior_index in 0..<prior |already, out, annotation|:
                            already <- true if out[prior_index] == annotation.name
                        out.push(annotation.name) if not already
                    row <- owner_index.chain_next[row.usize()]

        # Whether `owner` has a row at `sentinel` named `name` (over the owner chain).
        def imc_owner_has(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, owner: sview, sentinel: u32, name: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = imc_index_head(owner_index, owner)
                while row != SYMBOL_INDEX_ROW_NONE |row|:
                    annotation: Ast::EnumAnnotation = annotations[row.usize()]
                    return true if annotation.owner == owner and annotation.line == sentinel and annotation.name == name
                    row <- owner_index.chain_next[row.usize()]
                return false

        # Collect protocol P's required members (of the given sentinel kind), transitively
        # following the `is Parent` supertype chain.
        def imc_collect_required(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, protocol: sview, sentinel: u32, visited: mutable darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if imc_name_in(visited, protocol)
                visited.push(protocol)
                row: mutable u32 = imc_index_head(owner_index, protocol)
                while row != SYMBOL_INDEX_ROW_NONE |row, out|:
                    annotation: Ast::EnumAnnotation = annotations[row.usize()]
                    out.push(annotation.name) if annotation.owner == protocol and annotation.line == sentinel and not imc_name_in(out, annotation.name)
                    row <- owner_index.chain_next[row.usize()]
                parent: sview = imc_indexed_value(annotations, owner_index, protocol, 3900000013)
                imc_collect_required(annotations, owner_index, parent, sentinel, visited, out) if parent != ""

        # The effects (dotted `Family.Member`) protocol method `method` grants (3900000063).
        def imc_protocol_effects(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, interface: sview, method: sview, module_scope: usize, protocol_names: darray[sview]&, protocol_scopes: darray[usize]&, context: GlobalAuthority&, out: mutable darray[sview]&, scopes: mutable darray[usize]&, offsets: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                protocol: usize = canonical_named_slot(interface, module_scope, protocol_names, protocol_scopes, context)
                return if protocol >= protocol_names.count
                owner: sview = protocol_names[protocol]
                origin_scope: usize = protocol_scopes[protocol]
                method_row: mutable u32 = imc_index_head(owner_index, owner)
                while method_row != SYMBOL_INDEX_ROW_NONE |method_row, out, scopes, offsets|:
                    declaration: Ast::EnumAnnotation = annotations[method_row.usize()]
                    method_row <- owner_index.chain_next[method_row.usize()]
                    continue if declaration.owner != owner or declaration.name != method or declaration.line != 3900000060 or ga_module_text(declaration.module, context) != origin_scope
                    ref_row: mutable u32 = imc_index_head(owner_index, method)
                    while ref_row != SYMBOL_INDEX_ROW_NONE |ref_row, out, scopes, offsets|:
                        effect: Ast::EnumAnnotation = annotations[ref_row.usize()]
                        ref_row <- owner_index.chain_next[ref_row.usize()]
                        if effect.owner == method and effect.line == 3900000063 and effect.offset == declaration.offset and effect.module == declaration.module:
                            out.push(effect.name)
                            scopes.push(origin_scope)
                            offsets.push(effect.offset)

        # Inferred rows are complete before conformance runs. Concrete method
        # signatures remain optional; bodyless protocol declarations bound the row.
        def imc_check_effects(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, body: darray[Ast::Decl], interface: sview @source, line: u32, table: lmut SymbolTable, module_scope: usize, protocol_names: darray[sview]&, protocol_scopes: darray[usize]&, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in body |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, func_body, effects, decorators, func_line):
                            allowed: mutable darray[sview] = []
                            allowed_scopes: mutable darray[usize] = []
                            allowed_offsets: mutable darray[u32] = []
                            imc_protocol_effects(annotations, owner_index, interface, name, module_scope, protocol_names, protocol_scopes, context, allowed, allowed_scopes, allowed_offsets)
                            slot: usize = canonical_effect_function(name, module_scope, func_line.offset, table)
                            if slot < table.effect_canonical_function_name.count:
                                start: usize = table.effect_canonical_function_row_start[slot]
                                end: usize = start + table.effect_canonical_function_row_count[slot]
                                for row in start..<end |table| -> table:
                                    ref: sview = table.effect_canonical_refs[table.effect_canonical_row_ref[row]]
                                    row_offset: u32 = table.effect_canonical_row_offset[row] if row < table.effect_canonical_row_offset.count else GLOBAL_AUTHORITY_OFFSET_NONE
                                    if not ga_refs_cover_at(allowed, allowed_scopes, allowed_offsets, ref, table.effect_canonical_row_scope[row], context, row_offset):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ImplEffectExtra, name: ref, line: func_line.line, pos: func_line, expected: name, actual: interface})
                            else:
                                for effect in effects |table| -> table:
                                    if not ga_refs_cover_at(allowed, allowed_scopes, allowed_offsets, effect, module_scope, context, func_line.offset):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ImplEffectExtra, name: effect, line: func_line.line, pos: func_line, expected: name, actual: interface})
                        _:
                            pass

        def imc_function_identity(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, function_pos: Ast::Pos) -> u32:
            can Abort.Panic:
                for annotation in annotations |function_name, function_pos|:
                    return annotation.identity_id if annotation.owner == function_name and annotation.name == "__error_return" and annotation.line == function_pos.line and (function_pos.offset == 0 or annotation.offset == 0 or annotation.offset == function_pos.offset)
                return 0

        def imc_function_error_occurrence(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, function_pos: Ast::Pos, identity_id: u32) -> (found: bool, offset: u32):
            can Abort.Panic:
                for annotation in annotations |function_name, function_pos, identity_id|:
                    continue if annotation.owner != function_name or annotation.name != "__error_return" or annotation.line != function_pos.line
                    continue if function_pos.offset != 0 and annotation.offset != 0 and annotation.offset != function_pos.offset
                    continue if identity_id != 0 and annotation.identity_id != 0 and annotation.identity_id != identity_id
                    return (true, annotation.occurrence_offset)
                return (false, 0)

        def imc_function_module(annotations: darray[Ast::EnumAnnotation]&, function_pos: Ast::Pos, identity_id: u32) -> (known: bool, module: sview @source):
            can Abort.Panic:
                for annotation in annotations |function_pos, identity_id|:
                    continue if annotation.owner != "__fn_module" or annotation.line != function_pos.line
                    continue if function_pos.offset != 0 and annotation.offset != 0 and annotation.offset != function_pos.offset
                    continue if identity_id != 0 and annotation.identity_id != 0 and annotation.identity_id != identity_id
                    return (true, annotation.name)
                return (false, "")

        def imc_resolve_error_family_module(annotations: darray[Ast::EnumAnnotation]&, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, family: sview @source, raw_path: sview @source, function_module: (known: bool, module: sview @source), table: SymbolTable&) -> (known: bool, module: sview @source):
            can Abort.Panic:
                return (false, family) if raw_path == ""
                path: sview @source = raw_path
                path_end: mutable usize = path.len
                while path_end > 0 and (path[path_end - 1.usize()] == 32 or path[path_end - 1.usize()] == 9) |path_end, path|:
                    path_end <- path_end - 1.usize()
                if path_end >= family.len and catch_module_path_matches(path[path_end - family.len:path_end], family):
                    family_start: usize = path_end - family.len
                    separator: usize = catch_family_separator_start(path, family_start)
                    if separator != path.len:
                        explicit: (found: bool, module: sview @source) = catch_explicit_error_family_module(path, declaration_line, declaration_offset, declaration_identity_id, function_module.module, family, annotations, table)
                        return (explicit.found, explicit.module)
                return catch_error_family_module(family, function_module.known, function_module.module, table)

        def imc_error_family_path(annotations: darray[Ast::EnumAnnotation]&, family_index: usize) -> sview @source:
            can Abort.Panic:
                return "" if family_index >= annotations.count
                family: Ast::EnumAnnotation = annotations[family_index]
                return "" if family_index + 1.usize() >= annotations.count
                path: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                return path.name if path.owner == "__error_set_family_path" and path.line == family.line and path.offset == family.offset and path.identity_id == family.identity_id and path.occurrence_offset == family.occurrence_offset
                return ""

        def imc_error_family_matches(allowed: darray[ImcErrorFamily]&, family: sview, path: sview, module_known: bool, module: sview) -> bool:
            can Abort.Panic:
                for expected in allowed |family, path, module_known, module|:
                    continue if expected.family != family
                    return true if expected.module_known and module_known and expected.module == module
                    return true if expected.path != "" and path != "" and not expected.module_known and not module_known and catch_module_path_matches(expected.path, path)
                return false

        def imc_protocol_error_subset(annotations: darray[Ast::EnumAnnotation]&, family: Ast::EnumAnnotation) -> ImcErrorSubset:
            can Memory.Allocate, Abort.Panic:
                restricted: mutable bool = false
                variants: mutable darray[sview @source] @source = []
                for annotation in annotations |restricted, variants, family|:
                    same_occurrence: bool = annotation.module == family.module and annotation.offset == family.offset and annotation.occurrence_offset == family.occurrence_offset
                    if annotation.owner == "__protocol_error_variant_family" and annotation.line == 3900000146 and annotation.name == family.name and same_occurrence:
                        restricted <- true
                    if annotation.owner == family.name and annotation.line == 3900000147 and same_occurrence:
                        already_present: mutable bool = false
                        for prior in variants |already_present, annotation|:
                            already_present <- true if prior == annotation.name
                        variants.push(annotation.name) if not already_present
                return ImcErrorSubset{restricted: restricted, variants: variants}

        def imc_impl_error_subset(annotations: darray[Ast::EnumAnnotation]&, family_index: usize, family: Ast::EnumAnnotation) -> ImcErrorSubset:
            can Memory.Allocate, Abort.Panic:
                restricted: mutable bool = false
                variants: mutable darray[sview @source] @source = []
                row_index: mutable usize = family_index + 2.usize()
                while row_index < annotations.count |row_index, annotations, family, restricted, variants|:
                    annotation: Ast::EnumAnnotation = annotations[row_index]
                    break if annotation.owner == "__error_set_family" and annotation.line == family.line and annotation.offset == family.offset and annotation.identity_id == family.identity_id
                    same_occurrence: bool = annotation.line == family.line and annotation.offset == family.offset and annotation.identity_id == family.identity_id and annotation.occurrence_offset == family.occurrence_offset
                    if annotation.owner == "__error_variant_family" and annotation.name == family.name and same_occurrence:
                        restricted <- true
                        if row_index + 1.usize() < annotations.count:
                            allow: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                            if allow.owner == "__error_variant_allow" and allow.line == annotation.line and allow.offset == annotation.offset and allow.identity_id == annotation.identity_id and allow.occurrence_offset == annotation.occurrence_offset:
                                variants.push(allow.name) if not imc_error_subset_contains(variants, allow.name)
                    row_index <- row_index + 1.usize()
                return ImcErrorSubset{restricted: restricted, variants: variants}

        def imc_error_subset_contains(variants: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for variant in variants:
                    return true if variant == wanted
                return false

        def imc_bool_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        # Repeated references to one family form a union of their allowed variants. The
        # implementation's declared subset must fit inside that union; an unrestricted
        # protocol family admits any implementation subset.
        def imc_error_family_subset_matches(allowed: darray[ImcErrorFamily]&, family: sview, path: sview, module_known: bool, module: sview, implementation: ImcErrorSubset) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not imc_error_family_matches(allowed, family, path, module_known, module)
                expected_variants: mutable darray[sview] = []
                unrestricted: mutable bool = false
                for expected in allowed |expected_variants, unrestricted, family, path, module_known, module|:
                    continue if expected.family != family
                    same_module: bool = expected.module_known and module_known and expected.module == module
                    same_unresolved_path: bool = expected.path != "" and path != "" and not expected.module_known and not module_known and catch_module_path_matches(expected.path, path)
                    continue if not same_module and not same_unresolved_path
                    if not expected.subset_restricted:
                        unrestricted <- true
                    else:
                        for variant in expected.subset_variants |expected_variants, expected|:
                            expected_variants.push(variant) if not imc_error_subset_contains(expected_variants, variant)
                return true if unrestricted
                return false if not implementation.restricted
                for variant in implementation.variants:
                    return false if not imc_error_subset_contains(expected_variants, variant)
                return true

        # Find the nearest protocol declaration for method in this protocol's
        # inheritance chain, then collect only the error rows attached to that exact
        # module+offset. Error rows use the method name as owner, which is not unique.
        def imc_protocol_method_errors(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, protocol_query: sview @source, method: sview, module_scope: usize, protocol_names: darray[sview]&, protocol_scopes: darray[usize]&, context: GlobalAuthority&, table: SymbolTable&, visited_names: mutable darray[sview]&, visited_scopes: mutable darray[usize]&, found_method: mutable bool&, out: mutable darray[ImcErrorFamily]&) -> void:
            can Memory.Allocate, Abort.Panic:
                protocol_slot: usize = canonical_named_slot(protocol_query, module_scope, protocol_names, protocol_scopes, context)
                return if protocol_slot >= protocol_names.count
                protocol: sview = protocol_names[protocol_slot]
                origin_scope: usize = protocol_scopes[protocol_slot]
                for index in 0..<visited_names.count |visited_names, visited_scopes, index|:
                    return if visited_names[index] == protocol and visited_scopes[index] == origin_scope
                visited_names.push(protocol)
                visited_scopes.push(origin_scope)
                declaration_row: mutable u32 = imc_index_head(owner_index, protocol)
                while declaration_row != SYMBOL_INDEX_ROW_NONE |declaration_row, annotations, owner_index, protocol, origin_scope, method, found_method, out, context, table|:
                    declaration: Ast::EnumAnnotation = annotations[declaration_row.usize()]
                    declaration_row <- owner_index.chain_next[declaration_row.usize()]
                    continue if declaration.owner != protocol or declaration.name != method or declaration.line != 3900000060 or ga_module_text(declaration.module, context) != origin_scope
                    found_method <- true
                    error_row: mutable u32 = imc_index_head(owner_index, method)
                    while error_row != SYMBOL_INDEX_ROW_NONE |error_row, annotations, owner_index, method, declaration, out, table|:
                        error_index: u32 = error_row
                        error_annotation: Ast::EnumAnnotation = annotations[error_index.usize()]
                        error_row <- owner_index.chain_next[error_index.usize()]
                        continue if error_annotation.owner != method or error_annotation.line != 3900000064 or error_annotation.module != declaration.module or error_annotation.offset != declaration.offset
                        path: mutable sview @source = ""
                        if error_index.usize() + 1.usize() < annotations.count:
                            next: Ast::EnumAnnotation = annotations[error_index.usize() + 1.usize()]
                            path <- next.name if next.owner == "__protocol_error_family_path" and next.line == 3900000067 and next.module == error_annotation.module and next.offset == error_annotation.offset and next.identity_id == error_annotation.identity_id and next.occurrence_offset == error_annotation.occurrence_offset
                        protocol_module: (known: bool, module: sview @source) = (true, declaration.module)
                        family_module: (known: bool, module: sview @source) = imc_resolve_error_family_module(annotations, declaration.line, declaration.offset, declaration.identity_id, error_annotation.name, path, protocol_module, table)
                        subset: ImcErrorSubset = imc_protocol_error_subset(annotations, error_annotation)
                        out.push(ImcErrorFamily{family: error_annotation.name, path: path, module: family_module.module, module_known: family_module.known, subset_restricted: subset.restricted, subset_variants: subset.variants})
                return if imc_bool_value(found_method)
                parent: sview = imc_indexed_value(annotations, owner_index, protocol, 3900000013)
                imc_protocol_method_errors(annotations, owner_index, parent, method, origin_scope, protocol_names, protocol_scopes, context, table, visited_names, visited_scopes, found_method, out) if parent != ""


        def imc_protocol_errors(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, interface: sview @source, method: sview, module_scope: usize, protocol_names: darray[sview]&, protocol_scopes: darray[usize]&, context: GlobalAuthority&, table: SymbolTable&, out: mutable darray[ImcErrorFamily]&) -> void:
            can Memory.Allocate, Abort.Panic:
                visited_names: mutable darray[sview] = []
                visited_scopes: mutable darray[usize] = []
                found_method: mutable bool = false
                imc_protocol_method_errors(annotations, owner_index, interface, method, module_scope, protocol_names, protocol_scopes, context, table, visited_names, visited_scopes, found_method, out)
        # For each impl method, flag a family absent from the protocol method's error set or an
        # implementation subset that widens the protocol's restricted variant subset.
        def imc_check_errors(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, body: darray[Ast::Decl], interface: sview @source, line: u32, table: lmut SymbolTable, module_scope: usize, protocol_names: darray[sview]&, protocol_scopes: darray[usize]&, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in body |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, func_body, effects, decorators, func_line):
                            allowed: mutable darray[ImcErrorFamily] = []
                            empty_subset_variants: mutable darray[sview @source] @source = []
                            empty_subset: ImcErrorSubset = ImcErrorSubset{restricted: false, variants: empty_subset_variants}
                            identity_id: u32 = imc_function_identity(annotations, name, func_line)
                            return_occurrence: (found: bool, offset: u32) = imc_function_error_occurrence(annotations, name, func_line, identity_id)
                            function_module: (known: bool, module: sview @source) = imc_function_module(annotations, func_line, identity_id)
                            imc_protocol_errors(annotations, owner_index, interface, name, module_scope, protocol_names, protocol_scopes, context, table, allowed)
                            family_row: mutable u32 = imc_index_head(owner_index, "__error_set_family")
                            while family_row != SYMBOL_INDEX_ROW_NONE |family_row, table| -> table:
                                family_index: u32 = family_row
                                annotation: Ast::EnumAnnotation = annotations[family_index.usize()]
                                family_row <- owner_index.chain_next[family_index.usize()]
                                impl_family: bool = return_occurrence.found and annotation.owner == "__error_set_family" and annotation.line == func_line.line and (func_line.offset == 0 or annotation.offset == 0 or annotation.offset == func_line.offset) and (identity_id == 0 or annotation.identity_id == 0 or annotation.identity_id == identity_id) and annotation.occurrence_offset == return_occurrence.offset
                                path: sview @source = imc_error_family_path(annotations, family_index.usize())
                                family_module: (known: bool, module: sview @source) = imc_resolve_error_family_module(annotations, func_line.line, func_line.offset, identity_id, annotation.name, path, function_module, table) if impl_family else (false, "")
                                subset: mutable ImcErrorSubset = empty_subset
                                subset <- imc_impl_error_subset(annotations, family_index.usize(), annotation) if impl_family
                                # stage0 anchors this at the offending METHOD, not at the
                                # `impl` header; nothing pinned the line before, so it sat on
                                # the header and every impl reported the same location.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ImplErrorExtra, name: annotation.name, pos: func_line, line: func_line.line, expected: name, actual: interface}) if impl_family and not imc_error_family_subset_matches(allowed, annotation.name, path, family_module.known, family_module.module, subset)
                        _:
                            pass

        # The impl's binding for associated type `assoc` (`type Elem = i64` -> "i64"), or "".
        def imc_impl_type_binding(body: darray[Ast::Decl], assoc: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                for declaration in body:
                    match declaration:
                        Decl.Alias(name, value, alias_line):
                            return bare_type_name(value) if name == assoc
                        _:
                            pass
                return sview("", 0, 0)

        # Return-type conformance: for each impl method, resolve the protocol method's declared
        # return (3900000065) — `Self` -> concrete, an associated type -> the impl's binding,
        # else literal — and flag when it is concretely known and differs from the impl method's
        # return. Unresolvable associated returns (impl omits the binding, inherits a default)
        # are skipped so no false positives.
        def imc_check_return_types(annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, body: darray[Ast::Decl], interface: sview @source, concrete: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in body |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, func_body, effects, decorators, func_line):
                            protocol_return: sview = imc_indexed_value(annotations, owner_index, name, 3900000065)
                            if protocol_return != "":
                                impl_return: mutable sview = ""
                                impl_return <- bare_type_name(return_expr) if return_type is return_expr
                                # The impl may spell its return `Self` too; that is the concrete
                                # type by definition, not a mismatch against it.
                                impl_return <- concrete if impl_return == "Self"
                                is_assoc: bool = imc_owner_has(annotations, owner_index, interface, 3900000061, protocol_return)
                                resolved: mutable sview = ""
                                if protocol_return == "Self":
                                    resolved <- concrete
                                elif is_assoc:
                                    resolved <- imc_impl_type_binding(body, protocol_return)
                                else:
                                    resolved <- protocol_return
                                mismatched: bool = resolved != "" and impl_return != "" and resolved != impl_return
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ImplSignatureMismatch, name: name, line: line, expected: resolved, actual: interface, detail: impl_return}) if mismatched
                        _:
                            pass

        # Provided member names of an impl Scoped body: `def` methods and `type X` aliases.
        def imc_collect_provided(body: darray[Ast::Decl], methods: mutable darray[sview]&, types: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in body |methods, types|:
                    match declaration:
                        Decl.Func(name, params, return_type, func_body, effects, decorators, line):
                            methods.push(name)
                        Decl.Alias(name, value, alias_line):
                            types.push(name)
                        _:
                            pass

        def imc_report_missing(required: darray[sview @source]&, provided: darray[sview]&, kind_label: sview @source, interface: sview @source, concrete: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for member in required |table| -> table:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ImplMissingMember, name: member, line: line, expected: kind_label, actual: interface, detail: concrete}) if not imc_name_in(provided, member)

        def imc_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, owner_index: ImcIndex&, table: lmut SymbolTable, module_scope: usize, protocol_names: darray[sview]&, protocol_scopes: darray[usize]&, context: GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Scoped(body, scoped_line):
                            interface: sview = imc_indexed_value(annotations, owner_index, "__impl_scope", scoped_line.line)
                            derived: sview = imc_indexed_value(annotations, owner_index, "__impl_derived", scoped_line.line)
                            if interface != "" and derived == "":
                                concrete: sview = imc_indexed_value(annotations, owner_index, "__impl_concrete", scoped_line.line)
                                required_methods: mutable darray[sview @source] = []
                                required_types: mutable darray[sview @source] = []
                                default_methods: mutable darray[sview] = []
                                visited_m: mutable darray[sview] = []
                                visited_t: mutable darray[sview] = []
                                visited_d: mutable darray[sview] = []
                                imc_collect_required(annotations, owner_index, interface, 3900000060, visited_m, required_methods)
                                imc_collect_required(annotations, owner_index, interface, 3900000061, visited_t, required_types)
                                # Default methods (a protocol method with a body) are provided by
                                # the protocol itself — treat them as already satisfied.
                                imc_collect_required(annotations, owner_index, interface, 3900000062, visited_d, default_methods)
                                provided_methods: mutable darray[sview] = [entry for entry in default_methods]
                                provided_types: mutable darray[sview] = []
                                imc_collect_provided(body, provided_methods, provided_types)
                                table <- imc_report_missing(required_methods, provided_methods, "method", interface, concrete, scoped_line.line, table)
                                table <- imc_report_missing(required_types, provided_types, "associated type", interface, concrete, scoped_line.line, table)
                                table <- imc_check_effects(annotations, owner_index, body, interface, scoped_line.line, table, module_scope, protocol_names, protocol_scopes, context)
                                table <- imc_check_errors(annotations, owner_index, body, interface, scoped_line.line, table, module_scope, protocol_names, protocol_scopes, context)
                                table <- imc_check_return_types(annotations, owner_index, body, interface, concrete, scoped_line.line, table)
                            table <- imc_check_declarations(body, annotations, owner_index, table, module_scope, protocol_names, protocol_scopes, context)
                        Decl.Module(module_name, module_body, module_line):
                            table <- imc_check_declarations(module_body, annotations, owner_index, table, canonical_effect_module(module_scope, module_name, table), protocol_names, protocol_scopes, context)
                        _:
                            pass

    public:
        def check_impl_conformance(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owner_index: mutable ImcIndex = ImcIndex{}
                imc_build_index(file.enum_annotations, owner_index) can Global{Read,Write}
                context: mutable GlobalAuthority = GlobalAuthority{annotations: file.enum_annotations}
                canonical_effect_context(table, &context) can Global{Read,Write}
                protocol_names: mutable darray[sview] = []
                protocol_scopes: mutable darray[usize] = []
                for annotation in file.enum_annotations |protocol_names, protocol_scopes|:
                    if annotation.line == 3900000060:
                        protocol_names.push(annotation.owner)
                        protocol_scopes.push(ga_module_text(annotation.module, &context))
                table <- imc_check_declarations(file.top_decls, file.enum_annotations, owner_index, table, 0, protocol_names, protocol_scopes, &context)
