# Interior reference used after its owner was consumed (Pooled[T] interior-borrow UAF). A local
# `b = h.field` borrows into an `affine`-struct local `h`; if `h` is later consumed — moved into a
# call argument (`release(move h)`) — then any use of `b` is a use-after-free: "interior reference
# 'b' cannot be used: usage facts were consumed by argument to call 'release'". SOUND subset: a
# named interior-ref local whose owner is an affine local, a `move OWNER` in a call argument marks
# it consumed, and a subsequent use of the ref (in source order, descending control flow in order)
# is flagged. Anonymous interior refs (in container literals) are a conservative miss.
extend Semantic:
    private:
        def interior_affine_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            out.push(struct_name) if affinity == "affine"
                        Decl.Module(module_name, module_body, module_line):
                            interior_affine_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            interior_affine_type_names(scoped_body, out)
                        _:
                            pass

        def interior_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return wanted != "" and (any name in names where name == wanted)

        # The type head of an annotation (`Pooled[Node]` → "Pooled"), else its bare name.
        def interior_type_head(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match type_expression:
                    Expr.Index(head, argument, line): ident_name_of(head)
                    Expr.IndexN(head, arguments, line): ident_name_of(head)
                    _: bare_type_name(type_expression)

        # Collect affine-typed locals (recursively) and interior-ref locals (`b = OWNER.field` where
        # OWNER is an affine local). Two passes share this walk: affine locals first, then refs.
        def interior_collect_affine_locals(statements: darray[Ast::Stmt], affine_types: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if interior_name_present(affine_types, interior_type_head(type_expression))
                        Stmt.If(condition, then_body, else_body, line):
                            interior_collect_affine_locals(then_body, affine_types, out)
                            interior_collect_affine_locals(else_body, affine_types, out)
                        Stmt.While(condition, body, line):
                            interior_collect_affine_locals(body, affine_types, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            interior_collect_affine_locals(body, affine_types, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            interior_collect_affine_locals(body, affine_types, out)
                        _:
                            pass

        # If VALUE is `OWNER.field` on an affine local, the OWNER name, else "".
        def interior_ref_owner(value: Ast::Expr, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Field(object, field, line): ident_name_of(object) if interior_name_present(affine_locals, ident_name_of(object)) else sview("", 0, 0)
                    Expr.Paren(inner, line): interior_ref_owner(inner, affine_locals)
                    _: sview("", 0, 0)

        def interior_collect_refs(statements: darray[Ast::Stmt], affine_locals: darray[sview]&, out_names: mutable darray[sview]&, out_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_owners|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            owner: sview = interior_ref_owner(value, affine_locals)
                            if owner != "":
                                out_names.push(name)
                                out_owners.push(owner)
                        Stmt.If(condition, then_body, else_body, line):
                            interior_collect_refs(then_body, affine_locals, out_names, out_owners)
                            interior_collect_refs(else_body, affine_locals, out_names, out_owners)
                        Stmt.While(condition, body, line):
                            interior_collect_refs(body, affine_locals, out_names, out_owners)
                        Stmt.For(bind, variables, iterable, body, line):
                            interior_collect_refs(body, affine_locals, out_names, out_owners)
                        Stmt.Block(kind, clause, binding, body, line):
                            interior_collect_refs(body, affine_locals, out_names, out_owners)
                        _:
                            pass

        def interior_owner_of(ref_names: darray[sview]&, ref_owners: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                index: mutable usize = 0
                while index < ref_names.count |found, index|:
                    found <- ref_owners[index] if ref_names[index] == name and found == ""
                    index <- index + 1
                return found

        def interior_consumed_call(consumed_owners: darray[sview]&, consumed_calls: darray[sview]&, owner: sview) -> sview:
            can Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                index: mutable usize = 0
                while index < consumed_owners.count |found, index|:
                    found <- consumed_calls[index] if consumed_owners[index] == owner and found == ""
                    index <- index + 1
                return found

        # Flag any interior-ref ident in EXPRESSION whose owner is already consumed.
        def interior_check_uses(expression: Ast::Expr, ref_names: darray[sview]&, ref_owners: darray[sview]&, consumed_owners: darray[sview]&, consumed_calls: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        owner: sview = interior_owner_of(ref_names, ref_owners, name)
                        call: sview = interior_consumed_call(consumed_owners, consumed_calls, owner) if owner != "" else sview("", 0, 0)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InteriorRefConsumed, name: name, line: line, expected: call, actual: ""}) if call != ""
                    Expr.Field(object, field, line):
                        table <- interior_check_uses(object, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Index(object, index, line):
                        table <- interior_check_uses(object, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                        table <- interior_check_uses(index, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Binary(left, operator, right, line):
                        table <- interior_check_uses(left, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                        table <- interior_check_uses(right, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Unary(operator, operand, line):
                        table <- interior_check_uses(operand, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Paren(inner, line):
                        table <- interior_check_uses(inner, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table| -> table:
                            table <- interior_check_uses(argument, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    _:
                        pass

        # Record any `move OWNER` in a call argument (an affine local consumed by CALL).
        def interior_record_consumes(expression: Ast::Expr, affine_locals: darray[sview]&, consumed_owners: mutable darray[sview]&, consumed_calls: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        for argument in arguments |consumed_owners, consumed_calls|:
                            moved: sview = interior_moved_owner(argument, affine_locals)
                            if moved != "" and callee_name != "":
                                consumed_owners.push(moved)
                                consumed_calls.push(callee_name)
                        for argument in arguments |consumed_owners, consumed_calls|:
                            interior_record_consumes(argument, affine_locals, consumed_owners, consumed_calls)
                    Expr.Paren(inner, line):
                        interior_record_consumes(inner, affine_locals, consumed_owners, consumed_calls)
                    _:
                        pass

        def interior_moved_owner(argument: Ast::Expr, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match argument:
                    Expr.Move(operand, line): ident_name_of(operand) if interior_name_present(affine_locals, ident_name_of(operand)) else sview("", 0, 0)
                    _: sview("", 0, 0)

        def interior_scan(statements: darray[Ast::Stmt], ref_names: darray[sview]&, ref_owners: darray[sview]&, affine_locals: darray[sview]&, consumed_owners: mutable darray[sview]&, consumed_calls: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |consumed_owners, consumed_calls, table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- interior_check_uses(expression, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(expression, affine_locals, consumed_owners, consumed_calls)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- interior_check_uses(value, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(value, affine_locals, consumed_owners, consumed_calls)
                        Stmt.Assign(target, operator, value, line):
                            table <- interior_check_uses(target, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            table <- interior_check_uses(value, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(value, affine_locals, consumed_owners, consumed_calls)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- interior_check_uses(returned, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                                interior_record_consumes(returned, affine_locals, consumed_owners, consumed_calls)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- interior_check_uses(condition, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            table <- interior_scan(then_body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                            table <- interior_scan(else_body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        Stmt.While(condition, body, line):
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        _:
                            pass

        def check_interior_ref_uaf_decls(declarations: darray[Ast::Decl], affine_types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            affine_locals: mutable darray[sview] = []
                            interior_collect_affine_locals(body, affine_types, affine_locals)
                            ref_names: mutable darray[sview] = []
                            ref_owners: mutable darray[sview] = []
                            interior_collect_refs(body, affine_locals, ref_names, ref_owners)
                            consumed_owners: mutable darray[sview] = []
                            consumed_calls: mutable darray[sview] = []
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table) if ref_names.count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_interior_ref_uaf_decls(module_body, affine_types, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_interior_ref_uaf_decls(scoped_body, affine_types, table)
                        _:
                            pass

    public:
        def check_interior_ref_uaf(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                affine_types: mutable darray[sview] = []
                interior_affine_type_names(declarations, affine_types)
                table <- check_interior_ref_uaf_decls(declarations, affine_types, table)
