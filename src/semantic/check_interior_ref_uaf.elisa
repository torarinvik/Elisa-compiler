# Interior reference used after its owner was consumed (Pooled[T] interior-borrow UAF). A local
# `b = h.field` borrows into a `Pooled` local `h`; if `h` is later consumed — moved into a
# call argument (`release(move h)`) — then any use of `b` is a use-after-free: "interior reference
# 'b' cannot be used: usage facts were consumed by argument to call 'release'". SOUND subset: a
# named interior-ref local whose owner is an affine local, a `move OWNER` in a call argument marks
# it consumed, and a subsequent use of the ref (in source order, descending control flow in order)
# is flagged. Anonymous interior refs (in container literals) are a conservative miss.
extend Semantic:
    private:
        def interior_affine_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            # Only a pool handle recycles its slot on release. stage0 raises this for
                            # `Pooled[T]` alone (docs/69); any other affine struct is a borrowable owner
                            # whose field reads outlive a move of the owner.
                            out.push(struct_name) if affinity == "affine" and struct_name == "Pooled"
                        Decl.Module(module_name, module_body, module_line):
                            interior_affine_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            interior_affine_type_names(scoped_body, out)
                        _:
                            pass

        def interior_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return wanted != "" and (any name in names where name == wanted)

        def interior_unknown_owner() -> sview:
            can Abort.Panic:
                return sview("<unknown-interior-owner>", 0, 0)

        def interior_merge_owner(current: sview, candidate: sview) -> sview:
            can Abort.Panic:
                return current if candidate == ""
                return candidate if current == ""
                return current if current == candidate
                return interior_unknown_owner()

        # Calls may be written as a bare function, module-qualified function, or method. The
        # consuming argument is the same in each form; keep the leaf name for diagnostics.
        def interior_callee_name(callee: Ast::Expr) -> sview:
            can Abort.Panic:
                return match callee:
                    Expr.Ident(name, line): name
                    Expr.Scope(base, name, line): name
                    Expr.Field(base, name, line): name
                    Expr.Paren(inner, line): interior_callee_name(inner)
                    _: sview("", 0, 0)

        # The type head of an annotation (`Pooled[Node]` → "Pooled"), else its bare name.
        def interior_type_head(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match type_expression:
                    Expr.Index(head, argument, line): ident_name_of(head)
                    Expr.IndexN(head, arguments, line): ident_name_of(head)
                    _: bare_type_name(type_expression)

        # A by-value scalar read from an interior reference is a copied value, not another borrow
        # of the pooled slot. Do not carry the owner's invalidation fact onto that local value.
        # Unknown, aggregate, pointer, and reference annotations stay conservative.
        def interior_type_is_scalar_value(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                head: sview = bare_type_name(type_expression)
                return is_integer_type_name(head) or is_float_type_name(head) or head == "bool" or head == "char" or head == "void"

        # Collect affine-typed locals (recursively) and interior-ref locals (`b = OWNER.field` where
        # OWNER is an affine local). Two passes share this walk: affine locals first, then refs.
        def interior_collect_affine_locals(statements: darray[Ast::Stmt], affine_types: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out.push(name) if interior_name_present(affine_types, interior_type_head(type_expression))
                        Stmt.If(condition, then_body, else_body, line):
                            interior_collect_affine_locals(then_body, affine_types, out)
                            interior_collect_affine_locals(else_body, affine_types, out)
                        Stmt.While(condition, body, line):
                            interior_collect_affine_locals(body, affine_types, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            interior_collect_affine_locals(body, affine_types, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            interior_collect_affine_locals(body, affine_types, out)
                        _:
                            pass

        # The affine OWNER a value borrows from, searching the whole expression rather than
        # just its head. All three derivation forms stage0 flags reach the owner this way:
        #
        #   b = h.ptr                       direct
        #   xs = [h.ptr]                    through a container LITERAL
        #   b = passthrough(h.ptr)          through a CALL that forwards the borrow
        #
        # A call is treated as forwarding: it cannot manufacture a reference into `h` that
        # `h` did not already own, so the result borrows from the same owner.
        def interior_ref_owner(value: Ast::Expr, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Field(object, field, line): interior_field_owner(object, affine_locals)
                    Expr.Paren(inner, line): interior_ref_owner(inner, affine_locals)
                    Expr.Call(callee, arguments, argument_names, line): interior_ref_owner_in_list(arguments, affine_locals)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line): interior_ref_owner_in_list(elements, affine_locals)
                    Expr.Construct(type_expression, fields, line): interior_ref_owner_in_fields(fields, affine_locals)
                    Expr.RecordUpdate(base, fields, line): interior_ref_owner_in_record_update(base, fields, affine_locals)
                    Expr.DictLit(entries, line): interior_ref_owner_in_dict_entries(entries, affine_locals)
                    Expr.Index(object, index, line): interior_ref_owner(object, affine_locals)
                    _: sview("", 0, 0)

        def interior_field_owner(object: Ast::Expr, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                inherited: sview = interior_ref_owner(object, affine_locals)
                return inherited if inherited != ""
                owner: sview = ident_name_of(object)
                return owner if interior_name_present(affine_locals, owner)
                return sview("", 0, 0)

        def interior_lookup_ref_owner(ref_names: darray[sview]&, ref_owners: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while index > 0 |index: usize = ref_names.count|:
                    index <- index - 1
                    ref_owners[index] return if ref_names[index] == name
                return sview("", 0, 0)

        def interior_update_ref_owner(name: sview, owner: sview, ref_names: mutable darray[sview]&, ref_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                resolved_owner: sview = owner if owner != "" else interior_unknown_owner()
                while index > 0 |index: usize = ref_names.count|:
                    index <- index - 1
                    if ref_names[index] == name:
                        ref_owners[index] <- resolved_owner
                        return
                ref_names.push(name)
                ref_owners.push(resolved_owner)

        def interior_rebind_local_name(target: Ast::Expr) -> sview:
            can Abort.Panic:
                match target:
                    Expr.Binary(left, operator, right, line):
                        return interior_rebind_base_name(left) if operator == TokenKind.As and ident_name_of(right) == "&"
                    _:
                        pass
                return sview("", 0, 0)

        def interior_rebind_base_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, line): name
                    Expr.Paren(inner, line): interior_rebind_base_name(inner)
                    _: sview("", 0, 0)


        # The first affine owner borrowed by any expression in a list, or "".
        def interior_ref_owner_in_list(expressions: darray[Ast::Expr]&, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for candidate in expressions |found, affine_locals|:
                    owner: sview = interior_ref_owner(candidate, affine_locals)
                    found <- interior_merge_owner(found, owner)
                return found

        def interior_ref_owner_in_fields(fields: darray[Ast::FieldInit]&, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for field in fields |found, affine_locals|:
                    found <- interior_merge_owner(found, interior_ref_owner(field.value, affine_locals))
                return found

        def interior_ref_owner_in_record_update(base: Ast::Expr, fields: darray[Ast::FieldInit]&, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = interior_ref_owner(base, affine_locals)
                for field in fields |found, affine_locals|:
                    found <- interior_merge_owner(found, interior_ref_owner(field.value, affine_locals))
                return found

        def interior_ref_owner_in_dict_entries(entries: darray[Ast::DictEntry]&, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for entry in entries |found, affine_locals|:
                    found <- interior_merge_owner(found, interior_ref_owner(entry.key, affine_locals))
                    found <- interior_merge_owner(found, interior_ref_owner(entry.value, affine_locals))
                return found

        # The owner of any already-known interior ref mentioned in EXPRESSION, or "".
        def interior_ref_owner_in_names(value: Ast::Expr, ref_names: darray[sview]&, ref_owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Ident(name, line): interior_lookup_ref_owner(ref_names, ref_owners, name)
                    Expr.Paren(inner, line): interior_ref_owner_in_names(inner, ref_names, ref_owners)
                    Expr.Index(object, index, line): interior_ref_owner_in_names(object, ref_names, ref_owners)
                    Expr.Field(object, field, line): interior_ref_owner_in_names(object, ref_names, ref_owners)
                    Expr.Call(callee, arguments, argument_names, line): interior_ref_owner_in_names_list(arguments, ref_names, ref_owners)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line): interior_ref_owner_in_names_list(elements, ref_names, ref_owners)
                    Expr.Construct(type_expression, fields, line): interior_ref_owner_in_fields_names(fields, ref_names, ref_owners)
                    Expr.RecordUpdate(base, fields, line): interior_ref_owner_in_record_update_names(base, fields, ref_names, ref_owners)
                    Expr.DictLit(entries, line): interior_ref_owner_in_dict_entries_names(entries, ref_names, ref_owners)
                    _: sview("", 0, 0)


        def interior_ref_owner_in_names_list(expressions: darray[Ast::Expr]&, ref_names: darray[sview]&, ref_owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for candidate in expressions |found, ref_names, ref_owners|:
                    owner: sview = interior_ref_owner_in_names(candidate, ref_names, ref_owners)
                    found <- interior_merge_owner(found, owner)
                return found

        def interior_ref_owner_in_fields_names(fields: darray[Ast::FieldInit]&, ref_names: darray[sview]&, ref_owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for field in fields |found, ref_names, ref_owners|:
                    found <- interior_merge_owner(found, interior_ref_owner_in_names(field.value, ref_names, ref_owners))
                return found

        def interior_ref_owner_in_record_update_names(base: Ast::Expr, fields: darray[Ast::FieldInit]&, ref_names: darray[sview]&, ref_owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = interior_ref_owner_in_names(base, ref_names, ref_owners)
                for field in fields |found, ref_names, ref_owners|:
                    found <- interior_merge_owner(found, interior_ref_owner_in_names(field.value, ref_names, ref_owners))
                return found

        def interior_ref_owner_in_dict_entries_names(entries: darray[Ast::DictEntry]&, ref_names: darray[sview]&, ref_owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for entry in entries |found, ref_names, ref_owners|:
                    found <- interior_merge_owner(found, interior_ref_owner_in_names(entry.key, ref_names, ref_owners))
                    found <- interior_merge_owner(found, interior_ref_owner_in_names(entry.value, ref_names, ref_owners))
                return found


        def interior_collect_refs(statements: darray[Ast::Stmt], affine_locals: darray[sview]&, out_names: mutable darray[sview]&, out_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_owners|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if not interior_type_is_scalar_value(type_expression):
                                owner: mutable sview = interior_ref_owner(value, affine_locals)
                                # Re-derivation: `xs = [h.ptr]` makes `xs` a borrow of `h`, and
                                # `b = get xs[0]` then borrows through `xs` -- so a local built
                                # from a known interior ref inherits that ref's owner.
                                owner <- interior_ref_owner_in_names(value, out_names, out_owners) if owner == ""
                                if owner != "":
                                    out_names.push(name)
                                    out_owners.push(owner)
                        Stmt.If(condition, then_body, else_body, line):
                            interior_collect_refs(then_body, affine_locals, out_names, out_owners)
                            interior_collect_refs(else_body, affine_locals, out_names, out_owners)
                        Stmt.While(condition, body, line):
                            interior_collect_refs(body, affine_locals, out_names, out_owners)
                        Stmt.For(bind, variables, iterable, body, line):
                            interior_collect_refs(body, affine_locals, out_names, out_owners)
                        Stmt.Block(kind, clause, binding, body, line):
                            interior_collect_refs(body, affine_locals, out_names, out_owners)
                        _:
                            pass

        # Flag any interior-ref ident in EXPRESSION whose owner is already consumed.
        def interior_check_uses(expression: Ast::Expr, ref_names: darray[sview]&, ref_owners: darray[sview]&, consumed_owners: darray[sview]&, consumed_calls: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        owner: sview = interior_lookup_ref_owner(ref_names, ref_owners, name)
                        call: mutable sview = parallel_lookup_first(consumed_owners, consumed_calls, owner) if owner != "" else sview("", 0, 0)
                        call <- consumed_calls[consumed_calls.count - 1] if owner == "<unknown-interior-owner>" and consumed_calls.count > 0
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InteriorRefConsumed, name: name, line: line.line, expected: call, actual: ""}) if call != ""
                    Expr.Field(object, field, line):
                        table <- interior_check_uses(object, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Index(object, index, line):
                        table <- interior_check_uses(object, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                        table <- interior_check_uses(index, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Binary(left, operator, right, line):
                        table <- interior_check_uses(left, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                        table <- interior_check_uses(right, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Unary(operator, operand, line):
                        table <- interior_check_uses(operand, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Paren(inner, line):
                        table <- interior_check_uses(inner, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table| -> table:
                            table <- interior_check_uses(argument, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                    _:
                        pass

        # Record any `move OWNER` in a call argument (an affine local consumed by CALL).
        def interior_record_consumes(expression: Ast::Expr, affine_locals: darray[sview]&, consumed_owners: mutable darray[sview]&, consumed_calls: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = interior_callee_name(callee)
                        for argument in arguments |consumed_owners, consumed_calls|:
                            moved: sview = interior_moved_owner(argument, affine_locals)
                            if moved != "" and callee_name != "":
                                consumed_owners.push(moved)
                                consumed_calls.push(callee_name)
                        interior_record_consumes(callee, affine_locals, consumed_owners, consumed_calls)
                        interior_record_consumes_list(arguments, affine_locals, consumed_owners, consumed_calls)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for argument in arguments |consumed_owners, consumed_calls|:
                            moved: sview = interior_moved_owner(argument, affine_locals)
                            if moved != "" and operation != "":
                                consumed_owners.push(moved)
                                consumed_calls.push(operation)
                        interior_record_consumes(effect_type, affine_locals, consumed_owners, consumed_calls)
                        interior_record_consumes_list(arguments, affine_locals, consumed_owners, consumed_calls)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        interior_record_consumes(object, affine_locals, consumed_owners, consumed_calls)
                    Expr.Index(object, index, line):
                        interior_record_consumes(object, affine_locals, consumed_owners, consumed_calls)
                        interior_record_consumes(index, affine_locals, consumed_owners, consumed_calls)
                    Expr.Slice(object, low, high, line):
                        interior_record_consumes(object, affine_locals, consumed_owners, consumed_calls)
                        interior_record_consumes(low, affine_locals, consumed_owners, consumed_calls)
                        interior_record_consumes(high, affine_locals, consumed_owners, consumed_calls)
                    Expr.IndexN(object, arguments, line):
                        interior_record_consumes(object, affine_locals, consumed_owners, consumed_calls)
                        interior_record_consumes_list(arguments, affine_locals, consumed_owners, consumed_calls)
                    Expr.Binary(left, operator, right, line):
                        interior_record_consumes(left, affine_locals, consumed_owners, consumed_calls)
                        interior_record_consumes(right, affine_locals, consumed_owners, consumed_calls)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line) | Expr.Paren(operand, line):
                        interior_record_consumes(operand, affine_locals, consumed_owners, consumed_calls)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        interior_record_consumes_list(elements, affine_locals, consumed_owners, consumed_calls)
                    _:
                        pass

        def interior_record_consumes_list(expressions: darray[Ast::Expr]&, affine_locals: darray[sview]&, consumed_owners: mutable darray[sview]&, consumed_calls: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for expression in expressions |affine_locals, consumed_owners, consumed_calls|:
                    interior_record_consumes(expression, affine_locals, consumed_owners, consumed_calls)

        def interior_moved_owner(argument: Ast::Expr, affine_locals: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match argument:
                    Expr.Move(operand, line): ident_name_of(operand) if interior_name_present(affine_locals, ident_name_of(operand)) else sview("", 0, 0)
                    _: sview("", 0, 0)

        def interior_scan(statements: darray[Ast::Stmt], ref_names: mutable darray[sview]&, ref_owners: mutable darray[sview]&, affine_locals: darray[sview]&, consumed_owners: mutable darray[sview]&, consumed_calls: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |ref_names, ref_owners, consumed_owners, consumed_calls, table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- interior_check_uses(expression, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(expression, affine_locals, consumed_owners, consumed_calls)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- interior_check_uses(value, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(value, affine_locals, consumed_owners, consumed_calls)
                        Stmt.Assign(target, operator, value, line):
                            rebound_name: sview = interior_rebind_local_name(target)
                            table <- interior_check_uses(target, ref_names, ref_owners, consumed_owners, consumed_calls, table) if rebound_name == ""
                            table <- interior_check_uses(value, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(target, affine_locals, consumed_owners, consumed_calls)
                            interior_record_consumes(value, affine_locals, consumed_owners, consumed_calls)
                            if rebound_name != "":
                                rebound_owner: mutable sview = interior_ref_owner(value, affine_locals)
                                rebound_owner <- interior_ref_owner_in_names(value, ref_names, ref_owners) if rebound_owner == ""
                                interior_update_ref_owner(rebound_name, rebound_owner, ref_names, ref_owners)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- interior_check_uses(returned, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                                interior_record_consumes(returned, affine_locals, consumed_owners, consumed_calls)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- interior_check_uses(condition, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(condition, affine_locals, consumed_owners, consumed_calls)
                            table <- interior_scan(then_body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                            table <- interior_scan(else_body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        Stmt.While(condition, body, line):
                            table <- interior_check_uses(condition, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(condition, affine_locals, consumed_owners, consumed_calls)
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- interior_check_uses(iterable, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(iterable, affine_locals, consumed_owners, consumed_calls)
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- interior_check_uses(scrutinee, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(scrutinee, affine_locals, consumed_owners, consumed_calls)
                            for arm in arms |ref_names, ref_owners, consumed_owners, consumed_calls, table| -> table:
                                table <- interior_check_uses(arm.guard, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                                interior_record_consumes(arm.guard, affine_locals, consumed_owners, consumed_calls)
                                table <- interior_scan(arm.body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        Stmt.Contract(kind, expression, line):
                            table <- interior_check_uses(expression, ref_names, ref_owners, consumed_owners, consumed_calls, table)
                            interior_record_consumes(expression, affine_locals, consumed_owners, consumed_calls)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table)
                        _:
                            pass

        # Affine parameters are owners too. Omitting them lets a helper release a Pooled
        # parameter and then use a local pointer projected from that parameter.
        def interior_collect_affine_params(params: darray[Ast::ParamDecl], affine_types: darray[sview]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in params |out|:
                    out.push(parameter.name) if interior_name_present(affine_types, interior_type_head(parameter.type_expression))

        def check_interior_ref_uaf_decls(declarations: darray[Ast::Decl], affine_types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            affine_locals: mutable darray[sview] = []
                            interior_collect_affine_params(params, affine_types, affine_locals)
                            interior_collect_affine_locals(body, affine_types, affine_locals)
                            ref_names: mutable darray[sview] = []
                            ref_owners: mutable darray[sview] = []
                            interior_collect_refs(body, affine_locals, ref_names, ref_owners)
                            consumed_owners: mutable darray[sview] = []
                            consumed_calls: mutable darray[sview] = []
                            table <- interior_scan(body, ref_names, ref_owners, affine_locals, consumed_owners, consumed_calls, table) if ref_names.count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_interior_ref_uaf_decls(module_body, affine_types, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_interior_ref_uaf_decls(scoped_body, affine_types, table)
                        _:
                            pass

    public:
        def check_interior_ref_uaf(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                affine_types: mutable darray[sview] = []
                interior_affine_type_names(declarations, affine_types)
                table <- check_interior_ref_uaf_decls(declarations, affine_types, table)
