# A `fulfills SUBJECT is PROTOCOL` clause where PROTOCOL constrains the WHOLE function (a
# performance protocol like NoBoundsChecks or Vectorizes) is malformed — those are not per-value
# predicates and must be written `fulfills PROTOCOL`. The parser records each such occurrence
# under sentinel line 3900000020 (owner = subject, name = protocol).
extend Semantic:
    public:
        def check_fulfills_whole_function(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FulfillsWholeFunction, name: annotation.name, line: 0, expected: annotation.owner, actual: ""}) if annotation.line == 3900000020
