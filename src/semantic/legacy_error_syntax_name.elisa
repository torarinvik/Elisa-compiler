# Map parser markers for removed error patterns to their stable diagnostic names.
module LegacyErrorSyntaxName:
    public:
        def diagnostic_name(marker: sview) -> sview:
            ensure when marker:
                "__legacy_error_wildcard" -> result == ("wildcard")
                "__legacy_error_pipe" -> result == ("pipe")
                "__legacy_error_open" -> result == ("open")
                _ -> result == ("")
            return when marker:
                "__legacy_error_wildcard" -> "wildcard"
                "__legacy_error_pipe" -> "pipe"
                "__legacy_error_open" -> "open"
                _ -> ""
