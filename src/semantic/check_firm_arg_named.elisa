# Named arguments use the same firm type walls as positional arguments, with
# their formal index obtained from the uniquely resolved direct declaration.
extend Semantic:
    private:
        def check_named_firm_call_argument(function_name: sview @source, argument: Ast::Expr, argument_name: sview, line: u32, table: lmut SymbolTable, names: darray[sview @source]&, types: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                position: int = function_parameter_index(table, function_name, argument_name)
                return if position < 0
                expected: sview = function_parameter_type_at_firm(table, function_name, position.usize())
                actual: InferType = infer_expression_type(argument, names, types, table)
                family: sview = family_of_kind(actual) if expected != "" else ""
                raw_reference: bool = expression_is_raw_reference(argument, names, types, table)
                raw_cstr: bool = raw_reference and (is_string_type_name(expected) or function_parameter_is_string_at_firm(table, function_name, position.usize()))
                raw_sview: bool = function_name == "sview" and position == 0 and raw_cstr
                count: u32 = (position + 1).u32()
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: function_name, pos: Ast::expr_pos(argument), line: line, expected: "NUL-terminated cstr", actual: "raw reference", expected_count: count}) if raw_sview
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: function_name, pos: Ast::expr_pos(argument), line: line, expected: expected if expected != "" else "cstr", actual: "raw reference", expected_count: count}) if raw_cstr and not raw_sview
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: function_name, pos: Ast::expr_pos(argument), line: line, expected: expected, actual: stage0_value_spelling(actual), expected_count: count}) if expected != "" and family != "" and (firm_never_fits(family, expected) or named_struct_target(expected, table))
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: function_name, pos: Ast::expr_pos(argument), line: line, expected: diagnostic_type_spelling(expected), actual: stage0_index_spelling(actual), expected_count: count}) if expected != "" and string_member_never_fits(actual, expected)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: function_name, pos: Ast::expr_pos(argument), line: line, expected: expected, actual: actual.name, expected_count: count}) if expected != "" and family == "" and firm_nominal_never_fits(actual, expected, table)
                argument_enum: sview = enum_value_never_fits(argument, expected, names, types, table) if expected != "" and not enum_wall_is_local(argument) else ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: function_name, pos: Ast::expr_pos(argument), line: line, expected: expected, actual: argument_enum, expected_count: count}) if argument_enum != ""
