# A borrow used after its owner moved. `r = &o` (a `T&` local, a copy of another borrow, a
# borrow read out of a struct literal field, or the result of a call that can hand back one of
# its summarized reference arguments) borrows `o` — a local or parameter whose type is a BORROWABLE
# owner (struct_is_borrowable_owner: stage0's isBorrowableAffineOwnerType). Once `o` is moved
# — `f(move o)`, `p = move o`, `y <- move o`, `Box{k: move o}` — every later use of the borrow
# dangles, and stage0 reports each one: `linear value "r" cannot be used: usage facts were
# consumed by argument to call "finish"`. `o <- value` re-initialises the owner and revives its
# borrows. The same walk reports `return &local`, which dangles for the opposite reason: the
# frame it points into dies at the return.
#
# Statements run in order and expressions left to right; a branch or loop body is walked on a
# COPY of the consumption state, and afterwards an owner counts as moved if any path that falls
# through moved it (stage0 reports a use reachable from one moving path). A path ending in
# return/break/continue does not fall through.
#
# Everything this walk cannot read is SILENT, never guessed: a name bound more than once in the
# function (check_borrow_binders), a lambda or a match/block expression, a `move` in any other
# position, a call through a non-identifier callee. Each of those loses a report stage0 makes;
# none of them can invent one.
extend Semantic:
    private:
        # Exact identifier-position -> declaration identity index. Definition references are
        # built by name resolution before this pass; bucket chains retain exact offset checks
        # and avoid rescanning the full reference list for every call initializer.
        struct BorrowResolvedCallTargets:
            slots: mutable darray[u32] = []
            positions: mutable darray[Ast::Pos] = []
            declaration_ids: mutable darray[DeclId] = []
            ambiguous: mutable darray[bool] = []

        struct BorrowLoopExitPath:
            active_locals: mutable darray[sview] = []
            names: mutable darray[sview] = []
            fields: mutable darray[sview] = []
            owners: mutable darray[sview] = []
            kinds: mutable darray[u32] = []
            details: mutable darray[sview] = []

        struct BorrowLoopExitState:
            # `active_locals` belongs to the current statement list. Captured abrupt paths copy
            # it so cleanup never treats a declaration after that exit as already in scope.
            active_locals: mutable darray[sview] = []
            names: mutable darray[sview] = []
            fields: mutable darray[sview] = []
            owners: mutable darray[sview] = []
            kinds: mutable darray[u32] = []
            details: mutable darray[sview] = []
            seen: mutable bool = false
            exit_active_locals: mutable darray[sview] = []
            exit_paths: mutable darray[BorrowLoopExitPath] = []
            continue_names: mutable darray[sview] = []
            continue_fields: mutable darray[sview] = []
            continue_owners: mutable darray[sview] = []
            continue_kinds: mutable darray[u32] = []
            continue_details: mutable darray[sview] = []
            continue_seen: mutable bool = false
            continue_active_locals: mutable darray[sview] = []
            continue_paths: mutable darray[BorrowLoopExitPath] = []

        struct BorrowLarrowEntry:
            target: Ast::Expr
            value: Ast::Expr
            owners: mutable darray[sview] = []
            move_owner: sview = ""
            field_names: mutable darray[sview] = []
            field_fields: mutable darray[sview] = []
            field_owners: mutable darray[sview] = []

        struct BorrowStateSnapshot:
            slots: mutable darray[usize] = []
            names: mutable darray[sview @source] = []
            fields: mutable darray[sview @source] = []
            closed: mutable darray[bool] = []
            owner_heads: mutable darray[usize] = []
            owner_tails: mutable darray[usize] = []
            owner_values: mutable darray[sview @source] = []
            owner_next: mutable darray[usize] = []

        struct BorrowReplayLabeledState:
            label: sview @source = ""
            state: BorrowStateSnapshot = BorrowStateSnapshot{}

        # Staged provenance replay has no ownership diagnostics of its own, but it must
        # preserve the same reachable outcomes as the main walk. Each outcome owns a
        # compact snapshot so a branch can be merged without mutating another branch's log.
        struct BorrowReplayFlow:
            normal_seen: mutable bool = false
            normal: BorrowStateSnapshot = BorrowStateSnapshot{}
            return_seen: mutable bool = false
            returned: BorrowStateSnapshot = BorrowStateSnapshot{}
            breaks: mutable darray[BorrowReplayLabeledState] = []
            continues: mutable darray[BorrowReplayLabeledState] = []

        struct BorrowEscapeRootGroups:
            heads: mutable darray[usize] = []
            tails: mutable darray[usize] = []
            next: mutable darray[usize] = []
            values: mutable darray[sview @source] = []

        const BORROW_CALL_TARGET_NONE: u32 = 4294967295
        const BORROW_WILDCARD_KEY_HASH_NAME_SEPARATOR: u8 = 255

        def bam_definition_reference_hash(pos: Ast::Pos) -> u64:
            can Abort.Panic:
                hash: mutable u64 = (14695981039346656037 ^ pos.offset.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ pos.end_offset.u64()) * SEMANTIC_HASH_PRIME
                return hash

        def bam_build_definition_target_index(table: SymbolTable&) -> BorrowResolvedCallTargets:
            can Memory.Allocate, Abort.Panic:
                index: mutable BorrowResolvedCallTargets = BorrowResolvedCallTargets{}
                capacity: mutable usize = 16
                while capacity < table.definition_references.count * 2 |capacity|:
                    capacity <- capacity * 2
                index.slots.reserve(capacity)
                for _ in 0..<capacity |index|:
                    index.slots.push(0)
                for reference in table.definition_references |index|:
                    hash: u64 = bam_definition_reference_hash(reference.pos)
                    slot: mutable usize = hash.usize() & (capacity - 1)
                    duplicate: mutable bool = false
                    while index.slots[slot] != 0 |slot, duplicate, index, reference|:
                        row: usize = (index.slots[slot] - 1).usize()
                        prior_pos: Ast::Pos = index.positions[row]
                        if prior_pos.offset == reference.pos.offset and prior_pos.end_offset == reference.pos.end_offset:
                            index.ambiguous[row] <- true if index.declaration_ids[row].value != reference.declaration_id.value
                            duplicate <- true
                            break
                        slot <- (slot + 1) & (capacity - 1)
                    if not duplicate:
                        row: usize = index.positions.count
                        index.positions.push(reference.pos)
                        index.declaration_ids.push(reference.declaration_id)
                        index.ambiguous.push(false)
                        index.slots[slot] <- row.u32() + 1
                return index

        # Where `name` sits in `names`, or `names.count` when it is absent.
        def bam_index_of(names: darray[sview]&, name: sview) -> usize:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe|:
                    probe return if names[probe] == name
                    probe <- probe + 1
                return names.count

        def bam_lend_position_exists(names: darray[sview]&, positions: darray[usize]&, name: sview, position: usize) -> bool:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe|:
                    return true if probe < positions.count and names[probe] == name and positions[probe] == position
                    probe <- probe + 1
                return false

        def bam_is_owner(owners: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return name != "" and bam_index_of(owners, name) < owners.count

        # Record what consumed `owner` (kind 0 clears it: a re-initialised owner is live again).
        def bam_set_consumed(owners: darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, owner: sview, kind: u32, detail: sview) -> void:
            can Abort.Panic:
                slot: usize = bam_index_of(owners, owner)
                return if slot >= owners.count
                kinds[slot] <- kind
                details[slot] <- detail

        # Whatever a branch consumed and the state before it did not.
        def bam_merge(kinds: mutable darray[u32]&, details: mutable darray[sview]&, branch_kinds: darray[u32]&, branch_details: darray[sview]&) -> void:
            can Abort.Panic:
                merge_index: mutable usize = 0
                while merge_index < kinds.count |merge_index|:
                    if kinds[merge_index] == 0 and merge_index < branch_kinds.count and branch_kinds[merge_index] != 0:
                        kinds[merge_index] <- branch_kinds[merge_index]
                        details[merge_index] <- branch_details[merge_index]
                    merge_index <- merge_index + 1

        def bam_append_unique_owner(owners: mutable darray[sview]&, owner: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if owner == "" or (any prior in owners where prior == owner)
                owners.push(owner)

        # A field-path wildcard `a.b.*` covers descendants such as `a.b.c`; the
        # separator position identifies the exact prefix being queried.
        def bam_borrow_wildcard_matches(candidate: sview, field: sview, prefix_end: usize) -> bool:
            can Abort.Panic:
                return SemanticBorrowFieldPath::wildcard_matches(candidate, field, prefix_end)

        # The first row for the most-specific matching `prefix.*` key, or count if none exists.
        def bam_borrow_wildcard_row(borrow_names: darray[sview]&, borrow_fields: darray[sview]&, name: sview, field: sview) -> usize:
            can Abort.Panic:
                prefix_end: mutable usize = field.len
                while prefix_end > 0 |prefix_end, borrow_names, borrow_fields, name, field|:
                    prefix_end <- prefix_end - 1
                    if field[prefix_end] == SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR:
                        probe: mutable usize = borrow_names.count
                        while probe > 0 |probe, prefix_end, borrow_names, borrow_fields, name, field|:
                            probe <- probe - 1
                            if borrow_names[probe] == name and probe < borrow_fields.count and bam_borrow_wildcard_matches(borrow_fields[probe], field, prefix_end):
                                return probe
                return borrow_names.count

        def bam_borrow_slot_live(borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, name: sview, field: sview) -> bool:
            can Abort.Panic:
                return false if name == ""
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe|:
                    probe <- probe - 1
                    if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == field:
                        return probe < borrow_owners.count and borrow_owners[probe] != ""
                if field != "*" and field != "":
                    nested_wildcard: usize = bam_borrow_wildcard_row(borrow_names, borrow_fields, name, field)
                    return nested_wildcard < borrow_owners.count and borrow_owners[nested_wildcard] != "" if nested_wildcard < borrow_names.count
                    probe <- borrow_names.count
                    while probe > 0 |probe|:
                        probe <- probe - 1
                        if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == "*":
                            return probe < borrow_owners.count and borrow_owners[probe] != ""
                return false

        def bam_borrow_slot_recorded(borrow_names: darray[sview]&, borrow_fields: darray[sview]&, name: sview, field: sview) -> bool:
            can Abort.Panic:
                return false if name == ""
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe|:
                    probe <- probe - 1
                    return true if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == field
                return false

        def bam_force_reset_borrow_field(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, name: sview, field: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                borrow_names.push(name)
                borrow_fields.push(field)
                borrow_owners.push("")

        def bam_reset_borrow_field(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, name: sview, field: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                # Keep ordinary declarations out of the provenance log. Without this
                # guard, later reverse lookups scan one empty marker per local binding.
                return if name == "" or not bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, name, field)
                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, field)

        def bam_borrow_key_hash(name: sview, field: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                for offset in 0..<name.len |hash, name|:
                    hash <- (hash ^ name[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ 255.u64()) * SEMANTIC_HASH_PRIME
                for offset in 0..<field.len |hash, field|:
                    hash <- (hash ^ field[offset].u64()) * SEMANTIC_HASH_PRIME
                return hash

        def bam_borrow_wildcard_key_hash(name: sview, field: sview, prefix_end: usize) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                for offset in 0..<name.len |hash, name|:
                    hash <- (hash ^ name[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ BORROW_WILDCARD_KEY_HASH_NAME_SEPARATOR.u64()) * SEMANTIC_HASH_PRIME
                for offset in 0..<prefix_end |hash, field|:
                    hash <- (hash ^ field[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ SemanticBorrowFieldPath::ASCII_WILDCARD.u64()) * SEMANTIC_HASH_PRIME
                return hash

        def bam_borrow_snapshot_owner_hash(key_index: usize, owner: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                for offset in 0..<owner.len |hash, owner|:
                    hash <- (hash ^ owner[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ 255.u64()) * SEMANTIC_HASH_PRIME
                return (hash ^ key_index.u64()) * SEMANTIC_HASH_PRIME

        # Return the matching key's slot, or the first empty slot. Callers allocate a
        # power-of-two table with at least twice the number of possible keys.
        def bam_borrow_key_probe(slots: darray[usize]&, names: darray[sview]&, fields: darray[sview]&, name: sview, field: sview) -> (slot: usize, found: bool):
            can Abort.Panic:
                mask: usize = slots.count - 1
                slot: mutable usize = bam_borrow_key_hash(name, field).usize() & mask
                while slots[slot] != 0 |slot, slots, names, fields, name, field, mask|:
                    row: usize = slots[slot] - 1
                    if names[row] == name and row < fields.count and fields[row] == field:
                        return (slot, true)
                    slot <- (slot + 1) & mask
                return (slot, false)

        def bam_borrow_wildcard_probe(slots: darray[usize]&, names: darray[sview]&, fields: darray[sview]&, name: sview, field: sview, prefix_end: usize) -> (slot: usize, found: bool):
            can Abort.Panic:
                mask: usize = slots.count - 1
                slot: mutable usize = bam_borrow_wildcard_key_hash(name, field, prefix_end).usize() & mask
                while slots[slot] != 0 |slot, slots, names, fields, name, field, prefix_end, mask|:
                    row: usize = slots[slot] - 1
                    if names[row] == name and row < fields.count and bam_borrow_wildcard_matches(fields[row], field, prefix_end):
                        return (slot, true)
                    slot <- (slot + 1) & mask
                return (slot, false)

        def bam_borrow_field_probe(slots: darray[usize]&, fields: darray[sview]&, field: sview) -> (slot: usize, found: bool):
            can Abort.Panic:
                mask: usize = slots.count - 1
                slot: mutable usize = bam_borrow_key_hash("", field).usize() & mask
                while slots[slot] != 0 |slot, slots, fields, field, mask|:
                    row: usize = slots[slot] - 1
                    if fields[row] == field:
                        return (slot, true)
                    slot <- (slot + 1) & mask
                return (slot, false)

        # Compact the append-only borrow log in one reverse pass. Each key retains all owners
        # after its newest empty generation marker; a per-key linked list keeps owners grouped
        # without rescanning the history when a branch joins or compares states.
        def bam_borrow_state_snapshot(names: darray[sview @source]&, fields: darray[sview @source]&, owners: darray[sview @source]&) -> BorrowStateSnapshot:
            can Memory.Allocate, Abort.Panic:
                snapshot: mutable BorrowStateSnapshot = BorrowStateSnapshot{}
                owner_key_indices: mutable darray[usize] = []
                owner_slots: mutable darray[usize] = []
                if names.count > 0:
                    capacity: mutable usize = 16
                    while capacity < (names.count + 1) * 2 |capacity, names|:
                        capacity <- capacity * 2
                    snapshot.slots.reserve(capacity)
                    for _ in 0..<capacity |snapshot|:
                        snapshot.slots.push(0)
                row: mutable usize = names.count
                while row > 0 |row, snapshot, fields, owners|:
                    row <- row - 1
                    name: sview = names[row]
                    field: sview = fields[row] if row < fields.count else ""
                    slot, found = bam_borrow_key_probe(snapshot.slots, snapshot.names, snapshot.fields, name, field)
                    key_index: mutable usize = 0
                    if found:
                        key_index <- snapshot.slots[slot] - 1
                    else:
                        key_index <- snapshot.names.count
                        snapshot.names.push(name)
                        snapshot.fields.push(field)
                        snapshot.closed.push(false)
                        snapshot.owner_heads.push(0)
                        snapshot.owner_tails.push(0)
                        snapshot.slots[slot] <- key_index + 1
                    continue if snapshot.closed[key_index]
                    owner: sview = owners[row] if row < owners.count else ""
                    if owner == "":
                        snapshot.closed[key_index] <- true
                    else:
                        # Allocate only when a live owner first reaches the dedup path.
                        # Empty and all-tombstone snapshots never need this hash table.
                        if owner_slots.count == 0:
                            owner_capacity: mutable usize = 16
                            while owner_capacity < (owners.count + 1) * 2 |owner_capacity, owners|:
                                owner_capacity <- owner_capacity * 2
                            owner_slots.reserve(owner_capacity)
                            for _ in 0..<owner_capacity |owner_slots|:
                                owner_slots.push(0)
                        owner_mask: usize = owner_slots.count - 1
                        owner_slot: mutable usize = bam_borrow_snapshot_owner_hash(key_index, owner).usize() & owner_mask
                        duplicate: mutable bool = false
                        while owner_slots[owner_slot] != 0 |owner_slot, owner_slots, owner_key_indices, snapshot, owner, owner_mask, duplicate|:
                            owner_row: usize = owner_slots[owner_slot] - 1
                            if owner_key_indices[owner_row] == key_index and snapshot.owner_values[owner_row] == owner:
                                duplicate <- true
                                break
                            owner_slot <- (owner_slot + 1) & owner_mask
                        if not duplicate:
                            owner_row: usize = snapshot.owner_values.count
                            snapshot.owner_values.push(owner)
                            snapshot.owner_next.push(0)
                            owner_key_indices.push(key_index)
                            owner_slots[owner_slot] <- owner_row + 1
                            if snapshot.owner_heads[key_index] == 0:
                                snapshot.owner_heads[key_index] <- owner_row + 1
                            else:
                                snapshot.owner_next[snapshot.owner_tails[key_index] - 1] <- owner_row + 1
                            snapshot.owner_tails[key_index] <- owner_row + 1
                return snapshot

        def bam_borrow_snapshot_append_owners(snapshot: BorrowStateSnapshot&, key_index: usize, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                owner_node: mutable usize = snapshot.owner_heads[key_index]
                while owner_node != 0 |owner_node, snapshot, out|:
                    owner_row: usize = owner_node - 1
                    owner: sview = snapshot.owner_values[owner_row]
                    out.push(owner) if owner != ""
                    owner_node <- snapshot.owner_next[owner_row]

        def bam_borrow_snapshot_owners(snapshot: BorrowStateSnapshot&, name: sview, field: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or snapshot.names.count == 0
                owner_mark: usize = out.count
                slot, found = bam_borrow_key_probe(snapshot.slots, snapshot.names, snapshot.fields, name, field)
                if found:
                    key_index: usize = snapshot.slots[slot] - 1
                    bam_borrow_snapshot_append_owners(snapshot, key_index, out)
                    if out.count == owner_mark and field == "*":
                        return
                    return if out.count > owner_mark or field != ""
                    return bam_borrow_snapshot_owners(snapshot, name, "*", out)

                if field != "*" and field != "":
                    prefix_end: mutable usize = field.len
                    while prefix_end > 0 |prefix_end, snapshot, name, field, out|:
                        prefix_end <- prefix_end - 1
                        if field[prefix_end] == SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR:
                            slot, found = bam_borrow_wildcard_probe(snapshot.slots, snapshot.names, snapshot.fields, name, field, prefix_end)
                            if found:
                                bam_borrow_snapshot_append_owners(snapshot, snapshot.slots[slot] - 1, out)
                                return
                return if field == "*"
                bam_borrow_snapshot_owners(snapshot, name, "*", out)

        def bam_collect_borrow_keys(names: darray[sview]&, fields: darray[sview]&, holder: sview, out_names: mutable darray[sview]&, out_fields: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < (out_names.count + names.count + 1) * 2 |capacity, out_names, names|:
                    capacity <- capacity * 2
                slots: mutable darray[usize] = []
                slots.reserve(capacity)
                for _ in 0..<capacity |slots|:
                    slots.push(0)
                for seed_row in 0..<out_names.count |seed_row, slots, out_names, out_fields|:
                    key_field: sview = out_fields[seed_row] if seed_row < out_fields.count else ""
                    slot, found = bam_borrow_key_probe(slots, out_names, out_fields, out_names[seed_row], key_field)
                    slots[slot] <- seed_row + 1 if not found
                input_row: mutable usize = 0
                for key_name in names |input_row, fields, holder, out_names, out_fields, slots|:
                    key_field: sview = fields[input_row] if input_row < fields.count else ""
                    if holder == "" or key_name == holder:
                        slot, found = bam_borrow_key_probe(slots, out_names, out_fields, key_name, key_field)
                        if not found:
                            out_names.push(key_name)
                            out_fields.push(key_field)
                            slots[slot] <- out_names.count
                    input_row <- input_row + 1

        # Collect every owner in the newest generation of this exact slot. Empty-owner rows
        # terminate the generation, so an overwritten borrow cannot retain older provenance.
        def bam_borrow_exact_owners(borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, name: sview, field: sview, out: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                found_slot: mutable bool = false
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe, out|:
                    probe <- probe - 1
                    if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == field:
                        found_slot <- true
                        if probe >= borrow_owners.count or borrow_owners[probe] == "":
                            return true
                        bam_append_unique_owner(out, borrow_owners[probe])
                return found_slot

        # Resolve an exact slot first, then the most-specific ancestor wildcard, then `*`.
        # Exact tombstones suppress wildcard fallback; the direct `""` slot keeps its legacy
        # fallback to `*`, which represents an aggregate returned by a lender call.
        def bam_borrow_owners(borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, name: sview, field: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                owner_mark: usize = out.count
                found_slot: bool = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, field, out)
                if found_slot:
                    if out.count == owner_mark and field == "":
                        _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, "*", out)
                    return
                if field != "*" and field != "":
                    wildcard_row: usize = bam_borrow_wildcard_row(borrow_names, borrow_fields, name, field)
                    if wildcard_row < borrow_names.count:
                        _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, borrow_fields[wildcard_row], out)
                        return
                if field != "*":
                    _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, "*", out)

        def bam_push_borrow(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, name: sview, field: sview, owner: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or owner == ""
                borrow_names.push(name)
                borrow_fields.push(field)
                borrow_owners.push(owner)

        def bam_field_path_suffix(candidate: sview, prefix: sview) -> sview:
            can Abort.Panic:
                return candidate if prefix == ""
                suffix_start: usize = prefix.len + 1.usize()
                return candidate[suffix_start:candidate.len]

        def bam_copy_borrow_fields(destination: sview, prefix: sview, source: sview, source_prefix: sview, source_names: darray[sview]&, source_fields: darray[sview]&, source_owners: darray[sview]&, out_names: mutable darray[sview]&, out_fields: mutable darray[sview]&, out_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                field_names: mutable darray[sview] = []
                field_keys: mutable darray[sview] = []
                bam_collect_borrow_keys(source_names, source_fields, source, field_names, field_keys)
                for source_field in field_keys |field_names, source, source_names, source_fields, source_owners, out_names, out_fields, out_owners, prefix, table|:
                    continue if source_field == "" or source_field == source_prefix
                    continue if source_prefix != "" and not bam_field_path_within(source_field, source_prefix)
                    copied_owners: mutable darray[sview] = []
                    bam_borrow_owners(source_names, source_fields, source_owners, source, source_field, copied_owners)
                    source_suffix: sview = bam_field_path_suffix(source_field, source_prefix)
                    destination_field: sview = bam_join_field_key(prefix, source_suffix, out_fields, table)
                    bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, destination_field)
                    for copied_owner in copied_owners |out_names, out_fields, out_owners, destination_field|:
                        bam_push_borrow(out_names, out_fields, out_owners, destination, destination_field, copied_owner)

        def bam_field_path_within(candidate: sview, prefix: sview) -> bool:
            can Abort.Panic:
                return true if candidate == prefix
                prefix_length: usize = prefix.len
                return false if:
                    prefix_length == 0 or candidate.len <= prefix_length
                    candidate[prefix_length] != 46
                for index in 0..<prefix_length |candidate, prefix|:
                    return false if candidate[index] != prefix[index]
                return true

        def bam_clear_borrow_path(name: sview, prefix: sview, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                key_names: mutable darray[sview] = []
                key_fields: mutable darray[sview] = []
                matching_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, key_names, key_fields)
                for field in key_fields |name, prefix, borrow_names, borrow_fields, borrow_owners|:
                    matching_fields.push(field) if bam_field_path_within(field, prefix)
                bam_clear_borrow_field_keys(name, matching_fields, borrow_names, borrow_fields, borrow_owners)
                wildcard_path: sview = bam_join_field_key(prefix, "*", borrow_fields, table)
                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, wildcard_path) if bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, name, wildcard_path)

        def bam_clear_borrow_field_keys(name: sview, fields: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < (fields.count + 1) * 2 |capacity, fields|:
                    capacity <- capacity * 2
                selected_slots: mutable darray[usize] = []
                seen_slots: mutable darray[usize] = []
                selected_slots.reserve(capacity)
                seen_slots.reserve(capacity)
                for _ in 0..<capacity |selected_slots, seen_slots|:
                    selected_slots.push(0)
                    seen_slots.push(0)
                for row in 0..<fields.count |row, selected_slots, fields|:
                    slot, found = bam_borrow_field_probe(selected_slots, fields, fields[row])
                    selected_slots[slot] <- row + 1 if not found

                # Mask a holder-wide wildcard only when clearing that wildcard itself. Path
                # clears pass a subset and must leave sibling paths untouched.
                clears_global_wildcard: bool = any field in fields where field == "*"
                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, "*") if clears_global_wildcard and bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, name, "*")
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe, selected_slots, seen_slots, fields, borrow_names, borrow_fields, borrow_owners, name|:
                    probe <- probe - 1
                    continue if borrow_names[probe] != name or probe >= borrow_fields.count
                    field: sview = borrow_fields[probe]
                    continue if field == "*"
                    selected_slot, selected = bam_borrow_field_probe(selected_slots, fields, field)
                    continue if not selected
                    seen_slot, seen = bam_borrow_field_probe(seen_slots, fields, field)
                    continue if seen
                    selected_row: usize = selected_slots[selected_slot] - 1
                    seen_slots[seen_slot] <- selected_row + 1
                    continue if probe >= borrow_owners.count or borrow_owners[probe] == ""
                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, field)

        def bam_clear_borrow_fields(name: sview, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                field_names: mutable darray[sview] = []
                field_keys: mutable darray[sview] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, field_names, field_keys)
                bam_clear_borrow_field_keys(name, field_keys, borrow_names, borrow_fields, borrow_owners)

        # A write through a reference to an aggregate replaces its pointee's nested facts, but
        # the reference slot itself still names the same owner. Preserve the direct `""` row.
        def bam_clear_borrow_nested_fields(name: sview, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                field_names: mutable darray[sview] = []
                field_keys: mutable darray[sview] = []
                nested_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, field_names, field_keys)
                for field in field_keys |nested_fields|:
                    nested_fields.push(field) if field != ""
                bam_clear_borrow_field_keys(name, nested_fields, borrow_names, borrow_fields, borrow_owners)

        # Replace a holder's current field provenance with one path's state.
        def bam_replace_borrow_state(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, source_names: darray[sview]&, source_fields: darray[sview]&, source_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                source: BorrowStateSnapshot = bam_borrow_state_snapshot(source_names, source_fields, source_owners)
                key_names: mutable darray[sview] = []
                key_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, "", key_names, key_fields)
                bam_collect_borrow_keys(source.names, source.fields, "", key_names, key_fields)
                for row in 0..<key_names.count |row, borrow_names, borrow_fields, borrow_owners, source_names, source_fields, source_owners, key_names, key_fields|:
                    owners: mutable darray[sview] = []
                    bam_borrow_snapshot_owners(source, key_names[row], key_fields[row], owners)
                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, key_names[row], key_fields[row])
                    for owner in owners |borrow_names, borrow_fields, borrow_owners|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, key_names[row], key_fields[row], owner)

        # Join another possible path into the current provenance state (may-union).
        def bam_merge_borrow_state(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, alternate_names: darray[sview]&, alternate_fields: darray[sview]&, alternate_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                current: BorrowStateSnapshot = bam_borrow_state_snapshot(borrow_names, borrow_fields, borrow_owners)
                alternate: BorrowStateSnapshot = bam_borrow_state_snapshot(alternate_names, alternate_fields, alternate_owners)
                key_names: mutable darray[sview] = []
                key_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(current.names, current.fields, "", key_names, key_fields)
                bam_collect_borrow_keys(alternate.names, alternate.fields, "", key_names, key_fields)
                for row in 0..<key_names.count |row, borrow_names, borrow_fields, borrow_owners, alternate_names, alternate_fields, alternate_owners, key_names, key_fields|:
                    owners: mutable darray[sview] = []
                    alternate_owner_values: mutable darray[sview] = []
                    bam_borrow_snapshot_owners(current, key_names[row], key_fields[row], owners)
                    bam_borrow_snapshot_owners(alternate, key_names[row], key_fields[row], alternate_owner_values)
                    if owners.count == 0:
                        owners.extend(alternate_owner_values)
                    elif alternate_owner_values.count == 1:
                        alternate_owner: sview = alternate_owner_values[0]
                        owners.push(alternate_owner) if not (any known_owner in owners where known_owner == alternate_owner)
                    elif alternate_owner_values.count > 0:
                        capacity: mutable usize = 16
                        while capacity < (owners.count + alternate_owner_values.count + 1) * 2 |capacity, owners, alternate_owner_values|:
                            capacity <- capacity * 2
                        owner_slots: mutable darray[usize] = []
                        owner_slots.reserve(capacity)
                        for _ in 0..<capacity |owner_slots|:
                            owner_slots.push(0)
                        for owner_index in 0..<owners.count |owner_index, owner_slots, owners|:
                            slot, found = bam_borrow_field_probe(owner_slots, owners, owners[owner_index])
                            owner_slots[slot] <- owner_index + 1 if not found
                        for alternate_owner in alternate_owner_values |owner_slots, owners|:
                            slot, found = bam_borrow_field_probe(owner_slots, owners, alternate_owner)
                            if not found:
                                owners.push(alternate_owner)
                                owner_slots[slot] <- owners.count
                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, key_names[row], key_fields[row])
                    for owner in owners |borrow_names, borrow_fields, borrow_owners|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, key_names[row], key_fields[row], owner)

        # Recreate the compact snapshot as an append-only state log. Closed rows must remain
        # explicit tombstones so a missing exact field cannot fall back to a stale wildcard.
        def bam_replay_materialize_snapshot(snapshot: BorrowStateSnapshot&, names: mutable darray[sview]&, fields: mutable darray[sview]&, owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                names.truncate(0)
                fields.truncate(0)
                owners.truncate(0)
                for row in 0..<snapshot.names.count |snapshot, names, fields, owners|:
                    name: sview = snapshot.names[row]
                    field: sview = snapshot.fields[row] if row < snapshot.fields.count else ""
                    names.push(name)
                    fields.push(field)
                    if row < snapshot.owner_heads.count and snapshot.owner_heads[row] != 0:
                        node: mutable usize = snapshot.owner_heads[row]
                        while node != 0 |node, snapshot, owners|:
                            owner_row: usize = node - 1
                            owners.push(snapshot.owner_values[owner_row])
                            node <- snapshot.owner_next[owner_row]
                    else:
                        # A closed row with no live owners is the current tombstone. If it
                        # also has owner heads, the tombstone belongs to an older generation.
                        owners.push("")

        def bam_replay_snapshot_owner_row(snapshot: mutable BorrowStateSnapshot&, owner_slots: mutable darray[usize]&, owner_key_indices: mutable darray[usize]&, key_index: usize, owner: sview @source) -> (owner_row: usize, inserted: bool):
            can Memory.Allocate, Abort.Panic:
                mask: mutable usize = owner_slots.count - 1
                slot: mutable usize = bam_borrow_snapshot_owner_hash(key_index, owner).usize() & mask
                while owner_slots[slot] != 0 |slot, snapshot, owner_slots, owner_key_indices, key_index, owner, mask|:
                    owner_row: usize = owner_slots[slot] - 1
                    if owner_key_indices[owner_row] == key_index and snapshot.owner_values[owner_row] == owner:
                        return (owner_row, false)
                    slot <- (slot + 1) & mask
                if snapshot.owner_values.count + 1 > owner_slots.count / 2:
                    capacity: mutable usize = owner_slots.count * 2
                    owner_slots.truncate(0)
                    owner_slots.reserve(capacity)
                    for _ in 0..<capacity |owner_slots|:
                        owner_slots.push(0)
                    mask <- capacity - 1
                    for row in 0..<snapshot.owner_values.count |row, snapshot, owner_slots, owner_key_indices, mask|:
                        existing_slot: mutable usize = bam_borrow_snapshot_owner_hash(owner_key_indices[row], snapshot.owner_values[row]).usize() & mask
                        while owner_slots[existing_slot] != 0 |existing_slot, owner_slots, mask|:
                            existing_slot <- (existing_slot + 1) & mask
                        owner_slots[existing_slot] <- row + 1
                    slot <- bam_borrow_snapshot_owner_hash(key_index, owner).usize() & mask
                    while owner_slots[slot] != 0 |slot, owner_slots, mask|:
                        slot <- (slot + 1) & mask
                owner_row: usize = snapshot.owner_values.count
                snapshot.owner_values.push(owner)
                snapshot.owner_next.push(0)
                owner_key_indices.push(key_index)
                owner_slots[slot] <- owner_row + 1
                return (owner_row, true)

        def bam_replay_snapshot_link_owner(snapshot: mutable BorrowStateSnapshot&, key_index: usize, owner_row: usize) -> void:
            can Abort.Panic:
                snapshot.owner_next[owner_row] <- 0
                if snapshot.owner_heads[key_index] == 0:
                    snapshot.owner_heads[key_index] <- owner_row + 1
                else:
                    snapshot.owner_next[snapshot.owner_tails[key_index] - 1] <- owner_row + 1
                snapshot.owner_tails[key_index] <- owner_row + 1

        def bam_replay_snapshot_merge(left: BorrowStateSnapshot, right: BorrowStateSnapshot) -> BorrowStateSnapshot:
            can Memory.Allocate, Abort.Panic:
                merged: mutable BorrowStateSnapshot = BorrowStateSnapshot{}
                key_capacity: mutable usize = 16
                while key_capacity < (left.names.count + right.names.count + 1) * 2 |key_capacity, left, right|:
                    key_capacity <- key_capacity * 2
                merged.slots.reserve(key_capacity)
                for _ in 0..<key_capacity |merged|:
                    merged.slots.push(0)

                # The old materialize/merge/resnapshot path yields right-only keys first in
                # right order, then all left keys in left order. Keep that iteration order.
                # Queries still resolve each input key through the shared lookup helper so
                # wildcard inheritance and exact tombstones remain path-specific.
                for row in 0..<right.names.count |row, left, right, merged|:
                    name: sview = right.names[row]
                    field: sview = right.fields[row] if row < right.fields.count else ""
                    found_in_left: mutable bool = false
                    if left.names.count > 0:
                        _, found_in_left <- bam_borrow_key_probe(left.slots, left.names, left.fields, name, field)
                    continue if found_in_left
                    slot, found = bam_borrow_key_probe(merged.slots, merged.names, merged.fields, name, field)
                    if not found:
                        merged.names.push(name)
                        merged.fields.push(field)
                        merged.closed.push(false)
                        merged.owner_heads.push(0)
                        merged.owner_tails.push(0)
                        merged.slots[slot] <- merged.names.count
                for row in 0..<left.names.count |row, left, merged|:
                    name: sview = left.names[row]
                    field: sview = left.fields[row] if row < left.fields.count else ""
                    slot, found = bam_borrow_key_probe(merged.slots, merged.names, merged.fields, name, field)
                    if not found:
                        merged.names.push(name)
                        merged.fields.push(field)
                        merged.closed.push(false)
                        merged.owner_heads.push(0)
                        merged.owner_tails.push(0)
                        merged.slots[slot] <- merged.names.count

                owner_capacity: mutable usize = 16
                while owner_capacity < (left.owner_values.count + right.owner_values.count + 1) * 2 |owner_capacity, left, right|:
                    owner_capacity <- owner_capacity * 2
                owner_slots: mutable darray[usize] = []
                owner_slots.reserve(owner_capacity)
                for _ in 0..<owner_capacity |owner_slots|:
                    owner_slots.push(0)
                owner_key_indices: mutable darray[usize] = []
                left_values: mutable darray[sview] = []
                right_values: mutable darray[sview] = []
                left_owner_rows: mutable darray[usize] = []
                for key_index in 0..<merged.names.count |key_index, merged, left, right, owner_slots, owner_key_indices, left_values, right_values, left_owner_rows|:
                    name: sview = merged.names[key_index]
                    field: sview = merged.fields[key_index]
                    left_values.truncate(0)
                    right_values.truncate(0)
                    left_owner_rows.truncate(0)
                    bam_borrow_snapshot_owners(left, name, field, left_values)
                    bam_borrow_snapshot_owners(right, name, field, right_values)

                    # The old path writes left owners followed by unique right owners, then
                    # reverse-scans that log into a snapshot. Its observable owner traversal
                    # order is therefore right-only owners followed by all left owners.
                    # Record left owners first for membership, but link their nodes last.
                    for owner in left_values |key_index, merged, owner_slots, owner_key_indices|:
                        owner_row, inserted = bam_replay_snapshot_owner_row(merged, owner_slots, owner_key_indices, key_index, owner)
                        left_owner_rows.push(owner_row) if inserted
                    for owner in right_values |key_index, merged, owner_slots, owner_key_indices|:
                        owner_row, inserted = bam_replay_snapshot_owner_row(merged, owner_slots, owner_key_indices, key_index, owner)
                        bam_replay_snapshot_link_owner(merged, key_index, owner_row) if inserted
                    for owner_row in left_owner_rows |key_index, merged|:
                        bam_replay_snapshot_link_owner(merged, key_index, owner_row)
                    merged.closed[key_index] <- merged.owner_heads[key_index] == 0
                return merged

        def bam_replay_flow_reset(flow: mutable BorrowReplayFlow&) -> void:
            can Abort.Panic:
                flow.normal_seen <- false
                flow.normal <- BorrowStateSnapshot{}
                flow.return_seen <- false
                flow.returned <- BorrowStateSnapshot{}
                flow.breaks.truncate(0)
                flow.continues.truncate(0)

        def bam_replay_flow_set_normal(flow: mutable BorrowReplayFlow&, names: darray[sview]&, fields: darray[sview]&, owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                flow.normal <- bam_borrow_state_snapshot(names, fields, owners)
                flow.normal_seen <- true

        def bam_replay_flow_set_reachable(flow: mutable BorrowReplayFlow&) -> void:
            can Abort.Panic:
                flow.normal_seen <- true

        def bam_replay_flow_merge_normal(flow: mutable BorrowReplayFlow&, alternate: BorrowReplayFlow&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not alternate.normal_seen
                if flow.normal_seen:
                    flow.normal <- bam_replay_snapshot_merge(flow.normal, alternate.normal)
                else:
                    flow.normal <- alternate.normal
                    flow.normal_seen <- true

        # A snapshot with its own storage, so it can outlive the flow it was read from.
        def bam_replay_snapshot_copy(state: BorrowStateSnapshot&) -> BorrowStateSnapshot:
            can Memory.Allocate:
                copy: mutable BorrowStateSnapshot = BorrowStateSnapshot{}
                copy.slots.extend(state.slots)
                copy.names.extend(state.names)
                copy.fields.extend(state.fields)
                copy.closed.extend(state.closed)
                copy.owner_heads.extend(state.owner_heads)
                copy.owner_tails.extend(state.owner_tails)
                copy.owner_values.extend(state.owner_values)
                copy.owner_next.extend(state.owner_next)
                return copy

        def bam_replay_flow_add_return(flow: mutable BorrowReplayFlow&, state: BorrowStateSnapshot) -> void:
            can Memory.Allocate, Abort.Panic:
                if flow.return_seen:
                    flow.returned <- bam_replay_snapshot_merge(flow.returned, state)
                else:
                    # A fresh copy allocated in `flow`'s region: `state` may live in a caller's
                    # shorter-lived local flow (bam_replay_flow_merge_exits).
                    flow.returned <- bam_replay_snapshot_copy(state)
                    flow.return_seen <- true

        def bam_replay_flow_add_break(flow: mutable BorrowReplayFlow&, label: sview @source, state: BorrowStateSnapshot) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<flow.breaks.count |flow, label, state|:
                    if flow.breaks[row].label == label:
                        flow.breaks[row].state <- bam_replay_snapshot_merge(flow.breaks[row].state, state)
                        return
                flow.breaks.push(BorrowReplayLabeledState{label: label})
                flow.breaks[flow.breaks.count - 1].state <- bam_replay_snapshot_copy(state)

        def bam_replay_flow_add_continue(flow: mutable BorrowReplayFlow&, label: sview @source, state: BorrowStateSnapshot) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<flow.continues.count |flow, label, state|:
                    if flow.continues[row].label == label:
                        flow.continues[row].state <- bam_replay_snapshot_merge(flow.continues[row].state, state)
                        return
                flow.continues.push(BorrowReplayLabeledState{label: label})
                flow.continues[flow.continues.count - 1].state <- bam_replay_snapshot_copy(state)

        def bam_replay_flow_merge_exits(flow: mutable BorrowReplayFlow&, alternate: BorrowReplayFlow&) -> void:
            can Memory.Allocate, Abort.Panic:
                if alternate.return_seen:
                    bam_replay_flow_add_return(flow, alternate.returned)
                for exit in alternate.breaks |flow|:
                    bam_replay_flow_add_break(flow, exit.label, exit.state)
                for exit in alternate.continues |flow|:
                    bam_replay_flow_add_continue(flow, exit.label, exit.state)

        def bam_replay_snapshot_filter(snapshot: BorrowStateSnapshot, statements: darray[Ast::Stmt], extra_locals: darray[sview]&, binders: BorrowBinders&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> BorrowStateSnapshot:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                fields: mutable darray[sview] = []
                owners: mutable darray[sview] = []
                bam_replay_materialize_snapshot(snapshot, names, fields, owners)
                bam_filter_rhs_scope_borrow_state(statements, extra_locals, binders, names, fields, owners, base_names, base_fields, base_owners)
                return bam_borrow_state_snapshot(names, fields, owners)

        def bam_replay_flow_filter_scope(flow: mutable BorrowReplayFlow&, statements: darray[Ast::Stmt], extra_locals: darray[sview]&, binders: BorrowBinders&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_replay_flow_filter_normal_scope(flow, statements, extra_locals, binders, base_names, base_fields, base_owners)
                bam_replay_flow_filter_exits_scope(flow, statements, extra_locals, binders, base_names, base_fields, base_owners)

        def bam_replay_flow_filter_normal_scope(flow: mutable BorrowReplayFlow&, statements: darray[Ast::Stmt], extra_locals: darray[sview]&, binders: BorrowBinders&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if flow.normal_seen:
                    flow.normal <- bam_replay_snapshot_filter(flow.normal, statements, extra_locals, binders, base_names, base_fields, base_owners)

        def bam_replay_flow_filter_exits_scope(flow: mutable BorrowReplayFlow&, statements: darray[Ast::Stmt], extra_locals: darray[sview]&, binders: BorrowBinders&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if flow.return_seen:
                    flow.returned <- bam_replay_snapshot_filter(flow.returned, statements, extra_locals, binders, base_names, base_fields, base_owners)
                for row in 0..<flow.breaks.count |flow, statements, extra_locals, binders, base_names, base_fields, base_owners|:
                    flow.breaks[row].state <- bam_replay_snapshot_filter(flow.breaks[row].state, statements, extra_locals, binders, base_names, base_fields, base_owners)
                for row in 0..<flow.continues.count |flow, statements, extra_locals, binders, base_names, base_fields, base_owners|:
                    flow.continues[row].state <- bam_replay_snapshot_filter(flow.continues[row].state, statements, extra_locals, binders, base_names, base_fields, base_owners)

        def bam_replay_snapshot_restore_pattern(snapshot: BorrowStateSnapshot, pattern: Ast::Pattern, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> BorrowStateSnapshot:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                fields: mutable darray[sview] = []
                owners: mutable darray[sview] = []
                bam_replay_materialize_snapshot(snapshot, names, fields, owners)
                bam_restore_pattern_borrow_state(pattern, names, fields, owners, base_names, base_fields, base_owners)
                return bam_borrow_state_snapshot(names, fields, owners)

        def bam_replay_flow_restore_pattern(flow: mutable BorrowReplayFlow&, pattern: Ast::Pattern, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if flow.normal_seen:
                    flow.normal <- bam_replay_snapshot_restore_pattern(flow.normal, pattern, base_names, base_fields, base_owners)
                if flow.return_seen:
                    flow.returned <- bam_replay_snapshot_restore_pattern(flow.returned, pattern, base_names, base_fields, base_owners)
                for row in 0..<flow.breaks.count |flow, pattern, base_names, base_fields, base_owners|:
                    flow.breaks[row].state <- bam_replay_snapshot_restore_pattern(flow.breaks[row].state, pattern, base_names, base_fields, base_owners)
                for row in 0..<flow.continues.count |flow, pattern, base_names, base_fields, base_owners|:
                    flow.continues[row].state <- bam_replay_snapshot_restore_pattern(flow.continues[row].state, pattern, base_names, base_fields, base_owners)

        def bam_borrow_state_equal(left_names: darray[sview]&, left_fields: darray[sview]&, left_owners: darray[sview]&, right_names: darray[sview]&, right_fields: darray[sview]&, right_owners: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if left_names.count == right_names.count:
                    same_order: mutable bool = true
                    for row in 0..<left_names.count |same_order, left_names, left_fields, left_owners, right_names, right_fields, right_owners, row|:
                        left_field: sview = left_fields[row] if row < left_fields.count else ""
                        right_field: sview = right_fields[row] if row < right_fields.count else ""
                        left_owner: sview = left_owners[row] if row < left_owners.count else ""
                        right_owner: sview = right_owners[row] if row < right_owners.count else ""
                        same_order <- false if left_names[row] != right_names[row] or left_field != right_field or left_owner != right_owner
                        break if not same_order
                    return true if same_order
                left: BorrowStateSnapshot = bam_borrow_state_snapshot(left_names, left_fields, left_owners)
                right: BorrowStateSnapshot = bam_borrow_state_snapshot(right_names, right_fields, right_owners)
                key_names: mutable darray[sview] = []
                key_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(left.names, left.fields, "", key_names, key_fields)
                bam_collect_borrow_keys(right.names, right.fields, "", key_names, key_fields)
                left_values: mutable darray[sview] = []
                right_values: mutable darray[sview] = []
                owner_slots: mutable darray[usize] = []
                owner_values: mutable darray[sview] = []
                for row in 0..<key_names.count |key_names, key_fields, left, right, left_values, right_values, owner_slots, owner_values|:
                    left_values.truncate(0)
                    right_values.truncate(0)
                    bam_borrow_snapshot_owners(left, key_names[row], key_fields[row], left_values)
                    bam_borrow_snapshot_owners(right, key_names[row], key_fields[row], right_values)
                    return false if left_values.count != right_values.count
                    continue if right_values.count == 0
                    if right_values.count == 1:
                        return false if left_values[0] != right_values[0]
                        continue
                    owner_capacity: mutable usize = 16
                    while owner_capacity < (right_values.count + 1) * 2 |owner_capacity, right_values|:
                        owner_capacity <- owner_capacity * 2
                    owner_slots.truncate(0)
                    owner_slots.reserve(owner_capacity)
                    for _ in 0..<owner_capacity |owner_slots|:
                        owner_slots.push(0)
                    owner_values.truncate(0)
                    for owner in right_values |owner_slots, owner_values|:
                        owner_slot, found = bam_borrow_field_probe(owner_slots, owner_values, owner)
                        if not found:
                            owner_values.push(owner)
                            owner_slots[owner_slot] <- owner_values.count
                    for owner in left_values |right_values, owner_slots, owner_values|:
                        _, found = bam_borrow_field_probe(owner_slots, owner_values, owner)
                        return false if not found
                return true

        def bam_consumed_state_equal(left_kinds: darray[u32]&, left_details: darray[sview]&, right_kinds: darray[u32]&, right_details: darray[sview]&) -> bool:
            can Abort.Panic:
                return false if left_kinds.count != right_kinds.count
                for row in 0..<left_kinds.count |left_details, right_kinds, right_details|:
                    return false if:
                        left_kinds[row] != right_kinds[row]
                        left_kinds[row] != 0 and (row >= left_details.count or row >= right_details.count or left_details[row] != right_details[row])
                return true

        def bam_reset_loop_exits(exits: mutable BorrowLoopExitState&) -> void:
            can Abort.Panic:
                exits.active_locals.truncate(0)
                exits.names.truncate(0)
                exits.fields.truncate(0)
                exits.owners.truncate(0)
                exits.kinds.truncate(0)
                exits.details.truncate(0)
                exits.seen <- false
                exits.exit_active_locals.truncate(0)
                exits.exit_paths.truncate(0)
                exits.continue_names.truncate(0)
                exits.continue_fields.truncate(0)
                exits.continue_owners.truncate(0)
                exits.continue_kinds.truncate(0)
                exits.continue_details.truncate(0)
                exits.continue_seen <- false
                exits.continue_active_locals.truncate(0)
                exits.continue_paths.truncate(0)

        def bam_scope_locals_equal(left: darray[sview]&, right: darray[sview]&) -> bool:
            return false if left.count != right.count
            for row in 0..<left.count |left, right|:
                return false if left[row] != right[row]
            return true

        def bam_capture_loop_exit_path(paths: mutable darray[BorrowLoopExitPath]&, active_locals: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: darray[u32]&, details: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                path: mutable BorrowLoopExitPath = BorrowLoopExitPath{}
                path.active_locals.extend(active_locals)
                path.names.extend(borrow_names)
                path.fields.extend(borrow_fields)
                path.owners.extend(borrow_owners)
                path.kinds.extend(kinds)
                path.details.extend(details)
                paths.push(path)

        def bam_capture_continue(exits: mutable BorrowLoopExitState&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: darray[u32]&, details: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if exits.continue_seen:
                    if exits.continue_paths.count == 0 and bam_scope_locals_equal(exits.continue_active_locals, exits.active_locals):
                        bam_merge_borrow_state(exits.continue_names, exits.continue_fields, exits.continue_owners, borrow_names, borrow_fields, borrow_owners)
                        bam_merge(exits.continue_kinds, exits.continue_details, kinds, details)
                        return
                    if exits.continue_paths.count == 0:
                        bam_capture_loop_exit_path(exits.continue_paths, exits.continue_active_locals, exits.continue_names, exits.continue_fields, exits.continue_owners, exits.continue_kinds, exits.continue_details)
                    last_index: usize = exits.continue_paths.count - 1
                    last_path: mutable BorrowLoopExitPath = exits.continue_paths[last_index]
                    if bam_scope_locals_equal(last_path.active_locals, exits.active_locals):
                        bam_merge_borrow_state(last_path.names, last_path.fields, last_path.owners, borrow_names, borrow_fields, borrow_owners)
                        bam_merge(last_path.kinds, last_path.details, kinds, details)
                        exits.continue_paths[last_index] <- last_path
                    else:
                        bam_capture_loop_exit_path(exits.continue_paths, exits.active_locals, borrow_names, borrow_fields, borrow_owners, kinds, details)
                    # Once path snapshots exist, defer their join until filtering. Joining here
                    # duplicates work because the scope boundary must rebuild the joined state.
                else:
                    bam_replace_borrow_state(exits.continue_names, exits.continue_fields, exits.continue_owners, borrow_names, borrow_fields, borrow_owners)
                    exits.continue_kinds.extend(kinds)
                    exits.continue_details.extend(details)
                    exits.continue_active_locals.extend(exits.active_locals)
                    exits.continue_seen <- true

        def bam_capture_loop_exit(exits: mutable BorrowLoopExitState&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: darray[u32]&, details: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if exits.seen:
                    if exits.exit_paths.count == 0 and bam_scope_locals_equal(exits.exit_active_locals, exits.active_locals):
                        bam_merge_borrow_state(exits.names, exits.fields, exits.owners, borrow_names, borrow_fields, borrow_owners)
                        bam_merge(exits.kinds, exits.details, kinds, details)
                        return
                    if exits.exit_paths.count == 0:
                        bam_capture_loop_exit_path(exits.exit_paths, exits.exit_active_locals, exits.names, exits.fields, exits.owners, exits.kinds, exits.details)
                    last_index: usize = exits.exit_paths.count - 1
                    last_path: mutable BorrowLoopExitPath = exits.exit_paths[last_index]
                    if bam_scope_locals_equal(last_path.active_locals, exits.active_locals):
                        bam_merge_borrow_state(last_path.names, last_path.fields, last_path.owners, borrow_names, borrow_fields, borrow_owners)
                        bam_merge(last_path.kinds, last_path.details, kinds, details)
                        exits.exit_paths[last_index] <- last_path
                    else:
                        bam_capture_loop_exit_path(exits.exit_paths, exits.active_locals, borrow_names, borrow_fields, borrow_owners, kinds, details)
                    # As with continues, the scope boundary performs the needed join.
                else:
                    bam_replace_borrow_state(exits.names, exits.fields, exits.owners, borrow_names, borrow_fields, borrow_owners)
                    exits.kinds.extend(kinds)
                    exits.details.extend(details)
                    exits.exit_active_locals.extend(exits.active_locals)
                    exits.seen <- true

        def bam_merge_loop_exit_states(target: mutable BorrowLoopExitState&, alternate: BorrowLoopExitState&) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_capture_loop_exit(target, alternate.names, alternate.fields, alternate.owners, alternate.kinds, alternate.details) if alternate.seen
                bam_capture_continue(target, alternate.continue_names, alternate.continue_fields, alternate.continue_owners, alternate.continue_kinds, alternate.continue_details) if alternate.continue_seen

        # Non-scoped conditional blocks keep their declarations in the enclosing resolver
        # scope. Preserve each abrupt path's reached names when bringing it into that scope;
        # the caller adds normally reached names only when the block has a normal outcome.
        def bam_merge_unscoped_loop_exit_paths(target: mutable BorrowLoopExitState&, alternate: BorrowLoopExitState&) -> void:
            can Memory.Allocate, Abort.Panic:
                parent_locals: mutable darray[sview] = []
                parent_locals.extend(target.active_locals)
                if alternate.exit_paths.count == 0 and alternate.seen:
                    for local in alternate.exit_active_locals |target|:
                        bam_append_scope_local(target.active_locals, local)
                    bam_capture_loop_exit(target, alternate.names, alternate.fields, alternate.owners, alternate.kinds, alternate.details)
                else:
                    for path in alternate.exit_paths |target, parent_locals|:
                        target.active_locals.truncate(0)
                        target.active_locals.extend(parent_locals)
                        for local in path.active_locals |target|:
                            bam_append_scope_local(target.active_locals, local)
                        bam_capture_loop_exit(target, path.names, path.fields, path.owners, path.kinds, path.details)
                if alternate.continue_paths.count == 0 and alternate.continue_seen:
                    target.active_locals.truncate(0)
                    target.active_locals.extend(parent_locals)
                    for local in alternate.continue_active_locals |target|:
                        bam_append_scope_local(target.active_locals, local)
                    bam_capture_continue(target, alternate.continue_names, alternate.continue_fields, alternate.continue_owners, alternate.continue_kinds, alternate.continue_details)
                else:
                    for path in alternate.continue_paths |target, parent_locals|:
                        target.active_locals.truncate(0)
                        target.active_locals.extend(parent_locals)
                        for local in path.active_locals |target|:
                            bam_append_scope_local(target.active_locals, local)
                        bam_capture_continue(target, path.names, path.fields, path.owners, path.kinds, path.details)
                target.active_locals.truncate(0)
                target.active_locals.extend(parent_locals)

        # Stop reading `name` as a borrow: the newest row wins, and this one names no owner.
        def bam_drop_borrow(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_clear_borrow_fields(name, borrow_names, borrow_fields, borrow_owners)

        def bam_field_key_matches(candidate: sview, parent: sview, field: sview) -> bool:
            can Abort.Panic:
                needed: usize = parent.len + (1.usize() if parent != "" else 0.usize()) + field.len
                return false if candidate.len != needed
                cursor: mutable usize = 0
                if parent != "":
                    for index in 0..<parent.len |cursor, candidate, parent|:
                        return false if candidate[cursor] != parent[index]
                        cursor <- cursor + 1.usize()
                    return false if candidate[cursor] != 46
                    cursor <- cursor + 1.usize()
                for index in 0..<field.len |cursor, candidate, field|:
                    return false if candidate[cursor] != field[index]
                    cursor <- cursor + 1.usize()
                return true

        def bam_join_field_key(parent: sview, field: sview, known_fields: darray[sview]&, table: lmut SymbolTable) -> sview:
            can Memory.Allocate, Abort.Panic:
                return field if parent == ""
                for known in known_fields |parent, field|:
                    return known if bam_field_key_matches(known, parent, field)
                start: usize = table.text_storage.count
                for index in 0..<parent.len |table| -> table:
                    table.text_storage.push(parent[index])
                table.text_storage.push(46)
                for index in 0..<field.len |table| -> table:
                    table.text_storage.push(field[index])
                return bytes_view_range(table.text_storage, start, table.text_storage.count - start)

        def bam_expression_field_path(expression: Ast::Expr, known_fields: darray[sview]&, table: lmut SymbolTable) -> (root: sview, field: sview):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(root_name, _):
                        return (root_name, "")
                    Expr.Field(field_object, field_name, _):
                        parent_path: (root: sview, field: sview) = bam_expression_field_path(field_object, known_fields, table)
                        return ("", "") if parent_path.root == ""
                        return (parent_path.root, bam_join_field_key(parent_path.field, field_name, known_fields, table))
                    Expr.Paren(inner, _):
                        return bam_expression_field_path(inner, known_fields, table)
                    _:
                        return ("", "")

        def bam_value_owners(value: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, out: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Ampersand:
                            addressed: sview = ident_name_of(operand)
                            bam_append_unique_owner(out, addressed) if bam_is_owner(owners, addressed)
                    Expr.Paren(inner, _):
                        bam_value_owners(inner, owners, borrow_names, borrow_fields, borrow_owners, out, table)
                    Expr.Move(inner, _):
                        bam_value_owners(inner, owners, borrow_names, borrow_fields, borrow_owners, out, table)
                    Expr.Ident(source_name, _):
                        bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_name, "", out)
                    Expr.Field(field_object, _, _):
                        source_path: (root: sview, field: sview) = bam_expression_field_path(value, borrow_fields, table)
                        if source_path.root != "" and source_path.field != "":
                            bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_path.root, source_path.field, out)
                        else:
                            bam_value_owners(field_object, owners, borrow_names, borrow_fields, borrow_owners, out, table)
                    _:
                        pass

        def bam_update_has_later_field(fields: darray[Ast::FieldInit], field_name: sview, after: usize) -> bool:
            can Abort.Panic:
                probe: mutable usize = after + 1
                while probe < fields.count |probe, fields, field_name|:
                    return true if fields[probe].name == field_name
                    probe <- probe + 1
                return false

        # Owners inside an aggregate field are summarized at the containing field. The
        # recursive walk follows aggregate values and known lender calls so nested references
        # don't disappear from the summary.
        def bam_nested_value_owners(value: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, out: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Construct(_, fields, _):
                        for field in fields |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            bam_nested_value_owners(field.value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.RecordUpdate(base, fields, _):
                        base_name: sview = ident_name_of(base)
                        if base_name != "":
                            bam_value_owners(base, owners, borrow_names, borrow_fields, borrow_owners, out, table)
                            base_names: mutable darray[sview] = []
                            base_fields: mutable darray[sview] = []
                            bam_collect_borrow_keys(borrow_names, borrow_fields, base_name, base_names, base_fields)
                            for base_field in base_fields |base_names, base_name, borrow_names, borrow_fields, borrow_owners, fields, out|:
                                continue if base_field == "" or (base_field != "*" and (any update in fields where update.name == base_field or bam_field_path_within(base_field, update.name)))
                                bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, base_name, base_field, out)
                        else:
                            bam_nested_value_owners(base, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                        update_index: mutable usize = 0
                        for field in fields |update_index, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            if not bam_update_has_later_field(fields, field.name, update_index):
                                bam_nested_value_owners(field.value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                            update_index <- update_index + 1
                    Expr.Ident(source_name, _):
                        bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, out, table)
                        field_names: mutable darray[sview] = []
                        field_keys: mutable darray[sview] = []
                        bam_collect_borrow_keys(borrow_names, borrow_fields, source_name, field_names, field_keys)
                        for field in field_keys |field_names, source_name, borrow_names, borrow_fields, borrow_owners, out|:
                            continue if field == ""
                            bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_name, field, out)
                    Expr.Field(field_object, _, _):
                        source_path: (root: sview, field: sview) = bam_expression_field_path(value, borrow_fields, table)
                        if source_path.root != "" and source_path.field != "":
                            bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_path.root, source_path.field, out)
                            field_names: mutable darray[sview] = []
                            field_keys: mutable darray[sview] = []
                            bam_collect_borrow_keys(borrow_names, borrow_fields, source_path.root, field_names, field_keys)
                            source_path_root: sview = source_path.root
                            source_path_field: sview = source_path.field
                            for source_field in field_keys |field_names, source_path_root, source_path_field, borrow_names, borrow_fields, borrow_owners, out|:
                                continue if source_field == source_path_field or not bam_field_path_within(source_field, source_path_field)
                                bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_path_root, source_field, out)
                        else:
                            bam_nested_value_owners(field_object, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Paren(inner, _):
                        bam_nested_value_owners(inner, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Move(inner, _):
                        bam_nested_value_owners(inner, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            bam_nested_value_owners(element, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            bam_nested_value_owners(entry.key, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                            bam_nested_value_owners(entry.value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.If(_, then_value, else_value, _):
                        bam_nested_value_owners(then_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                        bam_nested_value_owners(else_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Block(_, block_value, _, _):
                        bam_nested_value_owners(block_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        for arm in arms |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(arm_value, _):
                                        bam_nested_value_owners(arm_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                    Stmt.Return(arm_return_option, _):
                                        if arm_return_option is arm_return_value:
                                            bam_nested_value_owners(arm_return_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                    _:
                                        pass
                    Expr.GetElse(guarded, recovery, _):
                        bam_nested_value_owners(guarded, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                        if recovery.count > 0:
                            match recovery[recovery.count - 1]:
                                Stmt.Expr(recovery_value, _):
                                    bam_nested_value_owners(recovery_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                Stmt.Return(recovery_return_option, _):
                                    if recovery_return_option is recovery_return_value:
                                        bam_nested_value_owners(recovery_return_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                _:
                                    pass
                    Expr.Call(_, _, _, _):
                        bam_lend_owners(value, owners, lend_names, lend_positions, lend_parameter_names, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    _:
                        bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, out, table)

        # Keep aggregate provenance at its full field path. A summary attached only to the
        # immediate parent field would make reading an unrelated sibling look borrowed.
        def bam_bind_value_fields(destination: sview, prefix: sview, value: Ast::Expr, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, out_names: mutable darray[sview]&, out_fields: mutable darray[sview]&, out_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                direct_owners: mutable darray[sview] = []
                bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, direct_owners, table)
                bam_lend_owners(value, owners, lend_names, lend_positions, lend_parameter_names, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, direct_owners, table) if direct_owners.count == 0
                if prefix != "":
                    bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, prefix)
                    for owner in direct_owners |out_names, out_fields, out_owners, destination, prefix|:
                        bam_push_borrow(out_names, out_fields, out_owners, destination, prefix, owner)
                    if direct_owners.count > 0:
                        wildcard_path: sview = bam_join_field_key(prefix, "*", out_fields, table)
                        bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, wildcard_path)
                        for owner in direct_owners |out_names, out_fields, out_owners, destination, wildcard_path|:
                            bam_push_borrow(out_names, out_fields, out_owners, destination, wildcard_path, owner)
                match value:
                    Expr.Construct(_, fields, _):
                        for init in fields |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, destination, prefix, table|:
                            child_path: sview = bam_join_field_key(prefix, init.name, out_fields, table)
                            bam_bind_value_fields(destination, child_path, init.value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.RecordUpdate(base, fields, _):
                        bam_bind_value_fields(destination, prefix, base, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                        for init in fields |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, destination, prefix, table|:
                            child_path: sview = bam_join_field_key(prefix, init.name, out_fields, table)
                            bam_clear_borrow_path(destination, child_path, out_names, out_fields, out_owners, table)
                            bam_bind_value_fields(destination, child_path, init.value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.Ident(source_name, _):
                        bam_copy_borrow_fields(destination, prefix, source_name, "", borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.Field(_, _, _):
                        source_path: (root: sview, field: sview) = bam_expression_field_path(value, borrow_fields, table)
                        bam_copy_borrow_fields(destination, prefix, source_path.root, source_path.field, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table) if source_path.root != "" and source_path.field != ""
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        bam_bind_value_fields(destination, prefix, inner, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _) | Expr.If(_, _, _, _) | Expr.Block(_, _, _, _):
                        nested_owners: mutable darray[sview] = []
                        bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, nested_owners, table)
                        if prefix != "" and nested_owners.count > 0:
                            bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, prefix)
                            for nested_owner in nested_owners |out_names, out_fields, out_owners, destination, prefix|:
                                bam_push_borrow(out_names, out_fields, out_owners, destination, prefix, nested_owner)
                            wildcard_path: sview = bam_join_field_key(prefix, "*", out_fields, table)
                            bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, wildcard_path)
                            for nested_owner in nested_owners |out_names, out_fields, out_owners, destination, wildcard_path|:
                                bam_push_borrow(out_names, out_fields, out_owners, destination, wildcard_path, nested_owner)
                    _:
                        pass

        # Append a scope binder without a linear duplicate check. The scope filter builds a
        # hash index after collecting the tree, so repeated spellings stay linear overall.
        def bam_append_scope_local(out: mutable darray[sview]&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                out.push(name) if name != "" and name != "_"

        def bam_collect_rhs_pattern_locals(pattern: Ast::Pattern, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name) | Pattern.Rest(name):
                        bam_append_scope_local(out, name)
                    Pattern.As(name, inner):
                        bam_append_scope_local(out, name)
                        for child in inner |out|:
                            bam_collect_rhs_pattern_locals(child, out)
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children) | Pattern.Or(children):
                        for child in children |out|:
                            bam_collect_rhs_pattern_locals(child, out)
                    _:
                        pass

        def bam_pattern_is_wildcard(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                return match pattern:
                    Pattern.Wildcard: true
                    _: false

        def bam_match_pattern_catches_all(pattern: Ast::Pattern, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match pattern:
                    Pattern.Wildcard | Pattern.Binding(_): true
                    Pattern.Tuple(elements): elements.count > 0 and not (any element in elements where not bam_pattern_is_wildcard(element))
                    Pattern.Struct(_, fields): struct_pattern_fields_are_irrefutable(fields)
                    Pattern.Variant(path, fields): path_names_declared_struct(path, table) and struct_pattern_fields_are_irrefutable(fields)
                    _: false

        # A scope filter owns only the declarations directly in its statement list. Nested
        # `if`/loop/match/block scopes restore their own binders at their own boundary; pulling
        # those names into the enclosing list would incorrectly restore an outer spelling from
        # the enclosing entry state and discard later assignments to that outer binding.
        def bam_collect_rhs_scope_stmt_locals(statements: darray[Ast::Stmt], binders: BorrowBinders&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |binders, out|:
                    match statement:
                        Stmt.VarDecl(name, _, _, _):
                            bam_append_scope_local(out, name)
                        Stmt.Assign(target, operator, _, _):
                            if operator == TokenKind.Assign:
                                match target:
                                    Expr.Ident(assigned_name, _):
                                        bam_append_scope_local(out, assigned_name)
                                    _:
                                        pass
                        _:
                            pass

        def bam_restore_borrow_name_state(local_names: darray[sview]&, names: mutable darray[sview]&, fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if local_names.count == 0
                local_fields: mutable darray[sview] = []
                capacity: mutable usize = 16
                while capacity < (local_names.count + 1) * 2 |capacity, local_names|:
                    capacity <- capacity * 2
                slots: mutable darray[usize] = []
                slots.reserve(capacity)
                for _ in 0..<capacity |slots|:
                    slots.push(0)
                for local_name in local_names |slots, local_fields|:
                    local_fields.push("")
                    slot, found = bam_borrow_key_probe(slots, local_names, local_fields, local_name, "")
                    slots[slot] <- local_fields.count if not found
                restored_names: mutable darray[sview] = []
                restored_fields: mutable darray[sview] = []
                restored_owners: mutable darray[sview] = []
                for row in 0..<names.count |row, restored_names, restored_fields, restored_owners, slots, local_names, local_fields, names, fields, borrow_owners|:
                    row_name: sview = names[row]
                    _, is_local = bam_borrow_key_probe(slots, local_names, local_fields, row_name, "")
                    if not is_local:
                        restored_names.push(row_name)
                        restored_fields.push(fields[row] if row < fields.count else "")
                        restored_owners.push(borrow_owners[row] if row < borrow_owners.count else "")
                for row in 0..<base_names.count |row, restored_names, restored_fields, restored_owners, slots, local_names, local_fields, base_names, base_fields, base_owners|:
                    row_name: sview = base_names[row]
                    _, is_local = bam_borrow_key_probe(slots, local_names, local_fields, row_name, "")
                    if is_local:
                        restored_names.push(row_name)
                        restored_fields.push(base_fields[row] if row < base_fields.count else "")
                        restored_owners.push(base_owners[row] if row < base_owners.count else "")
                names.truncate(0)
                fields.truncate(0)
                borrow_owners.truncate(0)
                names.extend(restored_names)
                fields.extend(restored_fields)
                borrow_owners.extend(restored_owners)

        def bam_filter_rhs_scope_borrow_state(statements: darray[Ast::Stmt], extra_locals: darray[sview]&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                locals: mutable darray[sview] = []
                bam_collect_rhs_scope_stmt_locals(statements, binders, locals)
                for extra_local in extra_locals |locals|:
                    bam_append_scope_local(locals, extra_local)
                bam_restore_borrow_name_state(locals, borrow_names, borrow_fields, borrow_owners, base_names, base_fields, base_owners)

        def bam_filter_borrow_state_locals(active_locals: darray[sview]&, extra_locals: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                locals: mutable darray[sview] = []
                locals.extend(active_locals)
                for extra_local in extra_locals |locals|:
                    bam_append_scope_local(locals, extra_local)
                bam_restore_borrow_name_state(locals, borrow_names, borrow_fields, borrow_owners, base_names, base_fields, base_owners)

        # Abrupt paths can exit before later declarations in the same body. Filter each captured
        # path with only the locals reached at that exit, then rebuild the compatibility join used
        # by the ownership fixed point.
        def bam_filter_loop_exit_paths(exits: mutable BorrowLoopExitState&, extra_locals: darray[sview]&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if exits.exit_paths.count == 0:
                    if exits.seen:
                        bam_filter_borrow_state_locals(exits.exit_active_locals, extra_locals, exits.names, exits.fields, exits.owners, base_names, base_fields, base_owners)
                else:
                    exits.names.truncate(0)
                    exits.fields.truncate(0)
                    exits.owners.truncate(0)
                    exits.kinds.truncate(0)
                    exits.details.truncate(0)
                    exits.seen <- false
                    for row in 0..<exits.exit_paths.count |row, exits, extra_locals, base_names, base_fields, base_owners|:
                        path: mutable BorrowLoopExitPath = exits.exit_paths[row]
                        bam_filter_borrow_state_locals(path.active_locals, extra_locals, path.names, path.fields, path.owners, base_names, base_fields, base_owners)
                        exits.exit_paths[row] <- path
                        if exits.seen:
                            bam_merge_borrow_state(exits.names, exits.fields, exits.owners, path.names, path.fields, path.owners)
                            bam_merge(exits.kinds, exits.details, path.kinds, path.details)
                        else:
                            bam_replace_borrow_state(exits.names, exits.fields, exits.owners, path.names, path.fields, path.owners)
                            exits.kinds.extend(path.kinds)
                            exits.details.extend(path.details)
                            exits.seen <- true
                if exits.continue_paths.count == 0:
                    if exits.continue_seen:
                        bam_filter_borrow_state_locals(exits.continue_active_locals, extra_locals, exits.continue_names, exits.continue_fields, exits.continue_owners, base_names, base_fields, base_owners)
                    return
                exits.continue_names.truncate(0)
                exits.continue_fields.truncate(0)
                exits.continue_owners.truncate(0)
                exits.continue_kinds.truncate(0)
                exits.continue_details.truncate(0)
                exits.continue_seen <- false
                for row in 0..<exits.continue_paths.count |row, exits, extra_locals, base_names, base_fields, base_owners|:
                    path: mutable BorrowLoopExitPath = exits.continue_paths[row]
                    bam_filter_borrow_state_locals(path.active_locals, extra_locals, path.names, path.fields, path.owners, base_names, base_fields, base_owners)
                    exits.continue_paths[row] <- path
                    if exits.continue_seen:
                        bam_merge_borrow_state(exits.continue_names, exits.continue_fields, exits.continue_owners, path.names, path.fields, path.owners)
                        bam_merge(exits.continue_kinds, exits.continue_details, path.kinds, path.details)
                    else:
                        bam_replace_borrow_state(exits.continue_names, exits.continue_fields, exits.continue_owners, path.names, path.fields, path.owners)
                        exits.continue_kinds.extend(path.kinds)
                        exits.continue_details.extend(path.details)
                        exits.continue_seen <- true

        def bam_expression_larrow_rhs(value: Ast::Expr, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, flow: mutable darray[bool]&, loop_exits: mutable BorrowLoopExitState&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                source_value: mutable Ast::Expr = value
                while source_value is Expr.Paren(inner_value, _) |source_value|:
                    source_value <- inner_value
                match source_value:
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table|:
                            continue if flow[0]
                            move_owner: sview = bam_moved_owner(element, owners)
                            if move_owner != "":
                                bam_set_consumed(owners, kinds, details, move_owner, 3, "")
                            else:
                                table <- bam_expression_larrow_rhs(element, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                    Expr.If(condition, then_value, else_value, _):
                        table <- bam_expression_larrow_rhs(condition, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                        if not flow[0]:
                            then_kinds: mutable darray[u32] = []
                            then_details: mutable darray[sview] = []
                            then_names: mutable darray[sview] = []
                            then_fields: mutable darray[sview] = []
                            then_owners: mutable darray[sview] = []
                            else_kinds: mutable darray[u32] = []
                            else_details: mutable darray[sview] = []
                            else_names: mutable darray[sview] = []
                            else_fields: mutable darray[sview] = []
                            else_owners: mutable darray[sview] = []
                            then_kinds.extend(kinds)
                            then_details.extend(details)
                            then_names.extend(borrow_names)
                            then_fields.extend(borrow_fields)
                            then_owners.extend(borrow_owners)
                            else_kinds.extend(kinds)
                            else_details.extend(details)
                            else_names.extend(borrow_names)
                            else_fields.extend(borrow_fields)
                            else_owners.extend(borrow_owners)
                            then_flow: mutable darray[bool] = [false]
                            else_flow: mutable darray[bool] = [false]
                            then_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            else_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            table <- bam_expression_larrow_rhs(then_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, then_names, then_fields, then_owners, then_kinds, then_details, then_flow, then_exits, table)
                            table <- bam_expression_larrow_rhs(else_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, else_names, else_fields, else_owners, else_kinds, else_details, else_flow, else_exits, table)
                            bam_merge_loop_exit_states(loop_exits, then_exits)
                            bam_merge_loop_exit_states(loop_exits, else_exits)
                            bam_merge(kinds, details, then_kinds, then_details) if not then_flow[0]
                            bam_merge(kinds, details, else_kinds, else_details) if not else_flow[0]
                            if not then_flow[0] and not else_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_names, then_fields, then_owners)
                                bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, else_names, else_fields, else_owners)
                            elif not then_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_names, then_fields, then_owners)
                            elif not else_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, else_names, else_fields, else_owners)
                            flow[0] <- true if then_flow[0] and else_flow[0]
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        pattern_base_names: mutable darray[sview] = []
                        pattern_base_fields: mutable darray[sview] = []
                        pattern_base_owners: mutable darray[sview] = []
                        pattern_base_names.extend(borrow_names)
                        pattern_base_fields.extend(borrow_fields)
                        pattern_base_owners.extend(borrow_owners)
                        table <- bam_expression_larrow_rhs(scrutinee, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                        if not flow[0]:
                            merged_kinds: mutable darray[u32] = []
                            merged_details: mutable darray[sview] = []
                            merged_names: mutable darray[sview] = []
                            merged_fields: mutable darray[sview] = []
                            merged_owners: mutable darray[sview] = []
                            merged_kinds.extend(kinds)
                            merged_details.extend(details)
                            merged_names.extend(borrow_names)
                            merged_fields.extend(borrow_fields)
                            merged_owners.extend(borrow_owners)
                            residual_kinds: mutable darray[u32] = []
                            residual_details: mutable darray[sview] = []
                            residual_names: mutable darray[sview] = []
                            residual_fields: mutable darray[sview] = []
                            residual_owners: mutable darray[sview] = []
                            residual_kinds.extend(kinds)
                            residual_details.extend(details)
                            residual_names.extend(borrow_names)
                            residual_fields.extend(borrow_fields)
                            residual_owners.extend(borrow_owners)
                            residual_possible: mutable bool = true
                            pattern_owners: mutable darray[sview] = []
                            pattern_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            pattern_names: mutable darray[sview] = []
                            pattern_fields: mutable darray[sview] = []
                            pattern_owners_state: mutable darray[sview] = []
                            pattern_names.extend(pattern_base_names)
                            pattern_fields.extend(pattern_base_fields)
                            pattern_owners_state.extend(pattern_base_owners)
                            table <- bam_nested_value_owners_scoped(scrutinee, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, pattern_names, pattern_fields, pattern_owners_state, pattern_owners, pattern_flow, table)
                            has_normal_arm: mutable bool = false
                            for arm in arms |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, merged_kinds, merged_details, merged_names, merged_fields, merged_owners, residual_kinds, residual_details, residual_names, residual_fields, residual_owners, residual_possible, has_normal_arm, table|:
                                break if not residual_possible
                                arm_kinds: mutable darray[u32] = []
                                arm_details: mutable darray[sview] = []
                                arm_names: mutable darray[sview] = []
                                arm_fields: mutable darray[sview] = []
                                arm_owners: mutable darray[sview] = []
                                arm_base_names: mutable darray[sview] = []
                                arm_base_fields: mutable darray[sview] = []
                                arm_base_owners: mutable darray[sview] = []
                                arm_flow: mutable darray[bool] = [false]
                                arm_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                                guard_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                                arm_kinds.extend(residual_kinds)
                                arm_details.extend(residual_details)
                                arm_names.extend(residual_names)
                                arm_fields.extend(residual_fields)
                                arm_owners.extend(residual_owners)
                                arm_base_names.extend(residual_names)
                                arm_base_fields.extend(residual_fields)
                                arm_base_owners.extend(residual_owners)
                                table <- bam_seed_pattern_borrow_state(arm.pattern, scrutinee, pattern_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, table)
                                has_guard: bool = match arm.guard:
                                    Expr.Invalid | Expr.Absent: false
                                    _: true
                                arm_catches_all: bool = bam_match_pattern_catches_all(arm.pattern, table)
                                arm_local_names: mutable darray[sview] = []
                                bam_collect_rhs_pattern_locals(arm.pattern, arm_local_names)
                                if has_guard:
                                    guard_exits.active_locals.extend(arm_local_names)
                                    table <- bam_expression_larrow_rhs(arm.guard, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, arm_kinds, arm_details, arm_flow, guard_exits, table)
                                    bam_filter_loop_exit_paths(guard_exits, arm_local_names, arm_base_names, arm_base_fields, arm_base_owners)
                                    bam_restore_pattern_borrow_state(arm.pattern, guard_exits.continue_names, guard_exits.continue_fields, guard_exits.continue_owners, arm_base_names, arm_base_fields, arm_base_owners) if guard_exits.continue_seen
                                    bam_restore_pattern_borrow_state(arm.pattern, guard_exits.names, guard_exits.fields, guard_exits.owners, arm_base_names, arm_base_fields, arm_base_owners) if guard_exits.seen
                                if has_guard and not arm_flow[0]:
                                    failed_names: mutable darray[sview] = []
                                    failed_fields: mutable darray[sview] = []
                                    failed_owners: mutable darray[sview] = []
                                    failed_names.extend(arm_names)
                                    failed_fields.extend(arm_fields)
                                    failed_owners.extend(arm_owners)
                                    bam_restore_pattern_borrow_state(arm.pattern, failed_names, failed_fields, failed_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                    if arm_catches_all:
                                        residual_kinds.truncate(0)
                                        residual_details.truncate(0)
                                        residual_names.truncate(0)
                                        residual_fields.truncate(0)
                                        residual_owners.truncate(0)
                                        residual_kinds.extend(arm_kinds)
                                        residual_details.extend(arm_details)
                                        residual_names.extend(failed_names)
                                        residual_fields.extend(failed_fields)
                                        residual_owners.extend(failed_owners)
                                    else:
                                        bam_merge(residual_kinds, residual_details, arm_kinds, arm_details)
                                        bam_merge_borrow_state(residual_names, residual_fields, residual_owners, failed_names, failed_fields, failed_owners)
                                elif arm_catches_all:
                                    residual_possible <- false
                                tail_count: mutable usize = arm.body.count
                                tail_value: mutable Ast::Expr = Ast::Expr.Invalid
                                tail_return: mutable bool = false
                                if arm.body.count > 0:
                                    match arm.body[arm.body.count - 1]:
                                        Stmt.Expr(arm_value, _):
                                            tail_count <- tail_count - 1
                                            tail_value <- arm_value
                                        Stmt.Return(arm_return_option, _):
                                            if arm_return_option is arm_return_value:
                                                tail_count <- tail_count - 1
                                                tail_value <- arm_return_value
                                                tail_return <- true
                                        _:
                                            pass
                                arm_body: darray[Ast::Stmt] = arm.body
                                arm_prefix: mutable darray[Ast::Stmt] = []
                                for prefix_index in 0..<tail_count |prefix_index, arm_body, arm_prefix|:
                                    arm_prefix.push(arm_body[prefix_index])
                                table <- bam_statements(arm_prefix, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, arm_kinds, arm_details, arm_flow, arm_exits, table) if not arm_flow[0]
                                table <- bam_expression_larrow_rhs(tail_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, arm_kinds, arm_details, arm_flow, arm_exits, table) if not arm_flow[0] and not (tail_value is Expr.Invalid)
                                arm_flow[0] <- true if tail_return and not arm_flow[0]
                                bam_filter_borrow_state_locals(arm_exits.active_locals, arm_local_names, arm_names, arm_fields, arm_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                bam_filter_loop_exit_paths(arm_exits, arm_local_names, arm_base_names, arm_base_fields, arm_base_owners)
                                bam_merge_loop_exit_states(loop_exits, guard_exits)
                                bam_merge_loop_exit_states(loop_exits, arm_exits)
                                if not arm_flow[0]:
                                    bam_merge(merged_kinds, merged_details, arm_kinds, arm_details)
                                    if not has_normal_arm:
                                        bam_replace_borrow_state(merged_names, merged_fields, merged_owners, arm_names, arm_fields, arm_owners)
                                        has_normal_arm <- true
                                    else:
                                        bam_merge_borrow_state(merged_names, merged_fields, merged_owners, arm_names, arm_fields, arm_owners)
                            residual_possible <- false if match_arms_exhaustive(arms, table)
                            if has_normal_arm:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, merged_names, merged_fields, merged_owners)
                                kinds.truncate(0)
                                kinds.extend(merged_kinds)
                                details.truncate(0)
                                details.extend(merged_details)
                                if residual_possible:
                                    bam_merge(kinds, details, residual_kinds, residual_details)
                                    bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_names, residual_fields, residual_owners)
                            elif residual_possible:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_names, residual_fields, residual_owners)
                                bam_merge(kinds, details, residual_kinds, residual_details)
                            else:
                                flow[0] <- true if arms.count > 0
                    Expr.GetElse(guarded, recovery, _):
                        guarded_kinds: mutable darray[u32] = []
                        guarded_details: mutable darray[sview] = []
                        guarded_names: mutable darray[sview] = []
                        guarded_fields: mutable darray[sview] = []
                        guarded_owners: mutable darray[sview] = []
                        recovery_kinds: mutable darray[u32] = []
                        recovery_details: mutable darray[sview] = []
                        recovery_names: mutable darray[sview] = []
                        recovery_fields: mutable darray[sview] = []
                        recovery_owners: mutable darray[sview] = []
                        guarded_flow: mutable darray[bool] = [false]
                        recovery_flow: mutable darray[bool] = [false]
                        guarded_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                        recovery_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                        guarded_kinds.extend(kinds)
                        guarded_details.extend(details)
                        guarded_names.extend(borrow_names)
                        guarded_fields.extend(borrow_fields)
                        guarded_owners.extend(borrow_owners)
                        table <- bam_expression_larrow_rhs(guarded, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, guarded_names, guarded_fields, guarded_owners, guarded_kinds, guarded_details, guarded_flow, guarded_exits, table)
                        recovery_kinds.extend(guarded_kinds)
                        recovery_details.extend(guarded_details)
                        recovery_names.extend(guarded_names)
                        recovery_fields.extend(guarded_fields)
                        recovery_owners.extend(guarded_owners)
                        recovery_count: mutable usize = recovery.count
                        recovery_value: mutable Ast::Expr = Ast::Expr.Invalid
                        recovery_return: mutable bool = false
                        if recovery.count > 0:
                            match recovery[recovery.count - 1]:
                                Stmt.Expr(recovery_tail, _):
                                    recovery_count <- recovery_count - 1
                                    recovery_value <- recovery_tail
                                Stmt.Return(recovery_option, _):
                                    if recovery_option is recovery_return_value:
                                        recovery_count <- recovery_count - 1
                                        recovery_value <- recovery_return_value
                                        recovery_return <- true
                                _:
                                    pass
                        recovery_prefix: mutable darray[Ast::Stmt] = []
                        for prefix_index in 0..<recovery_count |prefix_index, recovery, recovery_prefix|:
                            recovery_prefix.push(recovery[prefix_index])
                        table <- bam_statements(recovery_prefix, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, recovery_names, recovery_fields, recovery_owners, recovery_kinds, recovery_details, recovery_flow, recovery_exits, table) if not guarded_flow[0]
                        table <- bam_expression_larrow_rhs(recovery_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, recovery_names, recovery_fields, recovery_owners, recovery_kinds, recovery_details, recovery_flow, recovery_exits, table) if not guarded_flow[0] and not recovery_flow[0] and not (recovery_value is Expr.Invalid)
                        recovery_flow[0] <- true if not guarded_flow[0] and recovery_return and not recovery_flow[0]
                        bam_filter_borrow_state_locals(recovery_exits.active_locals, [], recovery_names, recovery_fields, recovery_owners, guarded_names, guarded_fields, guarded_owners) if not guarded_flow[0]
                        bam_filter_loop_exit_paths(recovery_exits, [], guarded_names, guarded_fields, guarded_owners) if not guarded_flow[0]
                        bam_merge_loop_exit_states(loop_exits, guarded_exits)
                        bam_merge_loop_exit_states(loop_exits, recovery_exits) if not guarded_flow[0]
                        if not guarded_flow[0] and not recovery_flow[0]:
                            bam_merge(kinds, details, guarded_kinds, guarded_details)
                            bam_merge(kinds, details, recovery_kinds, recovery_details)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, guarded_names, guarded_fields, guarded_owners)
                            bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, recovery_names, recovery_fields, recovery_owners)
                        elif not guarded_flow[0]:
                            bam_merge(kinds, details, guarded_kinds, guarded_details)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, guarded_names, guarded_fields, guarded_owners)
                        elif not recovery_flow[0]:
                            bam_merge(kinds, details, recovery_kinds, recovery_details)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, recovery_names, recovery_fields, recovery_owners)
                        flow[0] <- true if guarded_flow[0] and recovery_flow[0]
                    Expr.Block(block_statements, block_value, _, _):
                        # Evaluate block statements once with the full move/use checker. Keep
                        # borrow aliases scoped for the yielded expression; staged provenance
                        # replay later uses bam_scope_borrow_statements and does not consume
                        # moves or emit diagnostics a second time.
                        scoped_names: mutable darray[sview] = []
                        scoped_fields: mutable darray[sview] = []
                        scoped_owners: mutable darray[sview] = []
                        block_base_names: mutable darray[sview] = []
                        block_base_fields: mutable darray[sview] = []
                        block_base_owners: mutable darray[sview] = []
                        block_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                        block_base_names.extend(borrow_names)
                        block_base_fields.extend(borrow_fields)
                        block_base_owners.extend(borrow_owners)
                        scoped_names.extend(borrow_names)
                        scoped_fields.extend(borrow_fields)
                        scoped_owners.extend(borrow_owners)
                        table <- bam_statements(block_statements, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, kinds, details, flow, block_exits, table)
                        table <- bam_expression_larrow_rhs(block_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, kinds, details, flow, block_exits, table) if not flow[0]
                        bam_filter_loop_exit_paths(block_exits, [], block_base_names, block_base_fields, block_base_owners)
                        if not flow[0]:
                            bam_filter_borrow_state_locals(block_exits.active_locals, [], scoped_names, scoped_fields, scoped_owners, block_base_names, block_base_fields, block_base_owners)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, scoped_names, scoped_fields, scoped_owners)
                        bam_merge_loop_exit_states(loop_exits, block_exits)
                    _:
                        move_owner: sview = bam_moved_owner(source_value, owners)
                        if move_owner != "":
                            bam_set_consumed(owners, kinds, details, move_owner, 3, "")
                        else:
                            table <- bam_expression(source_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)

        def bam_stage_larrow_pair(target: Ast::Expr, value: Ast::Expr, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, entries: mutable darray[BorrowLarrowEntry], flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_replay_flow_reset(flow)
                source_value: mutable Ast::Expr = value
                while source_value is Expr.Paren(inner_value, _) |source_value|:
                    source_value <- inner_value
                match source_value:
                    Expr.Block(block_statements, block_value, _, _):
                        base_names: mutable darray[sview] = []
                        base_fields: mutable darray[sview] = []
                        base_owners: mutable darray[sview] = []
                        scoped_names: mutable darray[sview] = []
                        scoped_fields: mutable darray[sview] = []
                        scoped_owners: mutable darray[sview] = []
                        base_names.extend(borrow_names)
                        base_fields.extend(borrow_fields)
                        base_owners.extend(borrow_owners)
                        scoped_names.extend(borrow_names)
                        scoped_fields.extend(borrow_fields)
                        scoped_owners.extend(borrow_owners)
                        block_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_scope_borrow_statements(block_statements, block_statements.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, block_flow, table)
                        block_locals: mutable darray[sview] = []
                        bam_collect_rhs_scope_stmt_locals(block_statements, binders, block_locals)
                        bam_replay_flow_merge_exits(flow, block_flow)
                        if block_flow.normal_seen:
                            value_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_stage_larrow_pair(target, block_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, entries, value_flow, table)
                            bam_replay_flow_filter_exits_scope(value_flow, [], block_locals, binders, base_names, base_fields, base_owners)
                            bam_replay_flow_merge_exits(flow, value_flow)
                            if value_flow.normal_seen:
                                bam_filter_rhs_scope_borrow_state(block_statements, [], binders, scoped_names, scoped_fields, scoped_owners, base_names, base_fields, base_owners)
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, scoped_names, scoped_fields, scoped_owners)
                                bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                        bam_replay_flow_filter_normal_scope(flow, block_statements, [], binders, base_names, base_fields, base_owners)
                        return
                    _:
                        pass
                match target:
                    Expr.Paren(inner_target, _):
                        table <- bam_stage_larrow_pair(inner_target, source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entries, flow, table)
                    Expr.Array(targets, _):
                        matched_values: mutable darray[Ast::Expr] = []
                        match source_value:
                            Expr.Array(values, _) | Expr.Tuple(values, _):
                                if values.count == targets.count:
                                    matched_values.extend(values)
                            _:
                                pass
                        if matched_values.count == targets.count:
                            reachable: mutable bool = true
                            aggregate_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            for index in 0..<targets.count |index, reachable, targets, matched_values, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entries, aggregate_flow, table|:
                                continue if not reachable
                                item_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                table <- bam_stage_larrow_pair(targets[index], matched_values[index], owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entries, item_flow, table)
                                bam_replay_flow_merge_exits(aggregate_flow, item_flow)
                                reachable <- item_flow.normal_seen
                            bam_replay_flow_reset(flow)
                            bam_replay_flow_merge_exits(flow, aggregate_flow)
                            bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners) if reachable
                        else:
                            fallback_owners: mutable darray[sview] = []
                            table <- bam_nested_value_owners_scoped(source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, fallback_owners, flow, table)
                            if flow.normal_seen:
                                for target_item in targets |fallback_owners, entries, table|:
                                    table <- bam_stage_larrow_fallback(target_item, fallback_owners, entries, table)
                    _:
                        entry: mutable BorrowLarrowEntry = BorrowLarrowEntry{target: target, value: source_value}
                        table <- bam_nested_value_owners_scoped(source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entry.owners, flow, table)
                        if flow.normal_seen:
                            if not bam_expr_has_scoped_flow(source_value):
                                bam_bind_value_fields(ident_name_of(target), "", source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, entry.field_names, entry.field_fields, entry.field_owners, table) if target is Expr.Ident(_, _)
                            else:
                                destination_name: sview = ident_name_of(target)
                                if destination_name != "":
                                    for owner in entry.owners |entry, destination_name|:
                                        entry.field_names.push(destination_name)
                                        entry.field_fields.push("*")
                                        entry.field_owners.push(owner)
                            entry.move_owner <- bam_moved_owner(source_value, owners)
                            entries.push(entry)

        # A shape mismatch has no trustworthy positional mapping. Apply its aggregate owner
        # union to each leaf, while retaining independent per-leaf assignment effect lookups.
        def bam_stage_larrow_fallback(target: Ast::Expr, rebound_owners: darray[sview]&, entries: mutable darray[BorrowLarrowEntry], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Paren(inner_target, _):
                        table <- bam_stage_larrow_fallback(inner_target, rebound_owners, entries, table)
                    Expr.Array(targets, _):
                        for target_item in targets |rebound_owners, entries, table|:
                            table <- bam_stage_larrow_fallback(target_item, rebound_owners, entries, table)
                    _:
                        entry: mutable BorrowLarrowEntry = BorrowLarrowEntry{target: target, value: Ast::Expr.Invalid}
                        entry.owners.extend(rebound_owners)
                        match target:
                            Expr.Ident(target_name, _):
                                for rebound_owner in rebound_owners |entry, target_name|:
                                    entry.field_names.push(target_name)
                                    entry.field_fields.push("*")
                                    entry.field_owners.push(rebound_owner)
                            _:
                                pass
                        entries.push(entry)

        # The owner a `move o` names, else "".
        def bam_moved_owner(value: Ast::Expr, owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Move(moved_operand, moved_pos):
                        moved_name: sview = ident_name_of(moved_operand)
                        moved_name return if bam_is_owner(owners, moved_name)
                        return ""
                    _:
                        return ""

        # `r = lend(&o)`: source summaries identify which reference arguments may flow into a
        # returned reference-bearing value; an extern uses its explicit borrow-return contract.
        def bam_definition_target(pos: Ast::Pos, index: BorrowResolvedCallTargets&) -> DeclId:
            can Abort.Panic:
                return DeclId{value: 4294967295} if index.slots.count == 0
                hash: u64 = bam_definition_reference_hash(pos)
                capacity: usize = index.slots.count
                slot: mutable usize = hash.usize() & (capacity - 1)
                while index.slots[slot] != 0 |slot, index, pos, capacity|:
                    row: usize = (index.slots[slot] - 1).usize()
                    reference_pos: Ast::Pos = index.positions[row]
                    if reference_pos.offset == pos.offset and reference_pos.end_offset == pos.end_offset:
                        return DeclId{value: 4294967295} if index.ambiguous[row]
                        return index.declaration_ids[row]
                    slot <- (slot + 1) & (capacity - 1)
                return DeclId{value: 4294967295}

        def bam_direct_callee_target(callee: Ast::Expr, index: BorrowResolvedCallTargets&) -> DeclId:
            can Abort.Panic:
                match callee:
                    Expr.Ident(_, callee_pos):
                        return bam_definition_target(callee_pos, index)
                    _:
                        return DeclId{value: 4294967295}

        # Map the annotated extern formal to exactly one call argument. Named arguments use
        # the formal spelling; positional arguments use the formal slot. Malformed or duplicate
        # mappings are left unknown, so invalid calls cannot redirect a borrow to another owner.
        def bam_lender_argument_index(argument_count: usize, argument_names: darray[sview]&, formal_position: usize, formal_name: sview) -> i64:
            can Abort.Panic:
                matched: mutable i64 = -1
                positional_position: mutable usize = 0
                saw_named: mutable bool = false
                argument_index: mutable usize = 0
                while argument_index < argument_count |matched, positional_position, saw_named, argument_index|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    if argument_name != "":
                        saw_named <- true
                        if argument_name == formal_name:
                            return -1 if matched >= 0
                            matched <- argument_index.i64()
                    else:
                        return -1 if saw_named
                        if positional_position == formal_position:
                            return -1 if matched >= 0
                            matched <- argument_index.i64()
                        positional_position <- positional_position + 1
                    argument_index <- argument_index + 1
                return matched

        def bam_extern_lend_owners(value: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, out: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, _):
                        target: DeclId = bam_direct_callee_target(callee, call_targets)
                        return if target.value == 4294967295
                        lender_slot: mutable usize = extern_lend_ids.count
                        for index in 0..<extern_lend_ids.count |lender_slot, target, extern_lend_ids|:
                            if extern_lend_ids[index].value == target.value:
                                return if lender_slot < extern_lend_ids.count
                                lender_slot <- index
                        return if lender_slot >= extern_lend_ids.count or lender_slot >= extern_lend_positions.count or lender_slot >= extern_lend_names.count
                        argument_index: i64 = bam_lender_argument_index(arguments.count, argument_names, extern_lend_positions[lender_slot], extern_lend_names[lender_slot])
                        return if argument_index < 0 or argument_index.usize() >= arguments.count
                        bam_value_owners(arguments[argument_index.usize()], owners, borrow_names, borrow_fields, borrow_owners, out, table)
                    _:
                        pass

        def bam_lend_owners(value: Ast::Expr, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, out: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(Expr.Ident(callee_name, callee_pos), lend_arguments, lend_labels, _):
                        target: DeclId = bam_definition_target(callee_pos, call_targets)
                        found_source_summary: mutable bool = false
                        if target.value != 4294967295:
                            for slot in 0..<lend_names.count |found_source_summary, target, callee_name, lend_names, lend_positions, lend_parameter_names, out|:
                                continue if lend_names[slot] != callee_name or slot >= lend_positions.count or slot >= lend_parameter_names.count
                                argument_index: i64 = bam_lender_argument_index(lend_arguments.count, lend_labels, lend_positions[slot], lend_parameter_names[slot])
                                if argument_index >= 0 and argument_index.usize() < lend_arguments.count:
                                    bam_value_owners(lend_arguments[argument_index.usize()], owners, borrow_names, borrow_fields, borrow_owners, out, table)
                                    found_source_summary <- true
                        return if found_source_summary
                        bam_extern_lend_owners(value, owners, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Call(_, _, _, _):
                        pass
                    _:
                        pass

        def bam_report_slot_use(name: sview, field: sview, include_wildcard: bool, pos: Ast::Pos, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: darray[u32]&, details: darray[sview]&, table: lmut SymbolTable) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if name == ""
                exact_recorded: bool = bam_borrow_slot_recorded(borrow_names, borrow_fields, name, field)
                active_owners: mutable darray[sview] = []
                if exact_recorded:
                    _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, field, active_owners)
                    if active_owners.count == 0 and field == "" and include_wildcard:
                        _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, "*", active_owners)
                elif include_wildcard:
                    bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, name, field, active_owners)
                for borrowed_owner in active_owners |table, owners, kinds, details, name, field, pos|:
                    owner_slot: usize = bam_index_of(owners, borrowed_owner)
                    if owner_slot < owners.count and kinds[owner_slot] != 0:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BorrowUseAfterOwnerMove, name: name, pos: pos, line: pos.line, expected: details[owner_slot], actual: "", detail: field, expected_count: kinds[owner_slot]})
                        return true
                return false

        def bam_report_use(name: sview, field: sview, pos: Ast::Pos, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: darray[u32]&, details: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if bam_report_slot_use(name, field, true, pos, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                closed_fields: mutable darray[sview] = []
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe, closed_fields, table, owners, kinds, details, borrow_names, borrow_fields, borrow_owners, name, field, pos|:
                    probe <- probe - 1
                    continue if borrow_names[probe] != name or probe >= borrow_fields.count
                    current_field: sview = borrow_fields[probe]
                    continue if current_field == "" or current_field == "*" or (field != "" and (current_field == field or not bam_field_path_within(current_field, field)))
                    field_closed: mutable bool = false
                    for closed_field in closed_fields |field_closed, current_field, closed_fields|:
                        field_closed <- true if closed_field == current_field
                    continue if field_closed
                    if probe >= borrow_owners.count or borrow_owners[probe] == "":
                        closed_fields.push(current_field)
                    else:
                        owner_slot: usize = bam_index_of(owners, borrow_owners[probe])
                        if owner_slot < owners.count and kinds[owner_slot] != 0:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BorrowUseAfterOwnerMove, name: name, pos: pos, line: pos.line, expected: details[owner_slot], actual: "", detail: current_field, expected_count: kinds[owner_slot]})
                            return

        def bam_expression(expression: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(used_name, used_pos):
                        table <- bam_report_use(used_name, "", used_pos, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Field(field_object, field_name, field_pos):
                        # Keep the complete nested path, so a borrow in one field does not make
                        # reads of sibling fields look borrowed.
                        field_path: (root: sview, field: sview) = bam_expression_field_path(expression, borrow_fields, table)
                        if field_path.root != "" and field_path.field != "":
                            receiver_path: (root: sview, field: sview) = bam_expression_field_path(field_object, borrow_fields, table)
                            receiver_reported: mutable bool = false
                            if receiver_path.root != "":
                                receiver_reported <- bam_report_slot_use(receiver_path.root, receiver_path.field, true, expr_pos(field_object), owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            else:
                                table <- bam_expression(field_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            table <- bam_report_use(field_path.root, field_path.field, field_pos, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if not receiver_reported
                        else:
                            table <- bam_expression(field_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Call(call_callee, call_arguments, call_labels, call_pos):
                        callee_name: sview = ident_name_of(call_callee)
                        table <- bam_expression(call_callee, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if callee_name == ""
                        for call_argument in call_arguments |kinds, details, table| -> table:
                            table <- bam_expression(call_argument, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if bam_moved_owner(call_argument, owners) == ""
                        # The arguments are read BEFORE the call consumes any of them.
                        for consumed_argument in call_arguments |kinds, details|:
                            bam_set_consumed(owners, kinds, details, bam_moved_owner(consumed_argument, owners), 1, callee_name) if callee_name != ""
                    Expr.Construct(construct_head, construct_fields, construct_pos) | Expr.RecordUpdate(construct_head, construct_fields, construct_pos):
                        for construct_init in construct_fields |kinds, details, table| -> table:
                            table <- bam_expression(construct_init.value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if bam_moved_owner(construct_init.value, owners) == ""
                        for consumed_init in construct_fields |kinds, details|:
                            bam_set_consumed(owners, kinds, details, bam_moved_owner(consumed_init.value, owners), 4, consumed_init.name)
                    Expr.Binary(binary_left, binary_operator, binary_right, binary_pos):
                        table <- bam_expression(binary_left, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(binary_right, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if binary_operator != TokenKind.Is and binary_operator != TokenKind.As
                    Expr.Unary(_, unary_operand, unary_pos) | Expr.Paren(unary_operand, unary_pos) | Expr.Move(unary_operand, unary_pos) | Expr.RegionNew(unary_operand, _, unary_pos):
                        table <- bam_expression(unary_operand, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Index(index_object, index_value, index_pos):
                        table <- bam_expression(index_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(index_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.IndexN(indexn_object, indexn_arguments, indexn_pos):
                        table <- bam_expression(indexn_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        for indexn_argument in indexn_arguments |kinds, details, table| -> table:
                            table <- bam_expression(indexn_argument, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Slice(slice_object, slice_low, slice_high, slice_pos):
                        table <- bam_expression(slice_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(slice_low, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(slice_high, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Array(list_elements, list_pos) | Expr.Tuple(list_elements, list_pos) | Expr.SetLit(list_elements, list_pos):
                        for list_element in list_elements |kinds, details, table| -> table:
                            table <- bam_expression(list_element, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.DictLit(dict_entries, dict_pos):
                        for dict_entry in dict_entries |kinds, details, table| -> table:
                            table <- bam_expression(dict_entry.key, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            table <- bam_expression(dict_entry.value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.StaticEffectCall(effect_type, effect_operation, effect_candidates, effect_arguments, effect_labels, effect_pos):
                        for effect_argument in effect_arguments |kinds, details, table| -> table:
                            table <- bam_expression(effect_argument, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.If(if_condition, if_then, if_else, if_pos):
                        # Either arm of a ternary may run: read each against the state before it,
                        # then keep the union of what they consume.
                        table <- bam_expression(if_condition, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        then_kinds: mutable darray[u32] = []
                        then_details: mutable darray[sview] = []
                        else_kinds: mutable darray[u32] = []
                        else_details: mutable darray[sview] = []
                        then_kinds.extend(kinds)
                        then_details.extend(details)
                        else_kinds.extend(kinds)
                        else_details.extend(details)
                        table <- bam_expression(if_then, owners, borrow_names, borrow_fields, borrow_owners, then_kinds, then_details, table)
                        table <- bam_expression(if_else, owners, borrow_names, borrow_fields, borrow_owners, else_kinds, else_details, table)
                        bam_merge(kinds, details, then_kinds, then_details)
                        bam_merge(kinds, details, else_kinds, else_details)
                    _:
                        pass

        # A left-arrow target is a place being overwritten, so evaluate its receiver and
        # index expressions without treating the old terminal field/element as a value read.
        def bam_expression_place_receiver(receiver: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                receiver_path: (root: sview, field: sview) = bam_expression_field_path(receiver, borrow_fields, table)
                if receiver_path.root != "":
                    _ = bam_report_slot_use(receiver_path.root, receiver_path.field, true, expr_pos(receiver), owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    return
                table <- bam_expression(receiver, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)

        def bam_expression_place_target(target: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(_, _):
                        pass
                    Expr.Field(receiver, _, _):
                        table <- bam_expression_place_receiver(receiver, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Index(receiver, index, _):
                        table <- bam_expression_place_receiver(receiver, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(index, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.IndexN(receiver, indices, _):
                        table <- bam_expression_place_receiver(receiver, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        for index in indices |kinds, details, table| -> table:
                            table <- bam_expression(index, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Paren(inner, _):
                        table <- bam_expression_place_target(inner, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Array(targets, _):
                        for target_item in targets |kinds, details, table| -> table:
                            table <- bam_expression_place_target(target_item, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    _:
                        table <- bam_expression(target, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)

        # Apply the ownership transfer for one `<-` destination. Multi-target assignments call
        # this once per destination after evaluating the RHS, preserving positional provenance.
        def bam_apply_larrow_target(target: Ast::Expr, rebound_owners: darray[sview]&, assignment_effect: u32, owners: darray[sview]&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(target_name, target_pos):
                        if binders_bound_once(binders, target_name):
                            unknown_with_live_borrow: bool = assignment_effect == RBM_ASSIGN_EFFECT_UNKNOWN and bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, target_name, "")
                            writes_through: bool = assignment_effect == RBM_ASSIGN_EFFECT_WRITE_THROUGH or unknown_with_live_borrow
                            if writes_through:
                                _ = bam_report_slot_use(target_name, "", true, target_pos, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                                if unknown_with_live_borrow:
                                    # Inferred reference bindings are opaque to rule-R. Keep a
                                    # may-union until their slot mode is resolved.
                                    for rebound_owner in rebound_owners |borrow_names, borrow_fields, borrow_owners|:
                                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, target_name, "", rebound_owner)
                            else:
                                bam_clear_borrow_fields(target_name, borrow_names, borrow_fields, borrow_owners)
                                for rebound_owner in rebound_owners |borrow_names, borrow_fields, borrow_owners|:
                                    bam_push_borrow(borrow_names, borrow_fields, borrow_owners, target_name, "", rebound_owner)
                    Expr.Paren(inner, _):
                        table <- bam_apply_larrow_target(inner, rebound_owners, assignment_effect, owners, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Array(targets, _):
                        for target_item in targets |borrow_names, borrow_fields, borrow_owners, kinds, details, table| -> table:
                            table <- bam_apply_larrow_target(target_item, rebound_owners, assignment_effect, owners, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    _:
                        target_name, target_field = bam_expression_field_path(target, borrow_fields, table)
                        if target_name != "" and target_field != "":
                            if binders_bound_once(binders, target_name):
                                bam_clear_borrow_path(target_name, target_field, borrow_names, borrow_fields, borrow_owners, table)
                                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, target_name, target_field)
                                for rebound_owner in rebound_owners |borrow_names, borrow_fields, borrow_owners|:
                                    bam_push_borrow(borrow_names, borrow_fields, borrow_owners, target_name, target_field, rebound_owner)
                        else:
                            target_root: sview = bam_place_root(target)
                            if target_root != "":
                                # Preserve sibling provenance when the target's place shape is
                                # not represented by an exact field path.
                                root_owners: mutable darray[sview] = []
                                bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, target_root, "", root_owners)
                                bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, target_root, "*", root_owners)
                                root_key_names: mutable darray[sview] = []
                                root_key_fields: mutable darray[sview] = []
                                bam_collect_borrow_keys(borrow_names, borrow_fields, target_root, root_key_names, root_key_fields)
                                for root_field in root_key_fields |root_key_names, target_root, borrow_names, borrow_fields, borrow_owners, root_owners|:
                                    continue if root_field == "" or root_field == "*"
                                    bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, target_root, root_field, root_owners)
                                for rebound_owner in rebound_owners |root_owners|:
                                    bam_append_unique_owner(root_owners, rebound_owner)
                                bam_drop_borrow(borrow_names, borrow_fields, borrow_owners, target_root)
                                if binders_bound_once(binders, target_root) and root_owners.count > 0:
                                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, target_root, "*")
                                    for root_owner in root_owners |borrow_names, borrow_fields, borrow_owners|:
                                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, target_root, "*", root_owner)

        def bam_larrow_effect_for_target(target: Ast::Expr, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match target:
                    Expr.Ident(_, target_pos):
                        assignment_site: u64 = rbm_assignment_site_key(target_pos)
                        return known_effect if table.ref_assignment_modes.get(assignment_site) is known_effect
                    Expr.Paren(inner, _):
                        return bam_larrow_effect_for_target(inner, table)
                    _:
                        return RBM_ASSIGN_EFFECT_UNKNOWN

        # `r = &o`, `s = r`, `s = h.r`, `h = Holder{r: &o}` and `r = lend(&o)` all borrow `o`.
        # An annotation that is not a reference (`y: K = r`) copies the pointee instead, and
        # check_ref_value_copy reports that. Callers pass this decision directly so an
        # untyped assignment needs no placeholder annotation node.
        def bam_bind(name: sview, holds_reference: bool, value: Ast::Expr, allow_shadowed: bool, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not allow_shadowed and not binders_bound_once(binders, name)
                borrowed_owners: mutable darray[sview] = []
                bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, borrowed_owners, table)
                bam_lend_owners(value, owners, lend_names, lend_positions, lend_parameter_names, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrowed_owners, table) if borrowed_owners.count == 0
                new_names: mutable darray[sview] = []
                new_fields: mutable darray[sview] = []
                new_owners: mutable darray[sview] = []
                bam_bind_value_fields(name, "", value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, new_names, new_fields, new_owners, table)
                old_key_names: mutable darray[sview] = []
                old_key_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, old_key_names, old_key_fields)
                bam_clear_borrow_field_keys(name, old_key_fields, borrow_names, borrow_fields, borrow_owners)
                if borrowed_owners.count > 0:
                    if holds_reference:
                        for borrowed_owner in borrowed_owners |borrow_names, borrow_fields, borrow_owners|:
                            bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, "", borrowed_owner)
                    has_call_summary: mutable bool = false
                    match value:
                        Expr.Call(_, _, _, _):
                            has_call_summary <- true
                        _:
                            pass
                    if not holds_reference or has_call_summary:
                        # Aggregate return summaries identify the lending input but not its
                        # field path. Keep a wildcard slot so a later field read remains
                        # covered; exact literal/update paths continue to use named slots.
                        bam_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, "*")
                        for borrowed_owner in borrowed_owners |borrow_names, borrow_fields, borrow_owners|:
                            bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, "*", borrowed_owner)
                        old_key_index: mutable usize = 0
                        for old_field in old_key_fields |old_key_index, old_key_names, borrow_names, borrow_fields, borrow_owners|:
                            if old_field != "" and old_field != "*":
                                wildcard_owners: mutable darray[sview] = []
                                bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, name, "*", wildcard_owners)
                                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, old_field)
                                for wildcard_owner in wildcard_owners |borrow_names, borrow_fields, borrow_owners|:
                                    bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, old_field, wildcard_owner)
                            old_key_index <- old_key_index + 1
                new_key_names: mutable darray[sview] = []
                new_key_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(new_names, new_fields, name, new_key_names, new_key_fields)
                key_index: mutable usize = 0
                for new_field in new_key_fields |key_index, new_key_names, new_names, new_fields, new_owners, borrow_names, borrow_fields, borrow_owners|:
                    new_field_owners: mutable darray[sview] = []
                    bam_borrow_owners(new_names, new_fields, new_owners, name, new_field, new_field_owners)
                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, new_field)
                    for new_field_owner in new_field_owners |borrow_names, borrow_fields, borrow_owners|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, new_field, new_field_owner)
                    key_index <- key_index + 1

        def bam_scope_unknown_loop_binders(variables: darray[sview], owners: darray[sview]&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for variable in variables |owners, binders, borrow_names, borrow_fields, borrow_owners|:
                    continue if not binders_bound_once(binders, variable)
                    bam_clear_borrow_fields(variable, borrow_names, borrow_fields, borrow_owners)
                    for possible_owner in owners |borrow_names, borrow_fields, borrow_owners, variable|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, variable, "", possible_owner)

        def bam_collect_pattern_bindings(pattern: Ast::Pattern, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name) | Pattern.Rest(name):
                        return if name == "" or name == "_" or (any prior in out where prior == name)
                        out.push(name)
                    Pattern.As(name, inner):
                        if name != "" and name != "_" and not (any prior in out where prior == name):
                            out.push(name)
                        for child in inner |out|:
                            bam_collect_pattern_bindings(child, out)
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children) | Pattern.Or(children):
                        for child in children |out|:
                            bam_collect_pattern_bindings(child, out)
                    _:
                        pass

        # Restore shadowed outer names after an arm, while preserving all other branch facts.
        def bam_restore_pattern_borrow_state(pattern: Ast::Pattern, names: mutable darray[sview]&, fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, base_names: darray[sview]&, base_fields: darray[sview]&, base_owners: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                pattern_names: mutable darray[sview] = []
                bam_collect_rhs_pattern_locals(pattern, pattern_names)
                bam_restore_borrow_name_state(pattern_names, names, fields, borrow_owners, base_names, base_fields, base_owners)

        # Bind arm names to the value selected by their pattern. Literal tuple/constructor
        # projections keep exact provenance; when the source shape is opaque, each introduced
        # name receives the scrutinee's possible owner set so the scoped walk cannot erase a
        # live borrow merely because it cannot recover that projection.
        def bam_clear_pattern_borrow_fields(pattern_names: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if pattern_names.count == 0 or borrow_names.count == 0
                pattern_fields: mutable darray[sview] = []
                pattern_capacity: mutable usize = 16
                while pattern_capacity < (pattern_names.count + 1) * 2 |pattern_capacity, pattern_names|:
                    pattern_capacity <- pattern_capacity * 2
                pattern_slots: mutable darray[usize] = []
                pattern_slots.reserve(pattern_capacity)
                for _ in 0..<pattern_capacity |pattern_slots|:
                    pattern_slots.push(0)
                for pattern_name in pattern_names |pattern_slots, pattern_fields|:
                    pattern_fields.push("")
                    slot, found = bam_borrow_key_probe(pattern_slots, pattern_names, pattern_fields, pattern_name, "")
                    pattern_slots[slot] <- pattern_fields.count if not found
                original_count: usize = borrow_names.count
                key_capacity: mutable usize = 16
                while key_capacity < (original_count + 1) * 2 |key_capacity, borrow_names|:
                    key_capacity <- key_capacity * 2
                seen_names: mutable darray[sview] = []
                seen_fields: mutable darray[sview] = []
                seen_slots: mutable darray[usize] = []
                seen_names.reserve(original_count)
                seen_fields.reserve(original_count)
                seen_slots.reserve(key_capacity)
                for _ in 0..<key_capacity |seen_slots|:
                    seen_slots.push(0)
                row: mutable usize = original_count
                while row > 0 |row, pattern_slots, pattern_names, pattern_fields, seen_names, seen_fields, seen_slots, borrow_names, borrow_fields, borrow_owners|:
                    row <- row - 1
                    continue if row >= borrow_fields.count
                    name: sview = borrow_names[row]
                    _, is_pattern_name = bam_borrow_key_probe(pattern_slots, pattern_names, pattern_fields, name, "")
                    continue if not is_pattern_name
                    field: sview = borrow_fields[row]
                    slot, found = bam_borrow_key_probe(seen_slots, seen_names, seen_fields, name, field)
                    continue if found
                    seen_names.push(name)
                    seen_fields.push(field)
                    seen_slots[slot] <- seen_names.count
                    if row < borrow_owners.count and borrow_owners[row] != "":
                        bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, field)

        def bam_bind_pattern_fallback(pattern: Ast::Pattern, possible_owners: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                pattern_names: mutable darray[sview] = []
                bam_collect_pattern_bindings(pattern, pattern_names)
                bam_clear_pattern_borrow_fields(pattern_names, borrow_names, borrow_fields, borrow_owners)
                for pattern_name in pattern_names |possible_owners, borrow_names, borrow_fields, borrow_owners|:
                    for possible_owner in possible_owners |borrow_names, borrow_fields, borrow_owners, pattern_name|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, pattern_name, "", possible_owner)

        def bam_pattern_source_has_place_root(source: Ast::Expr) -> bool:
            can Abort.Panic:
                match source:
                    Expr.Ident(_, _):
                        return true
                    Expr.Field(object, _, _) | Expr.Paren(object, _) | Expr.Move(object, _):
                        return bam_pattern_source_has_place_root(object)
                    _:
                        return false

        def bam_pattern_field_value(source: Ast::Expr, selector: sview @source) -> (value: Ast::Expr, resolved: bool):
            can Abort.Panic:
                projected: mutable Ast::Expr = Ast::Expr.Field(source, selector, Ast::expr_pos(source))
                match source:
                    Expr.Construct(_, fields, _):
                        found_field: mutable bool = false
                        for field in fields |projected, selector|:
                            if field.name == selector:
                                projected <- field.value
                                found_field <- true
                        return (projected, true) if found_field
                        return (projected, false)
                    Expr.RecordUpdate(base, fields, _):
                        field_index: mutable usize = fields.count
                        found_field: mutable bool = false
                        while field_index > 0 |field_index, fields, projected, selector, found_field|:
                            field_index <- field_index - 1
                            if fields[field_index].name == selector:
                                projected <- fields[field_index].value
                                found_field <- true
                                break
                        return (projected, true) if found_field
                        return bam_pattern_field_value(base, selector)
                    Expr.Ident(_, _):
                        return (projected, true)
                    Expr.Field(_, _, _) | Expr.Paren(_, _) | Expr.Move(_, _):
                        return (projected, bam_pattern_source_has_place_root(source))
                    _:
                        return (projected, false)

        def bam_bind_pattern_borrow_value(pattern: Ast::Pattern, source: Ast::Expr, possible_owners: darray[sview]&, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        table <- bam_bind(name, true, source, true, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                    Pattern.As(name, inner):
                        table <- bam_bind(name, true, source, true, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                        for child in inner |possible_owners, source, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table|:
                            table <- bam_bind_pattern_borrow_value(child, source, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                    Pattern.Rest(name):
                        bam_bind_pattern_fallback(pattern, possible_owners, borrow_names, borrow_fields, borrow_owners)
                    Pattern.Field(selector, inner):
                        projected, resolved = bam_pattern_field_value(source, selector)
                        if resolved:
                            for child in inner |projected, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table|:
                                table <- bam_bind_pattern_borrow_value(child, projected, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                        else:
                            for child in inner |possible_owners, borrow_names, borrow_fields, borrow_owners|:
                                bam_bind_pattern_fallback(child, possible_owners, borrow_names, borrow_fields, borrow_owners)
                    Pattern.Tuple(children):
                        if source is Expr.Tuple(values, _) and values.count == children.count:
                            for index in 0..<children.count |index, children, values, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table|:
                                table <- bam_bind_pattern_borrow_value(children[index], values[index], possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                        else:
                            bam_bind_pattern_fallback(pattern, possible_owners, borrow_names, borrow_fields, borrow_owners)
                    Pattern.Variant(_, children):
                        if source is Expr.Construct(_, fields, _) and fields.count == children.count:
                            all_positional: mutable bool = true
                            for field in fields |all_positional|:
                                all_positional <- false if field.name != ""
                            for index in 0..<children.count |index, children, fields, all_positional, source, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table|:
                                match children[index]:
                                    Pattern.Field(selector, inner):
                                        projected, resolved = bam_pattern_field_value(source, selector)
                                        if resolved:
                                            for child in inner |projected, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table|:
                                                table <- bam_bind_pattern_borrow_value(child, projected, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                                        else:
                                            bam_bind_pattern_fallback(children[index], possible_owners, borrow_names, borrow_fields, borrow_owners)
                                    _:
                                        if all_positional:
                                            table <- bam_bind_pattern_borrow_value(children[index], fields[index].value, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                                        else:
                                            bam_bind_pattern_fallback(children[index], possible_owners, borrow_names, borrow_fields, borrow_owners)
                        else:
                            bam_bind_pattern_fallback(pattern, possible_owners, borrow_names, borrow_fields, borrow_owners)
                    Pattern.Struct(_, children):
                        for child in children |source, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table|:
                            match child:
                                Pattern.Binding(name):
                                    field_source, resolved = bam_pattern_field_value(source, name)
                                    if resolved:
                                        table <- bam_bind_pattern_borrow_value(child, field_source, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                                    else:
                                        bam_bind_pattern_fallback(child, possible_owners, borrow_names, borrow_fields, borrow_owners)
                                _:
                                    table <- bam_bind_pattern_borrow_value(child, source, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                    Pattern.Or(options):
                        base_names: mutable darray[sview] = []
                        base_fields: mutable darray[sview] = []
                        base_owners: mutable darray[sview] = []
                        merged_names: mutable darray[sview] = []
                        merged_fields: mutable darray[sview] = []
                        merged_owners: mutable darray[sview] = []
                        base_names.extend(borrow_names)
                        base_fields.extend(borrow_fields)
                        base_owners.extend(borrow_owners)
                        empty_names: mutable darray[sview] = []
                        empty_fields: mutable darray[sview] = []
                        empty_owners: mutable darray[sview] = []
                        bam_restore_pattern_borrow_state(pattern, base_names, base_fields, base_owners, empty_names, empty_fields, empty_owners)
                        merged_names.extend(base_names)
                        merged_fields.extend(base_fields)
                        merged_owners.extend(base_owners)
                        for option in options |source, possible_owners, base_names, base_fields, base_owners, merged_names, merged_fields, merged_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, table|:
                            option_names: mutable darray[sview] = []
                            option_fields: mutable darray[sview] = []
                            option_owners: mutable darray[sview] = []
                            option_names.extend(base_names)
                            option_fields.extend(base_fields)
                            option_owners.extend(base_owners)
                            table <- bam_bind_pattern_borrow_value(option, source, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, option_names, option_fields, option_owners, table)
                            bam_merge_borrow_state(merged_names, merged_fields, merged_owners, option_names, option_fields, option_owners)
                        bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, merged_names, merged_fields, merged_owners)
                    _:
                        pass

        def bam_seed_pattern_borrow_state(pattern: Ast::Pattern, source: Ast::Expr, possible_owners: darray[sview]&, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- bam_bind_pattern_borrow_value(pattern, source, possible_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)

        def bam_expr_has_scoped_flow(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.If(_, _, _, _) | Expr.Block(_, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.GetElse(_, _, _) | Expr.Comprehension(_, _, _, _, _):
                        return true
                    Expr.Call(callee, arguments, _, _):
                        return true if bam_expr_has_scoped_flow(callee)
                        for argument in arguments:
                            return true if bam_expr_has_scoped_flow(argument)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        for child in Ast::effect_runtime_children(candidates, arguments):
                            return true if bam_expr_has_scoped_flow(child)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.RegionNew(object, _, _):
                        return bam_expr_has_scoped_flow(object)
                    Expr.Index(index_object, index_value, _):
                        return true if bam_expr_has_scoped_flow(index_object)
                        return bam_expr_has_scoped_flow(index_value)
                    Expr.IndexN(index_object, arguments, _):
                        return true if bam_expr_has_scoped_flow(index_object)
                        for argument in arguments:
                            return true if bam_expr_has_scoped_flow(argument)
                    Expr.Binary(left, operator, right, _):
                        return true if bam_expr_has_scoped_flow(left)
                        return false if operator == TokenKind.Is or operator == TokenKind.As
                        return bam_expr_has_scoped_flow(right)
                    Expr.Refinement(base, predicate, _):
                        return true if bam_expr_has_scoped_flow(base)
                        return bam_expr_has_scoped_flow(predicate)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements:
                            return true if bam_expr_has_scoped_flow(element)
                    Expr.Construct(_, fields, _):
                        for field in fields:
                            return true if bam_expr_has_scoped_flow(field.value)
                    Expr.RecordUpdate(base, fields, _):
                        return true if bam_expr_has_scoped_flow(base)
                        for field in fields:
                            return true if bam_expr_has_scoped_flow(field.value)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return bam_expr_has_scoped_flow(inner)
                    Expr.DictLit(entries, _):
                        for entry in entries:
                            return true if bam_expr_has_scoped_flow(entry.key) or bam_expr_has_scoped_flow(entry.value)
                    Expr.Slice(slice_object, low, high, _):
                        return true if:
                            bam_expr_has_scoped_flow(slice_object)
                            low is not Expr.Absent and bam_expr_has_scoped_flow(low)
                        return high is not Expr.Absent and bam_expr_has_scoped_flow(high)
                    _:
                        pass
                return false

        # The ordinary binder handles precise literal field paths. For a value with scoped
        # control flow, use only the reachable owner set produced by the flow-aware walker.
        def bam_replay_bind(name: sview, holds_reference: bool, value: Ast::Expr, allow_shadowed: bool, value_owners: darray[sview]&, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not allow_shadowed and not binders_bound_once(binders, name)
                if not bam_expr_has_scoped_flow(value):
                    table <- bam_bind(name, holds_reference, value, allow_shadowed, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                    return
                old_names: mutable darray[sview] = []
                old_fields: mutable darray[sview] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, old_names, old_fields)
                bam_clear_borrow_fields(name, borrow_names, borrow_fields, borrow_owners)
                if holds_reference:
                    for owner in value_owners |borrow_names, borrow_fields, borrow_owners, name|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, "", owner)
                if not holds_reference and value_owners.count > 0:
                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, "*")
                    for owner in value_owners |borrow_names, borrow_fields, borrow_owners, name|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, "*", owner)
                    for old_field in old_fields |value_owners, borrow_names, borrow_fields, borrow_owners, name|:
                        continue if old_field == "" or old_field == "*"
                        bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, old_field)
                        for owner in value_owners |borrow_names, borrow_fields, borrow_owners, name, old_field|:
                            bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, old_field, owner)

        def bam_replay_exit_matches(exit_label: sview, loop_label: sview) -> bool:
            can Abort.Panic:
                return exit_label == "" or (loop_label != "" and exit_label == loop_label)

        # Parentheses and `move` preserve an iterable's literal cardinality and elements.
        # Keep this unwrapping local to replay classification; callers still replay the
        # original expression so its evaluation effects and exits are retained.
        def bam_unwrap_replay_literal_iterable(value: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return bam_unwrap_replay_literal_iterable(inner)
                    _:
                        return value

        # Join zero-or-more loop iterations to a fixed point. The while condition's normal
        # state is the false-condition exit and the body entry; normal completion and matching
        # continues feed the backedge. Matching breaks join the post-loop state.
        def bam_scope_loop_statements(body: darray[Ast::Stmt], variables: darray[sview], iterable: Ast::Expr, is_for: bool, loop_label: sview, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                definitely_empty_for: mutable bool = false
                literal_iterable_value: Ast::Expr = bam_unwrap_replay_literal_iterable(iterable)
                if is_for:
                    definitely_empty_for <- match literal_iterable_value:
                        Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _): elements.count == 0
                        _: false
                if definitely_empty_for:
                    bam_replay_flow_reset(flow)
                    bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                    return
                head_names: mutable darray[sview] = []
                head_fields: mutable darray[sview] = []
                head_owners: mutable darray[sview] = []
                head_names.extend(borrow_names)
                head_fields.extend(borrow_fields)
                head_owners.extend(borrow_owners)
                condition_has_scoped_flow: mutable bool = false
                if not is_for:
                    condition_has_scoped_flow <- bam_expr_has_scoped_flow(iterable)
                last_body_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                last_condition_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                loop_grew: mutable bool = true
                while loop_grew |loop_grew, head_names, head_fields, head_owners, last_body_flow, last_condition_flow, body, variables, iterable, literal_iterable_value, is_for, loop_label, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, table|:
                    condition_names: mutable darray[sview] = []
                    condition_fields: mutable darray[sview] = []
                    condition_owners: mutable darray[sview] = []
                    condition_names.extend(head_names)
                    condition_fields.extend(head_fields)
                    condition_owners.extend(head_owners)
                    condition_value_owners: mutable darray[sview] = []
                    condition_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                    if is_for:
                        bam_replay_flow_set_reachable(condition_flow)
                    elif condition_has_scoped_flow:
                        table <- bam_nested_value_owners_scoped(iterable, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, condition_names, condition_fields, condition_owners, condition_value_owners, condition_flow, table)
                    else:
                        table <- bam_nested_value_owners(iterable, owners, condition_names, condition_fields, condition_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, condition_value_owners, table)
                        bam_replay_flow_set_reachable(condition_flow)
                    next_names: mutable darray[sview] = []
                    next_fields: mutable darray[sview] = []
                    next_owners: mutable darray[sview] = []
                    next_names.extend(head_names)
                    next_fields.extend(head_fields)
                    next_owners.extend(head_owners)
                    body_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                    if condition_flow.normal_seen:
                        body_names: mutable darray[sview] = []
                        body_fields: mutable darray[sview] = []
                        body_owners: mutable darray[sview] = []
                        body_names.extend(condition_names)
                        body_fields.extend(condition_fields)
                        body_owners.extend(condition_owners)
                        if is_for:
                            literal_iterable: mutable bool = false
                            match literal_iterable_value:
                                Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _):
                                    literal_iterable <- true
                                _:
                                    pass
                            if literal_iterable and variables.count == 1:
                                bam_bind_loop_literal(variables[0], literal_iterable_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, body_names, body_fields, body_owners, table)
                            else:
                                bam_scope_unknown_loop_binders(variables, owners, binders, body_names, body_fields, body_owners)
                        table <- bam_scope_borrow_statements(body, body.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, body_names, body_fields, body_owners, body_flow, table)
                        bam_replay_flow_filter_normal_scope(body_flow, body, variables, binders, head_names, head_fields, head_owners)
                        bam_replay_flow_filter_exits_scope(body_flow, [], variables, binders, head_names, head_fields, head_owners)
                        bam_filter_rhs_scope_borrow_state(body, variables, binders, body_names, body_fields, body_owners, head_names, head_fields, head_owners) if body_flow.normal_seen
                        if body_flow.normal_seen:
                            bam_merge_borrow_state(next_names, next_fields, next_owners, body_names, body_fields, body_owners)
                        for exit in body_flow.continues |next_names, next_fields, next_owners, loop_label|:
                            if bam_replay_exit_matches(exit.label, loop_label):
                                continue_names: mutable darray[sview] = []
                                continue_fields: mutable darray[sview] = []
                                continue_owners: mutable darray[sview] = []
                                bam_replay_materialize_snapshot(exit.state, continue_names, continue_fields, continue_owners)
                                bam_merge_borrow_state(next_names, next_fields, next_owners, continue_names, continue_fields, continue_owners)
                    loop_grew <- not bam_borrow_state_equal(head_names, head_fields, head_owners, next_names, next_fields, next_owners)
                    last_body_flow <- body_flow
                    if not is_for and condition_flow.normal_seen and not condition_has_scoped_flow:
                        condition_flow.normal <- bam_borrow_state_snapshot(condition_names, condition_fields, condition_owners)
                    last_condition_flow <- condition_flow
                    if loop_grew:
                        head_names.truncate(0)
                        head_fields.truncate(0)
                        head_owners.truncate(0)
                        head_names.extend(next_names)
                        head_fields.extend(next_fields)
                        head_owners.extend(next_owners)
                bam_replay_flow_reset(flow)
                if last_condition_flow.return_seen:
                    bam_replay_flow_add_return(flow, last_condition_flow.returned)
                if last_body_flow.return_seen:
                    bam_replay_flow_add_return(flow, last_body_flow.returned)
                post_names: mutable darray[sview] = []
                post_fields: mutable darray[sview] = []
                post_owners: mutable darray[sview] = []
                post_seen: mutable bool = false
                if is_for:
                    post_names.extend(head_names)
                    post_fields.extend(head_fields)
                    post_owners.extend(head_owners)
                    post_seen <- true
                elif last_condition_flow.normal_seen:
                    bam_replay_materialize_snapshot(last_condition_flow.normal, post_names, post_fields, post_owners)
                    post_seen <- true
                # A loop header is checked in the enclosing label scope. A break or
                # continue reached while evaluating the condition therefore targets an
                # enclosing loop (or is invalid), never this loop.
                for exit in last_condition_flow.breaks |flow|:
                    bam_replay_flow_add_break(flow, exit.label, exit.state)
                for exit in last_condition_flow.continues |flow|:
                    bam_replay_flow_add_continue(flow, exit.label, exit.state)
                for exit in last_body_flow.breaks |flow, loop_label, head_names, head_fields, head_owners|:
                    if bam_replay_exit_matches(exit.label, loop_label):
                        break_names: mutable darray[sview] = []
                        break_fields: mutable darray[sview] = []
                        break_owners: mutable darray[sview] = []
                        bam_replay_materialize_snapshot(exit.state, break_names, break_fields, break_owners)
                        if post_seen:
                            bam_merge_borrow_state(post_names, post_fields, post_owners, break_names, break_fields, break_owners)
                        else:
                            post_names.extend(break_names)
                            post_fields.extend(break_fields)
                            post_owners.extend(break_owners)
                            post_seen <- true
                    else:
                        bam_replay_flow_add_break(flow, exit.label, exit.state)
                for exit in last_body_flow.continues |flow, loop_label|:
                    bam_replay_flow_add_continue(flow, exit.label, exit.state) if not bam_replay_exit_matches(exit.label, loop_label)
                if post_seen:
                    bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, post_names, post_fields, post_owners)
                    bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)

        # Replay borrow bindings in order and retain each terminating outcome. A branch joins
        # the statement tail only if that branch has a reachable normal snapshot.
        def bam_scope_borrow_statements_context(statements: darray[Ast::Stmt], count: usize, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, scope_base_names: darray[sview]&, scope_base_fields: darray[sview]&, scope_base_owners: darray[sview]&, active_locals: mutable darray[sview]&, flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_replay_flow_reset(flow)
                statement_index: mutable usize = 0
                reachable: mutable bool = true
                while statement_index < count and statement_index < statements.count and reachable |statement_index, reachable, flow, borrow_names, borrow_fields, borrow_owners, active_locals, table| -> table:
                    match statements[statement_index]:
                        Stmt.VarDecl(name, annotation, value, _):
                            value_owners: mutable darray[sview] = []
                            value_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, value_owners, value_flow, table)
                            bam_replay_flow_filter_exits_scope(value_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, value_flow)
                            if value_flow.normal_seen:
                                table <- bam_replay_bind(name, rvc_is_absent(annotation) or affine_annotation_is_ref(annotation), value, false, value_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                                bam_append_scope_local(active_locals, name)
                            else:
                                reachable <- false
                        Stmt.Assign(target, operator, value, _):
                            target_place: Ast::Expr = bam_strip_paren(target)
                            target_name: sview = ident_name_of(target_place)
                            target_owners: mutable darray[sview] = []
                            target_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(target_place, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, target_owners, target_flow, table)
                            bam_replay_flow_filter_exits_scope(target_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, target_flow)
                            value_owners: mutable darray[sview] = []
                            value_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            staged_entries: mutable darray[BorrowLarrowEntry] = []
                            if target_flow.normal_seen:
                                if operator == TokenKind.LArrow:
                                    table <- bam_stage_larrow_pair(target_place, value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, staged_entries, value_flow, table)
                                    for entry in staged_entries |value_owners|:
                                        for owner in entry.owners |value_owners|:
                                            bam_append_unique_owner(value_owners, owner)
                                else:
                                    table <- bam_nested_value_owners_scoped(value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, value_owners, value_flow, table)
                            bam_replay_flow_filter_exits_scope(value_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, value_flow)
                            if value_flow.normal_seen:
                                if operator == TokenKind.LArrow and target_name != "" and binders_bound_once(binders, target_name):
                                    rebound_owners: mutable darray[sview] = []
                                    rebound_owners.extend(value_owners)
                                    bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, rebound_owners, table) if rebound_owners.count == 0
                                    bam_lend_owners(value, owners, lend_names, lend_positions, lend_parameter_names, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, rebound_owners, table) if rebound_owners.count == 0
                                    effect: u32 = bam_larrow_effect_for_target(target, table)
                                    preserve_existing: bool = effect == RBM_ASSIGN_EFFECT_WRITE_THROUGH or (effect == RBM_ASSIGN_EFFECT_UNKNOWN and bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, target_name, ""))
                                    if effect == RBM_ASSIGN_EFFECT_WRITE_THROUGH:
                                        bam_clear_borrow_nested_fields(target_name, borrow_names, borrow_fields, borrow_owners)
                                        for entry in staged_entries |target_name, borrow_names, borrow_fields, borrow_owners, table|:
                                            for field_index in 0..<entry.field_fields.count |entry, target_name, borrow_names, borrow_fields, borrow_owners, field_index|:
                                                field_name: mutable sview = entry.field_names[field_index] if field_index < entry.field_names.count else ""
                                                field_name <- target_name if field_name == ""
                                                field_owner: sview = entry.field_owners[field_index] if field_index < entry.field_owners.count else ""
                                                if field_owner == "":
                                                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, field_name, entry.field_fields[field_index])
                                                else:
                                                    bam_push_borrow(borrow_names, borrow_fields, borrow_owners, field_name, entry.field_fields[field_index], field_owner)
                                    else:
                                        bam_clear_borrow_fields(target_name, borrow_names, borrow_fields, borrow_owners) if not preserve_existing
                                        for rebound_owner in rebound_owners |borrow_names, borrow_fields, borrow_owners, target_name|:
                                            bam_push_borrow(borrow_names, borrow_fields, borrow_owners, target_name, "", rebound_owner)
                                elif operator == TokenKind.Assign and target_name != "":
                                    table <- bam_replay_bind(target_name, true, value, false, value_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                                    bam_append_scope_local(active_locals, target_name)
                            else:
                                reachable <- false
                        Stmt.If(condition, then_body, else_body, _):
                            condition_owners: mutable darray[sview] = []
                            condition_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(condition, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, condition_owners, condition_flow, table)
                            bam_replay_flow_filter_exits_scope(condition_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, condition_flow)
                            if condition_flow.normal_seen:
                                branch_base_names: mutable darray[sview] = []
                                branch_base_fields: mutable darray[sview] = []
                                branch_base_owners: mutable darray[sview] = []
                                then_names: mutable darray[sview] = []
                                then_fields: mutable darray[sview] = []
                                then_owners: mutable darray[sview] = []
                                else_names: mutable darray[sview] = []
                                else_fields: mutable darray[sview] = []
                                else_owners: mutable darray[sview] = []
                                then_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                else_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                branch_base_names.extend(borrow_names)
                                branch_base_fields.extend(borrow_fields)
                                branch_base_owners.extend(borrow_owners)
                                then_names.extend(branch_base_names)
                                then_fields.extend(branch_base_fields)
                                then_owners.extend(branch_base_owners)
                                else_names.extend(branch_base_names)
                                else_fields.extend(branch_base_fields)
                                else_owners.extend(branch_base_owners)
                                table <- bam_scope_borrow_statements(then_body, then_body.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, then_names, then_fields, then_owners, then_flow, table)
                                table <- bam_scope_borrow_statements(else_body, else_body.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, else_names, else_fields, else_owners, else_flow, table)
                                bam_replay_flow_filter_normal_scope(then_flow, then_body, [], binders, branch_base_names, branch_base_fields, branch_base_owners)
                                bam_replay_flow_filter_normal_scope(else_flow, else_body, [], binders, branch_base_names, branch_base_fields, branch_base_owners)
                                bam_filter_rhs_scope_borrow_state(then_body, [], binders, then_names, then_fields, then_owners, branch_base_names, branch_base_fields, branch_base_owners) if then_flow.normal_seen
                                bam_filter_rhs_scope_borrow_state(else_body, [], binders, else_names, else_fields, else_owners, branch_base_names, branch_base_fields, branch_base_owners) if else_flow.normal_seen
                                bam_replay_flow_filter_exits_scope(then_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_filter_exits_scope(else_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_merge_exits(flow, then_flow)
                                bam_replay_flow_merge_exits(flow, else_flow)
                                if then_flow.normal_seen and else_flow.normal_seen:
                                    bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_names, then_fields, then_owners)
                                    bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, else_names, else_fields, else_owners)
                                elif then_flow.normal_seen:
                                    bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_names, then_fields, then_owners)
                                elif else_flow.normal_seen:
                                    bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, else_names, else_fields, else_owners)
                                else:
                                    reachable <- false
                            else:
                                reachable <- false
                        Stmt.While(condition, body, _):
                            loop_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_scope_loop_statements(body, [], condition, false, "", owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, loop_flow, table)
                            bam_replay_flow_filter_exits_scope(loop_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, loop_flow)
                            reachable <- loop_flow.normal_seen
                        Stmt.For(_, variables, iterable, body, _):
                            iterable_owners: mutable darray[sview] = []
                            iterable_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(iterable, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, iterable_owners, iterable_flow, table)
                            bam_replay_flow_filter_exits_scope(iterable_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, iterable_flow)
                            if iterable_flow.normal_seen:
                                loop_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                table <- bam_scope_loop_statements(body, variables, iterable, true, "", owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, loop_flow, table)
                                bam_replay_flow_filter_exits_scope(loop_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_merge_exits(flow, loop_flow)
                                reachable <- loop_flow.normal_seen
                            else:
                                reachable <- false
                        Stmt.Match(scrutinee, arms, _):
                            pattern_owners: mutable darray[sview] = []
                            scrutinee_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(scrutinee, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, pattern_owners, scrutinee_flow, table)
                            bam_replay_flow_filter_exits_scope(scrutinee_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, scrutinee_flow)
                            if scrutinee_flow.normal_seen:
                                residual_names: mutable darray[sview] = []
                                residual_fields: mutable darray[sview] = []
                                residual_owners: mutable darray[sview] = []
                                merged_names: mutable darray[sview] = []
                                merged_fields: mutable darray[sview] = []
                                merged_owners: mutable darray[sview] = []
                                residual_possible: mutable bool = true
                                has_normal: mutable bool = false
                                residual_names.extend(borrow_names)
                                residual_fields.extend(borrow_fields)
                                residual_owners.extend(borrow_owners)
                                for arm in arms |residual_names, residual_fields, residual_owners, merged_names, merged_fields, merged_owners, has_normal, residual_possible, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, flow, table|:
                                    break if not residual_possible
                                    arm_names: mutable darray[sview] = []
                                    arm_fields: mutable darray[sview] = []
                                    arm_owners: mutable darray[sview] = []
                                    arm_base_names: mutable darray[sview] = []
                                    arm_base_fields: mutable darray[sview] = []
                                    arm_base_owners: mutable darray[sview] = []
                                    arm_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                    arm_names.extend(residual_names)
                                    arm_fields.extend(residual_fields)
                                    arm_owners.extend(residual_owners)
                                    arm_base_names.extend(residual_names)
                                    arm_base_fields.extend(residual_fields)
                                    arm_base_owners.extend(residual_owners)
                                    table <- bam_seed_pattern_borrow_state(arm.pattern, scrutinee, pattern_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, table)
                                    has_guard: bool = match arm.guard:
                                        Expr.Invalid | Expr.Absent: false
                                        _: true
                                    pattern_catches_all: bool = bam_match_pattern_catches_all(arm.pattern, table)
                                    guard_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                    arm_locals: mutable darray[sview] = []
                                    bam_collect_rhs_pattern_locals(arm.pattern, arm_locals)
                                    if has_guard:
                                        guard_owners: mutable darray[sview] = []
                                        table <- bam_nested_value_owners_scoped(arm.guard, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, guard_owners, guard_flow, table)
                                        bam_replay_flow_filter_scope(guard_flow, [], arm_locals, binders, arm_base_names, arm_base_fields, arm_base_owners)
                                        bam_replay_flow_restore_pattern(guard_flow, arm.pattern, arm_base_names, arm_base_fields, arm_base_owners)
                                        bam_replay_flow_merge_exits(arm_flow, guard_flow)
                                    failed_names: mutable darray[sview] = []
                                    failed_fields: mutable darray[sview] = []
                                    failed_owners: mutable darray[sview] = []
                                    if has_guard and guard_flow.normal_seen:
                                        failed_names.extend(arm_names)
                                        failed_fields.extend(arm_fields)
                                        failed_owners.extend(arm_owners)
                                        failed_locals: mutable darray[sview] = []
                                        bam_collect_rhs_pattern_locals(arm.pattern, failed_locals)
                                        bam_filter_rhs_scope_borrow_state([], failed_locals, binders, failed_names, failed_fields, failed_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                    body_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                    if not has_guard or guard_flow.normal_seen:
                                        table <- bam_scope_borrow_statements(arm.body, arm.body.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, body_flow, table)
                                        bam_replay_flow_filter_normal_scope(body_flow, arm.body, arm_locals, binders, arm_base_names, arm_base_fields, arm_base_owners)
                                        bam_replay_flow_filter_exits_scope(body_flow, [], arm_locals, binders, arm_base_names, arm_base_fields, arm_base_owners)
                                        bam_replay_flow_restore_pattern(body_flow, arm.pattern, arm_base_names, arm_base_fields, arm_base_owners)
                                        bam_replay_flow_merge_exits(arm_flow, body_flow)
                                        arm_flow.normal <- body_flow.normal
                                        arm_flow.normal_seen <- body_flow.normal_seen
                                    if arm_flow.normal_seen:
                                        bam_replay_materialize_snapshot(arm_flow.normal, arm_names, arm_fields, arm_owners)
                                        if not has_normal:
                                            bam_replace_borrow_state(merged_names, merged_fields, merged_owners, arm_names, arm_fields, arm_owners)
                                            has_normal <- true
                                        else:
                                            bam_merge_borrow_state(merged_names, merged_fields, merged_owners, arm_names, arm_fields, arm_owners)
                                    bam_replay_flow_filter_exits_scope(arm_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                    bam_replay_flow_merge_exits(flow, arm_flow)
                                    if has_guard and guard_flow.normal_seen:
                                        if pattern_catches_all:
                                            residual_names.truncate(0)
                                            residual_fields.truncate(0)
                                            residual_owners.truncate(0)
                                            residual_names.extend(failed_names)
                                            residual_fields.extend(failed_fields)
                                            residual_owners.extend(failed_owners)
                                        else:
                                            bam_merge_borrow_state(residual_names, residual_fields, residual_owners, failed_names, failed_fields, failed_owners)
                                    elif has_guard and pattern_catches_all:
                                        residual_possible <- false
                                    elif not has_guard and pattern_catches_all:
                                        residual_possible <- false
                                residual_possible <- false if match_arms_exhaustive(arms, table)
                                if has_normal:
                                    bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, merged_names, merged_fields, merged_owners)
                                    bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_names, residual_fields, residual_owners) if residual_possible
                                    bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                                elif residual_possible:
                                    bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_names, residual_fields, residual_owners)
                                    bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                                else:
                                    reachable <- false
                            else:
                                reachable <- false
                        Stmt.Block(block_kind, clause, block_binding, body, _):
                            labelled_loop: mutable bool = false
                            if block_kind == "label" and clause.count == 1 and body.count == 1:
                                match body[0]:
                                    Stmt.While(_, _, _) | Stmt.For(_, _, _, _, _):
                                        labelled_loop <- true
                                    _:
                                        pass
                            if labelled_loop:
                                loop_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                match body[0]:
                                    Stmt.While(condition, loop_body, _):
                                        table <- bam_scope_loop_statements(loop_body, [], condition, false, clause[0], owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, loop_flow, table)
                                    Stmt.For(_, variables, iterable, loop_body, _):
                                        iterable_owners: mutable darray[sview] = []
                                        iterable_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                        table <- bam_nested_value_owners_scoped(iterable, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, iterable_owners, iterable_flow, table)
                                        if iterable_flow.normal_seen:
                                            table <- bam_scope_loop_statements(loop_body, variables, iterable, true, clause[0], owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, loop_flow, table)
                                            bam_replay_flow_merge_exits(loop_flow, iterable_flow)
                                        else:
                                            bam_replay_flow_merge_exits(loop_flow, iterable_flow)
                                bam_replay_flow_filter_exits_scope(loop_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_merge_exits(flow, loop_flow)
                                if loop_flow.normal_seen:
                                    bam_replay_materialize_snapshot(loop_flow.normal, borrow_names, borrow_fields, borrow_owners)
                                    reachable <- true
                                else:
                                    reachable <- false
                            else:
                                nested_names: mutable darray[sview] = []
                                nested_fields: mutable darray[sview] = []
                                nested_owners: mutable darray[sview] = []
                                base_names: mutable darray[sview] = []
                                base_fields: mutable darray[sview] = []
                                base_owners: mutable darray[sview] = []
                                nested_names.extend(borrow_names)
                                nested_fields.extend(borrow_fields)
                                nested_owners.extend(borrow_owners)
                                base_names.extend(borrow_names)
                                base_fields.extend(borrow_fields)
                                base_owners.extend(borrow_owners)
                                block_locals: mutable darray[sview] = []
                                block_locals.push(block_binding) if block_binding != ""
                                block_scoped: bool = body.count > 0 and SemanticBlockKindScope::block_kind_is_scope(block_kind)
                                bam_clear_borrow_fields(block_binding, nested_names, nested_fields, nested_owners) if block_scoped and block_binding != ""
                                block_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                if block_scoped:
                                    table <- bam_scope_borrow_statements(body, body.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, nested_names, nested_fields, nested_owners, block_flow, table)
                                    bam_replay_flow_filter_exits_scope(block_flow, [], block_locals, binders, base_names, base_fields, base_owners)
                                else:
                                    bam_append_scope_local(active_locals, block_binding)
                                    table <- bam_scope_borrow_statements_context(body, body.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, nested_names, nested_fields, nested_owners, scope_base_names, scope_base_fields, scope_base_owners, active_locals, block_flow, table)
                                if block_scoped:
                                    bam_replay_flow_filter_normal_scope(block_flow, body, block_locals, binders, base_names, base_fields, base_owners)
                                    bam_filter_rhs_scope_borrow_state(body, block_locals, binders, nested_names, nested_fields, nested_owners, base_names, base_fields, base_owners) if block_flow.normal_seen
                                    bam_replay_flow_filter_exits_scope(block_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_merge_exits(flow, block_flow)
                                if block_flow.normal_seen:
                                    bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, nested_names, nested_fields, nested_owners)
                                else:
                                    reachable <- false
                        Stmt.Expr(expression, _):
                            expression_owners: mutable darray[sview] = []
                            expression_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(expression, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, expression_owners, expression_flow, table)
                            bam_replay_flow_filter_exits_scope(expression_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, expression_flow)
                            reachable <- expression_flow.normal_seen
                        Stmt.Contract(_, expression, _):
                            contract_owners: mutable darray[sview] = []
                            contract_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(expression, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, contract_owners, contract_flow, table)
                            bam_replay_flow_filter_exits_scope(contract_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_merge_exits(flow, contract_flow)
                            reachable <- contract_flow.normal_seen
                        Stmt.Return(returned_option, _):
                            if returned_option is returned_value:
                                returned_owners: mutable darray[sview] = []
                                return_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                table <- bam_nested_value_owners_scoped(returned_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, returned_owners, return_flow, table)
                                bam_replay_flow_filter_exits_scope(return_flow, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_merge_exits(flow, return_flow)
                                return_snapshot: BorrowStateSnapshot = bam_replay_snapshot_filter(bam_borrow_state_snapshot(borrow_names, borrow_fields, borrow_owners), [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_add_return(flow, return_snapshot) if return_flow.normal_seen
                            else:
                                return_snapshot: BorrowStateSnapshot = bam_replay_snapshot_filter(bam_borrow_state_snapshot(borrow_names, borrow_fields, borrow_owners), [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                                bam_replay_flow_add_return(flow, return_snapshot)
                            reachable <- false
                        Stmt.Break(label, _):
                            break_snapshot: BorrowStateSnapshot = bam_replay_snapshot_filter(bam_borrow_state_snapshot(borrow_names, borrow_fields, borrow_owners), [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_add_break(flow, label, break_snapshot)
                            reachable <- false
                        Stmt.Continue(label, _):
                            continue_snapshot: BorrowStateSnapshot = bam_replay_snapshot_filter(bam_borrow_state_snapshot(borrow_names, borrow_fields, borrow_owners), [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                            bam_replay_flow_add_continue(flow, label, continue_snapshot)
                            reachable <- false
                        _:
                            pass
                    statement_index <- statement_index + 1
                if reachable:
                    bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)

        # Start a fresh lexical list. Inline constructs such as `static` use the context
        # variant directly so declarations reached inside them stay active in their parent.
        def bam_scope_borrow_statements(statements: darray[Ast::Stmt], count: usize, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                scope_base_names: mutable darray[sview] = []
                scope_base_fields: mutable darray[sview] = []
                scope_base_owners: mutable darray[sview] = []
                active_locals: mutable darray[sview] = []
                scope_base_names.extend(borrow_names)
                scope_base_fields.extend(borrow_fields)
                scope_base_owners.extend(borrow_owners)
                table <- bam_scope_borrow_statements_context(statements, count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, scope_base_names, scope_base_fields, scope_base_owners, active_locals, flow, table)
                if flow.normal_seen:
                    flow.normal <- bam_replay_snapshot_filter(flow.normal, [], active_locals, binders, scope_base_names, scope_base_fields, scope_base_owners)
                    bam_replay_materialize_snapshot(flow.normal, borrow_names, borrow_fields, borrow_owners)

        # Replay a block-like arm and expose only a reachable trailing expression as a
        # value. A trailing return evaluates its operand but records a return exit, never a
        # yield. Prefix statements are sequenced through their normal state only.
        def bam_replay_scoped_body_value(statements: darray[Ast::Stmt], owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, out: mutable darray[sview]&, flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                base_names: mutable darray[sview] = []
                base_fields: mutable darray[sview] = []
                base_owners: mutable darray[sview] = []
                base_names.extend(borrow_names)
                base_fields.extend(borrow_fields)
                base_owners.extend(borrow_owners)
                tail_count: mutable usize = statements.count
                tail_value: mutable Ast::Expr = Ast::Expr.Invalid
                tail_return: mutable bool = false
                if statements.count > 0:
                    match statements[statements.count - 1]:
                        Stmt.Expr(value, _):
                            tail_count <- tail_count - 1
                            tail_value <- value
                        Stmt.Return(returned_option, _):
                            tail_count <- tail_count - 1
                            tail_return <- true
                            tail_value <- returned_expression if returned_option is returned_expression
                        _:
                            pass
                prefix: mutable darray[Ast::Stmt] = []
                for row in 0..<tail_count |row, statements, prefix|:
                    prefix.push(statements[row])
                prefix_locals: mutable darray[sview] = []
                bam_collect_rhs_scope_stmt_locals(prefix, binders, prefix_locals)
                prefix_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                table <- bam_scope_borrow_statements(prefix, prefix.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, prefix_flow, table)
                bam_replay_flow_reset(flow)
                bam_replay_flow_merge_exits(flow, prefix_flow)
                if prefix_flow.normal_seen:
                    if tail_return:
                        return_owners: mutable darray[sview] = []
                        return_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(tail_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, return_owners, return_flow, table) if tail_value is not Expr.Invalid
                        bam_replay_flow_filter_exits_scope(return_flow, [], prefix_locals, binders, base_names, base_fields, base_owners)
                        bam_replay_flow_merge_exits(flow, return_flow)
                        return_snapshot: BorrowStateSnapshot = bam_replay_snapshot_filter(bam_borrow_state_snapshot(borrow_names, borrow_fields, borrow_owners), [], prefix_locals, binders, base_names, base_fields, base_owners) if prefix_locals.count > 0 else bam_borrow_state_snapshot(borrow_names, borrow_fields, borrow_owners)
                        bam_replay_flow_add_return(flow, return_snapshot) if return_flow.normal_seen or tail_value is Expr.Invalid
                    elif tail_value is not Expr.Invalid:
                        tail_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(tail_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, out, tail_flow, table)
                        bam_replay_flow_filter_exits_scope(tail_flow, [], prefix_locals, binders, base_names, base_fields, base_owners)
                        bam_replay_flow_merge_exits(flow, tail_flow)
                        if tail_flow.normal_seen:
                            bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                    else:
                        bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                if flow.normal_seen:
                    bam_filter_rhs_scope_borrow_state(statements, [], binders, borrow_names, borrow_fields, borrow_owners, base_names, base_fields, base_owners)
                bam_replay_flow_filter_normal_scope(flow, statements, [], binders, base_names, base_fields, base_owners)
                bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners) if flow.normal_seen

        # Resolve owners under scoped aliases while retaining each control-flow outcome.
        # Only the normal result of an expression contributes owners to its enclosing value.
        def bam_nested_value_owners_scoped(value: Ast::Expr, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, out: mutable darray[sview]&, flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_replay_flow_reset(flow)
                out_mark: usize = out.count
                reachable: mutable bool = true
                if not bam_expr_has_scoped_flow(value):
                    table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    bam_replay_flow_set_reachable(flow)
                    return
                match value:
                    Expr.Block(statements, block_value, _, _):
                        base_names: mutable darray[sview] = []
                        base_fields: mutable darray[sview] = []
                        base_owners: mutable darray[sview] = []
                        scoped_names: mutable darray[sview] = []
                        scoped_fields: mutable darray[sview] = []
                        scoped_owners: mutable darray[sview] = []
                        base_names.extend(borrow_names)
                        base_fields.extend(borrow_fields)
                        base_owners.extend(borrow_owners)
                        scoped_names.extend(borrow_names)
                        scoped_fields.extend(borrow_fields)
                        scoped_owners.extend(borrow_owners)
                        block_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_scope_borrow_statements(statements, statements.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, block_flow, table)
                        block_locals: mutable darray[sview] = []
                        bam_collect_rhs_scope_stmt_locals(statements, binders, block_locals)
                        bam_replay_flow_merge_exits(flow, block_flow)
                        if block_flow.normal_seen:
                            value_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(block_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, out, value_flow, table)
                            bam_replay_flow_filter_exits_scope(value_flow, [], block_locals, binders, base_names, base_fields, base_owners)
                            bam_replay_flow_merge_exits(flow, value_flow)
                            reachable <- value_flow.normal_seen
                        else:
                            reachable <- false
                        bam_replay_flow_filter_normal_scope(flow, statements, [], binders, base_names, base_fields, base_owners)
                        if reachable:
                            bam_filter_rhs_scope_borrow_state(statements, [], binders, scoped_names, scoped_fields, scoped_owners, base_names, base_fields, base_owners)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, scoped_names, scoped_fields, scoped_owners)
                        else:
                            reachable <- false
