# A borrow used after its owner moved. `r = &o` (a `T&` local, a copy of another borrow, a
# borrow read out of a struct literal field, or the result of a call that can hand back one of
# its summarized reference arguments) borrows `o` — a local or parameter whose type is a BORROWABLE
# owner (struct_is_borrowable_owner: stage0's isBorrowableAffineOwnerType). Once `o` is moved
# — `f(move o)`, `p = move o`, `y <- move o`, `Box{k: move o}` — every later use of the borrow
# dangles, and stage0 reports each one: `linear value "r" cannot be used: usage facts were
# consumed by argument to call "finish"`. `o <- value` re-initialises the owner and revives its
# borrows. The same walk reports `return &local`, which dangles for the opposite reason: the
# frame it points into dies at the return.
#
# Statements run in order and expressions left to right; a branch or loop body is walked on a
# COPY of the consumption state, and afterwards an owner counts as moved if any path that falls
# through moved it (stage0 reports a use reachable from one moving path). A path ending in
# return/break/continue does not fall through.
#
# Everything this walk cannot read is SILENT, never guessed: a name bound more than once in the
# function (check_borrow_binders), a lambda or a match/block expression, a `move` in any other
# position, a call through a non-identifier callee. Each of those loses a report stage0 makes;
# none of them can invent one.
extend Semantic:
    private:
        # Exact identifier-position -> declaration identity index. Definition references are
        # built by name resolution before this pass; bucket chains retain exact offset checks
        # and avoid rescanning the full reference list for every call initializer.
        struct BorrowResolvedCallTargets:
            slots: mutable darray[u32] = []
            positions: mutable darray[Ast::Pos] = []
            declaration_ids: mutable darray[DeclId] = []
            ambiguous: mutable darray[bool] = []

        struct BorrowLoopExitPath:
            active_locals: mutable darray[sview @source] @source = []
            names: mutable darray[sview @source] @source = []
            fields: mutable darray[sview @source] @source = []
            owners: mutable darray[sview @source] @source = []
            kinds: mutable darray[u32] @source = []
            details: mutable darray[sview @source] @source = []

        struct BorrowLoopExitState:
            # `active_locals` belongs to the current statement list. Captured abrupt paths copy
            # it so cleanup never treats a declaration after that exit as already in scope.
            active_locals: mutable darray[sview @source] @source = []
            names: mutable darray[sview @source] @source = []
            fields: mutable darray[sview @source] @source = []
            owners: mutable darray[sview @source] @source = []
            kinds: mutable darray[u32] @source = []
            details: mutable darray[sview @source] @source = []
            seen: mutable bool = false
            exit_active_locals: mutable darray[sview @source] @source = []
            exit_paths: mutable darray[BorrowLoopExitPath] @source = []
            continue_names: mutable darray[sview @source] @source = []
            continue_fields: mutable darray[sview @source] @source = []
            continue_owners: mutable darray[sview @source] @source = []
            continue_kinds: mutable darray[u32] @source = []
            continue_details: mutable darray[sview @source] @source = []
            continue_seen: mutable bool = false
            continue_active_locals: mutable darray[sview @source] @source = []
            continue_paths: mutable darray[BorrowLoopExitPath] @source = []

        struct BorrowLarrowEntry:
            target: Ast::Expr
            value: Ast::Expr
            owners: mutable darray[sview @source] @source = []
            move_owner: mutable sview @source = ""
            field_names: mutable darray[sview @source] @source = []
            field_fields: mutable darray[sview @source] @source = []
            field_owners: mutable darray[sview @source] @source = []

        struct BorrowStateSnapshot:
            slots: mutable darray[usize] = []
            names: mutable darray[sview @source] = []
            fields: mutable darray[sview @source] = []
            closed: mutable darray[bool] = []
            owner_heads: mutable darray[usize] = []
            owner_tails: mutable darray[usize] = []
            owner_values: mutable darray[sview @source] = []
            owner_next: mutable darray[usize] = []

        struct BorrowReplayLabeledState:
            label: sview @source = ""
            state: mutable BorrowStateSnapshot = BorrowStateSnapshot{}

        # Staged provenance replay has no ownership diagnostics of its own, but it must
        # preserve the same reachable outcomes as the main walk. Each outcome owns a
        # compact snapshot so a branch can be merged without mutating another branch's log.
        struct BorrowReplayFlow:
            normal_seen: mutable bool = false
            normal: mutable BorrowStateSnapshot = BorrowStateSnapshot{}
            return_seen: mutable bool = false
            returned: mutable BorrowStateSnapshot = BorrowStateSnapshot{}
            breaks: mutable darray[BorrowReplayLabeledState] = []
            continues: mutable darray[BorrowReplayLabeledState] = []

        struct BorrowEscapeRootGroups:
            heads: mutable darray[usize] = []
            tails: mutable darray[usize] = []
            next: mutable darray[usize] = []
            values: mutable darray[sview @source] = []

        # A place reached through a by-value parameter that is NOT frame storage: the
        # elements of a container parameter (`field` empty) or a reference-typed field of a
        # struct parameter (`p.data` loads a pointer; it does not borrow `p`). stage0 lets
        # such places escape inside an aggregate or a lending call; a direct `&p`/`&buf[0]`
        # return is still reported.
        struct BorrowDetachedPlace:
            root: sview @source
            field: sview @source

        const BORROW_CALL_TARGET_NONE: u32 = 4294967295
        const BORROW_WILDCARD_KEY_HASH_NAME_SEPARATOR: u8 = 255

        def bam_definition_reference_hash(pos: Ast::Pos) -> u64:
            can Abort.Panic:
                hash: mutable u64 = (14695981039346656037 ^ pos.offset.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ pos.end_offset.u64()) * SEMANTIC_HASH_PRIME
                return hash

        def bam_build_definition_target_index(table: SymbolTable&) -> BorrowResolvedCallTargets:
            can Memory.Allocate, Abort.Panic:
                index: mutable BorrowResolvedCallTargets = BorrowResolvedCallTargets{}
                capacity: mutable usize = 16
                while capacity < table.definition_references.count * 2 |capacity|:
                    capacity <- capacity * 2
                index.slots.reserve(capacity)
                for _ in 0..<capacity |index|:
                    index.slots.push(0)
                for reference in table.definition_references |index|:
                    hash: u64 = bam_definition_reference_hash(reference.pos)
                    slot: mutable usize = hash.usize() & (capacity - 1)
                    duplicate: mutable bool = false
                    while index.slots[slot] != 0 |slot, duplicate, index, reference|:
                        row: usize = (index.slots[slot] - 1).usize()
                        prior_pos: Ast::Pos = index.positions[row]
                        if prior_pos.offset == reference.pos.offset and prior_pos.end_offset == reference.pos.end_offset:
                            index.ambiguous[row] <- true if index.declaration_ids[row].value != reference.declaration_id.value
                            duplicate <- true
                            break
                        slot <- (slot + 1) & (capacity - 1)
                    if not duplicate:
                        row: usize = index.positions.count
                        index.positions.push(reference.pos)
                        index.declaration_ids.push(reference.declaration_id)
                        index.ambiguous.push(false)
                        index.slots[slot] <- row.u32() + 1
                return index

        # Where `name` sits in `names`, or `names.count` when it is absent.
        def bam_index_of(names: darray[sview]&, name: sview) -> usize:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe|:
                    return probe if names[probe] == name
                    probe <- probe + 1
                return names.count

        def bam_lend_position_exists(names: darray[sview]&, positions: darray[usize]&, name: sview, position: usize) -> bool:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe|:
                    return true if probe < positions.count and names[probe] == name and positions[probe] == position
                    probe <- probe + 1
                return false

        def bam_is_owner(owners: darray[sview @source]&, name: sview) -> bool:
            can Abort.Panic:
                return name != "" and bam_index_of(owners, name) < owners.count

        # Record what consumed `owner` (kind 0 clears it: a re-initialised owner is live again).
        def bam_set_consumed(owners: darray[sview @source]&, kinds: mutable darray[u32]&, details: mutable darray[sview @source]&, owner: sview, kind: u32, detail: sview @source) -> void:
            can Abort.Panic:
                slot: usize = bam_index_of(owners, owner)
                return if slot >= owners.count
                kinds[slot] <- kind
                details[slot] <- detail

        # Whatever a branch consumed and the state before it did not.
        def bam_merge(kinds: mutable darray[u32]&, details: mutable darray[sview @source]&, branch_kinds: darray[u32]&, branch_details: darray[sview @source]&) -> void:
            can Abort.Panic:
                merge_index: mutable usize = 0
                while merge_index < kinds.count |merge_index|:
                    if kinds[merge_index] == 0 and merge_index < branch_kinds.count and branch_kinds[merge_index] != 0:
                        kinds[merge_index] <- branch_kinds[merge_index]
                        details[merge_index] <- branch_details[merge_index]
                    merge_index <- merge_index + 1

        def bam_append_unique_owner(owners: mutable darray[sview @source]&, owner: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if owner == "" or (any prior in owners where prior == owner)
                owners.push(owner)

        # A field-path wildcard `a.b.*` covers descendants such as `a.b.c`; the
        # separator position identifies the exact prefix being queried.
        def bam_borrow_wildcard_matches(candidate: sview, field: sview, prefix_end: usize) -> bool:
            can Abort.Panic:
                return SemanticBorrowFieldPath::wildcard_matches(candidate, field, prefix_end)

        # The first row for the most-specific matching `prefix.*` key, or count if none exists.
        def bam_borrow_wildcard_row(borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, name: sview, field: sview) -> usize:
            can Abort.Panic:
                prefix_end: mutable usize = field.len
                while prefix_end > 0 |prefix_end, borrow_names, borrow_fields, name, field|:
                    prefix_end <- prefix_end - 1
                    if field[prefix_end] == SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR:
                        probe: mutable usize = borrow_names.count
                        while probe > 0 |probe, prefix_end, borrow_names, borrow_fields, name, field|:
                            probe <- probe - 1
                            if borrow_names[probe] == name and probe < borrow_fields.count and bam_borrow_wildcard_matches(borrow_fields[probe], field, prefix_end):
                                return probe
                return borrow_names.count

        def bam_borrow_slot_live(borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, name: sview, field: sview) -> bool:
            can Abort.Panic:
                return false if name == ""
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe|:
                    probe <- probe - 1
                    if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == field:
                        return probe < borrow_owners.count and borrow_owners[probe] != ""
                if field != "*" and field != "":
                    nested_wildcard: usize = bam_borrow_wildcard_row(borrow_names, borrow_fields, name, field)
                    return nested_wildcard < borrow_owners.count and borrow_owners[nested_wildcard] != "" if nested_wildcard < borrow_names.count
                    probe <- borrow_names.count
                    while probe > 0 |probe|:
                        probe <- probe - 1
                        if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == "*":
                            return probe < borrow_owners.count and borrow_owners[probe] != ""
                return false

        def bam_borrow_slot_recorded(borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, name: sview, field: sview) -> bool:
            can Abort.Panic:
                return false if name == ""
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe|:
                    probe <- probe - 1
                    return true if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == field
                return false

        def bam_force_reset_borrow_field(borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, name: sview @source, field: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                borrow_names.push(name)
                borrow_fields.push(field)
                borrow_owners.push("")

        def bam_reset_borrow_field(borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, name: sview @source, field: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                # Keep ordinary declarations out of the provenance log. Without this
                # guard, later reverse lookups scan one empty marker per local binding.
                return if name == "" or not bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, name, field)
                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, field)

        def bam_borrow_key_hash(name: sview, field: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                for offset in 0..<name.len |hash, name|:
                    hash <- (hash ^ name[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ 255.u64()) * SEMANTIC_HASH_PRIME
                for offset in 0..<field.len |hash, field|:
                    hash <- (hash ^ field[offset].u64()) * SEMANTIC_HASH_PRIME
                return hash

        def bam_borrow_wildcard_key_hash(name: sview, field: sview, prefix_end: usize) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                for offset in 0..<name.len |hash, name|:
                    hash <- (hash ^ name[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ BORROW_WILDCARD_KEY_HASH_NAME_SEPARATOR.u64()) * SEMANTIC_HASH_PRIME
                for offset in 0..<prefix_end |hash, field|:
                    hash <- (hash ^ field[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ SemanticBorrowFieldPath::ASCII_WILDCARD.u64()) * SEMANTIC_HASH_PRIME
                return hash

        def bam_borrow_snapshot_owner_hash(key_index: usize, owner: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = 14695981039346656037
                for offset in 0..<owner.len |hash, owner|:
                    hash <- (hash ^ owner[offset].u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ 255.u64()) * SEMANTIC_HASH_PRIME
                return (hash ^ key_index.u64()) * SEMANTIC_HASH_PRIME

        # Return the matching key's slot, or the first empty slot. Callers allocate a
        # power-of-two table with at least twice the number of possible keys.
        def bam_borrow_key_probe(slots: darray[usize]&, names: darray[sview]&, fields: darray[sview]&, name: sview, field: sview) -> (slot: usize, found: bool):
            can Abort.Panic:
                mask: usize = slots.count - 1
                slot: mutable usize = bam_borrow_key_hash(name, field).usize() & mask
                while slots[slot] != 0 |slot, slots, names, fields, name, field, mask|:
                    row: usize = slots[slot] - 1
                    if names[row] == name and row < fields.count and fields[row] == field:
                        return (slot, true)
                    slot <- (slot + 1) & mask
                return (slot, false)

        def bam_borrow_wildcard_probe(slots: darray[usize]&, names: darray[sview]&, fields: darray[sview]&, name: sview, field: sview, prefix_end: usize) -> (slot: usize, found: bool):
            can Abort.Panic:
                mask: usize = slots.count - 1
                slot: mutable usize = bam_borrow_wildcard_key_hash(name, field, prefix_end).usize() & mask
                while slots[slot] != 0 |slot, slots, names, fields, name, field, prefix_end, mask|:
                    row: usize = slots[slot] - 1
                    if names[row] == name and row < fields.count and bam_borrow_wildcard_matches(fields[row], field, prefix_end):
                        return (slot, true)
                    slot <- (slot + 1) & mask
                return (slot, false)

        def bam_borrow_field_probe(slots: darray[usize]&, fields: darray[sview]&, field: sview) -> (slot: usize, found: bool):
            can Abort.Panic:
                mask: usize = slots.count - 1
                slot: mutable usize = bam_borrow_key_hash("", field).usize() & mask
                while slots[slot] != 0 |slot, slots, fields, field, mask|:
                    row: usize = slots[slot] - 1
                    if fields[row] == field:
                        return (slot, true)
                    slot <- (slot + 1) & mask
                return (slot, false)

        # Compact the append-only borrow log in one reverse pass. Each key retains all owners
        # after its newest empty generation marker; a per-key linked list keeps owners grouped
        # without rescanning the history when a branch joins or compares states.
        def bam_borrow_state_snapshot(names: darray[sview @source]&, fields: darray[sview @source]&, owners: darray[sview @source]&) -> BorrowStateSnapshot:
            can Memory.Allocate, Abort.Panic:
                snapshot: mutable BorrowStateSnapshot = BorrowStateSnapshot{}
                owner_key_indices: mutable darray[usize] = []
                owner_slots: mutable darray[usize] = []
                if names.count > 0:
                    capacity: mutable usize = 16
                    while capacity < (names.count + 1) * 2 |capacity, names|:
                        capacity <- capacity * 2
                    snapshot.slots.reserve(capacity)
                    for _ in 0..<capacity |snapshot|:
                        snapshot.slots.push(0)
                row: mutable usize = names.count
                while row > 0 |row, snapshot, fields, owners|:
                    row <- row - 1
                    name: sview = names[row]
                    field: sview = fields[row] if row < fields.count else ""
                    slot, found = bam_borrow_key_probe(snapshot.slots, snapshot.names, snapshot.fields, name, field)
                    key_index: mutable usize = 0
                    if found:
                        key_index <- snapshot.slots[slot] - 1
                    else:
                        key_index <- snapshot.names.count
                        snapshot.names.push(name)
                        snapshot.fields.push(field)
                        snapshot.closed.push(false)
                        snapshot.owner_heads.push(0)
                        snapshot.owner_tails.push(0)
                        snapshot.slots[slot] <- key_index + 1
                    continue if snapshot.closed[key_index]
                    owner: sview = owners[row] if row < owners.count else ""
                    if owner == "":
                        snapshot.closed[key_index] <- true
                    else:
                        # Allocate only when a live owner first reaches the dedup path.
                        # Empty and all-tombstone snapshots never need this hash table.
                        if owner_slots.count == 0:
                            owner_capacity: mutable usize = 16
                            while owner_capacity < (owners.count + 1) * 2 |owner_capacity, owners|:
                                owner_capacity <- owner_capacity * 2
                            owner_slots.reserve(owner_capacity)
                            for _ in 0..<owner_capacity |owner_slots|:
                                owner_slots.push(0)
                        owner_mask: usize = owner_slots.count - 1
                        owner_slot: mutable usize = bam_borrow_snapshot_owner_hash(key_index, owner).usize() & owner_mask
                        duplicate: mutable bool = false
                        while owner_slots[owner_slot] != 0 |owner_slot, owner_slots, owner_key_indices, snapshot, owner, owner_mask, duplicate|:
                            owner_row: usize = owner_slots[owner_slot] - 1
                            if owner_key_indices[owner_row] == key_index and snapshot.owner_values[owner_row] == owner:
                                duplicate <- true
                                break
                            owner_slot <- (owner_slot + 1) & owner_mask
                        if not duplicate:
                            owner_row: usize = snapshot.owner_values.count
                            snapshot.owner_values.push(owner)
                            snapshot.owner_next.push(0)
                            owner_key_indices.push(key_index)
                            owner_slots[owner_slot] <- owner_row + 1
                            if snapshot.owner_heads[key_index] == 0:
                                snapshot.owner_heads[key_index] <- owner_row + 1
                            else:
                                snapshot.owner_next[snapshot.owner_tails[key_index] - 1] <- owner_row + 1
                            snapshot.owner_tails[key_index] <- owner_row + 1
                return snapshot

        def bam_borrow_snapshot_append_owners(snapshot: BorrowStateSnapshot&, key_index: usize, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                owner_node: mutable usize = snapshot.owner_heads[key_index]
                while owner_node != 0 |owner_node, snapshot, out|:
                    owner_row: usize = owner_node - 1
                    owner: sview = snapshot.owner_values[owner_row]
                    out.push(owner) if owner != ""
                    owner_node <- snapshot.owner_next[owner_row]

        def bam_borrow_snapshot_owners(snapshot: BorrowStateSnapshot&, name: sview, field: sview, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or snapshot.names.count == 0
                owner_mark: usize = out.count
                slot, found = bam_borrow_key_probe(snapshot.slots, snapshot.names, snapshot.fields, name, field)
                if found:
                    key_index: usize = snapshot.slots[slot] - 1
                    bam_borrow_snapshot_append_owners(snapshot, key_index, out)
                    if out.count == owner_mark and field == "*":
                        return
                    return if out.count > owner_mark or field != ""
                    return bam_borrow_snapshot_owners(snapshot, name, "*", out)

                if field != "*" and field != "":
                    prefix_end: mutable usize = field.len
                    while prefix_end > 0 |prefix_end, snapshot, name, field, out|:
                        prefix_end <- prefix_end - 1
                        if field[prefix_end] == SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR:
                            slot, found = bam_borrow_wildcard_probe(snapshot.slots, snapshot.names, snapshot.fields, name, field, prefix_end)
                            if found:
                                bam_borrow_snapshot_append_owners(snapshot, snapshot.slots[slot] - 1, out)
                                return
                return if field == "*"
                bam_borrow_snapshot_owners(snapshot, name, "*", out)

        def bam_collect_borrow_keys(names: darray[sview]&, fields: darray[sview]&, holder: sview, out_names: mutable darray[sview]&, out_fields: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < (out_names.count + names.count + 1) * 2 |capacity, out_names, names|:
                    capacity <- capacity * 2
                slots: mutable darray[usize] = []
                slots.reserve(capacity)
                for _ in 0..<capacity |slots|:
                    slots.push(0)
                for seed_row in 0..<out_names.count |seed_row, slots, out_names, out_fields|:
                    key_field: sview = out_fields[seed_row] if seed_row < out_fields.count else ""
                    slot, found = bam_borrow_key_probe(slots, out_names, out_fields, out_names[seed_row], key_field)
                    slots[slot] <- seed_row + 1 if not found
                input_row: mutable usize = 0
                for key_name in names |input_row, fields, holder, out_names, out_fields, slots|:
                    key_field: sview = fields[input_row] if input_row < fields.count else ""
                    if holder == "" or key_name == holder:
                        slot, found = bam_borrow_key_probe(slots, out_names, out_fields, key_name, key_field)
                        if not found:
                            out_names.push(key_name)
                            out_fields.push(key_field)
                            slots[slot] <- out_names.count
                    input_row <- input_row + 1

        # Collect every owner in the newest generation of this exact slot. Empty-owner rows
        # terminate the generation, so an overwritten borrow cannot retain older provenance.
        def bam_borrow_exact_owners(borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, name: sview, field: sview, out: mutable darray[sview @source]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                found_slot: mutable bool = false
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe, out|:
                    probe <- probe - 1
                    if borrow_names[probe] == name and probe < borrow_fields.count and borrow_fields[probe] == field:
                        found_slot <- true
                        if probe >= borrow_owners.count or borrow_owners[probe] == "":
                            return true
                        bam_append_unique_owner(out, borrow_owners[probe])
                return found_slot

        # Resolve an exact slot first, then the most-specific ancestor wildcard, then `*`.
        # Exact tombstones suppress wildcard fallback; the direct `""` slot keeps its legacy
        # fallback to `*`, which represents an aggregate returned by a lender call.
        def bam_borrow_owners(borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, name: sview, field: sview, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == ""
                owner_mark: usize = out.count
                found_slot: bool = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, field, out)
                if found_slot:
                    if out.count == owner_mark and field == "":
                        _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, "*", out)
                    return
                if field != "*" and field != "":
                    wildcard_row: usize = bam_borrow_wildcard_row(borrow_names, borrow_fields, name, field)
                    if wildcard_row < borrow_names.count:
                        _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, borrow_fields[wildcard_row], out)
                        return
                if field != "*":
                    _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, "*", out)

        def bam_push_borrow(borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, name: sview @source, field: sview @source, owner: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or owner == ""
                borrow_names.push(name)
                borrow_fields.push(field)
                borrow_owners.push(owner)

        def bam_field_path_suffix(candidate: sview, prefix: sview) -> sview:
            can Abort.Panic:
                return candidate if prefix == ""
                suffix_start: usize = prefix.len + 1.usize()
                return candidate[suffix_start:candidate.len]

        def bam_copy_borrow_fields(destination: sview @source, prefix: sview, source: sview, source_prefix: sview, source_names: darray[sview @source]&, source_fields: darray[sview @source]&, source_owners: darray[sview @source]&, out_names: mutable darray[sview @source]&, out_fields: mutable darray[sview @source]&, out_owners: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                field_names: mutable darray[sview @source] = []
                field_keys: mutable darray[sview @source] = []
                bam_collect_borrow_keys(source_names, source_fields, source, field_names, field_keys)
                for source_field in field_keys |field_names, source, source_names, source_fields, source_owners, out_names, out_fields, out_owners, prefix, table|:
                    continue if source_field == "" or source_field == source_prefix
                    continue if source_prefix != "" and not bam_field_path_within(source_field, source_prefix)
                    copied_owners: mutable darray[sview @source] = []
                    bam_borrow_owners(source_names, source_fields, source_owners, source, source_field, copied_owners)
                    source_suffix: sview = bam_field_path_suffix(source_field, source_prefix)
                    destination_field: sview = bam_join_field_key(prefix, source_suffix, out_fields, table)
                    bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, destination_field)
                    for copied_owner in copied_owners |out_names, out_fields, out_owners, destination_field|:
                        bam_push_borrow(out_names, out_fields, out_owners, destination, destination_field, copied_owner)

        def bam_field_path_within(candidate: sview, prefix: sview) -> bool:
            can Abort.Panic:
                return true if candidate == prefix
                prefix_length: usize = prefix.len
                return false if:
                    prefix_length == 0 or candidate.len <= prefix_length
                    candidate[prefix_length] != 46
                for index in 0..<prefix_length |candidate, prefix|:
                    return false if candidate[index] != prefix[index]
                return true

        def bam_clear_borrow_path(name: sview @source, prefix: sview, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                key_names: mutable darray[sview @source] = []
                key_fields: mutable darray[sview @source] = []
                matching_fields: mutable darray[sview @source] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, key_names, key_fields)
                for field in key_fields |name, prefix, borrow_names, borrow_fields, borrow_owners|:
                    matching_fields.push(field) if bam_field_path_within(field, prefix)
                bam_clear_borrow_field_keys(name, matching_fields, borrow_names, borrow_fields, borrow_owners)
                wildcard_path: sview = bam_join_field_key(prefix, "*", borrow_fields, table)
                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, wildcard_path) if bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, name, wildcard_path)

        def bam_clear_borrow_field_keys(name: sview @source, fields: darray[sview]&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < (fields.count + 1) * 2 |capacity, fields|:
                    capacity <- capacity * 2
                selected_slots: mutable darray[usize] = []
                seen_slots: mutable darray[usize] = []
                selected_slots.reserve(capacity)
                seen_slots.reserve(capacity)
                for _ in 0..<capacity |selected_slots, seen_slots|:
                    selected_slots.push(0)
                    seen_slots.push(0)
                for row in 0..<fields.count |row, selected_slots, fields|:
                    slot, found = bam_borrow_field_probe(selected_slots, fields, fields[row])
                    selected_slots[slot] <- row + 1 if not found

                # Mask a holder-wide wildcard only when clearing that wildcard itself. Path
                # clears pass a subset and must leave sibling paths untouched.
                clears_global_wildcard: bool = any field in fields where field == "*"
                bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, "*") if clears_global_wildcard and bam_borrow_slot_live(borrow_names, borrow_fields, borrow_owners, name, "*")
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe, selected_slots, seen_slots, fields, borrow_names, borrow_fields, borrow_owners, name|:
                    probe <- probe - 1
                    continue if borrow_names[probe] != name or probe >= borrow_fields.count
                    field: sview = borrow_fields[probe]
                    continue if field == "*"
                    selected_slot, selected = bam_borrow_field_probe(selected_slots, fields, field)
                    continue if not selected
                    seen_slot, seen = bam_borrow_field_probe(seen_slots, fields, field)
                    continue if seen
                    selected_row: usize = selected_slots[selected_slot] - 1
                    seen_slots[seen_slot] <- selected_row + 1
                    continue if probe >= borrow_owners.count or borrow_owners[probe] == ""
                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, name, field)

        def bam_clear_borrow_fields(name: sview @source, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                field_names: mutable darray[sview @source] = []
                field_keys: mutable darray[sview @source] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, field_names, field_keys)
                bam_clear_borrow_field_keys(name, field_keys, borrow_names, borrow_fields, borrow_owners)

        # A write through a reference to an aggregate replaces its pointee's nested facts, but
        # the reference slot itself still names the same owner. Preserve the direct `""` row.
        def bam_clear_borrow_nested_fields(name: sview @source, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                field_names: mutable darray[sview @source] = []
                field_keys: mutable darray[sview @source] = []
                nested_fields: mutable darray[sview @source] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, name, field_names, field_keys)
                for field in field_keys |nested_fields|:
                    nested_fields.push(field) if field != ""
                bam_clear_borrow_field_keys(name, nested_fields, borrow_names, borrow_fields, borrow_owners)

        # Replace a holder's current field provenance with one path's state.
        def bam_replace_borrow_state(borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, source_names: darray[sview @source]&, source_fields: darray[sview @source]&, source_owners: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                source: BorrowStateSnapshot = bam_borrow_state_snapshot(source_names, source_fields, source_owners)
                key_names: mutable darray[sview @source] = []
                key_fields: mutable darray[sview @source] = []
                bam_collect_borrow_keys(borrow_names, borrow_fields, "", key_names, key_fields)
                bam_collect_borrow_keys(source.names, source.fields, "", key_names, key_fields)
                for row in 0..<key_names.count |row, borrow_names, borrow_fields, borrow_owners, source_names, source_fields, source_owners, key_names, key_fields|:
                    owners: mutable darray[sview @source] = []
                    bam_borrow_snapshot_owners(source, key_names[row], key_fields[row], owners)
                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, key_names[row], key_fields[row])
                    for owner in owners |borrow_names, borrow_fields, borrow_owners|:
                        bam_push_borrow(borrow_names, borrow_fields, borrow_owners, key_names[row], key_fields[row], owner)
