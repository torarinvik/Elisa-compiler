# A borrow used after its owner moved. `r = &o` (a `T&` local, a copy of another borrow, a
# borrow read out of a struct literal field, or the result of a call that can only hand back
# its one reference argument) borrows `o` — a local or parameter whose type is a BORROWABLE
# owner (struct_is_borrowable_owner: stage0's isBorrowableAffineOwnerType). Once `o` is moved
# — `f(move o)`, `p = move o`, `y <- move o`, `Box{k: move o}` — every later use of the borrow
# dangles, and stage0 reports each one: `linear value "r" cannot be used: usage facts were
# consumed by argument to call "finish"`. `o <- value` re-initialises the owner and revives its
# borrows. The same walk reports `return &local`, which dangles for the opposite reason: the
# frame it points into dies at the return.
#
# Statements run in order and expressions left to right; a branch or loop body is walked on a
# COPY of the consumption state, and afterwards an owner counts as moved if any path that falls
# through moved it (stage0 reports a use reachable from one moving path). A path ending in
# return/break/continue does not fall through.
#
# Everything this walk cannot read is SILENT, never guessed: a name bound more than once in the
# function (check_borrow_binders), a lambda or a match/block expression, a `move` in any other
# position, a call through a non-identifier callee. Each of those loses a report stage0 makes;
# none of them can invent one.
extend Semantic:
    private:
        # Where `name` sits in `names`, or `names.count` when it is absent.
        def bam_index_of(names: darray[sview]&, name: sview) -> usize:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe|:
                    probe return if names[probe] == name
                    probe <- probe + 1
                return names.count

        def bam_lend_position_exists(names: darray[sview]&, positions: darray[usize]&, name: sview, position: usize) -> bool:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < names.count |probe|:
                    return true if probe < positions.count and names[probe] == name and positions[probe] == position
                    probe <- probe + 1
                return false

        def bam_is_owner(owners: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return name != "" and bam_index_of(owners, name) < owners.count

        # Record what consumed `owner` (kind 0 clears it: a re-initialised owner is live again).
        def bam_set_consumed(owners: darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, owner: sview, kind: u32, detail: sview) -> void:
            can Abort.Panic:
                slot: usize = bam_index_of(owners, owner)
                return if slot >= owners.count
                kinds[slot] <- kind
                details[slot] <- detail

        # Whatever a branch consumed and the state before it did not.
        def bam_merge(kinds: mutable darray[u32]&, details: mutable darray[sview]&, branch_kinds: darray[u32]&, branch_details: darray[sview]&) -> void:
            can Abort.Panic:
                merge_index: mutable usize = 0
                while merge_index < kinds.count |merge_index|:
                    if kinds[merge_index] == 0 and merge_index < branch_kinds.count and branch_kinds[merge_index] != 0:
                        kinds[merge_index] <- branch_kinds[merge_index]
                        details[merge_index] <- branch_details[merge_index]
                    merge_index <- merge_index + 1

        # The owner a borrow refers to: `field` is "" for a direct borrow and the field name for
        # one held in a struct literal (`h.r`). "" when this is not a tracked borrow.
        def bam_borrow_owner(borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, name: sview, field: sview) -> sview:
            can Abort.Panic:
                "" return if name == ""
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe|:
                    probe <- probe - 1
                    borrow_owners[probe] return if borrow_names[probe] == name and borrow_fields[probe] == field
                return ""

        def bam_push_borrow(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, name: sview, field: sview, owner: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or owner == ""
                borrow_names.push(name)
                borrow_fields.push(field)
                borrow_owners.push(owner)

        # Stop reading `name` as a borrow: the newest row wins, and this one names no owner.
        def bam_drop_borrow(borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if bam_borrow_owner(borrow_names, borrow_fields, borrow_owners, name, "") == ""
                borrow_names.push(name)
                borrow_fields.push("")
                borrow_owners.push("")

        # The owner behind a borrow-valued expression: `&o`, another borrow's name, or a borrow
        # read out of a struct literal field.
        def bam_value_owner(value: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, unary_pos):
                        if operator == TokenKind.Ampersand:
                            addressed: sview = ident_name_of(operand)
                            addressed return if bam_is_owner(owners, addressed)
                        return ""
                    Expr.Paren(inner, paren_pos):
                        return bam_value_owner(inner, owners, borrow_names, borrow_fields, borrow_owners)
                    Expr.Ident(source_name, source_pos):
                        return bam_borrow_owner(borrow_names, borrow_fields, borrow_owners, source_name, "")
                    Expr.Field(field_object, field_name, field_pos):
                        return bam_borrow_owner(borrow_names, borrow_fields, borrow_owners, ident_name_of(field_object), field_name)
                    _:
                        return ""

        # The owner a `move o` names, else "".
        def bam_moved_owner(value: Ast::Expr, owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Move(moved_operand, moved_pos):
                        moved_name: sview = ident_name_of(moved_operand)
                        moved_name return if bam_is_owner(owners, moved_name)
                        return ""
                    _:
                        return ""

        # `r = lend(&o)`: a call to a single-reference-parameter function that returns a
        # reference can only hand back a borrow of that argument.
        def bam_lend_owner(value: Ast::Expr, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(lend_callee, lend_arguments, lend_labels, lend_pos):
                        slot: usize = bam_index_of(lend_names, ident_name_of(lend_callee))
                        "" return if slot >= lend_names.count
                        position: usize = lend_positions[slot]
                        "" return if position >= lend_arguments.count
                        return bam_value_owner(lend_arguments[position], owners, borrow_names, borrow_fields, borrow_owners)
                    _:
                        return ""

        def bam_report_use(name: sview, field: sview, pos: Ast::Pos, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: darray[u32]&, details: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owner: sview = bam_borrow_owner(borrow_names, borrow_fields, borrow_owners, name, field)
                return if owner == ""
                slot: usize = bam_index_of(owners, owner)
                return if slot >= owners.count or kinds[slot] == 0
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BorrowUseAfterOwnerMove, name: name, pos: pos, line: pos.line, expected: details[slot], actual: "", detail: field, expected_count: kinds[slot]})

        def bam_expression(expression: Ast::Expr, owners: darray[sview]&, borrow_names: darray[sview]&, borrow_fields: darray[sview]&, borrow_owners: darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(used_name, used_pos):
                        table <- bam_report_use(used_name, "", used_pos, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Field(field_object, field_name, field_pos):
                        # `h.r` is a use of the borrow in that field; `h` itself is not.
                        field_holder: sview = ident_name_of(field_object)
                        held: sview = bam_borrow_owner(borrow_names, borrow_fields, borrow_owners, field_holder, field_name)
                        table <- bam_expression(field_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if held == ""
                        table <- bam_report_use(field_holder, field_name, field_pos, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if held != ""
                    Expr.Call(call_callee, call_arguments, call_labels, call_pos):
                        callee_name: sview = ident_name_of(call_callee)
                        table <- bam_expression(call_callee, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if callee_name == ""
                        for call_argument in call_arguments |kinds, details, table| -> table:
                            table <- bam_expression(call_argument, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if bam_moved_owner(call_argument, owners) == ""
                        # The arguments are read BEFORE the call consumes any of them.
                        for consumed_argument in call_arguments |kinds, details|:
                            bam_set_consumed(owners, kinds, details, bam_moved_owner(consumed_argument, owners), 1, callee_name) if callee_name != ""
                    Expr.Construct(construct_head, construct_fields, construct_pos) | Expr.RecordUpdate(construct_head, construct_fields, construct_pos):
                        for construct_init in construct_fields |kinds, details, table| -> table:
                            table <- bam_expression(construct_init.value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if bam_moved_owner(construct_init.value, owners) == ""
                        for consumed_init in construct_fields |kinds, details|:
                            bam_set_consumed(owners, kinds, details, bam_moved_owner(consumed_init.value, owners), 4, consumed_init.name)
                    Expr.Binary(binary_left, binary_operator, binary_right, binary_pos):
                        table <- bam_expression(binary_left, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(binary_right, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if binary_operator != TokenKind.Is and binary_operator != TokenKind.As
                    Expr.Unary(_, unary_operand, unary_pos) | Expr.Paren(unary_operand, unary_pos) | Expr.Move(unary_operand, unary_pos) | Expr.RegionNew(unary_operand, _, unary_pos):
                        table <- bam_expression(unary_operand, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Index(index_object, index_value, index_pos):
                        table <- bam_expression(index_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(index_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.IndexN(indexn_object, indexn_arguments, indexn_pos):
                        table <- bam_expression(indexn_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        for indexn_argument in indexn_arguments |kinds, details, table| -> table:
                            table <- bam_expression(indexn_argument, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Slice(slice_object, slice_low, slice_high, slice_pos):
                        table <- bam_expression(slice_object, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(slice_low, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        table <- bam_expression(slice_high, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.Array(list_elements, list_pos) | Expr.Tuple(list_elements, list_pos) | Expr.SetLit(list_elements, list_pos):
                        for list_element in list_elements |kinds, details, table| -> table:
                            table <- bam_expression(list_element, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.DictLit(dict_entries, dict_pos):
                        for dict_entry in dict_entries |kinds, details, table| -> table:
                            table <- bam_expression(dict_entry.key, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            table <- bam_expression(dict_entry.value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.StaticEffectCall(effect_type, effect_operation, effect_candidates, effect_arguments, effect_labels, effect_pos):
                        for effect_argument in effect_arguments |kinds, details, table| -> table:
                            table <- bam_expression(effect_argument, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                    Expr.If(if_condition, if_then, if_else, if_pos):
                        # Either arm of a ternary may run: read each against the state before it,
                        # then keep the union of what they consume.
                        table <- bam_expression(if_condition, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        then_kinds: mutable darray[u32] = []
                        then_details: mutable darray[sview] = []
                        else_kinds: mutable darray[u32] = []
                        else_details: mutable darray[sview] = []
                        then_kinds.extend(kinds)
                        then_details.extend(details)
                        else_kinds.extend(kinds)
                        else_details.extend(details)
                        table <- bam_expression(if_then, owners, borrow_names, borrow_fields, borrow_owners, then_kinds, then_details, table)
                        table <- bam_expression(if_else, owners, borrow_names, borrow_fields, borrow_owners, else_kinds, else_details, table)
                        bam_merge(kinds, details, then_kinds, then_details)
                        bam_merge(kinds, details, else_kinds, else_details)
                    _:
                        pass

        # `r = &o`, `s = r`, `s = h.r`, `h = Holder{r: &o}` and `r = lend(&o)` all borrow `o`.
        # An annotation that is not a reference (`y: K = r`) copies the pointee instead, and
        # check_ref_value_copy reports that. Callers pass this decision directly so an
        # untyped assignment needs no placeholder annotation node.
        def bam_bind(name: sview, holds_reference: bool, value: Ast::Expr, owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not binders_bound_once(binders, name)
                borrowed: mutable sview = bam_value_owner(value, owners, borrow_names, borrow_fields, borrow_owners)
                borrowed <- bam_lend_owner(value, owners, lend_names, lend_positions, borrow_names, borrow_fields, borrow_owners) if borrowed == ""
                if borrowed != "":
                    bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, "", borrowed) if holds_reference
                    return
                match value:
                    Expr.Construct(literal_head, literal_fields, literal_pos):
                        for literal_init in literal_fields |borrow_names, borrow_fields, borrow_owners|:
                            literal_owner: sview = bam_value_owner(literal_init.value, owners, borrow_names, borrow_fields, borrow_owners)
                            bam_push_borrow(borrow_names, borrow_fields, borrow_owners, name, literal_init.name, literal_owner)
                    _:
                        pass

        def bam_statements(statements: darray[Ast::Stmt], owners: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, binders: BorrowBinders&, borrow_names: mutable darray[sview]&, borrow_fields: mutable darray[sview]&, borrow_owners: mutable darray[sview]&, kinds: mutable darray[u32]&, details: mutable darray[sview]&, flow: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |borrow_names, borrow_fields, borrow_owners, kinds, details, flow, table| -> table:
                    # Everything after a return/break/continue is unreachable.
                    continue if flow[0]
                    match statement:
                        Stmt.Expr(statement_expression, statement_pos):
                            table <- bam_expression(statement_expression, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            declared_move: sview = bam_moved_owner(declared_value, owners)
                            table <- bam_expression(declared_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if declared_move == ""
                            bam_set_consumed(owners, kinds, details, declared_move, 2, declared_name)
                            bam_bind(declared_name, rvc_is_absent(declared_type) or affine_annotation_is_ref(declared_type), declared_value, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_pos):
                            assign_name: sview = ident_name_of(assign_target)
                            table <- bam_expression(assign_target, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if assign_name == ""
                            assign_move: sview = bam_moved_owner(assign_value, owners)
                            table <- bam_expression(assign_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if assign_move == ""
                            if assign_operator == TokenKind.LArrow:
                                bam_set_consumed(owners, kinds, details, assign_move, 3, "")
                                # `r <- &other` retargets the borrow. Which owner it lands on is
                                # not something this walk can follow, so the name stops being a
                                # borrow at all (the tombstone's owner is "").
                                bam_drop_borrow(borrow_names, borrow_fields, borrow_owners, assign_name) if assign_name != ""
                                # `o <- value` re-initialises the owner: its borrows are live again.
                                bam_set_consumed(owners, kinds, details, assign_name, 0, "") if assign_name != assign_move
                            else:
                                bam_set_consumed(owners, kinds, details, assign_move, 2, assign_name)
                                bam_bind(assign_name, true, assign_value, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners)
                        Stmt.Return(returned_option, returned_pos):
                            if returned_option is returned_expression:
                                table <- bam_expression(returned_expression, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if bam_moved_owner(returned_expression, owners) == ""
                            flow[0] <- true
                        Stmt.Break(break_label, break_pos) | Stmt.Continue(break_label, break_pos):
                            flow[0] <- true
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            table <- bam_expression(branch_condition, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            then_kinds: mutable darray[u32] = []
                            then_details: mutable darray[sview] = []
                            then_flow: mutable darray[bool] = [false]
                            else_kinds: mutable darray[u32] = []
                            else_details: mutable darray[sview] = []
                            else_flow: mutable darray[bool] = [false]
                            then_kinds.extend(kinds)
                            then_details.extend(details)
                            else_kinds.extend(kinds)
                            else_details.extend(details)
                            table <- bam_statements(branch_then, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, then_kinds, then_details, then_flow, table)
                            table <- bam_statements(branch_else, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, else_kinds, else_details, else_flow, table)
                            bam_merge(kinds, details, then_kinds, then_details) if not then_flow[0]
                            bam_merge(kinds, details, else_kinds, else_details) if not else_flow[0]
                            flow[0] <- true if then_flow[0] and else_flow[0] and branch_else.count > 0
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            table <- bam_expression(loop_condition, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            loop_kinds: mutable darray[u32] = []
                            loop_details: mutable darray[sview] = []
                            loop_flow: mutable darray[bool] = [false]
                            loop_kinds.extend(kinds)
                            loop_details.extend(details)
                            table <- bam_statements(loop_body, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, loop_kinds, loop_details, loop_flow, table)
                            bam_merge(kinds, details, loop_kinds, loop_details) if not loop_flow[0]
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            table <- bam_expression(for_iterable, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            each_kinds: mutable darray[u32] = []
                            each_details: mutable darray[sview] = []
                            each_flow: mutable darray[bool] = [false]
                            each_kinds.extend(kinds)
                            each_details.extend(details)
                            table <- bam_statements(for_body, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, each_kinds, each_details, each_flow, table)
                            bam_merge(kinds, details, each_kinds, each_details) if not each_flow[0]
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            table <- bam_expression(match_scrutinee, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            pre_kinds: mutable darray[u32] = []
                            pre_details: mutable darray[sview] = []
                            pre_kinds.extend(kinds)
                            pre_details.extend(details)
                            open_arms: mutable u32 = 0
                            for match_arm in match_arms |borrow_names, borrow_fields, borrow_owners, kinds, details, open_arms, table| -> table:
                                arm_kinds: mutable darray[u32] = []
                                arm_details: mutable darray[sview] = []
                                arm_flow: mutable darray[bool] = [false]
                                arm_kinds.extend(pre_kinds)
                                arm_details.extend(pre_details)
                                table <- bam_statements(match_arm.body, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, arm_kinds, arm_details, arm_flow, table)
                                if not arm_flow[0]:
                                    bam_merge(kinds, details, arm_kinds, arm_details)
                                    open_arms <- open_arms + 1
                            flow[0] <- true if match_arms.count > 0 and open_arms == 0
                        # `can`/`trusted`/`region`/`in`/`nursery`/... bodies run inline, in
                        # order, on this path's own state. Any other block (`try`, `catch`, ...)
                        # may not run, so it is walked on a copy and merged like a branch.
                        # Without this arm stage1 accepted every borrow used after its owner
                        # moved inside one of these blocks (stage0 rejects).
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            block_inline: bool = block_kind == "can" or block_kind == "trusted" or block_kind == "region" or block_kind == "in" or block_kind == "with" or block_kind == "nursery" or block_kind == "pool" or block_kind == "static"
                            if block_inline:
                                table <- bam_statements(block_body, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, table)
                            else:
                                block_kinds: mutable darray[u32] = []
                                block_details: mutable darray[sview] = []
                                block_flow: mutable darray[bool] = [false]
                                block_kinds.extend(kinds)
                                block_details.extend(details)
                                table <- bam_statements(block_body, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, block_kinds, block_details, block_flow, table)
                                bam_merge(kinds, details, block_kinds, block_details) if not block_flow[0]
                        _:
                            pass

        # A by-value binding of a borrowable owner: `o: K`, `o: mutable K`, or a parameter.
        def bam_owner_type_name(annotation: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                named: sview = affine_type_head(rvc_value_type(annotation), table)
                named return if struct_is_borrowable_owner(table, named)
                return ""

        # An untyped `o = K{...}` binds an owner too.
        def bam_construct_owner_type(value: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Construct(construct_head, construct_fields, construct_pos):
                        constructed: sview = ident_name_of(construct_head)
                        constructed return if struct_is_borrowable_owner(table, constructed)
                        return ""
                    _:
                        return ""

        def bam_collect_owners(statements: darray[Ast::Stmt], binders: BorrowBinders&, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            declared_owner: bool = bam_owner_type_name(declared_type, table) != "" or (rvc_is_absent(declared_type) and bam_construct_owner_type(declared_value, table) != "")
                            out.push(declared_name) if declared_owner and binders_bound_once(binders, declared_name)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_pos):
                            assign_name: sview = ident_name_of(assign_target)
                            binds_owner: bool = assign_operator != TokenKind.LArrow and bam_construct_owner_type(assign_value, table) != ""
                            out.push(assign_name) if binds_owner and binders_bound_once(binders, assign_name)
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            bam_collect_owners(branch_then, binders, table, out)
                            bam_collect_owners(branch_else, binders, table, out)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            bam_collect_owners(loop_body, binders, table, out)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            bam_collect_owners(for_body, binders, table, out)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            bam_collect_owners(block_body, binders, table, out)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            for match_arm in match_arms |out|:
                                bam_collect_owners(match_arm.body, binders, table, out)
                        _:
                            pass

        # `return &x` / `return &x.field` where `x` is a local: the frame dies at the return.
        # stage0's checkBorrowEscapesLocal; a parameter's storage belongs to the caller, so only
        # locals are reported.
        def bam_place_root(place: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Ident(rooted_name, rooted_pos):
                        return rooted_name
                    Expr.Field(rooted_object, rooted_field, rooted_field_pos):
                        return bam_place_root(rooted_object)
                    Expr.Paren(rooted_inner, rooted_paren_pos):
                        return bam_place_root(rooted_inner)
                    # `xs[i]` is interior storage of `xs`, so a borrow of it is a borrow of
                    # the container -- stage0 reports `return &xs[0]` on a local array.
                    Expr.Index(rooted_indexed, _, _) | Expr.IndexN(rooted_indexed, _, _):
                        return bam_place_root(rooted_indexed)
                    _:
                        return ""

        # Preserve the identifier occurrence along with its spelling. Callable/global
        # effect summaries must distinguish a file global from a same-named local in
        # another lexical scope.
        def bam_place_root_position(place: Ast::Expr) -> (known: bool, position: Ast::Pos):
            can Abort.Panic:
                match place:
                    Expr.Ident(_, rooted_pos):
                        return (true, rooted_pos)
                    Expr.Field(rooted_object, _, _) | Expr.Paren(rooted_object, _) | Expr.Index(rooted_object, _, _) | Expr.IndexN(rooted_object, _, _):
                        return bam_place_root_position(rooted_object)
                    _:
                        return (false, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        def bam_collect_local_pattern(pattern: Ast::Pattern, binders: BorrowBinders&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        out.push(name) if binders_bound_once(binders, name)
                    Pattern.Rest(name):
                        out.push(name) if name != "" and binders_bound_once(binders, name)
                    Pattern.As(name, inner):
                        out.push(name) if binders_bound_once(binders, name)
                        for child in inner:
                            bam_collect_local_pattern(child, binders, out)
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children) | Pattern.Or(children):
                        for child in children:
                            bam_collect_local_pattern(child, binders, out)
                    # Pins reference an existing name; they introduce no local binding.
                    _:
                        pass

        # Expression blocks, match arms, get-else recoveries, and comprehensions can contain
        # frame-local values too. Keep them in the same root set used by the store-through
        # walk; otherwise a call nested there can publish a borrow while `locals` is empty.
        def bam_collect_local_expression(expression: Ast::Expr, binders: BorrowBinders&, out: mutable darray[sview]&, collect_perm_containers: bool, perm_containers: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        bam_collect_local_expression(callee, binders, out, collect_perm_containers, perm_containers)
                        for argument in arguments:
                            bam_collect_local_expression(argument, binders, out, collect_perm_containers, perm_containers)
                    Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                        bam_collect_local_expression(effect_type, binders, out, collect_perm_containers, perm_containers)
                        for candidate in candidates:
                            for capture in candidate.captures:
                                bam_collect_local_expression(capture, binders, out, collect_perm_containers, perm_containers)
                        for argument in arguments:
                            bam_collect_local_expression(argument, binders, out, collect_perm_containers, perm_containers)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        bam_collect_local_expression(object, binders, out, collect_perm_containers, perm_containers)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        bam_collect_local_expression(object, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(index, binders, out, collect_perm_containers, perm_containers)
                    Expr.Slice(object, low, high, _):
                        bam_collect_local_expression(object, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(low, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(high, binders, out, collect_perm_containers, perm_containers)
                    Expr.IndexN(object, arguments, _):
                        bam_collect_local_expression(object, binders, out, collect_perm_containers, perm_containers)
                        for argument in arguments:
                            bam_collect_local_expression(argument, binders, out, collect_perm_containers, perm_containers)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _) | Expr.RegionNew(operand, _, _):
                        bam_collect_local_expression(operand, binders, out, collect_perm_containers, perm_containers)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements:
                            bam_collect_local_expression(element, binders, out, collect_perm_containers, perm_containers)
                    Expr.DictLit(entries, _):
                        for entry in entries:
                            bam_collect_local_expression(entry.key, binders, out, collect_perm_containers, perm_containers)
                            bam_collect_local_expression(entry.value, binders, out, collect_perm_containers, perm_containers)
                    Expr.Construct(head, fields, _) | Expr.RecordUpdate(head, fields, _):
                        bam_collect_local_expression(head, binders, out, collect_perm_containers, perm_containers)
                        for field in fields:
                            bam_collect_local_expression(field.value, binders, out, collect_perm_containers, perm_containers)
                    Expr.If(condition, then_value, else_value, _):
                        bam_collect_local_expression(condition, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(then_value, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(else_value, binders, out, collect_perm_containers, perm_containers)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        bam_collect_local_expression(scrutinee, binders, out, collect_perm_containers, perm_containers)
                        for arm in arms:
                            bam_collect_local_pattern(arm.pattern, binders, out)
                            bam_collect_local_expression(arm.guard, binders, out, collect_perm_containers, perm_containers)
                            bam_collect_locals(arm.body, binders, out, collect_perm_containers, perm_containers)
                    Expr.Comprehension(variable, iterable, condition, body, _):
                        bam_collect_local_expression(iterable, binders, out, collect_perm_containers, perm_containers)
                        out.push(variable) if binders_bound_once(binders, variable)
                        bam_collect_local_expression(condition, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(body, binders, out, collect_perm_containers, perm_containers)
                    Expr.Refinement(base, predicate, _):
                        bam_collect_local_expression(base, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(predicate, binders, out, collect_perm_containers, perm_containers)
                    Expr.GetElse(guarded, recovery, _):
                        bam_collect_local_expression(guarded, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_locals(recovery, binders, out, collect_perm_containers, perm_containers)
                    Expr.Block(body, value, _, _):
                        bam_collect_locals(body, binders, out, collect_perm_containers, perm_containers)
                        bam_collect_local_expression(value, binders, out, collect_perm_containers, perm_containers)
                    # A lambda body can run after this frame has ended; its locals do not
                    # become roots in the enclosing function's frame analysis.
                    _:
                        pass

        def bam_collect_locals(statements: darray[Ast::Stmt], binders: BorrowBinders&, out: mutable darray[sview]&, collect_perm_containers: bool, perm_containers: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out, perm_containers|:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            # A plain `T` / `mutable T` annotation is frame storage. A region
                            # qualifier or a reference is not, and neither is an inferred binding.
                            value_type: Ast::Expr = rvc_value_type(declared_type)
                            if not rvc_is_absent(value_type):
                                unique_binder: bool = binders_bound_once(binders, declared_name)
                                out.push(declared_name) if unique_binder
                                perm_containers.push(declared_name) if collect_perm_containers and unique_binder and emit_ast_expr_head_is_container(value_type)
                            bam_collect_local_expression(declared_value, binders, out, collect_perm_containers, perm_containers)
                        Stmt.Expr(value, _):
                            bam_collect_local_expression(value, binders, out, collect_perm_containers, perm_containers)
                        Stmt.Assign(target, _, value, _):
                            bam_collect_local_expression(target, binders, out, collect_perm_containers, perm_containers)
                            bam_collect_local_expression(value, binders, out, collect_perm_containers, perm_containers)
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            bam_collect_local_expression(branch_condition, binders, out, collect_perm_containers, perm_containers)
                            bam_collect_locals(branch_then, binders, out, collect_perm_containers, perm_containers)
                            bam_collect_locals(branch_else, binders, out, collect_perm_containers, perm_containers)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            bam_collect_local_expression(loop_condition, binders, out, collect_perm_containers, perm_containers)
                            bam_collect_locals(loop_body, binders, out, collect_perm_containers, perm_containers)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            bam_collect_local_expression(for_iterable, binders, out, collect_perm_containers, perm_containers)
                            for for_variable in for_variables |out|:
                                out.push(for_variable) if binders_bound_once(binders, for_variable)
                            bam_collect_locals(for_body, binders, out, collect_perm_containers, perm_containers)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            bam_collect_local_expression(match_scrutinee, binders, out, collect_perm_containers, perm_containers)
                            for match_arm in match_arms |out, perm_containers|:
                                bam_collect_local_pattern(match_arm.pattern, binders, out)
                                bam_collect_local_expression(match_arm.guard, binders, out, collect_perm_containers, perm_containers)
                                bam_collect_locals(match_arm.body, binders, out, collect_perm_containers, perm_containers)
                        # `can …:` / `trusted …:` / `region …:` / `try:` bodies declare frame
                        # locals too; skipping them let `can X: local = 5; return &local` escape.
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            out.push(block_binding) if block_binding != "" and binders_bound_once(binders, block_binding)
                            bam_collect_locals(block_body, binders, out, collect_perm_containers, perm_containers)
                        Stmt.Return(value, _):
                            if value is returned_expression:
                                bam_collect_local_expression(returned_expression, binders, out, collect_perm_containers, perm_containers)
                        Stmt.Contract(_, value, _):
                            bam_collect_local_expression(value, binders, out, collect_perm_containers, perm_containers)
                        _:
                            pass

        # Whether an aggregate expression places `parameter_name` itself into a value.
        # This deliberately follows value-building syntax, not arbitrary reads: `length(x)`
        # may consume a reference parameter without returning a borrow of it, while
        # `Lease{owner: x}` stores that reference in the returned value.
        def bam_summary_alias_carries(name: sview, alias_names: darray[sview]&, alias_carries: darray[bool]&) -> bool:
            can Abort.Panic:
                alias_index: mutable usize = alias_names.count
                while alias_index > 0 |alias_index|:
                    alias_index <- alias_index - 1
                    return alias_carries[alias_index] if alias_names[alias_index] == name
                return false

        def bam_aggregate_carries_parameter(expression: Ast::Expr, parameter_name: sview, alias_names: darray[sview]&, alias_carries: darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(value_name, value_pos):
                        return value_name == parameter_name or bam_summary_alias_carries(value_name, alias_names, alias_carries)
                    Expr.Unary(operator, operand, unary_pos):
                        return bam_place_root(operand) == parameter_name if operator == TokenKind.Ampersand
                        return false
                    Expr.Paren(inner, paren_pos):
                        return bam_aggregate_carries_parameter(inner, parameter_name, alias_names, alias_carries)
                    Expr.Construct(_, fields, _):
                        for initializer in fields |parameter_name|:
                            return true if bam_aggregate_carries_parameter(initializer.value, parameter_name, alias_names, alias_carries)
                        return false
                    Expr.RecordUpdate(base, fields, _):
                        return true if bam_aggregate_carries_parameter(base, parameter_name, alias_names, alias_carries)
                        for initializer in fields |parameter_name|:
                            return true if bam_aggregate_carries_parameter(initializer.value, parameter_name, alias_names, alias_carries)
                        return false
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |parameter_name|:
                            return true if bam_aggregate_carries_parameter(element, parameter_name, alias_names, alias_carries)
                        return false
                    Expr.DictLit(entries, _):
                        for entry in entries |parameter_name|:
                            return true if bam_aggregate_carries_parameter(entry.value, parameter_name, alias_names, alias_carries)
                        return false
                    Expr.If(_, then_value, else_value, _):
                        return bam_aggregate_carries_parameter(then_value, parameter_name, alias_names, alias_carries) or bam_aggregate_carries_parameter(else_value, parameter_name, alias_names, alias_carries)
                    Expr.Block(block_statements, value, _, _):
                        block_alias_names: mutable darray[sview] = []
                        block_alias_carries: mutable darray[bool] = []
                        block_alias_names.extend(alias_names)
                        block_alias_carries.extend(alias_carries)
                        return true if bam_returns_aggregate_borrow(block_statements, parameter_name, false, &block_alias_names, &block_alias_carries)
                        return bam_aggregate_carries_parameter(value, parameter_name, block_alias_names, block_alias_carries)
                    _:
                        return false

        # A helper is a known aggregate lender only when its returned value actually contains
        # its sole reference parameter. This avoids treating a reader such as `count(values)`
        # as a lender just because its signature accepts a reference.
        def bam_returns_aggregate_borrow(statements: darray[Ast::Stmt], parameter_name: sview, tail_value: bool, alias_names: mutable darray[sview]&, alias_carries: mutable darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                statement_index: mutable usize = 0
                for statement in statements |parameter_name, tail_value, statement_index, alias_names, alias_carries|:
                    match statement:
                        Stmt.Return(returned_option, _):
                            if returned_option is returned_expression:
                                return true if bam_aggregate_carries_parameter(returned_expression, parameter_name, alias_names, alias_carries)
                        Stmt.Expr(tail_expression, _):
                            return true if tail_value and statement_index + 1 == statements.count and bam_aggregate_carries_parameter(tail_expression, parameter_name, alias_names, alias_carries)
                        Stmt.VarDecl(declared_name, _, declared_value, _):
                            carries_parameter: bool = bam_aggregate_carries_parameter(declared_value, parameter_name, alias_names, alias_carries)
                            alias_names.push(declared_name)
                            alias_carries.push(carries_parameter)
                        Stmt.Assign(assign_target, _, assigned_value, _):
                            assigned_name: sview = bam_place_root(assign_target)
                            if assigned_name != "":
                                carries_parameter: bool = bam_aggregate_carries_parameter(assigned_value, parameter_name, alias_names, alias_carries)
                                was_carrying: bool = bam_summary_alias_carries(assigned_name, alias_names, alias_carries)
                                # This is a may-carry summary: once any reachable assignment
                                # stores the input borrow, a later safe overwrite must not hide
                                # the escaping path from the summary.
                                alias_names.push(assigned_name)
                                alias_carries.push(carries_parameter or was_carrying)
                        Stmt.If(_, branch_then, branch_else, _):
                            is_tail: bool = tail_value and statement_index + 1 == statements.count
                            return true if bam_returns_aggregate_borrow(branch_then, parameter_name, is_tail, alias_names, alias_carries)
                            return true if bam_returns_aggregate_borrow(branch_else, parameter_name, is_tail, alias_names, alias_carries)
                        Stmt.Match(_, arms, _):
                            is_tail_match: bool = tail_value and statement_index + 1 == statements.count
                            for arm in arms |parameter_name, is_tail_match, alias_names, alias_carries|:
                                return true if bam_returns_aggregate_borrow(arm.body, parameter_name, is_tail_match, alias_names, alias_carries)
                        Stmt.Block(_, _, _, block_body, _):
                            is_tail_block: bool = tail_value and statement_index + 1 == statements.count
                            return true if bam_returns_aggregate_borrow(block_body, parameter_name, is_tail_block, alias_names, alias_carries)
                        Stmt.While(_, loop_body, _) | Stmt.For(_, _, _, loop_body, _):
                            return true if bam_returns_aggregate_borrow(loop_body, parameter_name, false, alias_names, alias_carries)
                        _:
                            pass
                    statement_index <- statement_index + 1
                return false

        def bam_expression_is_parameter(expression: Ast::Expr, parameter_name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name == parameter_name
                    Expr.Paren(inner, _):
                        return bam_expression_is_parameter(inner, parameter_name)
                    _:
                        return false

        # A forwarding helper may return the aggregate-lender's result directly or store it in
        # a field/tuple before returning. The single reference parameter must be forwarded to
        # the callee's own summarized borrow parameter.
        def bam_expression_returns_lender(expression: Ast::Expr, parameter_name: sview, lend_names: darray[sview]&, lend_positions: darray[usize]&, alias_names: darray[sview]&, alias_carries: darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(value_name, _):
                        return bam_summary_alias_carries(value_name, alias_names, alias_carries)
                    Expr.Call(callee, arguments, _, _):
                        callee_name: sview = ident_name_of(callee)
                        slot: mutable usize = 0
                        while slot < lend_names.count |slot|:
                            if lend_names[slot] == callee_name and slot < lend_positions.count:
                                position: usize = lend_positions[slot]
                                return true if position < arguments.count and bam_expression_is_parameter(arguments[position], parameter_name)
                            slot <- slot + 1
                        return false
                    Expr.Construct(_, fields, _):
                        for initializer in fields |parameter_name, lend_names, lend_positions, alias_names, alias_carries|:
                            return true if bam_expression_returns_lender(initializer.value, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                        return false
                    Expr.RecordUpdate(base, fields, _):
                        return true if bam_expression_returns_lender(base, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                        for initializer in fields |parameter_name, lend_names, lend_positions, alias_names, alias_carries|:
                            return true if bam_expression_returns_lender(initializer.value, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                        return false
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |parameter_name, lend_names, lend_positions, alias_names, alias_carries|:
                            return true if bam_expression_returns_lender(element, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                        return false
                    Expr.DictLit(entries, _):
                        for entry in entries |parameter_name, lend_names, lend_positions, alias_names, alias_carries|:
                            return true if bam_expression_returns_lender(entry.value, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                        return false
                    Expr.If(_, then_value, else_value, _):
                        return bam_expression_returns_lender(then_value, parameter_name, lend_names, lend_positions, alias_names, alias_carries) or bam_expression_returns_lender(else_value, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                    Expr.Paren(inner, _):
                        return bam_expression_returns_lender(inner, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                    Expr.Block(block_statements, inner, _, _):
                        block_alias_names: mutable darray[sview] = []
                        block_alias_carries: mutable darray[bool] = []
                        block_alias_names.extend(alias_names)
                        block_alias_carries.extend(alias_carries)
                        return true if bam_statements_return_lender(block_statements, parameter_name, lend_names, lend_positions, &block_alias_names, &block_alias_carries, false)
                        return bam_expression_returns_lender(inner, parameter_name, lend_names, lend_positions, block_alias_names, block_alias_carries)
                    _:
                        return false

        def bam_statements_return_lender(statements: darray[Ast::Stmt], parameter_name: sview, lend_names: darray[sview]&, lend_positions: darray[usize]&, alias_names: mutable darray[sview]&, alias_carries: mutable darray[bool]&, tail_value: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                statement_index: mutable usize = 0
                for statement in statements |parameter_name, lend_names, lend_positions, alias_names, alias_carries, tail_value, statement_index|:
                    match statement:
                        Stmt.Return(returned_option, _):
                            if returned_option is returned_expression:
                                return true if bam_expression_returns_lender(returned_expression, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                        Stmt.Expr(tail_expression, _):
                            return true if tail_value and statement_index + 1 == statements.count and bam_expression_returns_lender(tail_expression, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                        Stmt.VarDecl(declared_name, _, declared_value, _):
                            carries_lender: bool = bam_expression_returns_lender(declared_value, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                            alias_names.push(declared_name)
                            alias_carries.push(carries_lender)
                        Stmt.Assign(assign_target, _, assigned_value, _):
                            assigned_name: sview = bam_place_root(assign_target)
                            if assigned_name != "":
                                carries_lender: bool = bam_expression_returns_lender(assigned_value, parameter_name, lend_names, lend_positions, alias_names, alias_carries)
                                was_carrying: bool = bam_summary_alias_carries(assigned_name, alias_names, alias_carries)
                                alias_names.push(assigned_name)
                                alias_carries.push(carries_lender or was_carrying)
                        Stmt.If(_, branch_then, branch_else, _):
                            is_tail: bool = tail_value and statement_index + 1 == statements.count
                            return true if bam_statements_return_lender(branch_then, parameter_name, lend_names, lend_positions, alias_names, alias_carries, is_tail)
                            return true if bam_statements_return_lender(branch_else, parameter_name, lend_names, lend_positions, alias_names, alias_carries, is_tail)
                        Stmt.Match(_, arms, _):
                            is_tail_match: bool = tail_value and statement_index + 1 == statements.count
                            for arm in arms |parameter_name, lend_names, lend_positions, alias_names, alias_carries, is_tail_match|:
                                return true if bam_statements_return_lender(arm.body, parameter_name, lend_names, lend_positions, alias_names, alias_carries, is_tail_match)
                        Stmt.Block(_, _, _, block_body, _):
                            is_tail_block: bool = tail_value and statement_index + 1 == statements.count
                            return true if bam_statements_return_lender(block_body, parameter_name, lend_names, lend_positions, alias_names, alias_carries, is_tail_block)
                        Stmt.While(_, loop_body, _) | Stmt.For(_, _, _, loop_body, _):
                            return true if bam_statements_return_lender(loop_body, parameter_name, lend_names, lend_positions, alias_names, alias_carries, false)
                        _:
                            pass
                    statement_index <- statement_index + 1
                return false

        def bam_collect_lend_wrappers(declarations: darray[Ast::Decl], lend_names: darray[sview]&, lend_positions: darray[usize]&, candidate_names: mutable darray[sview]&, candidate_positions: mutable darray[usize]&, declared_names: BorrowBinders&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |lend_names, lend_positions, candidate_names, candidate_positions|:
                    match declaration:
                        Decl.Func(function_name, function_parameters, function_return, function_body, _, _, _):
                            if function_return is declared_return and binders_bound_once(declared_names, function_name):
                                parameter_index: mutable usize = 0
                                summary_binders: mutable BorrowBinders = empty_borrow_binders()
                                borrow_function_binders(function_parameters, function_body, summary_binders)
                                for parameter in function_parameters |parameter_index, candidate_names, candidate_positions|:
                                    if affine_annotation_is_ref(parameter.type_expression) and not bam_lend_position_exists(lend_names, lend_positions, function_name, parameter_index):
                                        summary_parameter: sview = parameter.name
                                        can_summarize: bool = not (any unreadable_binder in summary_binders.names where unreadable_binder == "*") and binders_bound_once(summary_binders, summary_parameter)
                                        lender_alias_names: mutable darray[sview] = []
                                        lender_alias_carries: mutable darray[bool] = []
                                        forwards_aggregate_borrow: bool = can_summarize and bam_statements_return_lender(function_body, summary_parameter, lend_names, lend_positions, &lender_alias_names, &lender_alias_carries, true)
                                        if forwards_aggregate_borrow:
                                            candidate_names.push(function_name)
                                            candidate_positions.push(parameter_index)
                                    parameter_index <- parameter_index + 1
                        Decl.Module(module_name, module_body, _):
                            bam_collect_lend_wrappers(module_body, lend_names, lend_positions, candidate_names, candidate_positions, declared_names)
                        Decl.Scoped(scoped_body, _):
                            bam_collect_lend_wrappers(scoped_body, lend_names, lend_positions, candidate_names, candidate_positions, declared_names)
                        _:
                            pass

        def bam_report_escape_root(escaping: sview, pos: Ast::Pos, locals: darray[sview]&, aggregate_result: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                kind: mutable DiagnosticKind = DiagnosticKind.ReturnRefToLocal
                kind <- DiagnosticKind.ReturnRefAggregateLocal if aggregate_result
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: kind, name: escaping, pos: pos, line: pos.line, expected: "", actual: ""}) if escaping != "" and (any known_local in locals where known_local == escaping)

        def bam_escape_roots_for_binding(name: sview, escape_names: darray[sview]&, escape_roots: darray[sview]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                roots: mutable darray[sview] = []
                row: mutable usize = escape_names.count
                while row > 0 |row, roots|:
                    row <- row - 1
                    if escape_names[row] == name:
                        break if escape_roots[row] == ""
                        roots.push(escape_roots[row])
                return roots

        def bam_escape_collect_lend_argument_roots(argument: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, out_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                borrowed_root: sview = bam_borrow_root(argument)
                if borrowed_root != "":
                    out_roots.push(borrowed_root)
                    return
                match argument:
                    Expr.Ident(argument_name, _):
                        alias_roots: darray[sview] = bam_escape_roots_for_binding(argument_name, escape_names, escape_roots)
                        if alias_roots.count > 0:
                            for alias_root in alias_roots |out_roots|:
                                out_roots.push(alias_root)
                        else:
                            out_roots.push(argument_name)
                    Expr.Field(_, _, _) | Expr.Index(_, _, _):
                        value_roots: mutable darray[sview] = []
                        bam_escape_collect_roots(argument, lend_names, lend_positions, escape_names, escape_roots, value_roots)
                        if value_roots.count > 0:
                            for value_root in value_roots |out_roots|:
                                out_roots.push(value_root)
                        else:
                            place_root: sview = bam_place_root(argument)
                            out_roots.push(place_root) if place_root != ""
                    Expr.Paren(inner, _):
                        bam_escape_collect_lend_argument_roots(inner, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    _:
                        bam_escape_collect_roots(argument, lend_names, lend_positions, escape_names, escape_roots, out_roots)

        def bam_escape_collect_lend_call_roots(call: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, out_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match call:
                    Expr.Call(callee, arguments, _, _):
                        callee_name: sview = ident_name_of(callee)
                        slot: mutable usize = 0
                        while slot < lend_names.count |slot|:
                            if lend_names[slot] == callee_name and slot < lend_positions.count:
                                position: usize = lend_positions[slot]
                                if position < arguments.count:
                                    bam_escape_collect_lend_argument_roots(arguments[position], lend_names, lend_positions, escape_names, escape_roots, out_roots)
                            slot <- slot + 1
                    Expr.Paren(inner, _):
                        bam_escape_collect_lend_call_roots(inner, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    _:
                        pass

        # Merge one possible control-flow path into the current may-carry environment.
        # Keep only bindings that existed before the path: branch-local names do not escape.
        #
        # Every name in the environment receives a fresh version here (an empty root, then
        # its roots), and both readers (bam_escape_roots_for_binding, the Ident arm of
        # bam_escape_collect_roots) walk back from the newest entry and stop at that empty
        # root -- so the entries that were in the environment before the merge can never be
        # read again. The merged environment is therefore REBUILT from the fresh versions
        # rather than appended behind the dead ones: appending grew the lists by every
        # binding per branch, and each later merge and lookup re-walked that dead history
        # (quadratic in the number of branches of a function). Lookup results are unchanged.
        def bam_escape_merge_branch[@r](target_names: mutable darray[sview]& @r, target_roots: mutable darray[sview]& @r, branch_names: darray[sview]& @r, branch_roots: darray[sview]& @r) -> void:
            can Memory.Allocate, Abort.Panic:
                merge_names: mutable darray[sview] = []
                for target_name in target_names |merge_names|:
                    merge_names.push(target_name) if not (any known_merge in merge_names where known_merge == target_name)
                merged_names: mutable darray[sview] @r = []
                merged_roots: mutable darray[sview] @r = []
                for merge_name in merge_names |merged_names, merged_roots, target_names, target_roots, branch_names, branch_roots|:
                    target_values: darray[sview] = bam_escape_roots_for_binding(merge_name, target_names, target_roots)
                    branch_values: darray[sview] = bam_escape_roots_for_binding(merge_name, branch_names, branch_roots)
                    merged_names.push(merge_name)
                    merged_roots.push("")
                    for target_value in target_values |merged_names, merged_roots|:
                        merged_names.push(merge_name)
                        merged_roots.push(target_value)
                    for branch_value in branch_values |merged_names, merged_roots, target_values|:
                        if not (any known_value in target_values where known_value == branch_value):
                            merged_names.push(merge_name)
                            merged_roots.push(branch_value)
                target_names.truncate(0)
                target_roots.truncate(0)
                for merged_row in 0..<merged_names.count |target_names, target_roots|:
                    target_names.push(merged_names[merged_row])
                    target_roots.push(merged_roots[merged_row])

        # Collect local-storage roots carried by a value. Bindings are stored as groups in
        # `escape_names`/`escape_roots`; an empty root starts a new binding version and stops
        # lookup from reaching an older assignment.
        def bam_escape_collect_roots(value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, out_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, _) if operator == TokenKind.Ampersand:
                        root: sview = bam_place_root(operand)
                        out_roots.push(root) if root != ""
                    Expr.Index(Expr.Field(receiver, selector, _), _, _) if selector == "ref":
                        root: sview = bam_place_root(receiver)
                        out_roots.push(root) if root != ""
                    Expr.Call(_, _, _, _):
                        bam_escape_collect_lend_call_roots(value, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.Ident(name, _):
                        found_alias: mutable bool = false
                        alias_index: mutable usize = escape_names.count
                        while alias_index > 0 |alias_index, escape_names, escape_roots, found_alias, out_roots|:
                            alias_index <- alias_index - 1
                            if escape_names[alias_index] == name:
                                if escape_roots[alias_index] == "":
                                    break
                                out_roots.push(escape_roots[alias_index])
                                found_alias <- true
                    Expr.Field(object, _, _):
                        bam_escape_collect_roots(object, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.Construct(_, fields, _):
                        for initializer in fields |out_roots|:
                            bam_escape_collect_roots(initializer.value, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.RecordUpdate(base, fields, _):
                        bam_escape_collect_roots(base, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                        for initializer in fields |out_roots|:
                            bam_escape_collect_roots(initializer.value, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |out_roots|:
                            bam_escape_collect_roots(element, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.DictLit(entries, _):
                        for entry in entries |out_roots|:
                            bam_escape_collect_roots(entry.value, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.If(_, then_value, else_value, _):
                        bam_escape_collect_roots(then_value, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                        bam_escape_collect_roots(else_value, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        bam_escape_collect_roots(inner, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    Expr.Block(_, block_value, _, _):
                        bam_escape_collect_roots(block_value, lend_names, lend_positions, escape_names, escape_roots, out_roots)
                    _:
                        pass

        def bam_expression_is_direct_borrow(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, _, _):
                        return operator == TokenKind.Ampersand
                    Expr.Index(Expr.Field(receiver, selector, _), target, _):
                        return selector == "ref" or (selector == "cast" and bam_type_is_address(target) and bam_expression_is_direct_borrow(receiver))
                    Expr.Paren(inner, _):
                        return bam_expression_is_direct_borrow(inner)
                    _:
                        return false

        def bam_return_uses_aggregate_diagnostic(expression: Ast::Expr, aggregate_result: bool, direct_reference_result: bool) -> bool:
            can Abort.Panic:
                return true if aggregate_result
                return direct_reference_result and not bam_expression_is_direct_borrow(expression)

        def bam_escape_anchor(returned: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                match returned:
                    Expr.Construct(construct_type, _, _):
                        return Ast::expr_pos(construct_type)
                    _:
                        return Ast::expr_pos(returned)

        def bam_report_escape(returned: Ast::Expr, locals: darray[sview]&, perm_containers: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, aggregate_result: bool, anchor: Ast::Pos, anchored: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # stage0 reports the escape at the RETURNED expression's first token, not at
                # the `&` nested inside a literal; compound arms pass that anchor inward.
                nested_anchor: Ast::Pos = anchor if anchored else bam_escape_anchor(returned)
                match returned:
                    Expr.Unary(return_operator, return_operand, return_pos):
                        return if return_operator != TokenKind.Ampersand
                        table <- bam_report_escape_root(bam_place_root(return_operand), (anchor if anchored else return_pos), locals, aggregate_result, table)
                    # `x.ref[T]` -- the REMOVED reference shorthand. stage0 reports its removal
                    # and then keeps analysing it as `&x`, so the dangle lands too; stage1 used
                    # to stop at the removal message and let the use-after-free through.
                    Expr.Index(Expr.Field(ref_receiver, ref_selector, ref_field_pos), ref_target, ref_index_pos):
                        # `(&x).cast[T&?]` (also inside `trusted`) still points at x.
                        if ref_selector == "cast" and bam_type_is_address(ref_target):
                            # stage0's `perm` rule: a `static T&` function allocates its containers
                            # in `perm`, so `(&out[i]).cast[static T&]` outlives the frame.
                            return if bam_annotation_is_static(ref_target) and bam_borrow_is_element(bam_strip_paren(ref_receiver)) and (any perm_name in perm_containers where perm_name == bam_borrow_root(bam_strip_paren(ref_receiver)))
                            table <- bam_report_escape_root(bam_borrow_root(bam_strip_paren(ref_receiver)), (anchor if anchored else ref_field_pos), locals, aggregate_result, table)
                            return
                        return if ref_selector != "ref"
                        table <- bam_report_escape_root(bam_place_root(ref_receiver), (anchor if anchored else ref_index_pos), locals, aggregate_result, table)
                    Expr.Call(_, _, _, call_pos):
                        roots: mutable darray[sview] = []
                        bam_escape_collect_roots(returned, lend_names, lend_positions, escape_names, escape_roots, roots)
                        for root in roots |table| -> table:
                            table <- bam_report_escape_root(root, (anchor if anchored else call_pos), locals, aggregate_result, table)
                    Expr.Ident(returned_name, returned_pos):
                        roots: mutable darray[sview] = []
                        bam_escape_collect_roots(returned, lend_names, lend_positions, escape_names, escape_roots, roots)
                        for root in roots |table| -> table:
                            table <- bam_report_escape_root(root, (anchor if anchored else returned_pos), locals, aggregate_result, table)
                    Expr.Field(field_object, _, field_pos):
                        roots: mutable darray[sview] = []
                        bam_escape_collect_roots(field_object, lend_names, lend_positions, escape_names, escape_roots, roots)
                        for root in roots |table| -> table:
                            table <- bam_report_escape_root(root, (anchor if anchored else field_pos), locals, aggregate_result, table)
                    Expr.Construct(_, fields, _):
                        for initializer in fields |table| -> table:
                            table <- bam_report_escape(initializer.value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                    Expr.RecordUpdate(base, fields, _):
                        table <- bam_report_escape(base, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                        for initializer in fields |table| -> table:
                            table <- bam_report_escape(initializer.value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- bam_report_escape(element, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- bam_report_escape(entry.value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                    Expr.If(_, then_value, else_value, _):
                        table <- bam_report_escape(then_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                        table <- bam_report_escape(else_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        table <- bam_report_escape(inner, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                    Expr.Block(block_statements, block_value, _, _):
                        table <- bam_report_escape(block_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, aggregate_result, nested_anchor, true, table)
                    _:
                        pass

        # `name = value`: a fresh binding version holding the value's local-storage roots.
        def bam_escape_track_declaration(declared_name: sview, declared_value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview]&, escape_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                declared_roots: mutable darray[sview] = []
                bam_escape_collect_roots(declared_value, lend_names, lend_positions, escape_names, escape_roots, declared_roots)
                escape_names.push(declared_name)
                escape_roots.push("")
                for declared_root in declared_roots |escape_names, escape_roots|:
                    escape_names.push(declared_name)
                    escape_roots.push(declared_root)

        def bam_escape_track_assign(assign_target: Ast::Expr, assign_value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview]&, escape_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                assigned_name: sview = bam_place_root(assign_target)
                return if assigned_name == ""
                assigned_roots: mutable darray[sview] = []
                bam_escape_collect_roots(assign_value, lend_names, lend_positions, escape_names, escape_roots, assigned_roots)
                # An interior write changes one field/element, not the whole
                # aggregate. Preserve other possibly-borrowed members.
                if bam_place_is_interior(assign_target):
                    existing_roots: darray[sview] = bam_escape_roots_for_binding(assigned_name, escape_names, escape_roots)
                    for existing_root in existing_roots |assigned_roots|:
                        assigned_roots.push(existing_root) if not (any known_root in assigned_roots where known_root == existing_root)
                escape_names.push(assigned_name)
                escape_roots.push("")
                for assigned_root in assigned_roots |escape_names, escape_roots|:
                    escape_names.push(assigned_name)
                    escape_roots.push(assigned_root)

        # The container methods that RETAIN their arguments (stage0's
        # returnBorrowContainerInsertMethods).
        def bam_is_container_insert(method: sview) -> bool:
            can Abort.Panic:
                return when method:
                    "push" | "extend" | "insert" | "put" | "add" | "append" | "push_back" | "push_front" | "set" -> true
                    _ -> false

        # `out.push(&x)` as a statement: the receiver now ALSO holds the arguments' roots, so a
        # later `return out` carries them. The receiver's existing roots stay.
        def bam_escape_track_insert(statement_value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview]&, escape_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement_value:
                    Expr.Call(Expr.Field(insert_receiver, insert_method, _), insert_arguments, _, _):
                        return if not bam_is_container_insert(insert_method)
                        receiver_name: sview = bam_place_root(insert_receiver)
                        return if receiver_name == ""
                        inserted_roots: mutable darray[sview] = []
                        for insert_argument in insert_arguments |inserted_roots|:
                            bam_escape_collect_roots(insert_argument, lend_names, lend_positions, escape_names, escape_roots, inserted_roots)
                        return if inserted_roots.count == 0
                        existing_roots: darray[sview] = bam_escape_roots_for_binding(receiver_name, escape_names, escape_roots)
                        escape_names.push(receiver_name)
                        escape_roots.push("")
                        for existing_root in existing_roots |escape_names, escape_roots|:
                            escape_names.push(receiver_name)
                            escape_roots.push(existing_root)
                        for inserted_root in inserted_roots |escape_names, escape_roots, existing_roots|:
                            if not (any known_root in existing_roots where known_root == inserted_root):
                                escape_names.push(receiver_name)
                                escape_roots.push(inserted_root)
                    _:
                        pass

        def bam_escape_statements[@r](statements: darray[Ast::Stmt], locals: darray[sview]&, perm_containers: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview]& @r, escape_roots: mutable darray[sview]& @r, table: lmut SymbolTable, aggregate_result: bool, direct_reference_result: bool, tail_value: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                statement_index: mutable usize = 0
                for statement in statements |table, statement_index, escape_names, escape_roots| -> table:
                    match statement:
                        Stmt.Return(returned_option, returned_pos):
                            if returned_option is returned_expression:
                                table <- bam_report_escape(returned_expression, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, bam_return_uses_aggregate_diagnostic(returned_expression, aggregate_result, direct_reference_result), Ast::expr_pos(returned_expression), false, table)
                        # A body's tail expression is its return value.
                        Stmt.Expr(tail_expression, tail_pos):
                            is_tail_expression: bool = tail_value and statement_index + 1 == statements.count
                            # A value-form loop (`for v in xs |acc| -> acc:`) keeps its
                            # Expr.Block shape in the loop view: its statements write the
                            # captured names like a loop body, and only its yield is a value.
                            value_block: mutable bool = false
                            match tail_expression:
                                Expr.Block(value_block_statements, value_block_value, _, _):
                                    value_block <- true
                                    block_names: mutable darray[sview] @r = []
                                    block_roots: mutable darray[sview] @r = []
                                    block_names.extend(escape_names)
                                    block_roots.extend(escape_roots)
                                    table <- bam_escape_statements(value_block_statements, locals, perm_containers, lend_names, lend_positions, block_names, block_roots, table, aggregate_result, direct_reference_result, false)
                                    bam_escape_merge_branch(escape_names, escape_roots, block_names, block_roots)
                                    if is_tail_expression and not (value_block_value is Ast::Expr.Invalid):
                                        table <- bam_report_escape(value_block_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, bam_return_uses_aggregate_diagnostic(value_block_value, aggregate_result, direct_reference_result), Ast::expr_pos(value_block_value), false, table)
                                _:
                                    pass
                            if is_tail_expression and not value_block:
                                table <- bam_report_escape(tail_expression, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, bam_return_uses_aggregate_diagnostic(tail_expression, aggregate_result, direct_reference_result), Ast::expr_pos(tail_expression), false, table)
                            elif not value_block:
                                bam_escape_track_insert(tail_expression, lend_names, lend_positions, escape_names, escape_roots)
                        Stmt.VarDecl(declared_name, _, declared_value, _):
                            bam_escape_track_declaration(declared_name, declared_value, lend_names, lend_positions, escape_names, escape_roots)
                        Stmt.Assign(assign_target, _, assign_value, _):
                            bam_escape_track_assign(assign_target, assign_value, lend_names, lend_positions, escape_names, escape_roots)
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            then_names: mutable darray[sview] @r = []
                            then_roots: mutable darray[sview] @r = []
                            else_names: mutable darray[sview] @r = []
                            else_roots: mutable darray[sview] @r = []
                            then_names.extend(escape_names)
                            then_roots.extend(escape_roots)
                            else_names.extend(escape_names)
                            else_roots.extend(escape_roots)
                            table <- bam_escape_statements(branch_then, locals, perm_containers, lend_names, lend_positions, then_names, then_roots, table, aggregate_result, direct_reference_result, false)
                            table <- bam_escape_statements(branch_else, locals, perm_containers, lend_names, lend_positions, else_names, else_roots, table, aggregate_result, direct_reference_result, false)
                            bam_escape_merge_branch(escape_names, escape_roots, then_names, then_roots)
                            bam_escape_merge_branch(escape_names, escape_roots, else_names, else_roots)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            loop_names: mutable darray[sview] @r = []
                            loop_roots: mutable darray[sview] @r = []
                            loop_names.extend(escape_names)
                            loop_roots.extend(escape_roots)
                            table <- bam_escape_statements(loop_body, locals, perm_containers, lend_names, lend_positions, loop_names, loop_roots, table, aggregate_result, direct_reference_result, false)
                            bam_escape_merge_branch(escape_names, escape_roots, loop_names, loop_roots)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            loop_names: mutable darray[sview] @r = []
                            loop_roots: mutable darray[sview] @r = []
                            loop_names.extend(escape_names)
                            loop_roots.extend(escape_roots)
                            table <- bam_escape_statements(for_body, locals, perm_containers, lend_names, lend_positions, loop_names, loop_roots, table, aggregate_result, direct_reference_result, false)
                            bam_escape_merge_branch(escape_names, escape_roots, loop_names, loop_roots)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            table <- bam_escape_statements(block_body, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, table, aggregate_result, direct_reference_result, false)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            base_names: mutable darray[sview] @r = []
                            base_roots: mutable darray[sview] @r = []
                            base_names.extend(escape_names)
                            base_roots.extend(escape_roots)
                            for match_arm in match_arms |table, base_names, base_roots, escape_names, escape_roots| -> table:
                                arm_names: mutable darray[sview] @r = []
                                arm_roots: mutable darray[sview] @r = []
                                arm_names.extend(base_names)
                                arm_roots.extend(base_roots)
                                table <- bam_escape_statements(match_arm.body, locals, perm_containers, lend_names, lend_positions, arm_names, arm_roots, table, aggregate_result, direct_reference_result, false)
                                bam_escape_merge_branch(escape_names, escape_roots, arm_names, arm_roots)
                        _:
                            pass
                    statement_index <- statement_index + 1

        # The root of a BORROW expression: `&place` and the removed `place.ref[T]` shorthand
        # both hand out a reference into `place`'s storage.
        # A cast target that still carries an address: `T&`, `T&?`, `mutable T&`, `cstr`.
        def bam_type_is_address(type_expression: Ast::Expr) -> bool:
            return match type_expression:
                Expr.Ident(name, _): name == "cstr"
                Expr.Unary(operator, operand, _): operator == TokenKind.Ampersand or operator == TokenKind.Lmut or bam_type_is_address(operand)
                Expr.Paren(inner, _): bam_type_is_address(inner)
                _: false

        def bam_annotation_is_static(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Unary(operator, operand, _): operator == TokenKind.Static or bam_annotation_is_static(operand)
                    Expr.Paren(inner, _): bam_annotation_is_static(inner)
                    _: false

        # `&place[i]`: the address of a container ELEMENT (heap/arena storage), not of the
        # local's own frame slot.
        def bam_borrow_is_element(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Unary(operator, operand, _): operator == TokenKind.Ampersand and (operand is Expr.Index(_, _, _))
                    Expr.Paren(inner, _): bam_borrow_is_element(inner)
                    _: false

        def bam_borrow_root(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(borrow_operator, borrow_operand, borrow_pos):
                        "" return if borrow_operator != TokenKind.Ampersand
                        return bam_place_root(borrow_operand)
                    Expr.Index(Expr.Field(borrow_receiver, borrow_selector, borrow_field_pos), borrow_target, borrow_index_pos):
                        # `(&x).cast[T&?]` re-types the address of a local; the result still
                        # points at the local's storage (stage0 returnRefToLocal sees through it).
                        return bam_borrow_root(bam_strip_paren(borrow_receiver)) if borrow_selector == "cast" and bam_type_is_address(borrow_target)
                        "" return if borrow_selector != "ref"
                        return bam_place_root(borrow_receiver)
                    Expr.Paren(borrow_inner, _):
                        return bam_borrow_root(borrow_inner)
                    _:
                        return ""

        # Match the root above with the exact identifier occurrence so closure effects can
        # distinguish local storage from a same-named file global or parameter.
        def bam_borrow_root_position(expression: Ast::Expr) -> (known: bool, position: Ast::Pos):
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, _) if operator == TokenKind.Ampersand:
                        return bam_place_root_position(operand)
                    Expr.Index(Expr.Field(receiver, selector, _), target, _):
                        return bam_borrow_root_position(receiver) if selector == "cast" and bam_type_is_address(target)
                        return bam_place_root_position(receiver) if selector == "ref"
                        return (false, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
                    Expr.Paren(inner, _):
                        return bam_borrow_root_position(inner)
                    _:
                        return (false, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        # Whether a declared result physically contains a reference, following struct fields
        # and value aggregates. `view[T]` and `sview` are borrowed handles in their own right,
        # and their element type does not mean the handle stores those elements by value.
        def bam_type_contains_reference(type_id: u32, visited: mutable darray[u32]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if type_id == 0 or any seen_type in visited where seen_type == type_id
                visited.push(type_id)
                kind: SemTypeKind = interned_kind(type_id, table)
                return true if kind == SemTypeKind.Ref
                if kind == SemTypeKind.Tuple or kind == SemTypeKind.Optional:
                    element_position: mutable u32 = 0
                    while element_position < interned_elem_count(type_id, table) |element_position, visited|:
                        return true if bam_type_contains_reference(interned_elem(type_id, element_position, table), visited, table)
                        element_position <- element_position + 1
                if kind == SemTypeKind.Container and interned_name(type_id, table) != "view":
                    element_position: mutable u32 = 0
                    while element_position < interned_elem_count(type_id, table) |element_position, visited|:
                        return true if bam_type_contains_reference(interned_elem(type_id, element_position, table), visited, table)
                        element_position <- element_position + 1
                if kind == SemTypeKind.Named:
                    owner: sview = interned_name(type_id, table)
                    seen_fields: mutable darray[sview] = []
                    # The owner chain visits exactly the rows of `owner`, in row order.
                    field_row: mutable u32 = struct_field_owner_head(table, owner)
                    while field_row != SYMBOL_INDEX_ROW_NONE |field_row, visited, seen_fields, table, owner|:
                        field_index: usize = field_row.usize()
                        field_name: sview = table.struct_field_name[field_index]
                        if table.struct_field_owner[field_index] == owner and not (any seen_field in seen_fields where seen_field == field_name):
                            seen_fields.push(field_name)
                            field_type_id: u32 = field_type_id_of(table, owner, field_name)
                            return true if bam_type_contains_reference(field_type_id, visited, table)
                        field_row <- table.struct_field_owner_next[field_index]
                    payload_index: mutable usize = 0
                    while payload_index < table.enum_payload_owner.count |payload_index, visited|:
                        return true if table.enum_payload_owner[payload_index] == owner and bam_type_contains_reference(table.enum_payload_type_id[payload_index], visited, table)
                        payload_index <- payload_index + 1
                return false

        # An INTERIOR place (`out.p`, `out[i]`) -- writing one publishes through the target's
        # own storage. A bare `p <- ...` writes the POINTEE of a reference parameter, which is
        # the caller's value and not a place that can hold a borrow.
        def bam_place_is_interior(place: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Field(interior_object, interior_field, interior_field_pos):
                        return true
                    Expr.Index(interior_indexed, interior_index, interior_index_pos):
                        return true
                    Expr.Paren(interior_inner, interior_paren_pos):
                        return bam_place_is_interior(interior_inner)
                    _:
                        return false

        def bam_strip_ref(type_id: u32, table: SymbolTable&) -> u32:
            can Abort.Panic:
                stripped: mutable u32 = type_id
                while interned_kind(stripped, table) == SemTypeKind.Ref |stripped|:
                    stripped <- interned_elem(stripped, 0, table)
                return stripped

        # The declared type of a place rooted at a reference parameter, following fields,
        # elements and the references between them. 0 when any step is unknown -- the typed
        # store checks then stay silent rather than guess.
        def bam_place_type_id(place: Ast::Expr, ref_params: darray[sview]&, ref_param_types: darray[u32]&, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Ident(place_name, _):
                        place_index: usize = bam_index_of(ref_params, place_name)
                        0 return if place_index >= ref_params.count
                        return ref_param_types[place_index]
                    Expr.Field(place_object, place_field, _):
                        object_type: u32 = bam_strip_ref(bam_place_type_id(place_object, ref_params, ref_param_types, table), table)
                        0 return if interned_kind(object_type, table) != SemTypeKind.Named
                        return field_type_id_of(table, interned_name(object_type, table), place_field)
                    Expr.Index(place_indexed, _, _):
                        indexed_type: u32 = bam_strip_ref(bam_place_type_id(place_indexed, ref_params, ref_param_types, table), table)
                        0 return if interned_kind(indexed_type, table) != SemTypeKind.Container
                        return interned_elem(indexed_type, 0, table)
                    Expr.Paren(place_inner, _):
                        return bam_place_type_id(place_inner, ref_params, ref_param_types, table)
                    _:
                        return 0

        def bam_roots_reach_local(value: Ast::Expr, locals: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                value_roots: mutable darray[sview] = []
                bam_escape_collect_roots(value, lend_names, lend_positions, escape_names, escape_roots, value_roots)
                return any value_root in value_roots where (any known_local in locals where known_local == value_root)

        # A call target may be a local reference alias such as `alias = &out`. Follow the
        # flow-insensitive alias links collected for the function to see whether it can
        # designate one of the caller's reference parameters.
        def bam_store_target_reaches_ref(name: sview, ref_params: darray[sview]&, link_names: darray[sview]&, link_targets: darray[sview]&, visited: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if any ref_param in ref_params where ref_param == name
                false return if any visited_name in visited where visited_name == name
                visited.push(name)
                link_row: mutable usize = 0
                while link_row < link_names.count |link_row, visited|:
                    if link_names[link_row] == name and bam_store_target_reaches_ref(link_targets[link_row], ref_params, link_names, link_targets, visited):
                        return true
                    link_row <- link_row + 1
                return false

        def bam_store_target_is_ref(name: sview, ref_params: darray[sview]&, link_names: darray[sview]&, link_targets: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                visited: mutable darray[sview] = []
                return bam_store_target_reaches_ref(name, ref_params, link_names, link_targets, visited)

        # `out.push(v)` into a reference parameter's darray whose element type carries a
        # reference: stage0's analyzeBuiltinDarrayPushCall retention check.
        def bam_store_push(push_call: Ast::Expr, locals: darray[sview]&, ref_params: darray[sview]&, ref_param_types: darray[u32]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, table: lmut SymbolTable) -> bool:
            can Memory.Allocate, Abort.Panic:
                match push_call:
                    Expr.Call(Expr.Field(push_receiver, push_method, _), push_arguments, _, _):
                        push_root: sview = bam_place_root(push_receiver)
                        false return if push_method != "push" or push_arguments.count != 1 or push_root == ""
                        false return if not (any outer in ref_params where outer == push_root)
                        receiver_type: u32 = bam_strip_ref(bam_place_type_id(push_receiver, ref_params, ref_param_types, table), table)
                        false return if interned_kind(receiver_type, table) != SemTypeKind.Container or interned_name(receiver_type, table) != "darray"
                        visited_types: mutable darray[u32] = []
                        false return if not bam_type_contains_reference(interned_elem(receiver_type, 0, table), visited_types, table)
                        if bam_roots_reach_local(push_arguments[0], locals, lend_names, lend_positions, escape_names, escape_roots):
                            anchor: Ast::Pos = bam_escape_anchor(push_arguments[0])
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StoreRefToLocal, name: push_root, pos: anchor, line: anchor.line, expected: "", actual: "", state_code: 1})
                        return true
                    _:
                        return false

        # Map named actual arguments to formal slots only when the callee has one
        # unambiguous declaration. Unknown/overloaded calls stay on the conservative path.
        def bam_call_formal_positions(callee_name: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], table: SymbolTable&, actual_formals: mutable darray[usize]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                declaration_id: mutable DeclId = DeclId{value: 4294967295}
                declaration_count: mutable usize = 0
                symbol_row: mutable u32 = symbol_chain_head(table, callee_name)
                while symbol_row != 4294967295 |declaration_id, declaration_count, symbol_row, table, callee_name|:
                    symbol: Symbol& = &table.symbols[symbol_row.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == callee_name:
                        declaration_id <- symbol.id
                        declaration_count <- declaration_count + 1
                    symbol_row <- table.symbol_name_next[symbol_row.usize()]
                return false if declaration_count != 1

                formal_names: mutable darray[sview] = []
                formal_row: mutable u32 = function_param_chain_head(table, callee_name)
                while formal_row != 4294967295 |formal_names, formal_row, declaration_id|:
                    row: usize = formal_row.usize()
                    if row < table.function_param_declaration_id.count and table.function_param_declaration_id[row].value == declaration_id.value:
                        formal_names.push(table.function_param_name[row])
                    formal_row <- table.function_param_name_next[row]
                used: mutable darray[bool] = []
                while used.count < formal_names.count |used, formal_names|:
                    used.push(false)
                positional: mutable usize = 0
                saw_named: mutable bool = false
                for actual_index in 0..<arguments.count |actual_formals, formal_names, used, positional, saw_named, argument_names|:
                    label: sview = argument_names[actual_index] if actual_index < argument_names.count else ""
                    formal: mutable usize = formal_names.count
                    if label != "":
                        saw_named <- true
                        for formal_index in 0..<formal_names.count |formal, formal_names, label|:
                            formal <- formal_index if formal_names[formal_index] == label
                    else:
                        return false if saw_named
                        while positional < formal_names.count and used[positional] |positional, formal_names, used|:
                            positional <- positional + 1
                        formal <- positional
                        positional <- positional + 1
                    return false if formal >= formal_names.count or used[formal]
                    used[formal] <- true
                    actual_formals.push(formal)
                return true

        def bam_add_store_call_diagnostic(name: sview, position: Ast::Pos, code: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if any prior in table.diagnostics where prior.kind == DiagnosticKind.StoreRefToLocal and prior.pos.offset == position.offset and prior.pos.end_offset == position.end_offset and prior.state_code == code
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StoreRefToLocal, name: name, pos: position, line: position.line, expected: "", actual: "", state_code: code})

        # Runtime call arguments may include hidden receivers/captures. Empty SOURCE_NUMBERS
        # means the runtime list is the source list; zero entries mark hidden values.
        def bam_store_call_argument_state_code(source_numbers: darray[usize], runtime_index: usize) -> u32:
            can Abort.Panic:
                source_number: mutable usize = runtime_index + 1
                if source_numbers.count > 0:
                    source_number <- source_numbers[runtime_index] if runtime_index < source_numbers.count else 0
                return source_number.u32() * 10 + 4 if source_number > 0 else 0

        def bam_store_identity_argument_numbers(argument_count: usize) -> darray[usize]:
            can Memory.Allocate, Abort.Panic:
                source_numbers: mutable darray[usize] = []
                argument_index: mutable usize = 0
                while argument_index < argument_count |argument_index, source_numbers|:
                    source_numbers.push(argument_index + 1)
                    argument_index <- argument_index + 1
                return source_numbers

        # A callback or call without a usable top-level summary has unknown store behavior.
        # Treat each reference argument as a possible destination and each other argument
        # carrying a local root as a source.
        def bam_store_unknown_call_targets(call: Ast::Expr, callee_name: sview, call_arguments: darray[Ast::Expr], source_numbers: darray[usize], synthetic_global_targets: darray[sview], writable_ref_params: darray[sview]&, link_names: darray[sview]&, link_targets: darray[sview]&, locals: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                local_index: mutable dict[sview, bool] = {}
                for local_name in locals |local_index|:
                    local_index <- local_index.put(local_name, true) can Global{Read,Write}
                argument_reaches_local: mutable darray[bool] = []
                reachable_count: mutable usize = 0
                for source_argument in call_arguments |argument_reaches_local, reachable_count, local_index|:
                    source_roots: mutable darray[sview] = []
                    bam_escape_collect_roots(source_argument, lend_names, lend_positions, escape_names, escape_roots, source_roots)
                    source_reaches_local: mutable bool = false
                    local_member: bool = true
                    for source_root in source_roots |source_reaches_local, local_index|:
                        source_reaches_local <- true if local_index.get(source_root) is local_member
                    argument_reaches_local.push(source_reaches_local)
                    reachable_count <- reachable_count + 1 if source_reaches_local
                target: mutable usize = 0
                while target < call_arguments.count |target, table, argument_reaches_local, reachable_count| -> table:
                    target_place: mutable Ast::Expr = bam_strip_paren(call_arguments[target])
                    match target_place:
                        Expr.Unary(TokenKind.Ampersand, address_operand, _):
                            target_place <- address_operand
                        _:
                            pass
                    target_root: sview = bam_place_root(target_place)
                    is_global_target: bool = any global_target in synthetic_global_targets where global_target == target_root
                    if target_root != "" and (is_global_target or bam_store_target_is_ref(target_root, writable_ref_params, link_names, link_targets)):
                        reaches: bool = (reachable_count > 1) if (argument_reaches_local[target]) else (reachable_count > 0)
                        if reaches:
                            code: u32 = bam_store_call_argument_state_code(source_numbers, target)
                            call_pos: Ast::Pos = Ast::expr_pos(call)
                            bam_add_store_call_diagnostic(callee_name, call_pos, code, table)
                    target <- target + 1

        # A local function value may close over the caller's mutable reference parameters and
        # locals. Include those possible captures only when this binding is known to hold a
        # closure; an opaque callback parameter is modeled from its explicit arguments.
        def bam_store_unknown_local_call_targets(call: Ast::Expr, callee_name: sview, callee_pos: Ast::Pos, call_arguments: darray[Ast::Expr], capture_names: darray[sview]&, global_targets: darray[sview]&, global_stores: darray[BorrowLocalCallableGlobalStore]&, writable_ref_params: darray[sview]&, link_names: darray[sview]&, link_targets: darray[sview]&, locals: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                runtime_arguments: mutable darray[Ast::Expr] = []
                source_numbers: mutable darray[usize] = bam_store_identity_argument_numbers(call_arguments.count)
                runtime_arguments.extend(call_arguments)
                for capture_name in capture_names:
                    is_ref_target: bool = any target_name in writable_ref_params where target_name == capture_name
                    is_link_target: bool = any alias_name in link_names where alias_name == capture_name
                    is_local_source: bool = any local_name in locals where local_name == capture_name
                    is_tracked_source: bool = any escaping_name in escape_names where escaping_name == capture_name
                    if is_ref_target or is_link_target or is_local_source or is_tracked_source:
                        runtime_arguments.push(Expr.Ident(capture_name, callee_pos))
                        source_numbers.push(0)
                    if is_local_source:
                        runtime_arguments.push(Expr.Unary(TokenKind.Ampersand, Expr.Ident(capture_name, callee_pos), callee_pos))
                        source_numbers.push(0)
                # Retain the ordinary unknown-call analysis for captured values that may
                # flow through writable reference arguments.
                table <- bam_store_unknown_call_targets(call, callee_name, runtime_arguments, source_numbers, [], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                # Explicit arguments may be lambda parameters, so keep their conservative
                # global-target behavior. Captures are handled below by their exact recorded
                # source/target pair instead of being cross-producted with every global write.
                for global_target in global_targets:
                    target_arguments: mutable darray[Ast::Expr] = []
                    target_numbers: mutable darray[usize] = []
                    target_arguments.extend(call_arguments)
                    target_numbers.extend(bam_store_identity_argument_numbers(call_arguments.count))
                    target_arguments.push(Expr.Ident(global_target, callee_pos))
                    target_numbers.push(0)
                    table <- bam_store_unknown_call_targets(call, callee_name, target_arguments, target_numbers, [global_target], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                # Each captured source is checked only against the global destination it
                # may reach. Keep this separate from the ordinary unknown-call pass above,
                # which also handles captured references passed through writable arguments.
                for store in global_stores:
                    if store.source_is_address and store.source_binding_kind == BORROW_LOCAL_ALIAS_UNKNOWN_ROOT_KIND:
                        # The closure may return or select a local reference through an
                        # unmodeled call, iterator, or pattern projection.
                        bam_add_store_call_diagnostic(callee_name, Ast::expr_pos(call), 0, table)
                        continue
                    if store.source_is_address and store.source_binding_known and store.source_binding_kind != 0:
                        # This path intentionally modeled a known address source as local.
                        # The identity is now retained, so emit that same diagnostic without
                        # resolving a same-spelled name at the invocation site.
                        bam_add_store_call_diagnostic(callee_name, Ast::expr_pos(call), 0, table)
                        continue
                    store_arguments: mutable darray[Ast::Expr] = []
                    store_numbers: mutable darray[usize] = []
                    pair_locals: mutable darray[sview] = []
                    pair_locals.extend(locals)
                    pair_locals.push(store.source_name) if not (any local_name in pair_locals where local_name == store.source_name)
                    store_arguments.push(Expr.Ident(store.source_name, callee_pos))
                    store_numbers.push(0)
                    if store.source_is_address:
                        store_arguments.push(Expr.Unary(TokenKind.Ampersand, Expr.Ident(store.source_name, callee_pos), callee_pos))
                        store_numbers.push(0)
                    store_arguments.push(Expr.Ident(store.target_name, callee_pos))
                    store_numbers.push(0)
                    table <- bam_store_unknown_call_targets(call, callee_name, store_arguments, store_numbers, [store.target_name], writable_ref_params, link_names, link_targets, pair_locals, lend_names, lend_positions, escape_names, escape_roots, table)

        # `ea(out, &x)` where `out` is a reference parameter and `ea` may store its second
        # argument through its first (store_through_summary): the call publishes `&x` into the
        # caller's storage. stage0's queueCallArgumentStoreChecks; state_code 10*(i+1)+4 names
        # the 1-based argument.
        def bam_store_call_through(call: Ast::Expr, specialized_push: bool, source_numbers: darray[usize], locals: darray[sview]&, writable_ref_params: darray[sview]&, link_names: darray[sview]&, link_targets: darray[sview]&, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match call:
                    Expr.Call(Expr.Ident(callee_name, callee_pos), call_arguments, call_argument_names, call_pos):
                        callee_binding_kind, callee_binding_known, callee_binding_id = borrow_reference_site_lookup(reference_sites, function_owner, callee_pos, table)
                        shadowed: bool = callee_binding_kind != 0
                        named_arguments: bool = any argument_name in call_argument_names where argument_name != ""
                        if shadowed:
                            if callee_binding_kind == 2 and callee_binding_known and borrow_local_callable_state(reference_sites.local_callables, callee_binding_id):
                                closure_captures: darray[sview] = borrow_local_callable_captures(reference_sites.local_callables, callee_binding_id)
                                closure_global_targets: darray[sview] = borrow_local_callable_global_targets(reference_sites.local_callables, callee_binding_id)
                                closure_global_stores: darray[BorrowLocalCallableGlobalStore] = borrow_local_callable_global_stores(reference_sites.local_callables, callee_binding_id)
                                table <- bam_store_unknown_local_call_targets(call, callee_name, callee_pos, call_arguments, closure_captures, closure_global_targets, closure_global_stores, writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                            else:
                                table <- bam_store_unknown_call_targets(call, callee_name, call_arguments, source_numbers, [], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                            return
                        if not sts_is_declared(summary, callee_name):
                            table <- bam_store_unknown_call_targets(call, callee_name, call_arguments, source_numbers, [], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                            return
                        return if not sts_has_writable(summary, callee_name)
                        if named_arguments:
                            actual_formals: mutable darray[usize] = []
                            if not bam_call_formal_positions(callee_name, call_arguments, call_argument_names, table, actual_formals):
                                table <- bam_store_unknown_call_targets(call, callee_name, call_arguments, source_numbers, [], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                                return
                            target_actual: mutable usize = 0
                            while target_actual < call_arguments.count |target_actual, table, actual_formals| -> table:
                                formal_target: usize = actual_formals[target_actual]
                                if sts_is_writable(summary, callee_name, formal_target):
                                    target_place: mutable Ast::Expr = bam_strip_paren(call_arguments[target_actual])
                                    match target_place:
                                        Expr.Unary(TokenKind.Ampersand, address_operand, _):
                                            target_place <- address_operand
                                        _:
                                            pass
                                    target_root: sview = bam_place_root(target_place)
                                    if target_root != "" and bam_store_target_is_ref(target_root, writable_ref_params, link_names, link_targets):
                                        reaches: mutable bool = false
                                        source_actual: mutable usize = 0
                                        while source_actual < call_arguments.count and not reaches |source_actual, reaches, actual_formals|:
                                            reaches <- true if source_actual != target_actual and sts_has_pair(summary, callee_name, formal_target, actual_formals[source_actual]) and bam_roots_reach_local(call_arguments[source_actual], locals, lend_names, lend_positions, escape_names, escape_roots)
                                            source_actual <- source_actual + 1
                                        if reaches:
                                            code: u32 = bam_store_call_argument_state_code(source_numbers, target_actual)
                                            bam_add_store_call_diagnostic(callee_name, call_pos, code, table)
                                target_actual <- target_actual + 1
                            return
                        target: mutable usize = 0
                        while target < call_arguments.count |target, table| -> table:
                            if sts_is_writable(summary, callee_name, target):
                                target_place: mutable Ast::Expr = bam_strip_paren(call_arguments[target])
                                match target_place:
                                    Expr.Unary(TokenKind.Ampersand, address_operand, _):
                                        target_place <- address_operand
                                    _:
                                        pass
                                target_root: sview = bam_place_root(target_place)
                                if target_root != "" and bam_store_target_is_ref(target_root, writable_ref_params, link_names, link_targets):
                                    reaches: mutable bool = false
                                    source: mutable usize = 0
                                    while source < call_arguments.count and not reaches |source, reaches|:
                                        reaches <- true if source != target and sts_has_pair(summary, callee_name, target, source) and bam_roots_reach_local(call_arguments[source], locals, lend_names, lend_positions, escape_names, escape_roots)
                                        source <- source + 1
                                    if reaches:
                                        code: u32 = bam_store_call_argument_state_code(source_numbers, target)
                                        bam_add_store_call_diagnostic(callee_name, call_pos, code, table)
                            target <- target + 1
                    Expr.Call(callee, call_arguments, call_argument_names, _):
                        runtime_arguments: mutable darray[Ast::Expr] = []
                        runtime_names: mutable darray[sview] = []
                        runtime_source_numbers: mutable darray[usize] = []
                        call_name: mutable sview = "call"
                        return if specialized_push
                        match callee:
                            Expr.Field(receiver, method_name, _):
                                call_name <- method_name
                                runtime_arguments.push(receiver)
                                runtime_names.push("")
                                runtime_source_numbers.push(0)
                            Expr.Scope(_, scoped_name, _):
                                call_name <- scoped_name
                            _:
                                pass
                        argument_index: mutable usize = 0
                        for call_argument in call_arguments |runtime_arguments, runtime_names, runtime_source_numbers, argument_index, source_numbers|:
                            runtime_arguments.push(call_argument)
                            runtime_names.push(call_argument_names[argument_index]) if argument_index < call_argument_names.count else runtime_names.push("")
                            runtime_source_numbers.push(source_numbers[argument_index]) if source_numbers.count > 0 and argument_index < source_numbers.count else runtime_source_numbers.push(argument_index + 1)
                            argument_index <- argument_index + 1
                        actual_formals: mutable darray[usize] = []
                        if call_name != "call" and bam_call_formal_positions(call_name, runtime_arguments, runtime_names, table, actual_formals):
                            call_pos: Ast::Pos = Ast::expr_pos(call)
                            synthetic_call: Ast::Expr = Expr.Call(Expr.Ident(call_name, Ast::pos_at_line(0)), runtime_arguments, runtime_names, call_pos)
                            table <- bam_store_call_through(synthetic_call, false, runtime_source_numbers, locals, writable_ref_params, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        else:
                            table <- bam_store_unknown_call_targets(call, call_name, runtime_arguments, runtime_source_numbers, [], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                    _:
                        pass

        # Find store-through calls at every immediately evaluated expression site. Lambdas
        # are intentionally opaque because their bodies may run after this frame has ended.
        def bam_store_call_expression(expression: Ast::Expr, locals: darray[sview]&, ref_params: darray[sview]&, writable_ref_params: darray[sview]&, ref_param_types: darray[u32]&, link_names: darray[sview]&, link_targets: darray[sview]&, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return if writable_ref_params.count == 0 and summary.globals.count == 0
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        table <- bam_store_call_expression(callee, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        for argument in arguments |table, reference_sites| -> table:
                            table <- bam_store_call_expression(argument, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        specialized_push: bool = bam_store_push(expression, locals, ref_params, ref_param_types, lend_names, lend_positions, escape_names, escape_roots, table)
                        table <- bam_store_call_through(expression, specialized_push, [], locals, writable_ref_params, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.StaticEffectCall(_, operation, candidates, arguments, argument_names, _):
                        for candidate in candidates |table| -> table:
                            runtime_arguments: mutable darray[Ast::Expr] = []
                            runtime_names: mutable darray[sview] = []
                            runtime_source_numbers: mutable darray[usize] = []
                            for capture in candidate.captures |runtime_arguments|:
                                runtime_arguments.push(capture)
                                runtime_names.push("")
                                runtime_source_numbers.push(0)
                            argument_index: mutable usize = 0
                            for argument in arguments |runtime_arguments, runtime_names, runtime_source_numbers, argument_index, argument_names|:
                                runtime_arguments.push(argument)
                                runtime_names.push(argument_names[argument_index]) if argument_index < argument_names.count else runtime_names.push("")
                                runtime_source_numbers.push(argument_index + 1)
                                argument_index <- argument_index + 1
                            call_pos: Ast::Pos = Ast::expr_pos(expression)
                            synthetic_call: Ast::Expr = Expr.Call(Expr.Ident(candidate.callee, Ast::pos_at_line(0)), runtime_arguments, runtime_names, call_pos)
                            table <- bam_store_call_through(synthetic_call, false, runtime_source_numbers, locals, writable_ref_params, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            for capture in candidate.captures |table, reference_sites| -> table:
                                table <- bam_store_call_expression(capture, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        for argument in arguments |table, reference_sites| -> table:
                            table <- bam_store_call_expression(argument, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        return if candidates.count > 0
                        table <- bam_store_unknown_call_targets(expression, operation, arguments, [], [], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, table)
                    Expr.Scope(base, _, _):
                        table <- bam_store_call_expression(base, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Field(object, _, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Index(object, index, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(index, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.IndexN(object, indices, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        for index in indices |table, reference_sites| -> table:
                            table <- bam_store_call_expression(index, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Slice(object, low, high, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(low, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(high, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Binary(left, _, right, _):
                        table <- bam_store_call_expression(left, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(right, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _) | Expr.RegionNew(operand, _, _):
                        table <- bam_store_call_expression(operand, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.If(condition, then_value, else_value, _):
                        table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        callable_base: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                        table <- bam_store_call_expression(then_value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        then_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                        borrow_restore_local_callables(reference_sites, callable_base)
                        table <- bam_store_call_expression(else_value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        else_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                        borrow_merge_local_callable_states(reference_sites, then_callables, else_callables)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table, reference_sites| -> table:
                            table <- bam_store_call_expression(element, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table, reference_sites| -> table:
                            table <- bam_store_call_expression(entry.key, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            table <- bam_store_call_expression(entry.value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Construct(head, fields, _) | Expr.RecordUpdate(head, fields, _):
                        table <- bam_store_call_expression(head, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        for field in fields |table, reference_sites| -> table:
                            table <- bam_store_call_expression(field.value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- bam_store_call_expression(scrutinee, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        callable_base: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                        joined_callables: mutable darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                        for arm in arms |table, reference_sites| -> table:
                            borrow_restore_local_callables(reference_sites, callable_base)
                            table <- bam_store_call_expression(arm.guard, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            table <- bam_store_call_statements(arm.body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            arm_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            joined_callables <- borrow_join_local_callable_states(joined_callables, arm_callables)
                        borrow_restore_local_callables(reference_sites, joined_callables)
                    Expr.Comprehension(_, iterable, condition, body, _):
                        table <- bam_store_call_expression(iterable, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.Refinement(base, predicate, _):
                        table <- bam_store_call_expression(base, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(predicate, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    Expr.GetElse(guarded, recovery, _):
                        table <- bam_store_call_expression(guarded, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        callable_before_recovery: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                        table <- bam_store_call_statements(recovery, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        callable_after_recovery: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                        borrow_merge_local_callable_states(reference_sites, callable_before_recovery, callable_after_recovery)
                    Expr.Block(body, value, _, _):
                        table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                    _:
                        pass

        def bam_store_call_statements(statements: darray[Ast::Stmt], locals: darray[sview]&, ref_params: darray[sview]&, writable_ref_params: darray[sview]&, ref_param_types: darray[u32]&, link_names: darray[sview]&, link_targets: darray[sview]&, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview]&, escape_roots: darray[sview]&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |table, reference_sites| -> table:
                    match statement:
                        Stmt.VarDecl(name, _, value, declaration_pos):
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            binder_pos: mutable Ast::Pos = source_binder_position(table, name, declaration_pos.line, 0, "__pattern_binder")
                            binder_pos <- declaration_pos if binder_pos.line == 0
                            bam_remember_local_callable(binder_pos, value, function_owner, reference_sites, table, lend_names, lend_positions, summary.globals)
                        Stmt.Assign(target, _, value, _):
                            table <- bam_store_call_expression(target, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            match target:
                                Expr.Ident(_, target_pos):
                                    bam_remember_local_callable(target_pos, value, function_owner, reference_sites, table, lend_names, lend_positions, summary.globals)
                                _:
                                    pass
                        Stmt.Expr(value, _):
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            callable_base: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            table <- bam_store_call_statements(then_body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            then_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            borrow_restore_local_callables(reference_sites, callable_base)
                            table <- bam_store_call_statements(else_body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            else_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            borrow_merge_local_callable_states(reference_sites, then_callables, else_callables)
                        Stmt.While(condition, body, _):
                            table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            loop_callables: mutable darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            callable_changed: mutable bool = true
                            while callable_changed |callable_changed, table, reference_sites|:
                                borrow_restore_local_callables(reference_sites, loop_callables)
                                table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                                body_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                                next_callables: darray[BorrowLocalCallable] = borrow_join_local_callable_states(loop_callables, body_callables)
                                callable_changed <- not borrow_local_callable_states_equal(loop_callables, next_callables)
                                loop_callables <- next_callables
                            borrow_restore_local_callables(reference_sites, loop_callables)
                        Stmt.For(_, _, iterable, body, _):
                            table <- bam_store_call_expression(iterable, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            loop_callables: mutable darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            callable_changed: mutable bool = true
                            while callable_changed |callable_changed, table, reference_sites|:
                                borrow_restore_local_callables(reference_sites, loop_callables)
                                table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                                body_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                                next_callables: darray[BorrowLocalCallable] = borrow_join_local_callable_states(loop_callables, body_callables)
                                callable_changed <- not borrow_local_callable_states_equal(loop_callables, next_callables)
                                loop_callables <- next_callables
                            borrow_restore_local_callables(reference_sites, loop_callables)
                        Stmt.Return(value, _):
                            if value is returned_expression:
                                table <- bam_store_call_expression(returned_expression, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        Stmt.Block(_, _, _, body, _):
                            table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        Stmt.Match(scrutinee, arms, _):
                            table <- bam_store_call_expression(scrutinee, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            callable_base: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            joined_callables: mutable darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            for arm in arms |table, reference_sites| -> table:
                                borrow_restore_local_callables(reference_sites, callable_base)
                                table <- bam_store_call_expression(arm.guard, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                                table <- bam_store_call_statements(arm.body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                                arm_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                                joined_callables <- borrow_join_local_callable_states(joined_callables, arm_callables)
                            borrow_restore_local_callables(reference_sites, joined_callables)
                        Stmt.Contract(_, value, _):
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        _:
                            pass

        def bam_strip_paren(expression: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match expression:
                    Expr.Paren(stripped_inner, _):
                        return bam_strip_paren(stripped_inner)
                    _:
                        return expression

        def bam_store_capture_pattern(pattern: Ast::Pattern, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Pin(name):
                        out.push(name) if name != ""
                    Pattern.As(_, nested) | Pattern.Variant(_, nested) | Pattern.Struct(_, nested) | Pattern.Field(_, nested) | Pattern.Tuple(nested) | Pattern.Or(nested):
                        for child in nested |out|:
                            bam_store_capture_pattern(child, out)
                    _:
                        pass

        def bam_store_capture_expression(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        out.push(name) if name != ""
                    Expr.Call(callee, arguments, _, _):
                        bam_store_capture_expression(callee, out)
                        for argument in arguments |out|:
                            bam_store_capture_expression(argument, out)
                    Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                        bam_store_capture_expression(effect_type, out)
                        for candidate in candidates |out|:
                            for capture in candidate.captures |out|:
                                bam_store_capture_expression(capture, out)
                        for argument in arguments |out|:
                            bam_store_capture_expression(argument, out)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        bam_store_capture_expression(object, out)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        bam_store_capture_expression(object, out)
                        bam_store_capture_expression(index, out)
                    Expr.Slice(object, low, high, _):
                        bam_store_capture_expression(object, out)
                        bam_store_capture_expression(low, out)
                        bam_store_capture_expression(high, out)
                    Expr.IndexN(object, indices, _):
                        bam_store_capture_expression(object, out)
                        for index in indices |out|:
                            bam_store_capture_expression(index, out)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _) | Expr.RegionNew(operand, _, _):
                        bam_store_capture_expression(operand, out)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |out|:
                            bam_store_capture_expression(element, out)
                    Expr.DictLit(entries, _):
                        for entry in entries |out|:
                            bam_store_capture_expression(entry.key, out)
                            bam_store_capture_expression(entry.value, out)
                    Expr.Construct(head, fields, _) | Expr.RecordUpdate(head, fields, _):
                        bam_store_capture_expression(head, out)
                        for field in fields |out|:
                            bam_store_capture_expression(field.value, out)
                    Expr.If(condition, then_value, else_value, _):
                        bam_store_capture_expression(condition, out)
                        bam_store_capture_expression(then_value, out)
                        bam_store_capture_expression(else_value, out)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        bam_store_capture_expression(scrutinee, out)
                        for arm in arms |out|:
                            bam_store_capture_pattern(arm.pattern, out)
                            bam_store_capture_expression(arm.guard, out)
                            bam_store_capture_statements(arm.body, out)
                    Expr.Comprehension(_, iterable, condition, body, _):
                        bam_store_capture_expression(iterable, out)
                        bam_store_capture_expression(condition, out)
                        bam_store_capture_expression(body, out)
                    Expr.Refinement(base, predicate, _):
                        bam_store_capture_expression(base, out)
                        bam_store_capture_expression(predicate, out)
                    Expr.GetElse(guarded, recovery, _):
                        bam_store_capture_expression(guarded, out)
                        bam_store_capture_statements(recovery, out)
                    Expr.Lambda(_, body, _):
                        bam_store_capture_statements(body, out)
                    Expr.Block(statements, value, captures, _):
                        for capture in captures |out|:
                            out.push(capture) if capture != ""
                        bam_store_capture_statements(statements, out)
                        bam_store_capture_expression(value, out)
                    _:
                        pass

        def bam_store_capture_statements(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Expr(expression, _):
                            bam_store_capture_expression(expression, out)
                        Stmt.VarDecl(_, _, value, _):
                            bam_store_capture_expression(value, out)
                        Stmt.Assign(target, _, value, _):
                            bam_store_capture_expression(target, out)
                            bam_store_capture_expression(value, out)
                        Stmt.If(condition, then_body, else_body, _):
                            bam_store_capture_expression(condition, out)
                            bam_store_capture_statements(then_body, out)
                            bam_store_capture_statements(else_body, out)
                        Stmt.While(condition, body, _):
                            bam_store_capture_expression(condition, out)
                            bam_store_capture_statements(body, out)
                        Stmt.For(_, _, iterable, body, _):
                            bam_store_capture_expression(iterable, out)
                            bam_store_capture_statements(body, out)
                        Stmt.Block(_, _, _, body, _):
                            bam_store_capture_statements(body, out)
                        Stmt.Match(scrutinee, arms, _):
                            bam_store_capture_expression(scrutinee, out)
                            for arm in arms |out|:
                                bam_store_capture_pattern(arm.pattern, out)
                                bam_store_capture_expression(arm.guard, out)
                                bam_store_capture_statements(arm.body, out)
                        Stmt.Return(value, _):
                            if value is returned:
                                bam_store_capture_expression(returned, out)
                        Stmt.Contract(_, value, _):
                            bam_store_capture_expression(value, out)
                        _:
                            pass

        def bam_store_local_alias_add_root(alias_id: BindingId, root_id: BindingId, root_kind: u8, root_name: sview, root_known: bool, facts: mutable darray[BorrowLocalCallableAliasRoot]&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                false return if root_name == ""
                false return if any prior in facts where ownership_binding_ids_equal(prior.alias_binding_id, alias_id) and ownership_binding_ids_equal(prior.root_binding_id, root_id) and prior.root_binding_kind == root_kind and prior.root_binding_known == root_known
                facts.push(BorrowLocalCallableAliasRoot{alias_binding_id: alias_id, root_binding_id: root_id, root_binding_kind: root_kind, root_name: root_name, root_binding_known: root_known})
                return true

        def bam_store_local_alias_add_unknown_root(alias_id: BindingId, facts: mutable darray[BorrowLocalCallableAliasRoot]&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                unknown_id: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                return bam_store_local_alias_add_root(alias_id, unknown_id, BORROW_LOCAL_ALIAS_UNKNOWN_ROOT_KIND, "<unknown-local-alias>", false, facts)

        def bam_store_local_alias_add_edge(alias_id: BindingId, source_id: BindingId, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if ownership_binding_ids_equal(alias_id, source_id)
                return if any prior in edges where ownership_binding_ids_equal(prior.alias_binding_id, alias_id) and ownership_binding_ids_equal(prior.source_binding_id, source_id)
                edges.push(BorrowLocalCallableAliasEdge{alias_binding_id: alias_id, source_binding_id: source_id})

        # Resolve closure aliases by lexical BindingIds. One AST pass collects direct
        # roots and alias edges; the worklist propagates roots through chains regardless
        # of source order. Nested lambdas are scanned separately by the expression walker.
        def bam_store_local_alias_value(alias_id: BindingId, value: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                direct_root: sview = bam_borrow_root(value)
                direct_root_known, direct_root_position = bam_borrow_root_position(value)
                if direct_root != "" and direct_root_known:
                    root_kind, root_binding_known, root_id = borrow_reference_site_lookup(reference_sites, owner, direct_root_position, table)
                    if root_kind != 0 and root_binding_known:
                        bam_store_local_alias_add_root(alias_id, root_id, root_kind, direct_root, true, facts)
                        return
                match value:
                    Expr.Ident(_, position):
                        source_known, source_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        if source_known:
                            bam_store_local_alias_add_edge(alias_id, source_id, edges)
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: mutable sview = ""
                        callee_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                        callee_kind: mutable u8 = 0
                        bare_callee: mutable bool = false
                        qualified_callee: mutable bool = false
                        match callee:
                            Expr.Ident(name, position):
                                callee_name <- name
                                callee_position <- position
                                callee_kind <- borrow_reference_site_kind(reference_sites, owner, position, table)
                                bare_callee <- true
                            Expr.Scope(_, name, position) | Expr.Field(_, name, position):
                                callee_name <- name
                                callee_position <- position
                                qualified_callee <- true
                            _:
                                pass
                        has_named_arguments: bool = argument_names.count > 0 and (argument_names.count != arguments.count or any argument_name in argument_names where argument_name != "")
                        if bare_callee and callee_kind == 0 and not has_named_arguments:
                            # Exact positional summaries retain the narrow, resolved path.
                            lender_index: mutable usize = 0
                            while lender_index < lend_names.count and lender_index < lend_positions.count |lender_index, alias_id, arguments, callee_name, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                if lend_names[lender_index] == callee_name:
                                    argument_index: usize = lend_positions[lender_index]
                                    if argument_index < arguments.count:
                                        bam_store_local_alias_value(alias_id, arguments[argument_index], owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                lender_index <- lender_index + 1
                        else:
                            known_lender: bool = callee_name != "" and (any lender_name in lend_names where lender_name == callee_name)
                            if known_lender:
                                # The summary has no formal labels or qualified owner. Union
                                # argument provenance so named and qualified calls cannot
                                # discard a possible borrowed result.
                                for argument in arguments |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                    bam_store_local_alias_value(alias_id, argument, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                match callee:
                                    Expr.Field(receiver, _, _):
                                        bam_store_local_alias_value(alias_id, receiver, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        pass
                            elif (bare_callee and callee_kind == 2) or qualified_callee or not bare_callee:
                                # A local callable, method, qualified call, or computed callee
                                # can return a captured/local reference without a usable
                                # lender summary. Keep argument/receiver roots and add an
                                # explicit maybe-local marker for a later global-store check.
                                bam_store_local_alias_add_unknown_root(alias_id, facts)
                                for argument in arguments |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                    bam_store_local_alias_value(alias_id, argument, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                match callee:
                                    Expr.Field(receiver, _, _) | Expr.Scope(receiver, _, _):
                                        bam_store_local_alias_value(alias_id, receiver, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        pass
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        bam_store_local_alias_value(alias_id, inner, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_value(alias_id, element, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        for field in fields |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_value(alias_id, field.value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.DictLit(entries, _):
                        for entry in entries |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_value(alias_id, entry.value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.If(_, then_value, else_value, _):
                        bam_store_local_alias_value(alias_id, then_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_value(alias_id, else_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Block(statements, block_value, _, _):
                        bam_store_local_alias_statements(statements, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_value(alias_id, block_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Match(scrutinee, arms, match_pos) | Expr.Catch(scrutinee, arms, match_pos):
                        for arm in arms |alias_id, scrutinee, match_pos, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_pattern(arm.pattern, scrutinee, match_pos, true, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(arm.body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(arm_value, _):
                                        bam_store_local_alias_value(alias_id, arm_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    Stmt.Return(arm_value_option, _):
                                        if arm_value_option is arm_return_value:
                                            bam_store_local_alias_value(alias_id, arm_return_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        pass
                    _:
                        pass

        # Whole-value pattern bindings retain exact provenance. Destructuring projections
        # may select a reference from an opaque aggregate, so bind those names to a
        # conservative marker instead of silently treating them as non-aliases.
        def bam_store_local_alias_pattern_name(name: sview, value: Ast::Expr, position: Ast::Pos, whole_value: bool, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                binder_position: Ast::Pos = source_binder_position(table, name, position.line, 0, "__pattern_binder")
                if binder_position.line > 0:
                    binder_known, binder_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                    if binder_known:
                        if whole_value:
                            bam_store_local_alias_value(binder_id, value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        else:
                            bam_store_local_alias_add_unknown_root(binder_id, facts)

        def bam_store_local_alias_pattern(pattern: Ast::Pattern, value: Ast::Expr, position: Ast::Pos, whole_value: bool, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        bam_store_local_alias_pattern_name(name, value, position, whole_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Pattern.Rest(name):
                        bam_store_local_alias_pattern_name(name, value, position, false, owner, reference_sites, table, lend_names, lend_positions, facts, edges) if name != ""
                    Pattern.As(name, inner):
                        bam_store_local_alias_pattern_name(name, value, position, whole_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_pattern(inner, value, position, whole_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Pattern.Or(options):
                        for option in options |value, position, whole_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_pattern(option, value, position, whole_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children):
                        for child in children |value, position, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_pattern(child, value, position, false, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    _:
                        pass

        # Preserve resolver identities for destructuring assignments. Matching aggregate
        # shapes pair each binding with its own RHS; when the shape is not statically
        # matched, union the possible RHS roots into every target leaf conservatively.
        def bam_store_local_alias_assignment(target: Ast::Expr, value: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                target_value: Ast::Expr = bam_strip_paren(target)
                source_value: Ast::Expr = bam_strip_paren(value)
                match target_value:
                    Expr.Array(targets, _):
                        match source_value:
                            Expr.Array(values, _) | Expr.Tuple(values, _):
                                if values.count == targets.count:
                                    index: mutable usize = 0
                                    while index < targets.count |index, targets, values, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                        bam_store_local_alias_assignment(targets[index], values[index], owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                        index <- index + 1
                                    return
                            _:
                                pass
                        for child in targets |source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_assignment(child, source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Tuple(targets, _):
                        match source_value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                if values.count == targets.count:
                                    index: mutable usize = 0
                                    while index < targets.count |index, targets, values, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                        bam_store_local_alias_assignment(targets[index], values[index], owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                        index <- index + 1
                                    return
                            _:
                                pass
                        for child in targets |source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_assignment(child, source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Ident(_, position):
                        binding_known, alias_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        if binding_known:
                            bam_store_local_alias_value(alias_id, source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    _:
                        pass

        def bam_store_local_alias_statements(statements: darray[Ast::Stmt], owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                    match statement:
                        Stmt.VarDecl(name, _, value, line):
                            binding_position: Ast::Pos = source_binder_position(table, name, line.line, 0, "__pattern_binder")
                            binding_position <- line if binding_position.line == 0
                            binding_known, alias_id = borrow_reference_site_binding(reference_sites, owner, binding_position, table)
                            if binding_known:
                                bam_store_local_alias_value(alias_id, value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_expression(value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Assign(target, _, value, _):
                            bam_store_local_alias_assignment(target, value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_expression(value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Expr(expression, _):
                            bam_store_local_alias_expression(expression, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.If(condition, then_body, else_body, _):
                            bam_store_local_alias_expression(condition, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(then_body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(else_body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.While(condition, body, _):
                            bam_store_local_alias_expression(condition, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.For(_, variables, iterable, body, for_pos):
                            bam_store_local_alias_expression(iterable, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            # A literal collection gives a bounded, exact candidate set for
                            # a single loop variable. Opaque iterables and multi-binder
                            # unpacking are left to the ordinary direct-borrow paths.
                            if variables.count == 1:
                                match iterable:
                                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                                        binder_position: Ast::Pos = source_binder_position(table, variables[0], for_pos.line, 0, "__for_binder")
                                        if binder_position.line > 0:
                                            binder_known, binder_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                                            if binder_known:
                                                for element in elements |binder_id, elements, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                                    bam_store_local_alias_value(binder_id, element, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        binder_position: Ast::Pos = source_binder_position(table, variables[0], for_pos.line, 0, "__for_binder")
                                        if binder_position.line > 0:
                                            binder_known, binder_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                                            if binder_known:
                                                # An opaque iterable can carry local references
                                                # through its element binder. Preserve any known
                                                # roots from the iterable and fail closed when
                                                # the element is later stored globally.
                                                bam_store_local_alias_value(binder_id, iterable, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                                bam_store_local_alias_add_unknown_root(binder_id, facts)
                            bam_store_local_alias_statements(body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Block(_, _, _, body, _):
                            bam_store_local_alias_statements(body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Match(scrutinee, arms, match_pos):
                            bam_store_local_alias_expression(scrutinee, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            for arm in arms |scrutinee, match_pos, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                bam_store_local_alias_pattern(arm.pattern, scrutinee, match_pos, true, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                bam_store_local_alias_expression(arm.guard, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                bam_store_local_alias_statements(arm.body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Return(value, _):
                            if value is returned:
                                bam_store_local_alias_expression(returned, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Contract(_, value, _):
                            bam_store_local_alias_expression(value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        _:
                            pass

        def bam_store_local_alias_expression(expression: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Lambda(_, _, _):
                        pass
                    Expr.Call(callee, arguments, _, _):
                        bam_store_local_alias_expression(callee, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        for argument in arguments |owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_expression(argument, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.Move(object, _) | Expr.Paren(object, _) | Expr.RegionNew(object, _, _):
                        bam_store_local_alias_expression(object, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        bam_store_local_alias_expression(object, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(index, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Slice(object, low, high, _):
                        bam_store_local_alias_expression(object, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(low, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(high, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.IndexN(object, indices, _):
                        bam_store_local_alias_expression(object, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        for index in indices |owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_expression(index, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_expression(element, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.DictLit(entries, _):
                        for entry in entries |owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_expression(entry.key, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_expression(entry.value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Construct(head, fields, _) | Expr.RecordUpdate(head, fields, _):
                        bam_store_local_alias_expression(head, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        for field in fields |owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_expression(field.value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.If(condition, then_value, else_value, _):
                        bam_store_local_alias_expression(condition, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(then_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(else_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Match(scrutinee, arms, match_pos) | Expr.Catch(scrutinee, arms, match_pos):
                        bam_store_local_alias_expression(scrutinee, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        for arm in arms |scrutinee, match_pos, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_expression(arm.guard, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(arm.body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Comprehension(_, iterable, condition, body, _):
                        bam_store_local_alias_expression(iterable, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(condition, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Refinement(base, predicate, _):
                        bam_store_local_alias_expression(base, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(predicate, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.GetElse(guarded, recovery, _):
                        bam_store_local_alias_expression(guarded, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_statements(recovery, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Block(statements, value, _, _):
                        bam_store_local_alias_statements(statements, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_expression(value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    _:
                        pass

        def bam_store_local_alias_roots(statements: darray[Ast::Stmt], owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, inherited: darray[BorrowLocalCallableAliasRoot]&) -> darray[BorrowLocalCallableAliasRoot]:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                facts: mutable darray[BorrowLocalCallableAliasRoot] = []
                facts.extend(inherited)
                edges: mutable darray[BorrowLocalCallableAliasEdge] = []
                bam_store_local_alias_statements(statements, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                pending: mutable darray[BorrowLocalCallableAliasRoot] = []
                pending.extend(facts)
                pending_index: mutable usize = 0
                while pending_index < pending.count |pending_index, pending, edges, facts|:
                    source: BorrowLocalCallableAliasRoot = pending[pending_index]
                    pending_index <- pending_index + 1
                    for edge in edges |source, facts, pending|:
                        if ownership_binding_ids_equal(edge.source_binding_id, source.alias_binding_id):
                            if bam_store_local_alias_add_root(edge.alias_binding_id, source.root_binding_id, source.root_binding_kind, source.root_name, source.root_binding_known, facts):
                                pending.push(BorrowLocalCallableAliasRoot{alias_binding_id: edge.alias_binding_id, root_binding_id: source.root_binding_id, root_binding_kind: source.root_binding_kind, root_name: source.root_name, root_binding_known: source.root_binding_known})
                return facts

        def bam_store_global_target_expression(expression: Ast::Expr, global_names: darray[sview]&, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, captures: darray[sview]&, stores: mutable darray[BorrowLocalCallableGlobalStore]&, aliases: darray[BorrowLocalCallableAliasRoot]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Call(Expr.Lambda(_, lambda_body, _), arguments, _, _):
                        lambda_aliases: darray[BorrowLocalCallableAliasRoot] = bam_store_local_alias_roots(lambda_body, owner, reference_sites, table, lend_names, lend_positions, aliases)
                        bam_store_global_target_statements(lambda_body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, lambda_aliases, out)
                        for argument in arguments |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(argument, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Lambda(_, _, _):
                                pass
                            _:
                                bam_store_global_target_expression(callee, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        for argument in arguments |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(argument, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        for candidate in candidates |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            for capture in candidate.captures |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                                bam_store_global_target_expression(capture, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        for argument in arguments |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(argument, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        bam_store_global_target_expression(object, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        bam_store_global_target_expression(object, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(index, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Slice(object, low, high, _):
                        bam_store_global_target_expression(object, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(low, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(high, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.IndexN(object, indices, _):
                        bam_store_global_target_expression(object, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        for index in indices |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(index, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _) | Expr.RegionNew(operand, _, _):
                        bam_store_global_target_expression(operand, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(element, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.DictLit(entries, _):
                        for entry in entries |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(entry.key, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            bam_store_global_target_expression(entry.value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Construct(head, fields, _) | Expr.RecordUpdate(head, fields, _):
                        bam_store_global_target_expression(head, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        for field in fields |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(field.value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.If(condition, then_value, else_value, _):
                        bam_store_global_target_expression(condition, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(then_value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(else_value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        bam_store_global_target_expression(scrutinee, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        for arm in arms |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                            bam_store_global_target_expression(arm.guard, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            bam_store_global_target_statements(arm.body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Comprehension(_, iterable, condition, body, _):
                        bam_store_global_target_expression(iterable, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(condition, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Refinement(base, predicate, _):
                        bam_store_global_target_expression(base, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(predicate, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.GetElse(guarded, recovery, _):
                        bam_store_global_target_expression(guarded, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_statements(recovery, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    Expr.Lambda(_, lambda_body, _):
                        # Conservatively include effects of a nested closure stored in a
                        # local. The binding/call flow for nested function values is not
                        # tracked here, so omitting its body could miss a global write when
                        # that local closure is invoked by the outer closure.
                        lambda_aliases: darray[BorrowLocalCallableAliasRoot] = bam_store_local_alias_roots(lambda_body, owner, reference_sites, table, lend_names, lend_positions, aliases)
                        bam_store_global_target_statements(lambda_body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, lambda_aliases, out)
                    Expr.Block(statements, value, _, _):
                        bam_store_global_target_statements(statements, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        bam_store_global_target_expression(value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                    _:
                        pass

        def bam_store_global_target_place(place: Ast::Expr, global_names: darray[sview]&, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match place:
                    # Multiple assignment is represented as an array/tuple of independent
                    # places. Inspect each leaf so a closure's global effects include every
                    # destination, including nested destructuring targets.
                    Expr.Array(targets, _) | Expr.Tuple(targets, _):
                        for target in targets |global_names, owner, reference_sites, table, out|:
                            bam_store_global_target_place(target, global_names, owner, reference_sites, table, out)
                    _:
                        target_name: sview = bam_place_root(place)
                        root_position_known, root_position = bam_place_root_position(place)
                        root_is_local: mutable bool = false
                        if root_position_known:
                            root_is_local <- borrow_reference_site_is_local(reference_sites, owner, root_position, table)
                        if target_name != "" and (any global_name in global_names where global_name == target_name) and not root_is_local:
                            out.push(target_name) if not (any prior in out where prior == target_name)

        # Preserve source/destination correspondence in multiple assignment. The parser
        # represents destructuring places and their RHS values as matching Array/Tuple
        # trees; only pair corresponding leaves when both shapes and lengths agree.
        # When a single global destination receives an aggregate, inspect its aggregate
        # elements as possible stored references, always pairing them with that one target.
        def bam_store_global_target_source_pairs(target: Ast::Expr, value: Ast::Expr, global_names: darray[sview]&, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, captures: darray[sview]&, stores: mutable darray[BorrowLocalCallableGlobalStore]&, aliases: darray[BorrowLocalCallableAliasRoot]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                target_value: Ast::Expr = bam_strip_paren(target)
                source_value: Ast::Expr = bam_strip_paren(value)
                match target_value:
                    Expr.Array(targets, _):
                        match source_value:
                            Expr.Array(values, _):
                                if targets.count == values.count:
                                    index: mutable usize = 0
                                    while index < targets.count |index, targets, values, global_names, owner, reference_sites, table, captures, stores, aliases|:
                                        bam_store_global_target_source_pairs(targets[index], values[index], global_names, owner, reference_sites, table, captures, stores, aliases)
                                        index <- index + 1
                                    return
                            _:
                                pass
                    Expr.Tuple(targets, _):
                        match source_value:
                            Expr.Tuple(values, _):
                                if targets.count == values.count:
                                    index: mutable usize = 0
                                    while index < targets.count |index, targets, values, global_names, owner, reference_sites, table, captures, stores, aliases|:
                                        bam_store_global_target_source_pairs(targets[index], values[index], global_names, owner, reference_sites, table, captures, stores, aliases)
                                        index <- index + 1
                                    return
                            _:
                                pass
                    _:
                        pass
                match source_value:
                    Expr.Array(values, _) | Expr.Tuple(values, _):
                        for source_element in values |target, global_names, owner, reference_sites, table, captures, stores, aliases|:
                            bam_store_global_target_source_pairs(target, source_element, global_names, owner, reference_sites, table, captures, stores, aliases)
                        return
                    _:
                        pass
                target_names: mutable darray[sview] = []
                bam_store_global_target_place(target, global_names, owner, reference_sites, table, target_names)
                source_name: sview = bam_borrow_root(source_value)
                source_known, source_position = bam_borrow_root_position(source_value)
                source_binding_kind: mutable u8 = 0
                source_binding_known: mutable bool = false
                source_binding_id: mutable BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                if source_known:
                    resolved_kind, resolved_known, resolved_id = borrow_reference_site_lookup(reference_sites, owner, source_position, table)
                    source_binding_kind <- resolved_kind
                    source_binding_known <- resolved_known
                    source_binding_id <- resolved_id
                source_may_be_local: bool = source_binding_kind != 0
                for target_name in target_names |stores, source_name, source_may_be_local, source_binding_kind, source_binding_known, source_binding_id|:
                    if source_may_be_local:
                        # A direct source with a borrow root (`&`, `.ref`, or an
                        # address-preserving cast) is modeled by its underlying address.
                        # Retain the exact root so an invocation cannot resolve a shadowing
                        # same-spelled local instead.
                        known_pair: bool = any prior in stores where prior.source_name == source_name and prior.target_name == target_name and prior.source_is_address and prior.source_binding_known == source_binding_known and prior.source_binding_kind == source_binding_kind and (not source_binding_known or ownership_binding_ids_equal(prior.source_binding_id, source_binding_id))
                        stores.push(BorrowLocalCallableGlobalStore{source_name: source_name, target_name: target_name, source_is_address: true, source_binding_id: source_binding_id, source_binding_known: source_binding_known, source_binding_kind: source_binding_kind}) if not known_pair
                source_is_local_alias: mutable bool = false
                match source_value:
                    Expr.Ident(_, position):
                        alias_binding_known, alias_binding_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        if alias_binding_known:
                            for alias in aliases |source_is_local_alias, alias_binding_id|:
                                if ownership_binding_ids_equal(alias.alias_binding_id, alias_binding_id):
                                    source_is_local_alias <- true
                                    for target_name in target_names |stores, alias|:
                                        known_pair: bool = any prior in stores where prior.source_name == alias.root_name and prior.target_name == target_name and prior.source_is_address and prior.source_binding_known == alias.root_binding_known and prior.source_binding_kind == alias.root_binding_kind and (not alias.root_binding_known or ownership_binding_ids_equal(prior.source_binding_id, alias.root_binding_id))
                                        stores.push(BorrowLocalCallableGlobalStore{source_name: alias.root_name, target_name: target_name, source_is_address: true, source_binding_id: alias.root_binding_id, source_binding_known: alias.root_binding_known, source_binding_kind: alias.root_binding_kind}) if not known_pair
                    _:
                        pass
                raw_sources: mutable darray[sview] = []
                bam_store_capture_expression(source_value, raw_sources)
                for target_name in target_names |raw_sources, stores, source_is_local_alias|:
                    for raw_source in raw_sources |target_name, captures, stores, source_is_local_alias|:
                        if any capture_name in captures where capture_name == raw_source and not source_is_local_alias:
                            known_pair: bool = any prior in stores where prior.source_name == raw_source and prior.target_name == target_name and not prior.source_is_address
                            stores.push(BorrowLocalCallableGlobalStore{source_name: raw_source, target_name: target_name, source_is_address: false, source_binding_id: BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}, source_binding_known: false, source_binding_kind: 0}) if not known_pair

        def bam_store_global_target_statements(statements: darray[Ast::Stmt], global_names: darray[sview]&, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, captures: darray[sview]&, stores: mutable darray[BorrowLocalCallableGlobalStore]&, aliases: darray[BorrowLocalCallableAliasRoot]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                    match statement:
                        Stmt.Assign(target, _, value, _):
                            assignment_targets: mutable darray[sview] = []
                            bam_store_global_target_place(target, global_names, owner, reference_sites, table, assignment_targets)
                            bam_store_global_target_source_pairs(target, value, global_names, owner, reference_sites, table, captures, stores, aliases) if assignment_targets.count > 0
                            for target_name in assignment_targets |out|:
                                out.push(target_name) if not (any prior in out where prior == target_name)
                            bam_store_global_target_expression(target, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            bam_store_global_target_expression(value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.Expr(expression, _):
                            bam_store_global_target_expression(expression, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.VarDecl(_, _, value, _):
                            bam_store_global_target_expression(value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.If(condition, then_body, else_body, _):
                            bam_store_global_target_expression(condition, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            bam_store_global_target_statements(then_body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            bam_store_global_target_statements(else_body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.While(condition, body, _):
                            bam_store_global_target_expression(condition, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            bam_store_global_target_statements(body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.For(_, _, iterable, body, _):
                            bam_store_global_target_expression(iterable, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            bam_store_global_target_statements(body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.Block(_, _, _, body, _):
                            bam_store_global_target_statements(body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.Match(scrutinee, arms, _):
                            bam_store_global_target_expression(scrutinee, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                            for arm in arms |global_names, owner, reference_sites, table, captures, stores, aliases, out|:
                                bam_store_global_target_expression(arm.guard, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                                bam_store_global_target_statements(arm.body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.Return(value, _):
                            if value is returned:
                                bam_store_global_target_expression(returned, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        Stmt.Contract(_, value, _):
                            bam_store_global_target_expression(value, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, stores, aliases, out)
                        _:
                            pass

        def bam_store_merge_capture_names(target: mutable darray[sview]&, source: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for capture in source |target|:
                    target.push(capture) if not (any prior in target where prior == capture)

        def bam_store_merge_global_stores(target: mutable darray[BorrowLocalCallableGlobalStore]&, source: darray[BorrowLocalCallableGlobalStore]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for store in source |target|:
                    known_pair: bool = any prior in target where prior.source_name == store.source_name and prior.target_name == store.target_name and prior.source_is_address == store.source_is_address and prior.source_binding_known == store.source_binding_known and prior.source_binding_kind == store.source_binding_kind and (not prior.source_binding_known or ownership_binding_ids_equal(prior.source_binding_id, store.source_binding_id))
                    target.push(store) if not known_pair

        # Track only closure values that are syntactically known. Unknown function values
        # (including ordinary callback parameters) must not make every local look captured.
        def bam_value_is_local_callable(value: Ast::Expr, owner: DeclId, reference_sites: BorrowReferenceSites&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match value:
                    Expr.Lambda(_, _, _):
                        return true
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return bam_value_is_local_callable(inner, owner, reference_sites, table)
                    Expr.Ident(_, position):
                        return borrow_reference_site_is_local_callable(reference_sites, owner, position, table)
                    Expr.If(_, then_value, else_value, _):
                        return bam_value_is_local_callable(then_value, owner, reference_sites, table) or bam_value_is_local_callable(else_value, owner, reference_sites, table)
                    Expr.Block(_, block_value, _, _):
                        return bam_value_is_local_callable(block_value, owner, reference_sites, table)
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        for arm in arms:
                            return true if bam_store_statement_tail_is_local_callable(arm.body, owner, reference_sites, table)
                        return false
                    Expr.GetElse(guarded, recovery, _):
                        return bam_value_is_local_callable(guarded, owner, reference_sites, table) or bam_store_statement_tail_is_local_callable(recovery, owner, reference_sites, table)
                    _:
                        return false

        def bam_store_statement_tail_is_local_callable(statements: darray[Ast::Stmt], owner: DeclId, reference_sites: BorrowReferenceSites&, table: SymbolTable&) -> bool:
            can Abort.Panic, Global{Read,Write}:
                return false if statements.count == 0
                match statements[statements.count - 1]:
                    Stmt.Expr(expression, _):
                        return bam_value_is_local_callable(expression, owner, reference_sites, table)
                    Stmt.Return(value, _):
                        if value is returned:
                            return bam_value_is_local_callable(returned, owner, reference_sites, table)
                        return false
                    _:
                        return false

        def bam_value_local_callable_captures(value: Ast::Expr, owner: DeclId, reference_sites: BorrowReferenceSites&, table: SymbolTable&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                captures: mutable darray[sview] = []
                match value:
                    Expr.Lambda(_, body, _):
                        all_uses: mutable darray[sview] = []
                        # This name-only collector cannot distinguish an inner binder from an
                        # outer same-spelled reference in a sibling/nested scope. Retain every
                        # used name as a possible capture: ambiguous names may add a
                        # conservative warning, but subtracting them by spelling can silently
                        # miss a real escape. Global-store pairs below are still tied to their
                        # own syntactic borrowed root, so this fallback does not cross-product
                        # unrelated captures with global destinations.
                        bam_store_capture_statements(body, all_uses)
                        for use_name in all_uses |captures|:
                            captures.push(use_name) if not (any prior in captures where prior == use_name)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        captures <- bam_value_local_callable_captures(inner, owner, reference_sites, table)
                    Expr.Ident(_, position):
                        known, binding_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        captures <- borrow_local_callable_captures(reference_sites.local_callables, binding_id) if known
                    Expr.If(_, then_value, else_value, _):
                        then_captures: darray[sview] = bam_value_local_callable_captures(then_value, owner, reference_sites, table)
                        else_captures: darray[sview] = bam_value_local_callable_captures(else_value, owner, reference_sites, table)
                        bam_store_merge_capture_names(captures, then_captures)
                        bam_store_merge_capture_names(captures, else_captures)
                    Expr.Block(_, block_value, _, _):
                        captures <- bam_value_local_callable_captures(block_value, owner, reference_sites, table)
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        for arm in arms:
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(tail_value, _):
                                        arm_captures: darray[sview] = bam_value_local_callable_captures(tail_value, owner, reference_sites, table)
                                        bam_store_merge_capture_names(captures, arm_captures)
                                    Stmt.Return(tail_option, _):
                                        if tail_option is tail_value:
                                            arm_captures: darray[sview] = bam_value_local_callable_captures(tail_value, owner, reference_sites, table)
                                            bam_store_merge_capture_names(captures, arm_captures)
                                    _:
                                        pass
                    Expr.GetElse(guarded, recovery, _):
                        guarded_captures: darray[sview] = bam_value_local_callable_captures(guarded, owner, reference_sites, table)
                        bam_store_merge_capture_names(captures, guarded_captures)
                        if recovery.count > 0:
                            match recovery[recovery.count - 1]:
                                Stmt.Expr(tail_value, _):
                                    recovery_captures: darray[sview] = bam_value_local_callable_captures(tail_value, owner, reference_sites, table)
                                    bam_store_merge_capture_names(captures, recovery_captures)
                                Stmt.Return(tail_option, _):
                                    if tail_option is tail_value:
                                        recovery_captures: darray[sview] = bam_value_local_callable_captures(tail_value, owner, reference_sites, table)
                                        bam_store_merge_capture_names(captures, recovery_captures)
                                _:
                                    pass
                    _:
                        pass
                return captures

        def bam_value_local_callable_global_targets(value: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, global_names: darray[sview]&, captures: darray[sview]&, global_stores: mutable darray[BorrowLocalCallableGlobalStore]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                targets: mutable darray[sview] = []
                match value:
                    Expr.Lambda(_, body, _):
                        possible_targets: mutable darray[sview] = []
                        empty_aliases: darray[BorrowLocalCallableAliasRoot] = []
                        aliases: darray[BorrowLocalCallableAliasRoot] = bam_store_local_alias_roots(body, owner, reference_sites, table, lend_names, lend_positions, empty_aliases)
                        bam_store_global_target_statements(body, global_names, owner, reference_sites, table, lend_names, lend_positions, captures, global_stores, aliases, possible_targets)
                        for global_target in possible_targets |targets|:
                            targets.push(global_target) if not (any prior in targets where prior == global_target)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        targets <- bam_value_local_callable_global_targets(inner, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                    Expr.Ident(_, position):
                        known, binding_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        targets <- borrow_local_callable_global_targets(reference_sites.local_callables, binding_id) if known
                        prior_stores: darray[BorrowLocalCallableGlobalStore] = borrow_local_callable_global_stores(reference_sites.local_callables, binding_id) if known else []
                        bam_store_merge_global_stores(global_stores, prior_stores)
                    Expr.If(_, then_value, else_value, _):
                        then_targets: darray[sview] = bam_value_local_callable_global_targets(then_value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                        else_targets: darray[sview] = bam_value_local_callable_global_targets(else_value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                        bam_store_merge_capture_names(targets, then_targets)
                        bam_store_merge_capture_names(targets, else_targets)
                    Expr.Block(_, block_value, _, _):
                        targets <- bam_value_local_callable_global_targets(block_value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        for arm in arms:
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(tail_value, _):
                                        arm_targets: darray[sview] = bam_value_local_callable_global_targets(tail_value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                                        bam_store_merge_capture_names(targets, arm_targets)
                                    Stmt.Return(tail_option, _):
                                        if tail_option is tail_value:
                                            arm_targets: darray[sview] = bam_value_local_callable_global_targets(tail_value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                                            bam_store_merge_capture_names(targets, arm_targets)
                                    _:
                                        pass
                    Expr.GetElse(guarded, recovery, _):
                        guarded_targets: darray[sview] = bam_value_local_callable_global_targets(guarded, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                        bam_store_merge_capture_names(targets, guarded_targets)
                        if recovery.count > 0:
                            match recovery[recovery.count - 1]:
                                Stmt.Expr(tail_value, _):
                                    recovery_targets: darray[sview] = bam_value_local_callable_global_targets(tail_value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                                    bam_store_merge_capture_names(targets, recovery_targets)
                                Stmt.Return(tail_option, _):
                                    if tail_option is tail_value:
                                        recovery_targets: darray[sview] = bam_value_local_callable_global_targets(tail_value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores)
                                        bam_store_merge_capture_names(targets, recovery_targets)
                                _:
                                    pass
                    _:
                        pass
                return targets

        def bam_remember_local_callable(binding_position: Ast::Pos, value: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, global_names: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                known, binding_id = borrow_reference_site_binding(reference_sites, owner, binding_position, table)
                is_callable: bool = bam_value_is_local_callable(value, owner, reference_sites, table)
                captures: darray[sview] = bam_value_local_callable_captures(value, owner, reference_sites, table) if is_callable else []
                global_stores: mutable darray[BorrowLocalCallableGlobalStore] = []
                global_targets: darray[sview] = bam_value_local_callable_global_targets(value, owner, reference_sites, table, lend_names, lend_positions, global_names, captures, global_stores) if is_callable else []
                borrow_set_local_callable(reference_sites, binding_id, is_callable, captures, global_targets, global_stores) if known

        # `name = &place` links `name` to `place`; `name = other` where `other` is itself a
        # linked reference local copies the reference, so `name` names what `other` names.
        def bam_store_ref_link(name: sview, value: Ast::Expr, ref_params: darray[sview]&, link_names: mutable darray[sview]&, link_targets: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                stripped: Ast::Expr = bam_strip_paren(value)
                linked_root: mutable sview = bam_borrow_root(stripped)
                match stripped:
                    Expr.Ident(copied_name, _):
                        linked_root <- copied_name if (any known_link in link_names where known_link == copied_name) or (any ref_param in ref_params where ref_param == copied_name)
                    _:
                        pass
                return if linked_root == "" or linked_root == name
                link_names.push(name)
                link_targets.push(linked_root)

        # `al = &owner` / `al <- &owner`: the local `al` is a reference INTO `owner`, so a store
        # through `al` (`al.begin <- &x`, `al <- v`) lands in `owner`'s storage. stage0's
        # returnBorrowRefDeclLinks; a rebind adds a link rather than replacing one, so every
        # place `al` may name receives the store.
        def bam_store_ref_links(statements: darray[Ast::Stmt], ref_params: darray[sview]&, link_names: mutable darray[sview]&, link_targets: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |link_names, link_targets|:
                    match statement:
                        Stmt.VarDecl(linked_name, _, linked_value, _):
                            bam_store_ref_link(linked_name, linked_value, ref_params, link_names, link_targets)
                        Stmt.Assign(Expr.Ident(linked_name, _), _, linked_value, _):
                            bam_store_ref_link(linked_name, linked_value, ref_params, link_names, link_targets)
                        Stmt.If(_, linked_then, linked_else, _):
                            bam_store_ref_links(linked_then, ref_params, link_names, link_targets)
                            bam_store_ref_links(linked_else, ref_params, link_names, link_targets)
                        Stmt.While(_, linked_body, _):
                            bam_store_ref_links(linked_body, ref_params, link_names, link_targets)
                        Stmt.For(_, _, _, linked_body, _):
                            bam_store_ref_links(linked_body, ref_params, link_names, link_targets)
                        Stmt.Block(_, _, _, linked_body, _):
                            bam_store_ref_links(linked_body, ref_params, link_names, link_targets)
                        Stmt.Match(_, linked_arms, _):
                            for linked_arm in linked_arms |link_names, link_targets|:
                                bam_store_ref_links(linked_arm.body, ref_params, link_names, link_targets)
                        _:
                            pass

        # `al <- &p` and `al <- other_alias` re-point the reference local; they write nothing.
        def bam_store_is_rebind(value: Ast::Expr, link_names: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                stripped: Ast::Expr = bam_strip_paren(value)
                return true if bam_borrow_root(stripped) != ""
                match stripped:
                    Expr.Ident(copied_name, _):
                        return any known_link in link_names where known_link == copied_name
                    _:
                        return false

        # A store through the reference local `name` adds `stored_roots` to every place it may
        # name, keeping what those places already held (one field changes, not the whole owner).
        def bam_store_forward(name: sview, stored_roots: darray[sview]&, link_names: darray[sview]&, link_targets: darray[sview]&, seen: mutable darray[sview]&, escape_names: mutable darray[sview]&, escape_roots: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return if stored_roots.count == 0
                seen.push(name)
                link_row: mutable usize = 0
                while link_row < link_names.count |link_row, seen, escape_names, escape_roots|:
                    target: sview = link_targets[link_row]
                    if link_names[link_row] == name and not (any seen_name in seen where seen_name == target):
                        existing_roots: darray[sview] = bam_escape_roots_for_binding(target, escape_names, escape_roots)
                        escape_names.push(target)
                        escape_roots.push("")
                        for existing_root in existing_roots |escape_names, escape_roots|:
                            escape_names.push(target)
                            escape_roots.push(existing_root)
                        for stored_root in stored_roots |escape_names, escape_roots, existing_roots|:
                            if not (any known_root in existing_roots where known_root == stored_root):
                                escape_names.push(target)
                                escape_roots.push(stored_root)
                        bam_store_forward(target, stored_roots, link_names, link_targets, seen, escape_names, escape_roots)
                    link_row <- link_row + 1

        # bam_escape_merge_branch, answering whether the path added a root to a binding that
        # existed before it.
        # bam_escape_merge_branch that also reports whether the branch added a root; the
        # environment is rebuilt from the fresh versions for the same reason as there.
        def bam_escape_merge_branch_grew[@r](target_names: mutable darray[sview]& @r, target_roots: mutable darray[sview]& @r, branch_names: darray[sview]& @r, branch_roots: darray[sview]& @r) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                grew: mutable bool = false
                merge_names: mutable darray[sview] = []
                for target_name in target_names |merge_names|:
                    merge_names.push(target_name) if not (any known_merge in merge_names where known_merge == target_name)
                merged_names: mutable darray[sview] @r = []
                merged_roots: mutable darray[sview] @r = []
                for merge_name in merge_names |merged_names, merged_roots, target_names, target_roots, branch_names, branch_roots, grew|:
                    target_values: darray[sview] = bam_escape_roots_for_binding(merge_name, target_names, target_roots)
                    branch_values: darray[sview] = bam_escape_roots_for_binding(merge_name, branch_names, branch_roots)
                    merged_names.push(merge_name)
                    merged_roots.push("")
                    for target_value in target_values |merged_names, merged_roots|:
                        merged_names.push(merge_name)
                        merged_roots.push(target_value)
                    for branch_value in branch_values |merged_names, merged_roots, target_values, grew|:
                        if not (any known_value in target_values where known_value == branch_value):
                            merged_names.push(merge_name)
                            merged_roots.push(branch_value)
                            grew <- true
                target_names.truncate(0)
                target_roots.truncate(0)
                for merged_row in 0..<merged_names.count |target_names, target_roots|:
                    target_names.push(merged_names[merged_row])
                    target_roots.push(merged_roots[merged_row])
                return grew

        # A loop body also runs after its own earlier iterations: `h.a <- owner` then
        # `al.begin <- &x` stores the borrow on the SECOND pass. Rewalk until the finite set of
        # carried roots stops growing, and keep only diagnostics from the stable walk.
        def bam_store_loop[@r](body: darray[Ast::Stmt], locals: darray[sview]&, ref_params: darray[sview]&, writable_ref_params: darray[sview]&, ref_param_types: darray[u32]&, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview]& @r, escape_roots: mutable darray[sview]& @r, link_names: darray[sview]&, link_targets: darray[sview]&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                diagnostic_mark: usize = table.diagnostics.count
                grew: mutable bool = true
                loop_names: mutable darray[sview] @r = []
                loop_roots: mutable darray[sview] @r = []
                loop_callables: mutable darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                while grew |grew, table, escape_names, escape_roots, reference_sites|:
                    loop_names.truncate(0)
                    loop_roots.truncate(0)
                    loop_names.extend(escape_names)
                    loop_roots.extend(escape_roots)
                    borrow_restore_local_callables(reference_sites, loop_callables)
                    table <- bam_store_statements(body, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, loop_names, loop_roots, link_names, link_targets, summary, table)
                    body_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                    next_callables: darray[BorrowLocalCallable] = borrow_join_local_callable_states(loop_callables, body_callables)
                    callable_grew: bool = not borrow_local_callable_states_equal(loop_callables, next_callables)
                    loop_callables <- next_callables
                    borrow_restore_local_callables(reference_sites, loop_callables)
                    escape_grew: bool = bam_escape_merge_branch_grew(escape_names, escape_roots, loop_names, loop_roots)
                    grew <- escape_grew or callable_grew
                    table.diagnostics <- table.diagnostics.truncate(diagnostic_mark) if grew

        # `out.p <- &local` where `out` is a REFERENCE parameter: the frame dies at the return
        # but the pointee it just published lives on in the caller's storage. stage0 reports
        # this from the same escape analysis as the return form, with its own sentence.
        # Beyond the direct borrow (state 0), a TYPED target also catches the local root
        # reaching it through a value: `out.push(&x)` into a reference-carrying darray
        # (state 1), an aggregate literal or alias holding `&x` (state 2), and a local
        # reference alias `r = &x; out.r <- r` (state 3).
        def bam_store_statements[@r](statements: darray[Ast::Stmt], locals: darray[sview]&, ref_params: darray[sview]&, writable_ref_params: darray[sview]&, ref_param_types: darray[u32]&, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview]& @r, escape_roots: mutable darray[sview]& @r, link_names: darray[sview]&, link_targets: darray[sview]&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |table, escape_names, escape_roots, reference_sites, writable_ref_params| -> table:
                    match statement:
                        Stmt.VarDecl(declared_name, _, declared_value, declaration_pos):
                            table <- bam_store_call_expression(declared_value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            binder_pos: mutable Ast::Pos = source_binder_position(table, declared_name, declaration_pos.line, 0, "__pattern_binder")
                            binder_pos <- declaration_pos if binder_pos.line == 0
                            bam_remember_local_callable(binder_pos, declared_value, function_owner, reference_sites, table, lend_names, lend_positions, summary.globals)
                            bam_escape_track_declaration(declared_name, declared_value, lend_names, lend_positions, escape_names, escape_roots)
                        Stmt.Assign(store_target, store_operator, store_value, store_pos):
                            table <- bam_store_call_expression(store_target, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            table <- bam_store_call_expression(store_value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            match store_target:
                                Expr.Ident(_, target_pos):
                                    bam_remember_local_callable(target_pos, store_value, function_owner, reference_sites, table, lend_names, lend_positions, summary.globals)
                                _:
                                    pass
                            stored: sview = bam_borrow_root(store_value)
                            target_root: sview = bam_place_root(store_target)
                            # A global target outlives the frame whether written whole or through a
                            # field/index, unless a local or parameter of the same name shadows it.
                            global_target: bool = target_root != "" and (any global_name in summary.globals where global_name == target_root) and not (any shadow in locals where shadow == target_root) and not (any shadow_param in ref_params where shadow_param == target_root)
                            outlives: bool = target_root != "" and ((bam_place_is_interior(store_target) and (any outer in ref_params where outer == target_root)) or global_target)
                            escapes: bool = outlives and stored != "" and (any known_local in locals where known_local == stored)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StoreRefToLocal, name: stored, pos: store_pos, line: store_pos.line, expected: "", actual: ""}) if escapes
                            if outlives and stored == "":
                                target_type: u32 = bam_place_type_id(store_target, ref_params, ref_param_types, table)
                                visited_types: mutable darray[u32] = []
                                if bam_type_contains_reference(target_type, visited_types, table) and bam_roots_reach_local(store_value, locals, lend_names, lend_positions, escape_names, escape_roots):
                                    store_form: u32 = 3 if interned_kind(target_type, table) == SemTypeKind.Ref else 2
                                    anchor: Ast::Pos = bam_escape_anchor(store_value)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StoreRefToLocal, name: target_root, pos: anchor, line: anchor.line, expected: "", actual: "", state_code: store_form})
                            bam_escape_track_assign(store_target, store_value, lend_names, lend_positions, escape_names, escape_roots)
                            # A store THROUGH a reference local also lands in the place it names; its
                            # own rebind (`al <- &p`) is a link, not a store.
                            if target_root != "" and (bam_place_is_interior(store_target) or not bam_store_is_rebind(store_value, link_names)):
                                forwarded_roots: mutable darray[sview] = []
                                bam_escape_collect_roots(store_value, lend_names, lend_positions, escape_names, escape_roots, forwarded_roots)
                                forward_seen: mutable darray[sview] = []
                                bam_store_forward(target_root, forwarded_roots, link_names, link_targets, forward_seen, escape_names, escape_roots)
                        Stmt.Expr(push_call, _):
                            table <- bam_store_call_expression(push_call, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            bam_escape_track_insert(push_call, lend_names, lend_positions, escape_names, escape_roots)
                            match push_call:
                                Expr.Call(Expr.Field(forward_receiver, forward_method, _), forward_arguments, _, _):
                                    forward_root: sview = bam_place_root(forward_receiver)
                                    if bam_is_container_insert(forward_method) and forward_root != "":
                                        inserted_roots: mutable darray[sview] = []
                                        for forward_argument in forward_arguments |inserted_roots|:
                                            bam_escape_collect_roots(forward_argument, lend_names, lend_positions, escape_names, escape_roots, inserted_roots)
                                        forward_seen: mutable darray[sview] = []
                                        bam_store_forward(forward_root, inserted_roots, link_names, link_targets, forward_seen, escape_names, escape_roots)
                                _:
                                    pass
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            table <- bam_store_call_expression(branch_condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            callable_base: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            then_names: mutable darray[sview] @r = []
                            then_roots: mutable darray[sview] @r = []
                            else_names: mutable darray[sview] @r = []
                            else_roots: mutable darray[sview] @r = []
                            then_names.extend(escape_names)
                            then_roots.extend(escape_roots)
                            else_names.extend(escape_names)
                            else_roots.extend(escape_roots)
                            table <- bam_store_statements(branch_then, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, then_names, then_roots, link_names, link_targets, summary, table)
                            then_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            borrow_restore_local_callables(reference_sites, callable_base)
                            table <- bam_store_statements(branch_else, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, else_names, else_roots, link_names, link_targets, summary, table)
                            else_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            borrow_merge_local_callable_states(reference_sites, then_callables, else_callables)
                            bam_escape_merge_branch(escape_names, escape_roots, then_names, then_roots)
                            bam_escape_merge_branch(escape_names, escape_roots, else_names, else_roots)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            table <- bam_store_call_expression(loop_condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            table <- bam_store_loop(loop_body, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, link_names, link_targets, summary, table)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            table <- bam_store_call_expression(for_iterable, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            table <- bam_store_loop(for_body, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, link_names, link_targets, summary, table)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            table <- bam_store_statements(block_body, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, link_names, link_targets, summary, table)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            table <- bam_store_call_expression(match_scrutinee, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                            callable_base: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            joined_callables: mutable darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                            base_names: mutable darray[sview] @r = []
                            base_roots: mutable darray[sview] @r = []
                            base_names.extend(escape_names)
                            base_roots.extend(escape_roots)
                            for match_arm in match_arms |table, base_names, base_roots, escape_names, escape_roots, reference_sites| -> table:
                                borrow_restore_local_callables(reference_sites, callable_base)
                                arm_names: mutable darray[sview] @r = []
                                arm_roots: mutable darray[sview] @r = []
                                arm_names.extend(base_names)
                                arm_roots.extend(base_roots)
                                table <- bam_store_call_expression(match_arm.guard, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, arm_names, arm_roots, summary, table)
                                table <- bam_store_statements(match_arm.body, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, arm_names, arm_roots, link_names, link_targets, summary, table)
                                arm_callables: darray[BorrowLocalCallable] = borrow_snapshot_local_callables(reference_sites)
                                joined_callables <- borrow_join_local_callable_states(joined_callables, arm_callables)
                                bam_escape_merge_branch(escape_names, escape_roots, arm_names, arm_roots)
                            borrow_restore_local_callables(reference_sites, joined_callables)
                        Stmt.Return(returned_option, _):
                            if returned_option is returned_expression:
                                table <- bam_store_call_expression(returned_expression, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        Stmt.Contract(_, contract_expression, _):
                            table <- bam_store_call_expression(contract_expression, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, summary, table)
                        _:
                            pass

        # `g[i] <- &local` / `g.f <- &local` / `g <- (&local).cast[T&]` where `g` is a GLOBAL:
        # the global outlives the frame, so the stored address dangles once the function
        # returns. stage0 reports it with the direct-store sentence (state 0). Only the direct
        # borrow form is checked here; bam_store_statements covers reference PARAMETERS and
        # needs ref_params, so it never ran for a function like `main` with none.
        # Globals are Const symbols in the collector; their type id can be 0 for shapes the
        # type table does not model (`heap Entry&?[NB]`), so test the symbol kind instead.
        def bam_name_is_global(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                row: mutable u32 = symbol_chain_head(table, name)
                while row != 4294967295 |row, table, name|:
                    symbol: Symbol = table.symbols[row.usize()]
                    true return if symbol.kind == SymbolKind.Const and symbol.name == name
                    row <- table.symbol_name_next[row.usize()]
                return false

        def bam_global_store_statements(statements: darray[Ast::Stmt], locals: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(global_target, _, global_value, global_pos):
                            stored: sview = bam_borrow_root(global_value)
                            target_root: sview = bam_place_root(global_target)
                            if stored != "" and target_root != "" and (any known_local in locals where known_local == stored) and not (any shadow in locals where shadow == target_root) and bam_name_is_global(target_root, table):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StoreRefToLocal, name: stored, pos: global_pos, line: global_pos.line, expected: "", actual: ""})
                        Stmt.If(_, global_then, global_else, _):
                            table <- bam_global_store_statements(global_then, locals, table)
                            table <- bam_global_store_statements(global_else, locals, table)
                        Stmt.While(_, global_loop_body, _):
                            table <- bam_global_store_statements(global_loop_body, locals, table)
                        Stmt.For(_, _, _, global_for_body, _):
                            table <- bam_global_store_statements(global_for_body, locals, table)
                        Stmt.Block(_, _, _, global_block_body, _):
                            table <- bam_global_store_statements(global_block_body, locals, table)
                        Stmt.Match(_, global_arms, _):
                            for global_arm in global_arms |table| -> table:
                                table <- bam_global_store_statements(global_arm.body, locals, table)
                        _:
                            pass

        # A return summary is recorded for each reference parameter whose value can flow into
        # the returned reference-bearing result. Multiple parameters may each lend on different
        # paths, so the parallel name/position tables intentionally allow repeated function names.
        def bam_collect_lend_functions(declarations: darray[Ast::Decl], names: mutable darray[sview]&, positions: mutable darray[usize]&, seen: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, positions, seen|:
                    match declaration:
                        Decl.Func(function_name, function_parameters, function_return, function_body, function_effects, function_decorators, function_pos):
                            seen.push(function_name)
                            reference_count: mutable usize = 0
                            parameter_index: mutable usize = 0
                            for parameter in function_parameters |reference_count, parameter_index|:
                                if affine_annotation_is_ref(parameter.type_expression):
                                    reference_count <- reference_count + 1
                                parameter_index <- parameter_index + 1
                            if function_return is declared_return and reference_count > 0:
                                summary_binders: mutable BorrowBinders = empty_borrow_binders()
                                borrow_function_binders(function_parameters, function_body, summary_binders)
                                parameter_index <- 0
                                for parameter in function_parameters |parameter_index, names, positions, summary_binders|:
                                    if affine_annotation_is_ref(parameter.type_expression):
                                        summary_parameter: sview = parameter.name
                                        can_summarize: bool = not (any unreadable_binder in summary_binders.names where unreadable_binder == "*") and binders_bound_once(summary_binders, summary_parameter)
                                        summary_alias_names: mutable darray[sview] = []
                                        summary_alias_carries: mutable darray[bool] = []
                                        returns_borrow: bool = can_summarize and bam_returns_aggregate_borrow(function_body, summary_parameter, true, summary_alias_names, summary_alias_carries)
                                        if returns_borrow:
                                            names.push(function_name)
                                            positions.push(parameter_index)
                                    parameter_index <- parameter_index + 1
                        Decl.Module(module_name, module_body, module_pos):
                            bam_collect_lend_functions(module_body, names, positions, seen)
                        Decl.Scoped(scoped_body, scoped_pos):
                            bam_collect_lend_functions(scoped_body, names, positions, seen)
                        _:
                            pass

        def bam_declarations(declarations: darray[Ast::Decl], region_param_lines: darray[u32]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, summary: StoreThroughSummary&, reference_sites: mutable BorrowReferenceSites&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for declaration in declarations |table, reference_sites| -> table:
                    match declaration:
                        Decl.Func(function_name, function_parameters, function_return, function_body, function_effects, function_decorators, function_pos):
                            # `reference_sites` is shared across declarations for its lazy
                            # source-site index, but callable flow is function-local. Reuse
                            # its backing capacity without carrying prior functions' rows into
                            # branch snapshots or binding searches.
                            reference_sites.local_callables.truncate(0)
                            function_owner: DeclId = function_declaration_id(table, function_name, function_pos.offset)
                            binders: mutable BorrowBinders = empty_borrow_binders()
                            borrow_function_binders(function_parameters, function_body, binders)
                            # One unreadable pattern and the whole function is skipped: a name this
                            # walk cannot count may be bound twice, and then it reads the wrong one.
                            readable: bool = not (any binder in binders.names where binder == "*")
                            collect_perm_containers: bool = false
                            if function_return is static_return:
                                collect_perm_containers <- bam_annotation_is_static(static_return) and bam_type_is_address(static_return) and not auto_region_params_mention_arena(function_parameters) and not (any region_line in region_param_lines where region_line == function_pos.line)
                            owners: mutable darray[sview] = []
                            locals: mutable darray[sview] = []
                            perm_containers: mutable darray[sview] = []
                            if readable:
                                for parameter in function_parameters |owners|:
                                    owners.push(parameter.name) if bam_owner_type_name(parameter.type_expression, table) != "" and binders_bound_once(binders, parameter.name)
                                bam_collect_owners(function_body, binders, table, owners)
                                bam_collect_locals(function_body, binders, locals, collect_perm_containers, perm_containers)
                                for value_parameter in function_parameters |locals|:
                                    locals.push(value_parameter.name) if not affine_annotation_is_ref(value_parameter.type_expression) and binders_bound_once(binders, value_parameter.name)
                            kinds: mutable darray[u32] = []
                            details: mutable darray[sview] = []
                            for owner in owners |kinds, details|:
                                kinds.push(0)
                                details.push("")
                            borrow_names: mutable darray[sview] = []
                            borrow_fields: mutable darray[sview] = []
                            borrow_owners: mutable darray[sview] = []
                            escape_names: mutable darray[sview] = []
                            escape_roots: mutable darray[sview] = []
                            flow: mutable darray[bool] = [false]
                            table <- bam_statements(function_body, owners, lend_names, lend_positions, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, table) if owners.count > 0
                            returns_reference: mutable bool = false
                            returns_reference_aggregate: mutable bool = false
                            if function_return is declared_return:
                                returns_reference <- affine_annotation_is_ref(declared_return)
                                if not returns_reference:
                                    return_type_id: u32 = annotation_type_id(declared_return, table) can Global{Read,Write}
                                    visited_types: mutable darray[u32] = []
                                    returns_reference_aggregate <- bam_type_contains_reference(return_type_id, visited_types, table)
                            # Inspect returns in every function: a local reference can escape
                            # inside a struct/tuple/container, or through a known aggregate
                            # lender, even when the function's declared result is not itself T&.
                            table <- bam_escape_statements(function_body, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, table, returns_reference_aggregate, returns_reference, true) if (returns_reference or returns_reference_aggregate) and locals.count > 0
                            ref_params: mutable darray[sview] = []
                            writable_ref_params: mutable darray[sview] = []
                            ref_param_types: mutable darray[u32] = []
                            for ref_parameter in function_parameters |ref_params, writable_ref_params, ref_param_types, table| -> table:
                                if affine_annotation_is_ref(ref_parameter.type_expression) and binders_bound_once(binders, ref_parameter.name):
                                    parameter_type: u32 = annotation_type_id(ref_parameter.type_expression, table) can Global{Read,Write}
                                    ref_params.push(ref_parameter.name)
                                    ref_param_types.push(parameter_type)
                                    if param_is_mutable_ref(ref_parameter):
                                        visited_parameter_types: mutable darray[u32] = []
                                        writable_ref_params.push(ref_parameter.name) if bam_type_contains_reference(bam_strip_ref(parameter_type, table), visited_parameter_types, table)
                            store_names: mutable darray[sview] = []
                            link_names: mutable darray[sview] = []
                            link_targets: mutable darray[sview] = []
                            bam_store_ref_links(function_body, ref_params, link_names, link_targets)
                            store_roots: mutable darray[sview] = []
                            table <- bam_store_statements(function_body, locals, ref_params, writable_ref_params, ref_param_types, function_owner, reference_sites, lend_names, lend_positions, store_names, store_roots, link_names, link_targets, summary, table) if (ref_params.count > 0 or summary.globals.count > 0) and locals.count > 0
                            table <- bam_global_store_statements(function_body, locals, table) if locals.count > 0
                        Decl.Module(module_name, module_body, module_pos):
                            previous_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- bam_declarations(module_body, region_param_lines, lend_names, lend_positions, summary, reference_sites, table) can Global{Read,Write}
                            table.current_module <- previous_module
                        Decl.Scoped(scoped_body, scoped_pos):
                            table <- bam_declarations(scoped_body, region_param_lines, lend_names, lend_positions, summary, reference_sites, table) can Global{Read,Write}
                        _:
                            pass

    public:
        def check_borrow_after_move(declarations: darray[Ast::Decl], region_param_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                candidate_names: mutable darray[sview] = []
                candidate_positions: mutable darray[usize] = []
                declared_names: mutable darray[sview] = []
                bam_collect_lend_functions(declarations, candidate_names, candidate_positions, declared_names)
                # Indexed once: "declared exactly once" is asked per function per fixpoint round.
                declared_binders: mutable BorrowBinders = empty_borrow_binders()
                declared_binders.names.extend(declared_names)
                index_borrow_binders(declared_binders)
                lend_names: mutable darray[sview] = []
                lend_positions: mutable darray[usize] = []
                candidate_index: mutable usize = 0
                while candidate_index < candidate_names.count |candidate_index, lend_names, lend_positions|:
                    # An overloaded name resolves per call site, which this walk cannot do.
                    if binders_bound_once(declared_binders, candidate_names[candidate_index]) and not bam_lend_position_exists(lend_names, lend_positions, candidate_names[candidate_index], candidate_positions[candidate_index]):
                        lend_names.push(candidate_names[candidate_index])
                        lend_positions.push(candidate_positions[candidate_index])
                    candidate_index <- candidate_index + 1
                # Resolve forwarding helpers to a fixed point so `outer(x) -> middle(x) ->
                # inner(x)` carries the same borrow summary no matter which declaration came
                # first. Ambiguous function names remain untracked.
                more_lenders: mutable bool = true
                while more_lenders |more_lenders, lend_names, lend_positions|:
                    wrapper_names: mutable darray[sview] = []
                    wrapper_positions: mutable darray[usize] = []
                    bam_collect_lend_wrappers(declarations, lend_names, lend_positions, wrapper_names, wrapper_positions, declared_binders)
                    more_lenders <- false
                    wrapper_index: mutable usize = 0
                    while wrapper_index < wrapper_names.count |wrapper_index, lend_names, lend_positions, more_lenders|:
                        if not bam_lend_position_exists(lend_names, lend_positions, wrapper_names[wrapper_index], wrapper_positions[wrapper_index]):
                            lend_names.push(wrapper_names[wrapper_index])
                            lend_positions.push(wrapper_positions[wrapper_index])
                            more_lenders <- true
                        wrapper_index <- wrapper_index + 1
                reference_sites: mutable BorrowReferenceSites = empty_borrow_reference_sites()
                summary: StoreThroughSummary = build_store_through_summary(declarations, reference_sites, table) can Global{Read,Write}
                table <- bam_declarations(declarations, region_param_lines, lend_names, lend_positions, summary, reference_sites, table) can Global{Read,Write}
