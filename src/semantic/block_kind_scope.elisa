# Exact prefix-block kinds whose bodies introduce lexical scopes in name resolution.
module SemanticBlockKindScope:
    public:
        def block_kind_is_scope(kind: sview) -> bool:
            ensure when kind:
                "region" | "in" | "can" | "trusted" | "with" | "pool" | "nursery" | "scope" | "lock" -> result == (true)
                _ -> result == (false)
            return when kind:
                "region" | "in" | "can" | "trusted" | "with" | "pool" | "nursery" | "scope" | "lock" -> true
                _ -> false
