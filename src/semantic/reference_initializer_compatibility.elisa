# The one structural widening allowed after exact reference-target identity fails:
# a uniquely named typestate-qualified struct reference may lose that phantom state.
module SemanticReferenceInitializerCompatibility:
    public:
        ghost def typestate_widening_spec(expected_is_named: bool, actual_is_container: bool, same_nominal_name: bool, unique_typestate: bool) -> bool:
            return expected_is_named and actual_is_container and same_nominal_name and unique_typestate

        def typestate_widening_allowed(expected_is_named: bool, actual_is_container: bool, same_nominal_name: bool, unique_typestate: bool) -> bool:
            ensure result == typestate_widening_spec(expected_is_named, actual_is_container, same_nominal_name, unique_typestate)
            return false if not expected_is_named
            return false if not actual_is_container
            return false if not same_nominal_name
            return unique_typestate
