# NoBoundsChecks index enforcement (docs/89). A function that `fulfills NoBoundsChecks`
# (directly, or via a composite law that transitively `includes` it) promises every index
# access is statically proven in-bounds, so LLVM emits no runtime bounds check. A darray
# has a RUNTIME length, so a constant-literal index into a darray parameter that is NOT
# established by iteration is not statically proven — stage0 rejects it ("index access that
# is not statically proven in-bounds, so a runtime bounds check would be emitted").
#
# SOUND decidable subset: fire only on `recv[CONST]` where recv is a darray PARAMETER and
# the access sits OUTSIDE every loop (a `for i in …` iteration is the proven case, left
# alone). Constant index on a runtime-length darray at loop depth 0 is never provable, so
# this cannot overfire on the iteration idiom.
extend Semantic:
    private:
        # Names of functions that fulfill NoBoundsChecks (directly or transitively via a
        # composite law's `includes` edges).
        def nb_fulfilling_functions(file: Ast::File&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                includes_owner: darray[sview] = [a.owner for a in file.enum_annotations if a.line == 3900000023]
                includes_law: darray[sview] = [a.name for a in file.enum_annotations if a.line == 3900000023]
                for annotation in file.enum_annotations |out, includes_owner, includes_law|:
                    if annotation.line == 3900000021:
                        direct: bool = annotation.name == "NoBoundsChecks"
                        reach_visited: mutable darray[sview] = []
                        transitive: bool = law_reaches(annotation.name, "NoBoundsChecks", includes_owner, includes_law, reach_visited)
                        out.push(annotation.owner) if direct or transitive

        # darray-typed parameter names of a function (a runtime-length container — the case
        # where a constant index is never statically proven).
        def nb_darray_params(parameters: darray[Ast::ParamDecl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |out|:
                    out.push(parameter.name) if is_darray_type(parameter.type_expression)

        # Walk statements at loop depth `in_loop`; a constant index into a darray param at
        # depth 0 is an unproven access.
        def nb_walk(statements: darray[Ast::Stmt], darray_params: darray[sview]&, in_loop: bool, fn_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- nb_expr(expression, darray_params, in_loop, fn_name, line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- nb_expr(value, darray_params, in_loop, fn_name, line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- nb_expr(target, darray_params, in_loop, fn_name, line, table)
                            table <- nb_expr(value, darray_params, in_loop, fn_name, line, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- nb_expr(returned, darray_params, in_loop, fn_name, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- nb_walk(then_body, darray_params, in_loop, fn_name, table)
                            table <- nb_walk(else_body, darray_params, in_loop, fn_name, table)
                        Stmt.While(condition, while_body, line):
                            table <- nb_walk(while_body, darray_params, true, fn_name, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- nb_walk(for_body, darray_params, true, fn_name, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- nb_walk(block_body, darray_params, in_loop, fn_name, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- nb_walk(arm.body, darray_params, in_loop, fn_name, table)
                        _:
                            pass

        def nb_expr(expression: Ast::Expr, darray_params: darray[sview]&, in_loop: bool, fn_name: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index_argument, index_line):
                        object_name: sview = ident_name_of(object)
                        is_darray_param: bool = object_name != "" and (any p in darray_params where p == object_name)
                        index_literal: (found: bool, value: i64) = signed_int_literal(index_argument)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NoBoundsCheckUnproven, name: fn_name, line: line, expected: "", actual: ""}) if is_darray_param and index_literal.found and not in_loop
                        table <- nb_expr(object, darray_params, in_loop, fn_name, line, table)
                        table <- nb_expr(index_argument, darray_params, in_loop, fn_name, line, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- nb_expr(left, darray_params, in_loop, fn_name, line, table)
                        table <- nb_expr(right, darray_params, in_loop, fn_name, line, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- nb_expr(operand, darray_params, in_loop, fn_name, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- nb_expr(inner, darray_params, in_loop, fn_name, line, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- nb_expr(argument, darray_params, in_loop, fn_name, line, table)
                    _:
                        pass

        def nb_check_walk(declarations: darray[Ast::Decl], fulfilling: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if any f in fulfilling where f == function_name:
                                darray_params: mutable darray[sview] = []
                                nb_darray_params(parameters, darray_params)
                                table <- nb_walk(body, darray_params, false, function_name, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- nb_check_walk(module_body, fulfilling, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- nb_check_walk(scoped_body, fulfilling, table)
                        _:
                            pass

    public:
        def check_nobounds_index(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                fulfilling: mutable darray[sview] = []
                nb_fulfilling_functions(file, fulfilling)
                return if fulfilling.count == 0
                table <- nb_check_walk(file.top_decls, fulfilling, table)
