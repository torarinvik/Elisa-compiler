extend Semantic:
    private:
        # A loop body that stores a view into a holder (`owners.push(qualify(&storage, n))`)
        # and grows the view's backing earlier in the same body (`qualify` appends to
        # `storage`) leaves the holder stale on the NEXT iteration, and after the loop. The
        # first walk sees the growth before the store, so nothing is invalidated yet; walk the
        # body once more from the end-of-body state to model the back edge. Only when the
        # body can loop back and the first walk recorded new alias rows (no new view, nothing
        # to invalidate), which also bounds nested loops. Reports the second walk repeats
        # (same name and line) are dropped; its exit marks are discarded (the first walk's
        # are the same marks).
        def storage_view_rewalk_loop_body(body: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, view_fns: darray[sview]&, replace_names: darray[sview]&, value_names: darray[sview]&, field_elems: darray[sview]&, field_views: darray[sview]&, field_view_heads: darray[Ast::Expr]&, aliases_before: usize, stable_regions: mutable darray[sview]&, alias_names: mutable darray[sview]&, alias_sources: mutable darray[sview]&, alias_is_view: mutable darray[bool]&, invalidated: mutable darray[sview]&, invalidated_by: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if alias_names.count == aliases_before or storage_view_body_leaves(body)
                # A name declared inside the body is FRESH each iteration: growing such a backing
                # on the next pass cannot move the previous pass's bytes, and such a view is
                # re-derived before its next use (the first walk already checked that pass). So
                # second-walk reports naming one, as the view or as the grown backing
                # (`expected`), are dropped.
                body_locals: mutable darray[sview] = []
                storage_view_collect_body_decls(body, &body_locals)
                first_new: usize = table.diagnostics.count
                invalidated_before: usize = invalidated.count
                discard_exit: mutable darray[sview] = []
                discard_exit_by: mutable darray[sview] = []
                table <- walk_region_storage_stability(body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, discard_exit, discard_exit_by, table) can Global{Read,Write}
                write: mutable usize = first_new
                for read in first_new..<table.diagnostics.count |write, table, body_locals|:
                    candidate: Diagnostic = table.diagnostics[read]
                    repeated: bool =
                        for earlier in 0..<write |repeated: bool = false| -> repeated:
                            prior: Diagnostic = table.diagnostics[earlier]
                            repeated <- true if prior.kind == candidate.kind and prior.name == candidate.name and prior.line == candidate.line
                    continue if repeated or hce_contains(&body_locals, candidate.expected) or hce_contains(&body_locals, candidate.name)
                    table.diagnostics[write] <- candidate if write != read
                    write <- write + 1
                table.diagnostics <- table.diagnostics.truncate(write)
                # The same holds for the facts the second walk leaves for code AFTER the loop.
                return if invalidated.count != invalidated_by.count
                kept: mutable usize = invalidated_before
                for row in invalidated_before..<invalidated.count |kept, invalidated, invalidated_by, body_locals|:
                    continue if hce_contains(&body_locals, invalidated_by[row]) or hce_contains(&body_locals, invalidated[row])
                    if kept != row:
                        invalidated[kept] <- invalidated[row]
                        invalidated_by[kept] <- invalidated_by[row]
                    kept <- kept + 1
                invalidated <- invalidated.truncate(kept)
                invalidated_by <- invalidated_by.truncate(kept)

        # Names declared anywhere in STATEMENTS, nested loops included (a nested loop's
        # locals are bound per ITS iteration, so they are fresh per outer pass too).
        def storage_view_collect_body_decls(statements: darray[Ast::Stmt]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names|:
                    match statement:
                        Stmt.VarDecl(name, _, _, _):
                            names.push(name)
                        Stmt.If(_, then_body, else_body, _):
                            storage_view_collect_body_decls(then_body, names)
                            storage_view_collect_body_decls(else_body, names)
                        Stmt.Block(_, _, _, block_body, _):
                            storage_view_collect_body_decls(block_body, names)
                        Stmt.While(_, loop_body, _):
                            storage_view_collect_body_decls(loop_body, names)
                        Stmt.For(_, _, _, loop_body, _):
                            storage_view_collect_body_decls(loop_body, names)
                        Stmt.Match(_, arms, _):
                            for arm in arms |names|:
                                storage_view_collect_body_decls(arm.body, names)
                        _:
                            pass
