# A value cast of an integer CONSTANT to a narrower integer type (`300.u8()`, `u8(300)`) that
# does not fit the target's [min,max] window silently truncates it — stage0 warns. Distinct
# from the typed-declaration overflow ERROR (`x: u8 = 300`): the cast form is a WARNING. Pure
# constant-fold + range check; reuses bit_int_window and fold_const_int.
extend Semantic:
    private:
        # If EXPRESSION is a value cast of a constant integer that overflows the target integer
        # type, returns (found, value, type_name); else found=false.
        def cast_constant_overflow(expression: Ast::Expr) -> (found: bool, value: i64, type_name: sview):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        # Postfix form `V.u8()`: callee is `Field(V, "u8")`, no extra arguments.
                        if callee is Expr.Field(base, method_name, field_line):
                            postfix_window: (found: bool, low: i64, high: i64) = bit_int_window(method_name)
                            if postfix_window.found:
                                base_value: (found: bool, value: i64) = fold_const_int(base)
                                (true, base_value.value, method_name) return if base_value.found and (base_value.value < postfix_window.low or base_value.value > postfix_window.high)
                        # Prefix form `u8(V)`: callee is `Ident("u8")`, one constant argument.
                        if callee is Expr.Ident(callee_name, ident_line):
                            prefix_window: (found: bool, low: i64, high: i64) = bit_int_window(callee_name)
                            if prefix_window.found and arguments.count == 1:
                                argument_value: (found: bool, value: i64) = fold_const_int(arguments[0])
                                (true, argument_value.value, callee_name) return if argument_value.found and (argument_value.value < prefix_window.low or argument_value.value > prefix_window.high)
                        return (false, 0, sview("", 0, 0))
                    _:
                        return (false, 0, sview("", 0, 0))

        def cast_trunc_check_expression(expression: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                overflow: (found: bool, value: i64, type_name: sview) = cast_constant_overflow(expression)
                if overflow.found:
                    sign: sview = "neg" if overflow.value < 0 else sview("", 0, 0)
                    magnitude: i64 = 0 - overflow.value if overflow.value < 0 else overflow.value
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CastConstantTruncated, name: "", line: line, expected: sign, actual: overflow.type_name, expected_count: magnitude.u32()})
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- cast_trunc_check_expression(callee, line, table)
                        for argument in arguments |table| -> table:
                            table <- cast_trunc_check_expression(argument, line, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- cast_trunc_check_expression(left, line, table)
                        table <- cast_trunc_check_expression(right, line, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- cast_trunc_check_expression(operand, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- cast_trunc_check_expression(inner, line, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- cast_trunc_check_expression(condition, line, table)
                        table <- cast_trunc_check_expression(then_value, line, table)
                        table <- cast_trunc_check_expression(else_value, line, table)
                    _:
                        pass

        def cast_trunc_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cast_trunc_check_expression(expression, line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cast_trunc_check_expression(value, line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cast_trunc_check_expression(value, line, table)
                        Stmt.Return(value, line):
                            table <- cast_trunc_check_expression(returned, line, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cast_trunc_check_expression(condition, line, table)
                            table <- cast_trunc_check_statements(then_body, table)
                            table <- cast_trunc_check_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- cast_trunc_check_expression(condition, line, table)
                            table <- cast_trunc_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- cast_trunc_check_statements(for_body, table)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            table <- cast_trunc_check_statements(block_body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- cast_trunc_check_expression(scrutinee, line, table)
                            for arm in arms |table| -> table:
                                table <- cast_trunc_check_statements(arm.body, table)
                        _:
                            pass

        def cast_trunc_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- cast_trunc_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- cast_trunc_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- cast_trunc_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_cast_constant_truncated(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cast_trunc_walk(file.top_decls, table)
