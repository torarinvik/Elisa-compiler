# Value-threading, builtin container methods with a second result (STYLE_GUIDE.md section 6):
# `xs, last <- xs.pop()`, `xs, item <- xs.remove_at(i)` and `d, found <- d.remove(k)` thread
# the container through the method and bind its result. The backend emits them as the
# single-target statement (`last <- xs.pop()`), which updates `xs` in place; with any other
# first target (`ys, last <- xs.pop()`) that target would silently keep its old value, so the
# form is rejected with both correct spellings (ValueThreadClaimTarget).
#
# Only receivers that are plainly containers count: a local or parameter declared
# `darray[...]`/`dict[...]` (behind `mutable`/`&`), so a user type's own `pop` returning a
# tuple is never touched.
extend Semantic:
    private:
        def vtc_container_type(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(_, operand, _):
                        return vtc_container_type(operand)
                    Expr.Paren(inner, _):
                        return vtc_container_type(inner)
                    Expr.Index(head, _, _) | Expr.IndexN(head, _, _):
                        if head is Expr.Ident(head_name, _):
                            return head_name == "darray" or head_name == "dict"
                        return false
                    _:
                        return false

        def vtc_collect_containers(statements: darray[Ast::Stmt], containers: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |containers|:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, _):
                            containers.push(declared_name) if vtc_container_type(declared_type)
                            if declared_value is Expr.Block(value_statements, _, _, _):
                                vtc_collect_containers(value_statements, containers)
                        Stmt.Expr(statement_expression, _):
                            if statement_expression is Expr.Block(expression_statements, _, _, _):
                                vtc_collect_containers(expression_statements, containers)
                        Stmt.Block(_, _, _, block_body, _):
                            vtc_collect_containers(block_body, containers)
                        Stmt.If(_, then_body, else_body, _):
                            vtc_collect_containers(then_body, containers)
                            vtc_collect_containers(else_body, containers)
                        Stmt.While(_, while_body, _):
                            vtc_collect_containers(while_body, containers)
                        Stmt.For(_, _, _, for_body, _):
                            vtc_collect_containers(for_body, containers)
                        Stmt.Match(_, arms, _):
                            for arm in arms |containers|:
                                vtc_collect_containers(arm.body, containers)
                        _:
                            pass

        # One `a, b <- recv.method(..)` statement.
        def vtc_check_claim(statement: Ast::Stmt, containers: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if statement is Stmt.Assign(target, operator, assign_value, assign_pos):
                    return if operator != TokenKind.LArrow
                    if target is Expr.Array(targets, _):
                        return if targets.count != 2
                        if assign_value is Expr.Call(callee, arguments, _, _):
                            if callee is Expr.Field(receiver, method, _):
                                wanted: usize = 0 if method == "pop" else 1
                                return if not (method == "pop" or method == "remove_at" or method == "remove") or arguments.count != wanted
                                if receiver is Expr.Ident(receiver_name, _):
                                    return if not vtc_listed(containers, receiver_name)
                                    return if Ast::value_thread_place_equal(targets[0], receiver)
                                    written: mutable darray[u8] = []
                                    vtc_render(targets[0], &written)
                                    written.extend(", ")
                                    vtc_render(targets[1], &written)
                                    written.extend(" <- ")
                                    vtc_render(assign_value, &written)
                                    threaded: mutable darray[u8] = []
                                    threaded.extend(receiver_name)
                                    threaded.extend(", ")
                                    vtc_render(targets[1], &threaded)
                                    threaded.extend(" <- ")
                                    vtc_render(assign_value, &threaded)
                                    single: mutable darray[u8] = []
                                    vtc_render(targets[1], &single)
                                    single.extend(" <- ")
                                    vtc_render(assign_value, &single)
                                    table <- vtc_report(Diagnostic{kind: DiagnosticKind.ValueThreadClaimTarget, name: receiver_name, pos: assign_pos, line: assign_pos.line, actual: Parser::persist_name_bytes(&written, 0), expected: Parser::persist_name_bytes(&threaded, 0), detail: Parser::persist_name_bytes(&single, 0)}, table)

        def vtc_check_claims(statements: darray[Ast::Stmt], containers: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    table <- vtc_check_claim(statement, containers, table)
                    match statement:
                        Stmt.Expr(statement_expression, _):
                            if statement_expression is Expr.Block(expression_statements, _, _, _):
                                table <- vtc_check_claims(expression_statements, containers, table)
                        Stmt.VarDecl(_, _, declared_value, _):
                            if declared_value is Expr.Block(value_statements, _, _, _):
                                table <- vtc_check_claims(value_statements, containers, table)
                        Stmt.Block(_, _, _, block_body, _):
                            table <- vtc_check_claims(block_body, containers, table)
                        Stmt.If(_, then_body, else_body, _):
                            table <- vtc_check_claims(then_body, containers, table)
                            table <- vtc_check_claims(else_body, containers, table)
                        Stmt.While(_, while_body, _):
                            table <- vtc_check_claims(while_body, containers, table)
                        Stmt.For(_, _, _, for_body, _):
                            table <- vtc_check_claims(for_body, containers, table)
                        Stmt.Match(_, arms, _):
                            for arm in arms |table|:
                                table <- vtc_check_claims(arm.body, containers, table)
                        _:
                            pass

        def vtc_claim_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(_, params, _, body, _, _, _):
                            containers: mutable darray[sview] = []
                            for param in params |containers|:
                                containers.push(param.name) if vtc_container_type(param.type_expression)
                            vtc_collect_containers(body, &containers)
                            table <- vtc_check_claims(body, containers, table) if containers.count > 0
                        Decl.Module(_, module_body, _):
                            table <- vtc_claim_declarations(module_body, table)
                        Decl.Scoped(scoped_body, _):
                            table <- vtc_claim_declarations(scoped_body, table)
                        _:
                            pass
