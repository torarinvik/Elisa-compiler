# A binary operator (`+ - * / % ^ | & << >> < <= > >=`) applied directly to a PARAMETER
# whose declared type IS the function's own COMPLETELY UNBOUND generic type parameter
# (`def bump[T](a: T, b: T) -> void: a <- a + b`, no `[T: Interface]` clause at all).
# stage0 checks a generic function's body once, against only what the declared bound
# guarantees -- an unbound T supports nothing, so this is rejected at DECLARATION time
# regardless of any call site. stage1 applies the same declaration-time guard here; the
# check deliberately remains conservative and only diagnoses a shape it can prove is
# an operation on the function's own unbound value parameter.
#
# Deliberately narrow in two ways:
# - Only a COMPLETELY unbound parameter is flagged (zero bound clauses); never an attempt
#   to judge whether a DECLARED bound actually grants the operator used -- that would need
#   to model what each interface provides, which this does not attempt.
# - Only PARAMETERS whose type IS the bare VALUE type parameter (`a: T`, `a: mutable T`, ...)
#   are tracked. A REF parameter such as `items: T&` is deliberately excluded: `items + index`
#   is pointer arithmetic, unrelated to whatever T's bound provides. A local VarDecl's inferred
#   type is not modeled here, so
#   `x: T = a; x + b` is not caught. Under-catching, never over-catching: this only adds
#   diagnostics for a shape it is certain about.
#
# Restricted to a SINGLE generic type parameter per function, mirroring
# check_generic_interface_bounds.elisa's check_interface_specialization: with multiple type
# params the existing generic_param_lines/names side table's bound rows are keyed by the
# function's line, not disambiguated per parameter name, so a multi-param function cannot
# be resolved this way without a different (unaudited) query path.
extend Semantic:
    private:
        def gonb_operator_requires_bound(operator: TokenKind) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.Plus | TokenKind.Minus | TokenKind.Star | TokenKind.Slash | TokenKind.Percent | TokenKind.Caret | TokenKind.Pipe | TokenKind.Ampersand | TokenKind.LShift | TokenKind.RShift | TokenKind.Lt | TokenKind.LtEq | TokenKind.Gt | TokenKind.GtEq -> true
                    _ -> false


        # Compound assignment is the same binary operation followed by a store:
        # `x += y` is `x <- x + y`. Keep this mapping next to the operator predicate so
        # the declaration-time check cannot forget an operator that the normal analyzer
        # already validates through its augmented-assignment path.
        def gonb_compound_operator(operator: TokenKind) -> TokenKind:
            can Abort.Panic:
                return when operator:
                    TokenKind.PlusEq -> TokenKind.Plus
                    TokenKind.MinusEq -> TokenKind.Minus
                    TokenKind.StarEq -> TokenKind.Star
                    TokenKind.SlashEq -> TokenKind.Slash
                    TokenKind.PercentEq -> TokenKind.Percent
                    TokenKind.CaretEq -> TokenKind.Caret
                    TokenKind.PipeEq -> TokenKind.Pipe
                    TokenKind.AmpEq -> TokenKind.Ampersand
                    TokenKind.LShiftEq -> TokenKind.LShift
                    TokenKind.RShiftEq -> TokenKind.RShift
                    _ -> TokenKind.Eof


        # The function's SOLE generic type parameter name, or "" if it has zero or more
        # than one (the multi-param case is out of scope -- see file header).
        def gonb_sole_param_name(table: SymbolTable&, line: u32) -> sview:
            can Abort.Panic:
                result: mutable sview = ""
                count: mutable usize = 0
                index: mutable usize = 0
                while index < table.generic_param_lines.count |index, result, count, table, line|:
                    if table.generic_param_lines[index] == line:
                        result <- table.generic_param_names[index]
                        count <- count + 1
                    index <- index + 1
                return result if count == 1 else ""


        # Whether PARAM_NAME (the sole type parameter of the function at LINE) has ANY
        # bound clause at all (`[T: Interface]`) -- bound rows are keyed at
        # `line + 2^31`, distinct from the plain param-name rows at `line`.
        def gonb_param_has_any_bound(table: SymbolTable&, line: u32) -> bool:
            can Abort.Panic:
                encoded: u32 = line + 2147483648
                return any bound_line in table.generic_param_lines where bound_line == encoded


        # Whether EXPRESSION is exactly the bare type parameter used as a VALUE type --
        # `T` or `mutable T` -- stripping ONLY Mutable/Lmut. Deliberately distinct from
        # bare_type_name_through_ref, which also strips Ampersand: a REF parameter
        # (`items: T&`) is a C-buffer pointer, and `items + index` on it is POINTER
        # ARITHMETIC -- a completely different, always-legal operation unrelated to
        # whatever T's own bound provides (confirmed via the self-hosting audit this
        # over-fired on: elisacore_std/deque.elisa's and collections.elisa's
        # `*_void_from_items_at[T](items: T&, index: usize) -> void&: (items +
        # index).cast[void&]` helpers). A `&`-wrapped parameter must NEVER match here.
        def gonb_is_bare_value_type(expression: Ast::Expr, type_param_name: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return gonb_is_bare_value_type(operand, type_param_name) if operator == TokenKind.Mutable or operator == TokenKind.Lmut else false
                    Expr.Ident(ident_name, ident_line):
                        return ident_name == type_param_name
                    _:
                        return false


        # Names of function PARAMETERS whose declared type is the bare type parameter
        # used AS A VALUE (see gonb_is_bare_value_type) -- never a reference to it.
        # Out-parameter style (not a returned fresh darray) to avoid the
        # region-polymorphic call-context requirement.
        def gonb_bare_param_names(params: darray[Ast::ParamDecl], type_param_name: sview, bare_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                bare_names.extend([p.name for p in params if gonb_is_bare_value_type(p.type_expression, type_param_name)])


        def gonb_expr_uses_bare_param(expression: Ast::Expr, bare_names: darray[sview]&) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, ident_line): any bare_name in bare_names where bare_name == name
                    Expr.Paren(inner, paren_line): gonb_expr_uses_bare_param(inner, bare_names)
                    Expr.Move(inner, move_line): gonb_expr_uses_bare_param(inner, bare_names)
                    _: false


        def gonb_walk_expr(expression: Ast::Expr, bare_names: darray[sview]&, line: mutable u32&, found: mutable bool&) -> void:
            can Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_line):
                        if gonb_operator_requires_bound(operator) and (gonb_expr_uses_bare_param(left, bare_names) or gonb_expr_uses_bare_param(right, bare_names)):
                            found <- true
                            line <- binary_line.line
                        gonb_walk_expr(left, bare_names, line, found)
                        gonb_walk_expr(right, bare_names, line, found)
                    Expr.Paren(inner, paren_line):
                        gonb_walk_expr(inner, bare_names, line, found)
                    Expr.Unary(operator, operand, unary_line):
                        gonb_walk_expr(operand, bare_names, line, found)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        gonb_walk_expr(callee, bare_names, line, found)
                        for argument in arguments |bare_names, line, found|:
                            gonb_walk_expr(argument, bare_names, line, found)
                    Expr.Field(object, field, field_line):
                        gonb_walk_expr(object, bare_names, line, found)
                    Expr.Scope(base, name, scope_line):
                        gonb_walk_expr(base, bare_names, line, found)
                    Expr.Index(object, index, index_line):
                        gonb_walk_expr(object, bare_names, line, found)
                        gonb_walk_expr(index, bare_names, line, found) if not index_receiver_is_type_application(object)
                    Expr.Slice(object, low, high, slice_line):
                        gonb_walk_expr(object, bare_names, line, found)
                        gonb_walk_expr(low, bare_names, line, found)
                        gonb_walk_expr(high, bare_names, line, found)
                    Expr.IndexN(object, arguments, index_n_line):
                        gonb_walk_expr(object, bare_names, line, found)
                        for argument in arguments |bare_names, line, found|:
                            gonb_walk_expr(argument, bare_names, line, found) if not index_receiver_is_type_application(object)
                    Expr.Move(operand, move_line):
                        gonb_walk_expr(operand, bare_names, line, found)
                    Expr.RegionNew(operand, region, region_line):
                        gonb_walk_expr(operand, bare_names, line, found)
                    Expr.Array(elements, collection_line) | Expr.Tuple(elements, collection_line) | Expr.SetLit(elements, collection_line):
                        for element in elements |bare_names, line, found|:
                            gonb_walk_expr(element, bare_names, line, found)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |bare_names, line, found|:
                            gonb_walk_expr(entry.key, bare_names, line, found)
                            gonb_walk_expr(entry.value, bare_names, line, found)
                    Expr.Construct(type_expression, fields, construct_line):
                        gonb_walk_expr(type_expression, bare_names, line, found)
                        for field in fields |bare_names, line, found|:
                            gonb_walk_expr(field.value, bare_names, line, found)
                    Expr.RecordUpdate(base, fields, update_line):
                        gonb_walk_expr(base, bare_names, line, found)
                        for field in fields |bare_names, line, found|:
                            gonb_walk_expr(field.value, bare_names, line, found)
                    Expr.If(condition, then_expr, else_expr, if_line):
                        gonb_walk_expr(condition, bare_names, line, found)
                        gonb_walk_expr(then_expr, bare_names, line, found)
                        gonb_walk_expr(else_expr, bare_names, line, found)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        gonb_walk_expr(scrutinee, bare_names, line, found)
                        for arm in arms |bare_names, line, found|:
                            gonb_walk_expr(arm.guard, bare_names, line, found)
                            gonb_walk_stmts(arm.body, bare_names, line, found)
                    Expr.Comprehension(loop_variable, iterable, condition, body, comprehension_line):
                        gonb_walk_expr(iterable, bare_names, line, found)
                        gonb_walk_expr(condition, bare_names, line, found)
                        gonb_walk_expr(body, bare_names, line, found)
                    Expr.Refinement(base, predicate, refinement_line):
                        gonb_walk_expr(base, bare_names, line, found)
                        gonb_walk_expr(predicate, bare_names, line, found)
                    Expr.GetElse(guarded, recovery, get_else_line):
                        gonb_walk_expr(guarded, bare_names, line, found)
                        gonb_walk_stmts(recovery, bare_names, line, found)
                    Expr.Lambda(parameters, body, lambda_line):
                        gonb_walk_stmts(body, bare_names, line, found)
                    Expr.Block(statements, value, captures, block_line):
                        gonb_walk_stmts(statements, bare_names, line, found)
                        gonb_walk_expr(value, bare_names, line, found)
                    _:
                        pass


        def gonb_walk_stmts(statements: darray[Ast::Stmt], bare_names: darray[sview]&, line: mutable u32&, found: mutable bool&) -> void:
            can Abort.Panic:
                for statement in statements |bare_names, line, found|:
                    match statement:
                        Stmt.Expr(expression, stmt_line):
                            gonb_walk_expr(expression, bare_names, line, found)
                        Stmt.VarDecl(name, type_expression, value, stmt_line):
                            gonb_walk_expr(value, bare_names, line, found)
                        Stmt.Assign(target, operator, value, stmt_line):
                            compound_operator: TokenKind = gonb_compound_operator(operator)
                            if gonb_operator_requires_bound(compound_operator) and (gonb_expr_uses_bare_param(target, bare_names) or gonb_expr_uses_bare_param(value, bare_names)):
                                found <- true
                                line <- stmt_line.line
                            gonb_walk_expr(target, bare_names, line, found)
                            gonb_walk_expr(value, bare_names, line, found)
                        Stmt.Return(value, stmt_line):
                            gonb_walk_expr(return_value, bare_names, line, found) if value is return_value
                        Stmt.If(condition, then_body, else_body, stmt_line):
                            gonb_walk_expr(condition, bare_names, line, found)
                            gonb_walk_stmts(then_body, bare_names, line, found)
                            gonb_walk_stmts(else_body, bare_names, line, found)
                        Stmt.While(condition, body, stmt_line):
                            gonb_walk_expr(condition, bare_names, line, found)
                            gonb_walk_stmts(body, bare_names, line, found)
                        Stmt.For(bind, variables, iterable, body, stmt_line):
                            gonb_walk_expr(iterable, bare_names, line, found)
                            gonb_walk_stmts(body, bare_names, line, found)
                        Stmt.Block(kind, clause, binding, body, stmt_line):
                            gonb_walk_stmts(body, bare_names, line, found)
                        Stmt.Match(scrutinee, arms, stmt_line):
                            gonb_walk_expr(scrutinee, bare_names, line, found)
                            for arm in arms |bare_names, line, found|:
                                gonb_walk_expr(arm.guard, bare_names, line, found)
                                gonb_walk_stmts(arm.body, bare_names, line, found)
                        Stmt.Contract(kind, expression, stmt_line):
                            gonb_walk_expr(expression, bare_names, line, found)
                        _:
                            pass


        def gonb_walk_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, decl_line):
                            type_param_name: sview = gonb_sole_param_name(table, decl_line.line)
                            if type_param_name != "" and not gonb_param_has_any_bound(table, decl_line.line):
                                bare_names: mutable darray[sview] = []
                                gonb_bare_param_names(params, type_param_name, bare_names)
                                if bare_names.count > 0:
                                    found_line: mutable u32 = decl_line.line
                                    found: mutable bool = false
                                    gonb_walk_stmts(body, bare_names, found_line, found)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericOperatorNoBound, name: type_param_name, line: found_line, expected: "binary", actual: name}) if found
                        Decl.Module(name, body, decl_line) | Decl.Scoped(body, decl_line):
                            table <- gonb_walk_declarations(body, table)
                        _:
                            pass

    public:
        def check_generic_operator_no_bound(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- gonb_walk_declarations(file.top_decls, table)
