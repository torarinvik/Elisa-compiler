# Exact rule for a self-assignment diagnostic: mutation of an identifier to itself.
module SelfAssignmentPolicy:
    public:
        def is_mutation_operator(operator: Lexer::TokenKind) -> bool:
            ensure result == (operator == Lexer::TokenKind.LArrow)
            matches: bool = when operator:
                Lexer::TokenKind.LArrow -> true
                _ -> false
            assert(matches == (operator == Lexer::TokenKind.LArrow))
            return matches

        def should_report(operator: Lexer::TokenKind, target_name: sview, value_name: sview) -> bool:
            report: bool = when operator:
                Lexer::TokenKind.LArrow -> target_name == value_name
                _ -> false
            assert(report == (operator == Lexer::TokenKind.LArrow and target_name == value_name))
            return report
