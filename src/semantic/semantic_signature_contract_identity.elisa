# Exact owner lookup for the parser's line/kind/predicate contract side tables.
# Each drained row also has one `__signature_contract` annotation, in the same order,
# carrying the owning declaration offset. Keeping the marker as the offset source avoids
# another required Ast::File column while failing closed if the side tables diverge.
extend Semantic:
    private:
        const SIGNATURE_CONTRACT_OFFSET_NONE: u32 = 4294967295

        def signature_contract_owner_offset_at(index: usize, lines: darray[u32]&, kinds: darray[sview]&, predicates: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&) -> u32:
            can Abort.Panic:
                return SIGNATURE_CONTRACT_OFFSET_NONE if lines.count != kinds.count or lines.count != predicates.count or index >= lines.count
                marker_count: mutable usize = 0
                selected_line: mutable u32 = 0
                selected_kind: mutable sview = ""
                selected_offset: mutable u32 = SIGNATURE_CONTRACT_OFFSET_NONE
                for annotation in annotations |marker_count, index, selected_line, selected_kind, selected_offset|:
                    continue if annotation.owner != "__signature_contract"
                    if marker_count == index:
                        selected_line <- annotation.line
                        selected_kind <- annotation.name
                        selected_offset <- annotation.offset
                    marker_count <- marker_count + 1.usize()
                return SIGNATURE_CONTRACT_OFFSET_NONE if marker_count != lines.count
                return selected_offset if selected_offset != SIGNATURE_CONTRACT_OFFSET_NONE and selected_line == lines[index] and selected_kind == kinds[index]
                return SIGNATURE_CONTRACT_OFFSET_NONE
