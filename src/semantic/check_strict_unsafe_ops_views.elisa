# Stage1 semantic — unsafe-effect calls, extern calls, stale views, and the check entry
# (`extend Semantic: private:`). Checks caller obligations for direct unsafe-effect calls,
# flags raw extern calls without a grant, and detects views read after backing mutation.
# `check_strict_unsafe_ops` drives every part. Continues check_strict_unsafe_ops_requires.elisa.

extend Semantic:
    private:
        struct StrictUnsafeCallEffectBinding:
            name: sview
            effect: sview

        # Names of every `extern` function anywhere in the tree. stage0 marks each extern
        # fnType with an unconditional `Unsafe.RawExtern` permission ref (markRawExternFuncType,
        # gated only on enforceUnsafePermissions), so EVERY call to one requires the grant.
        def collect_extern_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            out.push(name)
                        Decl.Module(module_name, module_body, module_line):
                            collect_extern_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_extern_names(scoped_body, out)
                        _:
                            pass

        def strict_unsafe_call_has_diagnostic(table: SymbolTable&, callee: sview, line: u32, effect: sview) -> bool:
            can Abort.Panic:
                return any diagnostic in table.diagnostics where diagnostic.kind == DiagnosticKind.UngrantedEffectCall and diagnostic.name == callee and diagnostic.line == line and diagnostic.expected == effect

        def strict_unsafe_effect_refs_for_type(type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Lambda(parameters, body, position):
                        effects: mutable darray[sview] = []
                        for annotation in annotations |effects, position|:
                            effects.push(annotation.name) if annotation.owner == "__fn_type_effect" and annotation.offset == position.offset
                        return effects
                    Expr.Unary(operator, operand, position) | Expr.Paren(operand, position):
                        return strict_unsafe_effect_refs_for_type(operand, annotations)
                    Expr.Refinement(base, predicate, position):
                        return strict_unsafe_effect_refs_for_type(base, annotations)
                    _:
                        return []

        def strict_unsafe_effect_refs_for_value(expression: Ast::Expr, bindings: darray[StrictUnsafeCallEffectBinding]&, table: SymbolTable&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, position):
                        if any binding in bindings where binding.name == name:
                            return [binding.effect for binding in bindings if binding.name == name and binding.effect != ""]
                        return function_effect_refs(table, name)
                    Expr.Scope(base, name, position):
                        return function_effect_refs(table, name)
                    Expr.Paren(inner, position) | Expr.Move(inner, position):
                        return strict_unsafe_effect_refs_for_value(inner, bindings, table)
                    _:
                        return []

        def strict_unsafe_call_bind_local(bindings: mutable darray[StrictUnsafeCallEffectBinding]&, name: sview, type_expression: Ast::Expr, value: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                effects: mutable darray[sview] = []
                declared_effects: darray[sview] = strict_unsafe_effect_refs_for_type(type_expression, annotations)
                value_effects: darray[sview] = strict_unsafe_effect_refs_for_value(value, bindings, table)
                for effect in declared_effects |effects|:
                    add: bool = effect != "" and effect_ref_family(effect) == "Unsafe" and not (any known in effects where known == effect)
                    effects.push(effect) if add
                for effect in value_effects |effects|:
                    add: bool = effect != "" and effect_ref_family(effect) == "Unsafe" and not (any known in effects where known == effect)
                    effects.push(effect) if add
                bindings <- [binding for binding in bindings if binding.name != name]
                bindings.push(StrictUnsafeCallEffectBinding{name: name, effect: ""})
                for effect in effects |bindings|:
                    bindings.push(StrictUnsafeCallEffectBinding{name: name, effect: effect})

        def strict_unsafe_call_shadow_local(bindings: mutable darray[StrictUnsafeCallEffectBinding]&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                # No declared or inferred Unsafe effects: this local deliberately hides any
                # same-spelled outer callback or global function in its lexical scope.
                bindings <- [binding for binding in bindings if binding.name != name]
                bindings.push(StrictUnsafeCallEffectBinding{name: name, effect: ""})

        def strict_unsafe_call_bindings_copy(bindings: darray[StrictUnsafeCallEffectBinding]&) -> darray[StrictUnsafeCallEffectBinding]:
            can Memory.Allocate:
                return [binding for binding in bindings]

        # A branch or loop may assign a different callable to an outer local. Preserve the
        # union of possible Unsafe rows for bindings that existed on entry; locals introduced
        # inside the branch do not escape its lexical scope.
        def strict_unsafe_call_bindings_merge(bindings: mutable darray[StrictUnsafeCallEffectBinding]&, base: darray[StrictUnsafeCallEffectBinding]&, branch: darray[StrictUnsafeCallEffectBinding]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for candidate in branch |bindings, base|:
                    if candidate.effect != "" and (any original in base where original.name == candidate.name) and not (any known in bindings where known.name == candidate.name and known.effect == candidate.effect):
                        bindings.push(candidate)

        # The value flowing into a local callback may have an Unsafe effect even when the
        # variable's source annotation omitted that row. Keep every possible row until a
        # typed effect-preserving assignment analysis can prove a narrower target set.
        def strict_unsafe_call_rebind_local(bindings: mutable darray[StrictUnsafeCallEffectBinding]&, name: sview, value: Ast::Expr, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name == "" or not (any binding in bindings where binding.name == name)
                value_effects: darray[sview] = strict_unsafe_effect_refs_for_value(value, bindings, table)
                for effect in value_effects |bindings|:
                    add: bool = effect != "" and effect_ref_family(effect) == "Unsafe" and not (any known in bindings where known.name == name and known.effect == effect)
                    bindings.push(StrictUnsafeCallEffectBinding{name: name, effect: effect}) if add

        # An unsafe effect on a function value is a caller obligation too. Check it at the
        # call site against the active lexical grants; an unrelated `can Memory.Allocate:`
        # block cannot launder a call to a function requiring `Unsafe.PointerCast`. Signature
        # rows are deliberately not copied into active_grants: they describe what callers owe.
        def strict_unsafe_effect_call_expression(expression: Ast::Expr, fallback_line: u32, extern_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, active_grants: darray[sview]&, bindings: mutable darray[StrictUnsafeCallEffectBinding]&, enforce_raw_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee_expression, arguments, argument_names, call_position):
                        callee: sview = called_function_name(expression)
                        local_name: sview = match callee_expression:
                            Expr.Ident(name, position): name
                            _: ""
                        local_binding: bool = local_name != "" and (any binding in bindings where binding.name == local_name)
                        effect_callee: sview = local_name if local_binding else callee
                        is_extern: bool = not local_binding and effect_callee != "" and (any extern_name in extern_names where extern_name == effect_callee)
                        call_line: u32 = call_position.line if call_position.line != 0 else fallback_line
                        if effect_callee != "":
                            required_effects: mutable darray[sview] = []
                            if local_binding:
                                for binding in bindings |required_effects, effect_callee|:
                                    required_effects.push(binding.effect) if binding.name == effect_callee and binding.effect != ""
                            else:
                                required_effects <- function_effect_refs(table, effect_callee)
                            for required in required_effects |table, effect_callee, call_line, is_extern, enforce_raw_unsafe, active_grants|:
                                continue if effect_ref_family(required) != "Unsafe"
                                # Direct extern calls already have the dedicated RawExtern
                                # checker, and RawExtern remains gated by the explicit #unsafe
                                # mode. User wrappers carrying this effect are checked here.
                                continue if required == "Unsafe.RawExtern" and (is_extern or not enforce_raw_unsafe)
                                continue if strict_unsafe_grant_covers(active_grants, required)
                                continue if strict_unsafe_call_has_diagnostic(table, effect_callee, call_line, required)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: effect_callee, line: call_line, expected: required, actual: "Unsafe"})
                        table <- strict_unsafe_effect_call_expression(callee_expression, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        for argument in arguments |table, bindings| -> table:
                            table <- strict_unsafe_effect_call_expression(argument, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Field(object, field, field_line) | Expr.Scope(object, field, field_line):
                        table <- strict_unsafe_effect_call_expression(object, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Index(object, index, index_line):
                        table <- strict_unsafe_effect_call_expression(object, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(index, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.IndexN(object, indices, index_line):
                        table <- strict_unsafe_effect_call_expression(object, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        for index in indices |table, bindings| -> table:
                            table <- strict_unsafe_effect_call_expression(index, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- strict_unsafe_effect_call_expression(object, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(low, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(high, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- strict_unsafe_effect_call_expression(left, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(right, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, move_line) | Expr.RegionNew(operand, _, move_line) | Expr.Paren(operand, move_line):
                        table <- strict_unsafe_effect_call_expression(operand, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table, bindings| -> table:
                            table <- strict_unsafe_effect_call_expression(element, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table, bindings| -> table:
                            table <- strict_unsafe_effect_call_expression(entry.key, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            table <- strict_unsafe_effect_call_expression(entry.value, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        table <- strict_unsafe_effect_call_expression(type_expression, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        for field in fields |table, bindings| -> table:
                            table <- strict_unsafe_effect_call_expression(field.value, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        table <- strict_unsafe_effect_call_expression(base, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        for field in fields |table, bindings| -> table:
                            table <- strict_unsafe_effect_call_expression(field.value, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- strict_unsafe_effect_call_expression(condition, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                        then_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                        else_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                        table <- strict_unsafe_effect_call_expression(then_value, fallback_line, extern_names, annotations, active_grants, then_bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(else_value, fallback_line, extern_names, annotations, active_grants, else_bindings, enforce_raw_unsafe, table)
                        strict_unsafe_call_bindings_merge(bindings, base_bindings, then_bindings)
                        strict_unsafe_call_bindings_merge(bindings, base_bindings, else_bindings)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- strict_unsafe_effect_call_expression(iterable, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(condition, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(body, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- strict_unsafe_effect_call_expression(base, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(predicate, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.GetElse(guarded, recovery, get_line):
                        table <- strict_unsafe_effect_call_expression(guarded, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                        recovery_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                        table <- strict_unsafe_effect_call_statements(recovery, extern_names, annotations, active_grants, recovery_bindings, enforce_raw_unsafe, table)
                        strict_unsafe_call_bindings_merge(bindings, base_bindings, recovery_bindings)
                    Expr.Block(statements, value, captures, block_line):
                        base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                        block_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                        table <- strict_unsafe_effect_call_statements(statements, extern_names, annotations, active_grants, block_bindings, enforce_raw_unsafe, table)
                        table <- strict_unsafe_effect_call_expression(value, fallback_line, extern_names, annotations, active_grants, block_bindings, enforce_raw_unsafe, table)
                        strict_unsafe_call_bindings_merge(bindings, base_bindings, block_bindings)
                    Expr.Match(scrutinee, arms, match_line):
                        table <- strict_unsafe_effect_call_expression(scrutinee, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                        for arm in arms |table, bindings| -> table:
                            arm_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                            arm_names: mutable darray[sview] = []
                            pattern_bound_names(arm.pattern, arm_names)
                            for name in arm_names |arm_bindings|:
                                strict_unsafe_call_shadow_local(arm_bindings, name)
                            table <- strict_unsafe_effect_call_expression(arm.guard, fallback_line, extern_names, annotations, active_grants, arm_bindings, enforce_raw_unsafe, table)
                            table <- strict_unsafe_effect_call_statements(arm.body, extern_names, annotations, active_grants, arm_bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_bindings_merge(bindings, base_bindings, arm_bindings)
                    Expr.Catch(guarded, arms, catch_line):
                        table <- strict_unsafe_effect_call_expression(guarded, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                        for arm in arms |table, bindings| -> table:
                            arm_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                            arm_names: mutable darray[sview] = []
                            pattern_bound_names(arm.pattern, arm_names)
                            for name in arm_names |arm_bindings|:
                                strict_unsafe_call_shadow_local(arm_bindings, name)
                            table <- strict_unsafe_effect_call_expression(arm.guard, fallback_line, extern_names, annotations, active_grants, arm_bindings, enforce_raw_unsafe, table)
                            table <- strict_unsafe_effect_call_statements(arm.body, extern_names, annotations, active_grants, arm_bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_bindings_merge(bindings, base_bindings, arm_bindings)
                    Expr.StaticEffectCall(effect_type, operation_name, candidates, arguments, argument_names, call_position):
                        for argument in arguments |table, bindings| -> table:
                            table <- strict_unsafe_effect_call_expression(argument, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        for candidate in candidates |table, bindings| -> table:
                            for capture in candidate.captures |table, bindings| -> table:
                                table <- strict_unsafe_effect_call_expression(capture, fallback_line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                    Expr.Lambda(parameters, body, lambda_line):
                        no_grants: darray[sview] = []
                        lambda_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                        for name in parameters |lambda_bindings|:
                            strict_unsafe_call_shadow_local(lambda_bindings, name)
                        table <- strict_unsafe_effect_call_statements(body, extern_names, annotations, no_grants, lambda_bindings, enforce_raw_unsafe, table)
                    _:
                        pass

        def strict_unsafe_effect_call_statements(statements: darray[Ast::Stmt], extern_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, active_grants: darray[sview]&, bindings: mutable darray[StrictUnsafeCallEffectBinding]&, enforce_raw_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, bindings| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- strict_unsafe_effect_call_expression(expression, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- strict_unsafe_effect_call_expression(value, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_bind_local(bindings, name, type_expression, value, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- strict_unsafe_effect_call_expression(target, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            table <- strict_unsafe_effect_call_expression(value, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_rebind_local(bindings, target_name, value, table) if target is Expr.Ident(target_name, _) and operator == TokenKind.LArrow
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- strict_unsafe_effect_call_expression(returned, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- strict_unsafe_effect_call_expression(condition, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                            then_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                            else_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                            table <- strict_unsafe_effect_call_statements(then_body, extern_names, annotations, active_grants, then_bindings, enforce_raw_unsafe, table)
                            table <- strict_unsafe_effect_call_statements(else_body, extern_names, annotations, active_grants, else_bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_bindings_merge(bindings, base_bindings, then_bindings)
                            strict_unsafe_call_bindings_merge(bindings, base_bindings, else_bindings)
                        Stmt.While(condition, body, line):
                            table <- strict_unsafe_effect_call_expression(condition, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                            loop_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                            table <- strict_unsafe_effect_call_statements(body, extern_names, annotations, active_grants, loop_bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_bindings_merge(bindings, base_bindings, loop_bindings)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- strict_unsafe_effect_call_expression(iterable, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                            loop_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                            for name in variables |loop_bindings|:
                                strict_unsafe_call_shadow_local(loop_bindings, name)
                            table <- strict_unsafe_effect_call_statements(body, extern_names, annotations, active_grants, loop_bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_bindings_merge(bindings, base_bindings, loop_bindings)
                        Stmt.Block(kind, clause, binding, body, line):
                            grants_here: mutable darray[sview] = []
                            grants_here.extend(active_grants)
                            grants_here.extend(clause) if kind == "can" or kind == "trusted"
                            base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                            block_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                            strict_unsafe_call_shadow_local(block_bindings, binding) if binding != ""
                            table <- strict_unsafe_effect_call_statements(body, extern_names, annotations, grants_here, block_bindings, enforce_raw_unsafe, table)
                            strict_unsafe_call_bindings_merge(bindings, base_bindings, block_bindings)
                        Stmt.Match(scrutinee, arms, line):
                            table <- strict_unsafe_effect_call_expression(scrutinee, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                            base_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(bindings)
                            for arm in arms |table, bindings| -> table:
                                arm_bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(base_bindings)
                                arm_names: mutable darray[sview] = []
                                pattern_bound_names(arm.pattern, arm_names)
                                for name in arm_names |arm_bindings|:
                                    strict_unsafe_call_shadow_local(arm_bindings, name)
                                table <- strict_unsafe_effect_call_expression(arm.guard, line.line, extern_names, annotations, active_grants, arm_bindings, enforce_raw_unsafe, table)
                                table <- strict_unsafe_effect_call_statements(arm.body, extern_names, annotations, active_grants, arm_bindings, enforce_raw_unsafe, table)
                                strict_unsafe_call_bindings_merge(bindings, base_bindings, arm_bindings)
                        Stmt.Contract(kind, expression, line):
                            table <- strict_unsafe_effect_call_expression(expression, line.line, extern_names, annotations, active_grants, bindings, enforce_raw_unsafe, table)
                        _:
                            pass

        def strict_unsafe_effect_call_decls(declarations: darray[Ast::Decl], extern_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, enforce_raw_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            no_local_grants: darray[sview] = []
                            bindings: mutable darray[StrictUnsafeCallEffectBinding] = []
                            for parameter in parameters |bindings, annotations, table|:
                                strict_unsafe_call_bind_local(bindings, parameter.name, parameter.type_expression, Ast::Expr.Invalid, annotations, table)
                            table <- strict_unsafe_effect_call_statements(body, extern_names, annotations, no_local_grants, bindings, enforce_raw_unsafe, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- strict_unsafe_effect_call_decls(module_body, extern_names, annotations, enforce_raw_unsafe, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- strict_unsafe_effect_call_decls(scoped_body, extern_names, annotations, enforce_raw_unsafe, table)
                        _:
                            pass

        # Whether TYPE_EXPRESSION spells a `view[T]` / `sview` — a borrowed window whose
        # backing can be invalidated out from under it.
        def is_view_annotation(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, line):
                        head: sview = ident_name_of(object)
                        return when head:
                            "view" | "sview" -> true
                            _ -> false
                    Expr.Ident(name, line):
                        return when name:
                            "sview" | "view" -> true
                            _ -> false
                    Expr.Unary(operator, operand, line):
                        return is_view_annotation(operand)
                    Expr.Paren(inner, line):
                        return is_view_annotation(inner)
                    _:
                        return false

        # The CONTAINER a slice/index initializer borrows from, when it is one of the known
        # mutable containers; "" otherwise. `items[0:items.count]` and `items[i]` both borrow.
        def slice_source_container(value: Ast::Expr, containers: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Slice(object, low, high, line):
                        name: sview = ident_name_of(object)
                        return name if (any c in containers where c == name) else sview("", 0, 0)
                    Expr.Index(object, index, line):
                        iname: sview = ident_name_of(object)
                        return iname if (any c in containers where c == iname) else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Definite darray mutators — a call to one of these invalidates every live view of
        # the receiver. A conservative whitelist (never a read accessor), so marking a view
        # stale is always sound.
        def is_container_mutator(method: sview) -> bool:
            can Abort.Panic:
                return when method:
                    "clear" | "push" | "pop" | "truncate" | "insert" | "remove" | "extend" | "resize" | "sort" | "reverse" | "append" | "drain" | "retain" | "swap_remove" -> true
                    _ -> false

        # The receiver container an expression MUTATES (`items.clear()`), or "".
        def mutating_container(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                return ident_name_of(object) if is_container_mutator(field) else sview("", 0, 0)
                            _:
                                return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Whether EXPRESSION reads through a now-stale view: an index over it (`view[0]`) or a
        # bare mention (returning/forwarding the stale window).
        def expression_reads_stale_view(expression: Ast::Expr, stale_views: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return any s in stale_views where s == name
                    Expr.Index(object, index, line):
                        return expression_reads_stale_view(object, stale_views) or expression_reads_stale_view(index, stale_views)
                    Expr.Slice(object, low, high, line):
                        return expression_reads_stale_view(object, stale_views) or expression_reads_stale_view(low, stale_views) or expression_reads_stale_view(high, stale_views)
                    Expr.Binary(left, operator, right, line):
                        return expression_reads_stale_view(left, stale_views) or expression_reads_stale_view(right, stale_views)
                    Expr.Unary(operator, operand, line):
                        return expression_reads_stale_view(operand, stale_views)
                    Expr.Paren(inner, line):
                        return expression_reads_stale_view(inner, stale_views)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments:
                            true return if expression_reads_stale_view(argument, stale_views)
                        return false
                    _:
                        return false

        # Linear staleness walk: register `view[T]` locals sliced from a mutable container,
        # mark them stale at the container's first mutator call, and flag any read through a
        # stale view NOT covered by a `Unsafe.StaleRef` grant. `stale_granted` is inherited
        # from an enclosing `can/trusted Unsafe.StaleRef:` (a DIFFERENT grant does not
        # discharge it). view_names/view_srcs/stale_now are function-scoped, so nested blocks
        # share invalidation facts while the grant itself remains lexically scoped.
        def stale_view_walk(statements: darray[Ast::Stmt], containers: darray[sview]&, view_names: mutable darray[sview]&, view_srcs: mutable darray[sview]&, stale_now: mutable darray[sview]&, stale_granted: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, view_names, view_srcs, stale_now| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line.line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and expression_reads_stale_view(value, stale_now)
                            source: sview = slice_source_container(value, containers)
                            if is_view_annotation(type_expression) and source != "":
                                view_names.push(name)
                                view_srcs.push(source)
                        Stmt.Assign(target, operator, value, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line.line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and (expression_reads_stale_view(value, stale_now) or expression_reads_stale_view(target, stale_now))
                        Stmt.Expr(expression, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line.line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and expression_reads_stale_view(expression, stale_now)
                            mutated: sview = mutating_container(expression)
                            if mutated != "":
                                mark_probe: mutable usize = 0
                                while mark_probe < view_names.count |mark_probe, mutated, view_srcs, stale_now|:
                                    if view_srcs[mark_probe] == mutated:
                                        stale_now.push(view_names[mark_probe])
                                    mark_probe <- mark_probe + 1
                        Stmt.Return(value, line):
                            if value is returned:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: "stale reference", line: line.line, expected: "Unsafe.StaleRef", actual: "Unsafe"}) if not stale_granted and expression_reads_stale_view(returned, stale_now)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- stale_view_walk(then_body, containers, view_names, view_srcs, stale_now, stale_granted, table)
                            table <- stale_view_walk(else_body, containers, view_names, view_srcs, stale_now, stale_granted, table)
                        Stmt.While(condition, body, line):
                            table <- stale_view_walk(body, containers, view_names, view_srcs, stale_now, stale_granted, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- stale_view_walk(body, containers, view_names, view_srcs, stale_now, stale_granted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            grants_stale: bool = stale_granted or ((kind == "can" or kind == "trusted") and strict_unsafe_grant_covers(clause, "Unsafe.StaleRef"))
                            table <- stale_view_walk(body, containers, view_names, view_srcs, stale_now, grants_stale, table)
                        _:
                            pass

        def stale_view_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            containers: mutable darray[sview] = []
                            for parameter in parameters |containers|:
                                containers.push(parameter.name) if param_is_mutable_ref(parameter)
                            continue if containers.count == 0
                            view_names: mutable darray[sview] = []
                            view_srcs: mutable darray[sview] = []
                            stale_now: mutable darray[sview] = []
                            table <- stale_view_walk(body, containers, view_names, view_srcs, stale_now, false, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- stale_view_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- stale_view_decls(scoped_body, table)
                        _:
                            pass

        # `enforce_raw_unsafe` is stage0's pure EnforceUnsafePermissions (NOT the strict-proofs
        # union): the raw-extern obligation fires only under it.
        def check_strict_unsafe_ops(file: Ast::File&, enforce_raw_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                all_globals: mutable darray[sview] = []
                collect_mutable_globals(file.top_decls, all_globals)
                # Unsafe.MutableGlobal is about WRITABLE storage: stage0 requires it only for
                # a `global mutable`, and stays silent on a plain `global`. The unfiltered
                # list is the Global family's input, not this one's.
                mutable_globals: mutable darray[sview] = []
                collect_writable_globals(all_globals, file.enum_annotations, mutable_globals)
                extern_names: mutable darray[sview] = []
                collect_extern_names(file.top_decls, extern_names)
                table <- strict_unsafe_effect_call_decls(file.top_decls, extern_names, file.enum_annotations, enforce_raw_unsafe, table)
                table <- strict_extern_call_decls(file.top_decls, extern_names, table) if enforce_raw_unsafe and extern_names.count > 0
                table <- stale_view_decls(file.top_decls, table) if enforce_raw_unsafe
                checked_get_lines: mutable darray[u32] = []
                for annotation in file.enum_annotations |checked_get_lines|:
                    checked_get_lines.push(annotation.line) if annotation.owner == "__checked_get"
                mr_fns: mutable darray[sview] = []
                mr_positions: mutable darray[usize] = []
                collect_mutable_ref_positions(file.top_decls, mr_fns, mr_positions)
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, law_names, law_predicates)
                table <- strict_unsafe_decls(file.top_decls, mutable_globals, checked_get_lines, mr_fns, mr_positions, law_names, law_predicates, table)

        # Append every ident name in EXPRESSION to OUT (requires-mention collection).
        def collect_expression_idents(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Binary(left, operator, right, line):
                        collect_expression_idents(left, out)
                        collect_expression_idents(right, out)
                    Expr.Unary(operator, operand, line):
                        collect_expression_idents(operand, out)
                    Expr.Paren(inner, line):
                        collect_expression_idents(inner, out)
                    Expr.Index(object, index, line):
                        collect_expression_idents(object, out)
                        collect_expression_idents(index, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |out|:
                            collect_expression_idents(argument, out)
                    _:
                        pass
