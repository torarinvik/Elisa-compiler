# A law/predicate must be pure. `law N(...) = <predicate>` states an algebraic property, so
# its predicate may not perform effects (no IO, allocation, mutation, time, or randomness):
#
#   def shout(x: i64) -> bool can[Console.Write]: ...
#   law Bad(self: i64) = shout(self)     # error: uses the `Console.Write` effect
#
# SOUND syntactic subset: build a registry of functions that declare a signature effect
# (`Decl.Func.effects`), then flag a law whose predicate directly calls one — naming that
# function's first effect. A call to a function with no declared effect (or a transitively-
# effectful one lacking a signature clause) is a conservative miss, never a false positive.
extend Semantic:
    private:
        def lp_collect_effectful(declarations: darray[Ast::Decl], names: mutable darray[sview]&, effects: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, effects|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, function_effects, decorators, line):
                            if function_effects.count > 0:
                                names.push(function_name)
                                effects.push(function_effects[0])
                        Decl.Module(module_name, module_body, module_line):
                            lp_collect_effectful(module_body, names, effects)
                        Decl.Scoped(scoped_body, scoped_line):
                            lp_collect_effectful(scoped_body, names, effects)
                        _:
                            pass

        # The first effect of an effectful function called anywhere in the predicate ("" if
        # the predicate calls no registered effectful function).
        def lp_predicate_effect(expression: Ast::Expr, names: darray[sview]&, effects: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        index: mutable usize = 0
                        while index < names.count |index|:
                            effects[index] return if names[index] == callee_name
                            index <- index + 1
                        for argument in arguments:
                            found: sview = lp_predicate_effect(argument, names, effects)
                            found return if found != ""
                        return sview("", 0, 0)
                    Expr.Binary(left, operator, right, binary_line):
                        left_effect: sview = lp_predicate_effect(left, names, effects)
                        left_effect return if left_effect != ""
                        return lp_predicate_effect(right, names, effects)
                    Expr.Unary(operator, operand, unary_line):
                        return lp_predicate_effect(operand, names, effects)
                    Expr.Paren(inner, paren_line):
                        return lp_predicate_effect(inner, names, effects)
                    Expr.Field(object, field, field_line):
                        return lp_predicate_effect(object, names, effects)
                    Expr.Index(object, index_argument, index_line):
                        object_effect: sview = lp_predicate_effect(object, names, effects)
                        object_effect return if object_effect != ""
                        return lp_predicate_effect(index_argument, names, effects)
                    _:
                        return sview("", 0, 0)

        def lp_check_laws(declarations: darray[Ast::Decl], names: darray[sview]&, effects: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Law(law_name, predicate, law_line):
                            effect: sview = lp_predicate_effect(predicate, names, effects)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LawImpure, name: law_name, line: law_line.line, expected: "", actual: effect}) if effect != ""
                        Decl.Module(module_name, module_body, module_line):
                            table <- lp_check_laws(module_body, names, effects, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- lp_check_laws(scoped_body, names, effects, table)
                        _:
                            pass

    public:
        def check_law_purity(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                effects: mutable darray[sview] = []
                lp_collect_effectful(file.top_decls, names, effects)
                table <- lp_check_laws(file.top_decls, names, effects, table)
