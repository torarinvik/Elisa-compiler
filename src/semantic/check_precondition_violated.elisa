# Precondition-violation at call sites. A parameter's `where` refinement (`x: T where x>=0`)
# or a function's `requires` clause constrains an argument; a call passing a CONSTANT that
# provably breaks it is rejected by stage0 ("precondition of X is violated: the argument
# provably does not satisfy requires"). Decidable, SOUND subset: the constraint is a
# constant comparison (or and/or of them) on one parameter and the argument is an integer
# literal — the violation is evaluated directly, so it can only fire on a real violation
# (never a false positive). Reuses predicate_violated_by / where_signed_literal.
extend Semantic:
    private:
        # Whether NAME appears as an identifier anywhere in PREDICATE.
        def predicate_mentions(predicate: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Ident(ident_name, line):
                        return ident_name == name
                    Expr.Binary(left, operator, right, line):
                        return predicate_mentions(left, name) or predicate_mentions(right, name)
                    Expr.Unary(operator, operand, line):
                        return predicate_mentions(operand, name)
                    Expr.Paren(inner, line):
                        return predicate_mentions(inner, name)
                    _:
                        return false

        # Collect (function, constrained-parameter, its index, constraint predicate) for every
        # parameter carrying a `where` refinement, plus every `requires` clause paired with the
        # first parameter it names.
        # Pair an EXTERN's `requires` predicate with each extern parameter it names, indexed by
        # the parameter's call position. Extern preconditions live in the file's signature-
        # contract side-tables (line-paired); extern params in `extern_params[start..start+arity]`.
        def register_extern_requires(function_name: sview, extern_params: darray[Ast::ExternParam]&, param_start: u32, arity: u32, predicate: Ast::Expr, pre_functions: mutable darray[sview]&, pre_variables: mutable darray[sview]&, pre_indices: mutable darray[usize]&, pre_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while position < arity |position: u32 = 0, pre_functions, pre_variables, pre_indices, pre_predicates|:
                    index: usize = (param_start + position).usize()
                    if index < extern_params.count:
                        parameter_name: sview = extern_params[index].name
                        mentions: bool = parameter_name != "" and predicate_mentions(predicate, parameter_name)
                        pre_functions.push(function_name) if mentions
                        pre_variables.push(parameter_name) if mentions
                        pre_indices.push(position.usize()) if mentions
                        pre_predicates.push(predicate) if mentions
                    position <- position + 1

        def collect_preconditions(declarations: darray[Ast::Decl], signature_contract_lines: darray[u32]&, signature_contract_kinds: darray[sview]&, signature_contract_exprs: darray[Ast::Expr]&, extern_params: darray[Ast::ExternParam]&, pre_functions: mutable darray[sview]&, pre_variables: mutable darray[sview]&, pre_indices: mutable darray[usize]&, pre_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            while param_probe < parameters.count |param_probe: usize = 0, pre_functions, pre_variables, pre_indices, pre_predicates|:
                                where_predicate: Ast::Expr = where_predicate_of_type(parameters[param_probe].type_expression)
                                has_where: bool = match where_predicate:
                                    Expr.Absent: false
                                    _: true
                                pre_functions.push(function_name) if has_where
                                pre_variables.push(parameters[param_probe].name) if has_where
                                pre_indices.push(param_probe) if has_where
                                pre_predicates.push(where_predicate) if has_where
                                param_probe <- param_probe + 1
                            for statement in body |pre_functions, pre_variables, pre_indices, pre_predicates|:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        register_requires_precondition(function_name, parameters, expression, pre_functions, pre_variables, pre_indices, pre_predicates) if kind == "requires"
                                    _:
                                        pass
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            while sig_index < signature_contract_exprs.count |sig_index: usize = 0, pre_functions, pre_variables, pre_indices, pre_predicates|:
                                is_requires: bool = callable and signature_contract_lines[sig_index] == line and signature_contract_kinds[sig_index] == "requires"
                                register_extern_requires(extern_name, extern_params, param_start, arity, signature_contract_exprs[sig_index], pre_functions, pre_variables, pre_indices, pre_predicates) if is_requires
                                sig_index <- sig_index + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_preconditions(module_body, signature_contract_lines, signature_contract_kinds, signature_contract_exprs, extern_params, pre_functions, pre_variables, pre_indices, pre_predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_preconditions(scoped_body, signature_contract_lines, signature_contract_kinds, signature_contract_exprs, extern_params, pre_functions, pre_variables, pre_indices, pre_predicates)
                        _:
                            pass

        # Pair a `requires` predicate with the first parameter it names (single-parameter
        # constraints — the decidable subset).
        def register_requires_precondition(function_name: sview, parameters: darray[Ast::ParamDecl], predicate: Ast::Expr, pre_functions: mutable darray[sview]&, pre_variables: mutable darray[sview]&, pre_indices: mutable darray[usize]&, pre_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while probe < parameters.count |probe: usize = 0, pre_functions, pre_variables, pre_indices, pre_predicates|:
                    mentions: bool = predicate_mentions(predicate, parameters[probe].name)
                    pre_functions.push(function_name) if mentions
                    pre_variables.push(parameters[probe].name) if mentions
                    pre_indices.push(probe) if mentions
                    pre_predicates.push(predicate) if mentions
                    probe <- probe + 1

        # Whether signature row `probe` matches this call AND its constant argument violates
        # the precondition. Guarded so the argument access is in-bounds.
        def precondition_violated_at(probe: usize, callee_name: sview, arguments: darray[Ast::Expr]&, pre_functions: darray[sview]&, pre_variables: darray[sview]&, pre_indices: darray[usize]&, pre_predicates: darray[Ast::Expr]&, const_names: darray[sview]&, const_values: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if pre_functions[probe] != callee_name
                false return if pre_indices[probe] >= arguments.count
                argument_literal: (found: bool, value: i64) = argument_constant(arguments[pre_indices[probe]], const_names, const_values)
                false return if not argument_literal.found
                return predicate_violated_by(pre_predicates[probe], pre_variables[probe], argument_literal.value)

        def precondition_check_expression(expression: Ast::Expr, line: u32, pre_functions: darray[sview]&, pre_variables: darray[sview]&, pre_indices: darray[usize]&, pre_predicates: darray[Ast::Expr]&, const_names: darray[sview]&, const_values: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        while probe < pre_functions.count |probe: usize = 0, table| -> table:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionViolated, name: callee_name, line: line, expected: "", actual: ""}) if callee_name != "" and precondition_violated_at(probe, callee_name, arguments, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values)
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- precondition_check_expression(argument, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- precondition_check_expression(left, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        table <- precondition_check_expression(right, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                    Expr.Paren(inner, paren_line):
                        table <- precondition_check_expression(inner, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                    _:
                        pass

        def precondition_check_statements(statements: darray[Ast::Stmt], pre_functions: darray[sview]&, pre_variables: darray[sview]&, pre_indices: darray[usize]&, pre_predicates: darray[Ast::Expr]&, const_names: mutable darray[sview]&, const_values: mutable darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, const_names, const_values| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- precondition_check_expression(expression, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            constant: (found: bool, value: i64) = where_signed_literal(value)
                            const_names.push(name) if constant.found
                            const_values.push(constant.value) if constant.found
                            table <- precondition_check_expression(value, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- precondition_check_expression(value, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- precondition_check_expression(returned, line, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- precondition_check_statements(then_body, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                            table <- precondition_check_statements(else_body, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Stmt.While(condition, while_body, line):
                            table <- precondition_check_statements(while_body, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- precondition_check_statements(block_body, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- precondition_check_statements(for_body, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        _:
                            pass

        def precondition_check_walk(declarations: darray[Ast::Decl], pre_functions: darray[sview]&, pre_variables: darray[sview]&, pre_indices: darray[usize]&, pre_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            const_names: mutable darray[sview] = []
                            const_values: mutable darray[i64] = []
                            table <- precondition_check_statements(body, pre_functions, pre_variables, pre_indices, pre_predicates, const_names, const_values, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- precondition_check_walk(module_body, pre_functions, pre_variables, pre_indices, pre_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- precondition_check_walk(scoped_body, pre_functions, pre_variables, pre_indices, pre_predicates, table)
                        _:
                            pass

        def check_precondition_violated(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                pre_functions: mutable darray[sview] = []
                pre_variables: mutable darray[sview] = []
                pre_indices: mutable darray[usize] = []
                pre_predicates: mutable darray[Ast::Expr] = []
                collect_preconditions(file.top_decls, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, file.extern_params, pre_functions, pre_variables, pre_indices, pre_predicates)
                table <- precondition_check_walk(file.top_decls, pre_functions, pre_variables, pre_indices, pre_predicates, table)

        # Precondition-COULD-NOT-PROVE at call sites (a WARNING, disjoint from the VIOLATION
        # error above). At a call to a function whose parameter carries a `requires`/`where`
        # constraint, an argument that is an UNCONSTRAINED refinement-free variable of the caller
        # cannot be shown to satisfy the constraint — stage0 warns "precondition of X could not be
        # proven statically". Uses the exact maximally-conservative fact model of
        # check_refinement_arg_unproven (unproven_arg_at): fires ONLY when the argument is a
        # refinement-free, non-unsigned parameter with NO establishing fact (guard / contract /
        # reassignment), so it never fires where stage0 proves — a literal, a guarded/refined
        # argument, or an unsigned parameter all carry facts and stay silent.
        def precondition_unproven_expression(expression: Ast::Expr, line: u32, pre_functions: darray[sview]&, pre_indices: darray[usize]&, refinement_free_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        probe: mutable usize = 0
                        while probe < pre_functions.count |table, probe| -> table:
                            fires: bool = callee_name != "" and pre_functions[probe] == callee_name and pre_indices[probe] < arguments.count and unproven_arg_at(arguments[pre_indices[probe]], refinement_free_params, fact_names)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: callee_name, line: line, expected: "", actual: ""}) if fires
                            probe <- probe + 1
                        for argument in arguments |table| -> table:
                            table <- precondition_unproven_expression(argument, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- precondition_unproven_expression(left, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        table <- precondition_unproven_expression(right, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- precondition_unproven_expression(inner, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                    _:
                        pass

        def precondition_unproven_statements(statements: darray[Ast::Stmt], pre_functions: darray[sview]&, pre_indices: darray[usize]&, refinement_free_params: darray[sview]&, fact_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- precondition_unproven_expression(returned, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Stmt.Expr(expression, line):
                            table <- precondition_unproven_expression(expression, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- precondition_unproven_expression(value, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- precondition_unproven_expression(value, line, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- precondition_unproven_statements(then_body, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                            table <- precondition_unproven_statements(else_body, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Stmt.While(condition, while_body, line):
                            table <- precondition_unproven_statements(while_body, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- precondition_unproven_statements(block_body, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- precondition_unproven_statements(for_body, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        _:
                            pass

        def precondition_unproven_walk(declarations: darray[Ast::Decl], signature_contract_exprs: darray[Ast::Expr], signature_contract_lines: darray[u32], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, pre_functions: darray[sview]&, pre_indices: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            refinement_free_params: mutable darray[sview] = []
                            for parameter in parameters |refinement_free_params|:
                                refinement_free_params.push(parameter.name) if param_is_warnable(parameter.type_expression, law_names, law_predicates, alias_names, alias_predicates)
                            fact_names: mutable darray[sview] = []
                            collect_body_fact_names(body, fact_names)
                            sig_index: mutable usize = 0
                            while sig_index < signature_contract_exprs.count |fact_names, sig_index|:
                                collect_idents_in_expr(signature_contract_exprs[sig_index], fact_names) if signature_contract_lines[sig_index] == line
                                sig_index <- sig_index + 1
                            table <- precondition_unproven_statements(body, pre_functions, pre_indices, refinement_free_params, fact_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- precondition_unproven_walk(module_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, pre_functions, pre_indices, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- precondition_unproven_walk(scoped_body, signature_contract_exprs, signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, pre_functions, pre_indices, table)
                        _:
                            pass

        def check_precondition_unproven(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, law_names, law_predicates)
                alias_names: mutable darray[sview] = []
                alias_predicates: mutable darray[Ast::Expr] = []
                collect_refine_aliases(file.top_decls, alias_names, alias_predicates)
                pre_functions: mutable darray[sview] = []
                pre_variables: mutable darray[sview] = []
                pre_indices: mutable darray[usize] = []
                pre_predicates: mutable darray[Ast::Expr] = []
                collect_preconditions(file.top_decls, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, file.extern_params, pre_functions, pre_variables, pre_indices, pre_predicates)
                table <- precondition_unproven_walk(file.top_decls, file.signature_contract_exprs, file.signature_contract_lines, law_names, law_predicates, alias_names, alias_predicates, pre_functions, pre_indices, table)
