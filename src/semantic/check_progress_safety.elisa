# Progress-safety (stage0's EnforceProgressSafety): a `while` loop must carry EVIDENCE that it
# makes progress toward termination, otherwise it may spin forever. Evidence stage0 accepts:
#   - a `decreases <measure>` contract in the loop body,
#   - a Progress budget (a `can Progress.Tick:`/`can Progress.Yield:` block, enclosing or nested),
#   - the escape hatches `can/trusted Unsafe.AssumeProgress:` / `can/trusted Unsafe.NonProgress:`,
#   - a loop-condition variable mutated toward its bound (the counting/direction proof).
# This is the CONSERVATIVE port: it FIRES when the body assigns to NO condition variable at all
# (a provably-stuck loop like `while flag: pass`), or when every provable update moves a simple
# comparison variable away from its bound. Opaque updates suppress the direction finding. That
# avoids over-firing on loops carrying any of the evidence forms above. Gated on `enforce_progress`
# (EnforceProgressSafety).
extend Semantic:
    private:
        # A literal condition makes one branch unreachable, so use only the branch that can run.
        def progress_literal_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            can Abort.Panic:
                return match expression:
                    Expr.BoolLit(value, _): (true, value)
                    Expr.Paren(inner, _): progress_literal_bool(inner)
                    Expr.Unary(TokenKind.Not, operand, _):
                        operand_literal: (known: bool, value: bool) = progress_literal_bool(operand)
                        (true, not operand_literal.value) if operand_literal.known else (false, false)
                    Expr.Binary(left, TokenKind.And, right, _):
                        left_literal: (known: bool, value: bool) = progress_literal_bool(left)
                        if left_literal.known and not left_literal.value:
                            (true, false)
                        elif left_literal.known:
                            progress_literal_bool(right)
                        else:
                            right_literal: (known: bool, value: bool) = progress_literal_bool(right)
                            (true, false) if right_literal.known and not right_literal.value else (false, false)
                    Expr.Binary(left, TokenKind.Or, right, _):
                        left_literal: (known: bool, value: bool) = progress_literal_bool(left)
                        if left_literal.known and left_literal.value:
                            (true, true)
                        elif left_literal.known:
                            progress_literal_bool(right)
                        else:
                            right_literal: (known: bool, value: bool) = progress_literal_bool(right)
                            (true, true) if right_literal.known and right_literal.value else (false, false)
                    _: (false, false)

        # The block grants that discharge a loop's progress obligation.
        def progress_grant_is_evidence(grant: sview) -> bool:
            can Abort.Panic:
                return when grant:
                    "Unsafe.AssumeProgress" | "Unsafe.NonProgress" | "Progress.Tick" | "Progress.Yield" | "Progress.EnterRecursion" -> true
                    _ -> false

        # Carry the paths that have/have not reached a progress hatch through the body. Function
        # exits and breaks are discharged paths; continues are frozen at their source position.
        # Nested loops are separate obligations and may execute zero times.
        def progress_evidence_paths(statements: darray[Ast::Stmt], table: SymbolTable&, starts_uncovered: bool, starts_covered: bool) -> (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool):
            can Memory.Allocate, Abort.Panic:
                uncovered: mutable bool = starts_uncovered
                covered: mutable bool = starts_covered
                continued_uncovered: mutable bool = false
                continued_covered: mutable bool = false
                for statement in statements |uncovered, covered, continued_uncovered, continued_covered, table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, block_line):
                            direct_grant: bool = (kind == "can" or kind == "trusted") and (any grant in clause where progress_grant_is_evidence(grant))
                            if direct_grant:
                                grant_covered: bool = covered or uncovered
                                nested: (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool) = progress_evidence_paths(body, table, false, grant_covered)
                                uncovered <- nested.uncovered
                                covered <- nested.covered
                                continued_uncovered <- continued_uncovered or nested.continued_uncovered
                                continued_covered <- continued_covered or nested.continued_covered
                            else:
                                nested: (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool) = progress_evidence_paths(body, table, uncovered, covered)
                                uncovered <- nested.uncovered
                                covered <- nested.covered
                                continued_uncovered <- continued_uncovered or nested.continued_uncovered
                                continued_covered <- continued_covered or nested.continued_covered
                        Stmt.If(condition, then_body, else_body, if_line):
                            if expression_evaluation_aborts(condition, table):
                                uncovered <- false
                                covered <- false
                            else:
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    selected_body: darray[Ast::Stmt] = then_body if literal.value else else_body
                                    selected: (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool) = progress_evidence_paths(selected_body, table, uncovered, covered)
                                    uncovered <- selected.uncovered
                                    covered <- selected.covered
                                    continued_uncovered <- continued_uncovered or selected.continued_uncovered
                                    continued_covered <- continued_covered or selected.continued_covered
                                else:
                                    then_summary: (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool) = progress_evidence_paths(then_body, table, uncovered, covered)
                                    else_summary: (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool) = progress_evidence_paths(else_body, table, uncovered, covered)
                                    uncovered <- then_summary.uncovered or else_summary.uncovered
                                    covered <- then_summary.covered or else_summary.covered
                                    continued_uncovered <- continued_uncovered or then_summary.continued_uncovered or else_summary.continued_uncovered
                                    continued_covered <- continued_covered or then_summary.continued_covered or else_summary.continued_covered
                        Stmt.Match(scrutinee, arms, match_line):
                            is_catch: bool = progress_is_catch_match(table, match_line.line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_raises: bool = expression_may_raise_catchably(scrutinee, table)
                            if scrutinee_aborts and not (is_catch and scrutinee_raises):
                                uncovered <- false
                                covered <- false
                            else:
                                match_is_total: bool = progress_catch_error_arms_total_at(arms, table, match_line.line) if is_catch else progress_match_is_total(scrutinee, arms, table)
                                start_uncovered: bool = uncovered
                                start_covered: bool = covered
                                uncovered <- start_uncovered if not match_is_total
                                covered <- start_covered if not match_is_total
                                if match_is_total:
                                    uncovered <- false
                                    covered <- false
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, uncovered, covered, continued_uncovered, continued_covered, start_uncovered, start_covered, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    arm_reachable: bool = not (guard.known and not guard.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)) and not (is_catch and scrutinee_aborts and arm_index == 0)
                                    if arm_reachable:
                                        arm_summary: (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool) = progress_evidence_paths(arm.body, table, start_uncovered, start_covered)
                                        if not expression_evaluation_aborts(arm.guard, table):
                                            uncovered <- uncovered or arm_summary.uncovered
                                            covered <- covered or arm_summary.covered
                                            continued_uncovered <- continued_uncovered or arm_summary.continued_uncovered
                                            continued_covered <- continued_covered or arm_summary.continued_covered
                                    arm_index <- arm_index + 1
                        Stmt.Return(_, _) | Stmt.Break(_, _):
                            uncovered <- false
                            covered <- false
                        Stmt.Continue(_, _):
                            continued_uncovered <- continued_uncovered or uncovered
                            continued_covered <- continued_covered or covered
                            uncovered <- false
                            covered <- false
                        _:
                            pass
                    if statement_terminates(statement, table):
                        uncovered <- false
                        covered <- false
                return (uncovered, covered, continued_uncovered, continued_covered)

        # Every path that can reach the next iteration must have discharged progress.
        def progress_body_evidence_summary(statements: darray[Ast::Stmt], table: SymbolTable&) -> (all_loop_paths_covered: bool, has_looping_path: bool):
            can Memory.Allocate, Abort.Panic:
                paths: (uncovered: bool, covered: bool, continued_uncovered: bool, continued_covered: bool) = progress_evidence_paths(statements, table, true, false)
                has_looping_path: bool = paths.uncovered or paths.covered or paths.continued_uncovered or paths.continued_covered
                return (not paths.uncovered and not paths.continued_uncovered, has_looping_path)

        def progress_has_evidence_block(statements: darray[Ast::Stmt], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                summary: (all_loop_paths_covered: bool, has_looping_path: bool) = progress_body_evidence_summary(statements, table)
                return summary.all_loop_paths_covered and summary.has_looping_path

        # Whether the loop body carries a `decreases` contract (its own progress measure).
        def progress_body_has_decreases(statements: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            return true if kind == "decreases" or kind == "decreases*"
                        _:
                            pass
                return false

        # `=` introduces a binding only for a plain name (or a tuple of binding names). A
        # projected target such as `object.field = value` still writes through its base.
        def progress_target_binds_name(target: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(target_name, _):
                        return target_name == name
                    Expr.Tuple(elements, _):
                        return any element in elements where progress_target_binds_name(element, name)
                    _:
                        return false

        # The identifiers a (condition) expression mentions.
        def progress_expr_idents(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        out.push(name)
                    Expr.Binary(left, operator, right, line):
                        progress_expr_idents(left, out)
                        progress_expr_idents(right, out)
                    Expr.Unary(operator, operand, line):
                        progress_expr_idents(operand, out)
                    Expr.Paren(inner, line):
                        progress_expr_idents(inner, out)
                    Expr.Field(object, field, line):
                        pass
                    Expr.Index(object, index, line):
                        progress_expr_idents(index, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        progress_expr_idents(callee, out)
                        for argument in arguments |out|:
                            progress_expr_idents(argument, out)
                    _:
                        pass

        # For the comparison shape understood by the direction proof, separate the subject from
        # its bound. A changing RHS must not stand in for movement of the LHS; nontrivial bounds
        # stay unsupported so their stability is not silently assumed.
        def progress_bound_is_static_or_named(expression: Ast::Expr, names: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _):
                        return true
                    Expr.Ident(name, _):
                        names.push(name)
                        return true
                    Expr.Paren(inner, _):
                        return progress_bound_is_static_or_named(inner, names)
                    Expr.Unary(operator, operand, _) if operator == TokenKind.Minus:
                        match operand:
                            Expr.IntLit(_, _) | Expr.FloatLit(_, _):
                                return true
                            _:
                                return false
                    _:
                        return false

        def progress_condition_names(condition: Ast::Expr, subject_names: mutable darray[sview]&, bound_names: mutable darray[sview]&) -> (supported_subject: bool, supported_bound: bool):
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, _):
                        comparison: bool = operator == TokenKind.Lt or operator == TokenKind.LtEq or operator == TokenKind.Gt or operator == TokenKind.GtEq
                        subject: sview = ident_name_of(left)
                        if comparison and subject != "":
                            subject_names.push(subject)
                            return (true, progress_bound_is_static_or_named(right, bound_names))
                    _:
                        pass
                progress_expr_idents(condition, subject_names)
                return (false, false)

        # Whether a statement mutates a condition name in the current lexical scope. Plain `=`
        # and declarations introduce shadows; subsequent writes to that name no longer reach
        # the loop variable. Each nested scope gets its own shadow state.
        def progress_body_assigns_name(statements: darray[Ast::Stmt], name: sview, was_shadowed: bool, table: SymbolTable&) -> (assigns: bool, falls_through: bool):
            can Memory.Allocate, Abort.Panic:
                shadowed: mutable bool = was_shadowed
                falls_through: mutable bool = true
                for statement in statements |name, shadowed, falls_through|:
                    return (false, false) if not falls_through
                    match statement:
                        Stmt.Assign(target, operator, value, assign_line):
                            if operator == TokenKind.Assign and progress_target_binds_name(target, name):
                                shadowed <- true
                            else:
                                assigned: sview = ident_name_of(target)
                                return (true, false) if assigned == name and not shadowed
                        Stmt.VarDecl(declared_name, type_expression, decl_value, decl_line):
                            shadowed <- true if declared_name == name
                        Stmt.If(condition, then_body, else_body, if_line):
                            literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if literal.known:
                                branch: (assigns: bool, falls_through: bool) = progress_body_assigns_name(then_body, name, shadowed, table) if literal.value else progress_body_assigns_name(else_body, name, shadowed, table)
                                return (true, false) if branch.assigns
                                falls_through <- branch.falls_through
                            else:
                                then_branch: (assigns: bool, falls_through: bool) = progress_body_assigns_name(then_body, name, shadowed, table)
                                else_branch: (assigns: bool, falls_through: bool) = progress_body_assigns_name(else_body, name, shadowed, table)
                                return (true, false) if then_branch.assigns or else_branch.assigns
                                falls_through <- then_branch.falls_through or else_branch.falls_through
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            block_shadows_name: bool = binding == name
                            block_summary: (assigns: bool, falls_through: bool) = progress_body_assigns_name(block_body, name, shadowed or block_shadows_name, table)
                            return (true, false) if block_summary.assigns
                            falls_through <- block_summary.falls_through
                        Stmt.Match(scrutinee, arms, match_line):
                            match_total: bool = progress_match_is_total(scrutinee, arms, table)
                            match_falls_through: mutable bool = not match_total
                            for arm in arms |name, shadowed, table, match_falls_through|:
                                arm_summary: (assigns: bool, falls_through: bool) = progress_body_assigns_name(arm.body, name, shadowed or mdc_pattern_binds_name(arm.pattern, name), table)
                                return (true, false) if arm_summary.assigns
                                match_falls_through <- match_falls_through or arm_summary.falls_through
                            falls_through <- match_falls_through
                        Stmt.Return(_, _) | Stmt.Break(_, _) | Stmt.Continue(_, _):
                            return (false, false)
                        _:
                            pass
                return (false, falls_through)

        # Whether any statement list mutates any identifier used by the condition.
        def progress_body_assigns_any(statements: darray[Ast::Stmt], names: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for candidate in names:
                    summary: (assigns: bool, falls_through: bool) = progress_body_assigns_name(statements, candidate, false, table)
                    return true if summary.assigns
                return false

        # The direction of a signed integer literal. Keep this deliberately narrow: parser
        # payloads at or below zero can represent oversized positive magnitudes, and unary
        # negation of i64.min overflows, so those shapes stay opaque.
        def progress_literal_step_sign(value: Ast::Expr) -> (known: bool, sign: i64):
            can Abort.Panic:
                match value:
                    Expr.IntLit(literal_value, _):
                        return (true, 1) if literal_value > 0
                        return (true, 0) if literal_value == 0
                        return (false, 0)
                    Expr.Unary(operator, operand, _):
                        return (false, 0) if operator != TokenKind.Minus
                        return match operand:
                            # Integer magnitudes above i64.max are represented by i64.min;
                            # negating that payload is overflow and the source direction is
                            # deliberately left unproven.
                            Expr.IntLit(literal_value, _): (true, 0 - 1) if literal_value > 0 else (false, 0)
                            _: (false, 0)
                    _:
                        return (false, 0)

        # Classify an assignment to `v`: known=true with sign +1/0/-1 means increase/stall/
        # decrease; known=false means an update whose direction is not provable.
        def progress_step_sign(operator: TokenKind, value: Ast::Expr, v: sview) -> (known: bool, sign: i64):
            can Memory.Allocate, Abort.Panic:
                literal_step: (known: bool, sign: i64) = progress_literal_step_sign(value)
                return literal_step if operator == TokenKind.PlusEq
                if operator == TokenKind.MinusEq:
                    return (false, 0) if not literal_step.known
                    return (true, 0 - literal_step.sign)
                return (false, 0) if operator != TokenKind.LArrow
                match value:
                    Expr.Binary(left, binary_operator, right, binary_line):
                        return (false, 0) if ident_name_of(left) != v
                        right_step: (known: bool, sign: i64) = progress_literal_step_sign(right)
                        return (false, 0) if not right_step.known
                        return right_step if binary_operator == TokenKind.Plus
                        return (true, 0 - right_step.sign) if binary_operator == TokenKind.Minus
                        return (false, 0)
                    _:
                        return (false, 0)

        # Carry the possible outcomes of the current loop iteration through a statement list.
        # A path is waiting if it has not updated `v`, advancing if every known write so far
        # points toward the bound, wrong if a known write stalls/reverses that movement, and
        # opaque if an unclassified write prevents a direction conclusion. Return/break paths
        # disappear; continue paths are saved separately so later unreachable statements cannot
        # count as progress. Nested loops are ignored because they may execute zero times.
        def progress_all_paths_advance(statements: darray[Ast::Stmt], v: sview, expected_sign: i64, was_shadowed: bool, starts_waiting: bool, starts_advancing: bool, starts_wrong: bool, starts_opaque: bool, table: SymbolTable&) -> (waiting: bool, advancing: bool, wrong: bool, opaque: bool, continued_waiting: bool, continued_advancing: bool, continued_wrong: bool, continued_opaque: bool):
            can Memory.Allocate, Abort.Panic:
                waiting: mutable bool = starts_waiting
                advancing: mutable bool = starts_advancing
                wrong: mutable bool = starts_wrong
                opaque: mutable bool = starts_opaque
                continued_waiting: mutable bool = false
                continued_advancing: mutable bool = false
                continued_wrong: mutable bool = false
                continued_opaque: mutable bool = false
                shadowed: mutable bool = was_shadowed
                for statement in statements |v, expected_sign, shadowed, waiting, advancing, wrong, opaque, continued_waiting, continued_advancing, continued_wrong, continued_opaque, table|:
                    match statement:
                        Stmt.Assign(target, operator, value, assign_line):
                            if operator == TokenKind.Assign and progress_target_binds_name(target, v):
                                shadowed <- true
                            elif ident_name_of(target) == v and not shadowed:
                                step: (known: bool, sign: i64) = progress_step_sign(operator, value, v)
                                if not step.known:
                                    opaque <- opaque or waiting or advancing or wrong
                                    waiting <- false
                                    advancing <- false
                                    wrong <- false
                                elif step.sign == expected_sign:
                                    advancing <- advancing or waiting
                                    waiting <- false
                                else:
                                    wrong <- wrong or waiting or advancing
                                    waiting <- false
                        Stmt.VarDecl(name, type_expression, value, decl_line):
                            shadowed <- true if name == v
                        Stmt.If(condition, then_body, else_body, if_line):
                            literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if literal.known:
                                selected_body: darray[Ast::Stmt] = then_body if literal.value else else_body
                                selected_summary: (waiting: bool, advancing: bool, wrong: bool, opaque: bool, continued_waiting: bool, continued_advancing: bool, continued_wrong: bool, continued_opaque: bool) = progress_all_paths_advance(selected_body, v, expected_sign, shadowed, waiting, advancing, wrong, opaque, table)
                                waiting <- selected_summary.waiting
                                advancing <- selected_summary.advancing
                                wrong <- selected_summary.wrong
                                opaque <- selected_summary.opaque
                                continued_waiting <- continued_waiting or selected_summary.continued_waiting
                                continued_advancing <- continued_advancing or selected_summary.continued_advancing
                                continued_wrong <- continued_wrong or selected_summary.continued_wrong
                                continued_opaque <- continued_opaque or selected_summary.continued_opaque
                            else:
                                then_summary: (waiting: bool, advancing: bool, wrong: bool, opaque: bool, continued_waiting: bool, continued_advancing: bool, continued_wrong: bool, continued_opaque: bool) = progress_all_paths_advance(then_body, v, expected_sign, shadowed, waiting, advancing, wrong, opaque, table)
                                else_summary: (waiting: bool, advancing: bool, wrong: bool, opaque: bool, continued_waiting: bool, continued_advancing: bool, continued_wrong: bool, continued_opaque: bool) = progress_all_paths_advance(else_body, v, expected_sign, shadowed, waiting, advancing, wrong, opaque, table)
                                waiting <- then_summary.waiting or else_summary.waiting
                                advancing <- then_summary.advancing or else_summary.advancing
                                wrong <- then_summary.wrong or else_summary.wrong
                                opaque <- then_summary.opaque or else_summary.opaque
                                continued_waiting <- continued_waiting or then_summary.continued_waiting or else_summary.continued_waiting
                                continued_advancing <- continued_advancing or then_summary.continued_advancing or else_summary.continued_advancing
                                continued_wrong <- continued_wrong or then_summary.continued_wrong or else_summary.continued_wrong
                                continued_opaque <- continued_opaque or then_summary.continued_opaque or else_summary.continued_opaque
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            block_summary: (waiting: bool, advancing: bool, wrong: bool, opaque: bool, continued_waiting: bool, continued_advancing: bool, continued_wrong: bool, continued_opaque: bool) = progress_all_paths_advance(block_body, v, expected_sign, shadowed or binding == v, waiting, advancing, wrong, opaque, table)
                            waiting <- block_summary.waiting
                            advancing <- block_summary.advancing
                            wrong <- block_summary.wrong
                            opaque <- block_summary.opaque
                            continued_waiting <- continued_waiting or block_summary.continued_waiting
                            continued_advancing <- continued_advancing or block_summary.continued_advancing
                            continued_wrong <- continued_wrong or block_summary.continued_wrong
                            continued_opaque <- continued_opaque or block_summary.continued_opaque
                        Stmt.Match(scrutinee, arms, match_line):
                            is_catch: bool = progress_is_catch_match(table, match_line.line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_may_raise: bool = expression_may_raise_catchably(scrutinee, table)
                            if scrutinee_aborts and not (is_catch and scrutinee_may_raise):
                                waiting <- false
                                advancing <- false
                                wrong <- false
                                opaque <- false
                            else:
                                match_is_total: bool = progress_catch_error_arms_total_at(arms, table, match_line.line) if is_catch else progress_match_is_total(scrutinee, arms, table)
                                start_waiting: bool = waiting
                                start_advancing: bool = advancing
                                start_wrong: bool = wrong
                                start_opaque: bool = opaque
                                waiting <- false
                                advancing <- false
                                wrong <- false
                                opaque <- false
                                waiting <- start_waiting if not match_is_total
                                advancing <- start_advancing if not match_is_total
                                wrong <- start_wrong if not match_is_total
                                opaque <- start_opaque if not match_is_total
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, is_catch, scrutinee, scrutinee_aborts, waiting, advancing, wrong, opaque, continued_waiting, continued_advancing, continued_wrong, continued_opaque, start_waiting, start_advancing, start_wrong, start_opaque, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    arm_reachable: bool = not (guard.known and not guard.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)) and not (is_catch and scrutinee_aborts and arm_index == 0)
                                    if arm_reachable and not expression_evaluation_aborts(arm.guard, table):
                                        arm_summary: (waiting: bool, advancing: bool, wrong: bool, opaque: bool, continued_waiting: bool, continued_advancing: bool, continued_wrong: bool, continued_opaque: bool) = progress_all_paths_advance(arm.body, v, expected_sign, shadowed or mdc_pattern_binds_name(arm.pattern, v), start_waiting, start_advancing, start_wrong, start_opaque, table)
                                        waiting <- waiting or arm_summary.waiting
                                        advancing <- advancing or arm_summary.advancing
                                        wrong <- wrong or arm_summary.wrong
                                        opaque <- opaque or arm_summary.opaque
                                        continued_waiting <- continued_waiting or arm_summary.continued_waiting
                                        continued_advancing <- continued_advancing or arm_summary.continued_advancing
                                        continued_wrong <- continued_wrong or arm_summary.continued_wrong
                                        continued_opaque <- continued_opaque or arm_summary.continued_opaque
                                    arm_index <- arm_index + 1
                        Stmt.Return(_, _) | Stmt.Break(_, _):
                            waiting <- false
                            advancing <- false
                            wrong <- false
                            opaque <- false
                        Stmt.Continue(_, _):
                            continued_waiting <- continued_waiting or waiting
                            continued_advancing <- continued_advancing or advancing
                            continued_wrong <- continued_wrong or wrong
                            continued_opaque <- continued_opaque or opaque
                            waiting <- false
                            advancing <- false
                            wrong <- false
                            opaque <- false
                        _:
                            pass
                return (waiting, advancing, wrong, opaque, continued_waiting, continued_advancing, continued_wrong, continued_opaque)

        # A loop with a reachable path lacking an update toward its bound has no progress
        # evidence. Only the simple
        # single-variable comparison condition `v < B` / `v <= B` / `v > B` / `v >= B` is
        # judged: an upper-bounded loop must INCREMENT `v`; a lower-bounded loop must
        # DECREMENT it. An opaque update suppresses the finding conservatively.
        def progress_moves_wrong_direction(condition: Ast::Expr, while_body: darray[Ast::Stmt], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        v: sview = ident_name_of(left)
                        return false if v == ""
                        upper_bounded: bool = operator == TokenKind.Lt or operator == TokenKind.LtEq
                        lower_bounded: bool = operator == TokenKind.Gt or operator == TokenKind.GtEq
                        return false if not upper_bounded and not lower_bounded
                        expected_sign: i64 = 1 if upper_bounded else (0 - 1)
                        summary: (waiting: bool, advancing: bool, wrong: bool, opaque: bool, continued_waiting: bool, continued_advancing: bool, continued_wrong: bool, continued_opaque: bool) = progress_all_paths_advance(while_body, v, expected_sign, false, true, false, false, false, table)
                        has_opaque: bool = summary.opaque or summary.continued_opaque
                        has_looping_path: bool = summary.waiting or summary.advancing or summary.wrong or summary.opaque or summary.continued_waiting or summary.continued_advancing or summary.continued_wrong or summary.continued_opaque
                        return false if has_opaque or not has_looping_path
                        body_mutates_v: (assigns: bool, falls_through: bool) = progress_body_assigns_name(while_body, v, false, table)
                        has_unadvanced_path: bool = summary.waiting or summary.continued_waiting
                        return summary.wrong or summary.continued_wrong or (body_mutates_v.assigns and has_unadvanced_path)
                    _:
                        return false

        def progress_safety_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.While(condition, while_body, line):
                            has_decreases: bool = progress_body_has_decreases(while_body)
                            body_evidence: (all_loop_paths_covered: bool, has_looping_path: bool) = progress_body_evidence_summary(while_body, table)
                            has_hatch: bool = body_evidence.all_loop_paths_covered and body_evidence.has_looping_path
                            condition_names: mutable darray[sview] = []
                            condition_bound_names: mutable darray[sview] = []
                            condition_shape: (supported_subject: bool, supported_bound: bool) = progress_condition_names(condition, condition_names, condition_bound_names)
                            mutates_condition: bool = progress_body_assigns_any(while_body, condition_names, table)
                            mutates_bound: bool = progress_body_assigns_any(while_body, condition_bound_names, table)
                            wrong_direction: bool = progress_moves_wrong_direction(condition, while_body, table)
                            # No evidence: the body never touches the comparison subject, changes
                            # its bound, relies on a dynamic bound we cannot track, or stalls/reverses.
                            unstable_bound: bool = condition_shape.supported_subject and not condition_shape.supported_bound
                            no_evidence: bool = body_evidence.has_looping_path and not has_decreases and not has_hatch and (not mutates_condition or wrong_direction or mutates_bound or unstable_bound)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProgressNoEvidence, name: "", line: line.line, expected: "", actual: ""}) if no_evidence
                            table <- progress_safety_statements(while_body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            if not expression_evaluation_aborts(condition, table):
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    table <- progress_safety_statements(then_body, table) if literal.value
                                    table <- progress_safety_statements(else_body, table) if not literal.value
                                else:
                                    table <- progress_safety_statements(then_body, table)
                                    table <- progress_safety_statements(else_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- progress_safety_statements(for_body, table) if not progress_empty_iterable(iterable) and not expression_evaluation_aborts(iterable, table)
                        Stmt.Match(scrutinee, arms, line):
                            is_catch: bool = progress_is_catch_match(table, line.line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            catchable_raise: bool = expression_may_raise_catchably(scrutinee, table)
                            if not scrutinee_aborts or (is_catch and catchable_raise):
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, is_catch, scrutinee, scrutinee_aborts, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    arm_reachable: bool = not (guard.known and not guard.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)) and not (is_catch and scrutinee_aborts and arm_index == 0)
                                    if arm_reachable and not expression_evaluation_aborts(arm.guard, table):
                                        table <- progress_safety_statements(arm.body, table)
                                    arm_index <- arm_index + 1
                        Stmt.Block(kind, clause, binding, body, block_line):
                            # A `can/trusted …:` progress hatch wrapping the loop discharges every
                            # loop nested inside it — skip the whole subtree.
                            wraps_evidence: bool = (kind == "can" or kind == "trusted") and (any grant in clause where progress_grant_is_evidence(grant))
                            table <- progress_safety_statements(body, table) if not wraps_evidence
                        _:
                            pass

        # A literal empty array proves that a for/comprehension body cannot execute.
        def progress_empty_iterable(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Array(elements, _):
                        return elements.count == 0
                    Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        return elements.count == 0
                    Expr.DictLit(entries, _):
                        return entries.count == 0
                    Expr.StringLit(text, _):
                        return text.len == 2 and text[0] == 34 and text[1] == 34
                    Expr.Paren(inner, _):
                        return progress_empty_iterable(inner)
                    _:
                        return false

        # Whether a pattern proves that it does or does not match a literal bool.
        def progress_bool_pattern_matches(pattern: Ast::Pattern, value: bool) -> (known: bool, matches: bool):
            can Memory.Allocate, Abort.Panic:
                return match pattern:
                    Ast::Pattern.Wildcard | Ast::Pattern.Binding(_): (true, true)
                    Ast::Pattern.Literal(text):
                        if text == "true": (true, value)
                        elif text == "false": (true, not value)
                        else: (false, false)
                    Ast::Pattern.Or(options):
                        known: mutable bool = options.count > 0
                        matches: mutable bool = false
                        for option in options |known, matches|:
                            option_match: (known: bool, matches: bool) = progress_bool_pattern_matches(option, value)
                            known <- known and option_match.known
                            matches <- matches or option_match.matches
                        (known, matches)
                    Ast::Pattern.As(_, inner):
                        if inner.count == 1:
                            progress_bool_pattern_matches(inner[0], value)
                        else:
                            (false, false)
                    _: (false, false)

        def progress_pattern_is_irrefutable(pattern: Ast::Pattern) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match pattern:
                    Ast::Pattern.Wildcard | Ast::Pattern.Binding(_): true
                    Ast::Pattern.Tuple(elements): elements.count > 0 and all element in elements where progress_pattern_is_irrefutable(element)
                    Ast::Pattern.As(_, inner): inner.count == 1 and progress_pattern_is_irrefutable(inner[0])
                    Ast::Pattern.Or(options): any option in options where progress_pattern_is_irrefutable(option)
                    _: false

        # Catch error arms have a distinguished `error name` catch-all binder; ordinary Match
        # type-bind patterns still require type knowledge and must not be treated as irrefutable.
        def progress_catch_pattern_is_irrefutable(pattern: Ast::Pattern) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match pattern:
                    Ast::Pattern.Wildcard: true
                    Ast::Pattern.TypeBind(type_name, _) if type_name == "error": true
                    Ast::Pattern.As(_, inner): inner.count == 1 and progress_catch_pattern_is_irrefutable(inner[0])
                    Ast::Pattern.Or(options): any option in options where progress_catch_pattern_is_irrefutable(option)
                    _: false

        # Parse only signed decimal pattern literals here. Unsupported spelling stays
        # unknown, which keeps the analysis conservative and avoids duplicating parser rules.
        def progress_decimal_pattern_value(text: sview) -> (known: bool, value: i64):
            can Abort.Panic:
                value: mutable i64 = 0
                has_digit: mutable bool = false
                negative: bool = text.len > 0 and text[0] == 45
                start: usize = 1 if negative else 0
                return (false, 0) if start == text.len
                for index in start..<text.len |index, value, has_digit, text, negative|:
                    byte: u8 = text[index].u8()
                    if byte == 95:
                        pass
                    elif byte >= 48 and byte <= 57:
                        digit: i64 = (byte - 48).i64()
                        if negative:
                            return (false, 0) if value < (0 - 922337203685477580) or (value == (0 - 922337203685477580) and digit > 8)
                            value <- value * 10 - digit
                        else:
                            return (false, 0) if value > 922337203685477580 or (value == 922337203685477580 and digit > 7)
                            value <- value * 10 + digit
                        has_digit <- true
                    else:
                        return (false, 0)
                (has_digit, value)

        def progress_literal_int(expression: Ast::Expr) -> (known: bool, value: i64):
            can Abort.Panic:
                return match expression:
                    Ast::Expr.IntLit(value, _): (true, value)
                    Ast::Expr.Paren(inner, _): progress_literal_int(inner)
                    Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(magnitude, _), _) if magnitude >= 0:
                        (true, 0 - magnitude)
                    _: (false, 0)

        def progress_int_pattern_matches(pattern: Ast::Pattern, value: i64) -> (known: bool, matches: bool):
            can Memory.Allocate, Abort.Panic:
                return match pattern:
                    Ast::Pattern.Wildcard | Ast::Pattern.Binding(_): (true, true)
                    Ast::Pattern.Literal(text):
                        literal: (known: bool, value: i64) = progress_decimal_pattern_value(text)
                        (literal.known, literal.value == value) if literal.known else (false, false)
                    Ast::Pattern.Or(options):
                        known: mutable bool = options.count > 0
                        matches: mutable bool = false
                        for option in options |known, matches|:
                            option_match: (known: bool, matches: bool) = progress_int_pattern_matches(option, value)
                            known <- known and option_match.known
                            matches <- matches or option_match.matches
                        (known, matches)
                    Ast::Pattern.As(_, inner):
                        if inner.count == 1:
                            progress_int_pattern_matches(inner[0], value)
                        else:
                            (false, false)
                    _: (false, false)

        # For supported literal scrutinees, skip value patterns excluded by the value and
        # arms made dead by earlier unguarded (or literal-true guarded) matching patterns.
        # Unknown literal domains remain conservative.
        def progress_match_arm_reachable(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], target_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                literal: (known: bool, value: bool) = progress_literal_bool(scrutinee)
                integer_literal: (known: bool, value: i64) = progress_literal_int(scrutinee)
                if not literal.known and integer_literal.known:
                    prior_int: mutable usize = 0
                    while prior_int < target_index |prior_int, arms, integer_literal|:
                        prior_arm: Ast::MatchArm = arms[prior_int]
                        prior_guard: (known: bool, value: bool) = progress_literal_bool(prior_arm.guard)
                        prior_unconditional: bool = prior_arm.guard is Ast::Expr.Absent or (prior_guard.known and prior_guard.value)
                        if prior_unconditional:
                            prior_match: (known: bool, matches: bool) = progress_int_pattern_matches(prior_arm.pattern, integer_literal.value)
                            return false if prior_match.known and prior_match.matches
                            return false if progress_pattern_is_irrefutable(prior_arm.pattern)
                        prior_int <- prior_int + 1
                    target_match: (known: bool, matches: bool) = progress_int_pattern_matches(arms[target_index].pattern, integer_literal.value)
                    return target_match.matches if target_match.known
                    return true
                prior: mutable usize = 0
                while prior < target_index |prior, literal, arms|:
                    arm: Ast::MatchArm = arms[prior]
                    guard_is_unconditional: mutable bool = arm.guard is Ast::Expr.Absent
                    guard_literal: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                    guard_is_unconditional <- guard_is_unconditional or (guard_literal.known and guard_literal.value)
                    if guard_is_unconditional:
                        if literal.known:
                            prior_match: (known: bool, matches: bool) = progress_bool_pattern_matches(arm.pattern, literal.value)
                            return false if prior_match.known and prior_match.matches
                        else:
                            return false if progress_pattern_is_irrefutable(arm.pattern)
                    prior <- prior + 1
                return true if not literal.known
                current_match: (known: bool, matches: bool) = progress_bool_pattern_matches(arms[target_index].pattern, literal.value)
                return current_match.matches if current_match.known
                return true

        # The exhaustiveness helper ignores guarded rows, but still recognizes an unguarded
        # fallback after them. That is exactly the totality needed for path joins here.
        def progress_is_catch_match(table: SymbolTable&, line: u32) -> bool:
            can Abort.Panic:
                return any catch_line in table.catch_match_lines where catch_line == line

        def progress_catch_path_is_space(byte: u8) -> bool:
            can Abort.Panic:
                return byte == 32 or byte == 9

        # Family path rows retain their source spans. Skip token trivia, including the
        # line and triple-quoted comments the lexer removes from the parser stream.
        def progress_catch_skip_path_trivia(path: sview, start: usize) -> usize:
            can Abort.Panic:
                cursor: mutable usize = start
                while cursor < path.len:
                    if path[cursor] == 32 or path[cursor] == 9 or path[cursor] == 10 or path[cursor] == 13:
                        cursor <- cursor + 1.usize()
                    elif path[cursor] == 35:
                        while cursor < path.len and path[cursor] != 10 and path[cursor] != 13 |cursor, path|:
                            cursor <- cursor + 1.usize()
                    elif path[cursor] == 34 and cursor + 2.usize() < path.len and path[cursor + 1.usize()] == 34 and path[cursor + 2.usize()] == 34:
                        comment_cursor: mutable usize = cursor + 3.usize()
                        comment_closed: mutable bool = false
                        while comment_cursor + 2.usize() < path.len |comment_cursor, comment_closed, path|:
                            if path[comment_cursor] == 34 and path[comment_cursor + 1.usize()] == 34 and path[comment_cursor + 2.usize()] == 34:
                                cursor <- comment_cursor + 3.usize()
                                comment_closed <- true
                                break
                            comment_cursor <- comment_cursor + 1.usize()
                        return path.len if not comment_closed
                    else:
                        break
                return cursor

        def progress_catch_path_trim(path: sview) -> sview:
            can Abort.Panic:
                start: mutable usize = 0.usize()
                end: mutable usize = path.len
                while start < end and progress_catch_path_is_space(path[start]) |start, end, path|:
                    start <- start + 1.usize()
                while end > start and progress_catch_path_is_space(path[end - 1.usize()]) |start, end, path|:
                    end <- end - 1.usize()
                return path[start:end]

        def progress_catch_raw_path_canonical_length(raw_path: sview) -> (valid: bool, length: usize):
            can Abort.Panic:
                raw_index: mutable usize = 0.usize()
                length: mutable usize = 0.usize()
                while raw_index < raw_path.len |raw_index, length, raw_path|:
                    raw_index <- progress_catch_skip_path_trivia(raw_path, raw_index)
                    break if raw_index >= raw_path.len
                    if raw_path[raw_index] == 58:
                        next_colon: usize = progress_catch_skip_path_trivia(raw_path, raw_index + 1.usize())
                        return (false, 0.usize()) if next_colon >= raw_path.len or raw_path[next_colon] != 58
                        length <- length + 2.usize()
                        raw_index <- next_colon + 1.usize()
                    else:
                        length <- length + 1.usize()
                        raw_index <- raw_index + 1.usize()
                return (true, length)

        def progress_catch_raw_path_matches_canonical(raw_path: sview, canonical_path: sview) -> bool:
            can Abort.Panic:
                info: (valid: bool, length: usize) = progress_catch_raw_path_canonical_length(raw_path)
                return false if not info.valid or info.length != canonical_path.len
                raw_index: mutable usize = 0.usize()
                canonical_index: mutable usize = 0.usize()
                while raw_index < raw_path.len or canonical_index < canonical_path.len |raw_index, canonical_index, raw_path, canonical_path|:
                    raw_index <- progress_catch_skip_path_trivia(raw_path, raw_index)
                    return canonical_index == canonical_path.len if raw_index >= raw_path.len
                    return false if canonical_index >= canonical_path.len
                    if raw_path[raw_index] == 58:
                        return false if canonical_index + 1.usize() >= canonical_path.len or canonical_path[canonical_index] != 58 or canonical_path[canonical_index + 1.usize()] != 58
                        raw_index <- progress_catch_skip_path_trivia(raw_path, raw_index + 1.usize())
                        return false if raw_index >= raw_path.len or raw_path[raw_index] != 58
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 2.usize()
                    else:
                        return false if raw_path[raw_index] != canonical_path[canonical_index]
                        raw_index <- raw_index + 1.usize()
                        canonical_index <- canonical_index + 1.usize()
                return true

        def progress_catch_path_scope_separator(path: sview, find_last: bool) -> (found: bool, start: usize, after: usize):
            can Abort.Panic:
                cursor: mutable usize = 0.usize()
                selected_start: mutable usize = path.len
                selected_after: mutable usize = path.len
                found: mutable bool = false
                while cursor < path.len |cursor, selected_start, selected_after, found, path, find_last|:
                    cursor <- progress_catch_skip_path_trivia(path, cursor)
                    break if cursor >= path.len
                    if path[cursor] == 58:
                        next_colon: usize = progress_catch_skip_path_trivia(path, cursor + 1.usize())
                        if next_colon < path.len and path[next_colon] == 58:
                            selected_start <- cursor
                            selected_after <- next_colon + 1.usize()
                            found <- true
                            return (true, selected_start, selected_after) if not find_last
                            cursor <- selected_after
                        else:
                            cursor <- cursor + 1.usize()
                    else:
                        cursor <- cursor + 1.usize()
                return (found, selected_start, selected_after)

        def progress_catch_module_path_matches_exact(path: sview, suffixes: darray[sview]&, module: sview) -> bool:
            can Abort.Panic:
                path_info: (valid: bool, length: usize) = progress_catch_raw_path_canonical_length(path)
                return false if not path_info.valid or module.len < path_info.length
                return false if not progress_catch_raw_path_matches_canonical(path, module[0:path_info.length])
                module_offset: mutable usize = path_info.length
                for suffix in suffixes |module_offset, suffixes, module|:
                    return false if module_offset + 1.usize() >= module.len or module[module_offset] != 58 or module[module_offset + 1.usize()] != 58
                    module_offset <- module_offset + 2.usize()
                    suffix_info: (valid: bool, length: usize) = progress_catch_raw_path_canonical_length(suffix)
                    return false if not suffix_info.valid or module_offset + suffix_info.length > module.len
                    return false if not progress_catch_raw_path_matches_canonical(suffix, module[module_offset:module_offset + suffix_info.length])
                    module_offset <- module_offset + suffix_info.length
                return module_offset == module.len

        # Resolve the explicit module prefix in a callee's declared error family. Catch arm
        # prefixes use different Stage0 semantics and are matched separately by short variant.
        # Aliases here are selected from the nearest lexical scope, and their targets resolve
        # relative to the scope where each alias was declared.
        def progress_catch_module_path_matches_scoped(path: sview, suffixes: darray[sview]&, module: sview, table: SymbolTable&, lexical_scope: sview, before_offset: u32, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                normalized_path: sview = progress_catch_path_trim(path)
                alias_separator: (found: bool, start: usize, after: usize) = progress_catch_path_scope_separator(normalized_path, false)
                alias_name_path: sview = normalized_path[0:alias_separator.start] if alias_separator.found else normalized_path
                alias_suffixes: mutable darray[sview] = []
                if alias_separator.found and alias_separator.after < normalized_path.len:
                    alias_suffixes.push(normalized_path[alias_separator.after:normalized_path.len])
                for suffix in suffixes |alias_suffixes, suffixes|:
                    alias_suffixes.push(suffix)
                alias_found: mutable bool = false
                alias_ambiguous: mutable bool = false
                alias_scope: mutable sview = ""
                alias_target: mutable sview = ""
                alias_selected_offset: mutable u32 = 0
                best_scope_length: mutable usize = 0
                for alias in table.using_alias_rows |alias_found, alias_ambiguous, alias_scope, alias_target, alias_selected_offset, best_scope_length, alias_name_path, alias_suffixes, module, depth, table|:
                    continue if alias.name != "__using_alias" or not progress_catch_raw_path_matches_canonical(alias_name_path, alias.owner)
                    continue if before_offset != 4294967295 and alias.offset >= before_offset
                    continue if not named_type_owner_is_lexical(alias.module, lexical_scope)
                    target_count: mutable usize = 0
                    target_owner: mutable sview = ""
                    for target in table.using_alias_rows |target_count, target_owner, alias|:
                        if target.name == "__using_alias_target" and target.module == alias.module and target.line == alias.line and target.offset == alias.offset:
                            target_owner <- target.owner
                            target_count <- target_count + 1.usize()
                    return false if target_count != 1.usize()
                    if not alias_found or best_scope_length < alias.module.len:
                        alias_found <- true
                        alias_ambiguous <- false
                        alias_scope <- alias.module
                        alias_target <- target_owner
                        alias_selected_offset <- alias.offset
                        best_scope_length <- alias.module.len
                    elif best_scope_length == alias.module.len:
                        if alias_scope != alias.module:
                            alias_ambiguous <- true
                        elif alias_target != target_owner:
                            selected_matches: bool = progress_catch_module_path_matches_scoped(alias_target, alias_suffixes, module, table, alias_scope, alias_selected_offset, depth + 1.u32())
                            candidate_matches: bool = progress_catch_module_path_matches_scoped(target_owner, alias_suffixes, module, table, alias.module, alias.offset, depth + 1.u32())
                            alias_ambiguous <- true if not selected_matches or not candidate_matches
                if not alias_found:
                    if lexical_scope == "":
                        return progress_catch_module_path_matches_exact(normalized_path, suffixes, module)
                    scoped_suffixes: mutable darray[sview] = [normalized_path]
                    for suffix in suffixes |scoped_suffixes|:
                        scoped_suffixes.push(suffix)
                    candidate_scope: mutable sview = lexical_scope
                    while candidate_scope != "" |candidate_scope, scoped_suffixes, module|:
                        return true if progress_catch_module_path_matches_exact(candidate_scope, scoped_suffixes, module)
                        parent_separator: mutable usize = candidate_scope.len
                        probe: mutable usize = 0.usize()
                        while probe + 1.usize() < candidate_scope.len |parent_separator, probe, candidate_scope|:
                            parent_separator <- probe if candidate_scope[probe] == 58 and candidate_scope[probe + 1.usize()] == 58
                            probe <- probe + 1.usize()
                        candidate_scope <- candidate_scope[0:parent_separator] if parent_separator < candidate_scope.len
                        candidate_scope <- "" if parent_separator == candidate_scope.len
                    return progress_catch_module_path_matches_exact(normalized_path, suffixes, module)
                return false if alias_ambiguous
                return progress_catch_module_path_matches_scoped(alias_target, alias_suffixes, module, table, alias_scope, alias_selected_offset, depth + 1.u32())

        def progress_catch_module_path_matches(path: sview, suffixes: darray[sview]&, module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return progress_catch_module_path_matches_scoped(path, suffixes, module, table, table.current_module, 4294967295, 0)

        def progress_catch_path_tag_bytes(path: sview) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                bytes: mutable darray[u8] = []
                offset: mutable usize = 0.usize()
                while offset < path.len |bytes, offset, path|:
                    byte: u8 = path[offset]
                    if progress_catch_path_is_space(byte):
                        offset <- offset + 1.usize()
                    elif byte == 58 and offset + 1.usize() < path.len and path[offset + 1.usize()] == 58:
                        bytes.push(46)
                        offset <- offset + 2.usize()
                    else:
                        bytes.push(byte)
                        offset <- offset + 1.usize()
                return bytes

        def progress_catch_declared_tag_bytes(module: sview, family: sview, variant: sview) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                bytes: mutable darray[u8] = []
                offset: mutable usize = 0.usize()
                while offset < module.len |bytes, offset, module|:
                    byte: u8 = module[offset]
                    if byte == 58 and offset + 1.usize() < module.len and module[offset + 1.usize()] == 58:
                        bytes.push(46)
                        offset <- offset + 2.usize()
                    else:
                        bytes.push(byte)
                        offset <- offset + 1.usize()
                if module != "":
                    bytes.push(46)
                for index in 0..<family.len |bytes, family|:
                    bytes.push(family[index])
                bytes.push(46)
                for index in 0..<variant.len |bytes, variant|:
                    bytes.push(variant[index])
                return bytes

        def progress_catch_tag_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            can Abort.Panic:
                return false if left.count != right.count
                for index in 0..<left.count |left, right|:
                    return false if left[index] != right[index]
                return true

        # Go's ErrorTagShortName drops exactly the first dotted path component. For
        # `Parent.Child.Fault.Bad`, the fallback key is `Child.Fault.Bad`, not just `Bad`.
        def progress_catch_tag_short_names_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            can Abort.Panic:
                left_start: mutable usize = 0.usize()
                right_start: mutable usize = 0.usize()
                for index in 0..<left.count |left_start, left|:
                    if left[index] == 46:
                        left_start <- index + 1.usize()
                        break
                for index in 0..<right.count |right_start, right|:
                    if right[index] == 46:
                        right_start <- index + 1.usize()
                        break
                left_short_length: usize = left.count - left_start
                return false if left_short_length != right.count - right_start
                for offset in 0..<left_short_length |left, right, left_start, right_start|:
                    return false if left[left_start + offset] != right[right_start + offset]
                return true

        def progress_catch_variant_path_matches(path: sview, module: sview, family: sview, variant: sview, allow_short_fallback: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                arm_tag: darray[u8] = progress_catch_path_tag_bytes(path)
                declared_tag: darray[u8] = progress_catch_declared_tag_bytes(module, family, variant)
                return true if progress_catch_tag_bytes_equal(arm_tag, declared_tag)
                return false if not allow_short_fallback
                return progress_catch_tag_short_names_equal(arm_tag, declared_tag)

        def progress_catch_pattern_covers_declared_variant(pattern: Ast::Pattern, module: sview, family: sview, variant: sview, allow_short_fallback: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match pattern:
                    Ast::Pattern.Binding(name): progress_catch_variant_path_matches(name, module, family, variant, allow_short_fallback)
                    Ast::Pattern.Variant(path, fields): fields.count == 0 and progress_catch_variant_path_matches(path, module, family, variant, allow_short_fallback)
                    Ast::Pattern.As(_, inner): inner.count == 1 and progress_catch_pattern_covers_declared_variant(inner[0], module, family, variant, allow_short_fallback)
                    Ast::Pattern.Or(options): options.count > 0 and any option in options where progress_catch_pattern_covers_declared_variant(option, module, family, variant, allow_short_fallback)
                    _: false

        def progress_catch_family_module_in_scope(family: sview, function_module: sview, table: SymbolTable&) -> (known: bool, module: sview @source):
            can Abort.Panic:
                module: mutable sview @source = table.current_module
                found: mutable bool = false
                scoped_module: mutable sview @source = table.current_module
                scoped_length: mutable usize = 0.usize()
                scoped_found: mutable bool = false
                has_module: mutable bool = false
                modules_ambiguous: mutable bool = false
                for index in 0..<table.enum_variant_owner.count |module, found, scoped_module, scoped_length, scoped_found, has_module, modules_ambiguous, table, family, function_module|:
                    continue if table.enum_variant_owner[index] != family
                    return (false, table.current_module) if index >= table.enum_variant_module.count
                    candidate_module: sview @source = table.enum_variant_module[index]
                    if not found:
                        module <- candidate_module
                        found <- true
                    elif candidate_module != module:
                        modules_ambiguous <- true
                    if named_type_owner_is_lexical(candidate_module, function_module):
                        if not scoped_found or candidate_module.len > scoped_length:
                            scoped_module <- candidate_module
                            scoped_length <- candidate_module.len
                            scoped_found <- true
                        elif candidate_module.len == scoped_length and candidate_module != scoped_module:
                            return (false, table.current_module)
                return (true, scoped_module) if scoped_found
                return (true, module) if found and not modules_ambiguous
                return (false, table.current_module)

        def progress_catch_function_module(declaration_line: u32, declaration_offset: u32, table: SymbolTable&) -> (known: bool, module: sview @source):
            can Abort.Panic:
                selected_module: mutable sview @source = table.current_module
                module_count: mutable usize = 0.usize()
                for annotation in table.protocol_annotations |selected_module, module_count, declaration_line, declaration_offset|:
                    if annotation.owner == "__fn_module" and annotation.line == declaration_line and annotation.offset == declaration_offset:
                        selected_module <- annotation.name
                        module_count <- module_count + 1.usize()
                return (module_count == 1.usize(), selected_module)

        def progress_catch_family_path_leaf_matches(path: sview, family: sview) -> bool:
            can Abort.Panic:
                normalized_path: sview = progress_catch_path_trim(path)
                separator: (found: bool, start: usize, after: usize) = progress_catch_path_scope_separator(normalized_path, true)
                family_path: sview = normalized_path[separator.after:normalized_path.len] if separator.found else normalized_path
                return progress_catch_raw_path_matches_canonical(family_path, family)

        def progress_catch_explicit_family_module(path: sview, family: sview, declaration_offset: u32, function_module: sview, table: SymbolTable&) -> (known: bool, module: sview @source):
            can Memory.Allocate, Abort.Panic:
                normalized_path: sview = progress_catch_path_trim(path)
                separator: (found: bool, start: usize, after: usize) = progress_catch_path_scope_separator(normalized_path, true)
                return (false, table.current_module) if not separator.found or not progress_catch_family_path_leaf_matches(normalized_path, family)
                module_prefix: sview = normalized_path[0:separator.start]
                suffixes: darray[sview] = []
                selected_module: mutable sview @source = table.current_module
                selected: mutable bool = false
                ambiguous: mutable bool = false
                for index in 0..<table.enum_variant_owner.count |selected_module, selected, ambiguous, module_prefix, suffixes, table, family, function_module|:
                    continue if table.enum_variant_owner[index] != family
                    return (false, table.current_module) if index >= table.enum_variant_module.count
                    candidate_module: sview @source = table.enum_variant_module[index]
                    continue if not progress_catch_module_path_matches_scoped(module_prefix, suffixes, candidate_module, table, function_module, declaration_offset, 0)
                    if not selected:
                        selected_module <- candidate_module
                        selected <- true
                    elif selected_module != candidate_module:
                        ambiguous <- true
                return (false, table.current_module) if ambiguous or not selected
                return (true, selected_module)

        def progress_catch_declared_family_module_for_row(family_row_index: usize, family: sview, declaration_line: u32, declaration_offset: u32, function_module: sview, table: SymbolTable&) -> (known: bool, module: sview @source):
            can Memory.Allocate, Abort.Panic:
                selected_path: mutable sview @source = table.current_module
                path_count: mutable usize = 0.usize()
                return (false, table.current_module) if family_row_index >= table.protocol_annotations.count
                family_row: Ast::EnumAnnotation = table.protocol_annotations[family_row_index]
                return (false, table.current_module) if family_row.owner != "__error_set_family" or family_row.name != family or family_row.line != declaration_line or family_row.offset != declaration_offset
                path_index: mutable usize = family_row_index + 1.usize()
                # A path row attached to this family occurrence but carrying another
                # identity cannot be ignored in favor of scope-based recovery.
                if path_index < table.protocol_annotations.count:
                    adjacent_path: Ast::EnumAnnotation = table.protocol_annotations[path_index]
                    if adjacent_path.owner == "__error_set_family_path" and adjacent_path.line == declaration_line and adjacent_path.offset == declaration_offset:
                        return (false, table.current_module) if adjacent_path.identity_id != family_row.identity_id
                while path_index < table.protocol_annotations.count |selected_path, path_count, path_index, declaration_line, declaration_offset, family, family_row, table|:
                    annotation: Ast::EnumAnnotation = table.protocol_annotations[path_index]
                    break if annotation.owner == "__error_set_family" and annotation.line == declaration_line and annotation.offset == declaration_offset
                    if annotation.owner == "__error_set_family_path" and annotation.line == declaration_line and annotation.offset == declaration_offset and annotation.identity_id == family_row.identity_id and progress_catch_family_path_leaf_matches(annotation.name, family):
                        selected_path <- annotation.name
                        path_count <- path_count + 1.usize()
                    path_index <- path_index + 1.usize()
                return (false, table.current_module) if path_count > 1.usize()
                if path_count == 1.usize():
                    separator: (found: bool, start: usize, after: usize) = progress_catch_path_scope_separator(selected_path, true)
                    return progress_catch_explicit_family_module(selected_path, family, declaration_offset, function_module, table) if separator.found
                return progress_catch_family_module_in_scope(family, function_module, table)

        # Subset rows immediately follow the family/path pair that introduced them.
        # Keying only by the short family leaf merges `First::Fault{Busy}` with an
        # unrestricted `Second::Fault` in the same declaration.
        def progress_catch_family_row_has_subset(family_row_index: usize, family: sview, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if family_row_index + 2.usize() >= table.protocol_annotations.count
                family_row: Ast::EnumAnnotation = table.protocol_annotations[family_row_index]
                path_row: Ast::EnumAnnotation = table.protocol_annotations[family_row_index + 1.usize()]
                subset_row: Ast::EnumAnnotation = table.protocol_annotations[family_row_index + 2.usize()]
                return false if family_row.owner != "__error_set_family" or family_row.name != family or family_row.line != declaration_line or family_row.offset != declaration_offset
                return false if declaration_identity_id != 0 and family_row.identity_id != declaration_identity_id
                return false if path_row.owner != "__error_set_family_path" or path_row.line != family_row.line or path_row.offset != family_row.offset or path_row.identity_id != family_row.identity_id
                return subset_row.owner == "__error_variant_family" and subset_row.name == family and subset_row.line == declaration_line and subset_row.offset == declaration_offset and subset_row.identity_id == family_row.identity_id

        # A malformed marker/allow pair must not be treated as a valid subset that
        # happens to exclude every variant. Check the full row sequence before using
        # `allows_variant`, whose false result means a valid exclusion.
        def progress_catch_family_row_subset_metadata_valid(family_row_index: usize, family: sview, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if family_row_index + 1.usize() >= table.protocol_annotations.count
                family_row: Ast::EnumAnnotation = table.protocol_annotations[family_row_index]
                path_row: Ast::EnumAnnotation = table.protocol_annotations[family_row_index + 1.usize()]
                return false if family_row.owner != "__error_set_family" or family_row.name != family or family_row.line != declaration_line or family_row.offset != declaration_offset
                return false if declaration_identity_id != 0 and family_row.identity_id != declaration_identity_id
                return false if path_row.owner != "__error_set_family_path" or path_row.line != family_row.line or path_row.offset != family_row.offset or path_row.identity_id != family_row.identity_id
                marker_index: mutable usize = family_row_index + 2.usize()
                return true if marker_index >= table.protocol_annotations.count
                first_marker: Ast::EnumAnnotation = table.protocol_annotations[marker_index]
                return true if first_marker.owner != "__error_variant_family"
                valid_pair_found: mutable bool = false
                while marker_index < table.protocol_annotations.count |marker_index, table, family, declaration_line, declaration_offset, family_row, valid_pair_found|:
                    marker_row: Ast::EnumAnnotation = table.protocol_annotations[marker_index]
                    break if marker_row.owner == "__error_set_family" and marker_row.line == declaration_line and marker_row.offset == declaration_offset
                    return false if marker_row.owner != "__error_variant_family" or marker_row.name != family or marker_row.line != declaration_line or marker_row.offset != declaration_offset or marker_row.identity_id != family_row.identity_id
                    return false if marker_index + 1.usize() >= table.protocol_annotations.count
                    allow_row: Ast::EnumAnnotation = table.protocol_annotations[marker_index + 1.usize()]
                    return false if allow_row.owner != "__error_variant_allow" or allow_row.line != declaration_line or allow_row.offset != declaration_offset or allow_row.identity_id != family_row.identity_id
                    valid_pair_found <- true
                    marker_index <- marker_index + 2.usize()
                return valid_pair_found

        def progress_catch_family_row_allows_variant(family_row_index: usize, family: sview, variant: sview, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if not progress_catch_family_row_has_subset(family_row_index, family, declaration_line, declaration_offset, declaration_identity_id, table)
                marker_index: mutable usize = family_row_index + 2.usize()
                while marker_index < table.protocol_annotations.count |marker_index, table, family, variant, declaration_line, declaration_offset, declaration_identity_id|:
                    marker_row: Ast::EnumAnnotation = table.protocol_annotations[marker_index]
                    break if marker_row.owner == "__error_set_family" and marker_row.line == declaration_line and marker_row.offset == declaration_offset
                    break if marker_row.owner != "__error_variant_family" or marker_row.name != family or marker_row.line != declaration_line or marker_row.offset != declaration_offset or marker_row.identity_id != declaration_identity_id
                    break if marker_index + 1.usize() >= table.protocol_annotations.count
                    allow_row: Ast::EnumAnnotation = table.protocol_annotations[marker_index + 1.usize()]
                    break if allow_row.owner != "__error_variant_allow" or allow_row.line != declaration_line or allow_row.offset != declaration_offset or allow_row.identity_id != declaration_identity_id
                    return true if allow_row.name == variant
                    marker_index <- marker_index + 2.usize()
                return false

        def progress_catch_declared_variant_short_name_is_ambiguous(module: sview, variant: sview, family: sview, family_row_index: usize, declaration_line: u32, declaration_offset: u32, function_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                candidate_tag: darray[u8] = progress_catch_declared_tag_bytes(module, family, variant)
                for other_family_row_index in 0..<table.protocol_annotations.count |candidate_tag, family, family_row_index, other_family_row_index, declaration_line, declaration_offset, function_module, table|:
                    continue if other_family_row_index == family_row_index
                    other_family_row: Ast::EnumAnnotation = table.protocol_annotations[other_family_row_index]
                    continue if other_family_row.owner != "__error_set_family" or other_family_row.line != declaration_line or other_family_row.offset != declaration_offset
                    other_family: sview = other_family_row.name
                    other_family_offset: u32 = other_family_row.offset
                    other_family_identity: u32 = other_family_row.identity_id
                    return true if not progress_catch_family_row_subset_metadata_valid(other_family_row_index, other_family, declaration_line, declaration_offset, other_family_identity, table)
                    other_module: (known: bool, module: sview @source) = progress_catch_declared_family_module_for_row(other_family_row_index, other_family, declaration_line, declaration_offset, function_module, table)
                    return true if not other_module.known
                    for index in 0..<table.enum_variant_owner.count |candidate_tag, other_family, other_module, other_family_row_index, other_family_offset, other_family_identity, declaration_line, table|:
                        continue if table.enum_variant_owner[index] != other_family
                        continue if index >= table.enum_variant_module.count or index >= table.enum_variant_name.count
                        continue if table.enum_variant_module[index] != other_module.module
                        continue if not progress_catch_family_row_allows_variant(other_family_row_index, other_family, table.enum_variant_name[index], declaration_line, other_family_offset, other_family_identity, table)
                        other_tag: darray[u8] = progress_catch_declared_tag_bytes(other_module.module, other_family, table.enum_variant_name[index])
                        return true if progress_catch_tag_short_names_equal(candidate_tag, other_tag)
                return false

        def progress_catch_declared_error_families_total(arms: darray[Ast::MatchArm], table: SymbolTable&, callee: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                declaration_line: mutable u32 = 0
                declaration_offset: mutable u32 = 0
                declaration_count: mutable usize = 0
                for annotation in table.protocol_annotations |declaration_line, declaration_offset, declaration_count, table, callee|:
                    if annotation.owner == callee and annotation.name == "__lsp_func_name":
                        declaration_line <- annotation.line
                        declaration_offset <- annotation.offset
                        declaration_count <- declaration_count + 1.usize()
                return false if declaration_count != 1.usize()
                error_return_count: mutable usize = 0
                for annotation in table.protocol_annotations |error_return_count, table, callee, declaration_line, declaration_offset|:
                    if annotation.owner == callee and annotation.name == "__error_return" and annotation.line == declaration_line and annotation.offset == declaration_offset:
                        error_return_count <- error_return_count + 1.usize()
                return false if error_return_count != 1.usize()
                function_module: (known: bool, module: sview @source) = progress_catch_function_module(declaration_line, declaration_offset, table)
                return false if not function_module.known
                family_count: mutable usize = 0
                for family_row_index in 0..<table.protocol_annotations.count |family_count, table, declaration_line, declaration_offset|:
                    family_row: Ast::EnumAnnotation = table.protocol_annotations[family_row_index]
                    continue if family_row.owner != "__error_set_family" or family_row.line != declaration_line or family_row.offset != declaration_offset
                    family: sview = family_row.name
                    return false if not progress_catch_family_row_subset_metadata_valid(family_row_index, family, declaration_line, declaration_offset, family_row.identity_id, table)
                    family_info: (known: bool, module: sview @source) = progress_catch_declared_family_module_for_row(family_row_index, family, declaration_line, declaration_offset, function_module.module, table)
                    return false if not family_info.known
                    family_module: mutable sview @source = family_info.module
                    variant_index: mutable usize = 0
                    while variant_index < table.enum_variant_owner.count |variant_index, arms, table, family, family_module, family_row_index, family_row, declaration_line, declaration_offset, function_module|:
                        if table.enum_variant_owner[variant_index] == family:
                            if variant_index < table.enum_variant_module.count:
                                if table.enum_variant_module[variant_index] == family_module:
                                    if progress_catch_family_row_allows_variant(family_row_index, family, table.enum_variant_name[variant_index], declaration_line, declaration_offset, family_row.identity_id, table):
                                        variant: sview = table.enum_variant_name[variant_index]
                                        allow_short_fallback: bool = not progress_catch_declared_variant_short_name_is_ambiguous(family_module, variant, family, family_row_index, declaration_line, declaration_offset, function_module.module, table)
                                        variant_covered: mutable bool = false
                                        arm_index: mutable usize = 1
                                        while arm_index < arms.count |arm_index, arms, table, family, variant, family_module, allow_short_fallback, variant_covered|:
                                            arm: Ast::MatchArm = arms[arm_index]
                                            guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                            unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                                            variant_covered <- true if unconditional and progress_catch_pattern_covers_declared_variant(arm.pattern, family_module, family, variant, allow_short_fallback)
                                            arm_index <- arm_index + 1.usize()
                                        return false if not variant_covered
                        variant_index <- variant_index + 1.usize()
                    family_count <- family_count + 1.usize()
                return family_count > 0.usize()

        def progress_catch_error_arms_total_at(arms: darray[Ast::MatchArm], table: SymbolTable&, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count < 2
                arm_index: mutable usize = 0
                while arm_index + 1.usize() < arms.count |arm_index, arms, table|:
                    arm: Ast::MatchArm = arms[arm_index + 1.usize()]
                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    if unconditional and progress_catch_pattern_is_irrefutable(arm.pattern):
                        return true
                    arm_index <- arm_index + 1
                return false if line == 0
                catch_callee: mutable sview = ""
                catch_rows: mutable usize = 0
                for annotation in table.protocol_annotations |catch_callee, catch_rows, table, line|:
                    if annotation.name == "__catch_expr" and annotation.line == line:
                        catch_callee <- annotation.owner
                        catch_rows <- catch_rows + 1.usize()
                return false if catch_rows != 1.usize() or catch_callee == ""
                return progress_catch_declared_error_families_total(arms, table, catch_callee)

        # Keep line-free callers conservative. Progress callsites pass the Catch line
        # so this helper can consult the guarded function's declared error families.
        def progress_catch_error_arms_total(arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return progress_catch_error_arms_total_at(arms, table, 0)

        # Only a previous wildcard or `error name` pattern can shadow later
        # Catch handlers; `first_prior_index` distinguishes the sliced error-arm
        # view used by the totality helper from the full Catch arm list.
        def progress_catch_arms_range_reachable(arms: darray[Ast::MatchArm], target_index: usize, first_prior_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                prior: mutable usize = first_prior_index
                while prior < target_index |prior, arms|:
                    arm: Ast::MatchArm = arms[prior]
                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    return false if unconditional and progress_catch_pattern_is_irrefutable(arm.pattern)
                    prior <- prior + 1
                return true

        # Catch arm zero handles successful values; error handlers are ordered from arm one.
        # A prior guarded catch-all only hides later handlers when its guard is literal true.
        def progress_catch_arm_reachable(arms: darray[Ast::MatchArm], target_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if target_index == 0
                progress_catch_arms_range_reachable(arms, target_index, 1.usize())

        # A literal bool scrutinee can be total even though the shared enum helper does not
        # prove bool-literal exhaustiveness. Guards count only when absent or literal-true.
        def progress_match_is_total(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                literal: (known: bool, value: bool) = progress_literal_bool(scrutinee)
                if literal.known:
                    arm_index: mutable usize = 0
                    while arm_index < arms.count |arm_index, arms, scrutinee, literal, table|:
                        arm: Ast::MatchArm = arms[arm_index]
                        guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                        pattern_match: (known: bool, matches: bool) = progress_bool_pattern_matches(arm.pattern, literal.value)
                        unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                        if progress_match_arm_reachable(scrutinee, arms, arm_index) and pattern_match.known and pattern_match.matches and unconditional:
                            return true
                        arm_index <- arm_index + 1
                    return false
                integer_literal: (known: bool, value: i64) = progress_literal_int(scrutinee)
                if integer_literal.known:
                    arm_index: mutable usize = 0
                    while arm_index < arms.count |arm_index, arms, scrutinee, integer_literal, table|:
                        arm: Ast::MatchArm = arms[arm_index]
                        guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                        pattern_match: (known: bool, matches: bool) = progress_int_pattern_matches(arm.pattern, integer_literal.value)
                        unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                        if progress_match_arm_reachable(scrutinee, arms, arm_index) and pattern_match.known and pattern_match.matches and unconditional:
                            return true
                        arm_index <- arm_index + 1
                    return false
                arm_index: mutable usize = 0
                while arm_index < arms.count |arm_index, arms, table|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    if unconditional and progress_match_arm_reachable(scrutinee, arms, arm_index) and progress_pattern_is_irrefutable(arm.pattern):
                        return true
                    arm_index <- arm_index + 1
                return match_arms_exhaustive(arms, table)

        # Track only paths that break the current loop, preserving hatch state through
        # conditional blocks. Nested loops own their breaks and are deliberately opaque.
        def progress_current_break_paths(statements: darray[Ast::Stmt], table: SymbolTable&, starts_uncovered: bool, starts_covered: bool) -> (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool):
            can Memory.Allocate, Abort.Panic:
                uncovered: mutable bool = starts_uncovered
                covered: mutable bool = starts_covered
                break_uncovered: mutable bool = false
                break_covered: mutable bool = false
                for statement in statements |uncovered, covered, break_uncovered, break_covered, table|:
                    match statement:
                        Stmt.Break(_, _):
                            break_uncovered <- break_uncovered or uncovered
                            break_covered <- break_covered or covered
                            uncovered <- false
                            covered <- false
                        Stmt.Return(_, _) | Stmt.Continue(_, _):
                            uncovered <- false
                            covered <- false
                        Stmt.Block(kind, clause, binding, body, block_line):
                            grants_progress: bool = (kind == "can" or kind == "trusted") and (any grant in clause where progress_grant_is_evidence(grant))
                            block_uncovered: bool = false if grants_progress else uncovered
                            block_covered: bool = true if grants_progress and (uncovered or covered) else covered
                            nested: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(body, table, block_uncovered, block_covered)
                            uncovered <- nested.uncovered
                            covered <- nested.covered
                            break_uncovered <- break_uncovered or nested.break_uncovered
                            break_covered <- break_covered or nested.break_covered
                        Stmt.If(condition, then_body, else_body, _):
                            if expression_evaluation_aborts(condition, table):
                                uncovered <- false
                                covered <- false
                            else:
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    selected: darray[Ast::Stmt] = then_body if literal.value else else_body
                                    nested: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(selected, table, uncovered, covered)
                                    uncovered <- nested.uncovered
                                    covered <- nested.covered
                                    break_uncovered <- break_uncovered or nested.break_uncovered
                                    break_covered <- break_covered or nested.break_covered
                                else:
                                    then_paths: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(then_body, table, uncovered, covered)
                                    else_paths: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(else_body, table, uncovered, covered)
                                    uncovered <- then_paths.uncovered or else_paths.uncovered
                                    covered <- then_paths.covered or else_paths.covered
                                    break_uncovered <- break_uncovered or then_paths.break_uncovered or else_paths.break_uncovered
                                    break_covered <- break_covered or then_paths.break_covered or else_paths.break_covered
                        Stmt.Match(scrutinee, arms, line):
                            is_catch: bool = progress_is_catch_match(table, line.line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_raises: bool = expression_may_raise_catchably(scrutinee, table)
                            if scrutinee_aborts and not (is_catch and scrutinee_raises):
                                uncovered <- false
                                covered <- false
                            else:
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                is_total: bool = progress_catch_error_arms_total_at(arms, table, line.line) if is_catch else progress_match_is_total(scrutinee, arms, table)
                                uncovered <- before_uncovered if not is_total
                                covered <- before_covered if not is_total
                                uncovered <- false if is_total
                                covered <- false if is_total
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, is_catch, scrutinee, before_uncovered, before_covered, uncovered, covered, break_uncovered, break_covered, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    reachable: bool = not (guard.known and not guard.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)) and not (is_catch and scrutinee_aborts and arm_index == 0)
                                    if reachable:
                                        arm_paths: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(arm.body, table, before_uncovered, before_covered)
                                        if not expression_evaluation_aborts(arm.guard, table):
                                            uncovered <- uncovered or arm_paths.uncovered
                                            covered <- covered or arm_paths.covered
                                            break_uncovered <- break_uncovered or arm_paths.break_uncovered
                                            break_covered <- break_covered or arm_paths.break_covered
                                    arm_index <- arm_index + 1
                        Stmt.While(_, _, _) | Stmt.For(_, _, _, _, _):
                            pass
                        _:
                            pass
                    if statement_terminates(statement, table):
                        uncovered <- false
                        covered <- false
                return (uncovered, covered, break_uncovered, break_covered)

        # A `break` that can leave the current loop. Do not count breaks owned by nested loops,
        # and stop looking through an earlier unconditional exit.
        def progress_body_has_current_break(statements: darray[Ast::Stmt], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Break(_, _):
                            return true
                        Stmt.If(condition, then_body, else_body, _):
                            if not expression_evaluation_aborts(condition, table):
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    selected: darray[Ast::Stmt] = then_body if literal.value else else_body
                                    return true if progress_body_has_current_break(selected, table)
                                else:
                                    return true if progress_body_has_current_break(then_body, table) or progress_body_has_current_break(else_body, table)
                        Stmt.Match(scrutinee, arms, _):
                            if not expression_evaluation_aborts(scrutinee, table):
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, scrutinee, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    if progress_match_arm_reachable(scrutinee, arms, arm_index) and not (guard.known and not guard.value) and not expression_evaluation_aborts(arm.guard, table):
                                        return true if progress_body_has_current_break(arm.body, table)
                                    arm_index <- arm_index + 1
                        Stmt.Block(_, _, _, body, _):
                            return true if progress_body_has_current_break(body, table)
                        Stmt.While(_, _, _) | Stmt.For(_, _, _, _, _):
                            pass
                        _:
                            pass
                    return false if statement_terminates(statement, table)
                return false

        # Resolve zero-argument direct callees only when their name is unambiguous in this local
        # declaration graph. A one-segment module scope equal to current_module is local; other
        # qualified leaf names can belong to another module. The path bits keep hatches branch-local.
        def progress_zero_arg_direct_callee_name(callee: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                return match callee:
                    Expr.Ident(name, _): name
                    Expr.Scope(Expr.Ident(module_name, _), name, _) if table.current_module == module_name: name
                    Expr.Paren(inner, _): progress_zero_arg_direct_callee_name(inner, table)
                    _: ""

        def progress_collect_zero_arg_calls_expr(expression: Ast::Expr, out: mutable darray[sview]&, protected_edges: mutable darray[bool]&, uncovered: mutable bool&, covered: mutable bool&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        progress_collect_zero_arg_calls_expr(callee, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(callee, table):
                            uncovered <- false
                            covered <- false
                        else:
                            if arguments.count == 0:
                                direct_name: sview = progress_zero_arg_direct_callee_name(callee, table)
                                if direct_name != "":
                                    out.push(direct_name)
                                    protected_edges.push(covered == true and uncovered == false)
                            for argument in arguments |out|:
                                progress_collect_zero_arg_calls_expr(argument, out, protected_edges, uncovered, covered, table)
                                break if expression_evaluation_aborts(argument, table)
                    Expr.Binary(left, operator, right, line):
                        progress_collect_zero_arg_calls_expr(left, out, protected_edges, uncovered, covered, table)
                        short_circuit: (known: bool, value: bool) = progress_literal_bool(left)
                        if not expression_evaluation_aborts(left, table) and not (operator == TokenKind.And and short_circuit.known and not short_circuit.value) and not (operator == TokenKind.Or and short_circuit.known and short_circuit.value):
                            progress_collect_zero_arg_calls_expr(right, out, protected_edges, uncovered, covered, table)
                    Expr.Unary(operator, operand, line):
                        progress_collect_zero_arg_calls_expr(operand, out, protected_edges, uncovered, covered, table)
                    Expr.Paren(inner, line):
                        progress_collect_zero_arg_calls_expr(inner, out, protected_edges, uncovered, covered, table)
                    Expr.Field(object, field, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                    Expr.Index(object, index, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(object, table):
                            uncovered <- false
                            covered <- false
                        else:
                            progress_collect_zero_arg_calls_expr(index, out, protected_edges, uncovered, covered, table)
                    Expr.IndexN(object, indices, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(object, table):
                            uncovered <- false
                            covered <- false
                        else:
                            for index in indices |out|:
                                progress_collect_zero_arg_calls_expr(index, out, protected_edges, uncovered, covered, table)
                                break if expression_evaluation_aborts(index, table)
                    Expr.Scope(base, name, line):
                        progress_collect_zero_arg_calls_expr(base, out, protected_edges, uncovered, covered, table)
                    Expr.Slice(object, low, high, line):
                        progress_collect_zero_arg_calls_expr(object, out, protected_edges, uncovered, covered, table)
                        if not expression_evaluation_aborts(object, table):
                            progress_collect_zero_arg_calls_expr(low, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(high, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(low, table)
                    Expr.If(condition, then_value, else_value, line):
                        progress_collect_zero_arg_calls_expr(condition, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(condition, table):
                            uncovered <- false
                            covered <- false
                        else:
                            before_uncovered: bool = uncovered == true
                            before_covered: bool = covered == true
                            literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if literal.known:
                                selected_uncovered: mutable bool = before_uncovered
                                selected_covered: mutable bool = before_covered
                                selected_value: Ast::Expr = then_value if literal.value else else_value
                                progress_collect_zero_arg_calls_expr(selected_value, out, protected_edges, selected_uncovered, selected_covered, table)
                                uncovered <- selected_uncovered
                                covered <- selected_covered
                            else:
                                then_uncovered: mutable bool = before_uncovered
                                then_covered: mutable bool = before_covered
                                else_uncovered: mutable bool = before_uncovered
                                else_covered: mutable bool = before_covered
                                progress_collect_zero_arg_calls_expr(then_value, out, protected_edges, then_uncovered, then_covered, table)
                                progress_collect_zero_arg_calls_expr(else_value, out, protected_edges, else_uncovered, else_covered, table)
                                uncovered <- then_uncovered or else_uncovered
                                covered <- then_covered or else_covered
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |out|:
                            progress_collect_zero_arg_calls_expr(element, out, protected_edges, uncovered, covered, table)
                            break if expression_evaluation_aborts(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |out|:
                            progress_collect_zero_arg_calls_expr(entry.key, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(entry.value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(entry.key, table)
                            break if expression_evaluation_aborts(entry.key, table) or expression_evaluation_aborts(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        progress_collect_zero_arg_calls_expr(type_expression, out, protected_edges, uncovered, covered, table)
                        for field in fields |out|:
                            progress_collect_zero_arg_calls_expr(field.value, out, protected_edges, uncovered, covered, table)
                            break if expression_evaluation_aborts(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        progress_collect_zero_arg_calls_expr(base, out, protected_edges, uncovered, covered, table)
                        for field in fields |out|:
                            progress_collect_zero_arg_calls_expr(field.value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(base, table)
                            break if expression_evaluation_aborts(base, table) or expression_evaluation_aborts(field.value, table)
                    Expr.Match(scrutinee, arms, line):
                        progress_collect_zero_arg_calls_expr(scrutinee, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(scrutinee, table):
                            uncovered <- false
                            covered <- false
                        else:
                            start_uncovered: bool = uncovered == true
                            start_covered: bool = covered == true
                            match_is_total: bool = progress_match_is_total(scrutinee, arms, table)
                            uncovered <- start_uncovered if not match_is_total
                            covered <- start_covered if not match_is_total
                            uncovered <- false if match_is_total
                            covered <- false if match_is_total
                            arm_index: mutable usize = 0
                            while arm_index < arms.count |arm_index, arms, out, protected_edges, uncovered, covered, start_uncovered, start_covered, table|:
                                arm: Ast::MatchArm = arms[arm_index]
                                guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                if progress_match_arm_reachable(scrutinee, arms, arm_index) and not (guard.known and not guard.value):
                                    arm_uncovered: mutable bool = start_uncovered
                                    arm_covered: mutable bool = start_covered
                                    progress_collect_zero_arg_calls_expr(arm.guard, out, protected_edges, arm_uncovered, arm_covered, table)
                                    if not expression_evaluation_aborts(arm.guard, table):
                                        progress_collect_zero_arg_calls_body(arm.body, out, protected_edges, arm_uncovered, arm_covered, table)
                                        uncovered <- (uncovered == true) or arm_uncovered
                                        covered <- (covered == true) or arm_covered
                                arm_index <- arm_index + 1
                    Expr.Catch(guarded, arms, line):
                        progress_collect_zero_arg_calls_expr(guarded, out, protected_edges, uncovered, covered, table)
                        start_uncovered: bool = uncovered == true
                        start_covered: bool = covered == true
                        guarded_aborts: bool = expression_evaluation_aborts(guarded, table)
                        guarded_may_raise: bool = expression_may_raise_catchably(guarded, table)
                        if guarded_aborts and not guarded_may_raise:
                            uncovered <- false
                            covered <- false
                        else:
                            error_arms_total: bool = progress_catch_error_arms_total_at(arms, table, line.line)
                            has_unmatched_path: bool = not error_arms_total or (not guarded_aborts and arms.count == 0)
                            uncovered <- start_uncovered if has_unmatched_path
                            covered <- start_covered if has_unmatched_path
                            uncovered <- false if not has_unmatched_path
                            covered <- false if not has_unmatched_path
                            arm_index: mutable usize = 0
                            while arm_index < arms.count |arm_index, arms, out, protected_edges, uncovered, covered, start_uncovered, start_covered, table|:
                                arm: Ast::MatchArm = arms[arm_index]
                                guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                arm_reachable: bool = not (guard.known and not guard.value) and progress_catch_arm_reachable(arms, arm_index) and not (guarded_aborts and arm_index == 0)
                                if arm_reachable:
                                    arm_uncovered: mutable bool = start_uncovered
                                    arm_covered: mutable bool = start_covered
                                    progress_collect_zero_arg_calls_expr(arm.guard, out, protected_edges, arm_uncovered, arm_covered, table)
                                    if not expression_evaluation_aborts(arm.guard, table):
                                        progress_collect_zero_arg_calls_body(arm.body, out, protected_edges, arm_uncovered, arm_covered, table)
                                        uncovered <- (uncovered == true) or arm_uncovered
                                        covered <- (covered == true) or arm_covered
                                arm_index <- arm_index + 1
                    Expr.GetElse(guarded, recovery, line):
                        progress_collect_zero_arg_calls_expr(guarded, out, protected_edges, uncovered, covered, table)
                        if expression_evaluation_aborts(guarded, table):
                            uncovered <- false
                            covered <- false
                        else:
                            success_uncovered: bool = uncovered == true
                            success_covered: bool = covered == true
                            recovery_uncovered: mutable bool = success_uncovered
                            recovery_covered: mutable bool = success_covered
                            progress_collect_zero_arg_calls_body(recovery, out, protected_edges, recovery_uncovered, recovery_covered, table)
                            uncovered <- success_uncovered or recovery_uncovered
                            covered <- success_covered or recovery_covered
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        progress_collect_zero_arg_calls_expr(iterable, out, protected_edges, uncovered, covered, table)
                        if not progress_empty_iterable(iterable) and not expression_evaluation_aborts(iterable, table):
                            loop_uncovered: mutable bool = uncovered == true
                            loop_covered: mutable bool = covered == true
                            progress_collect_zero_arg_calls_expr(condition, out, protected_edges, loop_uncovered, loop_covered, table)
                            condition_literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if not expression_evaluation_aborts(condition, table) and not (condition_literal.known and not condition_literal.value):
                                progress_collect_zero_arg_calls_expr(body, out, protected_edges, loop_uncovered, loop_covered, table)
                    Expr.Block(statements, value, captures, line):
                        progress_collect_zero_arg_calls_body(statements, out, protected_edges, uncovered, covered, table)
                        progress_collect_zero_arg_calls_expr(value, out, protected_edges, uncovered, covered, table) if uncovered == true or covered == true
                    Expr.Move(operand, line) | Expr.RegionNew(operand, _, line):
                        progress_collect_zero_arg_calls_expr(operand, out, protected_edges, uncovered, covered, table)
                    Expr.Refinement(base, predicate, line):
                        progress_collect_zero_arg_calls_expr(base, out, protected_edges, uncovered, covered, table)
                        progress_collect_zero_arg_calls_expr(predicate, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(base, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |out|:
                            progress_collect_zero_arg_calls_expr(child, out, protected_edges, uncovered, covered, table)
                            break if expression_evaluation_aborts(child, table)
                    _:
                        pass

        # Collect call edges while carrying covered and uncovered paths through statement flow.
        def progress_collect_zero_arg_calls_body(statements: darray[Ast::Stmt], out: mutable darray[sview]&, protected_edges: mutable darray[bool]&, uncovered: mutable bool&, covered: mutable bool&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out, protected_edges, uncovered, covered, table|:
                    return if uncovered == false and covered == false
                    match statement:
                        Stmt.Expr(expression, expr_line):
                            progress_collect_zero_arg_calls_expr(expression, out, protected_edges, uncovered, covered, table)
                            if expression_aborts(expression, table):
                                uncovered <- false
                                covered <- false
                        Stmt.Return(value, return_line):
                            if value is present_value:
                                progress_collect_zero_arg_calls_expr(present_value, out, protected_edges, uncovered, covered, table)
                            uncovered <- false
                            covered <- false
                            return
                        Stmt.VarDecl(name, type_expression, value, decl_line):
                            progress_collect_zero_arg_calls_expr(type_expression, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(type_expression, table)
                            if expression_evaluation_aborts(type_expression, table) or expression_evaluation_aborts(value, table):
                                uncovered <- false
                                covered <- false
                        Stmt.Assign(target, operator, value, assign_line):
                            progress_collect_zero_arg_calls_expr(target, out, protected_edges, uncovered, covered, table)
                            progress_collect_zero_arg_calls_expr(value, out, protected_edges, uncovered, covered, table) if not expression_evaluation_aborts(target, table)
                            if expression_evaluation_aborts(target, table) or expression_evaluation_aborts(value, table):
                                uncovered <- false
                                covered <- false
                        Stmt.If(condition, then_body, else_body, if_line):
                            progress_collect_zero_arg_calls_expr(condition, out, protected_edges, uncovered, covered, table)
                            if expression_evaluation_aborts(condition, table):
                                uncovered <- false
                                covered <- false
                            else:
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                literal: (known: bool, value: bool) = progress_literal_bool(condition)
                                if literal.known:
                                    selected_uncovered: mutable bool = before_uncovered
                                    selected_covered: mutable bool = before_covered
                                    selected_body: darray[Ast::Stmt] = then_body if literal.value else else_body
                                    progress_collect_zero_arg_calls_body(selected_body, out, protected_edges, selected_uncovered, selected_covered, table)
                                    uncovered <- selected_uncovered
                                    covered <- selected_covered
                                else:
                                    then_uncovered: mutable bool = before_uncovered
                                    then_covered: mutable bool = before_covered
                                    else_uncovered: mutable bool = before_uncovered
                                    else_covered: mutable bool = before_covered
                                    progress_collect_zero_arg_calls_body(then_body, out, protected_edges, then_uncovered, then_covered, table)
                                    progress_collect_zero_arg_calls_body(else_body, out, protected_edges, else_uncovered, else_covered, table)
                                    uncovered <- then_uncovered or else_uncovered
                                    covered <- then_covered or else_covered
                        Stmt.While(condition, while_body, while_line):
                            progress_collect_zero_arg_calls_expr(condition, out, protected_edges, uncovered, covered, table)
                            literal: (known: bool, value: bool) = progress_literal_bool(condition)
                            if expression_evaluation_aborts(condition, table):
                                uncovered <- false
                                covered <- false
                            elif not (literal.known and not literal.value):
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                body_uncovered: mutable bool = before_uncovered
                                body_covered: mutable bool = before_covered
                                progress_collect_zero_arg_calls_body(while_body, out, protected_edges, body_uncovered, body_covered, table)
                                breaks: (uncovered: bool, covered: bool, break_uncovered: bool, break_covered: bool) = progress_current_break_paths(while_body, table, before_uncovered, before_covered)
                                if literal.known and literal.value:
                                    uncovered <- breaks.break_uncovered
                                    covered <- breaks.break_covered
                                else:
                                    uncovered <- before_uncovered or breaks.break_uncovered
                                    covered <- before_covered or breaks.break_covered
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            progress_collect_zero_arg_calls_expr(iterable, out, protected_edges, uncovered, covered, table)
                            if expression_evaluation_aborts(iterable, table):
                                uncovered <- false
                                covered <- false
                            elif not progress_empty_iterable(iterable):
                                body_uncovered: mutable bool = uncovered
                                body_covered: mutable bool = covered
                                progress_collect_zero_arg_calls_body(for_body, out, protected_edges, body_uncovered, body_covered, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            is_catch: bool = progress_is_catch_match(table, match_line.line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_raises: bool = expression_may_raise_catchably(scrutinee, table)
                            progress_collect_zero_arg_calls_expr(scrutinee, out, protected_edges, uncovered, covered, table)
                            if scrutinee_aborts and not (is_catch and scrutinee_raises):
                                uncovered <- false
                                covered <- false
                            else:
                                before_uncovered: bool = uncovered
                                before_covered: bool = covered
                                is_total: bool = progress_catch_error_arms_total_at(arms, table, match_line.line) if is_catch else progress_match_is_total(scrutinee, arms, table)
                                uncovered <- before_uncovered if not is_total
                                covered <- before_covered if not is_total
                                uncovered <- false if is_total
                                covered <- false if is_total
                                arm_index: mutable usize = 0
                                while arm_index < arms.count |arm_index, arms, uncovered, covered, before_uncovered, before_covered, out, protected_edges, table|:
                                    arm: Ast::MatchArm = arms[arm_index]
                                    guard: (known: bool, value: bool) = progress_literal_bool(arm.guard)
                                    arm_reachable: bool = not (guard.known and not guard.value) and (progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)) and not (is_catch and scrutinee_aborts and arm_index == 0)
                                    if arm_reachable:
                                        arm_uncovered: mutable bool = before_uncovered
                                        arm_covered: mutable bool = before_covered
                                        progress_collect_zero_arg_calls_expr(arm.guard, out, protected_edges, arm_uncovered, arm_covered, table)
                                        if not expression_evaluation_aborts(arm.guard, table):
                                            progress_collect_zero_arg_calls_body(arm.body, out, protected_edges, arm_uncovered, arm_covered, table)
                                            uncovered <- uncovered or arm_uncovered
                                            covered <- covered or arm_covered
                                    arm_index <- arm_index + 1
                        Stmt.Contract(kind, expression, contract_line):
                            progress_collect_zero_arg_calls_expr(expression, out, protected_edges, uncovered, covered, table)
                            if expression_evaluation_aborts(expression, table):
                                uncovered <- false
                                covered <- false
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            before_uncovered: bool = uncovered
                            before_covered: bool = covered
                            grants_progress: bool = (kind == "can" or kind == "trusted") and (any grant in clause where progress_grant_is_evidence(grant))
                            block_uncovered: mutable bool = false if grants_progress else before_uncovered
                            block_covered: mutable bool = true if grants_progress and (before_uncovered or before_covered) else before_covered
                            progress_collect_zero_arg_calls_body(block_body, out, protected_edges, block_uncovered, block_covered, table)
                            block_terminates: bool = statements_terminate(block_body, table)
                            uncovered <- false if block_terminates else block_uncovered
                            covered <- false if block_terminates else block_covered
                        Stmt.Break(_, _) | Stmt.Continue(_, _):
                            uncovered <- false
                            covered <- false
                            return
                        _:
                            pass
                    if statement_terminates(statement, table):
                        uncovered <- false
                        covered <- false
                        return

        # Compatibility helper used by semantic atom probes that only inspect callee names.
        def progress_zero_arg_calls_body(statements: darray[Ast::Stmt], out: mutable darray[sview]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                protected_edges: mutable darray[bool] = []
                uncovered: mutable bool = true
                covered: mutable bool = false
                progress_collect_zero_arg_calls_body(statements, out, protected_edges, uncovered, covered, table)

        # Whether zero-arg-call node `origin` can reach itself following zero-arg-call edges
        # (a non-progressing recursive cycle). `visited` tracks nodes already expanded.
        def progress_reaches_self(origin: usize, current: usize, names: darray[sview]&, has_evidence: darray[bool]&, callee_start: darray[usize]&, callee_count: darray[usize]&, all_callees: darray[sview]&, visited: mutable darray[bool]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                edge: mutable usize = 0
                while edge < callee_count[current] |edge, origin, current, names, has_evidence, callee_start, callee_count, all_callees, visited|:
                    callee_name: sview = all_callees[callee_start[current] + edge]
                    target: mutable i64 = -1
                    probe: mutable usize = 0
                    while probe < names.count |target, probe, callee_name, names|:
                        target <- probe.i64() if names[probe] == callee_name and target < 0
                        probe <- probe + 1
                    if target >= 0:
                        # A closed cycle back to the origin: non-progressing (origin has no
                        # evidence, checked by the caller).
                        return true if target.usize() == origin
                        # A function-level `decreases` contract discharges cycles through it.
                        if not visited[target.usize()] and not has_evidence[target.usize()]:
                            visited[target.usize()] <- true
                            return true if progress_reaches_self(origin, target.usize(), names, has_evidence, callee_start, callee_count, all_callees, visited)
                    edge <- edge + 1
                return false

        # File-level pass: functions in a zero-arg recursive cycle with no progress evidence.
        def progress_recursive_cycles(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                lines: mutable darray[u32] = []
                has_evidence: mutable darray[bool] = []
                callee_start: mutable darray[usize] = []
                callee_count: mutable darray[usize] = []
                all_callees: mutable darray[sview] = []
                for declaration in declarations |names, lines, has_evidence, callee_start, callee_count, all_callees|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # The edge collector records calls with no arguments. Keep only
                            # declarations that can be selected by that arity; otherwise an
                            # earlier overload with parameters can steal the name-only edge
                            # from a later recursive zero-argument declaration.
                            if parameters.count == 0:
                                names.push(function_name)
                                lines.push(line.line)
                                # Hatches are edge-local: a budget only covers calls inside its
                                # lexical block. A function-level decreases contract covers its
                                # recursive edges as a whole.
                                has_evidence.push(progress_body_has_decreases(body))
                                callee_start.push(all_callees.count)
                                local_callees: mutable darray[sview] = []
                                local_protection: mutable darray[bool] = []
                                local_uncovered: mutable bool = true
                                local_covered: mutable bool = false
                                progress_collect_zero_arg_calls_body(body, local_callees, local_protection, local_uncovered, local_covered, table)
                                kept_edges: mutable usize = 0
                                edge: mutable usize = 0
                                while edge < local_callees.count |edge, kept_edges, local_callees, local_protection, all_callees|:
                                    if not local_protection[edge]:
                                        all_callees.push(local_callees[edge])
                                        kept_edges <- kept_edges + 1
                                    edge <- edge + 1
                                callee_count.push(kept_edges)
                        _:
                            pass
                index: mutable usize = 0
                while index < names.count |index, names, lines, has_evidence, callee_start, callee_count, all_callees, table|:
                    if not has_evidence[index]:
                        visited: mutable darray[bool] = [false for _ in names]
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProgressRecursiveCycle, name: names[index], line: lines[index], expected: "", actual: ""}) if progress_reaches_self(index, index, names, has_evidence, callee_start, callee_count, all_callees, visited)
                    index <- index + 1

        def check_progress_safety(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- progress_recursive_cycles(declarations, table)
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- progress_safety_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            previous_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- check_progress_safety(module_body, table)
                            table.current_module <- previous_module
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_progress_safety(scoped_body, table)
                        _:
                            pass
