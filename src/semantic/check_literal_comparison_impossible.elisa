# Check for comparisons with integer literals that are impossible for the compared type.
# E.g., x: u8 compared to 256 (outside 0..255), or y: i8 compared to -200 (outside -128..127).

include "./comparison_operator_policy.elisa"
include "./literal_comparison_range.elisa"

extend Semantic:
    private:
        const NEGATIVE_LITERAL_SIGN_FLAG: u32 = 1
        const NONNEGATIVE_LITERAL_SIGN_FLAG: u32 = 0

        # Whether comparing a value of `type_name` against the integer literal `literal_expr`
        # (handling Unary(Minus,...) and Paren(...)) is always vacuous — the literal lies
        # outside the type's representable range, so the comparison can never be satisfied.
        # Returns false for a non-literal operand. Computes the range test DIRECTLY on the
        # expression (no `mutable i64&` out-param — that form did not propagate the extracted
        # value back to the caller, so it read a stale 0 and tripped the test on EVERY
        # comparison; a bool return also sidesteps the optional-return codegen mismatch).
        def comparison_is_impossible(type_name: sview, literal_expr: Ast::Expr) -> bool:
            can Abort.Panic:
                match literal_expr:
                    Expr.IntLit(val, _):
                        return LiteralComparisonRange::is_outside(type_name, val)
                    Expr.Unary(TokenKind.Minus, Expr.IntLit(neg_val, _), _):
                        return LiteralComparisonRange::is_outside(type_name, -neg_val)
                    Expr.Paren(inner, _):
                        return comparison_is_impossible(type_name, inner)
                    _:
                        return false

        # The literal an impossible comparison was made against, as MAGNITUDE plus a sign
        # flag: stage0 names the value ("integer literal 300 does not fit in u8") and a
        # Diagnostic's numeric slots are u32, so the sign rides in `actual` as "-" or "".
        # Kept separate from comparison_is_impossible so that helper's bool return stays as it
        # is -- see the note there about the out-param form that silently read a stale 0.
        def comparison_literal_magnitude(literal_expr: Ast::Expr) -> (found: bool, magnitude: u32, sign: sview):
            can Abort.Panic:
                match literal_expr:
                    Expr.IntLit(val, _):
                        return (true, val.u32(), "") if val >= 0
                        return (true, (-val).u32(), "-")
                    Expr.Unary(TokenKind.Minus, Expr.IntLit(neg_val, _), _):
                        return (true, neg_val.u32(), "-") if neg_val >= 0
                        return (true, (-neg_val).u32(), "")
                    Expr.Paren(inner, _):
                        return comparison_literal_magnitude(inner)
                    _:
                        return (false, 0, "")

        # Reuse the established out-of-range diagnostic kind. Keeping comparison overflow in
        # that family preserves the public DiagnosticKind numbering and prevents one source
        # error from producing both the old "vacuous" warning and the definitive range error.
        def report_literal_comparison(type_name: sview, literal_expr: Ast::Expr, line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not LiteralComparisonRange::is_supported_integer_type(type_name) or not comparison_is_impossible(type_name, literal_expr)
                literal: (found: bool, magnitude: u32, sign: sview) = comparison_literal_magnitude(literal_expr)
                if literal.found:
                    negative: u32 = NEGATIVE_LITERAL_SIGN_FLAG if literal.sign == "-" else NONNEGATIVE_LITERAL_SIGN_FLAG
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralAssignOutOfRange, name: "", line: line.line, pos: Ast::expr_pos(literal_expr), expected: type_name, actual: "", expected_count: literal.magnitude, actual_count: negative})
                else:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralComparisonImpossible, name: "", line: line.line, pos: Ast::expr_pos(literal_expr), expected: type_name, actual: ""})


        # Walk through expressions, checking for impossible literal comparisons.
        def walk_expression_for_literal_comparison(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        # Check for comparison operators: ==, !=, <, >, <=, >=
                        is_comparison: bool = ComparisonOperatorPolicy::is_comparison(operator)
                        # Try: left is Ident, right is literal (possibly wrapped)
                        if is_comparison:
                            match left:
                                Expr.Ident(left_name, left_line):
                                    left_type: sview = local_type_of(var_types, type_names, left_name)
                                    table <- report_literal_comparison(left_type, right, line, table)
                                _:
                                    # Try: right is Ident, left is literal (possibly wrapped).
                                    match right:
                                        Expr.Ident(right_name, right_line):
                                            right_type: sview = local_type_of(var_types, type_names, right_name)
                                            table <- report_literal_comparison(right_type, left, line, table)
                                        _:
                                            pass
                        # Recursively walk both sides
                        table <- walk_expression_for_literal_comparison(left, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_literal_comparison(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_literal_comparison(argument, table, var_types, type_names)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- walk_expression_for_literal_comparison(child, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_literal_comparison(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_literal_comparison(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_literal_comparison(object, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_literal_comparison(operand, table, var_types, type_names)
                    Expr.Move(operand, line):
                        table <- walk_expression_for_literal_comparison(operand, table, var_types, type_names)
                    Expr.RegionNew(operand, region, line):
                        table <- walk_expression_for_literal_comparison(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_literal_comparison(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_literal_comparison(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_literal_comparison(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_literal_comparison(object, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(low, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_literal_comparison(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_literal_comparison(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_literal_comparison(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_literal_comparison(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_literal_comparison(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_literal_comparison(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_literal_comparison(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_literal_comparison(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_literal_comparison(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_literal_comparison(condition, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_literal_comparison(iterable, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(condition, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_literal_comparison(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_literal_comparison(statements, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_literal_comparison(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_expression_for_literal_comparison(arm.guard, table, var_types, type_names)
                            table <- walk_statements_for_literal_comparison(arm.body, table, var_types, type_names)
                    Expr.Catch(guarded, arms, line):
                        table <- walk_expression_for_literal_comparison(guarded, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_expression_for_literal_comparison(arm.guard, table, var_types, type_names)
                            table <- walk_statements_for_literal_comparison(arm.body, table, var_types, type_names)
                    Expr.Refinement(base, predicate, line):
                        table <- walk_expression_for_literal_comparison(base, table, var_types, type_names)
                        table <- walk_expression_for_literal_comparison(predicate, table, var_types, type_names)
                    Expr.GetElse(guarded, recovery, line):
                        table <- walk_expression_for_literal_comparison(guarded, table, var_types, type_names)
                        table <- walk_statements_for_literal_comparison(recovery, table, var_types, type_names)
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                    Expr.IntLit(_, _):
                        pass
                    Expr.FloatLit(_, _):
                        pass
                    Expr.StringLit(_, _):
                        pass
                    Expr.CharLit(_, _):
                        pass
                    Expr.BoolLit(_, _):
                        pass
                    Expr.Ident(_, _):
                        pass
                    Expr.ShorthandMember(_, _):
                        pass

        # Walk through statements, tracking variable types and checking for impossible comparisons.
        def walk_statements_for_literal_comparison(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_literal_comparison(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_literal_comparison(type_expression, table, var_types, type_names)
                            table <- walk_expression_for_literal_comparison(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_literal_comparison(target, table, var_types, type_names)
                            table <- walk_expression_for_literal_comparison(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_literal_comparison(condition, table, var_types, type_names)
                            table <- walk_statements_for_literal_comparison(then_body, table, var_types, type_names)
                            table <- walk_statements_for_literal_comparison(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_literal_comparison(condition, table, var_types, type_names)
                            table <- walk_statements_for_literal_comparison(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_literal_comparison(iterable, table, var_types, type_names)
                            table <- walk_statements_for_literal_comparison(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_literal_comparison(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_literal_comparison(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_literal_comparison(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_literal_comparison(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_literal_comparison(return_value, table, var_types, type_names)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_literal_comparison(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk every expression-bearing declaration, including signatures, defaults, fields, laws, and constants.
        def check_literal_comparison_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                                table <- walk_expression_for_literal_comparison(param.type_expression, table, var_types, type_names)
                                table <- walk_expression_for_literal_comparison(param.default_value, table, var_types, type_names)
                            table <- walk_expression_for_literal_comparison(return_type, table, var_types, type_names) if return_type is return_type
                            table <- walk_statements_for_literal_comparison(body, table, var_types, type_names)
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            type_names: mutable darray[sview] = []
                            var_types: mutable darray[sview] = []
                            for member in members |table|:
                                table <- walk_expression_for_literal_comparison(member.type_expression, table, var_types, type_names)
                                table <- walk_expression_for_literal_comparison(member.default_value, table, var_types, type_names)
                                for bit_member in member.bit_group_members |table|:
                                    table <- walk_expression_for_literal_comparison(bit_member.type_expression, table, var_types, type_names)
                            for invariant in invariants |table|:
                                table <- walk_expression_for_literal_comparison(invariant, table, var_types, type_names)
                        Decl.Enum(name, variants, is_const, storage_type, line):
                            type_names: mutable darray[sview] = []
                            var_types: mutable darray[sview] = []
                            table <- walk_expression_for_literal_comparison(storage_type, table, var_types, type_names)
                            for variant in variants |table|:
                                for field_type in variant.fields |table|:
                                    table <- walk_expression_for_literal_comparison(field_type, table, var_types, type_names)
                                table <- walk_expression_for_literal_comparison(variant.value_expr, table, var_types, type_names)
                        Decl.Alias(name, target, line):
                            type_names: mutable darray[sview] = []
                            var_types: mutable darray[sview] = []
                            table <- walk_expression_for_literal_comparison(target, table, var_types, type_names)
                        Decl.Law(name, predicate, line):
                            type_names: mutable darray[sview] = []
                            var_types: mutable darray[sview] = []
                            table <- walk_expression_for_literal_comparison(predicate, table, var_types, type_names)
                        Decl.Const(name, type_expression, value, is_mutable, line):
                            type_names: mutable darray[sview] = []
                            var_types: mutable darray[sview] = []
                            table <- walk_expression_for_literal_comparison(type_expression, table, var_types, type_names)
                            table <- walk_expression_for_literal_comparison(value, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_literal_comparison_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_literal_comparison_declarations(body, table)
                        Decl.Invalid:
                            pass
                        Decl.Import(module_name, line):
                            pass
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            pass

    public:
        # Public entry point for the check.
        def check_literal_comparison_impossible(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_literal_comparison_declarations(declarations, table)
