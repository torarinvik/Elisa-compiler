# A call that stores a VIEW of this function's own container storage into a holder the
# caller passed by reference (fuzz finding F2, stage0 checkCallArgumentHolderStoreEscape):
#
#     def set(h: mutable Hs&, s: sview) -> void:
#         h.s <- s
#     def fill(h: mutable Hs&) -> void:
#         b: mutable darray[u8] = [65.u8()]
#         set(h, b.as_sview())          # h.s now views b's bytes, freed when fill returns
#
# The direct store `h.s <- b.as_sview()` is the `in auto:` store escape; the callee's own
# checks accept the store (both are its parameters), so the CALLER checks it, using the
# store-through summary machinery (store_through_summary.elisa) with a different notion of a
# writable target: a `mutable S&` parameter whose struct S holds a view field (sview, cstr,
# view[T]), directly or through a nested struct field. Container holders (`mutable
# darray[sview]&`) are the region container rule's, not this one's.
#
# The stored argument must be a view of OWNED storage: `x.as_sview()` / `x.as_cstr()` /
# `x.view()` / `x[a:b]` whose root `x` is a local declared with a non-reference type outside
# any region block, or a local bound once to such a view. Aggregate locals conservatively
# inherit view taint from any initialized field. Since this pass has no field types, every
# later field projection is treated as possibly view-backed. Assigning a projection also taints
# its root and preserves earlier aggregate taint. The target argument must be a
# reference parameter of the calling function, a local alias of one, or a call result that
# may return one. Direct, scoped, generic, and deferred static-effect calls use summaries.
# Same-name overloads are unioned.
# Without typed field provenance, projections may be conservatively treated as caller
# references whenever this function has a reference parameter. This can reject a local
# projection such as `local_holder.slot`; the source gate records this precision boundary.
# Field calls are conservatively treated as unknown calls because this pass has no resolved
# callable identity for distinguishing UFCS methods from callable fields.
extend Semantic:
    private:
        const CHV_DIAGNOSTIC_ARGUMENT_NUMBER_BASE: usize = 1

        # Per-function, source-ordered view and reference provenance. The arrays are
        # parallel: every lexical binding has one row; owned says whether it names local
        # container storage, and may_owned_view also conservatively taints aggregates that
        # contain a view. The may facts join values assigned to that binding.
        # Branches clone this state and merge only rows that were visible on entry.
        struct CHVViewFlow:
            names: mutable darray[sview] = []
            owned: mutable darray[bool] = []
            may_owned_view: mutable darray[bool] = []
            may_alias_reference: mutable darray[bool] = []
            may_direct_alias_reference: mutable darray[bool] = []
            may_contain_alias_reference: mutable darray[bool] = []
            may_yield_alias_reference: mutable darray[bool] = []
            may_yield_alias_reference_known: mutable darray[bool] = []
            binding_types: mutable darray[Ast::Expr?] = []
            binding_type_known: mutable darray[bool] = []
            may_be_scalar_sview: mutable darray[bool] = []
            may_yield_scalar_sview: mutable darray[bool] = []
            may_be_byte_sequence: mutable darray[bool] = []
            shape_unknown: mutable darray[bool] = []
            shape_shadow_names: mutable darray[sview] = []
            rebind_claims: mutable darray[Ast::EnumAnnotation] = []
            reference_holders: mutable darray[sview] = []
            type_alias_names: mutable darray[sview] = []
            type_alias_targets: mutable darray[Ast::Expr] = []
            last_value_may_be_owned_view: mutable bool = false

        def chv_flow_latest(flow: CHVViewFlow&, name: sview) -> usize:
            can Abort.Panic:
                index: mutable usize = flow.names.count
                while index > 0 |index, flow|:
                    index <- index - 1
                    return index if flow.names[index] == name
                return flow.names.count

        def chv_flow_clone(flow: CHVViewFlow&) -> CHVViewFlow:
            can Memory.Allocate, Abort.Panic:
                clone: mutable CHVViewFlow = CHVViewFlow{}
                clone.names.extend(flow.names)
                clone.owned.extend(flow.owned)
                clone.may_owned_view.extend(flow.may_owned_view)
                clone.may_alias_reference.extend(flow.may_alias_reference)
                clone.may_direct_alias_reference.extend(flow.may_direct_alias_reference)
                clone.may_contain_alias_reference.extend(flow.may_contain_alias_reference)
                clone.may_yield_alias_reference.extend(flow.may_yield_alias_reference)
                clone.may_yield_alias_reference_known.extend(flow.may_yield_alias_reference_known)
                clone.binding_types.extend(flow.binding_types)
                clone.binding_type_known.extend(flow.binding_type_known)
                clone.may_be_scalar_sview.extend(flow.may_be_scalar_sview)
                clone.may_yield_scalar_sview.extend(flow.may_yield_scalar_sview)
                clone.may_be_byte_sequence.extend(flow.may_be_byte_sequence)
                clone.shape_unknown.extend(flow.shape_unknown)
                clone.shape_shadow_names.extend(flow.shape_shadow_names)
                clone.rebind_claims.extend(flow.rebind_claims)
                clone.reference_holders.extend(flow.reference_holders)
                clone.type_alias_names.extend(flow.type_alias_names)
                clone.type_alias_targets.extend(flow.type_alias_targets)
                clone.last_value_may_be_owned_view <- flow.last_value_may_be_owned_view
                return clone

        def chv_flow_has_lmut_rebind_claim(flow: CHVViewFlow&, name: sview, line: u32) -> bool:
            return any annotation in flow.rebind_claims where annotation.owner == "__lmut_rebind_claim" and annotation.name == name and annotation.line == line

        def chv_flow_bind(flow: mutable CHVViewFlow&, name: sview, owned: bool, may_owned_view: bool, may_alias_reference: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                flow.names.push(name)
                flow.owned.push(owned)
                flow.may_owned_view.push(may_owned_view)
                flow.may_alias_reference.push(may_alias_reference)
                flow.may_direct_alias_reference.push(may_alias_reference)
                flow.may_contain_alias_reference.push(false)
                flow.may_yield_alias_reference.push(false)
                flow.may_yield_alias_reference_known.push(false)
                flow.binding_types.push(null)
                flow.binding_type_known.push(false)
                flow.may_be_scalar_sview.push(false)
                flow.may_yield_scalar_sview.push(false)
                flow.may_be_byte_sequence.push(false)
                flow.shape_unknown.push(any shadow_name in flow.shape_shadow_names where shadow_name == name)

        # The local pre-scan is name based, so a binder with the same name must not
        # resolve its iterable shape through a future local initializer. Record these
        # names in the flow so every later binder kind receives the same protection.
        def chv_flow_add_shape_shadows(flow: mutable CHVViewFlow&, view_names: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for view_name in view_names |flow|:
                    if not (any shadow_name in flow.shape_shadow_names where shadow_name == view_name):
                        flow.shape_shadow_names.push(view_name)
                    for index in 0..<flow.names.count |index, flow|:
                        if flow.names[index] == view_name and index < flow.shape_unknown.count:
                            flow.shape_unknown[index] <- true

        def chv_flow_truncate(flow: mutable CHVViewFlow&, mark: usize) -> void:
            can Abort.Panic:
                flow.names.truncate(mark)
                flow.owned.truncate(mark)
                flow.may_owned_view.truncate(mark)
                flow.may_alias_reference.truncate(mark)
                flow.may_direct_alias_reference.truncate(mark)
                flow.may_contain_alias_reference.truncate(mark)
                flow.may_yield_alias_reference.truncate(mark)
                flow.may_yield_alias_reference_known.truncate(mark)
                flow.binding_types.truncate(mark)
                flow.binding_type_known.truncate(mark)
                flow.may_be_scalar_sview.truncate(mark)
                flow.may_yield_scalar_sview.truncate(mark)
                flow.may_be_byte_sequence.truncate(mark)
                flow.shape_unknown.truncate(mark)

        def chv_flow_merge(target: mutable CHVViewFlow&, source: CHVViewFlow&, visible_count: usize) -> void:
            can Abort.Panic:
                index: mutable usize = 0
                while index < visible_count and index < target.names.count and index < source.names.count |index, target, source|:
                    target.may_owned_view[index] <- target.may_owned_view[index] or source.may_owned_view[index]
                    target.may_alias_reference[index] <- target.may_alias_reference[index] or source.may_alias_reference[index]
                    target.may_direct_alias_reference[index] <- target.may_direct_alias_reference[index] or source.may_direct_alias_reference[index]
                    target.may_contain_alias_reference[index] <- target.may_contain_alias_reference[index] or source.may_contain_alias_reference[index]
                    target.may_yield_alias_reference[index] <- target.may_yield_alias_reference[index] or source.may_yield_alias_reference[index]
                    target.may_yield_alias_reference_known[index] <- target.may_yield_alias_reference_known[index] and source.may_yield_alias_reference_known[index]
                    target.may_be_scalar_sview[index] <- target.may_be_scalar_sview[index] and source.may_be_scalar_sview[index]
                    target.may_yield_scalar_sview[index] <- target.may_yield_scalar_sview[index] and source.may_yield_scalar_sview[index]
                    target.may_be_byte_sequence[index] <- target.may_be_byte_sequence[index] or source.may_be_byte_sequence[index]
                    target.shape_unknown[index] <- target.shape_unknown[index] or source.shape_unknown[index]
                    index <- index + 1

        def chv_flow_set_merge(target: mutable CHVViewFlow&, left: CHVViewFlow&, right: CHVViewFlow&, visible_count: usize) -> void:
            can Abort.Panic:
                index: mutable usize = 0
                while index < visible_count and index < target.names.count and index < left.names.count and index < right.names.count |index, target, left, right|:
                    target.may_owned_view[index] <- left.may_owned_view[index] or right.may_owned_view[index]
                    target.may_alias_reference[index] <- left.may_alias_reference[index] or right.may_alias_reference[index]
                    target.may_direct_alias_reference[index] <- left.may_direct_alias_reference[index] or right.may_direct_alias_reference[index]
                    target.may_contain_alias_reference[index] <- left.may_contain_alias_reference[index] or right.may_contain_alias_reference[index]
                    target.may_yield_alias_reference[index] <- left.may_yield_alias_reference[index] or right.may_yield_alias_reference[index]
                    target.may_yield_alias_reference_known[index] <- left.may_yield_alias_reference_known[index] and right.may_yield_alias_reference_known[index]
                    target.may_be_scalar_sview[index] <- left.may_be_scalar_sview[index] and right.may_be_scalar_sview[index]
                    target.may_yield_scalar_sview[index] <- left.may_yield_scalar_sview[index] and right.may_yield_scalar_sview[index]
                    target.may_be_byte_sequence[index] <- left.may_be_byte_sequence[index] or right.may_be_byte_sequence[index]
                    target.shape_unknown[index] <- left.shape_unknown[index] or right.shape_unknown[index]
                    index <- index + 1

        # Whether TYPE_EXPRESSION names a struct in HOLDERS: `S`, `mutable S`, `S&`, `Mod::S`.
        def chv_type_names_holder(type_expression: Ast::Expr, holders: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, _):
                        return any holder in holders where holder == type_name
                    Expr.Scope(_, scoped_name, _):
                        return any holder in holders where holder == scoped_name
                    Expr.Unary(_, operand, _):
                        return chv_type_names_holder(operand, holders)
                    Expr.Paren(inner, _):
                        return chv_type_names_holder(inner, holders)
                    _:
                        return false

        def chv_collect_structs(declarations: darray[Ast::Decl], names: mutable darray[sview]&, members: mutable darray[darray[Ast::StructMember]]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, members|:
                    match declaration:
                        Decl.Struct(name: struct_name, members: struct_members, _):
                            names.push(struct_name)
                            members.push(struct_members)
                        Decl.Module(_, module_body, _):
                            chv_collect_structs(module_body, names, members)
                        Decl.Scoped(scoped_body, _):
                            chv_collect_structs(scoped_body, names, members)
                        _:
                            pass

        def chv_collect_reference_holders(declarations: darray[Ast::Decl], reference_holders: mutable darray[sview]&, more: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |reference_holders, more|:
                    match declaration:
                        Decl.Struct(name: struct_name, members: struct_members, _):
                            if not (any holder in reference_holders where holder == struct_name):
                                holds_reference: bool = any member in struct_members where chv_type_contains_reference(member.type_expression, 0) or chv_type_may_contain_alias_reference_with_holders(member.type_expression, reference_holders, 0)
                                if holds_reference:
                                    reference_holders.push(struct_name)
                                    more <- true
                        Decl.Alias(alias_name, target, _):
                            if not (any holder in reference_holders where holder == alias_name):
                                holds_reference: bool = chv_type_contains_reference(target, 0) or chv_type_may_contain_alias_reference_with_holders(target, reference_holders, 0)
                                if holds_reference:
                                    reference_holders.push(alias_name)
                                    more <- true
                        Decl.Module(_, module_body, _):
                            chv_collect_reference_holders(module_body, reference_holders, more)
                        Decl.Scoped(scoped_body, _):
                            chv_collect_reference_holders(scoped_body, reference_holders, more)
                        _:
                            pass

        # Named structs and aliases whose fields or targets can contain caller
        # references, directly or through another by-value aggregate.
        def chv_reference_holders(declarations: darray[Ast::Decl]) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                reference_holders: mutable darray[sview] = []
                more: mutable bool = true
                while more |more|:
                    more <- false
                    chv_collect_reference_holders(declarations, reference_holders, more)
                return reference_holders

        def chv_collect_type_aliases(declarations: darray[Ast::Decl], names: mutable darray[sview]&, targets: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, targets|:
                    match declaration:
                        Decl.Alias(name, target, _):
                            names.push(name)
                            targets.push(target)
                        Decl.Module(_, body, _) | Decl.Scoped(body, _):
                            chv_collect_type_aliases(body, names, targets)
                        _:
                            pass

        # Structs holding a view field, directly or through a field of another such struct.
        def chv_view_holders(declarations: darray[Ast::Decl]) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                members: mutable darray[darray[Ast::StructMember]] = []
                chv_collect_structs(declarations, names, members)
                holders: mutable darray[sview] = []
                more: mutable bool = true
                while more |more, holders|:
                    more <- false
                    for index in 0..<names.count |more, holders|:
                        if not (any holder in holders where holder == names[index]):
                            holds: bool = any member in members[index] where exclusivity_type_is_view(member.type_expression) or chv_type_names_holder(member.type_expression, holders)
                            if holds:
                                holders.push(names[index])
                                more <- true
                return holders

        # The store-through summary restricted to view-holder targets.
        def chv_build_summary(declarations: darray[Ast::Decl], holders: darray[sview]&, reference_sites: mutable BorrowReferenceSites&, table: mutable SymbolTable&) -> StoreThroughSummary:
            can Memory.Allocate, Abort.Panic:
                summary: mutable StoreThroughSummary = sts_empty()
                functions: mutable darray[Ast::Decl] = []
                sts_collect_functions(declarations, functions)
                summarised: mutable darray[Ast::Decl] = []
                summarised_unreadable: mutable darray[bool] = []
                function_owners: mutable darray[DeclId] = []
                for function in functions |summary, summarised, summarised_unreadable, function_owners, table|:
                    match function:
                        Decl.Func(name: function_name, params: function_parameters, body: function_body, pos: function_pos, _):
                            if function_name != "" and function_name != "_":
                                if not sts_is_declared(summary, function_name):
                                    sts_declare(summary, function_name) can Global{Read,Write}
                                position: mutable usize = 0
                                writable_found: mutable bool = false
                                for parameter in function_parameters |position, writable_found, summary|:
                                    if param_is_mutable_ref(parameter) and chv_type_names_holder(parameter.type_expression, holders):
                                        sts_add_writable(summary, function_name, position) can Global{Read,Write}
                                        writable_found <- true
                                    position <- position + 1
                                if writable_found and function_parameters.count > 1:
                                    function_owner: DeclId = function_declaration_id(table, function_name, function_pos.offset)
                                    has_unreadable_binder: bool = borrow_function_has_unreadable_binder(function_parameters, function_body) or function_owner.value.usize() >= table.symbols.count
                                    summarised.push(function)
                                    summarised_unreadable.push(has_unreadable_binder)
                                    function_owners.push(function_owner)
                        _:
                            pass
                more_rows: mutable bool = summarised.count > 0
                while more_rows |more_rows, summary, reference_sites, table|:
                    more_rows <- false
                    for function_index in 0..<summarised.count |function_index, more_rows, summary, summarised, summarised_unreadable, function_owners, reference_sites, table|:
                        match summarised[function_index]:
                            Decl.Func(name: function_name, params: function_parameters, body: function_body, _):
                                more_rows <- true if (sts_summarise_function(function_name, function_parameters, function_body, summarised_unreadable[function_index], function_owners[function_index], reference_sites, table, summary) can Global{Read,Write})
                            _:
                                pass
                return summary

        # Every binder of a function body (VarDecl names and `r = ...` definitions), with
        # repeats, plus the locals declared with a non-reference type outside region blocks.
        def chv_scan_locals(statements: darray[Ast::Stmt], in_region: bool, binders: mutable darray[sview]&, owned: mutable darray[sview]&, view_names: mutable darray[sview]&, view_values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |binders, owned, view_names, view_values|:
                    match statement:
                        Stmt.VarDecl(declared_name, type_expression, declared_value, _):
                            binders.push(declared_name)
                            typed_owned: bool = chv_type_is_owned_container(type_expression) and not type_marker_present_here(type_expression, TokenKind.Ampersand)
                            literal_owned: bool = (type_expression is Expr.Absent) and (declared_value is Expr.Array(_, _))
                            owned.push(declared_name) if not in_region and (typed_owned or literal_owned)
                            view_names.push(declared_name)
                            view_values.push(declared_value)
                            expression_binders: mutable darray[sview @source] = []
                            gather_expression_bindings(declared_value, expression_binders)
                            binders.extend(expression_binders)
                            chv_scan_expression_locals(declared_value, in_region, binders, owned, view_names, view_values)
                        Stmt.Assign(target, _, assigned_value, _):
                            if target is Expr.Ident(assigned_name, _):
                                binders.push(assigned_name)
                            if target is Expr.Array(target_elements, _):
                                for target_element in target_elements |binders|:
                                    if target_element is Expr.Ident(assigned_name, _):
                                        binders.push(assigned_name)
                            chv_scan_expression_locals(target, in_region, binders, owned, view_names, view_values)
                            chv_scan_expression_locals(assigned_value, in_region, binders, owned, view_names, view_values)
                            expression_binders: mutable darray[sview @source] = []
                            gather_expression_bindings(assigned_value, expression_binders)
                            binders.extend(expression_binders)
                        Stmt.If(condition, then_body, else_body, _):
                            chv_scan_expression_locals(condition, in_region, binders, owned, view_names, view_values)
                            chv_scan_locals(then_body, in_region, binders, owned, view_names, view_values)
                            chv_scan_locals(else_body, in_region, binders, owned, view_names, view_values)
                        Stmt.While(condition, loop_body, _):
                            chv_scan_expression_locals(condition, in_region, binders, owned, view_names, view_values)
                            chv_scan_locals(loop_body, in_region, binders, owned, view_names, view_values)
                        Stmt.For(_, loop_variables, iterable, loop_body, _):
                            for loop_variable in loop_variables |binders|:
                                binders.push(loop_variable)
                            chv_scan_expression_locals(iterable, in_region, binders, owned, view_names, view_values)
                            chv_scan_locals(loop_body, in_region, binders, owned, view_names, view_values)
                        Stmt.Block(kind, _, binding, block_body, _):
                            binders.push(binding) if binding != ""
                            chv_scan_locals(block_body, in_region or kind == "region" or kind == "in", binders, owned, view_names, view_values)
                        Stmt.Match(scrutinee, arms, _):
                            chv_scan_expression_locals(scrutinee, in_region, binders, owned, view_names, view_values)
                            for arm in arms |binders, owned, view_names, view_values|:
                                pattern_names: mutable darray[sview] = []
                                collect_pattern_binding_names(arm.pattern, pattern_names)
                                for pattern_name in pattern_names |binders|:
                                    binders.push(pattern_name)
                                chv_scan_expression_locals(arm.guard, in_region, binders, owned, view_names, view_values)
                                chv_scan_locals(arm.body, in_region, binders, owned, view_names, view_values)
                        Stmt.Expr(expression, _):
                            chv_scan_expression_locals(expression, in_region, binders, owned, view_names, view_values)
                            expression_binders: mutable darray[sview @source] = []
                            gather_expression_bindings(expression, expression_binders)
                            binders.extend(expression_binders)
                        Stmt.Return(value, _):
                            chv_scan_expression_locals(returned_value, in_region, binders, owned, view_names, view_values) if value is returned_value
                        Stmt.Contract(_, expression, _):
                            chv_scan_expression_locals(expression, in_region, binders, owned, view_names, view_values)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(_, _):
                            pass
                        Stmt.Continue(_, _):
                            pass

        # Find block-local declarations inside expression children before the diagnostic
        # walk runs, so nested value blocks contribute their owned containers and views.
        def chv_scan_expression_locals(expression: Ast::Expr, in_region: bool, binders: mutable darray[sview]&, owned: mutable darray[sview]&, view_names: mutable darray[sview]&, view_values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                    Expr.IntLit(_, _):
                        pass
                    Expr.FloatLit(_, _):
                        pass
                    Expr.StringLit(_, _):
                        pass
                    Expr.CharLit(_, _):
                        pass
                    Expr.BoolLit(_, _):
                        pass
                    Expr.Ident(_, _):
                        pass
                    Expr.Call(callee, arguments, _, _):
                        chv_scan_expression_locals(callee, in_region, binders, owned, view_names, view_values)
                        for argument in arguments |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(argument, in_region, binders, owned, view_names, view_values)
                    Expr.StaticEffectCall(candidates: candidates, arguments: arguments, _):
                        for child in Ast::effect_runtime_children(candidates, arguments) |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(child, in_region, binders, owned, view_names, view_values)
                    Expr.Field(object, _, _):
                        chv_scan_expression_locals(object, in_region, binders, owned, view_names, view_values)
                    Expr.Scope(base, _, _):
                        chv_scan_expression_locals(base, in_region, binders, owned, view_names, view_values)
                    Expr.ShorthandMember(_, _):
                        pass
                    Expr.Index(object, index, _):
                        chv_scan_expression_locals(object, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(index, in_region, binders, owned, view_names, view_values) if not index_receiver_is_type_application(object)
                    Expr.Slice(object, low, high, _):
                        chv_scan_expression_locals(object, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(low, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(high, in_region, binders, owned, view_names, view_values)
                    Expr.IndexN(object, arguments, _):
                        chv_scan_expression_locals(object, in_region, binders, owned, view_names, view_values)
                        for argument in arguments |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(argument, in_region, binders, owned, view_names, view_values) if not index_receiver_is_type_application(object)
                    Expr.Binary(left, _, right, _):
                        chv_scan_expression_locals(left, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(right, in_region, binders, owned, view_names, view_values)
                    Expr.Unary(_, operand, _):
                        chv_scan_expression_locals(operand, in_region, binders, owned, view_names, view_values)
                    Expr.Move(operand, _):
                        chv_scan_expression_locals(operand, in_region, binders, owned, view_names, view_values)
                    Expr.RegionNew(operand, _, _):
                        chv_scan_expression_locals(operand, in_region, binders, owned, view_names, view_values)
                    Expr.Paren(inner, _):
                        chv_scan_expression_locals(inner, in_region, binders, owned, view_names, view_values)
                    Expr.Array(elements, _):
                        for element in elements |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(element, in_region, binders, owned, view_names, view_values)
                    Expr.Tuple(elements, _):
                        for element in elements |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(element, in_region, binders, owned, view_names, view_values)
                    Expr.SetLit(elements, _):
                        for element in elements |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(element, in_region, binders, owned, view_names, view_values)
                    Expr.DictLit(entries, _):
                        for entry in entries |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(entry.key, in_region, binders, owned, view_names, view_values)
                            chv_scan_expression_locals(entry.value, in_region, binders, owned, view_names, view_values)
                    Expr.Construct(_, fields, _):
                        for field in fields |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(field.value, in_region, binders, owned, view_names, view_values)
                    Expr.RecordUpdate(base, fields, _):
                        chv_scan_expression_locals(base, in_region, binders, owned, view_names, view_values)
                        for field in fields |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(field.value, in_region, binders, owned, view_names, view_values)
                    Expr.If(condition, then_value, else_value, _):
                        chv_scan_expression_locals(condition, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(then_value, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(else_value, in_region, binders, owned, view_names, view_values)
                    Expr.Match(scrutinee, arms, _):
                        chv_scan_expression_locals(scrutinee, in_region, binders, owned, view_names, view_values)
                        for arm in arms |binders, owned, view_names, view_values|:
                            chv_scan_expression_locals(arm.guard, in_region, binders, owned, view_names, view_values)
                            chv_scan_locals(arm.body, in_region, binders, owned, view_names, view_values)
                    Expr.Catch(guarded, arms, _):
                        chv_scan_expression_locals(guarded, in_region, binders, owned, view_names, view_values)
                        for arm in arms |binders, owned, view_names, view_values|:
                            pattern_names: mutable darray[sview] = []
                            collect_pattern_binding_names(arm.pattern, pattern_names)
                            for pattern_name in pattern_names |binders|:
                                binders.push(pattern_name)
                            chv_scan_expression_locals(arm.guard, in_region, binders, owned, view_names, view_values)
                            chv_scan_locals(arm.body, in_region, binders, owned, view_names, view_values)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        chv_scan_expression_locals(iterable, in_region, binders, owned, view_names, view_values)
                        comprehension_binders: mutable darray[sview] = [name for name in binders]
                        comprehension_binders.push(variable)
                        chv_scan_expression_locals(condition, in_region, comprehension_binders, owned, view_names, view_values)
                        chv_scan_expression_locals(body, in_region, comprehension_binders, owned, view_names, view_values)
                    Expr.Refinement(base, predicate, _):
                        chv_scan_expression_locals(base, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(predicate, in_region, binders, owned, view_names, view_values)
                    Expr.GetElse(guarded, recovery, _):
                        chv_scan_expression_locals(guarded, in_region, binders, owned, view_names, view_values)
                        chv_scan_locals(recovery, in_region, binders, owned, view_names, view_values)
                    Expr.Lambda(_, _, _):
                        pass
                    Expr.Block(statements, value, _, _):
                        chv_scan_locals(statements, in_region, binders, owned, view_names, view_values)
                        chv_scan_expression_locals(value, in_region, binders, owned, view_names, view_values)

        # A closure introduces untyped parameters that may be either a view or a
        # reference-holder. Even when its enclosing function has only scalar (or no)
        # parameters, its body can therefore contain a store-through edge that needs
        # the same conservative walk as a reference-bearing function body.
        def chv_expression_contains_lambda(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Lambda(_, _, _): true
                    Expr.Call(callee, arguments, _, _): chv_expression_contains_lambda(callee) or any argument in arguments where chv_expression_contains_lambda(argument)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        any child in runtime_children where chv_expression_contains_lambda(child)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _): chv_expression_contains_lambda(object)
                    Expr.Index(object, index, _): chv_expression_contains_lambda(object) or chv_expression_contains_lambda(index)
                    Expr.Slice(object, low, high, _): chv_expression_contains_lambda(object) or chv_expression_contains_lambda(low) or chv_expression_contains_lambda(high)
                    Expr.IndexN(object, arguments, _): chv_expression_contains_lambda(object) or any argument in arguments where chv_expression_contains_lambda(argument)
                    Expr.Binary(left, _, right, _): chv_expression_contains_lambda(left) or chv_expression_contains_lambda(right)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _): chv_expression_contains_lambda(operand)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _): any element in elements where chv_expression_contains_lambda(element)
                    Expr.DictLit(entries, _): any entry in entries where chv_expression_contains_lambda(entry.key) or chv_expression_contains_lambda(entry.value)
                    Expr.Construct(type_expression, fields, _): chv_expression_contains_lambda(type_expression) or any field in fields where chv_expression_contains_lambda(field.value)
                    Expr.RecordUpdate(base, fields, _): chv_expression_contains_lambda(base) or any field in fields where chv_expression_contains_lambda(field.value)
                    Expr.If(condition, then_value, else_value, _): chv_expression_contains_lambda(condition) or chv_expression_contains_lambda(then_value) or chv_expression_contains_lambda(else_value)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _): chv_expression_contains_lambda(scrutinee) or any arm in arms where chv_expression_contains_lambda(arm.guard) or chv_statements_contain_lambda(arm.body)
                    Expr.Comprehension(_, iterable, condition, body, _, _): chv_expression_contains_lambda(iterable) or chv_expression_contains_lambda(condition) or chv_expression_contains_lambda(body)
                    Expr.Refinement(base, predicate, _): chv_expression_contains_lambda(base) or chv_expression_contains_lambda(predicate)
                    Expr.GetElse(guarded, recovery, _): chv_expression_contains_lambda(guarded) or chv_statements_contain_lambda(recovery)
                    Expr.Block(statements, value, _, _): chv_statements_contain_lambda(statements) or chv_expression_contains_lambda(value)
                    _:
                        false


        def chv_statements_contain_lambda(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                found: mutable bool = false
                for statement in statements |found|:
                    match statement:
                        Stmt.Expr(expression, _) | Stmt.Contract(_, expression, _): found <- found or chv_expression_contains_lambda(expression)
                        Stmt.VarDecl(_, type_expression, value, _): found <- found or chv_expression_contains_lambda(type_expression) or chv_expression_contains_lambda(value)
                        Stmt.Assign(target, _, value, _): found <- found or chv_expression_contains_lambda(target) or chv_expression_contains_lambda(value)
                        Stmt.If(condition, then_body, else_body, _): found <- found or chv_expression_contains_lambda(condition) or chv_statements_contain_lambda(then_body) or chv_statements_contain_lambda(else_body)
                        Stmt.While(condition, body, _): found <- found or chv_expression_contains_lambda(condition) or chv_statements_contain_lambda(body)
                        Stmt.For(_, _, iterable, body, _): found <- found or chv_expression_contains_lambda(iterable) or chv_statements_contain_lambda(body)
                        Stmt.Block(_, _, _, body, _): found <- found or chv_statements_contain_lambda(body)
                        Stmt.Match(scrutinee, arms, _):
                            found <- found or chv_expression_contains_lambda(scrutinee)
                            for arm in arms |found|:
                                found <- found or chv_expression_contains_lambda(arm.guard) or chv_statements_contain_lambda(arm.body)
                        Stmt.Return(value, _):
                            if value is returned_value:
                                found <- found or chv_expression_contains_lambda(returned_value)
                        _:
                            pass
                return found

        # Parallel assignment evaluates one tuple/array value once, then lands its
        # elements in corresponding targets. Parentheses do not change that shape.
        def chv_parallel_value_elements(value: Ast::Expr) -> (found: bool, elements: darray[Ast::Expr]):
            can Abort.Panic:
                match value:
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        return (true, elements)
                    Expr.Paren(inner, _):
                        return chv_parallel_value_elements(inner)
                    _:
                        return (false, [])

        def chv_type_is_owned_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, _):
                        return type_name == "dstr"
                    Expr.Index(Expr.Ident(head_name, _), _, _):
                        return head_name == "darray" or head_name == "set"
                    Expr.IndexN(Expr.Ident(head_name, _), _, _):
                        return head_name == "dict"
                    Expr.Unary(operator, operand, _):
                        return operator != TokenKind.Ampersand and chv_type_is_owned_container(operand)
                    Expr.Paren(inner, _):
                        return chv_type_is_owned_container(inner)
                    _:
                        return false

        def chv_type_is_scalar_sview(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, _):
                        return type_name == "sview" or type_name == "cstr"
                    Expr.Scope(_, scoped_name, _):
                        return scoped_name == "sview" or scoped_name == "cstr"
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _):
                        return chv_type_is_scalar_sview(operand)
                    _:
                        return false

        def chv_type_is_byte_sequence(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, _):
                        return type_name == "dstr"
                    Expr.Scope(_, scoped_name, _):
                        return scoped_name == "dstr"
                    Expr.Paren(inner, _):
                        return chv_type_is_byte_sequence(inner)
                    Expr.Unary(operator, operand, _):
                        return false if operator == TokenKind.Ampersand
                        return chv_type_is_byte_sequence(operand)
                    _:
                        return false
