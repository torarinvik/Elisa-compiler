# Stage1 semantic -- the operator diagnostic stage0 raises over an `<invalid>` operand.
#
# A name stage0 cannot resolve is typed `<invalid>`, and an ARITHMETIC or ORDERING
# operator over such an operand draws a second diagnostic on the same line:
#     return nosuch + 1
#   error: undefined identifier "nosuch"
#   error: operator requires numeric operands
# stage1 reported only the first. This file adds the second from stage1's OWN
# diagnostics, so it can only fire where a resolution error is already present.
#
# The propagation rule is MEASURED, not assumed, and it is narrower than "the subtree
# mentions a bad name":
#   * `<invalid>` spreads through arithmetic -- `nosuch - a * b` draws TWO, one per
#     operator, innermost first.
#   * It does NOT spread through a RESOLVED call: `g(nosuch) + 1` draws the undefined
#     identifier alone, because `g`'s return type is known whatever the argument is.
#   * EQUALITY is silent. `x == nosuch` draws nothing beyond the undefined identifier,
#     so only the four ORDERING comparisons are covered here.
# The poisoned-callee test is the cascade's own (check_call_of_invalid.elisa), which is
# why `Api::visible() + Api::hidden()` draws the private-member error, the cascade, and
# this operator diagnostic -- exactly stage0's three.

extend Semantic:
    private:
        # `+ - * / % << >> & ^ |` -- the operators whose result is `<invalid>` when an
        # operand is, and which stage0 reports as "operator requires numeric operands".
        def poe_is_arithmetic(operator: TokenKind) -> bool:
            return operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.LShift, TokenKind.RShift, TokenKind.Ampersand, TokenKind.Caret, TokenKind.Pipe}

        # `< > <= >=`. NOT `==`/`!=`: stage0 compares an `<invalid>` for equality without
        # complaint, measured.
        def poe_is_ordering(operator: TokenKind) -> bool:
            return operator in {TokenKind.Lt, TokenKind.Gt, TokenKind.LtEq, TokenKind.GtEq}

        def poe_named_on_line(table: SymbolTable&, line: u32, kind: DiagnosticKind, spelling: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any diagnostic in table.diagnostics where diagnostic.line == line and diagnostic.kind == kind and diagnostic.name == spelling and spelling != ""

        def poe_kind_on_line(table: SymbolTable&, line: u32, kind: DiagnosticKind) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any diagnostic in table.diagnostics where diagnostic.line == line and diagnostic.kind == kind

        # Does this expression carry stage0's `<invalid>` type? Only ever answered from a
        # diagnostic stage1 already produced, never from a guess about the type itself.
        def poe_is_invalid(expression: Ast::Expr, table: SymbolTable&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 24
                match expression:
                    Expr.Ident(ident_name, ident_line):
                        return poe_named_on_line(table, ident_line.line, DiagnosticKind.UndefinedName, ident_name)
                    Expr.Scope(base, scope_name, scope_line):
                        true return if poe_kind_on_line(table, scope_line.line, DiagnosticKind.PrivateMemberAccess)
                        return poe_named_on_line(table, scope_line.line, DiagnosticKind.UndefinedName, scope_name)
                    Expr.Field(object, field, field_line):
                        true return if poe_named_on_line(table, field_line.line, DiagnosticKind.UnknownFieldAccess, field)
                        # A ghost field is erased from codegen, so stage0 types a real-code read
                        # of it `<invalid>` and the arithmetic over it draws this too.
                        true return if poe_named_on_line(table, field_line.line, DiagnosticKind.GhostFieldRead, field)
                        return poe_kind_on_line(table, field_line.line, DiagnosticKind.FieldAccessOnPrimitive)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return coi_callee_is_poisoned(table, call_line.line, coi_callee_spelling(callee), coi_callee_is_field(callee), coi_callee_is_index(callee))
                    Expr.Paren(inner, paren_line):
                        return poe_is_invalid(inner, table, depth + 1)
                    Expr.Unary(operator, operand, unary_line):
                        return poe_is_invalid(operand, table, depth + 1) if operator == TokenKind.Minus or operator == TokenKind.Tilde
                        return false
                    Expr.Binary(left, operator, right, binary_line):
                        return (poe_is_invalid(left, table, depth + 1) or poe_is_invalid(right, table, depth + 1)) if poe_is_arithmetic(operator)
                        return false
                    _:
                        return false

        def poe_check_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_line):
                        # INNERMOST FIRST: stage0 reports `a - b * c` as the `*` then the `-`.
                        table <- poe_check_expression(left, table)
                        table <- poe_check_expression(right, table)
                        invalid: bool = poe_is_invalid(left, table, 0) or poe_is_invalid(right, table, 0)
                        # stage0 underlines the OPERATOR, which is what a Binary's own
                        # position already is (`nosuch + 1` -> the `+` at 2:19-20).
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: "", line: binary_line.line, pos: binary_line, expected: "", actual: ""}) if invalid and poe_is_arithmetic(operator)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrderingNonNumeric, name: "", line: binary_line.line, pos: binary_line, expected: "", actual: ""}) if invalid and poe_is_ordering(operator)
                    Expr.Unary(operator, operand, unary_line):
                        table <- poe_check_expression(operand, table)
                    Expr.Paren(inner, paren_line):
                        table <- poe_check_expression(inner, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- poe_check_expression(argument, table)
                    Expr.Field(object, field, field_line):
                        table <- poe_check_expression(object, table)
                    Expr.Index(object, index, index_line):
                        table <- poe_check_expression(object, table)
                    Expr.IndexN(indexn_object, indexn_arguments, indexn_line):
                        table <- poe_check_expression(indexn_object, table)
                    Expr.If(condition, then_expr, else_expr, if_expr_line):
                        table <- poe_check_expression(condition, table)
                        table <- poe_check_expression(then_expr, table)
                        table <- poe_check_expression(else_expr, table)
                    Expr.Array(elements, array_line):
                        for element in elements |table| -> table:
                            table <- poe_check_expression(element, table)
                    Expr.Tuple(elements, tuple_line):
                        for element in elements |table| -> table:
                            table <- poe_check_expression(element, table)
                    _:
                        pass

        def poe_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- poe_check_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- poe_check_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- poe_check_expression(value, table)
                        Stmt.Return(value, line):
                            table <- poe_check_expression(returned, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- poe_check_expression(condition, table)
                            table <- poe_check_statements(then_body, table)
                            table <- poe_check_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- poe_check_expression(condition, table)
                            table <- poe_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- poe_check_expression(iterable, table)
                            table <- poe_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- poe_check_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- poe_check_expression(scrutinee, table)
                            for arm in arms |table| -> table:
                                table <- poe_check_statements(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            # `uses C(x)` names a contract, not a value -- see the same veto
                            # in check_call_of_invalid.elisa.
                            table <- poe_check_expression(expression, table) if kind != "uses"
                        _:
                            pass

        # A `where` refinement on a parameter is a predicate like any other, and an
        # unresolvable name in it poisons the comparison exactly the same way.
        def poe_check_parameters(parameters: darray[Ast::ParamDecl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |table| -> table:
                    match parameter.type_expression:
                        Expr.Refinement(refined_base, refined_predicate, refinement_line):
                            table <- poe_check_expression(refined_predicate, table)
                        _:
                            pass

        def poe_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- poe_check_parameters(parameters, table)
                            table <- poe_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- poe_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- poe_walk(scoped_body, table)
                        _:
                            pass

    public:
        # RUNS AFTER check_call_of_invalid: a cascaded call is itself an `<invalid>` operand.
        def check_poisoned_operand(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- poe_walk(file.top_decls, table)
