# A `rebind ..., x = CALL(...)` names `x` (a colon-less target) as a THREADED-SLOT CLAIM (docs/120):
# the callee must thread `x` back, either by declaring lmut threading for it or by taking it as an
# `lmut` parameter. When the callee threads NOTHING — a plain `def f(...)` with no `lmut` parameter —
# every such claim is false: stage0 rejects it ("rebind target X claims a threaded slot, but f
# neither declares lmut threading for it nor passes it to an `lmut` parameter").
#
# SOUND, structural subset: fire only on a DIRECT call `f(...)` to a RESOLVED function that threads
# NO position (no `lmut` parameter within the argument range). A callee that threads SOME position,
# a UFCS receiver call (`recv.m()` — the pervasive `rebind s, p = p.m()` idiom threads its lmut
# receiver), or an unresolved/indirect callee all decline — a conservative miss, never a false claim.
# The colon-less claim names are recorded by the parser on `__lmut_rebind_claim`, keyed by line.
extend Semantic:
    private:
        # Does `callee` thread ANY argument position (0 ..< argument_count) via an lmut parameter?
        def lrc_threads_any(table: SymbolTable&, callee: sview, argument_count: usize) -> bool:
            can Abort.Panic:
                position: mutable u32 = 0
                threads: mutable bool = false
                while position.usize() < argument_count |position, threads, callee, table|:
                    threads <- true if lmut_threads_position(table, callee, position)
                    position <- position + 1
                return threads

        def lrc_claims_at(annotations: darray[Ast::EnumAnnotation]&, line: u32, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.extend([annotation.name for annotation in annotations if annotation.owner == "__lmut_rebind_claim" and annotation.line == line])
        # Is there a claim row at this line at all? The allocation-free half of lrc_claims_at,
        # short-circuiting at the first hit.
        #
        # lrc_check_statement runs for EVERY assignment in the unit and almost none of them
        # carry an `lmut` rebind claim, so it built a list, found it empty, and returned — and
        # that list is enough to give the call an auto-region to mmap and munmap.
        def lrc_has_claim_at(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__lmut_rebind_claim" and annotation.line == line

        def lrc_check_statement(target: Ast::Expr, value: Ast::Expr, line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not lrc_has_claim_at(annotations, line)
                claims: mutable darray[sview] = []
                lrc_claims_at(annotations, line, claims)
                return if claims.count == 0
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Ident(function_name, callee_line):
                                # Resolved single function that threads nothing → its every claim is false.
                                if direct_function_count(table, function_name) > 0 and not lrc_threads_any(table, function_name, arguments.count):
                                    for claim in claims |table| -> table:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LmutFalseClaim, name: claim, line: line, expected: function_name, actual: ""})
                            _:
                                pass
                    _:
                        pass

        def lrc_walk(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            table <- lrc_check_statement(target, value, line.line, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- lrc_walk(then_body, annotations, table)
                            table <- lrc_walk(else_body, annotations, table)
                        Stmt.While(condition, while_body, line):
                            table <- lrc_walk(while_body, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- lrc_walk(for_body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- lrc_walk(body, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- lrc_walk(arm.body, annotations, table)
                        _:
                            pass

        def lrc_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- lrc_walk(body, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- lrc_check_declarations(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- lrc_check_declarations(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_lmut_rebind_claim(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lrc_check_declarations(file.top_decls, file.enum_annotations, table)
