# Runtime-backed dict with an unsupported KEY type, used by indexing it. A `dict[K, V]`'s
# key must have value equality; stage0 rejects `d[k]` when K is `sview` or `dstr`. MEASURED,
# one probe per key type through `d[k] <- 5`:
#     REJECTED: sview, dstr, f32, f64
#     accepted: cstr, i64, u64, i32, usize, bool, char, const enum
#
# WHY THIS IS SYNTACTIC and not another read of the resolved type: the structural type system
# NORMALIZES `sview` and `dstr` dict keys to `cstr`. Proven — `d[true] <- 5` on
# dict[sview, i64] AND on dict[dstr, i64] both report "expects key of type cstr". So the
# interned spelling cannot separate them from a genuine cstr key, and this compiler's own
# source has 25 legitimate cstr-keyed dicts that a check keyed off it would reject. Tracking
# the DECLARED type is the only way to tell them apart; the pattern mirrors
# check_set_membership_element.elisa, which tracks `set[f32]`/`set[f64]` bindings the same way.
#
# The FLOAT keys are deliberately NOT flagged here — resolve_types_operators /
# resolve_types_initializers already own them through the interned spelling (which survives
# for floats), and reporting both would emit two diagnostics where stage0 emits one.
#
# Fires on USE (an index read or an index-assign target), never on the bare declaration:
# stage0 accepts `d: mutable dict[sview, i64] = {}` on its own.

extend Semantic:
    private:
        # The declared head name of a type expression, looking through mutable/&/paren
        # wrappers — "dict" for `mutable dict[sview, i64]&`.
        def dict_type_argument_at(type_expression: Ast::Expr, position: usize) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.IndexN(head, arguments, index_n_line):
                        sview("", 0, 0) return if ident_name_of(head) != "dict" or arguments.count <= position
                        return ident_name_of(arguments[position])
                    Expr.Unary(operator, operand, unary_line):
                        return dict_type_argument_at(operand, position)
                    Expr.Paren(inner, paren_line):
                        return dict_type_argument_at(inner, position)
                    _:
                        return sview("", 0, 0)


        # Whether a declared dict KEY spelling is one stage0 refuses to hash. Only the two
        # STRING-VIEW spellings: floats are owned by the interned-spelling check, and an
        # aggregate key's spelling is not reproducible exactly (same call as the float-only
        # coverage in check_set_membership_element.elisa). Missing a diagnostic is safe.
        def dict_key_spelling_unsupported(key_spelling: sview) -> bool:
            can Abort.Panic:
                return key_spelling == "sview" or key_spelling == "dstr"


        # How stage0 spells a declared type inside this message. `dstr` prints LOWERED as
        # "darray[u8]" — MEASURED: a dict[dstr, i64] reports "got key type in
        # dict[darray[u8], i64]". Same lowering stage0_index_spelling applies for the index
        # and slice walls. Every other spelling passes through, `sview` included.
        def dict_reported_spelling(declared_spelling: sview) -> sview:
            can Abort.Panic:
                "darray[u8]" return if declared_spelling == "dstr"
                return declared_spelling


        # Report `d[...]` when `d` names a tracked dict binding.
        def dict_key_check_index_target(object: Ast::Expr, line: u32, names: darray[sview]&, keys: darray[sview]&, values: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                indexed_name: sview = ident_name_of(object)
                return if indexed_name == ""
                key_spelling: sview = parallel_lookup_first(names, keys, indexed_name)
                return if key_spelling == ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RuntimeDictKeyUnsupported, name: "", line: line, expected: dict_reported_spelling(key_spelling), actual: dict_reported_spelling(parallel_lookup_first(names, values, indexed_name))})


        def dict_key_check_expression(expression: Ast::Expr, names: darray[sview]&, keys: darray[sview]&, values: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, index, line):
                        table <- dict_key_check_index_target(object, line, names, keys, values, table)
                        table <- dict_key_check_expression(object, names, keys, values, table)
                        table <- dict_key_check_expression(index, names, keys, values, table)
                    Expr.Binary(left, operator, right, line):
                        table <- dict_key_check_expression(left, names, keys, values, table)
                        table <- dict_key_check_expression(right, names, keys, values, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- dict_key_check_expression(operand, names, keys, values, table)
                    Expr.Paren(inner, paren_line):
                        table <- dict_key_check_expression(inner, names, keys, values, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- dict_key_check_expression(argument, names, keys, values, table)
                    _:
                        pass


        def dict_key_check_statements(statements: darray[Ast::Stmt], names: darray[sview]&, keys: darray[sview]&, values: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- dict_key_check_expression(expression, names, keys, values, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- dict_key_check_expression(value, names, keys, values, table)
                        Stmt.Assign(target, operator, value, line):
                            # An index TARGET is a use too (`d[k] <- v`), and the target is not
                            # walked as a value expression.
                            if target is Expr.Index(assign_object, assign_index, assign_line):
                                table <- dict_key_check_index_target(assign_object, line, names, keys, values, table)
                                table <- dict_key_check_expression(assign_index, names, keys, values, table)
                            table <- dict_key_check_expression(value, names, keys, values, table)
                        Stmt.Contract(kind, expression, line):
                            table <- dict_key_check_expression(expression, names, keys, values, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- dict_key_check_expression(returned, names, keys, values, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- dict_key_check_expression(condition, names, keys, values, table)
                            table <- dict_key_check_statements(then_body, names, keys, values, table)
                            table <- dict_key_check_statements(else_body, names, keys, values, table)
                        Stmt.While(condition, body, line):
                            table <- dict_key_check_expression(condition, names, keys, values, table)
                            table <- dict_key_check_statements(body, names, keys, values, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- dict_key_check_expression(iterable, names, keys, values, table)
                            table <- dict_key_check_statements(body, names, keys, values, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- dict_key_check_statements(body, names, keys, values, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- dict_key_check_expression(scrutinee, names, keys, values, table)
                            for arm in arms |table| -> table:
                                table <- dict_key_check_statements(arm.body, names, keys, values, table)
                        _:
                            pass


        # Collect local dict bindings with an unsupported declared key (recursively).
        def dict_key_collect_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, keys: mutable darray[sview]&, values: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, keys, values|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            local_key: sview = dict_type_argument_at(type_expression, 0)
                            if dict_key_spelling_unsupported(local_key):
                                names.push(name)
                                keys.push(local_key)
                                values.push(dict_type_argument_at(type_expression, 1))
                        Stmt.If(condition, then_body, else_body, line):
                            dict_key_collect_locals(then_body, names, keys, values)
                            dict_key_collect_locals(else_body, names, keys, values)
                        Stmt.While(condition, body, line):
                            dict_key_collect_locals(body, names, keys, values)
                        Stmt.For(bind, variables, iterable, body, line):
                            dict_key_collect_locals(body, names, keys, values)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            dict_key_collect_locals(body, names, keys, values)
                        _:
                            pass


        def check_runtime_dict_key_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            keys: mutable darray[sview] = []
                            values: mutable darray[sview] = []
                            for param in params |names, keys, values|:
                                param_key: sview = dict_type_argument_at(param.type_expression, 0)
                                if dict_key_spelling_unsupported(param_key):
                                    names.push(param.name)
                                    keys.push(param_key)
                                    values.push(dict_type_argument_at(param.type_expression, 1))
                            dict_key_collect_locals(body, names, keys, values)
                            table <- dict_key_check_statements(body, names, keys, values, table) if names.count > 0
                        Decl.Module(module_name, body, line):
                            table <- check_runtime_dict_key_decls(body, table)
                        Decl.Scoped(body, line):
                            table <- check_runtime_dict_key_decls(body, table)
                        _:
                            pass

    public:
        def check_runtime_dict_key(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_runtime_dict_key_decls(declarations, table)
