# Unknown interface (stage0 static_interfaces / static_interface_protocol_depth). An `impl I for T`
# whose I is not a declared protocol, or a `protocol X is P` whose parent P is not a declared
# protocol, is rejected ("unknown interface I"). The parser records declared protocols
# (owner "__protocol_decl"), each protocol's `is Parent` (sentinel 3900000013), and each impl's
# interface (sentinel 3900000014).
extend Semantic:
    private:
        def interface_is_declared(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__protocol_decl" and annotation.name == name

        def check_unknown_interface(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    # An impl target interface (3900000014) or a protocol supertype (3900000013) that
                    # names no declared protocol.
                    is_interface_ref: bool = annotation.line == 3900000014 or annotation.line == 3900000013
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownInterface, name: annotation.name, line: 0, expected: "", actual: ""}) if is_interface_ref and annotation.name != "" and not interface_is_declared(file.enum_annotations, annotation.name)
