# Unknown interface (stage0 static_interfaces / static_interface_protocol_depth). An `impl I for T`
# whose I is not a declared protocol, or a `protocol X is P` whose parent P is not a declared
# protocol, is rejected ("unknown interface I"). The parser records declared protocols
# (owner "__protocol_decl"), each protocol's `is Parent` (sentinel 3900000013), and each impl's
# interface (sentinel 3900000014).
extend Semantic:
    private:
        def interface_is_declared(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                # A reference may be module-qualified (`Pack::Show`): it names the protocol
                # declared as `Show` inside `module Pack` (the declaration records its module).
                return any annotation in annotations where annotation.owner == "__protocol_decl" and (annotation.name == name or qualified_name_matches(name, annotation.module, annotation.name))

        # Same lookup over an already-filtered protocol list. Keep this separate from
        # interface_is_declared: table.protocol_annotations is also consumed as a sparse
        # annotation side table by unknown-type checking, so changing the shared helper's
        # owner filter would create false ProtocolRequiresConcreteType diagnostics.
        def protocol_list_contains(protocols: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in protocols where annotation.name == name or qualified_name_matches(name, annotation.module, annotation.name)

        def check_unknown_interface(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # References are sparse among all parser annotations. Keep the repeated lookup
                # proportional to protocol declarations, not to every field/effect/permission
                # annotation in a large imported source graph.
                protocols: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations:
                    protocols.push(annotation) if annotation.owner == "__protocol_decl"
                for annotation in file.enum_annotations |table| -> table:
                    # An impl target interface (3900000014) or a protocol supertype (3900000013) that
                    # names no declared protocol.
                    is_interface_ref: bool = annotation.line == 3900000014 or annotation.line == 3900000013
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownInterface, name: annotation.name, line: annotation.detail_line, pos: annotation.pos, expected: "", actual: ""}) if is_interface_ref and annotation.name != "" and not protocol_list_contains(protocols, annotation.name)
