extend Semantic:
    private:
        def chv_iterable_element_yields_scalar_sview(iterable: Ast::Expr, flow: CHVViewFlow&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                known_elements, elements = chv_known_iterable_shape(iterable, depth + 1)
                if known_elements:
                    element_count: usize = chv_known_iterable_shape_count(elements)
                    all_scalar: mutable bool = element_count > 0
                    for element_index in 0..<element_count |all_scalar, elements, flow, view_names, view_values|:
                        element: Ast::Expr = chv_known_iterable_shape_element(elements, element_index)
                        all_scalar <- all_scalar and chv_iterable_element_is_scalar_sview(element, flow, view_names, view_values, depth + 1)
                    return all_scalar
                match iterable:
                    Expr.Slice(object, _, _, _):
                        return chv_iterable_element_yields_scalar_sview(object, flow, view_names, view_values, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        return index < flow.names.count and flow.may_yield_scalar_sview[index]
                    Expr.If(_, then_value, else_value, _):
                        return chv_iterable_element_yields_scalar_sview(then_value, flow, view_names, view_values, depth + 1) and chv_iterable_element_yields_scalar_sview(else_value, flow, view_names, view_values, depth + 1)
                    _:
                        return false

        # A writable reference may be hidden behind a local reference alias or a call
        # returning a reference. Local aliases use both direct and contained flow facts.
        def chv_expression_may_alias_ref(argument: Ast::Expr, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                # As above, lexical name lookup terminates in flow rather than expanding
                # an alias expression, so syntax depth cannot establish reference aliasing.
                match argument:
                    Expr.Paren(inner, _):
                        return chv_expression_may_alias_ref(inner, ref_params, flow, table, depth + 1)
                    Expr.Move(inner, _):
                        return chv_expression_may_alias_ref(inner, ref_params, flow, table, depth + 1)
                    Expr.If(_, then_value, else_value, _):
                        return chv_expression_may_alias_ref(then_value, ref_params, flow, table, depth + 1) or chv_expression_may_alias_ref(else_value, ref_params, flow, table, depth + 1)
                    Expr.Call(Expr.Field(_, method, _), arguments, _, _) if method == "as_sview" or method == "as_cstr":
                        return false if arguments.count == 0
                        return ref_params.count > 0
                    Expr.Call(_, _, _, _):
                        return ref_params.count > 0
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        return any element in elements where chv_expression_may_alias_ref(element, ref_params, flow, table, depth + 1)
                    Expr.DictLit(entries, _):
                        return any entry in entries where chv_expression_may_alias_ref(entry.key, ref_params, flow, table, depth + 1) or chv_expression_may_alias_ref(entry.value, ref_params, flow, table, depth + 1)
                    Expr.Construct(_, fields, _):
                        return any field in fields where chv_expression_may_alias_ref(field.value, ref_params, flow, table, depth + 1)
                    Expr.RecordUpdate(base, fields, _):
                        return chv_expression_may_alias_ref(base, ref_params, flow, table, depth + 1) or any field in fields where chv_expression_may_alias_ref(field.value, ref_params, flow, table, depth + 1)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        empty_view_names: darray[sview] = []
                        empty_view_values: darray[Ast::Expr] = []
                        iterable_may_yield_alias_reference: bool = chv_iterable_element_may_alias_reference(iterable, ref_params, flow, table, depth + 1)
                        iterable_may_contain_alias_reference: bool = chv_iterable_element_may_contain_alias_ref(iterable, ref_params, flow, table, depth + 1)
                        iterable_element_is_scalar_sview: bool = chv_iterable_element_is_scalar_sview(iterable, flow, empty_view_names, empty_view_values, depth + 1)
                        iterable_element_yields_scalar_sview: bool = chv_iterable_element_yields_scalar_sview(iterable, flow, empty_view_names, empty_view_values, depth + 1)
                        comprehension_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                        chv_flow_bind(&comprehension_flow, variable, false, false, iterable_may_yield_alias_reference)
                        chv_flow_set_iterable_element_type(&comprehension_flow, variable, iterable)
                        comprehension_index: usize = chv_flow_latest(comprehension_flow, variable)
                        comprehension_flow.may_contain_alias_reference[comprehension_index] <- iterable_may_contain_alias_reference if comprehension_index < comprehension_flow.names.count
                        comprehension_flow.may_be_scalar_sview[comprehension_index] <- iterable_element_is_scalar_sview if comprehension_index < comprehension_flow.names.count
                        comprehension_flow.may_yield_scalar_sview[comprehension_index] <- iterable_element_yields_scalar_sview if comprehension_index < comprehension_flow.names.count
                        comprehension_ref_params: mutable darray[sview] = []
                        for outer_ref in ref_params |comprehension_ref_params|:
                            comprehension_ref_params.push(outer_ref) if outer_ref != variable
                        chv_flow_bind_truthy_condition_binders(condition, comprehension_ref_params, &comprehension_flow, table)
                        return chv_expression_may_alias_ref(body, comprehension_ref_params, comprehension_flow, table, depth + 1)
                    Expr.Binary(left, binary_operator, right, _):
                        return false if chv_binary_operator_returns_bool(binary_operator, right)
                        return chv_expression_may_alias_ref(left, ref_params, flow, table, depth + 1) or chv_expression_may_alias_ref(right, ref_params, flow, table, depth + 1)
                    Expr.Unary(operator, operand, _):
                        return false if operator == TokenKind.Not
                        return chv_expression_may_alias_ref(operand, ref_params, flow, table, depth + 1)
                    Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _) | Expr.Block(_, _, _, _) | Expr.GetElse(_, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.StaticEffectCall(_, _, _, _, _, _):
                        return ref_params.count > 0
                    Expr.Refinement(base, _, _):
                        return chv_expression_may_alias_ref(base, ref_params, flow, table, depth + 1)
                    _:
                        root: sview = chv_place_root(exclusivity_strip_address(argument).place)
                        if root == "":
                            return false
                        index: usize = chv_flow_latest(flow, root)
                        if index < flow.names.count:
                            return flow.may_alias_reference[index] or flow.may_contain_alias_reference[index]
                        return any reference_parameter in ref_params where reference_parameter == root

        # Unlike chv_expression_may_alias_ref, this query classifies only the value
        # itself. It deliberately stops at aggregate constructors and aggregate names;
        # their nested references are carried in may_contain_alias_reference.
        def chv_expression_may_direct_alias_ref(argument: Ast::Expr, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_expression_may_direct_alias_ref(inner, ref_params, flow, table, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        if index < flow.names.count:
                            return flow.may_direct_alias_reference[index]
                        return any reference_parameter in ref_params where reference_parameter == name
                    Expr.If(_, then_value, else_value, _):
                        return chv_expression_may_direct_alias_ref(then_value, ref_params, flow, table, depth + 1) or chv_expression_may_direct_alias_ref(else_value, ref_params, flow, table, depth + 1)
                    Expr.Call(Expr.Field(_, method, _), arguments, _, _) if method == "as_sview" or method == "as_cstr":
                        return false if arguments.count == 0
                        return ref_params.count > 0
                    Expr.Slice(_, _, _, _):
                        # A slice is a view/container value. Its elements may
                        # carry aliases, but the slice expression is not itself
                        # a direct reference alias.
                        return false
                    Expr.Call(_, _, _, _) | Expr.Field(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Block(_, _, _, _) | Expr.GetElse(_, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.StaticEffectCall(_, _, _, _, _, _):
                        return ref_params.count > 0
                    Expr.Tuple(_, _) | Expr.Array(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _) | Expr.Construct(_, _, _) | Expr.RecordUpdate(_, _, _) | Expr.Comprehension(_, _, _, _, _, _):
                        return false
                    Expr.Binary(left, operator, right, _):
                        return false if chv_binary_operator_returns_bool(operator, right)
                        return chv_expression_may_direct_alias_ref(left, ref_params, flow, table, depth + 1) or chv_expression_may_direct_alias_ref(right, ref_params, flow, table, depth + 1)
                    Expr.Unary(operator, operand, _):
                        return false if operator == TokenKind.Not
                        return chv_expression_may_direct_alias_ref(operand, ref_params, flow, table, depth + 1)
                    Expr.Refinement(base, _, _):
                        return chv_expression_may_direct_alias_ref(base, ref_params, flow, table, depth + 1)
                    _:
                        root: sview = chv_place_root(exclusivity_strip_address(argument).place)
                        if root == "":
                            return false
                        index: usize = chv_flow_latest(flow, root)
                        if index < flow.names.count:
                            return flow.may_direct_alias_reference[index]
                        return any reference_parameter in ref_params where reference_parameter == root

        def chv_expression_may_contain_alias_ref(expression: Ast::Expr, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if chv_flow_iterable_is_scalar_sview(expression, flow, depth + 1)
                known_elements, elements = chv_known_iterable_shape(expression, depth + 1)
                if known_elements:
                    found: mutable bool = false
                    element_count: usize = chv_known_iterable_shape_count(elements)
                    for element_index in 0..<element_count |found, elements, ref_params, flow, table|:
                        element: Ast::Expr = chv_known_iterable_shape_element(elements, element_index)
                        found <- found or chv_expression_may_contain_alias_ref(element, ref_params, flow, table, depth + 1)
                    return found
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_expression_may_contain_alias_ref(inner, ref_params, flow, table, depth + 1)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        return any element in elements where chv_expression_may_contain_alias_ref(element, ref_params, flow, table, depth + 1)
                    Expr.DictLit(entries, _):
                        return any entry in entries where chv_expression_may_contain_alias_ref(entry.key, ref_params, flow, table, depth + 1) or chv_expression_may_contain_alias_ref(entry.value, ref_params, flow, table, depth + 1)
                    Expr.Construct(_, fields, _):
                        return any field in fields where chv_expression_may_contain_alias_ref(field.value, ref_params, flow, table, depth + 1)
                    Expr.RecordUpdate(base, fields, _):
                        return chv_expression_may_contain_alias_ref(base, ref_params, flow, table, depth + 1) or any field in fields where chv_expression_may_contain_alias_ref(field.value, ref_params, flow, table, depth + 1)
                    Expr.Slice(_, _, _, _):
                        return chv_iterable_element_may_contain_alias_ref(expression, ref_params, flow, table, depth + 1)
                    Expr.If(condition, then_value, else_value, _):
                        then_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                        chv_flow_bind_truthy_condition_binders(condition, ref_params, &then_flow, table)
                        return chv_expression_may_contain_alias_ref(then_value, ref_params, then_flow, table, depth + 1) or chv_expression_may_contain_alias_ref(else_value, ref_params, flow, table, depth + 1)
                    Expr.Ident(name, _):
                        return false if chv_flow_iterable_is_scalar_sview(expression, flow, depth + 1)
                        index: usize = chv_flow_latest(flow, name)
                        if index < flow.names.count:
                            return flow.may_contain_alias_reference[index] or flow.may_alias_reference[index]
                        return any reference_parameter in ref_params where reference_parameter == name
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        empty_view_names: darray[sview] = []
                        empty_view_values: darray[Ast::Expr] = []
                        iterable_may_yield_alias_reference: bool = chv_iterable_element_may_alias_reference(iterable, ref_params, flow, table, depth + 1)
                        iterable_may_contain_alias_reference: bool = chv_iterable_element_may_contain_alias_ref(iterable, ref_params, flow, table, depth + 1)
                        iterable_element_is_scalar_sview: bool = chv_iterable_element_is_scalar_sview(iterable, flow, empty_view_names, empty_view_values, depth + 1)
                        iterable_element_yields_scalar_sview: bool = chv_iterable_element_yields_scalar_sview(iterable, flow, empty_view_names, empty_view_values, depth + 1)
                        comprehension_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                        chv_flow_bind(&comprehension_flow, variable, false, false, iterable_may_yield_alias_reference)
                        chv_flow_set_iterable_element_type(&comprehension_flow, variable, iterable)
                        comprehension_index: usize = chv_flow_latest(comprehension_flow, variable)
                        comprehension_flow.may_contain_alias_reference[comprehension_index] <- iterable_may_contain_alias_reference if comprehension_index < comprehension_flow.names.count
                        comprehension_flow.may_be_scalar_sview[comprehension_index] <- iterable_element_is_scalar_sview if comprehension_index < comprehension_flow.names.count
                        comprehension_flow.may_yield_scalar_sview[comprehension_index] <- iterable_element_yields_scalar_sview if comprehension_index < comprehension_flow.names.count
                        comprehension_ref_params: mutable darray[sview] = []
                        for outer_ref in ref_params |comprehension_ref_params|:
                            comprehension_ref_params.push(outer_ref) if outer_ref != variable
                        chv_flow_bind_truthy_condition_binders(condition, comprehension_ref_params, &comprehension_flow, table)
                        return chv_expression_may_contain_alias_ref(body, comprehension_ref_params, comprehension_flow, table, depth + 1)
                    _:
                        return chv_expression_may_alias_ref(expression, ref_params, flow, table, depth + 1)

        # The pre-scan records initializer expressions for local aggregate shapes.
        # Once a binding is assigned, that initializer no longer describes its slots;
        # use the joined flow facts instead of projecting from stale syntax.
        def chv_iterable_shape_unknown(iterable: Ast::Expr, flow: CHVViewFlow&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, depth: u32) -> bool:
            can Abort.Panic:
                return false if depth > 64
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_iterable_shape_unknown(inner, flow, view_names, view_values, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        return true if index < flow.names.count and flow.shape_unknown[index]
                        view_index: mutable usize = view_names.count
                        while view_index > 0 |view_index, view_names, view_values, flow|:
                            view_index <- view_index - 1
                            if view_names[view_index] == name and view_index < view_values.count:
                                match view_values[view_index]:
                                    Expr.Ident(initializer_name, _) if initializer_name == name:
                                        return false
                                    _:
                                        return chv_iterable_shape_unknown(view_values[view_index], flow, view_names, view_values, depth + 1)
                        return false
                    Expr.If(_, then_value, else_value, _):
                        return chv_iterable_shape_unknown(then_value, flow, view_names, view_values, depth + 1) or chv_iterable_shape_unknown(else_value, flow, view_names, view_values, depth + 1)
                    # These literals have a known outer shape even when one of their
                    # elements names a container that was later rebound. Keep the
                    # outer elements available so their current flow facts can be
                    # propagated; destructuring into an unknown nested shape will
                    # still bail in chv_known_iterable_shape_with_locals.
                    Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _):
                        return false
                    _:
                        return false

        def chv_iterable_binding_facts(iterable: Ast::Expr, slot: usize, destructure: bool, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&) -> (known: bool, may_owned_view: bool, may_alias_reference: bool, may_contain_alias_reference: bool, may_be_scalar_sview: bool, may_yield_scalar_sview: bool):
            can Memory.Allocate, Abort.Panic:
                return (false, false, false, false, false, false) if chv_iterable_shape_unknown(iterable, flow, view_names, view_values, 0)
                known, outer_shape = chv_known_iterable_shape_with_locals(iterable, flow, view_names, view_values, 0)
                return (false, false, false, false, false, false) if not known
                outer_count: usize = chv_known_iterable_shape_count(outer_shape)
                return (true, false, false, false, false, false) if outer_count == 0
                may_owned_view: mutable bool = false
                may_alias_reference: mutable bool = false
                may_contain_alias_reference: mutable bool = false
                may_be_scalar_sview: mutable bool = true
                may_yield_scalar_sview: mutable bool = true
                for outer_index in 0..<outer_count |may_owned_view, may_alias_reference, may_contain_alias_reference, may_be_scalar_sview, may_yield_scalar_sview, ref_params, flow, table, view_names, view_values, slot, destructure, outer_shape|:
                    outer_element: Ast::Expr = chv_known_iterable_shape_element(outer_shape, outer_index)
                    element: mutable Ast::Expr = outer_element
                    if destructure:
                        inner_is_known, inner_shape = chv_known_iterable_shape_with_locals(outer_element, flow, view_names, view_values, 0)
                        inner_count: usize = chv_known_iterable_shape_count(inner_shape) if inner_is_known else 0
                        return (false, false, false, false, false, false) if not inner_is_known or slot >= inner_count
                        element <- chv_known_iterable_shape_element(inner_shape, slot)
                    element_is_aggregate, nested_shape = chv_known_iterable_shape_with_locals(element, flow, view_names, view_values, 0)
                    may_owned_view <- may_owned_view or chv_is_owned_view(element, flow, 0)
                    may_alias_reference <- may_alias_reference or (not element_is_aggregate and chv_expression_may_direct_alias_ref(element, ref_params, flow, table, 0))
                    may_contain_alias_reference <- may_contain_alias_reference or chv_expression_may_contain_alias_ref(element, ref_params, flow, table, 0)
                    may_be_scalar_sview <- may_be_scalar_sview and chv_expression_is_scalar_sview(element, flow, view_names, view_values, 0)
                    may_yield_scalar_sview <- may_yield_scalar_sview and chv_iterable_element_yields_scalar_sview(element, flow, view_names, view_values, 0)
                return (true, may_owned_view, may_alias_reference, may_contain_alias_reference, may_be_scalar_sview, may_yield_scalar_sview)

        def chv_call_method_info(callee: Ast::Expr, depth: u32) -> (found: bool, method: sview):
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(_, method, _):
                        return (true, method)
                    Expr.Paren(inner, _):
                        return chv_call_method_info(inner, depth + 1)
                    Expr.Index(head, _, _):
                        return chv_call_method_info(head, depth + 1)
                    Expr.IndexN(head, _, _):
                        return chv_call_method_info(head, depth + 1)
                    _:
                        return (false, sview("", 0, 0))

        # These builtin collection methods can change which values a later iteration
        # yields. Keep this list limited to methods used by the darray, set, and map
        # APIs; reserve changes capacity only and does not invalidate element shape.
        def chv_collection_mutator(method: sview) -> bool:
            can Abort.Panic:
                return method in {"push", "push_back", "push_front", "extend", "append", "append_many", "insert", "pop", "pop_front", "remove", "remove_at", "discard", "delete", "clear", "truncate", "resize", "set", "put", "add", "get_or_insert", "update_at", "retain", "drain", "swap_remove", "swap", "sort", "reverse", "fill"}

        def chv_collection_mutator_adds_values(method: sview) -> bool:
            can Abort.Panic:
                return method in {"push", "push_back", "push_front", "extend", "append", "append_many", "insert", "set", "put", "add", "get_or_insert", "update_at", "fill"}

        # `dict.entry(key).insert(value)` mutates the dictionary rooted at the
        # receiver of `entry`, rather than the temporary entry proxy.
        def chv_mutator_receiver_root(receiver: Ast::Expr, depth: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                return "" if depth > 64
                match receiver:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_mutator_receiver_root(inner, depth + 1)
                    Expr.Call(Expr.Field(base, method, _), _, _, _) if method == "entry":
                        return chv_mutator_receiver_root(base, depth + 1)
                    _:
                        return chv_place_root(receiver)

        def chv_mutator_receiver_root_from_callee(callee: Ast::Expr, depth: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                return "" if depth > 64
                match callee:
                    Expr.Field(receiver, method, _) if chv_collection_mutator(method):
                        return chv_mutator_receiver_root(receiver, depth + 1)
                    Expr.Paren(inner, _) | Expr.Index(inner, _, _) | Expr.IndexN(inner, _, _):
                        return chv_mutator_receiver_root_from_callee(inner, depth + 1)
                    _:
                        return ""

        def chv_walk_call_callee(callee: Ast::Expr, in_region: bool, ref_params: darray[sview]&, binders: darray[sview]&, owned: darray[sview]&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, flow: mutable CHVViewFlow&, summary: StoreThroughSummary&, receiver_owned_view: mutable bool&, receiver_may_alias_reference: mutable bool&, callee_may_be_owned_view: mutable bool&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, _, _):
                        table <- chv_walk_expression(receiver, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                        receiver_owned_view <- flow.last_value_may_be_owned_view
                        receiver_may_alias_reference <- chv_expression_may_alias_ref(receiver, ref_params, flow, table, 0)
                        callee_may_be_owned_view <- false
                        flow.last_value_may_be_owned_view <- false
                    Expr.Paren(inner, _):
                        table <- chv_walk_call_callee(inner, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, receiver_owned_view, receiver_may_alias_reference, callee_may_be_owned_view, table)
                    Expr.Index(head, index, _):
                        table <- chv_walk_call_callee(head, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, receiver_owned_view, receiver_may_alias_reference, callee_may_be_owned_view, table)
                        head_may_be_owned_view: bool = callee_may_be_owned_view or chv_is_owned_view(head, flow, 0)
                        index_may_be_owned_view: mutable bool = false
                        if not index_receiver_is_type_application(head):
                            table <- chv_walk_expression(index, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            index_may_be_owned_view <- flow.last_value_may_be_owned_view
                            indexed_arguments: darray[Ast::Expr] = [head, index]
                            indexed_owned_views: darray[bool] = [head_may_be_owned_view, index_may_be_owned_view]
                            indexed_alias_refs: darray[bool] = [chv_expression_may_alias_ref(head, ref_params, flow, table, 0), chv_expression_may_alias_ref(index, ref_params, flow, table, 0)]
                            table <- chv_check_unknown_call(indexed_arguments, indexed_owned_views, indexed_alias_refs, ref_params, binders, owned, view_names, view_values, flow, table)
                        callee_may_be_owned_view <- head_may_be_owned_view or index_may_be_owned_view
                        flow.last_value_may_be_owned_view <- callee_may_be_owned_view
                    Expr.IndexN(head, arguments, _):
                        table <- chv_walk_call_callee(head, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, receiver_owned_view, receiver_may_alias_reference, callee_may_be_owned_view, table)
                        head_may_be_owned_view: bool = callee_may_be_owned_view or chv_is_owned_view(head, flow, 0)
                        # In call position IndexN is explicit generic application. Its
                        # bracket arguments are type/shape inputs and never runtime values.
                        callee_may_be_owned_view <- head_may_be_owned_view
                        flow.last_value_may_be_owned_view <- callee_may_be_owned_view
                    _:
                        table <- chv_walk_expression(callee, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                        callee_may_be_owned_view <- flow.last_value_may_be_owned_view

        def chv_owned_view_at(arguments: darray[Ast::Expr], owned_views: darray[bool], index: usize, flow: CHVViewFlow&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return owned_views[index] if index < owned_views.count
                return chv_is_owned_view(arguments[index], flow, 0) if index < arguments.count
                return true

        def chv_alias_reference_at(arguments: darray[Ast::Expr], aliases_reference: darray[bool], index: usize, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return aliases_reference[index] if index < aliases_reference.count
                return chv_expression_may_alias_ref(arguments[index], ref_params, flow, table, 0) if index < arguments.count
                return true

        def chv_check_call_target(callee_name: sview, call_arguments: darray[Ast::Expr], argument_owned_views: darray[bool], argument_may_alias_refs: darray[bool], ref_params: darray[sview]&, binders: darray[sview]&, owned: darray[sview]&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, flow: mutable CHVViewFlow&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not sts_has_writable(summary, callee_name)
                source_checked: mutable darray[bool] = []
                source_is_owned_view: mutable darray[bool] = []
                source_cache_ready: mutable bool = false
                target: mutable usize = 0
                while target < call_arguments.count |target, table, source_cache_ready, source_checked, source_is_owned_view| -> table:
                    if sts_is_writable(summary, callee_name, target):
                        if chv_alias_reference_at(call_arguments, argument_may_alias_refs, target, ref_params, flow, table):
                            if not source_cache_ready:
                                for source_index in 0..<call_arguments.count |source_checked, source_is_owned_view|:
                                    source_checked.push(false)
                                    source_is_owned_view.push(false)
                                source_cache_ready <- true
                            source: mutable usize = 0
                            while source < call_arguments.count |source, table, source_is_owned_view, source_checked| -> table:
                                if source != target and sts_has_pair(summary, callee_name, target, source):
                                    if not source_checked[source]:
                                        source_is_owned_view[source] <- chv_owned_view_at(call_arguments, argument_owned_views, source, flow)
                                        source_checked[source] <- true
                                    if source_is_owned_view[source]:
                                        at: Ast::Pos = Ast::expr_pos(call_arguments[source])
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AutoRegionStoreEscape, name: "", pos: at, line: at.line, expected: "", actual: "", state_code: (target + CHV_DIAGNOSTIC_ARGUMENT_NUMBER_BASE).u32()})
                                source <- source + 1
                    target <- target + 1

        def chv_call_has_named_arguments(argument_names: darray[sview]) -> bool:
            can Abort.Panic:
                return any argument_name in argument_names where argument_name != ""

        # An indirect or external call has no source summary. If it receives a caller
        # reference, an alias of one, or a result that may return one, plus an owned view,
        # assume the call may store that view through the reference.
        def chv_check_unknown_call(call_arguments: darray[Ast::Expr], argument_owned_views: darray[bool], argument_may_alias_refs: darray[bool], ref_params: darray[sview]&, binders: darray[sview]&, owned: darray[sview]&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, flow: mutable CHVViewFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for target in 0..<call_arguments.count |table| -> table:
                    if chv_alias_reference_at(call_arguments, argument_may_alias_refs, target, ref_params, flow, table):
                        for source in 0..<call_arguments.count |table| -> table:
                            if source != target and chv_owned_view_at(call_arguments, argument_owned_views, source, flow):
                                at: Ast::Pos = Ast::expr_pos(call_arguments[source])
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AutoRegionStoreEscape, name: "", pos: at, line: at.line, expected: "", actual: "", state_code: (target + CHV_DIAGNOSTIC_ARGUMENT_NUMBER_BASE).u32()})

        def chv_check_named_call(callee_name: sview, call_arguments: darray[Ast::Expr], argument_names: darray[sview], argument_owned_views: darray[bool], argument_may_alias_refs: darray[bool], ref_params: darray[sview]&, binders: darray[sview]&, owned: darray[sview]&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, flow: mutable CHVViewFlow&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if not chv_call_has_named_arguments(argument_names) and sts_is_declared(summary, callee_name) and not (any binder in binders where binder == callee_name):
                    table <- chv_check_call_target(callee_name, call_arguments, argument_owned_views, argument_may_alias_refs, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                else:
                    table <- chv_check_unknown_call(call_arguments, argument_owned_views, argument_may_alias_refs, ref_params, binders, owned, view_names, view_values, flow, table)

        def chv_check_named_callee(callee: Ast::Expr, call_arguments: darray[Ast::Expr], argument_names: darray[sview], argument_owned_views: darray[bool], argument_may_alias_refs: darray[bool], method_receiver_owned_view: bool, method_receiver_may_alias_ref: bool, ref_params: darray[sview]&, binders: darray[sview]&, owned: darray[sview]&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, flow: mutable CHVViewFlow&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Ident(callee_name, _):
                        table <- chv_check_named_call(callee_name, call_arguments, argument_names, argument_owned_views, argument_may_alias_refs, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                    Expr.Scope(_, scoped_name, _):
                        table <- chv_check_named_call(scoped_name, call_arguments, argument_names, argument_owned_views, argument_may_alias_refs, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                    Expr.Field(receiver, _, _):
                        method_arguments: mutable darray[Ast::Expr] = [receiver]
                        method_arguments.extend(call_arguments)
                        method_owned_views: mutable darray[bool] = [method_receiver_owned_view]
                        method_owned_views.extend(argument_owned_views)
                        method_may_alias_refs: mutable darray[bool] = [method_receiver_may_alias_ref]
                        method_may_alias_refs.extend(argument_may_alias_refs)
                        table <- chv_check_unknown_call(method_arguments, method_owned_views, method_may_alias_refs, ref_params, binders, owned, view_names, view_values, flow, table)
                    Expr.Index(head, _, _):
                        table <- chv_check_named_callee(head, call_arguments, argument_names, argument_owned_views, argument_may_alias_refs, method_receiver_owned_view, method_receiver_may_alias_ref, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                    Expr.IndexN(head, _, _):
                        table <- chv_check_named_callee(head, call_arguments, argument_names, argument_owned_views, argument_may_alias_refs, method_receiver_owned_view, method_receiver_may_alias_ref, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                    Expr.Paren(inner, _):
                        table <- chv_check_named_callee(inner, call_arguments, argument_names, argument_owned_views, argument_may_alias_refs, method_receiver_owned_view, method_receiver_may_alias_ref, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                    _:
                        table <- chv_check_unknown_call(call_arguments, argument_owned_views, argument_may_alias_refs, ref_params, binders, owned, view_names, view_values, flow, table)

        def chv_check_call(call: Ast::Expr, argument_owned_views: darray[bool], argument_may_alias_refs: darray[bool], method_receiver_owned_view: bool, method_receiver_may_alias_ref: bool, ref_params: darray[sview]&, binders: darray[sview]&, owned: darray[sview]&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, flow: mutable CHVViewFlow&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match call:
                    Expr.Call(callee, call_arguments, argument_names, _):
                        table <- chv_check_named_callee(callee, call_arguments, argument_names, argument_owned_views, argument_may_alias_refs, method_receiver_owned_view, method_receiver_may_alias_ref, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                    _:
                        pass

        # Bindings from a successful pattern test carry the scrutinee's conservative
        # provenance. This mirrors resolver flow: names introduced by `is`/`as` are local
        # values in the true path, and `and` unions the binders of its operands while `or`
        # retains only names bound by both alternatives.
        def chv_truthy_binding_facts(condition: Ast::Expr, binder: sview, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&) -> (found: bool, may_owned_view: bool, may_alias_reference: bool):
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        return chv_truthy_binding_facts(inner, binder, ref_params, flow, table)
                    Expr.Binary(left, operator, right, _):
                        match operator:
                            TokenKind.Is | TokenKind.As:
                                names: mutable darray[sview @source] = []
                                gather_truthy_condition_bindings(condition, table, names)
                                if any name in names where name == binder:
                                    return (true, chv_is_owned_view(left, flow, 0), chv_expression_may_alias_ref(left, ref_params, flow, table, 0))
                            TokenKind.And:
                                left_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_truthy_binding_facts(left, binder, ref_params, flow, table)
                                left_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                                chv_flow_bind_truthy_condition_binders(left, ref_params, &left_flow, table)
                                right_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_truthy_binding_facts(right, binder, ref_params, left_flow, table)
                                right_names: mutable darray[sview @source] = []
                                gather_truthy_condition_bindings(right, table, right_names)
                                return right_facts if any name in right_names where name == binder
                                return (left_facts.found or right_facts.found, left_facts.may_owned_view or right_facts.may_owned_view, left_facts.may_alias_reference or right_facts.may_alias_reference)
                            TokenKind.Or:
                                left_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_truthy_binding_facts(left, binder, ref_params, flow, table)
                                right_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_truthy_binding_facts(right, binder, ref_params, flow, table)
                                return (left_facts.found and right_facts.found, left_facts.may_owned_view or right_facts.may_owned_view, left_facts.may_alias_reference or right_facts.may_alias_reference)
                            _:
                                pass
                    _:
                        pass
                return (false, false, false)

        def chv_flow_bind_expression_binders(expression: Ast::Expr, ref_params: darray[sview]&, flow: mutable CHVViewFlow&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview @source] = []
                gather_expression_bindings(expression, names)
                for name in names |flow, table|:
                    facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(expression, name, ref_params, flow, table)
                    # If the scope walker gathers a binder from a shape whose value source
                    # this analysis cannot recover, preserve soundness without erasing taint.
                    chv_flow_bind(flow, name, false, facts.may_owned_view or not facts.found, facts.may_alias_reference or not facts.found)

        def chv_join_expression_binding_facts(left: (found: bool, may_owned_view: bool, may_alias_reference: bool), right: (found: bool, may_owned_view: bool, may_alias_reference: bool)) -> (found: bool, may_owned_view: bool, may_alias_reference: bool):
            can Abort.Panic:
                return (left.found or right.found, left.may_owned_view or right.may_owned_view, left.may_alias_reference or right.may_alias_reference)

        # Ordered expression children can introduce the same binder more than once.
        # The later occurrence shadows the earlier one in the surrounding flow.
        def chv_last_expression_binding_facts(left: (found: bool, may_owned_view: bool, may_alias_reference: bool), right: (found: bool, may_owned_view: bool, may_alias_reference: bool)) -> (found: bool, may_owned_view: bool, may_alias_reference: bool):
            can Abort.Panic:
                return right if right.found
                return left

        def chv_expression_binding_facts(expression: Ast::Expr, binder: sview, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&) -> (found: bool, may_owned_view: bool, may_alias_reference: bool):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.Is or operator == TokenKind.As:
                            names: mutable darray[sview @source] = []
                            gather_truthy_condition_bindings(expression, table, names)
                            return (true, chv_is_owned_view(left, flow, 0), chv_expression_may_alias_ref(left, ref_params, flow, table, 0)) if any name in names where name == binder
                            return (false, false, false)
                        left_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(left, binder, ref_params, flow, table)
                        if operator == TokenKind.And:
                            right_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                            chv_flow_bind_truthy_condition_binders(left, ref_params, &right_flow, table)
                            right_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(right, binder, ref_params, right_flow, table)
                            return right_facts if right_facts.found
                            return left_facts
                        right_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(right, binder, ref_params, flow, table)
                        if operator == TokenKind.Or:
                            # A disjunction only introduces a pattern name when both
                            # alternatives bind it. If the syntax collector still reports
                            # a one-sided binder, the caller fails closed and keeps it tainted.
                            return (left_facts.found and right_facts.found, left_facts.may_owned_view or right_facts.may_owned_view, left_facts.may_alias_reference or right_facts.may_alias_reference)
                        return chv_last_expression_binding_facts(left_facts, right_facts)
                    Expr.Call(callee, arguments, _, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(callee, binder, ref_params, flow, table)
                        for argument in arguments |facts, flow, table|:
                            next_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(argument, binder, ref_params, flow, table)
                            facts <- chv_last_expression_binding_facts(facts, next_facts)
                        return facts
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = (false, false, false)
                        for child in Ast::effect_runtime_children(candidates, arguments) |facts, flow, table|:
                            next_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(child, binder, ref_params, flow, table)
                            facts <- chv_last_expression_binding_facts(facts, next_facts)
                        return facts
                    Expr.Field(receiver, _, _) | Expr.Scope(receiver, _, _) | Expr.Unary(_, receiver, _) | Expr.Move(receiver, _) | Expr.RegionNew(receiver, _, _) | Expr.Paren(receiver, _):
                        return chv_expression_binding_facts(receiver, binder, ref_params, flow, table)
                    Expr.Index(receiver, index, _) | Expr.Refinement(receiver, index, _):
                        left_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(receiver, binder, ref_params, flow, table)
                        right_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(index, binder, ref_params, flow, table)
                        # The selector/predicate evaluates after the receiver/base and
                        # can shadow a same-named pattern binder from it.
                        return right_facts if right_facts.found
                        return left_facts
                    Expr.Slice(receiver, low, high, _):
                        receiver_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(receiver, binder, ref_params, flow, table)
                        low_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(low, binder, ref_params, flow, table)
                        high_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(high, binder, ref_params, flow, table)
                        # Slice operands are visited receiver, low bound, high bound;
                        # the last matching binder is the one visible after evaluation.
                        return high_facts if high_facts.found
                        return low_facts if low_facts.found
                        return receiver_facts
                    Expr.IndexN(receiver, arguments, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(receiver, binder, ref_params, flow, table)
                        for argument in arguments |facts, flow, table|:
                            next_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(argument, binder, ref_params, flow, table)
                            facts <- chv_last_expression_binding_facts(facts, next_facts)
                        return facts
                    Expr.Tuple(elements, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = (false, false, false)
                        for element in elements |facts, flow, table|:
                            next_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(element, binder, ref_params, flow, table)
                            # Tuple elements are resolved in source order and append their
                            # binders to the enclosing scope. A later same-name element
                            # shadows an earlier one, so retain the last matching fact.
                            facts <- next_facts if next_facts.found
                        return facts
                    Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = (false, false, false)
                        for element in elements |facts, flow, table|:
                            next_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(element, binder, ref_params, flow, table)
                            facts <- chv_last_expression_binding_facts(facts, next_facts)
                        return facts
                    Expr.DictLit(entries, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = (false, false, false)
                        for entry in entries |facts, flow, table|:
                            key_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(entry.key, binder, ref_params, flow, table)
                            value_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(entry.value, binder, ref_params, flow, table)
                            facts <- chv_last_expression_binding_facts(facts, key_facts)
                            facts <- chv_last_expression_binding_facts(facts, value_facts)
                        return facts
                    Expr.Construct(_, fields, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = (false, false, false)
                        for field in fields |facts, flow, table|:
                            next_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(field.value, binder, ref_params, flow, table)
                            facts <- chv_last_expression_binding_facts(facts, next_facts)
                        return facts
                    Expr.RecordUpdate(base, fields, _):
                        facts: mutable (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(base, binder, ref_params, flow, table)
                        for field in fields |facts, flow, table|:
                            next_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(field.value, binder, ref_params, flow, table)
                            facts <- chv_last_expression_binding_facts(facts, next_facts)
                        return facts
                    Expr.If(condition, then_value, else_value, _):
                        condition_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(condition, binder, ref_params, flow, table)
                        then_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(then_value, binder, ref_params, flow, table)
                        else_facts: (found: bool, may_owned_view: bool, may_alias_reference: bool) = chv_expression_binding_facts(else_value, binder, ref_params, flow, table)
                        return (condition_facts.found or then_facts.found or else_facts.found, condition_facts.may_owned_view or then_facts.may_owned_view or else_facts.may_owned_view, condition_facts.may_alias_reference or then_facts.may_alias_reference or else_facts.may_alias_reference)
                    Expr.GetElse(guarded, _, _):
                        return chv_expression_binding_facts(guarded, binder, ref_params, flow, table)
                    Expr.Match(scrutinee, _, _) | Expr.Catch(scrutinee, _, _):
                        return chv_expression_binding_facts(scrutinee, binder, ref_params, flow, table)
                    Expr.Comprehension(_, iterable, _, _, _, _):
                        return chv_expression_binding_facts(iterable, binder, ref_params, flow, table)
                    _:
                        return (false, false, false)
