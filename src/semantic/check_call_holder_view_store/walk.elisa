extend Semantic:
    private:
        def chv_walk_statements(statements: darray[Ast::Stmt], in_region: bool, ref_params: darray[sview]&, binders: darray[sview]&, owned: darray[sview]&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, flow: mutable CHVViewFlow&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, flow| -> table:
                    match statement:
                        Stmt.Invalid:
                            pass
                        Stmt.Expr(statement_value, _):
                            table <- chv_walk_expression(statement_value, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            chv_flow_bind_expression_binders(statement_value, ref_params, flow, table)
                        Stmt.VarDecl(declared_name, type_expression, declared_value, _):
                            table <- chv_walk_expression(declared_value, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            chv_flow_bind_expression_binders(declared_value, ref_params, flow, table)
                            typed_owned: bool = chv_type_is_owned_container(type_expression) and not type_marker_present_here(type_expression, TokenKind.Ampersand)
                            literal_owned: bool = (type_expression is Expr.Absent) and (declared_value is Expr.Array(_, _))
                            declared_alias_ref: bool = chv_expression_may_alias_ref(declared_value, ref_params, flow, table, 0)
                            declared_direct_alias_ref: bool = chv_type_is_direct_alias_reference(type_expression, flow.type_alias_names, flow.type_alias_targets, 0) if not (type_expression is Expr.Absent) else chv_expression_may_direct_alias_ref(declared_value, ref_params, flow, table, 0)
                            declared_shape_known, declared_shape = chv_known_iterable_shape(declared_value, 0)
                            declared_type_yield_facts: (known: bool, may_yield: bool) = chv_type_iterable_yields_alias_reference(type_expression, flow.type_alias_names, flow.type_alias_targets, 0)
                            declared_yield_alias_reference: bool = declared_type_yield_facts.may_yield if declared_type_yield_facts.known else chv_iterable_element_may_alias_reference(declared_value, ref_params, flow, table, 0)
                            declared_yield_alias_known: bool = declared_type_yield_facts.known or declared_shape_known
                            declared_type_may_contain_alias_reference: bool = chv_type_may_contain_alias_reference_with_holders(type_expression, flow.reference_holders, 0) if not declared_shape_known else false
                            declared_may_contain_alias_reference: bool = declared_type_may_contain_alias_reference or chv_expression_may_contain_alias_ref(declared_value, ref_params, flow, table, 0)
                            declared_may_be_scalar_sview: bool = chv_type_is_scalar_sview(type_expression) or chv_flow_iterable_is_scalar_sview(declared_value, flow, 0) or chv_expression_is_scalar_sview(declared_value, flow, view_names, view_values, 0)
                            declared_may_yield_scalar_sview: bool = chv_type_iterable_yields_scalar_sview(type_expression, 0) or chv_iterable_element_is_scalar_sview(declared_value, flow, view_names, view_values, 0)
                            # Opaque extern values may retain borrowed Elisa pointers, so
                            # their type does not erase initializer provenance.
                            chv_flow_bind(flow, declared_name, not in_region and (typed_owned or literal_owned), flow.last_value_may_be_owned_view, declared_alias_ref)
                            declared_index: usize = chv_flow_latest(flow, declared_name)
                            flow.may_direct_alias_reference[declared_index] <- declared_direct_alias_ref if declared_index < flow.names.count
                            flow.may_contain_alias_reference[declared_index] <- declared_may_contain_alias_reference if declared_index < flow.names.count
                            flow.may_yield_alias_reference[declared_index] <- declared_yield_alias_reference if declared_index < flow.names.count
                            flow.may_yield_alias_reference_known[declared_index] <- declared_yield_alias_known if declared_index < flow.names.count
                            flow.binding_types[declared_index] <- type_expression if declared_index < flow.names.count and not (type_expression is Expr.Absent)
                            flow.binding_type_known[declared_index] <- not (type_expression is Expr.Absent) if declared_index < flow.names.count
                            flow.may_be_scalar_sview[declared_index] <- declared_may_be_scalar_sview if declared_index < flow.names.count
                            flow.may_yield_scalar_sview[declared_index] <- declared_may_yield_scalar_sview if declared_index < flow.names.count
                            flow.may_be_byte_sequence[declared_index] <- chv_type_is_byte_sequence(type_expression) or chv_flow_is_byte_sequence(declared_value, flow, 0) if declared_index < flow.names.count
                        Stmt.Assign(target, operator, assigned_value, assign_pos):
                            assigned_name: sview = ident_name_of(target)
                            assigned_root: sview = chv_place_root(target)
                            projection_assignment: bool = assigned_name == "" and assigned_root != ""
                            previous_may_owned_view: mutable bool = false
                            previous_may_alias_reference: mutable bool = false
                            previous_may_direct_alias_reference: mutable bool = false
                            previous_may_contain_alias_reference: mutable bool = false
                            previous_may_be_scalar_sview: mutable bool = false
                            previous_index: usize = chv_flow_latest(flow, assigned_root) if assigned_root != "" else flow.names.count
                            previous_may_owned_view <- flow.may_owned_view[previous_index] if previous_index < flow.names.count
                            previous_may_alias_reference <- flow.may_alias_reference[previous_index] if previous_index < flow.names.count
                            previous_may_direct_alias_reference <- flow.may_direct_alias_reference[previous_index] if previous_index < flow.names.count
                            previous_may_contain_alias_reference <- flow.may_contain_alias_reference[previous_index] if previous_index < flow.names.count
                            previous_may_be_scalar_sview <- flow.may_be_scalar_sview[previous_index] if previous_index < flow.names.count
                            parallel_targets: mutable darray[Ast::Expr] = []
                            if target is Expr.Array(target_elements, _):
                                parallel_targets.extend(target_elements)
                            parallel_values_found, parallel_values = chv_parallel_value_elements(assigned_value)
                            parallel_shape: bool = parallel_values_found and parallel_targets.count > 0 and parallel_targets.count == parallel_values.count
                            parallel_owned_views: mutable darray[bool] = []
                            parallel_alias_refs: mutable darray[bool] = []
                            parallel_direct_alias_refs: mutable darray[bool] = []
                            parallel_contained_alias_refs: mutable darray[bool] = []
                            parallel_yield_alias_refs: mutable darray[bool] = []
                            parallel_yield_alias_knowns: mutable darray[bool] = []
                            parallel_scalar_sviews: mutable darray[bool] = []
                            parallel_yield_scalar_sviews: mutable darray[bool] = []
                            assigned_value_may_be_owned_view: mutable bool = false
                            assigned_value_may_alias_reference: mutable bool = false
                            assigned_value_may_direct_alias_reference: mutable bool = false
                            assigned_value_may_contain_alias_reference: mutable bool = false
                            assigned_value_may_yield_alias_reference: mutable bool = false
                            assigned_value_yield_alias_reference_known: mutable bool = true
                            assigned_value_may_be_scalar_sview: mutable bool = false
                            assigned_value_may_yield_scalar_sview: mutable bool = false
                            if parallel_shape:
                                # Walk each value exactly once, left to right. Preserve its
                                # own facts for the matching synthetic rebind temporary.
                                for parallel_value in parallel_values |table, parallel_owned_views, parallel_alias_refs, parallel_direct_alias_refs, parallel_contained_alias_refs, parallel_yield_alias_refs, parallel_yield_alias_knowns, parallel_scalar_sviews, parallel_yield_scalar_sviews, flow, assigned_value_may_be_owned_view, assigned_value_may_alias_reference, assigned_value_may_direct_alias_reference, assigned_value_may_contain_alias_reference, assigned_value_may_yield_alias_reference, assigned_value_yield_alias_reference_known| -> table:
                                    table <- chv_walk_expression(parallel_value, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                                    value_may_be_owned_view: bool = flow.last_value_may_be_owned_view
                                    value_may_alias_reference: bool = chv_expression_may_alias_ref(parallel_value, ref_params, flow, table, 0)
                                    value_may_direct_alias_reference: bool = chv_expression_may_direct_alias_ref(parallel_value, ref_params, flow, table, 0)
                                    value_may_contain_alias_reference: bool = chv_expression_may_contain_alias_ref(parallel_value, ref_params, flow, table, 0)
                                    value_yield_alias_facts: (known: bool, may_yield: bool) = chv_iterable_element_alias_facts(parallel_value, ref_params, flow, table, 0)
                                    value_may_be_scalar_sview: bool = chv_expression_is_scalar_sview(parallel_value, flow, view_names, view_values, 0)
                                    value_may_yield_scalar_sview: bool = chv_iterable_element_is_scalar_sview(parallel_value, flow, view_names, view_values, 0)
                                    parallel_owned_views.push(value_may_be_owned_view)
                                    parallel_alias_refs.push(value_may_alias_reference)
                                    parallel_direct_alias_refs.push(value_may_direct_alias_reference)
                                    parallel_contained_alias_refs.push(value_may_contain_alias_reference)
                                    parallel_yield_alias_refs.push(value_yield_alias_facts.may_yield)
                                    parallel_yield_alias_knowns.push(value_yield_alias_facts.known)
                                    parallel_scalar_sviews.push(value_may_be_scalar_sview)
                                    parallel_yield_scalar_sviews.push(value_may_yield_scalar_sview)
                                    assigned_value_may_be_owned_view <- assigned_value_may_be_owned_view or value_may_be_owned_view
                                    assigned_value_may_alias_reference <- assigned_value_may_alias_reference or value_may_alias_reference
                                    assigned_value_may_direct_alias_reference <- assigned_value_may_direct_alias_reference or value_may_direct_alias_reference
                                    assigned_value_may_contain_alias_reference <- assigned_value_may_contain_alias_reference or value_may_contain_alias_reference
                                    assigned_value_may_yield_alias_reference <- assigned_value_may_yield_alias_reference or value_yield_alias_facts.may_yield
                                    assigned_value_yield_alias_reference_known <- assigned_value_yield_alias_reference_known and value_yield_alias_facts.known if parallel_values.count > 1 else value_yield_alias_facts.known
                                flow.last_value_may_be_owned_view <- assigned_value_may_be_owned_view
                            else:
                                table <- chv_walk_expression(assigned_value, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                                assigned_value_may_be_owned_view <- flow.last_value_may_be_owned_view
                                assigned_value_may_alias_reference <- chv_expression_may_alias_ref(assigned_value, ref_params, flow, table, 0)
                                assigned_value_may_direct_alias_reference <- chv_expression_may_direct_alias_ref(assigned_value, ref_params, flow, table, 0)
                                assigned_value_may_contain_alias_reference <- chv_expression_may_contain_alias_ref(assigned_value, ref_params, flow, table, 0)
                                assigned_value_yield_alias_facts: (known: bool, may_yield: bool) = chv_iterable_element_alias_facts(assigned_value, ref_params, flow, table, 0)
                                assigned_value_may_yield_alias_reference <- assigned_value_yield_alias_facts.may_yield
                                assigned_value_yield_alias_reference_known <- assigned_value_yield_alias_facts.known
                                assigned_value_may_be_scalar_sview <- chv_expression_is_scalar_sview(assigned_value, flow, view_names, view_values, 0)
                                assigned_value_may_yield_scalar_sview <- chv_iterable_element_is_scalar_sview(assigned_value, flow, view_names, view_values, 0)
                            chv_flow_bind_expression_binders(assigned_value, ref_params, flow, table)
                            table <- chv_walk_expression(target, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            assigned_alias: bool = assigned_value_may_be_owned_view or ((operator != TokenKind.Assign or projection_assignment) and previous_may_owned_view)
                            assigned_alias_ref: bool = assigned_value_may_alias_reference or ((operator != TokenKind.Assign or projection_assignment) and previous_may_alias_reference)
                            assigned_direct_alias_ref: bool = assigned_value_may_direct_alias_reference or ((operator != TokenKind.Assign or projection_assignment) and previous_may_direct_alias_reference)
                            assigned_contains_alias_ref: bool = assigned_value_may_contain_alias_reference or (projection_assignment and assigned_value_may_alias_reference) or ((operator != TokenKind.Assign or projection_assignment) and previous_may_contain_alias_reference)
                            if assigned_root != "":
                                assigned_index: mutable usize = chv_flow_latest(flow, assigned_root)
                                if operator == TokenKind.Assign and assigned_name != "":
                                    # `=` creates a new lexical binding, including when a name
                                    # already exists in an outer scope. Preserve the previous row
                                    # so branch-local shadowing cannot leak after the join.
                                    chv_flow_bind(flow, assigned_root, false, assigned_alias, assigned_alias_ref)
                                    assigned_index <- chv_flow_latest(flow, assigned_root)
                                    flow.may_direct_alias_reference[assigned_index] <- assigned_value_may_direct_alias_reference if assigned_index < flow.names.count
                                    flow.may_contain_alias_reference[assigned_index] <- assigned_value_may_contain_alias_reference if assigned_index < flow.names.count
                                    flow.may_yield_alias_reference[assigned_index] <- assigned_value_may_yield_alias_reference if assigned_index < flow.names.count
                                    flow.may_yield_alias_reference_known[assigned_index] <- assigned_value_yield_alias_reference_known if assigned_index < flow.names.count
                                    flow.may_be_scalar_sview[assigned_index] <- assigned_value_may_be_scalar_sview if assigned_index < flow.names.count
                                    flow.may_yield_scalar_sview[assigned_index] <- assigned_value_may_yield_scalar_sview if assigned_index < flow.names.count
                                    flow.shape_unknown[assigned_index] <- true if assigned_index < flow.names.count
                                elif assigned_index < flow.names.count:
                                    flow.may_owned_view[assigned_index] <- assigned_alias
                                    flow.may_alias_reference[assigned_index] <- assigned_alias_ref
                                    flow.may_direct_alias_reference[assigned_index] <- assigned_direct_alias_ref if assigned_name != "" else previous_may_direct_alias_reference
                                    flow.may_contain_alias_reference[assigned_index] <- assigned_contains_alias_ref
                                    flow.may_yield_alias_reference[assigned_index] <- assigned_value_may_yield_alias_reference if assigned_name != "" else flow.may_yield_alias_reference[assigned_index] or assigned_value_may_yield_alias_reference
                                    flow.may_yield_alias_reference_known[assigned_index] <- assigned_value_yield_alias_reference_known if assigned_name != "" else flow.may_yield_alias_reference_known[assigned_index] and assigned_value_yield_alias_reference_known
                                    flow.may_be_scalar_sview[assigned_index] <- assigned_value_may_be_scalar_sview if assigned_name != "" else false
                                    flow.may_yield_scalar_sview[assigned_index] <- assigned_value_may_yield_scalar_sview if assigned_name != "" else false
                                    flow.shape_unknown[assigned_index] <- true
                                else:
                                    chv_flow_bind(flow, assigned_root, false, assigned_alias, assigned_alias_ref)
                                    assigned_index <- chv_flow_latest(flow, assigned_root)
                                    flow.may_direct_alias_reference[assigned_index] <- assigned_value_may_direct_alias_reference if assigned_index < flow.names.count
                                    flow.may_contain_alias_reference[assigned_index] <- assigned_value_may_contain_alias_reference if assigned_index < flow.names.count
                                    flow.may_yield_alias_reference[assigned_index] <- assigned_value_may_yield_alias_reference if assigned_index < flow.names.count
                                    flow.may_yield_alias_reference_known[assigned_index] <- assigned_value_yield_alias_reference_known if assigned_index < flow.names.count
                                    flow.may_be_scalar_sview[assigned_index] <- assigned_value_may_be_scalar_sview if assigned_index < flow.names.count
                                    flow.may_yield_scalar_sview[assigned_index] <- assigned_value_may_yield_scalar_sview if assigned_index < flow.names.count
                                    flow.shape_unknown[assigned_index] <- true if assigned_index < flow.names.count
                            elif target is Expr.Array(target_elements, _):
                                for target_index in 0..<target_elements.count |flow, operator, assigned_value_may_be_owned_view, assigned_value_may_alias_reference, assigned_value_may_direct_alias_reference, assigned_value_may_contain_alias_reference, assigned_value_may_yield_alias_reference, assigned_value_yield_alias_reference_known, assigned_value_may_be_scalar_sview, assigned_value_may_yield_scalar_sview, parallel_shape, parallel_owned_views, parallel_alias_refs, parallel_direct_alias_refs, parallel_contained_alias_refs, parallel_yield_alias_refs, parallel_yield_alias_knowns, parallel_scalar_sviews, parallel_yield_scalar_sviews, target_elements|:
                                    if target_elements[target_index] is Expr.Ident(target_name, _):
                                        target_flow_index: mutable usize = chv_flow_latest(flow, target_name)
                                        previous_target_may_be_owned_view: bool = target_flow_index < flow.names.count and flow.may_owned_view[target_flow_index]
                                        previous_target_may_alias_reference: bool = target_flow_index < flow.names.count and flow.may_alias_reference[target_flow_index]
                                        previous_target_may_direct_alias_reference: bool = target_flow_index < flow.names.count and flow.may_direct_alias_reference[target_flow_index]
                                        previous_target_may_contain_alias_reference: bool = target_flow_index < flow.names.count and flow.may_contain_alias_reference[target_flow_index]
                                        previous_target_may_be_scalar_sview: bool = target_flow_index < flow.names.count and flow.may_be_scalar_sview[target_flow_index]
                                        element_may_be_owned_view: bool = parallel_owned_views[target_index] if parallel_shape else assigned_value_may_be_owned_view
                                        element_may_alias_reference: bool = parallel_alias_refs[target_index] if parallel_shape else assigned_value_may_alias_reference
                                        element_may_direct_alias_reference: bool = parallel_direct_alias_refs[target_index] if parallel_shape else assigned_value_may_direct_alias_reference
                                        element_may_contain_alias_reference: bool = parallel_contained_alias_refs[target_index] if parallel_shape else assigned_value_may_contain_alias_reference
                                        element_may_yield_alias_reference: bool = parallel_yield_alias_refs[target_index] if parallel_shape else assigned_value_may_yield_alias_reference
                                        element_yield_alias_known: bool = parallel_yield_alias_knowns[target_index] if parallel_shape else assigned_value_yield_alias_reference_known
                                        element_may_be_scalar_sview: bool = parallel_scalar_sviews[target_index] if parallel_shape else assigned_value_may_be_scalar_sview
                                        element_may_yield_scalar_sview: bool = parallel_yield_scalar_sviews[target_index] if parallel_shape else assigned_value_may_yield_scalar_sview
                                        target_alias: bool = element_may_be_owned_view or (operator != TokenKind.Assign and previous_target_may_be_owned_view)
                                        target_alias_ref: bool = element_may_alias_reference or (operator != TokenKind.Assign and previous_target_may_alias_reference)
                                        target_direct_alias_ref: bool = element_may_direct_alias_reference or (operator != TokenKind.Assign and previous_target_may_direct_alias_reference)
                                        target_is_rebind_claim: bool = operator == TokenKind.Assign and chv_flow_has_lmut_rebind_claim(flow, target_name, assign_pos.line)
                                        if operator == TokenKind.Assign and not target_is_rebind_claim:
                                            chv_flow_bind(flow, target_name, false, target_alias, target_alias_ref)
                                            target_flow_index <- chv_flow_latest(flow, target_name)
                                            flow.may_direct_alias_reference[target_flow_index] <- element_may_direct_alias_reference if target_flow_index < flow.names.count
                                            flow.may_contain_alias_reference[target_flow_index] <- element_may_contain_alias_reference if target_flow_index < flow.names.count
                                            flow.may_yield_alias_reference[target_flow_index] <- element_may_yield_alias_reference if target_flow_index < flow.names.count
                                            flow.may_yield_alias_reference_known[target_flow_index] <- element_yield_alias_known if target_flow_index < flow.names.count
                                            flow.may_be_scalar_sview[target_flow_index] <- element_may_be_scalar_sview if target_flow_index < flow.names.count
                                            flow.may_yield_scalar_sview[target_flow_index] <- element_may_yield_scalar_sview if target_flow_index < flow.names.count
                                            flow.shape_unknown[target_flow_index] <- true if target_flow_index < flow.names.count
                                        elif target_flow_index < flow.names.count:
                                            flow.may_owned_view[target_flow_index] <- target_alias
                                            flow.may_alias_reference[target_flow_index] <- target_alias_ref
                                            flow.may_direct_alias_reference[target_flow_index] <- target_direct_alias_ref
                                            flow.may_contain_alias_reference[target_flow_index] <- element_may_contain_alias_reference if operator == TokenKind.Assign else element_may_contain_alias_reference or previous_target_may_contain_alias_reference
                                            flow.may_yield_alias_reference[target_flow_index] <- element_may_yield_alias_reference if operator == TokenKind.Assign else flow.may_yield_alias_reference[target_flow_index] or element_may_yield_alias_reference
                                            flow.may_yield_alias_reference_known[target_flow_index] <- element_yield_alias_known if operator == TokenKind.Assign else flow.may_yield_alias_reference_known[target_flow_index] and element_yield_alias_known
                                            flow.may_be_scalar_sview[target_flow_index] <- element_may_be_scalar_sview
                                            flow.may_yield_scalar_sview[target_flow_index] <- element_may_yield_scalar_sview
                                            flow.shape_unknown[target_flow_index] <- true
                                        else:
                                            chv_flow_bind(flow, target_name, false, target_alias, target_alias_ref)
                                            target_flow_index <- chv_flow_latest(flow, target_name)
                                            flow.may_direct_alias_reference[target_flow_index] <- element_may_direct_alias_reference if target_flow_index < flow.names.count
                                            flow.may_contain_alias_reference[target_flow_index] <- element_may_contain_alias_reference if target_flow_index < flow.names.count
                                            flow.may_yield_alias_reference[target_flow_index] <- element_may_yield_alias_reference if target_flow_index < flow.names.count
                                            flow.may_yield_alias_reference_known[target_flow_index] <- element_yield_alias_known if target_flow_index < flow.names.count
                                            flow.may_be_scalar_sview[target_flow_index] <- element_may_be_scalar_sview if target_flow_index < flow.names.count
                                            flow.may_yield_scalar_sview[target_flow_index] <- element_may_yield_scalar_sview if target_flow_index < flow.names.count
                                            flow.shape_unknown[target_flow_index] <- true if target_flow_index < flow.names.count
                        Stmt.Return(value, _):
                            table <- chv_walk_expression(return_value, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table) if value is return_value
                        Stmt.If(condition, then_body, else_body, _):
                            table <- chv_walk_expression(condition, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            branch_mark: usize = flow.names.count
                            then_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                            else_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                            chv_flow_bind_truthy_condition_binders(condition, ref_params, &then_flow, table)
                            table <- chv_walk_statements(then_body, in_region, ref_params, binders, owned, view_names, view_values, &then_flow, summary, table)
                            table <- chv_walk_statements(else_body, in_region, ref_params, binders, owned, view_names, view_values, &else_flow, summary, table)
                            chv_flow_set_merge(flow, &then_flow, &else_flow, branch_mark)
                        Stmt.While(condition, loop_body, _):
                            table <- chv_walk_expression(condition, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            branch_mark: usize = flow.names.count
                            loop_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                            chv_flow_bind_truthy_condition_binders(condition, ref_params, &loop_flow, table)
                            table <- chv_walk_statements(loop_body, in_region, ref_params, binders, owned, view_names, view_values, &loop_flow, summary, table)
                            chv_flow_merge(flow, &loop_flow, branch_mark)
                        Stmt.For(bind, loop_variables, iterable, loop_body, _):
                            table <- chv_walk_expression(iterable, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            # View provenance follows possible yielded views. Only mutable
                            # loop binding exposes writable iterable slots. Copied loop
                            # values still inherit facts from explicit aggregate elements.
                            iterable_may_be_owned_view: bool = chv_iterable_element_may_be_owned_view(iterable, flow, view_names, view_values, flow.last_value_may_be_owned_view, 0)
                            iterable_may_alias_reference: bool = chv_expression_may_alias_ref(iterable, ref_params, flow, table, 0)
                            iterable_may_direct_alias_reference: bool = chv_expression_may_direct_alias_ref(iterable, ref_params, flow, table, 0)
                            loop_element_may_alias_reference: bool = chv_iterable_element_may_alias_reference(iterable, ref_params, flow, table, 0)
                            loop_element_may_contain_alias_reference: bool = chv_iterable_element_may_contain_alias_ref(iterable, ref_params, flow, table, 0)
                            loop_element_is_scalar_sview: bool = chv_iterable_element_is_scalar_sview(iterable, flow, view_names, view_values, 0)
                            loop_element_yields_scalar_sview: bool = chv_iterable_element_yields_scalar_sview(iterable, flow, view_names, view_values, 0)
                            loop_variable_may_alias_reference: bool = loop_element_may_alias_reference or (bind == "mutable" and iterable_may_alias_reference)
                            branch_mark: usize = flow.names.count
                            loop_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                            for loop_variable_index in 0..<loop_variables.count |loop_flow, loop_variables|:
                                element_facts: (known: bool, may_owned_view: bool, may_alias_reference: bool, may_contain_alias_reference: bool, may_be_scalar_sview: bool, may_yield_scalar_sview: bool) = chv_iterable_binding_facts(iterable, loop_variable_index, loop_variables.count > 1, ref_params, flow, table, view_names, view_values)
                                loop_variable: sview = loop_variables[loop_variable_index]
                                loop_variable_may_be_owned_view: bool = element_facts.may_owned_view if element_facts.known else iterable_may_be_owned_view
                                loop_variable_may_alias_reference: mutable bool = element_facts.may_alias_reference if element_facts.known else loop_element_may_alias_reference
                                loop_variable_may_alias_reference <- loop_variable_may_alias_reference or (bind == "mutable" and iterable_may_alias_reference)
                                loop_variable_may_direct_alias_reference: mutable bool = element_facts.may_alias_reference if element_facts.known else loop_element_may_alias_reference
                                loop_variable_may_direct_alias_reference <- loop_variable_may_direct_alias_reference or (bind == "mutable" and iterable_may_direct_alias_reference)
                                loop_variable_may_contain_alias_reference: bool = element_facts.may_contain_alias_reference if element_facts.known else loop_element_may_contain_alias_reference
                                loop_variable_is_scalar_sview: bool = element_facts.may_be_scalar_sview if element_facts.known else loop_element_is_scalar_sview
                                loop_variable_yields_scalar_sview: bool = element_facts.may_yield_scalar_sview if element_facts.known else loop_element_yields_scalar_sview
                                chv_flow_bind(&loop_flow, loop_variable, false, loop_variable_may_be_owned_view, loop_variable_may_alias_reference)
                                chv_flow_set_iterable_element_type(&loop_flow, loop_variable, iterable)
                                loop_index: usize = chv_flow_latest(loop_flow, loop_variable)
                                loop_flow.may_direct_alias_reference[loop_index] <- loop_variable_may_direct_alias_reference if loop_index < loop_flow.names.count
                                loop_flow.may_contain_alias_reference[loop_index] <- loop_variable_may_contain_alias_reference if loop_index < loop_flow.names.count
                                loop_flow.may_be_scalar_sview[loop_index] <- loop_variable_is_scalar_sview if loop_index < loop_flow.names.count
                                loop_flow.may_yield_scalar_sview[loop_index] <- loop_variable_yields_scalar_sview if loop_index < loop_flow.names.count
                            table <- chv_walk_statements(loop_body, in_region, ref_params, binders, owned, view_names, view_values, &loop_flow, summary, table)
                            chv_flow_merge(flow, &loop_flow, branch_mark)
                        Stmt.Block(kind, _, binding, block_body, _):
                            block_mark: usize = flow.names.count
                            chv_flow_bind(flow, binding, false, false, false) if binding != ""
                            table <- chv_walk_statements(block_body, in_region or kind == "region" or kind == "in", ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            chv_flow_truncate(flow, block_mark)
                        Stmt.Match(scrutinee, arms, _):
                            table <- chv_walk_expression(scrutinee, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                            scrutinee_may_be_owned_view: bool = flow.last_value_may_be_owned_view
                            scrutinee_may_direct_alias_reference: bool = chv_expression_may_direct_alias_ref(scrutinee, ref_params, flow, table, 0)
                            scrutinee_may_contain_alias_reference: bool = chv_expression_may_contain_alias_ref(scrutinee, ref_params, flow, table, 0)
                            branch_mark: usize = flow.names.count
                            entry_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                            merged_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                            merged_ready: mutable bool = false
                            for arm in arms |table| -> table:
                                arm_flow: mutable CHVViewFlow = chv_flow_clone(entry_flow)
                                chv_flow_bind_pattern(arm.pattern, true, scrutinee_may_be_owned_view, scrutinee_may_direct_alias_reference, scrutinee_may_contain_alias_reference, arm_flow)
                                table <- chv_walk_expression(arm.guard, in_region, ref_params, binders, owned, view_names, view_values, &arm_flow, summary, table)
                                table <- chv_walk_statements(arm.body, in_region, ref_params, binders, owned, view_names, view_values, &arm_flow, summary, table)
                                if not merged_ready:
                                    chv_flow_set_merge(&merged_flow, &arm_flow, &arm_flow, branch_mark)
                                    merged_ready <- true
                                else:
                                    chv_flow_merge(&merged_flow, &arm_flow, branch_mark)
                            chv_flow_set_merge(flow, &merged_flow, &merged_flow, branch_mark) if merged_ready
                        Stmt.Contract(_, expression, _):
                            table <- chv_walk_expression(expression, in_region, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                        Stmt.Break(_, _):
                            pass
                        Stmt.Continue(_, _):
                            pass

        def chv_walk_declarations_with_reference_holders(declarations: darray[Ast::Decl], summary: StoreThroughSummary&, rebind_claims: darray[Ast::EnumAnnotation]&, reference_holders: darray[sview]&, type_alias_names: darray[sview]&, type_alias_targets: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(params: parameters, body: body, _):
                            ref_params: mutable darray[sview] = []
                            binders: mutable darray[sview] = []
                            flow: mutable CHVViewFlow = CHVViewFlow{}
                            flow.rebind_claims.extend(rebind_claims)
                            flow.reference_holders.extend(reference_holders)
                            flow.type_alias_names.extend(type_alias_names)
                            flow.type_alias_targets.extend(type_alias_targets)
                            should_walk_body: mutable bool = false
                            for parameter in parameters |ref_params, binders|:
                                binders.push(parameter.name)
                                parameter_has_reference_marker: bool = type_marker_present_here(parameter.type_expression, TokenKind.Ampersand)
                                parameter_direct_alias_reference: bool = chv_type_is_direct_alias_reference(parameter.type_expression, flow.type_alias_names, flow.type_alias_targets, 0)
                                ref_params.push(parameter.name) if parameter_has_reference_marker or parameter_direct_alias_reference
                                parameter_owned: bool = chv_type_is_owned_container(parameter.type_expression) and not parameter_has_reference_marker
                                parameter_may_alias_reference: bool = parameter_has_reference_marker or parameter_direct_alias_reference
                                chv_flow_bind(flow, parameter.name, parameter_owned, false, parameter_may_alias_reference)
                                parameter_index: usize = chv_flow_latest(flow, parameter.name)
                                flow.may_direct_alias_reference[parameter_index] <- parameter_direct_alias_reference if parameter_index < flow.names.count
                                parameter_yield_facts: (known: bool, may_yield: bool) = chv_type_iterable_yields_alias_reference(parameter.type_expression, flow.type_alias_names, flow.type_alias_targets, 0)
                                flow.may_yield_alias_reference[parameter_index] <- parameter_yield_facts.may_yield if parameter_index < flow.names.count
                                flow.may_yield_alias_reference_known[parameter_index] <- parameter_yield_facts.known if parameter_index < flow.names.count
                                flow.binding_types[parameter_index] <- parameter.type_expression if parameter_index < flow.names.count and not (parameter.type_expression is Expr.Absent)
                                flow.binding_type_known[parameter_index] <- not (parameter.type_expression is Expr.Absent) if parameter_index < flow.names.count
                                flow.may_be_scalar_sview[parameter_index] <- chv_type_is_scalar_sview(parameter.type_expression) if parameter_index < flow.names.count
                                parameter_may_contain_alias_reference: bool = chv_type_may_contain_alias_reference_with_holders(parameter.type_expression, flow.reference_holders, 0)
                                flow.may_contain_alias_reference[parameter_index] <- parameter_may_contain_alias_reference if parameter_index < flow.names.count
                                flow.may_yield_scalar_sview[parameter_index] <- chv_type_iterable_yields_scalar_sview(parameter.type_expression, 0) if parameter_index < flow.names.count
                                flow.may_be_byte_sequence[parameter_index] <- chv_type_is_byte_sequence(parameter.type_expression) if parameter_index < flow.names.count
                                should_walk_body <- should_walk_body or parameter_has_reference_marker or parameter_direct_alias_reference or parameter_may_contain_alias_reference or parameter_yield_facts.may_yield
                            if should_walk_body or chv_statements_contain_lambda(body):
                                owned: mutable darray[sview] = []
                                view_names: mutable darray[sview] = []
                                view_values: mutable darray[Ast::Expr] = []
                                chv_scan_locals(body, false, binders, owned, view_names, view_values)
                                chv_flow_add_shape_shadows(flow, view_names)
                                table <- chv_walk_statements(body, false, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                        Decl.Module(_, module_body, _):
                            table <- chv_walk_declarations_with_reference_holders(module_body, summary, rebind_claims, reference_holders, type_alias_names, type_alias_targets, table)
                        Decl.Scoped(scoped_body, _):
                            table <- chv_walk_declarations_with_reference_holders(scoped_body, summary, rebind_claims, reference_holders, type_alias_names, type_alias_targets, table)
                        _:
                            pass

        def chv_walk_declarations(declarations: darray[Ast::Decl], summary: StoreThroughSummary&, rebind_claims: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                reference_holders: darray[sview] = chv_reference_holders(declarations)
                # Flows are cloned at every branch and only read `__lmut_rebind_claim` rows,
                # so hand them just those instead of every annotation in the file.
                lmut_claims: mutable darray[Ast::EnumAnnotation] = []
                for claim in rebind_claims |lmut_claims|:
                    lmut_claims.push(claim) if claim.owner == "__lmut_rebind_claim"
                type_alias_names: mutable darray[sview] = []
                type_alias_targets: mutable darray[Ast::Expr] = []
                chv_collect_type_aliases(declarations, type_alias_names, type_alias_targets)
                table <- chv_walk_declarations_with_reference_holders(declarations, summary, lmut_claims, reference_holders, type_alias_names, type_alias_targets, table)

    public:
        def check_call_holder_view_store(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                holders: darray[sview] = chv_view_holders(file.top_decls)
                return if holders.count == 0
                reference_sites: mutable BorrowReferenceSites = empty_borrow_reference_sites()
                summary: StoreThroughSummary = chv_build_summary(file.top_decls, holders, reference_sites, table) can Global{Read,Write}
                table <- chv_walk_declarations(file.top_decls, summary, file.enum_annotations, table)
