extend Semantic:
    private:
        const CHV_SCALAR_TYPE_BITS: u64 = 32767

        def chv_scalar_type_bit(name: sview) -> u64:
            can Abort.Panic:
                return when name:
                    "i8" -> 1
                    "i16" -> 2
                    "i32" -> 4
                    "i64" -> 8
                    "int" -> 16
                    "isize" -> 32
                    "u8" -> 64
                    "u16" -> 128
                    "u32" -> 256
                    "u64" -> 512
                    "usize" -> 1024
                    "f32" -> 2048
                    "f64" -> 4096
                    "bool" -> 8192
                    "char" -> 16384
                    _ -> 0

        # Only seeded builtins with no source declaration/import/generic of the same
        # spelling authorize scalar classification. Ambiguity anywhere in the unit
        # declines this precision; a bare spelling alone is never type identity.
        def chv_unshadowed_scalar_types(table: SymbolTable&) -> u64:
            can Abort.Panic:
                available: mutable u64 = 0
                unshadowed: mutable u64 = CHV_SCALAR_TYPE_BITS
                for symbol in table.symbols |available, unshadowed|:
                    bit: u64 = chv_scalar_type_bit(symbol.name)
                    if symbol.kind == SymbolKind.Unknown and symbol.line == 0 and symbol.offset == 0 and symbol.module_owner == "":
                        available <- available | bit
                    else:
                        unshadowed <- unshadowed & (CHV_SCALAR_TYPE_BITS ^ bit)
                for name in table.generic_param_names |unshadowed|:
                    unshadowed <- unshadowed & (CHV_SCALAR_TYPE_BITS ^ chv_scalar_type_bit(name))
                return available & unshadowed

        def chv_type_is_known_scalar(type_expression: Ast::Expr, flow: CHVViewFlow&, depth: u32) -> bool:
            can Abort.Panic:
                return false if depth > 64
                match type_expression:
                    Expr.Ident(name, _):
                        return (flow.scalar_type_mask & chv_scalar_type_bit(name)) != 0
                    Expr.Paren(inner, _):
                        return chv_type_is_known_scalar(inner, flow, depth + 1)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable:
                        return chv_type_is_known_scalar(inner, flow, depth + 1)
                    _:
                        # References, aliases, and nominal/scoped types remain conservative.
                        return false

        def chv_is_known_scalar(expression: Ast::Expr, flow: CHVViewFlow&, depth: u32) -> bool:
            can Abort.Panic:
                return false if depth > 64
                match expression:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _):
                        return true
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_is_known_scalar(inner, flow, depth + 1)
                    Expr.Ident(name, _):
                        row: usize = chv_flow_latest(flow, name)
                        if row < flow.names.count and row < flow.binding_types.count and flow.binding_type_known[row]:
                            if flow.binding_types[row] is type_expression:
                                return chv_type_is_known_scalar(type_expression, flow, depth + 1)
                        return false
                    Expr.Call(Expr.Field(receiver, method, _), arguments, _, _):
                        return arguments.count == 0 and (flow.scalar_type_mask & chv_scalar_type_bit(method)) != 0 and chv_is_known_scalar(receiver, flow, depth + 1)
                    Expr.Call(Expr.Ident(name, _), arguments, _, _):
                        return arguments.count == 1 and (flow.scalar_type_mask & chv_scalar_type_bit(name)) != 0 and chv_is_known_scalar(arguments[0], flow, depth + 1)
                    Expr.Unary(operator, operand, _):
                        return true if operator == TokenKind.Not
                        return (operator == TokenKind.Minus or operator == TokenKind.Plus) and chv_is_known_scalar(operand, flow, depth + 1)
                    Expr.Binary(left, operator, right, _):
                        return true if operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq or operator == TokenKind.In or operator == TokenKind.Is or operator == TokenKind.And or operator == TokenKind.Or
                        arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
                        return arithmetic and chv_is_known_scalar(left, flow, depth + 1) and chv_is_known_scalar(right, flow, depth + 1)
                    Expr.If(_, then_value, else_value, _):
                        return chv_is_known_scalar(then_value, flow, depth + 1) and chv_is_known_scalar(else_value, flow, depth + 1)
                    _:
                        return false
