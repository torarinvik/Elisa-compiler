extend Semantic:
    private:
        const CHV_SCALAR_TYPE_BITS: u64 = 32767
        const CHV_DARRAY_TYPE_BIT: u64 = 32768
        const CHV_KNOWN_TYPE_BITS: u64 = CHV_SCALAR_TYPE_BITS | CHV_DARRAY_TYPE_BIT

        def chv_scalar_type_bit(name: sview) -> u64:
            can Abort.Panic:
                return when name:
                    "i8" -> 1
                    "i16" -> 2
                    "i32" -> 4
                    "i64" -> 8
                    "int" -> 16
                    "isize" -> 32
                    "u8" -> 64
                    "u16" -> 128
                    "u32" -> 256
                    "u64" -> 512
                    "usize" -> 1024
                    "f32" -> 2048
                    "f64" -> 4096
                    "bool" -> 8192
                    "char" -> 16384
                    _ -> 0

        def chv_known_type_bit(name: sview) -> u64:
            can Abort.Panic:
                return CHV_DARRAY_TYPE_BIT if name == "darray" else chv_scalar_type_bit(name)

        def chv_type_is_builtin_darray(type_expression: Ast::Expr, mask: u64, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return false if depth > 64 or (mask & CHV_DARRAY_TYPE_BIT) == 0
                match type_expression:
                    Expr.Index(Expr.Ident(name, _), _, _):
                        return name == "darray"
                    Expr.Paren(inner, _):
                        return chv_type_is_builtin_darray(inner, mask, depth + 1)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut:
                        return chv_type_is_builtin_darray(inner, mask, depth + 1)
                    _:
                        return false

        # Only seeded builtins with no source declaration/import/generic of the same
        # spelling authorize scalar classification. Ambiguity anywhere in the unit
        # declines this precision; a bare spelling alone is never type identity.
        def chv_unshadowed_scalar_types(table: SymbolTable&) -> u64:
            can Abort.Panic:
                available: mutable u64 = 0
                unshadowed: mutable u64 = CHV_KNOWN_TYPE_BITS
                for symbol in table.symbols |available, unshadowed|:
                    bit: u64 = chv_known_type_bit(symbol.name)
                    builtin_kind: bool = (symbol.kind == SymbolKind.Struct and symbol.name == "darray") or (symbol.kind == SymbolKind.Unknown and symbol.name != "darray")
                    if builtin_kind and symbol.line == 0 and symbol.offset == 0 and symbol.module_owner == "":
                        available <- available | bit
                    else:
                        unshadowed <- unshadowed & (CHV_KNOWN_TYPE_BITS ^ bit)
                for name in table.generic_param_names |unshadowed|:
                    unshadowed <- unshadowed & (CHV_KNOWN_TYPE_BITS ^ chv_known_type_bit(name))
                return available & unshadowed

        def chv_scalar_mask_without_import_aliases(mask: u64, annotations: darray[Ast::EnumAnnotation]&) -> u64:
            can Abort.Panic:
                available: mutable u64 = mask
                for annotation in annotations |available|:
                    return 0 if semantic_is_synthetic_unknown_import_marker(annotation)
                    if annotation.name == "__using_alias":
                        available <- available & (CHV_KNOWN_TYPE_BITS ^ chv_known_type_bit(annotation.owner))
                return available

        def chv_function_returns_scalar(name: sview, scalar_type_mask: u64, table: SymbolTable&) -> bool:
            can Abort.Panic:
                indexed: bool = table.symbol_name_next.count == table.symbols.count
                row: mutable usize = symbol_chain_head(table, name).usize() if indexed else 0
                found: mutable bool = false
                while row < table.symbols.count |row, found, table, name, scalar_type_mask, indexed|:
                    symbol: Symbol = table.symbols[row]
                    if symbol.name == name:
                        return false if symbol.kind != SymbolKind.Func or (scalar_type_mask & chv_scalar_type_bit(symbol.return_type)) == 0
                        found <- true
                    row <- table.symbol_name_next[row].usize() if indexed else row + 1.usize()
                return found

        def chv_scalar_functions(scalar_type_mask: u64, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                aliases: mutable darray[sview] = []
                for annotation in annotations |aliases|:
                    return names if semantic_is_synthetic_unknown_import_marker(annotation)
                    aliases.push(annotation.owner) if annotation.name == "__using_alias"
                for annotation in table.possible_import_annotations |aliases|:
                    return names if semantic_is_synthetic_unknown_import_marker(annotation)
                    aliases.push(annotation.owner) if annotation.name == "__using_alias"
                for symbol in table.symbols |names|:
                    continue if symbol.kind != SymbolKind.Func or (scalar_type_mask & chv_scalar_type_bit(symbol.return_type)) == 0
                    continue if any alias in aliases where alias == symbol.name
                    continue if any name in names where name == symbol.name
                    names.push(symbol.name) if chv_function_returns_scalar(symbol.name, scalar_type_mask, table)
                return names

        def chv_scalar_call_lookup(names: darray[sview]&) -> dict[u64, usize]:
            can Memory.Allocate, Abort.Panic:
                lookup: mutable dict[u64, usize] = {}
                for row in 0..<names.count |lookup, names|:
                    hash: u64 = name_hash(names[row])
                    if lookup.get(hash) is previous:
                        lookup <- lookup.put(hash, names.count) can Global{Read,Write}
                    else:
                        lookup <- lookup.put(hash, row) can Global{Read,Write}
                return lookup

        def chv_unique_scalar_field_owner(owner: sview, table: SymbolTable&) -> (known: bool, module: sview):
            can Abort.Panic:
                return (false, "") if any generic_name in table.generic_param_names where generic_name == owner
                indexed: bool = table.symbol_name_next.count == table.symbols.count
                row: mutable usize = symbol_chain_head(table, owner).usize() if indexed else 0
                found: mutable bool = false
                owner_module: mutable sview = ""
                while row < table.symbols.count |row, found, owner_module, table, owner, indexed|:
                    symbol: Symbol = table.symbols[row]
                    if symbol.name == owner and symbol.kind != SymbolKind.Module:
                        return (false, "") if found or symbol.kind != SymbolKind.Struct or symbol.line == 0
                        found <- true
                        owner_module <- symbol.module_owner
                    row <- table.symbol_name_next[row].usize() if indexed else row + 1.usize()
                return (found, owner_module)

        def chv_scalar_fields(mask: u64, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&) -> CHVScalarFields:
            can Memory.Allocate, Abort.Panic:
                count: usize = table.struct_field_owner.count
                return CHVScalarFields{} if count != table.struct_field_name.count or count != table.struct_field_type.count or count != table.struct_field_module.count
                aliases: mutable darray[sview] = []
                for annotation in annotations |aliases|:
                    return CHVScalarFields{} if semantic_is_synthetic_unknown_import_marker(annotation)
                    aliases.push(annotation.owner) if annotation.name == "__using_alias"
                for annotation in table.possible_import_annotations |aliases|:
                    return CHVScalarFields{} if semantic_is_synthetic_unknown_import_marker(annotation)
                    aliases.push(annotation.owner) if annotation.name == "__using_alias"
                owners: mutable darray[sview] = []
                names: mutable darray[sview] = []
                lookup: mutable dict[u64, usize] = {}
                for row in 0..<count |owners, names, lookup, table, mask, aliases|:
                    continue if (mask & chv_scalar_type_bit(table.struct_field_type[row])) == 0
                    owner: sview = table.struct_field_owner[row]
                    continue if any alias in aliases where alias == owner
                    identity = chv_unique_scalar_field_owner(owner, table)
                    continue if not identity.known or identity.module != table.struct_field_module[row]
                    field: sview = table.struct_field_name[row]
                    hash: u64 = struct_field_pair_hash(owner, field)
                    if lookup.get(hash) is previous:
                        lookup <- lookup.put(hash, count) can Global{Read,Write}
                    else:
                        lookup <- lookup.put(hash, names.count) can Global{Read,Write}
                    owners.push(owner)
                    names.push(field)
                return CHVScalarFields{owners: owners, names: names, lookup: lookup}

        def chv_field_is_known_scalar(receiver: Ast::Expr, field: sview, flow: CHVViewFlow&) -> bool:
            can Abort.Panic:
                match receiver:
                    Expr.Ident(name, _):
                        row: usize = chv_flow_latest(flow, name)
                        return false if row >= flow.names.count or row >= flow.binding_types.count or not flow.binding_type_known[row]
                        if flow.binding_types[row] is type_expression:
                            return true if field == "count" and chv_type_is_builtin_darray(type_expression, flow.scalar_type_mask)
                            owner: sview = chv_plain_nominal_type(type_expression, 0)
                            return false if owner == ""
                            fields: CHVScalarFields = flow.scalar_calls.fields
                            if fields.lookup.get(struct_field_pair_hash(owner, field)) is slot:
                                if slot < fields.names.count and slot < fields.owners.count:
                                    return fields.owners[slot] == owner and fields.names[slot] == field
                                for index in 0..<fields.names.count |fields, owner, field|:
                                    return true if index < fields.owners.count and fields.owners[index] == owner and fields.names[index] == field
                        return false
                    _:
                        return false

        def chv_type_is_known_scalar(type_expression: Ast::Expr, flow: CHVViewFlow&, depth: u32) -> bool:
            can Abort.Panic:
                return false if depth > 64
                match type_expression:
                    Expr.Ident(name, _):
                        return (flow.scalar_type_mask & chv_scalar_type_bit(name)) != 0
                    Expr.Paren(inner, _):
                        return chv_type_is_known_scalar(inner, flow, depth + 1)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable:
                        return chv_type_is_known_scalar(inner, flow, depth + 1)
                    _:
                        # References, aliases, and nominal/scoped types remain conservative.
                        return false

        def chv_is_known_scalar(expression: Ast::Expr, flow: CHVViewFlow&, depth: u32) -> bool:
            can Abort.Panic:
                return false if depth > 64
                match expression:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _):
                        return true
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_is_known_scalar(inner, flow, depth + 1)
                    Expr.Ident(name, _):
                        row: usize = chv_flow_latest(flow, name)
                        if row < flow.names.count and row < flow.binding_types.count and flow.binding_type_known[row]:
                            if flow.binding_types[row] is type_expression:
                                return chv_type_is_known_scalar(type_expression, flow, depth + 1)
                        return false
                    Expr.Field(receiver, field, _):
                        return chv_field_is_known_scalar(receiver, field, flow)
                    Expr.Call(Expr.Field(receiver, method, _), arguments, _, _):
                        return arguments.count == 0 and (flow.scalar_type_mask & chv_scalar_type_bit(method)) != 0 and chv_is_known_scalar(receiver, flow, depth + 1)
                    Expr.Call(Expr.Ident(name, _), arguments, _, _):
                        return false if chv_flow_latest(flow, name) < flow.names.count
                        return false if any shadow in flow.scalar_calls.shadow_names where shadow == name
                        if arguments.count == 1 and (flow.scalar_type_mask & chv_scalar_type_bit(name)) != 0 and chv_is_known_scalar(arguments[0], flow, depth + 1):
                            return true
                        if flow.scalar_calls.lookup.get(name_hash(name)) is row:
                            return flow.scalar_calls.names[row] == name if row < flow.scalar_calls.names.count
                            # Hash collisions retain exact spelling checks.
                            return any known_name in flow.scalar_calls.names where known_name == name
                        return false if flow.scalar_calls.lookup.count > 0
                        return any known_name in flow.scalar_calls.names where known_name == name
                    Expr.Unary(operator, operand, _):
                        return true if operator == TokenKind.Not
                        return (operator == TokenKind.Minus or operator == TokenKind.Plus) and chv_is_known_scalar(operand, flow, depth + 1)
                    Expr.Binary(left, operator, right, _):
                        return true if operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq or operator == TokenKind.In or operator == TokenKind.Is or operator == TokenKind.And or operator == TokenKind.Or
                        arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
                        return arithmetic and chv_is_known_scalar(left, flow, depth + 1) and chv_is_known_scalar(right, flow, depth + 1)
                    Expr.If(_, then_value, else_value, _):
                        return chv_is_known_scalar(then_value, flow, depth + 1) and chv_is_known_scalar(else_value, flow, depth + 1)
                    _:
                        return false
