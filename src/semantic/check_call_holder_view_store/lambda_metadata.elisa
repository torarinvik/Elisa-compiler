extend Semantic:
    private:
        # Build ordered position chains once; all branch flows share them read-only.
        def chv_lambda_metadata(annotations: darray[Ast::EnumAnnotation]&, declarations: darray[Ast::Decl]&, table: SymbolTable&) -> CHVLambdaMetadata:
            can Memory.Allocate, Abort.Panic:
                rows: mutable darray[Ast::EnumAnnotation] = []
                links: mutable darray[usize] = []
                heads: mutable dict[u64, usize] = {}
                for annotation in annotations |rows, links|:
                    if annotation.owner == "__lambda_param":
                        rows.push(annotation)
                        links.push(0)
                index: mutable usize = rows.count
                while index > 0 |index, rows, links, heads|:
                    index <- index - 1
                    annotation: Ast::EnumAnnotation = rows[index]
                    key: u64 = (annotation.line.u64() << 32) | annotation.offset.u64()
                    if heads.get(key) is lambda_chain_head:
                        links[index] <- lambda_chain_head
                    heads <- heads.put(key, index + 1) can Global{Read,Write}
                functions: mutable darray[Ast::Decl] = []
                sts_collect_functions(declarations, functions)
                function_heads: mutable dict[u64, usize] = {}
                for function_index in 0..<functions.count |function_heads, functions|:
                    if functions[function_index] is Ast::Decl.Func(name: function_name, _):
                        hash: u64 = name_hash(function_name)
                        if function_heads.get(hash) is prior:
                            function_heads <- function_heads.put(hash, functions.count + 1) can Global{Read,Write}
                        else:
                            function_heads <- function_heads.put(hash, function_index) can Global{Read,Write}
                # Import resolution may introduce another callable with the same
                # spelling, including through an unresolved conditional import.
                contextual_calls_allowed: mutable bool = true
                for annotation in table.definite_import_annotations |contextual_calls_allowed|:
                    contextual_calls_allowed <- false if annotation.name == "__using" or annotation.name == "__using_alias" or annotation.owner == "__from_member"
                for annotation in table.possible_import_annotations |contextual_calls_allowed|:
                    contextual_calls_allowed <- false if semantic_is_synthetic_unknown_import_marker(annotation) or annotation.name == "__using" or annotation.name == "__using_alias" or annotation.owner == "__from_member"
                return CHVLambdaMetadata{rows: rows, next: links, heads: heads, functions: functions, function_heads: function_heads, contextual_calls_allowed: contextual_calls_allowed}

        def chv_lambda_type_heads(lambda_index_state: CHVLambdaMetadata&, position: Ast::Pos) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                heads: mutable darray[sview] = []
                key: u64 = (position.line.u64() << 32) | position.offset.u64()
                cursor: mutable usize = 0
                cursor <- found if lambda_index_state.heads.get(key) is found
                while cursor > 0 |cursor, heads|:
                    row: usize = cursor - 1
                    break if row >= lambda_index_state.rows.count or row >= lambda_index_state.next.count
                    heads.push(lambda_index_state.rows[row].name)
                    cursor <- lambda_index_state.next[row]
                return heads

        # Resolve only a unique, unshadowed direct source function. Ambiguity,
        # aliases and unresolved function types retain conservative lambda facts.
        def chv_contextual_lambda_heads(metadata: CHVLambdaMetadata&, call: Ast::Expr?, lambda_position: Ast::Pos, shadow_names: darray[sview]&, table: SymbolTable&) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                empty: darray[sview] = []
                return empty if call is null or not metadata.contextual_calls_allowed
                call_value: Ast::Expr = get call else (Ast::Expr.Invalid)
                if call_value is Ast::Expr.Call(Ast::Expr.Ident(function_name, _), arguments, argument_names, _):
                    return empty if any argument_name in argument_names where argument_name != ""
                    return empty if any shadow_name in shadow_names where shadow_name == function_name
                    found_index: mutable usize = arguments.count
                    matches: mutable usize = 0
                    for argument_index in 0..<arguments.count |found_index, matches|:
                        if arguments[argument_index] is Ast::Expr.Lambda(_, _, argument_pos):
                            if Ast::pos_equal(argument_pos, lambda_position):
                                matches <- matches + 1
                                found_index <- argument_index
                    return empty if matches != 1
                    function_index: mutable usize = metadata.functions.count + 1
                    function_index <- row if metadata.function_heads.get(name_hash(function_name)) is row
                    return empty if function_index >= metadata.functions.count
                    # Imported functions, overloads and shadowing must not make a
                    # spelling-only source declaration appear unique.
                    matching_symbols: mutable usize = 0
                    indexed: bool = table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count
                    row: mutable usize = symbol_chain_head(table, function_name).usize() if indexed else 0
                    while row < table.symbols.count |row, matching_symbols|:
                        symbol: Symbol = table.symbols[row]
                        if symbol.name == function_name:
                            return empty if symbol.kind != SymbolKind.Func
                            matching_symbols <- matching_symbols + 1
                        row <- table.symbol_name_next[row].usize() if indexed else row + 1.usize()
                    return empty if matching_symbols != 1
                    if metadata.functions[function_index] is Ast::Decl.Func(name: declared_name, params: params, _):
                        return empty if declared_name != function_name or found_index >= params.count
                        formal: mutable Ast::Expr = zeroed_strip_binding_modifiers(params[found_index].type_expression)
                        if formal is Ast::Expr.Binary(inner, formal_operator, _, _):
                            return empty if formal_operator != TokenKind.Arrow
                            formal <- zeroed_strip_binding_modifiers(inner)
                        if formal is Ast::Expr.Lambda(_, _, formal_pos):
                            return chv_lambda_type_heads(metadata, formal_pos)
                return empty
