extend Semantic:
    private:
        def chv_type_contains_reference(type_expression: Ast::Expr, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        return true if operator == TokenKind.Ampersand
                        return chv_type_contains_reference(operand, depth + 1)
                    Expr.Paren(inner, _):
                        return chv_type_contains_reference(inner, depth + 1)
                    Expr.Index(head, index, _):
                        return chv_type_contains_reference(head, depth + 1) or chv_type_contains_reference(index, depth + 1)
                    Expr.IndexN(head, indices, _):
                        return chv_type_contains_reference(head, depth + 1) or any index in indices where chv_type_contains_reference(index, depth + 1)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        return any element in elements where chv_type_contains_reference(element, depth + 1)
                    Expr.DictLit(entries, _):
                        return any entry in entries where chv_type_contains_reference(entry.key, depth + 1) or chv_type_contains_reference(entry.value, depth + 1)
                    _:
                        return false

        # Whether an unknown iterable may contain references in its yielded values.
        # A reference to a scalar is not a reference-containing container, while
        # `darray[i64&]` and nested aggregates can yield references.
        def chv_type_may_contain_alias_reference_with_holders(type_expression: Ast::Expr, reference_holders: darray[sview]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                match type_expression:
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _):
                        return chv_type_may_contain_alias_reference_with_holders(operand, reference_holders, depth + 1)
                    Expr.Index(head, element_type, _):
                        return chv_type_contains_reference(element_type, depth + 1) or chv_type_names_holder(element_type, reference_holders) or chv_type_may_contain_alias_reference_with_holders(element_type, reference_holders, depth + 1)
                    Expr.IndexN(head, indices, _):
                        return any index in indices where chv_type_contains_reference(index, depth + 1) or chv_type_names_holder(index, reference_holders) or chv_type_may_contain_alias_reference_with_holders(index, reference_holders, depth + 1)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        return any element in elements where chv_type_contains_reference(element, depth + 1) or chv_type_names_holder(element, reference_holders) or chv_type_may_contain_alias_reference_with_holders(element, reference_holders, depth + 1)
                    Expr.DictLit(entries, _):
                        return any entry in entries where chv_type_contains_reference(entry.key, depth + 1) or chv_type_names_holder(entry.key, reference_holders) or chv_type_may_contain_alias_reference_with_holders(entry.key, reference_holders, depth + 1) or chv_type_contains_reference(entry.value, depth + 1) or chv_type_names_holder(entry.value, reference_holders) or chv_type_may_contain_alias_reference_with_holders(entry.value, reference_holders, depth + 1)
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        return chv_type_names_holder(type_expression, reference_holders)
                    _:
                        return false

        def chv_type_may_contain_alias_reference(type_expression: Ast::Expr, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                empty_reference_holders: mutable darray[sview] = []
                return chv_type_may_contain_alias_reference_with_holders(type_expression, empty_reference_holders, depth)

        def chv_type_alias_target(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, depth: u32) -> (found: bool, target: Ast::Expr):
            can Abort.Panic:
                return (false, type_expression) if depth > 64
                alias_name: mutable sview = ""
                match type_expression:
                    Expr.Ident(name, _):
                        alias_name <- name
                    # The alias inventory is flat and cannot prove that a
                    # qualified reference names this alias's defining module.
                    # Leave scoped names unresolved; callers treat a matching
                    # alias name conservatively instead of borrowing another
                    # module's target.
                    _:
                        return (false, type_expression)
                found_count: mutable usize = 0
                target_expression: mutable Ast::Expr = type_expression
                for index in 0..<alias_names.count |found_count, target_expression, alias_names, alias_targets|:
                    if alias_names[index] == alias_name and index < alias_targets.count:
                        found_count <- found_count + 1
                        target_expression <- alias_targets[index]
                return (found_count == 1, target_expression)

        # Alias lookup currently retains bare names while walking nested modules.
        # If two scopes provide the same name, keep direct-reference classification
        # conservative instead of treating the unresolved qualified alias as clean.
        def chv_type_alias_name_count(type_expression: Ast::Expr, alias_names: darray[sview]&) -> usize:
            can Abort.Panic:
                alias_name: mutable sview = ""
                match type_expression:
                    Expr.Ident(name, _) | Expr.Scope(_, name, _):
                        alias_name <- name
                    _:
                        return 0
                matches: mutable usize = 0
                for name in alias_names |matches|:
                    matches <- matches + 1 if name == alias_name
                return matches

        def chv_type_is_direct_alias_reference(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                # A long or cyclic alias chain is unresolved here. Keep it
                # conservative instead of losing a possible direct reference.
                return true if depth > 64
                match type_expression:
                    Expr.Unary(operator, _, _) if operator == TokenKind.Ampersand:
                        return true
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _):
                        return chv_type_is_direct_alias_reference(operand, alias_names, alias_targets, depth + 1)
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        found, target = chv_type_alias_target(type_expression, alias_names, alias_targets, depth + 1)
                        return chv_type_is_direct_alias_reference(target, alias_names, alias_targets, depth + 1) if found
                        return chv_type_alias_name_count(type_expression, alias_names) > 0
                    _:
                        return false

        # Return the element type when TYPE_EXPRESSION is a collection this pass
        # understands. Keeping this type fact on bindings lets nested iteration
        # distinguish `darray[&T]` from `darray[RefBox]`, even when both are opaque.
        def chv_type_iterable_element(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, depth: u32) -> (known: bool, element_type: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                return (false, type_expression) if depth > 64
                match type_expression:
                    Expr.Paren(inner, _):
                        return chv_type_iterable_element(inner, alias_names, alias_targets, depth + 1)
                    Expr.Unary(_, inner, _):
                        return chv_type_iterable_element(inner, alias_names, alias_targets, depth + 1)
                    Expr.Index(Expr.Ident(head, _), element_type, _) if head == "darray" or head == "array" or head == "set":
                        return (true, element_type)
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        found, target = chv_type_alias_target(type_expression, alias_names, alias_targets, depth + 1)
                        if found:
                            return chv_type_iterable_element(target, alias_names, alias_targets, depth + 1)
                        return (false, type_expression)
                    _:
                        return (false, type_expression)

        def chv_type_iterable_yields_alias_reference(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_targets: darray[Ast::Expr]&, depth: u32) -> (known: bool, may_yield: bool):
            can Memory.Allocate, Abort.Panic:
                known, element_type = chv_type_iterable_element(type_expression, alias_names, alias_targets, depth + 1)
                # The flattened table cannot resolve ambiguous qualified names,
                # and the depth guard can stop a unique alias chain before its
                # element type is reached. Treat either unresolved alias as
                # potentially yielding references rather than clean.
                return (true, true) if not known and chv_type_alias_name_count(type_expression, alias_names) > 0
                return (known, known and chv_type_is_direct_alias_reference(element_type, alias_names, alias_targets, depth + 1))

        def chv_flow_set_iterable_element_type(flow: mutable CHVViewFlow&, binding_name: sview, iterable: Ast::Expr) -> void:
            can Abort.Panic:
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        chv_flow_set_iterable_element_type(flow, binding_name, inner)
                    Expr.Slice(object, _, _, _):
                        # Slicing keeps the collection's element type.
                        chv_flow_set_iterable_element_type(flow, binding_name, object)
                    Expr.Ident(iterable_name, _):
                        iterable_index: usize = chv_flow_latest(flow, iterable_name)
                        if iterable_index < flow.names.count and iterable_index < flow.binding_type_known.count and flow.binding_type_known[iterable_index]:
                            iterable_type_option: Ast::Expr? = flow.binding_types[iterable_index]
                            if iterable_type_option is iterable_type:
                                element_facts: (known: bool, element_type: Ast::Expr) = chv_type_iterable_element(iterable_type, flow.type_alias_names, flow.type_alias_targets, 0)
                                if element_facts.known:
                                    binding_index: usize = chv_flow_latest(flow, binding_name)
                                    if binding_index < flow.names.count:
                                        flow.binding_types[binding_index] <- element_facts.element_type
                                        flow.binding_type_known[binding_index] <- true
                                        yield_facts: (known: bool, may_yield: bool) = chv_type_iterable_yields_alias_reference(element_facts.element_type, flow.type_alias_names, flow.type_alias_targets, 0)
                                        flow.may_yield_alias_reference[binding_index] <- yield_facts.may_yield
                                        flow.may_yield_alias_reference_known[binding_index] <- yield_facts.known
                    _:
                        pass

        def chv_type_iterable_yields_scalar_sview(type_expression: Ast::Expr, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                match type_expression:
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _):
                        return chv_type_iterable_yields_scalar_sview(inner, depth + 1)
                    Expr.Index(Expr.Ident(head, _), element_type, _) if head == "darray" or head == "set" or head == "array":
                        return chv_type_is_scalar_sview(element_type)
                    _:
                        return false

        # The local a view-producing argument views: `x.as_sview()` / `x.as_cstr()` / `x.view()` /
        # `x[a:b]` with `x` a bare name; "" otherwise.
        def chv_view_call_local(argument: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, _):
                        return chv_view_call_local(inner)
                    Expr.Call(Expr.Field(receiver, method, _), call_arguments, _, _):
                        return chv_viewed_local(receiver) if call_arguments.count == 0 and (method == "as_sview" or method == "as_cstr" or method == "view")
                        return ""
                    Expr.Slice(object: slice_object, _):
                        return chv_viewed_local(slice_object)
                    _:
                        return ""

        # The viewed container when PLACE is a bare local name or a slice of one.
        def chv_viewed_local(place: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Ident(root_name, _):
                        return root_name
                    Expr.Slice(object: object, _):
                        return chv_viewed_local(object)
                    Expr.Paren(inner, _):
                        return chv_viewed_local(inner)
                    _:
                        return ""

        def chv_place_root(place: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Ident(root_name, _):
                        return root_name
                    Expr.Field(object, _, _):
                        return chv_place_root(object)
                    Expr.Index(object, _, _):
                        return chv_place_root(object)
                    Expr.IndexN(object, _, _):
                        return chv_place_root(object)
                    Expr.Slice(object: object, _):
                        return chv_place_root(object)
                    Expr.Paren(inner, _):
                        return chv_place_root(inner)
                    _:
                        return ""

        # The parser leaves `as` only for a qualified packed-variant test or a bare
        # reinterpret target marker. The latter is an assignment place, not a bool.
        def chv_is_reinterpret_target_marker(target: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return name == "&" or name == "!"
                    _:
                        return false

        # `is` and packed-pattern `as` carry a type or pattern on the right, not a
        # runtime value operand. Reinterpret markers are targets as well.
        def chv_binary_operator_has_non_runtime_target(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.Is or operator == TokenKind.As

        def chv_binary_operator_returns_bool(operator: TokenKind, right: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                boolean_operator: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq or operator == TokenKind.In or operator == TokenKind.Is or operator == TokenKind.And or operator == TokenKind.Or
                return boolean_operator or (operator == TokenKind.As and not chv_is_reinterpret_target_marker(right))

        # Whether ARGUMENT may be a view of owned local storage. Bare-name reassignment can
        # clear stale provenance. Projection assignments preserve root taint because this pass
        # does not know which aggregate field or indexed element was replaced.
        def chv_is_owned_view(argument: Ast::Expr, flow: CHVViewFlow&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                # Recursion follows AST children, not aliases: name provenance is already
                # summarized in flow. A nesting cutoff would invent borrowed storage for
                # deeply parenthesized literals and ordinary scalar call arguments.
                root: sview = chv_view_call_local(argument)
                if root != "":
                    index: usize = chv_flow_latest(flow, root)
                    return index < flow.names.count and (flow.owned[index] or flow.may_owned_view[index])
                match argument:
                    Expr.Paren(inner, _):
                        return chv_is_owned_view(inner, flow, depth + 1)
                    Expr.Move(inner, _):
                        return chv_is_owned_view(inner, flow, depth + 1)
                    Expr.Ident(bound_name, _):
                        index: usize = chv_flow_latest(flow, bound_name)
                        return index < flow.names.count and flow.may_owned_view[index]
                    Expr.Field(_, _, _):
                        root_name: sview = chv_place_root(argument)
                        index: usize = chv_flow_latest(flow, root_name) if root_name != "" else flow.names.count
                        return index < flow.names.count and flow.may_owned_view[index]
                    Expr.Call(Expr.Field(receiver, _, _), call_arguments, _, _):
                        receiver_root: sview = chv_place_root(receiver)
                        receiver_index: usize = chv_flow_latest(flow, receiver_root) if receiver_root != "" else flow.names.count
                        receiver_may_be_owned: bool = chv_is_owned_view(receiver, flow, depth + 1) or (receiver_index < flow.names.count and (flow.owned[receiver_index] or flow.may_owned_view[receiver_index]))
                        arguments_may_be_owned: bool = any call_argument in call_arguments where chv_is_owned_view(call_argument, flow, depth + 1)
                        return receiver_may_be_owned or arguments_may_be_owned
                    Expr.Call(arguments: call_arguments, _):
                        return any call_argument in call_arguments where chv_is_owned_view(call_argument, flow, depth + 1)
                    Expr.If(_, then_value, else_value, _):
                        return chv_is_owned_view(then_value, flow, depth + 1) or chv_is_owned_view(else_value, flow, depth + 1)
                    Expr.Index(object, index, _):
                        index_may_be_owned_view: mutable bool = false
                        if not index_receiver_is_type_application(object):
                            index_may_be_owned_view <- chv_is_owned_view(index, flow, depth + 1)
                        return chv_is_owned_view(object, flow, depth + 1) or index_may_be_owned_view
                    Expr.IndexN(object, arguments, _):
                        # IndexN represents multi-index selection or generic application. Unlike
                        # single-key Index, it does not lower through the __index__ protocol, so
                        # selector/type arguments cannot become the returned view's storage.
                        return chv_is_owned_view(object, flow, depth + 1)
                    Expr.Unary(operator, operand, _):
                        return false if operator == TokenKind.Not
                        return chv_is_owned_view(operand, flow, depth + 1)
                    Expr.Binary(left, binary_operator, right, _):
                        return false if chv_binary_operator_returns_bool(binary_operator, right)
                        return chv_is_owned_view(left, flow, depth + 1) or chv_is_owned_view(right, flow, depth + 1)
                    _:
                        return false

        # Return the aggregate syntax itself as a read-only shape view. The semantic
        # pass runs in a submitted worker, which may read captured Ast nodes but may
        # not allocate a new darray containing Ast::Expr values.
        def chv_known_iterable_shape(iterable: Ast::Expr, depth: u32) -> (known: bool, shape: Ast::Expr) can[Abort.Panic]:
            can Abort.Panic:
                return (false, iterable) if depth > 64
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_known_iterable_shape(inner, depth + 1)
                    Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _):
                        return (true, iterable)
                    _:
                        return (false, iterable)

        # Keep a view of a known container expression instead of copying its AST nodes
        # into a temporary darray. This checker runs in a submitted semantic worker, which
        # may read the captured AST store but may not build new Ast::Node-backed values.
        def chv_known_iterable_shape_with_locals(iterable: Ast::Expr, flow: CHVViewFlow&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, depth: u32) -> (known: bool, shape: Ast::Expr) can[Abort.Panic]:
            can Abort.Panic:
                return (false, iterable) if depth > 64
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_known_iterable_shape_with_locals(inner, flow, view_names, view_values, depth + 1)
                    Expr.Ident(name, _):
                        current_index: usize = chv_flow_latest(flow, name)
                        return (false, iterable) if current_index < flow.names.count and flow.shape_unknown[current_index]
                        matches: mutable usize = 0
                        matched_index: mutable usize = view_values.count
                        for index in 0..<view_names.count |matches, matched_index, view_names, view_values|:
                            if view_names[index] == name and index < view_values.count:
                                matches <- matches + 1
                                matched_index <- index
                        return (false, iterable) if matches != 1
                        matched_value: Ast::Expr = view_values[matched_index]
                        match matched_value:
                            Expr.Ident(initializer_name, _) if initializer_name == name:
                                return (false, iterable)
                            _:
                                return chv_known_iterable_shape_with_locals(matched_value, flow, view_names, view_values, depth + 1)
                    Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _):
                        return (true, iterable)
                    _:
                        return (false, iterable)

        def chv_known_iterable_shape_count(shape: Ast::Expr) -> usize:
            can Abort.Panic:
                match shape:
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        return elements.count
                    Expr.DictLit(entries, _):
                        return entries.count * 2
                    _:
                        return 0

        def chv_known_iterable_shape_element(shape: Ast::Expr, index: usize) -> Ast::Expr:
            can Abort.Panic:
                match shape:
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        return elements[index]
                    Expr.DictLit(entries, _):
                        entry: Ast::DictEntry = entries[index / 2]
                        return entry.key if index % 2 == 0
                        return entry.value
                    _:
                        return shape

        # Iterating an sview yields scalar bytes, not borrowed-view elements. The
        # initializer source records the view-producing expression for local names.
        def chv_iterable_is_scalar_sview(iterable: Ast::Expr, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > view_names.count
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_iterable_is_scalar_sview(inner, view_names, view_values, depth + 1)
                    Expr.Call(Expr.Field(_, method, _), arguments, _, _):
                        return arguments.count == 0 and (method == "as_sview" or method == "as_cstr")
                    Expr.If(_, then_value, else_value, _):
                        return chv_iterable_is_scalar_sview(then_value, view_names, view_values, depth + 1) and chv_iterable_is_scalar_sview(else_value, view_names, view_values, depth + 1)
                    Expr.Slice(object, _, _, _):
                        return chv_iterable_is_scalar_sview(object, view_names, view_values, depth + 1)
                    Expr.Ident(name, _):
                        index: mutable usize = view_names.count
                        while index > 0 |index|:
                            index <- index - 1
                            if view_names[index] == name and index < view_values.count:
                                match view_values[index]:
                                    Expr.Call(Expr.Field(_, method, _), arguments, _, _):
                                        return arguments.count == 0 and (method == "as_sview" or method == "as_cstr")
                                    Expr.Ident(initializer_name, _) if initializer_name != name:
                                        return chv_iterable_is_scalar_sview(view_values[index], view_names, view_values, depth + 1)
                                    Expr.If(_, then_value, else_value, _):
                                        return chv_iterable_is_scalar_sview(then_value, view_names, view_values, depth + 1) and chv_iterable_is_scalar_sview(else_value, view_names, view_values, depth + 1)
                                    Expr.Slice(object, _, _, _):
                                        return chv_iterable_is_scalar_sview(object, view_names, view_values, depth + 1)
                                    Expr.Ident("sview", _) | Expr.Ident("cstr", _):
                                        return true
                                    _:
                                        return false
                        return false
                    _:
                        return false

        # For known aggregate literals, join the element facts. Unknown iterables
        # retain the old conservative whole-value fact, except scalar sview iteration.
        def chv_iterable_element_may_be_owned_view(iterable: Ast::Expr, flow: CHVViewFlow&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, fallback_may_be_owned_view: bool, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if chv_flow_iterable_is_scalar_sview(iterable, flow, depth + 1)
                known_elements, elements = chv_known_iterable_shape(iterable, depth + 1)
                if known_elements:
                    may_yield_owned_view: mutable bool = false
                    element_count: usize = chv_known_iterable_shape_count(elements)
                    for element_index in 0..<element_count |may_yield_owned_view, flow, elements|:
                        element: Ast::Expr = chv_known_iterable_shape_element(elements, element_index)
                        may_yield_owned_view <- may_yield_owned_view or chv_is_owned_view(element, flow, depth + 1)
                    return may_yield_owned_view
                match iterable:
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        if index < flow.names.count:
                            return false if flow.may_be_scalar_sview[index]
                            return flow.may_owned_view[index]
                        return false if chv_iterable_is_scalar_sview(iterable, view_names, view_values, 0)
                    _:
                        pass
                return false if chv_iterable_is_scalar_sview(iterable, view_names, view_values, 0)
                return fallback_may_be_owned_view

        def chv_flow_iterable_is_scalar_sview(iterable: Ast::Expr, flow: CHVViewFlow&, depth: u32) -> bool:
            can Abort.Panic:
                return false if depth > 64
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_flow_iterable_is_scalar_sview(inner, flow, depth + 1)
                    Expr.Call(Expr.Field(_, method, _), arguments, _, _):
                        return arguments.count == 0 and (method == "as_sview" or method == "as_cstr")
                    Expr.Slice(object, _, _, _):
                        return chv_flow_is_byte_sequence(object, flow, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        return index < flow.names.count and (flow.may_be_scalar_sview[index] or flow.may_be_byte_sequence[index])
                    Expr.If(_, then_value, else_value, _):
                        return chv_flow_iterable_is_scalar_sview(then_value, flow, depth + 1) and chv_flow_iterable_is_scalar_sview(else_value, flow, depth + 1)
                    _:
                        return false

        def chv_flow_is_byte_sequence(expression: Ast::Expr, flow: CHVViewFlow&, depth: u32) -> bool:
            can Abort.Panic:
                return false if depth > 64
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_flow_is_byte_sequence(inner, flow, depth + 1)
                    Expr.Call(Expr.Field(_, method, _), arguments, _, _):
                        return arguments.count == 0 and (method == "as_sview" or method == "as_cstr")
                    Expr.Slice(object, _, _, _):
                        return chv_flow_is_byte_sequence(object, flow, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        return index < flow.names.count and (flow.may_be_byte_sequence[index] or flow.may_be_scalar_sview[index])
                    Expr.If(_, then_value, else_value, _):
                        return chv_flow_is_byte_sequence(then_value, flow, depth + 1) and chv_flow_is_byte_sequence(else_value, flow, depth + 1)
                    _:
                        return false

        def chv_expression_is_scalar_sview(expression: Ast::Expr, flow: CHVViewFlow&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                return true if chv_flow_iterable_is_scalar_sview(expression, flow, depth + 1)
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_expression_is_scalar_sview(inner, flow, view_names, view_values, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        if index < flow.names.count:
                            return flow.may_be_scalar_sview[index]
                        return chv_iterable_is_scalar_sview(expression, view_names, view_values, depth + 1)
                    Expr.If(_, then_value, else_value, _):
                        return chv_expression_is_scalar_sview(then_value, flow, view_names, view_values, depth + 1) and chv_expression_is_scalar_sview(else_value, flow, view_names, view_values, depth + 1)
                    _:
                        return chv_iterable_is_scalar_sview(expression, view_names, view_values, depth + 1)

        def chv_iterable_element_may_contain_alias_ref(iterable: Ast::Expr, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                return false if chv_flow_iterable_is_scalar_sview(iterable, flow, depth + 1)
                known_elements, elements = chv_known_iterable_shape(iterable, depth + 1)
                if known_elements:
                    found: mutable bool = false
                    element_count: usize = chv_known_iterable_shape_count(elements)
                    for element_index in 0..<element_count |found, elements, ref_params, flow, table|:
                        element: Ast::Expr = chv_known_iterable_shape_element(elements, element_index)
                        found <- found or chv_expression_may_contain_alias_ref(element, ref_params, flow, table, depth + 1)
                    return found
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_iterable_element_may_contain_alias_ref(inner, ref_params, flow, table, depth + 1)
                    Expr.Slice(object, _, _, _):
                        return chv_iterable_element_may_contain_alias_ref(object, ref_params, flow, table, depth + 1)
                    Expr.If(condition, then_value, else_value, _):
                        then_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                        chv_flow_bind_truthy_condition_binders(condition, ref_params, &then_flow, table)
                        return chv_iterable_element_may_contain_alias_ref(then_value, ref_params, then_flow, table, depth + 1) or chv_iterable_element_may_contain_alias_ref(else_value, ref_params, flow, table, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        if index < flow.names.count:
                            return flow.may_contain_alias_reference[index]
                    _:
                        pass
                return chv_expression_may_contain_alias_ref(iterable, ref_params, flow, table, depth + 1)

        def chv_iterable_element_may_alias_reference(iterable: Ast::Expr, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                return false if chv_flow_iterable_is_scalar_sview(iterable, flow, depth + 1)
                known_elements, elements = chv_known_iterable_shape(iterable, depth + 1)
                if known_elements:
                    may_yield_alias_reference: mutable bool = false
                    element_count: usize = chv_known_iterable_shape_count(elements)
                    for element_index in 0..<element_count |may_yield_alias_reference, elements, ref_params, flow, table|:
                        element: Ast::Expr = chv_known_iterable_shape_element(elements, element_index)
                        element_is_aggregate, nested_shape = chv_known_iterable_shape(element, depth + 1)
                        may_yield_alias_reference <- may_yield_alias_reference or (not element_is_aggregate and chv_expression_may_direct_alias_ref(element, ref_params, flow, table, depth + 1))
                    return may_yield_alias_reference
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_iterable_element_may_alias_reference(inner, ref_params, flow, table, depth + 1)
                    Expr.Slice(object, _, _, _):
                        return chv_iterable_element_may_alias_reference(object, ref_params, flow, table, depth + 1)
                    Expr.If(condition, then_value, else_value, _):
                        then_flow: mutable CHVViewFlow = chv_flow_clone(flow)
                        chv_flow_bind_truthy_condition_binders(condition, ref_params, &then_flow, table)
                        return chv_iterable_element_may_alias_reference(then_value, ref_params, then_flow, table, depth + 1) or chv_iterable_element_may_alias_reference(else_value, ref_params, flow, table, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        if index < flow.names.count:
                            if index < flow.may_yield_alias_reference_known.count and flow.may_yield_alias_reference_known[index]:
                                return flow.may_yield_alias_reference[index]
                            if index < flow.binding_type_known.count and flow.binding_type_known[index]:
                                binding_type_option: Ast::Expr? = flow.binding_types[index]
                                if binding_type_option is binding_type:
                                    type_facts: (known: bool, may_yield: bool) = chv_type_iterable_yields_alias_reference(binding_type, flow.type_alias_names, flow.type_alias_targets, depth + 1)
                                    return type_facts.may_yield if type_facts.known
                    _:
                        pass
                # If the yielded type is unknown, contained references could be
                # direct elements (for example darray[&T]). Stay conservative;
                # known aggregate element types take the precise false path above.
                return chv_iterable_element_may_contain_alias_ref(iterable, ref_params, flow, table, depth + 1)

        def chv_iterable_element_alias_facts(iterable: Ast::Expr, ref_params: darray[sview]&, flow: CHVViewFlow&, table: SymbolTable&, depth: u32) -> (known: bool, may_yield: bool):
            can Memory.Allocate, Abort.Panic:
                return (false, false) if depth > 64
                known_shape, shape = chv_known_iterable_shape(iterable, depth + 1)
                if known_shape:
                    return (true, chv_iterable_element_may_alias_reference(iterable, ref_params, flow, table, depth + 1))
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return chv_iterable_element_alias_facts(inner, ref_params, flow, table, depth + 1)
                    Expr.Slice(object, _, _, _):
                        return chv_iterable_element_alias_facts(object, ref_params, flow, table, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        if index < flow.names.count:
                            if index < flow.may_yield_alias_reference_known.count and flow.may_yield_alias_reference_known[index]:
                                return (true, flow.may_yield_alias_reference[index])
                            if index < flow.binding_type_known.count and flow.binding_type_known[index]:
                                type_option: Ast::Expr? = flow.binding_types[index]
                                if type_option is binding_type:
                                    type_facts: (known: bool, may_yield: bool) = chv_type_iterable_yields_alias_reference(binding_type, flow.type_alias_names, flow.type_alias_targets, depth + 1)
                                    return type_facts if type_facts.known
                        return (false, chv_iterable_element_may_alias_reference(iterable, ref_params, flow, table, depth + 1))
                    Expr.If(_, then_value, else_value, _):
                        left_facts: (known: bool, may_yield: bool) = chv_iterable_element_alias_facts(then_value, ref_params, flow, table, depth + 1)
                        right_facts: (known: bool, may_yield: bool) = chv_iterable_element_alias_facts(else_value, ref_params, flow, table, depth + 1)
                        return (left_facts.known and right_facts.known, left_facts.may_yield or right_facts.may_yield)
                    _:
                        return (false, chv_iterable_element_may_alias_reference(iterable, ref_params, flow, table, depth + 1))

        def chv_iterable_element_is_scalar_sview(iterable: Ast::Expr, flow: CHVViewFlow&, view_names: darray[sview]&, view_values: darray[Ast::Expr]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 64
                return false if chv_flow_iterable_is_scalar_sview(iterable, flow, depth + 1)
                known_elements, elements = chv_known_iterable_shape(iterable, depth + 1)
                if known_elements:
                    element_count: usize = chv_known_iterable_shape_count(elements)
                    all_scalar: mutable bool = element_count > 0
                    for element_index in 0..<element_count |all_scalar, elements, flow, view_names, view_values|:
                        element: Ast::Expr = chv_known_iterable_shape_element(elements, element_index)
                        all_scalar <- all_scalar and chv_expression_is_scalar_sview(element, flow, view_names, view_values, depth + 1)
                    return all_scalar
                match iterable:
                    Expr.Slice(object, _, _, _):
                        return chv_iterable_element_is_scalar_sview(object, flow, view_names, view_values, depth + 1)
                    Expr.Ident(name, _):
                        index: usize = chv_flow_latest(flow, name)
                        return index < flow.names.count and flow.may_yield_scalar_sview[index]
                    Expr.If(_, then_value, else_value, _):
                        return chv_iterable_element_is_scalar_sview(then_value, flow, view_names, view_values, depth + 1) and chv_iterable_element_is_scalar_sview(else_value, flow, view_names, view_values, depth + 1)
                    _:
                        return false
