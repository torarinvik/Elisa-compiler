extend Semantic:
    private:
        # Check if an expression is an empty range with literal integer bounds.
        # Returns true if the range is provably empty (no iterations).
        def is_empty_range(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(lo, op, hi, line):
                        if lo is Expr.IntLit(a):
                            if hi is Expr.IntLit(b):
                                match op:
                                    TokenKind.RangeLt:
                                        return a >= b
                                    TokenKind.RangeLe:
                                        return a > b
                                    TokenKind.RangeGt:
                                        return a <= b
                                    _:
                                        pass
                    _:
                        pass
                return false

        # Check for for-loops over provably empty literal integer ranges.
        # Flags loops like `for i in 5..<5:` or `for i in 7..<3:` that never execute.
        def check_empty_range_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.For(bind, variables, iterable, body, line):
                            if is_empty_range(iterable):
                                loop_var: sview = variables[0] if variables.count > 0 else ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyRange, name: loop_var, line: line, expected: "", actual: ""})
                            table <- check_empty_range_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_empty_range_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_empty_range_statements(arm.body, table)
                        Stmt.While(condition, body, line):
                            table <- check_empty_range_statements(body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_empty_range_statements(then_body, table)
                            table <- check_empty_range_statements(else_body, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass


        # Check for empty ranges in all declarations (recursing through Func/Module/Scoped).
        def check_empty_range(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_empty_range_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_empty_range(body, table)
                        Decl.Scoped(body, line):
                            table <- check_empty_range(body, table)
                        _:
                            pass
