# A BARE parallel rebind whose element is a threading `lmut` call on one of its own targets:
#
#     e, k <- e.step(), k          # def step(box: lmut Box) -> i64
#
# stage0 reads a threading call in a multi-target rebind as CONSUMING its receiver target: the
# receiver leaves the target list while its element stays in the tuple, so the bare form can
# never balance. MEASURED against stage0, one probe per row (2026-09-06):
#
#     e, k <- e.step(), k           cannot assign (_0: i64, _1: i64) to i64     at `k` (the one left)
#     k, e <- k, e.step()           cannot assign (_0: i64, _1: i64) to i64     at `k`
#     e, k <- e.same(), k           cannot assign (_0: Box, _1: i64) to i64     (return type irrelevant)
#     e, k <- e.step(), k + 1       (_0: i64, _1: i64)                         an expression spells its type
#     e, k <- e.step(), 7           (_0: i64, _1: int)                         an int literal spells `int`
#     e, p <- e.step(), p           (_0: i64, _1: Pair) to Pair                a struct target spells its name
#     e, k, j <- e.step(), k, j     tuple destructuring expects 3 bindings, got 2   at `e` (the first)
#     e, f <- e.step(), f.step()    ACCEPTED — every target consumed, nothing left to assign
#
# The threading reading IS legal inside the manifest `if` (docs/120 §6). The parser desugars
# each of its branches to this same parallel shape, so those are told apart by their GENERATED
# position — `Ast::pos_at_line`, column 0 — and exempted. stage1 accepted every bare form: a
# PERMISSIVE gap found while closing the corpus decline `lmut_threading_value`, and closed here.
extend Semantic:
    private:
        # The stage0 spelling of one tuple element: a literal by its literal kind, a threading
        # call by its declared return type, anything else by its inferred value type.
        def prt_element_spelling(element: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                literal: sview = literal_kind_of(element)
                literal return if literal != ""
                match element:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method_name, field_line):
                                declared: sview = function_return_type(table, method_name)
                                declared return if declared != ""
                            _:
                                pass
                    _:
                        pass
                return stage0_value_spelling(infer_expression_type(element, names, types, table))

        # The target name a threading call at `element` consumes, when that name is among
        # `targets` ("" otherwise): `recv.m(...)` with `m` declaring an `lmut` receiver.
        def prt_consumed_target(element: Ast::Expr, targets: darray[Ast::Expr]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match element:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method_name, field_line):
                                receiver_name: sview = ident_name_of(receiver)
                                "" return if receiver_name == "" or not lmut_threads_position(table, method_name, 0)
                                receiver_name return if any target in targets where ident_name_of(target) == receiver_name
                            _:
                                pass
                    _:
                        pass
                return ""

        def check_parallel_rebind_threading(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if operator != TokenKind.LArrow
                match target:
                    Expr.Array(targets, targets_pos):
                        # A generated position is a manifest branch (see the header).
                        return if targets_pos.column == 0
                        match value:
                            Expr.Array(elements, elements_pos):
                                return if elements.count != targets.count or targets.count < 2
                                consumed: mutable darray[sview] = []
                                for element in elements |consumed, targets, table|:
                                    name: sview = prt_consumed_target(element, targets, table)
                                    consumed.push(name) if name != "" and not (any seen in consumed where seen == name)
                                return if consumed.count == 0
                                remaining: mutable darray[usize] = []
                                for index in 0..<targets.count |remaining, targets, consumed|:
                                    remaining.push(index) if not (any seen in consumed where seen == ident_name_of(targets[index]))
                                return if remaining.count == 0
                                if remaining.count >= 2:
                                    if targets[0] is Expr.Ident(first_name, first_pos):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TupleDestructureArityMismatch, name: first_name, line: first_pos.line, pos: first_pos, expected: "", actual: "", expected_count: elements.count.u32(), actual_count: remaining.count.u32()})
                                    return
                                # One target left: the WHOLE tuple is assigned to it. Two and three
                                # elements are spelled exactly; a wider tuple keeps the first three.
                                return if elements.count > 3
                                if targets[remaining[0]] is Expr.Ident(left_name, left_pos):
                                    left_type: sview = local_type_of(names, types, left_name)
                                    return if left_type == ""
                                    third: sview = prt_element_spelling(elements[2], names, types, table) if elements.count == 3 else ""
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ParallelRebindThreadedTuple, name: left_name, line: left_pos.line, pos: left_pos, expected: left_type, actual: "", actual_count: elements.count.u32(), detail: prt_element_spelling(elements[0], names, types, table), detail2: prt_element_spelling(elements[1], names, types, table), detail3: third})
                            _:
                                pass
                    _:
                        pass
