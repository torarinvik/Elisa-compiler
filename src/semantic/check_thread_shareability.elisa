# Thread-boundary structural shareability. `static` is a source-level provenance
# qualifier intentionally erased by TypeId interning, so retain this distinction from
# declaration ASTs when validating spawn/pool arguments and callback results.
extend Semantic:
    private:
        def type_contains_operator(type_expression: Ast::Expr, wanted: TokenKind) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return operator == wanted or type_contains_operator(operand, wanted)
                    Expr.Index(head, argument, line):
                        return type_contains_operator(head, wanted) or type_contains_operator(argument, wanted)
                    Expr.IndexN(head, arguments, line):
                        true return if type_contains_operator(head, wanted)
                        for argument in arguments:
                            true return if type_contains_operator(argument, wanted)
                        return false
                    Expr.Paren(inner, line):
                        return type_contains_operator(inner, wanted)
                    _:
                        return false


        def type_is_nonstatic_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return type_contains_operator(type_expression, TokenKind.Ampersand) and not type_contains_operator(type_expression, TokenKind.Static)


        def thread_flag_for_name(names: darray[sview]&, flags: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    flags[index] return if names[index] == name
                return false


        def thread_callback_has_nonstatic_ref_result(callback_names: darray[sview]&, callback_flags: darray[bool]&, expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return thread_flag_for_name(callback_names, callback_flags, name)
                    Expr.Paren(inner, line):
                        return thread_callback_has_nonstatic_ref_result(callback_names, callback_flags, inner)
                    _:
                        return false


        def report_thread_callback_result(call_name: sview, callback: Ast::Expr, line: u32, callback_names: darray[sview]&, callback_flags: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadResultNotShareable, name: call_name, line: line, expected: "", actual: "reference"}) if thread_callback_has_nonstatic_ref_result(callback_names, callback_flags, callback)


        def report_thread_payload(call_name: sview, payload: Ast::Expr, line: u32, names: darray[sview]&, flags: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                payload_name: sview = affine_root(payload)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadArgumentNotShareable, name: call_name, line: line, expected: "", actual: "reference"}) if payload_name != "" and thread_flag_for_name(names, flags, payload_name)


        def check_thread_boundary_call(callee: Ast::Expr, arguments: darray[Ast::Expr]&, line: u32, names: darray[sview]&, flags: darray[bool]&, callback_names: darray[sview]&, callback_flags: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                call_name: sview = match callee:
                    Expr.Ident(name, call_line): name
                    _: ""
                return if call_name != "spawn1" and call_name != "pool_submit1" and call_name != "spawn_daemon"
                callback_index: usize = 0 if call_name == "spawn1" or call_name == "spawn_daemon" else 1
                table <- report_thread_callback_result(call_name, arguments[callback_index], line, callback_names, callback_flags, table) if callback_index < arguments.count
                table <- report_thread_payload(call_name, arguments[arguments.count - 1], line, names, flags, table) if arguments.count > 0


        def walk_thread_shareability_expression(expression: Ast::Expr, names: darray[sview]&, flags: darray[bool]&, callback_names: darray[sview]&, callback_flags: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_thread_boundary_call(callee, arguments, line.line, names, flags, callback_names, callback_flags, table)
                        for argument in arguments |table|:
                            table <- walk_thread_shareability_expression(argument, names, flags, callback_names, callback_flags, table)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        table <- walk_thread_shareability_expression(operand, names, flags, callback_names, callback_flags, table)
                    Expr.Binary(left, operator, right, line) | Expr.Refinement(left, right, line):
                        table <- walk_thread_shareability_expression(left, names, flags, callback_names, callback_flags, table)
                        table <- walk_thread_shareability_expression(right, names, flags, callback_names, callback_flags, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_thread_shareability_expression(element, names, flags, callback_names, callback_flags, table)
                    _:
                        pass


        def walk_thread_shareability_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, flags: mutable darray[bool]&, callback_names: darray[sview]&, callback_flags: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, flags, table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_thread_shareability_expression(value, names, flags, callback_names, callback_flags, table)
                            names.push(name)
                            flags.push(type_is_nonstatic_reference(type_expression))
                        Stmt.Assign(target, operator, value, line) | Stmt.Expr(value, line):
                            table <- walk_thread_shareability_expression(value, names, flags, callback_names, callback_flags, table)
                        Stmt.Return(value, line):
                            table <- walk_thread_shareability_expression(returned, names, flags, callback_names, callback_flags, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_thread_shareability_expression(condition, names, flags, callback_names, callback_flags, table)
                            table <- walk_thread_shareability_statements(then_body, names, flags, callback_names, callback_flags, table)
                            table <- walk_thread_shareability_statements(else_body, names, flags, callback_names, callback_flags, table)
                        Stmt.Block(kind, clause, binding, body, line) | Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- walk_thread_shareability_statements(body, names, flags, callback_names, callback_flags, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |names, flags, table|:
                                table <- walk_thread_shareability_statements(arm.body, names, flags, callback_names, callback_flags, table)
                        _:
                            pass


        def collect_thread_callbacks(declarations: darray[Ast::Decl], names: mutable darray[sview]&, flags: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, flags|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names.push(name)
                            flags.push(type_is_nonstatic_reference(return_expression) if return_type is return_expression else false)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            collect_thread_callbacks(body, names, flags)
                        _:
                            pass


        def check_thread_shareability_declarations(declarations: darray[Ast::Decl], callback_names: darray[sview]&, callback_flags: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            flags: mutable darray[bool] = []
                            for param in params |names, flags|:
                                names.push(param.name)
                                flags.push(type_is_nonstatic_reference(param.type_expression))
                            table <- walk_thread_shareability_statements(body, names, flags, callback_names, callback_flags, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_thread_shareability_declarations(body, callback_names, callback_flags, table)
                        _:
                            pass

    public:
        def check_thread_shareability(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callback_names: mutable darray[sview] = []
                callback_flags: mutable darray[bool] = []
                collect_thread_callbacks(declarations, callback_names, callback_flags)
                table <- check_thread_shareability_declarations(declarations, callback_names, callback_flags, table)
