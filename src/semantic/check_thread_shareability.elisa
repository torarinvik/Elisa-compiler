# Thread-boundary structural shareability. `static` is a source-level provenance
# qualifier intentionally erased by TypeId interning, so retain this distinction from
# declaration ASTs when validating spawn/pool arguments and callback results.
extend Semantic:
    private:
        # These cutoffs are static allocation heuristics; retain them as compile-time
        # scorecard items until measurements confirm the index build amortizes its cost.
        const THREAD_ALIAS_INDEX_NONE: u32 = 4294967295
        const THREAD_CALLBACK_INDEX_NONE: u32 = 4294967295
        const THREAD_ALIAS_INDEX_MIN_ROWS: usize = 8.usize()
        const THREAD_CALLBACK_INDEX_MIN_ROWS: usize = 8.usize()

        enum ThreadTypeSource:
            Declaration(Ast::Decl)
            Expression(Ast::Expr)

        struct ThreadCallbackIndex:
            names: mutable darray[sview @source] = []
            modules: mutable darray[sview @source] = []
            return_types: mutable darray[Ast::Expr] = []
            flags: mutable darray[bool] = []
            classified: mutable darray[bool] = []
            duplicate_next: mutable darray[u32] = []
            duplicate_tail: mutable darray[u32] = []
            slots: mutable darray[u32] = []
            index_attempted: mutable bool = false
            index_built: mutable bool = false
            type_owners: mutable darray[sview @source] = []
            type_owner_modules: mutable darray[sview @source] = []
            type_owner_lines: mutable darray[u32] = []
            type_sources: mutable darray[ThreadTypeSource] = []
            type_next: mutable darray[u32] = []
            type_heads: mutable dict[u64, u32] = {}
            type_tails: mutable dict[u64, u32] = {}
            type_counts: mutable dict[u64, u32] = {}
            scope_module_names: mutable darray[sview @source] = []
            scope_module_next: mutable darray[u32] = []
            scope_module_heads: mutable dict[u64, u32] = {}
            scope_module_index_attempted: mutable bool = false
            scope_module_index_built: mutable bool = false
            # stage0 checks a thread boundary inside a generic function once per
            # specialization: a type parameter of the enclosing function is shareable at the
            # definition. stage1 has no specialized bodies, so such a function becomes a
            # derived boundary instead, and its call sites check the concrete arguments.
            function_line: mutable u32 = 0
            function_name: mutable sview @source = ""
            generic_deferred: mutable bool = false
            function_params: mutable darray[sview @source] = []
            function_param_deferred: mutable darray[bool] = []
            function_param_is_fn: mutable darray[bool] = []
            derived_names: mutable darray[sview @source] = []
            derived_param_starts: mutable darray[usize] = []
            derived_param_counts: mutable darray[usize] = []
            derived_param_is_fn: mutable darray[bool] = []
            # Per callback row: its declaration line (its own generic scope) and whether
            # its result type mentions one of its own type parameters.
            lines: mutable darray[u32] = []
            row_generic: mutable darray[bool] = []

        # Exact visited keys pair module scope with the type spelling. The open-addressed
        # table keeps recursive aggregate walks near-linear without conflating `A::Item`
        # and `B::Item`.
        struct ThreadTypeVisitSet:
            names: mutable darray[sview @source] = []
            modules: mutable darray[sview @source] = []
            slots: mutable darray[u32] = []

        const THREAD_TYPE_VISIT_EMPTY: u32 = 4294967295
        const THREAD_TYPE_VISIT_HASH_MIN_ROWS: usize = 4.usize()

        def thread_type_visit_hash(module_scope: sview, name: sview) -> u64:
            can Abort.Panic:
                return (name_hash(module_scope) * 1099511628211) ^ name_hash(name)

        def thread_type_visit_slot(set: ThreadTypeVisitSet&, module_scope: sview, name: sview) -> usize:
            can Abort.Panic:
                mask: usize = set.slots.count - 1.usize()
                slot: mutable usize = thread_type_visit_hash(module_scope, name).usize() & mask
                while set.slots[slot] != THREAD_TYPE_VISIT_EMPTY |slot, set, module_scope, name, mask|:
                    row: usize = set.slots[slot].usize()
                    return slot if row < set.names.count and row < set.modules.count and set.names[row] == name and set.modules[row] == module_scope
                    slot <- (slot + 1.usize()) & mask
                return slot

        def thread_type_visit_grow(set: mutable ThreadTypeVisitSet&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16.usize()
                while capacity < (set.names.count + 1.usize()) * 2.usize() |capacity, set|:
                    capacity <- capacity * 2.usize()
                set.slots <- []
                for _slot in 0..<capacity |set|:
                    set.slots <- set.slots.push(THREAD_TYPE_VISIT_EMPTY)
                for row in 0..<set.names.count |row, set|:
                    slot: usize = thread_type_visit_slot(set, set.modules[row], set.names[row])
                    set.slots[slot] <- row.u32()

        def thread_type_visit_contains(set: ThreadTypeVisitSet&, module_scope: sview, name: sview) -> bool:
            can Abort.Panic:
                if set.slots.count == 0:
                    for row in 0..<set.names.count:
                        return true if set.names[row] == name and row < set.modules.count and set.modules[row] == module_scope
                    return false
                return set.slots[thread_type_visit_slot(set, module_scope, name)] != THREAD_TYPE_VISIT_EMPTY

        def thread_type_visit_add(set: mutable ThreadTypeVisitSet&, module_scope: sview @source, name: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                if set.slots.count == 0 and set.names.count < THREAD_TYPE_VISIT_HASH_MIN_ROWS:
                    set.names <- set.names.push(name)
                    set.modules <- set.modules.push(module_scope)
                    return
                thread_type_visit_grow(set) if set.slots.count < (set.names.count + 1.usize()) * 2.usize()
                slot: usize = thread_type_visit_slot(set, module_scope, name)
                return if set.slots[slot] != THREAD_TYPE_VISIT_EMPTY
                set.slots[slot] <- set.names.count.u32()
                set.names <- set.names.push(name)
                set.modules <- set.modules.push(module_scope)


        def new_thread_callback_index() -> ThreadCallbackIndex can[Abort.Panic]:
            return ThreadCallbackIndex{names: [], modules: [], return_types: [], flags: [], classified: [], duplicate_next: [], duplicate_tail: [], slots: [], index_attempted: false, index_built: false, type_owners: [], type_owner_modules: [], type_owner_lines: [], type_sources: [], type_next: [], type_heads: {}, type_tails: {}, type_counts: {}, scope_module_names: [], scope_module_next: [], scope_module_heads: {}, scope_module_index_attempted: false, scope_module_index_built: false, function_line: 0, function_name: "", generic_deferred: false, function_params: [], function_param_deferred: [], function_param_is_fn: [], derived_names: [], derived_param_starts: [], derived_param_counts: [], derived_param_is_fn: [], lines: [], row_generic: []}


        # Retain one AST declaration row per named aggregate instead of flattening every
        # member into the index. The symbol table's structural projections omit positional
        # structs and erase reference qualifiers, so queried declarations still walk their
        # original member expressions on demand.
        def thread_index_type_row(callbacks: mutable ThreadCallbackIndex&, owner: sview @source, owner_module: sview @source, owner_line: u32, source: ThreadTypeSource) -> void:
            can Memory.Allocate, Abort.Panic:
                row: usize = callbacks.type_owners.count
                callbacks.type_owners <- callbacks.type_owners.push(owner)
                callbacks.type_owner_modules <- callbacks.type_owner_modules.push(owner_module)
                callbacks.type_owner_lines <- callbacks.type_owner_lines.push(owner_line)
                callbacks.type_sources <- callbacks.type_sources.push(source)
                callbacks.type_next <- callbacks.type_next.push(THREAD_CALLBACK_INDEX_NONE)
                hash: u64 = name_hash(owner)
                prior_tail: mutable u32 = THREAD_CALLBACK_INDEX_NONE
                can Global{Read,Write}:
                    prior_tail <- tail_row if callbacks.type_tails.get(hash) is tail_row
                if prior_tail != THREAD_CALLBACK_INDEX_NONE:
                    callbacks.type_next[prior_tail.usize()] <- row.u32()
                else:
                    callbacks.type_heads <- callbacks.type_heads.put(hash, row.u32()) can Global{Read,Write}
                callbacks.type_tails <- callbacks.type_tails.put(hash, row.u32()) can Global{Read,Write}
                old_count: mutable u32 = 0
                can Global{Read,Write}:
                    old_count <- count if callbacks.type_counts.get(hash) is count
                callbacks.type_counts <- callbacks.type_counts.put(hash, old_count + 1) can Global{Read,Write}


        def thread_index_type_declaration(callbacks: mutable ThreadCallbackIndex&, owner: sview @source, owner_module: sview @source, owner_line: u32, declaration: Ast::Decl) -> void:
            can Memory.Allocate, Abort.Panic:
                can Global{Read,Write}:
                    thread_index_type_row(callbacks, owner, owner_module, owner_line, ThreadTypeSource.Declaration(declaration))


        def thread_index_type_expression(callbacks: mutable ThreadCallbackIndex&, owner: sview @source, owner_module: sview @source, owner_line: u32, expression: Ast::Expr) -> void:
            can Memory.Allocate, Abort.Panic:
                can Global{Read,Write}:
                    thread_index_type_row(callbacks, owner, owner_module, owner_line, ThreadTypeSource.Expression(expression))


        # Build a per-pass open-addressed spelling index. Each slot stores the first source
        # row for a name, and same-spelling overloads remain in a compact row chain so their
        # return types can be classified only when that callback spelling is queried.
        def thread_build_callback_name_index(callbacks: mutable ThreadCallbackIndex&) -> void can[Abort.Panic, Memory.Allocate]:
            callbacks.index_attempted <- true
            callbacks.index_built <- false
            callbacks.slots <- []
            return if callbacks.names.count != callbacks.modules.count or callbacks.names.count != callbacks.return_types.count or callbacks.names.count != callbacks.flags.count or callbacks.names.count != callbacks.classified.count or callbacks.names.count != callbacks.duplicate_next.count or callbacks.names.count != callbacks.duplicate_tail.count
            # The lookup's linear fallback is cheaper for tiny callback sets and avoids
            # allocating a slot array at all when the source declares no functions.
            return if:
                callbacks.names.count < THREAD_CALLBACK_INDEX_MIN_ROWS
                callbacks.names.count >= 2147483647.usize()
            capacity: usize = callbacks.names.count + callbacks.names.count + 1.usize()
            for _slot in 0..<capacity |callbacks|:
                callbacks.slots <- callbacks.slots.push(THREAD_CALLBACK_INDEX_NONE)
            for callback_row in 0..<callbacks.names.count |callback_row, callbacks, capacity|:
                callback_hash: u64 = name_hash(callbacks.names[callback_row])
                slot: mutable usize = callback_hash.usize() % capacity
                probes: mutable usize = 0.usize()
                slot_found: mutable bool = false
                while probes < capacity and not slot_found |slot, probes, slot_found, callback_row, callbacks, capacity|:
                    existing_row: u32 = callbacks.slots[slot]
                    if existing_row == THREAD_CALLBACK_INDEX_NONE:
                        callbacks.slots[slot] <- callback_row.u32()
                        slot_found <- true
                    elif callbacks.names[existing_row.usize()] == callbacks.names[callback_row]:
                        head_row: usize = existing_row.usize()
                        tail_row: usize = callbacks.duplicate_tail[head_row].usize()
                        return if tail_row >= callbacks.names.count
                        callbacks.duplicate_next[tail_row] <- callback_row.u32()
                        callbacks.duplicate_tail[head_row] <- callback_row.u32()
                        slot_found <- true
                    else:
                        slot <- slot + 1.usize()
                        slot <- 0.usize() if slot >= capacity
                        probes <- probes + 1.usize()
                return if not slot_found
            callbacks.index_built <- true



        # Build once for this pass: type checks recur for callback results, parameters, locals,
        # and nested fields. Hashes select a collision bucket; exact names and every duplicate
        # row remain visible to the resolver in their original source order.
        def thread_build_alias_name_index(table: lmut SymbolTable) -> void can[Abort.Panic, Memory.Allocate]:
            table.thread_alias_name_heads <- {}
            table.thread_alias_name_tails <- {}
            table.thread_alias_name_counts <- {}
            table.thread_alias_name_next <- []
            table.thread_alias_name_index_count <- table.type_alias_name.count
            table.thread_alias_name_index_built <- false
            return if table.type_alias_name.count >= THREAD_ALIAS_INDEX_NONE.usize()
            for alias_index in 0..<table.type_alias_name.count |alias_index, table|:
                table.thread_alias_name_next <- table.thread_alias_name_next.push(THREAD_ALIAS_INDEX_NONE)
                alias_hash: u64 = name_hash(table.type_alias_name[alias_index])
                prior_tail: mutable u32 = THREAD_ALIAS_INDEX_NONE
                can Global{Read,Write}:
                    prior_tail <- tail_row if table.thread_alias_name_tails.get(alias_hash) is tail_row
                if prior_tail != THREAD_ALIAS_INDEX_NONE:
                    table.thread_alias_name_next[prior_tail.usize()] <- alias_index.u32()
                else:
                    table.thread_alias_name_heads <- table.thread_alias_name_heads.put(alias_hash, alias_index.u32()) can Global{Read,Write}
                table.thread_alias_name_tails <- table.thread_alias_name_tails.put(alias_hash, alias_index.u32()) can Global{Read,Write}
                old_count: mutable u32 = 0
                can Global{Read,Write}:
                    old_count <- count if table.thread_alias_name_counts.get(alias_hash) is count
                table.thread_alias_name_counts <- table.thread_alias_name_counts.put(alias_hash, old_count + 1) can Global{Read,Write}
            table.thread_alias_name_index_built <- true


        def thread_alias_name_index_is_valid(table: SymbolTable&) -> bool:
            can Abort.Panic:
                return table.thread_alias_name_index_built and table.thread_alias_name_index_count == table.type_alias_name.count and table.thread_alias_name_next.count == table.type_alias_name.count and table.type_alias_target.count == table.type_alias_name.count and table.type_alias_module.count == table.type_alias_name.count and table.type_alias_declarations.count == table.type_alias_name.count


        def thread_has_submit_marker(annotations: darray[Ast::EnumAnnotation]&, pos: Ast::Pos) -> bool:
            can Abort.Panic:
                for annotation in annotations:
                    return true if annotation.name == "__submit" and annotation.offset == pos.offset
                return false


        def thread_restore_scope(names: mutable darray[sview @source]&, flags: mutable darray[bool]&, element_flags: mutable darray[bool]&, pool_types: mutable darray[sview @source]&, pool_mutability: mutable darray[bool]&, count: usize) -> void:
            can Abort.Panic:
                names <- names.truncate(count)
                flags <- flags.truncate(count)
                element_flags <- element_flags.truncate(count)
                pool_types <- pool_types.truncate(count)
                pool_mutability <- pool_mutability.truncate(count)


        def thread_push_pattern_binders(pattern: Ast::Pattern, may_reference: bool, names: mutable darray[sview @source]&, flags: mutable darray[bool]&, element_flags: mutable darray[bool]&, pool_types: mutable darray[sview @source]&, pool_mutability: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        names.push(name)
                        flags.push(may_reference)
                        element_flags.push(may_reference)
                        pool_types.push("")
                        pool_mutability.push(false)
                    Pattern.Rest(name):
                        if name != "":
                            names.push(name)
                            flags.push(may_reference)
                            element_flags.push(may_reference)
                            pool_types.push("")
                            pool_mutability.push(false)
                    Pattern.As(name, inner):
                        names.push(name)
                        flags.push(may_reference)
                        element_flags.push(may_reference)
                        pool_types.push("")
                        pool_mutability.push(false)
                        for item in inner |names, flags, element_flags, pool_types, pool_mutability|:
                            thread_push_pattern_binders(item, may_reference, names, flags, element_flags, pool_types, pool_mutability)
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Field(_, fields) | Pattern.Tuple(fields) | Pattern.Or(fields):
                        for item in fields |names, flags, element_flags, pool_types, pool_mutability|:
                            thread_push_pattern_binders(item, may_reference, names, flags, element_flags, pool_types, pool_mutability)
                    _:
                        pass


        def thread_push_arm_binders(arm: Ast::MatchArm, may_reference: bool, names: mutable darray[sview @source]&, flags: mutable darray[bool]&, element_flags: mutable darray[bool]&, pool_types: mutable darray[sview @source]&, pool_mutability: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                thread_push_pattern_binders(arm.pattern, may_reference, names, flags, element_flags, pool_types, pool_mutability)

        def type_contains_operator(type_expression: Ast::Expr, wanted: TokenKind) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return operator == wanted or type_contains_operator(operand, wanted)
                    Expr.Index(head, argument, line):
                        return type_contains_operator(head, wanted) or type_contains_operator(argument, wanted)
                    Expr.IndexN(head, arguments, line):
                        return true if type_contains_operator(head, wanted)
                        for argument in arguments:
                            return true if type_contains_operator(argument, wanted)
                        return false
                    Expr.Paren(inner, line):
                        return type_contains_operator(inner, wanted)
                    _:
                        return false


        def type_is_nonstatic_reference(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return type_contains_operator(type_expression, TokenKind.Ampersand) and not type_contains_operator(type_expression, TokenKind.Static)


        def thread_scope_module_matches(expression: Ast::Expr, module_name: sview, end: usize) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return false if end != name.len
                        for offset in 0..<end |offset, module_name, name|:
                            return false if module_name[offset] != name[offset]
                        return true
                    Expr.Scope(base, name, _):
                        name_length: usize = name.len
                        return false if end < name_length + 2.usize()
                        suffix_start: usize = end - name_length
                        for offset in 0..<name_length |offset, module_name, name, suffix_start|:
                            return false if module_name[suffix_start + offset] != name[offset]
                        return false if module_name[suffix_start - 1.usize()] != 58 or module_name[suffix_start - 2.usize()] != 58
                        return thread_scope_module_matches(base, module_name, suffix_start - 2.usize())
                    _:
                        return false


        # Hash a qualified scope directly from its AST segments using the same FNV-1a byte
        # sequence as name_hash. This lets the resolver probe only candidate declarations in
        # the matching hash bucket instead of rescanning module strings once per reference.
        def thread_scope_module_hash(expression: Ast::Expr) -> u64:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name_hash(name)
                    Expr.Scope(base, name, _):
                        hash: mutable u64 = thread_scope_module_hash(base)
                        hash <- (hash ^ 58) * SEMANTIC_HASH_PRIME
                        hash <- (hash ^ 58) * SEMANTIC_HASH_PRIME
                        for byte in name |hash|:
                            hash <- (hash ^ byte.u64()) * SEMANTIC_HASH_PRIME
                        return hash
                    _:
                        return 0


        # Keep one exact candidate per canonical module string. Hash collisions remain a
        # linked bucket and are checked by string equality before the source scope is matched.
        def thread_scope_module_index_add(callbacks: mutable ThreadCallbackIndex&, module_name: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if module_name == ""
                hash: u64 = name_hash(module_name)
                previous: mutable u32 = THREAD_CALLBACK_INDEX_NONE
                can Global{Read,Write}:
                    previous <- head if callbacks.scope_module_heads.get(hash) is head
                row: mutable u32 = previous
                while row != THREAD_CALLBACK_INDEX_NONE |row, callbacks, module_name|:
                    break if row.usize() >= callbacks.scope_module_names.count or row.usize() >= callbacks.scope_module_next.count
                    return if callbacks.scope_module_names[row.usize()] == module_name
                    row <- callbacks.scope_module_next[row.usize()]
                new_row: u32 = callbacks.scope_module_names.count.u32()
                callbacks.scope_module_names <- callbacks.scope_module_names.push(module_name)
                callbacks.scope_module_next <- callbacks.scope_module_next.push(previous)
                callbacks.scope_module_heads <- callbacks.scope_module_heads.put(hash, new_row) can Global{Read,Write}


        def thread_build_scope_module_index(callbacks: mutable ThreadCallbackIndex&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                callbacks.scope_module_names <- []
                callbacks.scope_module_next <- []
                callbacks.scope_module_heads <- {}
                callbacks.scope_module_index_built <- false
                callback_module_count: usize = callbacks.modules.count
                for module_index in 0..<callback_module_count |callbacks|:
                    module_name: sview = callbacks.modules[module_index]
                    thread_scope_module_index_add(callbacks, module_name) can Global{Read,Write}
                type_owner_module_count: usize = callbacks.type_owner_modules.count
                for module_index in 0..<type_owner_module_count |callbacks|:
                    module_name: sview = callbacks.type_owner_modules[module_index]
                    thread_scope_module_index_add(callbacks, module_name) can Global{Read,Write}
                for module_name in table.type_alias_module |callbacks|:
                    thread_scope_module_index_add(callbacks, module_name) can Global{Read,Write}
                for module_name in table.qualified_type_module |callbacks|:
                    thread_scope_module_index_add(callbacks, module_name) can Global{Read,Write}
                callbacks.scope_module_index_built <- callbacks.scope_module_names.count == callbacks.scope_module_next.count


        # Hash to the candidate bucket, then match the complete nested scope expression against
        # stable canonical names. This avoids flattening into and growing table storage.
        def thread_scope_module_name[@callbacks](expression: Ast::Expr, callbacks: mutable ThreadCallbackIndex& @callbacks, table: SymbolTable&) -> sview @callbacks:
            can Memory.Allocate, Abort.Panic:
                if not callbacks.scope_module_index_attempted:
                    callbacks.scope_module_index_attempted <- true
                    can Global{Read,Write}:
                        thread_build_scope_module_index(callbacks, table)
                return "" if not callbacks.scope_module_index_built or callbacks.scope_module_names.count != callbacks.scope_module_next.count
                hash: u64 = thread_scope_module_hash(expression)
                row: mutable u32 = THREAD_CALLBACK_INDEX_NONE
                can Global{Read,Write}:
                    row <- head if callbacks.scope_module_heads.get(hash) is head
                while row != THREAD_CALLBACK_INDEX_NONE |row, callbacks, expression|:
                    return callbacks.scope_module_names[row.usize()] if row.usize() < callbacks.scope_module_names.count and row.usize() < callbacks.scope_module_next.count and thread_scope_module_matches(expression, callbacks.scope_module_names[row.usize()], (callbacks.scope_module_names[row.usize()]).len)
                    break if row.usize() >= callbacks.scope_module_next.count
                    row <- callbacks.scope_module_next[row.usize()]
                return ""


        # Follow the by-value shape of a declared type and reject a nonstatic reference
        # anywhere in it. Thread payloads are copied by value, so a pointer nested in a
        # tuple, container, alias, or struct is just as frame-bound as a direct `T&`.
        # The bounded walk fails closed on excessive nesting; recursive named structs use
        # `visited` to terminate without treating a harmless recursive edge as a borrow.
        def thread_type_contains_nonstatic_reference(type_expression: Ast::Expr, table: SymbolTable&, callbacks: mutable ThreadCallbackIndex&, visited: mutable ThreadTypeVisitSet&, depth: usize, static_context: bool, generic_scope_line: u32, module_scope: sview @source) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                return true if depth > 16.usize()
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Ampersand or operator == TokenKind.Lmut:
                            return true if not static_context
                            return thread_type_contains_nonstatic_reference(operand, table, callbacks, visited, depth + 1.usize(), false, generic_scope_line, module_scope)
                        return thread_type_contains_nonstatic_reference(operand, table, callbacks, visited, depth + 1.usize(), static_context or operator == TokenKind.Static, generic_scope_line, module_scope)
                    Expr.Index(head, argument, _):
                        return true if thread_type_contains_nonstatic_reference(argument, table, callbacks, visited, depth + 1.usize(), false, generic_scope_line, module_scope)
                        return thread_type_contains_nonstatic_reference(head, table, callbacks, visited, depth + 1.usize(), static_context, generic_scope_line, module_scope)
                    Expr.Refinement(base, _, _):
                        return thread_type_contains_nonstatic_reference(base, table, callbacks, visited, depth + 1.usize(), static_context, generic_scope_line, module_scope)
                    Expr.IndexN(head, arguments, _):
                        return true if thread_type_contains_nonstatic_reference(head, table, callbacks, visited, depth + 1.usize(), static_context, generic_scope_line, module_scope)
                        for argument in arguments:
                            return true if thread_type_contains_nonstatic_reference(argument, table, callbacks, visited, depth + 1.usize(), false, generic_scope_line, module_scope)
                        return false
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        for element in elements:
                            return true if thread_type_contains_nonstatic_reference(element, table, callbacks, visited, depth + 1.usize(), false, generic_scope_line, module_scope)
                        return false
                    Expr.Paren(inner, _):
                        return thread_type_contains_nonstatic_reference(inner, table, callbacks, visited, depth + 1.usize(), static_context, generic_scope_line, module_scope)
                    Expr.Scope(module_expression, name, _):
                        module_scope_for_type: mutable sview = ""
                        can Global{Read,Write}:
                            module_scope_for_type <- thread_scope_module_name(module_expression, callbacks, table)
                        return true if module_scope_for_type == ""
                        return thread_named_type_contains_nonstatic_reference(name, module_scope_for_type, table, callbacks, visited, depth + 1.usize(), static_context, generic_scope_line)
                    Expr.Ident(name, _):
                        return thread_named_type_contains_nonstatic_reference(name, module_scope, table, callbacks, visited, depth + 1.usize(), static_context, generic_scope_line)
                    _:
                        return false


        def thread_generic_name_at_line(table: SymbolTable&, line: u32, name: sview) -> bool:
            can Abort.Panic:
                return false if line == 0 or line >= 2147483648
                encoded_bound_line: u32 = line + 2147483648
                for generic_index in 0..<table.generic_param_lines.count |line, name, table, encoded_bound_line|:
                    return true if generic_index < table.generic_param_names.count and table.generic_param_names[generic_index] == name and (table.generic_param_lines[generic_index] == line or table.generic_param_lines[generic_index] == encoded_bound_line)
                return false


        def thread_builtin_struct_name(name: sview) -> bool:
            can Abort.Panic:
                return name in {"ArenaFreeBlock", "Thread", "Task", "ThreadPool", "TaskGroup", "Mutex", "MutexGuard", "CondVar", "atomic", "Region", "Arena", "ArenaMark", "PackedStoreAllocResult", "PackedStoreIndexAllocResult", "StringView", "DynArray", "DynArrayView", "SplitView", "EnumerateView", "TreeKindFilteredView", "ChunksExactView", "TreeChildren", "TreeAttributeSeq", "NodeKey", "NodeTable", "DictBucket", "DynDict", "SetBucket", "DynSet", "darray", "dict", "set", "array", "view"}


        def thread_alias_row_contains_nonstatic_reference(alias_index: usize, name: sview, module_scope: sview @source, table: SymbolTable&, callbacks: mutable ThreadCallbackIndex&, visited: mutable ThreadTypeVisitSet&, depth: usize, static_context: bool) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                return false if:
                    alias_index >= table.type_alias_name.count
                    table.type_alias_name[alias_index] != name
                return true if alias_index >= table.type_alias_target.count or alias_index >= table.type_alias_module.count
                return false if table.type_alias_module[alias_index] != module_scope
                # Alias rows, declarations, and symbols are appended together. The declaration
                # id is the exact symbol row. Always inspect the full target AST because the
                # bare projection erases references and their static qualifier.
                return true if alias_index >= table.type_alias_declarations.count
                alias: TypeAliasDeclaration = table.type_alias_declarations[alias_index]
                return true if alias.module_owner != table.type_alias_module[alias_index]
                symbol_index: usize = alias.declaration_id.value.usize()
                return true if symbol_index >= table.symbols.count
                symbol: Symbol = table.symbols[symbol_index]
                return true if symbol.id.value != alias.declaration_id.value or symbol.name != name
                return thread_type_contains_nonstatic_reference(alias.target, table, callbacks, visited, depth + 1.usize(), static_context, alias.pos.line, module_scope)


        def thread_type_declaration_contains_nonstatic_reference(declaration: Ast::Decl, table: SymbolTable&, callbacks: mutable ThreadCallbackIndex&, visited: mutable ThreadTypeVisitSet&, depth: usize, generic_scope_line: u32, module_scope: sview @source) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                match declaration:
                    Decl.Struct(members: members, _):
                        for member in members:
                            return true if thread_type_contains_nonstatic_reference(member.type_expression, table, callbacks, visited, depth + 1.usize(), false, generic_scope_line, module_scope)
                        return false
                    Decl.Enum(variants: variants, _):
                        for variant in variants:
                            for field_type in variant.fields:
                                return true if thread_type_contains_nonstatic_reference(field_type, table, callbacks, visited, depth + 1.usize(), false, generic_scope_line, module_scope)
                        return false
                    _:
                        # Declaration rows are created only for structs and enums. If the
                        # source projection is inconsistent, fail closed on a possible borrow.
                        return true
