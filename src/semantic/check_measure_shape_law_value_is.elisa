# A measure law (`Vectorizes`) or shape law (`NoBoundsChecks`) is a per-FUNCTION performance
# protocol claimed via `fulfills`, never a per-value refinement — so `x is Vectorizes` /
# `xs is NoBoundsChecks` in a value position is malformed (docs/85 §8, docs/89). Flag any
# `EXPR is IDENT` whose IDENT names a builtin measure/shape law.
extend Semantic:
    private:
        # The law CLASS of a builtin performance law name ("measure"/"shape"), else "".
        def performance_law_class(name: sview) -> sview:
            can Abort.Panic:
                return when name:
                    "Vectorizes" -> "measure"
                    "NoBoundsChecks" -> "shape"
                    _ -> sview("", 0, 0)

        def measure_shape_check_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Is and right is Expr.Ident(law_name, ident_line):
                            law_class: sview = performance_law_class(law_name)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MeasureShapeLawInValueIs, name: law_name, line: line.line, expected: "", actual: law_class, expected_count: 1}) if law_class != ""
                        table <- measure_shape_check_expression(left, table)
                        table <- measure_shape_check_expression(right, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- measure_shape_check_expression(operand, table)
                    Expr.Paren(inner, paren_line):
                        table <- measure_shape_check_expression(inner, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- measure_shape_check_expression(callee, table)
                        for argument in arguments |table| -> table:
                            table <- measure_shape_check_expression(argument, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- measure_shape_check_expression(condition, table)
                        table <- measure_shape_check_expression(then_value, table)
                        table <- measure_shape_check_expression(else_value, table)
                    _:
                        pass

        def measure_shape_check_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- measure_shape_check_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- measure_shape_check_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- measure_shape_check_expression(value, table)
                        Stmt.Return(value, line):
                            table <- measure_shape_check_expression(returned, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- measure_shape_check_expression(condition, table)
                            table <- measure_shape_check_statements(then_body, table)
                            table <- measure_shape_check_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- measure_shape_check_expression(condition, table)
                            table <- measure_shape_check_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- measure_shape_check_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- measure_shape_check_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- measure_shape_check_expression(scrutinee, table)
                            for arm in arms |table| -> table:
                                table <- measure_shape_check_statements(arm.body, table)
                        _:
                            pass

        def measure_shape_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- measure_shape_check_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- measure_shape_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- measure_shape_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_measure_shape_law_value_is(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- measure_shape_walk(file.top_decls, table)
