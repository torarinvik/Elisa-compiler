# Nested-region store-escape — VALUE PROVENANCE: which region does a stored value actually live
# in? Its own `@region` annotation, the region of the receiver it was sliced or viewed from, or
# a region it was TAINTED with when a value from there flowed into it. The nesting position of
# that region is what the escape check compares. Continues check_region_escape.elisa.
include "./region_escape_view_method.elisa"

extend Semantic:
    private:
        const REGION_ESCAPE_ASCII_UPPER_A: u8 = 65
        const REGION_ESCAPE_ASCII_UPPER_Z: u8 = 90


        # The declared @region of a local, or "" when it carries none.
        def local_region_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                annotation_option: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, name, before_line)
                region_name: mutable sview @source = sview("", 0, 0)
                region_name <- present.region if annotation_option is present
                return region_name


        # Region parameter names can repeat in different functions. Require the
        # use site to lie inside the declaration's recorded source range.
        def region_escape_is_region_param(region: sview, annotations: darray[Ast::LocalRegionAnnotation]&, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any annotation in annotations where annotation.name == "__region_param" and annotation.region == region and annotation.line <= line and (annotation.end_line == 0 or line <= annotation.end_line)


        # The inferred region that owns a local binding, or "" when it was not
        # declared inside an active region. Newest entries win under shadowing.
        def region_escape_local_owner_region(names: darray[sview @source]&, regions: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    return regions[index] if index < regions.count and names[index] == name
                return ""



        # The nesting position of REGION on the nesting (outer regions have smaller indices),
        # with found=false when it is not an enclosing function-local region.
        def region_stack_position(nesting: darray[sview @source]&, region_name: sview) -> (found: bool, position: usize):
            can Abort.Panic:
                found_here: mutable bool = false
                position_here: mutable usize = 0
                while probe < nesting.count |probe: usize = 0, found_here, position_here|:
                    matched: bool = nesting[probe] == region_name
                    found_here <- true if matched
                    position_here <- probe if matched
                    probe <- probe + 1
                return (found_here, position_here)



        # The @region of a stored VALUE expression: a plain ident's region, or — for a list
        # literal `[v, …]` — the (single) inner region shared by its element idents. Returns
        # "" when no region-annotated value is found. Sound: only explicitly-annotated
        # idents contribute, so a region-less element yields no false region.
        def stored_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, nesting: darray[sview @source]&, line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        return local_region_name(annotations, name, line)
                    Expr.Paren(inner, paren_line):
                        return stored_value_region(inner, annotations, view_fns, nesting, line)
                    Expr.Index(head, argument, index_line):
                        # A view/element of a region-local (`v[i]`) lives in the base's region.
                        return stored_value_region(head, annotations, view_fns, nesting, line)
                    Expr.Slice(object, low, high, slice_line):
                        # A slice `v[0:n]` is a view into the base's region.
                        return stored_value_region(object, annotations, view_fns, nesting, line)
                    Expr.Field(object, field, field_line):
                        # A field of a region-local lives in the same region.
                        return stored_value_region(object, annotations, view_fns, nesting, line)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        # A view-producing method on a region-local (`d.as_sview()`,
                        # `d.as_cstr()`, `d.as_view()`, `d.as_slice()`) aliases the region's
                        # backing. Other methods (`d.count()`) return owned values → not a region
                        # dependency, so only these whitelisted borrows carry the region.
                        method_region: sview @source = stored_view_method_region(callee, annotations, view_fns, nesting, line)
                        return method_region if method_region != ""
                        # A VIEW-returning free function's result aliases its argument's
                        # backing (`escaped <- head(&v, 1)` with v @inner ties the view
                        # to inner) — cross-function view provenance.
                        called: sview @source = ident_name_of(callee)
                        return_region: mutable sview @source = sview("", 0, 0)
                        if called != "" and (any vf in view_fns where vf == called):
                            for argument in arguments |return_region|:
                                candidate2: sview @source = stored_value_region(view_arg_base(argument), annotations, view_fns, nesting, line)
                                return_region <- region_escape_deeper_region(return_region, candidate2, nesting)
                        return return_region
                    # `get OPT else return/raise/...` keeps the success value in a GetElse node;
                    # its recovery terminates, so the only value provenance is the guarded side.
                    Expr.GetElse(guarded, _, _):
                        return stored_value_region(guarded, annotations, view_fns, nesting, line)
                    Expr.Move(inner, move_line):
                        return stored_value_region(inner, annotations, view_fns, nesting, line)
                    # `&b[0]`, and through a pointer cast `(&b[0]).cast[u8&?]` (an Index of
                    # Field "cast"), addresses the region-local's backing (stage0 rejects the
                    # store with "value in region ... is stored into ...").
                    Expr.Unary(TokenKind.Ampersand, operand, _):
                        return stored_value_region(operand, annotations, view_fns, nesting, line)
                    Expr.Array(elements, array_line):
                        element_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview @source = stored_value_region(element, annotations, view_fns, nesting, line)
                            element_region <- region_escape_deeper_region(element_region, candidate, nesting)
                        return element_region
                    Expr.Tuple(elements, tuple_line):
                        element_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview @source = stored_value_region(element, annotations, view_fns, nesting, line)
                            element_region <- region_escape_deeper_region(element_region, candidate, nesting)
                        return element_region
                    Expr.Construct(type_expression, fields, construct_line):
                        field_region: mutable sview @source = sview("", 0, 0)
                        for field in fields |field_region|:
                            candidate: sview @source = stored_value_region(field.value, annotations, view_fns, nesting, line)
                            field_region <- region_escape_deeper_region(field_region, candidate, nesting)
                        return field_region
                    Expr.RecordUpdate(base, fields, update_line):
                        field_region: mutable sview @source = stored_value_region(base, annotations, view_fns, nesting, line)
                        for field in fields |field_region|:
                            candidate: sview @source = stored_value_region(field.value, annotations, view_fns, nesting, line)
                            field_region <- region_escape_deeper_region(field_region, candidate, nesting)
                        return field_region
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line, _):
                        element_region: mutable sview @source = stored_value_region(body, annotations, view_fns, nesting, line)
                        # The result owns a fresh collection buffer in the currently active
                        # region, even when its element expression is an unannotated binder.
                        if nesting.count > 0:
                            element_region <- region_escape_deeper_region(element_region, nesting[nesting.count - 1], nesting)
                        return element_region
                    Expr.If(condition, then_expression, else_expression, if_line):
                        # A conditional value `v if c else w` escapes if EITHER branch carries
                        # an inner region.
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return stored_value_region(then_expression, annotations, view_fns, nesting, line) if literal.value
                            return stored_value_region(else_expression, annotations, view_fns, nesting, line)
                        then_region: sview @source = stored_value_region(then_expression, annotations, view_fns, nesting, line)
                        else_region: sview @source = stored_value_region(else_expression, annotations, view_fns, nesting, line)
                        return region_escape_deeper_region(then_region, else_region, nesting)
                    # Keep the tail binder distinct from the input parameter: stage0
                    # otherwise recurses on the enclosing block when building the seed.
                    Expr.Block(block_statements, block_value, _, _):
                        return sview("", 0, 0) if region_escape_provenance_statements_terminate(block_statements)
                        return stored_value_region(block_value, annotations, view_fns, nesting, line)
                    Expr.Match(_, arms, _):
                        arm_region: mutable sview @source = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = stored_value_region(arm_value, annotations, view_fns, nesting, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        return arm_region
                    Expr.Catch(guarded, arms, _):
                        arm_region: mutable sview @source = stored_value_region(guarded, annotations, view_fns, nesting, line)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = stored_value_region(arm_value, annotations, view_fns, nesting, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        return arm_region
                    _:
                        return sview("", 0, 0)



        # The region of the receiver of a whitelisted view-producing method call, else "".
        def stored_view_method_region(callee: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, nesting: darray[sview @source]&, line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, method, field_line):
                        return stored_value_region(object, annotations, view_fns, nesting, line) if SemanticRegionEscapeViewMethod::is_view_method(method)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)



        # The root ident of a stored VALUE expression, through field/index/paren/move selectors
        # (`inner.xs` / `mid` -> "inner" / "mid"). A `copy(x)`/other-call value has no ident root,
        # so a deep copy correctly launders the region (returns "").
        def region_value_root_ident(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Ident(name, ident_line): name
                    Expr.Field(object, field_name, field_line): region_value_root_ident(object)
                    Expr.Index(object, index, index_line): region_value_root_ident(object)
                    # A slice `xs[0:2]` is a view into `xs`'s storage, like an index projection.
                    Expr.Slice(object, low, high, slice_line): region_value_root_ident(object)
                    Expr.Paren(inner, paren_line): region_value_root_ident(inner)
                    Expr.Move(inner, move_line): region_value_root_ident(inner)
                    _: sview("", 0, 0)



        # The region a name has been TAINTED with (a value from that region flowed into it, directly
        # or via a struct field/copy), or "".
        def region_taint_lookup(taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                while probe > 0 |probe: usize = taint_names.count|:
                    probe <- probe - 1
                    return taint_regions[probe] if probe < taint_regions.count and taint_names[probe] == name
                return ""



        # `Type.Variant(...)`: a capitalised type name and a capitalised variant. Constructing a
        # variant carries its payloads' regions, unlike a call that returns an owned value.
        def enum_variant_callee(callee: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, variant, field_pos):
                        type_name: sview @source = ident_name_of(object)
                        return type_name.len > 0 and variant.len > 0 and type_name[0] >= REGION_ESCAPE_ASCII_UPPER_A and type_name[0] <= REGION_ESCAPE_ASCII_UPPER_Z and variant[0] >= REGION_ESCAPE_ASCII_UPPER_A and variant[0] <= REGION_ESCAPE_ASCII_UPPER_Z
                    _:
                        return false

        # The region a stored value lives in: its own `@region` provenance, or — when it has none —
        # the region tainting its root ident (a struct copied/field-assigned from a region value).
        def effective_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                direct: sview @source = stored_value_region(value, annotations, view_fns, nesting, line)
                return direct if direct != ""
                root_taint: sview @source = region_taint_lookup(taint_names, taint_regions, region_value_root_ident(value))
                return root_taint if root_taint != ""
                return match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        effective_value_region(inner, annotations, view_fns, nesting, taint_names, taint_regions, line)
                    # A projection of a COMPUTED value (`pick(&xs).v`, `pick(&xs)[0:1]`) has no
                    # root ident to look up, so it inherits the projected value's region; whether
                    # the projected part carries a handle is region_escape_value_carries_handles'.
                    Expr.Field(projected, _, _) | Expr.Index(projected, _, _) | Expr.Slice(projected, _, _, _):
                        effective_value_region(projected, annotations, view_fns, nesting, taint_names, taint_regions, line)
                    # A view-producing call on a tainted local (`xs.as_sview()`) or a
                    # view-returning free function fed one (`pick(&xs)`) aliases that local's
                    # region; any other call returns an owned value and launders it.
                    Expr.Call(callee, arguments, argument_names, call_line):
                        view_call_region: mutable sview @source = sview("", 0, 0)
                        match callee:
                            Expr.Field(view_receiver, view_method, view_field_line):
                                if SemanticRegionEscapeViewMethod::is_view_method(view_method):
                                    view_call_region <- region_taint_lookup(taint_names, taint_regions, region_value_root_ident(view_receiver))
                                if enum_variant_callee(callee):
                                    for payload in arguments |view_call_region|:
                                        payload_region: sview @source = effective_value_region(payload, annotations, view_fns, nesting, taint_names, taint_regions, line)
                                        view_call_region <- region_escape_deeper_region(view_call_region, payload_region, nesting)
                            _:
                                called_view_fn: sview @source = ident_name_of(callee)
                                if called_view_fn != "" and (any view_fn in view_fns where view_fn == called_view_fn):
                                    for view_argument in arguments |view_call_region|:
                                        view_candidate: sview @source = region_taint_lookup(taint_names, taint_regions, region_value_root_ident(view_arg_base(view_argument)))
                                        view_call_region <- region_escape_deeper_region(view_call_region, view_candidate, nesting)
                        view_call_region
                    Expr.GetElse(guarded, _, _):
                        effective_value_region(guarded, annotations, view_fns, nesting, taint_names, taint_regions, line)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        nested_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |nested_region|:
                            candidate: sview @source = effective_value_region(element, annotations, view_fns, nesting, taint_names, taint_regions, line)
                            nested_region <- region_escape_deeper_region(nested_region, candidate, nesting)
                        nested_region
                    Expr.Construct(type_expression, fields, construct_line):
                        nested_region: mutable sview @source = sview("", 0, 0)
                        for field in fields |nested_region|:
                            candidate: sview @source = effective_value_region(field.value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                            nested_region <- region_escape_deeper_region(nested_region, candidate, nesting)
                        nested_region
                    Expr.Lambda(lambda_params, lambda_body, _):
                        # A closure capturing a region-tainted local lives in that region.
                        captured_name: sview @source = lvre_stmts_mention(lambda_body, taint_names, lambda_params)
                        region_taint_lookup(taint_names, taint_regions, captured_name) if captured_name != "" else sview("", 0, 0)
                    Expr.RecordUpdate(base, fields, update_line):
                        nested_region: mutable sview @source = effective_value_region(base, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        for field in fields |nested_region|:
                            candidate: sview @source = effective_value_region(field.value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                            nested_region <- region_escape_deeper_region(nested_region, candidate, nesting)
                        return nested_region
                    Expr.If(condition, then_value, else_value, if_line):
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return effective_value_region(then_value, annotations, view_fns, nesting, taint_names, taint_regions, line) if literal.value
                            return effective_value_region(else_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        then_region: sview @source = effective_value_region(then_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        else_region: sview @source = effective_value_region(else_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        region_escape_deeper_region(then_region, else_region, nesting)
                    Expr.Block(block_statements, block_value, _, _):
                        empty_container_fns: darray[sview @source] = []
                        result: (found: bool, position: usize) = region_escape_body_value_region(block_statements, block_value, annotations, view_fns, empty_container_fns, nesting, taint_names, taint_regions, line)
                        return nesting[result.position] if result.found
                        return sview("", 0, 0)
                    Expr.Match(_, arms, _):
                        arm_region: mutable sview @source = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = effective_value_region(arm_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        arm_region
                    Expr.Catch(guarded, arms, _):
                        arm_region: mutable sview @source = effective_value_region(guarded, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = effective_value_region(arm_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        arm_region
                    _:
                        sview("", 0, 0)



        def region_escape_provenance_literal_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            can Abort.Panic:
                return match expression:
                    Expr.BoolLit(value, _): (true, value)
                    Expr.Paren(inner, _): region_escape_provenance_literal_bool(inner)
                    _: (false, false)


        def region_escape_provenance_bool_pattern(pattern: Ast::Pattern, value: bool) -> (known: bool, matches: bool, catchall: bool):
            can Abort.Panic:
                return match pattern:
                    Pattern.Literal(literal):
                        if literal == "true": (true, value, false)
                        elif literal == "false": (true, not value, false)
                        else: (false, false, false)
                    Pattern.Wildcard | Pattern.Binding(_): (true, true, true)
                    _: (false, false, false)



        def region_escape_provenance_pattern_is_match_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Or(options):
                        return any option in options where region_escape_provenance_pattern_is_match_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where region_escape_provenance_pattern_is_match_catchall(wrapped)
                    _:
                        return false


        # Provenance collection has no SymbolTable parameter for enum coverage, so narrower
        # coverage shapes stay conservative. Boolean literal arms are enough to prove the
        # two-value domain exhaustive when each reachable arm terminates.
        def region_escape_provenance_match_arms_terminate(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count == 0
                literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(scrutinee)
                if literal.known:
                    arm_index: mutable usize = 0.usize()
                    while arm_index < arms.count |arm_index, arms, literal|:
                        arm: Ast::MatchArm = arms[arm_index]
                        if region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index):
                            return false if not (arm.guard is Ast::Expr.Absent) and not region_escape_provenance_expression_terminates(arm.guard)
                            return false if not region_escape_provenance_statements_terminate(arm.body)
                            return true if arm.guard is Ast::Expr.Absent or region_escape_provenance_expression_terminates(arm.guard)
                        arm_index <- arm_index + 1.usize()
                    return false
                covers_true: mutable bool = false
                covers_false: mutable bool = false
                for arm in arms:
                    guard_terminates: bool = region_escape_provenance_expression_terminates(arm.guard)
                    return false if not (arm.guard is Ast::Expr.Absent) and not guard_terminates and not region_escape_provenance_statements_terminate(arm.body)
                    return false if (arm.guard is Ast::Expr.Absent or guard_terminates) and not region_escape_provenance_statements_terminate(arm.body)
                    if arm.guard is Ast::Expr.Absent or guard_terminates:
                        true_pattern: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(arm.pattern, true)
                        false_pattern: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(arm.pattern, false)
                        covers_true <- true if true_pattern.known and true_pattern.matches
                        covers_false <- true if false_pattern.known and false_pattern.matches
                        return true if true_pattern.catchall or false_pattern.catchall
                covers_true and covers_false


        # The shared reachability helpers take an owned array. Match arms inside an AST
        # node are borrowed, so copy them into this helper's source region before querying.
        def region_escape_provenance_match_arm_reachable(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm]&, target_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                owned_arms: mutable darray[Ast::MatchArm] @source = []
                for arm in arms |owned_arms|:
                    owned_arms.push(arm)
                return progress_match_arm_reachable(scrutinee, owned_arms, target_index)


        def region_escape_provenance_catch_arm_reachable(arms: darray[Ast::MatchArm]&, target_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                owned_arms: mutable darray[Ast::MatchArm] @source = []
                for arm in arms |owned_arms|:
                    owned_arms.push(arm)
                return progress_catch_arm_reachable(owned_arms, target_index)


        # These three spellings are lexer keywords, so their bare AST names cannot be
        # shadowed by a user binding. Other calls remain fallthrough without symbol lookup.
        def region_escape_provenance_abort_callee(callee: Ast::Expr) -> bool:
            can Abort.Panic:
                return match callee:
                    Expr.Ident(name, _): name == "panic" or name == "raise" or name == "error"
                    Expr.Paren(inner, _): region_escape_provenance_abort_callee(inner)
                    _: false


        def region_escape_provenance_catchable_raise_callee(callee: Ast::Expr) -> bool:
            can Abort.Panic:
                return match callee:
                    Expr.Ident(name, _): name == "raise"
                    Expr.Paren(inner, _): region_escape_provenance_catchable_raise_callee(inner)
                    _: false


        # Scan eager expressions in evaluation order. A catchable raise is reachable if a
        # child can raise before an earlier child is guaranteed to abort.
        def region_escape_provenance_catchable_raise_sequence(expressions: darray[Ast::Expr]&) -> (reaches_end: bool, found_raise: bool):
            can Memory.Allocate, Abort.Panic:
                empty_catch_lines: darray[u32] @source = []
                region_escape_provenance_catchable_raise_sequence_with_metadata(expressions, empty_catch_lines)


