# Nested-region store-escape — VALUE PROVENANCE: which region does a stored value actually live
# in? Its own `@region` annotation, the region of the receiver it was sliced or viewed from, or
# a region it was TAINTED with when a value from there flowed into it. The nesting position of
# that region is what the escape check compares. Continues check_region_escape.elisa.
include "./region_escape_view_method.elisa"

extend Semantic:
    private:
        const REGION_ESCAPE_ASCII_UPPER_A: u8 = 65
        const REGION_ESCAPE_ASCII_UPPER_Z: u8 = 90


        # The declared @region of a local, or "" when it carries none.
        def local_region_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                annotation_option: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, name, before_line)
                region_name: mutable sview @source = sview("", 0, 0)
                region_name <- present.region if annotation_option is present
                return region_name


        # Region parameter names can repeat in different functions. Require the
        # use site to lie inside the declaration's recorded source range.
        def region_escape_is_region_param(region: sview, annotations: darray[Ast::LocalRegionAnnotation]&, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any annotation in annotations where annotation.name == "__region_param" and annotation.region == region and annotation.line <= line and (annotation.end_line == 0 or line <= annotation.end_line)


        # The inferred region that owns a local binding, or "" when it was not
        # declared inside an active region. Newest entries win under shadowing.
        def region_escape_local_owner_region(names: darray[sview @source]&, regions: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    return regions[index] if index < regions.count and names[index] == name
                return ""



        # The nesting position of REGION on the nesting (outer regions have smaller indices),
        # with found=false when it is not an enclosing function-local region.
        def region_stack_position(nesting: darray[sview @source]&, region_name: sview) -> (found: bool, position: usize):
            can Abort.Panic:
                found_here: mutable bool = false
                position_here: mutable usize = 0
                while probe < nesting.count |probe: usize = 0, found_here, position_here|:
                    matched: bool = nesting[probe] == region_name
                    found_here <- true if matched
                    position_here <- probe if matched
                    probe <- probe + 1
                return (found_here, position_here)



        # The @region of a stored VALUE expression: a plain ident's region, or — for a list
        # literal `[v, …]` — the (single) inner region shared by its element idents. Returns
        # "" when no region-annotated value is found. Sound: only explicitly-annotated
        # idents contribute, so a region-less element yields no false region.
        def stored_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, nesting: darray[sview @source]&, line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        return local_region_name(annotations, name, line)
                    Expr.Paren(inner, paren_line):
                        return stored_value_region(inner, annotations, view_fns, nesting, line)
                    Expr.Index(head, argument, index_line):
                        # A view/element of a region-local (`v[i]`) lives in the base's region.
                        return stored_value_region(head, annotations, view_fns, nesting, line)
                    Expr.Slice(object, low, high, slice_line):
                        # A slice `v[0:n]` is a view into the base's region.
                        return stored_value_region(object, annotations, view_fns, nesting, line)
                    Expr.Field(object, field, field_line):
                        # A field of a region-local lives in the same region.
                        return stored_value_region(object, annotations, view_fns, nesting, line)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        # A view-producing method on a region-local (`d.as_sview()`,
                        # `d.as_cstr()`, `d.as_view()`, `d.as_slice()`) aliases the region's
                        # backing. Other methods (`d.count()`) return owned values → not a region
                        # dependency, so only these whitelisted borrows carry the region.
                        method_region: sview @source = stored_view_method_region(callee, annotations, view_fns, nesting, line)
                        return method_region if method_region != ""
                        # A VIEW-returning free function's result aliases its argument's
                        # backing (`escaped <- head(&v, 1)` with v @inner ties the view
                        # to inner) — cross-function view provenance.
                        called: sview @source = ident_name_of(callee)
                        return_region: mutable sview @source = sview("", 0, 0)
                        if called != "" and (any vf in view_fns where vf == called):
                            for argument in arguments |return_region|:
                                candidate2: sview @source = stored_value_region(view_arg_base(argument), annotations, view_fns, nesting, line)
                                return_region <- region_escape_deeper_region(return_region, candidate2, nesting)
                        return return_region
                    # `get OPT else return/raise/...` keeps the success value in a GetElse node;
                    # its recovery terminates, so the only value provenance is the guarded side.
                    Expr.GetElse(guarded, _, _):
                        return stored_value_region(guarded, annotations, view_fns, nesting, line)
                    Expr.Move(inner, move_line):
                        return stored_value_region(inner, annotations, view_fns, nesting, line)
                    # `&b[0]`, and through a pointer cast `(&b[0]).cast[u8&?]` (an Index of
                    # Field "cast"), addresses the region-local's backing (stage0 rejects the
                    # store with "value in region ... is stored into ...").
                    Expr.Unary(TokenKind.Ampersand, operand, _):
                        return stored_value_region(operand, annotations, view_fns, nesting, line)
                    Expr.Array(elements, array_line):
                        element_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview @source = stored_value_region(element, annotations, view_fns, nesting, line)
                            element_region <- region_escape_deeper_region(element_region, candidate, nesting)
                        return element_region
                    Expr.Tuple(elements, tuple_line):
                        element_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview @source = stored_value_region(element, annotations, view_fns, nesting, line)
                            element_region <- region_escape_deeper_region(element_region, candidate, nesting)
                        return element_region
                    Expr.Construct(type_expression, fields, construct_line):
                        field_region: mutable sview @source = sview("", 0, 0)
                        for field in fields |field_region|:
                            candidate: sview @source = stored_value_region(field.value, annotations, view_fns, nesting, line)
                            field_region <- region_escape_deeper_region(field_region, candidate, nesting)
                        return field_region
                    Expr.RecordUpdate(base, fields, update_line):
                        field_region: mutable sview @source = stored_value_region(base, annotations, view_fns, nesting, line)
                        for field in fields |field_region|:
                            candidate: sview @source = stored_value_region(field.value, annotations, view_fns, nesting, line)
                            field_region <- region_escape_deeper_region(field_region, candidate, nesting)
                        return field_region
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line, _):
                        element_region: mutable sview @source = stored_value_region(body, annotations, view_fns, nesting, line)
                        # The result owns a fresh collection buffer in the currently active
                        # region, even when its element expression is an unannotated binder.
                        if nesting.count > 0:
                            element_region <- region_escape_deeper_region(element_region, nesting[nesting.count - 1], nesting)
                        return element_region
                    Expr.If(condition, then_expression, else_expression, if_line):
                        # A conditional value `v if c else w` escapes if EITHER branch carries
                        # an inner region.
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return stored_value_region(then_expression, annotations, view_fns, nesting, line) if literal.value
                            return stored_value_region(else_expression, annotations, view_fns, nesting, line)
                        then_region: sview @source = stored_value_region(then_expression, annotations, view_fns, nesting, line)
                        else_region: sview @source = stored_value_region(else_expression, annotations, view_fns, nesting, line)
                        return region_escape_deeper_region(then_region, else_region, nesting)
                    # Keep the tail binder distinct from the input parameter: stage0
                    # otherwise recurses on the enclosing block when building the seed.
                    Expr.Block(block_statements, block_value, _, _):
                        return sview("", 0, 0) if region_escape_provenance_statements_terminate(block_statements)
                        return stored_value_region(block_value, annotations, view_fns, nesting, line)
                    Expr.Match(_, arms, _):
                        arm_region: mutable sview @source = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = stored_value_region(arm_value, annotations, view_fns, nesting, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        return arm_region
                    Expr.Catch(guarded, arms, _):
                        arm_region: mutable sview @source = stored_value_region(guarded, annotations, view_fns, nesting, line)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = stored_value_region(arm_value, annotations, view_fns, nesting, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        return arm_region
                    _:
                        return sview("", 0, 0)



        # The region of the receiver of a whitelisted view-producing method call, else "".
        def stored_view_method_region(callee: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, nesting: darray[sview @source]&, line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, method, field_line):
                        return stored_value_region(object, annotations, view_fns, nesting, line) if SemanticRegionEscapeViewMethod::is_view_method(method)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)



        # The root ident of a stored VALUE expression, through field/index/paren/move selectors
        # (`inner.xs` / `mid` -> "inner" / "mid"). A `copy(x)`/other-call value has no ident root,
        # so a deep copy correctly launders the region (returns "").
        def region_value_root_ident(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Ident(name, ident_line): name
                    Expr.Field(object, field_name, field_line): region_value_root_ident(object)
                    Expr.Index(object, index, index_line): region_value_root_ident(object)
                    # A slice `xs[0:2]` is a view into `xs`'s storage, like an index projection.
                    Expr.Slice(object, low, high, slice_line): region_value_root_ident(object)
                    Expr.Paren(inner, paren_line): region_value_root_ident(inner)
                    Expr.Move(inner, move_line): region_value_root_ident(inner)
                    _: sview("", 0, 0)



        # The region a name has been TAINTED with (a value from that region flowed into it, directly
        # or via a struct field/copy), or "".
        def region_taint_lookup(taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                while probe > 0 |probe: usize = taint_names.count|:
                    probe <- probe - 1
                    return taint_regions[probe] if probe < taint_regions.count and taint_names[probe] == name
                return ""



        # `Type.Variant(...)`: a capitalised type name and a capitalised variant. Constructing a
        # variant carries its payloads' regions, unlike a call that returns an owned value.
        def enum_variant_callee(callee: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, variant, field_pos):
                        type_name: sview @source = ident_name_of(object)
                        return type_name.len > 0 and variant.len > 0 and type_name[0] >= REGION_ESCAPE_ASCII_UPPER_A and type_name[0] <= REGION_ESCAPE_ASCII_UPPER_Z and variant[0] >= REGION_ESCAPE_ASCII_UPPER_A and variant[0] <= REGION_ESCAPE_ASCII_UPPER_Z
                    _:
                        return false

        # The region a stored value lives in: its own `@region` provenance, or — when it has none —
        # the region tainting its root ident (a struct copied/field-assigned from a region value).
        def effective_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, line: u32) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                direct: sview @source = stored_value_region(value, annotations, view_fns, nesting, line)
                return direct if direct != ""
                root_taint: sview @source = region_taint_lookup(taint_names, taint_regions, region_value_root_ident(value))
                return root_taint if root_taint != ""
                return match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        effective_value_region(inner, annotations, view_fns, nesting, taint_names, taint_regions, line)
                    # A projection of a COMPUTED value (`pick(&xs).v`, `pick(&xs)[0:1]`) has no
                    # root ident to look up, so it inherits the projected value's region; whether
                    # the projected part carries a handle is region_escape_value_carries_handles'.
                    Expr.Field(projected, _, _) | Expr.Index(projected, _, _) | Expr.Slice(projected, _, _, _):
                        effective_value_region(projected, annotations, view_fns, nesting, taint_names, taint_regions, line)
                    # A view-producing call on a tainted local (`xs.as_sview()`) or a
                    # view-returning free function fed one (`pick(&xs)`) aliases that local's
                    # region; any other call returns an owned value and launders it.
                    Expr.Call(callee, arguments, argument_names, call_line):
                        view_call_region: mutable sview @source = sview("", 0, 0)
                        match callee:
                            Expr.Field(view_receiver, view_method, view_field_line):
                                if SemanticRegionEscapeViewMethod::is_view_method(view_method):
                                    view_call_region <- region_taint_lookup(taint_names, taint_regions, region_value_root_ident(view_receiver))
                                if enum_variant_callee(callee):
                                    for payload in arguments |view_call_region|:
                                        payload_region: sview @source = effective_value_region(payload, annotations, view_fns, nesting, taint_names, taint_regions, line)
                                        view_call_region <- region_escape_deeper_region(view_call_region, payload_region, nesting)
                            _:
                                called_view_fn: sview @source = ident_name_of(callee)
                                if called_view_fn != "" and (any view_fn in view_fns where view_fn == called_view_fn):
                                    for view_argument in arguments |view_call_region|:
                                        view_candidate: sview @source = region_taint_lookup(taint_names, taint_regions, region_value_root_ident(view_arg_base(view_argument)))
                                        view_call_region <- region_escape_deeper_region(view_call_region, view_candidate, nesting)
                        view_call_region
                    Expr.GetElse(guarded, _, _):
                        effective_value_region(guarded, annotations, view_fns, nesting, taint_names, taint_regions, line)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        nested_region: mutable sview @source = sview("", 0, 0)
                        for element in elements |nested_region|:
                            candidate: sview @source = effective_value_region(element, annotations, view_fns, nesting, taint_names, taint_regions, line)
                            nested_region <- region_escape_deeper_region(nested_region, candidate, nesting)
                        nested_region
                    Expr.Construct(type_expression, fields, construct_line):
                        nested_region: mutable sview @source = sview("", 0, 0)
                        for field in fields |nested_region|:
                            candidate: sview @source = effective_value_region(field.value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                            nested_region <- region_escape_deeper_region(nested_region, candidate, nesting)
                        nested_region
                    Expr.Lambda(lambda_params, lambda_body, _):
                        # A closure capturing a region-tainted local lives in that region.
                        captured_name: sview @source = lvre_stmts_mention(lambda_body, taint_names, lambda_params)
                        region_taint_lookup(taint_names, taint_regions, captured_name) if captured_name != "" else sview("", 0, 0)
                    Expr.RecordUpdate(base, fields, update_line):
                        nested_region: mutable sview @source = effective_value_region(base, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        for field in fields |nested_region|:
                            candidate: sview @source = effective_value_region(field.value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                            nested_region <- region_escape_deeper_region(nested_region, candidate, nesting)
                        return nested_region
                    Expr.If(condition, then_value, else_value, if_line):
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return effective_value_region(then_value, annotations, view_fns, nesting, taint_names, taint_regions, line) if literal.value
                            return effective_value_region(else_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        then_region: sview @source = effective_value_region(then_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        else_region: sview @source = effective_value_region(else_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        region_escape_deeper_region(then_region, else_region, nesting)
                    Expr.Block(block_statements, block_value, _, _):
                        empty_container_fns: darray[sview @source] = []
                        result: (found: bool, position: usize) = region_escape_body_value_region(block_statements, block_value, annotations, view_fns, empty_container_fns, nesting, taint_names, taint_regions, line)
                        return nesting[result.position] if result.found
                        return sview("", 0, 0)
                    Expr.Match(_, arms, _):
                        arm_region: mutable sview @source = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = effective_value_region(arm_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        arm_region
                    Expr.Catch(guarded, arms, _):
                        arm_region: mutable sview @source = effective_value_region(guarded, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0 or region_escape_provenance_statements_terminate(arm.body)
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview @source = effective_value_region(arm_value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                                    arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                                _:
                                    pass
                        arm_region
                    _:
                        sview("", 0, 0)



        def region_escape_provenance_literal_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            can Abort.Panic:
                return match expression:
                    Expr.BoolLit(value, _): (true, value)
                    Expr.Paren(inner, _): region_escape_provenance_literal_bool(inner)
                    _: (false, false)


        def region_escape_provenance_bool_pattern(pattern: Ast::Pattern, value: bool) -> (known: bool, matches: bool, catchall: bool):
            can Abort.Panic:
                return match pattern:
                    Pattern.Literal(literal):
                        if literal == "true": (true, value, false)
                        elif literal == "false": (true, not value, false)
                        else: (false, false, false)
                    Pattern.Wildcard | Pattern.Binding(_): (true, true, true)
                    _: (false, false, false)



        def region_escape_provenance_pattern_is_match_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Or(options):
                        return any option in options where region_escape_provenance_pattern_is_match_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where region_escape_provenance_pattern_is_match_catchall(wrapped)
                    _:
                        return false


        # Provenance collection has no SymbolTable parameter for enum coverage, so narrower
        # coverage shapes stay conservative. Stop at the first unguarded catch-all because
        # later arms cannot affect whether a normal match result is reachable.
        def region_escape_provenance_match_arms_terminate(arms: darray[Ast::MatchArm]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count == 0
                for arm in arms:
                    return false if not (arm.guard is Ast::Expr.Absent)
                    return false if not region_escape_provenance_statements_terminate(arm.body)
                    return true if region_escape_provenance_pattern_is_match_catchall(arm.pattern)
                return false


        # The shared reachability helpers take an owned array. Match arms inside an AST
        # node are borrowed, so copy them into this helper's source region before querying.
        def region_escape_provenance_match_arm_reachable(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm]&, target_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                owned_arms: mutable darray[Ast::MatchArm] @source = []
                for arm in arms |owned_arms|:
                    owned_arms.push(arm)
                return progress_match_arm_reachable(scrutinee, owned_arms, target_index)


        def region_escape_provenance_catch_arm_reachable(arms: darray[Ast::MatchArm]&, target_index: usize) -> bool:
            can Memory.Allocate, Abort.Panic:
                owned_arms: mutable darray[Ast::MatchArm] @source = []
                for arm in arms |owned_arms|:
                    owned_arms.push(arm)
                return progress_catch_arm_reachable(owned_arms, target_index)


        # These three spellings are lexer keywords, so their bare AST names cannot be
        # shadowed by a user binding. Other calls remain fallthrough without symbol lookup.
        def region_escape_provenance_abort_callee(callee: Ast::Expr) -> bool:
            can Abort.Panic:
                return match callee:
                    Expr.Ident(name, _): name == "panic" or name == "raise" or name == "error"
                    Expr.Paren(inner, _): region_escape_provenance_abort_callee(inner)
                    _: false


        def region_escape_provenance_catchable_raise_callee(callee: Ast::Expr) -> bool:
            can Abort.Panic:
                return match callee:
                    Expr.Ident(name, _): name == "raise"
                    Expr.Paren(inner, _): region_escape_provenance_catchable_raise_callee(inner)
                    _: false


        # Scan eager expressions in evaluation order. A catchable raise is reachable if a
        # child can raise before an earlier child is guaranteed to abort.
        def region_escape_provenance_catchable_raise_sequence(expressions: darray[Ast::Expr]&) -> (reaches_end: bool, found_raise: bool):
            can Memory.Allocate, Abort.Panic:
                for expression in expressions:
                    return (false, true) if region_escape_provenance_catchable_raise(expression)
                    return (false, false) if region_escape_provenance_expression_terminates(expression)
                return (true, false)


        def region_escape_provenance_catchable_raise_field_values(fields: darray[Ast::FieldInit]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for field in fields:
                    return true if region_escape_provenance_catchable_raise(field.value)
                    return false if region_escape_provenance_expression_terminates(field.value)
                return false


        def region_escape_provenance_catchable_raise_match_arms(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                arm_index: mutable usize = 0.usize()
                while arm_index < arms.count |arm_index, arms|:
                    arm: Ast::MatchArm = arms[arm_index]
                    if not region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index):
                        arm_index <- arm_index + 1.usize()
                        continue
                    return true if region_escape_provenance_catchable_raise(arm.guard)
                    if not (arm.guard is Ast::Expr.Absent):
                        guard_bool: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                        if (guard_bool.known and not guard_bool.value) or region_escape_provenance_expression_terminates(arm.guard):
                            arm_index <- arm_index + 1.usize()
                            continue
                    return true if region_escape_provenance_catchable_raise_statements(arm.body)
                    return false if arm.guard is Ast::Expr.Absent and region_escape_provenance_pattern_is_match_catchall(arm.pattern)
                    arm_index <- arm_index + 1.usize()
                return false


        def region_escape_provenance_catchable_raise_statements(statements: darray[Ast::Stmt]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, _):
                            return true if region_escape_provenance_catchable_raise(expression)
                        Stmt.Return(value, _):
                            return true if value is present_value and region_escape_provenance_catchable_raise(present_value)
                        Stmt.VarDecl(_, type_expression, value, _):
                            return true if region_escape_provenance_catchable_raise(type_expression) or region_escape_provenance_catchable_raise(value)
                        Stmt.Assign(target, _, value, _):
                            return true if region_escape_provenance_catchable_raise(target) or region_escape_provenance_catchable_raise(value)
                        Stmt.If(condition, then_body, else_body, _):
                            return true if region_escape_provenance_catchable_raise(condition)
                            return false if region_escape_provenance_expression_terminates(condition)
                            literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                            if literal.known:
                                if literal.value:
                                    return true if region_escape_provenance_catchable_raise_statements(then_body)
                                else:
                                    return true if region_escape_provenance_catchable_raise_statements(else_body)
                            else:
                                return true if region_escape_provenance_catchable_raise_statements(then_body) or region_escape_provenance_catchable_raise_statements(else_body)
                        Stmt.While(condition, body, _):
                            return true if region_escape_provenance_catchable_raise(condition)
                            return false if region_escape_provenance_expression_terminates(condition)
                            literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                            return false if literal.known and not literal.value
                            return true if region_escape_provenance_catchable_raise_statements(body)
                        Stmt.For(_, _, iterable, body, _):
                            return true if region_escape_provenance_catchable_raise(iterable)
                            return false if region_escape_provenance_expression_terminates(iterable)
                            return true if region_escape_provenance_catchable_raise_statements(body)
                        Stmt.Block(_, _, _, body, _):
                            return true if region_escape_provenance_catchable_raise_statements(body)
                        Stmt.Match(scrutinee, arms, _):
                            return true if region_escape_provenance_catchable_raise(scrutinee)
                            return false if region_escape_provenance_expression_terminates(scrutinee)
                            return true if region_escape_provenance_catchable_raise_match_arms(scrutinee, arms)
                        Stmt.Contract(_, expression, _):
                            return true if region_escape_provenance_catchable_raise(expression)
                        _:
                            pass
                    return false if region_escape_provenance_statement_terminates(statement)
                return false


        def region_escape_provenance_catchable_raise(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Call(callee, arguments, _, _):
                        direct_raise_callee: bool = region_escape_provenance_catchable_raise_callee(callee)
                        return true if region_escape_provenance_catchable_raise(callee)
                        return false if not region_escape_provenance_abort_callee(callee) and region_escape_provenance_expression_terminates(callee)
                        argument_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_sequence(arguments)
                        argument_facts.found_raise or (argument_facts.reaches_end and direct_raise_callee)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        region_escape_provenance_catchable_raise_sequence(runtime_children).found_raise
                    Expr.If(condition, then_value, else_value, _):
                        return true if region_escape_provenance_catchable_raise(condition)
                        return false if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_catchable_raise(then_value) if literal.value
                            return region_escape_provenance_catchable_raise(else_value)
                        region_escape_provenance_catchable_raise(then_value) or region_escape_provenance_catchable_raise(else_value)
                    Expr.Match(scrutinee, arms, _):
                        return true if region_escape_provenance_catchable_raise(scrutinee)
                        return false if region_escape_provenance_expression_terminates(scrutinee)
                        region_escape_provenance_catchable_raise_match_arms(scrutinee, arms)
                    Expr.Block(statements, value, _, _):
                        return true if region_escape_provenance_catchable_raise_statements(statements)
                        return false if region_escape_provenance_statements_terminate(statements)
                        region_escape_provenance_catchable_raise(value)
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        region_escape_provenance_catchable_raise(inner)
                    Expr.Binary(left, operator, right, _):
                        return true if region_escape_provenance_catchable_raise(left)
                        return false if region_escape_provenance_expression_terminates(left)
                        right_required: mutable bool = operator != TokenKind.And and operator != TokenKind.Or
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(left)
                        right_required <- not literal.known or literal.value if operator == TokenKind.And
                        right_required <- not literal.known or not literal.value if operator == TokenKind.Or
                        right_required and region_escape_provenance_catchable_raise(right)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        region_escape_provenance_catchable_raise(object)
                    Expr.Index(object, index, _):
                        return true if region_escape_provenance_catchable_raise(object)
                        return false if region_escape_provenance_expression_terminates(object)
                        region_escape_provenance_catchable_raise(index)
                    Expr.IndexN(object, indices, _):
                        return true if region_escape_provenance_catchable_raise(object)
                        return false if region_escape_provenance_expression_terminates(object)
                        region_escape_provenance_catchable_raise_sequence(indices).found_raise
                    Expr.Slice(object, low, high, _):
                        return true if region_escape_provenance_catchable_raise(object)
                        return false if region_escape_provenance_expression_terminates(object)
                        return true if region_escape_provenance_catchable_raise(low)
                        return false if region_escape_provenance_expression_terminates(low)
                        region_escape_provenance_catchable_raise(high)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        region_escape_provenance_catchable_raise_sequence(elements).found_raise
                    Expr.DictLit(entries, _):
                        for entry in entries:
                            return true if region_escape_provenance_catchable_raise(entry.key)
                            return false if region_escape_provenance_expression_terminates(entry.key)
                            return true if region_escape_provenance_catchable_raise(entry.value)
                            return false if region_escape_provenance_expression_terminates(entry.value)
                        return false
                    Expr.Construct(_, fields, _):
                        region_escape_provenance_catchable_raise_field_values(fields)
                    Expr.RecordUpdate(base, fields, _):
                        return true if region_escape_provenance_catchable_raise(base)
                        return false if region_escape_provenance_expression_terminates(base)
                        region_escape_provenance_catchable_raise_field_values(fields)
                    Expr.GetElse(guarded, recovery, _):
                        return true if region_escape_provenance_catchable_raise(guarded)
                        return false if region_escape_provenance_expression_terminates(guarded)
                        region_escape_provenance_catchable_raise_statements(recovery)
                    Expr.Catch(guarded, arms, _):
                        guarded_aborts: bool = region_escape_provenance_expression_terminates(guarded)
                        guarded_may_raise: bool = region_escape_provenance_catchable_raise(guarded)
                        return false if guarded_aborts and not guarded_may_raise
                        errors_handled: mutable bool = false
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms, guarded_aborts, guarded_may_raise, errors_handled|:
                            arm: Ast::MatchArm = arms[arm_index]
                            arm_reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index)
                            arm_reachable <- false if guarded_aborts and arm_index == 0
                            arm_reachable <- false if arm_index > 0 and not guarded_may_raise
                            if arm_reachable:
                                return true if region_escape_provenance_catchable_raise(arm.guard)
                                if not (arm.guard is Ast::Expr.Absent):
                                    guard_bool: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                                    if (guard_bool.known and not guard_bool.value) or region_escape_provenance_expression_terminates(arm.guard):
                                        arm_index <- arm_index + 1.usize()
                                        continue
                                return true if region_escape_provenance_catchable_raise_statements(arm.body)
                                errors_handled <- true if arm_index > 0 and arm.guard is Ast::Expr.Absent and region_escape_provenance_pattern_is_error_catchall(arm.pattern)
                            arm_index <- arm_index + 1.usize()
                        guarded_may_raise and not errors_handled
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        return true if region_escape_provenance_catchable_raise(iterable)
                        return false if region_escape_provenance_expression_terminates(iterable)
                        return true if region_escape_provenance_catchable_raise(condition)
                        return false if region_escape_provenance_expression_terminates(condition)
                        condition_bool: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return false if condition_bool.known and not condition_bool.value
                        region_escape_provenance_catchable_raise(body)
                    Expr.Refinement(base, predicate, _):
                        return true if region_escape_provenance_catchable_raise(base)
                        return false if region_escape_provenance_expression_terminates(base)
                        region_escape_provenance_catchable_raise(predicate)
                    _:
                        false


        def region_escape_provenance_pattern_is_error_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard:
                        return true
                    Pattern.TypeBind(type_name, _):
                        return type_name == "error"
                    Pattern.Or(options):
                        return any option in options where region_escape_provenance_pattern_is_error_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where region_escape_provenance_pattern_is_error_catchall(wrapped)
                    _:
                        return false


        def region_escape_provenance_catch_error_arms_terminate(arms: darray[Ast::MatchArm]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count < 2
                for arm_index in 1..<arms.count:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    continue if guard.known and not guard.value
                    return false if not region_escape_provenance_statements_terminate(arm.body)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    return true if unconditional and region_escape_provenance_pattern_is_error_catchall(arm.pattern)
                return false



        # Whether an expression or statement must leave its current block/function before
        # normal continuation. This syntax-level walk follows eager children and literal
        # branches; unknown calls remain fallthrough because their callee may be shadowed.
        def region_escape_provenance_expression_terminates(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(_, _): false
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        region_escape_provenance_expression_terminates(inner)
                    Expr.Call(callee, arguments, _, _):
                        region_escape_provenance_abort_callee(callee) or region_escape_provenance_expression_terminates(callee) or any argument in arguments where region_escape_provenance_expression_terminates(argument)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        any child in runtime_children where region_escape_provenance_expression_terminates(child)
                    Expr.Binary(left, operator, right, _):
                        left_terminates: bool = region_escape_provenance_expression_terminates(left)
                        return true if left_terminates
                        right_required: mutable bool = operator != TokenKind.And and operator != TokenKind.Or
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(left)
                        right_required <- literal.known and ((operator == TokenKind.And and literal.value) or (operator == TokenKind.Or and not literal.value)) if operator == TokenKind.And or operator == TokenKind.Or
                        right_required and region_escape_provenance_expression_terminates(right)
                    Expr.Block(statements, value, _, _):
                        region_escape_provenance_statements_terminate(statements) or region_escape_provenance_expression_terminates(value)
                    Expr.If(condition, then_value, else_value, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_expression_terminates(then_value) if literal.value
                            return region_escape_provenance_expression_terminates(else_value)
                        region_escape_provenance_expression_terminates(then_value) and region_escape_provenance_expression_terminates(else_value)
                    Expr.Match(scrutinee, arms, _):
                        region_escape_provenance_expression_terminates(scrutinee) or region_escape_provenance_match_arms_terminate(arms)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        region_escape_provenance_expression_terminates(object)
                    Expr.Index(object, index, _):
                        region_escape_provenance_expression_terminates(object) or region_escape_provenance_expression_terminates(index)
                    Expr.IndexN(object, indices, _):
                        region_escape_provenance_expression_terminates(object) or any index in indices where region_escape_provenance_expression_terminates(index)
                    Expr.Slice(object, low, high, _):
                        region_escape_provenance_expression_terminates(object) or region_escape_provenance_expression_terminates(low) or region_escape_provenance_expression_terminates(high)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        any element in elements where region_escape_provenance_expression_terminates(element)
                    Expr.DictLit(entries, _):
                        any entry in entries where region_escape_provenance_expression_terminates(entry.key) or region_escape_provenance_expression_terminates(entry.value)
                    Expr.Construct(_, fields, _):
                        any field in fields where region_escape_provenance_expression_terminates(field.value)
                    Expr.RecordUpdate(base, fields, _):
                        region_escape_provenance_expression_terminates(base) or any field in fields where region_escape_provenance_expression_terminates(field.value)
                    Expr.GetElse(guarded, _, _):
                        region_escape_provenance_expression_terminates(guarded)
                    Expr.Catch(guarded, arms, _):
                        guarded_terminates: bool = region_escape_provenance_expression_terminates(guarded)
                        catchable_raise: bool = region_escape_provenance_catchable_raise(guarded)
                        if guarded_terminates:
                            return true if not catchable_raise
                            region_escape_provenance_catch_error_arms_terminate(arms)
                        arms.count > 0 and region_escape_provenance_statements_terminate(arms[0].body) and region_escape_provenance_catch_error_arms_terminate(arms)
                    Expr.Comprehension(_, iterable, _, _, _, _):
                        region_escape_provenance_expression_terminates(iterable)
                    Expr.Refinement(left, right, _):
                        region_escape_provenance_expression_terminates(left) or region_escape_provenance_expression_terminates(right)
                    _:
                        false


        def region_escape_provenance_statement_terminates(statement: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Return(_, _) | Stmt.Break(_, _) | Stmt.Continue(_, _): true
                    Stmt.Expr(expression, _): region_escape_provenance_expression_terminates(expression)
                    Stmt.VarDecl(_, _, value, _): region_escape_provenance_expression_terminates(value)
                    Stmt.Assign(target, _, value, _): region_escape_provenance_expression_terminates(target) or region_escape_provenance_expression_terminates(value)
                    Stmt.If(condition, then_body, else_body, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_provenance_statements_terminate(then_body) if literal.value
                            return region_escape_provenance_statements_terminate(else_body)
                        region_escape_provenance_statements_terminate(then_body) and region_escape_provenance_statements_terminate(else_body)
                    Stmt.Block(_, _, _, body, _): region_escape_provenance_statements_terminate(body)
                    Stmt.While(condition, _, _): region_escape_provenance_expression_terminates(condition)
                    Stmt.For(_, _, iterable, _, _): region_escape_provenance_expression_terminates(iterable)
                    Stmt.Match(scrutinee, arms, _): region_escape_provenance_expression_terminates(scrutinee) or region_escape_provenance_match_arms_terminate(arms)
                    _:
                        false


        def region_escape_provenance_statements_terminate(statements: darray[Ast::Stmt]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_terminates(statement)
                return false


        def region_escape_provenance_catch_error_arms_terminate_with_metadata(arms: darray[Ast::MatchArm], catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count < 2
                for arm_index in 1..<arms.count:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    continue if guard.known and not guard.value
                    return false if not region_escape_provenance_statements_terminate_with_metadata(arm.body, catch_match_lines)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    return true if unconditional and region_escape_provenance_pattern_is_error_catchall(arm.pattern)
                return false


        def region_escape_provenance_statement_terminates_with_metadata(statement: Ast::Stmt, catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Match(scrutinee, arms, line):
                        is_catch_match: bool = any catch_line in catch_match_lines where catch_line == line.line
                        if is_catch_match:
                            scrutinee_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                            scrutinee_may_raise: bool = region_escape_provenance_catchable_raise(scrutinee)
                            if scrutinee_aborts:
                                return not scrutinee_may_raise or region_escape_provenance_catch_error_arms_terminate_with_metadata(arms, catch_match_lines)
                            return arms.count > 0 and region_escape_provenance_statements_terminate_with_metadata(arms[0].body, catch_match_lines) and region_escape_provenance_catch_error_arms_terminate_with_metadata(arms, catch_match_lines)
                        region_escape_provenance_expression_terminates(scrutinee) or region_escape_provenance_match_arms_terminate(arms)
                    Stmt.If(condition, then_body, else_body, _):
                        return true if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return region_escape_provenance_statements_terminate_with_metadata(then_body, catch_match_lines) if literal.known and literal.value
                        return region_escape_provenance_statements_terminate_with_metadata(else_body, catch_match_lines) if literal.known
                        return region_escape_provenance_statements_terminate_with_metadata(then_body, catch_match_lines) and region_escape_provenance_statements_terminate_with_metadata(else_body, catch_match_lines)
                    Stmt.Block(_, _, _, body, _):
                        region_escape_provenance_statements_terminate_with_metadata(body, catch_match_lines)
                    _:
                        region_escape_provenance_statement_terminates(statement)


        def region_escape_provenance_statements_terminate_with_metadata(statements: darray[Ast::Stmt]&, catch_match_lines: darray[u32]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                return false


        # Loop transfers leave the body but still affect the state after the loop.
        # Preserve writes that can reach a break, continue, or ordinary body fallthrough;
        # discard only paths that return or abort before leaving the loop.
        def region_escape_provenance_statement_reaches_after_loop(statement: Ast::Stmt, catch_match_lines: darray[u32]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Break(_, _) | Stmt.Continue(_, _): true
                    Stmt.Return(_, _): false
                    Stmt.If(condition, then_body, else_body, _):
                        return false if region_escape_provenance_expression_terminates(condition)
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        return region_escape_provenance_statements_reach_after_loop(then_body, catch_match_lines) if literal.known and literal.value
                        return region_escape_provenance_statements_reach_after_loop(else_body, catch_match_lines) if literal.known
                        region_escape_provenance_statements_reach_after_loop(then_body, catch_match_lines) or region_escape_provenance_statements_reach_after_loop(else_body, catch_match_lines)
                    Stmt.Block(_, _, _, body, _):
                        region_escape_provenance_statements_reach_after_loop(body, catch_match_lines)
                    Stmt.Match(scrutinee, arms, line):
                        is_catch_match: bool = any catch_line in catch_match_lines where catch_line == line.line
                        scrutinee_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                        scrutinee_may_raise: bool = region_escape_provenance_catchable_raise(scrutinee) if is_catch_match else false
                        return false if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                        arm_index: mutable usize = 0.usize()
                        while arm_index < arms.count |arm_index, arms|:
                            arm: Ast::MatchArm = arms[arm_index]
                            arm_reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                            arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                            arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                            guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                            if arm_reachable and not (guard_literal.known and not guard_literal.value) and not region_escape_provenance_expression_terminates(arm.guard):
                                return true if region_escape_provenance_statements_reach_after_loop(arm.body, catch_match_lines)
                            arm_index <- arm_index + 1.usize()
                        if is_catch_match:
                            return not region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                        return not region_escape_provenance_match_covers_values(scrutinee, arms)
                    _:
                        not region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)


        def region_escape_provenance_statements_reach_after_loop(statements: darray[Ast::Stmt]&, catch_match_lines: darray[u32]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if region_escape_provenance_statement_reaches_after_loop(statement, catch_match_lines)
                    return false if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                return true
        # A value block can assign an outer local from a nested branch. Track those
        # assignments in a private environment so a later tail expression sees the
        # provenance from every branch that can fall through.
        def region_escape_body_merge_falling_branch(base_names: darray[sview @source]&, base_regions: darray[sview @source]&, branch_names: darray[sview @source]&, branch_regions: darray[sview @source]&, joined_names: mutable darray[sview @source]&, joined_regions: mutable darray[sview @source]&, has_joined: mutable bool&, nesting: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for name in base_names |joined_names, joined_regions, has_joined|:
                    branch_region: sview @source = region_taint_lookup(branch_names, branch_regions, name)
                    if has_joined == true:
                        joined_region: sview @source = region_taint_lookup(joined_names, joined_regions, name)
                        joined_names.push(name)
                        joined_regions.push(region_escape_deeper_region(joined_region, branch_region, nesting))
                    else:
                        joined_names.push(name)
                        joined_regions.push(branch_region)
                has_joined <- true


        def region_escape_body_apply_statements(body: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, catch_match_lines: darray[u32] = []) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |taint_names, taint_regions|:
                    return if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, statement_line):
                            value_region: mutable sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, statement_line.line, catch_match_lines)
                            if value_region == "" and nesting.count > 0 and member_type_is_owned_container(type_expression) and region_escape_is_fresh_container_value(value):
                                value_region <- nesting[nesting.count - 1]
                            taint_names.push(name)
                            taint_regions.push(value_region)
                        Stmt.Assign(target, operator, value, statement_line):
                            target_root: sview @source = region_escape_assign_target_root(target)
                            if target_root != "":
                                value_region: mutable sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, statement_line.line, catch_match_lines)
                                if operator != TokenKind.Assign and operator != TokenKind.LArrow:
                                    value_region <- region_escape_deeper_region(region_taint_lookup(taint_names, taint_regions, target_root), value_region, nesting)
                                # Append even an empty region to clear an earlier local taint
                                # when a branch safely reassigns the value.
                                taint_names.push(target_root)
                                taint_regions.push(value_region)
                        Stmt.Block(_, _, _, nested_body, _):
                            base_names: darray[sview @source] = [name for name in taint_names]
                            base_regions: darray[sview @source] = [region for region in taint_regions]
                            nested_names: mutable darray[sview @source] = [name for name in taint_names]
                            nested_regions: mutable darray[sview @source] = [region for region in taint_regions]
                            region_escape_body_apply_statements(nested_body, annotations, view_fns, container_fns, nesting, nested_names, nested_regions, catch_match_lines)
                            joined_names: mutable darray[sview @source] = []
                            joined_regions: mutable darray[sview @source] = []
                            has_joined: mutable bool = false
                            region_escape_body_merge_falling_branch(base_names, base_regions, nested_names, nested_regions, joined_names, joined_regions, has_joined, nesting)
                            for name in base_names |taint_names, taint_regions|:
                                taint_names.push(name)
                                taint_regions.push(region_taint_lookup(joined_names, joined_regions, name))
                        Stmt.If(condition, then_body, else_body, _):
                            condition_terminates: bool = region_escape_provenance_expression_terminates(condition)
                            return if condition_terminates
                            condition_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                            base_names: darray[sview @source] = [name for name in taint_names]
                            base_regions: darray[sview @source] = [region for region in taint_regions]
                            joined_names: mutable darray[sview @source] = []
                            joined_regions: mutable darray[sview @source] = []
                            has_joined: mutable bool = false
                            if not condition_literal.known or condition_literal.value:
                                then_names: mutable darray[sview @source] = [name for name in base_names]
                                then_regions: mutable darray[sview @source] = [region for region in base_regions]
                                region_escape_body_apply_statements(then_body, annotations, view_fns, container_fns, nesting, then_names, then_regions, catch_match_lines)
                                if not region_escape_provenance_statements_terminate_with_metadata(then_body, catch_match_lines):
                                    region_escape_body_merge_falling_branch(base_names, base_regions, then_names, then_regions, joined_names, joined_regions, has_joined, nesting)
                            if not condition_literal.known or not condition_literal.value:
                                else_names: mutable darray[sview @source] = [name for name in base_names]
                                else_regions: mutable darray[sview @source] = [region for region in base_regions]
                                region_escape_body_apply_statements(else_body, annotations, view_fns, container_fns, nesting, else_names, else_regions, catch_match_lines)
                                if not region_escape_provenance_statements_terminate_with_metadata(else_body, catch_match_lines):
                                    region_escape_body_merge_falling_branch(base_names, base_regions, else_names, else_regions, joined_names, joined_regions, has_joined, nesting)
                            if has_joined:
                                for name in base_names |taint_names, taint_regions, joined_names, joined_regions|:
                                    taint_names.push(name)
                                    taint_regions.push(region_taint_lookup(joined_names, joined_regions, name))
                        Stmt.Match(scrutinee, arms, match_line):
                            is_catch_match: bool = any catch_line in catch_match_lines where catch_line == match_line.line
                            scrutinee_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                            scrutinee_may_raise: bool = region_escape_provenance_catchable_raise(scrutinee) if is_catch_match else false
                            return if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                            base_names: darray[sview @source] = [name for name in taint_names]
                            base_regions: darray[sview @source] = [region for region in taint_regions]
                            joined_names: mutable darray[sview @source] = []
                            joined_regions: mutable darray[sview @source] = []
                            has_joined: mutable bool = false
                            scrutinee_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(scrutinee)
                            scrutinee_region: sview @source = region_escape_stored_or_call_region(scrutinee, annotations, view_fns, container_fns, nesting, base_names, base_regions, match_line.line, catch_match_lines)
                            arm_index: mutable usize = 0.usize()
                            while arm_index < arms.count |joined_names, joined_regions, has_joined, arm_index|:
                                arm: Ast::MatchArm = arms[arm_index]
                                arm_reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                                pattern_reachability: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(arm.pattern, scrutinee_literal.value)
                                arm_reachable <- false if not is_catch_match and scrutinee_literal.known and pattern_reachability.known and not pattern_reachability.matches
                                guard_terminates: bool = region_escape_provenance_expression_terminates(arm.guard)
                                guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                                if arm_reachable and not guard_terminates and not (guard_literal.known and not guard_literal.value):
                                    arm_names: mutable darray[sview @source] = [name for name in base_names]
                                    arm_regions: mutable darray[sview @source] = [region for region in base_regions]
                                    bound_names: mutable darray[sview @source] @source = []
                                    collect_pattern_binding_names(arm.pattern, bound_names)
                                    for bound_name in bound_names |arm_names, arm_regions|:
                                        arm_names.push(bound_name)
                                        arm_regions.push(scrutinee_region)
                                    region_escape_body_apply_statements(arm.body, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, catch_match_lines)
                                    if not region_escape_provenance_statements_terminate_with_metadata(arm.body, catch_match_lines):
                                        region_escape_body_merge_falling_branch(base_names, base_regions, arm_names, arm_regions, joined_names, joined_regions, has_joined, nesting)
                                arm_index <- arm_index + 1.usize()
                            total_match: mutable bool = false if is_catch_match else arms.count > 0 and (arms[arms.count - 1].pattern is Ast::Pattern.Wildcard or arms[arms.count - 1].pattern is Ast::Pattern.Binding(_)) and all arm in arms where arm.guard is Ast::Expr.Absent
                            total_match <- true if not is_catch_match and scrutinee_literal.known and any arm in arms where arm.guard is Ast::Expr.Absent and (region_escape_provenance_bool_pattern(arm.pattern, scrutinee_literal.value)).matches
                            total_match <- region_escape_provenance_catch_error_arms_terminate_with_metadata(arms, catch_match_lines) if is_catch_match and scrutinee_aborts and scrutinee_may_raise
                            total_match <- true if is_catch_match and not scrutinee_aborts and arms.count > 0 and region_escape_provenance_pattern_is_match_catchall(arms[0].pattern) and arms[0].guard is Ast::Expr.Absent
                            region_escape_body_merge_falling_branch(base_names, base_regions, base_names, base_regions, joined_names, joined_regions, has_joined, nesting) if not total_match
                            if has_joined == true:
                                for name in base_names |taint_names, taint_regions, joined_names, joined_regions|:
                                    taint_names.push(name)
                                    taint_regions.push(region_taint_lookup(joined_names, joined_regions, name))
                        _:
                            pass


        # Evaluate a value-producing statement block with a private taint environment.
        # This is used for both `match` arms and ML-style block expressions: locals created
        # by one arm/block must contribute provenance to its tail, but must not leak into a
        # sibling arm or the surrounding scope. Return a caller-stack index, never a view
        # whose inferred lifetime is tied to these temporary environment arrays.
        def region_escape_body_value_region(body: darray[Ast::Stmt]&, explicit_value: Ast::Expr?, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32] = []) -> (found: bool, position: usize):
            can Memory.Allocate, Abort.Panic:
                return (false, 0) if region_escape_provenance_statements_terminate_with_metadata(body, catch_match_lines)
                body_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                body_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                region_escape_body_apply_statements(body, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, catch_match_lines)
                if explicit_value is value:
                    value_region: sview @source = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, line, catch_match_lines)
                    return region_stack_position(nesting, value_region)
                return (false, 0) if body.count == 0
                match body[body.count - 1]:
                    Stmt.Expr(tail_value, tail_line):
                        value_region: sview @source = region_escape_stored_or_call_region(tail_value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, tail_line.line, catch_match_lines)
                        return region_stack_position(nesting, value_region)
                    _:
                        return (false, 0)


        def region_escape_provenance_match_covers_values(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm]) -> bool:
            can Memory.Allocate, Abort.Panic:
                literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(scrutinee)
                for arm_index in 0..<arms.count |arms, arm_index, literal|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    unconditional: bool = arm.guard is Ast::Expr.Absent or (guard.known and guard.value)
                    continue if not unconditional or not progress_match_arm_reachable(scrutinee, arms, arm_index)
                    if literal.known:
                        pattern_match: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(arm.pattern, literal.value)
                        return true if pattern_match.known and pattern_match.matches
                    else:
                        return true if region_escape_provenance_pattern_is_match_catchall(arm.pattern)
                return false


        # Replay element provenance alongside the ordinary block-local taints. Branches
        # get private environments, and only reachable paths that can fall through join.
        def region_escape_body_apply_statements_with_elements(body: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: mutable darray[sview @source]&, taint_regions: mutable darray[sview @source]&, element_taint_names: mutable darray[sview @source]&, element_taint_regions: mutable darray[sview @source]&, catch_match_lines: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |taint_names, taint_regions, element_taint_names, element_taint_regions|:
                    return if region_escape_provenance_statement_terminates_with_metadata(statement, catch_match_lines)
                    match statement:
                        Stmt.VarDecl(name, _, value, statement_line):
                            element_region: sview @source = region_escape_comprehension_element_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, statement_line.line)
                            region_escape_element_taint_set(element_taint_names, element_taint_regions, name, element_region)
                        Stmt.Assign(target, operator, value, statement_line):
                            region_escape_record_collection_element_mutation(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, statement_line.line, [catch_line for catch_line in catch_match_lines])
                            match target:
                                Expr.Ident(target_name, _):
                                    assigned_region: mutable sview @source = region_escape_comprehension_element_region(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, statement_line.line)
                                    if operator == TokenKind.PlusEq:
                                        assigned_region <- region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, target_name), assigned_region, nesting)
                                    region_escape_element_taint_set(element_taint_names, element_taint_regions, target_name, assigned_region)
                                Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                                    target_name: sview @source = region_escape_assign_target_root(target)
                                    if target_name != "":
                                        assigned_region: sview @source = region_escape_stored_or_call_region_with_elements(value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, statement_line.line, [catch_line for catch_line in catch_match_lines])
                                        prior_region: sview @source = region_escape_element_taint_lookup(element_taint_names, element_taint_regions, target_name)
                                        region_escape_element_taint_set(element_taint_names, element_taint_regions, target_name, region_escape_element_region_join(prior_region, assigned_region, nesting))
                                _:
                                    pass
                        Stmt.Expr(expression, statement_line):
                            region_escape_record_collection_element_mutation(expression, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, statement_line.line, [catch_line for catch_line in catch_match_lines])
                        Stmt.If(condition, then_body, else_body, statement_line):
                            return if region_escape_provenance_expression_terminates(condition)
                            region_escape_record_collection_element_mutation(condition, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, statement_line.line, [catch_line for catch_line in catch_match_lines])
                            literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                            base_element_names: darray[sview @source] = [name for name in element_taint_names]
                            base_element_regions: darray[sview @source] = [region for region in element_taint_regions]
                            has_joined: mutable bool = false
                            if not literal.known or literal.value:
                                then_names: mutable darray[sview @source] = [name for name in taint_names]
                                then_regions: mutable darray[sview @source] = [region for region in taint_regions]
                                then_element_names: mutable darray[sview @source] = [name for name in base_element_names]
                                then_element_regions: mutable darray[sview @source] = [region for region in base_element_regions]
                                region_escape_body_apply_statements_with_elements(then_body, annotations, view_fns, container_fns, nesting, then_names, then_regions, then_element_names, then_element_regions, catch_match_lines)
                                if not region_escape_provenance_statements_terminate_with_metadata(then_body, catch_match_lines):
                                    for name in base_element_names |element_taint_names, element_taint_regions, then_element_names, then_element_regions, has_joined|:
                                        branch_region: sview @source = region_escape_element_taint_lookup(then_element_names, then_element_regions, name)
                                        joined_region: sview @source = branch_region if not has_joined else region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name), branch_region, nesting)
                                        region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, joined_region, nesting)
                                    has_joined <- true
                            if not literal.known or not literal.value:
                                else_names: mutable darray[sview @source] = [name for name in taint_names]
                                else_regions: mutable darray[sview @source] = [region for region in taint_regions]
                                else_element_names: mutable darray[sview @source] = [name for name in base_element_names]
                                else_element_regions: mutable darray[sview @source] = [region for region in base_element_regions]
                                region_escape_body_apply_statements_with_elements(else_body, annotations, view_fns, container_fns, nesting, else_names, else_regions, else_element_names, else_element_regions, catch_match_lines)
                                if not region_escape_provenance_statements_terminate_with_metadata(else_body, catch_match_lines):
                                    for name in base_element_names |element_taint_names, element_taint_regions, else_element_names, else_element_regions, has_joined|:
                                        branch_region: sview @source = region_escape_element_taint_lookup(else_element_names, else_element_regions, name)
                                        joined_region: sview @source = branch_region if not has_joined else region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name), branch_region, nesting)
                                        region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, joined_region, nesting)
                                    has_joined <- true
                        Stmt.Match(scrutinee, arms, match_line):
                            is_catch_match: bool = any catch_line in catch_match_lines where catch_line == match_line.line
                            scrutinee_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                            scrutinee_may_raise: bool = region_escape_provenance_catchable_raise(scrutinee) if is_catch_match else false
                            return if scrutinee_aborts and (not is_catch_match or not scrutinee_may_raise)
                            region_escape_record_collection_element_mutation(scrutinee, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, match_line.line, [catch_line for catch_line in catch_match_lines])
                            scrutinee_region: sview @source = region_escape_stored_or_call_region_with_elements(scrutinee, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, match_line.line, [catch_line for catch_line in catch_match_lines])
                            base_element_names: darray[sview @source] = [name for name in element_taint_names]
                            base_element_regions: darray[sview @source] = [region for region in element_taint_regions]
                            has_joined: mutable bool = false
                            arm_index: mutable usize = 0.usize()
                            while arm_index < arms.count |taint_names, taint_regions, element_taint_names, element_taint_regions, has_joined, arm_index|:
                                arm: Ast::MatchArm = arms[arm_index]
                                guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                                arm_reachable: mutable bool = region_escape_provenance_catch_arm_reachable(arms, arm_index) if is_catch_match else region_escape_provenance_match_arm_reachable(scrutinee, arms, arm_index)
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index == 0
                                arm_reachable <- false if is_catch_match and scrutinee_aborts and arm_index > 0 and not scrutinee_may_raise
                                if not ((guard_literal.known and not guard_literal.value) or region_escape_provenance_expression_terminates(arm.guard) or not arm_reachable):
                                    arm_names: mutable darray[sview @source] = [name for name in taint_names]
                                    arm_regions: mutable darray[sview @source] = [region for region in taint_regions]
                                    arm_element_names: mutable darray[sview @source] = [name for name in base_element_names]
                                    arm_element_regions: mutable darray[sview @source] = [region for region in base_element_regions]
                                    bound_names: mutable darray[sview @source] @source = []
                                    collect_pattern_binding_names(arm.pattern, bound_names)
                                    for bound_name in bound_names |arm_names, arm_regions, arm_element_names, arm_element_regions|:
                                        arm_names.push(bound_name)
                                        arm_regions.push(scrutinee_region)
                                        region_escape_element_taint_set(arm_element_names, arm_element_regions, bound_name, REGION_ESCAPE_UNKNOWN_ELEMENT_REGION)
                                    region_escape_record_collection_element_mutation(arm.guard, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, arm_element_names, arm_element_regions, match_line.line, [catch_line for catch_line in catch_match_lines])
                                    region_escape_body_apply_statements_with_elements(arm.body, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, arm_element_names, arm_element_regions, catch_match_lines)
                                    if not region_escape_provenance_statements_terminate_with_metadata(arm.body, catch_match_lines):
                                        for name in base_element_names |element_taint_names, element_taint_regions, arm_element_names, arm_element_regions, has_joined|:
                                            continue if any excluded in bound_names where excluded == name
                                            branch_region: sview @source = region_escape_element_taint_lookup(arm_element_names, arm_element_regions, name)
                                            joined_region: sview @source = branch_region if not has_joined else region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name), branch_region, nesting)
                                            region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, joined_region, nesting)
                                        has_joined <- true
                                arm_index <- arm_index + 1.usize()
                            if has_joined and not is_catch_match and not region_escape_provenance_match_covers_values(scrutinee, arms):
                                for name in base_element_names |element_taint_names, element_taint_regions, base_element_names, base_element_regions|:
                                    base_region: sview @source = region_escape_element_taint_lookup(base_element_names, base_element_regions, name)
                                    joined_region: sview @source = region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name), base_region, nesting)
                                    region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, joined_region, nesting)
                        Stmt.Block(_, _, _, nested_body, _):
                            nested_names: mutable darray[sview @source] = [name for name in taint_names]
                            nested_regions: mutable darray[sview @source] = [region for region in taint_regions]
                            base_element_names: darray[sview @source] = [name for name in element_taint_names]
                            nested_element_names: mutable darray[sview @source] = [name for name in element_taint_names]
                            nested_element_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                            region_escape_body_apply_statements_with_elements(nested_body, annotations, view_fns, container_fns, nesting, nested_names, nested_regions, nested_element_names, nested_element_regions, catch_match_lines)
                            if not region_escape_provenance_statements_terminate_with_metadata(nested_body, catch_match_lines):
                                for name in base_element_names |element_taint_names, element_taint_regions, nested_element_names, nested_element_regions|:
                                    region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, region_escape_element_taint_lookup(nested_element_names, nested_element_regions, name), nesting)
                        Stmt.While(condition, while_body, statement_line):
                            return if region_escape_provenance_expression_terminates(condition)
                            region_escape_record_collection_element_mutation(condition, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, statement_line.line, [catch_line for catch_line in catch_match_lines])
                            condition_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                            if not (condition_literal.known and not condition_literal.value):
                                base_taint_names: darray[sview @source] = [name for name in taint_names]
                                base_taint_regions: darray[sview @source] = [region for region in taint_regions]
                                while_names: mutable darray[sview @source] = [name for name in taint_names]
                                while_regions: mutable darray[sview @source] = [region for region in taint_regions]
                                base_element_names: darray[sview @source] = [name for name in element_taint_names]
                                while_element_names: mutable darray[sview @source] = [name for name in element_taint_names]
                                while_element_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                                region_escape_body_apply_statements_with_elements(while_body, annotations, view_fns, container_fns, nesting, while_names, while_regions, while_element_names, while_element_regions, catch_match_lines)
                                if region_escape_provenance_statements_reach_after_loop(while_body, [catch_line for catch_line in catch_match_lines]):
                                    for name in base_taint_names |taint_names, taint_regions, while_names, while_regions|:
                                        joined_region: sview @source = region_escape_deeper_region(region_taint_lookup(base_taint_names, base_taint_regions, name), region_taint_lookup(while_names, while_regions, name), nesting)
                                        region_escape_taint_replace(taint_names, taint_regions, name, joined_region, nesting)
                                    for name in base_element_names |element_taint_names, element_taint_regions, while_element_names, while_element_regions|:
                                        branch_region: sview @source = region_escape_element_taint_lookup(while_element_names, while_element_regions, name)
                                        joined_region: sview @source = region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name), branch_region, nesting)
                                        region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, joined_region, nesting)
                        Stmt.For(_, variables, iterable, for_body, line):
                            return if region_escape_provenance_expression_terminates(iterable)
                            region_escape_record_collection_element_mutation(iterable, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, [catch_line for catch_line in catch_match_lines])
                            loop_region: sview @source = region_escape_comprehension_element_region(iterable, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line)
                            base_taint_names: darray[sview @source] = [name for name in taint_names]
                            base_taint_regions: darray[sview @source] = [region for region in taint_regions]
                            loop_names: mutable darray[sview @source] = [name for name in taint_names]
                            loop_regions: mutable darray[sview @source] = [region for region in taint_regions]
                            base_element_names: darray[sview @source] = [name for name in element_taint_names]
                            loop_element_names: mutable darray[sview @source] = [name for name in element_taint_names]
                            loop_element_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                            for variable in variables |loop_names, loop_regions, loop_element_names, loop_element_regions|:
                                loop_names.push(variable)
                                loop_regions.push(loop_region)
                                region_escape_element_taint_set(loop_element_names, loop_element_regions, variable, loop_region)
                            region_escape_body_apply_statements_with_elements(for_body, annotations, view_fns, container_fns, nesting, loop_names, loop_regions, loop_element_names, loop_element_regions, catch_match_lines)
                            if region_escape_provenance_statements_reach_after_loop(for_body, [catch_line for catch_line in catch_match_lines]):
                                for name in base_taint_names |taint_names, taint_regions, loop_names, loop_regions, variables|:
                                    continue if any variable in variables where variable == name
                                    joined_region: sview @source = region_escape_deeper_region(region_taint_lookup(base_taint_names, base_taint_regions, name), region_taint_lookup(loop_names, loop_regions, name), nesting)
                                    region_escape_taint_replace(taint_names, taint_regions, name, joined_region, nesting)
                                for name in base_element_names |element_taint_names, element_taint_regions, loop_element_names, loop_element_regions, variables|:
                                    continue if any variable in variables where variable == name
                                    branch_region: sview @source = region_escape_element_taint_lookup(loop_element_names, loop_element_regions, name)
                                    joined_region: sview @source = region_escape_element_region_join(region_escape_element_taint_lookup(element_taint_names, element_taint_regions, name), branch_region, nesting)
                                    region_escape_element_taint_replace(element_taint_names, element_taint_regions, name, joined_region, nesting)
                        Stmt.Contract(_, expression, line):
                            region_escape_record_collection_element_mutation(expression, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line.line, [catch_line for catch_line in catch_match_lines])
                        _:
                            pass
                    one_statement: darray[Ast::Stmt] @source = [statement]
                    region_escape_body_apply_statements(one_statement, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, [catch_line for catch_line in catch_match_lines])


        def region_escape_body_value_region_with_elements(body: darray[Ast::Stmt]&, explicit_value: Ast::Expr?, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32]&) -> (found: bool, position: usize):
            can Memory.Allocate, Abort.Panic:
                return (false, 0) if region_escape_provenance_statements_terminate_with_metadata(body, catch_match_lines)
                body_taint_names: mutable darray[sview @source] = [name for name in taint_names]
                body_taint_regions: mutable darray[sview @source] = [region for region in taint_regions]
                body_element_taint_names: mutable darray[sview @source] = [name for name in element_taint_names]
                body_element_taint_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                region_escape_body_apply_statements_with_elements(body, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, body_element_taint_names, body_element_taint_regions, catch_match_lines)
                if explicit_value is value:
                    value_region: sview @source = region_escape_stored_or_call_region_with_elements(value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, body_element_taint_names, body_element_taint_regions, line, [catch_line for catch_line in catch_match_lines])
                    return region_stack_position(nesting, value_region)
                return (false, 0) if body.count == 0
                match body[body.count - 1]:
                    Stmt.Expr(tail_value, tail_line):
                        value_region: sview @source = region_escape_stored_or_call_region_with_elements(tail_value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, body_element_taint_names, body_element_taint_regions, tail_line.line, [catch_line for catch_line in catch_match_lines])
                        return region_stack_position(nesting, value_region)
                    _:
                        return (false, 0)


        def region_escape_value_arms_region_with_elements(is_catch: bool, scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, element_taint_names: darray[sview @source]&, element_taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32]) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                guarded_aborts: bool = region_escape_provenance_expression_terminates(scrutinee)
                guarded_may_raise: bool = region_escape_provenance_catchable_raise(scrutinee) if is_catch else false
                if guarded_aborts and not guarded_may_raise:
                    return ""
                result_region: mutable sview @source = ""
                if is_catch and not guarded_aborts:
                    result_region <- region_escape_stored_or_call_region_with_elements(scrutinee, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, [catch_line for catch_line in catch_match_lines])
                scrutinee_region: sview @source = region_escape_stored_or_call_region_with_elements(scrutinee, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, element_taint_names, element_taint_regions, line, [catch_line for catch_line in catch_match_lines])
                arm_index: mutable usize = 0.usize()
                while arm_index < arms.count |result_region, taint_names, taint_regions, element_taint_names, element_taint_regions, arm_index|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard_literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(arm.guard)
                    reachable: mutable bool = progress_catch_arm_reachable(arms, arm_index) if is_catch else progress_match_arm_reachable(scrutinee, arms, arm_index)
                    reachable <- false if is_catch and arm_index == 0 and guarded_aborts
                    reachable <- false if is_catch and guarded_aborts and arm_index > 0 and not guarded_may_raise
                    reachable <- false if not reachable or (guard_literal.known and not guard_literal.value) or region_escape_provenance_expression_terminates(arm.guard)
                    if reachable:
                        arm_names: mutable darray[sview @source] = [name for name in taint_names]
                        arm_regions: mutable darray[sview @source] = [region for region in taint_regions]
                        arm_element_names: mutable darray[sview @source] = [name for name in element_taint_names]
                        arm_element_regions: mutable darray[sview @source] = [region for region in element_taint_regions]
                        bound_names: mutable darray[sview @source] @source = []
                        collect_pattern_binding_names(arm.pattern, bound_names)
                        for bound_name in bound_names |arm_names, arm_regions, arm_element_names, arm_element_regions|:
                            arm_names.push(bound_name)
                            arm_regions.push(scrutinee_region)
                            region_escape_element_taint_set(arm_element_names, arm_element_regions, bound_name, REGION_ESCAPE_UNKNOWN_ELEMENT_REGION)
                        region_escape_record_collection_element_mutation(arm.guard, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, arm_element_names, arm_element_regions, line)
                        arm_result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(arm.body, null, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, arm_element_names, arm_element_regions, line, catch_match_lines)
                        candidate: sview @source = nesting[arm_result.position] if arm_result.found else ""
                        result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                    arm_index <- arm_index + 1.usize()
                return result_region



        # The taint region a value contributes: its own @region/taint, OR — for a call to an
        # ambient-allocating container-returning function made INSIDE a region block — the innermost
        # region (the call allocates its owned result in the current block's region).
        def region_escape_stored_or_call_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, container_fns: darray[sview @source]&, nesting: darray[sview @source]&, taint_names: darray[sview @source]&, taint_regions: darray[sview @source]&, line: u32, catch_match_lines: darray[u32] = []) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, _):
                        while index > 0 |index: usize = taint_names.count|:
                            index <- index - 1
                            return taint_regions[index] if index < taint_regions.count and taint_names[index] == name
                        return local_region_name(annotations, name, line)
                    Expr.RegionNew(_, region, _):
                        return region if region != ""
                        return nesting[nesting.count - 1] if nesting.count > 0 else ""
                    Expr.Block(statements, tail_value, _, block_pos):
                        result: (found: bool, position: usize) = region_escape_body_value_region(statements, tail_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                        return nesting[result.position] if result.found else ""
                    Expr.Match(scrutinee, arms, _):
                        empty_element_names: mutable darray[sview @source] = []
                        empty_element_regions: mutable darray[sview @source] = []
                        return region_escape_value_arms_region_with_elements(false, scrutinee, arms, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, empty_element_names, empty_element_regions, line, catch_match_lines)
                    Expr.Catch(guarded, arms, _):
                        empty_element_names: mutable darray[sview @source] = []
                        empty_element_regions: mutable darray[sview @source] = []
                        return region_escape_value_arms_region_with_elements(true, guarded, arms, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, empty_element_names, empty_element_regions, line, catch_match_lines)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return region_escape_stored_or_call_region(inner, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                    Expr.Field(object, _, _) | Expr.Index(object, _, _) | Expr.Slice(object, _, _, _):
                        return region_escape_stored_or_call_region(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        result_region: mutable sview @source = ""
                        for element in elements |result_region|:
                            candidate: sview @source = region_escape_stored_or_call_region(element, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.Construct(_, fields, _):
                        result_region: mutable sview @source = ""
                        for field in fields |result_region|:
                            candidate: sview @source = region_escape_stored_or_call_region(field.value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.RecordUpdate(base, fields, _):
                        result_region: mutable sview @source = region_escape_stored_or_call_region(base, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                        for field in fields |result_region|:
                            candidate: sview @source = region_escape_stored_or_call_region(field.value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.If(condition, then_value, else_value, _):
                        literal: (known: bool, value: bool) = region_escape_provenance_literal_bool(condition)
                        if literal.known:
                            return region_escape_stored_or_call_region(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines) if literal.value
                            return region_escape_stored_or_call_region(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                        then_region: sview @source = region_escape_stored_or_call_region(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                        else_region: sview @source = region_escape_stored_or_call_region(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                        return region_escape_deeper_region(then_region, else_region, nesting)
                    # GetElse's recovery is a terminating control-flow path; only its success
                    # expression can become the value stored or returned by the caller.
                    Expr.GetElse(guarded, _, _):
                        return region_escape_stored_or_call_region(guarded, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line, catch_match_lines)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        direct: sview @source = effective_value_region(value, annotations, view_fns, nesting, taint_names, taint_regions, line)
                        callee_name: sview @source = ident_name_of(callee)
                        return nesting[nesting.count - 1] if nesting.count > 0 and callee_name != "" and (any container_fn in container_fns where container_fn == callee_name)
                        return direct
                    _:
                        return effective_value_region(value, annotations, view_fns, nesting, taint_names, taint_regions, line)


        # A branch mentioning an outer/parameter region cannot hide a shorter-lived
        # local dependency from another branch.
        def region_escape_deeper_region(left: sview, right: sview, nesting: darray[sview @source]&) -> sview:
            can Abort.Panic:
                left_position: (found: bool, position: usize) = region_stack_position(nesting, left)
                right_position: (found: bool, position: usize) = region_stack_position(nesting, right)
                return nesting[right_position.position] if right_position.found and (not left_position.found or right_position.position > left_position.position)
                return nesting[left_position.position] if left_position.found
                # Preserve caller-owned provenance when no local region is present. It is
                # needed to compare distinct region parameters after aggregate/enum joins;
                # local escape checks still ignore it because it is absent from `nesting`.
                return REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION if left == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION or right == REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                return REGION_ESCAPE_UNKNOWN_ELEMENT_REGION if left == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION or right == REGION_ESCAPE_UNKNOWN_ELEMENT_REGION
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION if left == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION or right == REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
                return right if left == ""
                return left if right == "" or left == right
                return REGION_ESCAPE_MULTIPLE_EXTERNAL_REGION
