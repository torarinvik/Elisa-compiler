# Nested-region store-escape — VALUE PROVENANCE: which region does a stored value actually live
# in? Its own `@region` annotation, the region of the receiver it was sliced or viewed from, or
# a region it was TAINTED with when a value from there flowed into it. The nesting position of
# that region is what the escape check compares. Continues check_region_escape.elisa.

extend Semantic:
    private:


        # The declared @region of a local, or "" when it carries none.
        def local_region_name(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, before_line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                annotation_option: Ast::LocalRegionAnnotation? = local_region_annotation_of(annotations, name, before_line)
                region_name: mutable sview = sview("", 0, 0)
                region_name <- present.region if annotation_option is present
                return region_name


        # The inferred region that owns a local binding, or "" when it was not
        # declared inside an active region. Newest entries win under shadowing.
        def region_escape_local_owner_region(names: darray[sview]&, regions: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    return regions[index] if index < regions.count and names[index] == name
                return ""



        # The nesting position of REGION on the nesting (outer regions have smaller indices),
        # with found=false when it is not an enclosing function-local region.
        def region_stack_position(nesting: darray[sview]&, region_name: sview) -> (found: bool, position: usize):
            can Abort.Panic:
                found_here: mutable bool = false
                position_here: mutable usize = 0
                while probe < nesting.count |probe: usize = 0, found_here, position_here|:
                    matched: bool = nesting[probe] == region_name
                    found_here <- true if matched
                    position_here <- probe if matched
                    probe <- probe + 1
                return (found_here, position_here)



        # The @region of a stored VALUE expression: a plain ident's region, or — for a list
        # literal `[v, …]` — the (single) inner region shared by its element idents. Returns
        # "" when no region-annotated value is found. Sound: only explicitly-annotated
        # idents contribute, so a region-less element yields no false region.
        def stored_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        return local_region_name(annotations, name, line)
                    Expr.Paren(inner, paren_line):
                        return stored_value_region(inner, annotations, view_fns, line)
                    Expr.Index(head, argument, index_line):
                        # A view/element of a region-local (`v[i]`) lives in the base's region.
                        return stored_value_region(head, annotations, view_fns, line)
                    Expr.Slice(object, low, high, slice_line):
                        # A slice `v[0:n]` is a view into the base's region.
                        return stored_value_region(object, annotations, view_fns, line)
                    Expr.Field(object, field, field_line):
                        # A field of a region-local lives in the same region.
                        return stored_value_region(object, annotations, view_fns, line)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        # A view-producing method on a region-local (`d.as_sview()`,
                        # `d.as_cstr()`, `d.as_view()`, `d.as_slice()`) aliases the region's
                        # backing. Other methods (`d.count()`) return owned values → not a region
                        # dependency, so only these whitelisted borrows carry the region.
                        method_region: sview = stored_view_method_region(callee, annotations, view_fns, line)
                        method_region return if method_region != ""
                        # A VIEW-returning free function's result aliases its argument's
                        # backing (`escaped <- head(&v, 1)` with v @inner ties the view
                        # to inner) — cross-function view provenance.
                        called: sview = ident_name_of(callee)
                        return_region: mutable sview = sview("", 0, 0)
                        if called != "" and (any vf in view_fns where vf == called):
                            for argument in arguments |return_region|:
                                candidate2: sview = stored_value_region(view_arg_base(argument), annotations, view_fns, line)
                                return_region <- candidate2 if return_region == "" and candidate2 != ""
                        return return_region
                    Expr.Move(inner, move_line):
                        return stored_value_region(inner, annotations, view_fns, line)
                    Expr.Array(elements, array_line):
                        element_region: mutable sview = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview = stored_value_region(element, annotations, view_fns, line)
                            element_region <- candidate if candidate != ""
                        return element_region
                    Expr.Tuple(elements, tuple_line):
                        element_region: mutable sview = sview("", 0, 0)
                        for element in elements |element_region|:
                            candidate: sview = stored_value_region(element, annotations, view_fns, line)
                            element_region <- candidate if candidate != "" and element_region == ""
                        return element_region
                    Expr.Construct(type_expression, fields, construct_line):
                        field_region: mutable sview = sview("", 0, 0)
                        for field in fields |field_region|:
                            candidate: sview = stored_value_region(field.value, annotations, view_fns, line)
                            field_region <- candidate if candidate != "" and field_region == ""
                        return field_region
                    Expr.RecordUpdate(base, fields, update_line):
                        base_region: sview = stored_value_region(base, annotations, view_fns, line)
                        base_region return if base_region != ""
                        field_region: mutable sview = sview("", 0, 0)
                        for field in fields |field_region|:
                            candidate: sview = stored_value_region(field.value, annotations, view_fns, line)
                            field_region <- candidate if candidate != "" and field_region == ""
                        return field_region
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        return stored_value_region(body, annotations, view_fns, line)
                    Expr.If(condition, then_expression, else_expression, if_line):
                        # A conditional value `v if c else w` escapes if EITHER branch carries
                        # an inner region.
                        then_region: sview = stored_value_region(then_expression, annotations, view_fns, line)
                        else_region: sview = stored_value_region(else_expression, annotations, view_fns, line)
                        return then_region if then_region != ""
                        return else_region
                    # Keep the tail binder distinct from the input parameter: stage0
                    # otherwise recurses on the enclosing block when building the seed.
                    Expr.Block(_, block_value, _, _):
                        return stored_value_region(block_value, annotations, view_fns, line)
                    Expr.Match(_, arms, _):
                        arm_region: mutable sview = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview = stored_value_region(arm_value, annotations, view_fns, line)
                                    arm_region <- candidate if arm_region == "" and candidate != ""
                                _:
                                    pass
                        return arm_region
                    Expr.Catch(guarded, arms, _):
                        guarded_region: sview = stored_value_region(guarded, annotations, view_fns, line)
                        guarded_region return if guarded_region != ""
                        arm_region: mutable sview = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview = stored_value_region(arm_value, annotations, view_fns, line)
                                    arm_region <- candidate if arm_region == "" and candidate != ""
                                _:
                                    pass
                        return arm_region
                    _:
                        return sview("", 0, 0)



        # The region of the receiver of a whitelisted view-producing method call, else "".
        def stored_view_method_region(callee: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, method, field_line):
                        is_view_method: bool = method == "as_sview" or method == "as_cstr" or method == "as_view" or method == "as_slice" or method == "as_str"
                        stored_value_region(object, annotations, view_fns, line) return if is_view_method
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)



        # The root ident of a stored VALUE expression, through field/index/paren/move selectors
        # (`inner.xs` / `mid` -> "inner" / "mid"). A `copy(x)`/other-call value has no ident root,
        # so a deep copy correctly launders the region (returns "").
        def region_value_root_ident(value: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match value:
                    Expr.Ident(name, ident_line): name
                    Expr.Field(object, field_name, field_line): region_value_root_ident(object)
                    Expr.Index(object, index, index_line): region_value_root_ident(object)
                    Expr.Paren(inner, paren_line): region_value_root_ident(inner)
                    Expr.Move(inner, move_line): region_value_root_ident(inner)
                    _: sview("", 0, 0)



        # The region a name has been TAINTED with (a value from that region flowed into it, directly
        # or via a struct field/copy), or "".
        def region_taint_lookup(taint_names: darray[sview]&, taint_regions: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while probe > 0 |probe: usize = taint_names.count|:
                    probe <- probe - 1
                    return taint_regions[probe] if probe < taint_regions.count and taint_names[probe] == name
                return ""



        # The region a stored value lives in: its own `@region` provenance, or — when it has none —
        # the region tainting its root ident (a struct copied/field-assigned from a region value).
        def effective_value_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, taint_names: darray[sview]&, taint_regions: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = stored_value_region(value, annotations, view_fns, line)
                direct return if direct != ""
                root_taint: sview = region_taint_lookup(taint_names, taint_regions, region_value_root_ident(value))
                root_taint return if root_taint != ""
                return match value:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        effective_value_region(inner, annotations, view_fns, taint_names, taint_regions, line)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        nested_region: mutable sview = sview("", 0, 0)
                        for element in elements |nested_region|:
                            candidate: sview = effective_value_region(element, annotations, view_fns, taint_names, taint_regions, line)
                            nested_region <- candidate if candidate != "" and nested_region == ""
                        nested_region
                    Expr.Construct(type_expression, fields, construct_line):
                        nested_region: mutable sview = sview("", 0, 0)
                        for field in fields |nested_region|:
                            candidate: sview = effective_value_region(field.value, annotations, view_fns, taint_names, taint_regions, line)
                            nested_region <- candidate if candidate != "" and nested_region == ""
                        nested_region
                    Expr.RecordUpdate(base, fields, update_line):
                        base_region: sview = effective_value_region(base, annotations, view_fns, taint_names, taint_regions, line)
                        base_region return if base_region != ""
                        nested_region: mutable sview = sview("", 0, 0)
                        for field in fields |nested_region|:
                            candidate: sview = effective_value_region(field.value, annotations, view_fns, taint_names, taint_regions, line)
                            nested_region <- candidate if candidate != "" and nested_region == ""
                        return nested_region
                    Expr.If(condition, then_value, else_value, if_line):
                        then_region: sview = effective_value_region(then_value, annotations, view_fns, taint_names, taint_regions, line)
                        then_region if then_region != "" else effective_value_region(else_value, annotations, view_fns, taint_names, taint_regions, line)
                    Expr.Block(_, block_value, _, _):
                        effective_value_region(block_value, annotations, view_fns, taint_names, taint_regions, line)
                    Expr.Match(_, arms, _):
                        arm_region: mutable sview = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview = effective_value_region(arm_value, annotations, view_fns, taint_names, taint_regions, line)
                                    arm_region <- candidate if arm_region == "" and candidate != ""
                                _:
                                    pass
                        arm_region
                    Expr.Catch(guarded, arms, _):
                        guarded_region: sview = effective_value_region(guarded, annotations, view_fns, taint_names, taint_regions, line)
                        return guarded_region if guarded_region != ""
                        arm_region: mutable sview = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            continue if arm.body.count == 0
                            match arm.body[arm.body.count - 1]:
                                Stmt.Expr(arm_value, _):
                                    candidate: sview = effective_value_region(arm_value, annotations, view_fns, taint_names, taint_regions, line)
                                    arm_region <- candidate if arm_region == "" and candidate != ""
                                _:
                                    pass
                        arm_region
                    _:
                        sview("", 0, 0)



        # Evaluate a value-producing statement block with a private taint environment.
        # This is used for both `match` arms and ML-style block expressions: locals created
        # by one arm/block must contribute provenance to its tail, but must not leak into a
        # sibling arm or the surrounding scope. Return a caller-stack index, never a view
        # whose inferred lifetime is tied to these temporary environment arrays.
        def region_escape_body_value_region(body: darray[Ast::Stmt]&, explicit_value: Ast::Expr?, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, container_fns: darray[sview]&, nesting: darray[sview]&, taint_names: darray[sview]&, taint_regions: darray[sview]&, line: u32) -> (found: bool, position: usize):
            can Memory.Allocate, Abort.Panic:
                body_taint_names: mutable darray[sview] = [name for name in taint_names]
                body_taint_regions: mutable darray[sview] = [region for region in taint_regions]
                for statement in body |body_taint_names, body_taint_regions|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, statement_line):
                            value_region: mutable sview = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, statement_line.line)
                            if value_region == "" and nesting.count > 0 and member_type_is_owned_container(type_expression) and region_escape_is_fresh_container_value(value):
                                value_region <- nesting[nesting.count - 1]
                            body_taint_names.push(name)
                            body_taint_regions.push(value_region)
                        Stmt.Assign(target, operator, value, statement_line):
                            value_region: sview = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, statement_line.line)
                            target_root: sview = region_escape_assign_target_root(target)
                            if value_region != "" and target_root != "":
                                body_taint_names.push(target_root)
                                body_taint_regions.push(value_region)
                        _:
                            pass
                if explicit_value is value:
                    value_region: sview = region_escape_stored_or_call_region(value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, line)
                    return region_stack_position(nesting, value_region)
                return (false, 0) if body.count == 0
                match body[body.count - 1]:
                    Stmt.Expr(tail_value, tail_line):
                        value_region: sview = region_escape_stored_or_call_region(tail_value, annotations, view_fns, container_fns, nesting, body_taint_names, body_taint_regions, tail_line.line)
                        return region_stack_position(nesting, value_region)
                    _:
                        return (false, 0)



        # The taint region a value contributes: its own @region/taint, OR — for a call to an
        # ambient-allocating container-returning function made INSIDE a region block — the innermost
        # region (the call allocates its owned result in the current block's region).
        def region_escape_stored_or_call_region(value: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, container_fns: darray[sview]&, nesting: darray[sview]&, taint_names: darray[sview]&, taint_regions: darray[sview]&, line: u32) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Ident(name, _):
                        while index > 0 |index: usize = taint_names.count|:
                            index <- index - 1
                            return taint_regions[index] if index < taint_regions.count and taint_names[index] == name
                        return local_region_name(annotations, name, line)
                    Expr.RegionNew(_, region, _):
                        return region if region != ""
                        return nesting[nesting.count - 1] if nesting.count > 0 else ""
                    Expr.Block(statements, tail_value, _, block_pos):
                        result: (found: bool, position: usize) = region_escape_body_value_region(statements, tail_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                        return nesting[result.position] if result.found else ""
                    Expr.Match(guarded, arms, _) | Expr.Catch(guarded, arms, _):
                        guarded_region: sview = region_escape_stored_or_call_region(guarded, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                        arm_region: mutable sview = sview("", 0, 0)
                        for arm in arms |arm_region|:
                            arm_names: mutable darray[sview] = [name for name in taint_names]
                            arm_regions: mutable darray[sview] = [region for region in taint_regions]
                            collect_pattern_binding_names(arm.pattern, arm_names)
                            while arm_regions.count < arm_names.count |arm_regions|:
                                arm_regions.push(guarded_region)
                            result: (found: bool, position: usize) = region_escape_body_value_region(arm.body, null, annotations, view_fns, container_fns, nesting, arm_names, arm_regions, line)
                            candidate: sview = nesting[result.position] if result.found else ""
                            arm_region <- region_escape_deeper_region(arm_region, candidate, nesting)
                        return arm_region
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return region_escape_stored_or_call_region(inner, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                    Expr.Field(object, _, _) | Expr.Index(object, _, _) | Expr.Slice(object, _, _, _):
                        return region_escape_stored_or_call_region(object, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        result_region: mutable sview = ""
                        for element in elements |result_region|:
                            candidate: sview = region_escape_stored_or_call_region(element, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.Construct(_, fields, _):
                        result_region: mutable sview = ""
                        for field in fields |result_region|:
                            candidate: sview = region_escape_stored_or_call_region(field.value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.RecordUpdate(base, fields, _):
                        result_region: mutable sview = region_escape_stored_or_call_region(base, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                        for field in fields |result_region|:
                            candidate: sview = region_escape_stored_or_call_region(field.value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                            result_region <- region_escape_deeper_region(result_region, candidate, nesting)
                        return result_region
                    Expr.If(_, then_value, else_value, _):
                        then_region: sview = region_escape_stored_or_call_region(then_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                        else_region: sview = region_escape_stored_or_call_region(else_value, annotations, view_fns, container_fns, nesting, taint_names, taint_regions, line)
                        return region_escape_deeper_region(then_region, else_region, nesting)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        direct: sview = effective_value_region(value, annotations, view_fns, taint_names, taint_regions, line)
                        callee_name: sview = ident_name_of(callee)
                        return nesting[nesting.count - 1] if nesting.count > 0 and callee_name != "" and (any container_fn in container_fns where container_fn == callee_name)
                        return direct
                    _:
                        return effective_value_region(value, annotations, view_fns, taint_names, taint_regions, line)


        # A branch mentioning an outer/parameter region cannot hide a shorter-lived
        # local dependency from another branch.
        def region_escape_deeper_region(left: sview, right: sview, nesting: darray[sview]&) -> sview:
            can Abort.Panic:
                left_position: (found: bool, position: usize) = region_stack_position(nesting, left)
                right_position: (found: bool, position: usize) = region_stack_position(nesting, right)
                return right if right_position.found and (not left_position.found or right_position.position > left_position.position)
                return right if left == ""
                return left
