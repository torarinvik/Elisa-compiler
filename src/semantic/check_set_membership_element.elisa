# Runtime-backed set with an unsupported element type. A `set[T]`'s element must have value
# equality. MEASURED against stage0 with the std prepended, through -emit obj:
#     REJECTED: set[sview], set[dstr], set[f32], set[f64]
#     accepted: set[cstr], set[i64]  (and the other integer widths, bool, char, const enum)
#
# stage0 reports ONE PER DECLARATION **AND** ONE PER USE. MEASURED counts:
#     local decl only                     1
#     local decl + one membership         2
#     param + one membership              1
#     param + two memberships             2
#     param + `s.insert(p)`               1
#     param never used                    0
# A bare mention (`_ = s`) is NOT a use. Note the declaration half is the OPPOSITE of the dict
# rule next door in check_runtime_dict_key.elisa, where a bare
# `d: mutable dict[sview, i64] = {}` is ACCEPTED and only indexing it is refused.
#
# This used to fire ONLY on a membership `x in S`, and only for `set[f32]`/`set[f64]` — it
# missed sview/dstr entirely, missed `s.insert(k)`, and missed the declaration. Dropping the
# use half while adding the declaration half regressed stage0's own semantic suite (a
# `set[f64]` PARAMETER used twice expects 2 errors), so both halves are needed.
#
# `dstr` prints LOWERED as `darray[u8]`, the same lowering the index/slice walls and the dict
# key check apply. Aggregate elements are still a conservative miss: their spelling is not
# reproducible exactly, and a wrong one is worse than a missing one.

extend Semantic:
    private:
        def set_element_spelling_unsupported(element_spelling: sview) -> bool:
            can Abort.Panic:
                return element_spelling == "sview" or element_spelling == "dstr" or element_spelling == "f32" or element_spelling == "f64"


        # The element spelling of a `set[T]` whose T stage0 refuses to hash (looking through
        # mutable/&/paren wrappers), else "". Only the four MEASURED spellings.
        def set_unsupported_element_of(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        element: sview = ident_name_of(argument)
                        return element if ident_name_of(head) == "set" and set_element_spelling_unsupported(element) else sview("", 0, 0)
                    Expr.IndexN(head, arguments, index_n_line):
                        element_n: sview = ident_name_of(arguments[0]) if arguments.count > 0 else sview("", 0, 0)
                        return element_n if ident_name_of(head) == "set" and set_element_spelling_unsupported(element_n) else sview("", 0, 0)
                    Expr.Unary(operator, operand, unary_line):
                        return set_unsupported_element_of(operand)
                    Expr.Paren(inner, paren_line):
                        return set_unsupported_element_of(inner)
                    _:
                        return sview("", 0, 0)


        # stage0 prints a dstr element LOWERED: `set[dstr]` reports "got element type in
        # set[darray[u8]]". Every other spelling passes through.
        def set_element_reported_spelling(declared_spelling: sview) -> sview:
            can Abort.Panic:
                "darray[u8]" return if declared_spelling == "dstr"
                return declared_spelling


        def set_element_report(element_spelling: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if element_spelling == ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SetElementUnsupported, name: "", line: line, expected: "", actual: set_element_reported_spelling(element_spelling)})


        # Flag every USE of a tracked set: a membership `x in S`, and a method call `S.m(...)`
        # (`s.insert(k)`). A bare mention of the name is NOT a use — stage0 reports 0 for a
        # parameter that is only discarded.
        def set_element_check_expression(expression: Ast::Expr, names: darray[sview]&, elements: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- set_element_report(parallel_lookup_first(names, elements, ident_name_of(right)), line, table) if operator == TokenKind.In
                        table <- set_element_check_expression(left, names, elements, table)
                        table <- set_element_check_expression(right, names, elements, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        if callee is Expr.Field(method_object, method_name, method_line):
                            table <- set_element_report(parallel_lookup_first(names, elements, ident_name_of(method_object)), call_line, table)
                        for argument in arguments |table| -> table:
                            table <- set_element_check_expression(argument, names, elements, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- set_element_check_expression(operand, names, elements, table)
                    Expr.Paren(inner, paren_line):
                        table <- set_element_check_expression(inner, names, elements, table)
                    _:
                        pass


        # Walk statements: flag each local DECLARATION of an offending set (and record it as a
        # tracked binding), then flag each USE.
        def set_element_check_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, elements: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, names, elements| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            declared_element: sview = set_unsupported_element_of(type_expression)
                            if declared_element != "":
                                names.push(name)
                                elements.push(declared_element)
                                table <- set_element_report(declared_element, line, table)
                            table <- set_element_check_expression(value, names, elements, table)
                        Stmt.Expr(expression, line):
                            table <- set_element_check_expression(expression, names, elements, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- set_element_check_expression(value, names, elements, table)
                        Stmt.Contract(kind, expression, line):
                            table <- set_element_check_expression(expression, names, elements, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- set_element_check_expression(returned, names, elements, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- set_element_check_expression(condition, names, elements, table)
                            table <- set_element_check_statements(then_body, names, elements, table)
                            table <- set_element_check_statements(else_body, names, elements, table)
                        Stmt.While(condition, body, line):
                            table <- set_element_check_expression(condition, names, elements, table)
                            table <- set_element_check_statements(body, names, elements, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- set_element_check_expression(iterable, names, elements, table)
                            table <- set_element_check_statements(body, names, elements, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- set_element_check_statements(body, names, elements, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- set_element_check_expression(scrutinee, names, elements, table)
                            for arm in arms |table, names, elements| -> table:
                                table <- set_element_check_statements(arm.body, names, elements, table)
                        _:
                            pass


        def check_set_membership_element_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            elements: mutable darray[sview] = []
                            # Params are TRACKED but not reported: an unused set param is
                            # accepted by stage0; only its uses are errors.
                            for param in params |names, elements|:
                                param_element: sview = set_unsupported_element_of(param.type_expression)
                                if param_element != "":
                                    names.push(param.name)
                                    elements.push(param_element)
                            table <- set_element_check_statements(body, names, elements, table)
                        Decl.Module(module_name, body, line):
                            table <- check_set_membership_element_decls(body, table)
                        Decl.Scoped(body, line):
                            table <- check_set_membership_element_decls(body, table)
                        _:
                            pass

    public:
        def check_set_membership_element(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_set_membership_element_decls(declarations, table)
