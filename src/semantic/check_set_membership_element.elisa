# Runtime-backed set with an unsupported element type used in a membership test. A `set[T]`'s
# element must have value equality — stage0 rejects `x in s` when `s: set[f32|f64]` (floats have
# no exact equality). SOUND subset: track set-of-FLOAT bindings (param/local `set[f32]`/`set[f64]`)
# and flag a membership `x in S` whose right operand names one. Aggregates are also rejected by
# stage0 but their element spelling is harder to render exactly, so only floats (whose spelling is
# the bare `f32`/`f64`) are covered here; other element kinds are a conservative miss. The error
# fires on USE (`in`), not on the bare declaration — matching stage0.
extend Semantic:
    private:
        # The float element spelling of a `set[f32]`/`set[f64]` type (looking through mutable/&/
        # paren wrappers), else "".
        def set_float_element(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        element: sview = ident_name_of(argument)
                        return element if ident_name_of(head) == "set" and (element == "f32" or element == "f64") else sview("", 0, 0)
                    Expr.IndexN(head, arguments, index_n_line):
                        element_n: sview = ident_name_of(arguments[0]) if arguments.count > 0 else sview("", 0, 0)
                        return element_n if ident_name_of(head) == "set" and (element_n == "f32" or element_n == "f64") else sview("", 0, 0)
                    Expr.Unary(operator, operand, unary_line):
                        return set_float_element(operand)
                    Expr.Paren(inner, paren_line):
                        return set_float_element(inner)
                    _:
                        return sview("", 0, 0)

        # The float-element spelling of the set-binding named NAME (param/local), else "".
        def set_binding_float_element(names: darray[sview]&, elements: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                index: mutable usize = 0
                while index < names.count |found, index|:
                    found <- elements[index] if names[index] == name and found == ""
                    index <- index + 1
                return found

        # Flag every membership `x in S` whose right operand names a set-of-float binding.
        def set_membership_check_expression(expression: Ast::Expr, names: darray[sview]&, elements: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.In:
                            element: sview = set_binding_float_element(names, elements, ident_name_of(right))
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SetElementUnsupported, name: "", line: line, expected: "", actual: element}) if element != ""
                        table <- set_membership_check_expression(left, names, elements, table)
                        table <- set_membership_check_expression(right, names, elements, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- set_membership_check_expression(operand, names, elements, table)
                    Expr.Paren(inner, paren_line):
                        table <- set_membership_check_expression(inner, names, elements, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- set_membership_check_expression(argument, names, elements, table)
                    _:
                        pass

        def set_membership_check_statements(statements: darray[Ast::Stmt], names: darray[sview]&, elements: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- set_membership_check_expression(expression, names, elements, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- set_membership_check_expression(value, names, elements, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- set_membership_check_expression(value, names, elements, table)
                        Stmt.Contract(kind, expression, line):
                            table <- set_membership_check_expression(expression, names, elements, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- set_membership_check_expression(returned, names, elements, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- set_membership_check_expression(condition, names, elements, table)
                            table <- set_membership_check_statements(then_body, names, elements, table)
                            table <- set_membership_check_statements(else_body, names, elements, table)
                        Stmt.While(condition, body, line):
                            table <- set_membership_check_expression(condition, names, elements, table)
                            table <- set_membership_check_statements(body, names, elements, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- set_membership_check_expression(iterable, names, elements, table)
                            table <- set_membership_check_statements(body, names, elements, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- set_membership_check_statements(body, names, elements, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- set_membership_check_expression(scrutinee, names, elements, table)
                            for arm in arms |table| -> table:
                                table <- set_membership_check_statements(arm.body, names, elements, table)
                        _:
                            pass

        # Collect set-of-float local bindings (recursively) into the name/element maps.
        def set_membership_collect_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, elements: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, elements|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            local_element: sview = set_float_element(type_expression)
                            if local_element != "":
                                names.push(name)
                                elements.push(local_element)
                        Stmt.If(condition, then_body, else_body, line):
                            set_membership_collect_locals(then_body, names, elements)
                            set_membership_collect_locals(else_body, names, elements)
                        Stmt.While(condition, body, line):
                            set_membership_collect_locals(body, names, elements)
                        Stmt.For(bind, variables, iterable, body, line):
                            set_membership_collect_locals(body, names, elements)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            set_membership_collect_locals(body, names, elements)
                        _:
                            pass

        def check_set_membership_element_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            elements: mutable darray[sview] = []
                            for parameter in params |names, elements|:
                                parameter_element: sview = set_float_element(parameter.type_expression)
                                if parameter_element != "":
                                    names.push(parameter.name)
                                    elements.push(parameter_element)
                            set_membership_collect_locals(body, names, elements)
                            table <- set_membership_check_statements(body, names, elements, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_set_membership_element_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_set_membership_element_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_set_membership_element(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_set_membership_element_decls(declarations, table)
