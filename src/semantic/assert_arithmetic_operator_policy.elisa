# Closed TokenKind set used to classify arithmetic assert operands.
module AssertArithmeticOperatorPolicy:
    public:
        def is_arithmetic(operator: Lexer::TokenKind) -> bool:
            matches: bool = when operator:
                Lexer::TokenKind.Plus | Lexer::TokenKind.Minus | Lexer::TokenKind.Star | Lexer::TokenKind.Slash | Lexer::TokenKind.Percent -> true
                _ -> false
            assert(matches == (
                when operator:
                    Lexer::TokenKind.Plus | Lexer::TokenKind.Minus | Lexer::TokenKind.Star | Lexer::TokenKind.Slash | Lexer::TokenKind.Percent -> true
                    _ -> false
            ))
            can Abort.Panic:
                return matches
