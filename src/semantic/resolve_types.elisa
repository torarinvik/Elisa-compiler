extend Semantic:
    private:
        # Primitive-name families for the literal-initializer check.
        def is_integer_type_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u8&" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
                    _ -> false


        def is_float_type_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "f32" | "f64" -> true
                    _ -> false


        def is_string_type_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "cstr" | "dstr" | "sview" -> true
                    _ -> false


        # The declared head-type name when the annotation is a bare (possibly
        # `mutable`-wrapped) primitive name; "" otherwise (refs, optionals,
        # generics, user types — all skipped).
        def bare_type_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        bare_type_name(operand) return if operator == TokenKind.Mutable
                    Expr.Ident(name, ident_line):
                        return name
                    _:
                        pass
                # NOTE: a tuple type annotation `(A, B, …)` returns "" here (Unknown), NOT a
                # sentinel name. Tried collapsing it to a reserved "(tuple)" name so tuple-typed
                # variables could be checked — but a SemTypeKind carried through the type-NAME
                # string leaks into every name-consuming check (check_unknown_type_name flags
                # "(tuple)" as an unknown type; named-mismatch renders "expects (tuple)").
                # Structural type info must live OUT of the name-string channel (the interned
                # type table). Until then, tuple-typed variables stay Unknown.
                return ""


        # Whether a literal of `lit_kind` ("int"/"float"/"string"/"char"/"bool")
        # can NEVER initialize a variable of primitive type `type_name` — the
        # oracle-verified impossible-pair matrix (see /tmp/m1,m2 probes; adaptive
        # pairs like int->char, char->int, int->float, float->int are LEGAL).
        def literal_never_fits(lit_kind: sview, type_name: sview) -> bool:
            can Abort.Panic:
                return when lit_kind:
                    "string" -> is_integer_type_name(type_name) or is_float_type_name(type_name) or type_name == "bool" or type_name == "char"
                    "int" -> is_string_type_name(type_name) or type_name == "bool"
                    "bool" -> is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name) or type_name == "char"
                    "char" -> is_string_type_name(type_name)
                    "float" -> type_name == "bool"
                    _ -> false


        # The literal kind of a direct literal expression ("" for anything else).
        def literal_kind_of(value: Ast::Expr) -> sview:
            can Abort.Panic:
                match value:
                    Expr.IntLit(int_value):
                        return "int"
                    Expr.FloatLit(float_text):
                        return "float"
                    Expr.StringLit(string_text):
                        return "string"
                    Expr.CharLit(char_text):
                        return "char"
                    Expr.BoolLit(bool_value):
                        return "bool"
                    _:
                        pass
                return ""


        # Record a binding's bare primitive type name ("" = unknown). SCOPED
        # (item 106): a re-declaration PUSHES a shadow entry — lookups scan
        # backward (innermost wins) and block exits truncate to their scope
        # mark, so an inner `x: u8` never degrades the outer `x: i64`.
        def note_local_type(names: mutable darray[sview]&, types: mutable darray[sview]&, name: sview, type_name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                names.push(name)
                types.push(type_name)


        # Recorded type of `name`, "" if unknown — INNERMOST (last-pushed) wins.
        def local_type_of(names: darray[sview]&, types: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while name_index > 0 |name_index: usize = names.count|:
                    name_index <- name_index - 1
                    types[name_index] return if names[name_index] == name
                return ""


        # Contextual literal descent (Phase C item 102 sliver): check a NESTED
        # array literal against a structural darray/array annotation — the
        # top-level scalar case belongs to check_darray_element_mismatch; this
        # recursion only enters when the ELEMENT type is itself a sequence
        # container (`x: darray[darray[i64]] = [[1, "s"]]` — oracle: "darray
        # literal element expects i64, got …"). Depth-bounded defensively.
        def check_nested_array_literal(value: Ast::Expr, expected_id: u32, depth: u32, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth > 16
                expected_head: sview = interned_name(expected_id, table) if interned_kind(expected_id, table) == SemTypeKind.Container else ""
                return if expected_head != "darray" and expected_head != "array"
                element_id: u32 = interned_elem(expected_id, 0, table)
                element_is_sequence: bool = interned_kind(element_id, table) == SemTypeKind.Container and (interned_name(element_id, table) == "darray" or interned_name(element_id, table) == "array")
                element_spelling: sview = type_name_of_row(element_id, table)
                match value:
                    Expr.Paren(inner, paren_line):
                        table <- check_nested_array_literal(inner, expected_id, depth, names, types, table)
                    Expr.If(condition, then_expr, else_expr, if_line):
                        # A branch is a complete value under the declared context, so
                        # enter one level deeper: direct `["bad"]` branches must check
                        # their scalar leaves, while nested containers continue recursing.
                        table <- check_nested_array_literal(then_expr, expected_id, depth + 1, names, types, table)
                        table <- check_nested_array_literal(else_expr, expected_id, depth + 1, names, types, table)
                    Expr.Block(statements, value, captures, block_line):
                        # A block expression's final value is also a complete value under
                        # the declaration context; its statements are checked by the
                        # ordinary statement walkers.
                        table <- check_nested_array_literal(value, expected_id, depth + 1, names, types, table)
                    Expr.Array(literal_elements, literal_line):
                        # Scalar leaves are checked only INSIDE a descent (depth > 0) —
                        # depth 0 belongs to the existing element check.
                        check_leaves: bool = not element_is_sequence and depth > 0 and element_spelling != ""
                        for literal_element in literal_elements |table|:
                            table <- check_nested_array_literal(literal_element, element_id, depth + 1, names, types, table) if element_is_sequence
                            continue if not check_leaves
                            leaf_literal: sview = literal_kind_of(literal_element)
                            leaf_family: sview = infer_family(literal_element, names, types, table) if leaf_literal == "" else ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DArrayElementTypeMismatch, name: "", pos: Ast::expr_pos(literal_element), line: literal_line.line, expected: element_spelling, actual: stage0_literal_spelling(leaf_literal)}) if leaf_literal != "" and literal_never_fits(leaf_literal, element_spelling)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DArrayElementTypeMismatch, name: "", pos: Ast::expr_pos(literal_element), line: literal_line.line, expected: element_spelling, actual: infer_spelling(literal_element, names, types, table)}) if leaf_family != "" and firm_never_fits(leaf_family, element_spelling)
                    _:
                        pass


        # Truncate both local-type channels back to a scope mark — the block-exit
        # half of the scoped-shadowing rule (item 106).
        def close_type_scope(scope_mark: usize, names: mutable darray[sview]&, types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Abort.Panic:
                names.truncate(scope_mark)
                types.truncate(scope_mark)
                # The structural channel moves in lockstep with the flat one (every
                # note_local_type pairs with a note_local_type_id*), so one mark
                # serves both — guarded for safety.
                table.local_type_names <- table.local_type_names.truncate(scope_mark) if table.local_type_names.count > scope_mark
                table.local_type_ids <- table.local_type_ids.truncate(scope_mark) if table.local_type_ids.count > scope_mark


        # A primitive/void/unknown InferType (no carried name).
        def primitive_type(kind: SemTypeKind) -> InferType:
            return InferType{kind: kind, name: sview("", 0, 0)}


        # Map a declared bare type NAME onto an InferType. A recognized primitive maps to
        # its kind; a non-empty unrecognized name is a `Named` (struct/enum) carrying the
        # spelling; "" is `Unknown`.
        def type_of_name(type_name: sview) -> InferType:
            can Abort.Panic:
                # Scalar kinds KEEP the declared spelling in .name (stage0-parity
                # diagnostics print the precise type: "usize", not the family "int";
                # see stage0_value_spelling). Family consumers ignore .name.
                InferType{kind: SemTypeKind.Int, name: type_name} return if is_integer_type_name(type_name)
                InferType{kind: SemTypeKind.Float, name: type_name} return if is_float_type_name(type_name)
                InferType{kind: SemTypeKind.String, name: type_name} return if is_string_type_name(type_name)
                primitive_type(SemTypeKind.Bool) return if type_name == "bool"
                primitive_type(SemTypeKind.Char) return if type_name == "char"
                primitive_type(SemTypeKind.Void) return if type_name == "void"
                primitive_type(SemTypeKind.Unknown) return if type_name == ""
                return InferType{kind: SemTypeKind.Named, name: type_name}


        # The declared bare RETURN-type name of a direct call to `function_name`, "" if unknown.
        # SOUND: returns a type only when `function_name` names exactly ONE Func symbol (no
        # overloads — differing signatures could return different types), so an ambiguous
        # or non-function name yields "" (Unknown).
        def function_return_type(table: SymbolTable&, function_name: sview) -> sview:
            can Abort.Panic:
                # Chain walk, not a whole-table scan (see name_known): the chain visits
                # same-named rows in push order, so the "overloaded -> ambiguous" early
                # return fires exactly where the old scan fired it.
                found: mutable sview = ""
                seen: mutable bool = false
                row: mutable u32 = symbol_chain_head(table, function_name)
                while row != 4294967295 |found, seen, row, table, function_name|:
                    chain_symbol: Symbol& = &table.symbols[row.usize()]
                    if chain_symbol.kind == SymbolKind.Func and chain_symbol.name == function_name:
                        "" return if seen   # overloaded — ambiguous return type
                        found <- chain_symbol.return_type
                        seen <- true
                    row <- table.symbol_name_next[row.usize()]
                return found


        # The structural interned TypeId of a value expression (0 if unmodeled):
        # annotated local, registered struct field, or unique direct call's return.
        def structural_type_id_of(expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(value_name, value_line):
                        return local_type_id_of(value_name, table)
                    Expr.Call(value_callee, value_arguments, value_argument_names, value_call_line):
                        match value_callee:
                            Expr.Ident(called_name, called_line):
                                return function_return_type_id(table, called_name)
                            _:
                                pass
                        return 0
                    Expr.Index(indexed_object, index_expression, index_line):
                        return indexed_element_type_id(structural_type_id_of(indexed_object, names, types, table), table)
                    Expr.IndexN(indexed_object_n, index_arguments, index_n_line):
                        selected_id: mutable u32 = structural_type_id_of(indexed_object_n, names, types, table)
                        for _ in index_arguments |selected_id|:
                            selected_id <- indexed_element_type_id(selected_id, table)
                        return selected_id
                    Expr.Field(field_object, field_name, field_access_line):
                        field_object_type: InferType = infer_expression_type(field_object, names, types, table)
                        field_type_id_of(table, field_object_type.name, field_name) return if field_object_type.kind == SemTypeKind.Named
                        # A normal field access through `state: State&` deliberately keeps
                        # the reference itself opaque in the coarse inference channel (a
                        # ref is not the value it points at).  The structural channel still
                        # knows the referent, so unwrap reference layers for field lookup.
                        field_object_id: mutable u32 = structural_type_id_of(field_object, names, types, table)
                        while interned_kind(field_object_id, table) == SemTypeKind.Ref:
                            field_object_id <- interned_elem(field_object_id, 0, table)
                        field_type_id_of(table, interned_name(field_object_id, table), field_name) return if interned_kind(field_object_id, table) == SemTypeKind.Named
                        return 0
                    _:
                        return 0


        # The structural return TypeId of a direct call to `function_name` (0 if unknown).
        # Same uniqueness guard as function_return_type: overloads yield 0.
        def function_return_type_id(table: SymbolTable&, function_name: sview) -> u32:
            can Abort.Panic:
                found_id: u32 =
                    for symbol in table.symbols |found_id: u32 = 0, seen = false| -> found_id:
                        if symbol.kind == SymbolKind.Func and symbol.name == function_name:
                            0 return if seen   # overloaded — ambiguous return type
                            found_id <- symbol.return_type_id
                            seen <- true
                return found_id


        # The declared bare TYPE name of struct `owner`'s field `field_name`, "" if unknown
        # (struct not registered, field absent, or field's type not a bare name).
        def field_type_of(table: SymbolTable&, owner: sview, field_name: sview) -> sview:
            can Abort.Panic:
                while field_row_index < table.struct_field_owner.count |field_row_index: usize = 0|:
                    table.struct_field_type[field_row_index] return if table.struct_field_owner[field_row_index] == owner and table.struct_field_name[field_row_index] == field_name
                    field_row_index <- field_row_index + 1
                return ""


        # The STRUCTURAL interned TypeId of struct `owner`'s field `field_name`
        # (0 if unknown) — the Phase C sibling of field_type_of.
        def field_type_id_of(table: SymbolTable&, owner: sview, field_name: sview) -> u32:
            can Abort.Panic:
                while field_id_index < table.struct_field_owner.count |field_id_index: usize = 0|:
                    table.struct_field_type_id[field_id_index] return if table.struct_field_owner[field_id_index] == owner and table.struct_field_name[field_id_index] == field_name
                    field_id_index <- field_id_index + 1
                return 0


        # Whether struct `owner`'s field `field_name` was declared `mutable`. False when
        # the struct/field is not registered (default: immutable — callers only fire when
        # the field IS registered, so this default is never the deciding factor there).
        def field_is_mutable(table: SymbolTable&, owner: sview, field_name: sview) -> bool:
            can Abort.Panic:
                # WHICH `owner` -- field rows are keyed by bare struct name, so four
                # modules each declaring a `Grade` share the key and the first row wins.
                # nw-core has exactly that: InTheDark, Maze, Removals and Sokoban all
                # declare `Grade`, all with a `floor` field, and only Maze's is immutable.
                # Every assignment to the other three reported `field "floor" is
                # immutable`, on stage1 alone, for a program stage0 compiles.
                # When the enclosing module names one, that row wins outright.
                if table.current_module != "":
                    while own_row < table.struct_field_owner.count |own_row: usize = 0|:
                        if table.struct_field_owner[own_row] == owner and table.struct_field_name[own_row] == field_name and struct_field_module_at(table, own_row) == table.current_module:
                            return table.struct_field_mutable[own_row]
                        own_row <- own_row + 1
                # Otherwise: if the bare name belongs to more than ONE module, this check
                # cannot tell which struct is meant and must not fire. The semantic phase
                # keeps type names BARE -- `x: InTheDark::Grade` resolves to just "Grade" --
                # so the qualifier the source wrote is already gone by here, and the scan
                # would answer from whichever module was included first.
                #
                # Answering "mutable" instead of guessing is the safe direction: it drops a
                # check, it does not invent an error. stage0 resolves the same assignment
                # correctly and the gate runs both compilers, so the property is still
                # enforced -- just not twice.
                #
                # The real fix is qualified type names through the semantic phase, which is
                # the same 37-site change the struct-owner column deliberately avoided.
                modules_seen: mutable darray[sview] = []
                while scan_row < table.struct_field_owner.count |scan_row: usize = 0, modules_seen|:
                    if table.struct_field_owner[scan_row] == owner and table.struct_field_name[scan_row] == field_name:
                        row_module: sview = struct_field_module_at(table, scan_row)
                        modules_seen.push(row_module) if not any seen in modules_seen where seen == row_module
                    scan_row <- scan_row + 1
                true return if modules_seen.count > 1
                while mut_row_index < table.struct_field_owner.count |mut_row_index: usize = 0|:
                    table.struct_field_mutable[mut_row_index] return if table.struct_field_owner[mut_row_index] == owner and table.struct_field_name[mut_row_index] == field_name
                    mut_row_index <- mut_row_index + 1
                return false


        # Whether struct `name` is affinity-disciplined (`linear`/`affine`) — a single-use
        # "linear handle" type that may not be a dict key or set element.
        def struct_is_affine(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                while affine_row_index < table.struct_affine_owner.count |affine_row_index: usize = 0|:
                    true return if table.struct_affine_owner[affine_row_index] == name
                    affine_row_index <- affine_row_index + 1
                return false

        def expression_is_null(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(null_name, null_line): null_name == "null"
                    Expr.Paren(inner, paren_line): expression_is_null(inner)
                    _: false


        # Whether function `owner` declares at least one signature effect (`can[...]`), per the
        # effect-row registry. Used to decide a call site requires a local effect grant.
        def function_declares_effect(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                while effect_row_index < table.function_effect_owner.count |effect_row_index: usize = 0|:
                    true return if table.function_effect_owner[effect_row_index] == owner
                    effect_row_index <- effect_row_index + 1
                return false


        # Whether function `owner` performs an untrusted `panic` in its body (per the
        # effect-source registry) — i.e. it INFERS an effect even without declaring one.
        def function_body_panics(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                while source_row_index < table.function_effect_source_owner.count |source_row_index: usize = 0|:
                    true return if table.function_effect_source_owner[source_row_index] == owner
                    source_row_index <- source_row_index + 1
                return false


        # Whether a call to `owner` requires an effect grant at the call site: it either
        # DECLARES signature effects or INFERS one (untrusted panic in body). One sound hop
        # of stage0's transitive effect inference.
        # The first declared signature-effect ref of `owner` ("Abort.Panic",
        # "Console", ...), or "Abort.Panic" when the effect is inferred from an
        # untrusted body panic, or "" when the function carries no effect. Used to
        # render stage0's exact ungranted-call warning text.
        def function_first_effect_ref(table: SymbolTable&, owner: sview) -> sview:
            can Abort.Panic:
                while effect_row_index < table.function_effect_owner.count |effect_row_index: usize = 0|:
                    table.function_effect_name[effect_row_index] return if table.function_effect_owner[effect_row_index] == owner
                    effect_row_index <- effect_row_index + 1
                while source_index < table.function_effect_source_owner.count |source_index: usize = 0|:
                    if table.function_effect_source_owner[source_index] == owner:
                        recorded: sview = table.function_effect_source_ref[source_index] if source_index < table.function_effect_source_ref.count else ""
                        return recorded if recorded != "" else "Abort.Panic"
                    source_index <- source_index + 1
                return ""

        # The canonical declared effect refs of `owner`, including the concrete `via`
        # requirement rows recorded by symbol collection. A bare family suppresses its
        # member rows, matching stage0's permission-ref canonicalization. The small insertion
        # sort keeps diagnostics deterministic and matches stage0's lexical ordering.
        def effect_ref_less(left: sview, right: sview) -> bool:
            can Abort.Panic:
                limit: usize = sview_len(left) if sview_len(left) < sview_len(right) else sview_len(right)
                while index < limit |index: usize = 0|:
                    true return if sview_at(left, index) < sview_at(right, index)
                    false return if sview_at(left, index) > sview_at(right, index)
                    index <- index + 1.usize()
                return sview_len(left) < sview_len(right)

        def function_effect_refs(table: SymbolTable&, owner: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                collected: mutable darray[sview] = []
                while row_index < table.function_effect_owner.count |row_index: usize = 0|:
                    if table.function_effect_owner[row_index] == owner:
                        candidate: sview = table.function_effect_name[row_index]
                        duplicate: bool = any existing in collected where existing == candidate
                        collected.push(candidate) if not duplicate
                    row_index <- row_index + 1.usize()
                if collected.count == 0:
                    while source_index < table.function_effect_source_owner.count |source_index: usize = 0|:
                        if table.function_effect_source_owner[source_index] == owner:
                            inferred: mutable sview = table.function_effect_source_ref[source_index] if source_index < table.function_effect_source_ref.count else ""
                            inferred <- "Abort.Panic" if inferred == ""
                            collected.push(inferred) if not (any existing in collected where existing == inferred)
                        source_index <- source_index + 1.usize()
                # The Global family is INFERRED, never declared-only: a function that declares
                # `can[Memory.Allocate]` and also reads a global requires BOTH (stage0 unions
                # its declared and inferred refs). The fallback above consults the inferred
                # rows only when nothing is declared, so the Global rows are merged in
                # unconditionally. Nothing registers them unless `-Wglobals` is on, which is
                # what keeps this a no-op on a default build.
                while global_index < table.function_effect_source_owner.count |global_index: usize = 0, collected|:
                    if table.function_effect_source_owner[global_index] == owner:
                        global_ref: sview = table.function_effect_source_ref[global_index] if global_index < table.function_effect_source_ref.count else ""
                        is_global_ref: bool = effect_ref_family(global_ref) == "Global"
                        collected.push(global_ref) if is_global_ref and not (any existing in collected where existing == global_ref)
                    global_index <- global_index + 1
                # If both `P` and `P.Member` are present, stage0 retains the whole-family
                # ref and drops the more specific rows.
                canonical: mutable darray[sview] = []
                for candidate in collected:
                    family: sview = effect_ref_family(candidate)
                    has_bare: bool = any bare in collected where bare == family
                    canonical.push(candidate) if not (has_bare and candidate != family)
                for outer in 0..<canonical.count |canonical|:
                    position: mutable usize = outer
                    while position > 0.usize() |position, canonical|:
                        break if not effect_ref_less(canonical[position], canonical[position - 1.usize()])
                        swap: sview = canonical[position - 1.usize()]
                        canonical[position - 1.usize()] <- canonical[position]
                        canonical[position] <- swap
                        position <- position - 1.usize()
                return canonical

        # DECLARED-only variant: the first signature-declared effect ref of `owner`,
        # ignoring body-inferred registry entries (whose ref is a heuristic). Used by
        # the postfix-grant coverage check, which must not over-fire on inferred refs.
        def function_first_declared_effect_ref(table: SymbolTable&, owner: sview) -> sview:
            can Abort.Panic:
                while declared_index < table.function_effect_owner.count |declared_index: usize = 0|:
                    table.function_effect_name[declared_index] return if table.function_effect_owner[declared_index] == owner
                    declared_index <- declared_index + 1
                return ""

        # The concrete permission named after `via`, or empty when this is an ordinary
        # permission/effect reference. `via` remains part of the source spelling in the
        # abstract row; callers get a separate concrete row for authority checking.
        def effect_ref_via(effect_ref: sview) -> sview:
            via_index: mutable usize = 0
            depth: mutable int = 0
            while via_index + 2.usize() < sview_len(effect_ref) |via_index, depth|:
                byte: u8 = sview_at(effect_ref, via_index)
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                is_via: bool = depth == 0 and sview_at(effect_ref, via_index) == 118 and sview_at(effect_ref, via_index + 1.usize()) == 105 and sview_at(effect_ref, via_index + 2.usize()) == 97
                before_is_boundary: bool = via_index == 0.usize() or not ((sview_at(effect_ref, via_index - 1.usize()) >= 48 and sview_at(effect_ref, via_index - 1.usize()) <= 57) or (sview_at(effect_ref, via_index - 1.usize()) >= 65 and sview_at(effect_ref, via_index - 1.usize()) <= 90) or (sview_at(effect_ref, via_index - 1.usize()) >= 97 and sview_at(effect_ref, via_index - 1.usize()) <= 122) or sview_at(effect_ref, via_index - 1.usize()) == 95)
                after_index: mutable usize = via_index + 3.usize()
                after_is_boundary: bool = after_index >= sview_len(effect_ref) or not ((sview_at(effect_ref, after_index) >= 48 and sview_at(effect_ref, after_index) <= 57) or (sview_at(effect_ref, after_index) >= 65 and sview_at(effect_ref, after_index) <= 90) or (sview_at(effect_ref, after_index) >= 97 and sview_at(effect_ref, after_index) <= 122) or sview_at(effect_ref, after_index) == 95)
                if is_via and before_is_boundary and after_is_boundary:
                    while after_index < sview_len(effect_ref) and (sview_at(effect_ref, after_index) == 32 or sview_at(effect_ref, after_index) == 9 or sview_at(effect_ref, after_index) == 13) |after_index|:
                        after_index <- after_index + 1.usize()
                    return effect_ref[after_index:sview_len(effect_ref)]
                via_index <- via_index + 1.usize()
            return sview("", 0, 0)

        def effect_ref_trim_layout(effect_ref: sview) -> sview:
            start: mutable usize = 0
            finish: mutable usize = sview_len(effect_ref)
            while start < finish and (sview_at(effect_ref, start) == 32 or sview_at(effect_ref, start) == 9 or sview_at(effect_ref, start) == 13) |start, finish, effect_ref|:
                start <- start + 1.usize()
            while finish > start and (sview_at(effect_ref, finish - 1.usize()) == 32 or sview_at(effect_ref, finish - 1.usize()) == 9 or sview_at(effect_ref, finish - 1.usize()) == 13) |finish, start, effect_ref|:
                finish <- finish - 1.usize()
            return effect_ref[start:finish]

        # The abstract row of a two-dimensional effect reference. Handler
        # specialization compares this part; `via` is checked as a separate
        # concrete permission row and is never part of the abstract identity.
        def effect_ref_abstract(effect_ref: sview) -> sview:
            abstract_index: mutable usize = 0
            depth: mutable int = 0
            while abstract_index + 2.usize() < sview_len(effect_ref) |abstract_index, depth|:
                byte: u8 = sview_at(effect_ref, abstract_index)
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                is_via: bool = depth == 0 and sview_at(effect_ref, abstract_index) == 118 and sview_at(effect_ref, abstract_index + 1.usize()) == 105 and sview_at(effect_ref, abstract_index + 2.usize()) == 97
                before_is_boundary: bool = abstract_index == 0.usize() or not ((sview_at(effect_ref, abstract_index - 1.usize()) >= 48 and sview_at(effect_ref, abstract_index - 1.usize()) <= 57) or (sview_at(effect_ref, abstract_index - 1.usize()) >= 65 and sview_at(effect_ref, abstract_index - 1.usize()) <= 90) or (sview_at(effect_ref, abstract_index - 1.usize()) >= 97 and sview_at(effect_ref, abstract_index - 1.usize()) <= 122) or sview_at(effect_ref, abstract_index - 1.usize()) == 95)
                after_index: mutable usize = abstract_index + 3.usize()
                after_is_boundary: bool = after_index >= sview_len(effect_ref) or not ((sview_at(effect_ref, after_index) >= 48 and sview_at(effect_ref, after_index) <= 57) or (sview_at(effect_ref, after_index) >= 65 and sview_at(effect_ref, after_index) <= 90) or (sview_at(effect_ref, after_index) >= 97 and sview_at(effect_ref, after_index) <= 122) or sview_at(effect_ref, after_index) == 95)
                return effect_ref_trim_layout(effect_ref[0:abstract_index]) if is_via and before_is_boundary and after_is_boundary
                abstract_index <- abstract_index + 1.usize()
            return effect_ref_trim_layout(effect_ref)

        # The permission FAMILY of an effect ref: the segment before the first '.' or '['.
        # Generic abstract effects such as `Writer[sview]` retain their full surface spelling
        # in function rows, but grant coverage and diagnostics operate on the family head.
        def effect_ref_family(effect_ref: sview) -> sview:
            can Abort.Panic:
                abstract_ref: sview = effect_ref_abstract(effect_ref)
                family_start: mutable usize = 0
                while dot_index < sview_len(abstract_ref) |dot_index: usize = 0|:
                    # Namespace qualification is not a new effect family:
                    # `Effects::Tick` has the same row identity as `Tick`.
                    if abstract_ref[dot_index] == 58 and dot_index + 1.usize() < sview_len(abstract_ref) and abstract_ref[dot_index + 1.usize()] == 58:
                        family_start <- dot_index + 2.usize()
                        dot_index <- dot_index + 2.usize()
                        continue
                    abstract_ref[family_start:dot_index] return if abstract_ref[dot_index] == '.' or abstract_ref[dot_index] == '['
                    dot_index <- dot_index + 1
                return abstract_ref[family_start:sview_len(abstract_ref)]

        def function_has_effect(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                return function_declares_effect(table, owner) or function_body_panics(table, owner)
