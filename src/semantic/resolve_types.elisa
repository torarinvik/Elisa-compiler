extend Semantic:
    private:
        # Primitive-name families for the literal-initializer check.
        def is_integer_type_name(name: sview) -> bool:
            can Abort.Panic:
                # Every spelling below starts with `i` or `u` (105/117) and is 2-7 bytes;
                # reject the rest before the string compares (type_of_name calls this per
                # inferred identifier).
                name_length: usize = name.len
                return false if name_length < 2 or name_length > 7
                first_byte: u8 = name[0]
                return false if first_byte != 105 and first_byte != 117
                return when name:
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u8&" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
                    _ -> false


        def is_float_type_name(name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "f32" | "f64" -> true
                    _ -> false


        def is_string_type_name_prefix(name: sview, name_length: usize) -> bool:
            can Abort.Panic:
                return true if:
                    name_length == 4 and sview_slice_equals(name, 0, "cstr")
                    name_length == 4 and sview_slice_equals(name, 0, "dstr")
                    name_length == 5 and sview_slice_equals(name, 0, "sview")
                if name_length > 6 and name[name_length - 1] == 93:
                    return true if:
                        sview_slice_equals(name, 0, "cstr[")
                        sview_slice_equals(name, 0, "dstr[")
                        sview_slice_equals(name, 0, "sview[")
                return true if name_length > 0 and name[name_length - 1] == 63 and is_string_type_name_prefix(name, name_length - 1)
                return false


        def is_string_type_name(name: sview) -> bool:
            can Abort.Panic:
                return is_string_type_name_prefix(name, name.len)


        # The declared head-type name when the annotation is a bare (possibly
        # `mutable`-wrapped) primitive name; "" otherwise (refs, optionals,
        # generics, user types — all skipped).
        def bare_type_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return bare_type_name(operand) if operator == TokenKind.Mutable
                    Expr.Ident(name, ident_line):
                        return name
                    _:
                        pass
                # NOTE: a tuple type annotation `(A, B, …)` returns "" here (Unknown), NOT a
                # sentinel name. Tried collapsing it to a reserved "(tuple)" name so tuple-typed
                # variables could be checked — but a SemTypeKind carried through the type-NAME
                # string leaks into every name-consuming check (check_unknown_type_name flags
                # "(tuple)" as an unknown type; named-mismatch renders "expects (tuple)").
                # Structural type info must live OUT of the name-string channel (the interned
                # type table). Until then, tuple-typed variables stay Unknown.
                return ""


        # Whether a literal of `lit_kind` ("int"/"float"/"string"/"char"/"bool")
        # can NEVER initialize a variable of primitive type `type_name` — the
        # oracle-verified impossible-pair matrix (see /tmp/m1,m2 probes; adaptive
        # pairs like int->char, char->int, int->float, float->int are LEGAL).
        def literal_never_fits(lit_kind: sview, type_name: sview) -> bool:
            can Abort.Panic:
                # Nothing fits `void`. Left permissive, `xs: void[2] = [1, "s"]` passed every
                # semantic check and TRAPPED the backend asking LLVM for void's size (found by
                # the malformed-input smoke, 2026-09-07); stage0 reports each element.
                return true if type_name == "void"
                return when lit_kind:
                    "string" -> is_integer_type_name(type_name) or is_float_type_name(type_name) or type_name == "bool" or type_name == "char"
                    "int" -> is_string_type_name(type_name) or type_name == "bool"
                    "bool" -> is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name) or type_name == "char"
                    "char" -> is_string_type_name(type_name)
                    "float" -> type_name == "bool"
                    _ -> false


        # The literal kind of a direct literal expression ("" for anything else).
        def literal_kind_of(value: Ast::Expr) -> sview:
            can Abort.Panic:
                match value:
                    Expr.IntLit(int_value, _):
                        return "int"
                    Expr.FloatLit(float_text, _):
                        return "float"
                    Expr.StringLit(string_text, _):
                        return "string"
                    Expr.CharLit(char_text, _):
                        return "char"
                    Expr.BoolLit(bool_value, _):
                        return "bool"
                    _:
                        pass
                return ""


        # Record a binding's bare primitive type name ("" = unknown). SCOPED
        # (item 106): a re-declaration PUSHES a shadow entry — lookups scan
        # backward (innermost wins) and block exits truncate to their scope
        # mark, so an inner `x: u8` never degrades the outer `x: i64`.
        def note_local_type(names: mutable darray[sview]&, types: mutable darray[sview @source]&, name: sview, type_name: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                names.push(name)
                types.push(type_name)


        # Recorded type of `name`, "" if unknown — INNERMOST (last-pushed) wins.
        def local_type_of(names: darray[sview]&, types: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                while name_index > 0 |name_index: usize = names.count|:
                    name_index <- name_index - 1
                    return types[name_index] if names[name_index] == name
                return ""


        # Contextual literal descent (Phase C item 102 sliver): check a NESTED
        # array literal against a structural darray/array annotation — the
        # top-level scalar case belongs to check_darray_element_mismatch; this
        # recursion only enters when the ELEMENT type is itself a sequence
        # container (`x: darray[darray[i64]] = [[1, "s"]]` — oracle: "darray
        # literal element expects i64, got …"). Depth-bounded defensively.
        def check_nested_array_literal(value: Ast::Expr, expected_id: u32, depth: u32, names: darray[sview]&, types: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth > 16
                expected_head: sview = interned_name(expected_id, table) if interned_kind(expected_id, table) == SemTypeKind.Container else ""
                return if expected_head != "darray" and expected_head != "array"
                element_id: u32 = interned_elem(expected_id, 0, table)
                element_is_sequence: bool = interned_kind(element_id, table) == SemTypeKind.Container and (interned_name(element_id, table) == "darray" or interned_name(element_id, table) == "array")
                element_spelling: sview = type_name_of_row(element_id, table)
                match value:
                    Expr.Paren(inner, paren_line):
                        table <- check_nested_array_literal(inner, expected_id, depth, names, types, table)
                    Expr.If(condition, then_expr, else_expr, if_line):
                        # A branch is a complete value under the declared context, so
                        # enter one level deeper: direct `["bad"]` branches must check
                        # their scalar leaves, while nested containers continue recursing.
                        table <- check_nested_array_literal(then_expr, expected_id, depth + 1, names, types, table)
                        table <- check_nested_array_literal(else_expr, expected_id, depth + 1, names, types, table)
                    Expr.Block(statements, value, captures, block_line):
                        # A block expression's final value is also a complete value under
                        # the declaration context; its statements are checked by the
                        # ordinary statement walkers.
                        table <- check_nested_array_literal(value, expected_id, depth + 1, names, types, table)
                    Expr.Array(literal_elements, literal_line):
                        # Scalar leaves are checked only INSIDE a descent (depth > 0) —
                        # depth 0 belongs to the existing element check.
                        check_leaves: bool = not element_is_sequence and depth > 0 and element_spelling != ""
                        for literal_element in literal_elements |table|:
                            table <- check_nested_array_literal(literal_element, element_id, depth + 1, names, types, table) if element_is_sequence
                            continue if not check_leaves
                            leaf_literal: sview = literal_kind_of(literal_element)
                            leaf_family: sview = infer_family(literal_element, names, types, table) if leaf_literal == "" else ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DArrayElementTypeMismatch, name: "", pos: Ast::expr_pos(literal_element), line: literal_line.line, expected: element_spelling, actual: stage0_literal_spelling(leaf_literal)}) if leaf_literal != "" and literal_never_fits(leaf_literal, element_spelling)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DArrayElementTypeMismatch, name: "", pos: Ast::expr_pos(literal_element), line: literal_line.line, expected: element_spelling, actual: infer_spelling(literal_element, names, types, table)}) if leaf_family != "" and firm_never_fits(leaf_family, element_spelling)
                    _:
                        pass


        # Truncate both local-type channels back to a scope mark — the block-exit
        # half of the scoped-shadowing rule (item 106).
        def close_type_scope(scope_mark: usize, names: mutable darray[sview]&, types: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Abort.Panic:
                names.truncate(scope_mark)
                types.truncate(scope_mark)
                # The structural channel moves in lockstep with the flat one (every
                # note_local_type pairs with a note_local_type_id*), so one mark
                # serves both — guarded for safety.
                table.local_type_names <- table.local_type_names.truncate(scope_mark) if table.local_type_names.count > scope_mark
                table.local_type_ids <- table.local_type_ids.truncate(scope_mark) if table.local_type_ids.count > scope_mark
                table.local_const_enum_owner_names <- table.local_const_enum_owner_names.truncate(scope_mark) if table.local_const_enum_owner_names.count > scope_mark
                table.local_const_enum_owner_modules <- table.local_const_enum_owner_modules.truncate(scope_mark) if table.local_const_enum_owner_modules.count > scope_mark


        # A primitive/void/unknown InferType (no carried name).
        def primitive_type(kind: SemTypeKind) -> InferType:
            return InferType{kind: kind, name: sview("", 0, 0)}


        # Map a declared bare type NAME onto an InferType. A recognized primitive maps to
        # its kind; a non-empty unrecognized name is a `Named` (struct/enum) carrying the
        # spelling; "" is `Unknown`.
        def type_of_name(type_name: sview @source) -> InferType:
            can Abort.Panic:
                # Scalar kinds KEEP the declared spelling in .name (stage0-parity
                # diagnostics print the precise type: "usize", not the family "int";
                # see stage0_value_spelling). Family consumers ignore .name.
                # "" (an unrecorded local) is the common case and matches none of the families.
                return primitive_type(SemTypeKind.Unknown) if type_name.len == 0
                return InferType{kind: SemTypeKind.Int, name: type_name} if is_integer_type_name(type_name)
                return InferType{kind: SemTypeKind.Float, name: type_name} if is_float_type_name(type_name)
                return InferType{kind: SemTypeKind.String, name: type_name} if is_string_type_name(type_name)
                return when type_name:
                    "bool" -> primitive_type(SemTypeKind.Bool)
                    "char" -> primitive_type(SemTypeKind.Char)
                    "void" -> primitive_type(SemTypeKind.Void)
                    "" -> primitive_type(SemTypeKind.Unknown)
                    _ -> InferType{kind: SemTypeKind.Named, name: type_name}


        # The declared bare RETURN-type name of a direct call to `function_name`, "" if unknown.
        # SOUND: returns a type only when `function_name` names exactly ONE Func symbol (no
        # overloads — differing signatures could return different types), so an ambiguous
        # or non-function name yields "" (Unknown).
        def function_return_type(table: SymbolTable&, function_name: sview) -> sview @source:
            can Abort.Panic:
                # Chain walk, not a whole-table scan (see name_known): the chain visits
                # same-named rows in push order, so the "overloaded -> ambiguous" early
                # return fires exactly where the old scan fired it.
                found: mutable sview @source = ""
                seen: mutable bool = false
                row: mutable u32 = symbol_chain_head(table, function_name)
                while row != 4294967295 |found, seen, row, table, function_name|:
                    chain_symbol: Symbol& = &table.symbols[row.usize()]
                    if chain_symbol.kind == SymbolKind.Func and chain_symbol.name == function_name:
                        return "" if seen   # overloaded — ambiguous return type
                        found <- chain_symbol.return_type
                        seen <- true
                    row <- table.symbol_name_next[row.usize()]
                return found


        # Whether a generic parameter with `name` belongs to the exact declaration.
        # Bound rows use the high-bit line encoding but retain the same owner offset.
        def function_generic_param_named(table: SymbolTable&, line: u32, offset: u32, name: sview) -> bool:
            can Abort.Panic:
                return true if table.generic_param_lines.count != table.generic_param_names.count or table.generic_param_lines.count != table.generic_param_owner_offsets.count
                encoded_bound_line: u32 = line + 2147483648
                for generic_index in 0..<table.generic_param_lines.count |line, offset, name, table, encoded_bound_line|:
                    return true if (table.generic_param_lines[generic_index] == line or table.generic_param_lines[generic_index] == encoded_bound_line) and table.generic_param_owner_offsets[generic_index] == offset and table.generic_param_names[generic_index] == name
                return false


        # A structural return row can contain a generic type parameter under any number of
        # reference/container/optional wrappers. An uninstantiated generic row is not a
        # concrete caller type: treating `T&` as a reference to the named type `T` creates a
        # false mismatch for valid calls such as `id(value: i32& @r) -> T& @r`. Keep the
        # structural channel conservative until call-site substitution is available.
        def type_id_contains_function_generic(type_id: u32, function_line: u32, function_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if type_id == 0
                if interned_kind(type_id, table) == SemTypeKind.Named:
                    return function_generic_param_named(table, function_line, function_offset, interned_name(type_id, table))
                for element_position in 0..<interned_elem_count(type_id, table) |type_id, function_line, function_offset, table|:
                    return true if type_id_contains_function_generic(interned_elem(type_id, element_position.u32(), table), function_line, function_offset, table)
                return false


        # Region-parameterized return rows are generic schemes as well. Until direct
        # call-site region substitution is available, they must remain unknown to the
        # structural expression channel; exposing the literal scheme region would reject
        # valid same-region calls or invent a concrete lifetime.
        def type_id_contains_region(type_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if type_id == 0
                return true if interned_kind(type_id, table) == SemTypeKind.Region
                for element_position in 0..<interned_elem_count(type_id, table) |type_id, table|:
                    return true if type_id_contains_region(interned_elem(type_id, element_position.u32(), table), table)
                return false


        # The structural interned TypeId of a value expression (0 if unmodeled):
        # annotated local, registered struct field, or unique direct call's return.
        def structural_type_id_of(expression: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(value_name, value_line):
                        local_id: u32 = local_type_id_of(value_name, table)
                        return local_id if local_id != 0
                        # An unmodeled local (e.g. a `darray[T]&` parameter) still
                        # shadows a same-named global from another module. Some passes
                        # carry the function's bindings only in the flat `names` channel.
                        return 0 if local_type_bound(value_name, table) or any local_name in names where local_name == value_name
                        return global_type_id_of(value_name, table)
                    Expr.Unary(operator, operand, unary_line):
                        # Address-of changes the value into a reference, but the
                        # initializer check compares its referent against the declared
                        # reference target, so expose the place's id here. Other unary
                        # qualifiers preserve the operand's structural identity.
                        return structural_type_id_of(operand, names, types, table) if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                        return 0
                    Expr.Call(value_callee, value_arguments, value_argument_names, value_call_line):
                        match value_callee:
                            Expr.Ident(called_name, called_line):
                                return function_return_type_id(table, called_name)
                            _:
                                pass
                        return 0
                    Expr.Index(indexed_object, index_expression, index_line):
                        return indexed_element_type_id(structural_type_id_of(indexed_object, names, types, table), table)
                    Expr.IndexN(indexed_object_n, index_arguments, index_n_line):
                        selected_id: mutable u32 = structural_type_id_of(indexed_object_n, names, types, table)
                        for _ in index_arguments |selected_id|:
                            selected_id <- indexed_element_type_id(selected_id, table)
                        return selected_id
                    Expr.Field(field_object, field_name, field_access_line):
                        # ONE walk of the object, not two. This arm used to call
                        # infer_expression_type(field_object) AND structural_type_id_of(field_object),
                        # and infer_expression_type's own Field arm calls back into this function --
                        # so each link cost T(n) = T(n-1) + S(n-1) and S(n) = T(n-1) + S(n-1), i.e.
                        # 2^links. MEASURED 2026-09-17: a 28-link chain rooted at a `T&` param took
                        # ~23s, and the internal-suite corpus's 270-link chain.elisa never finished,
                        # hanging that gate for hours. See test/repro/field_chain_exponential_*.elisa.
                        #
                        # The structural channel goes FIRST and answers on its own. The coarse walk
                        # is kept ONLY for a non-Field object, where it is a leaf lookup rather than
                        # a second descent of the whole chain -- and where it is the case the coarse
                        # channel exists for (`p.x` on a local of a named struct type).
                        #
                        # Skipping it for a FIELD object loses nothing: the only caller that reaches
                        # here with a Field object is infer_expression_type's own Field arm, and it
                        # gets here only AFTER its Named branch failed to return -- which already
                        # establishes that the coarse type of this very object is not Named.
                        field_object_id: mutable u32 = structural_type_id_of(field_object, names, types, table)
                        while interned_kind(field_object_id, table) == SemTypeKind.Ref:
                            field_object_id <- interned_elem(field_object_id, 0, table)
                        return field_type_id_of(table, interned_name(field_object_id, table), field_name) if interned_kind(field_object_id, table) == SemTypeKind.Named
                        match field_object:
                            Expr.Field(nested_object, nested_field, nested_pos):
                                return 0
                            _:
                                pass
                        field_object_type: InferType = infer_expression_type(field_object, names, types, table)
                        return field_type_id_of(table, field_object_type.name, field_name) if field_object_type.kind == SemTypeKind.Named
                        return 0
                    _:
                        return 0


        # The structural return TypeId of a direct call to `function_name` (0 if unknown).
        # Same uniqueness guard as function_return_type: overloads yield 0.
        def function_return_type_id(table: SymbolTable&, function_name: sview) -> u32:
            can Abort.Panic:
                # `symbol_name_head`/`symbol_name_next` is the authoritative collision-safe
                # index for declaration names. The old whole-table scan made every inferred
                # call-return lookup proportional to the complete imported program; on the
                # proof assistant's self-import this dominated semantic time and retained the
                # large table while repeatedly comparing unrelated names. Walk only this name's
                # overload chain. The real-name guard remains deliberate: hash collisions must
                # not turn an unrelated function into a return-type match.
                found_id: mutable u32 = 0
                seen: mutable bool = false
                cursor: mutable u32 = symbol_chain_head(table, function_name)
                while cursor != 4294967295 |found_id, seen, cursor, table, function_name|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    if symbol.name == function_name and symbol.kind == SymbolKind.Func:
                        return 0 if seen   # overloaded — ambiguous return type
                        # A generic function's return row is a scheme, not an
                        # instantiated type. Returning it would make reference and
                        # container compatibility compare a caller's concrete type
                        # against the literal type parameter name.
                        found_id <- 0 if type_id_contains_function_generic(symbol.return_type_id, symbol.line, symbol.offset, table) or type_id_contains_region(symbol.return_type_id, table) else symbol.return_type_id
                        seen <- true
                    cursor <- table.symbol_name_next[cursor.usize()]
                return found_id


        # Resolve a field row without conflating same-named structs from different
        # modules. Prefer the current module, then a top-level declaration. The coarse
        # semantic type channel stores bare names, so an external module row is usable
        # only when the owner/field pair is unambiguous.
        def struct_field_row_for_type(table: SymbolTable&, owner: sview,
                                      field_name: sview) -> i64:
            can Abort.Panic:
                return struct_field_row_for_type_in_module(table, owner, field_name, table.current_module)


        # The module-explicit sibling for late passes whose traversal context is not
        # reflected in table.current_module (for example the affine flow walk).
        def struct_field_row_for_type_in_module(table: SymbolTable&, owner: sview,
                                                field_name: sview, current_module: sview) -> i64:
            can Abort.Panic:
                # Preserve the original precedence (current module, then top level, then a
                # single unqualified external row) while visiting the field table only once.
                # The previous three passes were a dominant cost during full-source imports.
                current_row: mutable i64 = -1
                top_row: mutable i64 = -1
                first_row: mutable i64 = -1
                first_module: mutable sview = ""
                ambiguous: mutable bool = false
                # The (owner, field) chain visits exactly the matching rows, in row order.
                chain_row: mutable u32 = struct_field_pair_head(table, struct_field_pair_hash(owner, field_name))
                while chain_row != SYMBOL_INDEX_ROW_NONE |chain_row, current_row, top_row, first_row, first_module, ambiguous|:
                    row: usize = chain_row.usize()
                    if table.struct_field_owner[row] == owner and table.struct_field_name[row] == field_name:
                        row_module: sview = struct_field_module_at(table, row)
                        current_row <- row.i64() if current_row < 0 and current_module != "" and row_module == current_module
                        top_row <- row.i64() if top_row < 0 and row_module == ""
                        if first_row < 0:
                            first_row <- row.i64()
                            first_module <- row_module
                        elif row_module != first_module:
                            ambiguous <- true
                    chain_row <- table.struct_field_pair_next[row]
                return current_row if current_row >= 0
                return top_row if top_row >= 0
                return -1 if ambiguous
                return first_row


        # The declared bare TYPE name of struct `owner`'s field `field_name`, "" if unknown
        # (struct not registered, field absent, or field's type not a bare name).
        def field_type_of(table: SymbolTable&, owner: sview, field_name: sview) -> sview:
            can Abort.Panic:
                row: i64 = struct_field_row_for_type(table, owner, field_name)
                return "" if row < 0
                return table.struct_field_type[row.usize()]


        # The STRUCTURAL interned TypeId of struct `owner`'s field `field_name`
        # (0 if unknown) — the Phase C sibling of field_type_of.
        def field_type_id_of(table: SymbolTable&, owner: sview, field_name: sview) -> u32:
            can Abort.Panic:
                row: i64 = struct_field_row_for_type(table, owner, field_name)
                return 0 if row < 0
                return table.struct_field_type_id[row.usize()]


        def field_type_id_of_in_module(table: SymbolTable&, owner: sview,
                                       field_name: sview, current_module: sview) -> u32:
            can Abort.Panic:
                row: i64 = struct_field_row_for_type_in_module(table, owner, field_name, current_module)
                return 0 if row < 0
                return table.struct_field_type_id[row.usize()]


        # Whether struct `owner`'s field `field_name` was declared `mutable`. False when
        # the struct/field is not registered (default: immutable — callers only fire when
        # the field IS registered, so this default is never the deciding factor there).
        def field_is_mutable(table: SymbolTable&, owner: sview, field_name: sview) -> bool:
            can Abort.Panic:
                # WHICH `owner` -- field rows are keyed by bare struct name, so four
                # modules each declaring a `Grade` share the key and the first row wins.
                # nw-core has exactly that: InTheDark, Maze, Removals and Sokoban all
                # declare `Grade`, all with a `floor` field, and only Maze's is immutable.
                # Every assignment to the other three reported `field "floor" is
                # immutable`, on stage1 alone, for a program stage0 compiles.
                # When the enclosing module names one, that row wins outright.
                if table.current_module != "":
                    # Owner-chain walks: exactly OWNER's rows, ascending, as the full scans were.
                    own_chain: mutable u32 = struct_field_owner_head(table, owner)
                    while own_chain != SYMBOL_INDEX_ROW_NONE |own_chain|:
                        own_row: usize = own_chain.usize()
                        if table.struct_field_owner[own_row] == owner and table.struct_field_name[own_row] == field_name and struct_field_module_at(table, own_row) == table.current_module:
                            return table.struct_field_mutable[own_row]
                        own_chain <- table.struct_field_owner_next[own_row]
                # Otherwise: if the bare name belongs to more than ONE module, this check
                # cannot tell which struct is meant and must not fire. The semantic phase
                # keeps type names BARE -- `x: InTheDark::Grade` resolves to just "Grade" --
                # so the qualifier the source wrote is already gone by here, and the scan
                # would answer from whichever module was included first.
                #
                # Answering "mutable" instead of guessing is the safe direction: it drops a
                # check, it does not invent an error. stage0 resolves the same assignment
                # correctly and the gate runs both compilers, so the property is still
                # enforced -- just not twice.
                #
                # The real fix is qualified type names through the semantic phase, which is
                # the same 37-site change the struct-owner column deliberately avoided.
                modules_seen: mutable darray[sview] = []
                scan_chain: mutable u32 = struct_field_owner_head(table, owner)
                while scan_chain != SYMBOL_INDEX_ROW_NONE |scan_chain, modules_seen|:
                    scan_row: usize = scan_chain.usize()
                    if table.struct_field_owner[scan_row] == owner and table.struct_field_name[scan_row] == field_name:
                        row_module: sview = struct_field_module_at(table, scan_row)
                        modules_seen.push(row_module) if not any seen in modules_seen where seen == row_module
                    scan_chain <- table.struct_field_owner_next[scan_row]
                return true if modules_seen.count > 1
                mut_chain: mutable u32 = struct_field_owner_head(table, owner)
                while mut_chain != SYMBOL_INDEX_ROW_NONE |mut_chain|:
                    mut_row_index: usize = mut_chain.usize()
                    return table.struct_field_mutable[mut_row_index] if table.struct_field_owner[mut_row_index] == owner and table.struct_field_name[mut_row_index] == field_name
                    mut_chain <- table.struct_field_owner_next[mut_row_index]
                return false


        # Whether a struct module is visible at an unqualified type use. Affinity rows store
        # the declaration module separately from the bare spelling: without this check, an
        # unrelated same-named type in another module could make the current type appear affine,
        # or a `using Module` import could lose the affinity marker entirely.
        def struct_affinity_module_visible(table: SymbolTable&, module: sview, name: sview) -> bool:
            can Abort.Panic:
                return true if:
                    module == "" or module == table.current_module
                    any imported in table.imported_modules where imported == module
                    semantic_possible_import_module_visible(table, module, table.current_module)
                # A qualified `M::T` use reaches these rows as its bare member `T`, and only when
                # M itself has a row for `T` (affine_qualified_member). Unless another `T` is
                # visible unqualified here, the bare spelling can only mean M's, so M's marker
                # applies. Without this, every module-qualified affine local could be copied and
                # reused after a move. A visible competitor keeps the old answer.
                return true if not competing_type_visible(table, module, name)
                return false if not (any brought in table.imported_members where brought == name) and not semantic_possible_import_member_owner_visible(table, module, name, table.current_module)
                member_index: mutable usize = 0
                while member_index < table.module_member_name.count |member_index, module, name, table|:
                    return true if table.module_member_name[member_index] == name and table.module_member_owner[member_index] == module
                    member_index <- member_index + 1
                return false

        # Whether a type declaration spelled `name` that module `module` does not own is visible
        # unqualified from the current module: a `using` that brings in any `name`, a same-named
        # type of the current or an imported module, or a top-level one. A top-level declaration
        # is a type symbol without a module row; miscounting only keeps the conservative answer.
        def competing_type_visible(table: SymbolTable&, module: sview, name: sview) -> bool:
            can Abort.Panic:
                return true if any brought in table.imported_members where brought == name
                return true if semantic_possible_import_member_visible(table, name, table.current_module)
                module_rows: mutable usize = 0
                while row < table.qualified_type_name.count |row: usize = 0, module_rows, table, module, name|:
                    if table.qualified_type_name[row] == name:
                        module_rows <- module_rows + 1
                        owner: sview = table.qualified_type_module[row]
                        return true if owner != module and (owner == table.current_module or (any imported in table.imported_modules where imported == owner) or semantic_possible_import_module_visible(table, owner, table.current_module))
                    row <- row + 1
                type_symbols: mutable usize = 0
                cursor: mutable u32 = symbol_chain_head(table, name)
                while cursor != 4294967295 |type_symbols, cursor, table, name|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    is_type: bool = symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Extern or symbol.kind == SymbolKind.Alias
                    type_symbols <- type_symbols + 1 if symbol.name == name and is_type
                    cursor <- table.symbol_name_next[cursor.usize()]
                return type_symbols > module_rows

        # Whether struct `name` is affinity-disciplined (`linear`/`affine`) — a single-use
        # "linear handle" type that may not be a dict key or set element.
        def struct_is_affine(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                while affine_row_index < table.struct_affine_owner.count |affine_row_index: usize = 0, name, table|:
                    module: sview = table.struct_affine_module[affine_row_index] if affine_row_index < table.struct_affine_module.count else ""
                    return true if table.struct_affine_owner[affine_row_index] == name and struct_affinity_module_visible(table, module, name)
                    affine_row_index <- affine_row_index + 1
                return false

        # The declared-affine subset distinguishes borrowable owners from plain aggregates
        # whose fields transitively contain an affine value.
        def struct_is_declared_affine(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                while affine_row_index < table.struct_declared_affine_owner.count |affine_row_index: usize = 0, name, table|:
                    module: sview = table.struct_declared_affine_module[affine_row_index] if affine_row_index < table.struct_declared_affine_module.count else ""
                    return true if table.struct_declared_affine_owner[affine_row_index] == name and struct_affinity_module_visible(table, module, name)
                    affine_row_index <- affine_row_index + 1
                return false

        def expression_is_null(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(null_name, null_line): null_name == "null"
                    Expr.Paren(inner, paren_line): expression_is_null(inner)
                    _: false


        # Whether function `owner` declares at least one signature effect (`can[...]`), per the
        # effect-row registry. Used to decide a call site requires a local effect grant.
        def function_declares_effect(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                return false if effect_name_has_multiple_module_owners(table, owner)
                if table.effect_owner_indexed == table.function_effect_owner.count:
                    effect_row: mutable u32 = effect_owner_chain_head(table, owner)
                    while effect_row != SYMBOL_INDEX_ROW_NONE |effect_row, table, owner|:
                        return true if table.function_effect_owner[effect_row.usize()] == owner
                        effect_row <- table.effect_owner_next[effect_row.usize()]
                    return false
                while effect_row_index < table.function_effect_owner.count |effect_row_index: usize = 0|:
                    return true if table.function_effect_owner[effect_row_index] == owner
                    effect_row_index <- effect_row_index + 1
                return false


        # Whether function `owner` performs an untrusted `panic` in its body (per the
        # effect-source registry) — i.e. it INFERS an effect even without declaring one.
        def function_body_panics(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                return false if effect_name_has_multiple_module_owners(table, owner)
                if table.effect_source_indexed == table.function_effect_source_owner.count:
                    source_row: mutable u32 = effect_source_chain_head(table, owner)
                    while source_row != SYMBOL_INDEX_ROW_NONE |source_row, table, owner|:
                        return true if table.function_effect_source_owner[source_row.usize()] == owner
                        source_row <- table.effect_source_next[source_row.usize()]
                    return false
                while source_row_index < table.function_effect_source_owner.count |source_row_index: usize = 0|:
                    return true if table.function_effect_source_owner[source_row_index] == owner
                    source_row_index <- source_row_index + 1
                return false
