extend Semantic:
    private:
        # Primitive-name families for the literal-initializer check.
        def is_integer_type_name(n: sview) -> bool:
            can Abort.Panic:
                if n == "i8" or n == "i16" or n == "i32" or n == "i64" or n == "int" or n == "isize":
                    return true
                return n == "u8" or n == "u16" or n == "u32" or n == "u64" or n == "usize" or n == "uintptr"


        def is_float_type_name(n: sview) -> bool:
            can Abort.Panic:
                return n == "f32" or n == "f64"


        def is_string_type_name(n: sview) -> bool:
            can Abort.Panic:
                return n == "cstr" or n == "dstr" or n == "sview"


        # The declared head-type name when the annotation is a bare (possibly
        # `mutable`-wrapped) primitive name; "" otherwise (refs, optionals,
        # generics, user types — all skipped).
        def bare_type_name(e: Ast::Expr) -> sview:
            can Abort.Panic:
                if e is Expr.Unary(op, operand, uline):
                    if op == TokenKind.Mutable:
                        return bare_type_name(operand)
                    return ""
                if e is Expr.Ident(name, iline):
                    return name
                return ""


        # Whether a literal of `lit_kind` ("int"/"float"/"string"/"char"/"bool")
        # can NEVER initialize a variable of primitive type `tname` — the
        # oracle-verified impossible-pair matrix (see /tmp/m1,m2 probes; adaptive
        # pairs like int->char, char->int, int->float, float->int are LEGAL).
        def literal_never_fits(lit_kind: sview, tname: sview) -> bool:
            can Abort.Panic:
                if lit_kind == "string":
                    return is_integer_type_name(tname) or is_float_type_name(tname) or tname == "bool" or tname == "char"
                if lit_kind == "int":
                    return is_string_type_name(tname) or tname == "bool"
                if lit_kind == "bool":
                    return is_integer_type_name(tname) or is_float_type_name(tname) or is_string_type_name(tname) or tname == "char"
                if lit_kind == "char":
                    return tname == "cstr" or tname == "dstr"
                if lit_kind == "float":
                    return tname == "bool"
                return false


        # The literal kind of a direct literal expression ("" for anything else).
        def literal_kind_of(value: Ast::Expr) -> sview:
            can Abort.Panic:
                if value is Expr.IntLit(iv):
                    return "int"
                if value is Expr.FloatLit(ft):
                    return "float"
                if value is Expr.StringLit(st):
                    return "string"
                if value is Expr.CharLit(ct):
                    return "char"
                if value is Expr.BoolLit(bv):
                    return "bool"
                return ""


        # Record a binding's bare primitive type name ("" = unknown). A repeated
        # name with a DIFFERENT recorded type degrades to "" (shadowing across
        # blocks is conflated by this flat table — conservative, never flags).
        def note_local_type(names: mutable darray[sview]&, types: mutable darray[sview]&, name: sview, tname: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                while i < names.count |i: usize = 0|:
                    if names[i] == name:
                        if types[i] != tname:
                            types[i] <- ""
                        return
                    i <- i + 1
                names.push(name)
                types.push(tname)


        # Recorded type of `name`, "" if unknown.
        def local_type_of(names: darray[sview]&, types: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while i < names.count |i: usize = 0|:
                    if names[i] == name:
                        return types[i]
                    i <- i + 1
                return ""


        # A primitive/void/unknown InferType (no carried name).
        def prim_type(k: TypeKind) -> InferType:
            return InferType{kind: k, name: sview("", 0, 0)}


        # Map a declared bare type NAME onto an InferType. A recognized primitive maps to
        # its kind; a non-empty unrecognized name is a `Named` (struct/enum) carrying the
        # spelling; "" is `Unknown`.
        def type_of_name(tname: sview) -> InferType:
            can Abort.Panic:
                if is_integer_type_name(tname):
                    return prim_type(TypeKind.Int)
                if is_float_type_name(tname):
                    return prim_type(TypeKind.Float)
                if is_string_type_name(tname):
                    return prim_type(TypeKind.String)
                if tname == "bool":
                    return prim_type(TypeKind.Bool)
                if tname == "char":
                    return prim_type(TypeKind.Char)
                if tname == "void":
                    return prim_type(TypeKind.Void)
                if tname == "":
                    return prim_type(TypeKind.Unknown)
                return InferType{kind: TypeKind.Named, name: tname}


        # The declared bare RETURN-type name of a direct call to `fname`, "" if unknown.
        # SOUND: returns a type only when `fname` names exactly ONE Func symbol (no
        # overloads — differing signatures could return different types), so an ambiguous
        # or non-function name yields "" (Unknown).
        def func_return_type(table: SymbolTable&, fname: sview) -> sview:
            can Abort.Panic:
                found: sview =
                    for s in table.symbols |found: sview = "", seen = false| -> found:
                        if s.kind == SymbolKind.Func and s.name == fname:
                            if seen:
                                return ""   # overloaded — ambiguous return type
                            found <- s.ret_type
                            seen <- true
                return found


        # The declared bare TYPE name of struct `owner`'s field `fname`, "" if unknown
        # (struct not registered, field absent, or field's type not a bare name).
        def field_type_of(table: SymbolTable&, owner: sview, fname: sview) -> sview:
            can Abort.Panic:
                while i < table.struct_field_owner.count |i: usize = 0|:
                    if table.struct_field_owner[i] == owner and table.struct_field_name[i] == fname:
                        return table.struct_field_type[i]
                    i <- i + 1
                return ""


        # THE type-inference engine: assign a structured `InferType` to an expression from
        # its shape + the flat local-type table + the struct-field registry. Sound SUBSET —
        # anything not modeled is `Unknown` (never used to flag). Comparisons/membership/
        # refinement/logic yield `Bool`; arithmetic yields a known operand's type; field
        # access `obj.field` yields the field's declared type; parens and sign/bitwise/
        # volatile unaries pass through; `not` yields `Bool`. Calls/constructors: Unknown.
        def infer_expr_type(e: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> InferType:
            can Memory.Allocate, Abort.Panic:
                if e is Expr.IntLit(iv):
                    return prim_type(TypeKind.Int)
                if e is Expr.FloatLit(ft):
                    return prim_type(TypeKind.Float)
                if e is Expr.StringLit(st):
                    return prim_type(TypeKind.String)
                if e is Expr.CharLit(ct):
                    return prim_type(TypeKind.Char)
                if e is Expr.BoolLit(bv):
                    return prim_type(TypeKind.Bool)
                if e is Expr.Ident(name, iline):
                    return type_of_name(local_type_of(names, types, name))
                if e is Expr.Paren(inner, pline):
                    return infer_expr_type(inner, names, types, table)
                # Field access `obj.field`: when obj is a known struct and field is a
                # registered bare-typed field, the access has that field's type.
                if e is Expr.Field(obj, field, fline):
                    ot: InferType = infer_expr_type(obj, names, types, table)
                    if ot.kind == TypeKind.Named:
                        return type_of_name(field_type_of(table, ot.name, field))
                    return prim_type(TypeKind.Unknown)
                # Direct call `f(...)`: the return type of a uniquely-named function.
                # Method/qualified calls (func is a Field/Scope) fall to Unknown.
                if e is Expr.Call(func, args, arg_names, cline):
                    if func is Expr.Ident(fname, fnline):
                        return type_of_name(func_return_type(table, fname))
                    return prim_type(TypeKind.Unknown)
                if e is Expr.Unary(op, operand, uline):
                    if op == TokenKind.Not:
                        return prim_type(TypeKind.Bool)
                    # `!x` is the volatile/atomic READ sigil (NOT logical not — that's
                    # `not`): it preserves the operand's type, like sign/bitwise ops.
                    if op == TokenKind.Bang or op == TokenKind.Minus or op == TokenKind.Plus or op == TokenKind.Tilde:
                        return infer_expr_type(operand, names, types, table)
                    return prim_type(TypeKind.Unknown)
                if e is Expr.Binary(left, op, right, bline):
                    if op in {TokenKind.EqEq, TokenKind.BangEq, TokenKind.Lt, TokenKind.Gt, TokenKind.LtEq, TokenKind.GtEq, TokenKind.In, TokenKind.Is, TokenKind.And, TokenKind.Or}:
                        return prim_type(TypeKind.Bool)
                    if op in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.LShift, TokenKind.RShift, TokenKind.Pipe, TokenKind.Caret, TokenKind.Ampersand}:
                        lt: InferType = infer_expr_type(left, names, types, table)
                        if lt.kind != TypeKind.Unknown:
                            return lt
                        return infer_expr_type(right, names, types, table)
                    return prim_type(TypeKind.Unknown)
                return prim_type(TypeKind.Unknown)


        # The coarse "family" string of an InferType, for the legacy literal/condition
        # checks: "int" | "float" | "bool" | "string" | "char" | "" (unknown/void/named).
        def family_of_kind(t: InferType) -> sview:
            can Abort.Panic:
                if t.kind == TypeKind.Int:
                    return "int"
                if t.kind == TypeKind.Float:
                    return "float"
                if t.kind == TypeKind.Bool:
                    return "bool"
                if t.kind == TypeKind.String:
                    return "string"
                if t.kind == TypeKind.Char:
                    return "char"
                return ""


        # Map a bare primitive type name onto its family (projection of type_of_name).
        def family_of_type_name(tname: sview) -> sview:
            can Abort.Panic:
                return family_of_kind(type_of_name(tname))


        # Infer an expression's type FAMILY — a projection of the structured engine.
        def infer_family(e: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return family_of_kind(infer_expr_type(e, names, types, table))


        # Whether a FIRM (non-literal) value of family `vfam` can never inhabit a
        # variable of primitive `tname`. Numerics are fully inter-convertible in
        # Elisa (int<->float, any width — oracle-verified), so only the hard
        # bool/string/numeric walls are flagged; `char` values are skipped
        # (adaptive rules untested for firm chars).
        def firm_never_fits(vfam: sview, tname: sview) -> bool:
            can Abort.Panic:
                tf: sview = family_of_type_name(tname)
                if tf == "":
                    return false
                if vfam == "bool":
                    return tf != "bool"
                if vfam == "int" or vfam == "float":
                    return tf == "bool" or tf == "string"
                if vfam == "string":
                    return tf == "int" or tf == "float" or tf == "bool"
                return false


        # Flag a value (literal OR firm expression) against a declared primitive.
        def check_value_against(value: Ast::Expr, tname: sview, dname: sview, line: u32, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                lit: sview = literal_kind_of(value)
                if lit != "":
                    if literal_never_fits(lit, tname):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: dname, line: line, expected: tname, actual: lit})
                else:
                    vfam: sview = infer_family(value, names, types, table)
                    if vfam != "" and firm_never_fits(vfam, tname):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: dname, line: line, expected: tname, actual: vfam})


        # Flag a `match` that omits at least one variant of its (known enum) scrutinee and
        # has no catch-all — parity with stage0's `non-exhaustive match`. SOUND SUBSET: it
        # reports only when the scrutinee is a plain identifier whose local-type is a
        # registered enum AND every arm is a variant / or-of-variants pattern; a catch-all
        # (`_`/binding) or any unclassifiable arm (literal/struct/tuple/typebind/…) BAILS,
        # so it can never falsely claim a covered value is missing.
        # NOTE: Multi-scrutinee tuple matches (`match a, b:`) are not yet supported for
        # exhaustiveness checking (the cartesian product of both types is complex to model).
        def check_match_exhaustive(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], line: u32, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                sname: sview = match scrutinee:
                    Expr.Ident(nm, il): nm
                    _:                  ""
                if sname == "":
                    return
                ename: sview = local_type_of(names, types, sname)
                if ename == "" or not enum_is_known(ename, table):
                    return
                # Every arm must be a variant (or or-of-variants) cover; anything else bails.
                covered: mutable darray[sview] = []
                for arm in arms:
                    if not collect_arm_variant_paths(arm.pattern, covered):
                        return
                # Report the first declared variant of `ename` no arm covers.
                while vi < table.enum_variant_owner.count |vi: usize = 0|:
                    if table.enum_variant_owner[vi] == ename:
                        vname: sview = table.enum_variant_name[vi]
                        if not paths_cover_variant(covered, vname):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveMatch, name: ename, line: line, expected: vname, actual: ""})
                            return
                    vi <- vi + 1


        # True if `ename` is a declared enum (has at least one variant in the registry).
        def enum_is_known(ename: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any o in table.enum_variant_owner where o == ename


        # Append the variant path(s) an arm pattern covers to `covered`, returning true.
        # Returns FALSE for a catch-all (`_`/binding) or any pattern that is not a variant
        # or or-of-variants — the signal for the caller to bail (cannot soundly report).
        def collect_arm_variant_paths(pat: Ast::Pattern, covered: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                ok: mutable bool = false
                match pat:
                    Pattern.Variant(path, fields):
                        covered.push(path)
                        ok <- true
                    Pattern.Or(options):
                        ok <- true
                        for o in options |ok, covered|:
                            if not collect_arm_variant_paths(o, covered):
                                ok <- false
                    Pattern.Wildcard:
                        ok <- false
                    Pattern.Binding(bn):
                        ok <- false
                    Pattern.Literal(t):
                        ok <- false
                    Pattern.Struct(sp, sf):
                        ok <- false
                    Pattern.Tuple(el):
                        ok <- false
                    Pattern.TypeBind(tt, tb):
                        ok <- false
                    Pattern.Other(ot):
                        ok <- false
                return ok


        # True if some collected variant path has a final `.`-tail equal to `vname`.
        def paths_cover_variant(covered: darray[sview]&, vname: sview) -> bool:
            can Abort.Panic:
                return any p in covered where path_tail_equals(p, vname)


        # True if the tail of `path` after its last `.` equals `vname` (a bare `path` with
        # no `.` compares whole).
        def path_tail_equals(path: sview, vname: sview) -> bool:
            can Abort.Panic:
                plen: usize = sview_len(path)
                vlen: usize = sview_len(vname)
                # Fold: the index of the last `.` (or -1) as a loop-expression.
                dot: isize =
                    for i in 0..<plen |d: isize = -1| -> d:
                        d <- i.isize() if sview_at(path, i) == '.' else d
                tail_start: usize = (dot + 1).usize()
                if plen - tail_start != vlen:
                    return false
                for j in 0..<vlen:
                    if sview_at(path, tail_start + j) != sview_at(vname, j):
                        return false
                return true


        # Literal-vs-declared-type checks across a body: `x: PRIM = LITERAL`
        # declarations, `x <- LITERAL` mutations (via the flat local-type table),
        # and `return LITERAL` against the declared return type. Recurses nested
        # bodies; only the oracle-verified impossible pairs are flagged.
        # A ternary `A if COND else B` (Expr.If) requires COND to be bool, mirroring
        # if/while. Checked in value positions (parity with stage0's `ternary condition
        # must be bool, got T`); recurses into the branches so chained ternaries are all
        # covered. Sound like NonBoolCondition: only fires when infer_family is certain
        # AND not bool (the `!x` volatile-read sigil preserves operand type, not bool).
        def check_ternary_cond(e: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match e:
                    Ast::Expr.If(cond, then_e, else_e, line):
                        fam: sview = infer_family(cond, names, types, table)
                        if fam != "" and fam != "bool":
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "ternary", line: line, expected: "bool", actual: fam})
                        table <- check_ternary_cond(then_e, names, types, table)
                        table <- check_ternary_cond(else_e, names, types, table)
                    _:
                        pass


        # Whether an operand's inferred kind is a firm (known) non-bool — the flaggable
        # case for a logical `and`/`or`. Unknown/Void/Named/Bool are never flagged.
        def kind_is_firm_non_bool(t: InferType) -> bool:
            can Abort.Panic:
                return t.kind == TypeKind.Int or t.kind == TypeKind.Float or t.kind == TypeKind.String or t.kind == TypeKind.Char


        # Whether an operand's inferred kind is a firm non-numeric — the flaggable case
        # for arithmetic `+ - * / %`. Only the hard bool/string walls; char is numeric-
        # adjacent (char arithmetic is legal) and int/float/unknown/named never flag.
        def kind_is_firm_non_numeric(t: InferType) -> bool:
            can Abort.Panic:
                return t.kind == TypeKind.Bool or t.kind == TypeKind.String


        # Comparison-compatibility group of a kind (for `==`/`!=`): 1 = bool, 2 = string,
        # 3 = numeric (int/float/char are mutually comparable — Elisa inter-converts
        # numerics and char is numeric-adjacent). 0 = not firm-comparable (Unknown/Void/
        # Named — never used to flag). Two firm operands in DIFFERENT non-zero groups can
        # never be equal, so an `==`/`!=` between them is a type error.
        def comparison_group(t: InferType) -> u8:
            can Abort.Panic:
                if t.kind == TypeKind.Bool:
                    return 1
                if t.kind == TypeKind.String:
                    return 2
                if t.kind == TypeKind.Int or t.kind == TypeKind.Float or t.kind == TypeKind.Char:
                    return 3
                return 0


        # Operator-operand type checks (docs: the type-inference engine's first real
        # unlock). Walks value expressions; a logical `and`/`or` with a firm non-bool
        # operand, or an arithmetic `+ - * / %` with a firm non-numeric operand, is
        # flagged. Sound SUBSET: only firmly-known incompatible operand kinds fire, so
        # any Unknown operand (the common case under the flat type table) is silent.
        def check_operator_operands(e: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match e:
                    Ast::Expr.Binary(left, op, right, line):
                        table <- check_operator_operands(left, names, types, table)
                        table <- check_operator_operands(right, names, types, table)
                        if op == TokenKind.And or op == TokenKind.Or:
                            lt: InferType = infer_expr_type(left, names, types, table)
                            rt: InferType = infer_expr_type(right, names, types, table)
                            if kind_is_firm_non_bool(lt):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: token_text(op), line: line, expected: "bool", actual: family_of_kind(lt)})
                            if kind_is_firm_non_bool(rt):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: token_text(op), line: line, expected: "bool", actual: family_of_kind(rt)})
                        elif op in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}:
                            lt: InferType = infer_expr_type(left, names, types, table)
                            rt: InferType = infer_expr_type(right, names, types, table)
                            if kind_is_firm_non_numeric(lt):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(op), line: line, expected: "number", actual: family_of_kind(lt)})
                            if kind_is_firm_non_numeric(rt):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(op), line: line, expected: "number", actual: family_of_kind(rt)})
                        elif op == TokenKind.EqEq or op == TokenKind.BangEq:
                            lt: InferType = infer_expr_type(left, names, types, table)
                            rt: InferType = infer_expr_type(right, names, types, table)
                            lg: u8 = comparison_group(lt)
                            rg: u8 = comparison_group(rt)
                            if lg != 0 and rg != 0 and lg != rg:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IncompatibleComparison, name: token_text(op), line: line, expected: family_of_kind(lt), actual: family_of_kind(rt)})
                    Ast::Expr.Unary(op, operand, line):
                        table <- check_operator_operands(operand, names, types, table)
                        if op == TokenKind.Not:
                            ot: InferType = infer_expr_type(operand, names, types, table)
                            if kind_is_firm_non_bool(ot):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: "not", line: line, expected: "bool", actual: family_of_kind(ot)})
                        elif op == TokenKind.Minus or op == TokenKind.Tilde:
                            ot: InferType = infer_expr_type(operand, names, types, table)
                            if kind_is_firm_non_numeric(ot):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(op), line: line, expected: "number", actual: family_of_kind(ot)})
                    Ast::Expr.Paren(inner, line):
                        table <- check_operator_operands(inner, names, types, table)
                    Ast::Expr.If(cond, then_e, else_e, line):
                        table <- check_operator_operands(cond, names, types, table)
                        table <- check_operator_operands(then_e, names, types, table)
                        table <- check_operator_operands(else_e, names, types, table)
                    Ast::Expr.Call(func, args, arg_names, line):
                        for a in args |table| -> table:
                            table <- check_operator_operands(a, names, types, table)
                    Ast::Expr.Index(obj, index, line):
                        table <- check_operator_operands(obj, names, types, table)
                        # `recv.cast[T]`: the bracket is a TYPE, not a value operand — don't
                        # recurse into it. Instead, if `recv` is an identifier whose declared
                        # type is a numeric primitive and `T` is a DIFFERENT numeric primitive,
                        # the `.cast` is a value conversion (stage0 requires a constructor).
                        is_cast: mutable bool = false
                        if obj is Expr.Field(recv, cast_field, cfline):
                            if cast_field == "cast":
                                is_cast <- true
                                if recv is Expr.Ident(rname, rnline):
                                    if index is Expr.Ident(tname, tnline):
                                        recv_tname: sview = local_type_of(names, types, rname)
                                        recv_numeric: bool = is_integer_type_name(recv_tname) or is_float_type_name(recv_tname)
                                        dst_numeric: bool = is_integer_type_name(tname) or is_float_type_name(tname)
                                        if recv_numeric and dst_numeric and recv_tname != tname:
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidCast, name: tname, line: line, expected: recv_tname, actual: ""})
                        if not is_cast:
                            table <- check_operator_operands(index, names, types, table)
                    _:
                        pass


        # A short spelling of an operator token for diagnostics ("and"/"or"/"+"/…).
        def token_text(op: TokenKind) -> sview:
            can Abort.Panic:
                if op == TokenKind.And:
                    return "and"
                if op == TokenKind.Or:
                    return "or"
                if op == TokenKind.Plus:
                    return "+"
                if op == TokenKind.Minus:
                    return "-"
                if op == TokenKind.Star:
                    return "*"
                if op == TokenKind.Slash:
                    return "/"
                if op == TokenKind.Percent:
                    return "%"
                if op == TokenKind.Tilde:
                    return "~"
                return "?"


        def check_var_inits(stmts: darray[Ast::Stmt], ret_tname: sview, names: mutable darray[sview]&, types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts |table, names, types| -> table:
                    match stmt:
                        Stmt.VarDecl(name, type_expr, value, line):
                            tname: sview = bare_type_name(type_expr)
                            note_local_type(names, types, name, tname)
                            table <- check_ternary_cond(value, names, types, table)
                            table <- check_operator_operands(value, names, types, table)
                            if tname != "":
                                table <- check_value_against(value, tname, name, line, names, types, table)
                        Stmt.Assign(target, op, value, line):
                            table <- check_ternary_cond(value, names, types, table)
                            table <- check_operator_operands(value, names, types, table)
                            if target is Expr.Ident(aname, aline):
                                if op == TokenKind.Assign:
                                    # `x = v` defines a fresh, unannotated local.
                                    note_local_type(names, types, aname, "")
                                elif op == TokenKind.LArrow:
                                    atype: sview = local_type_of(names, types, aname)
                                    if atype != "":
                                        table <- check_value_against(value, atype, aname, line, names, types, table)
                            elif target is Expr.Field(fobj, ffield, ffline):
                                # `p.x <- v`: the assigned value must fit field x's declared
                                # type (a Field target is always a mutation, never a define).
                                if op == TokenKind.LArrow:
                                    fot: InferType = infer_expr_type(fobj, names, types, table)
                                    if fot.kind == TypeKind.Named:
                                        ftype: sview = field_type_of(table, fot.name, ffield)
                                        if ftype != "":
                                            table <- check_value_against(value, ftype, ffield, line, names, types, table)
                        Stmt.Return(value, line):
                            if value is rvt:
                                table <- check_ternary_cond(rvt, names, types, table)
                                table <- check_operator_operands(rvt, names, types, table)
                            if ret_tname != "":
                                if value is rv:
                                    table <- check_value_against(rv, ret_tname, "return", line, names, types, table)
                        Stmt.If(cond, then_body, else_body, line):
                            table <- check_operator_operands(cond, names, types, table)
                            cfam: sview = infer_family(cond, names, types, table)
                            if cfam != "" and cfam != "bool":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "if", line: line, expected: "bool", actual: cfam})
                            table <- check_var_inits(then_body, ret_tname, names, types, table)
                            table <- check_var_inits(else_body, ret_tname, names, types, table)
                        Stmt.While(cond, body, line):
                            table <- check_operator_operands(cond, names, types, table)
                            wfam: sview = infer_family(cond, names, types, table)
                            if wfam != "" and wfam != "bool":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "while", line: line, expected: "bool", actual: wfam})
                            table <- check_var_inits(body, ret_tname, names, types, table)
                        Stmt.For(bind, vars, iter, body, line):
                            table <- check_loop_iterable(iter, names, types, table, line)
                            for v in vars |names, types|:
                                note_local_type(names, types, v, "")
                            table <- check_var_inits(body, ret_tname, names, types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            if binding != "":
                                note_local_type(names, types, binding, "")
                            table <- check_var_inits(body, ret_tname, names, types, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_match_exhaustive(scrutinee, arms, line, names, types, table)
                            for arm in arms |table| -> table:
                                table <- check_var_inits(arm.body, ret_tname, names, types, table)
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

