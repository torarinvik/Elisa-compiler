extend Semantic:
    private:
        # Primitive-name families for the literal-initializer check.
        def is_integer_type_name(name: sview) -> bool:
            can Abort.Panic:
                true return if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "int" or name == "isize"
                return name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uintptr"


        def is_float_type_name(name: sview) -> bool:
            can Abort.Panic:
                return name == "f32" or name == "f64"


        def is_string_type_name(name: sview) -> bool:
            can Abort.Panic:
                return name == "cstr" or name == "dstr" or name == "sview"


        # The declared head-type name when the annotation is a bare (possibly
        # `mutable`-wrapped) primitive name; "" otherwise (refs, optionals,
        # generics, user types — all skipped).
        def bare_type_name(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                if expression is Expr.Unary(operator, operand, unary_line):
                    bare_type_name(operand) return if operator == TokenKind.Mutable
                    return ""
                name return if expression is Expr.Ident(name, ident_line)
                # NOTE: a tuple type annotation `(A, B, …)` returns "" here (Unknown), NOT a
                # sentinel name. Tried collapsing it to a reserved "(tuple)" name so tuple-typed
                # variables could be checked — but a TypeKind carried through the type-NAME
                # string leaks into every name-consuming check (check_unknown_type_name flags
                # "(tuple)" as an unknown type; named-mismatch renders "expects (tuple)").
                # Structural type info must live OUT of the name-string channel (the interned
                # type table). Until then, tuple-typed variables stay Unknown.
                return ""


        # Whether a literal of `lit_kind` ("int"/"float"/"string"/"char"/"bool")
        # can NEVER initialize a variable of primitive type `type_name` — the
        # oracle-verified impossible-pair matrix (see /tmp/m1,m2 probes; adaptive
        # pairs like int->char, char->int, int->float, float->int are LEGAL).
        def literal_never_fits(lit_kind: sview, type_name: sview) -> bool:
            can Abort.Panic:
                return when lit_kind:
                    "string" -> is_integer_type_name(type_name) or is_float_type_name(type_name) or type_name == "bool" or type_name == "char"
                    "int" -> is_string_type_name(type_name) or type_name == "bool"
                    "bool" -> is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name) or type_name == "char"
                    "char" -> type_name == "cstr" or type_name == "dstr"
                    "float" -> type_name == "bool"
                    _ -> false


        # The literal kind of a direct literal expression ("" for anything else).
        def literal_kind_of(value: Ast::Expr) -> sview:
            can Abort.Panic:
                if value is Expr.IntLit(int_value):
                    return "int"
                if value is Expr.FloatLit(float_text):
                    return "float"
                if value is Expr.StringLit(string_text):
                    return "string"
                if value is Expr.CharLit(char_text):
                    return "char"
                if value is Expr.BoolLit(bool_value):
                    return "bool"
                return ""


        # Record a binding's bare primitive type name ("" = unknown). A repeated
        # name with a DIFFERENT recorded type degrades to "" (shadowing across
        # blocks is conflated by this flat table — conservative, never flags).
        def note_local_type(names: mutable darray[sview]&, types: mutable darray[sview]&, name: sview, type_name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                while name_index < names.count |name_index: usize = 0|:
                    if names[name_index] == name:
                        types[name_index] <- "" if types[name_index] != type_name
                        return
                    name_index <- name_index + 1
                names.push(name)
                types.push(type_name)


        # Recorded type of `name`, "" if unknown.
        def local_type_of(names: darray[sview]&, types: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                while name_index < names.count |name_index: usize = 0|:
                    types[name_index] return if names[name_index] == name
                    name_index <- name_index + 1
                return ""


        # A primitive/void/unknown InferType (no carried name).
        def primitive_type(kind: TypeKind) -> InferType:
            return InferType{kind: kind, name: sview("", 0, 0)}


        # Map a declared bare type NAME onto an InferType. A recognized primitive maps to
        # its kind; a non-empty unrecognized name is a `Named` (struct/enum) carrying the
        # spelling; "" is `Unknown`.
        def type_of_name(type_name: sview) -> InferType:
            can Abort.Panic:
                primitive_type(TypeKind.Int) return if is_integer_type_name(type_name)
                primitive_type(TypeKind.Float) return if is_float_type_name(type_name)
                primitive_type(TypeKind.String) return if is_string_type_name(type_name)
                primitive_type(TypeKind.Bool) return if type_name == "bool"
                primitive_type(TypeKind.Char) return if type_name == "char"
                primitive_type(TypeKind.Void) return if type_name == "void"
                primitive_type(TypeKind.Unknown) return if type_name == ""
                return InferType{kind: TypeKind.Named, name: type_name}


        # The declared bare RETURN-type name of a direct call to `function_name`, "" if unknown.
        # SOUND: returns a type only when `function_name` names exactly ONE Func symbol (no
        # overloads — differing signatures could return different types), so an ambiguous
        # or non-function name yields "" (Unknown).
        def function_return_type(table: SymbolTable&, function_name: sview) -> sview:
            can Abort.Panic:
                found: sview =
                    for symbol in table.symbols |found: sview = "", seen = false| -> found:
                        if symbol.kind == SymbolKind.Func and symbol.name == function_name:
                            "" return if seen   # overloaded — ambiguous return type
                            found <- symbol.return_type
                            seen <- true
                return found


        # The structural return TypeId of a direct call to `function_name` (0 if unknown).
        # Same uniqueness guard as function_return_type: overloads yield 0.
        def function_return_type_id(table: SymbolTable&, function_name: sview) -> u32:
            can Abort.Panic:
                found_id: u32 =
                    for symbol in table.symbols |found_id: u32 = 0, seen = false| -> found_id:
                        if symbol.kind == SymbolKind.Func and symbol.name == function_name:
                            0 return if seen   # overloaded — ambiguous return type
                            found_id <- symbol.return_type_id
                            seen <- true
                return found_id


        # The declared bare TYPE name of struct `owner`'s field `field_name`, "" if unknown
        # (struct not registered, field absent, or field's type not a bare name).
        def field_type_of(table: SymbolTable&, owner: sview, field_name: sview) -> sview:
            can Abort.Panic:
                while field_row_index < table.struct_field_owner.count |field_row_index: usize = 0|:
                    table.struct_field_type[field_row_index] return if table.struct_field_owner[field_row_index] == owner and table.struct_field_name[field_row_index] == field_name
                    field_row_index <- field_row_index + 1
                return ""


        # The STRUCTURAL interned TypeId of struct `owner`'s field `field_name`
        # (0 if unknown) — the Phase C sibling of field_type_of.
        def field_type_id_of(table: SymbolTable&, owner: sview, field_name: sview) -> u32:
            can Abort.Panic:
                while field_id_index < table.struct_field_owner.count |field_id_index: usize = 0|:
                    table.struct_field_type_id[field_id_index] return if table.struct_field_owner[field_id_index] == owner and table.struct_field_name[field_id_index] == field_name
                    field_id_index <- field_id_index + 1
                return 0


        # Whether struct `owner`'s field `field_name` was declared `mutable`. False when
        # the struct/field is not registered (default: immutable — callers only fire when
        # the field IS registered, so this default is never the deciding factor there).
        def field_is_mutable(table: SymbolTable&, owner: sview, field_name: sview) -> bool:
            can Abort.Panic:
                while mut_row_index < table.struct_field_owner.count |mut_row_index: usize = 0|:
                    table.struct_field_mutable[mut_row_index] return if table.struct_field_owner[mut_row_index] == owner and table.struct_field_name[mut_row_index] == field_name
                    mut_row_index <- mut_row_index + 1
                return false


        # Whether struct `name` is affinity-disciplined (`linear`/`affine`) — a single-use
        # "linear handle" type that may not be a dict key or set element.
        def struct_is_affine(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                while affine_row_index < table.struct_affine_owner.count |affine_row_index: usize = 0|:
                    true return if table.struct_affine_owner[affine_row_index] == name
                    affine_row_index <- affine_row_index + 1
                return false


        # Whether function `owner` declares at least one signature effect (`can[...]`), per the
        # effect-row registry. Used to decide a call site requires a local effect grant.
        def function_declares_effect(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                while effect_row_index < table.function_effect_owner.count |effect_row_index: usize = 0|:
                    true return if table.function_effect_owner[effect_row_index] == owner
                    effect_row_index <- effect_row_index + 1
                return false


        # Whether function `owner` performs an untrusted `panic` in its body (per the
        # effect-source registry) — i.e. it INFERS an effect even without declaring one.
        def function_body_panics(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                while source_row_index < table.function_effect_source_owner.count |source_row_index: usize = 0|:
                    true return if table.function_effect_source_owner[source_row_index] == owner
                    source_row_index <- source_row_index + 1
                return false


        # Whether a call to `owner` requires an effect grant at the call site: it either
        # DECLARES signature effects or INFERS one (untrusted panic in body). One sound hop
        # of stage0's transitive effect inference.
        def function_has_effect(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                return function_declares_effect(table, owner) or function_body_panics(table, owner)


        # THE type-inference engine: assign a structured `InferType` to an expression from
        # its shape + the flat local-type table + the struct-field registry. Sound SUBSET —
        # anything not modeled is `Unknown` (never used to flag). Comparisons/membership/
        # refinement/logic yield `Bool`; arithmetic yields a known operand's type; field
        # access `object.field` yields the field's declared type; parens and sign/bitwise/
        # volatile unaries pass through; `not` yields `Bool`. Calls/constructors: Unknown.
        def infer_expression_type(expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> InferType:
            can Memory.Allocate, Abort.Panic:
                if expression is Expr.IntLit(int_value):
                    return primitive_type(TypeKind.Int)
                if expression is Expr.FloatLit(float_text):
                    return primitive_type(TypeKind.Float)
                if expression is Expr.StringLit(string_text):
                    return primitive_type(TypeKind.String)
                if expression is Expr.CharLit(char_text):
                    return primitive_type(TypeKind.Char)
                if expression is Expr.BoolLit(bool_value):
                    return primitive_type(TypeKind.Bool)
                if expression is Expr.Ident(name, ident_line):
                    flat_type: InferType = type_of_name(local_type_of(names, types, name))
                    flat_type return if flat_type.kind != TypeKind.Unknown
                    # Structural fallback (Phase C): a local whose annotation was not a
                    # bare name may still have an interned TypeId. ONLY Container and
                    # Optional map — a `T&` local is NOT dereferenced to T (refs to
                    # buffers are legally indexed/field-accessed as raw memory, so a
                    # scalar-through-ref inference false-positives the index/field
                    # checks — corpus-verified), and Tuple idents stay Unknown here
                    # (the tuple/container sidecar check owns tuple-var misuse).
                    structural_id: u32 = local_type_id_of(name, table)
                    structural_kind: TypeKind = interned_kind(structural_id, table)
                    InferType{kind: structural_kind, name: interned_name(structural_id, table)} return if structural_kind == TypeKind.Container or structural_kind == TypeKind.Optional
                    return flat_type
                if expression is Expr.Paren(inner, paren_line):
                    return infer_expression_type(inner, names, types, table)
                # Tuple literal `(a, b, …)`: a distinct `Tuple` type (POD — the per-position
                # element types are NOT stored here; a consumer needing them recurses into the
                # `Expr.Tuple` node's `elements` in its own region context). This replaces the
                # former `Unknown` so operand checks can tell a whole tuple is not a scalar.
                if expression is Expr.Tuple(tuple_elements, tuple_line):
                    return InferType{kind: TypeKind.Tuple, name: "tuple"}
                # Indexing a container-typed local: `xs[i]` yields the element type,
                # `d[k]` the dict VALUE type (Phase C — via the interned type table).
                # Only bare-Ident receivers are modeled; `.cast[T]`'s bracket is a
                # type application (object is a Field), so it stays Unknown here.
                if expression is Expr.Index(indexed_object, index_expression, index_line):
                    if indexed_object is Expr.Ident(container_name, container_line):
                        element_type: InferType = infer_from_type_id(indexed_element_type_id(local_type_id_of(container_name, table), table), table)
                        element_type return if element_type.kind != TypeKind.Unknown
                        # Indexing a STRING local yields a char (oracle-verified:
                        # stage0 types `s[0]` char for cstr/dstr/sview).
                        receiver_type: InferType = infer_expression_type(indexed_object, names, types, table)
                        primitive_type(TypeKind.Char) return if receiver_type.kind == TypeKind.String
                    return primitive_type(TypeKind.Unknown)
                # NOTE: array/list literals `[…]` are deliberately NOT given a firm type here.
                # `[]` (and `[…]`) is the canonical empty/collection initializer for dstr and
                # container types (`out: dstr = []`, `xs: darray[T] = […]`), so treating a list
                # as firm-never-fit-scalar produces false positives on legitimate collection
                # initialization. They stay Unknown until the engine can distinguish "list as a
                # collection initializer" from "list misused as a scalar" (needs declared-type
                # structure — the interned type table).
                # Field access `object.field`: when object is a known struct and field is a
                # registered bare-typed field, the access has that field's type.
                if expression is Expr.Field(object, field, field_line):
                    object_type: InferType = infer_expression_type(object, names, types, table)
                    if object_type.kind == TypeKind.Named:
                        flat_field: InferType = type_of_name(field_type_of(table, object_type.name, field))
                        flat_field return if flat_field.kind != TypeKind.Unknown
                        # Structural field (Phase C): `p.items` where items is a
                        # container/optional-typed registered field.
                        structural_field: InferType = infer_from_type_id(field_type_id_of(table, object_type.name, field), table)
                        structural_field return if structural_field.kind == TypeKind.Container or structural_field.kind == TypeKind.Optional
                        return primitive_type(TypeKind.Unknown)
                    # Size fields of the KNOWN container heads are integers (usize) —
                    # user generics are excluded (their `count` could be anything).
                    is_known_container: bool = object_type.kind == TypeKind.Container and (object_type.name == "darray" or object_type.name == "dict" or object_type.name == "set" or object_type.name == "list" or object_type.name == "array")
                    is_size_field: bool = field == "count" or field == "len" or field == "capacity" or field == "size"
                    primitive_type(TypeKind.Int) return if is_known_container and is_size_field
                    return primitive_type(TypeKind.Unknown)
                # Direct call `f(...)`: the return type of a uniquely-named function.
                # Method/qualified calls (callee is a Field/Scope) fall to Unknown.
                if expression is Expr.Call(callee, arguments, argument_names, call_line):
                    if callee is Expr.Ident(function_name, function_name_line):
                        flat_return: InferType = type_of_name(function_return_type(table, function_name))
                        flat_return return if flat_return.kind != TypeKind.Unknown
                        # Structural return (Phase C): a `-> darray[T]`/`-> T?` return
                        # annotation has no bare name but does have an interned TypeId.
                        structural_return: InferType = infer_from_type_id(function_return_type_id(table, function_name), table)
                        structural_return return if structural_return.kind == TypeKind.Container or structural_return.kind == TypeKind.Optional
                    return primitive_type(TypeKind.Unknown)
                if expression is Expr.Unary(operator, operand, unary_line):
                    primitive_type(TypeKind.Bool) return if operator == TokenKind.Not
                    # `!x` is the volatile/atomic READ sigil (NOT logical not — that's
                    # `not`): it preserves the operand's type, like sign/bitwise ops.
                    infer_expression_type(operand, names, types, table) return if operator == TokenKind.Bang or operator == TokenKind.Minus or operator == TokenKind.Plus or operator == TokenKind.Tilde
                    return primitive_type(TypeKind.Unknown)
                if expression is Expr.Binary(left, operator, right, binary_line):
                    primitive_type(TypeKind.Bool) return if operator in {TokenKind.EqEq, TokenKind.BangEq, TokenKind.Lt, TokenKind.Gt, TokenKind.LtEq, TokenKind.GtEq, TokenKind.In, TokenKind.Is, TokenKind.And, TokenKind.Or}
                    if operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.LShift, TokenKind.RShift, TokenKind.Pipe, TokenKind.Caret, TokenKind.Ampersand}:
                        left_type: InferType = infer_expression_type(left, names, types, table)
                        left_type return if left_type.kind != TypeKind.Unknown
                        return infer_expression_type(right, names, types, table)
                    return primitive_type(TypeKind.Unknown)
                return primitive_type(TypeKind.Unknown)


        # An InferType from an interned row (Phase C): scalar kinds and Named map
        # directly; Container/Optional keep their structural kind; Ref and unmodeled
        # rows are Unknown (refs to buffers must not read as their referent scalar —
        # see the Ident-arm note).
        def infer_from_type_id(type_id: u32, table: SymbolTable&) -> InferType:
            can Abort.Panic:
                row_kind: TypeKind = interned_kind(type_id, table)
                return when row_kind:
                    TypeKind.Int | TypeKind.Float | TypeKind.Bool | TypeKind.Char | TypeKind.String -> primitive_type(row_kind)
                    TypeKind.Named | TypeKind.Container | TypeKind.Optional -> InferType{kind: row_kind, name: interned_name(type_id, table)}
                    _ -> primitive_type(TypeKind.Unknown)


        # The interned ELEMENT TypeId an index expression on `container_id` yields:
        # darray/array/set index by position -> element 0; dict[k] -> the VALUE
        # (element 1). 0 (Unknown) for other heads/shapes.
        def indexed_element_type_id(container_id: u32, table: SymbolTable&) -> u32:
            can Abort.Panic:
                0 return if interned_kind(container_id, table) != TypeKind.Container
                head: sview = interned_name(container_id, table)
                interned_elem(container_id, 0, table) return if head == "darray" or head == "array" or head == "set"
                interned_elem(container_id, 1, table) return if head == "dict"
                return 0


        # The coarse "family" string of an InferType, for the legacy literal/condition
        # checks: "int" | "float" | "bool" | "string" | "char" | "" (unknown/void/named).
        def family_of_kind(inferred_type: InferType) -> sview:
            can Abort.Panic:
                return when inferred_type.kind:
                    TypeKind.Int -> "int"
                    TypeKind.Float -> "float"
                    TypeKind.Bool -> "bool"
                    TypeKind.String -> "string"
                    TypeKind.Char -> "char"
                    TypeKind.Tuple -> "tuple"
                    # Structural families (Phase C): consumed by the generic non-bool
                    # walls (NonBoolCondition/NonBoolMatchGuard fire on any firm
                    # non-"bool" family); the mismatch oracles (firm_never_fits,
                    # comparison_group) treat them as unmodeled and stay silent, so
                    # the tuple/container sidecar check is not double-reported.
                    TypeKind.Optional -> "optional"
                    TypeKind.Container -> "container"
                    _ -> ""


        # Map a bare primitive type name onto its family (projection of type_of_name).
        def family_of_type_name(type_name: sview) -> sview:
            can Abort.Panic:
                return family_of_kind(type_of_name(type_name))


        # Infer an expression's type FAMILY — a projection of the structured engine.
        def infer_family(expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return family_of_kind(infer_expression_type(expression, names, types, table))


        # Whether a FIRM (non-literal) value of family `value_family` can never inhabit a
        # variable of primitive `type_name`. Numerics are fully inter-convertible in
        # Elisa (int<->float, any width — oracle-verified), so only the hard
        # bool/string/numeric walls are flagged; `char` values are skipped
        # (adaptive rules untested for firm chars).
        def firm_never_fits(value_family: sview, type_name: sview) -> bool:
            can Abort.Panic:
                target_family: sview = family_of_type_name(type_name)
                false return if target_family == ""
                return when value_family:
                    "bool" -> target_family != "bool"
                    "int" | "float" -> target_family == "bool" or target_family == "string"
                    "string" -> target_family == "int" or target_family == "float" or target_family == "bool"
                    # Firm chars hit only the bool/string walls (char<->numeric is
                    # adaptive and legal — oracle-verified 2026-07-16).
                    "char" -> target_family == "bool" or target_family == "string"
                    # A tuple never fits a primitive element type. `target_family` is already
                    # proven non-"" (the early return above), so it is some scalar family here;
                    # a declared tuple/named element type yields "" and bailed, so this can't
                    # false-positive on a genuine darray/dict/set of tuples.
                    "tuple" -> true
                    _ -> false


        # Flag a value (literal OR firm expression) against a declared primitive.
        def check_value_against(value: Ast::Expr, type_name: sview, declared_name: sview, line: u32, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                literal_kind: sview = literal_kind_of(value)
                if literal_kind != "":
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: declared_name, line: line, expected: type_name, actual: literal_kind}) if literal_never_fits(literal_kind, type_name)
                else:
                    value_family: sview = infer_family(value, names, types, table)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: declared_name, line: line, expected: type_name, actual: value_family}) if value_family != "" and firm_never_fits(value_family, type_name)


        # Flag a `match` that omits at least one variant of its (known enum) scrutinee and
        # has no catch-all — parity with stage0's `non-exhaustive match`. SOUND SUBSET: it
        # reports only when the scrutinee is a plain identifier whose local-type is a
        # registered enum AND every arm is a variant / or-of-variants pattern; a catch-all
        # (`_`/binding) or any unclassifiable arm (literal/struct/tuple/typebind/…) BAILS,
        # so it can never falsely claim a covered value is missing.
        # NOTE: Multi-scrutinee tuple matches (`match a, b:`) are not yet supported for
        # exhaustiveness checking (the cartesian product of both types is complex to model).
        def check_match_exhaustive(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], line: u32, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                scrutinee_name: sview = match scrutinee:
                    Expr.Ident(name, ident_line): name
                    _:                            ""
                return if scrutinee_name == ""
                enum_name: sview = local_type_of(names, types, scrutinee_name)
                return if enum_name == "" or not enum_is_known(enum_name, table)
                # Every arm must be a variant (or or-of-variants) cover; anything else bails.
                covered: mutable darray[sview] = []
                for arm in arms:
                    # docs/122 §5.1: a guarded arm can fail at runtime, so its variant
                    # paths never count toward coverage (mirrors stage0's coverage sink).
                    guarded: bool = match arm.guard:
                        Expr.Invalid: false
                        Expr.Absent: false
                        _:            true
                    continue if guarded
                    return if not collect_arm_variant_paths(arm.pattern, covered)
                # Report the first declared variant of `enum_name` no arm covers.
                while variant_index < table.enum_variant_owner.count |variant_index: usize = 0|:
                    if table.enum_variant_owner[variant_index] == enum_name:
                        variant_name: sview = table.enum_variant_name[variant_index]
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveMatch, name: enum_name, line: line, expected: variant_name, actual: ""}) if not paths_cover_variant(covered, variant_name)
                        return if not paths_cover_variant(covered, variant_name)
                    variant_index <- variant_index + 1


        # True if `enum_name` is a declared enum (has at least one variant in the registry).
        def enum_is_known(enum_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any owner in table.enum_variant_owner where owner == enum_name


        # Append the variant path(s) an arm pattern covers to `covered`, returning true.
        # Returns FALSE for a catch-all (`_`/binding) or any pattern that is not a variant
        # or or-of-variants — the signal for the caller to bail (cannot soundly report).
        def collect_arm_variant_paths(pattern: Ast::Pattern, covered: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                ok: mutable bool = false
                match pattern:
                    Pattern.Variant(path, fields):
                        covered.push(path)
                        ok <- true
                    Pattern.Or(options):
                        ok <- true
                        for option in options |ok, covered|:
                            ok <- false if not collect_arm_variant_paths(option, covered)
                    Pattern.Wildcard:
                        ok <- false
                    Pattern.Binding(binding_name):
                        ok <- false
                    Pattern.Literal(literal_text):
                        ok <- false
                    Pattern.Struct(struct_path, struct_fields):
                        ok <- false
                    Pattern.Tuple(elements):
                        ok <- false
                    Pattern.TypeBind(bound_type, binder):
                        ok <- false
                    Pattern.Range(range_lo, range_hi, range_inclusive):
                        ok <- false
                    Pattern.As(as_name, as_inner):
                        # docs/122 §5.4: coverage comes from the wrapped variant pattern.
                        ok <- true
                        for inner_pattern in as_inner |ok, covered|:
                            ok <- false if not collect_arm_variant_paths(inner_pattern, covered)
                    Pattern.Other(other_text):
                        ok <- false
                return ok


        # True if some collected variant path has a final `.`-tail equal to `variant_name`.
        def paths_cover_variant(covered: darray[sview]&, variant_name: sview) -> bool:
            can Abort.Panic:
                return any path in covered where path_tail_equals(path, variant_name)


        # True if the tail of `path` after its last `.` equals `variant_name` (a bare `path` with
        # no `.` compares whole).
        def path_tail_equals(path: sview, variant_name: sview) -> bool:
            can Abort.Panic:
                path_length: usize = sview_len(path)
                variant_length: usize = sview_len(variant_name)
                # Fold: the index of the last `.` (or -1) as a loop-expression.
                dot: isize =
                    for char_index in 0..<path_length |last_dot_index: isize = -1| -> last_dot_index:
                        last_dot_index <- char_index.isize() if sview_at(path, char_index) == '.' else last_dot_index
                tail_start: usize = (dot + 1).usize()
                false return if path_length - tail_start != variant_length
                for char_index in 0..<variant_length:
                    false return if sview_at(path, tail_start + char_index) != sview_at(variant_name, char_index)
                return true


        # Literal-vs-declared-type checks across a body: `x: PRIM = LITERAL`
        # declarations, `x <- LITERAL` mutations (via the flat local-type table),
        # and `return LITERAL` against the declared return type. Recurses nested
        # bodies; only the oracle-verified impossible pairs are flagged.
        # A ternary `A if COND else B` (Expr.If) requires COND to be bool, mirroring
        # if/while. Checked in value positions (parity with stage0's `ternary condition
        # must be bool, got T`); recurses into the branches so chained ternaries are all
        # covered. Sound like NonBoolCondition: only fires when infer_family is certain
        # AND not bool (the `!x` volatile-read sigil preserves operand type, not bool).
        def check_ternary_condition(expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.If(condition, then_expression, else_expression, line):
                        family: sview = infer_family(condition, names, types, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "ternary", line: line, expected: "bool", actual: family}) if family != "" and family != "bool"
                        table <- check_ternary_condition(then_expression, names, types, table)
                        table <- check_ternary_condition(else_expression, names, types, table)
                    _:
                        pass


        # Whether an operand's inferred kind is a firm (known) non-bool — the flaggable
        # case for a logical `and`/`or`. Unknown/Void/Named/Bool are never flagged.
        def kind_is_firm_non_bool(inferred_type: InferType) -> bool:
            can Abort.Panic:
                return inferred_type.kind == TypeKind.Int or inferred_type.kind == TypeKind.Float or inferred_type.kind == TypeKind.String or inferred_type.kind == TypeKind.Char


        # Whether an operand's inferred kind is a firm non-numeric — the flaggable case
        # for arithmetic `+ - * / %`. Only the hard bool/string walls; char is numeric-
        # adjacent (char arithmetic is legal) and int/float/unknown/named never flag.
        def kind_is_firm_non_numeric(inferred_type: InferType) -> bool:
            can Abort.Panic:
                # Bool / String / Tuple are firmly non-numeric: none is ever a valid operand to
                # ordering (`<`), shift/bitwise, arithmetic, or compound-assign. Tuple joins here
                # so those operator checks fire on a whole-tuple operand (previously Unknown ->
                # silent miss). Sound: these consumers require a numeric operand outright and do
                # not compare against a declared type, so a tuple can never be a false positive.
                return inferred_type.kind == TypeKind.Bool or inferred_type.kind == TypeKind.String or inferred_type.kind == TypeKind.Tuple


        # Comparison-compatibility group of a kind (for `==`/`!=`): 1 = bool, 2 = string,
        # 3 = numeric (int/float/char are mutually comparable — Elisa inter-converts
        # numerics and char is numeric-adjacent). 0 = not firm-comparable (Unknown/Void/
        # Named — never used to flag). Two firm operands in DIFFERENT non-zero groups can
        # never be equal, so an `==`/`!=` between them is a type error.
        def comparison_group(inferred_type: InferType) -> u8:
            can Abort.Panic:
                1 return if inferred_type.kind == TypeKind.Bool
                2 return if inferred_type.kind == TypeKind.String
                3 return if inferred_type.kind == TypeKind.Int or inferred_type.kind == TypeKind.Float or inferred_type.kind == TypeKind.Char
                return 0


        # Operator-operand type checks (docs: the type-inference engine's first real
        # unlock). Walks value expressions; a logical `and`/`or` with a firm non-bool
        # operand, or an arithmetic `+ - * / %` with a firm non-numeric operand, is
        # flagged. Sound SUBSET: only firmly-known incompatible operand kinds fire, so
        # any Unknown operand (the common case under the flat type table) is silent.
        def check_operator_operands(expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.Binary(left, operator, right, line):
                        table <- check_operator_operands(left, names, types, table)
                        table <- check_operator_operands(right, names, types, table)
                        match operator:
                            TokenKind.And | TokenKind.Or:
                                left_type: InferType = infer_expression_type(left, names, types, table)
                                right_type: InferType = infer_expression_type(right, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: token_text(operator), line: line, expected: "bool", actual: family_of_kind(left_type)}) if kind_is_firm_non_bool(left_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: token_text(operator), line: line, expected: "bool", actual: family_of_kind(right_type)}) if kind_is_firm_non_bool(right_type)
                            TokenKind.Plus | TokenKind.Minus | TokenKind.Star | TokenKind.Slash | TokenKind.Percent:
                                left_type: InferType = infer_expression_type(left, names, types, table)
                                right_type: InferType = infer_expression_type(right, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(operator), line: line, expected: "number", actual: family_of_kind(left_type)}) if kind_is_firm_non_numeric(left_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(operator), line: line, expected: "number", actual: family_of_kind(right_type)}) if kind_is_firm_non_numeric(right_type)
                            TokenKind.EqEq | TokenKind.BangEq:
                                left_type: InferType = infer_expression_type(left, names, types, table)
                                right_type: InferType = infer_expression_type(right, names, types, table)
                                left_group: u8 = comparison_group(left_type)
                                right_group: u8 = comparison_group(right_type)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IncompatibleComparison, name: token_text(operator), line: line, expected: family_of_kind(left_type), actual: family_of_kind(right_type)}) if left_group != 0 and right_group != 0 and left_group != right_group
                            _:
                                pass
                    Ast::Expr.Unary(operator, operand, line):
                        table <- check_operator_operands(operand, names, types, table)
                        match operator:
                            TokenKind.Not:
                                operand_type: InferType = infer_expression_type(operand, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolOperand, name: "not", line: line, expected: "bool", actual: family_of_kind(operand_type)}) if kind_is_firm_non_bool(operand_type)
                            TokenKind.Minus | TokenKind.Tilde:
                                operand_type: InferType = infer_expression_type(operand, names, types, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(operator), line: line, expected: "number", actual: family_of_kind(operand_type)}) if kind_is_firm_non_numeric(operand_type)
                            _:
                                pass
                    Ast::Expr.Paren(inner, line):
                        table <- check_operator_operands(inner, names, types, table)
                    Ast::Expr.If(condition, then_expression, else_expression, line):
                        table <- check_operator_operands(condition, names, types, table)
                        table <- check_operator_operands(then_expression, names, types, table)
                        table <- check_operator_operands(else_expression, names, types, table)
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table| -> table:
                            table <- check_operator_operands(argument, names, types, table)
                    Ast::Expr.Index(object, index, line):
                        table <- check_operator_operands(object, names, types, table)
                        # `recv.cast[T]`: the bracket is a TYPE, not a value operand — don't
                        # recurse into it. Instead, if `recv` is an identifier whose declared
                        # type is a numeric primitive and `T` is a DIFFERENT numeric primitive,
                        # the `.cast` is a value conversion (stage0 requires a constructor).
                        is_cast: mutable bool = false
                        if object is Expr.Field(receiver, cast_field, cast_field_line):
                            is_cast <- true if cast_field == "cast"
                            if receiver is Expr.Ident(receiver_name, receiver_name_line) and cast_field == "cast":
                                if index is Expr.Ident(target_type_name, target_type_line):
                                    receiver_type_name: sview = local_type_of(names, types, receiver_name)
                                    receiver_numeric: bool = is_integer_type_name(receiver_type_name) or is_float_type_name(receiver_type_name)
                                    destination_numeric: bool = is_integer_type_name(target_type_name) or is_float_type_name(target_type_name)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidCast, name: target_type_name, line: line, expected: receiver_type_name, actual: ""}) if receiver_numeric and destination_numeric and receiver_type_name != target_type_name
                        table <- check_operator_operands(index, names, types, table) if not is_cast
                    _:
                        pass


        # A short spelling of an operator token for diagnostics ("and"/"or"/"+"/…).
        def token_text(operator: TokenKind) -> sview:
            can Abort.Panic:
                return when operator:
                    TokenKind.And -> "and"
                    TokenKind.Or -> "or"
                    TokenKind.Plus -> "+"
                    TokenKind.Minus -> "-"
                    TokenKind.Star -> "*"
                    TokenKind.Slash -> "/"
                    TokenKind.Percent -> "%"
                    TokenKind.Tilde -> "~"
                    _ -> "?"


        # docs/125 R2 / stage0 parity: an EXPRESSION-position match or when (`x = match e:`,
        # `return when e:`) must be exhaustive too. The statement walker's Stmt.Match arm
        # only reaches STATEMENT-form matches; this catches the Expr.Match a value
        # initializer / return / assignment carries. It bails on non-enum scrutinees exactly
        # like check_match_exhaustive (open-scalar `_`-required totality is a separate,
        # later rule), so it can only add enum-totality — and stage0 already enforces this,
        # so stage1's own (accepted) source stays clean.
        # An unguarded catch-all arm (`_` or a bare binding) makes any match total.
        def match_has_catch_all(arms: darray[Ast::MatchArm]) -> bool:
            for arm in arms:
                guarded: bool = match arm.guard:
                    Ast::Expr.Invalid: false
                    Ast::Expr.Absent: false
                    _:                 true
                if not guarded:
                    is_catch_all: bool = match arm.pattern:
                        Ast::Pattern.Wildcard:      true
                        Ast::Pattern.Binding(name): true
                        _:                          false
                    true return if is_catch_all
            return false

        def check_value_match_exhaustive(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            match value:
                Ast::Expr.Match(scrutinee, arms, match_line):
                    table <- check_match_exhaustive(scrutinee, arms, match_line, names, types, table)
                    # docs/125 R2: a value-producing match/when over an OPEN scalar domain
                    # (int/char/string/float) with no `_` cannot yield a value for every
                    # input. Enum scrutinees infer_family to "" (handled above), so this only
                    # adds open-scalar totality and never double-reports.
                    if not match_has_catch_all(arms):
                        scalar_family: sview = infer_family(scrutinee, names, types, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonExhaustiveScalarMatch, name: scalar_family, line: match_line, expected: "", actual: ""}) if scalar_family == "int" or scalar_family == "char" or scalar_family == "string" or scalar_family == "float"
                _:
                    return

        def check_variable_initializers(statements: darray[Ast::Stmt], return_type_name: sview, names: mutable darray[sview]&, types: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, names, types| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(names, types, name, type_name)
                            # Structural channel (Phase C): the annotation's interned
                            # TypeId, so idents of container/optional/ref type infer
                            # structurally (bare_type_name sees only bare names).
                            note_local_type_id(name, type_expression, table)
                            table <- check_ternary_condition(value, names, types, table)
                            table <- check_operator_operands(value, names, types, table)
                            table <- check_value_match_exhaustive(value, names, types, table)
                            table <- check_value_against(value, type_name, name, line, names, types, table) if type_name != ""
                        Stmt.Assign(target, operator, value, line):
                            table <- check_ternary_condition(value, names, types, table)
                            table <- check_operator_operands(value, names, types, table)
                            table <- check_value_match_exhaustive(value, names, types, table)
                            if target is Expr.Ident(target_name, target_line) and operator == TokenKind.Assign:
                                # `x = v` defines a fresh, unannotated local.
                                note_local_type(names, types, target_name, "")
                            elif target is Expr.Ident(target_name, target_line) and operator == TokenKind.LArrow:
                                target_type: sview = local_type_of(names, types, target_name)
                                if target_type != "":
                                    table <- check_value_against(value, target_type, target_name, line, names, types, table)
                                else:
                                    # Structural target (Phase C): a scalar can never be
                                    # assigned to a CONTAINER-typed local (`xs <- 5` —
                                    # oracle: "cannot assign int to darray[i64]"). An
                                    # OPTIONAL target legally accepts its base value and
                                    # never flags here. Both literal and firm-inferred
                                    # scalar values are walls; unknowns stay silent.
                                    target_structural: u32 = local_type_id_of(target_name, table)
                                    if interned_kind(target_structural, table) == TypeKind.Container:
                                        assigned_kind: mutable sview = literal_kind_of(value)
                                        assigned_kind <- infer_family(value, names, types, table) if assigned_kind == ""
                                        is_scalar_value: bool = assigned_kind == "int" or assigned_kind == "float" or assigned_kind == "bool" or assigned_kind == "char" or assigned_kind == "string"
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: target_name, line: line, expected: interned_name(target_structural, table), actual: assigned_kind}) if is_scalar_value
                            elif target is Expr.Field(field_object, target_field, target_field_line) and operator == TokenKind.LArrow:
                                # `p.x <- v`: the assigned value must fit field x's declared
                                # type (a Field target is always a mutation, never a define).
                                object_type: InferType = infer_expression_type(field_object, names, types, table)
                                field_type: sview = field_type_of(table, object_type.name, target_field) if object_type.kind == TypeKind.Named else ""
                                table <- check_value_against(value, field_type, target_field, line, names, types, table) if field_type != ""
                        Stmt.Return(value, line):
                            if value is return_expression:
                                table <- check_ternary_condition(return_expression, names, types, table)
                                table <- check_operator_operands(return_expression, names, types, table)
                                table <- check_value_match_exhaustive(return_expression, names, types, table)
                            table <- check_value_against(returned_value, return_type_name, "return", line, names, types, table) if return_type_name != "" and value is returned_value
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_operator_operands(condition, names, types, table)
                            condition_family: sview = infer_family(condition, names, types, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "if", line: line, expected: "bool", actual: condition_family}) if condition_family != "" and condition_family != "bool"
                            table <- check_variable_initializers(then_body, return_type_name, names, types, table)
                            table <- check_variable_initializers(else_body, return_type_name, names, types, table)
                        Stmt.While(condition, body, line):
                            table <- check_operator_operands(condition, names, types, table)
                            condition_family: sview = infer_family(condition, names, types, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonBoolCondition, name: "while", line: line, expected: "bool", actual: condition_family}) if condition_family != "" and condition_family != "bool"
                            table <- check_variable_initializers(body, return_type_name, names, types, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_loop_iterable(iterable, names, types, table, line)
                            # Loop-variable ELEMENT typing (Phase C): iterating a
                            # container-typed local binds its element type — `for x in
                            # xs:` (darray/set, one variable) types x as the element,
                            # `for k, v in d:` (dict, two variables) types the key and
                            # value. Any other shape stays untyped ("").
                            iterable_id: mutable u32 = 0
                            if iterable is Expr.Ident(iterable_name, iterable_line):
                                iterable_id <- local_type_id_of(iterable_name, table)
                            elif iterable is Expr.Call(iterable_callee, iterable_args, iterable_arg_names, iterable_call_line):
                                # `for x in g():` — the returned container's elements.
                                if iterable_callee is Expr.Ident(iterable_fn, iterable_fn_line):
                                    iterable_id <- function_return_type_id(table, iterable_fn)
                            elif iterable is Expr.Field(iterable_object, iterable_field, iterable_field_line):
                                # `for x in p.items:` — a registered struct field's container.
                                field_object_type: InferType = infer_expression_type(iterable_object, names, types, table)
                                if field_object_type.kind == TypeKind.Named:
                                    iterable_id <- field_type_id_of(table, field_object_type.name, iterable_field)
                            iterable_head: sview = interned_name(iterable_id, table) if interned_kind(iterable_id, table) == TypeKind.Container else ""
                            sequence_element: u32 = interned_elem(iterable_id, 0, table) if (iterable_head == "darray" or iterable_head == "array" or iterable_head == "set") and variables.count == 1 else 0
                            dict_key: u32 = interned_elem(iterable_id, 0, table) if iterable_head == "dict" and variables.count == 2 else 0
                            dict_value: u32 = interned_elem(iterable_id, 1, table) if iterable_head == "dict" and variables.count == 2 else 0
                            while variable_index < variables.count |variable_index: usize = 0, names, types, table|:
                                variable_element: u32 = when variable_index:
                                    0 -> sequence_element if sequence_element != 0 else dict_key
                                    1 -> dict_value
                                    _ -> 0
                                note_local_type(names, types, variables[variable_index], type_name_of_row(variable_element, table))
                                note_local_type_id_direct(variables[variable_index], variable_element, table)
                                variable_index <- variable_index + 1
                            table <- check_variable_initializers(body, return_type_name, names, types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            note_local_type(names, types, binding, "") if binding != ""
                            table <- check_variable_initializers(body, return_type_name, names, types, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_match_exhaustive(scrutinee, arms, line, names, types, table)
                            for arm in arms |table| -> table:
                                table <- check_variable_initializers(arm.body, return_type_name, names, types, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
