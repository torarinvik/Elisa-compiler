extend Semantic:
    private:
        def pma_private_candidate_excluded_by_public_rank(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, symbol: Symbol, public_rank: usize, actual_type: sview) -> bool:
            can Abort.Panic:
                first_parameter: (found: bool, kind: SemTypeKind, name: sview @source) = pma_symbol_first_parameter_type(table, symbol)
                return false if not first_parameter.found
                return true if public_rank > 1.usize()
                return true if actual_type == "bool" and (first_parameter.kind == SemTypeKind.Int or first_parameter.kind == SemTypeKind.Float or first_parameter.kind == SemTypeKind.Char or first_parameter.kind == SemTypeKind.String)
                return public_rank > 0.usize() if first_parameter.kind == SemTypeKind.Named and pma_generic_parameter_identity(annotations, first_parameter.name, symbol)
                # An exact concrete match can tie another concrete overload, so it must
                # remain visible to the privacy check. Other conversions are unmodeled.
                return false

        # Suppress a spelling-based private-call report only when every exact private
        # overload is ineligible by Core's coarse fixed-arity filter, mismatches a known
        # bool-vs-primitive pair, or is a generic receiver outranked by an exact public type.
        # Unknown conversions and concrete ties preserve the privacy diagnostic.
        def pma_private_call_overloads_excluded(file: Ast::File&, index: PrivateMemberIndex&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, member: sview, current_module: sview, unqualified_call: bool, arguments: darray[Ast::Expr], argument_names: darray[sview @source], bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> bool:
            can Abort.Panic:
                return false if any argument_name in argument_names where argument_name != ""
                public_rank: (found: bool, rank: usize) = pma_public_call_sibling_rank(file, index, table, annotations, owner, member, current_module, unqualified_call, arguments, bound, bound_types)
                return false if not public_rank.found
                actual_type: sview @source = pma_argument_type_name(arguments[0], bound, bound_types) if arguments.count > 0.usize() else ""
                return false if actual_type == ""
                private_candidates: mutable usize = 0.usize()
                all_excluded: mutable bool = true
                for symbol in table.symbols |private_candidates, all_excluded, index, table, annotations, owner, member, arguments, actual_type, public_rank|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != member or symbol.module_owner != owner or not pma_symbol_has_private_marker(index, symbol)
                    private_candidates <- private_candidates + 1.usize()
                    candidate_excluded: bool = not pma_symbol_core_accepts_receiver_arity(symbol, arguments.count) or pma_private_candidate_excluded_by_public_rank(table, annotations, symbol, public_rank.rank, actual_type)
                    all_excluded <- false if not candidate_excluded
                return private_candidates > 0.usize() and all_excluded

        # Whether the `::`-joined module path `owner` is spelled by the Ident/Scope chain in
        # `base`, matching right to left so no joined path has to be BUILT: a synthesized
        # sview would have to live in a side buffer, and a Diagnostic may only carry views
        # into the source. `end` is the exclusive end of the not-yet-matched prefix.
        def pma_chain_ends_at(base: Ast::Expr, owner: sview, end: usize) -> bool:
            can Abort.Panic:
                return match base:
                    Expr.Ident(head_name, _):
                        end == head_name.len and sview_slice_equals(owner, 0, head_name)
                    Expr.Scope(inner, last_name, _):
                        pma_chain_prefix_ends_at(inner, owner, end, last_name)
                    _:
                        false

        def pma_chain_prefix_ends_at(inner: Ast::Expr, owner: sview, end: usize, last_name: sview) -> bool:
            can Abort.Panic:
                last_length: usize = last_name.len
                return false if end < last_length + 2.usize()
                start: usize = end - last_length
                return false if:
                    not sview_slice_equals(owner, start, last_name)
                    owner[start - 1.usize()] != 58 or owner[start - 2.usize()] != 58
                return pma_chain_ends_at(inner, owner, start - 2.usize())

        def pma_using_alias_target(annotations: darray[Ast::EnumAnnotation]&, alias: Ast::EnumAnnotation) -> sview:
            can Abort.Panic:
                selected_target: mutable sview = ""
                target_count: mutable usize = 0
                for target_row in annotations |selected_target, target_count, alias|:
                    if target_row.name == "__using_alias_target" and target_row.module == alias.module and target_row.line == alias.line and target_row.offset == alias.offset:
                        target_count <- target_count + 1.usize()
                        selected_target <- target_row.owner
                return selected_target if target_count == 1.usize()
                return ""

        # Module aliases use the analyzer-wide registration order. Unknown pairs stay
        # explicit so privacy checks can decline to claim a definite owner.
        def pma_using_alias_precedes(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, precedes: bool):
            can Abort.Panic:
                return semantic_possible_import_alias_precedes(left, right, table)

        # An alias can establish a private owner only when it is the winning,
        # definitely-selected analyzer-wide alias. An unresolved branch alias
        # may be public or private, so it must not cause a definite privacy diagnostic.
        def pma_using_alias_is_shadowed(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&, alias: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                for earlier_alias in annotations |file, table, alias|:
                    continue if earlier_alias.name != "__using_alias" or earlier_alias.owner != alias.owner or earlier_alias.module == alias.module and earlier_alias.line == alias.line and earlier_alias.offset == alias.offset
                    earlier_branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(earlier_alias, annotations, file, table)
                    continue if earlier_branch.known and not earlier_branch.active
                    order: (known: bool, precedes: bool) = pma_using_alias_precedes(earlier_alias, alias, table)
                    return true if not order.known
                    return true if order.precedes and (not earlier_branch.known or earlier_branch.active)
                return false

        # Resolve alias heads recursively while preserving any literal suffix. Require a
        # known exact owner so a possible alias cannot create a definite privacy report.
        def pma_alias_target_matches_owner(annotations: darray[Ast::EnumAnnotation]&, candidate_owner: sview, alias: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                target: sview = pma_using_alias_target(annotations, alias)
                return false if target == ""
                target_prefix: (known: bool, matches: bool, end: usize) = semantic_possible_import_alias_target_prefix(candidate_owner, target, alias.module, alias.offset, table)
                return target_prefix.known and target_prefix.matches and target_prefix.end == candidate_owner.len

        def pma_alias_chain_ends_at(base: Ast::Expr, owner: sview, end: usize, alias: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return match base:
                    Expr.Ident(head_name, _):
                        return false if head_name != alias.owner or end > owner.len
                        candidate_owner: sview = string_view_slice(owner, 0, end.i64())
                        pma_alias_target_matches_owner(annotations, candidate_owner, alias, table)
                    Expr.Scope(inner, last_name, _):
                        pma_alias_chain_prefix_ends_at(inner, owner, end, last_name, alias, annotations, table)
                    _:
                        false

        def pma_alias_chain_prefix_ends_at(inner: Ast::Expr, owner: sview, end: usize, last_name: sview, alias: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                last_length: usize = last_name.len
                return false if end < last_length + 2.usize()
                start: usize = end - last_length
                return false if:
                    not sview_slice_equals(owner, start, last_name)
                    owner[start - 1.usize()] != 58 or owner[start - 2.usize()] != 58
                return pma_alias_chain_ends_at(inner, owner, start - 2.usize(), alias, annotations, table)

        def pma_chain_head_name(base: Ast::Expr) -> sview:
            can Abort.Panic:
                return match base:
                    Expr.Ident(head_name, _): head_name
                    Expr.Scope(inner, _, _): pma_chain_head_name(inner)
                    Expr.Paren(inner, _): pma_chain_head_name(inner)
                    _: ""

        # The module that hides `member` when `base` spells that module's path, or "" when
        # this access is not a private one. The owner comes OUT of the recorded row rather
        # than being assembled from the chain, which is what lets a nested owner
        # (`Geo::Scalar`) be compared without materialising it.
        def pma_scope_owner(file: Ast::File&, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, table: SymbolTable&, base: Ast::Expr, member: sview) -> sview @source:
            can Abort.Panic:
                private_index: mutable u32 = pma_member_head(index, member)
                alias_name: sview = pma_chain_head_name(base)
                while private_index != SYMBOL_INDEX_ROW_NONE |private_index, file, index, annotations, current_module, table, base, member, alias_name|:
                    candidate: sview @source = index.modules[private_index.usize()]
                    if index.names[private_index.usize()] == member:
                        return candidate if pma_chain_ends_at(base, candidate, candidate.len)
                        for alias in annotations |file, index, annotations, current_module, table, base, member, candidate, alias_name|:
                            continue if alias.name != "__using_alias" or alias.owner != alias_name
                            branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(alias, annotations, file, table)
                            continue if not branch.known or not branch.active
                            continue if pma_using_alias_is_shadowed(annotations, file, table, alias)
                            return candidate if pma_alias_chain_ends_at(base, candidate, candidate.len, alias, annotations, table)
                    private_index <- index.name_next[private_index.usize()]
                return ""

        # The leftmost segment of a scope chain: stage0 reports a privacy error AT the head
        # of the path (`Geo` in `Geo::Scalar::hidden`), not at the member.
        def pma_chain_head_pos(base: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                return match base:
                    Expr.Scope(inner, _, _):
                        pma_chain_head_pos(inner)
                    _:
                        Ast::expr_pos(base)

        def pma_call_target_identity(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, bound: darray[sview @source]&) -> (member: sview @source, owner: sview @source):
            can Abort.Panic:
                return match expression:
                    Expr.Ident(member, _):
                        (member, pma_unqualified_call_owner(table, current_module, index, annotations, bound, member))
                    Expr.Scope(base, member, _):
                        (member, pma_scope_owner(file, index, annotations, current_module, table, base, member))
                    Expr.Paren(inner, _):
                        pma_call_target_identity(file, inner, current_module, index, annotations, table, bound)
                    _:
                        ("", "")

        def pma_is_private_function_target(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, bound: darray[sview @source]&) -> bool:
            can Abort.Panic:
                identity: (member: sview @source, owner: sview @source) = pma_call_target_identity(file, expression, current_module, index, annotations, table, bound)
                return false if identity.member == "" or identity.owner == ""
                return any symbol in table.symbols where symbol.kind == SymbolKind.Func and symbol.name == identity.member and symbol.module_owner == identity.owner and pma_symbol_has_private_marker(index, symbol)

        # `f[T](...)` and `f[T, U](...)` arrive as Index / IndexN callees, while
        # `(f)(...)` arrives as Paren. Normalize only a declaration-backed private
        # function target; ordinary subscripts and function-value expressions keep the
        # existing recursive expression walk below.
        def pma_normalize_call_callee(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, bound: darray[sview @source]&) -> Ast::Expr:
            can Abort.Panic:
                return match expression:
                    Expr.Paren(inner, _):
                        pma_normalize_call_callee(file, inner, current_module, index, annotations, table, bound)
                    Expr.Index(object, _, _) if pma_is_private_function_target(file, object, current_module, index, annotations, table, bound):
                        pma_normalize_call_callee(file, object, current_module, index, annotations, table, bound)
                    Expr.IndexN(object, _, _) if pma_is_private_function_target(file, object, current_module, index, annotations, table, bound):
                        pma_normalize_call_callee(file, object, current_module, index, annotations, table, bound)
                    _:
                        expression

        # Once a generic callee has been normalized, still visit its type/index arguments
        # so private type names inside `f[Hidden]` retain their own diagnostics.
        def pma_report_call_callee_indices(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, _):
                        table <- pma_report_call_callee_indices(file, inner, current_module, index, annotations, table, bound, bound_types)
                    Expr.Index(object, argument, _):
                        table <- pma_report_call_callee_indices(file, object, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report(file, argument, current_module, index, annotations, table, bound, bound_types)
                    Expr.IndexN(object, arguments, _):
                        table <- pma_report_call_callee_indices(file, object, current_module, index, annotations, table, bound, bound_types)
                        for argument in arguments |table| -> table:
                            table <- pma_report(file, argument, current_module, index, annotations, table, bound, bound_types)
                    _:
                        pass

        def pma_report(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(member, ident_line):
                        owner: sview @source = pma_unqualified_owner(table, current_module, index, annotations, bound, member)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, pos: ident_line, line: ident_line.line, expected: "", actual: owner}) if owner != ""
                    Expr.Scope(base, member, scope_line):
                        # The path is checked OUTSIDE-IN: a private module closes the door on
                        # everything behind it, however public the member itself is, and stage0
                        # names that module rather than the member. Reporting both would be two
                        # errors for one closed door, so the leaf is only judged once the whole
                        # base path came back clean.
                        reported_before: usize = table.diagnostics.count
                        table <- pma_report(file, base, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report_scope_member(file, base, member, scope_line, current_module, index, annotations, table) if table.diagnostics.count == reported_before
                    Expr.Construct(type_expression, fields, _):
                        table <- pma_report(file, type_expression, current_module, index, annotations, table, bound, bound_types)
                        for field in fields |table|:
                            table <- pma_report(file, field.value, current_module, index, annotations, table, bound, bound_types)
                    Expr.Block(statements, value, _, _):
                        block_bound: mutable darray[sview @source] = []
                        block_bound.extend(bound)
                        block_bound_types: mutable darray[sview @source] = []
                        block_bound_types.extend(bound_types)
                        table <- pma_walk_stmts(statements, file, current_module, index, annotations, table, block_bound, block_bound_types)
                        table <- pma_report(file, value, current_module, index, annotations, table, block_bound, block_bound_types)
                    Expr.Field(object, field, field_line):
                        table <- pma_report(file, object, current_module, index, annotations, table, bound, bound_types)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        normalized_callee: Ast::Expr = pma_normalize_call_callee(file, callee, current_module, index, annotations, table, bound)
                        normalized_callee_is_path: mutable bool = false
                        match normalized_callee:
                            Expr.Ident(callee_name, callee_line):
                                normalized_callee_is_path <- true
                                owner: sview @source = pma_unqualified_call_owner(table, current_module, index, annotations, bound, callee_name)
                                private_candidates_excluded: mutable bool = false
                                if owner != "":
                                    private_candidates_excluded <- pma_private_call_overloads_excluded(file, index, table, annotations, owner, callee_name, current_module, true, arguments, argument_names, bound, bound_types)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: callee_name, pos: callee_line, line: callee_line.line, expected: "", actual: owner}) if owner != "" and not private_candidates_excluded
                            Expr.Scope(base, callee_name, callee_line):
                                normalized_callee_is_path <- true
                                reported_before: usize = table.diagnostics.count
                                table <- pma_report(file, base, current_module, index, annotations, table, bound, bound_types)
                                if table.diagnostics.count == reported_before:
                                    owner: sview @source = pma_scope_owner(file, index, annotations, current_module, table, base, callee_name)
                                    private_candidates_excluded: mutable bool = false
                                    if owner != "":
                                        private_candidates_excluded <- pma_private_call_overloads_excluded(file, index, table, annotations, owner, callee_name, current_module, false, arguments, argument_names, bound, bound_types)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: callee_name, pos: pma_chain_head_pos(base), line: callee_line.line, expected: "", actual: owner}) if owner != "" and not pma_within_module(current_module, owner) and not private_candidates_excluded
                            _:
                                table <- pma_report(file, callee, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report_call_callee_indices(file, callee, current_module, index, annotations, table, bound, bound_types) if normalized_callee_is_path
                        for argument in arguments |table| -> table:
                            table <- pma_report(file, argument, current_module, index, annotations, table, bound, bound_types)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- pma_report(file, left, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report(file, right, current_module, index, annotations, table, bound, bound_types)
                    Expr.Unary(operator, operand, unary_line):
                        table <- pma_report(file, operand, current_module, index, annotations, table, bound, bound_types)
                    Expr.Paren(inner, paren_line):
                        table <- pma_report(file, inner, current_module, index, annotations, table, bound, bound_types)
                    Expr.Index(object, index_argument, index_line):
                        table <- pma_report(file, object, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report(file, index_argument, current_module, index, annotations, table, bound, bound_types)
                    _:
                        pass

        def pma_report_scope_member(file: Ast::File&, base: Ast::Expr, member: sview @source, scope_line: Ast::Pos, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owner: sview @source = pma_scope_owner(file, index, annotations, current_module, table, base, member)
                return if owner == "" or pma_within_module(current_module, owner)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, pos: pma_chain_head_pos(base), line: scope_line.line, expected: "", actual: owner})

        def pma_walk_stmts(statements: darray[Ast::Stmt], file: Ast::File&, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: mutable darray[sview @source]&, bound_types: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, bound, bound_types| -> table, bound, bound_types:
                    match statement:
                        Stmt.Return(value, line):
                            table <- pma_report(file, returned, current_module, index, annotations, table, bound, bound_types) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pma_report(file, type_expression, current_module, index, annotations, table, bound, bound_types)
                            table <- pma_report(file, value, current_module, index, annotations, table, bound, bound_types)
                            if name != "":
                                bound.push(name)
                                bound_types.push(bare_type_name(type_expression))
                        Stmt.Assign(target, operator, value, line):
                            table <- pma_report(file, target, current_module, index, annotations, table, bound, bound_types)
                            table <- pma_report(file, value, current_module, index, annotations, table, bound, bound_types)
                        Stmt.Expr(expression, line):
                            table <- pma_report(file, expression, current_module, index, annotations, table, bound, bound_types)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pma_report(file, condition, current_module, index, annotations, table, bound, bound_types)
                            then_bound: mutable darray[sview @source] = []
                            then_bound.extend(bound)
                            then_bound_types: mutable darray[sview @source] = []
                            then_bound_types.extend(bound_types)
                            else_bound: mutable darray[sview @source] = []
                            else_bound.extend(bound)
                            else_bound_types: mutable darray[sview @source] = []
                            else_bound_types.extend(bound_types)
                            table <- pma_walk_stmts(then_body, file, current_module, index, annotations, table, then_bound, then_bound_types)
                            table <- pma_walk_stmts(else_body, file, current_module, index, annotations, table, else_bound, else_bound_types)
                        Stmt.While(condition, while_body, while_line):
                            table <- pma_report(file, condition, current_module, index, annotations, table, bound, bound_types)
                            while_bound: mutable darray[sview @source] = []
                            while_bound.extend(bound)
                            while_bound_types: mutable darray[sview @source] = []
                            while_bound_types.extend(bound_types)
                            table <- pma_walk_stmts(while_body, file, current_module, index, annotations, table, while_bound, while_bound_types)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- pma_report(file, iterable, current_module, index, annotations, table, bound, bound_types)
                            for_bound: mutable darray[sview @source] = []
                            for_bound.extend(bound)
                            for_bound_types: mutable darray[sview @source] = []
                            for_bound_types.extend(bound_types)
                            for variable in variables:
                                for_bound.push(variable)
                                for_bound_types.push("")
                            table <- pma_walk_stmts(for_body, file, current_module, index, annotations, table, for_bound, for_bound_types)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            if kind == "static":
                                branch_row: usize = pma_static_if_row_for_position(file, block_line)
                                if branch_row < file.static_if_lines.count:
                                    branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                                    continue if branch.known and not branch.selected
                            block_bound: mutable darray[sview @source] = []
                            block_bound.extend(bound)
                            block_bound_types: mutable darray[sview @source] = []
                            block_bound_types.extend(bound_types)
                            if binding != "":
                                block_bound.push(binding)
                                block_bound_types.push("")
                            table <- pma_walk_stmts(body, file, current_module, index, annotations, table, block_bound, block_bound_types)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- pma_report(file, scrutinee, current_module, index, annotations, table, bound, bound_types)
                            for arm in arms |table| -> table:
                                arm_bound: mutable darray[sview @source] = []
                                arm_bound.extend(bound)
                                arm_bound_types: mutable darray[sview @source] = []
                                arm_bound_types.extend(bound_types)
                                table <- pma_walk_stmts(arm.body, file, current_module, index, annotations, table, arm_bound, arm_bound_types)
                        _:
                            pass

        def pma_walk_declarations(declarations: darray[Ast::Decl], file: Ast::File&, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            function_bound: mutable darray[sview @source] = []
                            function_bound_types: mutable darray[sview @source] = []
                            for parameter in parameters |table|:
                                table <- pma_report(file, parameter.type_expression, current_module, index, annotations, table, function_bound, function_bound_types)
                                function_bound.push(parameter.name)
                                function_bound_types.push(bare_type_name(parameter.type_expression))
                            table <- pma_report(file, result_type, current_module, index, annotations, table, function_bound, function_bound_types) if return_type is result_type
                            table <- pma_walk_stmts(body, file, current_module, index, annotations, table, function_bound, function_bound_types)
                        Decl.Module(module_name, module_body, module_line):
                            table <- pma_walk_declarations(module_body, file, module_name, index, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            branch_row: usize = pma_static_if_row_for_position(file, scoped_line)
                            if branch_row < file.static_if_lines.count:
                                branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                                continue if branch.known and not branch.selected
                            table <- pma_walk_declarations(scoped_body, file, current_module, index, annotations, table)
                        _:
                            pass

    public:
        def check_private_member_access(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                annotations: darray[Ast::EnumAnnotation] = pma_active_import_annotations(file, table)
                has_private: bool = any annotation in annotations where annotation.owner == "__private_member"
                private_index: mutable PrivateMemberIndex = PrivateMemberIndex{names: [], modules: [], declaration_offsets: [], name_heads: {}, name_next: [], import_heads: {}, import_owners: [], import_members: [], import_next: []}
                pma_build_wildcard_import_index(annotations, private_index) if has_private
                pma_build_index(annotations, private_index) can Global{Read,Write} if has_private
                pma_build_selective_import_index(annotations, private_index) can Global{Read,Write} if has_private
                table <- pma_walk_declarations(file.top_decls, file, "", private_index, annotations, table) if has_private
