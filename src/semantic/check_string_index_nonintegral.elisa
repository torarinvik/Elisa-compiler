# Check for indexing a STRING (`s[i]`) with a firm Float index (e.g. `s[1.5]`).
# A string is only ever indexable by an integer, so a firm float index (numeric but not
# integral) can never be valid. Only fires when the receiver is firmly SemTypeKind.String
# (cstr/dstr/sview); Unknown and Named (could be a dict keyed by non-int) receivers are
# excluded. Type-application brackets (`.cast[T]`, generics) are always excluded. Disjoint
# from StringIndexNonNumeric, which owns firm Bool/String indices (non-numeric); this check
# owns only the Float case.

extend Semantic:
    private:

        # Walk through expressions, checking for indexing of non-indexable scalar types.
        def walk_expression_for_string_index_nonintegral(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_string_index_nonintegral(left, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_string_index_nonintegral(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_string_index_nonintegral(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_string_index_nonintegral(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_string_index_nonintegral(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        if not index_receiver_is_type_application(object):
                            object_type: InferType = infer_expression_type(object, var_types, type_names, table)
                            index_type: InferType = infer_expression_type(index, var_types, type_names, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StringIndexNonIntegral, name: "", line: line, expected: "", actual: stage0_value_spelling(index_type)}) if object_type.kind == SemTypeKind.String and index_type.kind == SemTypeKind.Float
                        table <- walk_expression_for_string_index_nonintegral(object, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_string_index_nonintegral(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_string_index_nonintegral(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_string_index_nonintegral(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_string_index_nonintegral(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_string_index_nonintegral(object, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(low, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        if not index_receiver_is_type_application(object):
                            object_type: InferType = infer_expression_type(object, var_types, type_names, table)
                            for argument in arguments |table|:
                                argument_type: InferType = infer_expression_type(argument, var_types, type_names, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StringIndexNonIntegral, name: "", line: line, expected: "", actual: stage0_value_spelling(argument_type)}) if object_type.kind == SemTypeKind.String and argument_type.kind == SemTypeKind.Float
                        table <- walk_expression_for_string_index_nonintegral(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_string_index_nonintegral(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_string_index_nonintegral(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_string_index_nonintegral(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_string_index_nonintegral(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_string_index_nonintegral(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_string_index_nonintegral(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_string_index_nonintegral(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_string_index_nonintegral(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_string_index_nonintegral(condition, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_string_index_nonintegral(iterable, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(condition, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_string_index_nonintegral(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_string_index_nonintegral(statements, table, var_types, type_names)
                        table <- walk_expression_for_string_index_nonintegral(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_string_index_nonintegral(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_string_index_nonintegral(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for non-indexable indexing.
        def walk_statements_for_string_index_nonintegral(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_string_index_nonintegral(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_string_index_nonintegral(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_string_index_nonintegral(target, table, var_types, type_names)
                            table <- walk_expression_for_string_index_nonintegral(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_string_index_nonintegral(condition, table, var_types, type_names)
                            table <- walk_statements_for_string_index_nonintegral(then_body, table, var_types, type_names)
                            table <- walk_statements_for_string_index_nonintegral(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_string_index_nonintegral(condition, table, var_types, type_names)
                            table <- walk_statements_for_string_index_nonintegral(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_string_index_nonintegral(iterable, table, var_types, type_names)
                            table <- walk_statements_for_string_index_nonintegral(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_string_index_nonintegral(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_string_index_nonintegral(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_string_index_nonintegral(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_string_index_nonintegral(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_string_index_nonintegral(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_string_index_nonintegral(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_string_index_nonintegral_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_string_index_nonintegral(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_string_index_nonintegral_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_string_index_nonintegral_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_string_index_nonintegral(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_string_index_nonintegral_declarations(declarations, table)
