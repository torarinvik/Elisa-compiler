extend Semantic:
    private:
        def callable_module_path_matches_suffix(candidate_module: sview, base_module: sview, suffix: sview) -> bool:
            can Abort.Panic:
                expected_length: usize = base_module.len if suffix == "" else base_module.len + 2.usize() + suffix.len
                return false if candidate_module.len != expected_length
                for offset in 0..<base_module.len |candidate_module, base_module|:
                    return false if candidate_module[offset] != base_module[offset]
                return true if suffix == ""
                return false if candidate_module[base_module.len] != 58 or candidate_module[base_module.len + 1.usize()] != 58
                for offset in 0..<suffix.len |candidate_module, base_module, suffix|:
                    return false if candidate_module[base_module.len + 2.usize() + offset] != suffix[offset]
                return true

        def callable_import_module_matches_target(candidate_module: sview, import_module: sview, imported_module: sview) -> bool:
            can Abort.Panic:
                return candidate_module == imported_module if import_module == ""
                return callable_module_path_matches_suffix(candidate_module, import_module, imported_module)

        def callable_module_path_segments_append(segments: mutable darray[sview @source]&, path: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                return if path == ""
                start: mutable usize = 0.usize()
                offset: mutable usize = 0.usize()
                while offset + 1.usize() < path.len |segments, path, start, offset|:
                    if path[offset] == 58 and path[offset + 1.usize()] == 58:
                        segments.push(path[start:offset])
                        start <- offset + 2.usize()
                        offset <- offset + 2.usize()
                    else:
                        offset <- offset + 1.usize()
                segments.push(path[start:path.len])

        def callable_alias_path_matches_candidate(annotations: darray[Ast::EnumAnnotation]&, alias_scope: sview @source, alias_target: sview @source, suffix: sview @source, candidate_module: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                segments: mutable darray[sview @source] = []
                callable_module_path_segments_append(segments, alias_target)
                callable_module_path_segments_append(segments, suffix)
                current_scope: mutable sview = alias_scope
                remaining: mutable usize = annotations.count + 1.usize()
                while segments.count > 0.usize() and remaining > 0.usize() |segments, remaining, annotations, current_scope|:
                    visible_alias: (count: usize, target: sview, scope: sview) = callable_using_alias_visible_target(annotations, current_scope, segments[0])
                    return false if visible_alias.count > 1.usize()
                    if visible_alias.count == 0.usize():
                        expanded_relative: mutable darray[sview @source] = []
                        callable_module_path_segments_append(expanded_relative, current_scope)
                        for index in 0..<segments.count |expanded_relative, segments|:
                            expanded_relative.push(segments[index])
                        segments <- expanded_relative
                        break
                    expanded_alias: mutable darray[sview @source] = []
                    callable_module_path_segments_append(expanded_alias, visible_alias.target)
                    for index in 1..<segments.count |expanded_alias, segments|:
                        expanded_alias.push(segments[index])
                    segments <- expanded_alias
                    current_scope <- visible_alias.scope
                    remaining <- remaining - 1.usize()
                return false if remaining == 0.usize()
                return candidate_module == "" if segments.count == 0.usize()
                candidate_start: mutable usize = 0.usize()
                for index in 0..<segments.count |candidate_module, candidate_start, segments|:
                    candidate_end: mutable usize = candidate_module.len
                    for offset in candidate_start..<candidate_module.len |candidate_module, candidate_start, candidate_end|:
                        if offset + 1.usize() < candidate_module.len and candidate_module[offset] == 58 and candidate_module[offset + 1.usize()] == 58:
                            candidate_end <- offset
                            break
                    return false if candidate_module[candidate_start:candidate_end] != segments[index]
                    if index + 1.usize() < segments.count:
                        return false if candidate_end + 1.usize() >= candidate_module.len or candidate_module[candidate_end] != 58 or candidate_module[candidate_end + 1.usize()] != 58
                        candidate_start <- candidate_end + 2.usize()
                    else:
                        return candidate_end == candidate_module.len
                return false

        def callable_alias_path_matches_candidate_bounded(alias_scope: sview @source, alias_target: sview @source, suffix: sview @source, candidate_module: sview, declaration_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return semantic_possible_import_alias_target_matches(candidate_module, alias_target, suffix, alias_scope, declaration_offset, table)

        # Alias targets may themselves begin with an alias. A target whose first
        # segment names an unresolved static alias, or whose visible alias chain is
        # ambiguous/cyclic, cannot be treated as a definite nonmatch for a candidate.
        def callable_static_alias_path_uncertain(annotations: darray[Ast::EnumAnnotation]&, alias_scope: sview @source, target_path: sview @source, suffix: sview @source, declaration_offset: u32, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                segments: mutable darray[sview @source] = []
                callable_module_path_segments_append(segments, target_path)
                callable_module_path_segments_append(segments, suffix)
                current_scope: mutable sview = alias_scope
                before_offset: mutable u32 = declaration_offset
                remaining: mutable usize = annotations.count + 1.usize()
                while segments.count > 0.usize() and remaining > 0.usize() |segments, remaining, annotations, current_scope, before_offset, table|:
                    visible_alias: (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32) = semantic_possible_import_alias_head_target(segments[0], current_scope, before_offset, table)
                    return true if not visible_alias.known
                    if not visible_alias.found:
                        for unresolved in annotations |segments, current_scope|:
                            continue if unresolved.owner != "__try_unresolved_static_binding" or unresolved.name != "__using_alias" or unresolved.detail_name != segments[0]
                            possible_alias_found: mutable bool = false
                            for possible_alias in table.possible_import_annotations |possible_alias_found, unresolved, segments, current_scope, before_offset, table|:
                                continue if possible_alias.name != "__using_alias" or possible_alias.owner != segments[0] or possible_alias.module != unresolved.module or possible_alias.line != unresolved.line or possible_alias.offset != unresolved.offset
                                possible_alias_found <- true
                                before_requester: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(possible_alias, current_scope, before_offset, table)
                                return true if not before_requester.known or before_requester.precedes
                            if not possible_alias_found and unresolved.module == current_scope:
                                return true if before_offset == FALLIBLE_FUNCTION_NO_OFFSET or unresolved.offset == FALLIBLE_FUNCTION_NO_OFFSET or unresolved.offset < before_offset
                        return false
                    expanded_alias: mutable darray[sview @source] = []
                    callable_module_path_segments_append(expanded_alias, visible_alias.raw_target)
                    for index in 1..<segments.count |expanded_alias, segments|:
                        expanded_alias.push(segments[index])
                    segments <- expanded_alias
                    current_scope <- visible_alias.scope
                    before_offset <- visible_alias.offset
                    remaining <- remaining - 1.usize()
                return segments.count > 0.usize()

        def callable_named_declaration_in_module(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview, module: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, annotations, name, module|:
                    symbol: Symbol = table.symbols[row.usize()]
                    row <- table.symbol_name_next[row.usize()]
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner != module
                    return true if not callable_function_declaration_is_static_inactive(annotations, name, module, symbol.line, symbol.offset)
                return false

        # The parser retains declarations from every static-if arm. Try adds an exact
        # source-position marker only for function declarations whose branch ancestry
        # has been proven inactive; unresolved branch selection remains conservative.
        def callable_function_declaration_is_static_inactive(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_line: u32, declaration_offset: u32) -> bool:
            can Abort.Panic:
                return any marker in annotations where marker.owner == "__try_inactive_function" and marker.name == name and marker.module == candidate_module and marker.line == declaration_line and marker.offset == declaration_offset

        # Unknown static branches keep their declarations as possible lookup candidates,
        # but cached facts and ErrorSet family selection must not treat one arm as certain.
        def callable_function_declaration_is_static_unresolved(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_line: u32, declaration_offset: u32) -> bool:
            can Abort.Panic:
                return any marker in annotations where marker.owner == "__try_unresolved_function" and marker.name == name and marker.module == candidate_module and marker.line == declaration_line and marker.offset == declaration_offset

        def callable_active_direct_function_count(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview) -> usize:
            can Abort.Panic:
                count: mutable usize = 0.usize()
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE |row, count, table, annotations, name|:
                    symbol: Symbol = table.symbols[row.usize()]
                    row <- table.symbol_name_next[row.usize()]
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    count <- count + 1.usize() if not callable_function_declaration_is_static_inactive(annotations, name, symbol.module_owner, symbol.line, symbol.offset)
                return count

        def callable_function_declaration_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_line: u32, declaration_offset: u32, lexical_module: sview) -> bool:
            can Abort.Panic:
                return callable_function_declaration_visible_with(annotations, annotations, name, candidate_module, declaration_line, declaration_offset, lexical_module)

        # DECLARATION_ROWS needs every row this declaration's own markers can match (see
        # try_noncall_declaration_markers); module-alias visibility reads ANNOTATIONS.
        def callable_function_declaration_visible_with(declaration_rows: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_line: u32, declaration_offset: u32, lexical_module: sview) -> bool:
            can Abort.Panic:
                return false if callable_function_declaration_is_static_inactive(declaration_rows, name, candidate_module, declaration_line, declaration_offset)
                return false if not try_error_alias_module_visible(annotations, candidate_module, lexical_module)
                exact_private: mutable bool = false
                exact_public: mutable bool = false
                legacy_private_marker: mutable bool = false
                for annotation in declaration_rows |exact_private, exact_public, legacy_private_marker, name, candidate_module, declaration_line, declaration_offset|:
                    continue if annotation.name != name or annotation.module != candidate_module or (annotation.owner != "__section_private" and annotation.owner != "__section_public")
                    offsets_known: bool = declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET and annotation.offset != FALLIBLE_FUNCTION_NO_OFFSET
                    exact_offset: bool = offsets_known and annotation.offset == declaration_offset
                    exact_line: bool = not offsets_known and annotation.line == declaration_line
                    if exact_offset or exact_line:
                        exact_private <- true if annotation.owner == "__section_private"
                        exact_public <- true if annotation.owner == "__section_public"
                    elif annotation.owner == "__section_private" and annotation.offset == FALLIBLE_FUNCTION_NO_OFFSET:
                        legacy_private_marker <- true
                return false if exact_private and exact_public
                return try_noncall_module_is_ancestor(candidate_module, lexical_module) if exact_private
                return true if exact_public
                # Old producers may have emitted a name-only private section marker.
                # With no declaration coordinate to match, fail closed for this name.
                return false if legacy_private_marker
                return true

        def callable_named_visible_declaration_in_module(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview, module: sview, enclosing_module: sview) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |table, annotations, name, module, enclosing_module|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner != module
                    return true if callable_function_declaration_visible(annotations, name, module, symbol.line, symbol.offset, enclosing_module)
                return false

        def callable_symbol_accepts_named_arguments(table: SymbolTable&, try_named_arguments: darray[Ast::EnumAnnotation]&, symbol: Symbol, try_offset: u32) -> bool:
            can Abort.Panic:
                return true if try_offset == FALLIBLE_FUNCTION_NO_OFFSET
                parameter_count: mutable usize = 0.usize()
                for row in 0..<table.function_param_owner.count |table, symbol, parameter_count|:
                    continue if row >= table.function_param_declaration_id.count or table.function_param_declaration_id[row].value != symbol.id.value
                    parameter_count <- parameter_count + 1.usize()
                # Extern and synthesized declarations may not have parameter-name rows.
                # Keep their overloads conservative when formal names are unavailable.
                return true if parameter_count == 0.usize()
                for argument in try_named_arguments |table, symbol, try_offset|:
                    continue if argument.owner != "__try_callee_named_arg" or argument.offset != try_offset
                    found_parameter: mutable bool = false
                    for row in 0..<table.function_param_owner.count |table, symbol, argument, found_parameter|:
                        continue if row >= table.function_param_declaration_id.count or table.function_param_declaration_id[row].value != symbol.id.value
                        found_parameter <- true if row < table.function_param_name.count and table.function_param_name[row] == argument.name
                    return false if not found_parameter
                return true

        def try_enclosing_function_decl_id(table: SymbolTable&, enclosing: (line: u32, offset: u32), enclosing_module: sview) -> DeclId:
            can Abort.Panic:
                found: mutable DeclId = DeclId{value: INVALID_DECL_ID_VALUE}
                matches: mutable usize = 0.usize()
                for symbol in table.symbols |found, matches, enclosing, enclosing_module|:
                    continue if symbol.kind != SymbolKind.Func or symbol.line != enclosing.line or symbol.module_owner != enclosing_module
                    continue if enclosing.offset != FALLIBLE_FUNCTION_NO_OFFSET and symbol.offset != enclosing.offset
                    matches <- matches + 1.usize()
                    found <- symbol.id
                return found if matches == 1.usize()
                return DeclId{value: INVALID_DECL_ID_VALUE}

        def try_overload_type_is_generic_parameter(type_id: u32, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if type_id == 0 or declaration.value == INVALID_DECL_ID_VALUE or declaration.value.usize() >= table.symbols.count
                return false if interned_kind(type_id, table) != SemTypeKind.Named
                name: sview = interned_name(type_id, table)
                declaration_symbol: Symbol = table.symbols[declaration.value.usize()]
                for annotation in annotations |name, declaration_symbol|:
                    return true if annotation.owner == name and annotation.name == "__generic_param_identity" and annotation.detail_line == declaration_symbol.line and annotation.offset == declaration_symbol.offset and annotation.module == declaration_symbol.module_owner
                return false

        def try_overload_type_symbol_is_nominal(symbol: Symbol) -> bool:
            return symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)

        # Non-alias nominal types retain exact declaration markers for static-if rows.
        # A declaration is excluded only when one of those exact rows proves it inactive;
        # missing and unresolved markers remain possible candidates.
        def try_overload_nominal_type_declaration_is_static_inactive(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_module: sview, declaration_line: u32, declaration_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for marker in annotations |file, name, declaration_module, declaration_line, declaration_offset, table|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__nominal_type_static_branch" or marker.detail_name != name or marker.module != declaration_module or marker.line != declaration_line or marker.offset != declaration_offset
                    continue if marker.identity_id == 4294967295
                    branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, marker.identity_id.usize(), declaration_module, table)
                    return true if branch.known and not branch.selected
                return false

        # Unlike callable declarations, nominal type visibility is used only to recover
        # an identity already selected by Core's type resolver. A private declaration is
        # visible in its own module and descendants, but unrelated private modules must
        # not poison a same-spelled local or imported type.
        def try_overload_type_declaration_visible(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, type_symbol_is_alias: bool, name: sview, declaration_module: sview, declaration_line: u32, declaration_offset: u32, lexical_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if type_symbol_is_alias and try_noncall_type_alias_declaration_is_static_inactive(file, annotations, name, declaration_module, declaration_line, declaration_offset, table)
                return false if not type_symbol_is_alias and try_overload_nominal_type_declaration_is_static_inactive(file, annotations, name, declaration_module, declaration_line, declaration_offset, table)
                return false if not try_error_alias_module_visible(annotations, declaration_module, lexical_module)
                exact_private: mutable bool = false
                exact_public: mutable bool = false
                legacy_private_marker: mutable bool = false
                for annotation in annotations |exact_private, exact_public, legacy_private_marker, name, declaration_module, declaration_line, declaration_offset|:
                    continue if annotation.name != name or annotation.module != declaration_module or (annotation.owner != "__section_private" and annotation.owner != "__section_public")
                    offsets_known: bool = declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET and annotation.offset != FALLIBLE_FUNCTION_NO_OFFSET
                    exact_offset: bool = offsets_known and annotation.offset == declaration_offset
                    exact_line: bool = not offsets_known and annotation.line == declaration_line
                    if exact_offset or exact_line:
                        exact_private <- true if annotation.owner == "__section_private"
                        exact_public <- true if annotation.owner == "__section_public"
                    elif annotation.owner == "__section_private" and annotation.offset == FALLIBLE_FUNCTION_NO_OFFSET:
                        legacy_private_marker <- true
                return false if exact_private and exact_public
                return try_noncall_module_is_ancestor(declaration_module, lexical_module) if exact_private
                return true if exact_public
                return false if legacy_private_marker
                return true

        def try_overload_type_owner_in_module(file: Ast::File&, name: sview, declaration_module: sview, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, ambiguous: bool, owner: sview):
            can Abort.Panic:
                count: mutable usize = 0.usize()
                for symbol in table.symbols |count, name, declaration_module, lexical_module, annotations|:
                    continue if symbol.name != name or symbol.module_owner != declaration_module or not try_overload_type_symbol_is_nominal(symbol)
                    continue if not try_overload_type_declaration_visible(file, annotations, symbol.kind == SymbolKind.Alias, name, declaration_module, symbol.line, symbol.offset, lexical_module, table)
                    count <- count + 1.usize()
                # Duplicate declarations in one module share the same nominal owner;
                # Core reports that declaration error separately. Ambiguity here means
                # different visible modules can own the same bare spelling.
                return (count > 0.usize(), false, declaration_module)

        def try_overload_unresolved_wildcard_type_owner(file: Ast::File&, name: sview, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, ambiguous: bool, owner: sview, scope_length: usize):
            can Abort.Panic:
                found: mutable bool = false
                ambiguous: mutable bool = false
                owner: mutable sview = ""
                scope_length: mutable usize = 0.usize()
                for binding in annotations |found, ambiguous, owner, scope_length, annotations, table, name, lexical_module|:
                    continue if binding.owner != "__try_unresolved_static_binding" or binding.name != "__binding_wildcard_import" or not try_noncall_module_is_ancestor(binding.module, lexical_module)
                    candidate_count: mutable usize = 0.usize()
                    candidate_owner: mutable sview = ""
                    candidate_ambiguous: mutable bool = false
                    for symbol in table.symbols |candidate_count, candidate_owner, candidate_ambiguous, annotations, binding, name, lexical_module|:
                        continue if symbol.name != name or not try_overload_type_symbol_is_nominal(symbol)
                        # The sentinel's detail_name is already the canonical target
                        # assembled while filtering the original relative using row.
                        continue if symbol.module_owner != binding.detail_name
                        continue if not try_overload_type_declaration_visible(file, annotations, symbol.kind == SymbolKind.Alias, name, symbol.module_owner, symbol.line, symbol.offset, lexical_module, table)
                        candidate_ambiguous <- true if candidate_count > 0.usize() and candidate_owner != symbol.module_owner
                        candidate_count <- candidate_count + 1.usize()
                        candidate_owner <- symbol.module_owner
                    continue if candidate_count == 0.usize()
                    if not found or binding.module.len > scope_length:
                        found <- true
                        ambiguous <- candidate_ambiguous
                        owner <- candidate_owner
                        scope_length <- binding.module.len
                    elif binding.module.len == scope_length:
                        ambiguous <- true if candidate_ambiguous or owner != candidate_owner
                return (found, ambiguous, owner, scope_length)

        def try_overload_unresolved_selective_import_can_bind_type(file: Ast::File&, binding: Ast::EnumAnnotation, name: sview, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                # A function/value import cannot change nominal type identity. Pair the
                # unresolved import with its exact source row and require a visible type
                # declaration before making owner lookup uncertain.
                source_found: mutable bool = false
                source_name: mutable sview = ""
                for source in annotations |source_found, source_name, binding, annotations|:
                    if source.owner == "__from_src" and source.module == binding.module and source.line == binding.line and source.offset == binding.offset:
                        source_found <- true
                        source_name <- source.name
                        break
                return false if not source_found or source_name == ""
                for symbol in table.symbols |binding, name, source_name, lexical_module, annotations|:
                    continue if symbol.name != name or not try_overload_type_symbol_is_nominal(symbol)
                    continue if not callable_import_module_matches_target(symbol.module_owner, binding.module, source_name)
                    return true if try_overload_type_declaration_visible(file, annotations, symbol.kind == SymbolKind.Alias, name, symbol.module_owner, symbol.line, symbol.offset, lexical_module, table)
                return false

        # Reconstruct Core's type-name owner from the declaration's lexical scope. Local
        # and ancestor declarations precede imports; selective imports precede wildcard
        # imports. This keeps an unimported same-named declaration in a private module out
        # of the decision while still returning unknown for genuinely colliding imports.
        def try_overload_nominal_type_owner_for_module(file: Ast::File&, name: sview, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, ambiguous: bool, owner: sview):
            can Abort.Panic:
                return (false, false, "") if name == ""
                scope_module: mutable sview = lexical_module
                while true |scope_module, annotations, table, name, lexical_module|:
                    local: (found: bool, ambiguous: bool, owner: sview) = try_overload_type_owner_in_module(file, name, scope_module, lexical_module, annotations, table)
                    return local if local.found or local.ambiguous
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)

                selective_seen: mutable bool = false
                for binding in annotations |selective_seen, annotations, name, lexical_module, table|:
                    if binding.owner == "__try_unresolved_static_binding" and binding.name == "__from_member" and binding.detail_name == name and try_noncall_module_is_ancestor(binding.module, lexical_module):
                        return (false, true, "") if try_overload_unresolved_selective_import_can_bind_type(file, binding, name, lexical_module, annotations, table)
                    continue if selective_seen or binding.owner != "__from_member" or binding.name != name
                    for source in annotations |selective_seen, binding, annotations, name, lexical_module, table|:
                        continue if source.owner != "__from_src" or source.module != binding.module or source.line != binding.line or source.offset != binding.offset
                        selective_seen <- true
                        count: mutable usize = 0.usize()
                        selected_owner: mutable sview = ""
                        for symbol in table.symbols |count, selected_owner, annotations, binding, source, name, lexical_module|:
                            continue if symbol.name != name or not try_overload_type_symbol_is_nominal(symbol)
                            continue if not callable_import_module_matches_target(symbol.module_owner, binding.module, source.name)
                            if not try_overload_type_declaration_visible(file, annotations, symbol.kind == SymbolKind.Alias, name, symbol.module_owner, symbol.line, symbol.offset, lexical_module, table):
                                continue
                            count <- count + 1.usize()
                            selected_owner <- symbol.module_owner
                        return (count > 0.usize(), false, selected_owner) if count > 0.usize()
                        return (false, false, "")

                wildcard_found: mutable bool = false
                wildcard_ambiguous: mutable bool = false
                wildcard_scope_length: mutable usize = 0.usize()
                wildcard_owner: mutable sview = ""
                for binding in annotations |wildcard_found, wildcard_ambiguous, wildcard_scope_length, wildcard_owner, annotations, name, lexical_module, table|:
                    continue if binding.name != "__binding_wildcard_import" or not try_noncall_module_is_ancestor(binding.module, lexical_module)
                    for symbol in table.symbols |wildcard_found, wildcard_ambiguous, wildcard_scope_length, wildcard_owner, binding, annotations, name, lexical_module|:
                        continue if symbol.name != name or not try_overload_type_symbol_is_nominal(symbol)
                        continue if not callable_import_module_matches_target(symbol.module_owner, binding.module, binding.owner)
                        continue if not try_overload_type_declaration_visible(file, annotations, symbol.kind == SymbolKind.Alias, name, symbol.module_owner, symbol.line, symbol.offset, lexical_module, table)
                        if not wildcard_found or binding.module.len > wildcard_scope_length:
                            wildcard_found <- true
                            wildcard_ambiguous <- false
                            wildcard_scope_length <- binding.module.len
                            wildcard_owner <- symbol.module_owner
                        elif binding.module.len == wildcard_scope_length:
                            wildcard_ambiguous <- true if wildcard_owner != symbol.module_owner
                unresolved_wildcard: (found: bool, ambiguous: bool, owner: sview, scope_length: usize) = try_overload_unresolved_wildcard_type_owner(file, name, lexical_module, annotations, table)
                unresolved_wildcard_can_change_owner: bool = unresolved_wildcard.found and (not wildcard_found or unresolved_wildcard.scope_length > wildcard_scope_length or (unresolved_wildcard.scope_length == wildcard_scope_length and (unresolved_wildcard.ambiguous or unresolved_wildcard.owner != wildcard_owner)))
                return (false, true, "") if unresolved_wildcard_can_change_owner
                return (wildcard_found and not wildcard_ambiguous, wildcard_ambiguous, wildcard_owner)

        def try_overload_nominal_type_owner(file: Ast::File&, name: sview, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, ambiguous: bool, owner: sview):
            can Abort.Panic:
                return (false, false, "") if declaration.value == INVALID_DECL_ID_VALUE or declaration.value.usize() >= table.symbols.count
                return try_overload_nominal_type_owner_for_module(file, name, table.symbols[declaration.value.usize()].module_owner, annotations, table)

        # Preserve a known-but-unqualified nominal receiver so callers can fail closed
        # instead of falling back to a visible overload after its owner became ambiguous.
        def try_overload_type_has_ambiguous_nominal_identity(file: Ast::File&, type_id: u32, declaration: DeclId,
                annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> bool:
            can Abort.Panic:
                return false if type_id == 0
                return true if depth > 64
                kind: SemTypeKind = interned_kind(type_id, table)
                if kind == SemTypeKind.Named:
                    return false if try_overload_type_is_generic_parameter(type_id, declaration, annotations, table)
                    name: sview = interned_name(type_id, table)
                    return false if name == ""
                    identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, name, declaration, annotations, table)
                    return identity.ambiguous
                if kind == SemTypeKind.Container:
                    container_name: sview = interned_name(type_id, table)
                    builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                    if not builtin_container:
                        container_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, container_name, declaration, annotations, table)
                        return true if container_identity.ambiguous
                for element_position in 0..<interned_elem_count(type_id, table) |type_id, declaration, annotations, table, depth|:
                    return true if try_overload_type_has_ambiguous_nominal_identity(file, interned_elem(type_id, element_position.u32(), table), declaration, annotations, table, depth + 1)
                return false

        def try_overload_type_shared_ambiguous_match_state(file: Ast::File&, formal_type_id: u32, actual_type_id: u32,
                formal_declaration: DeclId, actual_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> (potential_match: bool, ambiguous: bool):
            can Abort.Panic:
                return (true, true) if depth > 64
                return (false, false) if formal_type_id == 0 or actual_type_id == 0
                formal_kind: SemTypeKind = interned_kind(formal_type_id, table)
                actual_kind: SemTypeKind = interned_kind(actual_type_id, table)
                if formal_kind == SemTypeKind.Ref or actual_kind == SemTypeKind.Ref:
                    if formal_kind == SemTypeKind.Ref and actual_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1 or interned_elem_count(actual_type_id, table) != 1
                        return try_overload_type_shared_ambiguous_match_state(file, interned_elem(formal_type_id, 0, table), interned_elem(actual_type_id, 0, table), formal_declaration, actual_module, annotations, table, depth + 1)
                    if formal_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1
                        return try_overload_type_shared_ambiguous_match_state(file, interned_elem(formal_type_id, 0, table), actual_type_id, formal_declaration, actual_module, annotations, table, depth + 1)
                    return (false, false) if interned_elem_count(actual_type_id, table) != 1
                    return try_overload_type_shared_ambiguous_match_state(file, formal_type_id, interned_elem(actual_type_id, 0, table), formal_declaration, actual_module, annotations, table, depth + 1)
                return (false, false) if formal_kind != actual_kind
                if formal_kind == SemTypeKind.Named:
                    name: sview = interned_name(actual_type_id, table)
                    return (false, false) if name == "" or name != interned_name(formal_type_id, table)
                    return (true, false) if try_overload_type_is_generic_parameter(formal_type_id, formal_declaration, annotations, table)
                    actual_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(file, name, actual_module, annotations, table)
                    formal_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, name, formal_declaration, annotations, table)
                    return (false, false) if actual_identity.found and formal_identity.found and actual_identity.owner != formal_identity.owner
                    return (true, true) if actual_identity.ambiguous or formal_identity.ambiguous or not actual_identity.found or not formal_identity.found
                    return (true, false)
                if formal_kind == SemTypeKind.Int or formal_kind == SemTypeKind.Float:
                    return (true, false) if formal_type_id == actual_type_id
                    return (true, false) if formal_kind == SemTypeKind.Int and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                    return (false, false)
                return (true, false) if formal_kind == SemTypeKind.Char and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                return (formal_type_id == actual_type_id, false) if formal_kind == SemTypeKind.Bool or formal_kind == SemTypeKind.Char
                return (true, false) if formal_kind == SemTypeKind.String
                return (false, false) if formal_kind != SemTypeKind.Optional and formal_kind != SemTypeKind.Ref and formal_kind != SemTypeKind.Tuple and formal_kind != SemTypeKind.Container
                return (false, false) if interned_name(formal_type_id, table) != interned_name(actual_type_id, table)
                if formal_kind == SemTypeKind.Container:
                    container_name: sview = interned_name(actual_type_id, table)
                    builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                    if not builtin_container:
                        actual_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(file, container_name, actual_module, annotations, table)
                        formal_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, container_name, formal_declaration, annotations, table)
                        return (false, false) if actual_container.found and formal_container.found and actual_container.owner != formal_container.owner
                        return (true, true) if actual_container.ambiguous or formal_container.ambiguous or not actual_container.found or not formal_container.found
                element_count: u32 = interned_elem_count(actual_type_id, table)
                return (false, false) if element_count != interned_elem_count(formal_type_id, table)
                has_ambiguous_element: mutable bool = false
                for element_position in 0..<element_count.usize() |element_count, formal_type_id, actual_type_id, formal_declaration, actual_module, annotations, table, depth|:
                    element_state: (potential_match: bool, ambiguous: bool) = try_overload_type_shared_ambiguous_match_state(file, interned_elem(formal_type_id, element_position.u32(), table), interned_elem(actual_type_id, element_position.u32(), table), formal_declaration, actual_module, annotations, table, depth + 1)
                    return (false, false) if not element_state.potential_match
                    has_ambiguous_element <- true if element_state.ambiguous
                return (true, has_ambiguous_element)

        def try_overload_type_is_firm(file: Ast::File&, type_id: u32, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                kind: SemTypeKind = interned_kind(type_id, table)
                return true if kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char or kind == SemTypeKind.String
                if kind == SemTypeKind.Named:
                    return false if try_overload_type_is_generic_parameter(type_id, declaration, annotations, table)
                    name: sview = interned_name(type_id, table)
                    return false if name == ""
                    identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, name, declaration, annotations, table)
                    return identity.found
                if kind == SemTypeKind.Optional or kind == SemTypeKind.Ref:
                    return false if interned_elem_count(type_id, table) != 1
                    return try_overload_type_is_firm(file, interned_elem(type_id, 0, table), declaration, annotations, table)
                if kind == SemTypeKind.Tuple or kind == SemTypeKind.Container:
                    if kind == SemTypeKind.Container:
                        container_name: sview = interned_name(type_id, table)
                        return false if container_name == ""
                        builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                        if not builtin_container:
                            identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, container_name, declaration, annotations, table)
                            return false if not identity.found
                    for element_position in 0..<interned_elem_count(type_id, table) |type_id, declaration, annotations, table|:
                        return false if not try_overload_type_is_firm(file, interned_elem(type_id, element_position.u32(), table), declaration, annotations, table)
                    return true
                return false

        # The receiver selector already knows the call-site module even when its exact
        # enclosing function row is unavailable. Use that lexical scope for nominal TypeIds
        # so a named receiver can still be ranked after the binding lookup has succeeded.
        def try_overload_type_is_firm_in_module(file: Ast::File&, type_id: u32, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return false if type_id == 0 or depth > 64
                kind: SemTypeKind = interned_kind(type_id, table)
                return true if kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char or kind == SemTypeKind.String
                if kind == SemTypeKind.Named:
                    name: sview = interned_name(type_id, table)
                    return false if name == ""
                    identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(file, name, lexical_module, annotations, table)
                    return identity.found
                if kind == SemTypeKind.Optional or kind == SemTypeKind.Ref:
                    return false if interned_elem_count(type_id, table) != 1
                    return try_overload_type_is_firm_in_module(file, interned_elem(type_id, 0, table), lexical_module, annotations, table, depth + 1)
                if kind == SemTypeKind.Tuple or kind == SemTypeKind.Container:
                    if kind == SemTypeKind.Container:
                        container_name: sview = interned_name(type_id, table)
                        return false if container_name == ""
                        builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                        if not builtin_container:
                            identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(file, container_name, lexical_module, annotations, table)
                            return false if not identity.found
                    for element_position in 0..<interned_elem_count(type_id, table) |type_id, lexical_module, annotations, table, depth|:
                        return false if not try_overload_type_is_firm_in_module(file, interned_elem(type_id, element_position.u32(), table), lexical_module, annotations, table, depth + 1)
                    return true
                return false

include "./callable_arguments.elisa"
include "./callback_families.elisa"
include "./callable_overloads.elisa"
include "./callable_noncall_expressions.elisa"
