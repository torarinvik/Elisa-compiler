extend Semantic:
    private:
        def callable_module_path_matches_suffix(candidate_module: sview, base_module: sview, suffix: sview) -> bool:
            can Abort.Panic:
                expected_length: usize = base_module.len if suffix == "" else base_module.len + 2.usize() + suffix.len
                return false if candidate_module.len != expected_length
                for offset in 0..<base_module.len |candidate_module, base_module|:
                    return false if candidate_module[offset] != base_module[offset]
                return true if suffix == ""
                return false if candidate_module[base_module.len] != 58 or candidate_module[base_module.len + 1.usize()] != 58
                for offset in 0..<suffix.len |candidate_module, base_module, suffix|:
                    return false if candidate_module[base_module.len + 2.usize() + offset] != suffix[offset]
                return true

        def callable_module_path_segments_append(segments: mutable darray[sview]&, path: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if path == ""
                start: mutable usize = 0.usize()
                offset: mutable usize = 0.usize()
                while offset + 1.usize() < path.len |segments, path, start, offset|:
                    if path[offset] == 58 and path[offset + 1.usize()] == 58:
                        segments.push(path[start:offset])
                        start <- offset + 2.usize()
                        offset <- offset + 2.usize()
                    else:
                        offset <- offset + 1.usize()
                segments.push(path[start:path.len])

        def callable_alias_path_matches_candidate(annotations: darray[Ast::EnumAnnotation]&, alias_scope: sview, alias_target: sview, suffix: sview, candidate_module: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                segments: mutable darray[sview] = []
                callable_module_path_segments_append(segments, alias_target)
                callable_module_path_segments_append(segments, suffix)
                current_scope: mutable sview = alias_scope
                remaining: mutable usize = annotations.count + 1.usize()
                while segments.count > 0.usize() and remaining > 0.usize() |segments, remaining, annotations, current_scope|:
                    visible_alias: (count: usize, target: sview, scope: sview) = callable_using_alias_visible_target(annotations, current_scope, segments[0])
                    return false if visible_alias.count > 1.usize()
                    if visible_alias.count == 0.usize():
                        expanded_relative: mutable darray[sview] = []
                        callable_module_path_segments_append(expanded_relative, current_scope)
                        for index in 0..<segments.count |expanded_relative, segments|:
                            expanded_relative.push(segments[index])
                        segments <- expanded_relative
                        break
                    expanded_alias: mutable darray[sview] = []
                    callable_module_path_segments_append(expanded_alias, visible_alias.target)
                    for index in 1..<segments.count |expanded_alias, segments|:
                        expanded_alias.push(segments[index])
                    segments <- expanded_alias
                    current_scope <- visible_alias.scope
                    remaining <- remaining - 1.usize()
                return false if remaining == 0.usize()
                return candidate_module == "" if segments.count == 0.usize()
                candidate_start: mutable usize = 0.usize()
                for index in 0..<segments.count |candidate_module, candidate_start, segments|:
                    candidate_end: mutable usize = candidate_module.len
                    for offset in candidate_start..<candidate_module.len |candidate_module, candidate_start, candidate_end|:
                        if offset + 1.usize() < candidate_module.len and candidate_module[offset] == 58 and candidate_module[offset + 1.usize()] == 58:
                            candidate_end <- offset
                            break
                    return false if candidate_module[candidate_start:candidate_end] != segments[index]
                    if index + 1.usize() < segments.count:
                        return false if candidate_end + 1.usize() >= candidate_module.len or candidate_module[candidate_end] != 58 or candidate_module[candidate_end + 1.usize()] != 58
                        candidate_start <- candidate_end + 2.usize()
                    else:
                        return candidate_end == candidate_module.len
                return false

        def callable_named_declaration_in_module(table: SymbolTable&, name: sview, module: sview) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |table, name, module|:
                    return true if symbol.kind == SymbolKind.Func and symbol.name == name and symbol.module_owner == module
                return false

        def callable_function_declaration_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_line: u32, declaration_offset: u32, lexical_module: sview) -> bool:
            can Abort.Panic:
                return false if not try_error_alias_module_visible(annotations, candidate_module, lexical_module)
                exact_private: mutable bool = false
                exact_public: mutable bool = false
                legacy_private_marker: mutable bool = false
                for annotation in annotations |exact_private, exact_public, legacy_private_marker, name, candidate_module, declaration_line, declaration_offset|:
                    continue if annotation.name != name or annotation.module != candidate_module or (annotation.owner != "__section_private" and annotation.owner != "__section_public")
                    offsets_known: bool = declaration_offset != 0 and annotation.offset != 0
                    exact_offset: bool = offsets_known and annotation.offset == declaration_offset
                    exact_line: bool = not offsets_known and declaration_line != 0 and annotation.line == declaration_line
                    if exact_offset or exact_line:
                        exact_private <- true if annotation.owner == "__section_private"
                        exact_public <- true if annotation.owner == "__section_public"
                    elif annotation.owner == "__section_private" and annotation.offset == 0:
                        legacy_private_marker <- true
                return false if exact_private and exact_public
                return try_noncall_module_is_ancestor(candidate_module, lexical_module) if exact_private
                return true if exact_public
                # Old producers may have emitted a name-only private section marker.
                # With no declaration coordinate to match, fail closed for this name.
                return false if legacy_private_marker
                return true

        def callable_named_visible_declaration_in_module(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview, module: sview, enclosing_module: sview) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |table, annotations, name, module, enclosing_module|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner != module
                    return true if callable_function_declaration_visible(annotations, name, module, symbol.line, symbol.offset, enclosing_module)
                return false

        def callable_symbol_accepts_named_arguments(table: SymbolTable&, try_named_arguments: darray[Ast::EnumAnnotation]&, symbol: Symbol, try_offset: u32) -> bool:
            can Abort.Panic:
                return true if try_offset == 0
                parameter_count: mutable usize = 0.usize()
                for row in 0..<table.function_param_owner.count |table, symbol, parameter_count|:
                    continue if row >= table.function_param_declaration_id.count or table.function_param_declaration_id[row].value != symbol.id.value
                    parameter_count <- parameter_count + 1.usize()
                # Extern and synthesized declarations may not have parameter-name rows.
                # Keep their overloads conservative when formal names are unavailable.
                return true if parameter_count == 0.usize()
                for argument in try_named_arguments |table, symbol, try_offset|:
                    continue if argument.owner != "__try_callee_named_arg" or argument.offset != try_offset
                    found_parameter: mutable bool = false
                    for row in 0..<table.function_param_owner.count |table, symbol, argument, found_parameter|:
                        continue if row >= table.function_param_declaration_id.count or table.function_param_declaration_id[row].value != symbol.id.value
                        found_parameter <- true if row < table.function_param_name.count and table.function_param_name[row] == argument.name
                    return false if not found_parameter
                return true

        def try_enclosing_function_decl_id(table: SymbolTable&, enclosing: (line: u32, offset: u32), enclosing_module: sview) -> DeclId:
            can Abort.Panic:
                found: mutable DeclId = DeclId{value: INVALID_DECL_ID_VALUE}
                matches: mutable usize = 0.usize()
                for symbol in table.symbols |found, matches, enclosing, enclosing_module|:
                    continue if symbol.kind != SymbolKind.Func or symbol.line != enclosing.line or symbol.module_owner != enclosing_module
                    continue if enclosing.offset != 0 and symbol.offset != enclosing.offset
                    matches <- matches + 1.usize()
                    found <- symbol.id
                return found if matches == 1.usize()
                return DeclId{value: INVALID_DECL_ID_VALUE}

        def try_overload_type_is_generic_parameter(type_id: u32, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if type_id == 0 or declaration.value == INVALID_DECL_ID_VALUE or declaration.value.usize() >= table.symbols.count
                return false if interned_kind(type_id, table) != SemTypeKind.Named
                name: sview = interned_name(type_id, table)
                declaration_symbol: Symbol = table.symbols[declaration.value.usize()]
                for annotation in annotations |name, declaration_symbol|:
                    return true if annotation.owner == name and annotation.name == "__generic_param_identity" and annotation.detail_line == declaration_symbol.line and annotation.offset == declaration_symbol.offset and annotation.module == declaration_symbol.module_owner
                return false

        def try_overload_type_symbol_is_nominal(symbol: Symbol) -> bool:
            return symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)

        # Unlike callable declarations, nominal type visibility is used only to recover
        # an identity already selected by Core's type resolver. A private declaration is
        # visible in its own module and descendants, but unrelated private modules must
        # not poison a same-spelled local or imported type.
        def try_overload_type_declaration_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_module: sview, declaration_line: u32, declaration_offset: u32, lexical_module: sview) -> bool:
            can Abort.Panic:
                return false if not try_error_alias_module_visible(annotations, declaration_module, lexical_module)
                exact_private: mutable bool = false
                exact_public: mutable bool = false
                legacy_private_marker: mutable bool = false
                for annotation in annotations |exact_private, exact_public, legacy_private_marker, name, declaration_module, declaration_line, declaration_offset|:
                    continue if annotation.name != name or annotation.module != declaration_module or (annotation.owner != "__section_private" and annotation.owner != "__section_public")
                    offsets_known: bool = declaration_offset != 0 and annotation.offset != 0
                    exact_offset: bool = offsets_known and annotation.offset == declaration_offset
                    exact_line: bool = not offsets_known and declaration_line != 0 and annotation.line == declaration_line
                    if exact_offset or exact_line:
                        exact_private <- true if annotation.owner == "__section_private"
                        exact_public <- true if annotation.owner == "__section_public"
                    elif annotation.owner == "__section_private" and annotation.offset == 0:
                        legacy_private_marker <- true
                return false if exact_private and exact_public
                return try_noncall_module_is_ancestor(declaration_module, lexical_module) if exact_private
                return true if exact_public
                return false if legacy_private_marker
                return true

        def try_overload_type_owner_in_module(name: sview, declaration_module: sview, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, ambiguous: bool, owner: sview):
            can Abort.Panic:
                count: mutable usize = 0.usize()
                for symbol in table.symbols |count, name, declaration_module, lexical_module, annotations|:
                    continue if symbol.name != name or symbol.module_owner != declaration_module or not try_overload_type_symbol_is_nominal(symbol)
                    continue if not try_overload_type_declaration_visible(annotations, name, declaration_module, symbol.line, symbol.offset, lexical_module)
                    count <- count + 1.usize()
                # Duplicate declarations in one module share the same nominal owner;
                # Core reports that declaration error separately. Ambiguity here means
                # different visible modules can own the same bare spelling.
                return (count > 0.usize(), false, declaration_module)

        # Reconstruct Core's type-name owner from the declaration's lexical scope. Local
        # and ancestor declarations precede imports; selective imports precede wildcard
        # imports. This keeps an unimported same-named declaration in a private module out
        # of the decision while still returning unknown for genuinely colliding imports.
        def try_overload_nominal_type_owner_for_module(name: sview, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, ambiguous: bool, owner: sview):
            can Abort.Panic:
                return (false, false, "") if name == ""
                scope_module: mutable sview = lexical_module
                while true |scope_module, annotations, table, name, lexical_module|:
                    local: (found: bool, ambiguous: bool, owner: sview) = try_overload_type_owner_in_module(name, scope_module, lexical_module, annotations, table)
                    return local if local.found or local.ambiguous
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)

                selective_seen: mutable bool = false
                for binding in annotations |selective_seen, annotations, name, lexical_module, table|:
                    continue if selective_seen or binding.owner != "__from_member" or binding.name != name
                    for source in annotations |selective_seen, binding, annotations, name, lexical_module, table|:
                        continue if source.owner != "__from_src" or source.module != binding.module or source.line != binding.line or source.offset != binding.offset
                        selective_seen <- true
                        count: mutable usize = 0.usize()
                        selected_owner: mutable sview = ""
                        for symbol in table.symbols |count, selected_owner, annotations, binding, source, name, lexical_module|:
                            continue if symbol.name != name or not try_overload_type_symbol_is_nominal(symbol)
                            continue if not callable_module_path_matches_suffix(symbol.module_owner, binding.module, source.name)
                            if not try_overload_type_declaration_visible(annotations, name, symbol.module_owner, symbol.line, symbol.offset, lexical_module):
                                continue
                            count <- count + 1.usize()
                            selected_owner <- symbol.module_owner
                        return (count > 0.usize(), false, selected_owner) if count > 0.usize()
                        return (false, false, "")

                wildcard_found: mutable bool = false
                wildcard_ambiguous: mutable bool = false
                wildcard_scope_length: mutable usize = 0.usize()
                wildcard_owner: mutable sview = ""
                for binding in annotations |wildcard_found, wildcard_ambiguous, wildcard_scope_length, wildcard_owner, annotations, name, lexical_module, table|:
                    continue if binding.name != "__binding_wildcard_import" or not try_noncall_module_is_ancestor(binding.module, lexical_module)
                    for symbol in table.symbols |wildcard_found, wildcard_ambiguous, wildcard_scope_length, wildcard_owner, binding, annotations, name, lexical_module|:
                        continue if symbol.name != name or not try_overload_type_symbol_is_nominal(symbol)
                        continue if not callable_module_path_matches_suffix(symbol.module_owner, binding.module, binding.owner)
                        continue if not try_overload_type_declaration_visible(annotations, name, symbol.module_owner, symbol.line, symbol.offset, lexical_module)
                        if not wildcard_found or binding.module.len > wildcard_scope_length:
                            wildcard_found <- true
                            wildcard_ambiguous <- false
                            wildcard_scope_length <- binding.module.len
                            wildcard_owner <- symbol.module_owner
                        elif binding.module.len == wildcard_scope_length:
                            wildcard_ambiguous <- true if wildcard_owner != symbol.module_owner
                return (wildcard_found and not wildcard_ambiguous, wildcard_ambiguous, wildcard_owner)

        def try_overload_nominal_type_owner(name: sview, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (found: bool, ambiguous: bool, owner: sview):
            can Abort.Panic:
                return (false, false, "") if declaration.value == INVALID_DECL_ID_VALUE or declaration.value.usize() >= table.symbols.count
                return try_overload_nominal_type_owner_for_module(name, table.symbols[declaration.value.usize()].module_owner, annotations, table)

        # Preserve a known-but-unqualified nominal receiver so callers can fail closed
        # instead of falling back to a visible overload after its owner became ambiguous.
        def try_overload_type_has_ambiguous_nominal_identity(type_id: u32, declaration: DeclId,
                annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> bool:
            can Abort.Panic:
                return false if type_id == 0
                return true if depth > 64
                kind: SemTypeKind = interned_kind(type_id, table)
                if kind == SemTypeKind.Named:
                    return false if try_overload_type_is_generic_parameter(type_id, declaration, annotations, table)
                    name: sview = interned_name(type_id, table)
                    return false if name == ""
                    identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(name, declaration, annotations, table)
                    return identity.ambiguous
                if kind == SemTypeKind.Container:
                    container_name: sview = interned_name(type_id, table)
                    builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                    if not builtin_container:
                        container_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(container_name, declaration, annotations, table)
                        return true if container_identity.ambiguous
                for element_position in 0..<interned_elem_count(type_id, table) |type_id, declaration, annotations, table, depth|:
                    return true if try_overload_type_has_ambiguous_nominal_identity(interned_elem(type_id, element_position.u32(), table), declaration, annotations, table, depth + 1)
                return false

        def try_overload_type_shared_ambiguous_match_state(formal_type_id: u32, actual_type_id: u32,
                formal_declaration: DeclId, actual_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> (potential_match: bool, ambiguous: bool):
            can Abort.Panic:
                return (true, true) if depth > 64
                return (false, false) if formal_type_id == 0 or actual_type_id == 0
                formal_kind: SemTypeKind = interned_kind(formal_type_id, table)
                actual_kind: SemTypeKind = interned_kind(actual_type_id, table)
                if formal_kind == SemTypeKind.Ref or actual_kind == SemTypeKind.Ref:
                    if formal_kind == SemTypeKind.Ref and actual_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1 or interned_elem_count(actual_type_id, table) != 1
                        return try_overload_type_shared_ambiguous_match_state(interned_elem(formal_type_id, 0, table), interned_elem(actual_type_id, 0, table), formal_declaration, actual_module, annotations, table, depth + 1)
                    if formal_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1
                        return try_overload_type_shared_ambiguous_match_state(interned_elem(formal_type_id, 0, table), actual_type_id, formal_declaration, actual_module, annotations, table, depth + 1)
                    return (false, false) if interned_elem_count(actual_type_id, table) != 1
                    return try_overload_type_shared_ambiguous_match_state(formal_type_id, interned_elem(actual_type_id, 0, table), formal_declaration, actual_module, annotations, table, depth + 1)
                return (false, false) if formal_kind != actual_kind
                if formal_kind == SemTypeKind.Named:
                    name: sview = interned_name(actual_type_id, table)
                    return (false, false) if name == "" or name != interned_name(formal_type_id, table)
                    return (true, false) if try_overload_type_is_generic_parameter(formal_type_id, formal_declaration, annotations, table)
                    actual_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(name, actual_module, annotations, table)
                    formal_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(name, formal_declaration, annotations, table)
                    return (false, false) if actual_identity.found and formal_identity.found and actual_identity.owner != formal_identity.owner
                    return (true, true) if actual_identity.ambiguous or formal_identity.ambiguous or not actual_identity.found or not formal_identity.found
                    return (true, false)
                if formal_kind == SemTypeKind.Int or formal_kind == SemTypeKind.Float:
                    return (true, false) if formal_type_id == actual_type_id
                    return (true, false) if formal_kind == SemTypeKind.Int and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                    return (false, false)
                return (true, false) if formal_kind == SemTypeKind.Char and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                return (formal_type_id == actual_type_id, false) if formal_kind == SemTypeKind.Bool or formal_kind == SemTypeKind.Char
                return (true, false) if formal_kind == SemTypeKind.String
                return (false, false) if formal_kind != SemTypeKind.Optional and formal_kind != SemTypeKind.Ref and formal_kind != SemTypeKind.Tuple and formal_kind != SemTypeKind.Container
                return (false, false) if interned_name(formal_type_id, table) != interned_name(actual_type_id, table)
                if formal_kind == SemTypeKind.Container:
                    container_name: sview = interned_name(actual_type_id, table)
                    builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                    if not builtin_container:
                        actual_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(container_name, actual_module, annotations, table)
                        formal_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(container_name, formal_declaration, annotations, table)
                        return (false, false) if actual_container.found and formal_container.found and actual_container.owner != formal_container.owner
                        return (true, true) if actual_container.ambiguous or formal_container.ambiguous or not actual_container.found or not formal_container.found
                element_count: u32 = interned_elem_count(actual_type_id, table)
                return (false, false) if element_count != interned_elem_count(formal_type_id, table)
                has_ambiguous_element: mutable bool = false
                for element_position in 0..<element_count.usize() |element_count, formal_type_id, actual_type_id, formal_declaration, actual_module, annotations, table, depth|:
                    element_state: (potential_match: bool, ambiguous: bool) = try_overload_type_shared_ambiguous_match_state(interned_elem(formal_type_id, element_position.u32(), table), interned_elem(actual_type_id, element_position.u32(), table), formal_declaration, actual_module, annotations, table, depth + 1)
                    return (false, false) if not element_state.potential_match
                    has_ambiguous_element <- true if element_state.ambiguous
                return (true, has_ambiguous_element)

        def try_overload_type_is_firm(type_id: u32, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                kind: SemTypeKind = interned_kind(type_id, table)
                return true if kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char or kind == SemTypeKind.String
                if kind == SemTypeKind.Named:
                    return false if try_overload_type_is_generic_parameter(type_id, declaration, annotations, table)
                    name: sview = interned_name(type_id, table)
                    return false if name == ""
                    identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(name, declaration, annotations, table)
                    return identity.found
                if kind == SemTypeKind.Optional or kind == SemTypeKind.Ref:
                    return false if interned_elem_count(type_id, table) != 1
                    return try_overload_type_is_firm(interned_elem(type_id, 0, table), declaration, annotations, table)
                if kind == SemTypeKind.Tuple or kind == SemTypeKind.Container:
                    if kind == SemTypeKind.Container:
                        container_name: sview = interned_name(type_id, table)
                        return false if container_name == ""
                        builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                        if not builtin_container:
                            identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(container_name, declaration, annotations, table)
                            return false if not identity.found
                    for element_position in 0..<interned_elem_count(type_id, table) |type_id, declaration, annotations, table|:
                        return false if not try_overload_type_is_firm(interned_elem(type_id, element_position.u32(), table), declaration, annotations, table)
                    return true
                return false

        # The receiver selector already knows the call-site module even when its exact
        # enclosing function row is unavailable. Use that lexical scope for nominal TypeIds
        # so a named receiver can still be ranked after the binding lookup has succeeded.
        def try_overload_type_is_firm_in_module(type_id: u32, lexical_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return false if type_id == 0 or depth > 64
                kind: SemTypeKind = interned_kind(type_id, table)
                return true if kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char or kind == SemTypeKind.String
                if kind == SemTypeKind.Named:
                    name: sview = interned_name(type_id, table)
                    return false if name == ""
                    identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(name, lexical_module, annotations, table)
                    return identity.found
                if kind == SemTypeKind.Optional or kind == SemTypeKind.Ref:
                    return false if interned_elem_count(type_id, table) != 1
                    return try_overload_type_is_firm_in_module(interned_elem(type_id, 0, table), lexical_module, annotations, table, depth + 1)
                if kind == SemTypeKind.Tuple or kind == SemTypeKind.Container:
                    if kind == SemTypeKind.Container:
                        container_name: sview = interned_name(type_id, table)
                        return false if container_name == ""
                        builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                        if not builtin_container:
                            identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(container_name, lexical_module, annotations, table)
                            return false if not identity.found
                    for element_position in 0..<interned_elem_count(type_id, table) |type_id, lexical_module, annotations, table, depth|:
                        return false if not try_overload_type_is_firm_in_module(interned_elem(type_id, element_position.u32(), table), lexical_module, annotations, table, depth + 1)
                    return true
                return false

        # Simple identifiers reuse their exact binding type. A unique same-module direct
        # call can contribute its concrete return TypeId; overloads, generic schemes,
        # shadowed values, and unresolved declarations remain unknown.
        def try_call_argument_type_ids(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, argument_positions: darray[Ast::EnumAnnotation]&, caller: DeclId, try_offset: u32, arity: u32, receiver_ref_mutability_known: mutable bool&, receiver_ref_mutable: mutable bool&) -> darray[u32]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[u32] = []
                receiver_ref_mutability_known <- false
                receiver_ref_mutable <- false
                argument_index: mutable usize = 0.usize()
                while argument_index < arity.usize() |result, argument_index, table, argument_positions, caller, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable, annotations|:
                    position_found: mutable bool = false
                    position_conflict: mutable bool = false
                    argument_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    for marker in argument_positions |position_found, position_conflict, argument_position, argument_index, try_offset|:
                        continue if marker.owner != "__try_callee_argument_position" or marker.offset != try_offset or marker.identity_id != argument_index.u32()
                        if not position_found:
                            argument_position <- marker.pos
                            position_found <- true
                        else:
                            position_conflict <- true if marker.pos.offset != argument_position.offset or marker.pos.end_offset != argument_position.end_offset
                    argument_type_id: mutable u32 = 0
                    type_found: mutable bool = false
                    type_conflict: mutable bool = false
                    receiver_ref_conflict: mutable bool = false
                    if position_found and not position_conflict and caller.value != INVALID_DECL_ID_VALUE:
                        binding: OwnershipBindingLookupResult = ownership_binding_at_position(table, caller, argument_position)
                        if binding.known:
                            for declared in table.binding_declared_types |argument_type_id, type_found, type_conflict, receiver_ref_conflict, receiver_ref_mutability_known, receiver_ref_mutable, binding, table, argument_index|:
                                continue if declared.binding_id.owner.value != binding.binding_id.owner.value or declared.binding_id.serial != binding.binding_id.serial
                                if not type_found:
                                    argument_type_id <- declared.type_id
                                    type_found <- true
                                else:
                                    type_conflict <- true if argument_type_id != declared.type_id
                                if argument_index == 0 and interned_kind(declared.type_id, table) == SemTypeKind.Ref:
                                    receiver_ref_mutability_seen: bool = receiver_ref_mutability_known
                                    if not receiver_ref_mutability_seen:
                                        receiver_ref_mutability_known <- true
                                        receiver_ref_mutable <- declared.writable_borrow
                                    elif receiver_ref_mutable != declared.writable_borrow:
                                        receiver_ref_conflict <- true
                    if not type_found and not type_conflict and caller.value != INVALID_DECL_ID_VALUE and caller.value.usize() < table.symbols.count:
                        nested_call_found: mutable bool = false
                        nested_call_conflict: mutable bool = false
                        nested_call_name: mutable sview = ""
                        nested_call_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                        for marker in argument_positions |nested_call_found, nested_call_conflict, nested_call_name, nested_call_position, argument_index, try_offset|:
                            continue if marker.owner != "__try_callee_argument_direct_call" or marker.offset != try_offset or marker.identity_id != argument_index.u32()
                            if not nested_call_found:
                                nested_call_found <- true
                                nested_call_name <- marker.name
                                nested_call_position <- marker.pos
                            else:
                                nested_call_conflict <- true if marker.name != nested_call_name or marker.pos.offset != nested_call_position.offset
                        if nested_call_found and not nested_call_conflict:
                            call_binding: OwnershipBindingLookupResult = ownership_binding_at_position(table, caller, nested_call_position)
                            if not call_binding.known:
                                caller_module: sview = table.symbols[caller.value.usize()].module_owner
                                call_return_found: mutable bool = false
                                call_return_conflict: mutable bool = false
                                call_return_type_id: mutable u32 = 0
                                call_return_function_line: mutable u32 = 0
                                for symbol in table.symbols |call_return_found, call_return_conflict, call_return_type_id, call_return_function_line, nested_call_name, caller_module|:
                                    continue if symbol.kind != SymbolKind.Func or symbol.name != nested_call_name or symbol.module_owner != caller_module
                                    if not call_return_found:
                                        call_return_type_id <- symbol.return_type_id
                                        call_return_function_line <- symbol.line
                                        call_return_found <- true
                                    else:
                                        call_return_conflict <- true
                                call_return_is_generic: bool = type_id_contains_function_generic(call_return_type_id, call_return_function_line, table) if call_return_found and not call_return_conflict else false
                                call_return_has_region: bool = type_id_contains_region(call_return_type_id, table) if call_return_found and not call_return_conflict else false
                                if call_return_type_id != 0 and not call_return_conflict and not call_return_is_generic and not call_return_has_region:
                                    argument_type_id <- call_return_type_id
                                    type_found <- true
                    receiver_ref_mutability_known <- false if argument_index == 0 and (type_conflict or receiver_ref_conflict)
                    receiver_ref_mutability_resolved: bool = receiver_ref_mutability_known
                    receiver_ref_mutable <- false if argument_index == 0 and not receiver_ref_mutability_resolved
                    argument_type_firm: bool = try_overload_type_is_firm(argument_type_id, caller, annotations, table) if type_found and not type_conflict else false
                    argument_type_ambiguous: bool = try_overload_type_has_ambiguous_nominal_identity(argument_type_id, caller, annotations, table, 0) if type_found and not type_conflict else false
                    result.push(argument_type_id if type_found and not type_conflict and (argument_type_firm or argument_type_ambiguous) else 0)
                    argument_index <- argument_index + 1.usize()
                return result

        def try_overload_receiver_pattern_matches(formal_type_id: u32, actual_type_id: u32, declaration: DeclId, actual_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> (known: bool, matches: bool):
            can Abort.Panic:
                return (false, false) if formal_type_id == 0 or actual_type_id == 0 or depth > 64
                return (true, true) if try_overload_type_is_generic_parameter(formal_type_id, declaration, annotations, table)
                formal_kind: SemTypeKind = interned_kind(formal_type_id, table)
                actual_kind: SemTypeKind = interned_kind(actual_type_id, table)
                # Receiver references are transparently borrowed or dereferenced by Core.
                if formal_kind == SemTypeKind.Ref or actual_kind == SemTypeKind.Ref:
                    if formal_kind == SemTypeKind.Ref and actual_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1 or interned_elem_count(actual_type_id, table) != 1
                        return try_overload_receiver_pattern_matches(interned_elem(formal_type_id, 0, table), interned_elem(actual_type_id, 0, table), declaration, actual_module, annotations, table, depth + 1)
                    if formal_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1
                        return try_overload_receiver_pattern_matches(interned_elem(formal_type_id, 0, table), actual_type_id, declaration, actual_module, annotations, table, depth + 1)
                    return (false, false) if interned_elem_count(actual_type_id, table) != 1
                    return try_overload_receiver_pattern_matches(formal_type_id, interned_elem(actual_type_id, 0, table), declaration, actual_module, annotations, table, depth + 1)
                numeric: bool = (formal_kind == SemTypeKind.Int or formal_kind == SemTypeKind.Float) and (actual_kind == SemTypeKind.Int or actual_kind == SemTypeKind.Float)
                if numeric:
                    return (true, true) if formal_type_id == actual_type_id
                    # Core has one special integer receiver coercion for an actual
                    # `int`; typed numeric widths otherwise need the same receiver type.
                    return (true, true) if formal_kind == SemTypeKind.Int and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                    return (true, false)
                # Core's untyped integer receiver coercion also accepts every integral
                # storage type, including `char`, which has a separate semantic kind.
                return (true, true) if formal_kind == SemTypeKind.Char and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                if formal_kind == SemTypeKind.Named or actual_kind == SemTypeKind.Named:
                    return (true, false) if formal_kind != actual_kind or interned_name(formal_type_id, table) != interned_name(actual_type_id, table)
                    name: sview = interned_name(formal_type_id, table)
                    formal_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(name, declaration, annotations, table)
                    actual_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(name, actual_module, annotations, table)
                    return (false, false) if formal_identity.ambiguous or actual_identity.ambiguous
                    return (false, false) if not formal_identity.found or not actual_identity.found
                    return (true, formal_identity.owner == actual_identity.owner)
                structural: bool = formal_kind == SemTypeKind.Optional or formal_kind == SemTypeKind.Tuple or formal_kind == SemTypeKind.Container
                if structural:
                    return (true, false) if formal_kind != actual_kind or interned_name(formal_type_id, table) != interned_name(actual_type_id, table)
                    if formal_kind == SemTypeKind.Container:
                        container_name: sview = interned_name(formal_type_id, table)
                        builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                        if not builtin_container:
                            formal_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(container_name, declaration, annotations, table)
                            actual_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(container_name, actual_module, annotations, table)
                            return (false, false) if formal_container.ambiguous or actual_container.ambiguous or not formal_container.found or not actual_container.found
                            return (true, false) if formal_container.owner != actual_container.owner
                    element_count: u32 = interned_elem_count(formal_type_id, table)
                    return (true, false) if element_count != interned_elem_count(actual_type_id, table)
                    for element_position in 0..<element_count.usize() |element_count, formal_type_id, actual_type_id, declaration, annotations, table, depth|:
                        element_match: (known: bool, matches: bool) = try_overload_receiver_pattern_matches(interned_elem(formal_type_id, element_position.u32(), table), interned_elem(actual_type_id, element_position.u32(), table), declaration, actual_module, annotations, table, depth + 1)
                        return (false, false) if not element_match.known
                        return (true, false) if not element_match.matches
                    return (true, true)
                return (true, type_ids_compatible(formal_type_id, actual_type_id, table))

        def try_overload_receiver_specificity(type_id: u32, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> (known: bool, score: usize):
            can Abort.Panic:
                return (false, 0.usize()) if type_id == 0 or depth > 64
                return (true, 0.usize()) if try_overload_type_is_generic_parameter(type_id, declaration, annotations, table)
                kind: SemTypeKind = interned_kind(type_id, table)
                if kind == SemTypeKind.Ref:
                    return (false, 0.usize()) if interned_elem_count(type_id, table) != 1
                    return try_overload_receiver_specificity(interned_elem(type_id, 0, table), declaration, annotations, table, depth + 1)
                if kind == SemTypeKind.Optional or kind == SemTypeKind.Tuple or kind == SemTypeKind.Container:
                    score: mutable usize = 1.usize()
                    for element_position in 0..<interned_elem_count(type_id, table) |score, type_id, declaration, annotations, table, depth|:
                        element_score: (known: bool, score: usize) = try_overload_receiver_specificity(interned_elem(type_id, element_position.u32(), table), declaration, annotations, table, depth + 1)
                        return (false, 0.usize()) if not element_score.known
                        score <- score + element_score.score
                    return (true, score)
                return (false, 0.usize()) if not try_overload_type_is_firm(type_id, declaration, annotations, table)
                return (true, 1.usize())

        def callable_symbol_receiver_type(table: SymbolTable&, symbol: Symbol) -> (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool):
            can Abort.Panic:
                for row in 0..<table.function_param_owner.count |table, symbol|:
                    continue if row >= table.function_param_declaration_id.count or table.function_param_declaration_id[row].value != symbol.id.value
                    return (true, table.function_param_type_id[row], table.function_param_mutable_ref[row], true) if row < table.function_param_type_id.count and row < table.function_param_mutable_ref.count
                    return (true, table.function_param_type_id[row], false, false) if row < table.function_param_type_id.count
                    return (true, 0, false, false)
                return (false, 0, false, false)

        def callable_symbol_has_parameter_rows(table: SymbolTable&, symbol: Symbol) -> bool:
            can Abort.Panic:
                for declaration_id in table.function_param_declaration_id:
                    return true if declaration_id.value == symbol.id.value
                return false

        def callable_symbol_core_accepts_receiver_arity(table: SymbolTable&, symbol: Symbol, arity: u32) -> bool:
            can Abort.Panic:
                # Core keeps variadic and defaulted declarations in the receiver
                # candidate set, then lets ordinary call checking report bad counts.
                return true if symbol.arity_max == 4294967295
                for row in 0..<table.function_param_declaration_id.count |table, symbol, arity|:
                    continue if table.function_param_declaration_id[row].value != symbol.id.value
                    return true if row < table.function_param_has_default.count and table.function_param_has_default[row]
                return symbol.arity_max == arity

        def callable_try_call_forwards_arguments(annotations: darray[Ast::EnumAnnotation]&, try_offset: u32) -> bool:
            can Abort.Panic:
                return any marker in annotations where marker.owner == "__try_callee_argument_forward" and marker.offset == try_offset

        # Mirror Core's UFCS lookup across the full visible-name candidate set: filter
        # by Core's coarse arity rule, then rank only the first parameter. Later argument
        # compatibility is checked after the selected declaration is known.
        def callable_symbol_type_selected_candidate(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, try_offset: u32, arity: u32, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool) -> DeclId:
            can Abort.Panic:
                invalid: DeclId = DeclId{value: INVALID_DECL_ID_VALUE}
                return invalid if callable_try_call_forwards_arguments(annotations, try_offset)
                return invalid if argument_type_ids.count != arity.usize() or argument_type_ids.count == 0.usize()
                actual_receiver_type_id: u32 = argument_type_ids[0]
                return invalid if not try_overload_type_is_firm_in_module(actual_receiver_type_id, enclosing_module, annotations, table)
                actual_receiver_is_ref: bool = interned_kind(actual_receiver_type_id, table) == SemTypeKind.Ref
                return invalid if actual_receiver_is_ref and not receiver_ref_mutability_known
                return invalid if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for argument in try_named_arguments |try_named_arguments, try_offset|:
                    return invalid if argument.owner == "__try_callee_named_arg" and argument.offset == try_offset
                selected: mutable DeclId = invalid
                best_rank: mutable usize = 0.usize()
                best_count: mutable usize = 0.usize()
                for symbol in table.symbols |selected, best_rank, best_count, table, annotations, try_named_arguments, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, actual_receiver_type_id, actual_receiver_is_ref, receiver_ref_mutable|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    continue if not callable_symbol_core_accepts_receiver_arity(table, symbol, arity)
                    continue if not callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    receiver: (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool) = callable_symbol_receiver_type(table, symbol)
                    continue if not receiver.found and not callable_symbol_has_parameter_rows(table, symbol) and symbol.arity_min == 0 and (symbol.arity_max == 0 or symbol.arity_max == 4294967295)
                    return invalid if not receiver.found or receiver.type_id == 0
                    formal_receiver_is_ref: bool = interned_kind(receiver.type_id, table) == SemTypeKind.Ref
                    receiver_match: (known: bool, matches: bool) = try_overload_receiver_pattern_matches(receiver.type_id, actual_receiver_type_id, symbol.id, enclosing_module, annotations, table, 0)
                    return invalid if not receiver_match.known
                    continue if not receiver_match.matches
                    if actual_receiver_is_ref and not formal_receiver_is_ref and not try_overload_type_is_generic_parameter(receiver.type_id, symbol.id, annotations, table):
                        actual_receiver_base_id: u32 = interned_elem(actual_receiver_type_id, 0, table)
                        actual_receiver_base_kind: SemTypeKind = interned_kind(actual_receiver_base_id, table)
                        # A non-null scalar reference can act as a value receiver in Core;
                        # the TypeId table does not preserve nullability, so leave that set
                        # unresolved. Aggregate by-value candidates cannot match a RefType.
                        return invalid if actual_receiver_base_kind == SemTypeKind.Int or actual_receiver_base_kind == SemTypeKind.Float or actual_receiver_base_kind == SemTypeKind.Bool
                        continue
                    if formal_receiver_is_ref and actual_receiver_is_ref:
                        return invalid if not receiver.mutable_ref_known
                        continue if receiver.mutable_ref and not receiver_ref_mutable
                    formal_base: u32 = interned_elem(receiver.type_id, 0, table) if interned_kind(receiver.type_id, table) == SemTypeKind.Ref and interned_elem_count(receiver.type_id, table) == 1 else receiver.type_id
                    rank: (known: bool, score: usize) = try_overload_receiver_specificity(formal_base, symbol.id, annotations, table, 0)
                    return invalid if not rank.known
                    rank_score: usize = rank.score + 1.usize() if formal_receiver_is_ref and actual_receiver_is_ref and receiver.mutable_ref == receiver_ref_mutable else rank.score
                    if best_count == 0.usize() or rank_score > best_rank:
                        best_rank <- rank_score
                        best_count <- 1.usize()
                        selected <- symbol.id
                    elif rank_score == best_rank:
                        best_count <- best_count + 1.usize()
                return selected if best_count == 1.usize()
                return invalid

        def callable_symbol_accepts_arity(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, module: sview, declaration_offset: u32, declaration_line: u32, try_offset: u32, arity_known: bool, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, enclosing_module: sview, callee_qualifier: sview) -> bool:
            can Abort.Panic:
                return false if callable_try_call_forwards_arguments(annotations, try_offset) and callable_name_has_ufcs_overload_set_candidate(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table)
                return false if callable_overload_has_ambiguous_nominal_receiver_candidate(table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, try_offset, arity, enclosing_module, callee_qualifier)
                exact_found: mutable bool = false
                exact_accepts: mutable bool = false
                unknown_offset_count: mutable usize = 0.usize()
                unknown_offset_accepts: mutable bool = false
                matching_symbol_count: mutable usize = 0.usize()
                selected_type_candidate: DeclId = callable_symbol_type_selected_candidate(table, annotations, try_named_arguments, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable) if arity_known else DeclId{value: INVALID_DECL_ID_VALUE}
                return false if selected_type_candidate.value == INVALID_DECL_ID_VALUE and arity_known and callable_overload_has_inaccessible_arity_candidate(table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, module, declaration_offset, declaration_line, try_offset, arity_known, arity, selected_type_candidate, exact_found, exact_accepts, unknown_offset_count, unknown_offset_accepts, matching_symbol_count|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner != module
                    continue if symbol.line != declaration_line
                    matching_symbol_count <- matching_symbol_count + 1.usize()
                    accepts_call: mutable bool = (not arity_known or callable_symbol_core_accepts_receiver_arity(table, symbol, arity)) and callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    accepts_call <- false if selected_type_candidate.value != INVALID_DECL_ID_VALUE and symbol.id.value != selected_type_candidate.value
                    accepts_call <- false if selected_type_candidate.value != INVALID_DECL_ID_VALUE and symbol.id.value == selected_type_candidate.value and not callable_function_declaration_visible(annotations, name, module, symbol.line, symbol.offset, enclosing_module)
                    if symbol.offset == declaration_offset:
                        exact_found <- true
                        exact_accepts <- accepts_call
                    elif declaration_offset == 0 or symbol.offset == 0:
                        unknown_offset_count <- unknown_offset_count + 1.usize()
                        unknown_offset_accepts <- accepts_call
                return exact_accepts if exact_found
                return unknown_offset_accepts if unknown_offset_count == 1.usize() and matching_symbol_count == 1.usize()
                return false if matching_symbol_count != 0.usize()
                # Missing symbol provenance is inconclusive; preserve the existing lookup
                # and let duplicate visible declarations remain ambiguous.
                return true

        def callable_symbol_arity_candidate_count(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, try_offset: u32, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, enclosing_module: sview, callee_qualifier: sview) -> usize:
            can Abort.Panic:
                return 0.usize() if callable_try_call_forwards_arguments(annotations, try_offset) and callable_name_has_ufcs_overload_set_candidate(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table)
                return 0.usize() if callable_overload_has_ambiguous_nominal_receiver_candidate(table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, try_offset, arity, enclosing_module, callee_qualifier)
                selected_type_candidate: DeclId = callable_symbol_type_selected_candidate(table, annotations, try_named_arguments, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable)
                if selected_type_candidate.value != INVALID_DECL_ID_VALUE:
                    return 0.usize() if selected_type_candidate.value.usize() >= table.symbols.count
                    selected_symbol: Symbol = table.symbols[selected_type_candidate.value.usize()]
                    return 1.usize() if callable_function_declaration_visible(annotations, name, selected_symbol.module_owner, selected_symbol.line, selected_symbol.offset, enclosing_module)
                    return 0.usize()
                return 0.usize() if callable_overload_has_inaccessible_arity_candidate(table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable)
                candidate_count: mutable usize = 0.usize()
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, try_offset, arity, candidate_count, enclosing_module, callee_qualifier|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_visible_for_try_call(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                    if callable_symbol_core_accepts_receiver_arity(table, symbol, arity) and callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset):
                        candidate_count <- candidate_count + 1.usize()
                return candidate_count

        def callable_first_wildcard_imported_row(annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, name: sview, candidate_module: sview, enclosing_module: sview) -> (found: bool, matches: bool):
            can Abort.Panic:
                selected_found: mutable bool = false
                ambiguous_imports: mutable bool = false
                selected_scope_length: mutable usize = enclosing_module.len + 1.usize()
                selected_target: mutable sview = ""
                for binding in annotations |annotations, table, name, candidate_module, enclosing_module, selected_found, ambiguous_imports, selected_scope_length, selected_target|:
                    continue if binding.name != "__binding_wildcard_import" or not try_noncall_module_is_ancestor(binding.module, enclosing_module)
                    if callable_named_visible_declaration_in_module(table, annotations, name, binding.owner, enclosing_module):
                        ambiguous_imports <- true if selected_found and selected_target != binding.owner
                        if binding.module.len < selected_scope_length:
                            selected_found <- true
                            selected_scope_length <- binding.module.len
                            selected_target <- binding.owner
                        selected_found <- true if not selected_found
                        selected_target <- binding.owner if selected_target == ""
                return (true, false) if ambiguous_imports
                return (selected_found, selected_target == candidate_module)

        def callable_wildcard_imported_row_in_scope(annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, name: sview, candidate_module: sview, scope_module: sview) -> bool:
            can Abort.Panic:
                for binding in annotations |annotations, table, name, candidate_module, scope_module|:
                    if binding.name == "__binding_wildcard_import" and binding.owner == candidate_module and binding.module == scope_module:
                        return callable_named_declaration_in_module(table, name, candidate_module)
                return false

        # Core keeps selective imports in a program-level alias map, including imports
        # written inside a different module. The first matching import owns that bare-name
        # candidate; later conflicting imports are already diagnosed by Core.
        def callable_program_selective_import_row(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview) -> bool:
            can Abort.Panic:
                for binding in annotations |annotations, name, candidate_module|:
                    continue if binding.owner != "__from_member" or binding.name != name
                    for source in annotations |annotations, binding, name, candidate_module|:
                        continue if source.owner != "__from_src" or source.module != binding.module or source.line != binding.line or source.offset != binding.offset
                        # Core registers `from M import name` as joinQualifiedName(the
                        # importing namespace, M); module aliases are not expanded here.
                        return candidate_module == source.name if binding.module == ""
                        return callable_module_path_matches_suffix(candidate_module, binding.module, source.name)
                return false

        # Ordinary name lookup skips private import targets. Keep a separate raw
        # predicate above for Core's receiver-ranked overload candidate set, which can
        # select an inaccessible private registration before reporting access failure.
        def callable_program_selective_import_row_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, enclosing_module: sview) -> bool:
            can Abort.Panic:
                for binding in annotations |annotations, name, candidate_module, enclosing_module|:
                    continue if binding.owner != "__from_member" or binding.name != name
                    for source in annotations |annotations, binding, name, candidate_module, enclosing_module|:
                        continue if source.owner != "__from_src" or source.module != binding.module or source.line != binding.line or source.offset != binding.offset
                        path_matches: bool = candidate_module == source.name if binding.module == "" else callable_module_path_matches_suffix(candidate_module, binding.module, source.name)
                        return path_matches and try_error_alias_module_visible(annotations, candidate_module, enclosing_module)
                return false

        # An unresolved static-if import/alias cannot safely select a known candidate
        # that happens to remain after filtering. Decline family inference when that
        # unresolved binding could affect this bare name or qualified alias head.
        def callable_try_static_binding_uncertain(annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                alias_head: mutable sview = callee_qualifier
                for offset in 0..<callee_qualifier.len |alias_head, callee_qualifier|:
                    if offset + 1.usize() < callee_qualifier.len and callee_qualifier[offset] == 58 and callee_qualifier[offset + 1.usize()] == 58:
                        alias_head <- callee_qualifier[0:offset]
                        break
                for unresolved in annotations:
                    continue if unresolved.owner != "__try_unresolved_static_binding"
                    if unresolved.name == "__from_member" and callee_qualifier == "" and unresolved.detail_name == name:
                        return true
                    if unresolved.name == "__binding_wildcard_import" and callee_qualifier == "" and try_noncall_module_is_ancestor(unresolved.module, enclosing_module) and callable_named_declaration_in_module(table, name, unresolved.detail_name):
                        return true
                    return true if unresolved.name == "__using_alias" and callee_qualifier != "" and unresolved.detail_name == alias_head and try_noncall_module_is_ancestor(unresolved.module, enclosing_module)
                return false

        def callable_qualified_module_matches_candidate(annotations: darray[Ast::EnumAnnotation]&, candidate_module: sview, enclosing_module: sview, callee_qualifier: sview) -> bool:
            can Abort.Panic:
                separator: mutable usize = callee_qualifier.len
                for offset in 0..<callee_qualifier.len |separator, callee_qualifier|:
                    if offset + 1.usize() < callee_qualifier.len and callee_qualifier[offset] == 58 and callee_qualifier[offset + 1.usize()] == 58:
                        separator <- offset if separator == callee_qualifier.len
                if separator < callee_qualifier.len:
                    alias_head: sview = callee_qualifier[0:separator]
                    alias_suffix: sview = callee_qualifier[separator + 2.usize():callee_qualifier.len]
                    visible_prefix_alias: (count: usize, target: sview, scope: sview) = callable_using_alias_visible_target(annotations, enclosing_module, alias_head)
                    return visible_prefix_alias.count == 1.usize() and callable_alias_path_matches_candidate(annotations, visible_prefix_alias.scope, visible_prefix_alias.target, alias_suffix, candidate_module) if visible_prefix_alias.count != 0.usize()
                    return candidate_module == callee_qualifier or callable_module_path_matches_suffix(candidate_module, enclosing_module, callee_qualifier)
                visible_alias: (count: usize, target: sview, scope: sview) = callable_using_alias_visible_target(annotations, enclosing_module, callee_qualifier)
                return visible_alias.count == 1.usize() and callable_alias_path_matches_candidate(annotations, visible_alias.scope, visible_alias.target, "", candidate_module) if visible_alias.count != 0.usize()
                return candidate_module == callee_qualifier or module_last_segment(candidate_module) == callee_qualifier

        def callable_row_in_scope_indexed(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                candidate_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, declaration_offset, declaration_line)
                if callee_qualifier != "":
                    return false if not try_error_alias_module_visible(annotations, candidate_module, enclosing_module)
                    return false if not callable_function_declaration_visible(annotations, name, candidate_module, declaration_line, declaration_offset, enclosing_module)
                    return callable_qualified_module_matches_candidate(annotations, candidate_module, enclosing_module, callee_qualifier)
                return false if not callable_function_declaration_visible(annotations, name, candidate_module, declaration_line, declaration_offset, enclosing_module)
                # Core considers every lexical declaration before any wildcard `using`
                # candidate. A nested wildcard must not hide an ancestor's function.
                scope_module: mutable sview = enclosing_module
                while true |scope_module, annotations, name, candidate_module|:
                    if callable_named_visible_declaration_in_module(table, annotations, name, scope_module, enclosing_module):
                        return candidate_module == scope_module
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
                wildcard: (found: bool, matches: bool) = callable_first_wildcard_imported_row(annotations, table, name, candidate_module, enclosing_module)
                return wildcard.matches if wildcard.found
                return callable_program_selective_import_row_visible(annotations, name, candidate_module, enclosing_module)

        # Core's receiver selector searches all visible candidate names once an
        # overload set exists, including a same-named local and imported function.
        def callable_row_in_ufcs_candidate_set_indexed(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, declaration_offset, declaration_line)
                if callee_qualifier != "":
                    return false if not try_error_alias_module_visible(annotations, candidate_module, enclosing_module)
                    return callable_qualified_module_matches_candidate(annotations, candidate_module, enclosing_module, callee_qualifier)
                scope_module: mutable sview = enclosing_module
                while true |scope_module, annotations, name, candidate_module, table|:
                    return true if candidate_module == scope_module and callable_named_declaration_in_module(table, name, scope_module)
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
                # Receiver ranking gathers the overload set after ordinary lexical
                # lookup. Keep the candidate set complete, but apply Core's tier order:
                # every lexical declaration precedes every wildcard import.
                scope_module <- enclosing_module
                while true |scope_module, annotations, name, candidate_module, table|:
                    return true if callable_wildcard_imported_row_in_scope(annotations, table, name, candidate_module, scope_module)
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
                return callable_program_selective_import_row(annotations, name, candidate_module)

        def callable_name_has_ufcs_overload_set_in_scope(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, try_named_arguments: darray[Ast::EnumAnnotation]&, try_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if callable_try_call_forwards_arguments(annotations, try_offset)
                return false if any argument in try_named_arguments where argument.owner == "__try_callee_named_arg" and argument.offset == try_offset
                return callable_name_has_ufcs_overload_set_candidate(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table)

        # Core registers all functions for receiver dispatch by name; count the same
        # visible declaration group independently of whether this call shape is rankable.
        def callable_name_has_ufcs_overload_set_candidate(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    candidate_count: mutable usize = 0.usize()
                    for other in table.symbols |symbol, candidate_count, table|:
                        candidate_count <- candidate_count + 1.usize() if other.kind == SymbolKind.Func and other.name == name and other.module_owner == symbol.module_owner
                    return true if candidate_count >= 2.usize()
                return false

        def callable_overload_declaration_is_inaccessible_arity_candidate(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview, try_offset: u32, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool) -> bool:
            can Abort.Panic:
                return false if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, candidate_module, declaration_offset, declaration_line, enclosing_module, callee_qualifier, try_offset, arity|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner != candidate_module or symbol.line != declaration_line or symbol.offset != declaration_offset
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    coarse_candidate: bool = callable_symbol_core_accepts_receiver_arity(table, symbol, arity) and callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    return false if not coarse_candidate or callable_function_declaration_visible(annotations, name, candidate_module, symbol.line, symbol.offset, enclosing_module)
                    return true if argument_type_ids.count == 0.usize() or argument_type_ids[0] == 0
                    receiver: (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool) = callable_symbol_receiver_type(table, symbol)
                    return true if not receiver.found or receiver.type_id == 0
                    receiver_match: (known: bool, matches: bool) = try_overload_receiver_pattern_matches(receiver.type_id, argument_type_ids[0], symbol.id, enclosing_module, annotations, table, 0)
                    return false if receiver_match.known and not receiver_match.matches
                    if receiver_match.matches:
                        formal_receiver_is_ref: bool = interned_kind(receiver.type_id, table) == SemTypeKind.Ref
                        actual_receiver_is_ref: bool = interned_kind(argument_type_ids[0], table) == SemTypeKind.Ref
                        if actual_receiver_is_ref and not formal_receiver_is_ref and not try_overload_type_is_generic_parameter(receiver.type_id, symbol.id, annotations, table):
                            actual_receiver_base_id: u32 = interned_elem(argument_type_ids[0], 0, table)
                            actual_receiver_base_kind: SemTypeKind = interned_kind(actual_receiver_base_id, table)
                            return true if actual_receiver_base_kind == SemTypeKind.Int or actual_receiver_base_kind == SemTypeKind.Float or actual_receiver_base_kind == SemTypeKind.Bool
                            return false
                        if formal_receiver_is_ref and actual_receiver_is_ref:
                            return true if not receiver.mutable_ref_known or not receiver_ref_mutability_known
                            return false if receiver.mutable_ref and not receiver_ref_mutable
                        return true
                    possible_match: (potential_match: bool, ambiguous: bool) = try_overload_type_shared_ambiguous_match_state(receiver.type_id, argument_type_ids[0], symbol.id, enclosing_module, annotations, table, 0)
                    return possible_match.potential_match
                return false

        def callable_overload_has_inaccessible_arity_candidate(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview, try_offset: u32, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool) -> bool:
            can Abort.Panic:
                return false if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    continue if not callable_symbol_core_accepts_receiver_arity(table, symbol, arity)
                    continue if not callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    return true if callable_overload_declaration_is_inaccessible_arity_candidate(table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, symbol.module_owner, symbol.offset, symbol.line, enclosing_module, callee_qualifier, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable)
                return false

        # An ambiguous TypeId should stop family inference only if receiver ranking is
        # active and an eligible concrete candidate could match that same bare spelling.
        # Singleton calls, named-argument calls, and generic-only sets retain their normal
        # ErrorSet lookup behavior.
        def callable_overload_has_ambiguous_nominal_receiver_candidate(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, try_offset: u32, arity: u32, enclosing_module: sview, callee_qualifier: sview) -> bool:
            can Abort.Panic:
                return false if callable_try_call_forwards_arguments(annotations, try_offset)
                return false if argument_type_ids.count == 0.usize()
                return false if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    continue if not callable_symbol_core_accepts_receiver_arity(table, symbol, arity)
                    receiver: (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool) = callable_symbol_receiver_type(table, symbol)
                    ambiguous_match: (potential_match: bool, ambiguous: bool) = try_overload_type_shared_ambiguous_match_state(receiver.type_id, argument_type_ids[0], symbol.id, enclosing_module, annotations, table, 0) if receiver.found else (false, false)
                    return true if receiver.found and ambiguous_match.potential_match and ambiguous_match.ambiguous
                return false

        # Non-overloaded direct calls use ordinary name precedence. Overloaded calls
        # share Core's wider visible-name candidate set, which includes local and
        # imported declarations together.
        def callable_row_visible_for_try_call(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview, try_named_arguments: darray[Ast::EnumAnnotation]&, try_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, declaration_offset, declaration_line, enclosing_module, callee_qualifier, table) if callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                return callable_row_in_scope_indexed(module_index, module_annotations, annotations, name, declaration_offset, declaration_line, enclosing_module, callee_qualifier, table)

        def callable_error_family(annotations: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview) -> sview:
            fallback: mutable sview = ""
            fallback_found: mutable bool = false
            for source_row in 0..<annotations.count |name, enclosing_module, callee_qualifier, annotations, module_annotations, fallback, fallback_found|:
                scoped_annotation: Ast::EnumAnnotation = annotations[source_row]
                if scoped_annotation.owner == name and callable_error_family_row(annotations, source_row):
                    if not fallback_found:
                        fallback <- scoped_annotation.name
                        fallback_found <- true
                    return scoped_annotation.name if callable_row_in_scope(module_annotations, scoped_annotation.offset, scoped_annotation.line, enclosing_module, callee_qualifier)
            return fallback

        # The module qualifier written at a `try` call site, "" for a bare call.
        def try_callee_qualifier(index: dict[u64, sview]&, try_offset: u32) -> sview:
            can Abort.Panic:
                if index.get(try_offset.u64()) is qualifier:
                    # Re-wrap the stored view by value: the same data and length, so no new
                    # extent is claimed.
                    trusted Unsafe.PointerCast:
                        return StringView{data: qualifier.data, len: qualifier.len}
                return ""

        def try_callee_arity(index: dict[u64, u32]&, try_offset: u32) -> (known: bool, value: u32):
            can Abort.Panic:
                if index.get(try_offset.u64()) is arity:
                    return (true, arity)
                return (false, 0)

        # A declaration line and function offset identify the enclosing callable, while
        # occurrence_offset selects its return error set among callback parameter sets.
        def try_enclosing_return_occurrence(annotations: darray[Ast::EnumAnnotation]&, function_line: u32, function_offset: u32) -> (found: bool, occurrence_offset: u32, identity_id: u32):
            can Abort.Panic:
                occurrence_offset: mutable u32 = 0
                identity_id: mutable u32 = 0
                marker_count: mutable usize = 0.usize()
                for marker in annotations |occurrence_offset, identity_id, marker_count, function_line, function_offset|:
                    continue if marker.name != "__error_return" or marker.line != function_line
                    continue if function_offset != 0 and marker.offset != 0 and marker.offset != function_offset
                    marker_count <- marker_count + 1.usize()
                    occurrence_offset <- marker.occurrence_offset
                    identity_id <- marker.identity_id
                return (marker_count == 1.usize(), occurrence_offset, identity_id)

        # The function enclosing a `try`: by BYTE OFFSET when both sides carry one — lines
        # restart per included file once `#line` directives are spliced, so the largest
        # function line at or before the try's line is not the enclosing function — and by
        # line for producers that recorded no offset (extern callables), as before.
        def enclosing_try_function(table: SymbolTable&, try_line: u32, try_offset: u32) -> (line: u32, offset: u32):
            best_line: mutable u32 = FALLIBLE_FUNCTION_NO_LINE
            best_offset_line: mutable u32 = FALLIBLE_FUNCTION_NO_LINE
            best_offset: mutable u32 = FALLIBLE_FUNCTION_NO_OFFSET
            for symbol in table.symbols |best_line, best_offset_line, best_offset|:
                if symbol.kind == SymbolKind.Func:
                    best_line <- symbol.line if symbol.line <= try_line and symbol.line >= best_line
                    if try_offset != FALLIBLE_FUNCTION_NO_OFFSET and symbol.offset != FALLIBLE_FUNCTION_NO_OFFSET and symbol.offset <= try_offset and symbol.offset >= best_offset:
                        best_offset <- symbol.offset
                        best_offset_line <- symbol.line
            # Named tuples are constructed positionally; `(line: …)` is only the type spelling.
            return (best_offset_line, best_offset) if best_offset != FALLIBLE_FUNCTION_NO_OFFSET
            return (best_line, FALLIBLE_FUNCTION_NO_OFFSET)

        def fallible_function_position_index_build(index: mutable FallibleFunctionPositionIndex&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                positions: mutable darray[FallibleFunctionPosition] = []
                offsets_ordered: mutable bool = true
                saw_previous: mutable bool = false
                previous_offset: mutable u32 = FALLIBLE_FUNCTION_NO_OFFSET
                for symbol in table.symbols |positions, offsets_ordered, saw_previous, previous_offset|:
                    if symbol.kind == SymbolKind.Func and symbol.offset != FALLIBLE_FUNCTION_NO_OFFSET:
                        offsets_ordered <- false if saw_previous and symbol.offset < previous_offset
                        positions <- positions.push(FallibleFunctionPosition{offset: symbol.offset, line: symbol.line})
                        previous_offset <- symbol.offset
                        saw_previous <- true
                index.positions <- positions
                index.offsets_ordered <- offsets_ordered
                index.ready <- true

        def enclosing_try_function_indexed(index: mutable FallibleFunctionPositionIndex&, table: SymbolTable&, try_line: u32, try_offset: u32) -> (line: u32, offset: u32):
            can Memory.Allocate, Abort.Panic:
                if not index.ready:
                    fallible_function_position_index_build(index, table)
                if try_offset != FALLIBLE_FUNCTION_NO_OFFSET and index.offsets_ordered:
                    low: mutable usize = FALLIBLE_FUNCTION_FIRST_POSITION
                    high: mutable usize = index.positions.count
                    while low < high |low, high, index, try_offset|:
                        middle: usize = low + (high - low) / FALLIBLE_FUNCTION_SEARCH_DIVISOR
                        if index.positions[middle].offset <= try_offset:
                            low <- middle + FALLIBLE_FUNCTION_POSITION_STEP
                        else:
                            high <- middle
                    if low > FALLIBLE_FUNCTION_FIRST_POSITION:
                        position: FallibleFunctionPosition = index.positions[low - FALLIBLE_FUNCTION_POSITION_STEP]
                        return (position.line, position.offset)
                return enclosing_try_function(table, try_line, try_offset)

        def try_error_family_refs_match(source: TryErrorFamilyRef, destination: TryErrorFamilyRef) -> bool:
            can Abort.Panic:
                return false if source.family != destination.family
                return source.module == destination.module if source.module_known and destination.module_known
                return false if source.declaration_line != 0 and destination.declaration_line != 0
                return true

        # Return whether VARIANT is allowed by this declaration's captured return-set
        # occurrence. Callback parameters and adjacent members of a composite return share
        # the declaration position, so match the full family/path row key. Repeated family
        # rows in one occurrence are unioned: each matching row contributes its subset, and
        # any unrestricted row contributes the full family.
        def try_error_family_subset_status(annotations: darray[Ast::EnumAnnotation]&, family: TryErrorFamilyRef, variant: sview) -> (known: bool, restricted: bool, allowed: bool):
            can Abort.Panic:
                return (false, false, false) if family.declaration_line == 0 or family.family_path == ""
                if family.variant_override != "":
                    matching_rows: mutable usize = 0.usize()
                    for candidate_index in 0..<annotations.count |matching_rows, annotations, family|:
                        candidate: Ast::EnumAnnotation = annotations[candidate_index]
                        continue if candidate.owner != "__error_set_family" or candidate.name != family.source_name or candidate.line != family.declaration_line or candidate.offset != family.declaration_offset or candidate.identity_id != family.declaration_identity_id or candidate.occurrence_offset != family.occurrence_offset
                        continue if candidate_index + 1.usize() >= annotations.count
                        candidate_path: Ast::EnumAnnotation = annotations[candidate_index + 1.usize()]
                        continue if candidate_path.owner != "__error_set_family_path" or candidate_path.name != family.family_path or candidate_path.line != candidate.line or candidate_path.offset != candidate.offset or candidate_path.identity_id != candidate.identity_id or candidate_path.occurrence_offset != candidate.occurrence_offset
                        matching_rows <- matching_rows + 1.usize()
                    return (false, false, false) if matching_rows == 0.usize()
                    return (true, true, variant == family.variant_override)
                family_count: mutable usize = 0.usize()
                saw_restricted: mutable bool = false
                saw_unrestricted: mutable bool = false
                allowed: mutable bool = false
                valid: mutable bool = true
                for candidate_index in 0..<annotations.count |family_count, saw_restricted, saw_unrestricted, allowed, valid, annotations, family, variant|:
                    candidate: Ast::EnumAnnotation = annotations[candidate_index]
                    continue if candidate.owner != "__error_set_family" or candidate.name != family.source_name or candidate.line != family.declaration_line or candidate.offset != family.declaration_offset or candidate.identity_id != family.declaration_identity_id or candidate.occurrence_offset != family.occurrence_offset
                    continue if candidate_index + 1.usize() >= annotations.count
                    candidate_path: Ast::EnumAnnotation = annotations[candidate_index + 1.usize()]
                    continue if candidate_path.owner != "__error_set_family_path" or candidate_path.name != family.family_path or candidate_path.line != candidate.line or candidate_path.offset != candidate.offset or candidate_path.identity_id != candidate.identity_id or candidate_path.occurrence_offset != candidate.occurrence_offset
                    family_count <- family_count + 1.usize()
                    family_row: Ast::EnumAnnotation = candidate
                    candidate_restricted: mutable bool = false
                    row_index: mutable usize = candidate_index + 2.usize()
                    while row_index < annotations.count |row_index, annotations, family, variant, family_row, candidate_restricted, saw_restricted, allowed, valid|:
                        row: Ast::EnumAnnotation = annotations[row_index]
                        break if row.owner == "__error_set_family"
                        if row.owner == "__error_variant_family":
                            saw_restricted <- true
                            candidate_restricted <- true
                            marker_matches: bool = row.name == family.source_name and row.line == family_row.line and row.offset == family_row.offset and row.identity_id == family_row.identity_id and row.occurrence_offset == family_row.occurrence_offset
                            valid <- false if not marker_matches
                            if marker_matches and row_index + 1.usize() < annotations.count:
                                allow: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                                if allow.owner == "__error_variant_allow":
                                    allow_matches: bool = allow.line == row.line and allow.offset == row.offset and allow.identity_id == row.identity_id and allow.occurrence_offset == row.occurrence_offset
                                    valid <- false if not allow_matches
                                    allowed <- true if allow_matches and allow.name == variant
                                    row_index <- row_index + 1.usize() if allow_matches
                        elif row.owner == "__error_variant_allow":
                            valid <- false
                        row_index <- row_index + 1.usize()
                    saw_unrestricted <- true if not candidate_restricted
                return (false, false, false) if family_count == 0.usize() or not valid
                return (true, saw_restricted and not saw_unrestricted, saw_unrestricted or allowed)

        # `Fault{}` is rejected by check_empty_error_set_subset. A marker without a
        # matching allow row is malformed subset metadata, not a valid zero-tag family.
        # Detect it so Try does not add a second propagation error for the same shape.
        def try_error_family_has_empty_subset(annotations: darray[Ast::EnumAnnotation]&, family: TryErrorFamilyRef) -> bool:
            can Abort.Panic:
                return false if family.declaration_line == 0 or family.family_path == "" or family.variant_override != ""
                for family_index in 0..<annotations.count |annotations, family|:
                    family_row: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_row.owner != "__error_set_family" or family_row.name != family.source_name or family_row.line != family.declaration_line or family_row.offset != family.declaration_offset or family_row.identity_id != family.declaration_identity_id or family_row.occurrence_offset != family.occurrence_offset
                    continue if family_index + 2.usize() >= annotations.count
                    path_row: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if path_row.owner != "__error_set_family_path" or path_row.name != family.family_path or path_row.line != family_row.line or path_row.offset != family_row.offset or path_row.identity_id != family_row.identity_id or path_row.occurrence_offset != family_row.occurrence_offset
                    row_index: mutable usize = family_index + 2.usize()
                    while row_index < annotations.count |row_index, annotations, family, family_row|:
                        row: Ast::EnumAnnotation = annotations[row_index]
                        break if row.owner == "__error_set_family"
                        if row.owner == "__error_variant_family" and row.name == family.source_name and row.line == family_row.line and row.offset == family_row.offset and row.identity_id == family_row.identity_id and row.occurrence_offset == family_row.occurrence_offset:
                            has_matching_allow: mutable bool = false
                            if row_index + 1.usize() < annotations.count:
                                allow: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                                has_matching_allow <- allow.owner == "__error_variant_allow" and allow.line == row.line and allow.offset == row.offset and allow.identity_id == row.identity_id and allow.occurrence_offset == row.occurrence_offset
                            return true if not has_matching_allow
                            row_index <- row_index + 1.usize()
                        row_index <- row_index + 1.usize()
                return false

        def error_family_covers(annotations: darray[Ast::EnumAnnotation]&, source: TryErrorFamilyRef, destination: TryErrorFamilyRef, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if source.family == "" or destination.family == ""
                return true if try_error_family_has_empty_subset(annotations, source)
                # A malformed destination set cannot justify a second Try coverage
                # diagnostic, even when its family differs from the source's family.
                return true if try_error_family_has_empty_subset(annotations, destination)
                if source.module_known and destination.module_known:
                    saw_source_family_tag: mutable bool = false
                    for variant_index in 0..<table.enum_variant_owner.count |saw_source_family_tag, source, destination, annotations, table|:
                        belongs_to_source: bool = table.enum_variant_owner[variant_index] == source.family and variant_index < table.enum_variant_module.count and table.enum_variant_module[variant_index] == source.module
                        if belongs_to_source:
                            saw_source_family_tag <- true
                            source_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, source, table.enum_variant_name[variant_index])
                            return false if not source_subset.known
                            if source_subset.allowed:
                                destination_has_tag: mutable bool = false
                                for destination_index in 0..<table.enum_variant_owner.count |destination_has_tag, source, destination, annotations, table, variant_index|:
                                    belongs_to_destination: bool = table.enum_variant_owner[destination_index] == destination.family and destination_index < table.enum_variant_module.count and table.enum_variant_module[destination_index] == destination.module
                                    if belongs_to_destination and table.enum_variant_name[destination_index] == table.enum_variant_name[variant_index]:
                                        destination_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, destination, table.enum_variant_name[destination_index])
                                        return false if not destination_subset.known
                                        destination_has_tag <- true if destination_subset.allowed
                                return false if not destination_has_tag
                    return saw_source_family_tag
                return false if not try_error_family_refs_match(source, destination)
                source_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, source, "") if source.declaration_line != 0 else (true, false, true)
                destination_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, destination, "") if destination.declaration_line != 0 else (true, false, true)
                return false if not source_subset.known or source_subset.restricted
                return false if not destination_subset.known or destination_subset.restricted
                return true

        # ErrorSetAssignable matches a source tag against the whole destination union:
        # an exact family/module/tag wins, otherwise its short tag must identify exactly
        # one allowed destination tag. Checking each destination family independently and
        # accepting `any` misses ambiguity when two destination families share that tag.
        def error_family_covers_destinations(annotations: darray[Ast::EnumAnnotation]&, source: TryErrorFamilyRef, destinations: darray[TryErrorFamilyRef]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if source.family == "" or try_error_family_has_empty_subset(annotations, source)
                all_modules_known: mutable bool = true
                for destination in destinations |all_modules_known, annotations, source|:
                    return true if destination.family == "" or try_error_family_has_empty_subset(annotations, destination)
                    all_modules_known <- false if not destination.module_known
                if source.module_known and all_modules_known:
                    saw_source_family_tag: mutable bool = false
                    for source_index in 0..<table.enum_variant_owner.count |saw_source_family_tag, annotations, source, destinations, table|:
                        continue if source_index >= table.enum_variant_name.count or source_index >= table.enum_variant_module.count
                        continue if table.enum_variant_owner[source_index] != source.family or table.enum_variant_module[source_index] != source.module
                        saw_source_family_tag <- true
                        source_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, source, table.enum_variant_name[source_index])
                        return false if not source_subset.known
                        continue if not source_subset.allowed
                        exact_destination_match: mutable bool = false
                        short_destination_matches: mutable usize = 0.usize()
                        for candidate_index in 0..<table.enum_variant_owner.count |exact_destination_match, short_destination_matches, annotations, source, destinations, table, source_index|:
                            continue if candidate_index >= table.enum_variant_name.count or candidate_index >= table.enum_variant_module.count
                            duplicate_tag: mutable bool = false
                            for prior_index in 0..<candidate_index |duplicate_tag, table, candidate_index|:
                                continue if prior_index >= table.enum_variant_name.count or prior_index >= table.enum_variant_module.count
                                duplicate_tag <- true if table.enum_variant_owner[prior_index] == table.enum_variant_owner[candidate_index] and table.enum_variant_module[prior_index] == table.enum_variant_module[candidate_index] and table.enum_variant_name[prior_index] == table.enum_variant_name[candidate_index]
                            continue if duplicate_tag
                            tag_allowed: mutable bool = false
                            for destination in destinations |tag_allowed, annotations, table, candidate_index|:
                                continue if destination.family != table.enum_variant_owner[candidate_index] or destination.module != table.enum_variant_module[candidate_index]
                                destination_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, destination, table.enum_variant_name[candidate_index])
                                return false if not destination_subset.known
                                tag_allowed <- true if destination_subset.allowed
                            continue if not tag_allowed or table.enum_variant_name[candidate_index] != table.enum_variant_name[source_index]
                            short_destination_matches <- short_destination_matches + 1.usize()
                            exact_destination_match <- true if table.enum_variant_owner[candidate_index] == source.family and table.enum_variant_module[candidate_index] == source.module
                        return false if not exact_destination_match and short_destination_matches != 1.usize()
                    return saw_source_family_tag
                for destination in destinations |annotations, source, table|:
                    return true if error_family_covers(annotations, source, destination, table)
                return false

        def check_try_propagation_row(annotation: Ast::EnumAnnotation&, enclosing: (line: u32, offset: u32), enclosing_module: sview, callee_qualifier: sview, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, error_set_annotations: darray[Ast::EnumAnnotation]&, error_set_family_paths: darray[Ast::EnumAnnotation]&, error_set_index: mutable TryErrorSetIndex&, propagation_site_count: usize, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable, call_arity_known: bool, call_arity: u32, first_class_error_family: sview @source = "", lambda_error_family: sview @source = "", inside_lambda: bool = false) -> void:
            can Memory.Allocate, Abort.Panic, Global.Read:
                return if first_class_error_family == "" and annotation.owner != "__noncall" and callable_try_static_binding_uncertain(annotations, annotation.owner, enclosing_module, callee_qualifier, table)
                scope_known: bool = enclosing.line != 0 or enclosing.offset != 0 or enclosing_module != "" or callee_qualifier != ""
                sources: mutable darray[TryErrorFamilyRef] = []
                source_ambiguous: mutable bool = false
                if first_class_error_family != "":
                    sources.push(TryErrorFamilyRef{family: first_class_error_family, module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: 0, declaration_identity_id: 0, occurrence_offset: 0})
                else:
                    selected_sources: (families: darray[TryErrorFamilyRef], ambiguous: bool) = callable_error_indexed_family_refs(error_index, annotations, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, module_index, module_annotations, annotation.owner, enclosing_module, callee_qualifier, scope_known, annotation.offset, call_arity_known, call_arity, table)
                    sources <- selected_sources.families
                    source_ambiguous <- selected_sources.ambiguous
                    if sources.count == 0 and not source_ambiguous:
                        fallback_source: TryErrorFamilyRef = callable_error_indexed_family_ref(error_index, annotations, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, module_index, module_annotations, annotation.owner, enclosing_module, callee_qualifier, scope_known, annotation.offset, call_arity_known, call_arity, table)
                        sources.push(fallback_source) if fallback_source.family != ""
                return if sources.count == 0
                function_line: u32 = enclosing.line
                enclosing_return: (found: bool, occurrence_offset: u32, identity_id: u32) = try_enclosing_return_occurrence(annotations, function_line, enclosing.offset)
                destinations: mutable darray[TryErrorFamilyRef] = []
                if inside_lambda:
                    destinations.push(TryErrorFamilyRef{family: lambda_error_family, module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: 0, declaration_identity_id: 0, occurrence_offset: 0}) if lambda_error_family != ""
                else:
                    if propagation_site_count > 1 and propagation_site_count * error_set_annotations.count > TRY_ERROR_SET_INDEX_MIN_WORK:
                        try_error_set_index_build(error_set_index, error_set_annotations) can Global{Read,Write}
                        can Global.Read:
                            destination_indices: mutable darray[usize] = []
                            destination_indices <- try_error_set_destinations(error_set_index, error_set_annotations, enclosing.offset, function_line, enclosing_return.identity_id, enclosing_return.occurrence_offset) if enclosing_return.found
                            caller_module: sview = fallible_fn_module_indexed(module_index, module_annotations, enclosing.offset, function_line)
                            caller_module_known: bool = fallible_fn_module_known(module_annotations, enclosing.offset, function_line)
                            for destination_index in destination_indices |destinations, annotations, error_set_annotations, error_set_family_paths, caller_module, caller_module_known, table|:
                                family_annotation: Ast::EnumAnnotation = error_set_annotations[destination_index]
                                family_path: mutable sview @source = ""
                                if destination_index < error_set_family_paths.count:
                                    path_annotation: Ast::EnumAnnotation = error_set_family_paths[destination_index]
                                    family_path <- path_annotation.name if path_annotation.line == family_annotation.line and path_annotation.offset == family_annotation.offset and path_annotation.identity_id == family_annotation.identity_id and path_annotation.occurrence_offset == family_annotation.occurrence_offset
                                destinations.push(try_error_family_ref_for_annotation(annotations, family_annotation, family_path, caller_module_known, caller_module, table))
                    else:
                        caller_module: sview = fallible_fn_module_indexed(module_index, module_annotations, enclosing.offset, function_line)
                        caller_module_known: bool = fallible_fn_module_known(module_annotations, enclosing.offset, function_line)
                        for destination_index in 0..<error_set_annotations.count |destinations, annotations, error_set_annotations, error_set_family_paths, enclosing, function_line, enclosing_return, caller_module, caller_module_known, table|:
                            family_annotation: Ast::EnumAnnotation = error_set_annotations[destination_index]
                            continue if family_annotation.owner != "__error_set_family"
                            continue if not (family_annotation.offset == enclosing.offset if enclosing.offset != 0 and family_annotation.offset != 0 else family_annotation.line == function_line)
                            continue if not enclosing_return.found or family_annotation.occurrence_offset != enclosing_return.occurrence_offset
                            continue if enclosing_return.identity_id != 0 and family_annotation.identity_id != enclosing_return.identity_id
                            family_path: mutable sview @source = ""
                            if destination_index < error_set_family_paths.count:
                                path_annotation: Ast::EnumAnnotation = error_set_family_paths[destination_index]
                                family_path <- path_annotation.name if path_annotation.line == family_annotation.line and path_annotation.offset == family_annotation.offset and path_annotation.identity_id == family_annotation.identity_id and path_annotation.occurrence_offset == family_annotation.occurrence_offset
                            destinations.push(try_error_family_ref_for_annotation(annotations, family_annotation, family_path, caller_module_known, caller_module, table))
                # A fallible callee (`source != ""`) whose enclosing function declares NO error set
                # cannot propagate the `try` — stage0 requires the current function to return an
                # error union. (A function WITH an error set proceeds to the set-coverage check.)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryWithoutElseNonErrorFunction, name: "", line: annotation.line, expected: "", actual: ""}) if destinations.count == 0 and function_line != 0
                return if destinations.count == 0
                uncovered_source: mutable TryErrorFamilyRef = TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: 0, declaration_identity_id: 0, occurrence_offset: 0}
                for source in sources |uncovered_source, destinations, annotations, table|:
                    source_covered: bool = error_family_covers_destinations(annotations, source, destinations, table)
                    if not source_covered:
                        uncovered_source <- source
                        break
                return if uncovered_source.family == ""
                first: mutable sview @source = destinations[0].family
                second: mutable sview @source = ""
                second <- destinations[1].family if destinations.count > 1
                swap: bool = second != "" and error_family_symbol_position(table, second) < error_family_symbol_position(table, first)
                first, second <- second, first if swap
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryPropagationMismatch, name: uncovered_source.family, pos: annotation.pos, line: annotation.line, expected: first, actual: "", detail: second})

        # The compact AST erases the `try` head and records `__noncall` when its operand
        # is not a Call. Recover the narrow `try parameter` form from the function body and
        # the parser's `__param_error_union` metadata. A parameter marker is line-keyed, so
        # accept it only when every parameter on that source line is marked; otherwise the
        # parser metadata cannot unambiguously associate the errorset with a parameter.
        def try_noncall_parameter_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_parameter_name(inner)
                    _:
                        return ""

        def try_noncall_record_expression(expression: Ast::Expr, annotation: Ast::EnumAnnotation, nearest_offset: mutable u32&, nearest_name: mutable sview& @source) -> void:
            can Abort.Panic:
                position: Ast::Pos = Ast::expr_pos(expression)
                if position.line == annotation.line and position.offset > annotation.offset and nearest_offset == 4294967295:
                    nearest_offset <- position.offset
                    nearest_name <- try_noncall_parameter_name(expression)
                    # The first AST expression beginning after the erased try token is
                    # its operand root. Descending from a binary/member root and choosing
                    # the first identifier would incorrectly borrow that child's family.
                    return
                # The parser erases the `try` wrapper and records its token offset separately.
                # When `try value` is nested as a call argument, the statement's Call node
                # starts before the annotation, so search its children for the closest node
                # that begins after the token.
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        try_noncall_record_expression(callee, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        for candidate in candidates |annotation, nearest_offset, nearest_name|:
                            for capture in candidate.captures |annotation, nearest_offset, nearest_name|:
                                try_noncall_record_expression(capture, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.Binary(left, _, right, _):
                        try_noncall_record_expression(left, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(right, annotation, nearest_offset, nearest_name)
                    Expr.Paren(inner, _):
                        try_noncall_record_expression(inner, annotation, nearest_offset, nearest_name)
                    Expr.Field(object, _, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                    Expr.Scope(base, _, _):
                        try_noncall_record_expression(base, annotation, nearest_offset, nearest_name)
                    Expr.Index(object, index, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(index, annotation, nearest_offset, nearest_name)
                    Expr.IndexN(object, arguments, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.Slice(object, low, high, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(low, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(high, annotation, nearest_offset, nearest_name)
                    Expr.Unary(_, operand, _):
                        try_noncall_record_expression(operand, annotation, nearest_offset, nearest_name)
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        try_noncall_record_expression(operand, annotation, nearest_offset, nearest_name)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(element, annotation, nearest_offset, nearest_name)
                    Expr.DictLit(entries, _):
                        for entry in entries |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(entry.key, annotation, nearest_offset, nearest_name)
                            try_noncall_record_expression(entry.value, annotation, nearest_offset, nearest_name)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        try_noncall_record_expression(type_expression, annotation, nearest_offset, nearest_name)
                        for field in fields |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(field.value, annotation, nearest_offset, nearest_name)
                    Expr.If(condition, then_value, else_value, _):
                        try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(then_value, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(else_value, annotation, nearest_offset, nearest_name)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        try_noncall_record_expression(scrutinee, annotation, nearest_offset, nearest_name)
                        for arm in arms |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(arm.guard, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(arm.body, annotation, nearest_offset, nearest_name)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        try_noncall_record_expression(iterable, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(body, annotation, nearest_offset, nearest_name)
                    Expr.Refinement(base, predicate, _):
                        try_noncall_record_expression(base, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(predicate, annotation, nearest_offset, nearest_name)
                    Expr.GetElse(guarded, recovery, _):
                        try_noncall_record_expression(guarded, annotation, nearest_offset, nearest_name)
                        try_noncall_record_statements(recovery, annotation, nearest_offset, nearest_name)
                    Expr.Block(block_statements, value, _, _):
                        try_noncall_record_statements(block_statements, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                    Expr.Lambda(_, lambda_body, _):
                        try_noncall_record_statements(lambda_body, annotation, nearest_offset, nearest_name)
                    _:
                        pass

        def try_noncall_record_statements(statements: darray[Ast::Stmt], annotation: Ast::EnumAnnotation, nearest_offset: mutable u32&, nearest_name: mutable sview& @source) -> void:
            can Abort.Panic:
                for statement in statements |annotation, nearest_offset, nearest_name|:
                    match statement:
                        Stmt.Expr(expression, _):
                            try_noncall_record_expression(expression, annotation, nearest_offset, nearest_name)
                        Stmt.Assign(target, _, value, _):
                            try_noncall_record_expression(target, annotation, nearest_offset, nearest_name)
                            try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                        Stmt.VarDecl(_, _, value, _):
                            try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                        Stmt.Return(value, _):
                            if value is returned:
                                try_noncall_record_expression(returned, annotation, nearest_offset, nearest_name)
                        Stmt.If(condition, then_body, else_body, _):
                            try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(then_body, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(else_body, annotation, nearest_offset, nearest_name)
                        Stmt.While(condition, body, _):
                            try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.For(_, _, iterable, body, _):
                            try_noncall_record_expression(iterable, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.Block(_, _, _, body, _):
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.Match(scrutinee, arms, _):
                            try_noncall_record_expression(scrutinee, annotation, nearest_offset, nearest_name)
                            for arm in arms |annotation, nearest_offset, nearest_name|:
                                try_noncall_record_expression(arm.guard, annotation, nearest_offset, nearest_name)
                                try_noncall_record_statements(arm.body, annotation, nearest_offset, nearest_name)
                        Stmt.Contract(_, expression, _):
                            try_noncall_record_expression(expression, annotation, nearest_offset, nearest_name)
                        _:
                            pass

        def try_parameter_error_family(params: darray[Ast::ParamDecl], parameter_name: sview @source, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source):
            can Abort.Panic:
                parameter_line: mutable u32 = 0
                parameter_offset: mutable u32 = 0
                for parameter in params |parameter_line, parameter_name|:
                    if parameter.name == parameter_name:
                        parameter_line <- parameter.name_pos.line
                        parameter_offset <- parameter.name_pos.offset
                return (false, "") if parameter_line == 0
                if parameter_offset != 0:
                    invalid_exact: bool = any annotation in annotations where annotation.owner == "__param_error_union_invalid" and annotation.offset == parameter_offset
                    return (false, "") if invalid_exact
                    exact_family: mutable sview @source = ""
                    exact_count: mutable usize = 0
                    for annotation in annotations |exact_family, exact_count, parameter_offset|:
                        if annotation.owner == "__param_error_union" and annotation.offset == parameter_offset:
                            exact_family <- annotation.name if exact_count == 0
                            exact_count <- exact_count + 1.usize()
                    return (true, exact_family) if exact_count == 1
                    return (false, "") if exact_count > 1
                    # A legacy parser row can carry only its line, not the parameter's
                    # identifier offset. Let the line-based path below recover it only
                    # when it can pair every row with one parameter unambiguously.
                invalid_line: bool = any annotation in annotations where annotation.owner == "__param_error_union_invalid" and annotation.line == parameter_line
                return (false, "") if invalid_line
                params_on_line: mutable usize = 0
                for parameter in params |params_on_line, parameter_line|:
                    params_on_line <- params_on_line + 1.usize() if parameter.name_pos.line == parameter_line
                family: mutable sview @source = ""
                family_count: mutable usize = 0
                conflicting_families: mutable bool = false
                for annotation in annotations |family, family_count, conflicting_families, parameter_line|:
                    if annotation.owner == "__param_error_union" and annotation.line == parameter_line:
                        family <- annotation.name if family_count == 0
                        conflicting_families <- true if annotation.name != family
                        family_count <- family_count + 1.usize()
                return (true, "") if family_count == 0
                return (false, "") if family_count != params_on_line or conflicting_families
                return (true, family)

        def try_noncall_rebind_claimed_target(annotations: darray[Ast::EnumAnnotation]&, line: u32, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__lmut_rebind_claim" and annotation.line == line and annotation.name == name

        def try_noncall_pattern_shadows_name(pattern: Ast::Pattern, candidate: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                binders: mutable darray[sview @source] = []
                gather_arm_pattern(pattern, binders)
                return any binder in binders where binder == candidate

        def try_noncall_gather_catch_arm_pattern(pattern: Ast::Pattern, arm_index: usize, binders: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                # After the success arm, a bare pattern name is a fieldless error variant,
                # not a local binder. Nested variant fields still introduce real binders.
                if arm_index != 0.usize():
                    return if pattern is Pattern.Binding(_)
                    if pattern is Pattern.Or(options):
                        return if options.count == 0
                        first_binders: mutable darray[sview @source] = []
                        gather_arm_pattern(options[0], first_binders) if not (options[0] is Pattern.Binding(_))
                        for binder in first_binders:
                            present_in_every_option: mutable bool = true
                            for option in 1..<options.count:
                                option_binders: mutable darray[sview @source] = []
                                gather_arm_pattern(options[option], option_binders) if not (options[option] is Pattern.Binding(_))
                                present_in_every_option <- false if not any option_binder in option_binders where option_binder == binder
                            binders.push(binder) if present_in_every_option and not any existing in binders where existing == binder
                        return
                gather_arm_pattern(pattern, binders)

        def try_noncall_catch_pattern_shadows_name(pattern: Ast::Pattern, arm_index: usize, candidate: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                binders: mutable darray[sview @source] = []
                try_noncall_gather_catch_arm_pattern(pattern, arm_index, binders)
                return any binder in binders where binder == candidate

        # A deliberately narrow type projection for bindings whose scalar type is
        # explicit in the pattern or recoverable from a typed sequence parameter. The
        # non-call try scan must not keep an outer error family after a pattern shadows
        # that name, but it should still recognize `try` on a known primitive as invalid.
        def try_noncall_type_name_facts(type_name: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                numeric: bool = type_name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64", "char"}
                integer: bool = type_name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr"}
                known_nonfallible: bool = numeric or type_name in {"bool", "string", "cstr", "dstr", "sview"}
                return (known_nonfallible, numeric, integer)

        # The source scan resolves lexically unique aliases whose target is a primitive
        # scalar name or a chain of aliases visible from the current module, optionally
        # under transparent paren or mutability/storage wrappers. Qualified, generic,
        # duplicate, and cyclic aliases stay unknown rather than borrowing another module's
        # spelling.
        def try_noncall_declared_type_facts(type_expression: Ast::Expr) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return try_noncall_type_name_facts(name)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_declared_type_facts(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_declared_type_facts(inner)
                    _:
                        return (false, false, false)

        def try_noncall_declared_type_alias_target(type_expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_declared_type_alias_target(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_declared_type_alias_target(inner)
                    _:
                        return ""

        def try_noncall_type_alias_facts_add(declarations: darray[Ast::Decl], environment: mutable TryNonCallErrorFamilyEnv&, current_module: sview, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |environment, current_module, table|:
                    match declaration:
                        Decl.Alias(alias_name, target, _) if target is not Expr.Invalid:
                            target_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_declared_type_facts(target)
                            environment.type_alias_names.push(alias_name)
                            environment.type_alias_modules.push(current_module)
                            environment.type_alias_target_names.push(try_noncall_declared_type_alias_target(target))
                            environment.type_alias_known_nonfallible.push(target_facts.known_nonfallible)
                            environment.type_alias_numeric.push(target_facts.numeric)
                            environment.type_alias_integer.push(target_facts.integer)
                        Decl.Struct(type_name, _, _, _, _, _, _):
                            environment.non_alias_type_names.push(type_name)
                            environment.non_alias_type_modules.push(current_module)
                        Decl.Enum(type_name, _, _, _, _):
                            environment.non_alias_type_names.push(type_name)
                            environment.non_alias_type_modules.push(current_module)
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = try_noncall_module_path(current_module, module_name, table)
                            try_noncall_type_alias_facts_add(module_body, environment, nested_module, table)
                        Decl.Scoped(scoped_body, _):
                            try_noncall_type_alias_facts_add(scoped_body, environment, current_module, table)
                        _:
                            pass

        def try_noncall_type_alias_facts(alias_name: sview, environment: TryNonCallErrorFamilyEnv&, depth: u32, lookup_module: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                return (false, false, false) if depth > 64
                match_count: mutable usize = 0
                alias_index: mutable usize = 0
                scope_module: mutable sview = lookup_module
                scope_found: mutable bool = false
                while not scope_found |match_count, alias_index, scope_module, scope_found, environment, alias_name|:
                    local_type_shadows_name: mutable bool = false
                    for index in 0..<environment.non_alias_type_names.count |local_type_shadows_name, environment, alias_name, scope_module|:
                        local_type_shadows_name <- true if environment.non_alias_type_names[index] == alias_name and environment.non_alias_type_modules[index] == scope_module
                    return (false, false, false) if local_type_shadows_name
                    for index in 0..<environment.type_alias_names.count |match_count, alias_index, environment, alias_name, scope_module|:
                        if environment.type_alias_names[index] == alias_name and environment.type_alias_modules[index] == scope_module:
                            match_count <- match_count + 1.usize()
                            alias_index <- index
                    scope_found <- match_count > 0.usize()
                    if not scope_found:
                        if scope_module == "":
                            scope_found <- true
                        else:
                            scope_module <- try_noncall_module_parent(scope_module)
                return (false, false, false) if match_count != 1.usize()
                alias_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = (environment.type_alias_known_nonfallible[alias_index], environment.type_alias_numeric[alias_index], environment.type_alias_integer[alias_index])
                return alias_facts if alias_facts.known_nonfallible or alias_facts.numeric or alias_facts.integer
                target_name: sview = environment.type_alias_target_names[alias_index] if alias_index < environment.type_alias_target_names.count else ""
                return try_noncall_type_alias_facts(target_name, environment, depth + 1, environment.type_alias_modules[alias_index]) if target_name != ""
                return alias_facts

        def try_noncall_type_facts_with_aliases_at(type_expression: Ast::Expr, environment: TryNonCallErrorFamilyEnv&, lookup_module: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                direct_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_declared_type_facts(type_expression)
                return direct_facts if direct_facts.known_nonfallible
                match type_expression:
                    Expr.Ident(alias_name, _):
                        return try_noncall_type_alias_facts(alias_name, environment, 0, lookup_module)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_type_facts_with_aliases_at(inner, environment, lookup_module)
                    Expr.Paren(inner, _):
                        return try_noncall_type_facts_with_aliases_at(inner, environment, lookup_module)
                    _:
                        pass
                return (false, false, false)

        def try_noncall_type_facts_with_aliases(type_expression: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                return try_noncall_type_facts_with_aliases_at(type_expression, environment, environment.current_module)

        def try_noncall_function_return_is_generic(annotations: darray[Ast::EnumAnnotation]&, type_expression: Ast::Expr, function_position: Ast::Pos, current_module: sview @source) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, _):
                        for annotation in annotations |type_name, function_position, current_module|:
                            return true if annotation.owner == type_name and annotation.name == "__generic_param_identity" and annotation.detail_line == function_position.line and annotation.offset == function_position.offset and annotation.module == current_module
                    _:
                        pass
                return false

        def try_noncall_generic_return_formal(params: darray[Ast::ParamDecl] @source, type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, function_position: Ast::Pos, current_module: sview @source) -> (name: sview @source, index: usize):
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(return_name, _) if try_noncall_function_return_is_generic(annotations, type_expression, function_position, current_module):
                        match_count: mutable usize = 0
                        formal_name: mutable sview @source = ""
                        formal_index: mutable usize = 0
                        for index in 0..<params.count |match_count, formal_name, formal_index, params, return_name|:
                            if params[index].type_expression is Expr.Ident(parameter_type, _) and parameter_type == return_name:
                                match_count <- match_count + 1.usize()
                                formal_name <- params[index].name
                                formal_index <- index
                        return (formal_name, formal_index) if match_count == 1.usize()
                    _:
                        pass
                return ("", 0.usize())

        def try_noncall_callable_facts_add(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, environment: mutable TryNonCallErrorFamilyEnv&, current_module: sview @source, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |annotations, environment, current_module, table|:
                    match declaration:
                        Decl.Func(name, params, return_type, _, _, _, function_position):
                            family: mutable sview @source = ""
                            family_rows: mutable usize = 0
                            for row in 0..<annotations.count |family, family_rows, annotations, name, function_position|:
                                marker: Ast::EnumAnnotation = annotations[row]
                                same_declaration: bool = marker.offset == function_position.offset if marker.offset != 0 and function_position.offset != 0 else marker.line == function_position.line
                                if marker.owner == name and marker.name == "__error_return" and same_declaration and row + 1.usize() < annotations.count and callable_error_family_row(annotations, row + 1.usize()):
                                    family <- annotations[row + 1.usize()].name if family_rows == 0
                                    family_rows <- family_rows + 1.usize()
                            return_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = (false, false, false)
                            if return_type is function_return_type and not try_noncall_function_return_is_generic(annotations, function_return_type, function_position, current_module):
                                return_facts <- try_noncall_type_facts_with_aliases_at(function_return_type, environment, current_module)
                            generic_return_formal: mutable (name: sview @source, index: usize) = ("", 0.usize())
                            generic_return_formal <- try_noncall_generic_return_formal(params, function_return_type, annotations, function_position, current_module) if return_type is function_return_type
                            first_param_name: mutable sview @source = ""
                            first_param_type_name: mutable sview @source = ""
                            first_param_is_generic: mutable bool = false
                            has_default_param: mutable bool = false
                            variadic: mutable bool = false
                            for parameter in params |has_default_param|:
                                has_default_param <- true if parameter.has_default
                            for marker in annotations |variadic, function_position|:
                                variadic <- true if marker.owner == "__variadic" and marker.line == function_position.line
                            if params.count > 0.usize():
                                first_param_name <- params[0.usize()].name
                                match params[0.usize()].type_expression:
                                    Expr.Ident(parameter_type, _):
                                        first_param_type_name <- parameter_type
                                        first_param_is_generic <- try_noncall_function_return_is_generic(annotations, params[0.usize()].type_expression, function_position, current_module)
                                    _:
                                        pass
                            callable_visible: bool = callable_function_declaration_visible(annotations, name, current_module, function_position.line, function_position.offset, environment.current_module)
                            environment.callable_names.push(name)
                            environment.callable_modules.push(current_module)
                            environment.callable_families.push(family)
                            environment.callable_visible.push(callable_visible)
                            # Visibility is tracked separately so hidden registrations can
                            # block legacy name-only fallback without blocking a later
                            # visible candidate. A visible function with ambiguous
                            # ErrorSet rows remains an unknown candidate.
                            environment.callable_facts_known.push(family_rows <= 1.usize())
                            environment.callable_return_nonfallible.push(return_facts.known_nonfallible)
                            environment.callable_numeric.push(return_facts.numeric)
                            environment.callable_integer.push(return_facts.integer)
                            environment.callable_first_param_names.push(first_param_name)
                            environment.callable_first_param_type_names.push(first_param_type_name)
                            environment.callable_first_param_generic.push(first_param_is_generic)
                            environment.callable_max_param_counts.push(params.count)
                            environment.callable_has_default_params.push(has_default_param)
                            environment.callable_variadic.push(variadic)
                            environment.callable_generic_return_formal_names.push(generic_return_formal.name)
                            environment.callable_generic_return_formal_indices.push(generic_return_formal.index)
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = try_noncall_module_path(current_module, module_name, table)
                            try_noncall_callable_facts_add(module_body, annotations, environment, nested_module, table)
                        Decl.Scoped(scoped_body, _):
                            try_noncall_callable_facts_add(scoped_body, annotations, environment, current_module, table)
                        _:
                            pass

        # A qualified callee keeps its AST path so `OuterA::Common::pure` is
        # distinguished from `OuterB::Common::pure`. A one-segment qualifier still
        # matches the final segment, preserving module aliases and relative names.
        def try_noncall_qualifier_path_matches_module(qualifier: Ast::Expr, module_path: sview) -> bool:
            can Abort.Panic:
                match qualifier:
                    Expr.Ident(name, _):
                        return module_last_segment(module_path) == name
                    Expr.Scope(base, name, _):
                        separator: mutable usize = module_path.len
                        offset: mutable usize = 0
                        while offset + 1.usize() < module_path.len |separator, offset|:
                            separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                            offset <- offset + 1.usize()
                        return false if separator == module_path.len
                        return false if module_path[separator + 2.usize():module_path.len] != name
                        return try_noncall_qualifier_path_matches_module(base, module_path[0:separator])
                    Expr.Paren(inner, _):
                        return try_noncall_qualifier_path_matches_module(inner, module_path)
                    _:
                        return false

        def try_noncall_qualified_module_matches(callee: Ast::Expr, module_path: sview) -> bool:
            can Abort.Panic:
                match callee:
                    Expr.Scope(qualifier, _, _):
                        return try_noncall_qualifier_path_matches_module(qualifier, module_path)
                    Expr.Paren(inner, _):
                        return try_noncall_qualified_module_matches(inner, module_path)
                    _:
                        return false
