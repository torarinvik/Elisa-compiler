extend Semantic:
    private:
        # Simple identifiers reuse their exact binding type. A direct call can contribute
        # its return TypeId only when ordinary lookup selects one visible declaration;
        # overloads, generic schemes, shadowed values, and unresolved imports remain unknown.
        def try_call_argument_type_ids(file: Ast::File&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, argument_positions: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, caller: DeclId, try_offset: u32, arity: u32, receiver_ref_mutability_known: mutable bool&, receiver_ref_mutable: mutable bool&) -> darray[u32]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[u32] = []
                receiver_ref_mutability_known <- false
                receiver_ref_mutable <- false
                argument_index: mutable usize = 0.usize()
                while argument_index < arity.usize() |result, argument_index, table, argument_positions, module_index, module_annotations, caller, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable, annotations|:
                    position_found: mutable bool = false
                    position_conflict: mutable bool = false
                    argument_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    for marker in argument_positions |position_found, position_conflict, argument_position, argument_index, try_offset|:
                        continue if marker.owner != "__try_callee_argument_position" or marker.offset != try_offset or marker.identity_id != argument_index.u32()
                        if not position_found:
                            argument_position <- marker.pos
                            position_found <- true
                        else:
                            position_conflict <- true if marker.pos.offset != argument_position.offset or marker.pos.end_offset != argument_position.end_offset
                    argument_type_id: mutable u32 = 0
                    type_found: mutable bool = false
                    type_conflict: mutable bool = false
                    receiver_ref_conflict: mutable bool = false
                    if position_found and not position_conflict and caller.value != INVALID_DECL_ID_VALUE:
                        binding: OwnershipBindingLookupResult = ownership_binding_at_position(table, caller, argument_position)
                        if binding.known:
                            for declared in table.binding_declared_types |argument_type_id, type_found, type_conflict, receiver_ref_conflict, receiver_ref_mutability_known, receiver_ref_mutable, binding, table, argument_index|:
                                continue if declared.binding_id.owner.value != binding.binding_id.owner.value or declared.binding_id.serial != binding.binding_id.serial
                                if not type_found:
                                    argument_type_id <- declared.type_id
                                    type_found <- true
                                else:
                                    type_conflict <- true if argument_type_id != declared.type_id
                                if argument_index == 0 and interned_kind(declared.type_id, table) == SemTypeKind.Ref:
                                    receiver_ref_mutability_seen: bool = receiver_ref_mutability_known
                                    if not receiver_ref_mutability_seen:
                                        receiver_ref_mutability_known <- true
                                        receiver_ref_mutable <- declared.writable_borrow
                                    elif receiver_ref_mutable != declared.writable_borrow:
                                        receiver_ref_conflict <- true
                    if not type_found and not type_conflict and caller.value != INVALID_DECL_ID_VALUE and caller.value.usize() < table.symbols.count:
                        nested_call_found: mutable bool = false
                        nested_call_conflict: mutable bool = false
                        nested_call_name: mutable sview = ""
                        nested_call_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                        for marker in argument_positions |nested_call_found, nested_call_conflict, nested_call_name, nested_call_position, argument_index, try_offset|:
                            continue if marker.owner != "__try_callee_argument_direct_call" or marker.offset != try_offset or marker.identity_id != argument_index.u32()
                            if not nested_call_found:
                                nested_call_found <- true
                                nested_call_name <- marker.name
                                nested_call_position <- marker.pos
                            else:
                                nested_call_conflict <- true if marker.name != nested_call_name or marker.pos.offset != nested_call_position.offset
                        if nested_call_found and not nested_call_conflict:
                            call_binding: OwnershipBindingLookupResult = ownership_binding_at_position(table, caller, nested_call_position)
                            if not call_binding.known:
                                caller_module: sview = table.symbols[caller.value.usize()].module_owner
                                if not callable_try_static_binding_uncertain(annotations, nested_call_name, caller_module, "", table):
                                    call_return_found: mutable bool = false
                                    call_return_conflict: mutable bool = false
                                    call_return_type_id: mutable u32 = 0
                                    call_return_function_line: mutable u32 = 0
                                    call_return_function_offset: mutable u32 = 0
                                    for symbol in table.symbols |call_return_found, call_return_conflict, call_return_type_id, call_return_function_line, call_return_function_offset, nested_call_name, caller_module, module_index, module_annotations, annotations, table|:
                                        continue if symbol.kind != SymbolKind.Func or symbol.name != nested_call_name
                                        # A non-fallible callee has no error-family marker;
                                        # its declaration carries the authoritative owner.
                                        continue if callable_function_declaration_is_static_inactive(annotations, nested_call_name, symbol.module_owner, symbol.line, symbol.offset)
                                        continue if not callable_row_in_scope_with_owner(annotations, nested_call_name, symbol.module_owner, symbol.offset, symbol.line, caller_module, "", table)
                                        if not call_return_found:
                                            call_return_type_id <- symbol.return_type_id
                                            call_return_function_line <- symbol.line
                                            call_return_function_offset <- symbol.offset
                                            call_return_found <- true
                                        else:
                                            call_return_conflict <- true
                                    call_return_is_generic: bool = type_id_contains_function_generic(call_return_type_id, call_return_function_line, call_return_function_offset, table) if call_return_found and not call_return_conflict else false
                                    call_return_has_region: bool = type_id_contains_region(call_return_type_id, table) if call_return_found and not call_return_conflict else false
                                    if call_return_type_id != 0 and not call_return_conflict and not call_return_is_generic and not call_return_has_region:
                                        argument_type_id <- call_return_type_id
                                        type_found <- true
                    receiver_ref_mutability_known <- false if argument_index == 0 and (type_conflict or receiver_ref_conflict)
                    receiver_ref_mutability_resolved: bool = receiver_ref_mutability_known
                    receiver_ref_mutable <- false if argument_index == 0 and not receiver_ref_mutability_resolved
                    argument_type_firm: bool = try_overload_type_is_firm(file, argument_type_id, caller, annotations, table) if type_found and not type_conflict else false
                    argument_type_ambiguous: bool = try_overload_type_has_ambiguous_nominal_identity(file, argument_type_id, caller, annotations, table, 0) if type_found and not type_conflict else false
                    result.push(argument_type_id if type_found and not type_conflict and (argument_type_firm or argument_type_ambiguous) else 0)
                    argument_index <- argument_index + 1.usize()
                return result

        def try_overload_receiver_pattern_matches(file: Ast::File&, formal_type_id: u32, actual_type_id: u32, declaration: DeclId, actual_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> (known: bool, matches: bool):
            can Abort.Panic:
                return (false, false) if formal_type_id == 0 or actual_type_id == 0 or depth > 64
                return (true, true) if try_overload_type_is_generic_parameter(formal_type_id, declaration, annotations, table)
                formal_kind: SemTypeKind = interned_kind(formal_type_id, table)
                actual_kind: SemTypeKind = interned_kind(actual_type_id, table)
                # Receiver references are transparently borrowed or dereferenced by Core.
                if formal_kind == SemTypeKind.Ref or actual_kind == SemTypeKind.Ref:
                    if formal_kind == SemTypeKind.Ref and actual_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1 or interned_elem_count(actual_type_id, table) != 1
                        return try_overload_receiver_pattern_matches(file, interned_elem(formal_type_id, 0, table), interned_elem(actual_type_id, 0, table), declaration, actual_module, annotations, table, depth + 1)
                    if formal_kind == SemTypeKind.Ref:
                        return (false, false) if interned_elem_count(formal_type_id, table) != 1
                        return try_overload_receiver_pattern_matches(file, interned_elem(formal_type_id, 0, table), actual_type_id, declaration, actual_module, annotations, table, depth + 1)
                    return (false, false) if interned_elem_count(actual_type_id, table) != 1
                    return try_overload_receiver_pattern_matches(file, formal_type_id, interned_elem(actual_type_id, 0, table), declaration, actual_module, annotations, table, depth + 1)
                numeric: bool = (formal_kind == SemTypeKind.Int or formal_kind == SemTypeKind.Float) and (actual_kind == SemTypeKind.Int or actual_kind == SemTypeKind.Float)
                if numeric:
                    return (true, true) if formal_type_id == actual_type_id
                    # Core has one special integer receiver coercion for an actual
                    # `int`; typed numeric widths otherwise need the same receiver type.
                    return (true, true) if formal_kind == SemTypeKind.Int and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                    return (true, false)
                # Core's untyped integer receiver coercion also accepts every integral
                # storage type, including `char`, which has a separate semantic kind.
                return (true, true) if formal_kind == SemTypeKind.Char and actual_kind == SemTypeKind.Int and interned_name(actual_type_id, table) == "int"
                if formal_kind == SemTypeKind.Named or actual_kind == SemTypeKind.Named:
                    return (true, false) if formal_kind != actual_kind or interned_name(formal_type_id, table) != interned_name(actual_type_id, table)
                    name: sview = interned_name(formal_type_id, table)
                    formal_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, name, declaration, annotations, table)
                    actual_identity: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(file, name, actual_module, annotations, table)
                    return (false, false) if formal_identity.ambiguous or actual_identity.ambiguous
                    return (false, false) if not formal_identity.found or not actual_identity.found
                    return (true, formal_identity.owner == actual_identity.owner)
                structural: bool = formal_kind == SemTypeKind.Optional or formal_kind == SemTypeKind.Tuple or formal_kind == SemTypeKind.Container
                if structural:
                    return (true, false) if formal_kind != actual_kind or interned_name(formal_type_id, table) != interned_name(actual_type_id, table)
                    if formal_kind == SemTypeKind.Container:
                        container_name: sview = interned_name(formal_type_id, table)
                        builtin_container: bool = container_name == "array" or container_name == "darray" or container_name == "dict" or container_name == "set"
                        if not builtin_container:
                            formal_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner(file, container_name, declaration, annotations, table)
                            actual_container: (found: bool, ambiguous: bool, owner: sview) = try_overload_nominal_type_owner_for_module(file, container_name, actual_module, annotations, table)
                            return (false, false) if formal_container.ambiguous or actual_container.ambiguous or not formal_container.found or not actual_container.found
                            return (true, false) if formal_container.owner != actual_container.owner
                    element_count: u32 = interned_elem_count(formal_type_id, table)
                    return (true, false) if element_count != interned_elem_count(actual_type_id, table)
                    for element_position in 0..<element_count.usize() |element_count, formal_type_id, actual_type_id, declaration, annotations, table, depth|:
                        element_match: (known: bool, matches: bool) = try_overload_receiver_pattern_matches(file, interned_elem(formal_type_id, element_position.u32(), table), interned_elem(actual_type_id, element_position.u32(), table), declaration, actual_module, annotations, table, depth + 1)
                        return (false, false) if not element_match.known
                        return (true, false) if not element_match.matches
                    return (true, true)
                return (true, type_ids_compatible(formal_type_id, actual_type_id, table))

        def try_overload_receiver_specificity(file: Ast::File&, type_id: u32, declaration: DeclId, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, depth: u32) -> (known: bool, score: usize):
            can Abort.Panic:
                return (false, 0.usize()) if type_id == 0 or depth > 64
                return (true, 0.usize()) if try_overload_type_is_generic_parameter(type_id, declaration, annotations, table)
                kind: SemTypeKind = interned_kind(type_id, table)
                if kind == SemTypeKind.Ref:
                    return (false, 0.usize()) if interned_elem_count(type_id, table) != 1
                    return try_overload_receiver_specificity(file, interned_elem(type_id, 0, table), declaration, annotations, table, depth + 1)
                if kind == SemTypeKind.Optional or kind == SemTypeKind.Tuple or kind == SemTypeKind.Container:
                    score: mutable usize = 1.usize()
                    for element_position in 0..<interned_elem_count(type_id, table) |score, type_id, declaration, annotations, table, depth|:
                        element_score: (known: bool, score: usize) = try_overload_receiver_specificity(file, interned_elem(type_id, element_position.u32(), table), declaration, annotations, table, depth + 1)
                        return (false, 0.usize()) if not element_score.known
                        score <- score + element_score.score
                    return (true, score)
                return (false, 0.usize()) if not try_overload_type_is_firm(file, type_id, declaration, annotations, table)
                return (true, 1.usize())

        def callable_symbol_receiver_type(table: SymbolTable&, symbol: Symbol) -> (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool):
            can Abort.Panic:
                for row in 0..<table.function_param_owner.count |table, symbol|:
                    continue if row >= table.function_param_declaration_id.count or table.function_param_declaration_id[row].value != symbol.id.value
                    return (true, table.function_param_type_id[row], table.function_param_mutable_ref[row], true) if row < table.function_param_type_id.count and row < table.function_param_mutable_ref.count
                    return (true, table.function_param_type_id[row], false, false) if row < table.function_param_type_id.count
                    return (true, 0, false, false)
                return (false, 0, false, false)

        def callable_symbol_has_parameter_rows(table: SymbolTable&, symbol: Symbol) -> bool:
            can Abort.Panic:
                for declaration_id in table.function_param_declaration_id:
                    return true if declaration_id.value == symbol.id.value
                return false

        def callable_symbol_core_accepts_receiver_arity(table: SymbolTable&, symbol: Symbol, arity: u32) -> bool:
            can Abort.Panic:
                # Core keeps variadic and defaulted declarations in the receiver
                # candidate set, then lets ordinary call checking report bad counts.
                return true if symbol.arity_max == 4294967295
                for row in 0..<table.function_param_declaration_id.count |table, symbol, arity|:
                    continue if table.function_param_declaration_id[row].value != symbol.id.value
                    return true if row < table.function_param_has_default.count and table.function_param_has_default[row]
                return symbol.arity_max == arity

        def callable_try_call_forwards_arguments(annotations: darray[Ast::EnumAnnotation]&, try_offset: u32) -> bool:
            can Abort.Panic:
                return any marker in annotations where marker.owner == "__try_callee_argument_forward" and marker.offset == try_offset

        # `(..)` forwards the enclosing function's parameters in declaration order.
        # Retain unknown for generic, variadic, or incomplete parameter metadata.
        def try_forwarded_parameter_types(table: SymbolTable&, caller: DeclId, receiver_ref_mutability_known: mutable bool&, receiver_ref_mutable: mutable bool&) -> (known: bool, types: darray[u32]):
            can Memory.Allocate, Abort.Panic:
                types: mutable darray[u32] = []
                return (false, types) if caller.value == INVALID_DECL_ID_VALUE or caller.value.usize() >= table.symbols.count
                function: Symbol = table.symbols[caller.value.usize()]
                return (false, types) if function.arity_min != function.arity_max or function.arity_max == 4294967295
                for row in 0..<table.function_param_declaration_id.count |types, table, caller, receiver_ref_mutability_known, receiver_ref_mutable|:
                    continue if table.function_param_declaration_id[row].value != caller.value
                    return (false, []) if row >= table.function_param_type_id.count or table.function_param_type_id[row] == 0
                    type_id: u32 = table.function_param_type_id[row]
                    if types.count == 0 and interned_kind(type_id, table) == SemTypeKind.Ref:
                        return (false, []) if row >= table.function_param_mutable_ref.count
                        receiver_ref_mutability_known <- true
                        receiver_ref_mutable <- table.function_param_mutable_ref[row]
                    types.push(type_id)
                return (types.count == function.arity_max.usize(), types)

        # Mirror Core's UFCS lookup across the full visible-name candidate set: filter
        # by Core's coarse arity rule, then rank only the first parameter. Later argument
        # compatibility is checked after the selected declaration is known.
        def callable_symbol_type_selected_candidate(file: Ast::File&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview @source, try_offset: u32, arity: u32, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool) -> DeclId:
            can Abort.Panic:
                invalid: DeclId = DeclId{value: INVALID_DECL_ID_VALUE}
                return invalid if argument_type_ids.count != arity.usize() or argument_type_ids.count == 0.usize()
                actual_receiver_type_id: u32 = argument_type_ids[0]
                return invalid if not try_overload_type_is_firm_in_module(file, actual_receiver_type_id, enclosing_module, annotations, table)
                actual_receiver_is_ref: bool = interned_kind(actual_receiver_type_id, table) == SemTypeKind.Ref
                return invalid if actual_receiver_is_ref and not receiver_ref_mutability_known
                return invalid if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for argument in try_named_arguments |try_named_arguments, try_offset|:
                    return invalid if argument.owner == "__try_callee_named_arg" and argument.offset == try_offset
                selected: mutable DeclId = invalid
                best_rank: mutable usize = 0.usize()
                best_count: mutable usize = 0.usize()
                for symbol in table.symbols |selected, best_rank, best_count, table, annotations, try_named_arguments, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, actual_receiver_type_id, actual_receiver_is_ref, receiver_ref_mutable|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    continue if not callable_symbol_core_accepts_receiver_arity(table, symbol, arity)
                    continue if not callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    receiver: (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool) = callable_symbol_receiver_type(table, symbol)
                    continue if not receiver.found and not callable_symbol_has_parameter_rows(table, symbol) and symbol.arity_min == 0 and (symbol.arity_max == 0 or symbol.arity_max == 4294967295)
                    return invalid if not receiver.found or receiver.type_id == 0
                    formal_receiver_is_ref: bool = interned_kind(receiver.type_id, table) == SemTypeKind.Ref
                    receiver_match: (known: bool, matches: bool) = try_overload_receiver_pattern_matches(file, receiver.type_id, actual_receiver_type_id, symbol.id, enclosing_module, annotations, table, 0)
                    return invalid if not receiver_match.known
                    continue if not receiver_match.matches
                    if actual_receiver_is_ref and not formal_receiver_is_ref and not try_overload_type_is_generic_parameter(receiver.type_id, symbol.id, annotations, table):
                        actual_receiver_base_id: u32 = interned_elem(actual_receiver_type_id, 0, table)
                        actual_receiver_base_kind: SemTypeKind = interned_kind(actual_receiver_base_id, table)
                        # A non-null scalar reference can act as a value receiver in Core;
                        # the TypeId table does not preserve nullability, so leave that set
                        # unresolved. Aggregate by-value candidates cannot match a RefType.
                        return invalid if actual_receiver_base_kind == SemTypeKind.Int or actual_receiver_base_kind == SemTypeKind.Float or actual_receiver_base_kind == SemTypeKind.Bool
                        continue
                    if formal_receiver_is_ref and actual_receiver_is_ref:
                        return invalid if not receiver.mutable_ref_known
                        continue if receiver.mutable_ref and not receiver_ref_mutable
                    formal_base: u32 = interned_elem(receiver.type_id, 0, table) if interned_kind(receiver.type_id, table) == SemTypeKind.Ref and interned_elem_count(receiver.type_id, table) == 1 else receiver.type_id
                    rank: (known: bool, score: usize) = try_overload_receiver_specificity(file, formal_base, symbol.id, annotations, table, 0)
                    return invalid if not rank.known
                    rank_score: usize = rank.score + 1.usize() if formal_receiver_is_ref and actual_receiver_is_ref and receiver.mutable_ref == receiver_ref_mutable else rank.score
                    if best_count == 0.usize() or rank_score > best_rank:
                        best_rank <- rank_score
                        best_count <- 1.usize()
                        selected <- symbol.id
                    elif rank_score == best_rank:
                        best_count <- best_count + 1.usize()
                return selected if best_count == 1.usize()
                return invalid

        def callable_symbol_accepts_arity(file: Ast::File&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, module: sview, declaration_offset: u32, declaration_line: u32, try_offset: u32, arity_known: bool, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, enclosing_module: sview, callee_qualifier: sview @source) -> bool:
            can Abort.Panic:
                return false if argument_type_ids.count == 0 and callable_try_call_forwards_arguments(annotations, try_offset) and callable_name_has_ufcs_overload_set_candidate(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table)
                return false if callable_overload_has_ambiguous_nominal_receiver_candidate(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, try_offset, arity, enclosing_module, callee_qualifier)
                exact_found: mutable bool = false
                exact_accepts: mutable bool = false
                unknown_offset_count: mutable usize = 0.usize()
                unknown_offset_accepts: mutable bool = false
                matching_symbol_count: mutable usize = 0.usize()
                selected_type_candidate: DeclId = callable_symbol_type_selected_candidate(file, table, annotations, try_named_arguments, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable) if arity_known else DeclId{value: INVALID_DECL_ID_VALUE}
                return false if selected_type_candidate.value == INVALID_DECL_ID_VALUE and arity_known and callable_overload_has_inaccessible_arity_candidate(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, module, declaration_offset, declaration_line, try_offset, arity_known, arity, selected_type_candidate, exact_found, exact_accepts, unknown_offset_count, unknown_offset_accepts, matching_symbol_count|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner != module
                    continue if symbol.line != declaration_line
                    matching_symbol_count <- matching_symbol_count + 1.usize()
                    accepts_call: mutable bool = (not arity_known or callable_symbol_core_accepts_receiver_arity(table, symbol, arity)) and callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    accepts_call <- false if selected_type_candidate.value != INVALID_DECL_ID_VALUE and symbol.id.value != selected_type_candidate.value
                    accepts_call <- false if selected_type_candidate.value != INVALID_DECL_ID_VALUE and symbol.id.value == selected_type_candidate.value and not callable_function_declaration_visible(annotations, name, module, symbol.line, symbol.offset, enclosing_module)
                    if symbol.offset == declaration_offset:
                        exact_found <- true
                        exact_accepts <- accepts_call
                    elif declaration_offset == FALLIBLE_FUNCTION_NO_OFFSET or symbol.offset == FALLIBLE_FUNCTION_NO_OFFSET:
                        unknown_offset_count <- unknown_offset_count + 1.usize()
                        unknown_offset_accepts <- accepts_call
                return exact_accepts if exact_found
                return unknown_offset_accepts if unknown_offset_count == 1.usize() and matching_symbol_count == 1.usize()
                return false if matching_symbol_count != 0.usize()
                # Missing symbol provenance is inconclusive; preserve the existing lookup
                # and let duplicate visible declarations remain ambiguous.
                return true

        def callable_symbol_arity_candidate_count(file: Ast::File&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, try_offset: u32, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, enclosing_module: sview, callee_qualifier: sview @source) -> usize:
            can Abort.Panic:
                return 0.usize() if argument_type_ids.count == 0 and callable_try_call_forwards_arguments(annotations, try_offset) and callable_name_has_ufcs_overload_set_candidate(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table)
                return 0.usize() if callable_overload_has_ambiguous_nominal_receiver_candidate(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, try_offset, arity, enclosing_module, callee_qualifier)
                selected_type_candidate: DeclId = callable_symbol_type_selected_candidate(file, table, annotations, try_named_arguments, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable)
                if selected_type_candidate.value != INVALID_DECL_ID_VALUE:
                    return 0.usize() if selected_type_candidate.value.usize() >= table.symbols.count
                    selected_symbol: Symbol = table.symbols[selected_type_candidate.value.usize()]
                    return 1.usize() if callable_function_declaration_visible(annotations, name, selected_symbol.module_owner, selected_symbol.line, selected_symbol.offset, enclosing_module)
                    return 0.usize()
                return 0.usize() if callable_overload_has_inaccessible_arity_candidate(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable)
                candidate_count: mutable usize = 0.usize()
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, try_offset, arity, candidate_count, enclosing_module, callee_qualifier|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_visible_for_try_call(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                    if callable_symbol_core_accepts_receiver_arity(table, symbol, arity) and callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset):
                        candidate_count <- candidate_count + 1.usize()
                return candidate_count

        def callable_first_wildcard_imported_row(annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, name: sview, candidate_module: sview, enclosing_module: sview) -> (found: bool, matches: bool):
            can Abort.Panic:
                selected_found: mutable bool = false
                ambiguous_imports: mutable bool = false
                selected_scope_length: mutable usize = enclosing_module.len + 1.usize()
                selected_target: mutable sview = ""
                for binding in annotations |annotations, table, name, candidate_module, enclosing_module, selected_found, ambiguous_imports, selected_scope_length, selected_target|:
                    continue if binding.name != "__binding_wildcard_import" or not try_noncall_module_is_ancestor(binding.module, enclosing_module)
                    if callable_named_visible_declaration_in_module(table, annotations, name, binding.owner, enclosing_module):
                        ambiguous_imports <- true if selected_found and selected_target != binding.owner
                        if binding.module.len < selected_scope_length:
                            selected_found <- true
                            selected_scope_length <- binding.module.len
                            selected_target <- binding.owner
                        selected_found <- true if not selected_found
                        selected_target <- binding.owner if selected_target == ""
                return (true, false) if ambiguous_imports
                return (selected_found, selected_target == candidate_module)

        def callable_wildcard_imported_row_in_scope(annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, name: sview, candidate_module: sview, scope_module: sview) -> bool:
            can Abort.Panic:
                for binding in annotations |annotations, table, name, candidate_module, scope_module|:
                    if binding.name == "__binding_wildcard_import" and binding.owner == candidate_module and binding.module == scope_module:
                        return callable_named_declaration_in_module(table, annotations, name, candidate_module)
                return false

        # Core keeps selective imports in a program-level alias map, including imports
        # written inside a different module. The first matching import owns that bare-name
        # candidate; later conflicting imports are already diagnosed by Core.
        def callable_program_selective_import_row(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview) -> bool:
            can Abort.Panic:
                for binding in annotations |annotations, name, candidate_module|:
                    continue if binding.owner != "__from_member" or binding.name != name
                    for source in annotations |annotations, binding, name, candidate_module|:
                        continue if source.owner != "__from_src" or source.module != binding.module or source.line != binding.line or source.offset != binding.offset
                        # Core registers `from M import name` as joinQualifiedName(the
                        # importing namespace, M); module aliases are not expanded here.
                        return candidate_module == source.name if binding.module == ""
                        return callable_module_path_matches_suffix(candidate_module, binding.module, source.name)
                return false

        # Ordinary name lookup skips private import targets. Keep a separate raw
        # predicate above for Core's receiver-ranked overload candidate set, which can
        # select an inaccessible private registration before reporting access failure.
        def callable_program_selective_import_row_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, enclosing_module: sview) -> bool:
            can Abort.Panic:
                for binding in annotations |annotations, name, candidate_module, enclosing_module|:
                    continue if binding.owner != "__from_member" or binding.name != name
                    for source in annotations |annotations, binding, name, candidate_module, enclosing_module|:
                        continue if source.owner != "__from_src" or source.module != binding.module or source.line != binding.line or source.offset != binding.offset
                        path_matches: bool = candidate_module == source.name if binding.module == "" else callable_module_path_matches_suffix(candidate_module, binding.module, source.name)
                        return path_matches and try_error_alias_module_visible(annotations, candidate_module, enclosing_module)
                return false

        # An unresolved static-if import/alias cannot safely select a known candidate
        # that happens to remain after filtering. Decline family inference when that
        # unresolved binding could affect this bare name or qualified alias head.
        def callable_try_static_binding_uncertain(annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview @source, table: SymbolTable&) -> bool:
            can Abort.Panic:
                alias_head: mutable sview = callee_qualifier
                for offset in 0..<callee_qualifier.len |alias_head, callee_qualifier|:
                    if offset + 1.usize() < callee_qualifier.len and callee_qualifier[offset] == 58 and callee_qualifier[offset + 1.usize()] == 58:
                        alias_head <- callee_qualifier[0:offset]
                        break
                for unresolved in annotations:
                    continue if unresolved.owner != "__try_unresolved_static_binding"
                    if unresolved.name == "__from_member" and callee_qualifier == "" and unresolved.detail_name == name:
                        target_found: mutable bool = false
                        for source in annotations |unresolved, name, table, target_found|:
                            continue if source.owner != "__from_src" or source.module != unresolved.module or source.line != unresolved.line or source.offset != unresolved.offset
                            target_found <- true
                            for symbol in table.symbols:
                                continue if symbol.kind != SymbolKind.Func or symbol.name != name
                                continue if not callable_import_module_matches_target(symbol.module_owner, unresolved.module, source.name)
                                return true if callable_function_declaration_visible(annotations, name, symbol.module_owner, symbol.line, symbol.offset, enclosing_module)
                        return true if not target_found and any symbol in table.symbols where symbol.kind == SymbolKind.Func and symbol.name == name and callable_function_declaration_visible(annotations, name, symbol.module_owner, symbol.line, symbol.offset, enclosing_module)
                    if unresolved.name == "__binding_wildcard_import" and callee_qualifier == "" and try_noncall_module_is_ancestor(unresolved.module, enclosing_module):
                        return true if callable_named_visible_declaration_in_module(table, annotations, name, unresolved.detail_name, enclosing_module)
                    if unresolved.name == "__using_alias" and callee_qualifier != "" and unresolved.detail_name == alias_head:
                        selected_alias: (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32) = semantic_possible_import_alias_head_target(alias_head, enclosing_module, 4294967295, table)
                        continue if selected_alias.known and selected_alias.found
                        # The same qualified head can resolve through this alias or as a
                        # raw module path. Once the alias winner is unresolved, a candidate
                        # from either interpretation cannot establish a definite ErrorSet.
                        return true
                return false

        def callable_qualified_module_matches_candidate(annotations: darray[Ast::EnumAnnotation]&, candidate_module: sview, enclosing_module: sview, callee_qualifier: sview @source, name: sview, table: SymbolTable&, before_offset: u32 = 4294967295) -> bool:
            can Abort.Panic:
                # Core tries each lexical namespace before the global module-alias
                # rewrite, then tries the spelling as a root-qualified path. Select
                # the first lexical module that actually contributes this callable.
                scope_module: mutable sview = enclosing_module
                while scope_module != "" |scope_module, annotations, candidate_module, callee_qualifier, name, table|:
                    first_lexical_module: mutable sview = ""
                    for symbol in table.symbols |first_lexical_module, annotations, candidate_module, scope_module, callee_qualifier, name, enclosing_module|:
                        continue if symbol.kind != SymbolKind.Func or symbol.name != name
                        continue if not callable_module_path_matches_suffix(symbol.module_owner, scope_module, callee_qualifier)
                        if callable_function_declaration_visible(annotations, name, symbol.module_owner, symbol.line, symbol.offset, enclosing_module):
                            first_lexical_module <- symbol.module_owner
                            break
                    return candidate_module == first_lexical_module if first_lexical_module != ""
                    scope_module <- try_noncall_module_parent(scope_module)

                separator: mutable usize = callee_qualifier.len
                for offset in 0..<callee_qualifier.len |separator, callee_qualifier|:
                    if offset + 1.usize() < callee_qualifier.len and callee_qualifier[offset] == 58 and callee_qualifier[offset + 1.usize()] == 58:
                        separator <- offset if separator == callee_qualifier.len
                alias_head: sview = callee_qualifier[0:separator]
                alias_suffix: sview = callee_qualifier[separator + 2.usize():callee_qualifier.len] if separator < callee_qualifier.len else ""
                alias: (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32) = semantic_possible_import_alias_head_target(alias_head, enclosing_module, before_offset, table)
                return false if not alias.known
                if alias.found:
                    # Direct aliases are pre-registered for ordinary body lookup, but a
                    # source-positioned caller must not borrow an alias written later in
                    # the same file. Keep legacy post-registration callers on the sentinel.
                    return false if before_offset != 4294967295 and alias.offset >= before_offset
                    alias_module: mutable sview = ""
                    for symbol in table.symbols |alias_module, annotations, candidate_module, callee_qualifier, name, enclosing_module, alias|:
                        continue if symbol.kind != SymbolKind.Func or symbol.name != name
                        continue if not callable_function_declaration_visible(annotations, name, symbol.module_owner, symbol.line, symbol.offset, enclosing_module)
                        target_prefix: (known: bool, matches: bool, end: usize) = semantic_possible_import_alias_target_prefix(symbol.module_owner, alias.raw_target, alias.scope, alias.offset, table)
                        appended_target: (matches: bool, end: usize) = semantic_import_path_append_prefix_matches(symbol.module_owner, target_prefix.end, alias_suffix) if target_prefix.known and target_prefix.matches else (false, 0.usize())
                        if target_prefix.known and target_prefix.matches and appended_target.matches and appended_target.end == symbol.module_owner.len:
                            alias_module <- symbol.module_owner
                            break
                    return candidate_module == alias_module if alias_module != ""
                return candidate_module == callee_qualifier and callable_named_visible_declaration_in_module(table, annotations, name, candidate_module, enclosing_module)

        def callable_row_in_scope_indexed(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview @source, table: SymbolTable&) -> bool:
            can Abort.Panic:
                candidate_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, declaration_offset, declaration_line)
                return callable_row_in_scope_with_owner(annotations, name, candidate_module, declaration_offset, declaration_line, enclosing_module, callee_qualifier, table)

        def callable_row_in_scope_with_owner(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview @source, table: SymbolTable&) -> bool:
            can Abort.Panic:
                if callee_qualifier != "":
                    return false if not try_error_alias_module_visible(annotations, candidate_module, enclosing_module)
                    return false if not callable_function_declaration_visible(annotations, name, candidate_module, declaration_line, declaration_offset, enclosing_module)
                    return callable_qualified_module_matches_candidate(annotations, candidate_module, enclosing_module, callee_qualifier, name, table)
                return false if not callable_function_declaration_visible(annotations, name, candidate_module, declaration_line, declaration_offset, enclosing_module)
                # Core considers every lexical declaration before any wildcard `using`
                # candidate. A nested wildcard must not hide an ancestor's function.
                scope_module: mutable sview = enclosing_module
                while true |scope_module, annotations, name, candidate_module|:
                    if callable_named_visible_declaration_in_module(table, annotations, name, scope_module, enclosing_module):
                        return candidate_module == scope_module
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
                wildcard: (found: bool, matches: bool) = callable_first_wildcard_imported_row(annotations, table, name, candidate_module, enclosing_module)
                return wildcard.matches if wildcard.found
                return callable_program_selective_import_row_visible(annotations, name, candidate_module, enclosing_module)

        # Core's receiver selector searches all visible candidate names once an
        # overload set exists, including a same-named local and imported function.
        def callable_row_in_ufcs_candidate_set_indexed(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview @source, table: SymbolTable&) -> bool:
            can Abort.Panic:
                candidate_module: sview = fallible_fn_module_indexed(module_index, module_annotations, declaration_offset, declaration_line)
                return false if callable_function_declaration_is_static_inactive(annotations, name, candidate_module, declaration_line, declaration_offset)
                if callee_qualifier != "":
                    return false if not try_error_alias_module_visible(annotations, candidate_module, enclosing_module)
                    return callable_qualified_module_matches_candidate(annotations, candidate_module, enclosing_module, callee_qualifier, name, table)
                scope_module: mutable sview = enclosing_module
                while true |scope_module, annotations, name, candidate_module, table|:
                    return true if candidate_module == scope_module and callable_named_declaration_in_module(table, annotations, name, scope_module)
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
                # Receiver ranking gathers the overload set after ordinary lexical
                # lookup. Keep the candidate set complete, but apply Core's tier order:
                # every lexical declaration precedes every wildcard import.
                scope_module <- enclosing_module
                while true |scope_module, annotations, name, candidate_module, table|:
                    return true if callable_wildcard_imported_row_in_scope(annotations, table, name, candidate_module, scope_module)
                    break if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)
                return callable_program_selective_import_row(annotations, name, candidate_module)

        def callable_name_has_ufcs_overload_set_in_scope(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview @source, try_named_arguments: darray[Ast::EnumAnnotation]&, try_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if any argument in try_named_arguments where argument.owner == "__try_callee_named_arg" and argument.offset == try_offset
                return callable_name_has_ufcs_overload_set_candidate(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table)

        # Core registers all functions for receiver dispatch by name; count the same
        # visible declaration group independently of whether this call shape is rankable.
        def callable_name_has_ufcs_overload_set_candidate(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview @source, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, table|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if callable_function_declaration_is_static_inactive(annotations, name, symbol.module_owner, symbol.line, symbol.offset)
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    candidate_count: mutable usize = 0.usize()
                    for other in table.symbols |symbol, candidate_count, table, annotations, name|:
                        continue if other.kind != SymbolKind.Func or other.name != name or other.module_owner != symbol.module_owner
                        candidate_count <- candidate_count + 1.usize() if not callable_function_declaration_is_static_inactive(annotations, name, other.module_owner, other.line, other.offset)
                    return true if candidate_count >= 2.usize()
                return false

