extend Semantic:
    private:
        def try_noncall_record_expression(expression: Ast::Expr, annotation: Ast::EnumAnnotation, nearest_offset: mutable u32&, nearest_name: mutable sview& @source) -> void:
            can Abort.Panic:
                position: Ast::Pos = Ast::expr_pos(expression)
                if position.line == annotation.line and position.offset > annotation.offset and nearest_offset == 4294967295:
                    nearest_offset <- position.offset
                    nearest_name <- try_noncall_parameter_name(expression)
                    nearest_name <- annotation.owner if annotation.name == "__try_without_else" and annotation.owner != "__noncall" and annotation.owner != "__unknown_call"
                    # The first AST expression beginning after the erased try token is
                    # its operand root. Descending from a binary/member root and choosing
                    # the first identifier would incorrectly borrow that child's family.
                    return
                # The parser erases the `try` wrapper and records its token offset separately.
                # When `try value` is nested as a call argument, the statement's Call node
                # starts before the annotation, so search its children for the closest node
                # that begins after the token.
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        try_noncall_record_expression(callee, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        for candidate in candidates |annotation, nearest_offset, nearest_name|:
                            for capture in candidate.captures |annotation, nearest_offset, nearest_name|:
                                try_noncall_record_expression(capture, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.Binary(left, _, right, _):
                        try_noncall_record_expression(left, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(right, annotation, nearest_offset, nearest_name)
                    Expr.Paren(inner, _):
                        try_noncall_record_expression(inner, annotation, nearest_offset, nearest_name)
                    Expr.Field(object, _, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                    Expr.Scope(base, _, _):
                        try_noncall_record_expression(base, annotation, nearest_offset, nearest_name)
                    Expr.Index(object, index, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(index, annotation, nearest_offset, nearest_name)
                    Expr.IndexN(object, arguments, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        for argument in arguments |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(argument, annotation, nearest_offset, nearest_name)
                    Expr.Slice(object, low, high, _):
                        try_noncall_record_expression(object, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(low, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(high, annotation, nearest_offset, nearest_name)
                    Expr.Unary(_, operand, _):
                        try_noncall_record_expression(operand, annotation, nearest_offset, nearest_name)
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        try_noncall_record_expression(operand, annotation, nearest_offset, nearest_name)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(element, annotation, nearest_offset, nearest_name)
                    Expr.DictLit(entries, _):
                        for entry in entries |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(entry.key, annotation, nearest_offset, nearest_name)
                            try_noncall_record_expression(entry.value, annotation, nearest_offset, nearest_name)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        try_noncall_record_expression(type_expression, annotation, nearest_offset, nearest_name)
                        for field in fields |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(field.value, annotation, nearest_offset, nearest_name)
                    Expr.If(condition, then_value, else_value, _):
                        try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(then_value, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(else_value, annotation, nearest_offset, nearest_name)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        try_noncall_record_expression(scrutinee, annotation, nearest_offset, nearest_name)
                        for arm in arms |annotation, nearest_offset, nearest_name|:
                            try_noncall_record_expression(arm.guard, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(arm.body, annotation, nearest_offset, nearest_name)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        try_noncall_record_expression(iterable, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(body, annotation, nearest_offset, nearest_name)
                    Expr.Refinement(base, predicate, _):
                        if annotation.owner == "__try_fallback_expression" and position.line == annotation.line and position.offset == annotation.offset and nearest_offset == 4294967295:
                            # A try fallback puts the guarded operand in the second child.
                            nearest_offset <- Ast::expr_pos(predicate).offset
                            nearest_name <- ""
                            return
                        try_noncall_record_expression(base, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(predicate, annotation, nearest_offset, nearest_name)
                    Expr.GetElse(guarded, recovery, _):
                        try_noncall_record_expression(guarded, annotation, nearest_offset, nearest_name)
                        try_noncall_record_statements(recovery, annotation, nearest_offset, nearest_name)
                    Expr.Block(block_statements, value, _, _):
                        try_noncall_record_statements(block_statements, annotation, nearest_offset, nearest_name)
                        try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                    Expr.Lambda(_, lambda_body, _):
                        try_noncall_record_statements(lambda_body, annotation, nearest_offset, nearest_name)
                    _:
                        pass

        def try_noncall_record_statements(statements: darray[Ast::Stmt], annotation: Ast::EnumAnnotation, nearest_offset: mutable u32&, nearest_name: mutable sview& @source) -> void:
            can Abort.Panic:
                for statement in statements |annotation, nearest_offset, nearest_name|:
                    match statement:
                        Stmt.Expr(expression, _):
                            try_noncall_record_expression(expression, annotation, nearest_offset, nearest_name)
                        Stmt.Assign(target, _, value, _):
                            try_noncall_record_expression(target, annotation, nearest_offset, nearest_name)
                            try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                        Stmt.VarDecl(_, _, value, _):
                            try_noncall_record_expression(value, annotation, nearest_offset, nearest_name)
                        Stmt.Return(value, _):
                            if value is returned:
                                try_noncall_record_expression(returned, annotation, nearest_offset, nearest_name)
                        Stmt.If(condition, then_body, else_body, _):
                            try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(then_body, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(else_body, annotation, nearest_offset, nearest_name)
                        Stmt.While(condition, body, _):
                            try_noncall_record_expression(condition, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.For(_, _, iterable, body, _):
                            try_noncall_record_expression(iterable, annotation, nearest_offset, nearest_name)
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.Block(_, _, _, body, _):
                            try_noncall_record_statements(body, annotation, nearest_offset, nearest_name)
                        Stmt.Match(scrutinee, arms, _):
                            try_noncall_record_expression(scrutinee, annotation, nearest_offset, nearest_name)
                            for arm in arms |annotation, nearest_offset, nearest_name|:
                                try_noncall_record_expression(arm.guard, annotation, nearest_offset, nearest_name)
                                try_noncall_record_statements(arm.body, annotation, nearest_offset, nearest_name)
                        Stmt.Contract(_, expression, _):
                            try_noncall_record_expression(expression, annotation, nearest_offset, nearest_name)
                        _:
                            pass

        def try_parameter_error_family(params: darray[Ast::ParamDecl], parameter_name: sview @source, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source):
            can Abort.Panic:
                parameter_line: mutable u32 = 0
                parameter_offset: mutable u32 = 0
                parameter_found: mutable bool = false
                for parameter in params |parameter_line, parameter_offset, parameter_found, parameter_name|:
                    if parameter.name == parameter_name:
                        parameter_line <- parameter.name_pos.line
                        parameter_offset <- parameter.name_pos.offset
                        parameter_found <- true
                return (false, "") if not parameter_found
                if parameter_offset != 0:
                    invalid_exact: bool = any annotation in annotations where annotation.owner == "__param_error_union_invalid" and annotation.offset == parameter_offset
                    return (false, "") if invalid_exact
                    exact_family: mutable sview @source = ""
                    exact_count: mutable usize = 0
                    for annotation in annotations |exact_family, exact_count, parameter_offset|:
                        if annotation.owner == "__param_error_union" and annotation.offset == parameter_offset:
                            exact_family <- annotation.name if exact_count == 0
                            exact_count <- exact_count + 1.usize()
                    return (true, exact_family) if exact_count == 1
                    return (false, "") if exact_count > 1
                    # A legacy parser row can carry only its line, not the parameter's
                    # identifier offset. Let the line-based path below recover it only
                    # when it can pair every row with one parameter unambiguously.
                invalid_line: bool = any annotation in annotations where annotation.owner == "__param_error_union_invalid" and annotation.line == parameter_line
                return (false, "") if invalid_line
                params_on_line: mutable usize = 0
                for parameter in params |params_on_line, parameter_line|:
                    params_on_line <- params_on_line + 1.usize() if parameter.name_pos.line == parameter_line
                family: mutable sview @source = ""
                family_count: mutable usize = 0
                conflicting_families: mutable bool = false
                for annotation in annotations |family, family_count, conflicting_families, parameter_line|:
                    if annotation.owner == "__param_error_union" and annotation.line == parameter_line:
                        family <- annotation.name if family_count == 0
                        conflicting_families <- true if annotation.name != family
                        family_count <- family_count + 1.usize()
                return (true, "") if family_count == 0
                return (false, "") if family_count != params_on_line or conflicting_families
                return (true, family)

        def try_noncall_rebind_claimed_target(annotations: darray[Ast::EnumAnnotation]&, line: u32, name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__lmut_rebind_claim" and annotation.line == line and annotation.name == name

        def try_noncall_pattern_shadows_name(pattern: Ast::Pattern, candidate: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                binders: mutable darray[sview @source] = []
                gather_arm_pattern(pattern, binders)
                return any binder in binders where binder == candidate

        def try_noncall_gather_catch_arm_pattern(pattern: Ast::Pattern, arm_index: usize, binders: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                # After the success arm, a bare pattern name is a fieldless error variant,
                # not a local binder. Nested variant fields still introduce real binders.
                if arm_index != 0.usize():
                    return if pattern is Pattern.Binding(_)
                    if pattern is Pattern.Or(options):
                        return if options.count == 0
                        first_binders: mutable darray[sview @source] = []
                        gather_arm_pattern(options[0], first_binders) if not (options[0] is Pattern.Binding(_))
                        for binder in first_binders:
                            present_in_every_option: mutable bool = true
                            for option in 1..<options.count:
                                option_binders: mutable darray[sview @source] = []
                                gather_arm_pattern(options[option], option_binders) if not (options[option] is Pattern.Binding(_))
                                present_in_every_option <- false if not any option_binder in option_binders where option_binder == binder
                            binders.push(binder) if present_in_every_option and not any existing in binders where existing == binder
                        return
                gather_arm_pattern(pattern, binders)

        def try_noncall_catch_pattern_shadows_name(pattern: Ast::Pattern, arm_index: usize, candidate: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                binders: mutable darray[sview @source] = []
                try_noncall_gather_catch_arm_pattern(pattern, arm_index, binders)
                return any binder in binders where binder == candidate

        # A deliberately narrow type projection for bindings whose scalar type is
        # explicit in the pattern or recoverable from a typed sequence parameter. The
        # non-call try scan must not keep an outer error family after a pattern shadows
        # that name, but it should still recognize `try` on a known primitive as invalid.
        def try_noncall_type_name_facts(type_name: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                numeric: bool = type_name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64", "char"}
                integer: bool = type_name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr"}
                known_nonfallible: bool = numeric or type_name in {"bool", "string", "cstr", "dstr", "sview"}
                return (known_nonfallible, numeric, integer)

        # The source scan resolves lexically unique aliases whose target is a primitive
        # scalar name or a chain of aliases visible from the current module, optionally
        # under transparent paren or mutability/storage wrappers. Qualified, generic,
        # duplicate, and cyclic aliases stay unknown rather than borrowing another module's
        # spelling.
        def try_noncall_declared_type_facts(type_expression: Ast::Expr) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return try_noncall_type_name_facts(name)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_declared_type_facts(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_declared_type_facts(inner)
                    _:
                        return (false, false, false)

        def try_noncall_declared_type_alias_target(type_expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_declared_type_alias_target(inner)
                    Expr.Paren(inner, _):
                        return try_noncall_declared_type_alias_target(inner)
                    _:
                        return ""

        def try_noncall_type_alias_declaration_is_static_inactive(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, alias_name: sview, current_module: sview, declaration_line: u32, declaration_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                unresolved_branch: mutable bool = false
                # One marker is emitted per ancestor, outer-to-inner. A selected or
                # unknown outer row cannot decide whether a later inner row is inactive.
                for marker in annotations |file, table, alias_name, current_module, declaration_line, declaration_offset, unresolved_branch|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__type_alias_static_branch" or marker.detail_name != alias_name or marker.module != current_module or marker.line != declaration_line or marker.offset != declaration_offset
                    if marker.identity_id == 4294967295:
                        unresolved_branch <- true
                        continue
                    branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    return true if branch.known and not branch.selected
                    unresolved_branch <- true if not branch.known
                return false if unresolved_branch
                return false

        def try_noncall_static_scope_is_inactive(file: Ast::File&, scope_position: Ast::Pos, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                branch_row: usize = pma_static_if_row_for_position(file, scope_position)
                return false if branch_row >= file.static_if_lines.count
                branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                return branch.known and not branch.selected

        def try_noncall_type_alias_facts_add(file: Ast::File&, declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, environment: mutable TryNonCallErrorFamilyEnv&, current_module: sview, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |file, annotations, environment, current_module, table|:
                    match declaration:
                        Decl.Alias(alias_name, target, alias_position) if target is not Expr.Invalid:
                            continue if try_noncall_type_alias_declaration_is_static_inactive(file, annotations, alias_name, current_module, alias_position.line, alias_position.offset, table)
                            target_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_declared_type_facts(target)
                            environment.type_alias_names.push(alias_name)
                            environment.type_alias_modules.push(current_module)
                            environment.type_alias_target_names.push(try_noncall_declared_type_alias_target(target))
                            environment.type_alias_known_nonfallible.push(target_facts.known_nonfallible)
                            environment.type_alias_numeric.push(target_facts.numeric)
                            environment.type_alias_integer.push(target_facts.integer)
                        Decl.Struct(type_name, _, _, _, _, _, _):
                            environment.non_alias_type_names.push(type_name)
                            environment.non_alias_type_modules.push(current_module)
                        Decl.Enum(type_name, _, _, _, _):
                            environment.non_alias_type_names.push(type_name)
                            environment.non_alias_type_modules.push(current_module)
                        Decl.Module(module_name, module_body, _):
                            # Decl.Module names are canonical qualified AST paths;
                            # try_noncall_module_path remains for relative imports.
                            nested_module: sview @source = module_name
                            try_noncall_type_alias_facts_add(file, module_body, annotations, environment, nested_module, table)
                        Decl.Scoped(scoped_body, scope_position):
                            continue if try_noncall_static_scope_is_inactive(file, scope_position, current_module, table)
                            try_noncall_type_alias_facts_add(file, scoped_body, annotations, environment, current_module, table)
                        _:
                            pass

        def try_noncall_type_alias_facts(alias_name: sview, environment: TryNonCallErrorFamilyEnv&, depth: u32, lookup_module: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                return (false, false, false) if depth > 64
                match_count: mutable usize = 0
                alias_index: mutable usize = 0
                scope_module: mutable sview = lookup_module
                scope_found: mutable bool = false
                while not scope_found |match_count, alias_index, scope_module, scope_found, environment, alias_name|:
                    local_type_shadows_name: mutable bool = false
                    for index in 0..<environment.non_alias_type_names.count |local_type_shadows_name, environment, alias_name, scope_module|:
                        local_type_shadows_name <- true if environment.non_alias_type_names[index] == alias_name and environment.non_alias_type_modules[index] == scope_module
                    return (false, false, false) if local_type_shadows_name
                    for index in 0..<environment.type_alias_names.count |match_count, alias_index, environment, alias_name, scope_module|:
                        if environment.type_alias_names[index] == alias_name and environment.type_alias_modules[index] == scope_module:
                            match_count <- match_count + 1.usize()
                            alias_index <- index
                    scope_found <- match_count > 0.usize()
                    if not scope_found:
                        if scope_module == "":
                            scope_found <- true
                        else:
                            scope_module <- try_noncall_module_parent(scope_module)
                return (false, false, false) if match_count != 1.usize()
                alias_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = (environment.type_alias_known_nonfallible[alias_index], environment.type_alias_numeric[alias_index], environment.type_alias_integer[alias_index])
                return alias_facts if alias_facts.known_nonfallible or alias_facts.numeric or alias_facts.integer
                target_name: sview = environment.type_alias_target_names[alias_index] if alias_index < environment.type_alias_target_names.count else ""
                return try_noncall_type_alias_facts(target_name, environment, depth + 1, environment.type_alias_modules[alias_index]) if target_name != ""
                return alias_facts

        def try_noncall_type_facts_with_aliases_at(type_expression: Ast::Expr, environment: TryNonCallErrorFamilyEnv&, lookup_module: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                direct_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_declared_type_facts(type_expression)
                return direct_facts if direct_facts.known_nonfallible
                match type_expression:
                    Expr.Ident(alias_name, _):
                        return try_noncall_type_alias_facts(alias_name, environment, 0, lookup_module)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return try_noncall_type_facts_with_aliases_at(inner, environment, lookup_module)
                    Expr.Paren(inner, _):
                        return try_noncall_type_facts_with_aliases_at(inner, environment, lookup_module)
                    _:
                        pass
                return (false, false, false)

        def try_noncall_type_facts_with_aliases(type_expression: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                return try_noncall_type_facts_with_aliases_at(type_expression, environment, environment.current_module)

        def try_noncall_function_return_is_generic(annotations: darray[Ast::EnumAnnotation]&, type_expression: Ast::Expr, function_position: Ast::Pos, current_module: sview @source) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, _):
                        for annotation in annotations |type_name, function_position, current_module|:
                            return true if annotation.owner == type_name and annotation.name == "__generic_param_identity" and annotation.detail_line == function_position.line and annotation.offset == function_position.offset and annotation.module == current_module
                    _:
                        pass
                return false

        def try_noncall_generic_return_formal(params: darray[Ast::ParamDecl] @source, type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, function_position: Ast::Pos, current_module: sview @source) -> (name: sview @source, index: usize):
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(return_name, _) if try_noncall_function_return_is_generic(annotations, type_expression, function_position, current_module):
                        match_count: mutable usize = 0
                        formal_name: mutable sview @source = ""
                        formal_index: mutable usize = 0
                        for index in 0..<params.count |match_count, formal_name, formal_index, params, return_name|:
                            if params[index].type_expression is Expr.Ident(parameter_type, _) and parameter_type == return_name:
                                match_count <- match_count + 1.usize()
                                formal_name <- params[index].name
                                formal_index <- index
                        return (formal_name, formal_index) if match_count == 1.usize()
                    _:
                        pass
                return ("", 0.usize())

        # Marker rows grouped by offset (each chain ascending) plus the offset-less rows.
        struct TryMarkerOffsetIndex:
            heads: mutable dict[u32, u32] = {}
            tails: mutable dict[u32, u32] = {}
            next: mutable darray[u32] = []
            no_offset_rows: mutable darray[u32] = []

        def try_noncall_marker_offset_index(markers: darray[Ast::EnumAnnotation]&, index: mutable TryMarkerOffsetIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in 0..<markers.count |index, markers|:
                    index.next.push(SYMBOL_INDEX_ROW_NONE)
                    offset: u32 = markers[row].offset
                    if offset == FALLIBLE_FUNCTION_NO_OFFSET:
                        index.no_offset_rows.push(row.u32())
                    else:
                        if index.tails.get(offset) is tail_row:
                            index.next[tail_row.usize()] <- row.u32()
                        else:
                            index.heads <- index.heads.put(offset, row.u32()) can Global{Read,Write}
                        index.tails <- index.tails.put(offset, row.u32()) can Global{Read,Write}

        # The marker rows a declaration at OFFSET can match, in marker order: rows at that
        # offset, offset-less rows (matched by line), and the row after each kept
        # `__error_return`, so callable_error_family_row still sees its true successor.
        # Every per-declaration marker test either requires an equal offset or falls back
        # to the line for offset-less rows, so this subset gives the same answers. An
        # unknown declaration offset keeps every row.
        def try_noncall_declaration_markers(markers: darray[Ast::EnumAnnotation]&, index: TryMarkerOffsetIndex&, offset: u32) -> darray[Ast::EnumAnnotation]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[Ast::EnumAnnotation] = []
                if offset == FALLIBLE_FUNCTION_NO_OFFSET or index.next.count != markers.count:
                    for marker in markers |result|:
                        result.push(marker)
                    return result
                cursor: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if index.heads.get(offset) is head:
                    cursor <- head
                loose: mutable usize = 0
                next_free: mutable usize = 0
                while cursor != SYMBOL_INDEX_ROW_NONE or loose < index.no_offset_rows.count |cursor, loose, next_free, result, markers, index|:
                    row: mutable usize = 0
                    if cursor != SYMBOL_INDEX_ROW_NONE and (loose >= index.no_offset_rows.count or cursor < index.no_offset_rows[loose]):
                        row <- cursor.usize()
                        cursor <- index.next[cursor.usize()]
                    else:
                        row <- index.no_offset_rows[loose].usize()
                        loose <- loose + 1
                    continue if row < next_free
                    result.push(markers[row])
                    next_free <- row + 1
                    if markers[row].name == "__error_return" and row + 1 < markers.count:
                        result.push(markers[row + 1])
                        next_free <- row + 2
                return result

        # Callable fact collection reads only declaration markers: static-branch rows,
        # visibility sections, variadic rows, generic-parameter identities, and each
        # `__error_return` row with the family row that follows it. Keeping those rows in
        # order (a family row stays directly after its marker) lets each function declaration
        # scan this short list instead of every annotation in the file.
        def try_noncall_callable_marker_annotations(annotations: darray[Ast::EnumAnnotation]&) -> darray[Ast::EnumAnnotation]:
            can Memory.Allocate, Abort.Panic:
                keep: mutable darray[bool] = []
                for row in 0..<annotations.count |keep, annotations|:
                    keep.push(false)
                for row in 0..<annotations.count |keep, annotations|:
                    annotation: Ast::EnumAnnotation = annotations[row]
                    if annotation.name == "__error_return":
                        keep[row] <- true
                        keep[row + 1.usize()] <- true if row + 1.usize() < annotations.count
                    elif annotation.name == "__generic_param_identity" or annotation.owner == "__try_inactive_function" or annotation.owner == "__try_unresolved_function" or annotation.owner == "__section_private" or annotation.owner == "__section_public" or annotation.owner == "__variadic":
                        keep[row] <- true
                result: mutable darray[Ast::EnumAnnotation] = []
                for row in 0..<annotations.count |result, annotations, keep|:
                    result.push(annotations[row]) if keep[row]
                return result

        def try_noncall_callable_facts_add(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, marker_index: TryMarkerOffsetIndex&, environment: mutable TryNonCallErrorFamilyEnv&, current_module: sview @source, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |annotations, marker_index, environment, current_module, table|:
                    match declaration:
                        Decl.Func(name, params, return_type, _, _, _, function_position):
                            # Only rows at this declaration's offset (plus offset-less rows and each
                            # `__error_return` successor) can match its markers; see
                            # try_noncall_declaration_markers. Unknown offsets keep the full list.
                            declaration_rows: darray[Ast::EnumAnnotation] = try_noncall_declaration_markers(annotations, marker_index, function_position.offset)
                            continue if callable_function_declaration_is_static_inactive(declaration_rows, name, current_module, function_position.line, function_position.offset)
                            unresolved_static_branch: bool = callable_function_declaration_is_static_unresolved(declaration_rows, name, current_module, function_position.line, function_position.offset)
                            family: mutable sview @source = ""
                            family_rows: mutable usize = 0
                            for row in 0..<declaration_rows.count |family, family_rows, declaration_rows, name, function_position|:
                                marker: Ast::EnumAnnotation = declaration_rows[row]
                                same_declaration: bool = marker.offset == function_position.offset if marker.offset != FALLIBLE_FUNCTION_NO_OFFSET and function_position.offset != FALLIBLE_FUNCTION_NO_OFFSET else marker.line == function_position.line
                                if marker.owner == name and marker.name == "__error_return" and same_declaration and row + 1.usize() < declaration_rows.count and callable_error_family_row(declaration_rows, row + 1.usize()):
                                    family <- declaration_rows[row + 1.usize()].name if family_rows == 0 and not unresolved_static_branch
                                    family_rows <- family_rows + 1.usize()
                            return_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = (false, false, false)
                            if return_type is function_return_type and not try_noncall_function_return_is_generic(declaration_rows, function_return_type, function_position, current_module):
                                return_facts <- try_noncall_type_facts_with_aliases_at(function_return_type, environment, current_module)
                            generic_return_formal: mutable (name: sview @source, index: usize) = ("", 0.usize())
                            generic_return_formal <- try_noncall_generic_return_formal(params, function_return_type, declaration_rows, function_position, current_module) if return_type is function_return_type
                            first_param_name: mutable sview @source = ""
                            first_param_type_name: mutable sview @source = ""
                            first_param_is_generic: mutable bool = false
                            has_default_param: mutable bool = false
                            variadic: mutable bool = false
                            for parameter in params |has_default_param|:
                                has_default_param <- true if parameter.has_default
                            for marker in declaration_rows |variadic, function_position|:
                                variadic <- true if marker.owner == "__variadic" and marker.line == function_position.line and marker.offset == function_position.offset
                            if params.count > 0.usize():
                                first_param_name <- params[0.usize()].name
                                match params[0.usize()].type_expression:
                                    Expr.Ident(parameter_type, _):
                                        first_param_type_name <- parameter_type
                                        first_param_is_generic <- try_noncall_function_return_is_generic(declaration_rows, params[0.usize()].type_expression, function_position, current_module)
                                    _:
                                        pass
                            callable_visible: bool = callable_function_declaration_visible_with(declaration_rows, annotations, name, current_module, function_position.line, function_position.offset, environment.current_module)
                            environment.callable_names.push(name)
                            environment.callable_modules.push(current_module)
                            environment.callable_families.push(family)
                            environment.callable_visible.push(callable_visible)
                            # Visibility is tracked separately so hidden registrations can
                            # block legacy name-only fallback without blocking a later
                            # visible candidate. A visible function with ambiguous
                            # ErrorSet rows remains an unknown candidate.
                            environment.callable_facts_known.push(not unresolved_static_branch and family_rows <= 1.usize())
                            environment.callable_return_nonfallible.push(return_facts.known_nonfallible)
                            environment.callable_numeric.push(return_facts.numeric)
                            environment.callable_integer.push(return_facts.integer)
                            environment.callable_first_param_names.push(first_param_name)
                            environment.callable_first_param_type_names.push(first_param_type_name)
                            environment.callable_first_param_generic.push(first_param_is_generic)
                            environment.callable_max_param_counts.push(params.count)
                            environment.callable_has_default_params.push(has_default_param)
                            environment.callable_variadic.push(variadic)
                            environment.callable_generic_return_formal_names.push(generic_return_formal.name)
                            environment.callable_generic_return_formal_indices.push(generic_return_formal.index)
                        Decl.Module(module_name, module_body, _):
                            # Decl.Module names are canonical qualified AST paths;
                            # try_noncall_module_path remains for relative imports.
                            nested_module: sview @source = module_name
                            try_noncall_callable_facts_add(module_body, annotations, marker_index, environment, nested_module, table)
                        Decl.Scoped(scoped_body, _):
                            try_noncall_callable_facts_add(scoped_body, annotations, marker_index, environment, current_module, table)
                        _:
                            pass

        # A qualified callee keeps exact module identity: one-segment names are
        # checked against each lexical namespace and then the root path, never a
        # candidate's final segment alone. Analyzer-wide aliases are handled after
        # the lexical paths by the cached caller.
        def try_noncall_qualifier_path_matches_module(qualifier: Ast::Expr, module_path: sview, lexical_scope: sview) -> bool:
            can Abort.Panic:
                match qualifier:
                    Expr.Ident(name, _):
                        return module_path == name if lexical_scope == ""
                        return callable_module_path_matches_suffix(module_path, lexical_scope, name)
                    Expr.Scope(base, name, _):
                        separator: mutable usize = module_path.len
                        offset: mutable usize = 0
                        while offset + 1.usize() < module_path.len |separator, offset|:
                            separator <- offset if module_path[offset] == 58 and module_path[offset + 1.usize()] == 58
                            offset <- offset + 1.usize()
                        return false if separator == module_path.len
                        return false if module_path[separator + 2.usize():module_path.len] != name
                        return try_noncall_qualifier_path_matches_module(base, module_path[0:separator], lexical_scope)
                    Expr.Paren(inner, _):
                        return try_noncall_qualifier_path_matches_module(inner, module_path, lexical_scope)
                    _:
                        return false

        def try_noncall_qualifier_first_segment(qualifier: Ast::Expr) -> sview:
            can Abort.Panic:
                match qualifier:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(base, _, _):
                        return try_noncall_qualifier_first_segment(base)
                    Expr.Paren(inner, _):
                        return try_noncall_qualifier_first_segment(inner)
                    _:
                        return ""

        # Ordinary cached lookup skips inaccessible declarations; the overload
        # blocker passes include_hidden=true to see whether a private candidate belongs
        # to the same qualified module path and could win receiver ranking.
        def try_noncall_qualified_module_matches(callee: Ast::Expr, module_path: sview, callee_name: sview, environment: TryNonCallErrorFamilyEnv&, include_hidden: bool) -> bool:
            can Abort.Panic:
                match callee:
                    Expr.Scope(qualifier, _, _):
                        scope_module: mutable sview = environment.current_module
                        while scope_module != "" |scope_module, module_path, callee_name, qualifier, environment, include_hidden|:
                            first_lexical_module: mutable sview = ""
                            for index in 0..<environment.callable_names.count |first_lexical_module, module_path, callee_name, qualifier, scope_module, environment, include_hidden|:
                                continue if environment.callable_names[index] != callee_name or (not include_hidden and not environment.callable_visible[index])
                                if try_noncall_qualifier_path_matches_module(qualifier, environment.callable_modules[index], scope_module):
                                    first_lexical_module <- environment.callable_modules[index]
                                    break
                            return module_path == first_lexical_module if first_lexical_module != ""
                            scope_module <- try_noncall_module_parent(scope_module)
                        alias_head: sview = try_noncall_qualifier_first_segment(qualifier)
                        for alias_index in 0..<environment.using_alias_names.count |module_path, callee_name, qualifier, alias_head, environment, include_hidden|:
                            continue if environment.using_alias_names[alias_index] != alias_head
                            return false if alias_index >= environment.using_alias_known.count or not environment.using_alias_known[alias_index]
                            alias_candidate_module: mutable sview = ""
                            for index in 0..<environment.callable_names.count |alias_candidate_module, callee_name, qualifier, environment, alias_index, include_hidden|:
                                continue if environment.callable_names[index] != callee_name or (not include_hidden and not environment.callable_visible[index])
                                if try_noncall_callable_matches_using_alias(callee, alias_index, environment.callable_modules[index], environment):
                                    alias_candidate_module <- environment.callable_modules[index]
                                    break
                            return module_path == alias_candidate_module if alias_candidate_module != ""
                            break
                        return try_noncall_qualifier_path_matches_module(qualifier, module_path, "")
                    Expr.Paren(inner, _):
                        return try_noncall_qualified_module_matches(inner, module_path, callee_name, environment, include_hidden)
                    _:
                        return false
