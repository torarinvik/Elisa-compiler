extend Semantic:
    private:
        def try_noncall_scan_expression(expression: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: mutable TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&, annotation: Ast::EnumAnnotation, site_offset: u32, current_shadow: bool, current_local_error_family: sview @source, found: mutable bool&, shadowed_at_site: mutable bool&, local_error_family_at_site: mutable sview& @source, lambda_error_family_at_site: mutable sview& @source, inside_lambda_at_site: mutable bool&, known_nonfallible_at_site: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if found == true
                local_shadow: mutable bool = current_shadow
                local_error_family: mutable sview @source = current_local_error_family
                position: Ast::Pos = Ast::expr_pos(expression)
                if position.line == annotation.line and position.offset == site_offset:
                    found <- true
                    shadowed_at_site <- local_shadow
                    local_error_family_at_site <- local_error_family
                    known_nonfallible_at_site <- try_noncall_family_known_nonfallible(environment, candidate) if candidate != ""
                    if candidate == "":
                        source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(expression, params, environment, annotations)
                        local_error_family_at_site <- source_facts.family
                        known_nonfallible_at_site <- source_facts.known_nonfallible
                    return
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        try_noncall_scan_expression(callee, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for argument in arguments |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(argument, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        for effect_candidate in candidates |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            for capture in effect_candidate.captures |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                                return if found == true
                                try_noncall_scan_expression(capture, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for argument in arguments |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(argument, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Binary(left, operator, right, _):
                        try_noncall_scan_expression(left, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        right_shadow: mutable bool = local_shadow
                        right_error_family: mutable sview @source = local_error_family
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        right_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        if operator == TokenKind.And and try_noncall_truthy_condition_binds_name(left, candidate, annotations):
                            right_shadow <- true
                            right_error_family <- ""
                            condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(left, candidate, params, annotations)
                            try_noncall_family_bind(right_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                        try_noncall_scan_expression(right, candidate, params, right_environment, annotations, annotation, site_offset, right_shadow, right_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        if operator == TokenKind.And or operator == TokenKind.Or:
                            try_noncall_family_join_into(environment, base_environment, base_environment, right_environment, visible_count)
                        else:
                            try_noncall_family_join_into(environment, base_environment, right_environment, right_environment, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, right_environment, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Paren(inner, _):
                        try_noncall_scan_expression(inner, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Index(object, index, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(index, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.IndexN(object, arguments, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for argument in arguments |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(argument, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Slice(object, low, high, _):
                        try_noncall_scan_expression(object, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(low, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(high, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        try_noncall_scan_expression(operand, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(element, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.DictLit(entries, _):
                        for entry in entries |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(entry.key, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_scan_expression(entry.value, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        try_noncall_scan_expression(type_expression, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        for field in fields |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            return if found == true
                            try_noncall_scan_expression(field.value, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.If(condition, then_value, else_value, _):
                        try_noncall_scan_expression(condition, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        then_shadow: mutable bool = current_shadow
                        then_error_family: mutable sview @source = current_local_error_family
                        then_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        else_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        if try_noncall_truthy_condition_binds_name(condition, candidate, annotations):
                            then_shadow <- true
                            then_error_family <- ""
                            condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, candidate, params, annotations)
                            try_noncall_family_bind(then_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                        try_noncall_scan_expression(then_value, candidate, params, then_environment, annotations, annotation, site_offset, then_shadow, then_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(else_value, candidate, params, else_environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_family_join_into(environment, base_environment, then_environment, else_environment, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, then_environment, candidate) or try_noncall_family_branch_wrote(base_environment, else_environment, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Match(scrutinee, arms, _):
                        try_noncall_scan_expression(scrutinee, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        scrutinee_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(scrutinee, params, base_environment)
                        merged_arms: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                        merged_ready: mutable bool = false
                        candidate_wrote: mutable bool = false
                        for arm in arms |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site, scrutinee_facts|:
                            return if found == true
                            binds_candidate: bool = try_noncall_pattern_shadows_name(arm.pattern, candidate)
                            arm_shadow: bool = current_shadow or binds_candidate
                            arm_error_family: sview @source = "" if binds_candidate else current_local_error_family
                            arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if binds_candidate:
                                pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, candidate)
                                binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                binder_facts <- scrutinee_facts if not pattern_facts.known_nonfallible and not pattern_facts.numeric and not pattern_facts.integer
                                try_noncall_family_bind(arm_environment, candidate, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                            try_noncall_scan_expression(arm.guard, candidate, params, arm_environment, annotations, annotation, site_offset, arm_shadow, arm_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            guard_binds_candidate: bool = try_noncall_truthy_condition_binds_name(arm.guard, candidate, annotations)
                            body_shadow: bool = arm_shadow or guard_binds_candidate
                            body_error_family: sview @source = "" if guard_binds_candidate else arm_error_family
                            if guard_binds_candidate:
                                guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, candidate, params, annotations)
                                try_noncall_family_bind(arm_environment, candidate, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                            try_noncall_scan_statements(arm.body, candidate, params, arm_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            candidate_wrote <- true if try_noncall_family_branch_wrote(base_environment, arm_environment, candidate)
                            if not merged_ready:
                                merged_arms <- try_noncall_family_clone(arm_environment)
                                merged_ready <- true
                            else:
                                prior_merged: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(merged_arms)
                                merged_arms <- try_noncall_family_clone(base_environment)
                                try_noncall_family_join_into(merged_arms, base_environment, prior_merged, arm_environment, visible_count)
                        if merged_ready:
                            try_noncall_family_join_into(environment, base_environment, base_environment, merged_arms, visible_count)
                            if candidate_wrote:
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Catch(guarded, arms, _):
                        try_noncall_scan_expression(guarded, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        payload_facts: (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(guarded, params, base_environment, annotations)
                        merged_arms: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        candidate_wrote: mutable bool = false
                        arm_index: mutable usize = 0.usize()
                        for arm in arms |found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site, arm_index|:
                            return if found == true
                            binds_candidate: bool = try_noncall_catch_pattern_shadows_name(arm.pattern, arm_index, candidate)
                            arm_shadow: bool = current_shadow or binds_candidate
                            arm_error_family: sview @source = "" if binds_candidate else current_local_error_family
                            arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if binds_candidate:
                                pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, candidate)
                                if arm_index == 0.usize() and arm.pattern is Pattern.Binding(success_name) and success_name == candidate:
                                    try_noncall_family_bind(arm_environment, candidate, payload_facts.family, payload_facts.known_nonfallible, payload_facts.numeric, payload_facts.integer)
                                else:
                                    try_noncall_family_bind(arm_environment, candidate, "", pattern_facts.known_nonfallible, pattern_facts.numeric, pattern_facts.integer)
                            try_noncall_scan_expression(arm.guard, candidate, params, arm_environment, annotations, annotation, site_offset, arm_shadow, arm_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            guard_binds_candidate: bool = try_noncall_truthy_condition_binds_name(arm.guard, candidate, annotations)
                            body_shadow: bool = arm_shadow or guard_binds_candidate
                            body_error_family: sview @source = "" if guard_binds_candidate else arm_error_family
                            if guard_binds_candidate:
                                guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, candidate, params, annotations)
                                try_noncall_family_bind(arm_environment, candidate, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                            try_noncall_scan_statements(arm.body, candidate, params, arm_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            candidate_wrote <- true if try_noncall_family_branch_wrote(base_environment, arm_environment, candidate)
                            prior_merged: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(merged_arms)
                            merged_arms <- try_noncall_family_clone(base_environment)
                            try_noncall_family_join_into(merged_arms, base_environment, prior_merged, arm_environment, visible_count)
                            arm_index <- arm_index + 1.usize()
                        if arms.count > 0:
                            try_noncall_family_join_into(environment, base_environment, base_environment, merged_arms, visible_count)
                            if candidate_wrote:
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        try_noncall_scan_expression(iterable, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        comprehension_binds_candidate: bool = variable == candidate
                        comprehension_shadow: bool = current_shadow or comprehension_binds_candidate
                        comprehension_error_family: sview @source = "" if comprehension_binds_candidate else current_local_error_family
                        comprehension_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        try_noncall_family_bind(comprehension_environment, variable, "", false) if variable != ""
                        try_noncall_scan_expression(condition, candidate, params, comprehension_environment, annotations, annotation, site_offset, comprehension_shadow, comprehension_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(body, candidate, params, comprehension_environment, annotations, annotation, site_offset, comprehension_shadow, comprehension_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.Refinement(base, predicate, _):
                        if annotation.owner == "__try_fallback_expression" and position.line == annotation.line and position.offset == annotation.offset:
                            try_noncall_scan_expression(predicate, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            return
                        try_noncall_scan_expression(base, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(predicate, candidate, params, environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                    Expr.GetElse(guarded, recovery, _):
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        guarded_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                        recovery_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        try_noncall_scan_expression(guarded, candidate, params, guarded_environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_statements(recovery, candidate, params, recovery_environment, annotations, annotation, site_offset, current_shadow, current_local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_family_join_into(environment, base_environment, guarded_environment, recovery_environment, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, guarded_environment, candidate) or try_noncall_family_branch_wrote(base_environment, recovery_environment, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Block(block_statements, value, _, _):
                        visible_count: usize = environment.names.count
                        base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        block_families: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        block_environment: (shadow: bool, local_error_family: sview @source) = try_noncall_scan_statements(block_statements, candidate, params, block_families, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_scan_expression(value, candidate, params, block_families, annotations, annotation, site_offset, block_environment.shadow, block_environment.local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        try_noncall_family_join_into(environment, base_environment, block_families, block_families, visible_count)
                        if try_noncall_family_branch_wrote(base_environment, block_families, candidate):
                            local_shadow <- true
                            local_error_family <- try_noncall_family_lookup(environment, candidate)
                    Expr.Lambda(lambda_parameters, lambda_body, _):
                        lambda_shadow: mutable bool = current_shadow
                        lambda_error_family: mutable sview @source = local_error_family
                        lambda_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                        lambda_position: Ast::Pos = Ast::expr_pos(expression)
                        lambda_destination_family: sview @source = try_noncall_lambda_error_family(annotations, lambda_position.offset)
                        for parameter in lambda_parameters |lambda_shadow, lambda_error_family, lambda_environment, candidate, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                            # Lambda parameters have names but no parameter type rows in
                            # this AST. Contextual typing may make them fallible, so do not
                            # classify an unknown parameter as a known scalar.
                            try_noncall_family_bind(lambda_environment, parameter, "", false)
                            if parameter == candidate:
                                lambda_shadow <- true
                                lambda_error_family <- ""
                        try_noncall_scan_statements(lambda_body, candidate, params, lambda_environment, annotations, annotation, site_offset, lambda_shadow, lambda_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        if found == true and inside_lambda_at_site == false:
                            inside_lambda_at_site <- true
                            lambda_error_family_at_site <- lambda_destination_family
                    _:
                        pass

        # Scan statements in order and pass only bindings active along the path containing
        # the operand. Later declarations and sibling blocks do not shadow an earlier use.
        def try_noncall_scan_statements(statements: darray[Ast::Stmt], candidate: sview, params: darray[Ast::ParamDecl], environment: mutable TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&, annotation: Ast::EnumAnnotation, site_offset: u32, inherited_shadow: bool, inherited_local_error_family: sview @source, found: mutable bool&, shadowed_at_site: mutable bool&, local_error_family_at_site: mutable sview& @source, lambda_error_family_at_site: mutable sview& @source, inside_lambda_at_site: mutable bool&, known_nonfallible_at_site: mutable bool&) -> (shadow: bool, local_error_family: sview @source):
            can Memory.Allocate, Abort.Panic:
                local_shadow: mutable bool = inherited_shadow
                local_error_family: mutable sview @source = inherited_local_error_family
                for statement in statements |local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site|:
                    return (local_shadow, local_error_family) if found == true
                    match statement:
                        Stmt.Expr(expression, _):
                            expression_base: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            try_noncall_scan_expression(expression, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            if try_noncall_family_branch_wrote(expression_base, environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.VarDecl(name, type_expression, value, position):
                            try_noncall_scan_expression(value, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            declared_family: mutable sview @source = try_noncall_local_error_family(annotations, position.offset)
                            payload_facts: (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_assignment_catch_payload_facts(value, params, environment, annotations)
                            declared_type_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_type_facts_with_aliases(type_expression, environment)
                            declared_known_nonfallible: mutable bool = declared_type_facts.known_nonfallible
                            declared_numeric: mutable bool = declared_type_facts.numeric
                            declared_integer: mutable bool = declared_type_facts.integer
                            if declared_family == "" and type_expression is Expr.Absent:
                                source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(value, params, environment, annotations)
                                declared_family <- source_facts.family
                                declared_known_nonfallible <- source_facts.known_nonfallible
                                declared_numeric <- try_noncall_numeric_value(value, params, environment)
                                declared_integer <- try_noncall_integer_value(value, params, environment)
                            try_noncall_family_bind(environment, name, declared_family, declared_known_nonfallible, declared_numeric, declared_integer, payload_facts.family, payload_facts.known_nonfallible, payload_facts.numeric, payload_facts.integer)
                            if name == candidate:
                                local_shadow <- true
                                local_error_family <- declared_family
                        Stmt.Assign(target, operator, value, assignment_position):
                            try_noncall_scan_expression(value, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            assignment_source_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            assigned_facts: (found: bool, family: sview, known_nonfallible: bool) = try_noncall_target_source_facts(target, value, candidate, params, assignment_source_environment, annotations) if operator == TokenKind.Assign else (false, "", false)
                            assigned_numeric_facts: (found: bool, numeric: bool) = try_noncall_target_numeric_value(target, value, candidate, params, assignment_source_environment) if operator == TokenKind.Assign else (false, false)
                            assigned_integer_facts: (found: bool, integer: bool) = try_noncall_target_integer_value(target, value, candidate, params, assignment_source_environment) if operator == TokenKind.Assign else (false, false)
                            # Use the stable scanner environment for source views; the
                            # cloned assignment snapshot remains the authority for the
                            # parallel RHS-family and numeric facts below.
                            assigned_payload_facts: (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_assignment_catch_payload_facts(value, params, environment, annotations)
                            if operator == TokenKind.Assign:
                                assignment_updates: mutable TryNonCallAssignmentUpdates = TryNonCallAssignmentUpdates{}
                                try_noncall_collect_assignment_targets(target, value, candidate, params, &assignment_updates, assignment_source_environment, annotations, assignment_position.line)
                                try_noncall_apply_assignment_updates(assignment_updates, environment)
                            try_noncall_scan_expression(target, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            if assigned_facts.found:
                                existing_index: usize = try_noncall_family_index(environment, candidate)
                                rebind_claim: bool = try_noncall_rebind_claimed_target(annotations, assignment_position.line, candidate)
                                preserve_existing: bool = rebind_claim and existing_index < environment.names.count
                                assigned_family: sview @source = environment.families[existing_index] if preserve_existing else assigned_facts.family
                                assigned_known_nonfallible: bool = environment.known_nonfallible[existing_index] if preserve_existing else assigned_facts.known_nonfallible
                                assigned_origin: usize = environment.origins[existing_index] if preserve_existing else environment.names.count
                                assigned_numeric: bool = environment.numeric[existing_index] if preserve_existing else assigned_numeric_facts.numeric
                                assigned_integer: bool = environment.integer[existing_index] if preserve_existing else assigned_integer_facts.integer
                                assigned_payload_family: sview @source = environment.catch_payload_families[existing_index] if preserve_existing else assigned_payload_facts.family
                                assigned_payload_known_nonfallible: bool = environment.catch_payload_known_nonfallible[existing_index] if preserve_existing else assigned_payload_facts.known_nonfallible
                                assigned_payload_numeric: bool = environment.catch_payload_numeric[existing_index] if preserve_existing else assigned_payload_facts.numeric
                                assigned_payload_integer: bool = environment.catch_payload_integer[existing_index] if preserve_existing else assigned_payload_facts.integer
                                try_noncall_family_bind_with_origin(environment, candidate, assigned_family, assigned_known_nonfallible, assigned_origin, assigned_numeric, assigned_integer, assigned_payload_family, assigned_payload_known_nonfallible, assigned_payload_numeric, assigned_payload_integer)
                                if not preserve_existing:
                                    local_shadow <- true
                                    local_error_family <- assigned_family
                        Stmt.Return(value, _):
                            if value is returned:
                                try_noncall_scan_expression(returned, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        Stmt.If(condition, then_body, else_body, _):
                            try_noncall_scan_expression(condition, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            then_shadow: mutable bool = local_shadow
                            then_error_family: mutable sview @source = local_error_family
                            then_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            else_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if try_noncall_truthy_condition_binds_name(condition, candidate, annotations):
                                then_shadow <- true
                                then_error_family <- ""
                                condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, candidate, params, annotations)
                                try_noncall_family_bind(then_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                            try_noncall_scan_statements(then_body, candidate, params, then_environment, annotations, annotation, site_offset, then_shadow, then_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_scan_statements(else_body, candidate, params, else_environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_family_join_into(environment, base_environment, then_environment, else_environment, visible_count)
                            if try_noncall_family_branch_wrote(base_environment, then_environment, candidate) or try_noncall_family_branch_wrote(base_environment, else_environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.While(condition, body, _):
                            try_noncall_scan_expression(condition, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            body_shadow: mutable bool = local_shadow
                            body_error_family: mutable sview @source = local_error_family
                            loop_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            if try_noncall_truthy_condition_binds_name(condition, candidate, annotations):
                                body_shadow <- true
                                body_error_family <- ""
                                condition_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(condition, candidate, params, annotations)
                                try_noncall_family_bind(loop_environment, candidate, "", condition_facts.known_nonfallible, condition_facts.numeric, condition_facts.integer)
                            try_noncall_scan_statements(body, candidate, params, loop_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_family_join_into(environment, base_environment, base_environment, loop_environment, visible_count)
                            if try_noncall_family_branch_wrote(base_environment, loop_environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.For(_, variables, iterable, body, _):
                            try_noncall_scan_expression(iterable, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            loop_binds_name: bool = any variable in variables where variable == candidate
                            loop_shadow: bool = local_shadow or loop_binds_name
                            loop_error_family: mutable sview @source = local_error_family
                            loop_error_family <- "" if loop_binds_name
                            loop_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            for variable in variables |loop_environment|:
                                try_noncall_family_bind(loop_environment, variable, "")
                            try_noncall_scan_statements(body, candidate, params, loop_environment, annotations, annotation, site_offset, loop_shadow, loop_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            try_noncall_family_join_into(environment, base_environment, base_environment, loop_environment, visible_count)
                            if not loop_binds_name and try_noncall_family_branch_wrote(base_environment, loop_environment, candidate):
                                local_shadow <- true
                                local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.Block(kind, _, binding, body, _):
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            block_shadow: bool = local_shadow or binding == candidate
                            block_error_family: mutable sview @source = local_error_family
                            block_error_family <- "" if binding == candidate
                            block_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                            try_noncall_family_bind(block_environment, binding, "") if binding != ""
                            try_noncall_scan_statements(body, candidate, params, block_environment, annotations, annotation, site_offset, block_shadow, block_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            # Ordinary scoped blocks execute in sequence, so writes to
                            # bindings visible on entry flow back. Static blocks may be
                            # static-if alternatives; do not let one syntactic branch
                            # become unconditional source-order state.
                            if kind != "static":
                                try_noncall_family_join_into(environment, base_environment, block_environment, block_environment, visible_count)
                                if try_noncall_family_branch_wrote(base_environment, block_environment, candidate):
                                    local_shadow <- true
                                    local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.Match(scrutinee, arms, _):
                            try_noncall_scan_expression(scrutinee, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                            visible_count: usize = environment.names.count
                            base_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(environment)
                            scrutinee_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(scrutinee, params, base_environment)
                            merged_arms: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                            merged_ready: mutable bool = false
                            candidate_wrote: mutable bool = false
                            for arm in arms |local_shadow, local_error_family, candidate, annotations, annotation, site_offset, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site, merged_arms, merged_ready, candidate_wrote, scrutinee_facts|:
                                return (local_shadow, local_error_family) if found == true
                                pattern_binds_candidate: bool = try_noncall_pattern_shadows_name(arm.pattern, candidate)
                                arm_shadow: bool = local_shadow or pattern_binds_candidate
                                arm_error_family: sview @source = "" if pattern_binds_candidate else local_error_family
                                arm_environment: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(base_environment)
                                if pattern_binds_candidate:
                                    pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(arm.pattern, candidate)
                                    binder_facts: mutable (known_nonfallible: bool, numeric: bool, integer: bool) = pattern_facts
                                    binder_facts <- scrutinee_facts if not pattern_facts.known_nonfallible and not pattern_facts.numeric and not pattern_facts.integer
                                    try_noncall_family_bind(arm_environment, candidate, "", binder_facts.known_nonfallible, binder_facts.numeric, binder_facts.integer)
                                try_noncall_scan_expression(arm.guard, candidate, params, arm_environment, annotations, annotation, site_offset, arm_shadow, arm_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                                guard_binds_candidate: bool = try_noncall_truthy_condition_binds_name(arm.guard, candidate, annotations)
                                body_shadow: bool = arm_shadow or guard_binds_candidate
                                body_error_family: sview @source = "" if guard_binds_candidate else arm_error_family
                                if guard_binds_candidate:
                                    guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(arm.guard, candidate, params, annotations)
                                    try_noncall_family_bind(arm_environment, candidate, "", guard_facts.known_nonfallible, guard_facts.numeric, guard_facts.integer)
                                try_noncall_scan_statements(arm.body, candidate, params, arm_environment, annotations, annotation, site_offset, body_shadow, body_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                                candidate_wrote <- true if try_noncall_family_branch_wrote(base_environment, arm_environment, candidate)
                                if not merged_ready:
                                    merged_arms <- try_noncall_family_clone(arm_environment)
                                    merged_ready <- true
                                else:
                                    prior_merged: mutable TryNonCallErrorFamilyEnv = try_noncall_family_clone(merged_arms)
                                    merged_arms <- try_noncall_family_clone(base_environment)
                                    try_noncall_family_join_into(merged_arms, base_environment, prior_merged, arm_environment, visible_count)
                            if merged_ready:
                                try_noncall_family_join_into(environment, base_environment, base_environment, merged_arms, visible_count)
                                if candidate_wrote:
                                    local_shadow <- true
                                    local_error_family <- try_noncall_family_lookup(environment, candidate)
                        Stmt.Contract(_, expression, _):
                            try_noncall_scan_expression(expression, candidate, params, environment, annotations, annotation, site_offset, local_shadow, local_error_family, found, shadowed_at_site, local_error_family_at_site, lambda_error_family_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                        _:
                            pass
                return (local_shadow, local_error_family)

