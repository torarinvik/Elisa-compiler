extend Semantic:
    private:
        def try_noncall_callable_error_family(callee_name: sview, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source):
            can Abort.Panic:
                return (false, "") if callee_name == ""
                return (false, "") if any marker in annotations where marker.owner == "__try_unresolved_function" and marker.name == callee_name
                declarations: mutable usize = 0
                declaration_line: mutable u32 = 0
                declaration_offset: mutable u32 = 0
                for declaration in annotations:
                    # This source-only alias scan does not carry the caller module,
                    # unlike the direct-call checker below. A duplicate bare name may
                    # resolve to a different declaration (or to a nonfallible overload),
                    # so refuse to borrow any family when the name is not globally unique.
                    if declaration.name == "__lsp_func_name" and declaration.owner == callee_name:
                        continue if callable_function_declaration_is_static_inactive(annotations, callee_name, declaration.module, declaration.line, declaration.offset)
                        declarations <- declarations + 1.usize()
                        declaration_line <- declaration.line
                        declaration_offset <- declaration.offset
                return (false, "") if declarations > 1.usize()
                found: mutable bool = false
                conflicting: mutable bool = false
                family: mutable sview @source = ""
                for row in 0..<annotations.count |found, conflicting, family, annotations, callee_name, declarations, declaration_line, declaration_offset|:
                    marker: Ast::EnumAnnotation = annotations[row]
                    continue if marker.owner != callee_name or marker.name != "__error_return" or row + 1 >= annotations.count
                    continue if callable_function_declaration_is_static_inactive(annotations, callee_name, marker.module, marker.line, marker.offset)
                    continue if not callable_error_family_row(annotations, row + 1)
                    declaration_matches: mutable bool = declarations == 1.usize() and marker.line == declaration_line and marker.offset == declaration_offset
                    if declarations == 0.usize():
                        # Exported/extern signatures have line-keyed source metadata but
                        # do not emit the ordinary function-name marker.
                        declaration_matches <- true if any annotation in annotations where annotation.owner == callee_name and annotation.line == marker.line and annotation.offset == marker.offset and (annotation.name == "__extern_return_text_complete" or annotation.name == "__export_fn")
                    continue if not declaration_matches
                    if declaration_matches:
                        next_family: sview @source = annotations[row + 1].name
                        family <- next_family if not found
                        conflicting <- true if found and family != next_family
                        found <- true
                return (true, family) if found and not conflicting
                # A unique parser declaration marker with no matching error-return row is a
                # declared nonfallible function. Keep optional's more specific message
                # available on direct calls; through this noncall alias path the owner is
                # erased, but rejecting `try` on the returned value is still sound.
                return (true, "") if declarations == 1.usize() and not found
                return (false, "")

        # A deferred static-effect call stores the emitted handler callee, while the
        # source method's callable metadata remains keyed by its operation name. Join the
        # adjacent operation/hidden rows by handler identity and source position, then
        # resolve that exact method declaration before treating the call as fallible.
        def try_noncall_static_effect_candidate_may_raise(candidate: Ast::StaticEffectCandidate, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                return false if candidate.callee == "" or candidate.effect_identity_id == 0 or candidate.handler_identity_id == 0
                effect_found: mutable bool = false
                handler_name: mutable sview @source = ""
                for annotation in annotations |effect_found, handler_name, candidate|:
                    effect_found <- true if annotation.owner == "__effect_decl" and annotation.identity_id == candidate.effect_identity_id
                    handler_name <- annotation.name if (annotation.owner == "__handler_decl" or annotation.owner == "__handler_predecl") and annotation.identity_id == candidate.handler_identity_id
                return false if not effect_found or handler_name == ""

                operation_name: mutable sview @source = ""
                operation_line: mutable u32 = 0
                operation_offset: mutable u32 = 0
                operation_module: mutable sview @source = ""
                operation_matches: mutable usize = 0
                for row in 0..<annotations.count |operation_name, operation_line, operation_offset, operation_module, operation_matches, annotations, handler_name, candidate|:
                    hidden_row: Ast::EnumAnnotation = annotations[row]
                    continue if hidden_row.owner != handler_name or hidden_row.name != candidate.callee or hidden_row.line != 3900000086 or hidden_row.identity_id != candidate.handler_identity_id
                    continue if row == 0.usize()
                    operation_row: Ast::EnumAnnotation = annotations[row - 1.usize()]
                    continue if operation_row.owner != handler_name or operation_row.line != 3900000083 or operation_row.identity_id != candidate.handler_identity_id
                    operation_matches <- operation_matches + 1.usize()
                    operation_name <- operation_row.name
                    operation_line <- operation_row.detail_line
                    operation_offset <- operation_row.offset
                    operation_module <- operation_row.module
                return false if operation_matches != 1.usize() or operation_name == ""

                declaration_found: mutable bool = false
                for annotation in annotations |declaration_found, annotations, operation_name, operation_line, operation_offset|:
                    declaration_found <- true if annotation.owner == operation_name and annotation.name == "__lsp_func_name" and annotation.line == operation_line and annotation.offset == operation_offset
                return false if not declaration_found

                found_error: mutable bool = false
                conflicting_family: mutable bool = false
                family: mutable sview @source = ""
                for row in 0..<annotations.count |found_error, conflicting_family, family, annotations, operation_name, operation_line, operation_offset, operation_module|:
                    marker: Ast::EnumAnnotation = annotations[row]
                    continue if marker.owner != operation_name or marker.name != "__error_return" or row + 1.usize() >= annotations.count
                    continue if marker.line != operation_line or marker.offset != operation_offset
                    continue if not callable_error_family_row(annotations, row + 1.usize())
                    module_matches: mutable bool = false
                    for annotation in annotations |module_matches, marker, operation_module|:
                        module_matches <- true if annotation.owner == "__fn_module" and annotation.line == marker.line and annotation.offset == marker.offset and annotation.identity_id == marker.identity_id and annotation.name == operation_module
                    continue if not module_matches
                    next_family: sview @source = annotations[row + 1.usize()].name
                    family <- next_family if not found_error
                    conflicting_family <- true if found_error and family != next_family
                    found_error <- true
                return found_error and not conflicting_family

        def try_noncall_unqualified_callable_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(_, name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_unqualified_callable_name(inner)
                    _:
                        return ""

        def try_noncall_error_scan_callable_needs_resolution(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(_, _, _) | Expr.Scope(_, _, _):
                        return true
                    Expr.Paren(inner, _):
                        return try_noncall_error_scan_callable_needs_resolution(inner)
                    _:
                        return false

        def try_noncall_callable_metadata_present(callee_name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                return false if callee_name == ""
                return any annotation in annotations where annotation.owner == callee_name and (annotation.name == "__lsp_func_name" or annotation.name == "__error_return" or annotation.name == "__extern_return_text_complete" or annotation.name == "__export_fn")

        def try_noncall_error_scan_callable_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                # A receiver method can share a name with an unrelated free function or
                # callable field, and a qualified name can resolve through a module alias.
                # This source-only scan has neither receiver nor module identity, so only
                # bare names may borrow declaration metadata here.
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_error_scan_callable_name(inner)
                    _:
                        return ""

        def try_noncall_callable_qualifier(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Scope(base, _, _):
                        match base:
                            Expr.Ident(name, _):
                                return name
                            Expr.Scope(_, name, _):
                                return name
                            _:
                                return ""
                    Expr.Paren(inner, _):
                        return try_noncall_callable_qualifier(inner)
                    _:
                        return ""

        def try_noncall_expression_aborts_with_annotations(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, lexical_module: sview = "") -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Ident(name, _) if name in {"panic", "abort", "raise", "error"}:
                                return true
                            _:
                                pass
                        return try_noncall_expression_aborts_with_annotations(callee, annotations, lexical_module) or any argument in arguments where try_noncall_expression_aborts_with_annotations(argument, annotations, lexical_module)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        return any child in runtime_children where try_noncall_expression_aborts_with_annotations(child, annotations, lexical_module)
                    Expr.Field(receiver, _, _):
                        return try_noncall_expression_aborts_with_annotations(receiver, annotations, lexical_module)
                    Expr.Paren(inner, _):
                        return try_noncall_expression_aborts_with_annotations(inner, annotations, lexical_module)
                    Expr.If(condition, then_value, else_value, _):
                        return true if try_noncall_expression_aborts_with_annotations(condition, annotations, lexical_module)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        if condition_bool.known:
                            return try_noncall_expression_aborts_with_annotations(then_value, annotations, lexical_module) if condition_bool.value
                            return try_noncall_expression_aborts_with_annotations(else_value, annotations, lexical_module)
                        return try_noncall_expression_aborts_with_annotations(then_value, annotations, lexical_module) and try_noncall_expression_aborts_with_annotations(else_value, annotations, lexical_module)
                    Expr.Match(scrutinee, arms, _):
                        return true if try_noncall_expression_aborts_with_annotations(scrutinee, annotations, lexical_module)
                        scrutinee_bool: (known: bool, value: bool) = try_noncall_literal_bool(scrutinee)
                        return try_noncall_match_bool_arms_terminate_with_annotations(arms, scrutinee_bool.value, annotations, lexical_module) if scrutinee_bool.known
                        has_unconditional_wildcard: bool = any arm in arms where try_noncall_pattern_is_match_catchall(arm.pattern) and arm.guard is Expr.Absent
                        has_true_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "true" and arm.guard is Expr.Absent
                        has_false_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "false" and arm.guard is Expr.Absent
                        all_arms_abort: bool = all arm in arms where try_noncall_guard_is_definitely_false(arm.guard) or try_noncall_expression_aborts_with_annotations(arm.guard, annotations, lexical_module) or try_noncall_block_terminates_with_annotations(arm.body, annotations, lexical_module)
                        return arms.count > 0 and (has_unconditional_wildcard or (has_true_literal and has_false_literal)) and all_arms_abort
                    Expr.Catch(guarded, arms, _):
                        guarded_aborts: bool = try_noncall_expression_aborts_with_annotations(guarded, annotations, lexical_module)
                        if guarded_aborts:
                            return not try_noncall_expression_may_raise_catchably_with_annotations(guarded, annotations, lexical_module) or try_noncall_catch_error_arms_terminate(arms, annotations, lexical_module)
                        return false if arms.count == 0 or arms[0].guard is not Expr.Absent
                        return try_noncall_block_terminates_with_annotations(arms[0].body, annotations, lexical_module) and try_noncall_catch_error_arms_terminate(arms, annotations, lexical_module)
                    Expr.Block(statements, value, _, _):
                        return try_noncall_block_terminates_with_annotations(statements, annotations, lexical_module) or try_noncall_expression_aborts_with_annotations(value, annotations, lexical_module)
                    _:
                        return false


        def try_noncall_expression_aborts(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                empty_annotations: darray[Ast::EnumAnnotation] = []
                return try_noncall_expression_aborts_with_annotations(expression, empty_annotations)

        def try_noncall_literal_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            can Abort.Panic:
                return match expression:
                    Expr.BoolLit(value, _): (true, value)
                    Expr.Paren(inner, _): try_noncall_literal_bool(inner)
                    _: (false, false)

        def try_noncall_guard_is_definitely_false(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                guard_bool: (known: bool, value: bool) = try_noncall_literal_bool(expression)
                return guard_bool.known and not guard_bool.value

        def try_noncall_pattern_is_match_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Or(options):
                        return any option in options where try_noncall_pattern_is_match_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where try_noncall_pattern_is_match_catchall(wrapped)
                    _:
                        return false

        def try_noncall_pattern_is_error_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard:
                        return true
                    Pattern.TypeBind(type_name, _):
                        return type_name == "error"
                    Pattern.Or(options):
                        return any option in options where try_noncall_pattern_is_error_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where try_noncall_pattern_is_error_catchall(wrapped)
                    _:
                        return false

        def try_noncall_catch_error_arms_terminate(arms: darray[Ast::MatchArm],
                annotations: darray[Ast::EnumAnnotation]&, lexical_module: sview) -> bool:
            can Abort.Panic:
                return false if arms.count < 2
                covered_errors: mutable bool = false
                uncovered_guarded_error: mutable bool = false
                for index in 1..<arms.count |arms, covered_errors, uncovered_guarded_error|:
                    arm: Ast::MatchArm = arms[index]
                    if try_noncall_guard_is_definitely_false(arm.guard):
                        uncovered_guarded_error <- true
                        continue
                    continue if try_noncall_expression_aborts_with_annotations(arm.guard, annotations, lexical_module)
                    return false if not try_noncall_block_terminates_with_annotations(arm.body, annotations, lexical_module)
                    if arm.guard is Expr.Absent and try_noncall_pattern_is_error_catchall(arm.pattern):
                        covered_errors <- true
                        break
                    uncovered_guarded_error <- true if not (arm.guard is Expr.Absent)
                # Catch exhaustiveness is checked separately against the guarded callable's
                # declared error set, so a sequence of unguarded variant arms can be total.
                return covered_errors or not uncovered_guarded_error
