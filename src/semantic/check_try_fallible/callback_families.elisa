# Recover the exact error-set occurrence for a callback parameter. The compact
# function-type marker alone stores only the first token of a qualified path.
extend Semantic:
    private:
        def try_callback_type_offset(declarations: darray[Ast::Decl], function_line: u32, function_offset: u32, name: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(_, parameters, _, body, _, _, position):
                            if position.line == function_line and position.offset == function_offset:
                                locals: mutable darray[sview] = []
                                ewr_collect_local_names(body, locals)
                                return 0 if any local_name in locals where local_name == name
                                for parameter in parameters:
                                    if parameter.name == name:
                                        match parameter.type_expression:
                                            Expr.Lambda(_, _, lambda_position): return lambda_position.offset
                                            _: return 0
                                return 0
                        Decl.Module(_, body, _) | Decl.Scoped(body, _):
                            nested: u32 = try_callback_type_offset(body, function_line, function_offset, name)
                            return nested if nested != 0
                        _:
                            pass
                return 0

        def try_callback_family_ref(declarations: darray[Ast::Decl], function_line: u32, function_offset: u32, name: sview, current_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> TryErrorFamilyRef:
            can Memory.Allocate, Abort.Panic:
                empty: TryErrorFamilyRef = TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0}
                callback_offset: u32 = try_callback_type_offset(declarations, function_line, function_offset, name)
                return empty if callback_offset == 0
                occurrence: mutable u32 = 0
                marker_count: mutable usize = 0
                for marker in annotations |occurrence, marker_count, callback_offset|:
                    if marker.owner == "__fn_error_union" and marker.offset == callback_offset:
                        occurrence <- marker.occurrence_offset
                        marker_count <- marker_count + 1.usize()
                return empty if marker_count != 1.usize() or occurrence == 0
                family_index: mutable usize = annotations.count
                family_count: mutable usize = 0
                for index in 0..<annotations.count |family_index, family_count, occurrence, annotations|:
                    if annotations[index].owner == "__error_set_family" and annotations[index].occurrence_offset == occurrence:
                        family_index <- index
                        family_count <- family_count + 1.usize()
                return empty if family_count != 1.usize()
                family_row: Ast::EnumAnnotation = annotations[family_index]
                family_path: sview @source = try_error_family_path_for_row(annotations, family_index)
                return try_error_family_ref_for_annotation(annotations, family_row, family_path, true, current_module, table)
