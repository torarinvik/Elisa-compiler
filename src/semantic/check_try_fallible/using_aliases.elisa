extend Semantic:
    private:
        def try_noncall_visible_using_alias_target(environment: TryNonCallErrorFamilyEnv&, alias_name: sview) -> (known: bool, module: sview, target: sview):
            can Abort.Panic:
                scope_module: mutable sview = environment.current_module
                while true |scope_module, environment, alias_name|:
                    match_count: mutable usize = 0
                    target: mutable sview = ""
                    for index in 0..<environment.using_alias_names.count |match_count, target, environment, alias_name, scope_module|:
                        if environment.using_alias_names[index] == alias_name and environment.using_alias_modules[index] == scope_module:
                            match_count <- match_count + 1.usize()
                            target <- environment.using_alias_targets[index]
                    return (match_count == 1.usize(), scope_module, target) if match_count > 0.usize()
                    return (false, "", "") if scope_module == ""
                    scope_module <- try_noncall_module_parent(scope_module)

        # Resolve the qualifier from its last component back to the alias head while
        # consuming the same suffix from the cached declaration module. This supports
        # aliases used as a prefix, such as O::Inner::load for using Outer as O.
        def try_noncall_using_alias_qualifier_matches_module(qualifier: Ast::Expr, alias_name: sview, target_module: sview, candidate_module: sview) -> bool:
            can Abort.Panic:
                match qualifier:
                    Expr.Ident(name, _):
                        return name == alias_name and candidate_module == target_module
                    Expr.Scope(base, name, _):
                        return module_last_segment(candidate_module) == name and try_noncall_using_alias_qualifier_matches_module(base, alias_name, target_module, try_noncall_module_parent(candidate_module))
                    Expr.Paren(inner, _):
                        return try_noncall_using_alias_qualifier_matches_module(inner, alias_name, target_module, candidate_module)
                    _:
                        return false

        def try_noncall_callable_matches_using_alias(callee: Ast::Expr, alias_index: usize, candidate_module: sview, environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                alias_name: sview = environment.using_alias_names[alias_index]
                alias_module: sview = environment.using_alias_modules[alias_index]
                target_module: sview = environment.using_alias_targets[alias_index]
                match callee:
                    Expr.Scope(qualifier, _, _):
                        visible_alias: (known: bool, module: sview, target: sview) = try_noncall_visible_using_alias_target(environment, alias_name)
                        return visible_alias.known and visible_alias.module == alias_module and visible_alias.target == target_module and try_noncall_using_alias_qualifier_matches_module(qualifier, alias_name, target_module, candidate_module)
                    Expr.Paren(inner, _):
                        return try_noncall_callable_matches_using_alias(inner, alias_index, candidate_module, environment)
                    _:
                        return false

        # Unqualified module imports participate after declarations in the same lexical
        # module. Walk the lexical module chain one scope at a time so a local declaration
        # shadows imports and a nearer module shadows its ancestors.
        def try_noncall_callable_imported_in_scope(callee_name: sview, candidate_module: sview, scope_module: sview, environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                for index in 0..<environment.callable_wildcard_import_modules.count:
                    return true if environment.callable_wildcard_import_scopes[index] == scope_module and environment.callable_wildcard_import_modules[index] == candidate_module
                for index in 0..<environment.callable_imported_member_names.count:
                    return true if environment.callable_imported_member_scopes[index] == scope_module and environment.callable_imported_member_names[index] == callee_name and environment.callable_imported_member_modules[index] == candidate_module
                return false

        def try_noncall_callable_cached_facts(callee_name: sview, callee_qualifier: sview, callee: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize):
            can Abort.Panic:
                match_count: mutable usize = 0
                callable_index: mutable usize = 0
                if callee_qualifier == "":
                    scope_module: mutable sview = environment.current_module
                    while true |scope_module, match_count, callable_index, environment, callee_name|:
                        local_matches: mutable usize = 0
                        local_callable: mutable usize = 0
                        imported_matches: mutable usize = 0
                        imported_callable: mutable usize = 0
                        for index in 0..<environment.callable_names.count |local_matches, local_callable, imported_matches, imported_callable, environment, callee_name, scope_module|:
                            if environment.callable_names[index] == callee_name:
                                if environment.callable_modules[index] == scope_module:
                                    local_matches <- local_matches + 1.usize()
                                    local_callable <- index
                                elif try_noncall_callable_imported_in_scope(callee_name, environment.callable_modules[index], scope_module, environment):
                                    imported_matches <- imported_matches + 1.usize()
                                    imported_callable <- index
                        if local_matches > 0.usize():
                            match_count <- local_matches
                            callable_index <- local_callable
                            break
                        if imported_matches > 0.usize():
                            match_count <- imported_matches
                            callable_index <- imported_callable
                            break
                        return (false, "", false, false, false, false, "", 0.usize()) if scope_module == ""
                        scope_module <- try_noncall_module_parent(scope_module)
                else:
                    for index in 0..<environment.callable_names.count |match_count, callable_index, environment, callee_name, callee_qualifier, callee|:
                        module_matches: mutable bool = try_noncall_qualified_module_matches(callee, environment.callable_modules[index])
                        if not module_matches:
                            for alias_index in 0..<environment.using_alias_names.count |module_matches, environment, callee, index|:
                                module_matches <- try_noncall_callable_matches_using_alias(callee, alias_index, environment.callable_modules[index], environment)
                        if environment.callable_names[index] == callee_name and module_matches:
                            match_count <- match_count + 1.usize()
                            callable_index <- index
                if match_count == 1.usize():
                    return (false, "", false, false, false, true, "", 0.usize()) if not environment.callable_facts_known[callable_index]
                    return (true, environment.callable_families[callable_index], environment.callable_numeric[callable_index], environment.callable_integer[callable_index], environment.callable_return_nonfallible[callable_index], false, environment.callable_generic_return_formal_names[callable_index], environment.callable_generic_return_formal_indices[callable_index])
                return (false, "", false, false, false, match_count > 1.usize(), "", 0.usize())

        def try_noncall_generic_call_argument_index(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, formal_name: sview, formal_index: usize) -> usize:
            can Abort.Panic:
                named_matches: mutable usize = 0
                named_index: mutable usize = arguments.count
                positional_prefix: mutable usize = 0
                has_named_arguments: mutable bool = false
                for index in 0..<arguments.count |named_matches, named_index, positional_prefix, has_named_arguments, argument_names, formal_name|:
                    argument_name: sview = argument_names[index] if index < argument_names.count else ""
                    if argument_name != "":
                        has_named_arguments <- true
                        if argument_name == formal_name:
                            named_matches <- named_matches + 1.usize()
                            named_index <- index
                    elif not has_named_arguments:
                        positional_prefix <- positional_prefix + 1.usize()
                positional_index: usize = formal_index if formal_index < positional_prefix else arguments.count
                return arguments.count if named_matches > 1.usize()
                return arguments.count if named_matches == 1.usize() and positional_index < arguments.count
                return named_index if named_matches == 1.usize()
                return positional_index

        def try_noncall_assignment_cached_source_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (family: sview @source, known_nonfallible: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return (try_noncall_family_lookup(environment, name), try_noncall_family_known_nonfallible(environment, name))
                    Expr.Paren(inner, _):
                        return try_noncall_assignment_cached_source_facts(inner, params, environment)
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        return ("", false) if callee_name == ""
                        if callee_qualifier == "":
                            return ("", false) if try_noncall_family_index(environment, callee_name) < environment.names.count
                            for parameter in params:
                                return ("", false) if parameter.name == callee_name
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, environment)
                        return ("", false) if not call_facts.known
                        if call_facts.family == "" and call_facts.generic_formal_name != "":
                            argument_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, call_facts.generic_formal_name, call_facts.generic_formal_index)
                            return try_noncall_assignment_cached_source_facts(arguments[argument_index], params, environment) if argument_index < arguments.count
                        return (call_facts.family, call_facts.return_nonfallible)
                    Expr.If(condition, then_value, else_value, _):
                        return ("", false) if try_noncall_expression_aborts(condition)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        return try_noncall_assignment_cached_source_facts(then_value, params, environment) if condition_bool.known and condition_bool.value
                        return try_noncall_assignment_cached_source_facts(else_value, params, environment) if condition_bool.known
                        then_aborts: bool = try_noncall_expression_aborts(then_value)
                        else_aborts: bool = try_noncall_expression_aborts(else_value)
                        return ("", false) if then_aborts and else_aborts
                        return try_noncall_assignment_cached_source_facts(else_value, params, environment) if then_aborts
                        return try_noncall_assignment_cached_source_facts(then_value, params, environment) if else_aborts
                        then_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_cached_source_facts(then_value, params, environment)
                        else_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_cached_source_facts(else_value, params, environment)
                        return (then_facts.family, false) if then_facts.family != "" and then_facts.family == else_facts.family
                        return (then_facts.family, false) if then_facts.family != "" and else_facts.family == "" and else_facts.known_nonfallible
                        return (else_facts.family, false) if else_facts.family != "" and then_facts.family == "" and then_facts.known_nonfallible
                        return ("", true) if then_facts.family == "" and else_facts.family == "" and then_facts.known_nonfallible and else_facts.known_nonfallible
                    _:
                        pass
                return ("", false)

        def try_noncall_assignment_update_add(updates: mutable TryNonCallAssignmentUpdates&, name: sview @source, family: sview @source, known_nonfallible: bool, origin: usize, numeric: bool, integer: bool, catch_payload_family: sview @source = "", catch_payload_known_nonfallible: bool = false, catch_payload_numeric: bool = false, catch_payload_integer: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                updates.names.push(name)
                updates.families.push(family)
                updates.catch_payload_families.push(catch_payload_family)
                updates.catch_payload_known_nonfallible.push(catch_payload_known_nonfallible)
                updates.catch_payload_numeric.push(catch_payload_numeric)
                updates.catch_payload_integer.push(catch_payload_integer)
                updates.known_nonfallible.push(known_nonfallible)
                updates.numeric.push(numeric)
                updates.integer.push(integer)
                updates.origins.push(origin)

        def try_noncall_callable_source_facts(callee_name: sview @source, callee_qualifier: sview, callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool):
            can Abort.Panic:
                cached_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, environment)
                if cached_facts.known:
                    if cached_facts.family == "" and cached_facts.generic_formal_name != "":
                        argument_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, cached_facts.generic_formal_name, cached_facts.generic_formal_index)
                        if argument_index < arguments.count:
                            actual_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(arguments[argument_index], params, environment, annotations)
                            return (actual_facts.family != "" or actual_facts.known_nonfallible, actual_facts.family, try_noncall_numeric_value(arguments[argument_index], params, environment), try_noncall_integer_value(arguments[argument_index], params, environment), actual_facts.known_nonfallible)
                    return (cached_facts.known, cached_facts.family, cached_facts.numeric, cached_facts.integer, cached_facts.return_nonfallible)
                return (false, "", false, false, false) if cached_facts.ambiguous or callee_qualifier != ""
                return (false, "", false, false, false) if any name in environment.callable_names where name == callee_name
                legacy_facts: (known: bool, family: sview @source) = try_noncall_callable_error_family(callee_name, annotations)
                return (legacy_facts.known, legacy_facts.family, false, false, legacy_facts.known and legacy_facts.family == "")

        def try_noncall_pattern_binding_facts(pattern: Ast::Pattern, candidate: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match pattern:
                    Pattern.TypeBind(type_name, binder) if binder == candidate:
                        return try_noncall_type_name_facts(type_name)
                    Pattern.As(name, inner):
                        return (false, false, false) if name == candidate
                        for nested in inner:
                            facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(nested, candidate)
                            return facts if facts.known_nonfallible or facts.numeric or facts.integer
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Tuple(fields) | Pattern.Or(fields) | Pattern.Field(_, fields):
                        for nested in fields:
                            facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(nested, candidate)
                            return facts if facts.known_nonfallible or facts.numeric or facts.integer
                    _:
                        pass
                return (false, false, false)

        def try_noncall_expression_value_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        if index < environment.names.count:
                            return (false, false, false) if environment.families[index] != ""
                            return (environment.known_nonfallible[index], environment.numeric[index], environment.integer[index])
                        for parameter in params:
                            if parameter.name == name:
                                return try_noncall_type_facts_with_aliases(parameter.type_expression, environment)
                    Expr.Paren(inner, _):
                        return try_noncall_expression_value_facts(inner, params, environment)
                    Expr.IntLit(_, _):
                        return try_noncall_type_name_facts("i64")
                    Expr.FloatLit(_, _):
                        return try_noncall_type_name_facts("f64")
                    Expr.CharLit(_, _):
                        return try_noncall_type_name_facts("char")
                    Expr.BoolLit(_, _):
                        return try_noncall_type_name_facts("bool")
                    Expr.StringLit(_, _):
                        return try_noncall_type_name_facts("string")
                    _:
                        pass
                return (false, false, false)

        # Catch's plain success binding receives the payload after the guarded expression's
        # outer error family has been removed. Preserve a generic T actual's own error family
        # as well as nonfallible/numeric facts when the formal-to-actual mapping is unique.
        # A Match binder is different: it receives the complete scrutinee value.
        def try_noncall_assignment_catch_payload_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        if index < environment.names.count:
                            if environment.catch_payload_families[index] != "" or environment.catch_payload_known_nonfallible[index] or environment.catch_payload_numeric[index] or environment.catch_payload_integer[index]:
                                return (environment.catch_payload_families[index], environment.catch_payload_known_nonfallible[index], environment.catch_payload_numeric[index], environment.catch_payload_integer[index])
                            if environment.families[index] != "":
                                return ("", false, environment.numeric[index], environment.integer[index])
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, environment)
                        if call_facts.known and call_facts.generic_formal_name != "":
                            argument_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, call_facts.generic_formal_name, call_facts.generic_formal_index)
                            if argument_index < arguments.count:
                                actual_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(arguments[argument_index], params, environment, annotations)
                                actual_value_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(arguments[argument_index], params, environment)
                                return (actual_facts.family, actual_value_facts.known_nonfallible, actual_value_facts.numeric, actual_value_facts.integer)
                        source_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool) = try_noncall_callable_source_facts(callee_name, callee_qualifier, callee, arguments, argument_names, params, environment, annotations)
                        return ("", source_facts.return_nonfallible, source_facts.numeric, source_facts.integer) if source_facts.known and source_facts.family != ""
                    Expr.Paren(inner, _):
                        return try_noncall_assignment_catch_payload_facts(inner, params, environment, annotations)
                    _:
                        pass
                return ("", false, false, false)

        def try_noncall_catch_success_payload_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                guarded_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(expression, params, environment, annotations)
                return ("", false, false, false) if guarded_facts.family == ""
                return try_noncall_assignment_catch_payload_facts(expression, params, environment, annotations)

        def try_noncall_target_binds_name(target: Ast::Expr, candidate: sview) -> bool:
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return name == candidate
                    Expr.Paren(inner, _):
                        return try_noncall_target_binds_name(inner, candidate)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        for element in elements:
                            return true if try_noncall_target_binds_name(element, candidate)
                    _:
                        pass
                return false

        def try_noncall_target_source_facts(target: Ast::Expr, value: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (found: bool, family: sview @source, known_nonfallible: bool):
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return (false, "", false) if name != candidate
                        source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(value, params, environment, annotations)
                        return (true, source_facts.family, source_facts.known_nonfallible)
                    Expr.Paren(inner, _):
                        return try_noncall_target_source_facts(inner, value, candidate, params, environment, annotations)
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                return (true, "", false) if targets.count != values.count and try_noncall_target_binds_name(target, candidate)
                                for index in 0..<targets.count:
                                    if try_noncall_target_binds_name(targets[index], candidate):
                                        return try_noncall_target_source_facts(targets[index], values[index], candidate, params, environment, annotations) if index < values.count
                                        return (true, "", false)
                            _:
                                pass
                        return (true, "", false) if try_noncall_target_binds_name(target, candidate)
                    _:
                        pass
                return (false, "", false)

        def try_noncall_expression_is_name(expression: Ast::Expr, candidate: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name == candidate
                    Expr.Paren(inner, _):
                        return try_noncall_expression_is_name(inner, candidate)
                    _:
                        return false

        def try_noncall_callable_error_family(callee_name: sview, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source):
            can Abort.Panic:
                return (false, "") if callee_name == ""
                declarations: mutable usize = 0
                declaration_line: mutable u32 = 0
                declaration_offset: mutable u32 = 0
                for declaration in annotations:
                    # This source-only alias scan does not carry the caller module,
                    # unlike the direct-call checker below. A duplicate bare name may
                    # resolve to a different declaration (or to a nonfallible overload),
                    # so refuse to borrow any family when the name is not globally unique.
                    if declaration.name == "__lsp_func_name" and declaration.owner == callee_name:
                        declarations <- declarations + 1.usize()
                        declaration_line <- declaration.line
                        declaration_offset <- declaration.offset
                return (false, "") if declarations > 1.usize()
                found: mutable bool = false
                conflicting: mutable bool = false
                family: mutable sview @source = ""
                for row in 0..<annotations.count |found, conflicting, family, annotations, callee_name, declarations, declaration_line, declaration_offset|:
                    marker: Ast::EnumAnnotation = annotations[row]
                    continue if marker.owner != callee_name or marker.name != "__error_return" or row + 1 >= annotations.count
                    continue if not callable_error_family_row(annotations, row + 1)
                    declaration_matches: mutable bool = declarations == 1.usize() and marker.line == declaration_line and marker.offset == declaration_offset
                    if declarations == 0.usize():
                        # Exported/extern signatures have line-keyed source metadata but
                        # do not emit the ordinary function-name marker.
                        declaration_matches <- true if any annotation in annotations where annotation.owner == callee_name and annotation.line == marker.line and (annotation.name == "__extern_return_text_complete" or annotation.name == "__export_fn")
                    continue if not declaration_matches
                    if declaration_matches:
                        next_family: sview @source = annotations[row + 1].name
                        family <- next_family if not found
                        conflicting <- true if found and family != next_family
                        found <- true
                return (true, family) if found and not conflicting
                # A unique parser declaration marker with no matching error-return row is a
                # declared nonfallible function. Keep optional's more specific message
                # available on direct calls; through this noncall alias path the owner is
                # erased, but rejecting `try` on the returned value is still sound.
                return (true, "") if declarations == 1.usize() and not found
                return (false, "")

        # A deferred static-effect call stores the emitted handler callee, while the
        # source method's callable metadata remains keyed by its operation name. Join the
        # adjacent operation/hidden rows by handler identity and source position, then
        # resolve that exact method declaration before treating the call as fallible.
        def try_noncall_static_effect_candidate_may_raise(candidate: Ast::StaticEffectCandidate, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                return false if candidate.callee == "" or candidate.effect_identity_id == 0 or candidate.handler_identity_id == 0
                effect_found: mutable bool = false
                handler_name: mutable sview @source = ""
                for annotation in annotations |effect_found, handler_name, candidate|:
                    effect_found <- true if annotation.owner == "__effect_decl" and annotation.identity_id == candidate.effect_identity_id
                    handler_name <- annotation.name if (annotation.owner == "__handler_decl" or annotation.owner == "__handler_predecl") and annotation.identity_id == candidate.handler_identity_id
                return false if not effect_found or handler_name == ""

                operation_name: mutable sview @source = ""
                operation_line: mutable u32 = 0
                operation_offset: mutable u32 = 0
                operation_module: mutable sview @source = ""
                operation_matches: mutable usize = 0
                for row in 0..<annotations.count |operation_name, operation_line, operation_offset, operation_module, operation_matches, annotations, handler_name, candidate|:
                    hidden_row: Ast::EnumAnnotation = annotations[row]
                    continue if hidden_row.owner != handler_name or hidden_row.name != candidate.callee or hidden_row.line != 3900000086 or hidden_row.identity_id != candidate.handler_identity_id
                    continue if row == 0.usize()
                    operation_row: Ast::EnumAnnotation = annotations[row - 1.usize()]
                    continue if operation_row.owner != handler_name or operation_row.line != 3900000083 or operation_row.identity_id != candidate.handler_identity_id
                    operation_matches <- operation_matches + 1.usize()
                    operation_name <- operation_row.name
                    operation_line <- operation_row.detail_line
                    operation_offset <- operation_row.offset
                    operation_module <- operation_row.module
                return false if operation_matches != 1.usize() or operation_name == "" or operation_line == 0

                declaration_found: mutable bool = false
                for annotation in annotations |declaration_found, annotations, operation_name, operation_line, operation_offset|:
                    declaration_found <- true if annotation.owner == operation_name and annotation.name == "__lsp_func_name" and annotation.line == operation_line and annotation.offset == operation_offset
                return false if not declaration_found

                found_error: mutable bool = false
                conflicting_family: mutable bool = false
                family: mutable sview @source = ""
                for row in 0..<annotations.count |found_error, conflicting_family, family, annotations, operation_name, operation_line, operation_offset, operation_module|:
                    marker: Ast::EnumAnnotation = annotations[row]
                    continue if marker.owner != operation_name or marker.name != "__error_return" or row + 1.usize() >= annotations.count
                    continue if marker.line != operation_line or marker.offset != operation_offset
                    continue if not callable_error_family_row(annotations, row + 1.usize())
                    module_matches: mutable bool = false
                    for annotation in annotations |module_matches, marker, operation_module|:
                        module_matches <- true if annotation.owner == "__fn_module" and annotation.line == marker.line and annotation.offset == marker.offset and annotation.identity_id == marker.identity_id and annotation.name == operation_module
                    continue if not module_matches
                    next_family: sview @source = annotations[row + 1.usize()].name
                    family <- next_family if not found_error
                    conflicting_family <- true if found_error and family != next_family
                    found_error <- true
                return found_error and not conflicting_family

        def try_noncall_unqualified_callable_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(_, name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_unqualified_callable_name(inner)
                    _:
                        return ""

        def try_noncall_error_scan_callable_needs_resolution(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Field(_, _, _) | Expr.Scope(_, _, _):
                        return true
                    Expr.Paren(inner, _):
                        return try_noncall_error_scan_callable_needs_resolution(inner)
                    _:
                        return false

        def try_noncall_callable_metadata_present(callee_name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                return false if callee_name == ""
                return any annotation in annotations where annotation.owner == callee_name and (annotation.name == "__lsp_func_name" or annotation.name == "__error_return" or annotation.name == "__extern_return_text_complete" or annotation.name == "__export_fn")

        def try_noncall_error_scan_callable_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                # A receiver method can share a name with an unrelated free function or
                # callable field, and a qualified name can resolve through a module alias.
                # This source-only scan has neither receiver nor module identity, so only
                # bare names may borrow declaration metadata here.
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_error_scan_callable_name(inner)
                    _:
                        return ""

        def try_noncall_callable_qualifier(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Scope(base, _, _):
                        match base:
                            Expr.Ident(name, _):
                                return name
                            Expr.Scope(_, name, _):
                                return name
                            _:
                                return ""
                    Expr.Paren(inner, _):
                        return try_noncall_callable_qualifier(inner)
                    _:
                        return ""

        def try_noncall_expression_aborts_with_annotations(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Ident(name, _) if name in {"panic", "abort", "raise", "error"}:
                                return true
                            _:
                                pass
                        return try_noncall_expression_aborts_with_annotations(callee, annotations) or any argument in arguments where try_noncall_expression_aborts_with_annotations(argument, annotations)
                    Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        return any child in runtime_children where try_noncall_expression_aborts_with_annotations(child, annotations)
                    Expr.Field(receiver, _, _):
                        return try_noncall_expression_aborts_with_annotations(receiver, annotations)
                    Expr.Paren(inner, _):
                        return try_noncall_expression_aborts_with_annotations(inner, annotations)
                    Expr.If(condition, then_value, else_value, _):
                        return true if try_noncall_expression_aborts_with_annotations(condition, annotations)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        if condition_bool.known:
                            return try_noncall_expression_aborts_with_annotations(then_value, annotations) if condition_bool.value
                            return try_noncall_expression_aborts_with_annotations(else_value, annotations)
                        return try_noncall_expression_aborts_with_annotations(then_value, annotations) and try_noncall_expression_aborts_with_annotations(else_value, annotations)
                    Expr.Match(scrutinee, arms, _):
                        return true if try_noncall_expression_aborts_with_annotations(scrutinee, annotations)
                        scrutinee_bool: (known: bool, value: bool) = try_noncall_literal_bool(scrutinee)
                        return try_noncall_match_bool_arms_terminate(arms, scrutinee_bool.value) if scrutinee_bool.known
                        has_unconditional_wildcard: bool = any arm in arms where try_noncall_pattern_is_match_catchall(arm.pattern) and arm.guard is Expr.Absent
                        has_true_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "true" and arm.guard is Expr.Absent
                        has_false_literal: bool = any arm in arms where arm.pattern is Pattern.Literal(text) and text == "false" and arm.guard is Expr.Absent
                        all_arms_abort: bool = all arm in arms where try_noncall_guard_is_definitely_false(arm.guard) or try_noncall_expression_aborts_with_annotations(arm.guard, annotations) or try_noncall_block_terminates(arm.body)
                        return arms.count > 0 and (has_unconditional_wildcard or (has_true_literal and has_false_literal)) and all_arms_abort
                    Expr.Catch(guarded, arms, _):
                        guarded_aborts: bool = try_noncall_expression_aborts_with_annotations(guarded, annotations)
                        if guarded_aborts:
                            return not try_noncall_expression_may_raise_catchably_with_annotations(guarded, annotations) or try_noncall_catch_error_arms_terminate(arms)
                        return false if arms.count == 0 or arms[0].guard is not Expr.Absent
                        return try_noncall_block_terminates(arms[0].body) and try_noncall_catch_error_arms_terminate(arms)
                    Expr.Block(statements, value, _, _):
                        return try_noncall_block_terminates(statements) or try_noncall_expression_aborts_with_annotations(value, annotations)
                    _:
                        return false


        def try_noncall_expression_aborts(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                empty_annotations: darray[Ast::EnumAnnotation] = []
                return try_noncall_expression_aborts_with_annotations(expression, empty_annotations)

        def try_noncall_literal_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            can Abort.Panic:
                return match expression:
                    Expr.BoolLit(value, _): (true, value)
                    Expr.Paren(inner, _): try_noncall_literal_bool(inner)
                    _: (false, false)

        def try_noncall_guard_is_definitely_false(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                guard_bool: (known: bool, value: bool) = try_noncall_literal_bool(expression)
                return guard_bool.known and not guard_bool.value

        def try_noncall_pattern_is_match_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Or(options):
                        return any option in options where try_noncall_pattern_is_match_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where try_noncall_pattern_is_match_catchall(wrapped)
                    _:
                        return false

        def try_noncall_pattern_is_error_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard:
                        return true
                    Pattern.TypeBind(type_name, _):
                        return type_name == "error"
                    Pattern.Or(options):
                        return any option in options where try_noncall_pattern_is_error_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where try_noncall_pattern_is_error_catchall(wrapped)
                    _:
                        return false

        def try_noncall_catch_error_arms_terminate(arms: darray[Ast::MatchArm]) -> bool:
            can Abort.Panic:
                return false if arms.count < 2
                covered_errors: mutable bool = false
                uncovered_guarded_error: mutable bool = false
                for index in 1..<arms.count |arms, covered_errors, uncovered_guarded_error|:
                    arm: Ast::MatchArm = arms[index]
                    if try_noncall_guard_is_definitely_false(arm.guard):
                        uncovered_guarded_error <- true
                        continue
                    continue if try_noncall_expression_aborts(arm.guard)
                    return false if not try_noncall_block_terminates(arm.body)
                    if arm.guard is Expr.Absent and try_noncall_pattern_is_error_catchall(arm.pattern):
                        covered_errors <- true
                        break
                    uncovered_guarded_error <- true if not (arm.guard is Expr.Absent)
                # Catch exhaustiveness is checked separately against the guarded callable's
                # declared error set, so a sequence of unguarded variant arms can be total.
                return covered_errors or not uncovered_guarded_error
