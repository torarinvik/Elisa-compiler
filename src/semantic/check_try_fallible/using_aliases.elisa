                match pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Or(options):
                        return any option in options where try_noncall_pattern_is_match_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where try_noncall_pattern_is_match_catchall(wrapped)
                    _:
                        return false

        def try_noncall_pattern_is_error_catchall(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Wildcard:
                        return true
                    Pattern.TypeBind(type_name, _):
                        return type_name == "error"
                    Pattern.Or(options):
                        return any option in options where try_noncall_pattern_is_error_catchall(option)
                    Pattern.As(_, inner):
                        return any wrapped in inner where try_noncall_pattern_is_error_catchall(wrapped)
                    _:
                        return false

        def try_noncall_catch_error_arms_terminate(arms: darray[Ast::MatchArm],
                annotations: darray[Ast::EnumAnnotation]&, lexical_module: sview) -> bool:
            can Abort.Panic:
                return false if arms.count < 2
                covered_errors: mutable bool = false
                uncovered_guarded_error: mutable bool = false
                for index in 1..<arms.count |arms, covered_errors, uncovered_guarded_error|:
                    arm: Ast::MatchArm = arms[index]
                    if try_noncall_guard_is_definitely_false(arm.guard):
                        uncovered_guarded_error <- true
                        continue
                    continue if try_noncall_expression_aborts_with_annotations(arm.guard, annotations, lexical_module)
                    return false if not try_noncall_block_terminates_with_annotations(arm.body, annotations, lexical_module)
                    if arm.guard is Expr.Absent and try_noncall_pattern_is_error_catchall(arm.pattern):
                        covered_errors <- true
                        break
                    uncovered_guarded_error <- true if not (arm.guard is Expr.Absent)
                # Catch exhaustiveness is checked separately against the guarded callable's
                # declared error set, so a sequence of unguarded variant arms can be total.
                return covered_errors or not uncovered_guarded_error
