extend Semantic:
    private:
        def try_noncall_visible_using_alias_target(environment: TryNonCallErrorFamilyEnv&, alias_name: sview) -> (known: bool, module: sview, target: sview):
            can Abort.Panic:
                for index in 0..<environment.using_alias_names.count |environment, alias_name|:
                    if environment.using_alias_names[index] == alias_name:
                        known: bool = environment.using_alias_known[index] if index < environment.using_alias_known.count else false
                        return (known, environment.using_alias_modules[index], environment.using_alias_targets[index])
                return (false, "", "")

        # Resolve the qualifier from its last component back to the alias head while
        # consuming the same suffix from the cached declaration module. This supports
        # aliases used as a prefix, such as O::Inner::load for using Outer as O.
        def try_noncall_using_alias_qualifier_matches_module(qualifier: Ast::Expr, alias_name: sview, target_module: sview, candidate_module: sview) -> bool:
            can Abort.Panic:
                match qualifier:
                    Expr.Ident(name, _):
                        return name == alias_name and candidate_module == target_module
                    Expr.Scope(base, name, _):
                        return module_last_segment(candidate_module) == name and try_noncall_using_alias_qualifier_matches_module(base, alias_name, target_module, try_noncall_module_parent(candidate_module))
                    Expr.Paren(inner, _):
                        return try_noncall_using_alias_qualifier_matches_module(inner, alias_name, target_module, candidate_module)
                    _:
                        return false

        def try_noncall_callable_matches_using_alias(callee: Ast::Expr, alias_index: usize, candidate_module: sview, environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                alias_name: sview = environment.using_alias_names[alias_index]
                alias_module: sview = environment.using_alias_modules[alias_index]
                target_module: sview = environment.using_alias_targets[alias_index]
                match callee:
                    Expr.Scope(qualifier, _, _):
                        visible_alias: (known: bool, module: sview, target: sview) = try_noncall_visible_using_alias_target(environment, alias_name)
                        return visible_alias.known and visible_alias.module == alias_module and visible_alias.target == target_module and try_noncall_using_alias_qualifier_matches_module(qualifier, alias_name, target_module, candidate_module)
                    Expr.Paren(inner, _):
                        return try_noncall_callable_matches_using_alias(inner, alias_index, candidate_module, environment)
                    _:
                        return false

        def try_noncall_cached_first_parameter_argument_index(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, formal_name: sview) -> usize:
            can Abort.Panic:
                named_matches: mutable usize = 0.usize()
                named_index: mutable usize = arguments.count
                positional_prefix: mutable usize = 0.usize()
                has_named_arguments: mutable bool = false
                for index in 0..<arguments.count |named_matches, named_index, positional_prefix, has_named_arguments, argument_names, formal_name|:
                    argument_name: sview = argument_names[index] if index < argument_names.count else ""
                    if argument_name != "":
                        has_named_arguments <- true
                        if formal_name != "" and argument_name == formal_name:
                            named_matches <- named_matches + 1.usize()
                            named_index <- index
                    elif not has_named_arguments:
                        positional_prefix <- positional_prefix + 1.usize()
                positional_index: usize = 0.usize() if positional_prefix > 0.usize() else arguments.count
                return arguments.count if named_matches > 1.usize()
                return arguments.count if named_matches == 1.usize() and positional_index < arguments.count
                return named_index if named_matches == 1.usize()
                return 0.usize() if positional_prefix > 0.usize()
                return arguments.count

        def try_noncall_cached_builtin_type(type_name: sview) -> bool:
            can Abort.Panic:
                return type_name in {"bool", "char", "string", "int", "i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "isize", "usize", "uintptr", "f32", "f64"}

        def try_noncall_cached_integer_type(type_name: sview) -> bool:
            can Abort.Panic:
                return type_name in {"char", "int", "i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "isize", "usize", "uintptr"}

        def try_noncall_cached_receiver_type_matches(formal_type: sview, actual_type: sview) -> bool:
            can Abort.Panic:
                return true if formal_type == actual_type
                return actual_type == "int" and try_noncall_cached_integer_type(formal_type)

        def try_noncall_cached_argument_type_name(expression: Ast::Expr, params: darray[Ast::ParamDecl]) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        for parameter in params:
                            if parameter.name == name:
                                match parameter.type_expression:
                                    Expr.Ident(type_name, _):
                                        return type_name if try_noncall_cached_builtin_type(type_name)
                                    _:
                                        pass
                    Expr.BoolLit(_, _):
                        return "bool"
                    Expr.CharLit(_, _):
                        return "char"
                    Expr.StringLit(_, _):
                        return "string"
                    Expr.Paren(inner, _):
                        return try_noncall_cached_argument_type_name(inner, params)
                    _:
                        pass
                return ""

        # Core's receiver set spans every visible lexical candidate, wildcard
        # import, and the first selective alias; a private row in a different
        # candidate module can still outrank the ordinary cached lookup result.
        def try_noncall_cached_callable_in_ufcs_set(callee_name: sview, candidate_module: sview, callee_qualifier: sview, callee: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                if callee_qualifier != "":
                    return try_noncall_qualified_module_matches(callee, candidate_module, callee_name, environment, true)
                return true if try_noncall_module_is_ancestor(candidate_module, environment.current_module)
                for import_index in 0..<environment.callable_wildcard_import_modules.count |callee_name, candidate_module, import_index, environment|:
                    continue if environment.callable_wildcard_import_modules[import_index] != candidate_module
                    return true if try_noncall_module_is_ancestor(environment.callable_wildcard_import_scopes[import_index], environment.current_module)
                for import_index in 0..<environment.callable_imported_member_names.count |callee_name, candidate_module, import_index, environment|:
                    continue if environment.callable_imported_member_names[import_index] != callee_name
                    return candidate_module == environment.callable_imported_member_modules[import_index]
                return false

        # A static binding whose condition cannot be evaluated must not let cached
        # declarations determine a qualified call's ErrorSet. For aliases, matching the
        # written head is enough: the call may mean the alias target or the raw module.
        def try_noncall_static_binding_may_affect_call(callee_name: sview, callee_qualifier: sview, callee: Ast::Expr, environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                alias_head: mutable sview = callee_qualifier
                for offset in 0..<callee_qualifier.len |alias_head, callee_qualifier|:
                    if offset + 1.usize() < callee_qualifier.len and callee_qualifier[offset] == 58 and callee_qualifier[offset + 1.usize()] == 58:
                        alias_head <- callee_qualifier[0:offset]
                        break
                for binding_index in 0..<environment.unresolved_static_bindings.count |binding_index, callee_name, callee_qualifier, alias_head, callee, environment|:
                    unresolved: Ast::EnumAnnotation = environment.unresolved_static_bindings[binding_index]
                    target_module: sview = environment.unresolved_static_binding_targets[binding_index] if binding_index < environment.unresolved_static_binding_targets.count else ""
                    if unresolved.name == "__from_member" and callee_qualifier == "" and unresolved.detail_name == callee_name:
                        for callable_index in 0..<environment.callable_names.count |callee_name, target_module, environment|:
                            return true if environment.callable_names[callable_index] == callee_name and (target_module == "" or environment.callable_modules[callable_index] == target_module) and environment.callable_visible[callable_index]
                    if unresolved.name == "__binding_wildcard_import" and callee_qualifier == "" and try_noncall_module_is_ancestor(unresolved.module, environment.current_module) and target_module != "" and target_module == unresolved.detail_name:
                        for callable_index in 0..<environment.callable_names.count |callee_name, target_module, environment|:
                            return true if environment.callable_names[callable_index] == callee_name and environment.callable_modules[callable_index] == target_module and environment.callable_visible[callable_index]
                    if unresolved.name == "__binding_wildcard_import" and callee_qualifier == "" and try_noncall_module_is_ancestor(unresolved.module, environment.current_module) and target_module == "":
                        for callable_index in 0..<environment.callable_names.count |callee_name, environment|:
                            return true if environment.callable_names[callable_index] == callee_name and environment.callable_visible[callable_index]
                    if unresolved.name == "__using_alias" and callee_qualifier != "" and unresolved.detail_name == alias_head:
                        resolved_alias: (known: bool, module: sview, target: sview) = try_noncall_visible_using_alias_target(environment, alias_head)
                        continue if resolved_alias.known
                        for callable_index in 0..<environment.callable_names.count |callee_name, environment|:
                            return true if environment.callable_names[callable_index] == callee_name and environment.callable_visible[callable_index]
                return false

        # Cached facts omit TypeIds, so only disprove a hidden candidate when a
        # caller's first argument has an unambiguous builtin type. If a hidden
        # declaration can match and tie or outrank the visible row, do not infer
        # an ErrorSet from that visible sibling.
        def try_noncall_cached_hidden_candidate_blocks(selected_index: usize, callee_name: sview, callee_qualifier: sview, callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> bool:
            can Abort.Panic:
                has_hidden_sibling: mutable bool = false
                for index in 0..<environment.callable_names.count |has_hidden_sibling, environment, callee_name, callee_qualifier, callee|:
                    if environment.callable_names[index] == callee_name and not environment.callable_visible[index] and try_noncall_cached_callable_in_ufcs_set(callee_name, environment.callable_modules[index], callee_qualifier, callee, environment):
                        has_hidden_sibling <- true
                return false if not has_hidden_sibling
                return true if selected_index >= environment.callable_max_param_counts.count or selected_index >= environment.callable_has_default_params.count or selected_index >= environment.callable_variadic.count
                return true if not environment.callable_variadic[selected_index] and not environment.callable_has_default_params[selected_index] and environment.callable_max_param_counts[selected_index] != arguments.count
                for index in 0..<environment.callable_names.count |arguments, callee_name, callee_qualifier, callee, environment|:
                    continue if environment.callable_names[index] != callee_name or environment.callable_visible[index] or not try_noncall_cached_callable_in_ufcs_set(callee_name, environment.callable_modules[index], callee_qualifier, callee, environment)
                    return true if index >= environment.callable_max_param_counts.count or index >= environment.callable_has_default_params.count or index >= environment.callable_variadic.count
                    continue if not environment.callable_variadic[index] and not environment.callable_has_default_params[index] and environment.callable_max_param_counts[index] != arguments.count
                return true if selected_index >= environment.callable_first_param_names.count or selected_index >= environment.callable_first_param_type_names.count or selected_index >= environment.callable_first_param_generic.count
                selected_param_name: sview = environment.callable_first_param_names[selected_index]
                selected_type: sview = environment.callable_first_param_type_names[selected_index]
                selected_generic: bool = environment.callable_first_param_generic[selected_index]
                selected_argument_index: usize = try_noncall_cached_first_parameter_argument_index(arguments, argument_names, selected_param_name)
                return true if selected_argument_index >= arguments.count
                actual_type: sview @source = try_noncall_cached_argument_type_name(arguments[selected_argument_index], params)
                return true if actual_type == ""
                return true if not selected_generic and (selected_type == "" or not try_noncall_cached_builtin_type(selected_type) or not try_noncall_cached_receiver_type_matches(selected_type, actual_type))
                for index in 0..<environment.callable_names.count |selected_index, callee_name, callee_qualifier, callee, actual_type, selected_type, selected_generic, selected_param_name, arguments, argument_names, params, environment|:
                    continue if environment.callable_names[index] != callee_name or environment.callable_visible[index] or not try_noncall_cached_callable_in_ufcs_set(callee_name, environment.callable_modules[index], callee_qualifier, callee, environment)
                    return true if index >= environment.callable_first_param_names.count or index >= environment.callable_first_param_type_names.count or index >= environment.callable_first_param_generic.count
                    hidden_param_name: sview = environment.callable_first_param_names[index]
                    hidden_type: sview = environment.callable_first_param_type_names[index]
                    hidden_generic: bool = environment.callable_first_param_generic[index]
                    hidden_argument_index: usize = try_noncall_cached_first_parameter_argument_index(arguments, argument_names, hidden_param_name)
                    return true if hidden_argument_index >= arguments.count
                    hidden_actual_type: sview @source = try_noncall_cached_argument_type_name(arguments[hidden_argument_index], params)
                    return true if hidden_actual_type == "" or hidden_actual_type != actual_type
                    if not hidden_generic:
                        return true if hidden_type == "" or not try_noncall_cached_builtin_type(hidden_type)
                        continue if not try_noncall_cached_receiver_type_matches(hidden_type, actual_type)
                    if selected_generic:
                        return true
                    continue if hidden_generic
                    return true if hidden_type == selected_type or (actual_type == "int" and try_noncall_cached_integer_type(hidden_type) and try_noncall_cached_integer_type(selected_type))
                return false

        def try_noncall_callable_cached_facts(callee_name: sview, callee_qualifier: sview, callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize):
            can Abort.Panic:
                return (false, "", false, false, false, true, "", 0.usize()) if try_noncall_static_binding_may_affect_call(callee_name, callee_qualifier, callee, environment)
                match_count: mutable usize = 0
                callable_index: mutable usize = 0
                if callee_qualifier == "":
                    # Core searches every lexical namespace before consulting wildcard
                    # imports, so a nested `using` cannot beat an ancestor declaration.
                    # Candidate facts are premarked unknown when their module or member is
                    # private from this environment's current module; do not copy those
                    # hidden ErrorSets into cached local bindings.
                    scope_module: mutable sview = environment.current_module
                    while true |scope_module, match_count, callable_index, environment, callee_name|:
                        local_matches: mutable usize = 0
                        local_callable: mutable usize = 0
                        for index in 0..<environment.callable_names.count |local_matches, local_callable, environment, callee_name, scope_module|:
                            if environment.callable_names[index] == callee_name and environment.callable_visible[index]:
                                if environment.callable_modules[index] == scope_module:
                                    local_matches <- local_matches + 1.usize()
                                    local_callable <- index
                        if local_matches > 0.usize():
                            match_count <- local_matches
                            callable_index <- local_callable
                            break
                        break if scope_module == ""
                        scope_module <- try_noncall_module_parent(scope_module)
                    # Core builds each namespace's using list before flattening its
                    # child modules, so outer-scope usings precede nested-scope usings
                    # even when the nested module appears earlier in source.
                    if match_count == 0.usize():
                        first_visible_import_module: mutable sview = ""
                        selected_import_module: mutable sview = ""
                        selected_import_scope_length: mutable usize = environment.current_module.len + 1.usize()
                        selected_import_found: mutable bool = false
                        wildcard_ambiguous: mutable bool = false
                        for import_index in 0..<environment.callable_wildcard_import_modules.count |first_visible_import_module, selected_import_module, selected_import_scope_length, selected_import_found, wildcard_ambiguous, environment, callee_name|:
                            import_scope: sview = environment.callable_wildcard_import_scopes[import_index]
                            continue if not try_noncall_module_is_ancestor(import_scope, environment.current_module)
                            imported_matches: mutable usize = 0.usize()
                            for index in 0..<environment.callable_names.count |imported_matches, environment, callee_name, import_index|:
                                if environment.callable_names[index] == callee_name and environment.callable_visible[index] and environment.callable_modules[index] == environment.callable_wildcard_import_modules[import_index]:
                                    imported_matches <- imported_matches + 1.usize()
                            if imported_matches > 0.usize():
                                wildcard_ambiguous <- true if first_visible_import_module != "" and first_visible_import_module != environment.callable_wildcard_import_modules[import_index]
                                first_visible_import_module <- environment.callable_wildcard_import_modules[import_index] if first_visible_import_module == ""
                                if import_scope.len < selected_import_scope_length:
                                    selected_import_module <- environment.callable_wildcard_import_modules[import_index]
                                    selected_import_scope_length <- import_scope.len
                                    selected_import_found <- true
                        return (false, "", false, false, false, true, "", 0.usize()) if wildcard_ambiguous
                        if selected_import_found:
                            for index in 0..<environment.callable_names.count |match_count, callable_index, environment, callee_name, selected_import_module|:
                                if environment.callable_names[index] == callee_name and environment.callable_visible[index] and environment.callable_modules[index] == selected_import_module:
                                    match_count <- match_count + 1.usize()
                                    callable_index <- index
                    # Selective imports are a program-level alias map in Core. Only its
                    # first registered target is considered, after all wildcard imports.
                    if match_count == 0.usize():
                        for import_index in 0..<environment.callable_imported_member_names.count |match_count, callable_index, environment, callee_name|:
                            continue if environment.callable_imported_member_names[import_index] != callee_name
                            for index in 0..<environment.callable_names.count |match_count, callable_index, environment, callee_name, import_index|:
                                if environment.callable_names[index] == callee_name and environment.callable_visible[index] and environment.callable_modules[index] == environment.callable_imported_member_modules[import_index]:
                                    match_count <- match_count + 1.usize()
                                    callable_index <- index
                            break
                else:
                    for index in 0..<environment.callable_names.count |match_count, callable_index, environment, callee_name, callee_qualifier, callee|:
                        module_matches: mutable bool = try_noncall_qualified_module_matches(callee, environment.callable_modules[index], callee_name, environment, false)
                        if environment.callable_names[index] == callee_name and environment.callable_visible[index] and module_matches:
                            match_count <- match_count + 1.usize()
                            callable_index <- index
                if match_count == 1.usize():
                    return (false, "", false, false, false, true, "", 0.usize()) if not environment.callable_facts_known[callable_index]
                    return (false, "", false, false, false, true, "", 0.usize()) if try_noncall_cached_hidden_candidate_blocks(callable_index, callee_name, callee_qualifier, callee, arguments, argument_names, params, environment)
                    return (true, environment.callable_families[callable_index], environment.callable_numeric[callable_index], environment.callable_integer[callable_index], environment.callable_return_nonfallible[callable_index], false, environment.callable_generic_return_formal_names[callable_index], environment.callable_generic_return_formal_indices[callable_index])
                return (false, "", false, false, false, match_count > 1.usize(), "", 0.usize())

        def try_noncall_generic_call_argument_index(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, formal_name: sview, formal_index: usize) -> usize:
            can Abort.Panic:
                named_matches: mutable usize = 0
                named_index: mutable usize = arguments.count
                positional_prefix: mutable usize = 0
                has_named_arguments: mutable bool = false
                for index in 0..<arguments.count |named_matches, named_index, positional_prefix, has_named_arguments, argument_names, formal_name|:
                    argument_name: sview = argument_names[index] if index < argument_names.count else ""
                    if argument_name != "":
                        has_named_arguments <- true
                        if argument_name == formal_name:
                            named_matches <- named_matches + 1.usize()
                            named_index <- index
                    elif not has_named_arguments:
                        positional_prefix <- positional_prefix + 1.usize()
                positional_index: usize = formal_index if formal_index < positional_prefix else arguments.count
                return arguments.count if named_matches > 1.usize()
                return arguments.count if named_matches == 1.usize() and positional_index < arguments.count
                return named_index if named_matches == 1.usize()
                return positional_index

        def try_noncall_assignment_cached_source_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (family: sview @source, known_nonfallible: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return (try_noncall_family_lookup(environment, name), try_noncall_family_known_nonfallible(environment, name))
                    Expr.Paren(inner, _):
                        return try_noncall_assignment_cached_source_facts(inner, params, environment)
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        return ("", false) if callee_name == ""
                        if callee_qualifier == "":
                            return ("", false) if try_noncall_family_index(environment, callee_name) < environment.names.count
                            for parameter in params:
                                return ("", false) if parameter.name == callee_name
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, arguments, argument_names, params, environment)
                        return ("", false) if not call_facts.known
                        if call_facts.family == "" and call_facts.generic_formal_name != "":
                            argument_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, call_facts.generic_formal_name, call_facts.generic_formal_index)
                            return try_noncall_assignment_cached_source_facts(arguments[argument_index], params, environment) if argument_index < arguments.count
                        return (call_facts.family, call_facts.return_nonfallible)
                    Expr.If(condition, then_value, else_value, _):
                        return ("", false) if try_noncall_expression_aborts(condition)
                        condition_bool: (known: bool, value: bool) = try_noncall_literal_bool(condition)
                        return try_noncall_assignment_cached_source_facts(then_value, params, environment) if condition_bool.known and condition_bool.value
                        return try_noncall_assignment_cached_source_facts(else_value, params, environment) if condition_bool.known
                        then_aborts: bool = try_noncall_expression_aborts(then_value)
                        else_aborts: bool = try_noncall_expression_aborts(else_value)
                        return ("", false) if then_aborts and else_aborts
                        return try_noncall_assignment_cached_source_facts(else_value, params, environment) if then_aborts
                        return try_noncall_assignment_cached_source_facts(then_value, params, environment) if else_aborts
                        then_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_cached_source_facts(then_value, params, environment)
                        else_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_cached_source_facts(else_value, params, environment)
                        return (then_facts.family, false) if then_facts.family != "" and then_facts.family == else_facts.family
                        return (then_facts.family, false) if then_facts.family != "" and else_facts.family == "" and else_facts.known_nonfallible
                        return (else_facts.family, false) if else_facts.family != "" and then_facts.family == "" and then_facts.known_nonfallible
                        return ("", true) if then_facts.family == "" and else_facts.family == "" and then_facts.known_nonfallible and else_facts.known_nonfallible
                    _:
                        pass
                return ("", false)

        def try_noncall_assignment_update_add(updates: mutable TryNonCallAssignmentUpdates&, name: sview @source, family: sview @source, known_nonfallible: bool, origin: usize, numeric: bool, integer: bool, catch_payload_family: sview @source = "", catch_payload_known_nonfallible: bool = false, catch_payload_numeric: bool = false, catch_payload_integer: bool = false) -> void:
            can Memory.Allocate, Abort.Panic:
                updates.names.push(name)
                updates.families.push(family)
                updates.catch_payload_families.push(catch_payload_family)
                updates.catch_payload_known_nonfallible.push(catch_payload_known_nonfallible)
                updates.catch_payload_numeric.push(catch_payload_numeric)
                updates.catch_payload_integer.push(catch_payload_integer)
                updates.known_nonfallible.push(known_nonfallible)
                updates.numeric.push(numeric)
                updates.integer.push(integer)
                updates.origins.push(origin)

        def try_noncall_callable_source_facts(callee_name: sview @source, callee_qualifier: sview, callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool):
            can Abort.Panic:
                cached_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, arguments, argument_names, params, environment)
                if cached_facts.known:
                    if cached_facts.family == "" and cached_facts.generic_formal_name != "":
                        argument_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, cached_facts.generic_formal_name, cached_facts.generic_formal_index)
                        if argument_index < arguments.count:
                            actual_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(arguments[argument_index], params, environment, annotations)
                            return (actual_facts.family != "" or actual_facts.known_nonfallible, actual_facts.family, try_noncall_numeric_value(arguments[argument_index], params, environment), try_noncall_integer_value(arguments[argument_index], params, environment), actual_facts.known_nonfallible)
                    return (cached_facts.known, cached_facts.family, cached_facts.numeric, cached_facts.integer, cached_facts.return_nonfallible)
                return (false, "", false, false, false) if cached_facts.ambiguous or callee_qualifier != ""
                return (false, "", false, false, false) if any name in environment.callable_names where name == callee_name
                legacy_facts: (known: bool, family: sview @source) = try_noncall_callable_error_family(callee_name, annotations)
                return (legacy_facts.known, legacy_facts.family, false, false, legacy_facts.known and legacy_facts.family == "")

        def try_noncall_pattern_binding_facts(pattern: Ast::Pattern, candidate: sview) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match pattern:
                    Pattern.TypeBind(type_name, binder) if binder == candidate:
                        return try_noncall_type_name_facts(type_name)
                    Pattern.As(name, inner):
                        return (false, false, false) if name == candidate
                        for nested in inner:
                            facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(nested, candidate)
                            return facts if facts.known_nonfallible or facts.numeric or facts.integer
                    Pattern.Variant(_, fields) | Pattern.Struct(_, fields) | Pattern.Tuple(fields) | Pattern.Or(fields) | Pattern.Field(_, fields):
                        for nested in fields:
                            facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(nested, candidate)
                            return facts if facts.known_nonfallible or facts.numeric or facts.integer
                    _:
                        pass
                return (false, false, false)

        def try_noncall_expression_value_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&) -> (known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        if index < environment.names.count:
                            return (false, false, false) if environment.families[index] != ""
                            return (environment.known_nonfallible[index], environment.numeric[index], environment.integer[index])
                        for parameter in params:
                            if parameter.name == name:
                                return try_noncall_type_facts_with_aliases(parameter.type_expression, environment)
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, arguments, argument_names, params, environment)
                        return (false, false, false) if not call_facts.known or call_facts.family != ""
                        if call_facts.generic_formal_name != "":
                            argument_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, call_facts.generic_formal_name, call_facts.generic_formal_index)
                            return try_noncall_expression_value_facts(arguments[argument_index], params, environment) if argument_index < arguments.count
                        return (call_facts.return_nonfallible, call_facts.numeric, call_facts.integer)
                    Expr.Paren(inner, _):
                        return try_noncall_expression_value_facts(inner, params, environment)
                    Expr.IntLit(_, _):
                        return try_noncall_type_name_facts("i64")
                    Expr.FloatLit(_, _):
                        return try_noncall_type_name_facts("f64")
                    Expr.CharLit(_, _):
                        return try_noncall_type_name_facts("char")
                    Expr.BoolLit(_, _):
                        return try_noncall_type_name_facts("bool")
                    Expr.StringLit(_, _):
                        return try_noncall_type_name_facts("string")
                    _:
                        pass
                return (false, false, false)

        # Catch's plain success binding receives the payload after the guarded expression's
        # outer error family has been removed. Preserve a generic T actual's own error family
        # only when the generic callable also declares an error family; otherwise that family
        # is the guarded call's outer effect and Catch consumes it. A Match binder is different:
        # it receives the complete scrutinee value.
        def try_noncall_assignment_catch_payload_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        index: usize = try_noncall_family_index(environment, name)
                        if index < environment.names.count:
                            if environment.catch_payload_families[index] != "" or environment.catch_payload_known_nonfallible[index] or environment.catch_payload_numeric[index] or environment.catch_payload_integer[index]:
                                return (environment.catch_payload_families[index], environment.catch_payload_known_nonfallible[index], environment.catch_payload_numeric[index], environment.catch_payload_integer[index])
                            if environment.families[index] != "":
                                return ("", false, environment.numeric[index], environment.integer[index])
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: sview @source = try_noncall_unqualified_callable_name(callee)
                        callee_qualifier: sview @source = try_noncall_callable_qualifier(callee)
                        call_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool, ambiguous: bool, generic_formal_name: sview @source, generic_formal_index: usize) = try_noncall_callable_cached_facts(callee_name, callee_qualifier, callee, arguments, argument_names, params, environment)
                        if call_facts.known and call_facts.generic_formal_name != "":
                            argument_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, call_facts.generic_formal_name, call_facts.generic_formal_index)
                            if argument_index < arguments.count:
                                actual_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(arguments[argument_index], params, environment, annotations)
                                actual_value_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_expression_value_facts(arguments[argument_index], params, environment)
                                payload_family: sview @source = actual_facts.family if call_facts.family != "" else ""
                                return (payload_family, actual_value_facts.known_nonfallible, actual_value_facts.numeric, actual_value_facts.integer)
                        source_facts: (known: bool, family: sview @source, numeric: bool, integer: bool, return_nonfallible: bool) = try_noncall_callable_source_facts(callee_name, callee_qualifier, callee, arguments, argument_names, params, environment, annotations)
                        return ("", source_facts.return_nonfallible, source_facts.numeric, source_facts.integer) if source_facts.known and source_facts.family != ""
                    Expr.Paren(inner, _):
                        return try_noncall_assignment_catch_payload_facts(inner, params, environment, annotations)
                    _:
                        pass
                return ("", false, false, false)

        def try_noncall_catch_success_payload_facts(expression: Ast::Expr, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool):
            can Abort.Panic:
                guarded_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(expression, params, environment, annotations)
                return ("", false, false, false) if guarded_facts.family == ""
                return try_noncall_assignment_catch_payload_facts(expression, params, environment, annotations)

        def try_noncall_target_binds_name(target: Ast::Expr, candidate: sview) -> bool:
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return name == candidate
                    Expr.Paren(inner, _):
                        return try_noncall_target_binds_name(inner, candidate)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        for element in elements:
                            return true if try_noncall_target_binds_name(element, candidate)
                    _:
                        pass
                return false

        def try_noncall_target_source_facts(target: Ast::Expr, value: Ast::Expr, candidate: sview, params: darray[Ast::ParamDecl], environment: TryNonCallErrorFamilyEnv&, annotations: darray[Ast::EnumAnnotation]&) -> (found: bool, family: sview @source, known_nonfallible: bool):
            can Abort.Panic:
                match target:
                    Expr.Ident(name, _):
                        return (false, "", false) if name != candidate
                        source_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(value, params, environment, annotations)
                        return (true, source_facts.family, source_facts.known_nonfallible)
                    Expr.Paren(inner, _):
                        return try_noncall_target_source_facts(inner, value, candidate, params, environment, annotations)
                    Expr.Tuple(targets, _) | Expr.Array(targets, _):
                        match value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                return (true, "", false) if targets.count != values.count and try_noncall_target_binds_name(target, candidate)
                                for index in 0..<targets.count:
                                    if try_noncall_target_binds_name(targets[index], candidate):
                                        return try_noncall_target_source_facts(targets[index], values[index], candidate, params, environment, annotations) if index < values.count
                                        return (true, "", false)
                            _:
                                pass
                        return (true, "", false) if try_noncall_target_binds_name(target, candidate)
                    _:
                        pass
                return (false, "", false)

        def try_noncall_expression_is_name(expression: Ast::Expr, candidate: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name == candidate
                    Expr.Paren(inner, _):
                        return try_noncall_expression_is_name(inner, candidate)
                    _:
                        return false

