extend Semantic:
    private:
        def try_fallback_cast_target_has_ref(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, target_line):
                        if selector == "cast":
                            return try_fallback_cast_target_has_ref(target)
                    Expr.Unary(operator, operand, unary_line):
                        return true if operator == TokenKind.Ampersand
                        return try_fallback_cast_target_has_ref(operand)
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_has_ref(inner)
                    _:
                        pass
                return false

        def try_fallback_cast_target_spelling(expression: Ast::Expr) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, target_line):
                        return try_fallback_cast_target_base(target) if selector == "cast"
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_spelling(inner)
                    _:
                        pass
                return sview("", 0, 0)

        # Compare the compact spelling available for an extern return with the compact
        # spelling recovered from a cast fallback. A pointer target is kept as `base` plus
        # `detail` because the target expression itself is a borrowed AST view and the
        # diagnostic renderer appends the reference marker separately.
        def try_fallback_declared_name_matches(expected: sview, actual: sview, actual_detail: sview) -> bool:
            can Abort.Panic:
                return false if expected == "" or actual == ""
                if actual_detail == "&":
                    expected_length: usize = expected.len
                    return false if expected_length < 2.usize() or expected[expected_length - 1.usize()] != 38
                    return expected[0:expected_length - 1.usize()] == actual
                return expected == actual

        # Callable extern declarations keep their return head in a parser annotation rather
        # than in Symbol.return_type: the compact AST intentionally leaves that symbol field
        # empty because the backend reconstructs pointer/heap/optional ABI shape from the
        # parallel extern rows. Use the declaration line to pair the anonymous
        # `__extern_return` row with its callable declaration. This helper is only a fallback
        # for this compact checker; ordinary call inference must continue using its existing
        # ABI path.
        # This fallback walker has only the bare callee name, not Core's selected DeclId. A
        # same-name overload or module sibling therefore cannot be assigned soundly here. Return
        # a declaration key only when the Func name is globally unique; otherwise fail closed.
        # The offset keeps the side-table join exact for that unique declaration. Keep the
        # canonical scan for an incomplete index so a partial chain cannot hide a declaration.
        def try_fallback_extern_declaration_line(table: SymbolTable&, name: sview) -> (found: bool, line: u32, offset: u32):
            can Abort.Panic:
                if table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count:
                    hash: u64 = name_hash(name)
                    if table.symbol_name_count.get(hash) is indexed_count:
                        declaration_line: mutable u32 = 0
                        declaration_offset: mutable u32 = 0
                        function_count: mutable usize = 0.usize()
                        chain_valid: mutable bool = true
                        previous_row: mutable u32 = 0
                        has_previous: mutable bool = false
                        row: mutable u32 = symbol_chain_head(table, name)
                        steps: mutable usize = 0
                        while row != SYMBOL_INDEX_ROW_NONE and chain_valid and steps < table.symbols.count |row, steps, chain_valid, previous_row, has_previous, declaration_line, declaration_offset, function_count, table, name, hash|:
                            if row.usize() >= table.symbols.count or row.usize() >= table.symbol_name_next.count or (has_previous and row <= previous_row):
                                chain_valid <- false
                            else:
                                symbol: Symbol& = &table.symbols[row.usize()]
                                chain_valid <- false if name_hash(symbol.name) != hash
                                if chain_valid and symbol.name == name and symbol.kind == SymbolKind.Func:
                                    declaration_line <- symbol.line
                                    declaration_offset <- symbol.offset
                                    function_count <- function_count + 1.usize()
                                previous_row <- row
                                has_previous <- true
                                row <- table.symbol_name_next[row.usize()]
                                steps <- steps + 1.usize()
                        if chain_valid and row == SYMBOL_INDEX_ROW_NONE and steps == indexed_count.usize():
                            return (true, declaration_line, declaration_offset) if function_count == 1.usize()
                            return (false, 0, 0)
                function_count: mutable usize = 0.usize()
                declaration_line: mutable u32 = 0
                declaration_offset: mutable u32 = 0
                for symbol in table.symbols:
                    if symbol.name == name and symbol.kind == SymbolKind.Func:
                        function_count <- function_count + 1.usize()
                        declaration_line <- symbol.line
                        declaration_offset <- symbol.offset
                return (true, declaration_line, declaration_offset) if function_count == 1.usize()
                return (false, 0, 0)

        # Recover all side-tabled extern return shape in one pass over only the indexed
        # rows at this declaration line, filtering to the declaration offset. Preserve the
        # original first-row behavior for the head and darray element, and `any` behavior
        # for ptr/optional flags.
        def try_fallback_extern_return_info(index: CallableErrorAnnotationIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, name: sview) -> TryFallbackExternReturnInfo:
            can Abort.Panic:
                declaration: (found: bool, line: u32, offset: u32) = try_fallback_extern_declaration_line(table, name)
                info: mutable TryFallbackExternReturnInfo = TryFallbackExternReturnInfo{name: "", element: "", has_pointer: false, has_optional: false}
                return info if not declaration.found
                declaration_line: u32 = declaration.line
                declaration_offset: u32 = declaration.offset
                return_type_found: mutable bool = false
                element_found: mutable bool = false
                row: mutable u32 = callable_error_extern_line_head(index, declaration_line)
                while row != CALLABLE_ERROR_ROW_NONE |row, index, annotations, declaration_line, declaration_offset, name, info, return_type_found, element_found|:
                    annotation: Ast::EnumAnnotation = annotations[index.extern_source_rows[row.usize()]]
                    if annotation.offset == declaration_offset and annotation.owner == "__extern_return" and not return_type_found:
                        info.name <- annotation.name
                        return_type_found <- true
                    if annotation.offset == declaration_offset and annotation.name == "__extern_return_darray_elem" and not element_found:
                        # The parser's row names only the first identifier after darray[.
                        # Preserve the old empty result for non-primitive element types.
                        info.element <- annotation.owner if is_bare_primitive_type(annotation.owner)
                        element_found <- true
                    info.has_pointer <- true if annotation.offset == declaration_offset and annotation.owner == "__extern_return_ptr" and annotation.name == name
                    info.has_optional <- true if annotation.offset == declaration_offset and annotation.owner == "__extern_return_optional" and annotation.name == name
                    row <- index.extern_line_next[row.usize()]
                return info

        # The element of a `.cast[darray[E]]` fallback target, when it is a plain name.
        def try_fallback_cast_target_element(expression: Ast::Expr) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(Expr.Field(receiver, selector, field_line), target, target_line):
                        if selector == "cast":
                            match target:
                                Expr.Index(indexed_head, index_argument, index_line):
                                    return ident_name_of(index_argument)
                                _:
                                    pass
                    Expr.Paren(inner, paren_line):
                        return try_fallback_cast_target_element(inner)
                    _:
                        pass
                return sview("", 0, 0)

        def check_try_fallback_type_site(fallback: Ast::Expr, site_pos: Ast::Pos, callee_name: sview @source, callee_is_fallible: bool, annotations: darray[Ast::EnumAnnotation]&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if:
                    callee_name == ""
                    not callee_is_fallible
                expected_name: mutable sview @source = function_return_type(table, callee_name)
                expected_id: u32 = function_return_type_id(table, callee_name)
                extern_info: mutable TryFallbackExternReturnInfo = TryFallbackExternReturnInfo{name: "", element: "", has_pointer: false, has_optional: false}
                if expected_name == "" or expected_id == 0:
                    extern_info <- try_fallback_extern_return_info(error_index, annotations, table, callee_name)
                    expected_name <- extern_info.name if expected_name == ""
                return if:
                    expected_name == "" or expected_name == "void"
                    expected_id != 0 and interned_kind(expected_id, table) == SemTypeKind.Void
                actual_id: u32 = try_fallback_cast_target_id(fallback, table) can Global{Read,Write}
                actual_name: sview @source = try_fallback_cast_target_spelling(fallback)
                return if expected_name == "" or actual_name == ""
                actual_detail: sview @source = "&" if try_fallback_cast_target_has_ref(fallback) else ""
                if expected_id != 0:
                    return if actual_id == 0 or type_ids_compatible(expected_id, actual_id, table)
                else:
                    # A pointer or optional extern return has no source spelling for its expected
                    # side: the message can carry the fallback's `&` (detail) but not the
                    # expected one, so a mismatch would print `expects u8` where stage0 prints
                    # `expects u8&`. Stay silent rather than reject `-> u8&` met by `.cast[u8&]`.
                    return if:
                        extern_info.has_pointer
                        extern_info.has_optional
                # An extern `-> darray[u8]` side-tables only the `darray` head; its element rides
                # on a companion row, so stage0's `expects darray[u8]` (and an element mismatch
                # such as `got darray[i32]`) is spelled from the two element names.
                expected_element: sview @source = extern_info.element if expected_id == 0 and expected_name == "darray" else ""
                actual_element: sview @source = try_fallback_cast_target_element(fallback) if expected_element != "" and actual_name == "darray" else ""
                elements_agree: bool = expected_element == "" or actual_element == "" or expected_element == actual_element
                return if elements_agree and try_fallback_declared_name_matches(expected_name, actual_name, actual_detail)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryFallbackTypeMismatch, name: callee_name, pos: site_pos, line: site_pos.line, expected: expected_name, actual: actual_name, detail: actual_detail, detail2: expected_element, detail3: actual_element})

        def try_fallback_void_expression(file: Ast::File&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, module_index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: mutable CallableErrorAnnotationIndex&, function_positions: mutable FallibleFunctionPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    # `try CALL else FALLBACK` parses to Refinement(FALLBACK, CALL) — the
                    # fallback is the FIRST child. (`refine X where P` reuses the node with
                    # the opposite sense; the literal-plus-fallible-void-call conjunction
                    # below is what keeps this from firing on one.)
                    Expr.Refinement(fallback, guarded, refinement_pos):
                        callee_name: sview @source = try_fallback_callee_name(guarded)
                        has_direct_callee: bool = callable_active_direct_function_count(table, annotations, callee_name) > 0.usize() if callee_name != "" else false
                        callable_error_index_build(annotations, error_index, true) can Global{Read,Write} if has_direct_callee and not error_index.ready
                        callee_is_fallible: mutable bool = false
                        if has_direct_callee:
                            fallback_enclosing: (line: u32, offset: u32) = enclosing_try_function_indexed(function_positions, table, refinement_pos.line, refinement_pos.offset)
                            fallback_module: sview = fallible_fn_module_indexed(module_index, module_annotations, fallback_enclosing.offset, fallback_enclosing.line)
                            fallback_scope_known: bool = fallback_enclosing.line != 0 or fallback_enclosing.offset != FALLIBLE_FUNCTION_NO_OFFSET
                            empty_try_named_arguments: darray[Ast::EnumAnnotation] = []
                            empty_try_argument_type_ids: darray[u32] = []
                            callee_is_fallible <- callable_error_indexed_returns_error(file, error_index, annotations, empty_try_named_arguments, empty_try_argument_type_ids, false, false, module_index, module_annotations, callee_name, fallback_module, "", fallback_scope_known, 0, false, 0, table)
                        table <- check_try_fallback_void_site(fallback, refinement_pos, callee_name, callee_is_fallible, table)
                        table <- check_try_fallback_type_site(fallback, refinement_pos, callee_name, callee_is_fallible, annotations, error_index, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, fallback, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, guarded, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                        table <- try_fallback_void_expression(file, effect_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for candidate in candidates |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, candidate.effect_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for capture in candidate.captures |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(file, capture, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for argument in arguments |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, argument, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Call(callee, arguments, _, _):
                        table <- try_fallback_void_expression(file, callee, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for argument in arguments |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, argument, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        table <- try_fallback_void_expression(file, object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Index(object, index, _):
                        table <- try_fallback_void_expression(file, object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, index, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.IndexN(object, arguments, _):
                        table <- try_fallback_void_expression(file, object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for argument in arguments |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, argument, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Slice(object, low, high, _):
                        table <- try_fallback_void_expression(file, object, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, low, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, high, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- try_fallback_void_expression(file, left, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, right, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Unary(operator, operand, unary_pos):
                        table <- try_fallback_void_expression(file, operand, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        table <- try_fallback_void_expression(file, operand, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Paren(inner, paren_pos):
                        table <- try_fallback_void_expression(file, inner, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, element, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.DictLit(entries, _):
                        for entry in entries |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, entry.key, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(file, entry.value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Construct(type_expression, fields, _):
                        table <- try_fallback_void_expression(file, type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for field in fields |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, field.value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.RecordUpdate(base, fields, _):
                        table <- try_fallback_void_expression(file, base, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for field in fields |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, field.value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.If(condition, then_value, else_value, _):
                        table <- try_fallback_void_expression(file, condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, then_value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, else_value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Match(scrutinee, arms, _):
                        table <- try_fallback_void_expression(file, scrutinee, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for arm in arms |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, arm.guard, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(file, arm.body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Catch(guarded, arms, _):
                        table <- try_fallback_void_expression(file, guarded, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        for arm in arms |table, module_index, error_index, function_positions| -> table:
                            table <- try_fallback_void_expression(file, arm.guard, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(file, arm.body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        table <- try_fallback_void_expression(file, iterable, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Refinement(base, predicate, _):
                        table <- try_fallback_void_expression(file, base, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, predicate, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.GetElse(guarded, recovery, _):
                        table <- try_fallback_void_expression(file, guarded, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_statements(file, recovery, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Lambda(_, body, _):
                        table <- try_fallback_void_statements(file, body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    Expr.Block(statements, value, _, _):
                        table <- try_fallback_void_statements(file, statements, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        table <- try_fallback_void_expression(file, value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                    _:
                        pass

        def try_fallback_void_statements(file: Ast::File&, statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, module_index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: mutable CallableErrorAnnotationIndex&, function_positions: mutable FallibleFunctionPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, module_index, error_index, function_positions| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- try_fallback_void_expression(file, expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Block(_, _, _, body, _):
                            table <- try_fallback_void_statements(file, body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- try_fallback_void_expression(file, type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(file, value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Assign(target, operator, value, line):
                            table <- try_fallback_void_expression(file, target, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(file, value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Return(value, line):
                            table <- try_fallback_void_expression(file, returned, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write} if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- try_fallback_void_expression(file, condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(file, then_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(file, else_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.While(condition, while_body, line):
                            table <- try_fallback_void_expression(file, condition, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(file, while_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- try_fallback_void_expression(file, iterable, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_statements(file, for_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Match(scrutinee, arms, line):
                            table <- try_fallback_void_expression(file, scrutinee, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for arm in arms |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(file, arm.guard, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                table <- try_fallback_void_statements(file, arm.body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Stmt.Contract(_, expression, _):
                            table <- try_fallback_void_expression(file, expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        _:
                            pass

        def try_fallback_void_decls(file: Ast::File&, declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, module_index: mutable FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: mutable CallableErrorAnnotationIndex&, function_positions: mutable FallibleFunctionPositionIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, module_index, error_index, function_positions| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- try_fallback_void_statements(file, body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Struct(_, members, _, _, _, invariants, _):
                            for member in members |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(file, member.type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                table <- try_fallback_void_expression(file, member.default_value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                for bit_member in member.bit_group_members |table, module_index, error_index, function_positions| -> table:
                                    table <- try_fallback_void_expression(file, bit_member.type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for invariant in invariants |table, module_index, error_index, function_positions| -> table:
                                table <- try_fallback_void_expression(file, invariant, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Enum(_, variants, _, storage_type, _):
                            table <- try_fallback_void_expression(file, storage_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            for variant in variants |table, module_index, error_index, function_positions| -> table:
                                for field_type in variant.fields |table, module_index, error_index, function_positions| -> table:
                                    table <- try_fallback_void_expression(file, field_type, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                                table <- try_fallback_void_expression(file, variant.value_expr, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Alias(_, target, _):
                            table <- try_fallback_void_expression(file, target, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Law(_, predicate, _):
                            table <- try_fallback_void_expression(file, predicate, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Const(_, type_expression, value, _, _):
                            table <- try_fallback_void_expression(file, type_expression, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                            table <- try_fallback_void_expression(file, value, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Module(module_name, module_body, module_line):
                            table <- try_fallback_void_decls(file, module_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- try_fallback_void_decls(file, scoped_body, annotations, module_index, module_annotations, error_index, function_positions, table) can Global{Read,Write}
                        _:
                            pass

        # Parser annotations retain callable imports and aliases from every static-if arm.
        # Filter only rows whose branch is provably inactive; unresolved branch selection
        # becomes a sentinel so the caller can fail closed instead of selecting a fallback.
        def try_static_binding_branch_selection(annotation: Ast::EnumAnnotation,
                annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (tracked: bool, known: bool, active: bool):
            can Abort.Panic:
                marker_name: mutable sview = "__from_member_static_branch" if annotation.owner == "__from_member" else ""
                marker_name <- "__binding_wildcard_import_static_branch" if annotation.name == "__binding_wildcard_import"
                marker_name <- "__using_alias_static_branch" if annotation.name == "__using_alias"
                return (false, true, true) if marker_name == ""
                marker_detail: sview = annotation.name if annotation.owner == "__from_member" else annotation.owner
                found_marker: mutable bool = false
                unresolved: mutable bool = false
                for marker in annotations |found_marker, unresolved, annotation, marker_name, marker_detail, file, table|:
                    continue if marker.owner != "__static_if_branch" or marker.name != marker_name or marker.detail_name != marker_detail or marker.module != annotation.module or marker.line != annotation.line or marker.offset != annotation.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- pma_static_if_row_selection(file, marker.identity_id.usize(), annotation.module, table) if marker.identity_id != 4294967295
                    return (true, true, false) if branch.known and not branch.selected
                    unresolved <- true if not branch.known
                return (true, true, true) if not found_marker
                return (true, false, false) if unresolved
                return (true, true, true)

        def try_static_binding_filtered_annotations(file: Ast::File&, table: lmut SymbolTable) -> darray[Ast::EnumAnnotation]:
            can Abort.Panic, Memory.Allocate:
                filtered: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |filtered, table| -> table:
                    branch: (tracked: bool, known: bool, active: bool) = try_static_binding_branch_selection(annotation, file.enum_annotations, file, table)
                    if branch.tracked and branch.known and not branch.active:
                        continue
                    if branch.tracked and not branch.known:
                        marker_detail: mutable sview = annotation.name if annotation.owner == "__from_member" else annotation.owner
                        if annotation.name == "__binding_wildcard_import":
                            marker_detail <- try_noncall_module_path(annotation.module, annotation.owner, table)
                        filtered.push(Ast::EnumAnnotation{owner: "__try_unresolved_static_binding", name: "__from_member", detail_name: marker_detail, module: annotation.module, line: annotation.line, offset: annotation.offset}) if annotation.owner == "__from_member"
                        filtered.push(Ast::EnumAnnotation{owner: "__try_unresolved_static_binding", name: "__binding_wildcard_import", detail_name: marker_detail, module: annotation.module, line: annotation.line, offset: annotation.offset}) if annotation.name == "__binding_wildcard_import"
                        filtered.push(Ast::EnumAnnotation{owner: "__try_unresolved_static_binding", name: "__using_alias", detail_name: marker_detail, module: annotation.module, line: annotation.line, offset: annotation.offset}) if annotation.name == "__using_alias"
                        continue
                    filtered.push(annotation)
                # Try's callable index is also built from declarations in every
                # static-if arm. Mark only functions whose complete branch ancestry is
                # proven inactive; unresolved branch selection remains conservative.
                # The parser row already carries the declaration's exact identity, so
                # resolve each function marker once instead of rescanning it per symbol.
                for marker in file.enum_annotations |filtered, file, table|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__function_static_branch"
                    if marker.identity_id == 4294967295:
                        filtered.push(Ast::EnumAnnotation{owner: "__try_unresolved_function", name: marker.detail_name, module: marker.module, line: marker.line, offset: marker.offset})
                        continue
                    branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, marker.identity_id.usize(), marker.module, table)
                    filtered.push(Ast::EnumAnnotation{owner: "__try_inactive_function", name: marker.detail_name, module: marker.module, line: marker.line, offset: marker.offset}) if branch.known and not branch.selected
                    filtered.push(Ast::EnumAnnotation{owner: "__try_unresolved_function", name: marker.detail_name, module: marker.module, line: marker.line, offset: marker.offset}) if not branch.known
                return filtered

    public:
        def check_try_fallible(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                rebind try_annotations: darray[Ast::EnumAnnotation], table = try_static_binding_filtered_annotations(file, table)
                projection: mutable FallibleTryAnnotationProjection = FallibleTryAnnotationProjection{module_annotations: [], error_set_annotations: [], error_set_family_paths: [], try_qualifiers: {}, try_arities: {}, try_named_arguments: [], try_argument_positions: []}
                module_index: mutable FallibleFunctionModuleIndex = FallibleFunctionModuleIndex{by_line: {}, by_offset: {}, unknown_offset_by_line: {}, ready: false}
                fallback_function_positions: mutable FallibleFunctionPositionIndex = FallibleFunctionPositionIndex{positions: [], offsets_ordered: true, ready: false}
                try_site_count: mutable usize = 0
                fallback_site_count: mutable usize = 0
                error_index: mutable CallableErrorAnnotationIndex = CallableErrorAnnotationIndex{heads: {}, tails: {}, next: [], source_rows: [], extern_line_heads: {}, extern_line_tails: {}, extern_line_next: [], extern_source_rows: [], ready: false}
                projection_ready: mutable bool = false
                for row in 0..<try_annotations.count |projection, try_site_count, fallback_site_count, projection_ready, try_annotations|:
                    annotation: Ast::EnumAnnotation = try_annotations[row]
                    if annotation.name == "__try_without_else" and annotation.owner != "__unknown_call":
                        try_site_count <- try_site_count + 1.usize()
                        if not projection_ready:
                            for prefix_row in 0..<row |projection, try_annotations|:
                                fallible_try_projection_add(projection, try_annotations[prefix_row]) can Global{Read,Write}
                            projection_ready <- true
                    if annotation.owner == "__try_fallback_expression":
                        fallback_site_count <- fallback_site_count + 1.usize()
                        if not projection_ready:
                            for prefix_row in 0..<row |projection, try_annotations|:
                                fallible_try_projection_add(projection, try_annotations[prefix_row]) can Global{Read,Write}
                            projection_ready <- true
                    fallible_try_projection_add(projection, annotation) can Global{Read,Write} if projection_ready
                fallible_function_module_index_build(module_index, projection.module_annotations) can Global{Read,Write} if try_site_count > 0 or fallback_site_count > 0
                callable_error_index_build(try_annotations, error_index, true) can Global{Read,Write} if try_site_count > 0
                table <- check_try_fallible_rows(file, file.top_decls, try_annotations, projection.try_named_arguments, projection.try_argument_positions, projection.error_set_annotations, projection.error_set_family_paths, module_index, projection.module_annotations, projection.try_qualifiers, projection.try_arities, error_index, try_site_count, table) can Global{Read,Write} if try_site_count > 0
                table <- try_fallback_void_decls(file, file.top_decls, try_annotations, module_index, projection.module_annotations, error_index, fallback_function_positions, table) can Global{Read,Write} if fallback_site_count > 0
