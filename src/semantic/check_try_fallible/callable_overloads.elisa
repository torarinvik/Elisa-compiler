extend Semantic:
    private:
        def callable_overload_declaration_is_inaccessible_arity_candidate(file: Ast::File&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview @source, try_offset: u32, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool) -> bool:
            can Abort.Panic:
                return false if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, candidate_module, declaration_offset, declaration_line, enclosing_module, callee_qualifier, try_offset, arity|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name or symbol.module_owner != candidate_module or symbol.line != declaration_line or symbol.offset != declaration_offset
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    coarse_candidate: bool = callable_symbol_core_accepts_receiver_arity(table, symbol, arity) and callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    return false if not coarse_candidate or callable_function_declaration_visible(annotations, name, candidate_module, symbol.line, symbol.offset, enclosing_module)
                    return true if argument_type_ids.count == 0.usize() or argument_type_ids[0] == 0
                    receiver: (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool) = callable_symbol_receiver_type(table, symbol)
                    return true if not receiver.found or receiver.type_id == 0
                    receiver_match: (known: bool, matches: bool) = try_overload_receiver_pattern_matches(file, receiver.type_id, argument_type_ids[0], symbol.id, enclosing_module, annotations, table, 0)
                    return false if receiver_match.known and not receiver_match.matches
                    if receiver_match.matches:
                        formal_receiver_is_ref: bool = interned_kind(receiver.type_id, table) == SemTypeKind.Ref
                        actual_receiver_is_ref: bool = interned_kind(argument_type_ids[0], table) == SemTypeKind.Ref
                        if actual_receiver_is_ref and not formal_receiver_is_ref and not try_overload_type_is_generic_parameter(receiver.type_id, symbol.id, annotations, table):
                            actual_receiver_base_id: u32 = interned_elem(argument_type_ids[0], 0, table)
                            actual_receiver_base_kind: SemTypeKind = interned_kind(actual_receiver_base_id, table)
                            return true if actual_receiver_base_kind == SemTypeKind.Int or actual_receiver_base_kind == SemTypeKind.Float or actual_receiver_base_kind == SemTypeKind.Bool
                            return false
                        if formal_receiver_is_ref and actual_receiver_is_ref:
                            return true if not receiver.mutable_ref_known or not receiver_ref_mutability_known
                            return false if receiver.mutable_ref and not receiver_ref_mutable
                        return true
                    possible_match: (potential_match: bool, ambiguous: bool) = try_overload_type_shared_ambiguous_match_state(file, receiver.type_id, argument_type_ids[0], symbol.id, enclosing_module, annotations, table, 0)
                    return possible_match.potential_match
                return false

        def callable_overload_has_inaccessible_arity_candidate(file: Ast::File&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview @source, try_offset: u32, arity: u32, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool) -> bool:
            can Abort.Panic:
                return false if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    continue if not callable_symbol_core_accepts_receiver_arity(table, symbol, arity)
                    continue if not callable_symbol_accepts_named_arguments(table, try_named_arguments, symbol, try_offset)
                    return true if callable_overload_declaration_is_inaccessible_arity_candidate(file, table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, symbol.module_owner, symbol.offset, symbol.line, enclosing_module, callee_qualifier, try_offset, arity, receiver_ref_mutability_known, receiver_ref_mutable)
                return false

        # An ambiguous TypeId should stop family inference only if receiver ranking is
        # active and an eligible concrete candidate could match that same bare spelling.
        # Singleton calls, named-argument calls, and generic-only sets retain their normal
        # ErrorSet lookup behavior.
        def callable_overload_has_ambiguous_nominal_receiver_candidate(file: Ast::File&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, try_offset: u32, arity: u32, enclosing_module: sview, callee_qualifier: sview @source) -> bool:
            can Abort.Panic:
                return false if callable_try_call_forwards_arguments(annotations, try_offset)
                return false if argument_type_ids.count == 0.usize()
                return false if not callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                for symbol in table.symbols |table, annotations, try_named_arguments, argument_type_ids, module_index, module_annotations, name, enclosing_module, callee_qualifier, try_offset, arity|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != name
                    continue if not callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, symbol.offset, symbol.line, enclosing_module, callee_qualifier, table)
                    continue if not callable_symbol_core_accepts_receiver_arity(table, symbol, arity)
                    receiver: (found: bool, type_id: u32, mutable_ref: bool, mutable_ref_known: bool) = callable_symbol_receiver_type(table, symbol)
                    ambiguous_match: (potential_match: bool, ambiguous: bool) = try_overload_type_shared_ambiguous_match_state(file, receiver.type_id, argument_type_ids[0], symbol.id, enclosing_module, annotations, table, 0) if receiver.found else (false, false)
                    return true if receiver.found and ambiguous_match.potential_match and ambiguous_match.ambiguous
                return false

        # Non-overloaded direct calls use ordinary name precedence. Overloaded calls
        # share Core's wider visible-name candidate set, which includes local and
        # imported declarations together.
        def callable_row_visible_for_try_call(module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_offset: u32, declaration_line: u32, enclosing_module: sview, callee_qualifier: sview @source, try_named_arguments: darray[Ast::EnumAnnotation]&, try_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return callable_row_in_ufcs_candidate_set_indexed(module_index, module_annotations, annotations, name, declaration_offset, declaration_line, enclosing_module, callee_qualifier, table) if callable_name_has_ufcs_overload_set_in_scope(module_index, module_annotations, annotations, name, enclosing_module, callee_qualifier, try_named_arguments, try_offset, table)
                return callable_row_in_scope_indexed(module_index, module_annotations, annotations, name, declaration_offset, declaration_line, enclosing_module, callee_qualifier, table)

        def callable_error_family(annotations: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, name: sview, enclosing_module: sview, callee_qualifier: sview @source, table: SymbolTable&) -> sview:
            fallback: mutable sview = ""
            fallback_found: mutable bool = false
            for source_row in 0..<annotations.count |name, enclosing_module, callee_qualifier, annotations, module_annotations, fallback, fallback_found|:
                scoped_annotation: Ast::EnumAnnotation = annotations[source_row]
                if scoped_annotation.owner == name and callable_error_family_row(annotations, source_row):
                    if not fallback_found:
                        fallback <- scoped_annotation.name
                        fallback_found <- true
                    return scoped_annotation.name if callable_row_in_scope(annotations, module_annotations, scoped_annotation.offset, scoped_annotation.line, enclosing_module, callee_qualifier, name, table)
            return fallback

        # The module qualifier written at a `try` call site, "" for a bare call.
        def try_callee_qualifier(index: dict[u64, sview]&, try_offset: u32) -> sview:
            can Abort.Panic:
                if index.get(try_offset.u64()) is qualifier:
                    # Re-wrap the stored view by value: the same data and length, so no new
                    # extent is claimed.
                    trusted Unsafe.PointerCast:
                        return StringView{data: qualifier.data, len: qualifier.len}
                return ""

        def try_callee_arity(index: dict[u64, u32]&, try_offset: u32) -> (known: bool, value: u32):
            can Abort.Panic:
                if index.get(try_offset.u64()) is arity:
                    return (true, arity)
                return (false, 0)

        # A declaration line and function offset identify the enclosing callable, while
        # occurrence_offset selects its return error set among callback parameter sets.
        def try_enclosing_return_occurrence(annotations: darray[Ast::EnumAnnotation]&, function_line: u32, function_offset: u32) -> (found: bool, occurrence_offset: u32, identity_id: u32):
            can Abort.Panic:
                occurrence_offset: mutable u32 = 0
                identity_id: mutable u32 = 0
                marker_count: mutable usize = 0.usize()
                for marker in annotations |occurrence_offset, identity_id, marker_count, function_line, function_offset|:
                    continue if marker.name != "__error_return" or marker.line != function_line
                    continue if function_offset != FALLIBLE_FUNCTION_NO_OFFSET and marker.offset != function_offset
                    marker_count <- marker_count + 1.usize()
                    occurrence_offset <- marker.occurrence_offset
                    identity_id <- marker.identity_id
                return (marker_count == 1.usize(), occurrence_offset, identity_id)

        # The function enclosing a `try`: by BYTE OFFSET when both sides carry one — lines
        # restart per included file once `#line` directives are spliced, so the largest
        # function line at or before the try's line is not the enclosing function — and by
        # line for producers that recorded no offset (extern callables), as before.
        def enclosing_try_function(table: SymbolTable&, try_line: u32, try_offset: u32) -> (line: u32, offset: u32):
            best_line: mutable u32 = FALLIBLE_FUNCTION_NO_LINE
            best_offset_line: mutable u32 = FALLIBLE_FUNCTION_NO_LINE
            best_offset: mutable u32 = 0
            best_offset_found: mutable bool = false
            for symbol in table.symbols |best_line, best_offset_line, best_offset, best_offset_found|:
                if symbol.kind == SymbolKind.Func:
                    best_line <- symbol.line if symbol.line <= try_line and symbol.line >= best_line
                    if try_offset != FALLIBLE_FUNCTION_NO_OFFSET and symbol.offset != FALLIBLE_FUNCTION_NO_OFFSET and symbol.offset <= try_offset and (not best_offset_found or symbol.offset >= best_offset):
                        best_offset <- symbol.offset
                        best_offset_line <- symbol.line
                        best_offset_found <- true
            # Named tuples are constructed positionally; `(line: …)` is only the type spelling.
            return (best_offset_line, best_offset) if best_offset_found
            return (best_line, FALLIBLE_FUNCTION_NO_OFFSET)

        def fallible_function_position_index_build(index: mutable FallibleFunctionPositionIndex&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                positions: mutable darray[FallibleFunctionPosition] = []
                offsets_ordered: mutable bool = true
                saw_previous: mutable bool = false
                previous_offset: mutable u32 = 0
                for symbol in table.symbols |positions, offsets_ordered, saw_previous, previous_offset|:
                    if symbol.kind == SymbolKind.Func and symbol.offset != FALLIBLE_FUNCTION_NO_OFFSET:
                        offsets_ordered <- false if saw_previous and symbol.offset < previous_offset
                        positions <- positions.push(FallibleFunctionPosition{offset: symbol.offset, line: symbol.line})
                        previous_offset <- symbol.offset
                        saw_previous <- true
                index.positions <- positions
                index.offsets_ordered <- offsets_ordered
                index.ready <- true

        def enclosing_try_function_indexed(index: mutable FallibleFunctionPositionIndex&, table: SymbolTable&, try_line: u32, try_offset: u32) -> (line: u32, offset: u32):
            can Memory.Allocate, Abort.Panic:
                if not index.ready:
                    fallible_function_position_index_build(index, table)
                if try_offset != FALLIBLE_FUNCTION_NO_OFFSET and index.offsets_ordered:
                    low: mutable usize = FALLIBLE_FUNCTION_FIRST_POSITION
                    high: mutable usize = index.positions.count
                    while low < high |low, high, index, try_offset|:
                        middle: usize = low + (high - low) / FALLIBLE_FUNCTION_SEARCH_DIVISOR
                        if index.positions[middle].offset <= try_offset:
                            low <- middle + FALLIBLE_FUNCTION_POSITION_STEP
                        else:
                            high <- middle
                    if low > FALLIBLE_FUNCTION_FIRST_POSITION:
                        position: FallibleFunctionPosition = index.positions[low - FALLIBLE_FUNCTION_POSITION_STEP]
                        return (position.line, position.offset)
                return enclosing_try_function(table, try_line, try_offset)

        # Name-only family references are comparable only when the family leaf names
        # exactly one canonical module. A missing declaration offset is explicit, while
        # logical line zero remains a valid source line and must not imply missing scope.
        # The parser's ErrorSet row points at the name token, while its LSP row and
        # static-branch marker point at the declaration keyword. Join those positions
        # through the LSP name position so only this exact ErrorSet declaration is
        # removed when its branch is proven inactive.
        def try_error_set_decl_is_static_inactive(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, declaration: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                declaration_keyword_offset: mutable u32 = 0
                name_row_count: mutable usize = 0.usize()
                for name_row in annotations |declaration_keyword_offset, name_row_count, declaration|:
                    continue if name_row.owner != "__lsp_decl_name" or name_row.name != declaration.name or name_row.line != declaration.line or name_row.pos.offset != declaration.offset
                    declaration_keyword_offset <- name_row.offset
                    name_row_count <- name_row_count + 1.usize()
                return false if name_row_count != 1.usize()
                return try_overload_nominal_type_declaration_is_static_inactive(file, annotations, declaration.name, declaration.module, declaration.line, declaration_keyword_offset, table)

        def try_error_family_name_has_unique_module(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, family: sview, expected_module_known: bool, expected_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                selected_module: mutable sview @source = ""
                module_found: mutable bool = false
                for declaration in annotations |selected_module, module_found, family, file, table|:
                    continue if declaration.owner != "__error_set_decl" or declaration.name != family
                    continue if try_error_set_decl_is_static_inactive(file, annotations, declaration, table)
                    if module_found:
                        return false if declaration.module != selected_module
                    else:
                        selected_module <- declaration.module
                        module_found <- true
                return module_found and (not expected_module_known or selected_module == expected_module)

        def try_error_family_refs_match(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, source: TryErrorFamilyRef, destination: TryErrorFamilyRef, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if source.family != destination.family
                return source.module == destination.module if source.module_known and destination.module_known
                return false if source.declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET and destination.declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET
                expected_module_known: bool = source.module_known or destination.module_known
                expected_module: sview @source = source.module if source.module_known else destination.module
                return try_error_family_name_has_unique_module(file, annotations, source.family, expected_module_known, expected_module, table)

        # Return whether VARIANT is allowed by this declaration's captured return-set
        # occurrence. Callback parameters and adjacent members of a composite return share
        # the declaration position, so match the full family/path row key. Repeated family
        # rows in one occurrence are unioned: each matching row contributes its subset, and
        # any unrestricted row contributes the full family.
        def try_error_family_subset_status(annotations: darray[Ast::EnumAnnotation]&, family: TryErrorFamilyRef, variant: sview) -> (known: bool, restricted: bool, allowed: bool):
            can Abort.Panic:
                return (false, false, false) if family.declaration_offset == FALLIBLE_FUNCTION_NO_OFFSET or family.family_path == ""
                if family.variant_override != "":
                    matching_rows: mutable usize = 0.usize()
                    for candidate_index in 0..<annotations.count |matching_rows, annotations, family|:
                        candidate: Ast::EnumAnnotation = annotations[candidate_index]
                        continue if candidate.owner != "__error_set_family" or candidate.name != family.source_name or candidate.line != family.declaration_line or candidate.offset != family.declaration_offset or candidate.identity_id != family.declaration_identity_id or candidate.occurrence_offset != family.occurrence_offset
                        continue if candidate_index + 1.usize() >= annotations.count
                        candidate_path: Ast::EnumAnnotation = annotations[candidate_index + 1.usize()]
                        continue if candidate_path.owner != "__error_set_family_path" or candidate_path.name != family.family_path or candidate_path.line != candidate.line or candidate_path.offset != candidate.offset or candidate_path.identity_id != candidate.identity_id or candidate_path.occurrence_offset != candidate.occurrence_offset
                        matching_rows <- matching_rows + 1.usize()
                    return (false, false, false) if matching_rows == 0.usize()
                    return (true, true, variant == family.variant_override)
                family_count: mutable usize = 0.usize()
                saw_restricted: mutable bool = false
                saw_unrestricted: mutable bool = false
                allowed: mutable bool = false
                valid: mutable bool = true
                for candidate_index in 0..<annotations.count |family_count, saw_restricted, saw_unrestricted, allowed, valid, annotations, family, variant|:
                    candidate: Ast::EnumAnnotation = annotations[candidate_index]
                    continue if candidate.owner != "__error_set_family" or candidate.name != family.source_name or candidate.line != family.declaration_line or candidate.offset != family.declaration_offset or candidate.identity_id != family.declaration_identity_id or candidate.occurrence_offset != family.occurrence_offset
                    continue if candidate_index + 1.usize() >= annotations.count
                    candidate_path: Ast::EnumAnnotation = annotations[candidate_index + 1.usize()]
                    continue if candidate_path.owner != "__error_set_family_path" or candidate_path.name != family.family_path or candidate_path.line != candidate.line or candidate_path.offset != candidate.offset or candidate_path.identity_id != candidate.identity_id or candidate_path.occurrence_offset != candidate.occurrence_offset
                    family_count <- family_count + 1.usize()
                    family_row: Ast::EnumAnnotation = candidate
                    candidate_restricted: mutable bool = false
                    row_index: mutable usize = candidate_index + 2.usize()
                    while row_index < annotations.count |row_index, annotations, family, variant, family_row, candidate_restricted, saw_restricted, allowed, valid|:
                        row: Ast::EnumAnnotation = annotations[row_index]
                        break if row.owner == "__error_set_family"
                        if row.owner == "__error_variant_family":
                            saw_restricted <- true
                            candidate_restricted <- true
                            marker_matches: bool = row.name == family.source_name and row.line == family_row.line and row.offset == family_row.offset and row.identity_id == family_row.identity_id and row.occurrence_offset == family_row.occurrence_offset
                            valid <- false if not marker_matches
                            if marker_matches and row_index + 1.usize() < annotations.count:
                                allow: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                                if allow.owner == "__error_variant_allow":
                                    allow_matches: bool = allow.line == row.line and allow.offset == row.offset and allow.identity_id == row.identity_id and allow.occurrence_offset == row.occurrence_offset
                                    valid <- false if not allow_matches
                                    allowed <- true if allow_matches and allow.name == variant
                                    row_index <- row_index + 1.usize() if allow_matches
                        elif row.owner == "__error_variant_allow":
                            valid <- false
                        row_index <- row_index + 1.usize()
                    saw_unrestricted <- true if not candidate_restricted
                return (false, false, false) if family_count == 0.usize() or not valid
                return (true, saw_restricted and not saw_unrestricted, saw_unrestricted or allowed)

        # `Fault{}` is rejected by check_empty_error_set_subset. A marker without a
        # matching allow row is malformed subset metadata, not a valid zero-tag family.
        # Detect it so Try does not add a second propagation error for the same shape.
        def try_error_family_has_empty_subset(annotations: darray[Ast::EnumAnnotation]&, family: TryErrorFamilyRef) -> bool:
            can Abort.Panic:
                return false if family.declaration_offset == FALLIBLE_FUNCTION_NO_OFFSET or family.family_path == "" or family.variant_override != ""
                for family_index in 0..<annotations.count |annotations, family|:
                    family_row: Ast::EnumAnnotation = annotations[family_index]
                    continue if family_row.owner != "__error_set_family" or family_row.name != family.source_name or family_row.line != family.declaration_line or family_row.offset != family.declaration_offset or family_row.identity_id != family.declaration_identity_id or family_row.occurrence_offset != family.occurrence_offset
                    continue if family_index + 2.usize() >= annotations.count
                    path_row: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                    continue if path_row.owner != "__error_set_family_path" or path_row.name != family.family_path or path_row.line != family_row.line or path_row.offset != family_row.offset or path_row.identity_id != family_row.identity_id or path_row.occurrence_offset != family_row.occurrence_offset
                    row_index: mutable usize = family_index + 2.usize()
                    while row_index < annotations.count |row_index, annotations, family, family_row|:
                        row: Ast::EnumAnnotation = annotations[row_index]
                        break if row.owner == "__error_set_family"
                        if row.owner == "__error_variant_family" and row.name == family.source_name and row.line == family_row.line and row.offset == family_row.offset and row.identity_id == family_row.identity_id and row.occurrence_offset == family_row.occurrence_offset:
                            has_matching_allow: mutable bool = false
                            if row_index + 1.usize() < annotations.count:
                                allow: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                                has_matching_allow <- allow.owner == "__error_variant_allow" and allow.line == row.line and allow.offset == row.offset and allow.identity_id == row.identity_id and allow.occurrence_offset == row.occurrence_offset
                            return true if not has_matching_allow
                            row_index <- row_index + 1.usize()
                        row_index <- row_index + 1.usize()
                return false

        def error_family_covers(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, source: TryErrorFamilyRef, destination: TryErrorFamilyRef, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if source.family == "" or destination.family == ""
                return true if try_error_family_has_empty_subset(annotations, source)
                # A malformed destination set cannot justify a second Try coverage
                # diagnostic, even when its family differs from the source's family.
                return true if try_error_family_has_empty_subset(annotations, destination)
                if source.module_known and destination.module_known:
                    saw_source_family_tag: mutable bool = false
                    for variant_index in 0..<table.enum_variant_owner.count |saw_source_family_tag, source, destination, annotations, table|:
                        belongs_to_source: bool = table.enum_variant_owner[variant_index] == source.family and variant_index < table.enum_variant_module.count and table.enum_variant_module[variant_index] == source.module
                        if belongs_to_source:
                            saw_source_family_tag <- true
                            source_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, source, table.enum_variant_name[variant_index])
                            return false if not source_subset.known
                            if source_subset.allowed:
                                destination_has_tag: mutable bool = false
                                for destination_index in 0..<table.enum_variant_owner.count |destination_has_tag, source, destination, annotations, table, variant_index|:
                                    belongs_to_destination: bool = table.enum_variant_owner[destination_index] == destination.family and destination_index < table.enum_variant_module.count and table.enum_variant_module[destination_index] == destination.module
                                    if belongs_to_destination and table.enum_variant_name[destination_index] == table.enum_variant_name[variant_index]:
                                        destination_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, destination, table.enum_variant_name[destination_index])
                                        return false if not destination_subset.known
                                        destination_has_tag <- true if destination_subset.allowed
                                return false if not destination_has_tag
                    return saw_source_family_tag
                return false if not try_error_family_refs_match(file, annotations, source, destination, table)
                source_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, source, "") if source.declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET else (true, false, true)
                destination_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, destination, "") if destination.declaration_offset != FALLIBLE_FUNCTION_NO_OFFSET else (true, false, true)
                return false if not source_subset.known or source_subset.restricted
                return false if not destination_subset.known or destination_subset.restricted
                return true

        # ErrorSetAssignable matches a source tag against the whole destination union:
        # an exact family/module/tag wins, otherwise its short tag must identify exactly
        # one allowed destination tag. Checking each destination family independently and
        # accepting `any` misses ambiguity when two destination families share that tag.
        def error_family_covers_destinations(file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, source: TryErrorFamilyRef, destinations: darray[TryErrorFamilyRef]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if source.family == "" or try_error_family_has_empty_subset(annotations, source)
                all_modules_known: mutable bool = true
                for destination in destinations |all_modules_known, annotations, source|:
                    return true if destination.family == "" or try_error_family_has_empty_subset(annotations, destination)
                    all_modules_known <- false if not destination.module_known
                if source.module_known and all_modules_known:
                    saw_source_family_tag: mutable bool = false
                    for source_index in 0..<table.enum_variant_owner.count |saw_source_family_tag, annotations, source, destinations, table|:
                        continue if source_index >= table.enum_variant_name.count or source_index >= table.enum_variant_module.count
                        continue if table.enum_variant_owner[source_index] != source.family or table.enum_variant_module[source_index] != source.module
                        saw_source_family_tag <- true
                        source_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, source, table.enum_variant_name[source_index])
                        return false if not source_subset.known
                        continue if not source_subset.allowed
                        exact_destination_match: mutable bool = false
                        short_destination_matches: mutable usize = 0.usize()
                        for candidate_index in 0..<table.enum_variant_owner.count |exact_destination_match, short_destination_matches, annotations, source, destinations, table, source_index|:
                            continue if candidate_index >= table.enum_variant_name.count or candidate_index >= table.enum_variant_module.count
                            duplicate_tag: mutable bool = false
                            for prior_index in 0..<candidate_index |duplicate_tag, table, candidate_index|:
                                continue if prior_index >= table.enum_variant_name.count or prior_index >= table.enum_variant_module.count
                                duplicate_tag <- true if table.enum_variant_owner[prior_index] == table.enum_variant_owner[candidate_index] and table.enum_variant_module[prior_index] == table.enum_variant_module[candidate_index] and table.enum_variant_name[prior_index] == table.enum_variant_name[candidate_index]
                            continue if duplicate_tag
                            tag_allowed: mutable bool = false
                            for destination in destinations |tag_allowed, annotations, table, candidate_index|:
                                continue if destination.family != table.enum_variant_owner[candidate_index] or destination.module != table.enum_variant_module[candidate_index]
                                destination_subset: (known: bool, restricted: bool, allowed: bool) = try_error_family_subset_status(annotations, destination, table.enum_variant_name[candidate_index])
                                return false if not destination_subset.known
                                tag_allowed <- true if destination_subset.allowed
                            continue if not tag_allowed or table.enum_variant_name[candidate_index] != table.enum_variant_name[source_index]
                            short_destination_matches <- short_destination_matches + 1.usize()
                            exact_destination_match <- true if table.enum_variant_owner[candidate_index] == source.family and table.enum_variant_module[candidate_index] == source.module
                        return false if not exact_destination_match and short_destination_matches != 1.usize()
                    return saw_source_family_tag
                for destination in destinations |annotations, file, source, table|:
                    return true if error_family_covers(file, annotations, source, destination, table)
                return false

        def check_try_propagation_row(file: Ast::File&, annotation: Ast::EnumAnnotation&, enclosing: (line: u32, offset: u32), enclosing_module: sview, callee_qualifier: sview @source, annotations: darray[Ast::EnumAnnotation]&, try_named_arguments: darray[Ast::EnumAnnotation]&, argument_type_ids: darray[u32]&, receiver_ref_mutability_known: bool, receiver_ref_mutable: bool, error_set_annotations: darray[Ast::EnumAnnotation]&, error_set_family_paths: darray[Ast::EnumAnnotation]&, error_set_index: mutable TryErrorSetIndex&, propagation_site_count: usize, module_index: FallibleFunctionModuleIndex&, module_annotations: darray[Ast::EnumAnnotation]&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable, call_arity_known: bool, call_arity: u32, first_class_error_family: sview @source = "", lambda_error_family: sview @source = "", inside_lambda: bool = false) -> void:
            can Memory.Allocate, Abort.Panic, Global.Read:
                return if first_class_error_family == "" and annotation.owner != "__noncall" and callable_try_static_binding_uncertain(annotations, annotation.owner, enclosing_module, callee_qualifier, table)
                scope_known: bool = enclosing.line != 0 or enclosing.offset != FALLIBLE_FUNCTION_NO_OFFSET or enclosing_module != "" or callee_qualifier != ""
                sources: mutable darray[TryErrorFamilyRef] = []
                source_ambiguous: mutable bool = false
                if first_class_error_family != "":
                    callback: TryErrorFamilyRef = try_callback_family_ref(file.top_decls, enclosing.line, enclosing.offset, annotation.owner, enclosing_module, annotations, table) if not inside_lambda and annotation.owner != "__noncall" else TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0}
                    sources.push(callback) if callback.family != ""
                    sources.push(TryErrorFamilyRef{family: first_class_error_family, module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0}) if callback.family == ""
                else:
                    selected_sources: (families: darray[TryErrorFamilyRef], ambiguous: bool) = callable_error_indexed_family_refs(file, error_index, annotations, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, module_index, module_annotations, annotation.owner, enclosing_module, callee_qualifier, scope_known, annotation.offset, call_arity_known, call_arity, table)
                    sources <- selected_sources.families
                    source_ambiguous <- selected_sources.ambiguous
                    if sources.count == 0 and not source_ambiguous:
                        fallback_source: TryErrorFamilyRef = callable_error_indexed_family_ref(file, error_index, annotations, try_named_arguments, argument_type_ids, receiver_ref_mutability_known, receiver_ref_mutable, module_index, module_annotations, annotation.owner, enclosing_module, callee_qualifier, scope_known, annotation.offset, call_arity_known, call_arity, table)
                        sources.push(fallback_source) if fallback_source.family != ""
                return if sources.count == 0
                function_line: u32 = enclosing.line
                enclosing_return: (found: bool, occurrence_offset: u32, identity_id: u32) = try_enclosing_return_occurrence(annotations, function_line, enclosing.offset)
                destinations: mutable darray[TryErrorFamilyRef] = []
                if inside_lambda:
                    destinations.push(TryErrorFamilyRef{family: lambda_error_family, module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0}) if lambda_error_family != ""
                else:
                    if propagation_site_count > 1 and propagation_site_count * error_set_annotations.count > TRY_ERROR_SET_INDEX_MIN_WORK:
                        try_error_set_index_build(error_set_index, error_set_annotations) can Global{Read,Write}
                        can Global.Read:
                            destination_indices: mutable darray[usize] = []
                            destination_indices <- try_error_set_destinations(error_set_index, error_set_annotations, enclosing.offset, function_line, enclosing_return.identity_id, enclosing_return.occurrence_offset) if enclosing_return.found
                            caller_module: sview = fallible_fn_module_indexed(module_index, module_annotations, enclosing.offset, function_line)
                            caller_module_known: bool = fallible_fn_module_known(module_annotations, enclosing.offset, function_line)
                            for destination_index in destination_indices |destinations, annotations, error_set_annotations, error_set_family_paths, caller_module, caller_module_known, table|:
                                family_annotation: Ast::EnumAnnotation = error_set_annotations[destination_index]
                                family_path: mutable sview @source = ""
                                if destination_index < error_set_family_paths.count:
                                    path_annotation: Ast::EnumAnnotation = error_set_family_paths[destination_index]
                                    family_path <- path_annotation.name if path_annotation.line == family_annotation.line and path_annotation.offset == family_annotation.offset and path_annotation.identity_id == family_annotation.identity_id and path_annotation.occurrence_offset == family_annotation.occurrence_offset
                                destinations.push(try_error_family_ref_for_annotation(annotations, family_annotation, family_path, caller_module_known, caller_module, table))
                    else:
                        caller_module: sview = fallible_fn_module_indexed(module_index, module_annotations, enclosing.offset, function_line)
                        caller_module_known: bool = fallible_fn_module_known(module_annotations, enclosing.offset, function_line)
                        for destination_index in 0..<error_set_annotations.count |destinations, annotations, error_set_annotations, error_set_family_paths, enclosing, function_line, enclosing_return, caller_module, caller_module_known, table|:
                            family_annotation: Ast::EnumAnnotation = error_set_annotations[destination_index]
                            continue if family_annotation.owner != "__error_set_family"
                            continue if not (family_annotation.offset == enclosing.offset if enclosing.offset != FALLIBLE_FUNCTION_NO_OFFSET and family_annotation.offset != FALLIBLE_FUNCTION_NO_OFFSET else family_annotation.line == function_line)
                            continue if not enclosing_return.found or family_annotation.occurrence_offset != enclosing_return.occurrence_offset
                            continue if enclosing_return.identity_id != 0 and family_annotation.identity_id != enclosing_return.identity_id
                            family_path: mutable sview @source = ""
                            if destination_index < error_set_family_paths.count:
                                path_annotation: Ast::EnumAnnotation = error_set_family_paths[destination_index]
                                family_path <- path_annotation.name if path_annotation.line == family_annotation.line and path_annotation.offset == family_annotation.offset and path_annotation.identity_id == family_annotation.identity_id and path_annotation.occurrence_offset == family_annotation.occurrence_offset
                            destinations.push(try_error_family_ref_for_annotation(annotations, family_annotation, family_path, caller_module_known, caller_module, table))
                # A fallible callee (`source != ""`) whose enclosing function declares NO error set
                # cannot propagate the `try` — stage0 requires the current function to return an
                # error union. (A function WITH an error set proceeds to the set-coverage check.)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryWithoutElseNonErrorFunction, name: "", line: annotation.line, expected: "", actual: ""}) if destinations.count == 0 and (function_line != 0 or enclosing.offset != FALLIBLE_FUNCTION_NO_OFFSET)
                return if destinations.count == 0
                uncovered_source: mutable TryErrorFamilyRef = TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0}
                for source in sources |uncovered_source, destinations, annotations, file, table, enclosing, enclosing_return, inside_lambda|:
                    source_covered: mutable bool = error_family_covers_destinations(file, annotations, source, destinations, table)
                    # A callback returning the enclosing function's errorset parameter
                    # forwards the same symbolic family, not a same-named concrete enum.
                    if not source_covered and not inside_lambda and not source.module_known and source.variant_override == "" and enclosing_return.found:
                        for row in annotations |source_covered, source, destinations, enclosing, enclosing_return|:
                            if row.owner == "__errorset_param" and row.line == enclosing.line and row.offset == enclosing.offset and row.identity_id == enclosing_return.identity_id and row.name == source.family:
                                for destination in destinations |source_covered, source|:
                                    source_covered <- true if destination.family == source.family and not destination.module_known and destination.variant_override == ""
                    if not source_covered:
                        uncovered_source <- source
                        break
                return if uncovered_source.family == ""
                first: mutable sview @source = destinations[0].family
                second: mutable sview @source = ""
                second <- destinations[1].family if destinations.count > 1
                swap: bool = second != "" and error_family_symbol_position(table, second) < error_family_symbol_position(table, first)
                first, second <- second, first if swap
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryPropagationMismatch, name: uncovered_source.family, pos: annotation.pos, line: annotation.line, expected: first, actual: "", detail: second})

        # The compact AST erases the `try` head and records `__noncall` when its operand
        # is not a Call. Recover the narrow `try parameter` form from the function body and
        # the parser's `__param_error_union` metadata. A parameter marker is line-keyed, so
        # accept it only when every parameter on that source line is marked; otherwise the
        # parser metadata cannot unambiguously associate the errorset with a parameter.
        def try_noncall_parameter_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Paren(inner, _):
                        return try_noncall_parameter_name(inner)
                    _:
                        return ""

