# Unsupported calling convention (stage0 applyFunctionCallConvAnnotation). A `@callconv(X)`
# decorator whose single argument X is not a recognized calling-convention name is rejected
# ("unsupported calling convention X on function NAME"). The supported set mirrors stage0's
# normalizeExternCallConvAnnotationArg.
extend Semantic:
    private:
        def is_supported_callconv(name: sview) -> bool:
            can Abort.Panic:
                return name == "c" or name == "cdecl" or name == "default" or name == "fast" or name == "fastcall" or name == "cold" or name == "coldcc" or name == "stdcall" or name == "x86_stdcall" or name == "x86-stdcall" or name == "winapi" or name == "windows"

        def check_callconv_walk(declarations: darray[Ast::Decl], annotation_args: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for decorator in decorators |table| -> table:
                                is_single_arg_callconv: bool = decorator.name == "callconv" and decorator.arg_count == 1 and decorator.arg_start.usize() < annotation_args.count
                                conv: sview = annotation_args[decorator.arg_start.usize()] if is_single_arg_callconv else sview("", 0, 0)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnsupportedCallConv, name: conv, line: decorator.line, expected: function_name, actual: ""}) if is_single_arg_callconv and conv != "" and not is_supported_callconv(conv)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_callconv_walk(module_body, annotation_args, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_callconv_walk(scoped_body, annotation_args, table)
                        _:
                            pass

        def check_callconv(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_callconv_walk(file.top_decls, file.annotation_args, table)
