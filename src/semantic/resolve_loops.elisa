extend Semantic:
    private:
        # Whether an inferred type is provably iterable (darray-like, dict, set, range,
        # view, string, or an iterable-named type). Conservative: returns true only when
        # the type's family is a KNOWN iterable; Unknown/Named types are silent (never flagged).
        def is_iterable_type(t: InferType) -> bool:
            can Abort.Panic:
                return match t.kind:
                    TypeKind.Unknown:   true
                    TypeKind.String:    true
                    TypeKind.Named:
                        n: sview = t.name
                        (n == "darray" or n == "dict" or n == "set" or n == "view" or
                         n == "range" or n == "tree" or n == "TreeView" or
                         n == "ChunksExactView" or n == "EnumerateView" or
                         n == "StoreRowsView" or n == "frozen" or
                         n == "DictIterator" or n == "StoreRows" or
                         n == "view64")
                    _:                 false


        # Check a for loop's iterable expression for firmness: if we can prove it is a
        # non-iterable type (int/float/bool/char), flag it. Unknowns and Named types are
        # silent (conservative, firm-typed only).
        def check_loop_iterable(iter_expr: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                iter_type: InferType = infer_expr_type(iter_expr, names, types, table)
                if not is_iterable_type(iter_type):
                    # Firm non-iterable: flag it. Only flag when certain (not Unknown).
                    if iter_type.kind != TypeKind.Unknown:
                        actual_fam: sview = family_of_kind(iter_type)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonIterableLoop, name: "", line: line, expected: "", actual: actual_fam})

