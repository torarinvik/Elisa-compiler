extend Semantic:
    private:
        # Whether an inferred type is provably iterable (darray-like, dict, set, range,
        # view, string, or an iterable-named type). Conservative: returns true only when
        # the type's family is a KNOWN iterable; Unknown/Named types are silent (never flagged).
        def is_iterable_type(inferred_type: InferType) -> bool:
            can Abort.Panic:
                return match inferred_type.kind:
                    TypeKind.Unknown:   true
                    TypeKind.String:    true
                    TypeKind.Named:
                        type_name: sview = inferred_type.name
                        (type_name == "darray" or type_name == "dict" or type_name == "set" or type_name == "view" or
                         type_name == "range" or type_name == "tree" or type_name == "TreeView" or
                         type_name == "ChunksExactView" or type_name == "EnumerateView" or
                         type_name == "StoreRowsView" or type_name == "frozen" or
                         type_name == "DictIterator" or type_name == "StoreRows" or
                         type_name == "view64")
                    _:                 false


        # Check a for loop's iterable expression for firmness: if we can prove it is a
        # non-iterable type (int/float/bool/char), flag it. Unknowns and Named types are
        # silent (conservative, firm-typed only).
        def check_loop_iterable(iterable_expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                iterable_type: InferType = infer_expression_type(iterable_expression, names, types, table)
                # Firm non-iterable: flag it. Only flag when certain (not Unknown).
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonIterableLoop, name: "", line: line, expected: "", actual: family_of_kind(iterable_type)}) if not is_iterable_type(iterable_type) and iterable_type.kind != TypeKind.Unknown

