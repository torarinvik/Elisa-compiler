extend Semantic:
    private:
        # Whether an inferred type is provably iterable (darray-like, dict, set, range,
        # view, string, or an iterable-named type). Conservative: returns true only when
        # the type's family is a KNOWN iterable; Unknown/Named types are silent (never flagged).
        def is_iterable_type(inferred_type: InferType) -> bool:
            can Abort.Panic:
                return match inferred_type.kind:
                    SemTypeKind.Unknown:   true
                    SemTypeKind.String:    true
                    SemTypeKind.Named:
                        return match inferred_type.name:
                            "darray" | "dict" | "set" | "view" | "range" | "tree" | "TreeView" | "ChunksExactView" | "EnumerateView" | "StoreRowsView" | "frozen" | "DictIterator" | "StoreRows" | "view64": true
                            _: false
                    # Structural kinds (Phase C): container idents are the canonical
                    # iterables; optionals stay conservatively silent until stage0's
                    # exact stance is fixture-verified.
                    SemTypeKind.Container: true
                    SemTypeKind.Optional:  true
                    _:                 false


        # Check a for loop's iterable expression for firmness: if we can prove it is a
        # non-iterable type (int/float/bool/char), flag it. Unknowns and Named types are
        # silent (conservative, firm-typed only).
        def check_loop_iterable(iterable_expression: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                iterable_type: InferType = infer_expression_type(iterable_expression, names, types, table)
                # Firm non-iterable: flag it. Only flag when certain (not Unknown).
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonIterableLoop, name: "", line: line, expected: "", actual: family_of_kind(iterable_type)}) if not is_iterable_type(iterable_type) and iterable_type.kind != SemTypeKind.Unknown

