# Assigning one reference to another through `<-` over an AGGREGATE type. `p <- q` where both
# `p` and `q` are references to a container/struct writes q (a reference value) into p's pointee
# (a container/struct VALUE) — a type mismatch stage0 rejects ("cannot assign mutable T& to T").
# Scalar references (`mutable i64&`) auto-dereference on assignment and are exempt (verified
# against stage0), so this fires only for aggregate bases: darray/set/dict/array or a registered
# struct.
extend Semantic:
    private:
        # Strip the outer `mutable`/`&` wrappers of a reference type to its POINTEE type expression.
        def art_pointee(type_expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        art_pointee(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Ampersand
                        return type_expression
                    Expr.Paren(inner, paren_line):
                        return art_pointee(inner)
                    _:
                        return type_expression

        def art_has_ampersand(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        true return if operator == TokenKind.Ampersand
                        return art_has_ampersand(operand)
                    Expr.Paren(inner, paren_line):
                        return art_has_ampersand(inner)
                    _:
                        return false

        # Whether a POINTEE type expression is an aggregate: a darray/set/dict/array container or a
        # registered struct. Scalars, optionals, generics, refs are not aggregates here.
        def art_pointee_is_aggregate(pointee: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match pointee:
                    Expr.Index(object, index, index_line):
                        head: sview = ident_name_of(object)
                        return head == "darray" or head == "set" or head == "dict" or head == "array"
                    Expr.IndexN(object_n, arguments_n, indexn_line):
                        head_n: sview = ident_name_of(object_n)
                        return head_n == "darray" or head_n == "set" or head_n == "dict" or head_n == "array"
                    Expr.Ident(name, ident_line):
                        return struct_is_registered(table, name)
                    _:
                        return false

        def art_param_type(names: darray[sview]&, type_expressions: darray[Ast::Expr]&, name: sview) -> (found: bool, type_expression: Ast::Expr):
            can Abort.Panic:
                while index < names.count |index: usize = 0|:
                    (true, type_expressions[index]) return if names[index] == name and name != ""
                    index <- index + 1
                return (false, (Ast::Expr.Invalid))

        def art_check_statements(statements: darray[Ast::Stmt], names: darray[sview]&, type_expressions: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            if operator == TokenKind.LArrow and target is Expr.Ident(target_name, target_line) and value is Expr.Ident(value_name, value_line):
                                target_param: (found: bool, type_expression: Ast::Expr) = art_param_type(names, type_expressions, target_name)
                                value_param: (found: bool, type_expression: Ast::Expr) = art_param_type(names, type_expressions, value_name)
                                if target_param.found and value_param.found:
                                    target_pointee: Ast::Expr = art_pointee(target_param.type_expression)
                                    target_is_agg_ref: bool = art_has_ampersand(target_param.type_expression) and art_pointee_is_aggregate(target_pointee, table)
                                    value_is_ref: bool = art_has_ampersand(value_param.type_expression)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignRefToAggregate, name: target_name, line: line.line, expected: bare_type_name(target_pointee), actual: bare_type_name(value_param.type_expression)}) if target_is_agg_ref and value_is_ref
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- art_check_statements(then_body, names, type_expressions, table)
                            table <- art_check_statements(else_body, names, type_expressions, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- art_check_statements(while_body, names, type_expressions, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- art_check_statements(for_body, names, type_expressions, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- art_check_statements(body, names, type_expressions, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- art_check_statements(arm.body, names, type_expressions, table)
                        _:
                            pass

        def art_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            type_expressions: mutable darray[Ast::Expr] = []
                            for parameter in parameters |names, type_expressions|:
                                names.push(parameter.name)
                                type_expressions.push(parameter.type_expression)
                            table <- art_check_statements(body, names, type_expressions, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- art_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- art_check_declarations(scoped_body, table)
                        _:
                            pass

    public:
        def check_assign_ref_to_aggregate(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- art_check_declarations(file.top_decls, table)
