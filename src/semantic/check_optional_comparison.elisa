# Two optionals cannot be compared with `==`/`!=` directly (`opt == opt2` where both are `T?`):
# the comparison would need to decide how two absent values relate. stage0 rejects it and asks
# for an unwrap. SOUND subset: fires only when BOTH operands are bare Idents whose declared type
# (param or local annotation) is `T?` for a primitive base T. Comparing an optional to `null`
# (the presence test) or to a plain value is left alone.
extend Semantic:
    private:
        # The primitive base name of a `T?` annotation (`Unary(Question, Ident T)`), else "".
        def optcmp_base_name(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        base: sview = ident_name_of(operand)
                        if operator == TokenKind.Question and is_primitive_type_name(base):
                            return base
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return optcmp_base_name(inner)
                    _:
                        return sview("", 0, 0)

        def optcmp_collect_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, bases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, bases|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            base: sview = optcmp_base_name(type_expression)
                            if base != "":
                                names.push(name)
                                bases.push(base)
                        Stmt.If(condition, then_body, else_body, line):
                            optcmp_collect_locals(then_body, names, bases)
                            optcmp_collect_locals(else_body, names, bases)
                        Stmt.While(condition, while_body, line):
                            optcmp_collect_locals(while_body, names, bases)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            optcmp_collect_locals(for_body, names, bases)
                        Stmt.Block(kind, clause, binding, body, line):
                            optcmp_collect_locals(body, names, bases)
                        _:
                            pass

        def optcmp_lookup_base(names: darray[sview]&, bases: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                found: mutable sview = sview("", 0, 0)
                while index < names.count |found, index|:
                    found <- bases[index] if names[index] == name and found == ""
                    index <- index + 1
                return found

        def optional_cmp_check_expression(expression: Ast::Expr, names: darray[sview]&, bases: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.EqEq or operator == TokenKind.BangEq:
                            left_base: sview = optcmp_lookup_base(names, bases, ident_name_of(left))
                            right_base: sview = optcmp_lookup_base(names, bases, ident_name_of(right))
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OptionalComparison, name: "", line: line, expected: left_base, actual: right_base, expected_count: 1}) if left_base != "" and right_base != ""
                        table <- optional_cmp_check_expression(left, names, bases, table)
                        table <- optional_cmp_check_expression(right, names, bases, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- optional_cmp_check_expression(operand, names, bases, table)
                    Expr.Paren(inner, paren_line):
                        table <- optional_cmp_check_expression(inner, names, bases, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- optional_cmp_check_expression(argument, names, bases, table)
                    _:
                        pass

        def optional_cmp_check_statements(statements: darray[Ast::Stmt], names: darray[sview]&, bases: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- optional_cmp_check_expression(expression, names, bases, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- optional_cmp_check_expression(value, names, bases, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- optional_cmp_check_expression(value, names, bases, table)
                        Stmt.Return(value, line):
                            table <- optional_cmp_check_expression(returned, names, bases, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- optional_cmp_check_expression(condition, names, bases, table)
                            table <- optional_cmp_check_statements(then_body, names, bases, table)
                            table <- optional_cmp_check_statements(else_body, names, bases, table)
                        Stmt.While(condition, while_body, line):
                            table <- optional_cmp_check_expression(condition, names, bases, table)
                            table <- optional_cmp_check_statements(while_body, names, bases, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- optional_cmp_check_statements(for_body, names, bases, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- optional_cmp_check_statements(body, names, bases, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- optional_cmp_check_statements(arm.body, names, bases, table)
                        _:
                            pass

        def optional_cmp_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            bases: mutable darray[sview] = []
                            for parameter in parameters |names, bases|:
                                parameter_base: sview = optcmp_base_name(parameter.type_expression)
                                if parameter_base != "":
                                    names.push(parameter.name)
                                    bases.push(parameter_base)
                            optcmp_collect_locals(body, names, bases)
                            table <- optional_cmp_check_statements(body, names, bases, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- optional_cmp_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- optional_cmp_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_optional_comparison(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- optional_cmp_walk(file.top_decls, table)
