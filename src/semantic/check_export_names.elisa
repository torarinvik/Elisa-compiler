# Export-table validation (stage0 exports.go). Each `export fn NAME() -> T = TARGET` must
# have a unique export NAME and a defined re-export TARGET. The parser records exports on the
# side-table (`__export_fn` owner=export-name; `__export_target_ref` owner=target-name) since
# the Extern node drops both. SOUND: a repeated export name and an unresolved target are both
# decidable from the recorded facts.
extend Semantic:
    private:
        def pymodule_target_defined(table: SymbolTable&, target: sview) -> bool:
            can Abort.Panic:
                # Bare targets use the normal global symbol table. Qualified targets are module
                # members, which are kept in parallel owner/name rows by symbol collection.
                has_scope: mutable bool = false
                for index in 0..<sview_len(target) |has_scope, target|:
                    has_scope <- true if sview_at(target, index) == 58 and index + 1.usize() < sview_len(target) and sview_at(target, index + 1.usize()) == 58
                if not has_scope:
                    return find_symbol(table, target) is target_symbol
                for member_index in 0..<table.module_member_owner.count |member_index, table, target|:
                    owner: sview = table.module_member_owner[member_index]
                    member: sview = table.module_member_name[member_index]
                    continue if sview_len(target) != sview_len(owner) + 2.usize() + sview_len(member)
                    matched: mutable bool = true
                    for owner_index in 0..<sview_len(owner) |matched, target, owner|:
                        matched <- false if sview_at(target, owner_index) != sview_at(owner, owner_index)
                    matched <- false if sview_at(target, sview_len(owner)) != 58 or sview_at(target, sview_len(owner) + 1.usize()) != 58
                    for member_index2 in 0..<sview_len(member) |matched, target, member, owner|:
                        matched <- false if sview_at(target, sview_len(owner) + 2.usize() + member_index2) != sview_at(member, member_index2)
                    return true if matched
                return false

        def export_name_seen(seen: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in seen where name == wanted

        def check_export_names(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                seen_exports: mutable darray[sview] = []
                for annotation in file.enum_annotations |seen_exports, table| -> table:
                    if annotation.name == "__export_fn":
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateExportName, name: annotation.owner, line: annotation.line, expected: "", actual: ""}) if export_name_seen(seen_exports, annotation.owner)
                        seen_exports.push(annotation.owner)
                        table
                    elif annotation.name == "__pymodule_fn":
                        # Python function entries use the same duplicate-name diagnostic as
                        # ordinary exports. The first implementation keeps the public name as
                        # the annotation owner; module-qualified duplicate tracking can be added
                        # when nested/package pymodules are introduced.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateExportName, name: annotation.owner, line: annotation.line, expected: "pymodule", actual: ""}) if export_name_seen(seen_exports, annotation.owner)
                        seen_exports.push(annotation.owner)
                        table
                    elif annotation.name == "__pymodule_const":
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateExportName, name: annotation.owner, line: annotation.line, expected: "pymodule", actual: ""}) if export_name_seen(seen_exports, annotation.owner)
                        seen_exports.push(annotation.owner)
                        table
                    else:
                        # A re-export target that resolves to no global symbol is undefined.
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExportTargetUndefined, name: annotation.owner, line: annotation.line, expected: "", actual: ""}) if annotation.name == "__export_target_ref" and not (find_symbol(table, annotation.owner) is target_symbol)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExportTargetUndefined, name: annotation.owner, line: annotation.line, expected: "", actual: ""}) if annotation.name == "__pymodule_target_ref" and not pymodule_target_defined(table, annotation.owner)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExportTargetUndefined, name: annotation.owner, line: annotation.line, expected: "", actual: ""}) if annotation.name == "__pymodule_const_target_ref" and not pymodule_target_defined(table, annotation.owner)
                        table
