# Stage1 semantic — the predicate prover and its span fallback (`extend Semantic:
# private:`). `ensure_is_proven` is the entry every goal shape funnels into,
# `callee_summary_proves` discharges a goal from a callee's own ensure clause, and the
# `es_match_*` family matches a goal against the raw source span of a contract when no
# structural rule applies. Continues check_ensure_strict_goals.elisa; split out to keep
# each part file under 600 lines.

extend Semantic:
    private:
        def ensure_is_proven(predicate: Ast::Expr, requires_predicates: darray[Ast::Expr]&, return_expressions: darray[Ast::Expr]&, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&, has_hi: darray[bool]&, hi: darray[i64]&, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                # A syntactic TAUTOLOGY (`X or true`) is trivially true.
                true return if crv_ensure_is_tautology(predicate)
                # A verbatim restatement of a `requires` clause is assumed.
                true return if any required in requires_predicates where expressions_equal(predicate, required)
                # Propositional tiers: a disjunction with a requires-restating disjunct,
                # and equality under a `requires p == q` identification.
                true return if ensure_or_disjunct_proves(predicate, requires_predicates)
                true return if ensure_swap_equality_proves(predicate, requires_predicates)
                # CONJUNCTION / PAREN tier: `A and B` holds iff both conjuncts
                # hold; a parenthesized goal reduces to its inner predicate.
                match predicate:
                    Expr.Paren(paren_inner, paren_line):
                        return ensure_is_proven(paren_inner, requires_predicates, return_expressions, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                    Expr.Binary(conj_left, conj_op, conj_right, conj_line):
                        if conj_op == TokenKind.And:
                            proven_left: bool = ensure_is_proven(conj_left, requires_predicates, return_expressions, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                            false return if not proven_left
                            return ensure_is_proven(conj_right, requires_predicates, return_expressions, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                    _:
                        pass
                match predicate:
                    Expr.Binary(left, operator, right, line):
                        false return if not is_comparison_operator(operator)
                        has_return: bool = return_expressions.count == 1
                        return_expression: Ast::Expr = return_expressions[0] if has_return else (Ast::Expr.Invalid)
                        reflexive: bool = equal_normalized(left, right, return_expression, has_return)
                        true return if reflexive and is_reflexively_true_operator(operator)
                        # CONSTANT goal: both sides fold to integers after resolving
                        # `result`/`result.FIELD` (`ensure result.val > 0` on `return Box{val: 5}`).
                        true return if es_const_goal_true(predicate, return_expression, has_return)
                        # `return n % C` range tier (goal must be `result < bound`).
                        goal_is_result: bool = ident_name_of(left) == "result"
                        true return if has_return and goal_is_result and mod_goal_is_proven(return_expression, operator, right, int_params, has_lo, lo)
                        # MODULAR-ZERO: `ensure (result % D) == 0` on `return X - (X % D)`.
                        true return if ensure_mod_zero_proven(left, operator, right, return_expression, has_return)
                        # ALIGN-UP mod-zero identity: `(result % A) == 0` on `(E/A)*A`.
                        true return if ensure_align_mod_zero(left, operator, right, return_expression, has_return)
                        # The deep linear tier: env-resolved locals + pure-callee inlining.
                        # A `wrap_safe` underflow-guarded difference relaxes the box gate.
                        return_wrap_safe: bool = has_return and return_diff_underflow_safe(return_expression, requires_predicates)
                        true return if linear_goal_deep_proven(left, operator, right, return_expression, has_return, return_wrap_safe, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        # RELATIONAL tier: `requires a >= b` decides goals whose affine
                        # form is exactly ±(a - b) + k.
                        true return if ensure_difference_proves(left, operator, right, return_expression, has_return, requires_predicates)
                        # STRUCTURAL upper-bound difference: `ensure result <= M` on
                        # `return M - S` with a `requires S <= M` and non-negative S, where
                        # M/S may be field or method expressions (`r.data.count - used`).
                        true return if ensure_guarded_diff_upper(left, operator, right, return_expression, has_return, requires_predicates, int_params, has_lo, lo)
                        # CALLEE-SUMMARY route: `return f(args)` where f declares its own
                        # ensures. An EQUALITY summary `result == E` substitutes E (with
                        # f's params bound to the arguments); BOUND summaries box a
                        # synthetic variable standing for the call's value.
                        return callee_summary_proves(left, operator, right, return_expression, has_return, int_params, has_lo, lo, has_hi, hi, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies, sum_names, sum_param_starts, sum_param_counts, all_sum_params, sum_ensure_starts, sum_ensure_counts, all_sum_ensures)
                    _:
                        return false


        def callee_summary_proves(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&, has_hi: darray[bool]&, hi: darray[i64]&, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&, sum_names: darray[sview]&, sum_param_starts: darray[usize]&, sum_param_counts: darray[usize]&, all_sum_params: darray[sview]&, sum_ensure_starts: darray[usize]&, sum_ensure_counts: darray[usize]&, all_sum_ensures: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                called: mutable sview = sview("", 0, 0)
                call_arguments: mutable darray[Ast::Expr] = []
                match return_expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        called <- ident_name_of(callee)
                        call_arguments.extend(arguments)
                    _:
                        pass
                false return if called == ""
                slot: mutable i64 = -1
                probe: mutable usize = 0
                while probe < sum_names.count |slot, probe, called, sum_names|:
                    slot <- probe.i64() if sum_names[probe] == called and slot < 0
                    probe <- probe + 1
                false return if slot < 0
                index: usize = slot.usize()
                false return if sum_param_counts[index] != call_arguments.count
                # Bind callee params to the argument expressions as an ENVIRONMENT
                # (arguments reduced to affine caller-space forms).
                callee_env_names: mutable darray[sview] = []
                callee_env_starts: mutable darray[usize] = []
                callee_env_counts: mutable darray[usize] = []
                callee_term_names: mutable darray[sview] = []
                callee_term_coeffs: mutable darray[i64] = []
                callee_env_consts: mutable darray[i64] = []
                arg_offset: mutable usize = 0
                args_ok: mutable bool = true
                while arg_offset < call_arguments.count |arg_offset, args_ok, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, call_arguments, index|:
                    arg_names: mutable darray[sview] = []
                    arg_coeffs: mutable darray[i64] = []
                    arg_konst: mutable i64 = 0
                    arg_linear: bool = lin_add_deep(call_arguments[arg_offset], 1, arg_names, arg_coeffs, arg_konst, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    args_ok <- false if not arg_linear
                    callee_env_names.push(all_sum_params[sum_param_starts[index] + arg_offset])
                    callee_env_starts.push(callee_term_names.count)
                    callee_env_counts.push(arg_names.count)
                    callee_term_names.extend(arg_names)
                    callee_term_coeffs.extend(arg_coeffs)
                    callee_env_consts.push(arg_konst)
                    arg_offset <- arg_offset + 1
                # EQUALITY summary: `ensure result == E` — E (env-bound) becomes the
                # return expression.
                ensure_offset: mutable usize = 0
                while ensure_offset < sum_ensure_counts[index] |ensure_offset, index, args_ok, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, goal_left, operator, goal_right, int_params, has_lo, lo, has_hi, hi, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies|:
                    summary: Ast::Expr = all_sum_ensures[sum_ensure_starts[index] + ensure_offset]
                    match summary:
                        Expr.Binary(sum_left, sum_operator, sum_right, sum_line):
                            equality: bool = args_ok and sum_operator == TokenKind.EqEq and ident_name_of(sum_left) == "result"
                            # REFLEXIVE equality: with the callee's params renamed to the
                            # (bare-ident) arguments, `result == E` proves `result == goal_right`
                            # when E is structurally goal_right — regardless of variable bounds,
                            # since `result` IS E (equal even under wrapping). Sidesteps the box
                            # gate that a residual unbounded variable in E would otherwise trip.
                            if equality and operator == TokenKind.EqEq:
                                bare_from: mutable darray[sview] = []
                                bare_to: mutable darray[sview] = []
                                all_bare: mutable bool = true
                                bare_probe: mutable usize = 0
                                while bare_probe < call_arguments.count |bare_probe, all_bare, bare_from, bare_to, call_arguments, all_sum_params, sum_param_starts, index|:
                                    arg_name: sview = ident_name_of(call_arguments[bare_probe])
                                    all_bare <- false if arg_name == ""
                                    if arg_name != "":
                                        bare_from.push(all_sum_params[sum_param_starts[index] + bare_probe])
                                        bare_to.push(arg_name)
                                    bare_probe <- bare_probe + 1
                                if all_bare:
                                    renamed: Ast::Expr = csp_rename_idents(sum_right, bare_from, bare_to, 0)
                                    true return if expressions_equal(emz_unparen(renamed), emz_unparen(goal_right))
                            true return if equality and linear_goal_deep_proven(goal_left, operator, goal_right, sum_right, true, false, int_params, has_lo, lo, has_hi, hi, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        _:
                            pass
                    ensure_offset <- ensure_offset + 1
                # BOUND summaries: box a synthetic variable named after the callee, then
                # judge the goal with `result` standing for that variable.
                boxed_params: mutable darray[sview] = []
                boxed_has_lo: mutable darray[bool] = []
                boxed_lo: mutable darray[i64] = []
                boxed_has_hi: mutable darray[bool] = []
                boxed_hi: mutable darray[i64] = []
                boxed_params.extend(int_params)
                box_probe: mutable usize = 0
                while box_probe < int_params.count |box_probe, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi, has_lo, lo, has_hi, hi|:
                    boxed_has_lo.push(has_lo[box_probe])
                    boxed_lo.push(lo[box_probe])
                    boxed_has_hi.push(has_hi[box_probe])
                    boxed_hi.push(hi[box_probe])
                    box_probe <- box_probe + 1
                boxed_params.push(called)
                boxed_has_lo.push(false)
                boxed_lo.push(0)
                boxed_has_hi.push(false)
                boxed_hi.push(0)
                found_bound: mutable bool = false
                bound_offset: mutable usize = 0
                while bound_offset < sum_ensure_counts[index] |bound_offset, found_bound, index, called, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi|:
                    summary2: Ast::Expr = all_sum_ensures[sum_ensure_starts[index] + bound_offset]
                    match summary2:
                        Expr.Binary(sum_left2, sum_operator2, sum_right2, sum_line2):
                            bound_const: (found: bool, value: i64) = fold_const_int(sum_right2)
                            usable: bool = ident_name_of(sum_left2) == "result" and bound_const.found and is_comparison_operator(sum_operator2)
                            if usable:
                                lin_apply_bound(called, sum_operator2, bound_const.value, false, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi)
                                found_bound <- true
                        _:
                            pass
                    bound_offset <- bound_offset + 1
                false return if not found_bound
                synthetic: Ast::Expr = (Ast::Expr.Ident(called, Ast::pos_at_line(0)))
                empty_env_names: darray[sview] = []
                empty_env_starts: darray[usize] = []
                empty_env_counts: darray[usize] = []
                empty_term_names: darray[sview] = []
                empty_term_coeffs: darray[i64] = []
                empty_env_consts: darray[i64] = []
                return linear_goal_deep_proven(goal_left, operator, goal_right, synthetic, true, false, boxed_params, boxed_has_lo, boxed_lo, boxed_has_hi, boxed_hi, empty_env_names, empty_env_starts, empty_env_counts, empty_term_names, empty_term_coeffs, empty_env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)

        # Whether OPERATOR is any comparison (the ensure goal shapes the prover judges).
        def is_comparison_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        # --- Protocol-callee ensure injection (strict) --------------------------------
        # Under strict proofs, stage0 discharges a generic function's `ensure P` when its
        # returned value IS a protocol method's result and that method DECLARES the same
        # `ensure P` (both `result`s denote the same value). The parser skips protocol
        # method bodies but captures each method's ensure predicate SOURCE SPAN at
        # 3900000073 (owner = method name). Stage1 has no access to the parsed callee
        # contract, so we match the goal Expr against that span token-by-token
        # (whitespace-insensitive): `text = r.read(p); return text; ensure result.count >= 1`
        # is proven from Reader.read's `ensure result.count >= 1`. SOUND — our `result` is
        # exactly the callee's `result`, so any postcondition it guarantees transfers.
        def es_skip_span_spaces(span: sview, pos: usize) -> usize:
            can Abort.Panic:
                cursor: mutable usize = pos
                while cursor < sview_len(span) and (sview_at(span, cursor) == 32 or sview_at(span, cursor) == 9) |cursor, span|:
                    cursor <- cursor + 1
                return cursor

        def es_span_ident_byte(byte: u8) -> bool:
            can Abort.Panic:
                return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 or (byte >= 48 and byte <= 57)

        # Match a single byte after skipping leading spaces.
        def es_match_byte(span: sview, pos: usize, want: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                cursor: usize = es_skip_span_spaces(span, pos)
                (true, cursor + 1) return if cursor < sview_len(span) and sview_at(span, cursor) == want
                return (false, cursor)

        # Match two contiguous raw bytes (no interior space) from `pos`.
        def es_match_two(span: sview, pos: usize, a: u8, b: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                (false, pos) return if pos + 1 >= sview_len(span)
                (true, pos + 2) return if sview_at(span, pos) == a and sview_at(span, pos + 1) == b
                return (false, pos)

        def es_match_one(span: sview, pos: usize, a: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                (true, pos + 1) return if pos < sview_len(span) and sview_at(span, pos) == a
                return (false, pos)

        def es_match_three(span: sview, pos: usize, a: u8, b: u8, c: u8) -> (ok: bool, at: usize):
            can Abort.Panic:
                (false, pos) return if pos + 2 >= sview_len(span)
                (true, pos + 3) return if sview_at(span, pos) == a and sview_at(span, pos + 1) == b and sview_at(span, pos + 2) == c
                return (false, pos)

        # Match an operator's source spelling after skipping leading spaces.
        def es_match_op(span: sview, pos: usize, operator: TokenKind) -> (ok: bool, at: usize):
            can Abort.Panic:
                cursor: usize = es_skip_span_spaces(span, pos)
                return match operator:
                    TokenKind.EqEq: es_match_two(span, cursor, 61, 61)
                    TokenKind.BangEq: es_match_two(span, cursor, 33, 61)
                    TokenKind.GtEq: es_match_two(span, cursor, 62, 61)
                    TokenKind.LtEq: es_match_two(span, cursor, 60, 61)
                    TokenKind.Lt: es_match_one(span, cursor, 60)
                    TokenKind.Gt: es_match_one(span, cursor, 62)
                    TokenKind.Plus: es_match_one(span, cursor, 43)
                    TokenKind.Minus: es_match_one(span, cursor, 45)
                    TokenKind.Star: es_match_one(span, cursor, 42)
                    TokenKind.Slash: es_match_one(span, cursor, 47)
                    TokenKind.Percent: es_match_one(span, cursor, 37)
                    TokenKind.And: es_match_three(span, cursor, 97, 110, 100)
                    TokenKind.Or: es_match_two(span, cursor, 111, 114)
                    _: (false, cursor)

        # Match identifier `name` (a whole ident run) after skipping leading spaces.
        def es_match_ident(span: sview, pos: usize, name: sview) -> (ok: bool, at: usize):
            can Abort.Panic:
                cursor: usize = es_skip_span_spaces(span, pos)
                end: mutable usize = cursor
                while end < sview_len(span) and es_span_ident_byte(sview_at(span, end)) |end, span|:
                    end <- end + 1
                length: usize = end - cursor
                (false, cursor) return if length != sview_len(name) or length == 0
                probe: mutable usize = 0
                while probe < length |probe, span, name, cursor|:
                    (false, cursor) return if sview_at(span, cursor + probe) != sview_at(name, probe)
                    probe <- probe + 1
                return (true, end)

        # Match a non-negative integer literal after skipping leading spaces.
        def es_match_int(span: sview, pos: usize, value: i64) -> (ok: bool, at: usize):
            can Memory.Allocate, Abort.Panic:
                (false, pos) return if value < 0
                cursor: usize = es_skip_span_spaces(span, pos)
                digits: mutable darray[u8] = []
                magnitude: mutable i64 = value
                digits.push(48) if magnitude == 0
                while magnitude > 0 |magnitude, digits|:
                    digits.push((48 + (magnitude % 10)).u8())
                    magnitude <- magnitude / 10
                count: usize = digits.count
                run: mutable usize = cursor
                probe: mutable usize = 0
                while probe < count |probe, run, span, digits, count, cursor|:
                    want: u8 = digits[count - 1 - probe]
                    (false, cursor) return if run >= sview_len(span) or sview_at(span, run) != want
                    run <- run + 1
                    probe <- probe + 1
                # A trailing digit would mean a longer number (e.g. span `12` vs literal `1`).
                (false, cursor) return if run < sview_len(span) and sview_at(span, run) >= 48 and sview_at(span, run) <= 57
                return (true, run)

        def es_expr_matches_span(expr: Ast::Expr, span: sview, pos: usize) -> (ok: bool, at: usize):
            can Memory.Allocate, Abort.Panic:
                match expr:
                    Expr.Ident(name, line):
                        return es_match_ident(span, pos, name)
                    Expr.IntLit(value):
                        return es_match_int(span, pos, value)
                    Expr.Paren(inner, paren_line):
                        open_step: (ok: bool, at: usize) = es_match_byte(span, pos, 40)
                        (false, pos) return if not open_step.ok
                        inner_step: (ok: bool, at: usize) = es_expr_matches_span(inner, span, open_step.at)
                        (false, pos) return if not inner_step.ok
                        return es_match_byte(span, inner_step.at, 41)
                    Expr.Field(object, field, field_line):
                        object_step: (ok: bool, at: usize) = es_expr_matches_span(object, span, pos)
                        (false, pos) return if not object_step.ok
                        dot_step: (ok: bool, at: usize) = es_match_byte(span, object_step.at, 46)
                        (false, pos) return if not dot_step.ok
                        return es_match_ident(span, dot_step.at, field)
                    Expr.Unary(operator, operand, unary_line):
                        op_step: (ok: bool, at: usize) = es_match_op(span, pos, operator)
                        (false, pos) return if not op_step.ok
                        return es_expr_matches_span(operand, span, op_step.at)
                    Expr.Binary(left, operator, right, binary_line):
                        left_step: (ok: bool, at: usize) = es_expr_matches_span(left, span, pos)
                        (false, pos) return if not left_step.ok
                        op_step: (ok: bool, at: usize) = es_match_op(span, left_step.at, operator)
                        (false, pos) return if not op_step.ok
                        return es_expr_matches_span(right, span, op_step.at)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_step: (ok: bool, at: usize) = es_expr_matches_span(callee, span, pos)
                        (false, pos) return if not callee_step.ok
                        open_step: (ok: bool, at: usize) = es_match_byte(span, callee_step.at, 40)
                        (false, pos) return if not open_step.ok
                        arg_at: mutable usize = open_step.at
                        arg_ok: mutable bool = true
                        arg_index: mutable usize = 0
                        while arg_index < arguments.count |arg_index, arg_at, arg_ok, arguments, span|:
                            if arg_index > 0:
                                comma_step: (ok: bool, at: usize) = es_match_byte(span, arg_at, 44)
                                arg_ok <- false if not comma_step.ok
                                arg_at <- comma_step.at
                            argument_step: (ok: bool, at: usize) = es_expr_matches_span(arguments[arg_index], span, arg_at)
                            arg_ok <- false if not argument_step.ok
                            arg_at <- argument_step.at
                            arg_index <- arg_index + 1
                        (false, pos) return if not arg_ok
                        return es_match_byte(span, arg_at, 41)
                    _:
                        return (false, pos)

        # Whether the goal predicate is TEXTUALLY the whole span (whitespace-insensitive).
        def es_goal_equals_span(goal: Ast::Expr, span: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                step: (ok: bool, at: usize) = es_expr_matches_span(goal, span, 0)
                false return if not step.ok
                remainder: usize = es_skip_span_spaces(span, step.at)
                return remainder >= sview_len(span)

        # Method name of a `recv.method(args)` call expression, else "".
        def es_call_method_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return match callee:
                            Expr.Field(object, field, field_line): field
                            _: sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return es_call_method_name(inner)
                    _:
                        return sview("", 0, 0)

        # The method name whose result is the function's return value: a direct
        # `return recv.m(args)`, or `return L` where `L = recv.m(args)` and L is not
        # wholly reassigned. "" when the return value is not a single method-call result.
        def es_return_method_name(return_expression: Ast::Expr, body: darray[Ast::Stmt]) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = es_call_method_name(return_expression)
                direct return if direct != ""
                local: sview = ident_name_of(return_expression)
                (sview("", 0, 0)) return if local == "" or es_local_wholly_reassigned(body, local)
                found: mutable sview = sview("", 0, 0)
                for statement in body |found, local|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            found <- es_call_method_name(value) if name == local and found == ""
                        Stmt.Assign(target, operator, value, line):
                            found <- es_call_method_name(value) if ident_name_of(target) == local and found == ""
                        _:
                            pass
                return found

        # --- Protocol algebraic-law discharge (transitivity) --------------------------
        # `ensure result == true; return x.le(z)` with `requires x.le(y), y.le(z)` is proven
        # by the protocol's transitivity law `(a.le(b) and b.le(c)) implies a.le(c)`. We
        # recognise the shape structurally: a boolean method-relation return chained through
        # the requires, backed by an available `implies`-law over that method (span sentinel
        # 3900000078). A protocol WITHOUT such a law (only `total`, no `implies`) is not
        # matched, so the goal stays unproven — mirroring stage0.
        def es_span_contains(span: sview, needle: sview) -> bool:
            can Abort.Panic:
                needle_length: usize = sview_len(needle)
                (false) return if needle_length == 0 or sview_len(span) < needle_length
                limit: usize = sview_len(span) - needle_length
                start: mutable usize = 0
                while start <= limit |start, span, needle, needle_length|:
                    matched: mutable bool = true
                    offset: mutable usize = 0
                    while offset < needle_length |offset, matched, span, needle, start|:
                        matched <- false if sview_at(span, start + offset) != sview_at(needle, offset)
                        offset <- offset + 1
                    true return if matched
                    start <- start + 1
                return false

        def es_is_true_literal(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.BoolLit(value):
                        return value
                    Expr.Ident(name, ident_line):
                        return name == "true"
                    _:
                        return false

        # A goal `result == true` / bare `result` — a "the relation holds" postcondition.
        def es_goal_is_true(goal: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match goal:
                    Expr.Paren(inner, paren_line):
                        return es_goal_is_true(inner)
                    Expr.Ident(name, ident_line):
                        return name == "result"
                    Expr.Binary(left, operator, right, binary_line):
                        return operator == TokenKind.EqEq and ident_name_of(left) == "result" and es_is_true_literal(right)
                    _:
                        return false

        # A binary method relation `recv.method(arg)` — (found, recv, method, arg).
        def es_method_relation(expression: Ast::Expr) -> (found: bool, recv: sview, method: sview, arg: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return es_method_relation(inner)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        if callee is Expr.Field(object, method, field_line):
                            recv: sview = ident_name_of(object)
                            (true, recv, method, arguments[0]) return if recv != "" and arguments.count == 1
                        return (false, sview("", 0, 0), sview("", 0, 0), (Ast::Expr.Absent))
                    _:
                        return (false, sview("", 0, 0), sview("", 0, 0), (Ast::Expr.Absent))

        # Whether `requires` chains recv.method(mid) and mid.method(arg) for some middle term.
        def es_requires_chain(recv: sview, method: sview, arg: Ast::Expr, requires_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                arg_name: sview = ident_name_of(arg)
                (false) return if arg_name == ""
                for first in requires_predicates |recv, method, arg_name, requires_predicates|:
                    first_relation: (found: bool, recv: sview, method: sview, arg: Ast::Expr) = es_method_relation(first)
                    if first_relation.found and first_relation.recv == recv and first_relation.method == method:
                        mid: sview = ident_name_of(first_relation.arg)
                        if mid != "":
                            for second in requires_predicates |method, mid, arg_name|:
                                second_relation: (found: bool, recv: sview, method: sview, arg: Ast::Expr) = es_method_relation(second)
                                true return if second_relation.found and second_relation.method == method and second_relation.recv == mid and ident_name_of(second_relation.arg) == arg_name
                return false

        # Whether the ensure GOAL is discharged by a protocol transitivity law over the return.
        def es_protocol_law_proves(goal: Ast::Expr, return_expression: Ast::Expr, has_return: bool, requires_predicates: darray[Ast::Expr]&, law_spans: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if not has_return
                false return if not es_goal_is_true(goal)
                relation: (found: bool, recv: sview, method: sview, arg: Ast::Expr) = es_method_relation(return_expression)
                false return if not relation.found
                false return if not es_requires_chain(relation.recv, relation.method, relation.arg, requires_predicates)
                implies_needle: sview = "implies"
                return any law in law_spans where es_span_contains(law, implies_needle) and es_span_contains(law, relation.method)
