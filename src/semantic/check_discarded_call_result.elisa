# Check for discarded results of function calls: a call to a non-void function
# appearing as an expression statement, silently discarding the result.

extend Semantic:
    private:
        # Check for discarded call results in a statement list.
        def check_discarded_call_result_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            # Check if the expression is a direct call to a known non-void function.
                            if expression is Expr.Call(callee, arguments, argument_names, call_line):
                                # Callee must be a bare identifier (not a method/UFCS call).
                                if callee is Expr.Ident(fn_name, ident_line):
                                    # Must be a uniquely-named function (no overloads).
                                    if direct_function_count(table, fn_name) == 1:
                                        # Look up the function's symbol.
                                        if find_symbol(table, fn_name) is sym:
                                            # Check: is it a function with a known non-void return type?
                                            if sym.kind == SymbolKind.Func and sym.return_type != "" and sym.return_type != "void":
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DiscardedCallResult, name: fn_name, line: line, expected: sym.return_type, actual: ""})
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_discarded_call_result_statements(then_body, table)
                            table <- check_discarded_call_result_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_discarded_call_result_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_discarded_call_result_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_discarded_call_result_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_discarded_call_result_statements(arm.body, table)
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass


        # Check for discarded call results in all declarations (recursing through Func/Module/Scoped).
        def check_discarded_call_result(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_discarded_call_result_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_discarded_call_result(body, table)
                        Decl.Scoped(body, line):
                            table <- check_discarded_call_result(body, table)
                        _:
                            pass
