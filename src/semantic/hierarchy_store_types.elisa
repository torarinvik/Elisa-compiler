# Store representation is shared by a hierarchy root and its refinements.
extend Semantic:
    private:
        def hierarchy_store_root(name: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                root: mutable sview = name
                for _ in 0..<table.enum_hierarchy_child.count |root, table|:
                    parent: mutable sview = ""
                    for index in 0..<table.enum_hierarchy_child.count |parent, root, table|:
                        parent <- table.enum_hierarchy_parent[index] if table.enum_hierarchy_child[index] == root
                    break if parent == "" or parent == root
                    root <- parent
                return root

        def hierarchy_has_store(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                root: sview = hierarchy_store_root(name, table)
                return true if any packed_name in table.packed_enum_names where packed_name == name or packed_name == root
                for packed_name in table.packed_enum_names |root, table|:
                    return true if hierarchy_store_root(packed_name, table) == root
                return (any parent in table.enum_hierarchy_parent where parent == root) and (any owner in table.enum_common_owners where owner == root)

        def check_inline_hierarchy_store_type(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, argument, index_pos):
                        table <- check_inline_hierarchy_store_type(object, table)
                        table <- check_inline_hierarchy_store_type(argument, table)
                    Expr.IndexN(object, arguments, index_pos):
                        table <- check_inline_hierarchy_store_type(object, table)
                        for argument in arguments |table| -> table:
                            table <- check_inline_hierarchy_store_type(argument, table)
                    Expr.Unary(operator, operand, unary_pos):
                        table <- check_inline_hierarchy_store_type(operand, table)
                    Expr.Paren(inner, paren_pos):
                        table <- check_inline_hierarchy_store_type(inner, table)
                    Expr.Field(Expr.Ident(owner, owner_pos), member, member_pos):
                        in_hierarchy: bool = (any child in table.enum_hierarchy_child where child == owner) or (any parent in table.enum_hierarchy_parent where parent == owner)
                        if member == "Store" and in_hierarchy and not hierarchy_has_store(owner, table):
                            bytes: mutable darray[u8] = []
                            for byte in owner |bytes|:
                                bytes.push(byte)
                            bytes.extend([46, 83, 116, 111, 114, 101])
                            name: sview @source = intern_joined_text(bytes, table)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownTypeName, name: name, pos: owner_pos, line: owner_pos.line, expected: "", actual: ""})
                    _:
                        pass
