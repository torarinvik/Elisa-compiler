# Copying a value OUT of a reference. With `r: T&`, the declaration `y: T = r`, `return r` from a
# function declared `-> T`, and the mutation `y <- r` each copy the pointee, and stage0 refuses all
# three ("variable \"y\" expects T, got T&", "return type expects T, got T&", "cannot assign T& to
# T"; a `mutable T&` says so). A scalar pointee auto-dereferences instead — measured for i64, f64,
# bool, u8 and char — so this fires only for the pointee kinds MEASURED to refuse: a registered
# struct or enum, `sview`, `cstr`, `dstr` (which stage0 spells `darray[u8]`), and `darray[E]`,
# `set[E]` and `dict[K, V]` over plain element names. A struct literal field declared `T` given
# the reference (`H{xs: r}`) is the same copy ("struct literal field \"xs\" expects T, got T&").
# A call argument is the same copy, and
# check_lmut_value_arg reports that one (RefArgValueParam).
#
# Bindings are read by name, so a name bound more than once in the function is skipped
# (check_borrow_binders).
extend Semantic:
    private:
        # `T&` / `mutable T&` -> T, else null. A real Absent pointee stays present. `lmut T` threads a value; it is not a reference.
        def rvc_ref_pointee(type_expression: Ast::Expr) -> Ast::Expr?:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(ref_operator, ref_operand, ref_pos):
                        ref_operand return if ref_operator == TokenKind.Ampersand
                        if ref_operator == TokenKind.Mutable:
                            match ref_operand:
                                Expr.Unary(inner_operator, inner_operand, inner_pos):
                                    inner_operand return if inner_operator == TokenKind.Ampersand
                                _:
                                    pass
                        return null
                    _:
                        return null

        def rvc_ref_is_mutable(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match type_expression:
                    Expr.Unary(outer_operator, outer_operand, outer_pos): outer_operator == TokenKind.Mutable
                    _: false

        # A by-value annotation `T` / `mutable T` -> T, else Absent.
        def rvc_value_type(type_expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(value_name, value_pos):
                        return type_expression
                    Expr.Index(value_head, value_argument, value_index_pos):
                        return type_expression
                    Expr.IndexN(value_head_n, value_arguments, value_indexn_pos):
                        return type_expression
                    Expr.Unary(value_operator, value_operand, value_unary_pos):
                        rvc_value_type(value_operand) return if value_operator == TokenKind.Mutable
                        return (Ast::Expr.Absent)
                    _:
                        return (Ast::Expr.Absent)

        # A named pointee stage0 refuses to copy out of a reference.
        def rvc_named_refuses(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                true return if name == "sview" or name == "cstr" or name == "dstr"
                return struct_is_registered(table, name) or is_enum_name(table, name)

        # A container element spelled the way stage0 renders it. `dstr` renders as `darray[u8]`.
        def rvc_plain_element(name: sview) -> bool:
            can Abort.Panic:
                return name != "" and name != "dstr"

        # `dict[K, V]` whose key and value are both plain named types.
        def rvc_plain_dict(arguments: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if arguments.count != 2
                return rvc_plain_element(ident_name_of(arguments[0])) and rvc_plain_element(ident_name_of(arguments[1]))

        # A fixed array's extent (`i64[4]` -> 4), else 0.
        def rvc_extent(type_expression: Ast::Expr) -> u32:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(extent_head, extent_argument, extent_pos):
                        match extent_argument:
                            Expr.IntLit(extent_value, extent_literal_pos):
                                return extent_value.u32() if extent_value > 0
                            _:
                                return 0
                    _:
                        return 0
                return 0

        # How the pointee is spelled: 1 a named type, 2 `darray[E]`/`set[E]`, 3 `dict[K, V]`,
        # 4 a fixed array `T[N]`; 0 for anything this check does not model.
        def rvc_shape(type_expression: Ast::Expr, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                shape: mutable u32 = 0
                match type_expression:
                    Expr.Ident(shape_name, shape_pos):
                        shape <- 1 if rvc_named_refuses(shape_name, table)
                    Expr.Index(shape_head, shape_argument, shape_index_pos):
                        sequence_head: sview = ident_name_of(shape_head)
                        sequence_ok: bool = sequence_head == "darray" or sequence_head == "set"
                        shape <- 2 if sequence_ok and rvc_plain_element(ident_name_of(shape_argument))
                        shape <- 4 if sequence_head != "" and rvc_extent(type_expression) > 0
                    Expr.IndexN(dict_head, dict_arguments, dict_pos):
                        shape <- 3 if ident_name_of(dict_head) == "dict" and rvc_plain_dict(dict_arguments)
                    _:
                        pass
                return shape

        def rvc_head(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(head_name, head_pos):
                        return head_name
                    Expr.Index(head_object, head_argument, head_index_pos):
                        return ident_name_of(head_object)
                    Expr.IndexN(head_object_n, head_arguments, head_indexn_pos):
                        return ident_name_of(head_object_n)
                    _:
                        return ""

        def rvc_first(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(first_object, first_argument, first_index_pos):
                        return ident_name_of(first_argument)
                    Expr.IndexN(first_object_n, first_arguments, first_indexn_pos):
                        return ident_name_of(first_arguments[0]) if first_arguments.count == 2 else ""
                    _:
                        return ""

        def rvc_second(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.IndexN(second_object, second_arguments, second_indexn_pos):
                        return ident_name_of(second_arguments[1]) if second_arguments.count == 2 else ""
                    _:
                        return ""

        # Whether two modelled types are spelled identically.
        def rvc_same_type(left: Ast::Expr, right: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                left_shape: u32 = rvc_shape(left, table)
                false return if left_shape == 0 or left_shape != rvc_shape(right, table)
                return rvc_head(left) == rvc_head(right) and rvc_first(left) == rvc_first(right) and rvc_second(left) == rvc_second(right) and rvc_extent(left) == rvc_extent(right)

        # `DynArray[T]` is the runtime header spelling of logical
        # `darray[T, shape]`. The shape is a compile-time refinement and is not
        # present in the runtime header, so the value-copy wall must accept this
        # boundary when the element type is identical. Keep the exception narrow:
        # it does not bridge arbitrary nominal structs or mismatched elements.
        def rvc_dynarray_bridge(left: Ast::Expr, right: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                left_head: sview = rvc_head(left)
                right_head: sview = rvc_head(right)
                return left_head == "darray" and right_head == "DynArray" and rvc_first(left) == rvc_first(right)

        # The annotation of a name's single binding: a parameter, else a declaration in the body.
        def rvc_body_annotation(statements: darray[Ast::Stmt]&, name: sview) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    found: mutable Ast::Expr = (Ast::Expr.Absent)
                    match statement:
                        Stmt.VarDecl(annotated_name, annotated_type, annotated_value, annotated_pos):
                            found <- annotated_type if annotated_name == name
                        Stmt.If(annotated_condition, annotated_then, annotated_else, annotated_if_pos):
                            found <- rvc_body_annotation(annotated_then, name)
                            found <- rvc_body_annotation(annotated_else, name) if rvc_is_absent(found)
                        Stmt.While(annotated_loop_condition, annotated_loop_body, annotated_loop_pos):
                            found <- rvc_body_annotation(annotated_loop_body, name)
                        Stmt.For(annotated_bind, annotated_variables, annotated_iterable, annotated_for_body, annotated_for_pos):
                            found <- rvc_body_annotation(annotated_for_body, name)
                        Stmt.Block(annotated_kind, annotated_clause, annotated_binding, annotated_block_body, annotated_block_pos):
                            found <- rvc_body_annotation(annotated_block_body, name)
                        Stmt.Match(annotated_scrutinee, annotated_arms, annotated_match_pos):
                            for annotated_arm in annotated_arms |found|:
                                found <- rvc_body_annotation(annotated_arm.body, name) if rvc_is_absent(found)
                        _:
                            pass
                    found return if not rvc_is_absent(found)
                return (Ast::Expr.Absent)

        def rvc_is_absent(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Absent: true
                    _: false

        def rvc_annotation(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, name: sview) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters:
                    parameter.type_expression return if parameter.name == name
                return rvc_body_annotation(body, name)

        # Report `source` (bound once, as `T&`) copied into a by-value `target_type` of the same T.
        # `state_code` carries the form — 1 declaration of `target_name`, 2 return, 3 `<-`
        # assignment, 4 struct literal field `target_name` — plus 10 when the reference is `mutable`, which stage0 spells out.
        def rvc_report(source: sview, target_type: Ast::Expr, target_name: sview, form: u32, pos: Ast::Pos, line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, binders: BorrowBinders&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not binders_bound_once(binders, source)
                source_annotation: Ast::Expr = rvc_annotation(parameters, body, source)
                if rvc_ref_pointee(source_annotation) is pointee:
                    return if rvc_dynarray_bridge(pointee, target_type)
                    return if not rvc_same_type(pointee, rvc_value_type(target_type), table)
                    spelling: mutable u32 = form
                    spelling <- form + 10 if rvc_ref_is_mutable(source_annotation)
                    if form == 4:
                        # check_construct_field_type ran first and called a string field's reference
                        # value just "reference"; stage0 prints only this sentence there.
                        write: mutable usize = 0
                        for read in 0..<table.diagnostics.count |write, table|:
                            existing: Diagnostic = table.diagnostics[read]
                            continue if existing.kind == DiagnosticKind.ConstructFieldTypeMismatch and existing.actual == "reference" and existing.pos.line == pos.line and existing.pos.column == pos.column
                            table.diagnostics[write] <- existing if write != read
                            write <- write + 1
                        table.diagnostics <- table.diagnostics.truncate(write)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefValueCopy, name: target_name, pos: pos, line: line, expected: rvc_head(pointee), actual: rvc_second(pointee), detail: rvc_first(pointee), expected_count: rvc_extent(pointee), actual_count: rvc_shape(pointee, table), state_code: spelling})

        def rvc_statements(statements: darray[Ast::Stmt], return_type: Ast::Expr, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, binders: BorrowBinders&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(copy_name, copy_type, copy_value, copy_pos):
                            match copy_value:
                                Expr.Ident(copy_source, copy_source_pos):
                                    table <- rvc_report(copy_source, copy_type, copy_name, 1, copy_pos, copy_pos.line, parameters, body, binders, table)
                                _:
                                    pass
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_pos):
                            assign_target_name: sview = ident_name_of(assign_target)
                            if assign_operator == TokenKind.LArrow and binders_bound_once(binders, assign_target_name):
                                match assign_value:
                                    Expr.Ident(assign_source, assign_source_pos):
                                        assign_target_type: Ast::Expr = rvc_annotation(parameters, body, assign_target_name)
                                        table <- rvc_report(assign_source, assign_target_type, assign_target_name, 3, Ast::expr_pos(assign_target), assign_pos.line, parameters, body, binders, table)
                                    _:
                                        pass
                        Stmt.Return(return_option, return_pos):
                            if return_option is return_expression:
                                match return_expression:
                                    Expr.Ident(return_source, return_source_pos):
                                        table <- rvc_report(return_source, return_type, "", 2, return_source_pos, return_source_pos.line, parameters, body, binders, table)
                                    _:
                                        pass
                        Stmt.If(copy_condition, copy_then, copy_else, copy_if_pos):
                            table <- rvc_statements(copy_then, return_type, parameters, body, binders, table)
                            table <- rvc_statements(copy_else, return_type, parameters, body, binders, table)
                        Stmt.While(copy_loop_condition, copy_loop_body, copy_loop_pos):
                            table <- rvc_statements(copy_loop_body, return_type, parameters, body, binders, table)
                        Stmt.For(copy_bind, copy_variables, copy_iterable, copy_for_body, copy_for_pos):
                            table <- rvc_statements(copy_for_body, return_type, parameters, body, binders, table)
                        Stmt.Block(copy_kind, copy_clause, copy_binding, copy_block_body, copy_block_pos):
                            table <- rvc_statements(copy_block_body, return_type, parameters, body, binders, table)
                        Stmt.Match(copy_scrutinee, copy_arms, copy_match_pos):
                            for copy_arm in copy_arms |table| -> table:
                                table <- rvc_statements(copy_arm.body, return_type, parameters, body, binders, table)
                        _:
                            pass

        # Form 4: a struct literal field given a bare `T&` (possibly parenthesised) where the
        # field is declared `T`. stage0 reports at the value, `(b)` at its `(`, spanning the name.
        def rvc_construct_fields(type_expression: Ast::Expr, fields: darray[Ast::FieldInit]&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, binders: BorrowBinders&, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                struct_name: sview = bare_type_name(type_expression)
                return if struct_name == ""
                for field in fields |table| -> table:
                    source: sview = ident_name_of(oe_strip(field.value))
                    continue if source == ""
                    row: mutable usize = 0
                    while row < f_struct.count |row, table| -> table:
                        if f_struct[row] == struct_name and f_name[row] == field.name:
                            value_pos: mutable Ast::Pos = Ast::expr_pos(field.value)
                            value_pos.end_column <- value_pos.column + source.len.u32()
                            table <- rvc_report(source, f_type[row], field.name, 4, value_pos, value_pos.line, parameters, body, binders, table)
                            row <- f_struct.count
                        else:
                            row <- row + 1

        def rvc_construct_expression(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, binders: BorrowBinders&, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Construct(construct_type, construct_fields, construct_pos):
                        table <- rvc_construct_fields(construct_type, construct_fields, parameters, body, binders, f_struct, f_name, f_type, table)
                        for construct_field in construct_fields |table| -> table:
                            table <- rvc_construct_expression(construct_field.value, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.Paren(paren_inner, paren_pos):
                        table <- rvc_construct_expression(paren_inner, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.Call(call_callee, call_arguments, call_names, call_pos):
                        table <- rvc_construct_expression(call_callee, parameters, body, binders, f_struct, f_name, f_type, table)
                        for call_argument in call_arguments |table| -> table:
                            table <- rvc_construct_expression(call_argument, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.Field(field_object, field_member, field_pos):
                        table <- rvc_construct_expression(field_object, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.Index(index_object, index_value, index_pos):
                        table <- rvc_construct_expression(index_object, parameters, body, binders, f_struct, f_name, f_type, table)
                        table <- rvc_construct_expression(index_value, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.Binary(binary_left, binary_operator, binary_right, binary_pos):
                        table <- rvc_construct_expression(binary_left, parameters, body, binders, f_struct, f_name, f_type, table)
                        table <- rvc_construct_expression(binary_right, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.Unary(unary_operator, unary_operand, unary_pos):
                        table <- rvc_construct_expression(unary_operand, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.Array(array_elements, array_pos):
                        for array_element in array_elements |table| -> table:
                            table <- rvc_construct_expression(array_element, parameters, body, binders, f_struct, f_name, f_type, table)
                    Expr.If(if_condition, if_then, if_else, if_pos):
                        table <- rvc_construct_expression(if_condition, parameters, body, binders, f_struct, f_name, f_type, table)
                        table <- rvc_construct_expression(if_then, parameters, body, binders, f_struct, f_name, f_type, table)
                        table <- rvc_construct_expression(if_else, parameters, body, binders, f_struct, f_name, f_type, table)
                    _:
                        pass

        def rvc_construct_statements(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, binders: BorrowBinders&, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            table <- rvc_construct_expression(declared_value, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.Expr(statement_expression, statement_pos):
                            table <- rvc_construct_expression(statement_expression, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.Assign(assigned_target, assigned_operator, assigned_value, assigned_pos):
                            table <- rvc_construct_expression(assigned_value, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.Return(returned_option, returned_pos):
                            if returned_option is returned_expression:
                                table <- rvc_construct_expression(returned_expression, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            table <- rvc_construct_statements(branch_then, parameters, body, binders, f_struct, f_name, f_type, table)
                            table <- rvc_construct_statements(branch_else, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            table <- rvc_construct_statements(loop_body, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            table <- rvc_construct_statements(for_body, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            table <- rvc_construct_statements(block_body, parameters, body, binders, f_struct, f_name, f_type, table)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            for match_arm in match_arms |table| -> table:
                                table <- rvc_construct_statements(match_arm.body, parameters, body, binders, f_struct, f_name, f_type, table)
                        _:
                            pass

        def rvc_declarations(declarations: darray[Ast::Decl], f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, function_parameters, function_return, function_body, function_effects, function_decorators, function_pos):
                            binders: mutable BorrowBinders = empty_borrow_binders()
                            borrow_function_binders(function_parameters, function_body, binders)
                            readable: bool = not (any binder in binders.names where binder == "*")
                            declared_return: mutable Ast::Expr = (Ast::Expr.Absent)
                            if function_return is present_return:
                                declared_return <- present_return
                            table <- rvc_statements(function_body, declared_return, function_parameters, function_body, binders, table) if readable
                            table <- rvc_construct_statements(function_body, function_parameters, function_body, binders, f_struct, f_name, f_type, table) if readable
                        Decl.Module(module_name, module_body, module_pos):
                            table <- rvc_declarations(module_body, f_struct, f_name, f_type, table)
                        Decl.Scoped(scoped_body, scoped_pos):
                            table <- rvc_declarations(scoped_body, f_struct, f_name, f_type, table)
                        _:
                            pass

    public:
        def check_ref_value_copy(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                f_struct: mutable darray[sview] = []
                f_name: mutable darray[sview] = []
                f_type: mutable darray[Ast::Expr] = []
                oe_collect_fields(declarations, f_struct, f_name, f_type)
                table <- rvc_declarations(declarations, f_struct, f_name, f_type, table)
