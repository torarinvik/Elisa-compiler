# Validate the type-level relation independently of operation names. This pass
# does not authorize construction or enable the consuming transition intrinsic.
extend Semantic:
    private:
        def protocol_family_has_state(family: Ast::StateFamily&, state: sview) -> bool:
            can Abort.Panic:
                for declared in family.states:
                    return true if declared == state
                return false

        def protocol_edge_belongs_to(edge: Ast::StateTransitionEdge&, family: Ast::StateFamily&) -> bool:
            edge.owner == family.owner and edge.module_name == family.module_name and edge.declaration_line == family.declaration_line and edge.declaration_offset == family.pos.offset

        def resolve_protocol_state_declarations(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<file.state_families.count |table, index|:
                    family: Ast::StateFamily = file.state_families[index]
                    matches: mutable usize = 0
                    declaration_id: mutable DeclId = DeclId{value: 4294967295}
                    for symbol in table.symbols |matches, declaration_id|:
                        if symbol.kind == SymbolKind.Struct and symbol.name == family.owner and symbol.module_owner == family.module_name and symbol.line == family.declaration_line and symbol.offset == family.pos.offset:
                            matches <- matches + 1
                            declaration_id <- symbol.id
                    if matches == 1:
                        table.resolved_state_families <- table.resolved_state_families.push(ResolvedStateFamily{declaration_id: declaration_id, source_index: index.u32()})
                    else:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolGraphUnresolvedFamily, name: family.owner, pos: family.pos, line: family.pos.line, expected: "", actual: ""})
                for index in 0..<file.state_transition_edges.count |table, index|:
                    edge: Ast::StateTransitionEdge = file.state_transition_edges[index]
                    for resolved in table.resolved_state_families |table|:
                        family: Ast::StateFamily = file.state_families[resolved.source_index.usize()]
                        table.resolved_state_edges <- table.resolved_state_edges.push(ResolvedStateEdge{declaration_id: resolved.declaration_id, source_index: index.u32()}) if protocol_edge_belongs_to(&edge, &family)

        def check_protocol_state_graph(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for family in file.state_families |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolGraphEmptyFamily, name: family.owner, pos: family.pos, line: family.pos.line, expected: "", actual: ""}) if family.states.count == 0
                    for index in 0..<family.states.count |table, index|:
                        for previous in 0..<index |table, previous|:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolGraphDuplicateState, name: family.owner, pos: family.pos, line: family.pos.line, expected: family.states[index], actual: ""}) if family.states[previous] == family.states[index]
                for index in 0..<file.state_transition_edges.count |table, index|:
                    edge: Ast::StateTransitionEdge = file.state_transition_edges[index]
                    found_family: mutable bool = false
                    for family in file.state_families |table, found_family|:
                        if protocol_edge_belongs_to(&edge, &family):
                            found_family <- true
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolGraphMixedDerived, name: edge.owner, pos: edge.pos, line: edge.pos.line, expected: "", actual: ""}) if family.has_derive
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolGraphUnknownState, name: edge.owner, pos: edge.pos, line: edge.pos.line, expected: edge.source_state, actual: edge.target_state}) if not protocol_family_has_state(&family, edge.source_state) or not protocol_family_has_state(&family, edge.target_state)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolGraphNoNamedFamily, name: edge.owner, pos: edge.pos, line: edge.pos.line, expected: "", actual: ""}) if not found_family
                    for previous in 0..<index |table, previous|:
                        other: Ast::StateTransitionEdge = file.state_transition_edges[previous]
                        duplicate: bool = other.owner == edge.owner and other.module_name == edge.module_name and other.declaration_line == edge.declaration_line and other.declaration_offset == edge.declaration_offset and other.source_state == edge.source_state and other.target_state == edge.target_state
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolGraphDuplicateEdge, name: edge.owner, pos: edge.pos, line: edge.pos.line, expected: edge.source_state, actual: edge.target_state}) if duplicate
