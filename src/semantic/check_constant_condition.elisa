extend Semantic:
    private:
        # Check for constant conditions in if and while statements within a statement list.
        # Flags `if true`, `if false`, and `while false` (but not `while true`, which is idiomatic).
        def check_constant_condition_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            if condition is Expr.BoolLit(value):
                                flag: sview = "true" if value else "false"
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstantCondition, name: "", line: line, expected: "", actual: flag})
                            table <- check_constant_condition_statements(then_body, table)
                            table <- check_constant_condition_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            if condition is Expr.BoolLit(value) and value == false:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConstantCondition, name: "", line: line, expected: "", actual: "false"})
                            table <- check_constant_condition_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_constant_condition_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            # A `static:` compile-time block is meant to hold constant
                            # conditions (they drive compile-time selection), so the
                            # always-true/false lint is suppressed inside it — matching stage0.
                            table <- check_constant_condition_statements(body, table) if kind != "static"
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_constant_condition_statements(arm.body, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass


        # Check for constant conditions in all declarations (recursing through Func/Module/Scoped).
        def check_constant_condition(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_constant_condition_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_constant_condition(body, table)
                        Decl.Scoped(body, line):
                            table <- check_constant_condition(body, table)
                        _:
                            pass
