extend Semantic:
    private:
        def lmut_value_check_scope_statements(statements: darray[Ast::Stmt], value_names: mutable darray[sview]&, value_types: mutable darray[sview @source]&, receiver_names: mutable darray[sview]&, receiver_types: mutable darray[sview @source]&, receiver_is_ref: mutable darray[u16]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- lmut_value_check_expression(expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- lmut_value_check_expression(value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            # Every declaration shadows, including primitive/mutable values
                            # that do not themselves need place diagnostics.
                            binding_kind: mutable u8 = lvarg_ref_kind(type_expression)
                            binding_kind <- 3 if binding_kind == 0 and lvarg_type_has_mutable(type_expression) and ref_arg_is_explicit(value, receiver_names, receiver_is_ref)
                            value_names.push(name)
                            value_types.push(lmut_value_type_name(type_expression))
                            receiver_names.push(name)
                            receiver_types.push(lvarg_base_struct_name(type_expression))
                            receiver_is_ref.push(binding_kind.u16())
                        Stmt.Assign(target, operator, value, line):
                            table <- lmut_value_check_expression(target, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_expression(value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            if operator == TokenKind.Assign:
                                match target:
                                    Expr.Ident(name, target_line):
                                        # Plain `=` introduces a fresh identifier binding
                                        # after its initializer, just like a declaration.
                                        # Keep even untracked types so a scalar shadows an
                                        # earlier aggregate with the same spelling.
                                        table <- lmut_record_assignment_binding(name, value, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                                    Expr.Array(elements, target_line):
                                        assignment_rhs: Ast::Expr = lmut_assignment_rhs_unwrap(value)
                                        match assignment_rhs:
                                            Expr.Array(values, value_line) | Expr.Tuple(values, value_line):
                                                # Infer every component against the pre-assignment
                                                # bindings, since the resolver evaluates the RHS
                                                # before introducing any destructured names.
                                                assigned_value_types: mutable darray[sview @source] = []
                                                assigned_receiver_types: mutable darray[sview @source] = []
                                                assigned_ref_kinds: mutable darray[u16] = []
                                                for assigned_value in values |assigned_value_types, assigned_receiver_types, assigned_ref_kinds|:
                                                    assigned_value_type: mutable sview @source = lmut_value_arg_type(assigned_value, value_names, value_types, receiver_names, receiver_types, table)
                                                    assigned_ref_type: sview @source = ref_arg_base_type(assigned_value, receiver_names, receiver_types, receiver_is_ref)
                                                    assigned_ref_kind: u8 = ref_arg_ref_kind(assigned_value, receiver_names, receiver_types, receiver_is_ref)
                                                    assigned_receiver_type: mutable sview @source = assigned_value_type
                                                    if assigned_ref_type != "":
                                                        assigned_value_type <- ""
                                                        assigned_receiver_type <- assigned_ref_type
                                                    assigned_value_types.push(assigned_value_type)
                                                    assigned_receiver_types.push(assigned_receiver_type)
                                                    assigned_ref_kinds.push(assigned_ref_kind.u16())
                                                index: mutable usize = 0
                                                for element in elements |index, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table|:
                                                    if element is Expr.Ident(name, element_line):
                                                        assigned_value_type: sview @source = assigned_value_types[index] if index < assigned_value_types.count else ""
                                                        assigned_receiver_type: sview @source = assigned_receiver_types[index] if index < assigned_receiver_types.count else ""
                                                        assigned_ref_kind: u16 = assigned_ref_kinds[index] if index < assigned_ref_kinds.count else 0
                                                        lmut_append_assignment_binding(name, assigned_value_type, assigned_receiver_type, assigned_ref_kind, value_names, value_types, receiver_names, receiver_types, receiver_is_ref)
                                                    index <- index + 1
                                            _:
                                                for element in elements |table| -> table:
                                                    if element is Expr.Ident(name, element_line):
                                                        table <- lmut_record_assignment_binding(name, Expr.Invalid, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                                    _:
                                        pass
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- lmut_value_check_expression(returned, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            condition_bindings: mutable darray[sview @source] = []
                            gather_truthy_condition_bindings(condition, table, condition_bindings)
                            condition_binding_types: darray[sview @source] = lmut_truthy_binding_types(condition, condition_bindings, value_names, value_types, receiver_names, receiver_types, table)
                            table <- lmut_value_check_bound_scope_types(then_body, Expr.Invalid, condition_bindings, condition_binding_types, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            table <- lmut_value_check_statements(else_body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.While(condition, while_body, line):
                            table <- lmut_value_check_expression(condition, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            condition_bindings: mutable darray[sview @source] = []
                            gather_truthy_condition_bindings(condition, table, condition_bindings)
                            condition_binding_types: darray[sview @source] = lmut_truthy_binding_types(condition, condition_bindings, value_names, value_types, receiver_names, receiver_types, table)
                            table <- lmut_value_check_bound_scope_types(while_body, Expr.Invalid, condition_bindings, condition_binding_types, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- lmut_value_check_expression(iterable, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            item_type: sview @source = lvarg_literal_iteration_type(iterable, value_names, value_types, receiver_names, receiver_types, table) if bind == "" and variables.count == 1 else ""
                            table <- lmut_value_check_bound_scope(for_body, Expr.Invalid, variables, item_type, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            if SemanticBlockKindScope::block_kind_is_scope(kind) and (kind != "region" or body.count > 0):
                                block_bindings: darray[sview @source] = [binding] if binding != "" else []
                                table <- lmut_value_check_bound_scope(body, Expr.Invalid, block_bindings, "", value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            else:
                                # Static inclusion and parser splice blocks introduce
                                # declarations in the enclosing scope, like the resolver.
                                if binding != "":
                                    value_names.push(binding)
                                    value_types.push("")
                                    receiver_names.push(binding)
                                    receiver_types.push("")
                                    receiver_is_ref.push(0)
                                table <- lmut_value_check_scope_statements(body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- lmut_value_check_expression(scrutinee, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                            match_type: sview @source = lmut_value_arg_type(scrutinee, value_names, value_types, receiver_names, receiver_types, table)
                            table <- lmut_value_check_match_arms(arms, match_type, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Stmt.Contract(kind, expression, line):
                            table <- lmut_value_check_expression(expression, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        _:
                            pass

        # The base STRUCT type of an annotation, peeling `mutable`/`&`/`lmut`/`stack`/`heap`
        # wrappers: `mutable Holder&` -> "Holder". Bare/primitive/non-struct annotations that
        # bare_type_name cannot reduce to a non-primitive name yield "". Used for the receiver
        # map so a field access through a ref receiver resolves its owning struct.
        def lvarg_base_struct_name(type_expression: Ast::Expr) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        return name if name != "" and lvarg_needs_place_tracking(name) else sview("", 0, 0)
                    Expr.Unary(operator, operand, unary_line):
                        return lvarg_base_struct_name(operand) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return sview("", 0, 0)
                    Expr.Paren(inner, paren_line):
                        return lvarg_base_struct_name(inner)
                    Expr.Index(indexed_object, index, index_line):
                        return lvarg_base_struct_name(indexed_object)
                    Expr.IndexN(indexed_object, arguments, index_n_line):
                        return lvarg_base_struct_name(indexed_object)
                    _:
                        return sview("", 0, 0)

        def check_lmut_value_arg_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            value_names: mutable darray[sview] = []
                            value_types: mutable darray[sview @source] = []
                            receiver_names: mutable darray[sview] = []
                            receiver_types: mutable darray[sview @source] = []
                            receiver_is_ref: mutable darray[u16] = []
                            for parameter in parameters |value_names, value_types, receiver_names, receiver_types, receiver_is_ref|:
                                parameter_type: sview = lmut_value_type_name(parameter.type_expression)
                                if parameter_type != "":
                                    value_names.push(parameter.name)
                                    value_types.push(parameter_type)
                                base_type: sview = lvarg_base_struct_name(parameter.type_expression)
                                if base_type != "":
                                    receiver_names.push(parameter.name)
                                    receiver_types.push(base_type)
                                    receiver_is_ref.push(lvarg_ref_kind(parameter.type_expression).u16())
                            table <- lmut_value_check_statements(body, value_names, value_types, receiver_names, receiver_types, receiver_is_ref, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_lmut_value_arg_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_lmut_value_arg_walk(scoped_body, table)
                        _:
                            pass

        def check_lmut_value_arg(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_lmut_value_arg_walk(file.top_decls, table)
