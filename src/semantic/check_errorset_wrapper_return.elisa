# A function returning `error[E]` whose body directly `return WRAP(g, ...)`s a POLYMORPHIC errorset
# wrapper — `def WRAP[errorset R](f: fn() -> T error[R]) -> T error[R]` — propagates the wrapper's
# instantiated error set out of the caller. When the concrete family bound to R (the error family of
# a function-reference argument `g`) is not covered by the caller's declared set E, the return type
# cannot hold: stage0 rejects it ("return type expects i64 | E, got i64 | error[...]").
#
# SOUND cut: fire only on a DIRECT `return CALL(...)` whose callee is a poly wrapper (its return
# family == its own `[errorset R]` parameter) and whose actual arguments bound to formals carrying
# R resolve to one concrete (non-parametric) error family. Unrelated arguments are ignored, while
# ambiguous or absent bindings decline; a caller whose declared set covers the family is left clean.
# The pass resolves bare identifiers in the current module, its lexical parents, and visible
# imports. Qualified module paths and visible aliases are resolved against the callable index.
extend Semantic:
    private:
        struct EwrFamilyRef:
            family: sview @source
            family_path: sview @source
            source_name: sview @source
            variant_override: sview @source
            module: sview @source
            module_known: bool
            family_row_index: usize
            has_family_row: bool
            function_name: sview @source
            function_module: sview @source
            function_module_known: bool
            declaration_line: u32
            declaration_offset: u32
            declaration_identity_id: u32
            occurrence_offset: u32

        struct EwrCallableBinding:
            found: mutable bool
            scope_length: mutable usize
            specificity: mutable usize
            match_known: mutable bool

        def ewr_empty_family_ref() -> EwrFamilyRef:
            return EwrFamilyRef{family: "", family_path: "", source_name: "", variant_override: "", module: "", module_known: false, family_row_index: 0.usize(), has_family_row: false, function_name: "", function_module: "", function_module_known: false, declaration_line: 0, declaration_offset: 0, declaration_identity_id: 0, occurrence_offset: 0}

        def ewr_empty_callable_binding() -> EwrCallableBinding:
            return EwrCallableBinding{found: false, scope_length: 0.usize(), specificity: 0.usize(), match_known: false}

        # Const declarations inside static-if arms only participate when those arms are
        # selected. The parser records each enclosing arm against the exact declaration
        # position, so same-scope inactive constants cannot shadow an active outer const.
        def ewr_static_if_const_branch_selection(file: Ast::File&, name: sview, symbol: Symbol, table: SymbolTable&, depth: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in file.enum_annotations |found_marker, unknown, file, name, symbol, table, depth|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__const_static_branch" or marker.detail_name != name or marker.module != symbol.module_owner or marker.line != symbol.line or marker.offset != symbol.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- ewr_static_if_row_selection(file, marker.identity_id.usize(), symbol.module_owner, table, depth + 1) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        def ewr_static_if_named_constant_value(name: sview, current_module: sview, file: Ast::File&, table: SymbolTable&, depth: u32) -> (known: bool, value: i64):
            can Abort.Panic:
                return (false, 0) if depth >= 64
                selected_row: mutable usize = table.immutable_const_values.count
                selected_scope_length: mutable usize = 0.usize()
                selected_ambiguous: mutable bool = false
                unknown_scope_length: mutable usize = 0.usize()
                found_unknown: mutable bool = false
                for const_index in 0..<table.immutable_const_values.count |selected_row, selected_scope_length, selected_ambiguous, unknown_scope_length, found_unknown, name, current_module, file, table, depth|:
                    continue if const_index >= table.immutable_const_names.count or const_index >= table.immutable_const_rows.count
                    continue if table.immutable_const_names[const_index] != name
                    symbol_row: usize = table.immutable_const_rows[const_index].usize()
                    continue if symbol_row >= table.symbols.count
                    symbol: Symbol = table.symbols[symbol_row]
                    continue if symbol.name != name or (symbol.module_owner != "" and not SemanticPrivateModuleBoundary::within_module(current_module, symbol.module_owner))
                    branch: (known: bool, active: bool) = ewr_static_if_const_branch_selection(file, name, symbol, table, depth + 1)
                    continue if branch.known and not branch.active
                    if not branch.known:
                        found_unknown <- true
                        unknown_scope_length <- symbol.module_owner.len if symbol.module_owner.len > unknown_scope_length
                        continue
                    if selected_row >= table.immutable_const_values.count or symbol.module_owner.len > selected_scope_length:
                        selected_row <- const_index
                        selected_scope_length <- symbol.module_owner.len
                        selected_ambiguous <- false
                    elif symbol.module_owner.len == selected_scope_length:
                        selected_ambiguous <- true
                # Exact-module declarations outrank root fallback; uncertainty only blocks
                # a candidate when it could be at least as specific as that winner.
                return (false, 0) if found_unknown and (selected_row >= table.immutable_const_values.count or unknown_scope_length >= selected_scope_length)
                return (false, 0) if selected_ambiguous
                return (false, 0) if selected_row >= table.immutable_const_values.count
                return ewr_static_if_condition_value(table.immutable_const_values[selected_row], current_module, file, table, depth + 1)

        def ewr_static_if_condition_value(expression: Ast::Expr, current_module: sview, file: Ast::File&, table: SymbolTable&, depth: u32) -> (known: bool, value: i64):
            can Abort.Panic:
                return (false, 0) if depth >= 64
                match expression:
                    Expr.BoolLit(value, _):
                        return (true, 1 if value else 0)
                    Expr.IntLit(value, _):
                        return (true, value)
                    Expr.Paren(inner, _):
                        return ewr_static_if_condition_value(inner, current_module, file, table, depth + 1)
                    Expr.Ident(name, _):
                        return ewr_static_if_named_constant_value(name, current_module, file, table, depth + 1)
                    _:
                        return (false, 0)

        # Follow the parser's generic branch-row identity and depth metadata. The
        # current_module parameter remains for shared Catch callers, but each condition
        # uses its recorded lexical module; a missing module row stays unknown.
        def ewr_static_if_row_selection(file: Ast::File&, branch_row: usize, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (known: bool, selected: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64 or branch_row >= file.static_if_lines.count or branch_row >= file.static_if_kinds.count
                branch_depth: u32 = file.static_if_depths[branch_row] if branch_row < file.static_if_depths.count else StaticIfBranch::TOP_LEVEL_DEPTH
                chain_start: mutable usize = file.static_if_lines.count
                row: mutable usize = branch_row + 1.usize()
                while row > 0 |row, chain_start, branch_depth, file|:
                    row <- row - 1.usize()
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    if file.static_if_kinds[row] == StaticIfBranch::Kind.ChainHead:
                        chain_start <- row
                        break
                return (false, false) if chain_start >= file.static_if_lines.count
                for row in chain_start..<(branch_row + 1.usize()) |row, branch_row, branch_depth, file|:
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    if file.static_if_kinds[row] == StaticIfBranch::Kind.Fallback:
                        return (true, row == branch_row)
                    return (false, false) if row >= file.static_if_conds.count or row >= file.static_if_modules.count
                    condition_module: sview = file.static_if_modules[row]
                    condition: (known: bool, value: i64) = ewr_static_if_condition_value(file.static_if_conds[row], condition_module, file, table, depth + 1)
                    return (false, false) if not condition.known
                    if condition.value != 0:
                        return (true, row == branch_row)
                    return (true, false) if row == branch_row
                return (true, false)

        def ewr_static_import_branch_selection(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, marker_name: sview, marker_detail: sview, module: sview, line: u32, offset: u32, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, file, marker_name, marker_detail, module, line, offset|:
                    continue if marker.owner != "__static_if_branch" or marker.name != marker_name or marker.detail_name != marker_detail or marker.module != module or marker.line != line or marker.offset != offset
                    found_marker <- true
                    branch: (known: bool, selected: bool) = ewr_static_if_row_selection(file, marker.identity_id.usize(), module, table) if marker.identity_id != 4294967295 else (false, false)
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        def ewr_static_import_annotation_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                if annotation.owner == "__from_member":
                    return ewr_static_import_branch_selection(annotations, file, "__from_member_static_branch", annotation.name, annotation.module, annotation.line, annotation.offset, table)
                if annotation.name == "__binding_wildcard_import":
                    return ewr_static_import_branch_selection(annotations, file, "__binding_wildcard_import_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset, table)
                if annotation.name == "__using_alias":
                    return ewr_static_import_branch_selection(annotations, file, "__using_alias_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset, table)
                return (true, true)

        # Remove import and module-alias annotations proven to live in inactive static
        # branches before EWR performs any callable visibility or alias lookup. Keep an
        # explicit marker for unresolved branches so one cannot be mistaken for the only
        # visible import and lend its ErrorSet family speculatively.
        def ewr_static_import_annotations(file: Ast::File&, table: SymbolTable&) -> darray[Ast::EnumAnnotation]:
            can Abort.Panic, Memory.Allocate:
                active: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |active, file, table|:
                    if annotation.owner == "__from_member" or annotation.name == "__binding_wildcard_import" or annotation.name == "__using_alias":
                        branch: (known: bool, active: bool) = ewr_static_import_annotation_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.active
                        if not branch.known:
                            if annotation.owner == "__from_member":
                                imported_module: mutable sview = ""
                                for source in file.enum_annotations |imported_module, annotation|:
                                    imported_module <- source.name if source.owner == "__from_src" and source.module == annotation.module and source.line == annotation.line and source.offset == annotation.offset
                                active.push(Ast::EnumAnnotation{owner: "__ewr_unknown_selective_import", name: annotation.name, detail_name: imported_module, module: annotation.module, line: annotation.line, offset: annotation.offset})
                            elif annotation.name == "__binding_wildcard_import":
                                active.push(Ast::EnumAnnotation{owner: "__ewr_unknown_wildcard_import", name: "__binding_wildcard_import", detail_name: annotation.owner, module: annotation.module, line: annotation.line, offset: annotation.offset})
                            else:
                                target: mutable sview = ""
                                for target_row in file.enum_annotations |target, annotation|:
                                    target <- target_row.owner if target_row.name == "__using_alias_target" and target_row.module == annotation.module and target_row.line == annotation.line and target_row.offset == annotation.offset
                                active.push(Ast::EnumAnnotation{owner: "__ewr_unknown_using_alias", name: annotation.owner, detail_name: target, module: annotation.module, line: annotation.line, offset: annotation.offset})
                            continue
                    active.push(annotation)
                return active

        def ewr_raw_callable_in_module(declarations: darray[Ast::Decl], name: sview, target_module: sview, current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            return true if function_name == name and current_module == target_module
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            return true if callable and extern_name == name and current_module == target_module
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_raw_callable_in_module(module_body, name, target_module, nested_module, table)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_raw_callable_in_module(scoped_body, name, target_module, current_module, table)
                        _:
                            pass
                return false

        def ewr_raw_callable_matches_import_path(declarations: darray[Ast::Decl], name: sview, base_module: sview, suffix: sview, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic, Memory.Allocate:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            path_matches: bool = current_module == suffix if base_module == "" else callable_module_path_matches_suffix(current_module, base_module, suffix)
                            return true if function_name == name and path_matches
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            path_matches: bool = current_module == suffix if base_module == "" else callable_module_path_matches_suffix(current_module, base_module, suffix)
                            return true if callable and extern_name == name and path_matches
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_raw_callable_matches_import_path(module_body, name, base_module, suffix, nested_module, table)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_raw_callable_matches_import_path(scoped_body, name, base_module, suffix, current_module, table)
                        _:
                            pass
                return false

        def ewr_qualifier_head_matches(qualifier: sview @source, wanted: sview) -> bool:
            can Abort.Panic:
                return false if qualifier.len < wanted.len
                return false if qualifier[0:wanted.len] != wanted
                return true if qualifier.len == wanted.len
                return false if qualifier.len < wanted.len + 2.usize()
                return qualifier[wanted.len] == 58 and qualifier[wanted.len + 1.usize()] == 58

        def ewr_raw_callable_matches_alias_path(declarations: darray[Ast::Decl], name: sview, alias_module: sview @source, alias_target: sview @source, suffix: sview @source, annotations: darray[Ast::EnumAnnotation]&, current_module: sview = "") -> bool:
            can Abort.Panic, Memory.Allocate:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            return true if function_name == name and callable_alias_path_matches_candidate(annotations, alias_module, alias_target, suffix, current_module)
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            return true if callable and extern_name == name and callable_alias_path_matches_candidate(annotations, alias_module, alias_target, suffix, current_module)
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_raw_callable_matches_alias_path(module_body, name, alias_module, alias_target, suffix, annotations, nested_module)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_raw_callable_matches_alias_path(scoped_body, name, alias_module, alias_target, suffix, annotations, current_module)
                        _:
                            pass
                return false

        # An unresolved alias only blocks family inference while it can still win
        # Core's program-wide alias lookup. Same-scope ordering includes exact static
        # branch ancestry; enclosing direct aliases and source order resolve cross-scope
        # registrations when Core's flatten traversal makes their order provable.
        def ewr_unknown_using_alias_is_definitely_shadowed(marker: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for possible_alias in table.possible_import_annotations |marker, table|:
                    continue if possible_alias.name != "__using_alias" or possible_alias.owner != marker.name or possible_alias.module != marker.module or possible_alias.line != marker.line or possible_alias.offset != marker.offset
                    for definite_alias in table.definite_import_annotations |possible_alias, table|:
                        continue if definite_alias.name != "__using_alias" or definite_alias.owner != possible_alias.owner
                        ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(definite_alias, possible_alias, table)
                        return true if ordering.known and ordering.left_precedes and ewr_definite_module_alias_is_global_winner(definite_alias, table)
                    return false
                # The marker was created from an unresolved source row. If its original
                # row is missing from the projection, keep the conservative barrier.
                return false

        def ewr_module_alias_order(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, left_precedes: bool):
            can Abort.Panic:
                return semantic_possible_import_alias_precedes(left, right, table)

        def ewr_definite_module_alias_is_global_winner(alias: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for candidate in table.definite_import_annotations |alias, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    continue if candidate.module == alias.module and candidate.line == alias.line and candidate.offset == alias.offset
                    ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(candidate, alias, table)
                    return false if not ordering.known or ordering.left_precedes
                for candidate in table.possible_import_annotations |alias, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(candidate, alias, table)
                    return false if not ordering.known or ordering.left_precedes
                return true

        def ewr_unknown_static_import_affects_call(annotations: darray[Ast::EnumAnnotation]&, declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic, Memory.Allocate:
                for marker in annotations:
                    if marker.owner == "__ewr_unknown_selective_import" and marker.name == name:
                        return true if ewr_raw_callable_matches_import_path(declarations, name, marker.module, marker.detail_name, "", table)
                    if marker.owner == "__ewr_unknown_wildcard_import" and ewr_module_is_lexical_ancestor(marker.module, caller_module):
                        return true if ewr_raw_callable_in_module(declarations, name, marker.detail_name, "", table)
                        return true if ewr_raw_callable_matches_import_path(declarations, name, marker.module, marker.detail_name, "", table)
                    if marker.owner == "__ewr_unknown_using_alias" and qualifier != "" and ewr_qualifier_head_matches(qualifier, marker.name):
                        alias_head_length: usize = marker.name.len
                        suffix: sview @source = qualifier[alias_head_length + 2.usize():qualifier.len] if qualifier.len > alias_head_length else ""
                        return true if ewr_raw_callable_matches_alias_path(declarations, name, marker.module, marker.detail_name, suffix, annotations) and not ewr_unknown_using_alias_is_definitely_shadowed(marker, table)
                return false

        # Unqualified Stage0 lookup checks the current scope and then its parents. Keep
        # this local to EWR so a nested caller can resolve an enclosing declaration, while
        # unrelated sibling modules remain invisible.
        def ewr_module_is_lexical_ancestor(candidate: sview, caller: sview) -> bool:
            can Abort.Panic:
                return true if candidate == caller or candidate == ""
                return false if candidate.len + 2.usize() >= caller.len
                for index in 0..<candidate.len |candidate, caller|:
                    return false if candidate[index] != caller[index]
                return caller[candidate.len] == 58 and caller[candidate.len + 1.usize()] == 58

        # Encode lexical depth first, then Core's lookup order within one scope:
        # local declarations, wildcard `using`, then program-wide selective aliases.
        def ewr_local_scope_rank(module: sview, caller_module: sview) -> usize:
            # Reserve a band above every wildcard scope visible to CALLER_MODULE.
            # A local binding in a lexical parent precedes even a wildcard declared
            # in a more deeply nested module.
            return caller_module.len + caller_module.len + 2.usize() + module.len

        def ewr_wildcard_scope_rank(module: sview, caller_module: sview) -> usize:
            # Core appends inherited `using` names before names declared in the
            # current module, so the outermost visible wildcard has first precedence.
            return caller_module.len - module.len + 1.usize()

        # Wildcard imports are visible only from the lexical scope containing their
        # `using` declaration. Selective imports are program-wide aliases in Core; after
        # checking lexical wildcards, use the same first-alias lookup as Try.
        def ewr_imported_callable_scope(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, caller_module: sview) -> (visible: bool, scope_length: usize):
            can Abort.Panic:
                visible: mutable bool = false
                scope_length: mutable usize = 0
                for binding in annotations |visible, scope_length, annotations, name, candidate_module, caller_module|:
                    if binding.name == "__binding_wildcard_import" and binding.owner == candidate_module and ewr_module_is_lexical_ancestor(binding.module, caller_module):
                        wildcard_rank: usize = ewr_wildcard_scope_rank(binding.module, caller_module)
                        if not visible or wildcard_rank > scope_length:
                            visible <- true
                            scope_length <- wildcard_rank
                return (true, scope_length) if visible
                # Selective aliases are collected program-wide, including when the `from`
                # declaration appears in a sibling module. The shared helper preserves
                # Core's first-import-wins rule and resolves module aliases in the source.
                return (true, 0.usize()) if callable_program_selective_import_row(annotations, name, candidate_module)
                return (visible, scope_length)

        def ewr_callable_name_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview @source, caller_module: sview @source, declaration_line: u32, declaration_offset: u32) -> bool:
            can Abort.Panic:
                return false if not try_error_alias_module_visible(annotations, candidate_module, caller_module)
                legacy_private_marker: mutable bool = false
                for annotation in annotations |legacy_private_marker, name, candidate_module, caller_module, declaration_line, declaration_offset|:
                    continue if annotation.name != name or annotation.module != candidate_module or (annotation.owner != "__section_private" and annotation.owner != "__section_public")
                    # A source token span has positive length even when its line and
                    # starting offset are both zero; the default Pos has an empty span.
                    marker_position_known: bool = annotation.pos.end_offset > annotation.pos.offset
                    exact_position: bool = marker_position_known and annotation.pos.line == declaration_line and annotation.pos.offset == declaration_offset
                    if exact_position:
                        return ewr_module_is_lexical_ancestor(candidate_module, caller_module) if annotation.owner == "__section_private"
                        return true if annotation.owner == "__section_public"
                    legacy_private_marker <- true if annotation.owner == "__section_private" and not marker_position_known
                # Older side tables have no declaration coordinate. Fail closed when a
                # same-name private marker could refer to this candidate; parser-produced
                # markers carry Ast::Pos so byte offset zero remains an exact position.
                return false if legacy_private_marker
                return true

        def ewr_callable_binding_consider(binding: mutable EwrCallableBinding&, candidate_scope_length: usize) -> void:
            if not binding.found or candidate_scope_length > binding.scope_length:
                binding.found <- true
                binding.scope_length <- candidate_scope_length
                binding.specificity <- 0.usize()
                binding.match_known <- false

        def ewr_callable_binding_consider_ranked(binding: mutable EwrCallableBinding&, candidate_scope_length: usize, candidate_specificity: usize, candidate_match_known: bool) -> void:
            if not binding.found or candidate_scope_length > binding.scope_length:
                binding.found <- true
                binding.scope_length <- candidate_scope_length
                binding.specificity <- candidate_specificity
                binding.match_known <- candidate_match_known
            elif candidate_scope_length == binding.scope_length:
                if not candidate_match_known or not binding.match_known:
                    binding.match_known <- false
                elif candidate_specificity > binding.specificity:
                    binding.specificity <- candidate_specificity
                elif candidate_specificity == binding.specificity:
                    # A tie between private candidates is still a possible Core winner.
                    binding.match_known <- false

        def ewr_bool_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        # Ordinary free-call lookup binds the first visible name before validating call
        # arity or argument types. Preserve that binding so an incompatible local function
        # cannot disappear and expose a lower-priority imported ErrorSet family.
        def ewr_callable_binding_in_scope(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, current_module: sview @source, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, binding: mutable EwrCallableBinding&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |name, qualifier, current_module, caller_module, annotations, table, binding|:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, position):
                            if function_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: mutable bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_visible <- false if candidate_visible and not ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset)
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider(binding, candidate_scope_length) if candidate_visible
                        Decl.Extern(extern_name, _, _, _, callable, _, _, position):
                            if callable and extern_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: mutable bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_visible <- false if candidate_visible and not ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset)
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider(binding, candidate_scope_length) if candidate_visible
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            ewr_callable_binding_in_scope(module_body, name, qualifier, nested_module, caller_module, annotations, table, binding)
                        Decl.Scoped(scoped_body, _):
                            ewr_callable_binding_in_scope(scoped_body, name, qualifier, current_module, caller_module, annotations, table, binding)
                        _:
                            pass

        def ewr_first_visible_callable_binding(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> EwrCallableBinding:
            can Memory.Allocate, Abort.Panic:
                binding: mutable EwrCallableBinding = ewr_empty_callable_binding()
                ewr_callable_binding_in_scope(declarations, name, qualifier, "", caller_module, annotations, table, binding)
                return binding

        def ewr_callable_declared_in_module(declarations: darray[Ast::Decl], name: sview, target_module: sview, current_module: sview @source, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, position):
                            return true if function_name == name and current_module == target_module and ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset)
                        Decl.Extern(extern_name, _, _, _, callable, _, _, position):
                            return true if callable and extern_name == name and current_module == target_module and ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset)
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_callable_declared_in_module(module_body, name, target_module, nested_module, caller_module, annotations, table)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_callable_declared_in_module(scoped_body, name, target_module, current_module, caller_module, annotations, table)
                        _:
                            pass
                return false

        # Core reports a bare reference as ambiguous when multiple distinct visible
        # wildcard targets export that name. Do not let the scope-rank fallback invent
        # one ErrorSet family for a call Core cannot bind. A lexical declaration wins
        # before imports, and receiver-ranked UFCS calls use their separate candidate path.
        def ewr_wildcard_callable_name_is_ambiguous(declarations: darray[Ast::Decl], name: sview, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                lexical_binding: EwrCallableBinding = ewr_first_visible_callable_binding(declarations, name, "", caller_module, annotations, table)
                return false if lexical_binding.found and lexical_binding.scope_length > caller_module.len + 1.usize()
                targets: mutable darray[sview @source] = []
                for binding in annotations |targets, declarations, name, caller_module, annotations, table|:
                    continue if binding.name != "__binding_wildcard_import" or not ewr_module_is_lexical_ancestor(binding.module, caller_module)
                    continue if not ewr_callable_declared_in_module(declarations, name, binding.owner, "", caller_module, annotations, table)
                    continue if any target in targets where target == binding.owner
                    targets.push(binding.owner)
                    return true if targets.count >= 2.usize()
                return false

        # Core can bind a private primary before reporting its access error when the
        # free-call receiver rewrite is disabled (for example, by named arguments).
        # Keep inaccessible candidates as barriers at their lexical/import scope.
        def ewr_inaccessible_callable_binding_in_scope(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, current_module: sview @source, caller_module: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, binding: mutable EwrCallableBinding&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |name, qualifier, current_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding|:
                    match declaration:
                        Decl.Func(function_name, parameters, _, _, _, _, position):
                            if function_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_accessible: bool = ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset) if candidate_visible else false
                                # This helper only models a call with receiver ranking disabled.
                                # Core binds the direct name first and can retain its return type
                                # after diagnosing a positional count error.
                                candidate_arity_viable: bool = true
                                # This path runs only when Core's receiver-rank gate is off;
                                # direct-name binding is retained before argument diagnostics.
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider_ranked(binding, candidate_scope_length, 0.usize(), false) if candidate_visible and not candidate_accessible and candidate_arity_viable
                        Decl.Extern(extern_name, _, _, _, callable, _, _, position):
                            if callable and extern_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_accessible: bool = ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset) if candidate_visible else false
                                candidate_arity_viable: bool = true
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider_ranked(binding, candidate_scope_length, 0.usize(), false) if candidate_visible and not candidate_accessible and candidate_arity_viable
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            ewr_inaccessible_callable_binding_in_scope(module_body, name, qualifier, nested_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding)
                        Decl.Scoped(scoped_body, _):
                            ewr_inaccessible_callable_binding_in_scope(scoped_body, name, qualifier, current_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding)
                        _:
                            pass

        def ewr_first_inaccessible_callable_binding(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> EwrCallableBinding:
            can Memory.Allocate, Abort.Panic:
                binding: mutable EwrCallableBinding = ewr_empty_callable_binding()
                ewr_inaccessible_callable_binding_in_scope(declarations, name, qualifier, "", caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding)
                return binding

        # Core's callNameHasOverloadSet checks each qualified candidate name's UFCS
        # registrations separately. Two visible singleton names do not become one
        # overload set just because both can be named by the same bare identifier.
        def ewr_callable_count_in_module(declarations: darray[Ast::Decl], name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                count: mutable usize = 0.usize()
                for declaration in declarations |count, name|:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            count <- count + 1.usize() if function_name == name
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            count <- count + 1.usize() if callable and extern_name == name
                        Decl.Scoped(scoped_body, _):
                            count <- count + ewr_callable_count_in_module(scoped_body, name)
                        _:
                            pass
                return count

        def ewr_visible_callable_overload_set_in_scope(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, current_module: sview, caller_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module)
                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, current_module, caller_module) if not candidate_is_local else (false, 0.usize())
                candidate_visible: bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                return true if candidate_visible and ewr_callable_count_in_module(declarations, name) >= 2.usize()
                for declaration in declarations |name, current_module, caller_module, annotations, table|:
                    match declaration:
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_visible_callable_overload_set_in_scope(module_body, name, qualifier, nested_module, caller_module, annotations, table)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_visible_callable_overload_set_in_scope(scoped_body, name, qualifier, current_module, caller_module, annotations, table)
                        _:
                            pass
                return false

        def ewr_visible_name_has_overload_set(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ewr_visible_callable_overload_set_in_scope(declarations, name, qualifier, "", caller_module, annotations, table)

        def ewr_receiver_rank_gate(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview, call_arity_known: bool, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> bool:
            can Abort.Panic, Memory.Allocate:
                has_named_argument: bool = any argument_name in call_argument_names where argument_name != ""
                return false if not call_arity_known or call_arguments.count == 0.usize() or has_named_argument or has_argument_forward
                return ewr_visible_name_has_overload_set(declarations, name, qualifier, caller_module, annotations, table)

        # Resolve a qualified module path through exact names, the program-wide alias
        # map, and the caller's lexical prefix chain.
        def ewr_qualified_module_matches(candidate_module: sview, qualifier: sview @source, caller_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return ewr_qualified_module_rank(candidate_module, qualifier, caller_module, annotations, table) > 0.usize()

        # Core tries lexical prefixes first, then a first-segment module-alias
        # rewrite, and finally the spelled path. Larger ranks preserve that order
        # when several candidate modules contain the same callable.
        def ewr_qualified_module_rank(candidate_module: sview, qualifier: sview @source, caller_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> usize:
            can Memory.Allocate, Abort.Panic:
                lexical_rank: usize = ewr_qualified_module_path_rank(candidate_module, qualifier, caller_module)
                return lexical_rank if lexical_rank > 0.usize()
                return 2.usize() if ewr_known_module_alias_path_matches_candidate(candidate_module, qualifier, annotations, table)
                return 1.usize() if candidate_module == qualifier
                return 0.usize()

        def ewr_qualified_module_path_rank(candidate_module: sview, qualifier: sview @source, caller_module: sview) -> usize:
            can Abort.Panic:
                scope_module: mutable sview = caller_module
                while true |scope_module, candidate_module, qualifier|:
                    return 0.usize() if scope_module == ""
                    return scope_module.len + 3.usize() if callable_module_path_matches_suffix(candidate_module, scope_module, qualifier)
                    scope_module <- try_noncall_module_parent(scope_module)

        # Stage0 records `using ... as Alias` in a program-wide alias map, including
        # declarations nested in modules. Match the source target relative to each
        # declaring scope, then keep only the first registration using the provable
        # scope and source ordering shared with Stage0.
        def ewr_known_module_alias_path_matches_candidate(candidate_module: sview, qualifier: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                separator: mutable usize = qualifier.len
                for offset in 0..<qualifier.len |separator, qualifier|:
                    if offset + 1.usize() < qualifier.len and qualifier[offset] == 58 and qualifier[offset + 1.usize()] == 58:
                        separator <- offset
                        break
                alias_name: sview = qualifier[0:separator]
                suffix: sview @source = qualifier[separator + 2.usize():qualifier.len] if separator < qualifier.len else ""
                found: mutable bool = false
                for alias in annotations |found, alias_name, suffix, candidate_module, annotations|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name
                    shadowed: mutable bool = false
                    for earlier_alias in annotations |alias, shadowed, alias_name, annotations, table|:
                        continue if earlier_alias.name != "__using_alias" or earlier_alias.owner != alias_name
                        continue if earlier_alias.line == alias.line and earlier_alias.offset == alias.offset
                        ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(earlier_alias, alias, table)
                        shadowed <- true if not ordering.known or ordering.left_precedes
                    for possible_alias in table.possible_import_annotations |alias, shadowed, alias_name, table|:
                        continue if possible_alias.name != "__using_alias" or possible_alias.owner != alias_name
                        ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(possible_alias, alias, table)
                        shadowed <- true if not ordering.known or ordering.left_precedes
                    continue if shadowed
                    target_count: mutable usize = 0.usize()
                    target: mutable sview @source = ""
                    for target_row in annotations |target_count, target, alias|:
                        if target_row.name == "__using_alias_target" and target_row.module == alias.module and target_row.line == alias.line and target_row.offset == alias.offset:
                            target <- target_row.owner
                            target_count <- target_count + 1.usize()
                    return false if target_count != 1.usize()
                    return false if not callable_alias_path_matches_candidate(annotations, alias.module, target, suffix, candidate_module)
                    found <- true
                return found

        def ewr_declaration_has_error_return(annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, offset: u32) -> bool:
            can Abort.Panic:
                return any row in annotations where row.owner == name and row.name == "__error_return" and row.line == line and row.offset == offset

        def ewr_call_has_argument_forward(annotations: darray[Ast::EnumAnnotation]&, call_line: u32, call_offset: u32) -> bool:
            can Abort.Panic:
                return any row in annotations where row.owner == "__arg_forward" and row.name == "__arg_forward" and row.line == call_line and row.offset == call_offset

        def ewr_function_accepts_arity(parameters: darray[Ast::ParamDecl], decorators: darray[Ast::Annotation], argument_count: usize) -> bool:
            can Abort.Panic:
                has_default: bool = any parameter in parameters where parameter.has_default
                has_variadic: bool = any decorator in decorators where decorator.name == "c_variadic"
                # Core's receiver-rank prefilter retains every defaulted or variadic
                # signature. Missing required args and excess fixed args are diagnosed
                # after the raw overload winner has been chosen.
                return has_variadic or has_default or argument_count == parameters.count

        def ewr_declaration_accepts_arity(declarations: darray[Ast::Decl], function_line: u32, function_offset: u32, argument_count: usize) -> (found: bool, accepts: bool):
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(_, parameters, _, _, _, decorators, line):
                            return (true, ewr_function_accepts_arity(parameters, decorators, argument_count)) if line.line == function_line and line.offset == function_offset
                        Decl.Extern(_, _, arity, variadic, callable, _, _, line):
                            if line.line == function_line and line.offset == function_offset:
                                accepts: bool = variadic or argument_count == arity.usize()
                                return (true, callable and accepts)
                        Decl.Module(_, module_body, _):
                            nested: (found: bool, accepts: bool) = ewr_declaration_accepts_arity(module_body, function_line, function_offset, argument_count)
                            return nested if nested.found
                        Decl.Scoped(scoped_body, _):
                            nested: (found: bool, accepts: bool) = ewr_declaration_accepts_arity(scoped_body, function_line, function_offset, argument_count)
                            return nested if nested.found
                        _:
                            pass
                return (false, true)

        def ewr_type_expression_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name
                    _:
                        return ""

        def ewr_generic_parameter_at(annotations: darray[Ast::EnumAnnotation]&, name: sview, function_line: u32, function_offset: u32, function_module: sview) -> bool:
            can Abort.Panic:
                return true if any row in annotations where row.owner == name and row.name == "__generic_param_identity" and row.detail_line == function_line and row.offset == function_offset and row.module == function_module
                return false

        # Only primitive actual types are used to select here. Literals carry their
        # primitive category directly; identifiers use a caller parameter's declared type.
        # Locals and compound expressions stay unknown so this narrow analysis declines.
        def ewr_actual_primitive_type(expression: Ast::Expr, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, kind: u8, name: sview):
            can Abort.Panic:
                match expression:
                    Expr.IntLit(_, _):
                        return (true, 1, "")
                    Expr.FloatLit(_, _):
                        return (true, 2, "")
                    Expr.BoolLit(_, _):
                        return (true, 3, "bool")
                    Expr.CharLit(_, _):
                        return (true, 4, "char")
                    Expr.Ident(name, _):
                        return (false, 0, "") if any local_name in caller_local_names where local_name == name
                        for parameter in caller_parameters:
                            if parameter.name == name:
                                type_name: sview = ewr_type_expression_name(parameter.type_expression)
                                return (true, 5, type_name) if is_bare_primitive_type(type_name)
                                return (false, 0, "")
                        return (false, 0, "")
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ewr_actual_primitive_type(inner, caller_parameters, caller_local_names)
                    _:
                        return (false, 0, "")

        def ewr_argument_type_match(argument: Ast::Expr, expected_expression: Ast::Expr, function_line: u32, function_offset: u32, function_module: sview, annotations: darray[Ast::EnumAnnotation]&, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, matches: bool, specificity: usize):
            can Abort.Panic:
                expected_name: sview = ewr_type_expression_name(expected_expression)
                return (false, true, 0.usize()) if expected_name == ""
                actual: (known: bool, kind: u8, name: sview) = ewr_actual_primitive_type(argument, caller_parameters, caller_local_names)
                if ewr_generic_parameter_at(annotations, expected_name, function_line, function_offset, function_module):
                    return (actual.known, true, 0.usize())
                return (false, true, 0.usize()) if not actual.known
                if actual.kind == 1:
                    matches: bool = is_integer_type_name(expected_name)
                    return (true, matches, 1.usize() if matches else 0.usize())
                if actual.kind == 2:
                    matches: bool = is_float_type_name(expected_name)
                    return (true, matches, 1.usize() if matches else 0.usize())
                if actual.kind == 3 or actual.kind == 4:
                    matches: bool = actual.name == expected_name
                    return (true, matches, 2.usize() if matches else 0.usize()) if is_bare_primitive_type(expected_name)
                    return (false, true, 0.usize())
                if actual.kind == 5:
                    return (false, true, 0.usize()) if not is_bare_primitive_type(expected_name)
                    matches: bool = actual.name == expected_name
                    return (true, matches, 2.usize() if matches else 0.usize())
                return (false, true, 0.usize())

        def ewr_extern_argument_type_match(argument: Ast::Expr, expected_name: sview, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, matches: bool, specificity: usize):
            can Abort.Panic:
                return (false, true, 0.usize()) if not is_bare_primitive_type(expected_name)
                actual: (known: bool, kind: u8, name: sview) = ewr_actual_primitive_type(argument, caller_parameters, caller_local_names)
                return (false, true, 0.usize()) if not actual.known
                if actual.kind == 1:
                    matches: bool = is_integer_type_name(expected_name)
                    return (true, matches, 1.usize() if matches else 0.usize())
                if actual.kind == 2:
                    matches: bool = is_float_type_name(expected_name)
                    return (true, matches, 1.usize() if matches else 0.usize())
                if actual.kind == 3 or actual.kind == 4:
                    matches: bool = actual.name == expected_name
                    return (true, matches, 2.usize() if matches else 0.usize())
                if actual.kind == 5:
                    matches: bool = actual.name == expected_name
                    return (true, matches, 2.usize() if matches else 0.usize())
                return (false, true, 0.usize())

        def ewr_extern_arguments_match(param_start: u32, arity: u32, extern_params: darray[Ast::ExternParam], arguments: darray[Ast::Expr], caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, viable: bool, specificity: usize):
            can Abort.Panic:
                return (false, true, 0.usize()) if arity == 0 or arguments.count == 0
                parameter_index: usize = param_start.usize()
                return (false, true, 0.usize()) if parameter_index >= extern_params.count
                parameter: Ast::ExternParam = extern_params[parameter_index]
                return (false, true, 0.usize()) if parameter.is_ref or parameter.optional or parameter.mutable_ref
                matched: (known: bool, matches: bool, specificity: usize) = ewr_extern_argument_type_match(arguments[0.usize()], parameter.type_name, caller_parameters, caller_local_names)
                return (matched.known, matched.matches, matched.specificity)

        def ewr_function_arguments_match(parameters: darray[Ast::ParamDecl], arguments: darray[Ast::Expr], argument_names: darray[sview @source], function_line: u32, function_offset: u32, function_module: sview, annotations: darray[Ast::EnumAnnotation]&, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, viable: bool, specificity: usize):
            can Abort.Panic:
                assigned: mutable darray[bool] = []
                for _ in 0..<parameters.count |assigned|:
                    assigned.push(false)
                positional_index: mutable usize = 0.usize()
                seen_named: mutable bool = false
                all_known: mutable bool = true
                first_argument_seen: mutable bool = false
                specificity: mutable usize = 0.usize()
                for argument_index in 0..<arguments.count |assigned, positional_index, seen_named, all_known, first_argument_seen, specificity, parameters, arguments, argument_names, function_line, function_offset, function_module, annotations, caller_parameters, caller_local_names|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    parameter_index: mutable i64 = -1
                    if argument_name == "":
                        return (true, false, 0.usize()) if seen_named
                        if positional_index < parameters.count:
                            parameter_index <- positional_index.i64()
                            positional_index <- positional_index + 1.usize()
                        else:
                            # Coarse arity admission runs before this receiver match.
                            # Defaulted and variadic candidates may legally reach Core's
                            # winner here even when the call has positional overflow.
                            continue
                    else:
                        seen_named <- true
                        for index in 0..<parameters.count |parameter_index, parameters, argument_name|:
                            parameter_index <- index.i64() if parameters[index].name == argument_name
                        return (true, false, 0.usize()) if parameter_index < 0
                    slot: usize = parameter_index.usize()
                    return (true, false, 0.usize()) if assigned[slot]
                    assigned[slot] <- true
                    if slot == 0.usize():
                        matched: (known: bool, matches: bool, specificity: usize) = ewr_argument_type_match(arguments[argument_index], parameters[slot].type_expression, function_line, function_offset, function_module, annotations, caller_parameters, caller_local_names)
                        return (true, false, 0.usize()) if matched.known and not matched.matches
                        all_known <- false if not matched.known
                        specificity <- matched.specificity
                        first_argument_seen <- true
                return (all_known and (first_argument_seen or parameters.count == 0), true, specificity)

        def ewr_declaration_call_match(declarations: darray[Ast::Decl], function_line: u32, function_offset: u32, function_module: sview, arguments: darray[Ast::Expr], argument_names: darray[sview @source], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, viable: bool, specificity: usize):
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(_, parameters, _, _, _, _, position):
                            return ewr_function_arguments_match(parameters, arguments, argument_names, position.line, position.offset, function_module, annotations, caller_parameters, caller_local_names) if position.line == function_line and position.offset == function_offset
                        Decl.Extern(_, param_start, arity, _, callable, _, _, position):
                            return ewr_extern_arguments_match(param_start, arity, extern_params, arguments, caller_parameters, caller_local_names) if callable and position.line == function_line and position.offset == function_offset
                        Decl.Module(_, module_body, _):
                            nested: (known: bool, viable: bool, specificity: usize) = ewr_declaration_call_match(module_body, function_line, function_offset, function_module, arguments, argument_names, extern_params, annotations, caller_parameters, caller_local_names)
                            return nested if nested.known or nested.viable
                        Decl.Scoped(scoped_body, _):
                            nested: (known: bool, viable: bool, specificity: usize) = ewr_declaration_call_match(scoped_body, function_line, function_offset, function_module, arguments, argument_names, extern_params, annotations, caller_parameters, caller_local_names)
                            return nested if nested.known or nested.viable
                        _:
                            pass
                return (false, false, 0.usize())

        # Mirror Core's final call-argument ordering/default-fill step after candidate
        # selection. This is separate from coarse receiver eligibility: an invalid raw
        # winner blocks fallback, but contributes no ErrorSet family.
        def ewr_function_call_arguments_resolvable(parameters: darray[Ast::ParamDecl], decorators: darray[Ast::Annotation], arguments: darray[Ast::Expr], argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> bool:
            can Abort.Panic:
                has_variadic: bool = any decorator in decorators where decorator.name == "c_variadic"
                has_named: bool = any argument_name in argument_names where argument_name != ""
                return false if has_variadic and (has_named or has_argument_forward)
                # Core returns positional overflow unchanged before default filling.
                return true if not has_named and not has_argument_forward and arguments.count > parameters.count
                assigned: mutable darray[bool] = []
                for _ in 0..<parameters.count |assigned|:
                    assigned.push(false)
                positional_index: mutable usize = 0.usize()
                seen_named: mutable bool = false
                for argument_index in 0..<arguments.count |assigned, positional_index, seen_named, arguments, argument_names, parameters, has_argument_forward|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    parameter_index: mutable i64 = -1
                    if argument_name == "":
                        return false if has_argument_forward or seen_named or positional_index >= parameters.count
                        parameter_index <- positional_index.i64()
                        positional_index <- positional_index + 1.usize()
                    else:
                        seen_named <- true
                        for index in 0..<parameters.count |parameter_index, parameters, argument_name|:
                            parameter_index <- index.i64() if parameters[index].name == argument_name
                        return false if parameter_index < 0
                    slot: usize = parameter_index.usize()
                    return false if assigned[slot]
                    assigned[slot] <- true
                for parameter_index in 0..<parameters.count |assigned, parameters, has_argument_forward, caller_parameters, caller_local_names|:
                    continue if assigned[parameter_index] or parameters[parameter_index].has_default
                    return false if not has_argument_forward
                    parameter_name: sview = parameters[parameter_index].name
                    forwarded: mutable bool = any caller_parameter in caller_parameters where caller_parameter.name == parameter_name
                    forwarded <- true if any local_name in caller_local_names where local_name == parameter_name
                    return false if not forwarded
                return true

        def ewr_extern_call_arguments_resolvable(arity: u32, arguments: darray[Ast::Expr], argument_names: darray[sview @source], has_argument_forward: bool) -> bool:
            can Abort.Panic:
                return false if has_argument_forward or any argument_name in argument_names where argument_name != ""
                return true if arguments.count > arity.usize()
                return arguments.count == arity.usize()

        def ewr_declaration_call_arguments_resolvable(declarations: darray[Ast::Decl], function_line: u32, function_offset: u32, arguments: darray[Ast::Expr], argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (found: bool, resolvable: bool):
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(_, parameters, _, _, _, decorators, position):
                            return (true, ewr_function_call_arguments_resolvable(parameters, decorators, arguments, argument_names, has_argument_forward, caller_parameters, caller_local_names)) if position.line == function_line and position.offset == function_offset
                        Decl.Extern(_, _, arity, _, callable, _, _, position):
                            return (true, callable and ewr_extern_call_arguments_resolvable(arity, arguments, argument_names, has_argument_forward)) if position.line == function_line and position.offset == function_offset
                        Decl.Module(_, module_body, _):
                            nested: (found: bool, resolvable: bool) = ewr_declaration_call_arguments_resolvable(module_body, function_line, function_offset, arguments, argument_names, has_argument_forward, caller_parameters, caller_local_names)
                            return nested if nested.found
                        Decl.Scoped(scoped_body, _):
                            nested: (found: bool, resolvable: bool) = ewr_declaration_call_arguments_resolvable(scoped_body, function_line, function_offset, arguments, argument_names, has_argument_forward, caller_parameters, caller_local_names)
                            return nested if nested.found
                        _:
                            pass
                return (false, false)

        # Find visible infallible overloads. Known primitive argument types can reject a
        # mismatched candidate; unresolved types keep the result conservative.
        def ewr_infallible_callable_scope(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, current_module: sview @source, caller_module: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, receiver_rank_active: bool, found: mutable bool&, unknown_found: mutable bool&, scope_length: mutable usize&, is_local: mutable bool&, specificity: mutable usize&, unknown_scope_length: mutable usize&, unknown_is_local: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |name, qualifier, current_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, annotations, table, receiver_rank_active, found, unknown_found, scope_length, is_local, specificity, unknown_scope_length, unknown_is_local|:
                    match declaration:
                        Decl.Func(function_name, parameters, _, _, _, decorators, line):
                            viable_arity: bool = ewr_function_accepts_arity(parameters, decorators, call_arity) if call_arity_known and receiver_rank_active else true
                            argument_resolution: bool = ewr_function_call_arguments_resolvable(parameters, decorators, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names) if call_arity_known and not receiver_rank_active else true
                            argument_match: (known: bool, viable: bool, specificity: usize) = ewr_function_arguments_match(parameters, call_arguments, call_argument_names, line.line, line.offset, current_module, annotations, caller_parameters, caller_local_names) if call_arity_known and receiver_rank_active else (false, true, 0.usize())
                            candidate_type_viable: bool = argument_match.viable if receiver_rank_active else true
                            if function_name == name and viable_arity and argument_resolution and candidate_type_viable and not ewr_declaration_has_error_return(annotations, function_name, line.line, line.offset):
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: mutable bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_visible <- false if candidate_visible and not ewr_callable_name_visible(annotations, name, current_module, caller_module, line.line, line.offset) and not receiver_rank_active
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                if candidate_visible:
                                    if not argument_match.known and (receiver_rank_active or not ewr_bool_value(unknown_found) or candidate_scope_length > unknown_scope_length or (candidate_scope_length == unknown_scope_length and candidate_is_local and not ewr_bool_value(unknown_is_local))):
                                        unknown_found <- true
                                        unknown_scope_length <- candidate_scope_length
                                        unknown_is_local <- candidate_is_local
                                    if argument_match.known and (not ewr_bool_value(found) or (receiver_rank_active and argument_match.specificity > specificity) or (not receiver_rank_active and (candidate_scope_length > scope_length or (candidate_scope_length == scope_length and candidate_is_local and not ewr_bool_value(is_local))))):
                                        found <- true
                                        scope_length <- candidate_scope_length
                                        is_local <- candidate_is_local
                                        specificity <- argument_match.specificity
                        Decl.Extern(extern_name, _, arity, variadic, callable, _, _, position):
                            viable_arity: mutable bool = true
                            if call_arity_known and receiver_rank_active:
                                viable_arity <- variadic or call_arity == arity.usize()
                            argument_resolution: bool = ewr_extern_call_arguments_resolvable(arity, call_arguments, call_argument_names, has_argument_forward) if call_arity_known and not receiver_rank_active else true
                            if callable and extern_name == name and viable_arity and argument_resolution and not ewr_declaration_has_error_return(annotations, extern_name, position.line, position.offset):
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: mutable bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_visible <- false if candidate_visible and not ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset) and not receiver_rank_active
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                if candidate_visible and (receiver_rank_active or not ewr_bool_value(unknown_found) or candidate_scope_length > unknown_scope_length or (candidate_scope_length == unknown_scope_length and candidate_is_local and not ewr_bool_value(unknown_is_local))):
                                    unknown_found <- true
                                    unknown_scope_length <- candidate_scope_length
                                    unknown_is_local <- candidate_is_local
                        Decl.Module(module_name, module_body, module_line):
                            nested_module: sview @source = module_name
                            ewr_infallible_callable_scope(module_body, name, qualifier, nested_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, annotations, table, receiver_rank_active, found, unknown_found, scope_length, is_local, specificity, unknown_scope_length, unknown_is_local)
                        Decl.Scoped(scoped_body, scoped_line):
                            ewr_infallible_callable_scope(scoped_body, name, qualifier, current_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, annotations, table, receiver_rank_active, found, unknown_found, scope_length, is_local, specificity, unknown_scope_length, unknown_is_local)
                        _:
                            pass

        def ewr_infallible_callable_shadows(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], receiver_rank_active: bool, selected_scope_length: usize, selected_is_local: bool, selected_specificity: usize, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> bool:
            can Abort.Panic, Memory.Allocate:
                found: mutable bool = false
                unknown_found: mutable bool = false
                scope_length: mutable usize = 0.usize()
                is_local: mutable bool = false
                specificity: mutable usize = 0.usize()
                unknown_scope_length: mutable usize = 0.usize()
                unknown_is_local: mutable bool = false
                ewr_infallible_callable_scope(declarations, name, qualifier, "", caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, annotations, table, receiver_rank_active, found, unknown_found, scope_length, is_local, specificity, unknown_scope_length, unknown_is_local)
                if receiver_rank_active:
                    return true if unknown_found
                    return false if not found
                    return specificity >= selected_specificity
                if unknown_found:
                    return true if unknown_scope_length > selected_scope_length
                    return true if unknown_scope_length == selected_scope_length and unknown_is_local != selected_is_local and unknown_is_local
                    return true if unknown_scope_length == selected_scope_length and unknown_is_local == selected_is_local
                return false if not found
                return true if scope_length > selected_scope_length
                return is_local if scope_length == selected_scope_length and is_local != selected_is_local
                return true if scope_length == selected_scope_length and is_local == selected_is_local
                return false

        # The declaration position identifies the function; occurrence_offset identifies the
        # specific `error[...]` clause in its signature (callback parameters can have their own).
        def ewr_family_path_for_occurrence(annotations: darray[Ast::EnumAnnotation]&, family_index: usize, family: sview, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, occurrence_offset: u32) -> sview @source:
            can Abort.Panic:
                return "" if family_index >= annotations.count or family_index + 1.usize() >= annotations.count
                family_row: Ast::EnumAnnotation = annotations[family_index]
                return "" if family_row.owner != "__error_set_family" or family_row.name != family or family_row.line != declaration_line or family_row.offset != declaration_offset or family_row.identity_id != declaration_identity_id or family_row.occurrence_offset != occurrence_offset
                path_row: Ast::EnumAnnotation = annotations[family_index + 1.usize()]
                return path_row.name if path_row.owner == "__error_set_family_path" and path_row.line == family_row.line and path_row.offset == family_row.offset and path_row.identity_id == family_row.identity_id and path_row.occurrence_offset == family_row.occurrence_offset
                return ""

        # A missing or malformed source path must not fall back to a same-leaf family in
        # the caller's module. Bare paths resolve locally; qualified paths must resolve
        # through the declaration's explicit module or alias.
        def ewr_family_path_resolves(path: sview @source, family: sview @source, declaration_line: u32, declaration_offset: u32, declaration_identity_id: u32, declaration_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if path == ""
                return catch_module_path_matches(path, family) if catch_first_module_separator_start(path) == path.len
                resolved: (found: bool, uncertain: bool, module: sview @source) = catch_explicit_error_family_module(path, declaration_line, declaration_offset, declaration_identity_id, declaration_module, family, annotations, table)
                return resolved.found

        def ewr_return_occurrence(annotations: darray[Ast::EnumAnnotation]&, function_line: u32, function_offset: u32) -> (found: bool, ambiguous: bool, occurrence_offset: u32, identity_id: u32):
            can Abort.Panic:
                found: mutable bool = false
                ambiguous: mutable bool = false
                occurrence_offset: mutable u32 = 0
                identity_id: mutable u32 = 0
                for marker in annotations |found, ambiguous, occurrence_offset, identity_id, function_line, function_offset|:
                    continue if marker.name != "__error_return" or marker.line != function_line or marker.offset != function_offset
                    ambiguous <- true if found
                    occurrence_offset <- marker.occurrence_offset if not found
                    identity_id <- marker.identity_id if not found
                    found <- true
                return (found and not ambiguous, ambiguous, occurrence_offset, identity_id)

        def ewr_single_captured_family_row(annotations: darray[Ast::EnumAnnotation]&, callable_family: Ast::EnumAnnotation, function_module_known: bool, function_module: sview @source, table: mutable SymbolTable&) -> (found: bool, ambiguous: bool, row_index: usize):
            can Abort.Panic:
                found: mutable bool = false
                ambiguous: mutable bool = false
                row_index: mutable usize = 0.usize()
                selected_family: mutable sview @source = ""
                selected_module: mutable sview @source = ""
                for candidate_index in 0..<annotations.count |found, ambiguous, row_index, selected_family, selected_module, annotations, callable_family, function_module_known, function_module, table|:
                    candidate: Ast::EnumAnnotation = annotations[candidate_index]
                    continue if candidate.owner != "__error_set_family" or candidate.line != callable_family.line or candidate.offset != callable_family.offset or candidate.identity_id != callable_family.identity_id or candidate.occurrence_offset != callable_family.occurrence_offset
                    candidate_path: mutable sview @source = ""
                    if candidate_index + 1.usize() < annotations.count:
                        path_row: Ast::EnumAnnotation = annotations[candidate_index + 1.usize()]
                        candidate_path <- path_row.name if path_row.owner == "__error_set_family_path" and path_row.line == candidate.line and path_row.offset == candidate.offset and path_row.identity_id == candidate.identity_id and path_row.occurrence_offset == candidate.occurrence_offset
                    candidate_ref: mutable TryErrorFamilyRef = TryErrorFamilyRef{family: "", module: "", module_known: false, family_path: "", source_name: "", variant_override: "", declaration_line: 0, declaration_offset: FALLIBLE_FUNCTION_NO_OFFSET, declaration_identity_id: 0, occurrence_offset: 0}
                    if candidate.name == callable_family.name and candidate_path != "":
                        candidate_ref <- try_error_family_ref_for_annotation(annotations, candidate, candidate_path, function_module_known, function_module, table)
                    if candidate_ref.family != "" and candidate_ref.module_known:
                        ambiguous <- true if found and (selected_family != candidate_ref.family or selected_module != candidate_ref.module)
                        if not found:
                            row_index <- candidate_index
                            selected_family <- candidate_ref.family
                            selected_module <- candidate_ref.module
                            found <- true
                    else:
                        ambiguous <- true
                return (found and not ambiguous, ambiguous, row_index)

        # Resolve a callable in the wrapper call's module and lexical parents. A name-only lookup
        # can otherwise borrow a same-named declaration (and its errorset parameter) from a sibling
        # module. Unknown caller scope declines this narrow diagnostic rather than guessing.
        def ewr_callable_family(all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, name: sview @source, qualifier: sview @source, caller_module: sview @source, caller_module_known: bool, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> EwrFamilyRef:
            can Memory.Allocate, Abort.Panic:
                return ewr_empty_family_ref() if not caller_module_known
                return ewr_empty_family_ref() if ewr_unknown_static_import_affects_call(annotations, all_declarations, name, qualifier, caller_module, table)
                parameter_name_shadow: bool = any parameter in caller_parameters where parameter.name == name
                local_name_shadow: bool = any local_name in caller_local_names where local_name == name
                return ewr_empty_family_ref() if qualifier == "" and (parameter_name_shadow or local_name_shadow)
                receiver_rank_gate: bool = ewr_receiver_rank_gate(all_declarations, name, qualifier, caller_module, call_arity_known, call_arguments, call_argument_names, has_argument_forward, annotations, table)
                return ewr_empty_family_ref() if qualifier == "" and not receiver_rank_gate and ewr_wildcard_callable_name_is_ambiguous(all_declarations, name, caller_module, annotations, table)
                if receiver_rank_gate:
                    receiver_type: (known: bool, kind: u8, name: sview) = ewr_actual_primitive_type(call_arguments[0.usize()], caller_parameters, caller_local_names)
                    return ewr_empty_family_ref() if not receiver_type.known
                receiver_rank_active: bool = receiver_rank_gate
                selected: mutable EwrFamilyRef = ewr_empty_family_ref()
                selected_scope_length: mutable usize = 0
                selected_scope_known: mutable bool = false
                selected_is_local: mutable bool = false
                selected_specificity: mutable usize = 0.usize()
                selected_match_known: mutable bool = false
                ambiguous: mutable bool = false
                uncertain: mutable bool = false
                inaccessible_rank_found: mutable bool = false
                inaccessible_rank_unknown: mutable bool = false
                inaccessible_specificity: mutable usize = 0.usize()
                row: mutable u32 = callable_error_index_head(error_index, name)
                while row != CALLABLE_ERROR_ROW_NONE |row, annotations, module_annotations, module_index, error_index, table, all_declarations, extern_params, name, qualifier, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, receiver_rank_active, selected, selected_scope_length, selected_is_local, selected_specificity, selected_match_known, ambiguous, uncertain, inaccessible_rank_found, inaccessible_rank_unknown, inaccessible_specificity|:
                    source_row: usize = error_index.source_rows[row.usize()]
                    annotation: Ast::EnumAnnotation = annotations[source_row]
                    declaration_arity: (found: bool, accepts: bool) = ewr_declaration_accepts_arity(all_declarations, annotation.line, annotation.offset, call_arity) if call_arity_known and receiver_rank_active else (true, true)
                    candidate_arity_viable: bool = not declaration_arity.found or declaration_arity.accepts
                    if annotation.owner == name and callable_error_family_row(annotations, source_row) and candidate_arity_viable:
                        candidate_module_known: bool = fallible_fn_module_known(module_annotations, annotation.offset, annotation.line)
                        candidate_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, annotation.offset, annotation.line)
                        candidate_match: (known: bool, viable: bool, specificity: usize) = ewr_declaration_call_match(all_declarations, annotation.line, annotation.offset, candidate_module, call_arguments, call_argument_names, extern_params, annotations, caller_parameters, caller_local_names) if call_arity_known and receiver_rank_active else (false, true, 0.usize())
                        # Core's direct-name path keeps the bound return type after argument
                        # diagnostics. Only its receiver-rank rewrite selects by this type.
                        candidate_type_viable: bool = candidate_match.viable if receiver_rank_active else true
                        candidate_is_local: bool = candidate_module_known and ewr_module_is_lexical_ancestor(candidate_module, caller_module) if qualifier == "" else false
                        imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(annotations, name, candidate_module, caller_module) if qualifier == "" and candidate_module_known and not candidate_is_local else (false, 0.usize())
                        candidate_visible: mutable bool = ewr_qualified_module_matches(candidate_module, qualifier, caller_module, annotations, table) if qualifier != "" and candidate_module_known else candidate_is_local or imported_scope.visible
                        candidate_in_rank_set: bool = candidate_visible
                        candidate_accessible: bool = ewr_callable_name_visible(annotations, name, candidate_module, caller_module, annotation.line, annotation.offset) if candidate_in_rank_set else false
                        inaccessible_candidate: bool = candidate_in_rank_set and not candidate_accessible
                        if receiver_rank_active and inaccessible_candidate and candidate_type_viable:
                            if not candidate_match.known:
                                inaccessible_rank_unknown <- true
                            elif not inaccessible_rank_found or candidate_match.specificity > inaccessible_specificity:
                                inaccessible_rank_found <- true
                                inaccessible_specificity <- candidate_match.specificity
                        candidate_visible <- false if inaccessible_candidate
                        candidate_scope_length: mutable usize = imported_scope.scope_length
                        candidate_scope_length <- ewr_qualified_module_rank(candidate_module, qualifier, caller_module, annotations, table) if qualifier != ""
                        candidate_scope_length <- ewr_local_scope_rank(candidate_module, caller_module) if qualifier == "" and candidate_is_local
                        if candidate_visible and candidate_type_viable:
                            captured_family: (found: bool, ambiguous: bool, row_index: usize) = ewr_single_captured_family_row(annotations, annotation, candidate_module_known, candidate_module, table)
                            family_path: sview @source = ewr_family_path_for_occurrence(annotations, captured_family.row_index, annotation.name, annotation.line, annotation.offset, annotation.identity_id, annotation.occurrence_offset) if captured_family.found and not captured_family.ambiguous else ""
                            path_resolves: bool = ewr_family_path_resolves(family_path, annotation.name, annotation.line, annotation.offset, annotation.identity_id, candidate_module, annotations, table) if captured_family.found and not captured_family.ambiguous else false
                            if captured_family.found and not captured_family.ambiguous and path_resolves:
                                captured_row: Ast::EnumAnnotation = annotations[captured_family.row_index]
                                family: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, captured_row, family_path, candidate_module_known, candidate_module, table)
                                candidate: EwrFamilyRef = EwrFamilyRef{family: family.family, family_path: family_path, source_name: family.source_name, variant_override: family.variant_override, module: family.module, module_known: family.module_known, family_row_index: captured_family.row_index, has_family_row: true, function_name: annotation.owner, function_module: candidate_module, function_module_known: candidate_module_known, declaration_line: captured_row.line, declaration_offset: captured_row.offset, declaration_identity_id: captured_row.identity_id, occurrence_offset: captured_row.occurrence_offset}
                                if receiver_rank_active:
                                    if not candidate_match.known:
                                        ambiguous <- true
                                        uncertain <- true
                                    elif not selected_scope_known:
                                        selected <- candidate
                                        selected_scope_length <- candidate_scope_length
                                        selected_scope_known <- true
                                        selected_is_local <- candidate_is_local
                                        selected_specificity <- candidate_match.specificity
                                        selected_match_known <- true
                                        ambiguous <- false if not uncertain
                                    elif candidate_match.specificity > selected_specificity:
                                        selected <- candidate
                                        selected_scope_length <- candidate_scope_length
                                        selected_is_local <- candidate_is_local
                                        selected_specificity <- candidate_match.specificity
                                        selected_match_known <- true
                                        ambiguous <- false if not uncertain
                                    elif candidate_match.specificity == selected_specificity:
                                        ambiguous <- true if not ewr_family_refs_match(selected, candidate)
                                elif not selected_scope_known or candidate_scope_length > selected_scope_length or (candidate_scope_length == selected_scope_length and candidate_is_local and not selected_is_local):
                                    selected <- candidate
                                    selected_scope_length <- candidate_scope_length
                                    selected_scope_known <- true
                                    selected_is_local <- candidate_is_local
                                    selected_specificity <- candidate_match.specificity
                                    selected_match_known <- candidate_match.known
                                    ambiguous <- false
                                    uncertain <- not candidate_match.known
                                elif candidate_scope_length == selected_scope_length and candidate_is_local == selected_is_local:
                                    # With the receiver-rank rewrite disabled, same-scope
                                    # overloads do not get selected by argument-zero
                                    # specificity. Keep a family only when every same-scope
                                    # declaration names that same family.
                                    ambiguous <- true if not ewr_family_refs_match(selected, candidate)
                            elif receiver_rank_active:
                                if not candidate_match.known:
                                    ambiguous <- true
                                    uncertain <- true
                                elif not selected_scope_known or not selected_match_known or candidate_match.specificity > selected_specificity:
                                    selected <- ewr_empty_family_ref()
                                    selected_scope_length <- candidate_scope_length
                                    selected_scope_known <- true
                                    selected_is_local <- candidate_is_local
                                    selected_specificity <- candidate_match.specificity
                                    selected_match_known <- true
                                    ambiguous <- true
                                    uncertain <- true
                                elif candidate_match.specificity == selected_specificity:
                                    ambiguous <- true
                            elif not selected_scope_known or candidate_scope_length > selected_scope_length or (candidate_scope_length == selected_scope_length and candidate_is_local and not selected_is_local):
                                selected <- ewr_empty_family_ref()
                                selected_scope_length <- candidate_scope_length
                                selected_scope_known <- true
                                selected_is_local <- candidate_is_local
                                selected_specificity <- candidate_match.specificity
                                selected_match_known <- candidate_match.known
                                ambiguous <- true
                                uncertain <- true
                            elif candidate_scope_length == selected_scope_length and candidate_is_local == selected_is_local:
                                ambiguous <- true
                                uncertain <- true
                    row <- error_index.next[row.usize()]
                return ewr_empty_family_ref() if ambiguous
                return ewr_empty_family_ref() if receiver_rank_active and inaccessible_rank_unknown
                return ewr_empty_family_ref() if receiver_rank_active and inaccessible_rank_found and selected.family != "" and inaccessible_specificity >= selected_specificity
                # An identifier used as a function value has no call arity here. Ordinary
                # name lookup already filtered inaccessible candidates, so a hidden overload
                # must not outrank the visible selected binding through the call-only barrier.
                if not receiver_rank_active and call_arity_known and selected.family != "":
                    inaccessible_binding: EwrCallableBinding = ewr_first_inaccessible_callable_binding(all_declarations, name, qualifier, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table)
                    inaccessible_may_win: mutable bool = inaccessible_binding.scope_length > selected_scope_length
                    inaccessible_may_win <- inaccessible_binding.match_known and selected_match_known and inaccessible_binding.specificity >= selected_specificity if inaccessible_binding.scope_length == selected_scope_length
                    inaccessible_may_win <- true if inaccessible_binding.scope_length == selected_scope_length and (not inaccessible_binding.match_known or not selected_match_known)
                    return ewr_empty_family_ref() if inaccessible_binding.found and inaccessible_may_win
                    name_binding: EwrCallableBinding = ewr_first_visible_callable_binding(all_declarations, name, qualifier, caller_module, annotations, table)
                    return ewr_empty_family_ref() if not name_binding.found
                    return ewr_empty_family_ref() if selected_scope_length != name_binding.scope_length
                if selected.family != "":
                    return ewr_empty_family_ref() if ewr_infallible_callable_shadows(all_declarations, name, qualifier, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, receiver_rank_active, selected_scope_length, selected_is_local, selected_specificity, annotations, table)
                    if call_arity_known:
                        call_resolution: (found: bool, resolvable: bool) = ewr_declaration_call_arguments_resolvable(all_declarations, selected.declaration_line, selected.declaration_offset, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names)
                        return ewr_empty_family_ref() if not call_resolution.found or not call_resolution.resolvable
                    return selected
                if call_arity_known:
                    infallible_found: mutable bool = false
                    infallible_unknown_found: mutable bool = false
                    infallible_scope_length: mutable usize = 0.usize()
                    infallible_is_local: mutable bool = false
                    infallible_specificity: mutable usize = 0.usize()
                    infallible_unknown_scope_length: mutable usize = 0.usize()
                    infallible_unknown_is_local: mutable bool = false
                    ewr_infallible_callable_scope(all_declarations, name, qualifier, "", caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names, annotations, table, receiver_rank_active, infallible_found, infallible_unknown_found, infallible_scope_length, infallible_is_local, infallible_specificity, infallible_unknown_scope_length, infallible_unknown_is_local)
                    unknown_blocks_known: bool = infallible_unknown_found and (receiver_rank_active or infallible_unknown_scope_length > infallible_scope_length or (infallible_unknown_scope_length == infallible_scope_length and (infallible_unknown_is_local == infallible_is_local or infallible_unknown_is_local)))
                    if infallible_found and not unknown_blocks_known:
                        return EwrFamilyRef{family: "", family_path: "", source_name: "", variant_override: "", module: "", module_known: false, family_row_index: 0.usize(), has_family_row: false, function_name: name, function_module: "", function_module_known: true, declaration_line: 0, declaration_offset: 0, declaration_identity_id: 0, occurrence_offset: 0}
                return selected

        def ewr_family_refs_match(left: EwrFamilyRef, right: EwrFamilyRef) -> bool:
            return false if left.family == "" or right.family == "" or left.family != right.family
            return false if left.variant_override != right.variant_override
            return false if left.module_known and right.module_known and left.module != right.module
            return false if left.function_name != right.function_name or left.function_module_known != right.function_module_known
            return false if left.function_module_known and left.function_module != right.function_module
            return left.declaration_line == right.declaration_line and left.declaration_offset == right.declaration_offset and left.declaration_identity_id == right.declaration_identity_id and left.occurrence_offset == right.occurrence_offset

        # The generic parameter row is keyed to the exact declaration, so overloads and
        # multiple functions on one line cannot lend each other an errorset parameter.
        def ewr_errorset_parameter(errorset_rows: darray[Ast::EnumAnnotation]&, function_line: u32, function_offset: u32, identity_id: u32) -> (ambiguous: bool, found: bool, name: sview @source):
            can Abort.Panic:
                count: mutable usize = 0
                name: mutable sview @source = ""
                for row in errorset_rows |count, name, function_line, function_offset, identity_id|:
                    if row.owner == "__errorset_param" and row.line == function_line and row.offset == function_offset and row.identity_id == identity_id:
                        count <- count + 1.usize()
                        name <- row.name
                return (count > 1.usize(), count == 1.usize(), name)

        # G returns `error[R]` where R is G's OWN errorset parameter — i.e. a polymorphic wrapper.
        def ewr_poly_wrapper(all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, name: sview @source, qualifier: sview @source, caller_module: sview @source, caller_module_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (is_poly: bool, family: EwrFamilyRef, errorset_name: sview @source):
            can Memory.Allocate, Abort.Panic:
                family: EwrFamilyRef = ewr_callable_family(all_declarations, extern_params, annotations, module_annotations, module_index, error_index, table, name, qualifier, caller_module, caller_module_known, true, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names)
                return (false, ewr_empty_family_ref(), "") if family.family == ""
                parameter: (ambiguous: bool, found: bool, name: sview @source) = ewr_errorset_parameter(errorset_rows, family.declaration_line, family.declaration_offset, family.declaration_identity_id)
                return (false, ewr_empty_family_ref(), "") if parameter.ambiguous or not parameter.found or family.family != parameter.name
                return (true, family, parameter.name)

        # The CONCRETE error family of a function reference (a real enum, not an errorset parameter).
        def ewr_concrete_family(all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, name: sview @source, qualifier: sview @source, caller_module: sview @source, caller_module_known: bool) -> EwrFamilyRef:
            can Memory.Allocate, Abort.Panic:
                family: EwrFamilyRef = ewr_callable_family(all_declarations, extern_params, annotations, module_annotations, module_index, error_index, table, name, qualifier, caller_module, caller_module_known, false, 0.usize(), [], [], false, [], [])
                return ewr_empty_family_ref() if family.family == "" or not family.module_known
                parameter: (ambiguous: bool, found: bool, name: sview @source) = ewr_errorset_parameter(errorset_rows, family.declaration_line, family.declaration_offset, family.declaration_identity_id)
                return ewr_empty_family_ref() if parameter.ambiguous or (parameter.found and family.family == parameter.name)
                return family

        def ewr_function_identity_matches(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef) -> bool:
            can Abort.Panic:
                matches: mutable usize = 0.usize()
                for row in annotations |matches, family|:
                    if row.owner == family.function_name and row.name == "__error_return" and row.line == family.declaration_line and row.offset == family.declaration_offset and row.identity_id == family.declaration_identity_id and row.occurrence_offset == family.occurrence_offset:
                        matches <- matches + 1.usize()
                return matches == 1.usize()

        def ewr_find_function_parameters(declarations: darray[Ast::Decl], family: EwrFamilyRef, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> (matches: usize, parameters: darray[Ast::ParamDecl]):
            can Memory.Allocate, Abort.Panic:
                matches: mutable usize = 0.usize()
                result_parameters: mutable darray[Ast::ParamDecl] = []
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, candidate_parameters, return_type, body, effects, decorators, line):
                            declaration_module_matches: bool = family.function_module_known and current_module == family.function_module
                            declaration_identity_matches: bool = ewr_function_identity_matches(annotations, family)
                            if declaration_module_matches and function_name == family.function_name and line.line == family.declaration_line and line.offset == family.declaration_offset and declaration_identity_matches:
                                result_parameters <- candidate_parameters if matches == 0.usize()
                                matches <- matches + 1.usize()
                        Decl.Module(module_name, module_body, module_line):
                            nested_module: sview @source = module_name
                            nested: (matches: usize, parameters: darray[Ast::ParamDecl]) = ewr_find_function_parameters(module_body, family, nested_module, annotations, table)
                            result_parameters <- nested.parameters if matches == 0.usize() and nested.matches > 0.usize()
                            matches <- matches + nested.matches
                        Decl.Scoped(scoped_body, scoped_line):
                            nested: (matches: usize, parameters: darray[Ast::ParamDecl]) = ewr_find_function_parameters(scoped_body, family, current_module, annotations, table)
                            result_parameters <- nested.parameters if matches == 0.usize() and nested.matches > 0.usize()
                            matches <- matches + nested.matches
                        _:
                            pass
                return (matches, result_parameters)

        # Only formals whose own type contains this wrapper's R participate in binding.
        # Annotation occurrence offsets place nested callback errorsets between their
        # parameter name and the next formal (or the enclosing return type).
        def ewr_parameter_carries_errorset(parameters: darray[Ast::ParamDecl], parameter_index: usize, family: EwrFamilyRef, errorset_name: sview, return_occurrence_offset: u32, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                return false if parameter_index >= parameters.count
                parameter_start: u32 = parameters[parameter_index].name_pos.offset
                return false if parameter_start == 0
                parameter_end: mutable u32 = return_occurrence_offset
                if parameter_index + 1.usize() < parameters.count:
                    next_start: u32 = parameters[parameter_index + 1.usize()].name_pos.offset
                    return false if next_start == 0
                    parameter_end <- next_start
                return false if parameter_end <= parameter_start
                for row in annotations |parameter_start, parameter_end, family, errorset_name|:
                    if row.owner == "__error_set_family" and row.name == errorset_name and row.line == family.declaration_line and row.offset == family.declaration_offset and row.identity_id == family.declaration_identity_id and row.occurrence_offset >= parameter_start and row.occurrence_offset < parameter_end:
                        return true
                return false

        # Bind call arguments to formal positions using the same positional/named rules as
        # semantic call checking. Invalid or ambiguous calls decline this diagnostic.
        def ewr_argument_for_parameter(arguments: darray[Ast::Expr], argument_names: darray[sview @source], parameters: darray[Ast::ParamDecl], target_parameter: usize) -> (argument: Ast::Expr?, from_default: bool):
            can Abort.Panic:
                return (null, false) if target_parameter >= parameters.count
                assigned: mutable darray[bool] = []
                for _ in 0..<parameters.count |assigned|:
                    assigned.push(false)
                positional_index: mutable usize = 0.usize()
                seen_named: mutable bool = false
                found: mutable bool = false
                selected: mutable Ast::Expr? = null
                for argument_index in 0..<arguments.count |assigned, positional_index, seen_named, found, selected, parameters, argument_names, target_parameter|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    parameter_index: mutable i64 = -1
                    if argument_name == "":
                        return (null, false) if seen_named
                        if positional_index < parameters.count:
                            parameter_index <- positional_index.i64()
                            positional_index <- positional_index + 1.usize()
                    else:
                        seen_named <- true
                        for index in 0..<parameters.count |parameter_index, parameters, argument_name|:
                            parameter_index <- index.i64() if parameters[index].name == argument_name
                        return (null, false) if parameter_index < 0
                    if parameter_index >= 0:
                        slot: usize = parameter_index.usize()
                        return (null, false) if assigned[slot]
                        assigned[slot] <- true
                        if slot == target_parameter:
                            found <- true
                            selected <- arguments[argument_index]
                if not found and parameters[target_parameter].has_default:
                    return (parameters[target_parameter].default_value, true)
                return (selected, false)

        def ewr_span_contains(span: sview, needle: sview) -> bool:
            can Abort.Panic:
                return false if needle.len == 0 or span.len < needle.len
                last_start: usize = span.len - needle.len
                start: mutable usize = 0.usize()
                while start <= last_start |start, span, needle, last_start|:
                    matched: mutable bool = true
                    offset: mutable usize = 0.usize()
                    while offset < needle.len |offset, matched, span, needle, start|:
                        matched <- false if span[start + offset] != needle[offset]
                        offset <- offset + 1.usize()
                    return true if matched
                    start <- start + 1.usize()
                return false

        # A unique top-level declaration with no fallible metadata is known to contribute the
        # empty errorset. Restrict this fallback to unqualified top-level calls; module imports,
        # sibling scopes, and overloaded names remain unknown rather than being guessed.
        # Externs require complete return spelling so a fallible external signature is never
        # silently treated as an empty errorset.
        def ewr_extern_return_is_known_infallible(annotations: darray[Ast::EnumAnnotation]&, extern_name: sview, extern_line: u32, extern_offset: u32, return_type_name: sview) -> bool:
            can Abort.Panic:
                if return_type_name == "":
                    for row in annotations:
                        return false if row.line == extern_line and row.offset == extern_offset and (row.owner == "__extern_return" or row.owner == "__extern_return_text" or row.name == "__extern_return_text_complete")
                    return true
                complete_count: mutable usize = 0.usize()
                text_count: mutable usize = 0.usize()
                extern_return_count: mutable usize = 0.usize()
                return_text: mutable sview @source = ""
                for row in annotations |complete_count, text_count, extern_return_count, return_text, extern_name, extern_line, extern_offset|:
                    complete_count <- complete_count + 1.usize() if row.owner == extern_name and row.name == "__extern_return_text_complete" and row.line == extern_line and row.offset == extern_offset
                    if row.owner == "__extern_return_text" and row.line == extern_line and row.offset == extern_offset:
                        text_count <- text_count + 1.usize()
                        return_text <- row.name
                    extern_return_count <- extern_return_count + 1.usize() if row.owner == "__extern_return" and row.line == extern_line and row.offset == extern_offset
                return complete_count == 1.usize() and text_count == 1.usize() and extern_return_count == 1.usize() and not ewr_span_contains(return_text, "error")

        def ewr_unique_top_level_callable(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, name: sview, qualifier: sview @source, caller_module: sview) -> bool:
            can Abort.Panic:
                return false if caller_module != "" or qualifier != ""
                count: mutable usize = 0
                extern_line: mutable u32 = 0
                extern_offset: mutable u32 = 0
                is_extern: mutable bool = false
                extern_return_type_name: mutable sview @source = ""
                for declaration in declarations |count, extern_line, extern_offset, is_extern, extern_return_type_name, name|:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            count <- count + 1.usize() if function_name == name
                        Decl.Extern(extern_name, _, _, _, callable, return_type_name, _, position):
                            if callable and extern_name == name:
                                count <- count + 1.usize()
                                extern_line <- position.line
                                extern_offset <- position.offset
                                is_extern <- true
                                extern_return_type_name <- return_type_name
                        _:
                            pass
                return false if count != 1.usize()
                return ewr_extern_return_is_known_infallible(annotations, name, extern_line, extern_offset, extern_return_type_name) if is_extern
                return true

        def ewr_append_module_path(expression: Ast::Expr, bytes: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Scope(base, name, _):
                        return false if not ewr_append_module_path(base, bytes)
                        bytes.push(58)
                        bytes.push(58)
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Paren(inner, _):
                        return ewr_append_module_path(inner, bytes)
                    _:
                        return false

        def ewr_callable_parts(expression: Ast::Expr, table: mutable SymbolTable&) -> (known: bool, qualifier: sview @source, name: sview @source):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return (true, "", name)
                    Expr.Scope(base, name, _):
                        path_bytes: mutable darray[u8] = []
                        return (false, "", "") if not ewr_append_module_path(base, path_bytes)
                        qualifier: sview @source = intern_joined_text(path_bytes, table)
                        return (qualifier != "", qualifier, name)
                    Expr.Paren(inner, _):
                        return ewr_callable_parts(inner, table)
                    _:
                        return (false, "", "")

        def ewr_concrete_family_of_expression(expression: Ast::Expr, all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, caller_module: sview @source, caller_module_known: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview]) -> (known: bool, family: EwrFamilyRef):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return ewr_callable_concrete_family(name, "", false, 0.usize(), [], [], false, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known)
                    Expr.Scope(base, name, _):
                        callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(expression, table)
                        return ewr_callable_concrete_family(callable.name, callable.qualifier, false, 0.usize(), [], [], false, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known) if callable.known
                        return (false, ewr_empty_family_ref())
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(callee, table)
                        has_argument_forward: bool = ewr_call_has_argument_forward(annotations, call_line.line, call_line.offset)
                        return ewr_callable_concrete_family(callable.name, callable.qualifier, true, arguments.count, arguments, argument_names, has_argument_forward, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known) if callable.known
                        return (false, ewr_empty_family_ref())
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        return ewr_concrete_family_of_expression(inner, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known, caller_parameters, caller_local_names)
                    _:
                        return (false, ewr_empty_family_ref())

        def ewr_callable_concrete_family(name: sview @source, qualifier: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], has_argument_forward: bool, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, caller_module: sview @source, caller_module_known: bool) -> (known: bool, family: EwrFamilyRef):
            can Memory.Allocate, Abort.Panic:
                resolved: EwrFamilyRef = ewr_callable_family(all_declarations, extern_params, annotations, module_annotations, module_index, error_index, table, name, qualifier, caller_module, caller_module_known, call_arity_known, call_arity, call_arguments, call_argument_names, has_argument_forward, caller_parameters, caller_local_names)
                if resolved.family != "":
                    return (false, ewr_empty_family_ref()) if not resolved.module_known
                    parameter: (ambiguous: bool, found: bool, name: sview @source) = ewr_errorset_parameter(errorset_rows, resolved.declaration_line, resolved.declaration_offset, resolved.declaration_identity_id)
                    return (false, ewr_empty_family_ref()) if parameter.ambiguous or (parameter.found and resolved.family == parameter.name)
                    return (true, resolved)
                return (true, ewr_empty_family_ref()) if resolved.function_name == name
                if ewr_unique_top_level_callable(all_declarations, annotations, name, qualifier, caller_module):
                    return (true, ewr_empty_family_ref())
                return (false, ewr_empty_family_ref())

        # A parameter can shadow a global callable with the same spelling. Until local
        # binding resolution is available here, decline that identifier instead of borrowing
        # the global function's family.
        def ewr_expression_is_shadowed_by_parameter(expression: Ast::Expr, caller_parameters: darray[Ast::ParamDecl]) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return any parameter in caller_parameters where parameter.name == name
                    Expr.Call(callee, _, _, _):
                        return ewr_expression_is_shadowed_by_parameter(callee, caller_parameters)
                    Expr.Scope(base, _, _) | Expr.Field(base, _, _):
                        return ewr_expression_is_shadowed_by_parameter(base, caller_parameters)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ewr_expression_is_shadowed_by_parameter(inner, caller_parameters)
                    _:
                        return false

        def ewr_expression_name_is_local(expression: Ast::Expr, local_names: darray[sview]) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return any local_name in local_names where local_name == name
                    Expr.Call(callee, _, _, _):
                        return ewr_expression_name_is_local(callee, local_names)
                    Expr.Scope(base, _, _) | Expr.Field(base, _, _):
                        return ewr_expression_name_is_local(base, local_names)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return ewr_expression_name_is_local(inner, local_names)
                    _:
                        return false

        def ewr_collect_target_names(expression: Ast::Expr, names: mutable darray[sview]&) -> void:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        names.push(name)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _):
                        for element in elements |names|:
                            ewr_collect_target_names(element, names)
                    Expr.Paren(inner, _):
                        ewr_collect_target_names(inner, names)
                    _:
                        pass

        def ewr_collect_local_names(statements: darray[Ast::Stmt], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names|:
                    match statement:
                        Stmt.VarDecl(name, _, _, _):
                            names.push(name)
                        Stmt.Assign(target, operator, _, _):
                            ewr_collect_target_names(target, names) if operator == TokenKind.Assign
                        Stmt.If(_, then_body, else_body, _):
                            ewr_collect_local_names(then_body, names)
                            ewr_collect_local_names(else_body, names)
                        Stmt.Block(_, _, binding, body, _):
                            names.push(binding) if binding != ""
                            ewr_collect_local_names(body, names)
                        Stmt.While(_, body, _):
                            ewr_collect_local_names(body, names)
                        Stmt.For(_, variables, _, body, _):
                            for variable in variables |names|:
                                names.push(variable)
                            ewr_collect_local_names(body, names)
                        Stmt.Match(_, arms, _):
                            for arm in arms |names|:
                                collect_pattern_binding_names(arm.pattern, names)
                                ewr_collect_local_names(arm.body, names)
                        _:
                            pass

        # Resolve only actual arguments bound to formals that carry R. Other callback or
        # value parameters cannot accidentally supply R or make a valid binding ambiguous.
        def ewr_arg_family(arguments: darray[Ast::Expr], argument_names: darray[sview @source], parameters: darray[Ast::ParamDecl], caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], wrapper: EwrFamilyRef, errorset_name: sview, return_occurrence_offset: u32, all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: mutable SymbolTable&, caller_module: sview @source, caller_module_known: bool) -> (known: bool, families: darray[EwrFamilyRef]):
            can Memory.Allocate, Abort.Panic:
                families: mutable darray[EwrFamilyRef] = []
                saw_errorset_parameter: mutable bool = false
                for parameter_index in 0..<parameters.count |families, saw_errorset_parameter, arguments, argument_names, parameters, caller_parameters, caller_local_names, wrapper, errorset_name, return_occurrence_offset, all_declarations, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known|:
                    continue if not ewr_parameter_carries_errorset(parameters, parameter_index, wrapper, errorset_name, return_occurrence_offset, annotations)
                    saw_errorset_parameter <- true
                    actual_argument: (argument: Ast::Expr?, from_default: bool) = ewr_argument_for_parameter(arguments, argument_names, parameters, parameter_index)
                    if actual_argument.argument is argument:
                        return (false, []) if not actual_argument.from_default and ewr_expression_is_shadowed_by_parameter(argument, caller_parameters)
                        return (false, []) if not actual_argument.from_default and ewr_expression_name_is_local(argument, caller_local_names)
                        binding_module: sview @source = wrapper.function_module if actual_argument.from_default else caller_module
                        binding_module_known: bool = wrapper.function_module_known if actual_argument.from_default else caller_module_known
                        resolved: (known: bool, family: EwrFamilyRef) = ewr_concrete_family_of_expression(argument, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, binding_module, binding_module_known, caller_parameters, caller_local_names)
                        return (false, []) if not resolved.known
                        families.push(resolved.family) if resolved.family.family != ""
                    else:
                        return (false, [])
                return (false, []) if not saw_errorset_parameter
                return (true, families)

        def ewr_family_row_matches_ref(annotations: darray[Ast::EnumAnnotation]&, row_index: usize, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not family.has_family_row or row_index + 1.usize() >= annotations.count
                family_row: Ast::EnumAnnotation = annotations[row_index]
                expected_source_name: sview = family.source_name if family.source_name != "" else family.family
                return false if family_row.owner != "__error_set_family" or family_row.name != expected_source_name or family_row.line != family.declaration_line or family_row.offset != family.declaration_offset or family_row.identity_id != family.declaration_identity_id or family_row.occurrence_offset != family.occurrence_offset
                path_row: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                return false if path_row.owner != "__error_set_family_path" or path_row.line != family_row.line or path_row.offset != family_row.offset or path_row.identity_id != family_row.identity_id or path_row.occurrence_offset != family_row.occurrence_offset
                candidate_ref: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, family_row, path_row.name, family.function_module_known, family.function_module, table)
                return candidate_ref.family == family.family and candidate_ref.module_known == family.module_known and candidate_ref.module == family.module

        def ewr_subset_marker_matches_family(annotations: darray[Ast::EnumAnnotation]&, marker_index: usize, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if marker_index >= annotations.count
                marker: Ast::EnumAnnotation = annotations[marker_index]
                return false if marker.owner != "__error_variant_family" or marker.name != family.family or marker.line != family.declaration_line or marker.offset != family.declaration_offset or marker.identity_id != family.declaration_identity_id or marker.occurrence_offset != family.occurrence_offset
                for row_index in 0..<annotations.count |annotations, marker_index, family, marker, table|:
                    continue if not ewr_family_row_matches_ref(annotations, row_index, family, table)
                    continue if marker_index <= row_index + 1.usize()
                    cursor: mutable usize = row_index + 2.usize()
                    while cursor < marker_index |cursor, annotations, marker_index, family|:
                        break if annotations[cursor].owner == "__error_set_family"
                        cursor <- cursor + 1.usize()
                    return true if cursor == marker_index
                return false

        def ewr_family_path_metadata_valid(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return ewr_family_row_matches_ref(annotations, family.family_row_index, family, table)

        # A marker at the declaration position makes the occurrence restricted even when its
        # identity is malformed. Allows are accepted only for the exact declaration identity.
        def ewr_family_is_restricted(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                for marker_index in 0..<annotations.count |annotations, family, table|:
                    return true if ewr_subset_marker_matches_family(annotations, marker_index, family, table)
                return false

        def ewr_variant_allowed(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, variant: sview, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return variant == family.variant_override and ewr_family_path_metadata_valid(annotations, family, table) if family.variant_override != ""
                subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, family, table)
                return false if not subset.valid
                return true if not subset.restricted
                return false if not subset.has_allowed
                for marker_index in 0..<annotations.count |annotations, family, variant, table|:
                    continue if not ewr_subset_marker_matches_family(annotations, marker_index, family, table)
                    marker: Ast::EnumAnnotation = annotations[marker_index]
                    return false if not ewr_family_path_metadata_valid(annotations, family, table) or marker.identity_id != family.declaration_identity_id or marker_index + 1.usize() >= annotations.count
                    allow: Ast::EnumAnnotation = annotations[marker_index + 1.usize()]
                    if allow.owner == "__error_variant_allow" and allow.line == marker.line and allow.offset == marker.offset and allow.identity_id == marker.identity_id and allow.occurrence_offset == marker.occurrence_offset and allow.name == variant:
                        return true
                return false

        # Read one adjacent family/path row's marker/allow payload. Repeated family rows
        # are unioned by ewr_family_subset_state below.
        def ewr_family_row_subset_state(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, family_row_index: usize, table: mutable SymbolTable&) -> (valid: bool, restricted: bool, has_allowed: bool):
            can Abort.Panic:
                return (false, false, false) if not ewr_family_row_matches_ref(annotations, family_row_index, family, table)
                scan: mutable usize = family_row_index + 2.usize()
                restricted: mutable bool = false
                has_allowed: mutable bool = false
                marker_count: mutable usize = 0.usize()
                allow_count: mutable usize = 0.usize()
                while scan < annotations.count |scan, annotations, family, restricted, has_allowed, marker_count, allow_count|:
                    row: Ast::EnumAnnotation = annotations[scan]
                    break if row.owner == "__error_set_family"
                    break if row.name == "__error_return" and row.line == family.declaration_line and row.offset == family.declaration_offset and row.identity_id == family.declaration_identity_id
                    if row.owner == "__error_variant_family":
                        restricted <- true
                        marker_count <- marker_count + 1.usize()
                        return (false, true, has_allowed) if row.name != family.family or row.line != family.declaration_line or row.offset != family.declaration_offset or row.identity_id != family.declaration_identity_id or row.occurrence_offset != family.occurrence_offset
                        if scan + 1.usize() < annotations.count and annotations[scan + 1.usize()].owner == "__error_variant_allow":
                            allow: Ast::EnumAnnotation = annotations[scan + 1.usize()]
                            return (false, true, has_allowed) if allow.line != row.line or allow.offset != row.offset or allow.identity_id != row.identity_id or allow.occurrence_offset != row.occurrence_offset or allow.name == ""
                            has_allowed <- true
                            allow_count <- allow_count + 1.usize()
                            scan <- scan + 2.usize()
                        else:
                            # The only well-formed marker-only shape is one empty-set
                            # marker immediately before the next family or end of rows.
                            return (false, true, has_allowed) if marker_count != 1.usize() or allow_count != 0.usize()
                            next_is_boundary: mutable bool = scan + 1.usize() >= annotations.count
                            if scan + 1.usize() < annotations.count:
                                next_row: Ast::EnumAnnotation = annotations[scan + 1.usize()]
                                next_is_boundary <- next_row.owner == "__error_set_family" or (next_row.name == "__error_return" and next_row.line == family.declaration_line and next_row.offset == family.declaration_offset and next_row.identity_id == family.declaration_identity_id)
                            return (true, true, false) if next_is_boundary
                            return (false, true, false)
                    elif row.owner == "__error_variant_allow":
                        return (false, restricted, has_allowed)
                    elif restricted:
                        return (false, true, has_allowed)
                    else:
                        scan <- scan + 1.usize()
                return (true, restricted, has_allowed) if marker_count == allow_count or not restricted
                return (false, restricted, has_allowed)

        # Parser subset rows are stored as marker/allow pairs after each family/path
        # pair. Union repeated same-family/path occurrences on the same return clause:
        # an unrestricted row covers the full family; otherwise allowed variants add.
        # A marker-only `Fault{}` remains a primary type error and stays neutral here.
        def ewr_family_subset_state(annotations: darray[Ast::EnumAnnotation]&, family: EwrFamilyRef, table: mutable SymbolTable&) -> (valid: bool, restricted: bool, has_allowed: bool):
            can Abort.Panic:
                return (true, true, true) if family.variant_override != "" and ewr_family_path_metadata_valid(annotations, family, table)
                return (false, false, false) if not ewr_family_path_metadata_valid(annotations, family, table)
                family_count: mutable usize = 0.usize()
                saw_restricted: mutable bool = false
                saw_unrestricted: mutable bool = false
                has_allowed: mutable bool = false
                for row_index in 0..<annotations.count |family_count, saw_restricted, saw_unrestricted, has_allowed, annotations, family, table|:
                    continue if not ewr_family_row_matches_ref(annotations, row_index, family, table)
                    family_count <- family_count + 1.usize()
                    row_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_row_subset_state(annotations, family, row_index, table)
                    return (false, row_subset.restricted, has_allowed or row_subset.has_allowed) if not row_subset.valid
                    saw_restricted <- true if row_subset.restricted
                    saw_unrestricted <- true if not row_subset.restricted
                    has_allowed <- true if row_subset.has_allowed
                return (false, false, false) if family_count == 0.usize()
                return (true, saw_restricted and not saw_unrestricted, has_allowed)

        def ewr_family_covers(annotations: darray[Ast::EnumAnnotation]&, source: EwrFamilyRef, destination: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not source.module_known or not destination.module_known
                source_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, source, table)
                return true if not source_subset.valid
                # `error[Fault{}]` is rejected by check_empty_error_set_subset. It has no
                # defined propagation family, so suppress only this pass's second opinion.
                return true if source_subset.restricted and not source_subset.has_allowed
                destination_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, destination, table)
                return true if not destination_subset.valid or (destination_subset.restricted and not destination_subset.has_allowed)
                saw_source_tag: mutable bool = false
                for variant_index in 0..<table.enum_variant_owner.count |saw_source_tag, source, destination, annotations, table|:
                    belongs_to_source: bool = table.enum_variant_owner[variant_index] == source.family and variant_index < table.enum_variant_module.count and table.enum_variant_module[variant_index] == source.module
                    if belongs_to_source and ewr_variant_allowed(annotations, source, table.enum_variant_name[variant_index], table):
                        saw_source_tag <- true
                        destination_has_tag: mutable bool = false
                        for destination_index in 0..<table.enum_variant_owner.count |destination_has_tag, source, destination, annotations, table, variant_index|:
                            belongs_to_destination: bool = table.enum_variant_owner[destination_index] == destination.family and destination_index < table.enum_variant_module.count and table.enum_variant_module[destination_index] == destination.module
                            destination_has_tag <- true if belongs_to_destination and table.enum_variant_name[destination_index] == table.enum_variant_name[variant_index] and ewr_variant_allowed(annotations, destination, table.enum_variant_name[destination_index], table)
                        return false if not destination_has_tag
                return saw_source_tag

        # Match each concrete source tag against the complete declared destination
        # union, as Core's MatchErrorTag does: an exact family/module/tag wins; absent
        # that, exactly one allowed destination tag may share its short name.
        def ewr_family_covers_destination_union(annotations: darray[Ast::EnumAnnotation]&, source: EwrFamilyRef, destinations: darray[EwrFamilyRef]&, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not source.module_known
                source_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, source, table)
                return true if not source_subset.valid or (source_subset.restricted and not source_subset.has_allowed)
                for destination in destinations |annotations, source|:
                    return true if destination.family == "" or not destination.module_known
                    destination_subset: (valid: bool, restricted: bool, has_allowed: bool) = ewr_family_subset_state(annotations, destination, table)
                    return true if not destination_subset.valid or (destination_subset.restricted and not destination_subset.has_allowed)
                saw_source_tag: mutable bool = false
                for source_index in 0..<table.enum_variant_owner.count |saw_source_tag, source, destinations, annotations, table|:
                    continue if source_index >= table.enum_variant_name.count or source_index >= table.enum_variant_module.count
                    continue if table.enum_variant_owner[source_index] != source.family or table.enum_variant_module[source_index] != source.module
                    if ewr_variant_allowed(annotations, source, table.enum_variant_name[source_index], table):
                        saw_source_tag <- true
                        exact_destination_match: mutable bool = false
                        short_destination_matches: mutable usize = 0.usize()
                        for candidate_index in 0..<table.enum_variant_owner.count |exact_destination_match, short_destination_matches, source, destinations, annotations, table, source_index|:
                            continue if candidate_index >= table.enum_variant_name.count or candidate_index >= table.enum_variant_module.count
                            duplicate_tag: mutable bool = false
                            for prior_index in 0..<candidate_index |duplicate_tag, table, candidate_index|:
                                continue if prior_index >= table.enum_variant_name.count or prior_index >= table.enum_variant_module.count
                                duplicate_tag <- true if table.enum_variant_owner[prior_index] == table.enum_variant_owner[candidate_index] and table.enum_variant_module[prior_index] == table.enum_variant_module[candidate_index] and table.enum_variant_name[prior_index] == table.enum_variant_name[candidate_index]
                            continue if duplicate_tag
                            candidate_allowed: mutable bool = false
                            for destination in destinations |candidate_allowed, annotations, table, candidate_index|:
                                continue if destination.family != table.enum_variant_owner[candidate_index] or destination.module != table.enum_variant_module[candidate_index]
                                candidate_allowed <- true if ewr_variant_allowed(annotations, destination, table.enum_variant_name[candidate_index], table)
                            continue if not candidate_allowed or table.enum_variant_name[candidate_index] != table.enum_variant_name[source_index]
                            short_destination_matches <- short_destination_matches + 1.usize()
                            exact_destination_match <- true if table.enum_variant_owner[candidate_index] == source.family and table.enum_variant_module[candidate_index] == source.module
                        return false if not exact_destination_match and short_destination_matches != 1.usize()
                return saw_source_tag

        def ewr_destination_covers(annotations: darray[Ast::EnumAnnotation]&, actual: EwrFamilyRef, destination: EwrFamilyRef, table: mutable SymbolTable&) -> bool:
            can Abort.Panic:
                return false if actual.family == "" or destination.family == ""
                return ewr_family_covers(annotations, actual, destination, table)

        # The caller's first declared error family (for the diagnostic), or "".
        def ewr_declared_first(annotations: darray[Ast::EnumAnnotation]&, function_line: u32, function_offset: u32, occurrence_offset: u32, identity_id: u32) -> sview:
            first: mutable sview = ""
            for row in annotations |first, function_line, function_offset, occurrence_offset, identity_id|:
                first <- row.name if first == "" and row.owner == "__error_set_family" and row.line == function_line and row.offset == function_offset and row.identity_id == identity_id and row.occurrence_offset == occurrence_offset
            return first

        # Return the first actual family not covered by the caller's declared set. A caller with
        # NO declared set is treated as covering (a distinct diagnostic handles that shape).
        # Keeping each contributor separate preserves unions from multiple R-bearing formals.
        def ewr_first_uncovered_family(annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, function_line: u32, function_offset: u32, occurrence_offset: u32, return_identity_id: u32, actuals: darray[EwrFamilyRef]) -> sview:
            can Memory.Allocate, Abort.Panic:
                caller_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, function_offset, function_line)
                caller_module_known: bool = fallible_fn_module_known(module_annotations, function_offset, function_line)
                for actual in actuals:
                    has_family: mutable bool = false
                    unresolved_destination: mutable bool = false
                    destinations: mutable darray[EwrFamilyRef] = []
                    for row_index in 0..<annotations.count |has_family, unresolved_destination, destinations, annotations, table, caller_module, caller_module_known, function_line, function_offset, occurrence_offset, return_identity_id, actual|:
                        row: Ast::EnumAnnotation = annotations[row_index]
                        if row.owner == "__error_set_family" and row.line == function_line and row.offset == function_offset and row.identity_id == return_identity_id and row.occurrence_offset == occurrence_offset:
                            has_family <- true
                            family_path: mutable sview @source = ""
                            if row_index + 1.usize() < annotations.count:
                                path_annotation: Ast::EnumAnnotation = annotations[row_index + 1.usize()]
                                family_path <- path_annotation.name if path_annotation.owner == "__error_set_family_path" and path_annotation.line == row.line and path_annotation.offset == row.offset and path_annotation.identity_id == row.identity_id and path_annotation.occurrence_offset == row.occurrence_offset
                            path_resolves: bool = ewr_family_path_resolves(family_path, row.name, row.line, row.offset, row.identity_id, caller_module, annotations, table)
                            if not path_resolves:
                                unresolved_destination <- true
                                continue
                            destination_base: TryErrorFamilyRef = try_error_family_ref_for_annotation(annotations, row, family_path, caller_module_known, caller_module, table)
                            destination: EwrFamilyRef = EwrFamilyRef{family: destination_base.family, family_path: family_path, source_name: destination_base.source_name, variant_override: destination_base.variant_override, module: destination_base.module, module_known: destination_base.module_known, family_row_index: row_index, has_family_row: true, function_name: "", function_module: caller_module, function_module_known: caller_module_known, declaration_line: row.line, declaration_offset: row.offset, declaration_identity_id: row.identity_id, occurrence_offset: row.occurrence_offset}
                            unresolved_destination <- true if not destination.module_known
                            destinations.push(destination) if destination.module_known
                    if has_family:
                        covered: bool = unresolved_destination or ewr_family_covers_destination_union(annotations, actual, destinations, table)
                        return actual.family if not covered
                return ""

        def ewr_check_returned_call(value: Ast::Expr, function_line: u32, function_offset: u32, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, return_markers: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                caller_module: sview @source = fallible_fn_module_indexed(module_index, module_annotations, function_offset, function_line)
                caller_module_known: bool = fallible_fn_module_known(module_annotations, function_offset, function_line)
                return_occurrence: (found: bool, ambiguous: bool, occurrence_offset: u32, identity_id: u32) = ewr_return_occurrence(return_markers, function_line, function_offset)
                return if not return_occurrence.found or return_occurrence.ambiguous
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callable: (known: bool, qualifier: sview @source, name: sview @source) = ewr_callable_parts(callee, table)
                        return if not callable.known
                        return if ewr_expression_is_shadowed_by_parameter(callee, caller_parameters)
                        return if ewr_expression_name_is_local(callee, caller_local_names)
                        has_argument_forward: bool = ewr_call_has_argument_forward(annotations, call_line.line, call_line.offset)
                        wrapper: (is_poly: bool, family: EwrFamilyRef, errorset_name: sview @source) = ewr_poly_wrapper(all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, callable.name, callable.qualifier, caller_module, caller_module_known, arguments.count, arguments, argument_names, has_argument_forward, caller_parameters, caller_local_names)
                        if wrapper.is_poly:
                            wrapper_signature: (matches: usize, parameters: darray[Ast::ParamDecl]) = ewr_find_function_parameters(all_declarations, wrapper.family, "", annotations, table)
                            return if wrapper_signature.matches != 1.usize()
                            actual: (known: bool, families: darray[EwrFamilyRef]) = ewr_arg_family(arguments, argument_names, wrapper_signature.parameters, caller_parameters, caller_local_names, wrapper.family, wrapper.errorset_name, wrapper.family.occurrence_offset, all_declarations, extern_params, annotations, errorset_rows, module_annotations, module_index, error_index, table, caller_module, caller_module_known)
                            uncovered: sview = ewr_first_uncovered_family(annotations, table, module_annotations, module_index, function_line, function_offset, return_occurrence.occurrence_offset, return_occurrence.identity_id, actual.families) if actual.known else ""
                            if uncovered != "":
                                expected: sview = ewr_declared_first(annotations, function_line, function_offset, return_occurrence.occurrence_offset, return_occurrence.identity_id)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TryPropagationMismatch, name: uncovered, pos: call_line, line: call_line.line, expected: expected, actual: ""})
                    _:
                        pass

        def ewr_walk(statements: darray[Ast::Stmt], function_line: u32, function_offset: u32, caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, return_markers: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            table <- ewr_check_returned_call(returned, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- ewr_walk(then_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                            table <- ewr_walk(else_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- ewr_walk(body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.While(condition, while_body, line):
                            table <- ewr_walk(while_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- ewr_walk(for_body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- ewr_walk(arm.body, function_line, function_offset, caller_parameters, caller_local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        _:
                            pass

        def ewr_check_declarations(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam], annotations: darray[Ast::EnumAnnotation]&, return_markers: darray[Ast::EnumAnnotation]&, errorset_rows: darray[Ast::EnumAnnotation]&, module_annotations: darray[Ast::EnumAnnotation]&, module_index: FallibleFunctionModuleIndex&, error_index: CallableErrorAnnotationIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            local_names: mutable darray[sview] = []
                            ewr_collect_local_names(body, local_names)
                            table <- ewr_walk(body, line.line, line.offset, parameters, local_names, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- ewr_check_declarations(module_body, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- ewr_check_declarations(scoped_body, all_declarations, extern_params, annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
                        _:
                            pass

        # Each function's start line paired with its first declared error family, in
        # source order. `return type expects T | Bad, got ...` spells the RETURN TYPE, so
        # the set is the enclosing function's -- not a property of whichever check found
        # the mismatch. Five separate checks emit that sentence, so the pairing is
        # collected once here and applied where the rows leave the table.
        # The annotation table holds every enum annotation of the unit, so it is filtered
        # to the error-set rows ONCE; scanning it per function was ~8% of a self-host compile.
        def collect_function_error_sets(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, lines: mutable darray[u32]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                family_rows: mutable darray[Ast::EnumAnnotation] = []
                return_rows: mutable darray[Ast::EnumAnnotation] = []
                for row in annotations |family_rows, return_rows|:
                    family_rows.push(row) if row.owner == "__error_set_family"
                    return_rows.push(row) if row.name == "__error_return"
                collect_function_error_sets_from(declarations, family_rows, return_rows, lines, names)

        def collect_function_error_sets_from(declarations: darray[Ast::Decl], family_rows: darray[Ast::EnumAnnotation]&, return_rows: darray[Ast::EnumAnnotation]&, lines: mutable darray[u32]&, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |lines, names, family_rows, return_rows|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            lines.push(line.line)
                            return_occurrence: (found: bool, ambiguous: bool, occurrence_offset: u32, identity_id: u32) = ewr_return_occurrence(return_rows, line.line, line.offset)
                            names.push(ewr_declared_first(family_rows, line.line, line.offset, return_occurrence.occurrence_offset, return_occurrence.identity_id) if return_occurrence.found else "")
                        Decl.Module(module_name, module_body, module_line):
                            collect_function_error_sets_from(module_body, family_rows, return_rows, lines, names)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_function_error_sets_from(scoped_body, family_rows, return_rows, lines, names)
                        _:
                            pass

        # The enclosing function's error set for a `name == "return"` row, or "". The pairs
        # arrive in source order, so the last start at or before the line wins.
        def diag_return_error_set(lines: darray[u32]&, names: darray[sview]&, diagnostic_name: sview, diagnostic_line: u32) -> sview:
            return "" if diagnostic_name != "return"
            found: mutable sview = ""
            for index in 0..<lines.count |found|:
                found <- names[index] if diagnostic_name == "return" and lines[index] <= diagnostic_line
            return found

    public:
        def check_errorset_wrapper_return(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                module_annotations: mutable darray[Ast::EnumAnnotation] = []
                lookup_annotations: mutable darray[Ast::EnumAnnotation] = ewr_static_import_annotations(file, table)
                module_index: mutable FallibleFunctionModuleIndex = FallibleFunctionModuleIndex{by_line: {}, by_offset: {}, unknown_offset_by_line: {}, ready: false}
                error_index: mutable CallableErrorAnnotationIndex = CallableErrorAnnotationIndex{heads: {}, tails: {}, next: [], source_rows: [], extern_line_heads: {}, extern_line_tails: {}, extern_line_next: [], extern_source_rows: [], ready: false}
                # Keep only generic-parameter rows for the exact declaration lookup performed
                # above; declaration offsets and identities distinguish same-line overloads.
                errorset_rows: mutable darray[Ast::EnumAnnotation] = []
                return_markers: mutable darray[Ast::EnumAnnotation] = []
                for annotation in lookup_annotations |module_annotations, errorset_rows, return_markers|:
                    module_annotations.push(annotation) if annotation.owner == "__fn_module"
                    errorset_rows.push(annotation) if annotation.owner == "__errorset_param"
                    return_markers.push(annotation) if annotation.name == "__error_return"
                fallible_function_module_index_build(module_index, module_annotations) can Global{Read,Write} if module_annotations.count > 0
                callable_error_index_build(lookup_annotations, error_index, false) can Global{Read,Write}
                table <- ewr_check_declarations(file.top_decls, file.top_decls, file.extern_params, lookup_annotations, return_markers, errorset_rows, module_annotations, module_index, error_index, table)
