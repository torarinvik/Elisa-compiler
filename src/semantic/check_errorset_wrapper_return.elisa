# A function returning `error[E]` whose body directly `return WRAP(g, ...)`s a POLYMORPHIC errorset
# wrapper — `def WRAP[errorset R](f: fn() -> T error[R]) -> T error[R]` — propagates the wrapper's
# instantiated error set out of the caller. When the concrete family bound to R (the error family of
# a function-reference argument `g`) is not covered by the caller's declared set E, the return type
# cannot hold: stage0 rejects it ("return type expects i64 | E, got i64 | error[...]").
#
# SOUND cut: fire only on a DIRECT `return CALL(...)` whose callee is a poly wrapper (its return
# family == its own `[errorset R]` parameter) and whose actual arguments bound to formals carrying
# R resolve to one concrete (non-parametric) error family. Unrelated arguments are ignored, while
# ambiguous or absent bindings decline; a caller whose declared set covers the family is left clean.
# The pass resolves bare identifiers in the current module, its lexical parents, and visible
# imports. Qualified module paths and visible aliases are resolved against the callable index.
extend Semantic:
    private:
        struct EwrFamilyRef:
            family: sview @source
            family_path: sview @source
            source_name: sview @source
            variant_override: sview @source
            module: sview @source
            module_known: bool
            family_row_index: usize
            has_family_row: bool
            function_name: sview @source
            function_module: sview @source
            function_module_known: bool
            declaration_line: u32
            declaration_offset: u32
            declaration_identity_id: u32
            occurrence_offset: u32

        struct EwrCallableBinding:
            found: mutable bool
            scope_length: mutable usize
            specificity: mutable usize
            match_known: mutable bool

        def ewr_empty_family_ref() -> EwrFamilyRef:
            return EwrFamilyRef{family: "", family_path: "", source_name: "", variant_override: "", module: "", module_known: false, family_row_index: 0.usize(), has_family_row: false, function_name: "", function_module: "", function_module_known: false, declaration_line: 0, declaration_offset: 0, declaration_identity_id: 0, occurrence_offset: 0}

        def ewr_empty_callable_binding() -> EwrCallableBinding:
            return EwrCallableBinding{found: false, scope_length: 0.usize(), specificity: 0.usize(), match_known: false}

        # Const declarations inside static-if arms only participate when those arms are
        # selected. The parser records each enclosing arm against the exact declaration
        # position, so same-scope inactive constants cannot shadow an active outer const.
        def ewr_static_if_const_branch_selection(file: Ast::File&, name: sview, symbol: Symbol, table: SymbolTable&, depth: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in file.enum_annotations |found_marker, unknown, file, name, symbol, table, depth|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__const_static_branch" or marker.detail_name != name or marker.module != symbol.module_owner or marker.line != symbol.line or marker.offset != symbol.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- ewr_static_if_row_selection(file, marker.identity_id.usize(), symbol.module_owner, table, depth + 1) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        def ewr_static_if_named_constant_value(name: sview, current_module: sview, file: Ast::File&, table: SymbolTable&, depth: u32) -> (known: bool, value: i64):
            can Abort.Panic:
                return (false, 0) if depth >= 64
                selected_row: mutable usize = table.immutable_const_values.count
                selected_scope_length: mutable usize = 0.usize()
                selected_ambiguous: mutable bool = false
                unknown_scope_length: mutable usize = 0.usize()
                found_unknown: mutable bool = false
                for const_index in 0..<table.immutable_const_values.count |selected_row, selected_scope_length, selected_ambiguous, unknown_scope_length, found_unknown, name, current_module, file, table, depth|:
                    continue if const_index >= table.immutable_const_names.count or const_index >= table.immutable_const_rows.count
                    continue if table.immutable_const_names[const_index] != name
                    symbol_row: usize = table.immutable_const_rows[const_index].usize()
                    continue if symbol_row >= table.symbols.count
                    symbol: Symbol = table.symbols[symbol_row]
                    continue if symbol.name != name or (symbol.module_owner != "" and not SemanticPrivateModuleBoundary::within_module(current_module, symbol.module_owner))
                    branch: (known: bool, active: bool) = ewr_static_if_const_branch_selection(file, name, symbol, table, depth + 1)
                    continue if branch.known and not branch.active
                    if not branch.known:
                        found_unknown <- true
                        unknown_scope_length <- symbol.module_owner.len if symbol.module_owner.len > unknown_scope_length
                        continue
                    if selected_row >= table.immutable_const_values.count or symbol.module_owner.len > selected_scope_length:
                        selected_row <- const_index
                        selected_scope_length <- symbol.module_owner.len
                        selected_ambiguous <- false
                    elif symbol.module_owner.len == selected_scope_length:
                        selected_ambiguous <- true
                # Exact-module declarations outrank root fallback; uncertainty only blocks
                # a candidate when it could be at least as specific as that winner.
                return (false, 0) if found_unknown and (selected_row >= table.immutable_const_values.count or unknown_scope_length >= selected_scope_length)
                return (false, 0) if selected_ambiguous
                return (false, 0) if selected_row >= table.immutable_const_values.count
                return ewr_static_if_condition_value(table.immutable_const_values[selected_row], current_module, file, table, depth + 1)

        def ewr_static_if_condition_value(expression: Ast::Expr, current_module: sview, file: Ast::File&, table: SymbolTable&, depth: u32) -> (known: bool, value: i64):
            can Abort.Panic:
                return (false, 0) if depth >= 64
                match expression:
                    Expr.BoolLit(value, _):
                        return (true, 1 if value else 0)
                    Expr.IntLit(value, _):
                        return (true, value)
                    Expr.Paren(inner, _):
                        return ewr_static_if_condition_value(inner, current_module, file, table, depth + 1)
                    Expr.Ident(name, _):
                        return ewr_static_if_named_constant_value(name, current_module, file, table, depth + 1)
                    _:
                        return (false, 0)

        # Follow the parser's generic branch-row identity and depth metadata. The
        # current_module parameter remains for shared Catch callers, but each condition
        # uses its recorded lexical module; a missing module row stays unknown.
        def ewr_static_if_row_selection(file: Ast::File&, branch_row: usize, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (known: bool, selected: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64 or branch_row >= file.static_if_lines.count or branch_row >= file.static_if_kinds.count
                branch_depth: u32 = file.static_if_depths[branch_row] if branch_row < file.static_if_depths.count else StaticIfBranch::TOP_LEVEL_DEPTH
                chain_start: mutable usize = file.static_if_lines.count
                row: mutable usize = branch_row + 1.usize()
                while row > 0 |row, chain_start, branch_depth, file|:
                    row <- row - 1.usize()
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    if file.static_if_kinds[row] == StaticIfBranch::Kind.ChainHead:
                        chain_start <- row
                        break
                return (false, false) if chain_start >= file.static_if_lines.count
                for row in chain_start..<(branch_row + 1.usize()) |row, branch_row, branch_depth, file|:
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    if file.static_if_kinds[row] == StaticIfBranch::Kind.Fallback:
                        return (true, row == branch_row)
                    return (false, false) if row >= file.static_if_conds.count or row >= file.static_if_modules.count
                    condition_module: sview = file.static_if_modules[row]
                    condition: (known: bool, value: i64) = ewr_static_if_condition_value(file.static_if_conds[row], condition_module, file, table, depth + 1)
                    return (false, false) if not condition.known
                    if condition.value != 0:
                        return (true, row == branch_row)
                    return (true, false) if row == branch_row
                return (true, false)

        def ewr_static_import_branch_selection(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, marker_name: sview, marker_detail: sview, module: sview, line: u32, offset: u32, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, file, marker_name, marker_detail, module, line, offset|:
                    continue if marker.owner != "__static_if_branch" or marker.name != marker_name or marker.detail_name != marker_detail or marker.module != module or marker.line != line or marker.offset != offset
                    found_marker <- true
                    branch: (known: bool, selected: bool) = ewr_static_if_row_selection(file, marker.identity_id.usize(), module, table) if marker.identity_id != 4294967295 else (false, false)
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        def ewr_static_import_annotation_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                if annotation.owner == "__from_member":
                    return ewr_static_import_branch_selection(annotations, file, "__from_member_static_branch", annotation.name, annotation.module, annotation.line, annotation.offset, table)
                if annotation.name == "__binding_wildcard_import":
                    return ewr_static_import_branch_selection(annotations, file, "__binding_wildcard_import_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset, table)
                if annotation.name == "__using_alias":
                    return ewr_static_import_branch_selection(annotations, file, "__using_alias_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset, table)
                return (true, true)

        # Remove import and module-alias annotations proven to live in inactive static
        # branches before EWR performs any callable visibility or alias lookup. Keep an
        # explicit marker for unresolved branches so one cannot be mistaken for the only
        # visible import and lend its ErrorSet family speculatively.
        # The only rows ewr_imported_callable_scope reads, in order.
        def ewr_import_scope_rows(annotations: darray[Ast::EnumAnnotation]&) -> darray[Ast::EnumAnnotation]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[Ast::EnumAnnotation] = []
                for annotation in annotations |result|:
                    result.push(annotation) if annotation.name == "__binding_wildcard_import" or annotation.owner == "__from_member" or annotation.owner == "__from_src"
                return result

        def ewr_static_import_annotations(file: Ast::File&, table: SymbolTable&) -> darray[Ast::EnumAnnotation]:
            can Abort.Panic, Memory.Allocate:
                active: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |active, file, table|:
                    if annotation.owner == "__from_member" or annotation.name == "__binding_wildcard_import" or annotation.name == "__using_alias":
                        branch: (known: bool, active: bool) = ewr_static_import_annotation_selection(annotation, file.enum_annotations, file, table)
                        continue if branch.known and not branch.active
                        if not branch.known:
                            if annotation.owner == "__from_member":
                                imported_module: mutable sview = ""
                                for source in file.enum_annotations |imported_module, annotation|:
                                    imported_module <- source.name if source.owner == "__from_src" and source.module == annotation.module and source.line == annotation.line and source.offset == annotation.offset
                                active.push(Ast::EnumAnnotation{owner: "__ewr_unknown_selective_import", name: annotation.name, detail_name: imported_module, module: annotation.module, line: annotation.line, offset: annotation.offset})
                            elif annotation.name == "__binding_wildcard_import":
                                active.push(Ast::EnumAnnotation{owner: "__ewr_unknown_wildcard_import", name: "__binding_wildcard_import", detail_name: annotation.owner, module: annotation.module, line: annotation.line, offset: annotation.offset})
                            else:
                                target: mutable sview = ""
                                for target_row in file.enum_annotations |target, annotation|:
                                    target <- target_row.owner if target_row.name == "__using_alias_target" and target_row.module == annotation.module and target_row.line == annotation.line and target_row.offset == annotation.offset
                                active.push(Ast::EnumAnnotation{owner: "__ewr_unknown_using_alias", name: annotation.owner, detail_name: target, module: annotation.module, line: annotation.line, offset: annotation.offset})
                            continue
                    active.push(annotation)
                return active

        def ewr_raw_callable_in_module(declarations: darray[Ast::Decl], name: sview, target_module: sview, current_module: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            return true if function_name == name and current_module == target_module
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            return true if callable and extern_name == name and current_module == target_module
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_raw_callable_in_module(module_body, name, target_module, nested_module, table)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_raw_callable_in_module(scoped_body, name, target_module, current_module, table)
                        _:
                            pass
                return false

        def ewr_raw_callable_matches_import_path(declarations: darray[Ast::Decl], name: sview, base_module: sview, suffix: sview, current_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic, Memory.Allocate:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            path_matches: bool = current_module == suffix if base_module == "" else callable_module_path_matches_suffix(current_module, base_module, suffix)
                            return true if function_name == name and path_matches
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            path_matches: bool = current_module == suffix if base_module == "" else callable_module_path_matches_suffix(current_module, base_module, suffix)
                            return true if callable and extern_name == name and path_matches
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_raw_callable_matches_import_path(module_body, name, base_module, suffix, nested_module, table)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_raw_callable_matches_import_path(scoped_body, name, base_module, suffix, current_module, table)
                        _:
                            pass
                return false

        def ewr_qualifier_head_matches(qualifier: sview @source, wanted: sview) -> bool:
            can Abort.Panic:
                return false if qualifier.len < wanted.len
                return false if qualifier[0:wanted.len] != wanted
                return true if qualifier.len == wanted.len
                return false if qualifier.len < wanted.len + 2.usize()
                return qualifier[wanted.len] == 58 and qualifier[wanted.len + 1.usize()] == 58

        def ewr_raw_callable_matches_alias_path(declarations: darray[Ast::Decl], name: sview, alias_module: sview @source, alias_target: sview @source, suffix: sview @source, annotations: darray[Ast::EnumAnnotation]&, current_module: sview = "") -> bool:
            can Abort.Panic, Memory.Allocate:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            return true if function_name == name and callable_alias_path_matches_candidate(annotations, alias_module, alias_target, suffix, current_module)
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            return true if callable and extern_name == name and callable_alias_path_matches_candidate(annotations, alias_module, alias_target, suffix, current_module)
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            return true if ewr_raw_callable_matches_alias_path(module_body, name, alias_module, alias_target, suffix, annotations, nested_module)
                        Decl.Scoped(scoped_body, _):
                            return true if ewr_raw_callable_matches_alias_path(scoped_body, name, alias_module, alias_target, suffix, annotations, current_module)
                        _:
                            pass
                return false

        # An unresolved alias only blocks family inference while it can still win
        # Core's program-wide alias lookup. Same-scope ordering includes exact static
        # branch ancestry; enclosing direct aliases and source order resolve cross-scope
        # registrations when Core's flatten traversal makes their order provable.
        def ewr_unknown_using_alias_is_definitely_shadowed(marker: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                # The possible-import projection can omit unresolved source rows.
                # Use the parser markers as well, so no omitted contender can be
                # overlooked when proving that a definite registration wins.
                for definite_alias in table.definite_import_annotations |marker, annotations, table|:
                    continue if definite_alias.name != "__using_alias" or definite_alias.owner != marker.name
                    continue if not ewr_definite_module_alias_is_global_winner(definite_alias, table)
                    shadowed: mutable bool = true
                    found_marker: mutable bool = false
                    for unresolved in annotations |shadowed, found_marker, marker, definite_alias, table|:
                        continue if unresolved.owner != "__ewr_unknown_using_alias" or unresolved.name != marker.name
                        found_marker <- true if unresolved.module == marker.module and unresolved.line == marker.line and unresolved.offset == marker.offset
                        possible_alias: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: unresolved.name, name: "__using_alias", module: unresolved.module, line: unresolved.line, offset: unresolved.offset}
                        ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(definite_alias, possible_alias, table)
                        shadowed <- false if not ordering.known or not ordering.left_precedes
                    return true if found_marker and shadowed
                return false

        def ewr_module_alias_order(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, left_precedes: bool):
            can Abort.Panic:
                return semantic_possible_import_alias_precedes(left, right, table)

        def ewr_definite_module_alias_is_global_winner(alias: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for candidate in table.definite_import_annotations |alias, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    continue if candidate.module == alias.module and candidate.line == alias.line and candidate.offset == alias.offset
                    ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(candidate, alias, table)
                    return false if not ordering.known or ordering.left_precedes
                for candidate in table.possible_import_annotations |alias, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    ordering: (known: bool, left_precedes: bool) = ewr_module_alias_order(candidate, alias, table)
                    return false if not ordering.known or ordering.left_precedes
                return true

        def ewr_unknown_static_import_affects_call(annotations: darray[Ast::EnumAnnotation]&, declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview, table: SymbolTable&) -> bool:
            can Abort.Panic, Memory.Allocate:
                for marker in annotations:
                    if marker.owner == "__ewr_unknown_selective_import" and marker.name == name:
                        return true if ewr_raw_callable_matches_import_path(declarations, name, marker.module, marker.detail_name, "", table)
                    if marker.owner == "__ewr_unknown_wildcard_import" and ewr_module_is_lexical_ancestor(marker.module, caller_module):
                        return true if ewr_raw_callable_in_module(declarations, name, marker.detail_name, "", table)
                        return true if ewr_raw_callable_matches_import_path(declarations, name, marker.module, marker.detail_name, "", table)
                    if marker.owner == "__ewr_unknown_using_alias" and qualifier != "" and ewr_qualifier_head_matches(qualifier, marker.name):
                        alias_head_length: usize = marker.name.len
                        suffix: sview @source = qualifier[alias_head_length + 2.usize():qualifier.len] if qualifier.len > alias_head_length else ""
                        return true if ewr_raw_callable_matches_alias_path(declarations, name, marker.module, marker.detail_name, suffix, annotations) and not ewr_unknown_using_alias_is_definitely_shadowed(marker, annotations, table)
                return false

        # Unqualified Stage0 lookup checks the current scope and then its parents. Keep
        # this local to EWR so a nested caller can resolve an enclosing declaration, while
        # unrelated sibling modules remain invisible.
        def ewr_module_is_lexical_ancestor(candidate: sview, caller: sview) -> bool:
            can Abort.Panic:
                return true if candidate == caller or candidate == ""
                return false if candidate.len + 2.usize() >= caller.len
                for index in 0..<candidate.len |candidate, caller|:
                    return false if candidate[index] != caller[index]
                return caller[candidate.len] == 58 and caller[candidate.len + 1.usize()] == 58

        # Encode lexical depth first, then Core's lookup order within one scope:
        # local declarations, wildcard `using`, then program-wide selective aliases.
        def ewr_local_scope_rank(module: sview, caller_module: sview) -> usize:
            # Reserve a band above every wildcard scope visible to CALLER_MODULE.
            # A local binding in a lexical parent precedes even a wildcard declared
            # in a more deeply nested module.
            return caller_module.len + caller_module.len + 2.usize() + module.len

        def ewr_wildcard_scope_rank(module: sview, caller_module: sview) -> usize:
            # Core appends inherited `using` names before names declared in the
            # current module, so the outermost visible wildcard has first precedence.
            return caller_module.len - module.len + 1.usize()

        # Wildcard imports are visible only from the lexical scope containing their
        # `using` declaration. Selective imports are program-wide aliases in Core; after
        # checking lexical wildcards, use the same first-alias lookup as Try.
        def ewr_imported_callable_scope(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview, caller_module: sview) -> (visible: bool, scope_length: usize):
            can Abort.Panic:
                visible: mutable bool = false
                scope_length: mutable usize = 0
                for binding in annotations |visible, scope_length, annotations, name, candidate_module, caller_module|:
                    if binding.name == "__binding_wildcard_import" and binding.owner == candidate_module and ewr_module_is_lexical_ancestor(binding.module, caller_module):
                        wildcard_rank: usize = ewr_wildcard_scope_rank(binding.module, caller_module)
                        if not visible or wildcard_rank > scope_length:
                            visible <- true
                            scope_length <- wildcard_rank
                return (true, scope_length) if visible
                # Selective aliases are collected program-wide, including when the `from`
                # declaration appears in a sibling module. The shared helper preserves
                # Core's first-import-wins rule and resolves module aliases in the source.
                return (true, 0.usize()) if callable_program_selective_import_row(annotations, name, candidate_module)
                return (visible, scope_length)

        def ewr_callable_name_visible(annotations: darray[Ast::EnumAnnotation]&, name: sview, candidate_module: sview @source, caller_module: sview @source, declaration_line: u32, declaration_offset: u32) -> bool:
            can Abort.Panic:
                return false if not try_error_alias_module_visible(annotations, candidate_module, caller_module)
                legacy_private_marker: mutable bool = false
                for annotation in annotations |legacy_private_marker, name, candidate_module, caller_module, declaration_line, declaration_offset|:
                    continue if annotation.name != name or annotation.module != candidate_module or (annotation.owner != "__section_private" and annotation.owner != "__section_public")
                    # A source token span has positive length even when its line and
                    # starting offset are both zero; the default Pos has an empty span.
                    marker_position_known: bool = annotation.pos.end_offset > annotation.pos.offset
                    exact_position: bool = marker_position_known and annotation.pos.line == declaration_line and annotation.pos.offset == declaration_offset
                    if exact_position:
                        return ewr_module_is_lexical_ancestor(candidate_module, caller_module) if annotation.owner == "__section_private"
                        return true if annotation.owner == "__section_public"
                    legacy_private_marker <- true if annotation.owner == "__section_private" and not marker_position_known
                # Older side tables have no declaration coordinate. Fail closed when a
                # same-name private marker could refer to this candidate; parser-produced
                # markers carry Ast::Pos so byte offset zero remains an exact position.
                return false if legacy_private_marker
                return true

        def ewr_callable_binding_consider(binding: mutable EwrCallableBinding&, candidate_scope_length: usize) -> void:
            if not binding.found or candidate_scope_length > binding.scope_length:
                binding.found <- true
                binding.scope_length <- candidate_scope_length
                binding.specificity <- 0.usize()
                binding.match_known <- false

        def ewr_callable_binding_consider_ranked(binding: mutable EwrCallableBinding&, candidate_scope_length: usize, candidate_specificity: usize, candidate_match_known: bool) -> void:
            if not binding.found or candidate_scope_length > binding.scope_length:
                binding.found <- true
                binding.scope_length <- candidate_scope_length
                binding.specificity <- candidate_specificity
                binding.match_known <- candidate_match_known
            elif candidate_scope_length == binding.scope_length:
                if not candidate_match_known or not binding.match_known:
                    binding.match_known <- false
                elif candidate_specificity > binding.specificity:
                    binding.specificity <- candidate_specificity
                elif candidate_specificity == binding.specificity:
                    # A tie between private candidates is still a possible Core winner.
                    binding.match_known <- false

        def ewr_bool_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        # Ordinary free-call lookup binds the first visible name before validating call
        # arity or argument types. Preserve that binding so an incompatible local function
        # cannot disappear and expose a lower-priority imported ErrorSet family.
        def ewr_callable_binding_in_scope(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, current_module: sview @source, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, binding: mutable EwrCallableBinding&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |name, qualifier, current_module, caller_module, annotations, table, binding|:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, position):
                            if function_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(table.ewr_import_rows, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: mutable bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_visible <- false if candidate_visible and not ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset)
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider(binding, candidate_scope_length) if candidate_visible
                        Decl.Extern(extern_name, _, _, _, callable, _, _, position):
                            if callable and extern_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(table.ewr_import_rows, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: mutable bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_visible <- false if candidate_visible and not ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset)
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider(binding, candidate_scope_length) if candidate_visible
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            ewr_callable_binding_in_scope(module_body, name, qualifier, nested_module, caller_module, annotations, table, binding)
                        Decl.Scoped(scoped_body, _):
                            ewr_callable_binding_in_scope(scoped_body, name, qualifier, current_module, caller_module, annotations, table, binding)
                        _:
                            pass

        def ewr_first_visible_callable_binding(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> EwrCallableBinding:
            can Memory.Allocate, Abort.Panic:
                binding: mutable EwrCallableBinding = ewr_empty_callable_binding()
                ewr_callable_binding_in_scope(declarations, name, qualifier, "", caller_module, annotations, table, binding)
                return binding

        # Core can bind a private primary before reporting its access error when the
        # free-call receiver rewrite is disabled (for example, by named arguments).
        # Keep inaccessible candidates as barriers at their lexical/import scope.
        def ewr_inaccessible_callable_binding_in_scope(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, current_module: sview @source, caller_module: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&, binding: mutable EwrCallableBinding&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |name, qualifier, current_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding|:
                    match declaration:
                        Decl.Func(function_name, parameters, _, _, _, _, position):
                            if function_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(table.ewr_import_rows, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_accessible: bool = ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset) if candidate_visible else false
                                # This helper only models a call with receiver ranking disabled.
                                # Core binds the direct name first and can retain its return type
                                # after diagnosing a positional count error.
                                candidate_arity_viable: bool = true
                                # This path runs only when Core's receiver-rank gate is off;
                                # direct-name binding is retained before argument diagnostics.
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider_ranked(binding, candidate_scope_length, 0.usize(), false) if candidate_visible and not candidate_accessible and candidate_arity_viable
                        Decl.Extern(extern_name, _, _, _, callable, _, _, position):
                            if callable and extern_name == name:
                                candidate_is_local: bool = ewr_module_is_lexical_ancestor(current_module, caller_module) if qualifier == "" else false
                                imported_scope: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(table.ewr_import_rows, name, current_module, caller_module) if qualifier == "" and not candidate_is_local else (false, 0.usize())
                                candidate_visible: bool = ewr_qualified_module_matches(current_module, qualifier, caller_module, annotations, table) if qualifier != "" else candidate_is_local or imported_scope.visible
                                candidate_accessible: bool = ewr_callable_name_visible(annotations, name, current_module, caller_module, position.line, position.offset) if candidate_visible else false
                                candidate_arity_viable: bool = true
                                candidate_scope_length: mutable usize = imported_scope.scope_length
                                candidate_scope_length <- ewr_qualified_module_rank(current_module, qualifier, caller_module, annotations, table) if qualifier != ""
                                candidate_scope_length <- ewr_local_scope_rank(current_module, caller_module) if qualifier == "" and candidate_is_local
                                ewr_callable_binding_consider_ranked(binding, candidate_scope_length, 0.usize(), false) if candidate_visible and not candidate_accessible and candidate_arity_viable
                        Decl.Module(module_name, module_body, _):
                            nested_module: sview @source = module_name
                            ewr_inaccessible_callable_binding_in_scope(module_body, name, qualifier, nested_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding)
                        Decl.Scoped(scoped_body, _):
                            ewr_inaccessible_callable_binding_in_scope(scoped_body, name, qualifier, current_module, caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding)
                        _:
                            pass

        def ewr_first_inaccessible_callable_binding(declarations: darray[Ast::Decl], name: sview, qualifier: sview @source, caller_module: sview @source, call_arity_known: bool, call_arity: usize, call_arguments: darray[Ast::Expr], call_argument_names: darray[sview @source], caller_parameters: darray[Ast::ParamDecl], caller_local_names: darray[sview], annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> EwrCallableBinding:
            can Memory.Allocate, Abort.Panic:
                binding: mutable EwrCallableBinding = ewr_empty_callable_binding()
                ewr_inaccessible_callable_binding_in_scope(declarations, name, qualifier, "", caller_module, call_arity_known, call_arity, call_arguments, call_argument_names, caller_parameters, caller_local_names, annotations, table, binding)
                return binding

        # Core's callNameHasOverloadSet checks each qualified candidate name's UFCS
        # registrations separately. Two visible singleton names do not become one
        # overload set just because both can be named by the same bare identifier.
        def ewr_callable_count_in_module(declarations: darray[Ast::Decl], name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                count: mutable usize = 0.usize()
                for declaration in declarations |count, name|:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            count <- count + 1.usize() if function_name == name
                        Decl.Extern(extern_name, _, _, _, callable, _, _, _):
                            count <- count + 1.usize() if callable and extern_name == name
                        Decl.Scoped(scoped_body, _):
                            count <- count + ewr_callable_count_in_module(scoped_body, name)
                        _:
                            pass
                return count
