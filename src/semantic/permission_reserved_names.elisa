# The builtin permission families that user alias declarations may not shadow. This set is
# narrower than the complete permission vocabulary: abstract effect families such as IO remain
# valid alias names, so the sealed alias surface must stay explicit.
module PermissionReservedNames:
    public:
        def is_sealed_alias_family(name: sview) -> bool can[Abort.Panic]:
            return match name:
                "Segment" | "Unsafe" | "Memory" | "Abort" | "Sync" | "Atomics" | "Console" | "Blocking" | "Global": true
                _: false

        def is_reserved_top_permission_declaration(owner: sview, name: sview) -> bool can[Abort.Panic]:
            return owner == "__permission_decl" and name == "any"
