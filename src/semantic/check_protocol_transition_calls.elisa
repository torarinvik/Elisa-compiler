# First consuming-transition slice: one by-value owned parameter, one return,
# one moved binding, one same-module graph edge. Everything else stays closed.
extend Semantic:
    private:
        def protocol_transition_call_parts(expression: Ast::Expr, target_state: mutable sview&, moved_name: mutable sview&, moved_pos: mutable Ast::Pos&, move_pos: mutable Ast::Pos&) -> bool:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_pos):
                    if arguments.count != 1 or argument_names.count != 1 or argument_names[0] != "":
                        return false
                    match callee:
                        Expr.Index(Expr.Ident(intrinsic, _), Expr.Ident(state_name, _), _):
                            return false if intrinsic != "transition"
                            target_state <- state_name
                        _:
                            return false
                    match arguments[0]:
                        Expr.Move(Expr.Ident(source_name, source_pos), source_move_pos):
                            moved_name <- source_name
                            moved_pos <- source_pos
                            move_pos <- source_move_pos
                            return true
                        _:
                            return false
                _:
                    return false

        def protocol_transition_function_id(table: SymbolTable&, name: sview, module_name: sview, position: Ast::Pos) -> (known: bool, id: DeclId):
            missing: DeclId = DeclId{value: 4294967295}
            found: mutable bool = false
            result: mutable DeclId = missing
            for symbol in table.symbols |found, result|:
                if symbol.kind == SymbolKind.Func and symbol.name == name and symbol.module_owner == module_name and symbol.line == position.line:
                    return (false, missing) if found
                    found <- true
                    result <- symbol.id
            return (found, result)

        def protocol_transition_try_admit(table: lmut SymbolTable, function_name: sview, module_name: sview, parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, body: darray[Ast::Stmt], function_pos: Ast::Pos) -> void:
            can Memory.Allocate, Abort.Panic:
                return if body.count != 1 or parameters.count != 1
                match body[0]:
                    Stmt.Return(value, _):
                        target_state: mutable sview = ""
                        moved_name: mutable sview = ""
                        moved_ident_pos: mutable Ast::Pos = Ast::pos_at_line(0)
                        move_pos: mutable Ast::Pos = Ast::pos_at_line(0)
                        if value is returned_expression:
                            return if not protocol_transition_call_parts(returned_expression, target_state, moved_name, moved_ident_pos, move_pos)
                            return if moved_name != parameters[0].name
                            owner_result: (known: bool, id: DeclId) = protocol_transition_function_id(table, function_name, module_name, function_pos)
                            return if not owner_result.known
                            binding_result: (known: bool, binding_id: BindingId) = ownership_binding_at_position(table, owner_result.id, moved_ident_pos)
                            return if not binding_result.known or binding_result.binding_id.owner.value != owner_result.id.value
                            return if not protocol_binding_owned_type(table, binding_result.binding_id)
                            source_identity: mutable BindingStateIdentity = BindingStateIdentity{known: false, family_id: DeclId{value: 4294967295}, state_index: 4294967295, protocol: false}
                            declaration_matches: mutable usize = 0
                            for declaration in table.binding_declared_types |source_identity, declaration_matches|:
                                if ownership_binding_ids_equal(declaration.binding_id, binding_result.binding_id):
                                    declaration_matches <- declaration_matches + 1
                                    source_identity <- declaration.state_identity
                            return if declaration_matches != 1 or not source_identity.known or not source_identity.protocol
                            if return_type is expected_return:
                                visited_source: mutable darray[u32] = []
                                rebind return_identity: BindingStateIdentity, table = resolve_binding_state_identity(expected_return, module_name, visited_source, table)
                                return if not return_identity.known or not return_identity.protocol or return_identity.family_id.value != source_identity.family_id.value
                                family_index: u32 = protocol_family_source_index(table, source_identity.family_id)
                                return if family_index == SYMBOL_INDEX_ROW_NONE
                                family: Ast::StateFamily = table.state_family_declarations[family_index.usize()]
                                return if source_identity.state_index.usize() >= family.states.count or return_identity.state_index.usize() >= family.states.count
                                return if target_state != family.states[return_identity.state_index.usize()]
                                return if not protocol_function_has_authority(table, source_identity.family_id, owner_result.id)
                                return if not protocol_state_edge_allowed(table, source_identity.family_id, source_identity.state_index, return_identity.state_index)
                                moves_for_source: mutable usize = 0
                                exact_move: mutable bool = false
                                for occurrence in table.binding_moves |moves_for_source, exact_move, move_pos, binding_result|:
                                    if occurrence.resolved and ownership_binding_ids_equal(occurrence.binding_id, binding_result.binding_id):
                                        moves_for_source <- moves_for_source + 1
                                        exact_move <- occurrence.pos.offset == move_pos.offset and occurrence.pos.end_offset == move_pos.end_offset
                                return if moves_for_source != 1 or not exact_move
                                table.protocol_transition_admitted <- table.protocol_transition_admitted.push(Ast::expr_pos(returned_expression))
                    _:
                        pass

        def check_protocol_transition_declarations(declarations: darray[Ast::Decl], module_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |module_name, table|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, _, _, function_pos):
                            table <- protocol_transition_try_admit(table, function_name, module_name, parameters, return_type, body, function_pos)
                        Decl.Module(child_module, body, _):
                            table <- check_protocol_transition_declarations(body, child_module, table)
                        Decl.Scoped(body, _):
                            table <- check_protocol_transition_declarations(body, module_name, table)
                        _:
                            pass

    public:
        def check_protocol_transition_calls(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_protocol_transition_declarations(file.top_decls, "", table)
                for candidate in table.protocol_transition_candidates |table|:
                    admitted: bool = any accepted in table.protocol_transition_admitted where accepted.offset == candidate.offset and accepted.end_offset == candidate.end_offset
                    if not admitted:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ProtocolTransitionRejected, name: "", pos: candidate, line: candidate.line, expected: "", actual: "requires one owned parameter returned through an authorized same-family edge in a straight-line function"})
