# Untyped empty-darray builder whose element type cannot be inferred. stage0 flags
# `xs = []` (no annotation, empty list literal) when it has a subsequent USE but its
# element type resolves from NONE of: the literal (empty), a push/extend use's argument
# type, or a `-> darray[T]` return fallback (a `return xs` from a darray-returning fn).
# (Ref: stage0 analyzer_flow_blocks.go inferUntypedDArrayBuilderLocals.)
#
# Stage1 has no type-resolution map, so this ports a SOUND SUBSET: an argument counts as
# "resolvable" whenever it is a literal, a plain ident, an index, or a list literal —
# i.e. exactly the shapes stage0's resolver (inferKnownDArrayBuilderExprType /
# inferSimpleLiteralTypeExpr) can bind, plus ident/index treated optimistically. Only a
# push/extend of a Binary/Unary/Call/Field argument — which stage0 ALSO cannot resolve —
# is unresolvable here. So `flag ⇒ stage0-flags` (never a false positive); a resolvable-
# looking use stage0 would actually reject is a sound miss.
extend Semantic:
    private:
        # Whether an EXPRESSION is an empty list literal `[]` (through parens).
        def udb_is_empty_list(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return udb_is_empty_list(inner)
                    Expr.Array(elements, array_line):
                        return elements.count == 0
                    _:
                        return false

        # Whether a push/extend ARGUMENT is one whose element type stage0 can bind: a literal,
        # a plain ident, an index, or a list literal. Binary/Unary/Call/Field are NOT (stage0's
        # resolver declines them too), so a builder pushed only such values stays unresolved.
        def udb_arg_resolvable(argument: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, paren_line):
                        return udb_arg_resolvable(inner)
                    Expr.IntLit(int_value):
                        return true
                    Expr.FloatLit(float_value):
                        return true
                    Expr.StringLit(string_value):
                        return true
                    Expr.CharLit(char_value):
                        return true
                    Expr.BoolLit(bool_value):
                        return true
                    Expr.Ident(ident_name, ident_line):
                        return true
                    Expr.Index(index_object, index_argument, index_line):
                        return true
                    Expr.IndexN(indexn_object, indexn_arguments, indexn_line):
                        return true
                    Expr.Array(array_elements, array_line):
                        return true
                    _:
                        return false

        # Whether EXPRESSION contains a builder-typed USE of `name`: `name.push/extend/...`,
        # `name.count/capacity/items`, or `name[...]`.
        def udb_expr_uses(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        if callee is Expr.Field(method_object, method_field, method_line):
                            if ident_name_of(method_object) == name:
                                true return if method_field == "push" or method_field == "extend" or method_field == "reserve" or method_field == "resize" or method_field == "clear" or method_field == "truncate" or method_field == "as_sview" or method_field == "as_cstr"
                        true return if udb_expr_uses(callee, name)
                        for argument in arguments:
                            true return if udb_expr_uses(argument, name)
                        return false
                    Expr.Field(object, field, field_line):
                        if ident_name_of(object) == name:
                            true return if field == "count" or field == "capacity" or field == "items"
                        return udb_expr_uses(object, name)
                    Expr.Index(object, index_argument, index_line):
                        true return if ident_name_of(object) == name
                        return udb_expr_uses(object, name) or udb_expr_uses(index_argument, name)
                    Expr.Binary(left, operator, right, binary_line):
                        return udb_expr_uses(left, name) or udb_expr_uses(right, name)
                    Expr.Unary(operator, operand, unary_line) | Expr.Paren(operand, unary_line):
                        return udb_expr_uses(operand, name)
                    _:
                        return false

        # Whether EXPRESSION contains a `name.push(arg)` / `name.extend(arg)` whose ARG is
        # resolvable (so the builder's element type is pinned).
        def udb_expr_resolvable_push(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        if callee is Expr.Field(method_object, method_field, method_line):
                            if ident_name_of(method_object) == name and (method_field == "push" or method_field == "extend") and arguments.count == 1:
                                true return if udb_arg_resolvable(arguments[0])
                        true return if udb_expr_resolvable_push(callee, name)
                        for argument in arguments:
                            true return if udb_expr_resolvable_push(argument, name)
                        return false
                    Expr.Binary(left, operator, right, binary_line):
                        return udb_expr_resolvable_push(left, name) or udb_expr_resolvable_push(right, name)
                    Expr.Unary(operator, operand, unary_line) | Expr.Paren(operand, unary_line):
                        return udb_expr_resolvable_push(operand, name)
                    _:
                        return false

        # Statement-level flavors of the three probes, each recursing into nested bodies.
        def udb_stmt_uses(statement: Ast::Stmt, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, line):
                        return udb_expr_uses(expression, name)
                    Stmt.VarDecl(decl_name, decl_type, decl_value, decl_line):
                        return udb_expr_uses(decl_value, name)
                    Stmt.Assign(target, operator, value, assign_line):
                        return udb_expr_uses(value, name) or udb_expr_uses(target, name)
                    Stmt.Return(value, return_line):
                        return udb_expr_uses(returned, name) if value is returned else false
                    Stmt.If(condition, then_body, else_body, if_line):
                        return udb_any_uses(then_body, name) or udb_any_uses(else_body, name)
                    Stmt.While(while_condition, while_body, while_line):
                        return udb_any_uses(while_body, name)
                    Stmt.For(bind, variables, iterable, for_body, for_line):
                        return udb_any_uses(for_body, name)
                    Stmt.Block(block_kind, clause, binding, block_body, block_line):
                        return udb_any_uses(block_body, name)
                    Stmt.Match(scrutinee, arms, match_line):
                        for arm in arms:
                            true return if udb_any_uses(arm.body, name)
                        return false
                    _:
                        return false

        def udb_any_uses(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    true return if udb_stmt_uses(statement, name)
                return false

        def udb_stmt_resolvable(statement: Ast::Stmt, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, line):
                        return udb_expr_resolvable_push(expression, name)
                    Stmt.VarDecl(decl_name, decl_type, decl_value, decl_line):
                        return udb_expr_resolvable_push(decl_value, name)
                    Stmt.Assign(target, operator, value, assign_line):
                        return udb_expr_resolvable_push(value, name)
                    Stmt.Return(value, return_line):
                        return udb_expr_resolvable_push(returned, name) if value is returned else false
                    Stmt.If(condition, then_body, else_body, if_line):
                        return udb_any_resolvable(then_body, name) or udb_any_resolvable(else_body, name)
                    Stmt.While(while_condition, while_body, while_line):
                        return udb_any_resolvable(while_body, name)
                    Stmt.For(bind, variables, iterable, for_body, for_line):
                        return udb_any_resolvable(for_body, name)
                    Stmt.Block(block_kind, clause, binding, block_body, block_line):
                        return udb_any_resolvable(block_body, name)
                    Stmt.Match(scrutinee, arms, match_line):
                        for arm in arms:
                            true return if udb_any_resolvable(arm.body, name)
                        return false
                    _:
                        return false

        def udb_any_resolvable(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    true return if udb_stmt_resolvable(statement, name)
                return false

        def udb_stmt_returns(statement: Ast::Stmt, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Return(value, return_line):
                        return ident_name_of(returned) == name if value is returned else false
                    Stmt.If(condition, then_body, else_body, if_line):
                        return udb_any_returns(then_body, name) or udb_any_returns(else_body, name)
                    Stmt.While(while_condition, while_body, while_line):
                        return udb_any_returns(while_body, name)
                    Stmt.For(bind, variables, iterable, for_body, for_line):
                        return udb_any_returns(for_body, name)
                    Stmt.Block(block_kind, clause, binding, block_body, block_line):
                        return udb_any_returns(block_body, name)
                    Stmt.Match(scrutinee, arms, match_line):
                        for arm in arms:
                            true return if udb_any_returns(arm.body, name)
                        return false
                    _:
                        return false

        def udb_any_returns(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    true return if udb_stmt_returns(statement, name)
                return false

        # Analyze one statement-block: flag each untyped empty-builder decl whose element type
        # is unresolvable, then recurse into nested block bodies.
        def udb_analyze_block(statements: darray[Ast::Stmt], fn_returns_darray: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < statements.count |index, table| -> table:
                    match statements[index]:
                        # `xs = []` (untyped, `=` declares a fresh binding) is a Stmt.Assign in
                        # stage1's grammar (stage0 makes it a VarDeclStmt). An annotated
                        # `xs: darray[T] = []` is a Stmt.VarDecl WITH a type — never a candidate.
                        Stmt.Assign(target, operator, value, decl_line):
                            name: sview = ident_name_of(target) if operator == TokenKind.Assign else sview("", 0, 0)
                            is_untyped_empty: bool = name != "" and udb_is_empty_list(value)
                            if is_untyped_empty:
                                has_use: mutable bool = false
                                resolvable: mutable bool = false
                                returned: mutable bool = false
                                shadowed: mutable bool = false
                                probe: mutable usize = index + 1
                                while probe < statements.count |probe, has_use, resolvable, returned, shadowed|:
                                    if not shadowed:
                                        match statements[probe]:
                                            Stmt.Assign(shadow_target, shadow_operator, shadow_value, shadow_line):
                                                shadowed <- true if shadow_operator == TokenKind.Assign and ident_name_of(shadow_target) == name
                                            Stmt.VarDecl(shadow_name, shadow_type, shadow_value2, shadow_line2):
                                                shadowed <- true if shadow_name == name
                                            _:
                                                pass
                                        if not shadowed:
                                            has_use <- true if udb_stmt_uses(statements[probe], name)
                                            resolvable <- true if udb_stmt_resolvable(statements[probe], name)
                                            returned <- true if udb_stmt_returns(statements[probe], name)
                                    probe <- probe + 1
                                fallback: bool = fn_returns_darray and returned
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UntypedEmptyBuilder, name: name, line: decl_line.line, expected: "", actual: ""}) if has_use and not resolvable and not fallback
                        _:
                            pass
                    index <- index + 1
                # Recurse into nested block bodies (builders declared there are their own block).
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- udb_analyze_block(then_body, fn_returns_darray, table)
                            table <- udb_analyze_block(else_body, fn_returns_darray, table)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- udb_analyze_block(while_body, fn_returns_darray, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- udb_analyze_block(for_body, fn_returns_darray, table)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            table <- udb_analyze_block(block_body, fn_returns_darray, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- udb_analyze_block(arm.body, fn_returns_darray, table)
                        _:
                            pass

        # Whether a return type names `darray` (bare, or `darray[T]` head).
        def udb_type_is_darray(return_type: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match return_type:
                    Expr.Ident(name, ident_line):
                        return name == "darray"
                    Expr.Index(object, index_argument, index_line):
                        return ident_name_of(object) == "darray"
                    Expr.IndexN(object_n, arguments_n, indexn_line):
                        return ident_name_of(object_n) == "darray"
                    _:
                        return false

        def udb_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            fn_returns_darray: bool = udb_type_is_darray(present_return) if return_type is present_return else false
                            table <- udb_analyze_block(body, fn_returns_darray, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- udb_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- udb_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_untyped_darray_builder(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- udb_walk(declarations, table)
