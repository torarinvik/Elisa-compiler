# Stage1 abstract-effect validation — HANDLER FACTS: which handler a declaration targets, where it
# was declared, how many values an installation captures, and whether two effect references name
# the same compile-time specialization (handler selection is a specialization, so the family and
# its arguments must both agree). Continues check_abstract_effects.elisa.

extend Semantic:
    private:

        def ae_handler_declared(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__handler_decl" and annotation.name == handler_name



        # Abstract-effect helpers are checked as templates. Their source bodies may contain
        # unresolved abstract operation calls by design; the parser has already produced one
        # direct clone for each reachable static handler installation. Ordinary functions
        # still go through the unhandled-operation check below.
        def ae_effect_template_declared(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, line: u32) -> bool:
            can Abort.Panic:
                template: bool = any annotation in annotations where annotation.owner == "__effect_template" and annotation.name == function_name and annotation.line == line
                clone: bool = any annotation in annotations where annotation.owner == "__effect_clone" and annotation.name == function_name and annotation.line == line
                return template and clone



        def ae_effect_template_callee_name(callee: Ast::Expr) -> sview:
            can Abort.Panic:
                match callee:
                    Expr.Ident(name, position):
                        return name
                    Expr.Scope(object, name, position):
                        return name
                    Expr.Index(object, argument, position):
                        return ae_effect_template_callee_name(object)
                    Expr.IndexN(object, arguments, position):
                        return ae_effect_template_callee_name(object)
                    _:
                        pass
                return ""



        def ae_effect_template_has_clone(annotations: darray[Ast::EnumAnnotation]&, function_name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__effect_clone" and annotation.name == function_name



        def ae_handler_target(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview) -> sview:
            can Abort.Panic:
                while index < annotations.count |index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    annotation.name return if annotation.line == 3900000084 and annotation.owner == handler_name
                    index <- index + 1
                return ""



        def ae_handler_decl_line(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview) -> u32:
            can Abort.Panic:
                while index < annotations.count |index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    return annotation.line if annotation.owner == "__handler_decl" and annotation.name == handler_name
                    index <- index + 1
                return 0



        def ae_handler_capture_counts(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview, required: mutable u32&, total: mutable u32&) -> void:
            can Abort.Panic:
                while index < annotations.count |index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    required <- annotation.line if annotation.owner == "__handler_capture_required" and annotation.name == handler_name
                    total <- annotation.line if annotation.owner == "__handler_capture_total" and annotation.name == handler_name
                    index <- index + 1



        # The capture count marker follows the matching install marker. Searching only
        # until the next installation keeps separate installations of different handlers
        # independent, while avoiding any runtime-shaped metadata in the AST.
        def ae_install_capture_count_after(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview, install_line: u32) -> u32:
            can Abort.Panic:
                found_install: mutable bool = false
                while index < annotations.count |index: usize = 0, found_install|:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    if not found_install:
                        found_install <- true if annotation.owner == "__effect_install" and annotation.name == handler_name and annotation.line == install_line
                    else:
                        return 0 if annotation.owner == "__effect_install"
                        return annotation.line if annotation.owner == "__effect_install_capture_count" and annotation.name == handler_name
                    index <- index + 1
                return 0



        # Handler selection is a compile-time specialization, so the family and
        # every generic argument must agree. Whitespace inside the brackets is
        # insignificant, matching the formatter's normalized type spelling.
        def ae_effect_ref_same_specialization(left: sview, right: sview) -> bool:
            left_abstract: sview = effect_ref_abstract(left)
            right_abstract: sview = effect_ref_abstract(right)
            left_family: sview = effect_ref_family(left_abstract)
            right_family: sview = effect_ref_family(right_abstract)
            return false if left_family != right_family
            left_bracket: mutable usize = sview_len(left_abstract)
            right_bracket: mutable usize = sview_len(right_abstract)
            while left_bracket > 0.usize():
                left_bracket <- left_bracket - 1.usize()
                break if sview_at(left_abstract, left_bracket) == 91
            while right_bracket > 0.usize():
                right_bracket <- right_bracket - 1.usize()
                break if sview_at(right_abstract, right_bracket) == 91
            return true if left_bracket == 0.usize() and right_bracket == 0.usize()
            return false if left_bracket == 0.usize() or right_bracket == 0.usize()
            left_index: mutable usize = left_bracket
            right_index: mutable usize = right_bracket
            while left_index < sview_len(left_abstract) and right_index < sview_len(right_abstract) |left_index, right_index|:
                while left_index < sview_len(left_abstract) and (sview_at(left_abstract, left_index) == 32 or sview_at(left_abstract, left_index) == 9) |left_index|:
                    left_index <- left_index + 1.usize()
                while right_index < sview_len(right_abstract) and (sview_at(right_abstract, right_index) == 32 or sview_at(right_abstract, right_index) == 9) |right_index|:
                    right_index <- right_index + 1.usize()
                return false if left_index >= sview_len(left_abstract) or right_index >= sview_len(right_abstract)
                return false if sview_at(left_abstract, left_index) != sview_at(right_abstract, right_index)
                left_index <- left_index + 1.usize()
                right_index <- right_index + 1.usize()
            while left_index < sview_len(left_abstract) and (sview_at(left_abstract, left_index) == 32 or sview_at(left_abstract, left_index) == 9) |left_index|:
                left_index <- left_index + 1.usize()
            while right_index < sview_len(right_abstract) and (sview_at(right_abstract, right_index) == 32 or sview_at(right_abstract, right_index) == 9) |right_index|:
                right_index <- right_index + 1.usize()
            return left_index == sview_len(left_abstract) and right_index == sview_len(right_abstract)



        def ae_is_hidden_handler_name(name: sview) -> bool:
            return (sview_len(name) >= 11.usize() and name[0:11] == "__handler__") or (sview_len(name) >= 10.usize() and name[0:10] == "__effect__")
