# Stage1 semantic — `diagnostic_message` part 2 of 4 (`extend Semantic: private:`):
# the wording for contract, refinement, and effect diagnostics.
#
# One `match diagnostic.kind:` arm per kind does not fit in a 600-line file, so the arms
# are split across parts and each part reports through `handled`. A part that matches no
# arm leaves `handled` false and the dispatcher in semantic_api.elisa tries the next one,
# so an unmatched kind still reaches every part exactly as one flat match would.

extend Semantic:
    private:
        def diagnostic_effect_ref(diagnostic: Diagnostic, index: usize) -> sview:
            return diagnostic.effect_ref_1 if index == 0.usize()
            return diagnostic.effect_ref_2 if index == 1.usize()
            return diagnostic.effect_ref_3 if index == 2.usize()
            return diagnostic.effect_ref_4 if index == 3.usize()
            return diagnostic.effect_ref_5 if index == 4.usize()
            return diagnostic.effect_ref_6 if index == 5.usize()
            return diagnostic.effect_ref_7 if index == 6.usize()
            return diagnostic.effect_ref_8 if index == 7.usize()
            return ""

        def diagnostic_effect_family_seen(diagnostic: Diagnostic, index: usize, family: sview) -> bool:
            can Abort.Panic:
                while prior < index |prior: usize = 0|:
                    true return if effect_ref_family(diagnostic_effect_ref(diagnostic, prior)) == family
                    prior <- prior + 1.usize()
                return false

        def diagnostic_message_part2(diagnostic: Diagnostic, buffer: mutable darray[u8]&, handled: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                handled <- true
                match diagnostic.kind:
                    DiagnosticKind.DiscardedCallResult:
                        buffer.extend(f"result of \"{diagnostic.name}\" (returns {diagnostic.expected}) is discarded; assign it or discard explicitly with _ =")

                    DiagnosticKind.VoidValueUse:
                        buffer.extend(f"cannot bind void expression to \"{diagnostic.expected}\" (the initializer produces no value)") if diagnostic.expected != ""
                        buffer.extend(f"\"{diagnostic.name}\" returns void; its call cannot be used as a value") if diagnostic.expected == ""

                    DiagnosticKind.LiteralArgTypeMismatch:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.OversizedShift:
                        push_str(buffer, "shift count is out of range for every integer width (valid range 0..63)")

                    DiagnosticKind.NegativeShift:
                        push_str(buffer, "shift count is negative")

                    DiagnosticKind.LiteralAssignOutOfRange:
                        push_str(buffer, "integer literal ")
                        push_str(buffer, "-") if diagnostic.actual_count != 0
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " does not fit in ")
                        push_sview(buffer, diagnostic.expected)

                    DiagnosticKind.LiteralComparisonImpossible:
                        buffer.extend(f"comparison is always vacuous for {diagnostic.expected}")

                    DiagnosticKind.DuplicateVariantField:
                        buffer.extend(f"duplicate payload field \"{diagnostic.name}\" in enum variant \"{diagnostic.actual}\".\"{diagnostic.expected}\"")

                    DiagnosticKind.IdenticalLogicalOperands:
                        buffer.extend(f"identical operands on both sides of \"{diagnostic.name}\"")

                    DiagnosticKind.IdenticalBranches:
                        push_str(buffer, "if and else branches are identical")

                    DiagnosticKind.EmptyIterable:
                        push_str(buffer, "empty list literal requires an expected array or darray type")

                    DiagnosticKind.UnusedImport:
                        buffer.extend(f"import \"{diagnostic.name}\" is never used")

                    DiagnosticKind.FloatEquality:
                        push_str(buffer, "floating-point equality comparison is unreliable; use a tolerance")

                    DiagnosticKind.NegativeIndex:
                        push_str(buffer, "constant index -")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" out of bounds for {diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "]")

                    DiagnosticKind.DuplicatePatternBinding:
                        buffer.extend(f"name {diagnostic.name} bound more than once in pattern")

                    DiagnosticKind.ImmediateOverwrite:
                        buffer.extend(f"value assigned to {diagnostic.name} is immediately overwritten")

                    DiagnosticKind.ModuloByZero:
                        push_str(buffer, "modulo by zero")

                    DiagnosticKind.ShiftByZero:
                        push_str(buffer, "shift by zero has no effect")

                    DiagnosticKind.LogicalConstantOperand:
                        push_str(buffer, "logical operator with constant boolean operand")

                    DiagnosticKind.DuplicateDecorator:
                        buffer.extend(f"duplicate @{diagnostic.name} annotation on function \"{diagnostic.expected}\" (first seen at line ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, ":")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, ")")

                    DiagnosticKind.RedundantContinue:
                        push_str(buffer, "redundant continue at end of loop body")

                    DiagnosticKind.NegatedComparison:
                        push_str(buffer, "negated equality comparison; use the opposite operator")

                    DiagnosticKind.FieldAccessOnPrimitive:
                        buffer.extend(f"field access requires struct type, got {diagnostic.actual}")

                    DiagnosticKind.IndexNonIndexable:
                        buffer.extend(f"indexing requires string, array, view, packed store, or reference type, got {diagnostic.actual}")

                    DiagnosticKind.FirmArgTypeMismatch:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.RefArgValueParam:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.name}\" expects {diagnostic.expected}, got mutable {diagnostic.actual}&")

                    DiagnosticKind.NonBoolMatchGuard:
                        buffer.extend(f"match arm guard must be bool, got {diagnostic.actual}")

                    DiagnosticKind.RedundantCast:
                        buffer.extend(f"warning: redundant `.cast[{diagnostic.name}]`: the operand already has type {diagnostic.name}; remove the cast")

                    DiagnosticKind.UnknownFieldAccess:
                        buffer.extend(f"struct \"{diagnostic.expected}\" has no field \"{diagnostic.name}\"")

                    DiagnosticKind.ConstructFieldTypeMismatch:
                        buffer.extend(f"struct literal field \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.NamedTypeMismatch:
                        expected_is_container: bool = diagnostic.expected in {"darray", "dict", "set", "list", "array"}
                        buffer.extend(f"return type expects {diagnostic.expected}" if diagnostic.name == "return" else f"variable \"{diagnostic.name}\" expects {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and expected_is_container
                        # An OPTIONAL value spells `base?` — stage0 keeps the wrapper. For this
                        # kind `detail` is normally the container ELEMENT and gets bracketed;
                        # when `actual` is the optional family it is the base instead, so the
                        # bracketing must not fire.
                        value_optional: bool = diagnostic.actual == "optional" and diagnostic.detail != ""
                        buffer.extend(f", got {diagnostic.detail}?") if value_optional
                        buffer.extend(f", got {diagnostic.actual}") if not value_optional
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and not expected_is_container and not value_optional

                    DiagnosticKind.VoidArgument:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.name}\" expects {diagnostic.expected}, got void") if diagnostic.expected != ""
                        buffer.extend(f" to \"{diagnostic.name}\" cannot be void") if diagnostic.expected == ""

                    DiagnosticKind.NonNumericShiftOperand:
                        push_str(buffer, "operator requires numeric operands")

                    DiagnosticKind.CompoundAssignNonNumeric:
                        push_str(buffer, "augmented assignment requires numeric operands")

                    DiagnosticKind.StringIndexNonNumeric:
                        buffer.extend(f"index must be numeric, got {diagnostic.actual}")

                    # `name` carries stage0's own word for the bound, "start" or "end" —
                    # stage0 prints "slice start must be numeric" / "slice end must be …",
                    # so the two bounds differ only in that word.
                    DiagnosticKind.SliceBoundNonNumeric:
                        buffer.extend(f"slice {diagnostic.name} must be numeric, got {diagnostic.actual}")

                    DiagnosticKind.SliceBoundNonIntegral:
                        buffer.extend(f"slice {diagnostic.name} must be integral, got {diagnostic.actual}")

                    DiagnosticKind.VoidFieldAccess:
                        push_str(buffer, "field access requires struct type, got void")

                    DiagnosticKind.VoidIndex:
                        push_str(buffer, "indexing requires string, array, view, packed store, or reference type, got void")

                    DiagnosticKind.CallNonFunction:
                        buffer.extend(f"cannot call non-function value of type {diagnostic.actual}")

                    DiagnosticKind.UfcsAmbiguousCall:
                        buffer.extend(f"UFCS call \"{diagnostic.name}\" on {diagnostic.expected} is ambiguous")

                    DiagnosticKind.ShiftOperandNonIntegral:
                        push_str(buffer, "operator requires integral operands")

                    DiagnosticKind.VoidOperand:
                        push_str(buffer, "operator requires numeric operands")

                    DiagnosticKind.VoidCondition:
                        buffer.extend(f"{diagnostic.name} condition must be bool, got void") if diagnostic.name != ""
                        push_str(buffer, "condition must be bool, got void") if diagnostic.name == ""

                    DiagnosticKind.TernaryBranchMismatch:
                        buffer.extend(f"ternary branches are incompatible: {diagnostic.expected} and {diagnostic.actual}")

                    DiagnosticKind.ArrayLiteralElementTypeMismatch:
                        buffer.extend(f"array literal element expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.StringIndexNonIntegral:
                        buffer.extend(f"index must be integral, got {diagnostic.actual}")

                    DiagnosticKind.VoidCollectionElement:
                        buffer.extend(f"darray literal element expects {diagnostic.expected}, got void") if diagnostic.expected != ""
                        push_str(buffer, "collection element cannot be void") if diagnostic.expected == ""

                    DiagnosticKind.VoidUnaryOperand:
                        push_str(buffer, "unary operator requires numeric operand")

                    DiagnosticKind.VoidMatchScrutinee:
                        push_str(buffer, "match requires an enum, const enum, error set, optional, integer, string, tuple, sequence, or struct value, got void")

                    # Same sentence as the void case above — stage0 uses ONE message for
                    # every unmatchable scrutinee and varies only the trailing type.
                    # Identical text to VoidUnaryOperand — stage0 uses one sentence for any
                    # non-numeric unary operand, void or not.
                    DiagnosticKind.DictIndexAssignToOptionalRef:
                        buffer.extend(f"cannot assign {diagnostic.expected} to mutable {diagnostic.actual}&?")

                    DiagnosticKind.RuntimeDictKeyUnsupported:
                        buffer.extend(f"runtime-backed dict keys must be cstr, an integer type, bool, or a const enum (any type with value equality); floats and aggregates are unsupported; got key type in dict[{diagnostic.expected}, {diagnostic.actual}]")

                    DiagnosticKind.UnaryOperandNonNumeric:
                        push_str(buffer, "unary operator requires numeric operand")

                    DiagnosticKind.MatchScrutineeNotMatchable:
                        # stage0 drops the word "sequence" in VALUE position (`r: i64 = match x:`)
                        # and keeps it in STATEMENT position (`match x:`). The check records
                        # which one it saw in `expected`.
                        buffer.extend(f"match requires an enum, const enum, error set, optional, integer, string, tuple, or struct value, got {diagnostic.actual}") if diagnostic.expected == "expr"
                        buffer.extend(f"match requires an enum, const enum, error set, optional, integer, string, tuple, sequence, or struct value, got {diagnostic.actual}") if diagnostic.expected != "expr"

                    DiagnosticKind.OrderingNonNumeric:
                        push_str(buffer, "comparison requires numeric operands")

                    # stage0 names BOTH bounds, in order: `expected` is lo, `actual` is hi.
                    DiagnosticKind.RangeBoundNonIntegral:
                        buffer.extend(f"for loop range requires integral bounds, got {diagnostic.expected} and {diagnostic.actual}")

                    DiagnosticKind.DArrayElementTypeMismatch:
                        buffer.extend(f"darray literal element expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.SetElementTypeMismatch:
                        buffer.extend(f"set literal element ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" has type {diagnostic.actual}, expected {diagnostic.expected}")

                    DiagnosticKind.DictValueTypeMismatch:
                        buffer.extend(f"dict literal value ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" has type {diagnostic.actual}, expected {diagnostic.expected}")

                    DiagnosticKind.DictKeyTypeMismatch:
                        buffer.extend(f"dict literal key ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" has type {diagnostic.actual}, expected {diagnostic.expected}")

                    DiagnosticKind.CallNamedNonFunction:
                        buffer.extend(f"cannot call non-function value of type {diagnostic.actual}")

                    DiagnosticKind.StructPatternTypeMismatch:
                        buffer.extend(f"struct pattern expects struct \"{diagnostic.expected}\", got \"{diagnostic.name}\"")

                    DiagnosticKind.MatchArmEnumMismatch:
                        buffer.extend(f"match arm expects enum \"{diagnostic.name}\", got \"{diagnostic.expected}\"")

                    DiagnosticKind.InvalidBoolCast:
                        buffer.extend(f"invalid cast from {diagnostic.expected} to {diagnostic.actual}")

                    DiagnosticKind.FieldImmutableAssign:
                        buffer.extend(f"field \"{diagnostic.name}\" is immutable")

                    DiagnosticKind.UngrantedPanic:
                        # `add can Abort.Panic`, NOT `add can[Abort.Panic]`. stage0 brackets the
                        # hint only when it names more than one permission (permissionGrantHint:
                        # a single ref WITH a member returns "can F.M" bare).
                        push_str(buffer, "warning: panic requires can[Abort] and has no explicit local effect grant; add can Abort.Panic or a surrounding can ...: block; missing required effect facts")

                    DiagnosticKind.UngrantedEffectCall:
                        # Full stage0 warning text when the effect ref is known; the
                        # generic wrap-it hint otherwise (callback-parameter sites).
                        # The hint is BARE for a single permission and BRACKETED for several —
                        # stage0's permissionGrantHint returns "can F.M" when exactly one ref
                        # carries a member, and " can[A.B, C.D]" otherwise. stage1 always
                        # bracketed, so every single-effect warning read `add can[Abort.Panic]`
                        # where stage0 writes `add can Abort.Panic`.
                        #
                        # A comma in the rendered list is the discriminator: `diagnostic.expected`
                        # already holds the canonicalized `F.M` items joined with ", ".
                        # BRACKETED unless the hint is exactly one permission WITH a member.
                        # stage0's permissionGrantHint returns a bare "can F.M" only for a
                        # single ref carrying a member; a lone family with no member
                        # (`can[Console]`) still brackets. So a comma is not the whole test —
                        # the ABSENCE of a "." brackets too.
                        multi_grant: mutable bool = true
                        has_member: mutable bool = false
                        has_comma: mutable bool = false
                        for grant_index in 0..<sview_len(diagnostic.expected) |has_comma, has_member, diagnostic|:
                            has_comma <- true if sview_at(diagnostic.expected, grant_index) == 44
                            has_member <- true if sview_at(diagnostic.expected, grant_index) == 46
                        multi_grant <- false if has_member and not has_comma
                        # Built in pieces: an f-string cannot interpolate a darray[u8], so the
                        # bare-vs-bracketed hint is appended rather than substituted.
                        if diagnostic.expected != "":
                            buffer.extend(f"warning: call to \"{diagnostic.name}\" requires can[") if diagnostic.effect_ref_count > 0
                            if diagnostic.effect_ref_count > 0:
                                family_count: mutable usize = 0.usize()
                                for ref_index in 0..<diagnostic.effect_ref_count.usize() |buffer, diagnostic, family_count|:
                                    required_ref: sview = diagnostic_effect_ref(diagnostic, ref_index)
                                    required_family: sview = effect_ref_family(required_ref)
                                    continue if diagnostic_effect_family_seen(diagnostic, ref_index, required_family)
                                    buffer.extend(", ") if family_count > 0.usize()
                                    push_sview(buffer, required_family)
                                    family_count <- family_count + 1.usize()
                                buffer.extend("] and has no explicit local effect grant; add ")
                                if diagnostic.effect_ref_count == 1 and not multi_grant:
                                    buffer.extend("can ")
                                    push_sview(buffer, diagnostic_effect_ref(diagnostic, 0.usize()))
                                else:
                                    buffer.extend("can[")
                                    for ref_index in 0..<diagnostic.effect_ref_count.usize() |buffer, diagnostic|:
                                        buffer.extend(", ") if ref_index > 0.usize()
                                        push_sview(buffer, diagnostic_effect_ref(diagnostic, ref_index))
                                    buffer.extend("]")
                                push_str(buffer, " or a surrounding can ...: block; missing required effect facts")
                            else:
                                buffer.extend(f"warning: call to \"{diagnostic.name}\" requires can[{diagnostic.actual}] and has no explicit local effect grant; add ")
                                buffer.extend(f"can[{diagnostic.expected}]") if multi_grant
                                buffer.extend(f"can {diagnostic.expected}") if not multi_grant
                                push_str(buffer, " or a surrounding can ...: block; missing required effect facts")
                        buffer.extend(f"call to \"{diagnostic.name}\" requires an enclosing effect grant; wrap it in a `can ...:` block") if diagnostic.expected == ""

                    DiagnosticKind.EffectHandlerMismatch:
                        buffer.extend(f"effect handler \"{diagnostic.name}\" realizes \"{diagnostic.expected}\", but this installation grants \"{diagnostic.actual}\"")

                    DiagnosticKind.EffectHandlerCaptureArity:
                        buffer.extend(f"effect handler \"{diagnostic.name}\" requires ") if diagnostic.actual == "required"
                        buffer.extend(f"effect handler \"{diagnostic.name}\" accepts at most ") if diagnostic.actual == "maximum"
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(" capture argument(s), got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.AbstractEffectUnhandled:
                        buffer.extend(f"abstract effect operation {diagnostic.expected}.{diagnostic.name} requires an installed handler")

                    DiagnosticKind.AbstractEffectOperationMissing:
                        buffer.extend(f"effect \"{diagnostic.expected}\" has no operation \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateAbstractEffectOperation:
                        buffer.extend(f"effect \"{diagnostic.expected}\" declares operation \"{diagnostic.name}\" more than once")

                    DiagnosticKind.EffectHandlerResumeInvalid:
                        buffer.extend(f"handler \"{diagnostic.actual}\" operation \"{diagnostic.name}\" is outside the zero-overhead resumable subset: {diagnostic.expected}")

                    DiagnosticKind.EffectHandlerSignatureMismatch:
                        buffer.extend(f"handler \"{diagnostic.actual}\" operation \"{diagnostic.name}\" does not match the abstract operation signature")

                    DiagnosticKind.AbstractEffectValue:
                        buffer.extend(f"abstract effect operation {diagnostic.expected}.{diagnostic.name} cannot be used as a value; call it directly in the zero-overhead effect subset")

                    DiagnosticKind.AbstractEffectSpecializationMismatch:
                        buffer.extend(f"abstract effect operation {diagnostic.expected}.{diagnostic.name} does not match the active handler specialization; runtime effect dispatch is unavailable in the zero-overhead effect subset")

                    DiagnosticKind.AbstractEffectSpecializationArity:
                        if diagnostic.actual == "operation":
                            buffer.extend(f"abstract effect specialization {diagnostic.expected} expects ")
                            push_int(buffer, diagnostic.expected_count.i64())
                            buffer.extend(" type argument(s), got ")
                            push_int(buffer, diagnostic.actual_count.i64())
                        else:
                            buffer.extend(f"handler \"{diagnostic.name}\" has invalid specialization of abstract effect \"{diagnostic.expected}\": expected ")
                            push_int(buffer, diagnostic.expected_count.i64())
                            buffer.extend(" type argument(s), got ")
                            push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.AbstractEffectUnknown:
                        buffer.extend(f"abstract effect family \"{diagnostic.name}\" is not declared")

                    DiagnosticKind.AbstractEffectImplementationAccess:
                        buffer.extend(f"compiler-generated static effect operation \"{diagnostic.name}\" is private; call the abstract operation inside a handler installation")

                    DiagnosticKind.ConcreteEffectPermissionUnknown:
                        buffer.extend(f"concrete effect permission \"{diagnostic.name}\" names unknown permission family \"{diagnostic.expected}\"")

                    DiagnosticKind.MachineDecreasesType:
                        buffer.extend(f"loop `decreases` measure must be an integer, got {diagnostic.actual}")

                    DiagnosticKind.TypestateWidenedByCall:
                        buffer.extend(f"parameter {diagnostic.name} must be left in its declared state before \"{diagnostic.expected}\" returns, but its state was widened by a call; restore it or declare the transition with `ensures {diagnostic.name} => <state>`")

                    DiagnosticKind.TypestateNotRestored:
                        buffer.extend(f"parameter {diagnostic.name} must be left in its declared state before \"{diagnostic.expected}\" returns, but it is left in state {diagnostic.actual}; restore it or declare the transition with `ensures {diagnostic.name} => <state>`")

                    DiagnosticKind.StaticError:
                        buffer.extend(f"static error: {diagnostic.name}")

                    DiagnosticKind.StaticEvalDepthExceeded:
                        push_str(buffer, "static function evaluation exceeded 64 calls")

                    DiagnosticKind.TypestateEnsuresUnproven:
                        buffer.extend(f"cannot prove ensures {diagnostic.name} => {diagnostic.expected} on function \"{diagnostic.actual}\"")

                    DiagnosticKind.ContractNotFirst:
                        push_str(buffer, "`requires`/`ensure` contracts must be the first statements of the function body")

                    DiagnosticKind.ContractEnsureResultVoid:
                        push_str(buffer, "`ensure` references `result`, but this function returns void (no result value to bind)")

                    DiagnosticKind.DictKeyAffine:
                        buffer.extend(f"dict keys cannot contain linear handles, got {diagnostic.actual}")

                    DiagnosticKind.SetElementAffine:
                        buffer.extend(f"set elements cannot contain linear handles, got {diagnostic.actual}")

                    DiagnosticKind.AffineAddress:
                        match diagnostic.expected:
                            "Thread":
                                push_str(buffer, "cannot take address of thread handle")
                            _:
                                push_str(buffer, "cannot take address of linear value")

                    DiagnosticKind.AffineGlobal:
                        buffer.extend(f"global \"{diagnostic.name}\" cannot store linear handle values of type {diagnostic.expected}")

                    DiagnosticKind.AffineReference:
                        buffer.extend(f"references to values containing linear handles are not supported; got {diagnostic.expected}&")

                    DiagnosticKind.AffineUseAfterConsume:
                        match diagnostic.expected:
                            "match":
                                buffer.extend(f"linear handle value \"{diagnostic.name}\" cannot be used: usage facts were consumed by match over affine enum")
                            _:
                                buffer.extend(f"linear handle value \"{diagnostic.name}\" cannot be used after ownership was consumed")

                    DiagnosticKind.AffineMoveRequired:
                        match diagnostic.expected:
                            "ThreadPool":
                                buffer.extend(f"thread pool owner \"{diagnostic.name}\" must be moved explicitly before move into local \"{diagnostic.actual}\"")
                            "TaskGroup":
                                buffer.extend(f"task group owner \"{diagnostic.name}\" must be moved explicitly before move into local \"{diagnostic.actual}\"")
                            "ThreadCall":
                                buffer.extend(f"thread handle \"{diagnostic.name}\" must be moved explicitly before argument to call \"{diagnostic.actual}\"")
                            "Return":
                                buffer.extend(f"linear value \"{diagnostic.name}\" must be moved explicitly before return")
                            _:
                                buffer.extend(f"linear value \"{diagnostic.name}\" must be moved explicitly before move into local \"{diagnostic.actual}\"")

                    DiagnosticKind.AffineScopeExit:
                        buffer.extend(f"{diagnostic.expected} handle \"{diagnostic.name}\" must be consumed before scope exit")

                    DiagnosticKind.UnusedDecreases:
                        buffer.extend(f"warning: `decreases` on \"{diagnostic.name}\", which makes no direct recursive call; the termination clause is unused")

                    DiagnosticKind.GhostFieldDefault:
                        buffer.extend(f"ghost field \"{diagnostic.name}\" cannot have a default value: it is verification-only and erased, so it has no runtime initializer; assign it in a `ghost`/contract context instead")

                    DiagnosticKind.GhostLocalRead:
                        buffer.extend(f"ghost variable \"{diagnostic.name}\" is verification-only and cannot be read by real code: it is erased from codegen, so it may appear only in contracts (requires/ensure/invariant/assert) or another `ghost` declaration")

                    DiagnosticKind.ConstEnumStorageNotInt:
                        buffer.extend(f"const enum \"{diagnostic.name}\" storage type must be an explicit integer type, got {diagnostic.expected}")

                    DiagnosticKind.ConstEnumValueOutOfRange:
                        buffer.extend(f"const enum member \"{diagnostic.name}\".\"{diagnostic.expected}\" value ")
                        push_str(buffer, "-") if diagnostic.actual_count != 0
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" does not fit storage type {diagnostic.actual}")

                    DiagnosticKind.RaiseWithoutErrorSet:
                        push_str(buffer, "raise requires the current function to return an error union")

                    DiagnosticKind.RegionAnnotationOnScalarField:
                        buffer.extend(f"region annotation `@{diagnostic.actual}` is only supported on container, generic, and reference types")

                    DiagnosticKind.DuplicateBitGroupMember:
                        buffer.extend(f"duplicate packed group member \"{diagnostic.name}\" in {diagnostic.expected}.{diagnostic.actual}")

                    DiagnosticKind.NamedStatesWithoutDerive:
                        buffer.extend(f"struct \"{diagnostic.name}\" declares named states but is missing a derive state: block")

                    DiagnosticKind.DerivedStateConstructorMismatch:
                        buffer.extend(f"constructed {diagnostic.name} does not satisfy derived state {diagnostic.expected}")

                    DiagnosticKind.DerivedStateArgumentMismatch:
                        buffer.extend(f"argument to \"{diagnostic.name}\" expects {diagnostic.detail}[{diagnostic.expected}], got {diagnostic.detail}[{diagnostic.actual}]")

                    DiagnosticKind.UngrantedPointerCast:
                        push_str(buffer, "warning: ") if diagnostic.detail == "warn"
                        buffer.extend(f"pointer cast requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.PointerCast or a surrounding can ...: block; missing required effect facts")

                    DiagnosticKind.DenseNodeKeyRootMismatch:
                        buffer.extend(f"node key and frozen store must share the same exact frozen store root")

                    DiagnosticKind.ThreadTransferStoreDependency:
                        buffer.extend(f"argument to \"{diagnostic.name}\" cannot cross thread boundary: store dependency facts require rebase to frozen/public store")

                    DiagnosticKind.ThreadTransferRegionDependency:
                        buffer.extend(f"argument to \"{diagnostic.name}\" cannot cross thread boundary: region dependency facts include local region \"{diagnostic.actual}\"")

                    DiagnosticKind.FlowFlagStateMachine:
                        buffer.extend(f"mutable bool flag \"{diagnostic.name}\" is written in multiple branches and read after the join; this encodes a state machine — flatten the flow")

                    DiagnosticKind.IfValueMissingElse:
                        buffer.extend(f"an `if` used as a value must have a final `else`")

                    DiagnosticKind.TuplePatternArityMismatch:
                        push_str(buffer, "tuple pattern expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " elements, got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.OrPatternBindingMismatch:
                        # Wording matches stage0 exactly ("with compatible types"); diagnostics_diff
                        # compares normalized message TEXT, so a shorter paraphrase reads as a
                        # missing stage0 diagnostic.
                        buffer.extend(f"or-pattern alternatives must bind the same names with compatible types")

                    DiagnosticKind.MembershipRhsContainer:
                        push_str(buffer, "membership operator requires a list literal or tokenset on the right-hand side, got ")
                        push_sview(buffer, diagnostic.actual if diagnostic.actual != "" else "container")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != ""

                    DiagnosticKind.DarrayPushTypeMismatch:
                        buffer.extend(f"darray push expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.DictIndexKeyTypeMismatch:
                        buffer.extend(f"dict index expects key of type {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.InvalidCtorCast:
                        buffer.extend(f"invalid cast from {diagnostic.actual} to {diagnostic.expected}")

                    DiagnosticKind.NamespaceUsedAsValue:
                        buffer.extend(f"\"{diagnostic.name}\" is a namespace; write {diagnostic.name}::")
                        push_sview(buffer, diagnostic.expected if diagnostic.expected != "" else "member")
                        # The CALL form carries stage0's `(...)`: a namespace used as a callee
                        # reads `write M::geti(...)`, the plain field form `write M::geti`.
                        push_str(buffer, "(...)") if diagnostic.actual == "call"
                        # stage0's parenthetical, which stage1 had INVERTED — it told the reader that
                        # `::` reaches value members and `.` reaches namespaces, the exact
                        # opposite of the rule, in the one message whose job is to teach it.
                        push_str(buffer, " (`.` accesses value members, `::` accesses namespaces)")

                    DiagnosticKind.PackedMoveStoreMismatch:
                        buffer.extend(f"packed enum move-as over \"{diagnostic.expected}\" requires store type \"{diagnostic.expected}.Store\", got {diagnostic.actual}.Store")

                    DiagnosticKind.RecordUpdateUnknownField:
                        buffer.extend(f"record update has no field \"{diagnostic.name}\"")

                    DiagnosticKind.ModuloOperandNonIntegral:
                        push_str(buffer, "operator requires integral operands")

                    DiagnosticKind.ArrayIndexNonIntegral:
                        buffer.extend(f"index must be integral, got {diagnostic.actual}")

                    DiagnosticKind.RangeStepZero:
                        push_str(buffer, "for loop range step cannot be zero")

                    DiagnosticKind.MoveStructPatternArityMismatch:
                        buffer.extend(f"move-as pattern \"{diagnostic.name}\" expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " bindings, got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.LetDestructureUnknownField:
                        buffer.extend(f"struct \"{diagnostic.expected}\" has no field \"{diagnostic.name}\"")

                    DiagnosticKind.UnknownFunctionAnnotation:
                        buffer.extend(f"unknown function annotation @{diagnostic.name}")

                    DiagnosticKind.UnknownExternFunctionAnnotation:
                        buffer.extend(f"unknown extern function annotation @{diagnostic.name} on \"{diagnostic.expected}\"")

                    DiagnosticKind.TestFunctionParameters:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must not take parameters")

                    DiagnosticKind.BenchFunctionNonVoidReturn:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must return void, got {diagnostic.actual}")

                    DiagnosticKind.GenericFixtureFunction:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must not have type or shape parameters")

                    DiagnosticKind.AnnotatedFunctionPermissions:
                        buffer.extend(f"@{diagnostic.expected} function \"{diagnostic.name}\" must not require permissions")

                    DiagnosticKind.GuardNonnullNonOptionalParam:
                        buffer.extend(f"@guard_nonnull on function \"{diagnostic.expected}\" requires a nullable reference or optional parameter, got {diagnostic.actual}")

                    DiagnosticKind.GenericInterfaceBoundUnsatisfied:
                        buffer.extend(f"type \"{diagnostic.actual}\" does not satisfy required interface fact \"{diagnostic.expected}\" for type argument")

                    DiagnosticKind.GenericOperatorNoBound:
                        buffer.extend(f"operator \"{diagnostic.expected}\" used on unbound generic type parameter \"{diagnostic.name}\" in \"{diagnostic.actual}\" -- add an interface bound (e.g. [{diagnostic.name}: Add]) or it is not guaranteed to support this operator")

                    DiagnosticKind.ExternBorrowUnknownParam:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" references unknown parameter \"{diagnostic.name}\"")

                    DiagnosticKind.ExternBorrowNonProvenanceParam:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" cannot borrow from parameter \"{diagnostic.name}\" of type {diagnostic.actual}")

                    DiagnosticKind.ExternBorrowFieldNonStructReturn:
                        buffer.extend(f"@borrows_return(field, …) on extern function \"{diagnostic.expected}\" requires a concrete struct return type, got {diagnostic.actual}")

                    DiagnosticKind.ExternBorrowUnknownReturnField:
                        buffer.extend(f"@borrows_return on extern function \"{diagnostic.expected}\" references unknown return field path \"{diagnostic.name}\" in {diagnostic.actual}")

                    DiagnosticKind.ThreadArgumentNotShareable:
                        buffer.extend(f"argument to \"{diagnostic.name}\" is not structurally shareable across threads: non-static reference")

                    DiagnosticKind.ThreadResultNotShareable:
                        buffer.extend(f"result of \"{diagnostic.name}\" is not structurally shareable across threads: non-static reference")

                    DiagnosticKind.ArraySliceEndOutOfBounds:
                        push_str(buffer, "constant slice end ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, " out of bounds for array of length ")
                        push_int(buffer, diagnostic.expected_count.i64())

                    DiagnosticKind.ArraySliceReversed:
                        push_str(buffer, "constant slice start ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " is after end ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.RuntimeArraySize:
                        push_str(buffer, "array size must be a compile-time integer")

                    DiagnosticKind.FixedArrayShapeMismatch:
                        buffer.extend(f"return type expects {diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f"], got {diagnostic.actual}[")
                        push_int(buffer, diagnostic.actual_count.i64())
                        push_str(buffer, "]")
                    _:
                        handled <- false
