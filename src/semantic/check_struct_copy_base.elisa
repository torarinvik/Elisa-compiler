# Copy-update literal `Type{..base, field: value}`: the copy source must have the literal's
# struct type. The parser has already expanded the literal into an ordinary full `Construct`
# (parser_struct_copy_base.elisa) and recorded its base in File.struct_copy_bases, which the
# semantic entry copies into `table.struct_copy_bases`. The construct-field walker
# (check_construct_field_type) calls this at each `Construct`, where the enclosing locals'
# types are known. Parity: stage0's
#   struct literal "P" copy source `..base` must have type P, got Q
# A base whose type cannot be inferred is left alone (no false positive).
extend Semantic:
    private:
        # The bare struct name a literal's type expression names: `T`, `M::T`, `T[A]`.
        def copy_base_literal_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(_, name, _):
                        return name
                    Expr.Index(object, _, _):
                        return copy_base_literal_name(object)
                    Expr.IndexN(object, _, _):
                        return copy_base_literal_name(object)
                    _:
                        return ""

        # Whether type name `actual` names struct `expected`: equal, or `expected` qualified
        # (`M::expected` / `M.expected`).
        def copy_base_name_matches(actual: sview, expected: sview) -> bool:
            can Abort.Panic:
                true return if actual == expected
                actual_len: usize = sview_len(actual)
                expected_len: usize = sview_len(expected)
                false return if expected_len == 0 or actual_len <= expected_len
                offset: usize = actual_len - expected_len
                separator: u8 = sview_at(actual, offset - 1)
                false return if separator != 58 and separator != 46
                for index in 0..<expected_len |actual, expected, offset|:
                    false return if sview_at(actual, offset + index) != sview_at(expected, index)
                return true

        def check_struct_copy_base(type_expression: Ast::Expr, construct_pos: Ast::Pos, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if table.struct_copy_bases.count == 0
                expected: sview = copy_base_literal_name(type_expression)
                return if expected == ""
                bases: darray[Ast::StructCopyBase] = table.struct_copy_bases
                for record in bases |table, var_types, type_names, expected, construct_pos|:
                    continue if record.pos.line != construct_pos.line or record.pos.column != construct_pos.column or record.pos.offset != construct_pos.offset
                    actual_id: u32 = darray_referent_type_id(structural_type_id_of(record.base, var_types, type_names, table), table)
                    continue if actual_id == 0
                    actual_kind: SemTypeKind = interned_kind(actual_id, table)
                    continue if actual_kind == SemTypeKind.Unknown
                    named: bool = actual_kind == SemTypeKind.Named or actual_kind == SemTypeKind.Container
                    continue if named and copy_base_name_matches(interned_name(actual_id, table), expected)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructCopyBaseTypeMismatch, name: expected, pos: Ast::expr_pos(record.base), line: construct_pos.line, expected: expected, actual: diagnostic_name_of_row(actual_id, table)})
