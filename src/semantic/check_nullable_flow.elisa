extend Semantic:
    private:
        def nullable_index(names: darray[sview]&, name: sview) -> usize:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    index return if names[index] == name
                return names.count

        def nullable_root(names: darray[sview]&, roots: darray[usize]&, name: sview) -> usize:
            can Abort.Panic:
                index: usize = nullable_index(names, name)
                roots[index] return if index < roots.count
                return names.count

        def nullable_root_proven(names: darray[sview]&, roots: darray[usize]&, proven: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                root: usize = nullable_root(names, roots, name)
                while index < names.count |index: usize = 0|:
                    true return if root < names.count and roots[index] == root and proven[index]
                    index <- index + 1
                return false

        def nullable_is_reference(names: darray[sview]&, reference_optional: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                index: usize = nullable_index(names, name)
                return reference_optional[index] if index < reference_optional.count
                return false

        def nullable_scalar_literal(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _): true
                    Expr.Paren(inner, _): nullable_scalar_literal(inner)
                    _: false

        def set_nullable_root_proven(names: darray[sview]&, roots: darray[usize]&, proven: mutable darray[bool]&, name: sview, value: bool) -> void:
            can Abort.Panic:
                root: usize = nullable_root(names, roots, name)
                while index < names.count |index: usize = 0, proven|:
                    proven[index] <- value if roots[index] == root
                    index <- index + 1

        # Assignment changes one local pointer binding, not the values copied into
        # other locals. Keep the other locals' independently established facts.
        def set_nullable_binding_proven(names: darray[sview]&, proven: mutable darray[bool]&, name: sview, value: bool) -> void:
            can Abort.Panic:
                index: usize = nullable_index(names, name)
                proven[index] <- value if index < proven.count

        def restore_nullable_proofs(saved: darray[bool]&, proven: mutable darray[bool]&) -> void:
            can Abort.Panic:
                while index < saved.count |index: usize = 0, proven|:
                    proven[index] <- saved[index]
                    index <- index + 1

        def restore_nullable_scope(name_mark: usize, root_mark: usize, proof_mark: usize, reference_mark: usize, saved_proofs: darray[bool]&, names: mutable darray[sview]&, roots: mutable darray[usize]&, proven: mutable darray[bool]&, reference_optional: mutable darray[bool]&) -> void:
            can Abort.Panic:
                restore_nullable_proofs(saved_proofs, proven)
                names.truncate(name_mark) if names.count > name_mark
                roots.truncate(root_mark) if roots.count > root_mark
                proven.truncate(proof_mark) if proven.count > proof_mark
                reference_optional.truncate(reference_mark) if reference_optional.count > reference_mark

        def nullable_proofs_snapshot(proven: darray[bool]&, count: usize) -> mutable darray[bool]:
            can Memory.Allocate, Abort.Panic:
                snapshot: mutable darray[bool] = []
                while index < count |index: usize = 0, snapshot, proven|:
                    snapshot.push(proven[index]) if index < proven.count
                    index <- index + 1
                return snapshot

        def nullable_proofs_intersect(target: mutable darray[bool]&, candidate: darray[bool]&) -> void:
            can Abort.Panic:
                while index < target.count |index: usize = 0, target, candidate|:
                    target[index] <- target[index] and candidate[index] if index < candidate.count
                    index <- index + 1

        def discard_nullable_scope(name_mark: usize, root_mark: usize, proof_mark: usize, reference_mark: usize, names: mutable darray[sview]&, roots: mutable darray[usize]&, proven: mutable darray[bool]&, reference_optional: mutable darray[bool]&) -> void:
            can Abort.Panic:
                names.truncate(name_mark) if names.count > name_mark
                roots.truncate(root_mark) if roots.count > root_mark
                proven.truncate(proof_mark) if proven.count > proof_mark
                reference_optional.truncate(reference_mark) if reference_optional.count > reference_mark

        def null_guard_name(condition: Ast::Expr, want_equal: bool) -> sview:
            can Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        matches_operator: bool = operator == TokenKind.EqEq if want_equal else operator == TokenKind.BangEq
                        left_name: sview = ident_name_of(left)
                        right_name: sview = ident_name_of(right)
                        left_name return if matches_operator and right_name == "null"
                        right_name return if matches_operator and left_name == "null"
                        return ""
                    _:
                        return ""

        def body_definitely_returns(statements: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic:
                false return if statements.count == 0
                match statements[statements.count - 1]:
                    Stmt.Return(value, line):
                        return true
                    Stmt.Expr(Expr.Call(callee, _, _, _), _):
                        name: sview = ident_name_of(callee)
                        return name == "panic" or name == "abort" or name == "raise"
                    Stmt.If(condition, then_body, else_body, _):
                        return body_definitely_returns(then_body) and body_definitely_returns(else_body)
                    _:
                        return false

        # `@guard_nonnull(p)` on a callee is what makes a call a null guard. The old
        # reading took `arguments[0]` of ANY call under `not`, which both accepted an
        # undecorated predicate and proved the wrong argument when the decorator named
        # a later parameter. stage0 resolves the decorator to a PARAMETER INDEX and
        # proves the argument in that slot, so collect (function name, slot) pairs once
        # per file and look the callee up.
        def guard_nonnull_collect(declarations: darray[Ast::Decl], annotation_args: darray[sview]&, guard_names: mutable darray[sview]&, guard_slots: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |annotation_args, guard_names, guard_slots|:
                    match declaration:
                        Decl.Func(fn_name, fn_parameters, fn_return_type, fn_body, fn_effects, fn_decorators, fn_line):
                            for decorator in fn_decorators |annotation_args, guard_names, guard_slots, fn_parameters, fn_name|:
                                continue if decorator.name != "guard_nonnull" or decorator.arg_count != 1
                                continue if decorator.arg_start.usize() >= annotation_args.count
                                guarded: sview = annotation_args[decorator.arg_start.usize()]
                                while slot < fn_parameters.count |slot: usize = 0, guard_names, guard_slots, guarded, fn_name, fn_parameters|:
                                    if fn_parameters[slot].name == guarded:
                                        guard_names.push(fn_name)
                                        guard_slots.push(slot)
                                        break
                                    slot <- slot + 1
                        Decl.Module(module_name, module_body, module_line):
                            guard_nonnull_collect(module_body, annotation_args, guard_names, guard_slots)
                        Decl.Scoped(scoped_body, scoped_line):
                            guard_nonnull_collect(scoped_body, annotation_args, guard_names, guard_slots)
                        _:
                            pass

        # The name proven non-null by a bare `guard(a, b)` call, or "" when the callee
        # carries no `@guard_nonnull` or the named slot has no argument.
        def guard_nonnull_call_name(expression: Ast::Expr, guard_names: darray[sview]&, guard_slots: darray[usize]&) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        while index < guard_names.count |index: usize = 0, arguments, callee_name, guard_names, guard_slots|:
                            if guard_names[index] == callee_name:
                                ident_name_of(arguments[guard_slots[index]]) return if guard_slots[index] < arguments.count
                                return ""
                            index <- index + 1
                        return ""
                    _:
                        return ""

        def guard_nonnull_argument(condition: Ast::Expr, guard_names: darray[sview]&, guard_slots: darray[usize]&) -> sview:
            can Abort.Panic:
                match condition:
                    Expr.Unary(operator, operand, line):
                        guard_nonnull_call_name(operand, guard_names, guard_slots) return if operator == TokenKind.Not or operator == TokenKind.Bang
                        return ""
                    _:
                        return ""

        # A true conjunction proves each conjunct. Apply only facts that are valid when
        # evaluation reaches the conjunction's true branch; an OR never proves either side.
        def apply_nullable_true_guards(condition: Ast::Expr, names: darray[sview]&, roots: darray[usize]&, proven: mutable darray[bool]&, guard_names: darray[sview]&, guard_slots: darray[usize]&) -> void:
            can Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        apply_nullable_true_guards(inner, names, roots, proven, guard_names, guard_slots)
                    Expr.Binary(left, operator, right, _) if operator == TokenKind.And:
                        apply_nullable_true_guards(left, names, roots, proven, guard_names, guard_slots)
                        apply_nullable_true_guards(right, names, roots, proven, guard_names, guard_slots)
                    _:
                        name: sview = null_guard_name(condition, false)
                        guard: sview = guard_nonnull_call_name(condition, guard_names, guard_slots)
                        set_nullable_root_proven(names, roots, proven, name, true) if name != ""
                        set_nullable_root_proven(names, roots, proven, guard, true) if guard != ""

        # A false disjunction requires both operands to be false. Thus `p == null or
        # size == 0` followed by code has established `p != null`; false conjunctions
        # do not establish either operand individually.
        def apply_nullable_false_guards(condition: Ast::Expr, names: darray[sview]&, roots: darray[usize]&, proven: mutable darray[bool]&) -> void:
            can Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        apply_nullable_false_guards(inner, names, roots, proven)
                    Expr.Binary(left, operator, right, _) if operator == TokenKind.Or:
                        apply_nullable_false_guards(left, names, roots, proven)
                        apply_nullable_false_guards(right, names, roots, proven)
                    _:
                        name: sview = null_guard_name(condition, true)
                        set_nullable_root_proven(names, roots, proven, name, true) if name != ""

        def nullable_expr_terminates(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Expr.Call(callee, _, _, _): ident_name_of(callee) in {"panic", "abort", "raise"}
                    Expr.Unary(operator, operand, _): operator == TokenKind.Not and nullable_expr_terminates(operand)
                    Expr.Paren(inner, _): nullable_expr_terminates(inner)
                    _: false

        def nullable_cast_receiver(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Field(receiver, field, line):
                        ident_name_of(receiver) return if field == "cast"
                        return ""
                    _:
                        return ""

        def check_nullable_expression(expression: Ast::Expr, names: mutable darray[sview]&, roots: mutable darray[usize]&, proven: mutable darray[bool]&, reference_optional: mutable darray[bool]&, guard_names: darray[sview]&, guard_slots: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(object, field, line):
                        object_name: sview = ident_name_of(object)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NullableWithoutProof, name: field, line: line.line, expected: "field", actual: ""}) if field != "cast" and nullable_index(names, object_name) < names.count and not nullable_root_proven(names, roots, proven, object_name)
                        table <- check_nullable_expression(object, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Index(object, index, line):
                        cast_receiver: sview = nullable_cast_receiver(object)
                        target_id: u32 = annotation_type_id(index, table) if cast_receiver != "" else 0
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NullableWithoutProof, name: cast_receiver, line: line.line, expected: "cast", actual: ""}) if cast_receiver != "" and nullable_index(names, cast_receiver) < names.count and interned_kind(target_id, table) == SemTypeKind.Ref and not nullable_root_proven(names, roots, proven, cast_receiver)
                        indexed_name: sview = ident_name_of(object)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NullableWithoutProof, name: indexed_name, line: line.line, expected: "index", actual: ""}) if cast_receiver == "" and nullable_index(names, indexed_name) < names.count and not nullable_root_proven(names, roots, proven, indexed_name)
                        table <- check_nullable_expression(object, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        table <- check_nullable_expression(index, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        # Calling a nullable function value is the function-pointer
                        # equivalent of dereferencing a nullable reference. A preceding
                        # `!= null` guard (or assert) promotes it for this flow region.
                        nullable_callee_name: sview = ident_name_of(callee)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NullableWithoutProof, name: nullable_callee_name, line: line.line, expected: "call", actual: ""}) if nullable_callee_name != "" and nullable_index(names, nullable_callee_name) < names.count and not nullable_root_proven(names, roots, proven, nullable_callee_name)
                        # A Field callee is a METHOD CALL (`p.sview()`), not a field READ.
                        # stage0 arbitrates a call on a nullable receiver by the callee's
                        # PARAMETER type — `p.takes_ref()` fails with `expects u8&, got
                        # u8&?&`, and `p.takes_nullable()` is simply accepted — so no
                        # non-null proof is required at the receiver. Descending into the
                        # callee Field flagged the METHOD NAME as an unproven field access
                        # and hard-rejected every method call on a nullable receiver,
                        # including the std's own `__cast__(value: u8&?) -> sview`. Walk
                        # the receiver only; a genuine field in the chain (`p.inner.f()`)
                        # is still checked by the Field arm below.
                        match callee:
                            Expr.Field(call_receiver, call_method, call_method_line):
                                table <- check_nullable_expression(call_receiver, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            _:
                                table <- check_nullable_expression(callee, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        for argument in arguments |table|:
                            table <- check_nullable_expression(argument, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Binary(left, operator, right, line):
                        left_name: sview = ident_name_of(left)
                        right_name: sview = ident_name_of(right)
                        arithmetic_operator: bool = operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}
                        bad_left_scalar: bool = (arithmetic_operator or nullable_scalar_literal(right)) and nullable_is_reference(names, reference_optional, left_name) and not nullable_root_proven(names, roots, proven, left_name)
                        bad_right_scalar: bool = (arithmetic_operator or nullable_scalar_literal(left)) and nullable_is_reference(names, reference_optional, right_name) and not nullable_root_proven(names, roots, proven, right_name)
                        bad_name: sview = left_name if bad_left_scalar else right_name
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NullableWithoutProof, name: bad_name, line: line.line, expected: "value", actual: "scalar"}) if bad_left_scalar or bad_right_scalar
                        table <- check_nullable_expression(left, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        saved_right_proofs: mutable darray[bool] = []
                        saved_right_proofs.extend(proven)
                        apply_nullable_true_guards(left, names, roots, proven, guard_names, guard_slots) if operator == TokenKind.And
                        apply_nullable_false_guards(left, names, roots, proven) if operator == TokenKind.Or
                        table <- check_nullable_expression(right, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        restore_nullable_proofs(saved_right_proofs, proven) if operator == TokenKind.And or operator == TokenKind.Or
                    Expr.Unary(operator, operand, line):
                        table <- check_nullable_expression(operand, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Paren(inner, line):
                        table <- check_nullable_expression(inner, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- check_nullable_expression(condition, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        name_mark: usize = names.count
                        root_mark: usize = roots.count
                        proof_mark: usize = proven.count
                        reference_mark: usize = reference_optional.count
                        saved: mutable darray[bool] = []
                        saved.extend(proven)
                        apply_nullable_true_guards(condition, names, roots, proven, guard_names, guard_slots)
                        then_null: sview = null_guard_name(condition, true)
                        table <- check_nullable_expression(then_expr, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        then_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                        restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                        apply_nullable_false_guards(condition, names, roots, proven)
                        set_nullable_root_proven(names, roots, proven, then_null, true) if then_null != ""
                        recovery_guard: sview = guard_nonnull_argument(condition, guard_names, guard_slots)
                        set_nullable_root_proven(names, roots, proven, recovery_guard, true) if recovery_guard != ""
                        table <- check_nullable_expression(else_expr, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        else_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                        restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                        nullable_proofs_intersect(proven, then_proofs)
                        nullable_proofs_intersect(proven, else_proofs)
                    Expr.IndexN(object, indexes, line):
                        indexed_name: sview = ident_name_of(object)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NullableWithoutProof, name: indexed_name, line: line.line, expected: "index", actual: ""}) if nullable_index(names, indexed_name) < names.count and not nullable_root_proven(names, roots, proven, indexed_name)
                        table <- check_nullable_expression(object, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        for index in indexes |table|:
                            table <- check_nullable_expression(index, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Slice(object, low, high, line):
                        indexed_name: sview = ident_name_of(object)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NullableWithoutProof, name: indexed_name, line: line.line, expected: "index", actual: ""}) if nullable_index(names, indexed_name) < names.count and not nullable_root_proven(names, roots, proven, indexed_name)
                        table <- check_nullable_expression(object, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        table <- check_nullable_expression(low, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        table <- check_nullable_expression(high, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.StaticEffectCall(effect, operation, candidates, arguments, labels, line):
                        table <- check_nullable_expression(effect, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        for candidate in candidates |table|:
                            table <- check_nullable_expression(candidate.effect_type, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            for capture in candidate.captures |table|:
                                table <- check_nullable_expression(capture, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        for argument in arguments |table|:
                            table <- check_nullable_expression(argument, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- check_nullable_expression(element, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- check_nullable_expression(entry.key, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            table <- check_nullable_expression(entry.value, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Construct(head, fields, line) | Expr.RecordUpdate(head, fields, line):
                        table <- check_nullable_expression(head, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        for field in fields |table|:
                            table <- check_nullable_expression(field.value, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- check_nullable_expression(scrutinee, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        joined_proofs: mutable darray[bool] = []
                        has_arm: mutable bool = false
                        for arm in arms |table, names, roots, proven, reference_optional, guard_names, guard_slots|:
                            name_mark: usize = names.count
                            root_mark: usize = roots.count
                            proof_mark: usize = proven.count
                            reference_mark: usize = reference_optional.count
                            saved: mutable darray[bool] = []
                            saved.extend(proven)
                            table <- check_nullable_expression(arm.guard, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            apply_nullable_true_guards(arm.guard, names, roots, proven, guard_names, guard_slots)
                            table <- check_nullable_statements(arm.body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            arm_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                            if has_arm:
                                nullable_proofs_intersect(joined_proofs, arm_proofs)
                            else:
                                joined_proofs.extend(arm_proofs)
                                has_arm <- true
                            restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                        restore_nullable_proofs(joined_proofs, proven) if has_arm
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        table <- check_nullable_expression(iterable, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        table <- check_nullable_expression(condition, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        table <- check_nullable_expression(body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.Refinement(base, predicate, line):
                        table <- check_nullable_expression(base, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        table <- check_nullable_expression(predicate, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- check_nullable_expression(guarded, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        name_mark: usize = names.count
                        root_mark: usize = roots.count
                        proof_mark: usize = proven.count
                        reference_mark: usize = reference_optional.count
                        recovery_proofs: mutable darray[bool] = []
                        recovery_proofs.extend(proven)
                        table <- check_nullable_statements(recovery, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, recovery_proofs, names, roots, proven, reference_optional)
                    Expr.Lambda(parameters, body, line):
                        name_mark: usize = names.count
                        root_mark: usize = roots.count
                        proof_mark: usize = proven.count
                        reference_mark: usize = reference_optional.count
                        saved: mutable darray[bool] = []
                        saved.extend(proven)
                        while proof_index < proven.count |proof_index: usize = 0, proven|:
                            proven[proof_index] <- false
                            proof_index <- proof_index + 1
                        table <- check_nullable_statements(body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                    Expr.Block(statements, value, captures, line):
                        name_mark: usize = names.count
                        root_mark: usize = roots.count
                        proof_mark: usize = proven.count
                        reference_mark: usize = reference_optional.count
                        saved: mutable darray[bool] = []
                        saved.extend(proven)
                        table <- check_nullable_statements(statements, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        table <- check_nullable_expression(value, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        discard_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, names, roots, proven, reference_optional)
                    Expr.RegionNew(value, region, line) | Expr.Move(value, line):
                        table <- check_nullable_expression(value, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                    _:
                        pass

        def check_nullable_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, roots: mutable darray[usize]&, proven: mutable darray[bool]&, reference_optional: mutable darray[bool]&, guard_names: darray[sview]&, guard_slots: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, names, roots, proven, guard_names, guard_slots|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            declared_id: u32 = annotation_type_id(type_expression, table)
                            nullable: bool = interned_kind(declared_id, table) == SemTypeKind.Optional
                            nullable_ref: bool = nullable and interned_elem_count(declared_id, table) == 1 and interned_kind(interned_elem(declared_id, 0, table), table) == SemTypeKind.Ref
                            source_name: sview = ident_name_of(value)
                            source_index: usize = nullable_index(names, source_name)
                            source_proven: bool = nullable_root_proven(names, roots, proven, source_name) if source_index < names.count else false
                            new_root: usize = names.count
                            names.push(name) if nullable
                            # Each local is its own binding. A copied nullable pointer
                            # inherits the source fact at initialization, but a later
                            # rebind of either local must not erase the other's fact.
                            roots.push(new_root) if nullable
                            proven.push(source_proven) if nullable
                            reference_optional.push(nullable_ref) if nullable
                            table <- check_nullable_expression(value, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        Stmt.Assign(target, operator, value, line):
                            target_name: sview = ident_name_of(target)
                            table <- check_nullable_expression(target, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            table <- check_nullable_expression(value, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            set_nullable_binding_proven(names, proven, target_name, false) if operator == TokenKind.LArrow and nullable_index(names, target_name) < names.count
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_nullable_expression(condition, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            equal_name: sview = null_guard_name(condition, true)
                            unequal_name: sview = null_guard_name(condition, false)
                            guard_name: sview = guard_nonnull_argument(condition, guard_names, guard_slots)
                            # `if guard(p):` proves p for the THEN body; `if not guard(p):`
                            # (handled by guard_name below) proves it AFTER the if, but only
                            # when the then body definitely returns. stage0 accepts the first
                            # shape and rejects a use placed after the if, which the
                            # save/restore around each body already models.
                            positive_guard: sview = guard_nonnull_call_name(condition, guard_names, guard_slots)
                            name_mark: usize = names.count
                            root_mark: usize = roots.count
                            proof_mark: usize = proven.count
                            reference_mark: usize = reference_optional.count
                            saved: mutable darray[bool] = []
                            saved.extend(proven)
                            apply_nullable_true_guards(condition, names, roots, proven, guard_names, guard_slots)
                            table <- check_nullable_statements(then_body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            then_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                            restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                            apply_nullable_false_guards(condition, names, roots, proven)
                            set_nullable_root_proven(names, roots, proven, equal_name, true) if equal_name != ""
                            set_nullable_root_proven(names, roots, proven, guard_name, true) if guard_name != ""
                            table <- check_nullable_statements(else_body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            else_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                            restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                            if body_definitely_returns(then_body):
                                restore_nullable_proofs(else_proofs, proven)
                            elif body_definitely_returns(else_body):
                                restore_nullable_proofs(then_proofs, proven)
                            else:
                                nullable_proofs_intersect(proven, then_proofs)
                                nullable_proofs_intersect(proven, else_proofs)
                        Stmt.Contract(kind, expression, line):
                            # `assert p != null` PROVES non-null for the rest of the block:
                            # the assert either holds or aborts, so any later `p.field` is
                            # reached only when it held. stage0 accepts exactly this shape
                            # (`assert p != null` then `p.second`, and `&p.second`), and the
                            # walk had no Contract case at all, so the proof was never
                            # recorded. Uses the same `!= null` reading as the If narrowing
                            # above (null_guard_name with unequal=false), so `assert p == null`
                            # correctly proves nothing.
                            table <- check_nullable_expression(expression, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            apply_nullable_true_guards(expression, names, roots, proven, guard_names, guard_slots) if kind == "assert"
                        Stmt.While(condition, body, line):
                            table <- check_nullable_expression(condition, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            name_mark: usize = names.count
                            root_mark: usize = roots.count
                            proof_mark: usize = proven.count
                            reference_mark: usize = reference_optional.count
                            saved: mutable darray[bool] = []
                            saved.extend(proven)
                            apply_nullable_true_guards(condition, names, roots, proven, guard_names, guard_slots)
                            table <- check_nullable_statements(body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            body_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                            restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                            nullable_proofs_intersect(proven, body_proofs)
                        Stmt.For(binding, variables, iterable, body, line):
                            table <- check_nullable_expression(iterable, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            name_mark: usize = names.count
                            root_mark: usize = roots.count
                            proof_mark: usize = proven.count
                            reference_mark: usize = reference_optional.count
                            saved: mutable darray[bool] = []
                            saved.extend(proven)
                            table <- check_nullable_statements(body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            body_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                            restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                            nullable_proofs_intersect(proven, body_proofs)
                        Stmt.Block(kind, clause, binding, body, line):
                            name_mark: usize = names.count
                            root_mark: usize = roots.count
                            proof_mark: usize = proven.count
                            reference_mark: usize = reference_optional.count
                            table <- check_nullable_statements(body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            discard_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, names, roots, proven, reference_optional)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_nullable_expression(scrutinee, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                            joined_proofs: mutable darray[bool] = []
                            has_arm: mutable bool = false
                            for arm in arms |table, names, roots, proven, reference_optional, guard_names, guard_slots|:
                                name_mark: usize = names.count
                                root_mark: usize = roots.count
                                proof_mark: usize = proven.count
                                reference_mark: usize = reference_optional.count
                                saved: mutable darray[bool] = []
                                saved.extend(proven)
                                table <- check_nullable_expression(arm.guard, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                                apply_nullable_true_guards(arm.guard, names, roots, proven, guard_names, guard_slots)
                                table <- check_nullable_statements(arm.body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                                arm_proofs: mutable darray[bool] = nullable_proofs_snapshot(proven, proof_mark)
                                if has_arm:
                                    nullable_proofs_intersect(joined_proofs, arm_proofs)
                                else:
                                    joined_proofs.extend(arm_proofs)
                                    has_arm <- true
                                restore_nullable_scope(name_mark, root_mark, proof_mark, reference_mark, saved, names, roots, proven, reference_optional)
                            restore_nullable_proofs(joined_proofs, proven) if has_arm
                        Stmt.Return(value, line):
                            table <- check_nullable_expression(return_value, names, roots, proven, reference_optional, guard_names, guard_slots, table) if value is return_value
                        Stmt.Expr(expression, line):
                            table <- check_nullable_expression(expression, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        _:
                            pass

        def check_nullable_declarations(declarations: darray[Ast::Decl], guard_names: darray[sview]&, guard_slots: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, guard_names, guard_slots|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            roots: mutable darray[usize] = []
                            proven: mutable darray[bool] = []
                            reference_optional: mutable darray[bool] = []
                            for parameter in parameters |names, roots, proven, reference_optional, table|:
                                parameter_id: u32 = annotation_type_id(parameter.type_expression, table)
                                nullable: bool = interned_kind(parameter_id, table) == SemTypeKind.Optional
                                nullable_ref: bool = nullable and interned_elem_count(parameter_id, table) == 1 and interned_kind(interned_elem(parameter_id, 0, table), table) == SemTypeKind.Ref
                                new_root: usize = names.count
                                names.push(parameter.name) if nullable
                                roots.push(new_root) if nullable
                                proven.push(false) if nullable
                                reference_optional.push(nullable_ref) if nullable
                            table <- check_nullable_statements(body, names, roots, proven, reference_optional, guard_names, guard_slots, table)
                        Decl.Module(name, body, line):
                            table <- check_nullable_declarations(body, guard_names, guard_slots, table)
                        Decl.Scoped(body, line):
                            table <- check_nullable_declarations(body, guard_names, guard_slots, table)
                        _:
                            pass

    public:
        def check_nullable_flow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                guard_names: mutable darray[sview] = []
                guard_slots: mutable darray[usize] = []
                guard_nonnull_collect(file.top_decls, file.annotation_args, &guard_names, &guard_slots)
                table <- check_nullable_declarations(file.top_decls, guard_names, guard_slots, table)
