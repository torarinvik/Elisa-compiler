# Region-parameter inference failure at a call site (stage0 analyzeRegionParamInference). A
# callee that grows a darray field of a `mutable Struct&` param needs `@__rg_<param>`; when the
# argument is a plain call-initialised local (no region scope) whose grown field ESCAPES (is
# returned), stage0 cannot synthesise a region and reports it. Non-escaping grows are auto-
# regioned locally and stay silent, so the escape gate keeps this decidable subset sound.
#
# Return-value recursion only (no `mutable&` out-params) and a small function count — the full
# out-param version tripped a stage0 codegen scale threshold.
extend Semantic:
    private:
        # Grown field name of a `param.FIELD.push(...)` inside an expression, else "".
        def rpu_growth_field(expression: Ast::Expr, param: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return rpu_growth_field(inner, param)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                grow: bool = method == "push" or method == "push_back" or method == "insert" or method == "append" or method == "extend" or method == "resize"
                                if grow:
                                    match receiver:
                                        Expr.Field(object, base_field, base_line):
                                            base_field return if ident_name_of(object) == param
                                        _:
                                            pass
                            _:
                                pass
                        found: mutable sview = sview("", 0, 0)
                        for argument in arguments |found, param|:
                            found <- rpu_growth_field(argument, param) if found == ""
                        return found
                    _:
                        return sview("", 0, 0)

        # Grown field of PARAM anywhere in a statement list, else "".
        def rpu_growth_field_stmts(statements: darray[Ast::Stmt], param: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for statement in statements |found, param|:
                    match statement:
                        Stmt.Expr(expression, line):
                            found <- rpu_growth_field(expression, param) if found == ""
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            found <- rpu_growth_field_stmts(block_body, param) if found == ""
                        Stmt.If(condition, then_body, else_body, if_line):
                            found <- rpu_growth_field_stmts(then_body, param) if found == ""
                            found <- rpu_growth_field_stmts(else_body, param) if found == ""
                        _:
                            pass
                return found

        # Whether EXPR is `param.push/extend/...(...)` on the bare ref param itself.
        def rpu_param_pushed(expression: Ast::Expr, param: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return rpu_param_pushed(inner, param)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                grow: bool = method == "push" or method == "push_back" or method == "insert" or method == "append" or method == "extend" or method == "resize"
                                true return if grow and ident_name_of(receiver) == param
                            _:
                                pass
                        return any argument in arguments where rpu_param_pushed(argument, param)
                    _:
                        return false

        # Whether PARAM is grown inside a LOCAL `region NAME(...)` declaration block (kind
        # "region") — the doomed local region that cannot be the caller's, so its growth of a
        # caller-provided ref cannot infer a region. An `in <perm/global>` block (kind "in")
        # references an EXTERNAL region and is fine, so only kind "region" counts.
        def rpu_region_grows(statements: darray[Ast::Stmt], param: sview, inside_region: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if inside_region and rpu_param_pushed(expression, param)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            nested_region: bool = inside_region or block_kind == "region"
                            true return if rpu_region_grows(block_body, param, nested_region)
                        Stmt.If(condition, then_body, else_body, if_line):
                            true return if rpu_region_grows(then_body, param, inside_region)
                            true return if rpu_region_grows(else_body, param, inside_region)
                        _:
                            pass
                return false

        # Whether the body returns `local.field`; whether it opens a region scope; whether
        # `local` is a plain call-initialised struct local. Combined struct-name membership check.
        def rpu_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any candidate in names where candidate == wanted

        # Struct-name head of a (possibly `mutable`/`&`/paren-wrapped) type — `mutable Bag&` -> "Bag".
        def rpu_struct_head(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Unary(operator, operand, unary_line):
                        return rpu_struct_head(operand)
                    Expr.Paren(inner, paren_line):
                        return rpu_struct_head(inner)
                    Expr.Index(head, argument, index_line):
                        return ident_name_of(head)
                    Expr.IndexN(head_n, arguments, index_n_line):
                        return ident_name_of(head_n)
                    _:
                        return sview("", 0, 0)

        def rpu_returns_field(statements: darray[Ast::Stmt], local: sview, field: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                match returned:
                                    Expr.Field(object, return_field, field_line):
                                        true return if ident_name_of(object) == local and return_field == field
                                    _:
                                        pass
                        Stmt.If(condition, then_body, else_body, if_line):
                            true return if rpu_returns_field(then_body, local, field)
                            true return if rpu_returns_field(else_body, local, field)
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            true return if rpu_returns_field(block_body, local, field)
                        _:
                            pass
                return false

        def rpu_has_region_scope(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Block(block_kind, clause, binding, block_body, block_line):
                            true return if block_kind == "region" or block_kind == "in"
                            true return if rpu_has_region_scope(block_body)
                        Stmt.If(condition, then_body, else_body, if_line):
                            true return if rpu_has_region_scope(then_body)
                            true return if rpu_has_region_scope(else_body)
                        _:
                            pass
                return false

        def rpu_local_is_plain(statements: darray[Ast::Stmt], local: sview, structs: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if name == local:
                                is_struct: bool = rpu_name_in(structs, rpu_struct_head(type_expression))
                                match value:
                                    Expr.Call(callee, arguments, argument_names, call_line):
                                        return is_struct
                                    _:
                                        return false
                        _:
                            pass
                return false

    public:
        def check_region_param_uninferable(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Struct names + field-grower (name, grown field) tables.
                structs: mutable darray[sview] = []
                for declaration in file.top_decls |structs|:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            structs.push(struct_name)
                        _:
                            pass
                return if structs.count == 0
                # Kind 1: field-grower (mutable Struct& param whose darray FIELD is grown) — fires
                # when its grown field ESCAPES a plain local. Kind 2: region-grower (mutable darray&
                # param grown inside a LOCAL `region` block) — fires on any call.
                grower_name: mutable darray[sview] = []
                grower_field: mutable darray[sview] = []
                region_grower: mutable darray[sview] = []
                for declaration in file.top_decls |structs, grower_name, grower_field, region_grower|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if parameters.count >= 1:
                                first_type: Ast::Expr = parameters[0].type_expression
                                first_name: sview = parameters[0].name
                                is_ref: bool = type_marker_present_here(first_type, TokenKind.Ampersand)
                                ref_struct: bool = is_ref and rpu_name_in(structs, rpu_struct_head(first_type))
                                if ref_struct:
                                    grown: sview = rpu_growth_field_stmts(body, first_name)
                                    if grown != "":
                                        grower_name.push(function_name)
                                        grower_field.push(grown)
                                ref_darray: bool = is_ref and rpu_struct_head(first_type) == "darray"
                                region_grower.push(function_name) if ref_darray and rpu_region_grows(body, first_name, false)
                        _:
                            pass
                return if grower_name.count == 0 and region_grower.count == 0
                # Check each function's top-level grower calls.
                for declaration in file.top_decls |structs, grower_name, grower_field, region_grower, table| -> table:
                    match declaration:
                        Decl.Func(check_name, check_params, check_return, check_body, check_effects, check_decorators, check_line):
                            if not rpu_has_region_scope(check_body):
                                for statement in check_body |structs, grower_name, grower_field, region_grower, table| -> table:
                                    match statement:
                                        Stmt.Expr(call_expression, stmt_line):
                                            match call_expression:
                                                Expr.Call(callee, arguments, argument_names, call_line):
                                                    callee_name: sview = ident_name_of(callee)
                                                    gi: mutable i64 = -1
                                                    gp: mutable usize = 0
                                                    while gp < grower_name.count |gi, gp, callee_name, grower_name|:
                                                        gi <- gp.i64() if grower_name[gp] == callee_name and gi < 0
                                                        gp <- gp + 1
                                                    if gi >= 0 and arguments.count >= 1:
                                                        field: sview = grower_field[gi.usize()]
                                                        local: sview = ident_name_of(arguments[0])
                                                        plain: bool = local != "" and rpu_local_is_plain(check_body, local, structs)
                                                        fires: bool = plain and rpu_returns_field(check_body, local, field)
                                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionParamUninferable, name: callee_name, pos: call_line, line: call_line.line, expected: "", actual: local}) if fires
                                                    region_fires: bool = rpu_name_in(region_grower, callee_name)
                                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RegionParamUninferable, name: callee_name, pos: call_line, line: call_line.line, expected: "", actual: callee_name}) if region_fires
                                                _:
                                                    pass
                                        _:
                                            pass
                        _:
                            pass
