# Refinement bindings introduced by `A or B` are available on the truthy path only
# when both branches bind the same identifier with the same type. Stage1's resolver
# deliberately gathers a superset of condition bindings for name resolution; this pass
# validates the branch intersection before those names are used in the guarded body.
extend Semantic:
    private:
        def truthy_binding_index(names: darray[sview]&, name: sview) -> i64:
            while index < names.count |index: usize = 0|:
                index.i64() return if names[index] == name
                index <- index + 1
            return -1


        def collect_truthy_is_bindings(expression: Ast::Expr, names: mutable darray[sview]&, types: mutable darray[sview]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        match operator:
                            TokenKind.Is:
                                if right is Expr.Call(Expr.Ident(owner, owner_line), arguments, argument_names, call_line):
                                    while argument_index < arguments.count |argument_index: usize = 0|:
                                        if arguments[argument_index] is Expr.Ident(binding, binding_line):
                                            field_name: sview = argument_names[argument_index]
                                            if field_name != "" and truthy_binding_index(names, binding) < 0:
                                                names.push(binding)
                                                types.push(field_type_of(table, owner, field_name))
                                        argument_index <- argument_index + 1
                            TokenKind.And:
                                collect_truthy_is_bindings(left, names, types, table)
                                collect_truthy_is_bindings(right, names, types, table)
                            _:
                                pass
                    Expr.Paren(inner, line):
                        collect_truthy_is_bindings(inner, names, types, table)
                    _:
                        pass


        def truthy_expression_references(expression: Ast::Expr, name: sview) -> bool:
            match expression:
                Expr.Ident(candidate, line):
                    candidate_name: sview = candidate
                    return candidate_name == name
                Expr.Call(callee, arguments, argument_names, line):
                    true return if truthy_expression_references(callee, name)
                    for argument in arguments:
                        true return if truthy_expression_references(argument, name)
                Expr.Field(object, field, line):
                    return truthy_expression_references(object, name)
                Expr.Scope(base, member, line):
                    return truthy_expression_references(base, name)
                Expr.Index(object, index, line):
                    return truthy_expression_references(object, name) or truthy_expression_references(index, name)
                Expr.Slice(object, low, high, line):
                    return truthy_expression_references(object, name) or truthy_expression_references(low, name) or truthy_expression_references(high, name)
                Expr.IndexN(object, arguments, line):
                    true return if truthy_expression_references(object, name)
                    for argument in arguments:
                        true return if truthy_expression_references(argument, name)
                Expr.Binary(left, operator, right, line):
                    return truthy_expression_references(left, name) or truthy_expression_references(right, name)
                Expr.Unary(operator, operand, line):
                    return truthy_expression_references(operand, name)
                Expr.Paren(inner, line):
                    return truthy_expression_references(inner, name)
                _:
                    pass
            return false


        def truthy_statements_reference(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if truthy_expression_references(expression, name)
                        Stmt.Return(value, line):
                            if value is return_expression:
                                true return if truthy_expression_references(return_expression, name)
                        Stmt.VarDecl(local_name, type_expression, value, line):
                            true return if truthy_expression_references(value, name)
                        Stmt.Assign(target, operator, value, line):
                            true return if truthy_expression_references(target, name) or truthy_expression_references(value, name)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if truthy_expression_references(condition, name) or truthy_statements_reference(then_body, name) or truthy_statements_reference(else_body, name)
                        Stmt.While(condition, body, line):
                            true return if truthy_expression_references(condition, name) or truthy_statements_reference(body, name)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if truthy_expression_references(iterable, name) or truthy_statements_reference(body, name)
                        Stmt.Block(kind, clause, binding, body, line):
                            true return if truthy_statements_reference(body, name)
                        Stmt.Match(scrutinee, arms, line):
                            true return if truthy_expression_references(scrutinee, name)
                            for arm in arms:
                                true return if truthy_statements_reference(arm.body, name)
                        _:
                            pass
                return false


        def check_truthy_or_condition(condition: Ast::Expr, body: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if condition is Expr.Binary(left, operator, right, line):
                    return if operator != TokenKind.Or
                    left_names: mutable darray[sview] = []
                    left_types: mutable darray[sview] = []
                    right_names: mutable darray[sview] = []
                    right_types: mutable darray[sview] = []
                    collect_truthy_is_bindings(left, left_names, left_types, table)
                    collect_truthy_is_bindings(right, right_names, right_types, table)
                    while left_index < left_names.count |table, left_index: usize = 0| -> table:
                        right_index: i64 = truthy_binding_index(right_names, left_names[left_index])
                        missing: bool = right_index < 0
                        right_type: sview = "" if missing else right_types[right_index.usize()]
                        mismatch: bool = missing or left_types[left_index] != right_type
                        used: bool = truthy_statements_reference(body, left_names[left_index])
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TruthyOrBindingMismatch, name: left_names[left_index], line: line, expected: left_types[left_index], actual: right_type}) if mismatch and used
                        left_index <- left_index + 1


        def walk_truthy_or_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_truthy_or_condition(condition, then_body, table)
                            table <- walk_truthy_or_statements(then_body, table)
                            table <- walk_truthy_or_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_truthy_or_condition(condition, body, table)
                            table <- walk_truthy_or_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_truthy_or_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_truthy_or_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- walk_truthy_or_statements(arm.body, table)
                        _:
                            pass


        def check_truthy_or_bindings(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_truthy_or_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_truthy_or_bindings(body, table)
                        Decl.Scoped(body, line):
                            table <- check_truthy_or_bindings(body, table)
                        _:
                            pass
