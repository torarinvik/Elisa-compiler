extend Semantic:
    private:
        # Walk all statements in a function body, checking for double negation expressions.
        def walk_double_negation_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_double_negation_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_double_negation_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_double_negation_expression(target, table)
                            table <- walk_double_negation_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_double_negation_expression(condition, table)
                            table <- walk_double_negation_statements(then_body, table)
                            table <- walk_double_negation_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_double_negation_expression(condition, table)
                            table <- walk_double_negation_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_double_negation_expression(iterable, table)
                            table <- walk_double_negation_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_double_negation_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_double_negation_expression(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_double_negation_expression(arm.guard, table)
                                table <- walk_double_negation_statements(arm.body, table)
                        Stmt.Return(value, line):
                            table <- walk_double_negation_expression(return_value, table) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_double_negation_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Walk all expressions, checking for double negation (not not x or ! !x).
        def walk_double_negation_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_double_negation_expression(callee, table)
                        for argument in arguments |table|:
                            table <- walk_double_negation_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_double_negation_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_double_negation_expression(base, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- walk_double_negation_expression(object, table)
                        table <- walk_double_negation_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_double_negation_expression(object, table)
                        table <- walk_double_negation_expression(low, table)
                        table <- walk_double_negation_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_double_negation_expression(object, table)
                        for argument in arguments |table|:
                            table <- walk_double_negation_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_double_negation_expression(left, table)
                        table <- walk_double_negation_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        # Check for double negation: outer unary is NOT or BANG.
                        #
                        # `operand` is walked ONCE (below) so a chain of N nested unaries costs
                        # O(N), not O(2^N). It used to be walked twice — once here, once again
                        # after the diagnostic checks, both times over the SAME subtree — so a
                        # left-nested chain of `not`s re-walked its whole remaining tail at
                        # every level: T(n) = 2*T(n-1) + O(1) = O(2^n). Just 30 nested `not`s
                        # (`not not not ... true`, nothing else in the file) hung stage1
                        # indefinitely while stage0 accepted it instantly — this is the same
                        # DOUBLE-DESCENT shape as the elif-chain duplicate-condition bug (see
                        # elisa-codegen-bug-patterns memory), just one level lower (a unary
                        # chain instead of an if/elif chain).
                        is_negation_op: bool = operator == TokenKind.Not or operator == TokenKind.Bang
                        # Normalize every parenthesis layer before checking the inner
                        # operator. The old direct/one-paren checks missed equivalent forms
                        # such as `not (((not x)))` and made diagnostics depend on formatting.
                        inner_expression: mutable Ast::Expr = operand
                        while true:
                            match inner_expression:
                                Expr.Paren(paren_inner, _):
                                    inner_expression <- paren_inner
                                _:
                                    break
                        if is_negation_op:
                            match inner_expression:
                                Expr.Unary(inner_operator, _, _):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DoubleNegation, name: "", line: line.line, expected: "", actual: ""}) if inner_operator == TokenKind.Not or inner_operator == TokenKind.Bang
                                _:
                                    pass
                        table <- walk_double_negation_expression(operand, table)
                    Expr.Move(operand, line):
                        table <- walk_double_negation_expression(operand, table)
                    Expr.RegionNew(operand, region, line):
                        table <- walk_double_negation_expression(operand, table)
                    Expr.Refinement(base, predicate, line):
                        table <- walk_double_negation_expression(base, table)
                        table <- walk_double_negation_expression(predicate, table)
                    # `get EXPR else return …` — walk the GUARDED expression; the recovery is a
                    # statement list, which this expression walker does not descend into.
                    Expr.GetElse(guarded, recovery, line):
                        table <- walk_double_negation_expression(guarded, table)
                    Expr.Paren(inner, line):
                        table <- walk_double_negation_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_double_negation_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_double_negation_expression(element, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_double_negation_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_double_negation_expression(entry.key, table)
                            table <- walk_double_negation_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_double_negation_expression(type_expression, table)
                        for field in fields |table|:
                            table <- walk_double_negation_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_double_negation_expression(base, table)
                        for field in fields |table|:
                            table <- walk_double_negation_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_double_negation_expression(condition, table)
                        table <- walk_double_negation_expression(then_expr, table)
                        table <- walk_double_negation_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_double_negation_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- walk_double_negation_expression(arm.guard, table)
                            table <- walk_double_negation_statements(arm.body, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Expr.Catch(scrutinee, arms, line):
                        table <- walk_double_negation_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- walk_double_negation_expression(arm.guard, table)
                            table <- walk_double_negation_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_double_negation_expression(iterable, table)
                        table <- walk_double_negation_expression(condition, table)
                        table <- walk_double_negation_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_double_negation_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_double_negation_statements(statements, table)
                        table <- walk_double_negation_expression(value, table)


        # Entry point: check all declarations for double negation expressions.
        def check_declarations_for_double_negation(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_double_negation_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_declarations_for_double_negation(body, table)
                        Decl.Scoped(body, line):
                            table <- check_declarations_for_double_negation(body, table)
                        _:
                            pass


    public:
        # Public check function that can be called from semantic_api.
        def check_double_negation(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_declarations_for_double_negation(declarations, table)
