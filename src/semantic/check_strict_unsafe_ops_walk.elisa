# Stage1 semantic — the strict-unsafe statement and expression walks (`extend Semantic:
# private:`). `strict_unsafe_walk` threads the bounds facts a guard establishes through
# a body; `strict_unsafe_expression` decides one indexing or global read against them.
# Continues check_strict_unsafe_ops.elisa; split out to keep each part under 600 lines.

extend Semantic:
    private:
        # Whether one match arm rebinds a reference slot that was already live on entry.
        # Its post-match referent is path-dependent; the caller replaces tracked places with
        # the conservative unknown-place sentinel instead of leaking one arm's state into the
        # next or silently keeping only the final arm's target.
        def strict_body_rebinds_borrowed_slot(statements: darray[Ast::Stmt], binders: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Ident(name, _):
                                true return if any binder in binders where binder == name
                        Stmt.If(condition, then_body, else_body, line):
                            true return if strict_body_rebinds_borrowed_slot(then_body, binders) or strict_body_rebinds_borrowed_slot(else_body, binders)
                        Stmt.While(condition, body, line) | Stmt.For(_, _, _, body, line) | Stmt.Block(_, _, _, body, line):
                            true return if strict_body_rebinds_borrowed_slot(body, binders)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if strict_body_rebinds_borrowed_slot(arm.body, binders)
                        _:
                            pass
                return false


        def strict_unsafe_walk(statements: darray[Ast::Stmt], array_params: darray[sview]&, index_params: darray[sview]&, unsigned_indexes: darray[sview]&, mutable_params: darray[sview]&, ref_params: darray[sview]&, mutable_globals: darray[sview]&, local_names: darray[sview]&, checked_get_lines: darray[u32]&, mr_fns: darray[sview]&, mr_positions: darray[usize]&, outer_places: darray[Ast::Expr]&, outer_mut: darray[bool]&, outer_binders: darray[sview]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Shrinks as bounds guards prove index names: `if i >= xs.count: return`
                # makes `i` proven for every statement below it.
                live_index_params: mutable darray[sview] = []
                live_index_params.extend(index_params)
                # ALL live borrows (stack/& bindings) of locals, with the borrowing
                # binding's mutability: a second borrow where EITHER side is mutable, a
                # rebind adding one, or a mutable-ref CALL on a borrowed local is
                # Unsafe.Alias (stage0's strict rule; pinned four shapes).
                borrow_places: mutable darray[Ast::Expr] = [place for place in outer_places]
                borrow_mut: mutable darray[bool] = [flag for flag in outer_mut]
                borrow_binders: mutable darray[sview] = [binder for binder in outer_binders]
                for statement in statements |table, live_index_params, borrow_places, borrow_mut, borrow_binders| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- strict_unsafe_expression(expression, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(expression, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- strict_unsafe_expression(value, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(value, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                            borrow_place_info: (found: bool, place: Ast::Expr) = strict_alias_place(value, borrow_binders, borrow_places)
                            # Only an expression that CREATES or COPIES a borrow opens one --
                            # see strict_alias_is_new_borrow. `strict_alias_place` resolves the
                            # place of any ref-valued expression, which is what the call check
                            # below needs, but is not by itself a second live reference.
                            takes_any_borrow: bool = borrow_place_info.found and strict_alias_is_new_borrow(value, borrow_binders) and type_marker_present_here(type_expression, TokenKind.Ampersand)
                            # Mixing with a MUTABLE-flavored binding of the SAME PLACE aliases it.
                            # The comparison is the full field path, never its root ident: stage0
                            # accepts `&n.a` beside `&n.b` (measured) and flags `&n` beside `&n.a`,
                            # which is exactly what strict_alias_places_overlap decides. A
                            # root-keyed second table used to report every pair of sibling-field
                            # borrows -- both-mutable is a subset of `mixed`, so one test covers it.
                            binding_mut: bool = type_marker_present_here(type_expression, TokenKind.Mutable)
                            if takes_any_borrow:
                                mixed: mutable bool = false
                                borrow_probe: mutable usize = 0
                                while borrow_probe < borrow_places.count |mixed, borrow_probe, borrow_place_info, binding_mut, borrow_places, borrow_mut|:
                                    same_target: bool = strict_alias_places_overlap(borrow_places[borrow_probe], borrow_place_info.place)
                                    mixed <- true if same_target and (binding_mut or borrow_mut[borrow_probe])
                                    borrow_probe <- borrow_probe + 1
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line.line, expected: "", actual: ""}) if mixed and not strict_unsafe_grant_covers(active_grants, "Unsafe.Alias")
                                borrow_places.push(borrow_place_info.place)
                                borrow_mut.push(binding_mut)
                                borrow_binders.push(name)
                        Stmt.Assign(target, operator, value, line):
                            table <- strict_unsafe_expression(target, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_unsafe_expression(value, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(target, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                            table <- strict_borrowed_call_check(value, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                            # A REBIND storing `&node` into a ref slot adds a live borrow.
                            rebind_place_info: (found: bool, place: Ast::Expr) = strict_alias_place(value, borrow_binders, borrow_places) if strict_alias_is_new_borrow(value, borrow_binders) else (false, Ast::Expr.Invalid)
                            slot_name: sview = ident_name_of(target)
                            slot_is_borrow: bool = slot_name != "" and (any binder in borrow_binders where binder == slot_name)
                            if rebind_place_info.found and slot_is_borrow:
                                # Rebinding a SLOT releases its previous borrow first.
                                release_probe: mutable usize = 0
                                while release_probe < borrow_binders.count |release_probe, slot_name, borrow_places, borrow_binders|:
                                    borrow_places[release_probe] <- Ast::Expr.Invalid if borrow_binders[release_probe] == slot_name
                                    release_probe <- release_probe + 1
                                rebind_mixed: mutable bool = false
                                rebind_probe: mutable usize = 0
                                while rebind_probe < borrow_places.count |rebind_mixed, rebind_probe, rebind_place_info, borrow_places|:
                                    rebind_mixed <- true if strict_alias_places_overlap(borrow_places[rebind_probe], rebind_place_info.place)
                                    rebind_probe <- rebind_probe + 1
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line.line, expected: "", actual: ""}) if rebind_mixed and not strict_unsafe_grant_covers(active_grants, "Unsafe.Alias")
                                borrow_places.push(rebind_place_info.place)
                                borrow_mut.push(true)
                                borrow_binders.push(slot_name)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- strict_unsafe_expression(returned, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                                table <- strict_borrowed_call_check(returned, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- strict_unsafe_expression(condition, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(condition, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                            # Inside the THEN arm, `i < xs.count` holds.
                            # The proof survives only a body that neither REASSIGNS the index
                            # nor CALLS anything: `i <- i + 99` moves the index out of range,
                            # and `xs.truncate(0)` shrinks the container the bound was about.
                            # stage0 flags both (verified); this is the conservative form of
                            # its dataflow -- it can lose a benign call, never over-prove.
                            guarded_now: mutable sview = bounds_guard_name(condition, true, unsigned_indexes)
                            guarded_now <- sview("", 0, 0) if body_invalidates_bounds(then_body, guarded_now)
                            then_index_params: darray[sview] = index_params_without(live_index_params, guarded_now)
                            table <- strict_unsafe_walk(then_body, array_params, then_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, borrow_places, borrow_mut, borrow_binders, active_grants, table)
                            table <- strict_unsafe_walk(else_body, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, borrow_places, borrow_mut, borrow_binders, active_grants, table)
                            # `if i >= xs.count: return` — below the guard, `i` is in bounds
                            # on the only path that reaches there.
                            early_guarded: sview = bounds_guard_name(condition, false, unsigned_indexes)
                            live_index_params <- index_params_without(live_index_params, early_guarded) if early_guarded != "" and body_terminates(then_body)
                        Stmt.While(condition, body, line):
                            table <- strict_unsafe_expression(condition, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(condition, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                            table <- strict_unsafe_walk(body, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, borrow_places, borrow_mut, borrow_binders, active_grants, table)
                        # A `for` body was never walked at all, so every unchecked index,
                        # mutable-global access and pointer arithmetic inside a loop went
                        # unreported — the one statement shape most likely to contain them.
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- strict_unsafe_expression(iterable, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(iterable, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                            table <- strict_unsafe_walk(for_body, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, borrow_places, borrow_mut, borrow_binders, active_grants, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- strict_unsafe_expression(scrutinee, line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(scrutinee, line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                            invalidated_indices: mutable darray[sview] = []
                            match_entry_places: darray[Ast::Expr] = [place for place in borrow_places]
                            match_entry_mut: darray[bool] = [flag for flag in borrow_mut]
                            match_entry_binders: darray[sview] = [binder for binder in borrow_binders]
                            arm_rebinds_borrowed_slot: mutable bool = false
                            for arm in arms |invalidated_indices, table, line, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, match_entry_places, match_entry_mut, match_entry_binders, arm_rebinds_borrowed_slot, active_grants|:
                                arm_index_params: mutable darray[sview] = [index for index in live_index_params]
                                arm_borrow_places: mutable darray[Ast::Expr] = [place for place in match_entry_places]
                                arm_borrow_mut: mutable darray[bool] = [flag for flag in match_entry_mut]
                                arm_borrow_binders: mutable darray[sview] = [binder for binder in match_entry_binders]
                                table <- strict_unsafe_expression(arm.guard, line.line, array_params, arm_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                                table <- strict_borrowed_call_check(arm.guard, line.line, arm_borrow_binders, arm_borrow_places, mr_fns, mr_positions, active_grants, table)
                                table <- strict_unsafe_walk(arm.body, array_params, arm_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, arm_borrow_places, arm_borrow_mut, arm_borrow_binders, active_grants, table)
                                if expression_contains_call(arm.guard):
                                    for index in live_index_params |invalidated_indices|:
                                        invalidated_indices.push(index) if not (any known in invalidated_indices where known == index)
                                for index in live_index_params |invalidated_indices|:
                                    invalidated_indices.push(index) if body_invalidates_bounds(arm.body, index) and not (any known in invalidated_indices where known == index)
                                arm_rebinds_borrowed_slot <- true if strict_body_rebinds_borrowed_slot(arm.body, match_entry_binders)
                            if arm_rebinds_borrowed_slot:
                                for borrow_index in 0..<borrow_places.count |borrow_places|:
                                    borrow_places[borrow_index] <- strict_alias_unknown_place() if borrow_places[borrow_index] is not Ast::Expr.Invalid
                            for invalidated in invalidated_indices:
                                live_index_params <- index_params_without(live_index_params, invalidated)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            grant_here: mutable darray[sview] = []
                            grant_here.extend(active_grants)
                            grant_here.extend(clause) if block_kind == "can" or block_kind == "trusted"
                            table <- strict_unsafe_walk(body, array_params, live_index_params, unsigned_indexes, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, mr_fns, mr_positions, borrow_places, borrow_mut, borrow_binders, grant_here, table)
                            # An `assert i < xs.count` INSIDE the block is an established
                            # fact for the statements after it (`can Abort.Panic: assert
                            # i < xs.count` then `return xs[i]` — stage0 accepts).
                            for block_statement in body |live_index_params, unsigned_indexes|:
                                match block_statement:
                                    Stmt.Contract(contract_kind, contract_expression, contract_line):
                                        asserted: sview = bounds_guard_name(contract_expression, true, unsigned_indexes) if contract_kind == "assert" else sview("", 0, 0)
                                        live_index_params <- index_params_without(live_index_params, asserted) if asserted != ""
                                    _:
                                        pass
                        Stmt.Contract(contract_kind, contract_expression, contract_line):
                            asserted_here: sview = bounds_guard_name(contract_expression, true, unsigned_indexes) if contract_kind == "assert" else sview("", 0, 0)
                            live_index_params <- index_params_without(live_index_params, asserted_here) if asserted_here != ""
                            table <- strict_unsafe_expression(contract_expression, contract_line.line, array_params, live_index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_borrowed_call_check(contract_expression, contract_line.line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        _:
                            pass

        # Mutable-ref parameter POSITIONS of every declared function.
        def collect_mutable_ref_positions(declarations: darray[Ast::Decl], out_fns: mutable darray[sview]&, out_positions: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_fns, out_positions|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            position: mutable usize = 0
                            for parameter in parameters |out_fns, out_positions, position, name|:
                                out_fns.push(name) if param_is_mutable_ref(parameter)
                                out_positions.push(position) if param_is_mutable_ref(parameter)
                                position <- position + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_mutable_ref_positions(module_body, out_fns, out_positions)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_mutable_ref_positions(scoped_body, out_fns, out_positions)
                        _:
                            pass


        # A call passing a BORROWED local at a mutable-ref position aliases the borrow.
        def strict_borrowed_call_check(expression: Ast::Expr, line: u32, borrow_binders: darray[sview]&, borrow_places: darray[Ast::Expr]&, mr_fns: darray[sview]&, mr_positions: darray[usize]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if strict_unsafe_grant_covers(active_grants, "Unsafe.Alias")
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        called: sview = ident_name_of(callee)
                        if called != "":
                            row: mutable usize = 0
                            while row < mr_fns.count |row, table| -> table:
                                applies: bool = mr_fns[row] == called and mr_positions[row] < arguments.count
                                if applies:
                                    passed_info: (found: bool, place: Ast::Expr) = strict_alias_place(arguments[mr_positions[row]], borrow_binders, borrow_places)
                                    if passed_info.found:
                                        passed_name: sview = ident_name_of(arguments[mr_positions[row]])
                                        aliased: mutable bool = false
                                        for prior in 0..<borrow_places.count |aliased|:
                                            continue if borrow_places[prior] is Ast::Expr.Invalid
                                            continue if passed_name != "" and borrow_binders[prior] == passed_name
                                            aliased <- true if strict_alias_places_overlap(borrow_places[prior], passed_info.place)
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if aliased
                                row <- row + 1
                        table <- strict_borrowed_call_check(callee, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        for argument in arguments |table|:
                            table <- strict_borrowed_call_check(argument, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.Field(object, field, field_line):
                        table <- strict_borrowed_call_check(object, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.Index(object, index, index_line):
                        table <- strict_borrowed_call_check(object, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        table <- strict_borrowed_call_check(index, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.IndexN(object, arguments, index_line):
                        table <- strict_borrowed_call_check(object, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        for argument in arguments |table|:
                            table <- strict_borrowed_call_check(argument, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- strict_borrowed_call_check(left, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        table <- strict_borrowed_call_check(right, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- strict_borrowed_call_check(operand, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.Move(operand, move_line):
                        table <- strict_borrowed_call_check(operand, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.Paren(inner, paren_line):
                        table <- strict_borrowed_call_check(inner, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- strict_borrowed_call_check(condition, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        table <- strict_borrowed_call_check(then_value, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                        table <- strict_borrowed_call_check(else_value, line, borrow_binders, borrow_places, mr_fns, mr_positions, active_grants, table)
                    _:
                        pass


        # An access (read or write) to a mutable global (`global`/`global mutable`) requires
        # `can Unsafe.MutableGlobal`. A name shadowed by a param/local is excluded (it is not
        # the global). `const` values (immutable) never require the grant.
        def is_ungranted_mutable_global(name: sview, mutable_globals: darray[sview]&, local_names: darray[sview]&) -> bool:
            can Abort.Panic:
                false return if name == ""
                false return if any local_name in local_names where local_name == name
                return any global_name in mutable_globals where global_name == name

        # A FREE-FUNCTION call as an index carries no range facts, so the access cannot be
        # proven in bounds -- `t[g()]`. stage0 flags this for both `array` and `darray`
        # receivers (verified against `-emit unsafe` both ways).
        #
        # A METHOD-STYLE call is excluded: `table[c.u32()]` is an enum-TAG index, and stage0
        # proves it in bounds from the variant count (check_enum_tag_index carries the
        # too-many-variants half). Treating those as unproven reported two enum lookups
        # stage0 accepts, which is what made a blanket call rule net-negative.
        def index_is_call(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        return match callee:
                            Expr.Field(object, field, field_line): false
                            _: true
                    _:
                        return false


        # Scan an expression for mutable-global reads ONLY (never unchecked-index / pointer
        # arithmetic), for positions where the enclosing access is already checked.
        def strict_global_only(expression: Ast::Expr, line: u32, mutable_globals: darray[sview]&, local_names: darray[sview]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalUngranted, name: name, line: line, expected: "", actual: ""}) if is_ungranted_mutable_global(name, mutable_globals, local_names) and not strict_unsafe_grant_covers(active_grants, "Unsafe.MutableGlobal")
                    Expr.Field(object, field, field_line):
                        table <- strict_global_only(object, line, mutable_globals, local_names, active_grants, table)
                    Expr.Scope(base, name, scope_line):
                        if base is not Expr.Ident(_, _):
                            table <- strict_global_only(base, line, mutable_globals, local_names, active_grants, table)
                    Expr.Paren(inner, paren_line):
                        table <- strict_global_only(inner, line, mutable_globals, local_names, active_grants, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.RegionNew(operand, _, unary_line):
                        table <- strict_global_only(operand, line, mutable_globals, local_names, active_grants, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- strict_global_only(left, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(right, line, mutable_globals, local_names, active_grants, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- strict_global_only(object, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(index_argument, line, mutable_globals, local_names, active_grants, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- strict_global_only(object, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(low, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(high, line, mutable_globals, local_names, active_grants, table)
                    Expr.IndexN(object, arguments, index_line):
                        table <- strict_global_only(object, line, mutable_globals, local_names, active_grants, table)
                        for argument in arguments |table| -> table:
                            table <- strict_global_only(argument, line, mutable_globals, local_names, active_grants, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- strict_global_only(callee, line, mutable_globals, local_names, active_grants, table)
                        for argument in arguments |table| -> table:
                            table <- strict_global_only(argument, line, mutable_globals, local_names, active_grants, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- strict_global_only(argument, line, mutable_globals, local_names, active_grants, table)
                        for candidate in candidates |table|:
                            for capture in candidate.captures |table| -> table:
                                table <- strict_global_only(capture, line, mutable_globals, local_names, active_grants, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- strict_global_only(element, line, mutable_globals, local_names, active_grants, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- strict_global_only(entry.key, line, mutable_globals, local_names, active_grants, table)
                            table <- strict_global_only(entry.value, line, mutable_globals, local_names, active_grants, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        for field in fields |table| -> table:
                            table <- strict_global_only(field.value, line, mutable_globals, local_names, active_grants, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        table <- strict_global_only(base, line, mutable_globals, local_names, active_grants, table)
                        for field in fields |table| -> table:
                            table <- strict_global_only(field.value, line, mutable_globals, local_names, active_grants, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- strict_global_only(condition, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(then_value, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(else_value, line, mutable_globals, local_names, active_grants, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- strict_global_only(scrutinee, line, mutable_globals, local_names, active_grants, table)
                        for arm in arms |table|:
                            arm_locals: mutable darray[sview] = [name for name in local_names]
                            collect_pattern_binding_names(arm.pattern, arm_locals)
                            table <- strict_global_only(arm.guard, line, mutable_globals, arm_locals, active_grants, table)
                            table <- strict_global_only_statements(arm.body, mutable_globals, arm_locals, active_grants, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- strict_global_only(iterable, line, mutable_globals, local_names, active_grants, table)
                        comprehension_locals: mutable darray[sview] = [name for name in local_names]
                        comprehension_locals.push(variable)
                        table <- strict_global_only(condition, line, mutable_globals, comprehension_locals, active_grants, table)
                        table <- strict_global_only(body, line, mutable_globals, comprehension_locals, active_grants, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- strict_global_only(base, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(predicate, line, mutable_globals, local_names, active_grants, table)
                    Expr.GetElse(guarded, recovery, getelse_line):
                        table <- strict_global_only(guarded, line, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only_statements(recovery, mutable_globals, local_names, active_grants, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- strict_global_only_statements(statements, mutable_globals, local_names, active_grants, table)
                        table <- strict_global_only(value, line, mutable_globals, local_names, active_grants, table)
                    Expr.Lambda(parameters, body, lambda_line):
                        lambda_locals: mutable darray[sview] = [name for name in local_names]
                        collect_local_names(body, lambda_locals)
                        lambda_locals.extend(parameters)
                        no_outer_grants: darray[sview] = []
                        table <- strict_global_only_statements(body, mutable_globals, lambda_locals, no_outer_grants, table)
                    _:
                        pass


        def strict_global_only_statements(statements: darray[Ast::Stmt], mutable_globals: darray[sview]&, local_names: darray[sview]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, position):
                            table <- strict_global_only(expression, position.line, mutable_globals, local_names, active_grants, table)
                        Stmt.VarDecl(name, type_expression, value, position):
                            table <- strict_global_only(value, position.line, mutable_globals, local_names, active_grants, table)
                        Stmt.Assign(target, operator, value, position):
                            table <- strict_global_only(target, position.line, mutable_globals, local_names, active_grants, table)
                            table <- strict_global_only(value, position.line, mutable_globals, local_names, active_grants, table)
                        Stmt.Return(value, position):
                            if value is returned:
                                table <- strict_global_only(returned, position.line, mutable_globals, local_names, active_grants, table)
                        Stmt.If(condition, then_body, else_body, position):
                            table <- strict_global_only(condition, position.line, mutable_globals, local_names, active_grants, table)
                            table <- strict_global_only_statements(then_body, mutable_globals, local_names, active_grants, table)
                            table <- strict_global_only_statements(else_body, mutable_globals, local_names, active_grants, table)
                        Stmt.While(condition, body, position):
                            table <- strict_global_only(condition, position.line, mutable_globals, local_names, active_grants, table)
                            table <- strict_global_only_statements(body, mutable_globals, local_names, active_grants, table)
                        Stmt.For(binding, variables, iterable, body, position):
                            table <- strict_global_only(iterable, position.line, mutable_globals, local_names, active_grants, table)
                            loop_locals: mutable darray[sview] = [name for name in local_names]
                            loop_locals.extend(variables)
                            table <- strict_global_only_statements(body, mutable_globals, loop_locals, active_grants, table)
                        Stmt.Match(scrutinee, arms, position):
                            table <- strict_global_only(scrutinee, position.line, mutable_globals, local_names, active_grants, table)
                            for arm in arms |table|:
                                arm_locals: mutable darray[sview] = [name for name in local_names]
                                collect_pattern_binding_names(arm.pattern, arm_locals)
                                table <- strict_global_only(arm.guard, position.line, mutable_globals, arm_locals, active_grants, table)
                                table <- strict_global_only_statements(arm.body, mutable_globals, arm_locals, active_grants, table)
                        Stmt.Block(kind, clause, binding, body, position):
                            nested_grants: mutable darray[sview] = [grant for grant in active_grants]
                            block_locals: mutable darray[sview] = [name for name in local_names]
                            block_locals.push(binding) if binding != ""
                            nested_grants.extend(clause) if kind == "can" or kind == "trusted"
                            table <- strict_global_only_statements(body, mutable_globals, block_locals, nested_grants, table)
                        Stmt.Contract(kind, expression, position):
                            table <- strict_global_only(expression, position.line, mutable_globals, local_names, active_grants, table)
                        _:
                            pass

        def strict_unsafe_expression(expression: Ast::Expr, line: u32, array_params: darray[sview]&, index_params: darray[sview]&, mutable_params: darray[sview]&, ref_params: darray[sview]&, mutable_globals: darray[sview]&, local_names: darray[sview]&, checked_get_lines: darray[u32]&, active_grants: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalUngranted, name: name, line: line, expected: "", actual: ""}) if is_ungranted_mutable_global(name, mutable_globals, local_names) and not strict_unsafe_grant_covers(active_grants, "Unsafe.MutableGlobal")
                    Expr.Index(object, index, index_line):
                        object_name: sview = ident_name_of(object)
                        index_name: sview = ident_name_of(index)
                        # A bare `get xs[i]` parses to a plain Index (the recovery-less
                        # checked read binding an optional); the parser records its line
                        # so the CHECKED access is exempt here.
                        checked_get: bool = any g in checked_get_lines where g == line
                        index_unproven: bool = ((any i in index_params where i == index_name) or index_is_call(index)) and not checked_get
                        # Prefer an explicit membership walk over `any … where` so the stage1
                        # self-resolver sees `object_name` as a bound local use (not a free name
                        # inside a quantified predicate).
                        is_array_param: mutable bool = false
                        for array_param in array_params |is_array_param, object_name|:
                            is_array_param <- true if array_param == object_name
                        is_unproven: bool = is_array_param and index_unproven
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UncheckedIndexUngranted, name: object_name, line: line, expected: "", actual: ""}) if is_unproven and object_name != "" and not strict_unsafe_grant_covers(active_grants, "Unsafe.UncheckedIndex")
                        table <- strict_unsafe_expression(object, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(index, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        seen: mutable darray[sview] = []
                        aliased: mutable bool = false
                        for argument in arguments |seen, aliased|:
                            base: sview = argument_alias_base(argument, mutable_params)
                            continue if base == ""
                            aliased <- true if any s in seen where s == base
                            seen.push(base)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if aliased and not strict_unsafe_grant_covers(active_grants, "Unsafe.Alias")
                        table <- strict_unsafe_expression(callee, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        for argument in arguments |table| -> table:
                            table <- strict_unsafe_expression(argument, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        for argument in arguments |table| -> table:
                            table <- strict_unsafe_expression(argument, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        for candidate in candidates |table|:
                            for capture in candidate.captures |table| -> table:
                                table <- strict_unsafe_expression(capture, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Field(object, field, field_line):
                        table <- strict_unsafe_expression(object, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Scope(base, name, scope_line):
                        if base is not Expr.Ident(_, _):
                            table <- strict_unsafe_expression(base, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- strict_unsafe_expression(object, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(low, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(high, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.IndexN(object, arguments, index_line):
                        table <- strict_unsafe_expression(object, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        for argument in arguments |table| -> table:
                            table <- strict_unsafe_expression(argument, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Binary(left, operator, right, binary_line):
                        # `xs[i] else FALLBACK` — Binary(Index, Else, fallback) is the
                        # inline CHECKED access: the left index never flags; only the
                        # fallback is walked.
                        if operator == TokenKind.Else:
                            table <- strict_unsafe_expression(right, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            return
                        # The scoped pointer-capability walk owns this obligation. Keeping its
                        # type and grant analysis in one pass avoids shape gaps and duplicate
                        # diagnostics between the general unsafe walker and the grant checker.
                        table <- strict_unsafe_expression(left, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(right, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- strict_unsafe_expression(operand, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Move(operand, move_line) | Expr.RegionNew(operand, _, move_line):
                        table <- strict_unsafe_expression(operand, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Paren(inner, paren_line):
                        table <- strict_unsafe_expression(inner, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- strict_unsafe_expression(element, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- strict_unsafe_expression(entry.key, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                            table <- strict_unsafe_expression(entry.value, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        for field in fields |table| -> table:
                            table <- strict_unsafe_expression(field.value, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        table <- strict_unsafe_expression(base, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        for field in fields |table| -> table:
                            table <- strict_unsafe_expression(field.value, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- strict_unsafe_expression(condition, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(then_value, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(else_value, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- strict_unsafe_expression(scrutinee, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        for arm in arms |table|:
                            arm_locals: mutable darray[sview] = [name for name in local_names]
                            collect_pattern_binding_names(arm.pattern, arm_locals)
                            table <- strict_unsafe_expression(arm.guard, line, array_params, index_params, mutable_params, ref_params, mutable_globals, arm_locals, checked_get_lines, active_grants, table)
                            table <- strict_unsafe_expression_statements(arm.body, array_params, index_params, mutable_params, ref_params, mutable_globals, arm_locals, checked_get_lines, active_grants, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- strict_unsafe_expression(iterable, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        comprehension_locals: mutable darray[sview] = [name for name in local_names]
                        comprehension_locals.push(variable)
                        table <- strict_unsafe_expression(condition, line, array_params, index_params, mutable_params, ref_params, mutable_globals, comprehension_locals, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(body, line, array_params, index_params, mutable_params, ref_params, mutable_globals, comprehension_locals, checked_get_lines, active_grants, table)
                    # `get xs[i] else 0` — Refinement(fallback, guarded): the guarded
                    # access is CHECKED (absence propagates to the fallback), never an
                    # unchecked index. The fallback itself is still walked.
                    Expr.Refinement(fallback_base, guarded_predicate, refinement_line):
                        table <- strict_unsafe_expression(fallback_base, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        # The guarded side is checked for bounds, but calls and pointer
                        # arithmetic nested inside it still require their own capabilities.
                        table <- strict_unsafe_expression(guarded_predicate, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    # `get xs[i] else return/break` — same: the guarded access is checked.
                    Expr.GetElse(guarded_value, recovery_body, getelse_line):
                        checked_lines: mutable darray[u32] = [checked_line for checked_line in checked_get_lines]
                        checked_lines.push(getelse_line.line) if not (any checked_line in checked_lines where checked_line == getelse_line.line)
                        table <- strict_unsafe_expression(guarded_value, getelse_line.line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_lines, active_grants, table)
                        table <- strict_unsafe_expression_statements(recovery_body, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_lines, active_grants, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- strict_unsafe_expression_statements(statements, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                        table <- strict_unsafe_expression(value, line, array_params, index_params, mutable_params, ref_params, mutable_globals, local_names, checked_get_lines, active_grants, table)
                    Expr.Lambda(parameters, body, lambda_line):
                        lambda_locals: mutable darray[sview] = [name for name in local_names]
                        collect_local_names(body, lambda_locals)
                        lambda_locals.extend(parameters)
                        no_outer_grants: darray[sview] = []
                        table <- strict_unsafe_expression_statements(body, array_params, index_params, mutable_params, ref_params, mutable_globals, lambda_locals, checked_get_lines, no_outer_grants, table)
                    _:
                        pass
