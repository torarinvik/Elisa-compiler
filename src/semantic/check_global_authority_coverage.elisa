# Capability aliases are resolved in the declaration namespace. Their members
# retain that namespace during recursive expansion; a caller cannot rebind them.
extend Semantic:
    private:
        def ga_index_capabilities(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in state.annotations |state|:
                    if annotation.owner == "__permission_decl":
                        state.permission_names.push(annotation.name)
                        state.permission_scopes.push(ga_module_text(annotation.module, state))
                    if annotation.line == COV_ALIAS_MEMBER_ROW:
                        state.capability_heads <- state.capability_heads.put(name_hash(annotation.owner), state.capability_names.count) can Global{Read,Write}
                        state.capability_names.push(annotation.owner)
                        state.capability_scopes.push(ga_module_text(annotation.module, state))
                        state.capability_refs.push(annotation.name)
                state.capabilities_indexed <- true

        def ga_text_module(path: sview, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                separator: mutable usize = 0
                while separator < sview_len(path) and sview_at(path, separator) != 58 |separator|:
                    separator <- separator + 1
                first: sview = effect_ref_trim_layout(path[0:separator])
                lexical: mutable usize = lexical_scope
                parent: mutable usize = state.modules.count
                while true |lexical, parent|:
                    parent <- ga_child(state, lexical, first)
                    break if parent < state.modules.count
                    for alias in state.annotations |parent|:
                        if alias.name == "__using_alias" and alias.owner == first and ga_module_text(alias.module, state) == lexical:
                            for target in state.annotations |parent|:
                                parent <- ga_module_text(target.owner, state) if target.name == "__using_alias_target" and target.offset == alias.offset and target.line == alias.line and target.module == alias.module
                    break if parent < state.modules.count or lexical == 0
                    lexical <- state.parents[lexical]
                start: mutable usize = separator + 2
                while start < sview_len(path) and parent < state.modules.count |start, parent|:
                    end: mutable usize = start
                    while end < sview_len(path) and sview_at(path, end) != 58 |end|:
                        end <- end + 1
                    parent <- ga_child(state, parent, effect_ref_trim_layout(path[start:end]))
                    start <- end + 2
                return parent

        # Preserve namespace qualification for canonical lookup. The legacy
        # effect_ref_family helper intentionally returns only the leaf spelling.
        def ga_ref_head(ref: sview) -> sview:
            can Abort.Panic:
                abstract_ref: sview = effect_ref_abstract(ref)
                for index in 0..<sview_len(abstract_ref):
                    return abstract_ref[0:index] if sview_at(abstract_ref, index) == 46 or sview_at(abstract_ref, index) == 91
                return abstract_ref

        def ga_capability_slot(ref: sview, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                state.capability_names.count return if state.capability_names.count == 0
                family: sview = ga_ref_head(ref)
                last_scope: mutable usize = sview_len(family)
                for index in 0..<sview_len(family) |last_scope|:
                    last_scope <- index if sview_at(family, index) == 58 and index + 1 < sview_len(family) and sview_at(family, index + 1) == 58
                if last_scope < sview_len(family):
                    leaf: sview = family[last_scope + 2:sview_len(family)]
                    state.capability_names.count return if state.capability_heads.get(name_hash(leaf)) == null
                    parent: usize = ga_text_module(family[0:last_scope], lexical_scope, state)
                    return ga_resolve(leaf, parent, true, state.capability_names, state.capability_scopes, state)
                state.capability_names.count return if state.capability_heads.get(name_hash(family)) == null
                return ga_resolve(family, lexical_scope, false, state.capability_names, state.capability_scopes, state)

        def ga_permission_slot(ref: sview, lexical_scope: usize, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                head: sview = ga_ref_head(ref)
                last_scope: mutable usize = sview_len(head)
                for index in 0..<sview_len(head) |last_scope|:
                    last_scope <- index if sview_at(head, index) == 58 and index + 1 < sview_len(head) and sview_at(head, index + 1) == 58
                if last_scope < sview_len(head):
                    parent: usize = ga_text_module(head[0:last_scope], lexical_scope, state)
                    return ga_resolve(head[last_scope + 2:sview_len(head)], parent, true, state.permission_names, state.permission_scopes, state)
                return ga_resolve(head, lexical_scope, false, state.permission_names, state.permission_scopes, state)

        def ga_ref_covers(grant: sview, required: sview, grant_scope: usize, required_scope: usize, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 32
                grant_alias: usize = ga_capability_slot(grant, grant_scope, state)
                required_alias: usize = ga_capability_slot(required, required_scope, state)
                if required_alias < state.capability_names.count:
                    for row in 0..<state.capability_names.count:
                        if state.capability_names[row] == state.capability_names[required_alias] and state.capability_scopes[row] == state.capability_scopes[required_alias]:
                            false return if not ga_ref_covers(grant, state.capability_refs[row], grant_scope, state.capability_scopes[row], state, depth + 1)
                    return true
                if grant_alias < state.capability_names.count:
                    for row in 0..<state.capability_names.count:
                        if state.capability_names[row] == state.capability_names[grant_alias] and state.capability_scopes[row] == state.capability_scopes[grant_alias]:
                            true return if ga_ref_covers(state.capability_refs[row], required, state.capability_scopes[row], required_scope, state, depth + 1)
                    return false
                true return if grant == "any"
                grant_permission: usize = ga_permission_slot(grant, grant_scope, state)
                required_permission: usize = ga_permission_slot(required, required_scope, state)
                same_head: mutable bool = ga_ref_head(grant) == ga_ref_head(required)
                if grant_permission < state.permission_names.count or required_permission < state.permission_names.count:
                    same_head <- grant_permission < state.permission_names.count and required_permission < state.permission_names.count and state.permission_names[grant_permission] == state.permission_names[required_permission] and state.permission_scopes[grant_permission] == state.permission_scopes[required_permission]
                grant_abstract: sview = effect_ref_abstract(grant)
                required_abstract: sview = effect_ref_abstract(required)
                grant_suffix: sview = grant_abstract[sview_len(ga_ref_head(grant)):sview_len(grant_abstract)]
                required_suffix: sview = required_abstract[sview_len(ga_ref_head(required)):sview_len(required_abstract)]
                true return if same_head and grant_suffix == required_suffix and effect_ref_via(grant) == effect_ref_via(required)
                true return if same_head and grant_suffix == "" and effect_ref_via(grant) == ""
                via: sview = effect_ref_via(grant)
                if via != "":
                    true return if ga_ref_covers(via, required, grant_scope, required_scope, state, depth + 1)
                    true return if ga_ref_covers(effect_ref_abstract(grant), effect_ref_abstract(required), grant_scope, required_scope, state, depth + 1)
                if grant_suffix == "":
                    declaration: usize = grant_permission
                    declared_scope: usize = state.permission_scopes[declaration] if declaration < state.permission_names.count else grant_scope
                    for annotation in state.annotations:
                        if annotation.line == COV_PERMISSION_INCLUDE_ROW and annotation.owner == (state.permission_names[declaration] if declaration < state.permission_names.count else grant) and ga_module_text(annotation.module, state) == declared_scope:
                            true return if ga_ref_covers(annotation.name, required, declared_scope, required_scope, state, depth + 1)
                return false

        def ga_refs_cover(grants: darray[sview]&, scopes: darray[usize]&, required: sview, required_scope: usize, state: GlobalAuthority&, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if required == ""
                false return if depth > 32
                alias: usize = ga_capability_slot(required, required_scope, state)
                if alias < state.capability_names.count:
                    for row in 0..<state.capability_names.count:
                        if state.capability_names[row] == state.capability_names[alias] and state.capability_scopes[row] == state.capability_scopes[alias]:
                            false return if not ga_refs_cover(grants, scopes, state.capability_refs[row], state.capability_scopes[row], state, depth + 1)
                    return true
                for index in 0..<grants.count:
                    true return if ga_ref_covers(grants[index], required, scopes[index] if index < scopes.count else state.module_scope, required_scope, state, depth + 1)
                return false
