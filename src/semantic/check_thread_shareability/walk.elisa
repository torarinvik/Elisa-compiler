extend Semantic:
    private:
        def walk_thread_shareability_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, names: mutable darray[sview @source]&, flags: mutable darray[bool]&, element_flags: mutable darray[bool]&, pool_types: mutable darray[sview @source]&, pool_mutability: mutable darray[bool]&, callbacks: mutable ThreadCallbackIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_thread_boundary_call(callee, arguments, line.line, names, flags, callbacks, table)
                        table <- walk_thread_shareability_expression(callee, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        for argument in arguments |table|:
                            table <- walk_thread_shareability_expression(argument, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.StaticEffectCall(arguments: arguments, _):
                        for argument in arguments |table|:
                            table <- walk_thread_shareability_expression(argument, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.Field(object, _, _):
                        table <- walk_thread_shareability_expression(object, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _) | Expr.Refinement(object, index, _):
                        table <- walk_thread_shareability_expression(object, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        table <- walk_thread_shareability_expression(index, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.IndexN(object, indices, _):
                        table <- walk_thread_shareability_expression(object, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        for index in indices |table|:
                            table <- walk_thread_shareability_expression(index, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.Slice(object, low, high, _):
                        table <- walk_thread_shareability_expression(object, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        table <- walk_thread_shareability_expression(low, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        table <- walk_thread_shareability_expression(high, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.Unary(operator, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- walk_thread_shareability_expression(operand, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table|:
                            table <- walk_thread_shareability_expression(element, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table|:
                            table <- walk_thread_shareability_expression(entry.key, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            table <- walk_thread_shareability_expression(entry.value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.Construct(_, fields, _):
                        for field in fields |table|:
                            table <- walk_thread_shareability_expression(field.value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.RecordUpdate(base, fields, _):
                        table <- walk_thread_shareability_expression(base, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        for field in fields |table|:
                            table <- walk_thread_shareability_expression(field.value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                    Expr.If(condition, then_value, else_value, _):
                        table <- walk_thread_shareability_expression(condition, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        names_before: usize = names.count
                        table <- walk_thread_shareability_expression(then_value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                        table <- walk_thread_shareability_expression(else_value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                    Expr.Match(scrutinee, arms, _):
                        table <- walk_thread_shareability_expression(scrutinee, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        for arm in arms |table, names, flags, element_flags, pool_types, pool_mutability|:
                            names_before: usize = names.count
                            thread_push_arm_binders(arm, thread_expression_may_reference(scrutinee, names, flags, callbacks, table), names, flags, element_flags, pool_types, pool_mutability)
                            table <- walk_thread_shareability_expression(arm.guard, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            table <- walk_thread_shareability_statements(arm.body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                    Expr.Catch(guarded, arms, _):
                        table <- walk_thread_shareability_expression(guarded, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        for arm in arms |table, names, flags, element_flags, pool_types, pool_mutability|:
                            names_before: usize = names.count
                            thread_push_arm_binders(arm, true, names, flags, element_flags, pool_types, pool_mutability)
                            table <- walk_thread_shareability_expression(arm.guard, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            table <- walk_thread_shareability_statements(arm.body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        table <- walk_thread_shareability_expression(iterable, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        names_before: usize = names.count
                        comprehension_items_may_reference: mutable bool = false
                        comprehension_items_may_reference <- thread_iterable_binder_may_reference(iterable, names, flags, element_flags, callbacks, table)
                        names.push(variable)
                        flags.push(comprehension_items_may_reference)
                        element_flags.push(comprehension_items_may_reference)
                        pool_types.push("")
                        pool_mutability.push(false)
                        table <- walk_thread_shareability_expression(condition, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        table <- walk_thread_shareability_expression(body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                    Expr.GetElse(guarded, recovery, _):
                        table <- walk_thread_shareability_expression(guarded, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        names_before: usize = names.count
                        table <- walk_thread_shareability_statements(recovery, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                    Expr.Lambda(parameters, body, _):
                        names_before: usize = names.count
                        for parameter in parameters |names, flags, element_flags, pool_types, pool_mutability|:
                            names.push(parameter)
                            flags.push(true)
                            element_flags.push(true)
                            pool_types.push("")
                            pool_mutability.push(false)
                        table <- walk_thread_shareability_statements(body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                    # `submit f(a, b)` parses as a statement-less value block around the call and
                    # lowers to pool_submit1(pool, f, payload): every argument is a payload.
                    Expr.Block(block_statements, block_value, _, line):
                        if block_statements.count == 0 and thread_has_submit_marker(annotations, line):
                            table <- thread_validate_named_pool("__submit_pool", annotations, line.offset, line.line, names, pool_types, pool_mutability, table)
                            match block_value:
                                Expr.Call(_, task_arguments, _, task_pos):
                                    for task_argument in task_arguments |table|:
                                        table <- report_thread_payload("pool_submit1", task_argument, task_pos.line, names, flags, callbacks, table)
                                        table <- walk_thread_shareability_expression(task_argument, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                                _:
                                    pass
                        else:
                            names_before: usize = names.count
                            table <- walk_thread_shareability_statements(block_statements, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            table <- walk_thread_shareability_expression(block_value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                    # `Scope` and `ShorthandMember` nodes contain type/member selectors,
                    # not evaluated values. Literals and identifiers have no children.
                    _:
                        pass


        def walk_thread_shareability_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, names: mutable darray[sview @source]&, flags: mutable darray[bool]&, element_flags: mutable darray[bool]&, pool_types: mutable darray[sview @source]&, pool_mutability: mutable darray[bool]&, callbacks: mutable ThreadCallbackIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |names, flags, element_flags, pool_types, pool_mutability, table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_thread_shareability_expression(value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            declared_elements_may_reference: mutable bool = false
                            if (type_expression is Expr.Absent) or (type_expression is Expr.Invalid):
                                declared_elements_may_reference <- thread_iterable_binder_may_reference(value, names, flags, element_flags, callbacks, table)
                            else:
                                declared_elements_may_reference <- type_iterable_element_may_reference(type_expression, table, callbacks)
                            declared_value_may_reference: mutable bool = type_is_nonstatic_reference(type_expression)
                            if not declared_value_may_reference:
                                module_scope: sview = table.current_module
                                declared_value_may_reference <- thread_type_may_contain_nonstatic_reference(type_expression, table, callbacks, module_scope)
                            # A declared type is what the binding holds (stage0 checks types); the
                            # initializer's provenance only matters for an inferred binding.
                            if not declared_value_may_reference and ((type_expression is Expr.Absent) or (type_expression is Expr.Invalid)):
                                declared_value_may_reference <- thread_expression_may_reference(value, names, flags, callbacks, table)
                            if not declared_value_may_reference:
                                declared_value_may_reference <- thread_payload_borrows_local(value, names, flags)
                            if not declared_value_may_reference:
                                declared_value_may_reference <- thread_expression_type_contains_nonstatic_reference(value, callbacks, table)
                            names.push(name)
                            flags.push(declared_value_may_reference)
                            element_flags.push(declared_elements_may_reference)
                            pool_types.push(thread_submit_type_name(type_expression, value, table))
                            pool_mutability.push(thread_submit_binding_writable(type_expression, local_binding_is_mutable(name, line.line, line.offset, type_expression, table)))
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_thread_shareability_expression(target, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            table <- walk_thread_shareability_expression(value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            if operator == TokenKind.Assign:
                                match target:
                                    Expr.Ident(name, _):
                                        if not any bound_name in names where bound_name == name:
                                            value_may_reference: mutable bool = thread_expression_may_reference(value, names, flags, callbacks, table)
                                            if not value_may_reference:
                                                value_may_reference <- thread_payload_borrows_local(value, names, flags)
                                            if not value_may_reference:
                                                value_may_reference <- thread_expression_type_contains_nonstatic_reference(value, callbacks, table)
                                            names.push(name)
                                            flags.push(value_may_reference)
                                            element_flags.push(value_may_reference)
                                            pool_types.push(thread_submit_type_name(Ast::Expr.Absent, value, table))
                                            pool_mutability.push(thread_submit_binding_writable(Ast::Expr.Absent, local_binding_is_mutable(name, line.line, line.offset, Ast::Expr.Absent, table)))
                                    _:
                                        pass
                        Stmt.Expr(value, line):
                            table <- walk_thread_shareability_expression(value, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- walk_thread_shareability_expression(returned, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_thread_shareability_expression(condition, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            names_before: usize = names.count
                            table <- walk_thread_shareability_statements(then_body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                            table <- walk_thread_shareability_statements(else_body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                        Stmt.Block(kind, clause, binding, body, line):
                            names_before: usize = names.count
                            table <- thread_validate_named_pool("__nursery_pool", annotations, line.offset, line.line, names, pool_types, pool_mutability, table) if kind == "nursery" and clause.count == 2 and clause[0] == "on"
                            if binding != "":
                                names.push(binding)
                                flags.push(false)
                                element_flags.push(false)
                                pool_types.push("")
                                pool_mutability.push(false)
                            table <- walk_thread_shareability_statements(body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                        Stmt.While(condition, body, line):
                            table <- walk_thread_shareability_expression(condition, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            names_before: usize = names.count
                            table <- walk_thread_shareability_statements(body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                        Stmt.For(_, variables, iterable, body, line):
                            table <- walk_thread_shareability_expression(iterable, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            names_before: usize = names.count
                            loop_items_may_reference: mutable bool = false
                            loop_items_may_reference <- thread_iterable_binder_may_reference(iterable, names, flags, element_flags, callbacks, table)
                            for variable in variables |names, flags, element_flags, pool_types, pool_mutability|:
                                names.push(variable)
                                flags.push(loop_items_may_reference)
                                element_flags.push(loop_items_may_reference)
                                pool_types.push("")
                                pool_mutability.push(false)
                            table <- walk_thread_shareability_statements(body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_thread_shareability_expression(scrutinee, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            for arm in arms |names, flags, element_flags, pool_types, pool_mutability, table|:
                                names_before: usize = names.count
                                thread_push_arm_binders(arm, thread_expression_may_reference(scrutinee, names, flags, callbacks, table), names, flags, element_flags, pool_types, pool_mutability)
                                table <- walk_thread_shareability_expression(arm.guard, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                                table <- walk_thread_shareability_statements(arm.body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                                thread_restore_scope(names, flags, element_flags, pool_types, pool_mutability, names_before)
                        Stmt.Contract(_, expression, line):
                            table <- walk_thread_shareability_expression(expression, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                        _:
                            pass


        def collect_thread_callbacks(declarations: darray[Ast::Decl], file: Ast::File&, module_scope: sview @source, callbacks: mutable ThreadCallbackIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |callbacks|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            callbacks.names <- callbacks.names.push(name)
                            callbacks.modules <- callbacks.modules.push(module_scope)
                            callbacks.return_types <- callbacks.return_types.push(return_expression if return_type is return_expression else Ast::Expr.Absent)
                            callbacks.flags <- callbacks.flags.push(false)
                            callbacks.classified <- callbacks.classified.push(false)
                            callbacks.lines.push(line.line)
                            callbacks.row_generic.push(false)
                            callback_row: u32 = (callbacks.names.count - 1.usize()).u32()
                            callbacks.duplicate_next <- callbacks.duplicate_next.push(THREAD_CALLBACK_INDEX_NONE)
                            callbacks.duplicate_tail <- callbacks.duplicate_tail.push(callback_row)
                        Decl.Struct(name: name, pos: line, _):
                            can Global{Read,Write}:
                                thread_index_type_declaration(callbacks, name, module_scope, line.line, declaration)
                        Decl.Enum(name: name, pos: line, _):
                            can Global{Read,Write}:
                                thread_index_type_declaration(callbacks, name, module_scope, line.line, declaration)
                        Decl.Module(name, body, line):
                            can Global{Read,Write}:
                                collect_thread_callbacks(body, file, name, callbacks)
                        Decl.Scoped(body, line):
                            can Global{Read,Write}:
                                collect_thread_callbacks(body, file, module_scope, callbacks)
                        _:
                            pass


        def thread_index_synthetic_payload_types(file: Ast::File&, callbacks: mutable ThreadCallbackIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                # Function-local state/start enums are flattened by the parser because their
                # nested declaration fields do not survive in `Decl`. Rejoin those exact AST
                # expressions so their payloads receive the same qualifier-aware walk.
                for enum_index in 0..<file.payload_enum_names.count |callbacks, file|:
                    enum_name: sview = file.payload_enum_names[enum_index]
                    enum_module: sview = file.payload_enum_owners[enum_index] if enum_index < file.payload_enum_owners.count else ""
                    variant_start: usize = file.payload_enum_variant_starts[enum_index]
                    variant_count: usize = file.payload_enum_variant_counts[enum_index]
                    for variant_offset in 0..<variant_count |callbacks, file|:
                        variant_slot: usize = variant_start + variant_offset
                        field_start: usize = file.payload_enum_variant_field_starts[variant_slot]
                        field_count: usize = file.payload_enum_variant_field_counts[variant_slot]
                        for field_offset in 0..<field_count |callbacks, file|:
                            can Global{Read,Write}:
                                thread_index_type_expression(callbacks, enum_name, enum_module, 0, file.payload_enum_variant_fields[field_start + field_offset])


        def check_thread_shareability_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, callbacks: mutable ThreadCallbackIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview @source] = []
                            flags: mutable darray[bool] = []
                            element_flags: mutable darray[bool] = []
                            pool_types: mutable darray[sview @source] = []
                            pool_mutability: mutable darray[bool] = []
                            callbacks.function_line <- line.line
                            callbacks.function_name <- name
                            callbacks.function_params.clear()
                            callbacks.function_param_deferred.clear()
                            callbacks.function_param_is_fn.clear()
                            for param in params |names, flags, element_flags, pool_types, pool_mutability, table|:
                                names.push(param.name)
                                callbacks.generic_deferred <- false
                                param_may_reference: mutable bool = type_is_nonstatic_reference(param.type_expression)
                                if not param_may_reference:
                                    module_scope: sview = table.current_module
                                    param_may_reference <- thread_type_may_contain_nonstatic_reference(param.type_expression, table, callbacks, module_scope)
                                callbacks.function_params.push(param.name)
                                callbacks.function_param_deferred.push(callbacks.generic_deferred and not param_may_reference)
                                callbacks.function_param_is_fn.push(thread_type_is_fn(param.type_expression))
                                flags.push(param_may_reference)
                                element_flags.push(type_iterable_element_may_reference(param.type_expression, table, callbacks))
                                pool_types.push(thread_submit_type_name(param.type_expression, Ast::Expr.Absent, table))
                                pool_mutability.push(thread_submit_binding_writable(param.type_expression, param.is_mutable))
                            table <- walk_thread_shareability_statements(body, annotations, names, flags, element_flags, pool_types, pool_mutability, callbacks, table)
                            callbacks.function_line <- 0
                            callbacks.function_name <- ""
                            callbacks.function_params.clear()
                            callbacks.function_param_deferred.clear()
                            callbacks.function_param_is_fn.clear()
                        Decl.Module(name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- name
                            table <- check_thread_shareability_declarations(body, annotations, callbacks, table)
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- check_thread_shareability_declarations(body, annotations, callbacks, table)
                        _:
                            pass

    public:
        def check_thread_shareability(declarations: darray[Ast::Decl], file: Ast::File&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                # For small alias sets the linear resolver is cheaper than building the
                # per-pass maps. This threshold is a static allocation tradeoff and needs a
                # compile-time scorecard before treating the index as a net performance win.
                if table.type_alias_name.count >= THREAD_ALIAS_INDEX_MIN_ROWS:
                    can Global{Read,Write}:
                        table <- thread_build_alias_name_index(table)
                callbacks: mutable ThreadCallbackIndex = new_thread_callback_index()
                can Global{Read,Write}:
                    collect_thread_callbacks(declarations, file, "", callbacks)
                    thread_index_synthetic_payload_types(file, callbacks)
                # Keep the submit markers, explicit pool selectors, and global mutability
                # facts used by this boundary walk; discard the rest of the annotation table.
                submit_markers: mutable darray[Ast::EnumAnnotation] = []
                for annotation in annotations |submit_markers|:
                    submit_markers.push(annotation) if annotation.name == "__submit" or annotation.name == "__submit_pool" or annotation.name == "__nursery_pool" or annotation.name == "__global_mutable"
                # A derived boundary found late (after its callers were walked) reruns the walk;
                # chains (`task` forwards to `spawn1`) settle within a few rounds.
                diagnostic_mark: usize = table.diagnostics.count
                for round in 0..<4 |callbacks, table|:
                    derived_before: usize = callbacks.derived_names.count
                    table <- check_thread_shareability_declarations(declarations, submit_markers, callbacks, table)
                    break if callbacks.derived_names.count == derived_before
                    table.diagnostics <- table.diagnostics.truncate(diagnostic_mark) if round < 3
