extend Semantic:
    private:
        def thread_named_type_contains_nonstatic_reference(name: sview @source, module_scope: sview @source, table: SymbolTable&, callbacks: mutable ThreadCallbackIndex&, visited: mutable ThreadTypeVisitSet&, depth: usize, static_context: bool, generic_scope_line: u32) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                return true if depth > 16.usize()
                return false if name == ""
                return true if (name == "view" or name == "sview") and not static_context
                return false if:
                    name == "sview" and static_context
                    # A generic member type is substituted by the arguments already walked at
                    # its use site. Scope this exemption to the declaration that owns the member;
                    # generic names elsewhere in the file must not shadow a concrete type here.
                    thread_generic_name_at_line(table, generic_scope_line, name)
                if thread_generic_name_at_line(table, callbacks.function_line, name):
                    callbacks.generic_deferred <- true
                    return false
                if not static_context:
                    return false if thread_type_visit_contains(visited, module_scope, name)
                    thread_type_visit_add(visited, module_scope, name)
                # The name index selects candidate aliases; the full target AST preserves
                # reference qualifiers and is checked for every same-name candidate.
                found_exact_alias: mutable bool = false
                if thread_alias_name_index_is_valid(table):
                    alias_hash: u64 = name_hash(name)
                    alias_row: mutable u32 = THREAD_ALIAS_INDEX_NONE
                    expected_alias_count: mutable u32 = 0
                    expected_alias_tail: mutable u32 = THREAD_ALIAS_INDEX_NONE
                    can Global{Read,Write}:
                        alias_row <- row if table.thread_alias_name_heads.get(alias_hash) is row
                        expected_alias_count <- count if table.thread_alias_name_counts.get(alias_hash) is count
                        expected_alias_tail <- tail_row if table.thread_alias_name_tails.get(alias_hash) is tail_row
                    has_alias_head: bool = alias_row != THREAD_ALIAS_INDEX_NONE
                    has_alias_tail: bool = expected_alias_tail != THREAD_ALIAS_INDEX_NONE
                    return true if:
                        expected_alias_count == 0 and (has_alias_head or has_alias_tail)
                        expected_alias_count > 0 and (not has_alias_head or not has_alias_tail)
                        expected_alias_count.usize() > table.type_alias_name.count
                    alias_steps: mutable usize = 0.usize()
                    last_alias_row: mutable u32 = THREAD_ALIAS_INDEX_NONE
                    while alias_row != THREAD_ALIAS_INDEX_NONE and alias_steps < expected_alias_count.usize() |alias_row, alias_hash, name, table, callbacks, visited, depth, alias_steps, last_alias_row|:
                        alias_index: usize = alias_row.usize()
                        return true if:
                            alias_index >= table.type_alias_name.count or alias_index >= table.type_alias_target.count or alias_index >= table.type_alias_module.count or alias_index >= table.type_alias_declarations.count or alias_index >= table.thread_alias_name_next.count
                            alias_steps > 0 and alias_row <= last_alias_row
                            name_hash(table.type_alias_name[alias_index]) != alias_hash
                        found_exact_alias <- true if alias_index < table.type_alias_module.count and table.type_alias_name[alias_index] == name and table.type_alias_module[alias_index] == module_scope
                        return true if thread_alias_row_contains_nonstatic_reference(alias_index, name, module_scope, table, callbacks, visited, depth, static_context)
                        last_alias_row <- alias_row
                        alias_row <- table.thread_alias_name_next[alias_index]
                        alias_steps <- alias_steps + 1.usize()
                    return true if alias_row != THREAD_ALIAS_INDEX_NONE or alias_steps != expected_alias_count.usize() or last_alias_row != expected_alias_tail
                else:
                    for alias_index in 0..<table.type_alias_name.count |alias_index, name, table, callbacks, visited, depth|:
                        found_exact_alias <- true if alias_index < table.type_alias_module.count and table.type_alias_name[alias_index] == name and table.type_alias_module[alias_index] == module_scope
                        return true if thread_alias_row_contains_nonstatic_reference(alias_index, name, module_scope, table, callbacks, visited, depth, static_context)
                # Source AST declaration rows include positional struct fields and enum
                # payloads while preserving reference qualifiers erased by type interning.
                # Synthetic function-local enum payloads remain expression rows.
                return true if callbacks.type_owners.count != callbacks.type_owner_modules.count or callbacks.type_owners.count != callbacks.type_owner_lines.count or callbacks.type_owners.count != callbacks.type_sources.count or callbacks.type_owners.count != callbacks.type_next.count
                type_hash: u64 = name_hash(name)
                expected_count: mutable u32 = 0
                expected_tail: mutable u32 = THREAD_CALLBACK_INDEX_NONE
                type_head_row: mutable u32 = THREAD_CALLBACK_INDEX_NONE
                can Global{Read,Write}:
                    expected_count <- count if callbacks.type_counts.get(type_hash) is count
                    expected_tail <- tail_row if callbacks.type_tails.get(type_hash) is tail_row
                    type_head_row <- head_row if callbacks.type_heads.get(type_hash) is head_row
                has_head: bool = type_head_row != THREAD_CALLBACK_INDEX_NONE
                has_tail: bool = expected_tail != THREAD_CALLBACK_INDEX_NONE
                return true if:
                    expected_count == 0 and (has_head or has_tail)
                    expected_count > 0 and (not has_head or not has_tail)
                type_row: mutable u32 = type_head_row
                type_steps: mutable usize = 0.usize()
                last_type_row: mutable u32 = THREAD_CALLBACK_INDEX_NONE
                found_exact_type: mutable bool = false
                while type_row != THREAD_CALLBACK_INDEX_NONE and type_steps < callbacks.type_owners.count |type_row, name, table, callbacks, visited, depth, type_steps|:
                    type_index: usize = type_row.usize()
                    return true if type_index >= callbacks.type_owners.count or type_index >= callbacks.type_owner_modules.count or type_index >= callbacks.type_owner_lines.count or type_index >= callbacks.type_sources.count or type_index >= callbacks.type_next.count
                    if callbacks.type_owners[type_index] == name:
                        if callbacks.type_owner_modules[type_index] == module_scope:
                            found_exact_type <- true
                            match callbacks.type_sources[type_index]:
                                ThreadTypeSource.Declaration(declaration):
                                    return true if thread_type_declaration_contains_nonstatic_reference(declaration, table, callbacks, visited, depth + 1.usize(), callbacks.type_owner_lines[type_index], callbacks.type_owner_modules[type_index])
                                ThreadTypeSource.Expression(expression):
                                    return true if thread_type_contains_nonstatic_reference(expression, table, callbacks, visited, depth + 1.usize(), false, callbacks.type_owner_lines[type_index], callbacks.type_owner_modules[type_index])
                    last_type_row <- type_row
                    type_row <- callbacks.type_next[type_index]
                    type_steps <- type_steps + 1.usize()
                return true if type_row != THREAD_CALLBACK_INDEX_NONE or type_steps != expected_count.usize() or last_type_row != expected_tail
                field_row: mutable u32 = struct_field_owner_head(table, name)
                while field_row != SYMBOL_INDEX_ROW_NONE |field_row, name, table, callbacks, visited, depth|:
                    field_index: usize = field_row.usize()
                    if table.struct_field_owner[field_index] == name and field_index < table.private_field_types.count and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == module_scope:
                        return true if thread_type_contains_nonstatic_reference(table.private_field_types[field_index], table, callbacks, visited, depth + 1.usize(), false, 0, module_scope)
                    field_row <- table.struct_field_owner_next[field_index]
                symbol_row: mutable u32 = symbol_chain_head(table, name)
                symbol_steps: mutable usize = 0.usize()
                while symbol_row != SYMBOL_INDEX_ROW_NONE and symbol_steps < table.symbols.count |symbol_row, name, table, symbol_steps|:
                    symbol_index: usize = symbol_row.usize()
                    return true if symbol_index >= table.symbols.count or symbol_index >= table.symbol_name_next.count
                    if symbol_index < table.symbols.count and table.symbols[symbol_index].name == name:
                        kind: SymbolKind = table.symbols[symbol_index].kind
                        if kind == SymbolKind.Struct or kind == SymbolKind.Enum:
                            return false if found_exact_type or thread_builtin_struct_name(name)
                            return true
                        if kind == SymbolKind.Alias:
                            return false if found_exact_alias
                            return true
                        return false if is_builtin_type_name(name) or name == "cstr" or name == "dstr"
                    symbol_row <- table.symbol_name_next[symbol_index]
                    symbol_steps <- symbol_steps + 1.usize()
                return true if symbol_row != SYMBOL_INDEX_ROW_NONE
                # An unresolved or non-type symbol may represent a generic/imported
                # aggregate whose members are not represented in this file.
                return true


        def thread_type_may_contain_nonstatic_reference(type_expression: Ast::Expr, table: SymbolTable&, callbacks: mutable ThreadCallbackIndex&, module_scope: sview @source) -> bool can[Abort.Panic, Memory.Allocate]:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                visited: mutable ThreadTypeVisitSet = ThreadTypeVisitSet{names: [], modules: [], slots: []}
                return thread_type_contains_nonstatic_reference(type_expression, table, callbacks, visited, 0.usize(), false, 0, module_scope)


        def thread_submit_expr_type_name(expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Call(Expr.Ident(name, _), _, _, _) if name == "pool_new":
                        return "ThreadPool"
                    Expr.Construct(type_expression, _, _) | Expr.RecordUpdate(type_expression, _, _):
                        return affine_owner_through_ref(type_expression, table)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return thread_submit_expr_type_name(inner, table)
                    _:
                        return ""


        def thread_submit_type_name(type_expression: Ast::Expr, value: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                return thread_submit_expr_type_name(value, table) if (type_expression is Ast::Expr.Absent) or (type_expression is Ast::Expr.Invalid)
                return affine_owner_through_ref(type_expression, table)


        # A mutable reference must be mutable through its reference layer. A mutable local
        # binding can make a by-value ThreadPool writable, but it cannot upgrade a readonly
        # `ThreadPool&` stored in a mutable slot.
        def thread_submit_binding_writable(type_expression: Ast::Expr, binding_mutable: bool) -> bool:
            can Abort.Panic:
                return true if type_contains_operator(type_expression, TokenKind.Lmut) or type_is_mutable(type_expression)
                return false if type_contains_operator(type_expression, TokenKind.Ampersand)
                return binding_mutable


        def thread_validate_named_pool(marker: sview, annotations: darray[Ast::EnumAnnotation]&, offset: u32, line: u32, names: darray[sview @source]&, pool_types: darray[sview @source]&, pool_mutability: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                validated: mutable bool = false
                for annotation in annotations |table|:
                    if annotation.name == marker and annotation.offset == offset and not validated:
                        validated <- true
                        name: sview = annotation.owner
                        found: mutable usize = names.count
                        while found > 0 |found, names, name|:
                            found <- found - 1
                            if names[found] == name:
                                break
                        if found < names.count and names[found] == name:
                            actual_type: sview = pool_types[found]
                            if actual_type != "" and actual_type != "ThreadPool":
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, line: line, expected: "ThreadPool", actual: actual_type})
                            elif actual_type == "ThreadPool" and not pool_mutability[found]:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, line: line, expected: "mutable ThreadPool", actual: "ThreadPool"})
                            elif actual_type == "":
                                # Inferred locals whose initializer is not in the supported
                                # direct forms remain unknown here; regular name/type passes
                                # still diagnose unresolved identifiers.
                                pass
                        else:
                            type_id: u32 = global_type_id_of(name, table)
                            if type_id == 0:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: name, line: line, expected: "", actual: ""})
                            else:
                                base_id: u32 = interned_elem(type_id, 0, table) if interned_kind(type_id, table) == SemTypeKind.Ref else type_id
                                if interned_kind(base_id, table) != SemTypeKind.Named or interned_name(base_id, table) != "ThreadPool":
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, line: line, expected: "ThreadPool", actual: diagnostic_name_of_row(base_id, table)})
                                elif not any mutable_global in annotations where mutable_global.name == "__global_mutable" and mutable_global.owner == name:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, line: line, expected: "mutable ThreadPool", actual: "ThreadPool"})


        def type_iterable_element_may_reference(type_expression: Ast::Expr, table: SymbolTable&, callbacks: mutable ThreadCallbackIndex&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                module_scope: sview = table.current_module
                match type_expression:
                    Expr.Unary(operator, operand, _) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut:
                        return type_iterable_element_may_reference(operand, table, callbacks)
                    Expr.Index(_, element_type, _) | Expr.Refinement(element_type, _, _):
                        return thread_type_may_contain_nonstatic_reference(element_type, table, callbacks, module_scope)
                    Expr.IndexN(_, element_types, _):
                        for element_type in element_types |callbacks, table|:
                            return true if thread_type_may_contain_nonstatic_reference(element_type, table, callbacks, module_scope)
                        return false
                    Expr.Paren(inner, _):
                        return type_iterable_element_may_reference(inner, table, callbacks)
                    _:
                        return true


        # Whether a same-named candidate's result type is generic in its own parameters:
        # then the result carries whatever its arguments carry.
        def thread_call_result_is_generic(callbacks: mutable ThreadCallbackIndex&, name: sview, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                generic: mutable bool = false
                for index in 0..<callbacks.names.count |generic, callbacks, name, table|:
                    if callbacks.names[index] == name:
                        _ = thread_callback_row_may_reference(callbacks, index, table)
                        generic <- true if index < callbacks.row_generic.count and callbacks.row_generic[index]
                return generic

        # A direct or method-style call: the declared result (all same-named candidates),
        # and for a generic result the arguments' own provenance.
        def thread_call_may_reference(name: sview, receiver: Ast::Expr, arguments: darray[Ast::Expr]&, names: darray[sview @source]&, flags: darray[bool]&, callbacks: mutable ThreadCallbackIndex&, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                return true if thread_function_result_may_reference(callbacks, name, table.current_module, table)
                return false if not thread_call_result_is_generic(callbacks, name, table)
                return true if receiver is not Ast::Expr.Absent and thread_expression_may_reference(receiver, names, flags, callbacks, table)
                for argument in arguments |names, flags, callbacks, table|:
                    return true if thread_expression_may_reference(argument, names, flags, callbacks, table)
                return false

        def thread_expression_may_reference(expression: Ast::Expr, names: darray[sview @source]&, flags: darray[bool]&, callbacks: mutable ThreadCallbackIndex&, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Ident(name, _):
                        return thread_flag_for_name(names, flags, name)
                    Expr.Unary(operator, _, _):
                        return operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return thread_expression_may_reference(inner, names, flags, callbacks, table)
                    Expr.Binary(_, operator, _, _) if operator == TokenKind.RangeLt or operator == TokenKind.RangeLe:
                        return false
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements:
                            return true if thread_expression_may_reference(element, names, flags, callbacks, table)
                        return false
                    Expr.Construct(_, fields, _):
                        for field in fields:
                            return true if thread_expression_may_reference(field.value, names, flags, callbacks, table)
                        return false
                    Expr.RecordUpdate(base, fields, _):
                        return true if thread_expression_may_reference(base, names, flags, callbacks, table)
                        for field in fields:
                            return true if thread_expression_may_reference(field.value, names, flags, callbacks, table)
                        return false
                    Expr.Call(Expr.Ident(name, _), call_arguments, _, _):
                        return thread_call_may_reference(name, Ast::Expr.Absent, call_arguments, names, flags, callbacks, table)
                    Expr.Call(Expr.Field(receiver, method, _), call_arguments, _, _):
                        return thread_call_may_reference(method, receiver, call_arguments, names, flags, callbacks, table)
                    Expr.Call(Expr.Scope(module_expression, name, _), _, _, _):
                        module_scope: mutable sview = ""
                        can Global{Read,Write}:
                            module_scope <- thread_scope_module_name(module_expression, callbacks, table)
                        return true if module_scope == ""
                        return thread_function_result_may_reference(callbacks, name, module_scope, table)
                    Expr.Call(_, _, _, _) | Expr.StaticEffectCall(_, _, _, _, _, _):
                        return true
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.CharLit(_, _) | Expr.StringLit(_, _) | Expr.Absent:
                        return false
                    _:
                        # Calls, indexed values, and unknown collection expressions may
                        # yield references; retain soundness when source types are absent.
                        return true


        def thread_iterable_binder_may_reference(iterable: Ast::Expr, names: darray[sview @source]&, flags: darray[bool]&, element_flags: darray[bool]&, callbacks: mutable ThreadCallbackIndex&, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                match iterable:
                    Expr.Binary(_, operator, _, _) if operator == TokenKind.RangeLt or operator == TokenKind.RangeLe:
                        return false
                    Expr.Ident(name, _):
                        return thread_flag_for_name(names, element_flags, name)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements:
                            return true if thread_expression_may_reference(element, names, flags, callbacks, table)
                        return false
                    _:
                        return true


        def thread_flag_for_name(names: darray[sview @source]&, flags: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    return flags[index] if names[index] == name
                return false


        def thread_callback_row_may_reference(callbacks: mutable ThreadCallbackIndex&, row: usize, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                return true if row >= callbacks.modules.count or row >= callbacks.return_types.count or row >= callbacks.flags.count or row >= callbacks.classified.count
                if not callbacks.classified[row]:
                    return_type: Ast::Expr = callbacks.return_types[row]
                    # Classify in the candidate's own generic scope, independent of the
                    # function being walked (the result is cached per row).
                    outer_line: u32 = callbacks.function_line
                    outer_deferred: bool = callbacks.generic_deferred
                    callbacks.function_line <- callbacks.lines[row] if row < callbacks.lines.count else 0
                    callbacks.generic_deferred <- false
                    may_reference: bool = (type_is_nonstatic_reference(return_type) or thread_type_may_contain_nonstatic_reference(return_type, table, callbacks, callbacks.modules[row])) if return_type is not Ast::Expr.Absent and return_type is not Ast::Expr.Invalid else false
                    callbacks.row_generic[row] <- callbacks.generic_deferred if row < callbacks.row_generic.count
                    callbacks.function_line <- outer_line
                    callbacks.generic_deferred <- outer_deferred
                    callbacks.flags[row] <- may_reference
                    callbacks.classified[row] <- true
                return callbacks.flags[row]


        def thread_function_result_may_reference(callbacks: mutable ThreadCallbackIndex&, name: sview, module_scope: sview, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                # A large callback set earns a hash table only once some expression
                # actually asks for a function result. Cache failed attempts too; malformed
                # table state takes the conservative linear path below without rebuilding.
                if not callbacks.index_attempted:
                    callbacks.index_attempted <- true
                    thread_build_callback_name_index(callbacks) if callbacks.names.count >= THREAD_CALLBACK_INDEX_MIN_ROWS
                if callbacks.index_built and callbacks.names.count == callbacks.modules.count and callbacks.names.count == callbacks.flags.count and callbacks.names.count == callbacks.return_types.count and callbacks.names.count == callbacks.classified.count and callbacks.names.count == callbacks.duplicate_next.count and callbacks.slots.count > 0.usize():
                    capacity: usize = callbacks.slots.count
                    callback_hash: u64 = name_hash(name)
                    slot: mutable usize = callback_hash.usize() % capacity
                    probes: mutable usize = 0.usize()
                    while probes < capacity |slot, probes, callbacks, capacity, callback_hash, name, table|:
                        row: u32 = callbacks.slots[slot]
                        if row == THREAD_CALLBACK_INDEX_NONE:
                            # Unknown direct or indirect callback identities stay fail-closed.
                            return true
                        if row.usize() >= callbacks.names.count:
                            break
                        if callbacks.names[row.usize()] == name:
                            all_result: mutable bool = false
                            module_result: mutable bool = false
                            found_same: mutable bool = false
                            found_module: mutable bool = false
                            candidate: mutable u32 = row
                            seen: mutable usize = 0.usize()
                            while candidate != THREAD_CALLBACK_INDEX_NONE and seen < callbacks.names.count |candidate, seen, callbacks, all_result, module_result, found_same, found_module, table, module_scope|:
                                candidate_row: usize = candidate.usize()
                                return true if candidate_row >= callbacks.names.count or candidate_row >= callbacks.modules.count
                                found_same <- true
                                all_result <- true if thread_callback_row_may_reference(callbacks, candidate_row, table)
                                if callbacks.modules[candidate_row] == module_scope:
                                    found_module <- true
                                    module_result <- true if thread_callback_row_may_reference(callbacks, candidate_row, table)
                                candidate <- callbacks.duplicate_next[candidate_row]
                                seen <- seen + 1.usize()
                            return true if candidate != THREAD_CALLBACK_INDEX_NONE
                            return module_result if found_module
                            return all_result if found_same
                            return true
                        slot <- slot + 1.usize()
                        slot <- 0.usize() if slot >= capacity
                        probes <- probes + 1.usize()
                # Keep a conservative slow path for malformed or unavailable index state.
                # If the caller's module has no matching declaration (for example an import
                # is unresolved here), combine same-spelling rows conservatively.
                found_same: mutable bool = false
                found_module: mutable bool = false
                all_result: mutable bool = false
                module_result: mutable bool = false
                for index in 0..<callbacks.names.count |found_same, found_module, all_result, module_result, name, module_scope, callbacks, table|:
                    if index < callbacks.return_types.count and index < callbacks.modules.count and callbacks.names[index] == name:
                        found_same <- true
                        all_result <- true if thread_callback_row_may_reference(callbacks, index, table)
                        if callbacks.modules[index] == module_scope:
                            found_module <- true
                            module_result <- true if thread_callback_row_may_reference(callbacks, index, table)
                return module_result if found_module
                return all_result if found_same
                return true


        def thread_callback_has_nonstatic_ref_result(callbacks: mutable ThreadCallbackIndex&, expression: Ast::Expr, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Ident(name, line):
                        parameter_index: usize = thread_function_param_index(callbacks, name)
                        # The enclosing function's own callback parameter: its call sites
                        # check the concrete callback (a derived boundary).
                        if parameter_index < callbacks.function_param_is_fn.count and callbacks.function_param_is_fn[parameter_index]:
                            callbacks.generic_deferred <- true
                            return false
                        # The callback table is flat across modules and may contain overloads.
                        # Aggregate every same-named candidate, and keep unknown indirect
                        # callback identities fail-closed like direct call-result provenance.
                        module_scope: sview = table.current_module
                        return thread_function_result_may_reference(callbacks, name, module_scope, table)
                    Expr.Scope(module_expression, name, line):
                        module_scope: mutable sview = ""
                        can Global{Read,Write}:
                            module_scope <- thread_scope_module_name(module_expression, callbacks, table)
                        return true if module_scope == ""
                        return thread_function_result_may_reference(callbacks, name, module_scope, table)
                    Expr.Paren(inner, line):
                        return thread_callback_has_nonstatic_ref_result(callbacks, inner, table)
                    _:
                        return false


        def report_thread_callback_result(call_name: sview @source, callback: Ast::Expr, line: u32, callbacks: mutable ThreadCallbackIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                should_report: bool = thread_callback_has_nonstatic_ref_result(callbacks, callback, table)
                if should_report:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadResultNotShareable, name: call_name, line: line, expected: "", actual: "reference"})


        # `&count` / `lmut count` of a caller local or parameter: a stack reference handed to
        # another thread (stage0: "stack mutable i64&"). A task joined later may still race the
        # owner's frame, and a pool may outlive it, so such a borrow is never shareable.
        def thread_payload_borrows_local(payload: Ast::Expr, names: darray[sview @source]&, flags: darray[bool]&) -> bool:
            can Abort.Panic:
                match payload:
                    Expr.Ident(name, _):
                        return thread_flag_for_name(names, flags, name)
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return thread_payload_borrows_local(inner, names, flags)
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Ampersand or operator == TokenKind.Lmut:
                            return (affine_root(operand) != "" and any name in names where name == affine_root(operand)) or thread_payload_borrows_local(operand, names, flags)
                        # `!x` is Elisa's volatile read and preserves x's value type. Other
                        # unary operators produce a value; do not mistake their source
                        # operand's borrow for a borrow in the result.
                        return thread_payload_borrows_local(operand, names, flags) if operator == TokenKind.Bang
                        return false
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements:
                            return true if thread_payload_borrows_local(element, names, flags)
                        return false
                    # A call's result is independent of the provenance of each argument
                    # unless its declared result type says otherwise. The result-type walk
                    # below handles direct calls and fails closed for unresolved callees.
                    Expr.Call(_, _, _, _) | Expr.StaticEffectCall(_, _, _, _, _, _):
                        return false
                    Expr.Field(object, _, _) | Expr.Index(object, _, _):
                        return thread_payload_borrows_local(object, names, flags)
                    Expr.IndexN(object, indices, _):
                        return true if thread_payload_borrows_local(object, names, flags)
                        for index in indices:
                            return true if thread_payload_borrows_local(index, names, flags)
                        return false
                    Expr.Construct(_, fields, _):
                        for field in fields:
                            return true if thread_payload_borrows_local(field.value, names, flags)
                        return false
                    Expr.RecordUpdate(base, fields, _):
                        return true if thread_payload_borrows_local(base, names, flags)
                        for field in fields:
                            return true if thread_payload_borrows_local(field.value, names, flags)
                        return false
                    _:
                        return false

        def thread_expression_type_contains_nonstatic_reference(expression: Ast::Expr, callbacks: mutable ThreadCallbackIndex&, table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match expression:
                    Expr.Construct(type_expression, fields, _):
                        # The literal's declared type is what crosses the boundary (stage0
                        # checks the argument's type); each field value converts to its field
                        # type, so the field expressions add nothing.
                        module_scope: sview = table.current_module
                        return thread_type_may_contain_nonstatic_reference(type_expression, table, callbacks, module_scope)
                    Expr.RecordUpdate(base, fields, _):
                        return true if thread_expression_type_contains_nonstatic_reference(base, callbacks, table)
                        for field in fields:
                            return true if thread_expression_type_contains_nonstatic_reference(field.value, callbacks, table)
                        return false
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements:
                            return true if thread_expression_type_contains_nonstatic_reference(element, callbacks, table)
                        return false
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return thread_expression_type_contains_nonstatic_reference(inner, callbacks, table)
                    Expr.Call(Expr.Ident(name, _), _, _, _):
                        # Return provenance comes from the declaration AST because TypeId
                        # interning erases `static`. Generic and region-parameterized results
                        # retain their source qualifiers; unresolved overloads combine all
                        # same-named candidates conservatively.
                        module_scope: sview = table.current_module
                        return thread_function_result_may_reference(callbacks, name, module_scope, table)
                    Expr.Call(Expr.Scope(module_expression, name, _), _, _, _):
                        module_scope: mutable sview = ""
                        can Global{Read,Write}:
                            module_scope <- thread_scope_module_name(module_expression, callbacks, table)
                        return true if module_scope == ""
                        return thread_function_result_may_reference(callbacks, name, module_scope, table)
                    Expr.Call(_, _, _, _) | Expr.StaticEffectCall(_, _, _, _, _, _):
                        # Method, indirect, and effect calls lack a resolved return row here.
                        # Keep them shareability-safe until result provenance is available.
                        return true
                    _:
                        return false


        def report_thread_payload(call_name: sview @source, payload: Ast::Expr, line: u32, names: darray[sview @source]&, flags: darray[bool]&, callbacks: mutable ThreadCallbackIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                payload_name: sview = affine_root(payload)
                parameter_index: usize = thread_function_param_index(callbacks, payload_name)
                callbacks.generic_deferred <- true if parameter_index < callbacks.function_param_deferred.count and callbacks.function_param_deferred[parameter_index]
                should_report: mutable bool = payload_name != "" and thread_flag_for_name(names, flags, payload_name)
                if not should_report:
                    should_report <- thread_payload_borrows_local(payload, names, flags)
                if not should_report:
                    should_report <- match payload:
                        Expr.Call(Expr.Ident(call_name_inner, _), call_arguments, _, _): thread_call_may_reference(call_name_inner, Ast::Expr.Absent, call_arguments, names, flags, callbacks, table)
                        Expr.Call(Expr.Field(receiver, method, _), call_arguments, _, _): thread_call_may_reference(method, receiver, call_arguments, names, flags, callbacks, table)
                        _: thread_expression_type_contains_nonstatic_reference(payload, callbacks, table)
                if should_report:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ThreadArgumentNotShareable, name: call_name, line: line, expected: "", actual: "reference"})


        def thread_function_param_index(callbacks: ThreadCallbackIndex&, name: sview) -> usize:
            can Abort.Panic:
                return callbacks.function_params.count if name == ""
                for index in 0..<callbacks.function_params.count |name, callbacks|:
                    return index if callbacks.function_params[index] == name
                return callbacks.function_params.count

        def thread_derived_index(callbacks: ThreadCallbackIndex&, name: sview) -> usize:
            can Abort.Panic:
                return callbacks.derived_names.count if name == ""
                for index in 0..<callbacks.derived_names.count |name, callbacks|:
                    return index if callbacks.derived_names[index] == name
                return callbacks.derived_names.count

        def thread_register_derived_boundary(callbacks: mutable ThreadCallbackIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if callbacks.function_name == "" or thread_derived_index(callbacks, callbacks.function_name) < callbacks.derived_names.count
                callbacks.derived_names.push(callbacks.function_name)
                callbacks.derived_param_starts.push(callbacks.derived_param_is_fn.count)
                callbacks.derived_param_counts.push(callbacks.function_param_is_fn.count)
                for is_fn in callbacks.function_param_is_fn |callbacks|:
                    callbacks.derived_param_is_fn.push(is_fn)

        # Whether a parameter annotation is an fn type (`fn(...) -> T`; in type position
        # it may also parse through the lambda word).
        def thread_type_is_fn(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Binary(signature, operator, _, _):
                        return operator == TokenKind.Arrow and thread_type_is_fn(signature)
                    Expr.Call(callee: callee, _):
                        return ident_name_of(callee) == "fn"
                    Expr.Lambda(_, _, _):
                        return true
                    Expr.Paren(inner, _):
                        return thread_type_is_fn(inner)
                    _:
                        return false

        def check_thread_boundary_call(callee: Ast::Expr, arguments: darray[Ast::Expr]&, line: u32, names: darray[sview @source]&, flags: darray[bool]&, callbacks: mutable ThreadCallbackIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                call_name: sview = match callee:
                    Expr.Ident(name, call_line): name
                    _: ""
                callbacks.generic_deferred <- false
                if call_name != "spawn1" and call_name != "pool_submit1" and call_name != "spawn_daemon":
                    derived_index: usize = thread_derived_index(callbacks, call_name)
                    return if derived_index >= callbacks.derived_names.count
                    start: usize = callbacks.derived_param_starts[derived_index]
                    for argument_index in 0..<arguments.count |table|:
                        if argument_index < callbacks.derived_param_counts[derived_index] and callbacks.derived_param_is_fn[start + argument_index]:
                            table <- report_thread_callback_result(call_name, arguments[argument_index], line, callbacks, table)
                        else:
                            table <- report_thread_payload(call_name, arguments[argument_index], line, names, flags, callbacks, table)
                    thread_register_derived_boundary(callbacks) if callbacks.generic_deferred
                    return
                callback_index: usize = 0 if call_name == "spawn1" or call_name == "spawn_daemon" else 1
                if callback_index < arguments.count:
                    table <- report_thread_callback_result(call_name, arguments[callback_index], line, callbacks, table)
                if arguments.count > 0:
                    table <- report_thread_payload(call_name, arguments[arguments.count - 1], line, names, flags, callbacks, table)
                thread_register_derived_boundary(callbacks) if callbacks.generic_deferred
