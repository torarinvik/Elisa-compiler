# Brace-only default construction (docs — brace-only-default-construction): `Foo{...}`
# is the only default constructor; the paren form `Foo(a: 1)` requires an explicit
# `def Foo(...) -> Foo`. A LABELED paren call whose callee names a declared struct
# with no same-named constructor function is therefore an error. Fires only on the
# labeled shape — an unlabeled single-argument `Foo(x)` is the postfix-call cast/UFCS
# form and stays out of scope (sound miss, never a false fire).
extend Semantic:
    private:
        def positional_construction_walk(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- positional_construction_expression(expression, line, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- positional_construction_expression(value, line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- positional_construction_expression(value, line, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- positional_construction_expression(returned, line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- positional_construction_walk(then_body, table)
                            table <- positional_construction_walk(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- positional_construction_walk(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- positional_construction_walk(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- positional_construction_walk(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- positional_construction_walk(arm.body, table)
                        _:
                            pass

        def positional_construction_expression(expression: Ast::Expr, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        has_labels: mutable bool = false
                        for label in argument_names |has_labels|:
                            has_labels <- true if label != ""
                        is_struct: bool = callee_name != "" and (any symbol in table.symbols where symbol.name == callee_name and symbol.kind == SymbolKind.Struct)
                        has_constructor: bool = direct_function_count(table, callee_name) > 0
                        # Labeled (`Ref(p: x)`) or any-arg unlabeled (`Bag([])`) paren
                        # call on a ctor-less struct — a struct is never a value-cast
                        # target, so the unlabeled form is the same error.
                        # `new Box(value: 1)` (labeled, new-form) is the legal
                        # allocation-construction; POSITIONAL args error even under
                        # `new` (`new[r] Guard(true)`), and labeled construction
                        # without `new` errors too.
                        is_new_form: bool = any new_line in table.new_construct_lines where new_line == call_line
                        fires: bool = is_struct and not has_constructor and ((has_labels and not is_new_form) or (not has_labels and arguments.count > 0))
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PositionalConstruction, name: callee_name, line: line, expected: "", actual: ""}) if fires
                        # An empty list literal argument to the rejected construction
                        # has no expected element type to adopt.
                        for construction_argument in arguments |table| -> table:
                            is_empty_list: bool = match construction_argument:
                                Expr.Array(list_elements, list_line): list_elements.count == 0
                                _: false
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EmptyListNeedsType, name: "", line: line, expected: "", actual: ""}) if fires and is_empty_list
                        for argument in arguments |table| -> table:
                            table <- positional_construction_expression(argument, line, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- positional_construction_expression(left, line, table)
                        table <- positional_construction_expression(right, line, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- positional_construction_expression(operand, line, table)
                    Expr.Paren(inner, paren_line):
                        table <- positional_construction_expression(inner, line, table)
                    # `new[scratch] P(1)` builds an Expr.RegionNew WRAPPER around the
                    # construction (a named region has to survive to the backend, unlike
                    # bare `new`, which is erased). Without this arm the walk stopped at the
                    # wrapper and the construction inside was never checked: stage0 reports
                    # `positional construction P(...) is not allowed` and stage1 reported
                    # nothing. Only the REGION-qualified form was affected — `P(1)` and
                    # `new P(1)` both fired correctly.
                    Expr.RegionNew(allocated, region_name, region_new_line):
                        table <- positional_construction_expression(allocated, line, table)
                    _:
                        pass

        def check_positional_construction(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- positional_construction_walk(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_positional_construction(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_positional_construction(scoped_body, table)
                        _:
                            pass
