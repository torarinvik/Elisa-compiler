# Stage1 semantic — `diagnostic_message` part 1 of 4 and the dispatcher (`extend
# Semantic: public:`). Renders one diagnostic's human-readable wording, which must match
# stage0's byte for byte.
#
# One `match diagnostic.kind:` arm per kind does not fit in a 600-line file, so the arms
# are split across semantic_api_message_2/3/4.elisa. This file holds the first slice and
# the fallthrough chain: a part that matches no arm leaves `handled` false and the next
# part is tried, so an unmatched kind still reaches every arm exactly as one flat match
# would.

extend Semantic:
    public:
        # Canonical human-readable message for a diagnostic, with the offending `name`
        # interpolated, as an owned UTF-8 `darray[u8]`. This is the SINGLE SOURCE OF TRUTH
        # for diagnostic wording: consumers (LSP, CLI, tests) render this rather than
        # re-deriving per-kind text, so a new `DiagnosticKind` is worded in exactly one
        # place. The `match` is exhaustive with no wildcard arm, so adding a kind without
        # wording it here is a compile error rather than a silent generic fallback.
        def diagnostic_message(diagnostic: Diagnostic) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                buffer: mutable darray[u8] = []
                handled: mutable bool = true
                match diagnostic.kind:
                    DiagnosticKind.UndefinedName:
                        buffer.extend(f"undefined identifier \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateDecl:
                        buffer.extend(f"duplicate declaration \"{diagnostic.name}\" (already defined as {diagnostic.actual})" if diagnostic.actual != "" else f"duplicate declaration \"{diagnostic.name}\" (already defined as func)")

                    DiagnosticKind.DuplicateType:
                        buffer.extend(f"duplicate type \"{diagnostic.name}\"")

                    DiagnosticKind.AssignImmutable:
                        buffer.extend(f"cannot assign to immutable local \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateParam:
                        buffer.extend(f"duplicate parameter \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateField:
                        buffer.extend(f"duplicate field \"{diagnostic.name}\" in struct \"{diagnostic.expected}\"")

                    DiagnosticKind.DuplicateVariant:
                        buffer.extend(f"duplicate variant \"{diagnostic.name}\" in enum \"{diagnostic.expected}\"")

                    DiagnosticKind.NonExhaustiveMatch:
                        buffer.extend(f"non-exhaustive match over \"{diagnostic.name}\"; missing variant \"{diagnostic.expected}\"")

                    DiagnosticKind.NonExhaustiveScalarMatch:
                        # stage0's exact sentence, MEASURED per family: an `i64` and a `char`
                        # scrutinee both read as "integer"; `sview`/string is "string"; a
                        # multi-column `when` (tuple scrutinee) is "tuple". stage1 used to
                        # phrase this its own way ("over an open 'int' domain"), which no
                        # fixture pinned — so diagnostics_diff, which compares TEXT, could
                        # never have carried a fixture for this rule.
                        scalar_domain: sview = match diagnostic.name:
                            "int":   "integer"
                            "char":  "integer"
                            _:       diagnostic.name
                        buffer.extend(f"non-exhaustive {scalar_domain} match expression; add a final _ arm")

                    DiagnosticKind.InvalidTopLevelScalarMatchArm:
                        match diagnostic.name:
                            "int":
                                push_str(buffer, "top-level integer match arm must use an integer literal or _")
                            _:
                                push_str(buffer, "top-level string match arm must use a string literal or _")

                    DiagnosticKind.InvalidExportBoundary:
                        match diagnostic.expected:
                            "type":
                                buffer.extend(f"export type \"{diagnostic.name}\" must name a concrete C-ABI-compatible struct or concrete instantiation")
                            "global":
                                buffer.extend(f"export global \"{diagnostic.name}\" must target a global")
                            _:
                                buffer.extend(f"export func \"{diagnostic.name}\" is not C-ABI-compatible")

                    DiagnosticKind.BlockLambdaMissingContext:
                        push_str(buffer, "block lambda requires an explicit return type or contextual function type")

                    DiagnosticKind.LegacyErrorSyntax:
                        match diagnostic.name:
                            "wildcard":
                                push_str(buffer, "error[Set.*] is no longer supported; use error[Set] instead")
                            "open":
                                push_str(buffer, "the `, ...` suffix in error[...] is no longer supported; name the full sets directly (a bare set name already means the whole family)")
                            _:
                                push_str(buffer, "legacy fallible return syntax `T | ErrorSet` is no longer supported; use `T error[SomeSet]` instead")

                    DiagnosticKind.NullableWithoutProof:
                        match diagnostic.expected:
                            "field":
                                push_str(buffer, "field access requires proven non-null reference")
                            "call":
                                buffer.extend(f"call through nullable function \"{diagnostic.name}\" requires a non-null proof")
                            _:
                                buffer.extend(f"invalid cast from nullable reference \"{diagnostic.name}\" to non-null reference")

                    DiagnosticKind.AggregateStateArity:
                        if diagnostic.expected_count == 0:
                            buffer.extend(f"struct \"{diagnostic.name}\" does not declare an aggregate state parameter")
                        else:
                            buffer.extend(f"struct \"{diagnostic.name}\" expects ")
                            push_int(buffer, diagnostic.expected_count.i64())
                            push_str(buffer, " aggregate state arguments, got ")
                            push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.FunctionParameterVariance:
                        buffer.extend(f"variable \"{diagnostic.name}\" expects a callback that accepts nullable arguments; function \"{diagnostic.expected}\" requires a non-null argument")

                    DiagnosticKind.NonExhaustiveCatch:
                        buffer.extend(f"non-exhaustive catch over \"{diagnostic.expected}\"; missing error \"{diagnostic.name}\"")

                    DiagnosticKind.OrdinaryEnumTailPayload:
                        buffer.extend(f"enum \"{diagnostic.expected}\" variant \"{diagnostic.name}\" tail payloads are only supported for packed enums")

                    DiagnosticKind.FloatDictRuntimeKey:
                        push_str(buffer, "runtime-backed dict keys must be cstr, an integer type, bool, or a const enum")

                    DiagnosticKind.TryRequiresFallible:
                        push_str(buffer, "try without else requires an error union" if diagnostic.expected == "optional" else "try requires a fallible expression")

                    DiagnosticKind.ConstFloatCastRange:
                        buffer.extend(f"const \"{diagnostic.name}\" initializer must be a compile-time {diagnostic.expected} value")

                    DiagnosticKind.ContainerShapeReturn:
                        if diagnostic.name == "darray":
                            buffer.extend(f"return type expects darray[{diagnostic.expected}, {diagnostic.actual}], got darray[{diagnostic.expected}" )
                            push_str(buffer, ", ") if diagnostic.detail != ""
                            buffer.extend(f"{diagnostic.detail}") if diagnostic.detail != ""
                            push_str(buffer, "]")
                        else:
                            buffer.extend(f"return type expects {diagnostic.name}[{diagnostic.actual}], got {diagnostic.name}")
                            push_str(buffer, "[") if diagnostic.detail != ""
                            buffer.extend(f"{diagnostic.detail}") if diagnostic.detail != ""
                            push_str(buffer, "]") if diagnostic.detail != ""

                    DiagnosticKind.InternalRuntimeCarrier:
                        buffer.extend(f"internal runtime carrier type \"{diagnostic.name}\" is not supported in user-facing code; use \"{diagnostic.expected}\" instead")

                    DiagnosticKind.UngrantedParallelFor:
                        push_str(buffer, "parallel for requires an enclosing permission grant; add `can Pool.Submit, Pool.WaitAll:` or declare the Pool effects")

                    DiagnosticKind.ParallelOuterMutation:
                        buffer.extend(f"parallel for body cannot mutate outer binding \"{diagnostic.name}\"")

                    DiagnosticKind.UnknownPermissionMember:
                        buffer.extend(f"permission \"{diagnostic.name}\" has no member \"{diagnostic.actual}\"")

                    DiagnosticKind.DestroyedRegionUse:
                        buffer.extend(f"cannot allocate from destroyed region \"{diagnostic.actual}\"") if diagnostic.expected == "allocate"
                        buffer.extend(f"value \"{diagnostic.name}\" cannot be used: region dependency facts were invalidated by destroy of region \"{diagnostic.actual}\"") if diagnostic.expected != "allocate"

                    DiagnosticKind.StorageDependencyInvalidated:
                        buffer.extend(f"view \"{diagnostic.name}\" cannot be used: storage dependency facts were invalidated by darray push of {diagnostic.expected}") if diagnostic.expected != ""
                        buffer.extend(f"storage dependency facts were invalidated for interior reference \"{diagnostic.name}\"") if diagnostic.expected == ""

                    DiagnosticKind.PermissionParamMemberAccess:
                        buffer.extend(f"permission parameter \"{diagnostic.name}\" does not support member access")

                    DiagnosticKind.TruthyOrBindingMismatch:
                        match diagnostic.actual:
                            "":
                                buffer.extend(f"identifier \"{diagnostic.name}\" is not available here because truthy `or` branches do not agree on that binding: left branch binds it as {diagnostic.expected}, while right branch does not bind it")
                            _:
                                buffer.extend(f"identifier \"{diagnostic.name}\" is not available here because truthy `or` branches do not agree on that binding: left branch binds it as {diagnostic.expected}, while right branch binds it as {diagnostic.actual}")

                    DiagnosticKind.RaiseVariantNotAllowed:
                        buffer.extend(f"raise cannot propagate tag \"{diagnostic.name}.{diagnostic.actual}\" into error[{diagnostic.expected}.{diagnostic.detail}]")

                    DiagnosticKind.GhostFnImpure:
                        buffer.extend(f"ghost function \"{diagnostic.name}\" must be pure and total so its defining equation can be used by the prover")

                    DiagnosticKind.GhostFnRuntimeCall:
                        buffer.extend(f"ghost function \"{diagnostic.name}\" is verification-only and cannot be called by runtime code: it is erased from codegen")

                    DiagnosticKind.AmbiguousErrorVariant:
                        buffer.extend(f"error variant \"{diagnostic.name}\" is ambiguous across sets {diagnostic.expected}, {diagnostic.actual}; qualify it as {diagnostic.expected}.{diagnostic.name}")

                    DiagnosticKind.PreservesViolation:
                        buffer.extend(f"may write {diagnostic.name}.{diagnostic.detail}, which \"{diagnostic.actual}\" `preserves`")

                    DiagnosticKind.StaticIndirectRecursion:
                        buffer.extend(f"indirect recursive static call cycle involving \"{diagnostic.name}\" and \"{diagnostic.actual}\" is not supported; use direct structural recursion")

                    DiagnosticKind.StaticPartialRecursion:
                        buffer.extend(f"recursive static call to \"{diagnostic.name}\" must decrease a parameter using parameter - positive_constant")

                    DiagnosticKind.StaticSignedBaseCase:
                        buffer.extend(f"recursive static call to \"{diagnostic.name}\" uses `== 0` as the only visible base case for signed parameter \"{diagnostic.expected}\"; use a lower-bound check such as `{diagnostic.expected} <= 0`")

                    DiagnosticKind.PrivateMemberAccess:
                        buffer.extend(f"\"{diagnostic.actual}.{diagnostic.name}\" is private to module \"{diagnostic.actual}\"")

                    DiagnosticKind.ErrorsetParamShadow:
                        buffer.extend(f"errorset parameter \"{diagnostic.name}\" on \"{diagnostic.actual}\" shadows the declared error set \"{diagnostic.name}\"; every `error[{diagnostic.name}]` now refers to the parameter")

                    DiagnosticKind.ConstDictNoKey:
                        buffer.extend(f"const dict has no key s:{diagnostic.name}")

                    DiagnosticKind.GhostFieldRead:
                        buffer.extend(f"ghost field \"{diagnostic.name}\" is verification-only and cannot be read by real code: it is erased from codegen, so its value does not exist at runtime")

                    DiagnosticKind.GhostInitImpure:
                        buffer.extend(f"ghost variable \"{diagnostic.name}\" initializer must be side-effect-free (it is erased from codegen): use reads, arithmetic, or a ghost/pure function")

                    DiagnosticKind.LambdaRaiseMismatch:
                        buffer.extend(f"raise cannot propagate tag \"{diagnostic.name}.{diagnostic.actual}\" into {diagnostic.expected}")

                    DiagnosticKind.RaiseDestinationMismatch:
                        buffer.extend(f"raise cannot propagate tag \"{diagnostic.name}.{diagnostic.actual}\" into error[{diagnostic.expected}, {diagnostic.detail}]")

                    DiagnosticKind.TryPropagationMismatch:
                        match diagnostic.detail:
                            "":
                                buffer.extend(f"cannot propagate {diagnostic.name} from a function returning {diagnostic.expected}")
                            _:
                                buffer.extend(f"cannot propagate {diagnostic.name} from a function returning error[{diagnostic.expected}, {diagnostic.detail}]")

                    DiagnosticKind.ReadonlyRefMutation:
                        buffer.extend(f"cannot mutate through readonly ref \"{diagnostic.name}\"; note: plain refs T& are readonly; use mutable {diagnostic.expected}& if this reference should allow writes")

                    DiagnosticKind.ReadonlyRefArgument:
                        push_str(buffer, "argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.name}\" expects mutable {diagnostic.expected}&, got {diagnostic.actual}&; note: use mutable {diagnostic.actual}& here if the callee should be allowed to write through it")

                    DiagnosticKind.MachineTagCoverage:
                        match diagnostic.actual:
                            "_":
                                buffer.extend(f"machine state \"{diagnostic.name}\" dispatches on the closed enum \"{diagnostic.expected}\" with a '_' wildcard — spell the variants as explicit tags (docs/125 §9)")
                            _:
                                buffer.extend(f"machine state \"{diagnostic.name}\" does not cover the closed enum \"{diagnostic.expected}\"; missing variant \"{diagnostic.actual}\" (docs/125 §9)")

                    DiagnosticKind.ArityMismatch:
                        # Enriched form (single declaration, no defaults) carries counts —
                        # `function "g" expects N arguments, got M` (stage0 parity);
                        # otherwise the count is ambiguous (overload/defaults).
                        match diagnostic.expected:
                            "type":
                                buffer.extend(f"type \"{diagnostic.name}\" expects 2 type arguments, got 1")
                            "n":
                                buffer.extend(f"function \"{diagnostic.name}\" expects ")
                                push_int(buffer, diagnostic.expected_count.i64())
                                push_str(buffer, " arguments, got ")
                                push_int(buffer, diagnostic.actual_count.i64())
                            _:
                                buffer.extend(f"wrong number of arguments in call to \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateLocal:
                        buffer.extend(f"duplicate local \"{diagnostic.name}\" (already defined in this scope; use `<-` to mutate)")

                    DiagnosticKind.UnknownVariant:
                        buffer.extend(f"enum has no variant \"{diagnostic.name}\"")

                    DiagnosticKind.VariantArity:
                        # Parity: `enum constructor "E.A" expects N arguments, got M`.
                        buffer.extend(f"enum constructor \"{diagnostic.expected}.{diagnostic.name}\" expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " arguments, got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.TypeMismatch:
                        # Mirrors stage0: `variable "a" expects bool, got int` /
                        # `return type expects i64, got ...`.
                        expected_is_container: bool = diagnostic.expected in {"darray", "dict", "set", "list", "array"}
                        buffer.extend(f"return type expects {diagnostic.expected}" if diagnostic.name == "return" else f"variable \"{diagnostic.name}\" expects {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and expected_is_container
                        buffer.extend(f", got {diagnostic.actual}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and not expected_is_container

                    DiagnosticKind.NonBoolCondition:
                        # An optional condition prints its BASE type (stage0: 'got i64'); a
                        # container prints head[elem].
                        buffer.extend(f"{diagnostic.name} condition must be bool, got ")
                        push_sview(buffer, diagnostic.detail if diagnostic.actual == "optional" and diagnostic.detail != "" else diagnostic.actual)
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.actual != "optional" and diagnostic.detail != ""

                    DiagnosticKind.NonBoolOperand:
                        push_str(buffer, "not operator requires bool operand") if diagnostic.name == "not"
                        push_str(buffer, "logical operator requires bool operands") if diagnostic.name != "not"

                    DiagnosticKind.NonNumericOperand:
                        push_str(buffer, "operator requires numeric operands")

                    DiagnosticKind.IncompatibleComparison:
                        buffer.extend(f"cannot compare {diagnostic.expected}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and diagnostic.expected in {"darray", "dict", "set", "list", "array"}
                        buffer.extend(f" and {diagnostic.actual}")
                        buffer.extend(f"[{diagnostic.detail}]") if diagnostic.detail != "" and diagnostic.actual in {"darray", "dict", "set", "list", "array"}

                    DiagnosticKind.InvalidVariantTestOperand:
                        buffer.extend(f"is requires an enum value for variant tests, got {diagnostic.actual}")

                    DiagnosticKind.InvalidTopLevelSequenceMatchArm:
                        push_str(buffer, "unsupported top-level sequence match pattern *ast.MatchVariantPattern")

                    DiagnosticKind.ReturnValueInVoid:
                        buffer.extend(f"\"{diagnostic.name}\" returns void — remove the return value")

                    DiagnosticKind.MissingReturnValue:
                        buffer.extend(f"\"{diagnostic.name}\" must return a value")

                    DiagnosticKind.UnusedParam:
                        buffer.extend(f"parameter \"{diagnostic.name}\" is never used (discard with `_ = {diagnostic.name}` or rename to `_`)")

                    DiagnosticKind.UnusedLocal:
                        buffer.extend(f"local \"{diagnostic.name}\" is never used")

                    DiagnosticKind.BreakOutsideLoop:
                        # Static (no-interpolation) messages stay on `push_str`: a
                        # braceless f-string collapses to a plain string literal
                        # (`static u8&`), which `darray.extend` does not accept.
                        push_str(buffer, "`break` outside a loop")

                    DiagnosticKind.ContinueOutsideLoop:
                        push_str(buffer, "`continue` outside a loop")

                    DiagnosticKind.NonIterableLoop:
                        buffer.extend(f"for loop iterable must be an iterable type (darray, dict, set, view, range, string, etc.), got {diagnostic.actual}")

                    DiagnosticKind.UnreachableCode:
                        push_str(buffer, "unreachable code: a previous statement always exits this block")

                    DiagnosticKind.UnreachableMatchArm:
                        buffer.extend(f"match arm \"{diagnostic.name}\" is unreachable because an earlier arm already matches it")

                    DiagnosticKind.UnknownField:
                        buffer.extend(f"struct literal \"{diagnostic.expected}\" has no field \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateFieldInit:
                        buffer.extend(f"struct literal \"{diagnostic.expected}\" field \"{diagnostic.name}\" is specified more than once")

                    DiagnosticKind.MissingField:
                        buffer.extend(f"struct literal \"{diagnostic.expected}\" is missing field \"{diagnostic.name}\"")

                    DiagnosticKind.AssignUndefinedTarget:
                        buffer.extend(f"undefined assignment target \"{diagnostic.name}\" (use = to introduce a new local; <- requires an existing mutable target)")

                    DiagnosticKind.InvalidAssignTarget:
                        push_str(buffer, "invalid assignment target")

                    DiagnosticKind.ValueBlockMutation:
                        buffer.extend(f"value block may not mutate the outer binding \"{diagnostic.name}\" through a call (docs/119 E4); pass it by value, capture it in the header (`|{diagnostic.name}|`), or thread it back with `rebind`" if diagnostic.expected == "call" else f"value block may not mutate the outer binding \"{diagnostic.name}\" (docs/119 E4); a block/loop expression yields new values — use `rebind` to thread the update back or capture it in the header (`|{diagnostic.name}|`)")

                    DiagnosticKind.CaptureUndefined:
                        buffer.extend(f"capture \"{diagnostic.name}\" names no binding in scope (docs/119 E11)")

                    DiagnosticKind.CaptureImmutable:
                        buffer.extend(f"capture \"{diagnostic.name}\" is not a `mutable` binding; only mutables can be threaded through a value block (docs/119 E10)")

                    DiagnosticKind.UnknownFieldType:
                        buffer.extend(f"struct \"{diagnostic.expected}\" field \"{diagnostic.name}\" has unknown type \"{diagnostic.actual}\" (not a primitive, not a registered struct/enum)")

                    DiagnosticKind.RecursiveStruct:
                        buffer.extend(f"struct \"{diagnostic.name}\" is directly self-recursive (field \"{diagnostic.expected}\" has type \"{diagnostic.name}\" — infinite size); use a ref for indirection")

                    DiagnosticKind.InvalidCast:
                        buffer.extend(f"`.cast[{diagnostic.name}]` is a value conversion, not a reinterpret; use a constructor `{diagnostic.name}(x)` or `x.{diagnostic.name}()`")

                    DiagnosticKind.SyntaxExpectedToken:
                        buffer.extend(f"expected a token, found \"{diagnostic.name}\"")

                    DiagnosticKind.SyntaxUnexpectedToken:
                        buffer.extend(f"unexpected token \"{diagnostic.name}\"")

                    DiagnosticKind.SyntaxExpectedDeclaration:
                        buffer.extend(f"expected a declaration, found \"{diagnostic.name}\"")

                    DiagnosticKind.SyntaxExpectedExpression:
                        buffer.extend(f"expected an expression, found \"{diagnostic.name}\"")

                    DiagnosticKind.SyntaxMismatchedWithBindings:
                        buffer.extend(f"every alternative of a `with`-arm must bind the same constants; alternative near \"{diagnostic.name}\" differs")

                    DiagnosticKind.LmutAliasing:
                        buffer.extend(f"`lmut` argument \"{diagnostic.name}\" aliases another argument of the same call; a linear-mutable value must be named by exactly one live binding")

                    DiagnosticKind.NonTrailingDefaultParam:
                        buffer.extend(f"parameter \"{diagnostic.name}\" must declare a default because it follows a defaulted parameter")

                    DiagnosticKind.CallArgumentError:
                        call_argument_message: dstr = when diagnostic.expected:
                            "unknown" -> f"function \"{diagnostic.name}\" has no parameter \"{diagnostic.actual}\""
                            "duplicate" -> f"function \"{diagnostic.name}\" parameter \"{diagnostic.actual}\" is specified more than once"
                            "after_named" -> f"function \"{diagnostic.name}\" cannot use positional arguments after named arguments"
                            "missing" -> f"function \"{diagnostic.name}\" is missing argument for parameter \"{diagnostic.actual}\""
                            "no_names" -> f"function \"{diagnostic.name}\" does not expose parameter names for named argument calls"
                            _ -> f"invalid arguments in call to \"{diagnostic.name}\""
                        buffer.extend(call_argument_message)

                    DiagnosticKind.EnumConstructorArgumentError:
                        constructor_argument_message: dstr = when diagnostic.expected:
                            "mixed" -> f"enum constructor \"{diagnostic.name}\" cannot mix positional and named arguments"
                            "unnamed" -> f"enum constructor \"{diagnostic.name}\" does not declare named payload fields"
                            "unknown" -> f"enum constructor \"{diagnostic.name}\" has no payload field \"{diagnostic.actual}\""
                            "duplicate" -> f"enum constructor \"{diagnostic.name}\" payload field \"{diagnostic.actual}\" is specified more than once"
                            "missing" -> f"enum constructor \"{diagnostic.name}\" is missing payload field \"{diagnostic.actual}\""
                            _ -> f"invalid arguments in enum constructor \"{diagnostic.name}\""
                        buffer.extend(constructor_argument_message)

                    DiagnosticKind.SelfAssignment:
                        buffer.extend(f"assignment to \"{diagnostic.name}\" has no effect: target and value are identical")

                    DiagnosticKind.SelfComparison:
                        buffer.extend(f"comparison of \"{diagnostic.name}\" with itself is always the same")

                    DiagnosticKind.UnusedExpression:
                        push_str(buffer, "expression statement has no effect; its result is discarded")

                    DiagnosticKind.ConstantCondition:
                        buffer.extend(f"condition is always {diagnostic.actual}")

                    DiagnosticKind.RedundantBoolCompare:
                        push_str(buffer, "redundant comparison to a boolean literal; use the value (or its negation) directly")

                    DiagnosticKind.DuplicateImport:
                        buffer.extend(f"module \"{diagnostic.name}\" is imported more than once")

                    DiagnosticKind.DuplicateMatchArm:
                        buffer.extend(f"match arm \"{diagnostic.name}\" is unreachable because an earlier arm already matches it")

                    DiagnosticKind.DivisionByZero:
                        push_str(buffer, "division by zero")

                    DiagnosticKind.ArrayLiteralArity:
                        push_str(buffer, "array literal expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " elements, got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.UnknownTypeName:
                        buffer.extend(f"unknown type \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateDictKey:
                        buffer.extend(f"dict literal has a duplicate key \"{diagnostic.name}\"")

                    DiagnosticKind.DuplicateSetElement:
                        buffer.extend(f"set literal has a duplicate element \"{diagnostic.name}\"")

                    DiagnosticKind.IndexOutOfBounds:
                        push_str(buffer, "constant index ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f" out of bounds for {diagnostic.expected}[")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "]")

                    DiagnosticKind.SelfArithmetic:
                        buffer.extend(f"arithmetic of \"{diagnostic.name}\" with itself always yields a constant")

                    DiagnosticKind.DoubleNegation:
                        push_str(buffer, "double negation has no effect; use the value directly")

                    DiagnosticKind.InfiniteLoopNoExit:
                        push_str(buffer, "'while true' loop never exits (no break or return in its body)")

                    DiagnosticKind.RedundantArithmetic:
                        push_str(buffer, "redundant arithmetic: the literal operand makes this operation a no-op or a constant")

                    DiagnosticKind.EmptyRange:
                        push_str(buffer, "for loop over an empty range never executes")

                    DiagnosticKind.AssignToLoopVar:
                        buffer.extend(f"assignment to loop variable \"{diagnostic.name}\" has no effect on iteration")

                    DiagnosticKind.ConstantComparison:
                        buffer.extend(f"constant comparison is always {diagnostic.actual}")

                    DiagnosticKind.DuplicateCondition:
                        push_str(buffer, "duplicate condition: this branch repeats an earlier condition and can never run")
                    _:
                        handled <- false
                if not handled:
                    diagnostic_message_part2(diagnostic, buffer, handled)
                if not handled:
                    diagnostic_message_part3(diagnostic, buffer, handled)
                if not handled:
                    diagnostic_message_part4(diagnostic, buffer, handled)
                return buffer
