# Private module-member access. A member declared inside a module's `private:` section may
# only be referenced from within that module. A qualified access `Module::member` from
# OUTSIDE the module is rejected:
#
#   module Bar:
#       private:
#           def hidden() -> i32: ...
#       def open() -> i32: return hidden() * 2     # inside Bar — fine
#   def outside() -> i32:
#       return Bar::hidden()                       # outside Bar — error
#
# The parser records each private member name on the __private_member side-table; the
# member's owning module comes from module_member_owner/name (symbol table). An access
# `Module::member` fires when member is private, belongs to Module, and the enclosing
# declaration is not that module.
include "./private_module_boundary.elisa"

extend Semantic:
    private:
        const PMA_HASH_COMPONENT_SEPARATOR: u64 = 255

        struct PrivateImportSourceIndex:
            heads: mutable dict[u64, u32]
            modules: mutable darray[sview @source]
            lines: mutable darray[u32]
            offsets: mutable darray[u32]
            source_annotations: mutable darray[usize]
            next: mutable darray[u32]

        struct PrivateMemberIndex:
            names: mutable darray[sview @source]
            modules: mutable darray[sview @source]
            declaration_offsets: mutable darray[u32]
            name_heads: mutable dict[u64, u32]
            name_next: mutable darray[u32]
            import_heads: mutable dict[u64, u32]
            import_owners: mutable darray[sview @source]
            import_members: mutable darray[sview @source]
            import_next: mutable darray[u32]

        def pma_member_head(index: PrivateMemberIndex&, name: sview) -> u32:
            can Abort.Panic:
                return head if index.name_heads.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE

        def pma_import_head(index: PrivateMemberIndex&, hash: u64) -> u32:
            can Abort.Panic:
                return head if index.import_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        def pma_import_source_hash(module: sview, line: u32, offset: u32) -> u64:
            can Abort.Panic:
                hash: mutable u64 = name_hash(module)
                hash <- (hash ^ PMA_HASH_COMPONENT_SEPARATOR) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ line.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ PMA_HASH_COMPONENT_SEPARATOR) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ offset.u64()) * SEMANTIC_HASH_PRIME
                return hash

        def pma_import_source_head(index: PrivateImportSourceIndex&, module: sview, line: u32, offset: u32) -> u32:
            can Abort.Panic:
                return row if index.heads.get(pma_import_source_hash(module, line, offset)) is row else SYMBOL_INDEX_ROW_NONE

        def pma_import_source_contains(index: PrivateImportSourceIndex&, annotations: darray[Ast::EnumAnnotation]&, module: sview, line: u32, offset: u32, source_module: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = pma_import_source_head(index, module, line, offset)
                while row != SYMBOL_INDEX_ROW_NONE |row, index, annotations, module, line, offset, source_module|:
                    source_annotation: Ast::EnumAnnotation = annotations[index.source_annotations[row.usize()]]
                    return true if index.modules[row.usize()] == module and index.lines[row.usize()] == line and index.offsets[row.usize()] == offset and source_annotation.name == source_module
                    row <- index.next[row.usize()]
                return false

        def pma_selective_import_hash(owner: sview, member: sview) -> u64:
            can Abort.Panic:
                # Separate the two byte strings before hashing. The resulting hash only
                # selects a collision chain; exact owner/member equality remains authoritative.
                hash: mutable u64 = name_hash(owner)
                hash <- (hash ^ PMA_HASH_COMPONENT_SEPARATOR) * SEMANTIC_HASH_PRIME
                for byte in member |hash|:
                    hash <- (hash ^ byte.u64()) * SEMANTIC_HASH_PRIME
                return hash

        def pma_add_selective_import(index: mutable PrivateMemberIndex&, owner: sview @source, member: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = pma_selective_import_hash(owner, member)
                row: mutable u32 = pma_import_head(index, hash)
                while row != SYMBOL_INDEX_ROW_NONE |row, index, owner, member|:
                    return if index.import_owners[row.usize()] == owner and index.import_members[row.usize()] == member
                    row <- index.import_next[row.usize()]
                new_row: u32 = index.import_owners.count.u32()
                previous: u32 = pma_import_head(index, hash)
                index.import_owners.push(owner)
                index.import_members.push(member)
                index.import_next.push(previous)
                index.import_heads <- index.import_heads.put(hash, new_row) can Global{Read,Write}

        def pma_build_selective_import_index(annotations: darray[Ast::EnumAnnotation]&, index: mutable PrivateMemberIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                sources: mutable PrivateImportSourceIndex = PrivateImportSourceIndex{heads: {}, modules: [], lines: [], offsets: [], source_annotations: [], next: []}
                # Build an exact import-position index once. Multiple imports can share a
                # logical #line value, so source/member pairing includes lexical module and
                # token offset rather than joining every row with the same line.
                for source_index in 0..<annotations.count |source_index, annotations, sources|:
                    annotation: Ast::EnumAnnotation = annotations[source_index]
                    continue if annotation.owner != "__from_src"
                    # A multi-member `from M import ...` repeats the same source annotation
                    # for every member. Store its source row once rather than creating a
                    # quadratic cross-product when projecting its members. Keep an integer
                    # back-reference so the temporary index never owns borrowed source text.
                    continue if pma_import_source_contains(sources, annotations, annotation.module, annotation.line, annotation.offset, annotation.name)
                    hash: u64 = pma_import_source_hash(annotation.module, annotation.line, annotation.offset)
                    previous: u32 = pma_import_source_head(sources, annotation.module, annotation.line, annotation.offset)
                    row: u32 = sources.source_annotations.count.u32()
                    sources.modules.push(annotation.module)
                    sources.lines.push(annotation.line)
                    sources.offsets.push(annotation.offset)
                    sources.source_annotations.push(source_index)
                    sources.next.push(previous)
                    sources.heads <- sources.heads.put(hash, row) can Global{Read,Write}
                for annotation in annotations |annotations, sources, index|:
                    continue if annotation.owner != "__from_member"
                    row: mutable u32 = pma_import_source_head(sources, annotation.module, annotation.line, annotation.offset)
                    while row != SYMBOL_INDEX_ROW_NONE |row, annotations, sources, annotation, index|:
                        if sources.modules[row.usize()] == annotation.module and sources.lines[row.usize()] == annotation.line and sources.offsets[row.usize()] == annotation.offset:
                            source_annotation: Ast::EnumAnnotation = annotations[sources.source_annotations[row.usize()]]
                            pma_add_selective_import(index, source_annotation.name, annotation.name) can Global{Read,Write}
                        row <- sources.next[row.usize()]

        def pma_build_index(annotations: darray[Ast::EnumAnnotation]&, index: mutable PrivateMemberIndex&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation_index in 0..<annotations.count |annotation_index, annotations, index|:
                    annotation: Ast::EnumAnnotation = annotations[annotation_index]
                    continue if annotation.owner != "__private_member"
                    continue if annotation_index + 1 >= annotations.count
                    module_annotation: Ast::EnumAnnotation = annotations[annotation_index + 1]
                    continue if module_annotation.owner != "__private_member_module"
                    row: u32 = index.names.count.u32()
                    previous: u32 = pma_member_head(index, annotation.name)
                    index.names.push(annotation.name)
                    index.modules.push(module_annotation.name)
                    index.declaration_offsets.push(annotation.offset)
                    index.name_next.push(previous)
                    index.name_heads <- index.name_heads.put(name_hash(annotation.name), row) can Global{Read,Write}

        # Whether `module_name` declares `member` in a `private:` section. Each
        # `__private_member` entry is followed by a `__private_member_module` entry
        # naming its module, so the same member name in another module is unaffected.
        def pma_is_private(index: PrivateMemberIndex&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                private_index: mutable u32 = pma_member_head(index, member)
                while private_index != SYMBOL_INDEX_ROW_NONE |private_index, index, module_name, member|:
                    return true if index.names[private_index.usize()] == member and index.modules[private_index.usize()] == module_name
                    private_index <- index.name_next[private_index.usize()]
                return false

        # Whether `candidate` is exactly `owner` + `::` + `member`. A NESTED module is
        # recorded under its qualified name, so `Outer::Hidden` is how the symbol table
        # spells the module that the source calls `Hidden` inside `Outer`.
        def pma_qualified_tail_is(candidate: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                owner_length: usize = owner.len
                return false if:
                    candidate.len != owner_length + 2.usize() + member.len
                    not sview_slice_equals(candidate, 0, owner)
                    candidate[owner_length] != 58 or candidate[owner_length + 1.usize()] != 58
                return sview_slice_equals(candidate, owner_length + 2.usize(), member)

        def pma_module_owns(table: SymbolTable&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = member_chain_head(table, member)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, module_name, member|:
                    index: usize = row.usize()
                    if table.module_member_owner[index] == module_name:
                        return true if:
                            table.module_member_name[index] == member
                            pma_qualified_tail_is(table.module_member_name[index], module_name, member)
                    row <- table.member_name_next[index]
                return false

        # A file-level declaration shadows an imported module member with the same bare
        # spelling. Module-member rows are recorded once per declaration, so count differences
        # are not a reliable ownership test when the file also declares an overload.
        def pma_has_global_value(table: SymbolTable&, member: sview) -> bool:
            can Abort.Panic:
                symbol_row: mutable u32 = symbol_chain_head(table, member)
                while symbol_row != SYMBOL_INDEX_ROW_NONE |symbol_row, table, member|:
                    symbol: Symbol = table.symbols[symbol_row.usize()]
                    return true if symbol.name == member and symbol.kind != SymbolKind.Module and symbol.module_owner == ""
                    symbol_row <- table.symbol_name_next[symbol_row.usize()]
                return false

        # A global function shadows a bare function value, but calls still use Core's
        # overload candidate set across local and imported names. For call targets, only a
        # non-callable global value or lexical binding makes the private module candidate
        # unreachable before overload ranking.
        def pma_has_global_non_callable_value(table: SymbolTable&, member: sview) -> bool:
            can Abort.Panic:
                symbol_row: mutable u32 = symbol_chain_head(table, member)
                while symbol_row != SYMBOL_INDEX_ROW_NONE |symbol_row, table, member|:
                    symbol: Symbol = table.symbols[symbol_row.usize()]
                    return true if symbol.name == member and symbol.kind != SymbolKind.Module and symbol.kind != SymbolKind.Func and symbol.module_owner == ""
                    symbol_row <- table.symbol_name_next[symbol_row.usize()]
                return false

        # `table.imported_members` intentionally keeps only the member spelling. The compact
        # line-indexed pair projection preserves the source module without rescanning all
        # annotations (and without conflating a private name from one module with an import
        # from another module).
        def pma_selective_imports(index: PrivateMemberIndex&, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                hash: u64 = pma_selective_import_hash(owner, member)
                row: mutable u32 = pma_import_head(index, hash)
                while row != SYMBOL_INDEX_ROW_NONE |row, index, owner, member|:
                    return true if index.import_owners[row.usize()] == owner and index.import_members[row.usize()] == member
                    row <- index.import_next[row.usize()]
                return false

        def pma_import_scope_visible(current_module: sview, import_scope: sview) -> bool:
            can Abort.Panic:
                return true if import_scope == ""
                return pma_within_module(current_module, import_scope)

        # A source const nested in an unselected static-if arm is not a candidate for the
        # backend's folded condition. Branch identity is emitted beside the declaration so
        # same-scope sibling consts can be filtered before name resolution.
        def fill_static_if_branch_annotations(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.static_if_branch_annotations <- []
                for annotation in file.enum_annotations |table|:
                    table.static_if_branch_annotations <- table.static_if_branch_annotations.push(annotation) if annotation.owner == "__static_if_branch"
                table.static_if_branch_source_count <- file.enum_annotations.count

        def pma_static_if_const_branch_selection(file: Ast::File&, name: sview, symbol: Symbol, table: SymbolTable&, depth: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                if table.static_if_branch_source_count == file.enum_annotations.count and file.enum_annotations.count > 0:
                    return pma_static_if_const_branch_rows(table.static_if_branch_annotations, file, name, symbol, table, depth)
                return pma_static_if_const_branch_rows(file.enum_annotations, file, name, symbol, table, depth)

        def pma_static_if_const_branch_rows(rows: darray[Ast::EnumAnnotation]&, file: Ast::File&, name: sview, symbol: Symbol, table: SymbolTable&, depth: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in rows |found_marker, unknown, rows, file, name, symbol, table, depth|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__const_static_branch" or marker.detail_name != name or marker.module != symbol.module_owner or marker.line != symbol.line or marker.offset != symbol.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- pma_static_if_row_selection(file, marker.identity_id.usize(), symbol.module_owner, table, depth + 1) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        # Public overload ranking may suppress a private candidate only when this
        # declaration's static-if ancestry proves it active. Unknown markers are not
        # evidence that a public sibling wins the call.
        def pma_static_if_function_branch_selection(file: Ast::File&, name: sview, symbol: Symbol, table: SymbolTable&, depth: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                if table.static_if_branch_source_count == file.enum_annotations.count and file.enum_annotations.count > 0:
                    return pma_static_if_function_branch_rows(table.static_if_branch_annotations, file, name, symbol, table, depth)
                return pma_static_if_function_branch_rows(file.enum_annotations, file, name, symbol, table, depth)

        def pma_static_if_function_branch_rows(rows: darray[Ast::EnumAnnotation]&, file: Ast::File&, name: sview, symbol: Symbol, table: SymbolTable&, depth: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in rows |found_marker, unknown, rows, file, name, symbol, table, depth|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__function_static_branch" or marker.detail_name != name or marker.module != symbol.module_owner or marker.line != symbol.line or marker.offset != symbol.offset
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- pma_static_if_row_selection(file, marker.identity_id.usize(), symbol.module_owner, table, depth + 1) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        # Match direct module-qualified constant paths against the declaration owner.
        # Try the full spelling first, then the caller's module and lexical parents, as
        # ordinary qualified lookup does. Aliases that cannot be proven here stay unknown.
        def pma_static_if_qualified_module_matches(base: Ast::Expr, owner: sview, current_module: sview) -> bool:
            can Abort.Panic:
                return true if pma_chain_ends_at(base, owner, owner.len)
                candidate_scope: mutable sview = current_module
                while candidate_scope != "" |candidate_scope, base, owner|:
                    prefix_length: usize = candidate_scope.len
                    matches_prefix: mutable bool = owner.len > prefix_length + 2.usize()
                    for index in 0..<prefix_length |index, matches_prefix, candidate_scope, owner|:
                        matches_prefix <- false if owner[index] != candidate_scope[index]
                    if matches_prefix and owner[prefix_length] == 58 and owner[prefix_length + 1.usize()] == 58:
                        suffix: sview = string_view_slice(owner, (prefix_length + 2.usize()).i64(), owner.len.i64())
                        return pma_chain_ends_at(base, suffix, suffix.len)
                    parent_end: mutable usize = 0
                    for index in 0..<candidate_scope.len |index, parent_end, candidate_scope|:
                        parent_end <- index if index + 1.usize() < candidate_scope.len and candidate_scope[index] == 58 and candidate_scope[index + 1.usize()] == 58
                    candidate_scope <- string_view_slice(candidate_scope, 0, parent_end.i64()) if parent_end > 0
                    candidate_scope <- "" if parent_end == 0
                return false

        def pma_static_if_named_constant_value(name: sview, current_module: sview, file: Ast::File&, table: SymbolTable&, depth: u32, qualifier: Ast::Expr? = null) -> (known: bool, value: i64):
            can Abort.Panic:
                return (false, 0) if depth >= 64
                selected_row: mutable usize = table.immutable_const_values.count
                selected_scope_length: mutable usize = 0.usize()
                selected_module: mutable sview = ""
                selected_ambiguous: mutable bool = false
                unknown_scope_length: mutable usize = 0.usize()
                found_unknown: mutable bool = false
                # Only rows named NAME can match, so walk NAME's own name chain. A chain that
                # does not cover every name row falls back to the full row scan. No local
                # collection is built: a darray local makes the checker classify this function
                # as region-owning, which invalidates its cached analysis on every build.
                indexed: bool = table.immutable_const_name_next.count == table.immutable_const_names.count
                cursor: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if indexed:
                    if table.immutable_const_name_heads.get(name_hash(name)) is head:
                        cursor <- head
                scan_row: mutable usize = 0
                while (cursor != SYMBOL_INDEX_ROW_NONE if indexed else scan_row < table.immutable_const_values.count) |selected_row, selected_scope_length, selected_module, selected_ambiguous, unknown_scope_length, found_unknown, name, current_module, file, table, depth, indexed, cursor, scan_row|:
                    const_index: usize = cursor.usize() if indexed else scan_row
                    if indexed:
                        cursor <- table.immutable_const_name_next[cursor.usize()]
                    else:
                        scan_row <- scan_row + 1.usize()
                    continue if const_index >= table.immutable_const_names.count or const_index >= table.immutable_const_rows.count
                    continue if table.immutable_const_names[const_index] != name
                    symbol_row: usize = table.immutable_const_rows[const_index].usize()
                    continue if symbol_row >= table.symbols.count
                    symbol: Symbol = table.symbols[symbol_row]
                    if qualifier is qualified_base:
                        continue if symbol.name != name or not pma_static_if_qualified_module_matches(qualified_base, symbol.module_owner, current_module)
                    else:
                        continue if symbol.name != name or (symbol.module_owner != "" and not SemanticPrivateModuleBoundary::within_module(current_module, symbol.module_owner))
                    branch: (known: bool, active: bool) = pma_static_if_const_branch_selection(file, name, symbol, table, depth + 1)
                    continue if branch.known and not branch.active
                    if not branch.known:
                        found_unknown <- true
                        unknown_scope_length <- symbol.module_owner.len if symbol.module_owner.len > unknown_scope_length
                        continue
                    if selected_row >= table.immutable_const_values.count or symbol.module_owner.len > selected_scope_length:
                        selected_row <- const_index
                        selected_scope_length <- symbol.module_owner.len
                        selected_module <- symbol.module_owner
                        selected_ambiguous <- false
                    elif symbol.module_owner.len == selected_scope_length:
                        selected_ambiguous <- true
                # The backend resolves exact-module constants before top-level fallback.
                # Unknown rows in a less-specific scope cannot make that winner uncertain.
                return (false, 0) if found_unknown and (selected_row >= table.immutable_const_values.count or unknown_scope_length >= selected_scope_length)
                return (false, 0) if selected_ambiguous
                return (false, 0) if selected_row >= table.immutable_const_values.count and qualifier is qualified_base
                return (true, 0) if selected_row >= table.immutable_const_values.count
                return pma_static_if_condition_value(table.immutable_const_values[selected_row], selected_module, file, table, depth + 1)

        def pma_static_if_char_value(text: sview) -> (known: bool, value: i64):
            can Abort.Panic:
                return (false, 0) if text.len == 0
                start: usize = 1 if text.len >= 3 and text[0] == 39 and text[text.len - 1] == 39 else 0
                end: usize = text.len - 1 if start == 1 else text.len
                return (false, 0) if start >= end
                first: u8 = text[start]
                if first == 92:
                    return (false, 0) if end - start != 2
                    escaped: u8 = text[start + 1]
                    return (true, 10) if escaped == 110
                    return (true, 9) if escaped == 116
                    return (true, 13) if escaped == 114
                    return (true, 0) if escaped == 48
                    return (true, 92) if escaped == 92
                    return (true, 39) if escaped == 39
                    return (false, 0)
                return (false, 0) if end - start != 1
                return (true, first.i64())

        # The backend treats a condition it cannot fold as false and continues through
        # later arms/fallback. Preserve unknown for backend-foldable AST forms this checker
        # does not model, including qualified constants, enum members, string lengths, and
        # postfix casts, floats, and strings, so they cannot silently select the wrong
        # private-import arm.
        def pma_static_if_condition_value(expression: Ast::Expr, current_module: sview, file: Ast::File&, table: SymbolTable&, depth: u32) -> (known: bool, value: i64):
            can Abort.Panic:
                return (false, 0) if depth >= 64
                match expression:
                    Expr.BoolLit(value, _):
                        return (true, 1 if value else 0)
                    Expr.IntLit(value, _):
                        return (true, value)
                    Expr.CharLit(value, _):
                        return pma_static_if_char_value(value)
                    Expr.Paren(inner, _):
                        return pma_static_if_condition_value(inner, current_module, file, table, depth + 1)
                    Expr.Ident(name, _):
                        target: (known: bool, value: i64) = ga_static_if_target_constant(name)
                        return target if target.known
                        return (false, 0) if ga_static_if_target_predicate(name)
                        return pma_static_if_named_constant_value(name, current_module, file, table, depth + 1)
                    Expr.Scope(base, name, _):
                        return pma_static_if_named_constant_value(name, current_module, file, table, depth + 1, base)
                    Expr.Unary(operator, operand, _):
                        inner: (known: bool, value: i64) = pma_static_if_condition_value(operand, current_module, file, table, depth + 1)
                        return inner if not inner.known
                        if operator == TokenKind.Plus:
                            return inner
                        if operator == TokenKind.Minus:
                            return (true, 0) if not BackendConstArithmetic::negation_is_safe(inner.value)
                            return (true, 0 - inner.value)
                        if operator == TokenKind.Tilde:
                            return (true, ~inner.value)
                        return (false, 0)
                    Expr.Binary(left, operator, right, _):
                        left_value: (known: bool, value: i64) = pma_static_if_condition_value(left, current_module, file, table, depth + 1)
                        right_value: (known: bool, value: i64) = pma_static_if_condition_value(right, current_module, file, table, depth + 1)
                        return left_value if not left_value.known
                        return right_value if not right_value.known
                        if operator == TokenKind.EqEq:
                            return (true, 1 if left_value.value == right_value.value else 0)
                        if operator == TokenKind.BangEq:
                            return (true, 1 if left_value.value != right_value.value else 0)
                        if operator == TokenKind.Lt:
                            return (true, 1 if left_value.value < right_value.value else 0)
                        if operator == TokenKind.Gt:
                            return (true, 1 if left_value.value > right_value.value else 0)
                        if operator == TokenKind.LtEq:
                            return (true, 1 if left_value.value <= right_value.value else 0)
                        if operator == TokenKind.GtEq:
                            return (true, 1 if left_value.value >= right_value.value else 0)
                        if operator == TokenKind.And:
                            return (true, 1 if left_value.value != 0 and right_value.value != 0 else 0)
                        if operator == TokenKind.Or:
                            return (true, 1 if left_value.value != 0 or right_value.value != 0 else 0)
                        if operator == TokenKind.Plus:
                            return (true, 0) if not BackendConstArithmetic::add_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value + right_value.value)
                        if operator == TokenKind.Minus:
                            return (true, 0) if not BackendConstArithmetic::subtract_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value - right_value.value)
                        if operator == TokenKind.Star:
                            return (true, 0) if not BackendConstArithmetic::multiply_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value * right_value.value)
                        if operator == TokenKind.Slash:
                            return (true, 0) if not BackendConstArithmetic::division_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value / right_value.value)
                        if operator == TokenKind.Percent:
                            return (true, 0) if not BackendConstArithmetic::remainder_is_safe(left_value.value, right_value.value)
                            return (true, left_value.value % right_value.value)
                        if operator == TokenKind.Caret:
                            return (true, left_value.value ^ right_value.value)
                        if operator == TokenKind.Pipe:
                            return (true, left_value.value | right_value.value)
                        if operator == TokenKind.Ampersand:
                            return (true, left_value.value & right_value.value)
                        if operator == TokenKind.LShift:
                            return (true, 0) if not BackendConstArithmetic::shift_count_is_safe(right_value.value)
                            return (true, left_value.value << right_value.value)
                        if operator == TokenKind.RShift:
                            return (true, 0) if not BackendConstArithmetic::shift_count_is_safe(right_value.value)
                            return (true, left_value.value >> right_value.value)
                        return (false, 0)
                    Expr.Scope(_, _, _) | Expr.Field(_, _, _) | Expr.Call(_, _, _, _):
                        return (false, 0)
                    _:
                        return (false, 0)

        def pma_static_if_row_selection(file: Ast::File&, branch_row: usize, current_module: sview, table: SymbolTable&, depth: u32 = 0) -> (known: bool, selected: bool):
            can Abort.Panic:
                return (false, false) if depth >= 64 or branch_row >= file.static_if_lines.count or branch_row >= file.static_if_kinds.count
                branch_depth: u32 = file.static_if_depths[branch_row] if branch_row < file.static_if_depths.count else StaticIfBranch::TOP_LEVEL_DEPTH
                chain_start: mutable usize = file.static_if_lines.count
                row: mutable usize = branch_row + 1.usize()
                while row > 0 |row, chain_start, branch_depth, file|:
                    row <- row - 1.usize()
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    if file.static_if_kinds[row] == StaticIfBranch::Kind.ChainHead:
                        chain_start <- row
                        break
                return (false, false) if chain_start >= file.static_if_lines.count
                for row in chain_start..<(branch_row + 1.usize()) |row, branch_row, branch_depth, file|:
                    continue if row >= file.static_if_depths.count or file.static_if_depths[row] != branch_depth
                    branch_kind: StaticIfBranch::Kind = file.static_if_kinds[row]
                    if branch_kind == StaticIfBranch::Kind.Fallback:
                        return (true, row == branch_row)
                    return (false, false) if row >= file.static_if_conds.count or row >= file.static_if_modules.count
                    condition_module: sview = file.static_if_modules[row]
                    condition: (known: bool, value: i64) = pma_static_if_condition_value(file.static_if_conds[row], condition_module, file, table, depth + 1)
                    return (false, false) if not condition.known
                    if condition.known and condition.value != 0:
                        return (true, row == branch_row)
                    return (true, false) if row == branch_row
                return (true, false)

        # Statement static-if blocks retain the source line used by the parser's
        # condition-row projection. Refuse duplicate matches rather than filtering a
        # block with another branch's selection result.
        def pma_static_if_row_for_position(file: Ast::File&, position: Ast::Pos) -> usize:
            can Abort.Panic:
                selected: mutable usize = file.static_if_lines.count
                for row in 0..<file.static_if_lines.count |selected, position, file|:
                    if row < file.static_if_offsets.count and file.static_if_lines[row] == position.line and file.static_if_offsets[row] == position.offset:
                        return file.static_if_lines.count if selected < file.static_if_lines.count
                        selected <- row
                return selected

        def pma_import_member_for_branch_annotation(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&) -> (found: bool, member: sview, module: sview):
            can Abort.Panic:
                return (true, annotation.name, annotation.module) if annotation.owner == "__from_member"
                return (false, "", "") if annotation.owner != "__from_src" and annotation.name != "__using_member"
                for member_annotation in annotations:
                    continue if member_annotation.owner != "__from_member" or member_annotation.line != annotation.line or member_annotation.offset != annotation.offset
                    continue if annotation.owner == "__from_src" and member_annotation.module != annotation.module
                    continue if annotation.name == "__using_member" and member_annotation.name != annotation.module
                    return (true, member_annotation.name, member_annotation.module)
                return (false, "", "")

        def pma_import_branch_selection(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&, marker_owner: sview, marker_name: sview, marker_detail: sview, module: sview, line: u32, offset: u32) -> (known: bool, active: bool):
            can Abort.Panic:
                found_marker: mutable bool = false
                unknown: mutable bool = false
                for marker in annotations |found_marker, unknown, file, marker_owner, marker_name, marker_detail, module, line, offset|:
                    # Source positions are cheap and nearly unique; check them before
                    # comparing annotation strings while scanning the annotation table.
                    continue if marker.line != line or marker.offset != offset or marker.module != module or marker.name != marker_name or marker.owner != marker_owner or marker.detail_name != marker_detail
                    found_marker <- true
                    branch: mutable (known: bool, selected: bool) = (false, false)
                    branch <- pma_static_if_row_selection(file, marker.identity_id.usize(), module, table) if marker.identity_id != 4294967295
                    return (true, false) if branch.known and not branch.selected
                    unknown <- true if marker.identity_id == 4294967295 or not branch.known
                return (true, true) if not found_marker
                return (false, false) if unknown
                return (true, true)

        def pma_using_alias_for_using_row(annotations: darray[Ast::EnumAnnotation]&, using_row: Ast::EnumAnnotation) -> (found: bool, alias: sview, alias_offset: u32):
            can Abort.Panic:
                next_using_offset: mutable u32 = 4294967295
                for candidate in annotations |next_using_offset, using_row|:
                    continue if candidate.name != "__using" or candidate.module != using_row.module or candidate.line != using_row.line or candidate.offset <= using_row.offset
                    next_using_offset <- candidate.offset if candidate.offset < next_using_offset
                selected_alias: mutable sview = ""
                selected_alias_offset: mutable u32 = 4294967295
                for target_row in annotations |selected_alias, selected_alias_offset, using_row, next_using_offset|:
                    continue if target_row.name != "__using_alias_target" or target_row.owner != using_row.owner or target_row.module != using_row.module or target_row.line != using_row.line or target_row.offset <= using_row.offset or target_row.offset >= next_using_offset
                    for alias_row in annotations |selected_alias, selected_alias_offset, target_row|:
                        if alias_row.name == "__using_alias" and alias_row.module == target_row.module and alias_row.line == target_row.line and alias_row.offset == target_row.offset and target_row.offset < selected_alias_offset:
                            selected_alias <- alias_row.owner
                            selected_alias_offset <- target_row.offset
                return (selected_alias != "", selected_alias, selected_alias_offset)

        def pma_import_annotation_branch_selection(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            return pma_import_annotation_branch_selection_indexed(annotation, annotations, annotations, file, table)

        def pma_import_annotation_branch_selection_indexed(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, markers: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> (known: bool, active: bool):
            can Abort.Panic:
                if annotation.name == "__binding_wildcard_import":
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__binding_wildcard_import_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset)
                if annotation.name == "__using":
                    alias_pair: (found: bool, alias: sview, alias_offset: u32) = pma_using_alias_for_using_row(annotations, annotation)
                    if alias_pair.found:
                        return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__using_alias_static_branch", alias_pair.alias, annotation.module, annotation.line, alias_pair.alias_offset)
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__binding_wildcard_import_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset)
                if annotation.name == "__using_alias":
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__using_alias_static_branch", annotation.owner, annotation.module, annotation.line, annotation.offset)
                if annotation.name == "__using_alias_target":
                    alias_name: mutable sview = ""
                    for alias in annotations |alias_name, annotation|:
                        alias_name <- alias.owner if alias.name == "__using_alias" and alias.module == annotation.module and alias.line == annotation.line and alias.offset == annotation.offset
                    return (true, true) if alias_name == ""
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__using_alias_static_branch", alias_name, annotation.module, annotation.line, annotation.offset)
                if annotation.owner == "__private_member":
                    member_module: mutable sview @source = ""
                    found_module: mutable bool = false
                    for module_annotation in annotations |member_module, found_module, annotation|:
                        continue if module_annotation.owner != "__private_member_module" or module_annotation.line != annotation.line or module_annotation.offset != annotation.offset
                        member_module <- module_annotation.name
                        found_module <- true
                        break
                    return (true, true) if not found_module
                    return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__private_member_static_branch", annotation.name, member_module, annotation.line, annotation.offset)
                marker_member: (found: bool, member: sview, module: sview) = pma_import_member_for_branch_annotation(annotation, annotations)
                return (true, true) if not marker_member.found
                return pma_import_branch_selection(markers, file, table, "__static_if_branch", "__from_member_static_branch", marker_member.member, marker_member.module, annotation.line, annotation.offset)

        def pma_import_annotation_in_inactive_static_branch(annotation: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(annotation, annotations, file, table)
                return branch.known and not branch.active

        def pma_import_row_branch_uncertain(annotations: darray[Ast::EnumAnnotation]&, import_owner: sview, import_name: sview, import_scope: sview, line: u32, offset: u32) -> bool:
            can Abort.Panic:
                return any marker in annotations where marker.owner == "__pma_unknown_static_import" and marker.name == import_owner and marker.detail_name == import_name and marker.module == import_scope and marker.line == line and marker.offset == offset

        def pma_active_import_annotations(file: Ast::File&, table: SymbolTable&) -> darray[Ast::EnumAnnotation]:
            can Memory.Allocate, Abort.Panic:
                active: mutable darray[Ast::EnumAnnotation] = []
                markers: mutable darray[Ast::EnumAnnotation] = []
                relevant: mutable darray[Ast::EnumAnnotation] = []
                for candidate in file.enum_annotations |markers, relevant|:
                    markers.push(candidate) if candidate.owner == "__static_if_branch"
                    relevant.push(candidate) if candidate.owner == "__from_member" or candidate.owner == "__private_member_module" or candidate.name == "__using" or candidate.name == "__using_alias" or candidate.name == "__using_alias_target"
                for annotation in file.enum_annotations |active, markers, relevant, file, table|:
                    import_row: bool = annotation.owner == "__from_member" or annotation.owner == "__from_src" or annotation.name == "__using_member" or annotation.name == "__using" or annotation.name == "__binding_wildcard_import" or annotation.name == "__using_alias" or annotation.name == "__using_alias_target"
                    private_member_row: bool = annotation.owner == "__private_member"
                    branch_row: bool = import_row or private_member_row
                    branch: mutable (known: bool, active: bool) = (true, true)
                    branch <- pma_import_annotation_branch_selection_indexed(annotation, relevant, markers, file, table) if branch_row and markers.count > 0
                    continue if branch_row and branch.known and not branch.active
                    active.push(annotation)
                    if import_row and not branch.known:
                        active.push(Ast::EnumAnnotation{owner: "__pma_unknown_static_import", name: annotation.owner, detail_name: annotation.name, module: annotation.module, line: annotation.line, offset: annotation.offset})
                return active

        def pma_selective_annotation_is_using_member(annotations: darray[Ast::EnumAnnotation]&, member_annotation: Ast::EnumAnnotation, source_annotation: Ast::EnumAnnotation, member: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__using_member" and annotation.owner == source_annotation.name and annotation.module == member and annotation.line == member_annotation.line and annotation.offset == member_annotation.offset

        def pma_selective_import_target_status(annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> (found: bool, known: bool, first: bool):
            can Abort.Panic:
                selected_owner: mutable sview = ""
                selected_scope: mutable sview = ""
                selected_offset: mutable u32 = 4294967295
                selected_is_using: mutable bool = false
                found_owner: mutable bool = false
                known_order: mutable bool = true
                for member_annotation in annotations |annotations, current_module, owner, member|:
                    continue if member_annotation.owner != "__from_member" or member_annotation.name != member
                    continue if not pma_import_scope_visible(current_module, member_annotation.module)
                    known_order <- false if pma_import_row_branch_uncertain(annotations, "__from_member", member_annotation.name, member_annotation.module, member_annotation.line, member_annotation.offset)
                    for source_annotation in annotations |annotations, current_module, owner, member, member_annotation|:
                        continue if source_annotation.owner != "__from_src" or source_annotation.line != member_annotation.line or source_annotation.offset != member_annotation.offset or source_annotation.module != member_annotation.module
                        found_owner <- true if source_annotation.name == owner
                        candidate_is_using: bool = pma_selective_annotation_is_using_member(annotations, member_annotation, source_annotation, member)
                        if selected_owner == "":
                            selected_owner <- source_annotation.name
                            selected_scope <- member_annotation.module
                            selected_offset <- member_annotation.offset
                            selected_is_using <- candidate_is_using
                        elif selected_owner != source_annotation.name:
                            # Core registers the first alias in one scope. Cross-scope
                            # conflicts do not carry enough ordered metadata here, so keep
                            # the private path fail-closed instead of guessing a winner.
                            if selected_scope != member_annotation.module:
                                known_order <- false
                            elif candidate_is_using and not selected_is_using:
                                selected_owner <- source_annotation.name
                                selected_offset <- member_annotation.offset
                                selected_is_using <- true
                            elif selected_is_using and not candidate_is_using:
                                pass
                            elif member_annotation.offset < selected_offset:
                                selected_owner <- source_annotation.name
                                selected_offset <- member_annotation.offset
                                selected_is_using <- candidate_is_using
                            elif member_annotation.offset == selected_offset:
                                known_order <- false
                return (found_owner, known_order, selected_owner == owner)

        def pma_private_imported_module_member_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if any annotation in annotations where annotation.name == "__binding_wildcard_import" and annotation.owner == owner and pma_import_scope_visible(current_module, annotation.module)
                return false if not pma_selective_imports(index, owner, member)
                target: (found: bool, known: bool, first: bool) = pma_selective_import_target_status(annotations, current_module, owner, member)
                return target.found and (not target.known or target.first)

        def pma_public_imported_module_member_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if any annotation in annotations where annotation.name == "__binding_wildcard_import" and annotation.owner == owner and pma_import_scope_visible(current_module, annotation.module) and not pma_import_row_branch_uncertain(annotations, annotation.owner, annotation.name, annotation.module, annotation.line, annotation.offset)
                return false if not pma_selective_imports(index, owner, member)
                target: (found: bool, known: bool, first: bool) = pma_selective_import_target_status(annotations, current_module, owner, member)
                return target.found and target.known and target.first

        def pma_imported_module_member_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                return pma_public_imported_module_member_visible(index, annotations, current_module, owner, member)

        # Is the accessing module INSIDE the owner's privacy boundary? A nested module is:
        # `module A::Paint` may call `A::helper` even when `helper` is private to `A`, which is
        # what stage0 allows. This was a plain `!=` on the module names, so every child module
        # counted as outside its own parent and internal helpers had to be made public to be
        # callable from a submodule of the module that declared them.
        def pma_within_module(current_module: sview, owner: sview) -> bool:
            can Abort.Panic:
                return SemanticPrivateModuleBoundary::within_module(current_module, owner)

        # A candidate can join Core's unqualified receiver set when it is in the
        # current lexical module/one of its ancestors, at file scope, or imported into
        # the caller's scope. Do not count a public member in a private module path as a
        # usable sibling: Core can select it, but access checking will reject it.
        def pma_unqualified_candidate_module_visible(index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, candidate_module: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if candidate_module == "" or pma_within_module(current_module, candidate_module)
                return false if not pma_imported_module_member_visible(index, annotations, current_module, candidate_module, member)
                segment_start: mutable usize = 0.usize()
                while segment_start < candidate_module.len |segment_start, candidate_module, current_module, index, member|:
                    segment_end: mutable usize = segment_start
                    while segment_end < candidate_module.len and candidate_module[segment_end] != 58 |segment_end, candidate_module|:
                        segment_end <- segment_end + 1.usize()
                    segment: sview = candidate_module[segment_start:segment_end]
                    owner: sview = candidate_module[0:segment_start - 2.usize()] if segment_start >= 2.usize() else ""
                    return false if pma_is_private(index, owner, segment) and not pma_within_module(current_module, owner)
                    break if segment_end == candidate_module.len
                    next_start: usize = segment_end + 2.usize()
                    return false if next_start >= candidate_module.len or candidate_module[segment_end + 1.usize()] != 58
                    segment_start <- next_start
                return true

        # Return the owning module when an unqualified name resolves to a private
        # member imported into the current file. Qualified access was the original
        # check, but `using M` makes `M::hidden` and `hidden` the same visibility
        # boundary. Keep the caller's lexical bindings in the query so a parameter
        # or local that shadows a private imported member is not misdiagnosed.
        def pma_unqualified_owner(table: SymbolTable&, current_module: sview, private_index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, bound: darray[sview @source]&, member: sview) -> sview @source:
            can Abort.Panic:
                return "" if:
                    any bound_name in bound where bound_name == member
                    pma_has_global_value(table, member)
                owner: sview @source = pma_unqualified_private_import_owner(table, current_module, private_index, annotations, member)
                return "" if owner != "" and pma_has_public_imported_function_value(table, private_index, annotations, current_module, member, owner)
                return owner

        def pma_unqualified_call_owner(table: SymbolTable&, current_module: sview, private_index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, bound: darray[sview @source]&, member: sview) -> sview @source:
            can Abort.Panic:
                return "" if:
                    any bound_name in bound where bound_name == member
                    pma_has_global_non_callable_value(table, member)
                return pma_unqualified_private_import_owner(table, current_module, private_index, annotations, member)

        def pma_unqualified_private_import_owner(table: SymbolTable&, current_module: sview, private_index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, member: sview) -> sview @source:
            can Abort.Panic:
                row: mutable u32 = member_chain_head(table, member)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, current_module, member|:
                    index: usize = row.usize()
                    if table.module_member_name[index] == member:
                        owner: sview @source = table.module_member_owner[index]
                        if not pma_within_module(current_module, owner):
                            imported: bool = pma_private_imported_module_member_visible(private_index, annotations, current_module, owner, member)
                            return owner if imported and pma_is_private(private_index, owner, member) and pma_module_owns(table, owner, member)
                    row <- table.member_name_next[index]
                return ""

        # The private-section marker is attached to the declaration-head offset, which is
        # also Symbol.offset. Match it back to the exact overload before using its signature;
        # name_pos.offset is the identifier token and does not identify the marker.
        def pma_symbol_has_private_marker(index: PrivateMemberIndex&, symbol: Symbol) -> bool:
            can Abort.Panic:
                row: mutable u32 = pma_member_head(index, symbol.name)
                while row != SYMBOL_INDEX_ROW_NONE |row, index, symbol|:
                    index_position: usize = row.usize()
                    return true if index.names[index_position] == symbol.name and index.modules[index_position] == symbol.module_owner and index.declaration_offsets[index_position] == symbol.offset
                    row <- index.name_next[index_position]
                return false

        # A private wildcard candidate is removed before a function value is resolved.
        # If the source also imports a public callable of the same spelling explicitly,
        # that selective binding is the visible value and the private wildcard row must
        # not trigger a name-only diagnostic. Calls use the overload-aware path below.
        def pma_has_public_imported_function_value(table: SymbolTable&, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, member: sview, hidden_owner: sview) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |table, index, annotations, current_module, member, hidden_owner|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != member or symbol.module_owner == "" or symbol.module_owner == hidden_owner
                    continue if not pma_module_owns(table, symbol.module_owner, member) or not pma_unqualified_candidate_module_visible(index, annotations, current_module, symbol.module_owner, member)
                    return true if not pma_symbol_has_private_marker(index, symbol)
                return false

        def pma_bound_type_name(bound: darray[sview @source]&, bound_types: darray[sview @source]&, name: sview) -> sview @source:
            can Abort.Panic:
                index: mutable usize = bound.count
                while index > 0 |index, bound, bound_types, name|:
                    index <- index - 1
                    return bound_types[index] if bound[index] == name and index < bound_types.count
                    return "" if bound[index] == name
                return ""

        def pma_argument_type_name(argument: Ast::Expr, bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> sview @source:
            can Abort.Panic:
                match argument:
                    Expr.IntLit(_, _):
                        return "int"
                    Expr.FloatLit(_, _):
                        return "f64"
                    Expr.BoolLit(_, _):
                        return "bool"
                    Expr.CharLit(_, _):
                        return "char"
                    Expr.StringLit(_, _):
                        return "string"
                    Expr.Ident(name, _):
                        return pma_bound_type_name(bound, bound_types, name)
                    Expr.Paren(inner, _):
                        return pma_argument_type_name(inner, bound, bound_types)
                    _:
                        return ""

        def pma_symbol_first_parameter_type(table: SymbolTable&, symbol: Symbol) -> (found: bool, kind: SemTypeKind, name: sview @source):
            can Abort.Panic:
                parameter_index: mutable usize = 0.usize()
                for row in 0..<table.function_param_declaration_id.count |parameter_index, table, symbol|:
                    continue if table.function_param_declaration_id[row].value != symbol.id.value
                    if parameter_index == 0.usize():
                        return (true, interned_kind(table.function_param_type_id[row], table), table.function_param_type[row]) if row < table.function_param_type_id.count and row < table.function_param_type.count
                        return (false, SemTypeKind.Unknown, "")
                    parameter_index <- parameter_index + 1.usize()
                return (false, SemTypeKind.Unknown, "")

        def pma_generic_parameter_identity(annotations: darray[Ast::EnumAnnotation]&, parameter_name: sview, symbol: Symbol) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == parameter_name and annotation.name == "__generic_param_identity" and annotation.detail_line == symbol.line and annotation.offset == symbol.offset and annotation.module == symbol.module_owner

        # The call-site type probe carries a bare spelling, not a resolved nominal
        # owner. Only compare named formals when that spelling identifies one declared
        # type across the complete symbol table; same-spelled module-local types must
        # leave the privacy check fail-closed.
        def pma_named_type_spelling_is_unique(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                found: mutable bool = false
                for symbol in table.symbols |found, name|:
                    continue if symbol.name != name
                    type_symbol: bool = symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)
                    continue if not type_symbol
                    return false if found
                    found <- true
                return found

        # Mirror Core's receiver-ranking arity range exactly. Defaulted parameters lower
        # arity_min; they do not make every argument count viable, and variadic signatures
        # still require their non-defaulted minimum.
        def pma_symbol_core_accepts_receiver_arity(symbol: Symbol, argument_count: usize) -> bool:
            can Abort.Panic:
                return argument_count.u32() >= symbol.arity_min and argument_count.u32() <= symbol.arity_max

        # Rank only the public cases this checker can prove from source facts: an exact
        # known builtin or uniquely-spelled named formal, or Core's untyped-int-to-integral
        # receiver case, outranks a bare type parameter. A generic formal can still be the
        # only visible sibling; unknown conversions fail closed.
        def pma_public_call_sibling_rank(file: Ast::File&, index: PrivateMemberIndex&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, member: sview, current_module: sview, unqualified_call: bool, arguments: darray[Ast::Expr], bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> (found: bool, rank: usize):
            can Abort.Panic:
                return (false, 0.usize()) if arguments.count == 0.usize()
                actual_type: sview @source = pma_argument_type_name(arguments[0], bound, bound_types)
                return (false, 0.usize()) if actual_type == ""
                best_found: mutable bool = false
                best_rank: mutable usize = 0.usize()
                for symbol in table.symbols |best_found, best_rank, file, index, table, annotations, owner, member, current_module, unqualified_call, arguments, actual_type|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != member or pma_symbol_has_private_marker(index, symbol)
                    branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, member, symbol, table, 0)
                    continue if not branch.known or not branch.active
                    if not unqualified_call:
                        continue if symbol.module_owner != owner
                    continue if unqualified_call and not pma_unqualified_candidate_module_visible(index, annotations, current_module, symbol.module_owner, member)
                    continue if not pma_symbol_core_accepts_receiver_arity(symbol, arguments.count)
                    first_parameter: (found: bool, kind: SemTypeKind, name: sview @source) = pma_symbol_first_parameter_type(table, symbol)
                    continue if not first_parameter.found
                    candidate_rank: mutable usize = 0.usize()
                    if first_parameter.kind == SemTypeKind.Named and pma_generic_parameter_identity(annotations, first_parameter.name, symbol):
                        candidate_rank <- 0.usize()
                    elif (first_parameter.kind == SemTypeKind.Bool or first_parameter.kind == SemTypeKind.Int or first_parameter.kind == SemTypeKind.Float or first_parameter.kind == SemTypeKind.Char or first_parameter.kind == SemTypeKind.String) and first_parameter.name == actual_type:
                        candidate_rank <- 1.usize()
                    elif first_parameter.kind == SemTypeKind.Named and first_parameter.name == actual_type and pma_named_type_spelling_is_unique(table, first_parameter.name):
                        candidate_rank <- 1.usize()
                    elif actual_type == "int" and (first_parameter.kind == SemTypeKind.Int or first_parameter.kind == SemTypeKind.Char):
                        candidate_rank <- 1.usize()
                    else:
                        continue
                    # Core prefers a directly declared lexical candidate over an imported
                    # overload, even when the direct candidate is generic and the imported
                    # private candidate is concrete. Preserve that precedence before
                    # comparing formal-type specificity.
                    if unqualified_call and (symbol.module_owner == "" or pma_within_module(current_module, symbol.module_owner)):
                        candidate_rank <- 2.usize()
                    if not best_found or candidate_rank > best_rank:
                        best_found <- true
                        best_rank <- candidate_rank
                return (best_found, best_rank)

        def pma_private_candidate_excluded_by_public_rank(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, symbol: Symbol, public_rank: usize, actual_type: sview) -> bool:
            can Abort.Panic:
                first_parameter: (found: bool, kind: SemTypeKind, name: sview @source) = pma_symbol_first_parameter_type(table, symbol)
                return false if not first_parameter.found
                return true if public_rank > 1.usize()
                return true if actual_type == "bool" and (first_parameter.kind == SemTypeKind.Int or first_parameter.kind == SemTypeKind.Float or first_parameter.kind == SemTypeKind.Char or first_parameter.kind == SemTypeKind.String)
                return public_rank > 0.usize() if first_parameter.kind == SemTypeKind.Named and pma_generic_parameter_identity(annotations, first_parameter.name, symbol)
                # An exact concrete match can tie another concrete overload, so it must
                # remain visible to the privacy check. Other conversions are unmodeled.
                return false

        # Suppress a spelling-based private-call report only when every exact private
        # overload is ineligible by Core's coarse fixed-arity filter, mismatches a known
        # bool-vs-primitive pair, or is a generic receiver outranked by an exact public type.
        # Unknown conversions and concrete ties preserve the privacy diagnostic.
        def pma_private_call_overloads_excluded(file: Ast::File&, index: PrivateMemberIndex&, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, member: sview, current_module: sview, unqualified_call: bool, arguments: darray[Ast::Expr], argument_names: darray[sview @source], bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> bool:
            can Abort.Panic:
                return false if any argument_name in argument_names where argument_name != ""
                public_rank: (found: bool, rank: usize) = pma_public_call_sibling_rank(file, index, table, annotations, owner, member, current_module, unqualified_call, arguments, bound, bound_types)
                return false if not public_rank.found
                actual_type: sview @source = pma_argument_type_name(arguments[0], bound, bound_types) if arguments.count > 0.usize() else ""
                return false if actual_type == ""
                private_candidates: mutable usize = 0.usize()
                all_excluded: mutable bool = true
                for symbol in table.symbols |private_candidates, all_excluded, index, table, annotations, owner, member, arguments, actual_type, public_rank|:
                    continue if symbol.kind != SymbolKind.Func or symbol.name != member or symbol.module_owner != owner or not pma_symbol_has_private_marker(index, symbol)
                    private_candidates <- private_candidates + 1.usize()
                    candidate_excluded: bool = not pma_symbol_core_accepts_receiver_arity(symbol, arguments.count) or pma_private_candidate_excluded_by_public_rank(table, annotations, symbol, public_rank.rank, actual_type)
                    all_excluded <- false if not candidate_excluded
                return private_candidates > 0.usize() and all_excluded

        # Whether the `::`-joined module path `owner` is spelled by the Ident/Scope chain in
        # `base`, matching right to left so no joined path has to be BUILT: a synthesized
        # sview would have to live in a side buffer, and a Diagnostic may only carry views
        # into the source. `end` is the exclusive end of the not-yet-matched prefix.
        def pma_chain_ends_at(base: Ast::Expr, owner: sview, end: usize) -> bool:
            can Abort.Panic:
                return match base:
                    Expr.Ident(head_name, _):
                        end == head_name.len and sview_slice_equals(owner, 0, head_name)
                    Expr.Scope(inner, last_name, _):
                        pma_chain_prefix_ends_at(inner, owner, end, last_name)
                    _:
                        false

        def pma_chain_prefix_ends_at(inner: Ast::Expr, owner: sview, end: usize, last_name: sview) -> bool:
            can Abort.Panic:
                last_length: usize = last_name.len
                return false if end < last_length + 2.usize()
                start: usize = end - last_length
                return false if:
                    not sview_slice_equals(owner, start, last_name)
                    owner[start - 1.usize()] != 58 or owner[start - 2.usize()] != 58
                return pma_chain_ends_at(inner, owner, start - 2.usize())

        def pma_using_alias_target(annotations: darray[Ast::EnumAnnotation]&, alias: Ast::EnumAnnotation) -> sview:
            can Abort.Panic:
                selected_target: mutable sview = ""
                target_count: mutable usize = 0
                for target_row in annotations |selected_target, target_count, alias|:
                    if target_row.name == "__using_alias_target" and target_row.module == alias.module and target_row.line == alias.line and target_row.offset == alias.offset:
                        target_count <- target_count + 1.usize()
                        selected_target <- target_row.owner
                return selected_target if target_count == 1.usize()
                return ""

        # Module aliases use the analyzer-wide registration order. Unknown pairs stay
        # explicit so privacy checks can decline to claim a definite owner.
        def pma_using_alias_precedes(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, precedes: bool):
            can Abort.Panic:
                return semantic_possible_import_alias_precedes(left, right, table)

        # An alias can establish a private owner only when it is the winning,
        # definitely-selected analyzer-wide alias. An unresolved branch alias
        # may be public or private, so it must not cause a definite privacy diagnostic.
        def pma_using_alias_is_shadowed(annotations: darray[Ast::EnumAnnotation]&, file: Ast::File&, table: SymbolTable&, alias: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                for earlier_alias in annotations |file, table, alias|:
                    continue if earlier_alias.name != "__using_alias" or earlier_alias.owner != alias.owner or earlier_alias.module == alias.module and earlier_alias.line == alias.line and earlier_alias.offset == alias.offset
                    earlier_branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(earlier_alias, annotations, file, table)
                    continue if earlier_branch.known and not earlier_branch.active
                    order: (known: bool, precedes: bool) = pma_using_alias_precedes(earlier_alias, alias, table)
                    return true if not order.known
                    return true if order.precedes and (not earlier_branch.known or earlier_branch.active)
                return false

        # Resolve alias heads recursively while preserving any literal suffix. Require a
        # known exact owner so a possible alias cannot create a definite privacy report.
        def pma_alias_target_matches_owner(annotations: darray[Ast::EnumAnnotation]&, candidate_owner: sview, alias: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                target: sview = pma_using_alias_target(annotations, alias)
                return false if target == ""
                target_prefix: (known: bool, matches: bool, end: usize) = semantic_possible_import_alias_target_prefix(candidate_owner, target, alias.module, alias.offset, table)
                return target_prefix.known and target_prefix.matches and target_prefix.end == candidate_owner.len

        def pma_alias_chain_ends_at(base: Ast::Expr, owner: sview, end: usize, alias: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return match base:
                    Expr.Ident(head_name, _):
                        return false if head_name != alias.owner or end > owner.len
                        candidate_owner: sview = string_view_slice(owner, 0, end.i64())
                        pma_alias_target_matches_owner(annotations, candidate_owner, alias, table)
                    Expr.Scope(inner, last_name, _):
                        pma_alias_chain_prefix_ends_at(inner, owner, end, last_name, alias, annotations, table)
                    _:
                        false

        def pma_alias_chain_prefix_ends_at(inner: Ast::Expr, owner: sview, end: usize, last_name: sview, alias: Ast::EnumAnnotation, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                last_length: usize = last_name.len
                return false if end < last_length + 2.usize()
                start: usize = end - last_length
                return false if:
                    not sview_slice_equals(owner, start, last_name)
                    owner[start - 1.usize()] != 58 or owner[start - 2.usize()] != 58
                return pma_alias_chain_ends_at(inner, owner, start - 2.usize(), alias, annotations, table)

        def pma_chain_head_name(base: Ast::Expr) -> sview:
            can Abort.Panic:
                return match base:
                    Expr.Ident(head_name, _): head_name
                    Expr.Scope(inner, _, _): pma_chain_head_name(inner)
                    Expr.Paren(inner, _): pma_chain_head_name(inner)
                    _: ""

        # The module that hides `member` when `base` spells that module's path, or "" when
        # this access is not a private one. The owner comes OUT of the recorded row rather
        # than being assembled from the chain, which is what lets a nested owner
        # (`Geo::Scalar`) be compared without materialising it.
        def pma_scope_owner(file: Ast::File&, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, current_module: sview, table: SymbolTable&, base: Ast::Expr, member: sview) -> sview @source:
            can Abort.Panic:
                private_index: mutable u32 = pma_member_head(index, member)
                alias_name: sview = pma_chain_head_name(base)
                while private_index != SYMBOL_INDEX_ROW_NONE |private_index, file, index, annotations, current_module, table, base, member, alias_name|:
                    candidate: sview @source = index.modules[private_index.usize()]
                    if index.names[private_index.usize()] == member:
                        return candidate if pma_chain_ends_at(base, candidate, candidate.len)
                        for alias in annotations |file, index, annotations, current_module, table, base, member, candidate, alias_name|:
                            continue if alias.name != "__using_alias" or alias.owner != alias_name
                            branch: (known: bool, active: bool) = pma_import_annotation_branch_selection(alias, annotations, file, table)
                            continue if not branch.known or not branch.active
                            continue if pma_using_alias_is_shadowed(annotations, file, table, alias)
                            return candidate if pma_alias_chain_ends_at(base, candidate, candidate.len, alias, annotations, table)
                    private_index <- index.name_next[private_index.usize()]
                return ""

        # The leftmost segment of a scope chain: stage0 reports a privacy error AT the head
        # of the path (`Geo` in `Geo::Scalar::hidden`), not at the member.
        def pma_chain_head_pos(base: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                return match base:
                    Expr.Scope(inner, _, _):
                        pma_chain_head_pos(inner)
                    _:
                        Ast::expr_pos(base)

        def pma_call_target_identity(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, bound: darray[sview @source]&) -> (member: sview @source, owner: sview @source):
            can Abort.Panic:
                return match expression:
                    Expr.Ident(member, _):
                        (member, pma_unqualified_call_owner(table, current_module, index, annotations, bound, member))
                    Expr.Scope(base, member, _):
                        (member, pma_scope_owner(file, index, annotations, current_module, table, base, member))
                    Expr.Paren(inner, _):
                        pma_call_target_identity(file, inner, current_module, index, annotations, table, bound)
                    _:
                        ("", "")

        def pma_is_private_function_target(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, bound: darray[sview @source]&) -> bool:
            can Abort.Panic:
                identity: (member: sview @source, owner: sview @source) = pma_call_target_identity(file, expression, current_module, index, annotations, table, bound)
                return false if identity.member == "" or identity.owner == ""
                return any symbol in table.symbols where symbol.kind == SymbolKind.Func and symbol.name == identity.member and symbol.module_owner == identity.owner and pma_symbol_has_private_marker(index, symbol)

        # `f[T](...)` and `f[T, U](...)` arrive as Index / IndexN callees, while
        # `(f)(...)` arrives as Paren. Normalize only a declaration-backed private
        # function target; ordinary subscripts and function-value expressions keep the
        # existing recursive expression walk below.
        def pma_normalize_call_callee(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, bound: darray[sview @source]&) -> Ast::Expr:
            can Abort.Panic:
                return match expression:
                    Expr.Paren(inner, _):
                        pma_normalize_call_callee(file, inner, current_module, index, annotations, table, bound)
                    Expr.Index(object, _, _) if pma_is_private_function_target(file, object, current_module, index, annotations, table, bound):
                        pma_normalize_call_callee(file, object, current_module, index, annotations, table, bound)
                    Expr.IndexN(object, _, _) if pma_is_private_function_target(file, object, current_module, index, annotations, table, bound):
                        pma_normalize_call_callee(file, object, current_module, index, annotations, table, bound)
                    _:
                        expression

        # Once a generic callee has been normalized, still visit its type/index arguments
        # so private type names inside `f[Hidden]` retain their own diagnostics.
        def pma_report_call_callee_indices(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, _):
                        table <- pma_report_call_callee_indices(file, inner, current_module, index, annotations, table, bound, bound_types)
                    Expr.Index(object, argument, _):
                        table <- pma_report_call_callee_indices(file, object, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report(file, argument, current_module, index, annotations, table, bound, bound_types)
                    Expr.IndexN(object, arguments, _):
                        table <- pma_report_call_callee_indices(file, object, current_module, index, annotations, table, bound, bound_types)
                        for argument in arguments |table| -> table:
                            table <- pma_report(file, argument, current_module, index, annotations, table, bound, bound_types)
                    _:
                        pass

        def pma_report(file: Ast::File&, expression: Ast::Expr, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: darray[sview @source]&, bound_types: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(member, ident_line):
                        owner: sview @source = pma_unqualified_owner(table, current_module, index, annotations, bound, member)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, pos: ident_line, line: ident_line.line, expected: "", actual: owner}) if owner != ""
                    Expr.Scope(base, member, scope_line):
                        # The path is checked OUTSIDE-IN: a private module closes the door on
                        # everything behind it, however public the member itself is, and stage0
                        # names that module rather than the member. Reporting both would be two
                        # errors for one closed door, so the leaf is only judged once the whole
                        # base path came back clean.
                        reported_before: usize = table.diagnostics.count
                        table <- pma_report(file, base, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report_scope_member(file, base, member, scope_line, current_module, index, annotations, table) if table.diagnostics.count == reported_before
                    Expr.Construct(type_expression, fields, _):
                        table <- pma_report(file, type_expression, current_module, index, annotations, table, bound, bound_types)
                        for field in fields |table|:
                            table <- pma_report(file, field.value, current_module, index, annotations, table, bound, bound_types)
                    Expr.Block(statements, value, _, _):
                        block_bound: mutable darray[sview @source] = []
                        block_bound.extend(bound)
                        block_bound_types: mutable darray[sview @source] = []
                        block_bound_types.extend(bound_types)
                        table <- pma_walk_stmts(statements, file, current_module, index, annotations, table, block_bound, block_bound_types)
                        table <- pma_report(file, value, current_module, index, annotations, table, block_bound, block_bound_types)
                    Expr.Field(object, field, field_line):
                        table <- pma_report(file, object, current_module, index, annotations, table, bound, bound_types)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        normalized_callee: Ast::Expr = pma_normalize_call_callee(file, callee, current_module, index, annotations, table, bound)
                        normalized_callee_is_path: mutable bool = false
                        match normalized_callee:
                            Expr.Ident(callee_name, callee_line):
                                normalized_callee_is_path <- true
                                owner: sview @source = pma_unqualified_call_owner(table, current_module, index, annotations, bound, callee_name)
                                private_candidates_excluded: mutable bool = false
                                if owner != "":
                                    private_candidates_excluded <- pma_private_call_overloads_excluded(file, index, table, annotations, owner, callee_name, current_module, true, arguments, argument_names, bound, bound_types)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: callee_name, pos: callee_line, line: callee_line.line, expected: "", actual: owner}) if owner != "" and not private_candidates_excluded
                            Expr.Scope(base, callee_name, callee_line):
                                normalized_callee_is_path <- true
                                reported_before: usize = table.diagnostics.count
                                table <- pma_report(file, base, current_module, index, annotations, table, bound, bound_types)
                                if table.diagnostics.count == reported_before:
                                    owner: sview @source = pma_scope_owner(file, index, annotations, current_module, table, base, callee_name)
                                    private_candidates_excluded: mutable bool = false
                                    if owner != "":
                                        private_candidates_excluded <- pma_private_call_overloads_excluded(file, index, table, annotations, owner, callee_name, current_module, false, arguments, argument_names, bound, bound_types)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: callee_name, pos: pma_chain_head_pos(base), line: callee_line.line, expected: "", actual: owner}) if owner != "" and not pma_within_module(current_module, owner) and not private_candidates_excluded
                            _:
                                table <- pma_report(file, callee, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report_call_callee_indices(file, callee, current_module, index, annotations, table, bound, bound_types) if normalized_callee_is_path
                        for argument in arguments |table| -> table:
                            table <- pma_report(file, argument, current_module, index, annotations, table, bound, bound_types)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- pma_report(file, left, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report(file, right, current_module, index, annotations, table, bound, bound_types)
                    Expr.Unary(operator, operand, unary_line):
                        table <- pma_report(file, operand, current_module, index, annotations, table, bound, bound_types)
                    Expr.Paren(inner, paren_line):
                        table <- pma_report(file, inner, current_module, index, annotations, table, bound, bound_types)
                    Expr.Index(object, index_argument, index_line):
                        table <- pma_report(file, object, current_module, index, annotations, table, bound, bound_types)
                        table <- pma_report(file, index_argument, current_module, index, annotations, table, bound, bound_types)
                    _:
                        pass

        def pma_report_scope_member(file: Ast::File&, base: Ast::Expr, member: sview @source, scope_line: Ast::Pos, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owner: sview @source = pma_scope_owner(file, index, annotations, current_module, table, base, member)
                return if owner == "" or pma_within_module(current_module, owner)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, pos: pma_chain_head_pos(base), line: scope_line.line, expected: "", actual: owner})

        def pma_walk_stmts(statements: darray[Ast::Stmt], file: Ast::File&, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: mutable darray[sview @source]&, bound_types: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, bound, bound_types| -> table, bound, bound_types:
                    match statement:
                        Stmt.Return(value, line):
                            table <- pma_report(file, returned, current_module, index, annotations, table, bound, bound_types) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pma_report(file, type_expression, current_module, index, annotations, table, bound, bound_types)
                            table <- pma_report(file, value, current_module, index, annotations, table, bound, bound_types)
                            if name != "":
                                bound.push(name)
                                bound_types.push(bare_type_name(type_expression))
                        Stmt.Assign(target, operator, value, line):
                            table <- pma_report(file, target, current_module, index, annotations, table, bound, bound_types)
                            table <- pma_report(file, value, current_module, index, annotations, table, bound, bound_types)
                        Stmt.Expr(expression, line):
                            table <- pma_report(file, expression, current_module, index, annotations, table, bound, bound_types)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pma_report(file, condition, current_module, index, annotations, table, bound, bound_types)
                            then_bound: mutable darray[sview @source] = []
                            then_bound.extend(bound)
                            then_bound_types: mutable darray[sview @source] = []
                            then_bound_types.extend(bound_types)
                            else_bound: mutable darray[sview @source] = []
                            else_bound.extend(bound)
                            else_bound_types: mutable darray[sview @source] = []
                            else_bound_types.extend(bound_types)
                            table <- pma_walk_stmts(then_body, file, current_module, index, annotations, table, then_bound, then_bound_types)
                            table <- pma_walk_stmts(else_body, file, current_module, index, annotations, table, else_bound, else_bound_types)
                        Stmt.While(condition, while_body, while_line):
                            table <- pma_report(file, condition, current_module, index, annotations, table, bound, bound_types)
                            while_bound: mutable darray[sview @source] = []
                            while_bound.extend(bound)
                            while_bound_types: mutable darray[sview @source] = []
                            while_bound_types.extend(bound_types)
                            table <- pma_walk_stmts(while_body, file, current_module, index, annotations, table, while_bound, while_bound_types)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- pma_report(file, iterable, current_module, index, annotations, table, bound, bound_types)
                            for_bound: mutable darray[sview @source] = []
                            for_bound.extend(bound)
                            for_bound_types: mutable darray[sview @source] = []
                            for_bound_types.extend(bound_types)
                            for variable in variables:
                                for_bound.push(variable)
                                for_bound_types.push("")
                            table <- pma_walk_stmts(for_body, file, current_module, index, annotations, table, for_bound, for_bound_types)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            if kind == "static":
                                branch_row: usize = pma_static_if_row_for_position(file, block_line)
                                if branch_row < file.static_if_lines.count:
                                    branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                                    continue if branch.known and not branch.selected
                            block_bound: mutable darray[sview @source] = []
                            block_bound.extend(bound)
                            block_bound_types: mutable darray[sview @source] = []
                            block_bound_types.extend(bound_types)
                            if binding != "":
                                block_bound.push(binding)
                                block_bound_types.push("")
                            table <- pma_walk_stmts(body, file, current_module, index, annotations, table, block_bound, block_bound_types)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- pma_report(file, scrutinee, current_module, index, annotations, table, bound, bound_types)
                            for arm in arms |table| -> table:
                                arm_bound: mutable darray[sview @source] = []
                                arm_bound.extend(bound)
                                arm_bound_types: mutable darray[sview @source] = []
                                arm_bound_types.extend(bound_types)
                                table <- pma_walk_stmts(arm.body, file, current_module, index, annotations, table, arm_bound, arm_bound_types)
                        _:
                            pass

        def pma_walk_declarations(declarations: darray[Ast::Decl], file: Ast::File&, current_module: sview, index: PrivateMemberIndex&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            function_bound: mutable darray[sview @source] = []
                            function_bound_types: mutable darray[sview @source] = []
                            for parameter in parameters |table|:
                                table <- pma_report(file, parameter.type_expression, current_module, index, annotations, table, function_bound, function_bound_types)
                                function_bound.push(parameter.name)
                                function_bound_types.push(bare_type_name(parameter.type_expression))
                            table <- pma_report(file, result_type, current_module, index, annotations, table, function_bound, function_bound_types) if return_type is result_type
                            table <- pma_walk_stmts(body, file, current_module, index, annotations, table, function_bound, function_bound_types)
                        Decl.Module(module_name, module_body, module_line):
                            table <- pma_walk_declarations(module_body, file, module_name, index, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            branch_row: usize = pma_static_if_row_for_position(file, scoped_line)
                            if branch_row < file.static_if_lines.count:
                                branch: (known: bool, selected: bool) = pma_static_if_row_selection(file, branch_row, current_module, table)
                                continue if branch.known and not branch.selected
                            table <- pma_walk_declarations(scoped_body, file, current_module, index, annotations, table)
                        _:
                            pass

    public:
        def check_private_member_access(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                annotations: darray[Ast::EnumAnnotation] = pma_active_import_annotations(file, table)
                has_private: bool = any annotation in annotations where annotation.owner == "__private_member"
                private_index: mutable PrivateMemberIndex = PrivateMemberIndex{names: [], modules: [], declaration_offsets: [], name_heads: {}, name_next: [], import_heads: {}, import_owners: [], import_members: [], import_next: []}
                pma_build_index(annotations, private_index) can Global{Read,Write} if has_private
                pma_build_selective_import_index(annotations, private_index) can Global{Read,Write} if has_private
                table <- pma_walk_declarations(file.top_decls, file, "", private_index, annotations, table) if has_private
