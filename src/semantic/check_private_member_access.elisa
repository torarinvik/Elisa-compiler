# Private module-member access. A member declared inside a module's `private:` section may
# only be referenced from within that module. A qualified access `Module::member` from
# OUTSIDE the module is rejected:
#
#   module Bar:
#       private:
#           def hidden() -> i32: ...
#       def open() -> i32: return hidden() * 2     # inside Bar — fine
#   def outside() -> i32:
#       return Bar::hidden()                       # outside Bar — error
#
# The parser records each private member name on the __private_member side-table; the
# member's owning module comes from module_member_owner/name (symbol table). An access
# `Module::member` fires when member is private, belongs to Module, and the enclosing
# declaration is not that module.
extend Semantic:
    private:
        # Whether `module_name` declares `member` in a `private:` section. Each
        # `__private_member` entry is followed by a `__private_member_module` entry
        # naming its module, so the same member name in another module is unaffected.
        def pma_is_private(annotations: darray[Ast::EnumAnnotation]&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                for index in 0..<annotations.count:
                    continue if annotations[index].owner != "__private_member" or annotations[index].name != member
                    continue if index + 1 >= annotations.count
                    true return if annotations[index + 1].owner == "__private_member_module" and annotations[index + 1].name == module_name
                return false

        # Whether `candidate` is exactly `owner` + `::` + `member`. A NESTED module is
        # recorded under its qualified name, so `Outer::Hidden` is how the symbol table
        # spells the module that the source calls `Hidden` inside `Outer`.
        def pma_qualified_tail_is(candidate: sview, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                owner_length: usize = sview_len(owner)
                false return if sview_len(candidate) != owner_length + 2.usize() + sview_len(member)
                false return if not sview_slice_equals(candidate, 0, owner)
                false return if sview_at(candidate, owner_length) != 58 or sview_at(candidate, owner_length + 1.usize()) != 58
                return sview_slice_equals(candidate, owner_length + 2.usize(), member)

        def pma_module_owns(table: SymbolTable&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = member_chain_head(table, member)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, module_name, member|:
                    index: usize = row.usize()
                    if table.module_member_owner[index] == module_name:
                        true return if table.module_member_name[index] == member
                        true return if pma_qualified_tail_is(table.module_member_name[index], module_name, member)
                    row <- table.member_name_next[index]
                return false

        # A file-level declaration shadows an imported module member with the same bare
        # spelling. The flat symbol index also contains module members, so an arbitrary
        # non-module symbol is not enough to establish file-level ownership. An excess value
        # symbol beyond this name's recorded module-member rows is the top-level declaration.
        # This matters for the runtime, which intentionally provides a top-level
        # `sview_starts_with` while the compiler's `Semantic` module has an unrelated private
        # helper of the same name.
        def pma_has_global_value(table: SymbolTable&, member: sview) -> bool:
            can Abort.Panic:
                symbol_count: mutable usize = 0
                symbol_row: mutable u32 = symbol_chain_head(table, member)
                while symbol_row != SYMBOL_INDEX_ROW_NONE |symbol_row, table, member, symbol_count|:
                    symbol: Symbol = table.symbols[symbol_row.usize()]
                    symbol_count <- symbol_count + 1 if symbol.name == member and symbol.kind != SymbolKind.Module
                    symbol_row <- table.symbol_name_next[symbol_row.usize()]
                member_count: mutable usize = 0
                member_row: mutable u32 = member_chain_head(table, member)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_row, table, member, member_count|:
                    member_count <- member_count + 1 if table.module_member_name[member_row.usize()] == member
                    member_row <- table.member_name_next[member_row.usize()]
                return symbol_count > member_count

        # A selective `from Mod import member` carries the source module in a line-paired
        # `__from_src` annotation. `table.imported_members` intentionally keeps only the
        # spelling for ordinary name resolution, but using that spelling alone here would
        # conflate `from B import hidden` with a private `hidden` in an unrelated module A.
        def pma_selective_imports(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, member: sview) -> bool:
            can Abort.Panic:
                for member_row in annotations:
                    continue if member_row.owner != "__from_member" or member_row.name != member
                    for source_row in annotations:
                        true return if source_row.owner == "__from_src" and source_row.line == member_row.line and source_row.name == owner
                return false

        # Is the accessing module INSIDE the owner's privacy boundary? A nested module is:
        # `module A::Paint` may call `A::helper` even when `helper` is private to `A`, which is
        # what stage0 allows. This was a plain `!=` on the module names, so every child module
        # counted as outside its own parent and internal helpers had to be made public to be
        # callable from a submodule of the module that declared them.
        def pma_prefix_matches(text: sview, prefix: sview) -> bool:
            can Abort.Panic:
                prefix_length: usize = sview_len(prefix)
                false return if sview_len(text) < prefix_length
                while index < prefix_length |index: usize = 0|:
                    false return if sview_at(text, index) != sview_at(prefix, index)
                    index <- index + 1.usize()
                return true

        def pma_within_module(current_module: sview, owner: sview) -> bool:
            can Abort.Panic:
                true return if current_module == owner
                prefix_length: usize = sview_len(owner)
                false return if prefix_length == 0 or sview_len(current_module) <= prefix_length + 2.usize()
                false return if not pma_prefix_matches(current_module, owner)
                return sview_at(current_module, prefix_length) == 58 and sview_at(current_module, prefix_length + 1.usize()) == 58

        # Return the owning module when an unqualified name resolves to a private
        # member imported into the current file. Qualified access was the original
        # check, but `using M` makes `M::hidden` and `hidden` the same visibility
        # boundary. Keep the caller's lexical bindings in the query so a parameter
        # or local that shadows a private imported member is not misdiagnosed.
        def pma_unqualified_owner(table: SymbolTable&, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, bound: darray[sview]&, member: sview) -> sview:
            can Abort.Panic:
                return "" if any bound_name in bound where bound_name == member
                return "" if pma_has_global_value(table, member)
                row: mutable u32 = member_chain_head(table, member)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, current_module, annotations, member|:
                    index: usize = row.usize()
                    if table.module_member_name[index] == member:
                        owner: sview = table.module_member_owner[index]
                        if not pma_within_module(current_module, owner):
                            imported: mutable bool = any imported_module in table.imported_modules where imported_module == owner
                            imported <- true if pma_selective_imports(table, annotations, owner, member)
                            return owner if imported and pma_is_private(annotations, owner, member) and pma_module_owns(table, owner, member)
                    row <- table.member_name_next[index]
                return ""

        # Whether the `::`-joined module path `owner` is spelled by the Ident/Scope chain in
        # `base`, matching right to left so no joined path has to be BUILT: a synthesized
        # sview would have to live in a side buffer, and a Diagnostic may only carry views
        # into the source. `end` is the exclusive end of the not-yet-matched prefix.
        def pma_chain_ends_at(base: Ast::Expr, owner: sview, end: usize) -> bool:
            can Abort.Panic:
                return match base:
                    Expr.Ident(head_name, _):
                        end == sview_len(head_name) and sview_slice_equals(owner, 0, head_name)
                    Expr.Scope(inner, last_name, _):
                        pma_chain_prefix_ends_at(inner, owner, end, last_name)
                    _:
                        false

        def pma_chain_prefix_ends_at(inner: Ast::Expr, owner: sview, end: usize, last_name: sview) -> bool:
            can Abort.Panic:
                last_length: usize = sview_len(last_name)
                false return if end < last_length + 2.usize()
                start: usize = end - last_length
                false return if not sview_slice_equals(owner, start, last_name)
                false return if sview_at(owner, start - 1.usize()) != 58 or sview_at(owner, start - 2.usize()) != 58
                return pma_chain_ends_at(inner, owner, start - 2.usize())

        # The module that hides `member` when `base` spells that module's path, or "" when
        # this access is not a private one. The owner comes OUT of the recorded row rather
        # than being assembled from the chain, which is what lets a nested owner
        # (`Geo::Scalar`) be compared without materialising it.
        def pma_scope_owner(annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, base: Ast::Expr, member: sview) -> sview:
            can Abort.Panic:
                for index in 0..<annotations.count:
                    continue if annotations[index].owner != "__private_member" or annotations[index].name != member
                    continue if index + 1 >= annotations.count or annotations[index + 1].owner != "__private_member_module"
                    candidate: sview = annotations[index + 1].name
                    continue if not pma_chain_ends_at(base, candidate, sview_len(candidate))
                    continue if not pma_module_owns(table, candidate, member)
                    return candidate
                return ""

        # The leftmost segment of a scope chain: stage0 reports a privacy error AT the head
        # of the path (`Geo` in `Geo::Scalar::hidden`), not at the member.
        def pma_chain_head_pos(base: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                return match base:
                    Expr.Scope(inner, _, _):
                        pma_chain_head_pos(inner)
                    _:
                        Ast::expr_pos(base)

        def pma_report(expression: Ast::Expr, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(member, ident_line):
                        owner: sview = pma_unqualified_owner(table, current_module, annotations, bound, member)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, pos: ident_line, line: ident_line.line, expected: "", actual: owner}) if owner != ""
                    Expr.Scope(base, member, scope_line):
                        # The path is checked OUTSIDE-IN: a private module closes the door on
                        # everything behind it, however public the member itself is, and stage0
                        # names that module rather than the member. Reporting both would be two
                        # errors for one closed door, so the leaf is only judged once the whole
                        # base path came back clean.
                        reported_before: usize = table.diagnostics.count
                        table <- pma_report(base, current_module, annotations, table, bound)
                        table <- pma_report_scope_member(base, member, scope_line, current_module, annotations, table) if table.diagnostics.count == reported_before
                    Expr.Construct(type_expression, fields, _):
                        table <- pma_report(type_expression, current_module, annotations, table, bound)
                        for field in fields |table|:
                            table <- pma_report(field.value, current_module, annotations, table, bound)
                    Expr.Block(statements, value, _, _):
                        block_bound: mutable darray[sview] = []
                        block_bound.extend(bound)
                        table <- pma_walk_stmts(statements, current_module, annotations, table, block_bound)
                        table <- pma_report(value, current_module, annotations, table, block_bound)
                    Expr.Field(object, field, field_line):
                        table <- pma_report(object, current_module, annotations, table, bound)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- pma_report(callee, current_module, annotations, table, bound)
                        for argument in arguments |table| -> table:
                            table <- pma_report(argument, current_module, annotations, table, bound)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- pma_report(left, current_module, annotations, table, bound)
                        table <- pma_report(right, current_module, annotations, table, bound)
                    Expr.Unary(operator, operand, unary_line):
                        table <- pma_report(operand, current_module, annotations, table, bound)
                    Expr.Paren(inner, paren_line):
                        table <- pma_report(inner, current_module, annotations, table, bound)
                    Expr.Index(object, index_argument, index_line):
                        table <- pma_report(object, current_module, annotations, table, bound)
                        table <- pma_report(index_argument, current_module, annotations, table, bound)
                    _:
                        pass

        def pma_report_scope_member(base: Ast::Expr, member: sview, scope_line: Ast::Pos, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                owner: sview = pma_scope_owner(annotations, table, base, member)
                return if owner == "" or pma_within_module(current_module, owner)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, pos: pma_chain_head_pos(base), line: scope_line.line, expected: "", actual: owner})

        def pma_walk_stmts(statements: darray[Ast::Stmt], current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, bound| -> table, bound:
                    match statement:
                        Stmt.Return(value, line):
                            table <- pma_report(returned, current_module, annotations, table, bound) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pma_report(type_expression, current_module, annotations, table, bound)
                            table <- pma_report(value, current_module, annotations, table, bound)
                            bound.push(name) if name != ""
                        Stmt.Assign(target, operator, value, line):
                            table <- pma_report(target, current_module, annotations, table, bound)
                            table <- pma_report(value, current_module, annotations, table, bound)
                        Stmt.Expr(expression, line):
                            table <- pma_report(expression, current_module, annotations, table, bound)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pma_report(condition, current_module, annotations, table, bound)
                            then_bound: mutable darray[sview] = []
                            then_bound.extend(bound)
                            else_bound: mutable darray[sview] = []
                            else_bound.extend(bound)
                            table <- pma_walk_stmts(then_body, current_module, annotations, table, then_bound)
                            table <- pma_walk_stmts(else_body, current_module, annotations, table, else_bound)
                        Stmt.While(condition, while_body, while_line):
                            table <- pma_report(condition, current_module, annotations, table, bound)
                            while_bound: mutable darray[sview] = []
                            while_bound.extend(bound)
                            table <- pma_walk_stmts(while_body, current_module, annotations, table, while_bound)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- pma_report(iterable, current_module, annotations, table, bound)
                            for_bound: mutable darray[sview] = []
                            for_bound.extend(bound)
                            for variable in variables:
                                for_bound.push(variable)
                            table <- pma_walk_stmts(for_body, current_module, annotations, table, for_bound)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            block_bound: mutable darray[sview] = []
                            block_bound.extend(bound)
                            block_bound.push(binding) if binding != ""
                            table <- pma_walk_stmts(body, current_module, annotations, table, block_bound)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- pma_report(scrutinee, current_module, annotations, table, bound)
                            for arm in arms |table| -> table:
                                arm_bound: mutable darray[sview] = []
                                arm_bound.extend(bound)
                                table <- pma_walk_stmts(arm.body, current_module, annotations, table, arm_bound)
                        _:
                            pass

        def pma_walk_declarations(declarations: darray[Ast::Decl], current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            function_bound: mutable darray[sview] = []
                            for parameter in parameters |table|:
                                table <- pma_report(parameter.type_expression, current_module, annotations, table, function_bound)
                                function_bound.push(parameter.name)
                            table <- pma_report(result_type, current_module, annotations, table, function_bound) if return_type is result_type
                            table <- pma_walk_stmts(body, current_module, annotations, table, function_bound)
                        Decl.Module(module_name, module_body, module_line):
                            table <- pma_walk_declarations(module_body, module_name, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- pma_walk_declarations(scoped_body, current_module, annotations, table)
                        _:
                            pass

    public:
        def check_private_member_access(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                has_private: bool = any annotation in file.enum_annotations where annotation.owner == "__private_member"
                table <- pma_walk_declarations(file.top_decls, "", file.enum_annotations, table) if has_private
