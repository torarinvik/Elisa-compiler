# A `mutable T[State]&` typestate parameter that is handed to a call whose matching
# parameter is itself a MUTABLE reference may have its state widened by that callee. Unless
# the function declares the transition (`ensures p => <state>`), the resource is not handed
# back in its lent state — stage0 errors ("its state was widened by a call").
#
# SOUND SUBSET: fire only for a call to an EXTERN (opaque, so it always widens) whose param
# at the argument position is a mutable ref (`mutable q: U&` / `lmut`) and which declares NO
# `ensures q => <state>` of its own. A plain const-ref extern param cannot widen, and a
# callee with its own state postcondition is trusted — both stay silent. Non-extern callees
# are left to the full typestate flow (stage0's job).
extend Semantic:
    private:
        # The typestate struct a parameter's type names (`Player[Alive]` -> "Player"), when
        # `Player` is one of the collected `state`-parameterized structs; "" otherwise.
        # Looks through `&` / `mutable` / paren wrappers.
        def bracketed_typestate_name(type_expression: Ast::Expr, typestate_structs: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, line):
                        head: sview = ident_name_of(object)
                        return head if (any s in typestate_structs where s == head) else sview("", 0, 0)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        return head_n if (any s in typestate_structs where s == head_n) else sview("", 0, 0)
                    Expr.Unary(operator, operand, line):
                        return bracketed_typestate_name(operand, typestate_structs)
                    Expr.Paren(inner, line):
                        return bracketed_typestate_name(inner, typestate_structs)
                    _:
                        return sview("", 0, 0)

        # Whether some `ensures FUNCTION.PARAM => state` postcondition exists.
        def fn_has_typestate_ensures(postconditions: darray[Ast::TypestatePostcondition]&, function_name: sview, parameter_name: sview) -> bool:
            can Abort.Panic:
                return any pc in postconditions where pc.function_name == function_name and pc.parameter_name == parameter_name

        # The declared `ensures FUNCTION.PARAM => STATE` target state, or "".
        def fn_typestate_ensured_state(postconditions: darray[Ast::TypestatePostcondition]&, function_name: sview, parameter_name: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                for pc in postconditions:
                    pc.state return if pc.function_name == function_name and pc.parameter_name == parameter_name
                return sview("", 0, 0)

        # Whether an extern declares a `=> state` postcondition for the param at POSITION.
        def extern_has_postcondition_at(postconditions: darray[Ast::TypestatePostcondition]&, extern_name: sview, position: u32) -> bool:
            can Abort.Panic:
                return any pc in postconditions where pc.function_name == extern_name and pc.position == position

        # Whether the extern named EXTERN_NAME has a MUTABLE-ref parameter at POSITION.
        def extern_param_mutable_at(extern_names: darray[sview]&, extern_starts: darray[usize]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, extern_name: sview, position: u32) -> bool:
            can Abort.Panic:
                probe: mutable usize = 0
                while probe < extern_names.count |probe|:
                    if extern_names[probe] == extern_name and position.usize() < extern_arities[probe].usize():
                        slot: usize = extern_starts[probe] + position.usize()
                        return extern_params[slot].mutable_ref if slot < extern_params.count else false
                    probe <- probe + 1
                return false

        # Scan an expression for an extern call widening PARAM; emit at the call line.
        def typestate_widen_scan(expression: Ast::Expr, function_name: sview, param: sview, extern_names: darray[sview]&, extern_starts: darray[usize]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, postconditions: darray[Ast::TypestatePostcondition]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        called: sview = ident_name_of(callee)
                        if called != "" and (any e in extern_names where e == called):
                            position: mutable usize = 0
                            while position < arguments.count |position, table| -> table:
                                is_param: bool = ident_name_of(arguments[position]) == param
                                pos32: u32 = position.u32()
                                widens: bool = is_param and extern_param_mutable_at(extern_names, extern_starts, extern_arities, extern_params, called, pos32) and not extern_has_postcondition_at(postconditions, called, pos32)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypestateWidenedByCall, name: param, pos: call_line, line: call_line.line, expected: function_name, actual: ""}) if widens
                                position <- position + 1
                        for argument in arguments |table| -> table:
                            table <- typestate_widen_scan(argument, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                    Expr.Binary(left, operator, right, line):
                        table <- typestate_widen_scan(left, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        table <- typestate_widen_scan(right, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                    Expr.Unary(operator, operand, line):
                        table <- typestate_widen_scan(operand, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                    Expr.Paren(inner, line):
                        table <- typestate_widen_scan(inner, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                    _:
                        pass

        def typestate_widen_statements(statements: darray[Ast::Stmt], function_name: sview, param: sview, extern_names: darray[sview]&, extern_starts: darray[usize]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, postconditions: darray[Ast::TypestatePostcondition]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- typestate_widen_scan(expression, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- typestate_widen_scan(value, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- typestate_widen_scan(value, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- typestate_widen_scan(returned, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- typestate_widen_statements(then_body, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                            table <- typestate_widen_statements(else_body, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Stmt.While(condition, body, line):
                            table <- typestate_widen_statements(body, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- typestate_widen_statements(body, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- typestate_widen_statements(body, function_name, param, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        _:
                            pass

        def typestate_widen_walk(declarations: darray[Ast::Decl], typestate_structs: darray[sview]&, extern_names: darray[sview]&, extern_starts: darray[usize]&, extern_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, postconditions: darray[Ast::TypestatePostcondition]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            for parameter in parameters |table| -> table:
                                struct_name: sview = bracketed_typestate_name(parameter.type_expression, typestate_structs)
                                continue if struct_name == ""
                                # A declared `ensures p => State` does NOT excuse the widening: an
                                # opaque extern that carries no restoring postcondition of its own
                                # leaves the state indeterminate, so the ensures itself becomes
                                # unprovable (stage0 errors either way). The extern-postcondition
                                # guard in the scan still exempts an extern that restores the state.
                                table <- typestate_widen_statements(body, function_name, parameter.name, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- typestate_widen_walk(module_body, typestate_structs, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- typestate_widen_walk(scoped_body, typestate_structs, extern_names, extern_starts, extern_arities, extern_params, postconditions, table)
                        _:
                            pass

        def collect_typestate_structs(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            out.push(name) if has_named_states
                        Decl.Module(module_name, module_body, module_line):
                            collect_typestate_structs(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_typestate_structs(scoped_body, out)
                        _:
                            pass

        def collect_extern_signatures(declarations: darray[Ast::Decl], names: mutable darray[sview]&, starts: mutable darray[usize]&, arities: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, starts, arities|:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, extern_line):
                            names.push(name)
                            starts.push(param_start.usize())
                            arities.push(arity)
                        Decl.Module(module_name, module_body, module_line):
                            collect_extern_signatures(module_body, names, starts, arities)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_extern_signatures(scoped_body, names, starts, arities)
                        _:
                            pass

        def check_typestate_call_widening(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                typestate_structs: mutable darray[sview] = []
                collect_typestate_structs(file.top_decls, typestate_structs)
                return if typestate_structs.count == 0
                extern_names: mutable darray[sview] = []
                extern_starts: mutable darray[usize] = []
                extern_arities: mutable darray[u32] = []
                collect_extern_signatures(file.top_decls, extern_names, extern_starts, extern_arities)
                return if extern_names.count == 0
                table <- typestate_widen_walk(file.top_decls, typestate_structs, extern_names, extern_starts, extern_arities, file.extern_params, file.typestate_postconditions, table)
