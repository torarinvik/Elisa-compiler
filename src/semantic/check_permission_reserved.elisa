# Reserved top permission `any`. `any` is the implicit top of the permission lattice (it subsumes
# every effect); declaring `permission any:` shadows it and is rejected. The parser records each
# `permission NAME` on the side-table (`__permission_decl`); this check flags the name "any".
#
# Also: an `alias NAME = …` (the `alias`-keyword form, an effect/permission alias with an Invalid
# target — a `type NAME = …` is a different construct and is exempt) whose NAME is a BUILTIN
# permission family (Segment/Unsafe/Memory/Abort/Sync/Atomics/Console/Blocking) shadows that family
# and is rejected.
extend Semantic:
    private:
        def pr_is_builtin_permission_family(name: sview) -> bool:
            can Abort.Panic:
                return name in {"Segment", "Unsafe", "Memory", "Abort", "Sync", "Atomics", "Console", "Blocking"}

        def pr_check_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Alias(alias_name, target, alias_line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AliasPermissionFamilyConflict, name: alias_name, line: alias_line.line, expected: "", actual: ""}) if target is Ast::Expr.Invalid and pr_is_builtin_permission_family(alias_name)
                        Decl.Module(module_name, module_body, module_line):
                            table <- pr_check_declarations(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- pr_check_declarations(scoped_body, table)
                        _:
                            pass

        def check_permission_reserved(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |table| -> table:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PermissionReservedName, name: annotation.name, line: annotation.line, expected: "", actual: ""}) if annotation.owner == "__permission_decl" and annotation.name == "any"
