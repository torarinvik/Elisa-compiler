# docs/119 §3: an accumulator loop is an EXPRESSION. `for … |valid: bool = true| -> valid:`
# evaluates to its final accumulator, and a header accumulator is declared INSIDE the loop's
# block — so when the loop is written as a statement with more statements after it, its value
# is thrown away and nothing else holds it. elisa-engine shipped 16 validators of the shape
#
#     for i in 0..<3 |valid: bool = true| -> valid:
#         valid <- false if values[i] <= 0
#     true
#
# which always passed (elisa-engine 4c81848). This is an error, not a lint, because the
# program is well-typed and silently wrong.
#
# Flagged: a loop expression (the parser's `Stmt.Expr(Expr.Block(decls…, loop), yield)`, see
# wrap_loop_header) whose yield reads one of its own header accumulators, when something
# follows it in the same block. Every statement of a value block counts as followed — the
# block's tail value comes after it. A function's tail loop is its return value and is not a
# discard.
#
# NOT flagged: a yield that reads only CAPTURED outer bindings (`|table| -> table`). The loop
# writes the outer binding in place, so dropping the yield loses nothing; the compiler's own
# source relies on that shape 79 times. stage0 reports the same rule with the same sentence
# (analyzer_discarded_loop_value.go).
extend Semantic:
    private:
        def check_discarded_loop_value(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Ast::Decl.Func(func_name, func_params, func_return_type, func_body, func_effects, func_decorators, func_line):
                            table <- check_discarded_loop_value_statements(func_body, false, table)
                        Ast::Decl.Module(module_name, module_body, module_line):
                            table <- check_discarded_loop_value(module_body, table)
                        Ast::Decl.Scoped(scoped_body, scoped_line):
                            table <- check_discarded_loop_value(scoped_body, table)
                        _:
                            pass


        # `tail_follows`: the list is the statement part of a value block, so even its last
        # statement is followed (by the block's value).
        def check_discarded_loop_value_statements(statements: darray[Ast::Stmt], tail_follows: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement_index in 0..<statements.count |table| -> table:
                    statement: Ast::Stmt = statements[statement_index]
                    followed: bool = tail_follows or statement_index + 1 < statements.count
                    match statement:
                        Ast::Stmt.Expr(expression, line):
                            if followed:
                                table <- report_discarded_loop_value(expression, table)
                            table <- check_discarded_loop_value_expression(expression, table)
                        Ast::Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_discarded_loop_value_expression(value, table)
                        Ast::Stmt.Assign(target, operator, value, line):
                            table <- check_discarded_loop_value_expression(target, table)
                            table <- check_discarded_loop_value_expression(value, table)
                        Ast::Stmt.If(condition, then_body, else_body, line):
                            table <- check_discarded_loop_value_expression(condition, table)
                            table <- check_discarded_loop_value_statements(then_body, false, table)
                            table <- check_discarded_loop_value_statements(else_body, false, table)
                        Ast::Stmt.While(condition, body, line):
                            table <- check_discarded_loop_value_expression(condition, table)
                            table <- check_discarded_loop_value_statements(body, false, table)
                        Ast::Stmt.For(bind, variables, iterable, body, line):
                            table <- check_discarded_loop_value_expression(iterable, table)
                            table <- check_discarded_loop_value_statements(body, false, table)
                        Ast::Stmt.Block(kind, clause, binding, body, line):
                            table <- check_discarded_loop_value_statements(body, false, table)
                        Ast::Stmt.Match(scrutinee, arms, line):
                            table <- check_discarded_loop_value_expression(scrutinee, table)
                            for arm in arms |table| -> table:
                                table <- check_discarded_loop_value_expression(arm.guard, table)
                                table <- check_discarded_loop_value_statements(arm.body, false, table)
                        Ast::Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_discarded_loop_value_expression(return_value, table)
                        Ast::Stmt.Contract(kind, expression, line):
                            table <- check_discarded_loop_value_expression(expression, table)
                        Ast::Stmt.Invalid:
                            pass
                        Ast::Stmt.Break(label, line):
                            pass
                        Ast::Stmt.Continue(label, line):
                            pass


        # Report EXPRESSION when it is an accumulator loop whose yield reads one of its own
        # header accumulators. The block is `[accumulator decls…, loop]` with the yield as its
        # value (wrap_loop_header); any other block shape is not a loop expression.
        def report_discarded_loop_value(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if expression is Ast::Expr.Block(statements, value, captures, block_pos):
                    return if statements.count == 0
                    loop_pos: mutable Ast::Pos = block_pos
                    is_loop: mutable bool = false
                    match statements[statements.count - 1]:
                        Ast::Stmt.For(bind, variables, iterable, body, for_pos):
                            loop_pos <- for_pos
                            is_loop <- true
                        Ast::Stmt.While(condition, body, while_pos):
                            loop_pos <- while_pos
                            is_loop <- true
                        _:
                            pass
                    return if not is_loop
                    accumulator: mutable sview = ""
                    for declaration_index in 0..<statements.count - 1 |accumulator|:
                        declaration: Ast::Stmt = statements[declaration_index]
                        if accumulator == "":
                            if declaration is Ast::Stmt.VarDecl(declared_name, _, _, _):
                                accumulator <- declared_name if discarded_loop_yield_mentions(value, declared_name)
                    return if accumulator == ""
                    # `name` is the first accumulator the yield reads — the yield itself for the
                    # usual `-> valid`.
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DiscardedLoopValue, name: accumulator, pos: loop_pos, line: loop_pos.line, expected: "", actual: ""})


        # Whether NAME is read anywhere in a loop's yield expression.
        def discarded_loop_yield_mentions(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.Ident(ident_name, _):
                        return ident_name == name
                    Ast::Expr.Field(object, field, _):
                        return discarded_loop_yield_mentions(object, name)
                    Ast::Expr.Index(object, index, _):
                        return discarded_loop_yield_mentions(object, name) or discarded_loop_yield_mentions(index, name)
                    Ast::Expr.Call(callee, arguments, argument_names, _):
                        true return if discarded_loop_yield_mentions(callee, name)
                        return any argument in arguments where discarded_loop_yield_mentions(argument, name)
                    Ast::Expr.Binary(left, operator, right, _):
                        return discarded_loop_yield_mentions(left, name) or discarded_loop_yield_mentions(right, name)
                    Ast::Expr.Unary(operator, operand, _):
                        return discarded_loop_yield_mentions(operand, name)
                    Ast::Expr.Paren(inner, _):
                        return discarded_loop_yield_mentions(inner, name)
                    Ast::Expr.Move(operand, _):
                        return discarded_loop_yield_mentions(operand, name)
                    Ast::Expr.If(condition, then_expr, else_expr, _):
                        true return if discarded_loop_yield_mentions(condition, name)
                        return discarded_loop_yield_mentions(then_expr, name) or discarded_loop_yield_mentions(else_expr, name)
                    Ast::Expr.Tuple(elements, _):
                        return any element in elements where discarded_loop_yield_mentions(element, name)
                    Ast::Expr.Array(elements, _):
                        return any element in elements where discarded_loop_yield_mentions(element, name)
                    _:
                        return false


        def check_discarded_loop_value_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.If(condition, then_expr, else_expr, line):
                        table <- check_discarded_loop_value_expression(condition, table)
                        table <- check_discarded_loop_value_expression(then_expr, table)
                        table <- check_discarded_loop_value_expression(else_expr, table)
                    Ast::Expr.Binary(left, operator, right, line):
                        table <- check_discarded_loop_value_expression(left, table)
                        table <- check_discarded_loop_value_expression(right, table)
                    Ast::Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- check_discarded_loop_value_expression(child, table)
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        table <- check_discarded_loop_value_expression(callee, table)
                        for argument in arguments |table| -> table:
                            table <- check_discarded_loop_value_expression(argument, table)
                    Ast::Expr.Field(object, field, line):
                        table <- check_discarded_loop_value_expression(object, table)
                    Ast::Expr.Scope(base, name, line):
                        table <- check_discarded_loop_value_expression(base, table)
                    Ast::Expr.Index(object, index, line):
                        table <- check_discarded_loop_value_expression(object, table)
                        table <- check_discarded_loop_value_expression(index, table)
                    Ast::Expr.Slice(object, low, high, line):
                        table <- check_discarded_loop_value_expression(object, table)
                        table <- check_discarded_loop_value_expression(low, table)
                        table <- check_discarded_loop_value_expression(high, table)
                    Ast::Expr.IndexN(object, arguments, line):
                        table <- check_discarded_loop_value_expression(object, table)
                        for argument in arguments |table| -> table:
                            table <- check_discarded_loop_value_expression(argument, table)
                    Ast::Expr.Unary(operator, operand, line):
                        table <- check_discarded_loop_value_expression(operand, table)
                    Ast::Expr.Move(operand, line):
                        table <- check_discarded_loop_value_expression(operand, table)
                    Ast::Expr.RegionNew(operand, region, line):
                        table <- check_discarded_loop_value_expression(operand, table)
                    Ast::Expr.Refinement(base, predicate, line):
                        table <- check_discarded_loop_value_expression(base, table)
                        table <- check_discarded_loop_value_expression(predicate, table)
                    Ast::Expr.GetElse(guarded, recovery, line):
                        table <- check_discarded_loop_value_expression(guarded, table)
                        table <- check_discarded_loop_value_statements(recovery, false, table)
                    Ast::Expr.Paren(inner, line):
                        table <- check_discarded_loop_value_expression(inner, table)
                    Ast::Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- check_discarded_loop_value_expression(element, table)
                    Ast::Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- check_discarded_loop_value_expression(element, table)
                    Ast::Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- check_discarded_loop_value_expression(element, table)
                    Ast::Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- check_discarded_loop_value_expression(entry.key, table)
                            table <- check_discarded_loop_value_expression(entry.value, table)
                    Ast::Expr.Construct(type_expression, fields, line):
                        table <- check_discarded_loop_value_expression(type_expression, table)
                        for field in fields |table| -> table:
                            table <- check_discarded_loop_value_expression(field.value, table)
                    Ast::Expr.RecordUpdate(base, fields, line):
                        table <- check_discarded_loop_value_expression(base, table)
                        for field in fields |table| -> table:
                            table <- check_discarded_loop_value_expression(field.value, table)
                    Ast::Expr.Match(scrutinee, arms, line):
                        table <- check_discarded_loop_value_expression(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- check_discarded_loop_value_expression(arm.guard, table)
                            table <- check_discarded_loop_value_statements(arm.body, false, table)
                    Ast::Expr.Catch(scrutinee, arms, line):
                        table <- check_discarded_loop_value_expression(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- check_discarded_loop_value_expression(arm.guard, table)
                            table <- check_discarded_loop_value_statements(arm.body, false, table)
                    Ast::Expr.Comprehension(var, iterable, condition, body, line):
                        table <- check_discarded_loop_value_expression(iterable, table)
                        table <- check_discarded_loop_value_expression(condition, table)
                        table <- check_discarded_loop_value_expression(body, table)
                    Ast::Expr.Lambda(parameters, body, line):
                        table <- check_discarded_loop_value_statements(body, false, table)
                    # A value block: its tail value follows every one of its statements. A
                    # diverging block (Absent) and a statement-form loop block (Invalid) have
                    # no tail value.
                    Ast::Expr.Block(statements, value, captures, line):
                        block_has_value: bool = not (value is Ast::Expr.Invalid) and not (value is Ast::Expr.Absent)
                        table <- check_discarded_loop_value_statements(statements, block_has_value, table)
                        table <- check_discarded_loop_value_expression(value, table)
                    _:
                        pass
