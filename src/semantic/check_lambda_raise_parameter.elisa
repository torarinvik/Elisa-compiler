# Bind a lambda call argument to the selected declaration's callback error set.
extend Semantic:
    private:
        def lrc_argument_target(target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32), argument_index: usize, argument_names: darray[sview @source], annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32):
            can Abort.Panic:
                empty: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32) = (false, "", 0, 0, 0, "", 0)
                return empty if not target.known
                symbol_row: mutable u32 = symbol_chain_head(table, target.function_name)
                selected_id: mutable u32 = INVALID_DECL_ID_VALUE
                while symbol_row != SYMBOL_INDEX_ROW_NONE |symbol_row, selected_id|:
                    symbol: Symbol = table.symbols[symbol_row.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == target.function_name and symbol.module_owner == target.module and symbol.line == target.line and symbol.offset == target.offset:
                        return empty if selected_id != INVALID_DECL_ID_VALUE
                        selected_id <- symbol.id.value
                    symbol_row <- table.symbol_name_next[symbol_row.usize()]
                return empty if selected_id == INVALID_DECL_ID_VALUE
                label: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                for earlier in 0..<argument_index:
                    return empty if label == "" and earlier < argument_names.count and argument_names[earlier] != ""
                parameter_index: mutable usize = 0
                fn_offset: mutable u32 = 0
                parameter_row: mutable u32 = function_param_chain_head(table, target.function_name)
                while parameter_row != SYMBOL_INDEX_ROW_NONE |parameter_row, parameter_index, fn_offset|:
                    row: usize = parameter_row.usize()
                    if table.function_param_owner[row] == target.function_name and row < table.function_param_declaration_id.count and table.function_param_declaration_id[row].value == selected_id:
                        if (label != "" and table.function_param_name[row] == label) or (label == "" and parameter_index == argument_index):
                            return empty if row >= table.function_param_fn_type_offset.count
                            fn_offset <- table.function_param_fn_type_offset[row]
                            break
                        parameter_index <- parameter_index + 1
                    parameter_row <- table.function_param_name_next[row]
                return empty if fn_offset == 0
                occurrence: mutable u32 = 0
                marker_count: mutable usize = 0
                for marker in annotations |occurrence, marker_count, fn_offset|:
                    if marker.owner == "__fn_error_union" and marker.offset == fn_offset:
                        occurrence <- marker.occurrence_offset
                        marker_count <- marker_count + 1
                # A known function type with no error marker is infallible.
                return (true, target.module, target.line, target.offset, target.identity_id, target.function_name, 0) if marker_count == 0
                return empty if marker_count != 1 or occurrence == 0
                # Generic error-set parameters are inferred from the callback and
                # cannot be compared as concrete family identities here.
                for marker in annotations:
                    if marker.owner == "__fn_error_union" and marker.offset == fn_offset:
                        for generic in annotations |marker, target|:
                            return empty if generic.owner == "__errorset_param" and generic.name == marker.name and generic.line == target.line and generic.offset == target.offset
                return (true, target.module, target.line, target.offset, target.identity_id, target.function_name, occurrence)
