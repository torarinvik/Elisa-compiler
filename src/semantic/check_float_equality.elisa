# Check for floating-point equality comparisons using == or !=.
# Floating-point equality is unreliable due to precision issues; use tolerance-based comparison.

extend Semantic:
    private:
        # Check if a float literal spells exactly 0.0 (exempt from warning)
        def is_zero_float(text: sview) -> bool:
            can Abort.Panic:
                return text == "0.0" or text == "0.0f" or text == "0.0d"


        # Check if an integer literal is exactly 0 (exempt from warning)
        def is_zero_int(value: i64) -> bool:
            can Abort.Panic:
                return value == 0


        # Whether an expression is a literal 0 or 0.0 (either comparison side is exempt)
        def expr_is_zero_literal(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.IntLit(int_val):
                        return is_zero_int(int_val)
                    Expr.FloatLit(float_text):
                        return is_zero_float(float_text)
                    _:
                        return false


        # Walk all statements in a function body, checking for floating-point equality.
        # `local_names` and `local_types` track the declared type names of locals/params.
        def walk_float_equality_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable, local_names: darray[sview]&, local_types: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_float_equality_expression(expression, table, local_names, local_types)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_float_equality_expression(value, table, local_names, local_types)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_float_equality_expression(target, table, local_names, local_types)
                            table <- walk_float_equality_expression(value, table, local_names, local_types)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_float_equality_expression(condition, table, local_names, local_types)
                            table <- walk_float_equality_statements(then_body, table, local_names, local_types)
                            table <- walk_float_equality_statements(else_body, table, local_names, local_types)
                        Stmt.While(condition, body, line):
                            table <- walk_float_equality_expression(condition, table, local_names, local_types)
                            table <- walk_float_equality_statements(body, table, local_names, local_types)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_float_equality_expression(iterable, table, local_names, local_types)
                            table <- walk_float_equality_statements(body, table, local_names, local_types)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_float_equality_statements(body, table, local_names, local_types)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_float_equality_expression(scrutinee, table, local_names, local_types)
                            for arm in arms |table|:
                                table <- walk_float_equality_expression(arm.guard, table, local_names, local_types)
                                table <- walk_float_equality_statements(arm.body, table, local_names, local_types)
                        Stmt.Return(value, line):
                            table <- walk_float_equality_expression(return_value, table, local_names, local_types) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_float_equality_expression(expression, table, local_names, local_types)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Check if an expression is a floating-point type
        def is_float_expr(expression: Ast::Expr, local_names: darray[sview]&, local_types: darray[sview]&) -> bool:
            can Abort.Panic:
                # Case 1: float literal
                true return if expression is Expr.FloatLit(text)
                # Case 2: plain identifier with f32 or f64 type
                if expression is Expr.Ident(name, line):
                    # Search for this name in the locals
                    while index < local_names.count |index: usize = 0|:
                        if local_names[index] == name:
                            type_name: sview = local_types[index]
                            true return if type_name == "f32" or type_name == "f64"
                            return false
                        index <- index + 1
                return false


        # Walk all expressions, checking for floating-point equality comparisons.
        def walk_float_equality_expression(expression: Ast::Expr, table: lmut SymbolTable, local_names: darray[sview]&, local_types: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_float_equality_expression(callee, table, local_names, local_types)
                        for argument in arguments |table| -> table:
                            table <- walk_float_equality_expression(argument, table, local_names, local_types)
                    Expr.Field(object, field, line):
                        table <- walk_float_equality_expression(object, table, local_names, local_types)
                    Expr.Scope(base, name, line):
                        table <- walk_float_equality_expression(base, table, local_names, local_types)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- walk_float_equality_expression(object, table, local_names, local_types)
                        table <- walk_float_equality_expression(index, table, local_names, local_types)
                    Expr.Slice(object, low, high, line):
                        table <- walk_float_equality_expression(object, table, local_names, local_types)
                        table <- walk_float_equality_expression(low, table, local_names, local_types)
                        table <- walk_float_equality_expression(high, table, local_names, local_types)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_float_equality_expression(object, table, local_names, local_types)
                        for argument in arguments |table| -> table:
                            table <- walk_float_equality_expression(argument, table, local_names, local_types)
                    Expr.Binary(left, operator, right, line):
                        # Check for floating-point equality: == or != with at least one float operand
                        if operator == TokenKind.EqEq or operator == TokenKind.BangEq:
                            left_is_float: bool = is_float_expr(left, local_names, local_types)
                            right_is_float: bool = is_float_expr(right, local_names, local_types)

                            # Exemption: comparing against a literal 0 / 0.0 is exact.
                            # Computed unconditionally as a pure value (no side effects), then
                            # folded into the guard (docs/125 flow-flag discipline).
                            is_exempt: bool = expr_is_zero_literal(left) or expr_is_zero_literal(right)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FloatEquality, name: "", line: line, expected: "", actual: ""}) if (left_is_float or right_is_float) and not is_exempt

                        # Recursively walk left and right operands
                        table <- walk_float_equality_expression(left, table, local_names, local_types)
                        table <- walk_float_equality_expression(right, table, local_names, local_types) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Unary(operator, operand, line):
                        table <- walk_float_equality_expression(operand, table, local_names, local_types)
                    Expr.Refinement(base, predicate, line):
                        table <- walk_float_equality_expression(base, table, local_names, local_types)
                        table <- walk_float_equality_expression(predicate, table, local_names, local_types)
                    Expr.Paren(inner, line):
                        table <- walk_float_equality_expression(inner, table, local_names, local_types)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_float_equality_expression(element, table, local_names, local_types)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_float_equality_expression(element, table, local_names, local_types)
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_float_equality_expression(element, table, local_names, local_types)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- walk_float_equality_expression(entry.key, table, local_names, local_types)
                            table <- walk_float_equality_expression(entry.value, table, local_names, local_types)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_float_equality_expression(type_expression, table, local_names, local_types)
                        for field in fields |table| -> table:
                            table <- walk_float_equality_expression(field.value, table, local_names, local_types)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_float_equality_expression(base, table, local_names, local_types)
                        for field in fields |table| -> table:
                            table <- walk_float_equality_expression(field.value, table, local_names, local_types)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_float_equality_expression(condition, table, local_names, local_types)
                        table <- walk_float_equality_expression(then_expr, table, local_names, local_types)
                        table <- walk_float_equality_expression(else_expr, table, local_names, local_types)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_float_equality_expression(iterable, table, local_names, local_types)
                        table <- walk_float_equality_expression(condition, table, local_names, local_types)
                        table <- walk_float_equality_expression(body, table, local_names, local_types)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_float_equality_statements(body, table, local_names, local_types)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_float_equality_statements(statements, table, local_names, local_types)
                        table <- walk_float_equality_expression(value, table, local_names, local_types)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_float_equality_expression(scrutinee, table, local_names, local_types)
                        for arm in arms |table| -> table:
                            table <- walk_float_equality_statements(arm.body, table, local_names, local_types)


        # Entry point: walk function declarations and check for float equality issues.
        def check_float_equality_in_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Build local types from parameters
                            local_names: mutable darray[sview] = []
                            local_types: mutable darray[sview] = []
                            for param in params |local_names, local_types|:
                                param_type: sview = bare_type_name(param.type_expression)
                                local_names.push(param.name)
                                local_types.push(param_type)
                            table <- walk_float_equality_statements(body, table, local_names, local_types)
                        Decl.Module(name, body, line):
                            table <- check_float_equality_in_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_float_equality_in_declarations(body, table)
                        _:
                            pass


    public:
        # Public check function that can be called from semantic_api.
        def check_float_equality(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_float_equality_in_declarations(declarations, table)
