        def check_destroyed_region_declarations(declarations: darray[Ast::Decl], file: Ast::File&, view_fns: darray[sview]&, arena_invalidation_names: darray[sview]&, arena_invalidation_params: darray[u32]&, arena_invalidation_formals: darray[sview]&, arena_invalidation_row_heads: dict[u64, u32]&, arena_invalidation_row_tails: dict[u64, u32]&, arena_invalidation_row_next: darray[u32]&, local_function_names: darray[sview]&, opaque_function_names: darray[sview]&, opaque_function_starts: darray[usize]&, opaque_function_arities: darray[u32]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
