    public:
        def check_destroyed_region(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                region_annotations_forget_sorted() can Global.Write
                arena_invalidation_names: mutable darray[sview] = []
                arena_invalidation_params: mutable darray[u32] = []
                arena_invalidation_formals: mutable darray[sview] = []
                view_fns: mutable darray[sview] = []
                local_function_names: mutable darray[sview] = []
                opaque_function_names: mutable darray[sview] = []
                opaque_function_starts: mutable darray[usize] = []
                opaque_function_arities: mutable darray[u32] = []
                # Retain module-alias spellings beside summary rows so qualified calls
                # through aliases cannot accidentally match a different module's owner.
                # Duplicate aliases remain represented; either way, matching fails closed.
                arena_invalidation_row_heads: mutable dict[u64, u32] = {}
                arena_invalidation_row_tails: mutable dict[u64, u32] = {}
                arena_invalidation_row_next: mutable darray[u32] = []
                for annotation in table.protocol_annotations |arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, arena_invalidation_row_heads, arena_invalidation_row_tails, arena_invalidation_row_next|:
                    if annotation.name == "__using_alias":
                        destroyed_summary_index_push("__destroyed_region_module_alias__", arena_invalidation_names.count, arena_invalidation_row_heads, arena_invalidation_row_tails, arena_invalidation_row_next) can Global{Read,Write}
                        arena_invalidation_names.push("__destroyed_region_module_alias__")
                        arena_invalidation_params.push(NO_ARENA_SUMMARY_PARAM)
                        arena_invalidation_formals.push(annotation.owner)
                        arena_invalidation_formals.push("")
                destroyed_collect_function_metadata(file.top_decls, view_fns, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities)
                summaries_changed: mutable bool = true
                while summaries_changed |summaries_changed, file, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, arena_invalidation_row_heads, arena_invalidation_row_tails, arena_invalidation_row_next, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities|:
                    summaries_changed <- false
                    destroyed_collect_arena_invalidation_summaries(file.top_decls, "", arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, arena_invalidation_row_heads, arena_invalidation_row_tails, arena_invalidation_row_next, local_function_names, opaque_function_names, summaries_changed) can Global{Read,Write}
                table <- check_destroyed_region_declarations(file.top_decls, file, view_fns, arena_invalidation_names, arena_invalidation_params, arena_invalidation_formals, arena_invalidation_row_heads, arena_invalidation_row_tails, arena_invalidation_row_next, local_function_names, opaque_function_names, opaque_function_starts, opaque_function_arities, file.extern_params, table) can Global{Read,Write}
