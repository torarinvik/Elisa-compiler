# Region dependencies in view types and block statements.
extend Semantic:
    private:
        def destroyed_type_is_pool_owner_or_handle(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Index(object, _, line): ident_name_of(object) == "RegionPool" or ident_name_of(object) == "Pooled"
                    Expr.IndexN(object, _, line): ident_name_of(object) == "RegionPool" or ident_name_of(object) == "Pooled"
                    Expr.Unary(operator, operand, line):
                        return destroyed_type_is_pool_owner_or_handle(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Question or operator == TokenKind.Ampersand or operator == TokenKind.Heap or operator == TokenKind.Static or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, line): destroyed_type_is_pool_owner_or_handle(inner)
                    _: false

        def destroyed_type_is_view(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match type_expression:
                    Expr.Ident(name, line): name == "sview"
                    Expr.Index(object, element, line): ident_name_of(object) == "view" or destroyed_type_is_pool_owner_or_handle(type_expression)
                    Expr.IndexN(object, arguments, line): ident_name_of(object) == "view" or destroyed_type_is_pool_owner_or_handle(type_expression)
                    Expr.Unary(operator, operand, line):
                        return match operator:
                            # Storage qualifiers do not erase a value's region provenance. In
                            # particular, `heap T&` returned by a region-backed owner can still
                            # point into that owner's region; keep tracking it when copied to a
                            # local so a later destroy invalidates the alias too.
                            TokenKind.Mutable | TokenKind.Lmut | TokenKind.Question | TokenKind.Heap | TokenKind.Static | TokenKind.Stack | TokenKind.Tail: destroyed_type_is_view(operand)
                            TokenKind.Ampersand: true
                            _: false
                    Expr.Paren(inner, line): destroyed_type_is_view(inner)
                    _: false


        def destroyed_collect_view_block_statement(region_index: DestroyedRegionNameIndex&, statement: Ast::Stmt, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        local_regions: mutable darray[u32] = []
                        destroyed_collect_view_regions(region_index, value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, local_regions) can Global{Read,Write}
                        for region_id in local_regions:
                            borrow_names.push(name)
                            borrow_regions.push(region_id)
                    Stmt.Assign(target, operator, value, line):
                        target_name: sview = destroyed_use_root_name(target)
                        local_regions: mutable darray[u32] = []
                        destroyed_collect_view_regions(region_index, value, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, local_regions) can Global{Read,Write}
                        for region_id in local_regions:
                            borrow_names.push(target_name)
                            borrow_regions.push(region_id)
                    Stmt.Return(value, line):
                        destroyed_collect_view_regions(region_index, returned, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write} if value is returned
                    Stmt.Expr(expression, line):
                        destroyed_collect_view_regions(region_index, expression, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(region_index, nested, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.If(condition, then_body, else_body, line):
                        destroyed_collect_view_regions(region_index, condition, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_then in then_body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(region_index, nested_then, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_else in else_body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(region_index, nested_else, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.While(condition, body, line):
                        destroyed_collect_view_regions(region_index, condition, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_while in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(region_index, nested_while, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.For(bind, variables, iterable, body, line):
                        destroyed_collect_view_regions(region_index, iterable, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for nested_for in body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(region_index, nested_for, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.Match(scrutinee, arms, line):
                        destroyed_collect_view_regions(region_index, scrutinee, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                        for arm in arms |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_regions(region_index, arm.guard, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                            for nested_arm in arm.body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_block_statement(region_index, nested_arm, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    Stmt.Contract(kind, expression, line):
                        destroyed_collect_view_regions(region_index, expression, annotations, view_fns, borrow_names, borrow_regions, function_line, line.line, out) can Global{Read,Write}
                    _:
                        pass
