extend Semantic:
    private:
        # Collect backing-region provenance through view constructors, copies, slices, and
        # functions whose declared result is a view. Conservatively retaining every possible
        # source argument makes conditional view-returning helpers safe without trusting body
        # shape or choosing one branch's region.
        def destroyed_collect_view_regions(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, function_line: u32, use_line: u32, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        function_regions_of_name(annotations, name, function_line, use_line, out) can Global{Read,Write}
                        for index in 0..<borrow_names.count |out, borrow_names, borrow_regions, name|:
                            if borrow_names[index] == name and index < borrow_regions.count:
                                alias_region: u32 = borrow_regions[index]
                                out.push(alias_region) if alias_region != NO_REGION_BINDING and not any existing in out where existing == alias_region
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        destroyed_collect_view_regions(inner, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line) | Expr.Slice(object, start, end, line):
                        destroyed_collect_view_regions(object, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Unary(operator, operand, line):
                        destroyed_collect_view_regions(operand, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Call(callee, arguments, argument_names, line):
                        called: sview = ident_name_of(callee)
                        if called == "region_pool_new":
                            before_pool_regions: usize = out.count
                            for argument in arguments |annotations, function_line, use_line, out|:
                                owner_name: sview = destroyed_arena_owner_source_name(argument)
                                owner_region: u32 = region_binding_id_at(annotations, owner_name, function_line, use_line) can Global{Read,Write} if owner_name != "" else NO_REGION_BINDING
                                out.push(owner_region) if owner_region != NO_REGION_BINDING and not any existing in out where existing == owner_region
                                destroyed_collect_view_regions(argument, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                            destroyed_push_region_id(out, UNKNOWN_REGION_DEPENDENCY) if before_pool_regions == out.count
                        elif called == "sview" or any view_fn in view_fns where view_fn == called:
                            for argument in arguments |out|:
                                destroyed_collect_view_regions(argument, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                is_view_method: bool = when method:
                                    "sview" | "as_sview" | "as_view" | "as_slice" | "as_str" -> true
                                    _ -> false
                                is_pool_acquire: bool = method == "acquire"
                                destroyed_collect_view_regions(receiver, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write} if is_view_method or is_pool_acquire
                            _:
                                pass
                    Expr.Catch(guarded, arms, line):
                        destroyed_collect_view_regions(guarded, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        for arm in arms |out|:
                            destroyed_collect_view_regions(arm.guard, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                            for arm_statement in arm.body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_block_statement(arm_statement, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.GetElse(guarded, recovery, line):
                        destroyed_collect_view_regions(guarded, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        for recovery_statement in recovery |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(recovery_statement, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Binary(left, operator, right, line):
                        destroyed_collect_view_regions(left, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        destroyed_collect_view_regions(right, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.If(condition, then_value, else_value, line):
                        destroyed_collect_view_regions(then_value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        destroyed_collect_view_regions(else_value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Refinement(base, predicate, line):
                        destroyed_collect_view_regions(base, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        destroyed_collect_view_regions(predicate, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Block(statements, value, captures, line):
                        block_borrow_names: mutable darray[sview] = []
                        block_borrow_regions: mutable darray[u32] = []
                        for borrow_index in 0..<borrow_names.count |block_borrow_names, block_borrow_regions, borrow_regions|:
                            block_borrow_names.push(borrow_names[borrow_index])
                            block_borrow_regions.push(borrow_regions[borrow_index]) if borrow_index < borrow_regions.count
                        for block_statement in statements |annotations, view_fns, block_borrow_names, block_borrow_regions, function_line, use_line, out|:
                            destroyed_collect_view_block_statement(block_statement, annotations, view_fns, block_borrow_names, block_borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        destroyed_collect_view_regions(value, annotations, view_fns, block_borrow_names, block_borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Match(scrutinee, arms, line):
                        destroyed_collect_view_regions(scrutinee, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        for arm in arms |out|:
                            destroyed_collect_view_regions(arm.guard, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                            for arm_statement in arm.body |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_block_statement(arm_statement, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        destroyed_collect_view_regions(iterable, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        destroyed_collect_view_regions(condition, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        destroyed_collect_view_regions(body, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        destroyed_collect_view_regions(effect_type, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        for candidate in candidates |out|:
                            for capture in candidate.captures |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                                destroyed_collect_view_regions(capture, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        for argument in arguments |out|:
                            destroyed_collect_view_regions(argument, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Tuple(elements, line) | Expr.Array(elements, line):
                        for element in elements |out|:
                            destroyed_collect_view_regions(element, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |out|:
                            destroyed_collect_view_regions(field.value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    Expr.RecordUpdate(base, fields, line):
                        destroyed_collect_view_regions(base, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                        for field in fields |out|:
                            destroyed_collect_view_regions(field.value, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    _:
                        pass


        # Region-tied function returns can be aggregates whose fields carry references or
        # region-backed containers. They are not necessarily syntactic views (for example,
        # `Payload @r` where Payload contains `darray[u8]`). Resolve the call to one exact
        # declaration before using its `__region_return` annotation; a same-leaf declaration
        # in another module must never lend its return contract to this call.
        def destroyed_region_return_symbol_matches(symbol: Symbol&, function_name: sview, exact_owner: sview, exact_owner_mode: bool, module_names: darray[sview]&) -> bool:
            return false if symbol.kind != SymbolKind.Func or symbol.name != function_name
            return symbol.module_owner == exact_owner if exact_owner_mode
            return module_names.count > 0 and module_symbol_matches(symbol.module_owner, "", module_names, 0, module_names.count)



        # Count only same-name declarations on the healthy collision-safe chain. If the
        # index metadata or a chain row is incomplete, restart from the canonical table so
        # ambiguity and `__region_return` annotation checks keep their original behavior.
        def destroyed_count_region_return_matches(function_name: sview, exact_owner: sview, exact_owner_mode: bool, module_names: darray[sview]&, annotations: darray[Ast::LocalRegionAnnotation]&, table: SymbolTable&, matches: mutable usize&, tied: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                matches <- 0.usize()
                tied <- false
                index_valid: mutable bool = table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count
                if index_valid:
                    row: mutable u32 = symbol_chain_head(table, function_name)
                    steps: mutable usize = 0
                    while row != SYMBOL_INDEX_ROW_NONE and steps < table.symbols.count |row, steps, function_name, exact_owner, exact_owner_mode, module_names, annotations, table, matches, tied|:
                        symbol_index: usize = row.usize()
                        if symbol_index >= table.symbols.count or symbol_index >= table.symbol_name_next.count:
                            index_valid <- false
                            break
                        symbol: Symbol& = &table.symbols[symbol_index]
                        if destroyed_region_return_symbol_matches(symbol, function_name, exact_owner, exact_owner_mode, module_names):
                            matches <- matches + 1.usize()
                            tied <- true if any annotation in annotations where annotation.name == "__region_return" and annotation.line == symbol.line
                        row <- table.symbol_name_next[symbol_index]
                        steps <- steps + 1.usize()
                    index_valid <- false if row != SYMBOL_INDEX_ROW_NONE
                    return if index_valid
                matches <- 0.usize()
                tied <- false
                for symbol in table.symbols |function_name, exact_owner, exact_owner_mode, module_names, annotations, matches, tied|:
                    if destroyed_region_return_symbol_matches(symbol, function_name, exact_owner, exact_owner_mode, module_names):
                        matches <- matches + 1.usize()
                        tied <- true if any annotation in annotations where annotation.name == "__region_return" and annotation.line == symbol.line



        def destroyed_call_has_region_tied_return(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return destroyed_call_has_region_tied_return(inner, annotations, table)
                    Expr.Call(Expr.Scope(Expr.Ident(module_name, _), function_name, _), _, _, _):
                        matches: mutable usize = 0
                        tied: mutable bool = false
                        no_module_names: darray[sview] = []
                        destroyed_count_region_return_matches(function_name, module_name, true, no_module_names, annotations, table, matches, tied)
                        return matches == 1 and tied
                    Expr.Call(Expr.Scope(scope_base, function_name, _), _, _, _):
                        module_names: mutable darray[sview] = []
                        module_dotted: mutable darray[bool] = []
                        return false if not type_path_collect(scope_base, module_names, module_dotted) or module_names.count == 0 or (any separator_is_dot in module_dotted where separator_is_dot)
                        matches: mutable usize = 0
                        tied: mutable bool = false
                        destroyed_count_region_return_matches(function_name, "", false, module_names, annotations, table, matches, tied)
                        return matches == 1 and tied
                    _:
                        return false


        # Callers invoke this only after destroyed_call_has_region_tied_return has
        # succeeded for the same expression. Keep the wrapper unwrapping, but do not
        # repeat that symbol/annotation lookup before walking the call arguments.
        def destroyed_collect_region_tied_call_arguments(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview]&, borrow_names: mutable darray[sview]&, borrow_regions: mutable darray[u32]&, function_line: u32, use_line: u32, table: SymbolTable&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        destroyed_collect_region_tied_call_arguments(inner, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, table, out) can Global{Read,Write}
                    Expr.Call(arguments: arguments, _):
                        for argument in arguments |annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out|:
                            # A region-tied aggregate can carry an arena-backed field
                            # even when the actual argument is only `&arena`, which is
                            # not itself a view and therefore has no view provenance.
                            owner_name: sview = destroyed_arena_owner_source_name(argument)
                            owner_region: u32 = region_binding_id_at(annotations, owner_name, function_line, use_line) can Global{Read,Write} if owner_name != "" else NO_REGION_BINDING
                            destroyed_push_region_id(out, owner_region) if owner_region != NO_REGION_BINDING
                            destroyed_collect_view_regions(argument, annotations, view_fns, borrow_names, borrow_regions, function_line, use_line, out) can Global{Read,Write}
                    _:
                        pass

        def destroyed_alias_region(name: sview, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, destroyed: darray[u32]&) -> u32:
            can Abort.Panic:
                while index > 0 |index: usize = borrow_names.count|:
                    index <- index - 1
                    if borrow_names[index] == name and index < borrow_regions.count:
                        region: u32 = borrow_regions[index]
                        return region if destroyed_region_id_contains(destroyed, region)
                return NO_REGION_BINDING

        def destroyed_region_of_statement(statement: Ast::Stmt, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, function_line: u32, use_line: u32) -> u32:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        return destroyed_region_of_expression(value, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                    Stmt.Assign(target, operator, value, line):
                        target_region: u32 = destroyed_region_of_expression(target, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                        return target_region if target_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(value, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                    Stmt.Expr(expression, line) | Stmt.Contract(_, expression, line):
                        return destroyed_region_of_expression(expression, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                    Stmt.Return(value, line):
                        if value is returned:
                            return destroyed_region_of_expression(returned, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                        return NO_REGION_BINDING
                    Stmt.Block(kind, clause, binding, body, line):
                        for nested in body:
                            region_id: u32 = destroyed_region_of_statement(nested, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.If(condition, then_body, else_body, line):
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                        return condition_region if condition_region != NO_REGION_BINDING
                        for nested_then in then_body:
                            region_id: u32 = destroyed_region_of_statement(nested_then, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        for nested_else in else_body:
                            region_id: u32 = destroyed_region_of_statement(nested_else, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.While(condition, body, line):
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                        return condition_region if condition_region != NO_REGION_BINDING
                        for nested_while in body:
                            region_id: u32 = destroyed_region_of_statement(nested_while, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.For(bind, variables, iterable, body, line):
                        iterable_region: u32 = destroyed_region_of_expression(iterable, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                        return iterable_region if iterable_region != NO_REGION_BINDING
                        for nested_for in body:
                            region_id: u32 = destroyed_region_of_statement(nested_for, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Stmt.Match(scrutinee, arms, line):
                        scrutinee_region: u32 = destroyed_region_of_expression(scrutinee, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                        return scrutinee_region if scrutinee_region != NO_REGION_BINDING
                        for arm in arms:
                            guard_region: u32 = destroyed_region_of_expression(arm.guard, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                            return guard_region if guard_region != NO_REGION_BINDING
                            for nested_arm in arm.body:
                                region_id: u32 = destroyed_region_of_statement(nested_arm, annotations, destroyed, borrow_names, borrow_regions, function_line, line.line) can Global{Read,Write}
                                return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    _:
                        return NO_REGION_BINDING


        def destroyed_region_of_expression(expression: Ast::Expr, annotations: darray[Ast::LocalRegionAnnotation]&, destroyed: darray[u32]&, borrow_names: darray[sview]&, borrow_regions: darray[u32]&, function_line: u32, use_line: u32) -> u32:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        region: u32 = destroyed_annotation_region_id_of_name(annotations, name, destroyed, function_line, use_line) can Global{Read,Write}
                        return region if region != NO_REGION_BINDING else destroyed_alias_region(name, borrow_names, borrow_regions, destroyed)
                    Expr.Field(receiver, field, line):
                        return destroyed_region_of_expression(receiver, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Scope(base, name, line):
                        return destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Index(object, index, line):
                        object_region: u32 = destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return object_region if object_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(index, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.IndexN(object, arguments, line):
                        object_region: u32 = destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return object_region if object_region != NO_REGION_BINDING
                        for argument in arguments:
                            argument_region: u32 = destroyed_region_of_expression(argument, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return argument_region if argument_region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Slice(object, start, end, line):
                        object_region: u32 = destroyed_region_of_expression(object, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return object_region if object_region != NO_REGION_BINDING
                        start_region: u32 = destroyed_region_of_expression(start, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return start_region if start_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(end, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line):
                        return destroyed_region_of_expression(operand, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Paren(inner, line):
                        return destroyed_region_of_expression(inner, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_region: u32 = destroyed_region_of_expression(callee, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return callee_region if callee_region != NO_REGION_BINDING
                        for argument in arguments:
                            argument_region: u32 = destroyed_region_of_expression(argument, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return argument_region if argument_region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Catch(guarded, arms, line):
                        guarded_region: u32 = destroyed_region_of_expression(guarded, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return guarded_region if guarded_region != NO_REGION_BINDING
                        for arm in arms:
                            guard_region: u32 = destroyed_region_of_expression(arm.guard, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return guard_region if guard_region != NO_REGION_BINDING
                            for statement in arm.body:
                                region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                                return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.GetElse(guarded, recovery, line):
                        guarded_region: u32 = destroyed_region_of_expression(guarded, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return guarded_region if guarded_region != NO_REGION_BINDING
                        for statement in recovery:
                            region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Binary(left, operator, right, line):
                        left_region: u32 = destroyed_region_of_expression(left, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return left_region if left_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(right, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.If(condition, then_value, else_value, line):
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return condition_region if condition_region != NO_REGION_BINDING
                        then_region: u32 = destroyed_region_of_expression(then_value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return then_region if then_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(else_value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Refinement(base, predicate, line):
                        base_region: u32 = destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return base_region if base_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(predicate, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Tuple(elements, line) | Expr.Array(elements, line) | Expr.SetLit(elements, line):
                        for element in elements:
                            region: u32 = destroyed_region_of_expression(element, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            key_region: u32 = destroyed_region_of_expression(entry.key, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return key_region if key_region != NO_REGION_BINDING
                            value_region: u32 = destroyed_region_of_expression(entry.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return value_region if value_region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Construct(type_expression, fields, line):
                        for field in fields:
                            region: u32 = destroyed_region_of_expression(field.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.RecordUpdate(base, fields, line):
                        base_region: u32 = destroyed_region_of_expression(base, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return base_region if base_region != NO_REGION_BINDING
                        for field in fields:
                            region: u32 = destroyed_region_of_expression(field.value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return region if region != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Block(statements, value, captures, line):
                        for statement in statements:
                            region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return destroyed_region_of_expression(value, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.Match(scrutinee, arms, line):
                        scrutinee_region: u32 = destroyed_region_of_expression(scrutinee, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return scrutinee_region if scrutinee_region != NO_REGION_BINDING
                        for arm in arms:
                            guard_region: u32 = destroyed_region_of_expression(arm.guard, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return guard_region if guard_region != NO_REGION_BINDING
                            for statement in arm.body:
                                region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                                return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        iterable_region: u32 = destroyed_region_of_expression(iterable, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return iterable_region if iterable_region != NO_REGION_BINDING
                        condition_region: u32 = destroyed_region_of_expression(condition, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return condition_region if condition_region != NO_REGION_BINDING
                        return destroyed_region_of_expression(body, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        effect_region: u32 = destroyed_region_of_expression(effect_type, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                        return effect_region if effect_region != NO_REGION_BINDING
                        for candidate in candidates:
                            for capture in candidate.captures:
                                region_id: u32 = destroyed_region_of_expression(capture, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                                return region_id if region_id != NO_REGION_BINDING
                        for argument in arguments:
                            region_id: u32 = destroyed_region_of_expression(argument, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    Expr.Lambda(parameters, body, line):
                        for statement in body:
                            region_id: u32 = destroyed_region_of_statement(statement, annotations, destroyed, borrow_names, borrow_regions, function_line, use_line) can Global{Read,Write}
                            return region_id if region_id != NO_REGION_BINDING
                        return NO_REGION_BINDING
                    _:
                        return NO_REGION_BINDING

        # The root VALUE name of a use expression (`values[0]` -> "values"), for
        # stage0's cannot-be-used message.
        def destroyed_use_root_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Ident(root_name, root_line): root_name
                    Expr.Field(object, field, field_line): destroyed_use_root_name(object)
                    Expr.Index(object, index, index_line): destroyed_use_root_name(object)
                    Expr.IndexN(object, arguments, indexn_line): destroyed_use_root_name(object)
                    Expr.Slice(object, start, end, slice_line): destroyed_use_root_name(object)
                    Expr.Unary(operator, operand, unary_line): destroyed_use_root_name(operand)
                    Expr.Paren(inner, paren_line): destroyed_use_root_name(inner)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments:
                            root: sview = destroyed_use_root_name(argument)
                            return root if root != ""
                        return destroyed_use_root_name(callee)
                    Expr.Refinement(base, predicate, line):
                        base_root: sview = destroyed_use_root_name(base)
                        return base_root if base_root != ""
                        return destroyed_use_root_name(predicate)
                    Expr.Catch(guarded, _, line) | Expr.GetElse(guarded, _, line):
                        return destroyed_use_root_name(guarded)
                    _: ""

        # Explicit arena teardown invalidates values carrying that arena's region just
        # like leaving a lexical `region` block does. Rewind is conservatively treated
        # as invalidating the whole arena because this pass does not track allocation
        # epochs or the rewind mark's position.
        def destroyed_arena_invalidation(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        operation: sview = destroyed_direct_call_name(callee)
                        invalidates_all: bool = when operation:
                            "arena_free" | "arena_reset" | "arena_rewind" -> true
                            _ -> false
                        if invalidates_all and arguments.count > 0:
                            return destroyed_use_root_name(arguments[0])
                        return ""
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        return destroyed_arena_invalidation(inner)
                    _:
                        return ""

        # Named arguments retain source order in the AST, so the formal index is not
        # necessarily the source argument index (`f(target: a, keep: b)`). Positional
        # arguments fill the leading unassigned formals; labels select by formal name.
        def destroyed_summary_source_parameters(source_name: sview, params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if source_name == ""
                for parameter_index in 0..<params.count |out, params, source_name|:
                    if params[parameter_index].name == source_name and destroyed_type_is_arena_reference(params[parameter_index].type_expression):
                        index: u32 = parameter_index.u32()
                        out.push(index) if not any existing in out where existing == index
                for alias_index in 0..<alias_names.count |out, alias_names, alias_params, source_name|:
                    if alias_names[alias_index] == source_name and alias_index < alias_params.count:
                        index: u32 = alias_params[alias_index]
                        out.push(index) if index < params.count.u32() and destroyed_type_is_arena_reference(params[index.usize()].type_expression) and not any existing in out where existing == index

        def destroyed_summary_add_source_parameters(expression: Ast::Expr, params: darray[Ast::ParamDecl]&, alias_names: darray[sview]&, alias_params: darray[u32]&, out: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                source_name: sview = destroyed_arena_owner_source_name(expression)
                source_count: usize = out.count
                destroyed_summary_source_parameters(source_name, params, alias_names, alias_params, out)
                return if source_name != ""
                could_be_reference: bool = match expression:
                    Expr.Call(_, _, _, _) | Expr.Field(_, _, _) | Expr.Scope(_, _, _) | Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Slice(_, _, _, _) | Expr.RegionNew(_, _, _) | Expr.If(_, _, _, _) | Expr.Match(_, _, _) | Expr.Catch(_, _, _) | Expr.GetElse(_, _, _) | Expr.Block(_, _, _, _) | Expr.Refinement(_, _, _) | Expr.Construct(_, _, _) | Expr.RecordUpdate(_, _, _): true
                    Expr.Unary(operator, _, _): operator == TokenKind.Ampersand
                    Expr.Move(_, _) | Expr.Paren(_, _): true
                    Expr.Binary(_, _, _, _): true
                    _: false
                return if not could_be_reference or out.count > source_count
                for parameter_index in 0..<params.count |out, params|:
                    index: u32 = parameter_index.u32()
                    out.push(index) if destroyed_type_is_arena_reference(params[parameter_index].type_expression) and not any existing in out where existing == index


        def destroyed_summary_add_alias(name: sview, parameter_index: u32, alias_names: mutable darray[sview]&, alias_params: mutable darray[u32]&, changed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                exists: mutable bool = false
                for index in 0..<alias_names.count |exists, alias_names, alias_params, name, parameter_index|:
                    exists <- true if alias_names[index] == name and index < alias_params.count and alias_params[index] == parameter_index
                return if exists
                alias_names.push(name)
                alias_params.push(parameter_index)
                changed <- true


        def destroyed_summary_argument_index(parameter_name: sview, positional_index: u32, arguments: darray[Ast::Expr], argument_names: darray[sview]) -> u32:
            can Abort.Panic:
                for argument_index in 0..<argument_names.count:
                    return argument_index.u32() if argument_names[argument_index] == parameter_name
                named_seen: mutable bool = false
                for argument_name in argument_names |named_seen|:
                    named_seen <- true if argument_name != ""
                return NO_ARENA_SUMMARY_PARAM if named_seen
                return positional_index


        # Collect three declaration summaries in the same source-order walk. The view and
        # extern arrays preserve duplicates; local function names keep their first occurrence.
        def destroyed_collect_function_metadata(declarations: darray[Ast::Decl], view_fns: mutable darray[sview]&, local_function_names: mutable darray[sview]&, opaque_function_names: mutable darray[sview]&, opaque_function_starts: mutable darray[usize]&, opaque_function_arities: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                seen: mutable NameSet = empty_name_set()
                for existing in local_function_names |seen|:
                    name_set_add(seen, existing)
                destroyed_collect_function_metadata_tree(declarations, view_fns, local_function_names, seen, opaque_function_names, opaque_function_starts, opaque_function_arities)

        def destroyed_collect_function_metadata_tree(declarations: darray[Ast::Decl], view_fns: mutable darray[sview]&, local_function_names: mutable darray[sview]&, seen: mutable NameSet&, opaque_function_names: mutable darray[sview]&, opaque_function_starts: mutable darray[usize]&, opaque_function_arities: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |view_fns, local_function_names, seen, opaque_function_names, opaque_function_starts, opaque_function_arities|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            if not name_set_contains(seen, name):
                                name_set_add(seen, name)
                                local_function_names.push(name)
                            if return_type is declared_return:
                                view_fns.push(name) if return_type_is_view(declared_return) or return_tuple_type_has_view(declared_return)
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            opaque_function_names.push(name)
                            opaque_function_starts.push(param_start.usize())
                            opaque_function_arities.push(arity)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            destroyed_collect_function_metadata_tree(body, view_fns, local_function_names, seen, opaque_function_names, opaque_function_starts, opaque_function_arities)
                        _:
                            pass


        # Keep tiny local-reference lists allocation-free; promote larger lists to the
        # existing NameSet so repeated-name deduplication does not become quadratic.
        def destroyed_local_reference_name_add(name: sview, out: mutable darray[sview]&, seen: mutable NameSet&, indexed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                if indexed == true:
                    if not name_set_contains(seen, name):
                        name_set_add(seen, name)
                        out.push(name)
                    return
                for existing in out:
                    return if existing == name
                if out.count >= DESTROYED_REFERENCE_NAME_SET_THRESHOLD:
                    for existing_name in out |seen|:
                        name_set_add(seen, existing_name)
                    indexed <- true
                    name_set_add(seen, name)
                out.push(name)


        def destroyed_local_reference_name_index_reset(out: darray[sview]&, seen: mutable NameSet&, indexed: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                seen <- empty_name_set()
                indexed <- out.count >= DESTROYED_REFERENCE_NAME_SET_THRESHOLD
                if indexed == true:
                    for existing_name in out |seen|:
                        name_set_add(seen, existing_name)


        # Resolver references carry a BindingId owner, so local callable values are
        # recognized in the current function without mistaking an identically named
        # top-level function in another scope. The resolver maintains the shared owner
        # index as reference rows are recorded; fall back to the canonical scan if its
        # shape is ever inconsistent, and report incomplete names if that scan finds a
        # reference row with no matching spelling.
        def destroyed_scan_local_reference_names(function_owner: DeclId, table: SymbolTable&, out: mutable darray[sview]&, seen: mutable NameSet&, indexed: mutable bool&, out_complete: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                for reference_index in 0..<table.ref_binding_ids.count |function_owner, table, out, seen, indexed, out_complete|:
                    binding: BindingId = table.ref_binding_ids[reference_index]
                    if binding.owner.value == function_owner.value:
                        if reference_index < table.ref_name.count:
                            name: sview = table.ref_name[reference_index]
                            destroyed_local_reference_name_add(name, out, seen, indexed)
                        else:
                            out_complete <- false


        def destroyed_fallback_local_reference_names(function_owner: DeclId, table: SymbolTable&, out: mutable darray[sview]&, seen: mutable NameSet&, indexed: mutable bool&, mark: usize, out_complete: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.truncate(mark)
                destroyed_local_reference_name_index_reset(out, seen, indexed)
                out_complete <- table.ref_name.count == table.ref_binding_ids.count
                destroyed_scan_local_reference_names(function_owner, table, out, seen, indexed, out_complete)
