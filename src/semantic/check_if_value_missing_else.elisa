extend Semantic:
    private:
        # docs/125 branch totality — the ternary-requires-else invariant. An `if` used as
        # a VALUE must yield a value on every path, so it must have a final `else`. Two
        # syntaxes violate this, and both lower to the SAME node: an `Expr.If` whose
        # alternative is `Expr.Invalid`.
        #   - a bare ternary `a if c` with no `else` (parser leniently parses it to an
        #     Invalid-alt If; legal postfix guards `x <- a if c` / `EXPR if c` are
        #     destructured to `Stmt.If` in the parser and never reach here),
        #   - a docs/119 block-value tail `if c: …` with no `else`.
        # Stage0 rejects these as the parse error "expected else" (ternary) and the
        # semantic "docs/119 E7" (block-value); stage1 unifies them under one check.
        # Because legal guards are already `Stmt.If` by the time semantic runs, a
        # surviving Invalid-alt `Expr.If` is UNAMBIGUOUSLY the illegal case — the check
        # is false-positive-free by construction.
        def check_if_value_missing_else(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Ast::Decl.Func(func_name, func_params, func_return_type, func_body, func_effects, func_decorators, func_line):
                            table <- check_if_value_missing_else_statements(func_body, table)
                        Ast::Decl.Module(module_name, module_body, module_line):
                            table <- check_if_value_missing_else(module_body, table)
                        Ast::Decl.Scoped(scoped_body, scoped_line):
                            table <- check_if_value_missing_else(scoped_body, table)
                        _:
                            pass


        # Walk all statements, recursing into nested bodies and match arms.
        def check_if_value_missing_else_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Ast::Stmt.Expr(expression, line):
                            table <- check_if_value_missing_else_expression(expression, table)
                        Ast::Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_if_value_missing_else_expression(value, table)
                        Ast::Stmt.Assign(target, operator, value, line):
                            table <- check_if_value_missing_else_expression(target, table)
                            table <- check_if_value_missing_else_expression(value, table)
                        Ast::Stmt.If(condition, then_body, else_body, line):
                            table <- check_if_value_missing_else_expression(condition, table)
                            table <- check_if_value_missing_else_statements(then_body, table)
                            table <- check_if_value_missing_else_statements(else_body, table)
                        Ast::Stmt.While(condition, body, line):
                            table <- check_if_value_missing_else_expression(condition, table)
                            table <- check_if_value_missing_else_statements(body, table)
                        Ast::Stmt.For(bind, variables, iterable, body, line):
                            table <- check_if_value_missing_else_expression(iterable, table)
                            table <- check_if_value_missing_else_statements(body, table)
                        Ast::Stmt.Block(kind, clause, binding, body, line):
                            table <- check_if_value_missing_else_statements(body, table)
                        Ast::Stmt.Match(scrutinee, arms, line):
                            table <- check_if_value_missing_else_expression(scrutinee, table)
                            for arm in arms |table| -> table:
                                table <- check_if_value_missing_else_expression(arm.guard, table)
                                table <- check_if_value_missing_else_statements(arm.body, table)
                        Ast::Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_if_value_missing_else_expression(return_value, table)
                        Ast::Stmt.Contract(kind, expression, line):
                            table <- check_if_value_missing_else_expression(expression, table)
                        Ast::Stmt.Invalid:
                            pass
                        Ast::Stmt.Break(label, line):
                            pass
                        Ast::Stmt.Continue(label, line):
                            pass


        # Recursively walk all expressions. At each conditional expression, flag a missing
        # `else` (Invalid alternative), then recurse into every sub-expression.
        def check_if_value_missing_else_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.If(condition, then_expr, else_expr, line):
                        else_is_invalid: bool = match else_expr:
                            Ast::Expr.Invalid: true
                            _: false
                        if else_is_invalid:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IfValueMissingElse, name: "", line: line, expected: "", actual: ""})
                        table <- check_if_value_missing_else_expression(condition, table)
                        table <- check_if_value_missing_else_expression(then_expr, table)
                        table <- check_if_value_missing_else_expression(else_expr, table)
                    Ast::Expr.Binary(left, operator, right, line):
                        table <- check_if_value_missing_else_expression(left, table)
                        table <- check_if_value_missing_else_expression(right, table)
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        table <- check_if_value_missing_else_expression(callee, table)
                        for argument in arguments |table| -> table:
                            table <- check_if_value_missing_else_expression(argument, table)
                    Ast::Expr.Field(object, field, line):
                        table <- check_if_value_missing_else_expression(object, table)
                    Ast::Expr.Scope(base, name, line):
                        table <- check_if_value_missing_else_expression(base, table)
                    Ast::Expr.Index(object, index, line):
                        table <- check_if_value_missing_else_expression(object, table)
                        table <- check_if_value_missing_else_expression(index, table)
                    Ast::Expr.Slice(object, low, high, line):
                        table <- check_if_value_missing_else_expression(object, table)
                        table <- check_if_value_missing_else_expression(low, table)
                        table <- check_if_value_missing_else_expression(high, table)
                    Ast::Expr.IndexN(object, arguments, line):
                        table <- check_if_value_missing_else_expression(object, table)
                        for argument in arguments |table| -> table:
                            table <- check_if_value_missing_else_expression(argument, table)
                    Ast::Expr.Unary(operator, operand, line):
                        table <- check_if_value_missing_else_expression(operand, table)
                    Ast::Expr.Paren(inner, line):
                        table <- check_if_value_missing_else_expression(inner, table)
                    Ast::Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- check_if_value_missing_else_expression(element, table)
                    Ast::Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- check_if_value_missing_else_expression(element, table)
                    Ast::Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- check_if_value_missing_else_expression(element, table)
                    Ast::Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- check_if_value_missing_else_expression(entry.key, table)
                            table <- check_if_value_missing_else_expression(entry.value, table)
                    Ast::Expr.Construct(type_expression, fields, line):
                        table <- check_if_value_missing_else_expression(type_expression, table)
                        for field in fields |table| -> table:
                            table <- check_if_value_missing_else_expression(field.value, table)
                    Ast::Expr.RecordUpdate(base, fields, line):
                        table <- check_if_value_missing_else_expression(base, table)
                        for field in fields |table| -> table:
                            table <- check_if_value_missing_else_expression(field.value, table)
                    Ast::Expr.Match(scrutinee, arms, line):
                        table <- check_if_value_missing_else_expression(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- check_if_value_missing_else_expression(arm.guard, table)
                            table <- check_if_value_missing_else_statements(arm.body, table)
                    Ast::Expr.Comprehension(var, iterable, condition, body, line):
                        table <- check_if_value_missing_else_expression(iterable, table)
                        table <- check_if_value_missing_else_expression(condition, table)
                        table <- check_if_value_missing_else_expression(body, table)
                    Ast::Expr.Lambda(parameters, body, line):
                        table <- check_if_value_missing_else_statements(body, table)
                    Ast::Expr.Block(statements, value, captures, line):
                        table <- check_if_value_missing_else_statements(statements, table)
                        table <- check_if_value_missing_else_expression(value, table)
                    Ast::Expr.Invalid:
                        pass
                    Ast::Expr.IntLit(value):
                        pass
                    Ast::Expr.FloatLit(text):
                        pass
                    Ast::Expr.StringLit(text):
                        pass
                    Ast::Expr.CharLit(text):
                        pass
                    Ast::Expr.BoolLit(value):
                        pass
                    Ast::Expr.Ident(name, line):
                        pass
                    Ast::Expr.ShorthandMember(parts, line):
                        pass
