# A REFUTED obligation and an UNPROVEN one are the same defect seen by two passes: the
# refuter decides the argument provably fails the contract, the prover only fails to
# discharge it. stage0 prints the refutation alone. Measured over the internal suite:
# of its 81 lines that carry a `... is violated` message, not one also carries a
# `could not be proven` message -- the only message ever sharing such a line is an
# unrelated `cannot assign to immutable local`. stage1 ran both passes and printed both,
# so every refuted call site reported twice.
#
# The decision is made per LINE, not per (name, line): the two sentences disagree about
# the name. The prover invents pseudo-names for the obligations it cannot attribute to a
# callee (`"requires"`, `"return where refinement"`, `"where refinement on field"`), while
# the refuter names the callee. A line is the granularity stage0's own output makes
# observable, and it is the granularity the suppression has to work at.
#
# Applied on the way OUT, in check_full_diagnostics, for the same reason the `ensure`
# dedupe is: the refuter and the provers are independent checks that run in an arbitrary
# order, and a locally built replacement for `table.diagnostics` escapes its `in auto:`
# scope, which stage0 rejects outright.

extend Semantic:
    private:
        # A diagnostic that says an obligation is PROVABLY broken.
        def diagnostic_refutes_obligation(kind: DiagnosticKind) -> bool:
            can Abort.Panic:
                return match kind:
                    DiagnosticKind.LocalWhereRefinementViolated:    true
                    DiagnosticKind.ParametricIndexViolated:         true
                    DiagnosticKind.PreconditionProvablyViolated:    true
                    DiagnosticKind.PreconditionViolated:            true
                    DiagnosticKind.RefinementBoundViolated:         true
                    DiagnosticKind.StructFieldRefinementViolated:   true
                    DiagnosticKind.UsesPreconditionViolated:        true
                    DiagnosticKind.WhereRefinementReassignViolated: true
                    _:                                              false

        # A diagnostic that says an obligation could not be DISCHARGED. `EnsureNotProven` is
        # absent on purpose: a refuted postcondition is reported through that same kind with
        # `detail == "violated"`, so its refutation is matched by name and line in the ensure
        # pass instead.
        def diagnostic_leaves_obligation_open(kind: DiagnosticKind) -> bool:
            can Abort.Panic:
                return match kind:
                    DiagnosticKind.LocalRefinementUnproven:      true
                    DiagnosticKind.PreconditionUnproven:         true
                    DiagnosticKind.StructFieldRefinementUnproven: true
                    DiagnosticKind.QuantifiedRefinementUnproven: true
                    DiagnosticKind.RefinementArgNotProven:       true
                    DiagnosticKind.RefinementReturnNotProven:    true
                    _:                                            false
