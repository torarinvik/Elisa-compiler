# Stage1 abstract-effect validation — OPERATION SIGNATURES. The compact AST does not materialize
# an abstract effect body, so an operation's ABI-relevant shape (parameter count, mutability and
# type spellings, with the effect's own generic parameters specialized away) is recovered from
# the source spelling here, and a handler is matched against it.
# Continues check_abstract_effects.elisa.

extend Semantic:
    private:

        # The compact AST intentionally does not materialize an abstract effect body. The
        # parser therefore keeps each operation's source signature in an ordinal side-table
        # (3900000081 name, 3900000082 signature). Resolve that signature without introducing
        # a second declaration namespace or a runtime effect descriptor.
        def ae_effect_operation_signature(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview, operation: sview) -> sview:
            wanted: mutable usize = 0
            operation_index: mutable usize = 0
            found: mutable bool = false
            for annotation in annotations |wanted, operation_index, found|:
                if annotation.owner == effect_name and annotation.line == 3900000081:
                    wanted <- operation_index if not found and annotation.name == operation
                    found <- true if annotation.name == operation
                    operation_index <- operation_index + 1.usize()
            return sview("", 0, 0) if not found
            signature_index: mutable usize = 0
            for annotation in annotations |signature_index, wanted|:
                if annotation.owner == effect_name and annotation.line == 3900000082:
                    return annotation.name if signature_index == wanted
                    signature_index <- signature_index + 1.usize()
            return sview("", 0, 0)



        def ae_handler_operation_signature(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview, operation: sview) -> sview:
            wanted: mutable usize = 0
            operation_index: mutable usize = 0
            found: mutable bool = false
            for annotation in annotations |wanted, operation_index, found|:
                if annotation.owner == handler_name and annotation.line == 3900000083:
                    wanted <- operation_index if not found and annotation.name == operation
                    found <- true if annotation.name == operation
                    operation_index <- operation_index + 1.usize()
            return sview("", 0, 0) if not found
            signature_index: mutable usize = 0
            for annotation in annotations |signature_index, wanted|:
                if annotation.owner == handler_name and annotation.line == 3900000089:
                    return annotation.name if signature_index == wanted
                    signature_index <- signature_index + 1.usize()
            return sview("", 0, 0)



        def ae_effect_generic_names(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                for annotation in annotations |names|:
                    names.push(annotation.name) if annotation.owner == effect_name and annotation.line == 3900000090
                return names



        def ae_trim_signature_view(view: sview) -> sview:
            start: mutable usize = 0
            finish: mutable usize = sview_len(view)
            while start < finish and (sview_at(view, start) == 32 or sview_at(view, start) == 9 or sview_at(view, start) == 13) |start, finish, view|:
                start <- start + 1.usize()
            while finish > start and (sview_at(view, finish - 1.usize()) == 32 or sview_at(view, finish - 1.usize()) == 9 or sview_at(view, finish - 1.usize()) == 13) |finish, start, view|:
                finish <- finish - 1.usize()
            return view[start:finish]



        # Extract `Writer[sview, File]`'s application arguments. The result is a list of
        # source views, so no type/value is allocated and the realization remains compile-time
        # metadata only.
        def ae_effect_ref_arguments(effect_ref: sview) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                values: mutable darray[sview] = []
                open_bracket: mutable usize = 0
                while open_bracket < sview_len(effect_ref) and sview_at(effect_ref, open_bracket) != 91 |open_bracket, effect_ref|:
                    open_bracket <- open_bracket + 1.usize()
                return values if open_bracket >= sview_len(effect_ref)
                start: mutable usize = open_bracket + 1.usize()
                cursor: mutable usize = start
                depth: mutable int = 0
                while cursor < sview_len(effect_ref) |cursor, start, depth, effect_ref, values|:
                    byte: u8 = sview_at(effect_ref, cursor)
                    at_end: bool = byte == 93 and depth == 0
                    at_comma: bool = byte == 44 and depth == 0
                    if at_end or at_comma:
                        item: sview = ae_trim_signature_view(effect_ref[start:cursor])
                        values.push(item) if sview_len(item) > 0
                        break if at_end
                        start <- cursor + 1.usize()
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                    cursor <- cursor + 1.usize()
                return values



        def ae_signature_ident_byte(byte: u8) -> bool:
            return true if byte >= 65 and byte <= 90
            return true if byte >= 97 and byte <= 122
            return true if byte >= 48 and byte <= 57
            return byte == 95



        def ae_signature_word_at(signature: sview, start: usize, word: sview) -> bool:
            return false if start + sview_len(word) > sview_len(signature)
            return false if start > 0.usize() and ae_signature_ident_byte(sview_at(signature, start - 1.usize()))
            index: mutable usize = 0
            while index < sview_len(word) |index, signature, word|:
                return false if sview_at(signature, start + index) != sview_at(word, index)
                index <- index + 1.usize()
            return false if start + sview_len(word) < sview_len(signature) and ae_signature_ident_byte(sview_at(signature, start + sview_len(word)))
            return true



        def ae_signature_word_in_range(signature: sview, start: usize, end: usize, word: sview) -> bool:
            cursor: mutable usize = start
            while cursor < end |cursor, signature, end, word|:
                if ae_signature_ident_byte(sview_at(signature, cursor)):
                    word_start: usize = cursor
                    while cursor < end and ae_signature_ident_byte(sview_at(signature, cursor)) |cursor, signature, end|:
                        cursor <- cursor + 1.usize()
                    word_length: usize = cursor - word_start
                    if word_length == sview_len(word):
                        matches: mutable bool = true
                        for word_index in 0..<word_length |matches, signature, word, word_start|:
                            matches <- false if sview_at(signature, word_start + word_index) != sview_at(word, word_index)
                        return true if matches
                else:
                    cursor <- cursor + 1.usize()
            return false



        def ae_signature_append_range(signature: sview, start: usize, end: usize, out: mutable darray[u8]&) -> void:
            for index in start..<end |signature, out|:
                byte: u8 = sview_at(signature, index)
                out.push(byte) if byte != 32 and byte != 9 and byte != 13



        def ae_signature_generic_index(signature: sview, start: usize, end: usize, names: darray[sview]) -> i64:
            candidate_length: usize = end - start
            for name_index in 0..<names.count |name_index, signature, start, candidate_length|:
                continue if sview_len(names[name_index]) != candidate_length
                matches: mutable bool = true
                for character_index in 0..<candidate_length |matches, signature, names, name_index, start|:
                    matches <- false if sview_at(signature, start + character_index) != sview_at(names[name_index], character_index)
                return name_index.i64() if matches
            return -1



        # Append a type spelling while specializing exact effect parameters (`T` -> `sview`,
        # including nested forms such as `darray[T]`). Generic names are tokenized here so a
        # type named `Task` cannot accidentally substitute a parameter named `T`.
        def ae_signature_append_type_range(signature: sview, start: usize, end: usize, names: darray[sview], values: darray[sview], out: mutable darray[u8]&) -> void:
            cursor: mutable usize = start
            while cursor < end |cursor, signature, end, names, values, out|:
                if ae_signature_ident_byte(sview_at(signature, cursor)):
                    word_start: usize = cursor
                    while cursor < end and ae_signature_ident_byte(sview_at(signature, cursor)) |cursor, signature, end|:
                        cursor <- cursor + 1.usize()
                    generic_index: i64 = ae_signature_generic_index(signature, word_start, cursor, names)
                    if generic_index >= 0 and generic_index.usize() < values.count:
                        ae_signature_append_range(values[generic_index.usize()], 0, sview_len(values[generic_index.usize()]), out)
                    else:
                        ae_signature_append_range(signature, word_start, cursor, out)
                else:
                    byte: u8 = sview_at(signature, cursor)
                    out.push(byte) if byte != 32 and byte != 9 and byte != 13
                    cursor <- cursor + 1.usize()



        # Build an ABI-relevant operation shape: parameter count, mutability, parameter type
        # spellings, and return type. Parameter NAMES, default values, handler-local effect
        # grants, and the declaration body's trailing colon are excluded. This is deliberately
        # a small signature lexer rather than a general parser: nested tuple/function/container
        # types are retained byte-for-byte after whitespace normalization.
        def ae_signature_shape(signature: sview, generic_names: darray[sview], generic_values: darray[sview]) -> darray[u8]:
            can Memory.Allocate, Abort.Panic:
                out: mutable darray[u8] = []
                out.push(80) # P
                open_paren: mutable usize = 0
                while open_paren < sview_len(signature) and sview_at(signature, open_paren) != 40 |open_paren, signature|:
                    open_paren <- open_paren + 1.usize()
                if open_paren < sview_len(signature):
                    close_paren: mutable usize = open_paren + 1.usize()
                    depth: mutable int = 1
                    while close_paren < sview_len(signature) and depth > 0 |close_paren, depth, signature|:
                        depth <- depth + 1 if sview_at(signature, close_paren) == 40
                        depth <- depth - 1 if sview_at(signature, close_paren) == 41
                        close_paren <- close_paren + 1.usize()
                    close_paren <- close_paren - 1.usize() if close_paren > open_paren and depth == 0
                    parameter_start: mutable usize = open_paren + 1.usize()
                    cursor: mutable usize = parameter_start
                    nested: mutable int = 0
                    while cursor <= close_paren and cursor <= sview_len(signature) |cursor, parameter_start, nested, close_paren, signature, out|:
                        at_end: bool = cursor == close_paren or cursor >= sview_len(signature)
                        at_separator: bool = not at_end and nested == 0 and sview_at(signature, cursor) == 44
                        if at_end or at_separator:
                            segment_end: usize = cursor
                            has_content: mutable bool = false
                            for content_index in parameter_start..<segment_end |has_content, signature|:
                                byte: u8 = sview_at(signature, content_index)
                                has_content <- true if byte != 32 and byte != 9 and byte != 13
                            if has_content:
                                colon: mutable usize = segment_end
                                segment_depth: mutable int = 0
                                scan: mutable usize = parameter_start
                                while scan < segment_end |scan, colon, segment_depth, signature, segment_end|:
                                    byte: u8 = sview_at(signature, scan)
                                    colon <- scan if byte == 58 and segment_depth == 0 and colon == segment_end
                                    segment_depth <- segment_depth + 1 if byte == 40 or byte == 91 or byte == 123
                                    segment_depth <- segment_depth - 1 if segment_depth > 0 and (byte == 41 or byte == 93 or byte == 125)
                                    scan <- scan + 1.usize()
                                out.push(59) # ; starts one parameter
                                if colon < segment_end:
                                    out.push(77) if ae_signature_word_in_range(signature, parameter_start, colon, "mutable")
                                    type_start: usize = colon + 1.usize()
                                    type_end: mutable usize = segment_end
                                    type_depth: mutable int = 0
                                    type_scan: mutable usize = type_start
                                    while type_scan < segment_end |type_scan, type_end, type_depth, signature, segment_end|:
                                        type_byte: u8 = sview_at(signature, type_scan)
                                        type_end <- type_scan if type_byte == 61 and type_depth == 0
                                        type_depth <- type_depth + 1 if type_byte == 40 or type_byte == 91 or type_byte == 123
                                        type_depth <- type_depth - 1 if type_depth > 0 and (type_byte == 41 or type_byte == 93 or type_byte == 125)
                                        type_scan <- type_scan + 1.usize()
                                    ae_signature_append_type_range(signature, type_start, type_end, generic_names, generic_values, out)
                                else:
                                    # An untyped/variadic operation parameter is not a valid
                                    # effect ABI, but preserving its spelling makes the mismatch
                                    # deterministic instead of silently accepting it.
                                    ae_signature_append_range(signature, parameter_start, segment_end, out)
                            parameter_start <- cursor + 1.usize()
                        nested <- nested + 1 if not at_end and sview_at(signature, cursor) == 40 or (not at_end and sview_at(signature, cursor) == 91) or (not at_end and sview_at(signature, cursor) == 123)
                        nested <- nested - 1 if not at_end and nested > 0 and (sview_at(signature, cursor) == 41 or sview_at(signature, cursor) == 93 or sview_at(signature, cursor) == 125)
                        cursor <- cursor + 1.usize()
                    arrow: mutable usize = close_paren + 1.usize()
                    while arrow + 1.usize() < sview_len(signature) |arrow, signature|:
                        break if sview_at(signature, arrow) == 45 and sview_at(signature, arrow + 1.usize()) == 62
                        arrow <- arrow + 1.usize()
                    out.push(82) # R
                    if arrow + 1.usize() < sview_len(signature):
                        return_start: usize = arrow + 2.usize()
                        return_end: mutable usize = sview_len(signature)
                        return_depth: mutable int = 0
                        return_scan: mutable usize = return_start
                        while return_scan < sview_len(signature) |return_scan, return_end, return_depth, signature|:
                            return_byte: u8 = sview_at(signature, return_scan)
                            break_at_clause: mutable bool = return_byte == 58 and return_depth == 0
                            break_at_clause <- true if return_depth == 0 and (ae_signature_word_at(signature, return_scan, "can") or ae_signature_word_at(signature, return_scan, "requires") or ae_signature_word_at(signature, return_scan, "ensures") or ae_signature_word_at(signature, return_scan, "decreases"))
                            return_end <- return_scan if break_at_clause
                            return_depth <- return_depth + 1 if return_byte == 40 or return_byte == 91 or return_byte == 123
                            return_depth <- return_depth - 1 if return_depth > 0 and (return_byte == 41 or return_byte == 93 or return_byte == 125)
                            return_scan <- return_scan + 1.usize()
                        ae_signature_append_type_range(signature, return_start, return_end, generic_names, generic_values, out)
                    else:
                        out.extend("void")
                else:
                    out.extend("P;Rvoid")
                return out



        def ae_signature_matches(left: sview, right: sview, generic_names: darray[sview], generic_values: darray[sview]) -> bool:
            can Memory.Allocate, Abort.Panic:
                no_generic_names: darray[sview] = []
                no_generic_values: darray[sview] = []
                left_shape: darray[u8] = ae_signature_shape(left, generic_names, generic_values)
                right_shape: darray[u8] = ae_signature_shape(right, no_generic_names, no_generic_values)
                return false if left_shape.count != right_shape.count
                for index in 0..<left_shape.count |left_shape, right_shape|:
                    return false if left_shape[index] != right_shape[index]
                return true
