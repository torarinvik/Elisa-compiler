# Checked decimal steps for the bit-int width parser.
# A width is supported only in [0, 63]. Every multiply sees a prefix <= 63 and
# digit <= 9, so its intermediate is at most 639 even for unbounded input text.
module SemanticBitIntWidth:
    public:
        const BIT_INT_PREFIX_MIN: i64 = 0
        const BIT_INT_MIN_WIDTH: i64 = 1
        const BIT_INT_MAX_WIDTH: i64 = 63
        const BIT_INT_WIDTH_LIMIT: i64 = BIT_INT_MAX_WIDTH + 1
        const DECIMAL_RADIX: i64 = 10
        const DECIMAL_DIGIT_MIN: i64 = 0
        const DECIMAL_DIGIT_MAX: i64 = DECIMAL_RADIX - 1
        const ASCII_DIGIT_ZERO: u8 = 48
        const ASCII_DIGIT_NINE: u8 = 57
        const MAX_WIDTH_CANDIDATE: i64 = BIT_INT_MAX_WIDTH * DECIMAL_RADIX + DECIMAL_DIGIT_MAX
        const I64_MAX: i64 = 9223372036854775807

        # Parsing starts from the empty prefix (width 0), but a complete bit-int
        # type must have at least one bit. Keep this distinction explicit so
        # callers cannot accidentally accept u0/i0.
        def supported_final_width(width: i64) -> bool:
            ensure result == (width >= BIT_INT_MIN_WIDTH and width <= BIT_INT_MAX_WIDTH)
            return width >= BIT_INT_MIN_WIDTH and width <= BIT_INT_MAX_WIDTH

        def append_digit(width: i64, digit: i64) -> (valid: bool, value: i64):
            ensure (width >= BIT_INT_PREFIX_MIN and width <= BIT_INT_MAX_WIDTH and digit >= DECIMAL_DIGIT_MIN and digit <= DECIMAL_DIGIT_MAX) implies result.valid == (width * DECIMAL_RADIX + digit <= BIT_INT_MAX_WIDTH)
            ensure result.valid implies (result.value >= BIT_INT_PREFIX_MIN and result.value <= BIT_INT_MAX_WIDTH)
            ensure result.valid implies result.value == width * DECIMAL_RADIX + digit
            ensure not result.valid implies result.value == 0
            return (false, 0) if width < BIT_INT_PREFIX_MIN or width > BIT_INT_MAX_WIDTH or digit < DECIMAL_DIGIT_MIN or digit > DECIMAL_DIGIT_MAX
            candidate: i64 = width * DECIMAL_RADIX + digit
            return (false, 0) if candidate > BIT_INT_MAX_WIDTH
            return (true, candidate)

        # The unsigned 63-bit maximum is i64::MAX. Keeping this named value
        # separate prevents the parser from forming 2^63 and subtracting one.
        def unsigned_63_high_endpoint() -> i64:
            ensure result == I64_MAX
            return I64_MAX
