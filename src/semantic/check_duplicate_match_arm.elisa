# Duplicate match arm check — detects literal pattern duplicates within a single match.
# Variant-pattern duplicates are handled by UnreachableMatchArm in resolve_enums.
#
# This check walks all match expressions and statements, collecting literal patterns
# within each match. If a literal text repeats, the later arm is flagged as DuplicateMatchArm.

extend Semantic:
    private:
        # Recursively check for duplicate literal patterns in statements.
        def check_duplicate_match_arm_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- check_duplicate_match_arm_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_duplicate_match_arm_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_duplicate_match_arm_expression(target, table)
                            table <- check_duplicate_match_arm_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_duplicate_match_arm_expression(condition, table)
                            table <- check_duplicate_match_arm_statements(then_body, table)
                            table <- check_duplicate_match_arm_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_duplicate_match_arm_expression(condition, table)
                            table <- check_duplicate_match_arm_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_duplicate_match_arm_expression(iterable, table)
                            table <- check_duplicate_match_arm_statements(body, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_duplicate_match_arm_expression(return_value, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_duplicate_match_arm_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_duplicate_match_arm_expression(scrutinee, table)
                            table <- check_duplicate_match_arm_match_arms(arms, line.line, table)
                            for arm in arms |table|:
                                table <- check_duplicate_match_arm_statements(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- check_duplicate_match_arm_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Recursively check for duplicate literal patterns in expressions.
        def check_duplicate_match_arm_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_duplicate_match_arm_expression(callee, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_match_arm_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- check_duplicate_match_arm_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- check_duplicate_match_arm_expression(base, table)
                    Expr.Index(object, index, line):
                        table <- check_duplicate_match_arm_expression(object, table)
                        table <- check_duplicate_match_arm_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- check_duplicate_match_arm_expression(object, table)
                        table <- check_duplicate_match_arm_expression(low, table)
                        table <- check_duplicate_match_arm_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- check_duplicate_match_arm_expression(object, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_match_arm_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_duplicate_match_arm_expression(left, table)
                        table <- check_duplicate_match_arm_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_duplicate_match_arm_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- check_duplicate_match_arm_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_match_arm_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_match_arm_expression(element, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_match_arm_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- check_duplicate_match_arm_expression(entry.key, table)
                            table <- check_duplicate_match_arm_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- check_duplicate_match_arm_expression(type_expression, table)
                        for field in fields |table|:
                            table <- check_duplicate_match_arm_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- check_duplicate_match_arm_expression(base, table)
                        for field in fields |table|:
                            table <- check_duplicate_match_arm_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- check_duplicate_match_arm_expression(condition, table)
                        table <- check_duplicate_match_arm_expression(then_expr, table)
                        table <- check_duplicate_match_arm_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- check_duplicate_match_arm_expression(scrutinee, table)
                        table <- check_duplicate_match_arm_match_arms(arms, line.line, table)
                        for arm in arms |table|:
                            table <- check_duplicate_match_arm_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- check_duplicate_match_arm_expression(iterable, table)
                        table <- check_duplicate_match_arm_expression(condition, table)
                        table <- check_duplicate_match_arm_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- check_duplicate_match_arm_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- check_duplicate_match_arm_statements(statements, table)
                        table <- check_duplicate_match_arm_expression(value, table)
                    _:
                        # Ident, IntLit, FloatLit, StringLit, CharLit, BoolLit, ShorthandMember, Invalid, etc.
                        # These require no recursion into sub-expressions
                        pass


        # Check a single match's arms for duplicate literal and constructor patterns.
        # Variant payloads are classified inline because parser payloads are borrowed
        # side-table values; the explicit scan preserves the constructor shape while
        # avoiding a second borrow through the general enum resolver.
        def check_duplicate_match_arm_match_arms(arms: darray[Ast::MatchArm], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Collect literal texts from arms; later duplicates get flagged.
                seen: mutable darray[sview] = []
                seen_variants: mutable darray[sview] = []
                for arm in arms |table, seen, seen_variants|:
                    match arm.pattern:
                        Pattern.Literal(text):
                            # Check if this literal was already seen
                            is_duplicate: bool = any previous_text in seen where previous_text == text
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateMatchArm, name: text, line: line, expected: "", actual: ""}) if is_duplicate
                            seen.push(text) if not is_duplicate
                        Pattern.Variant(path, fields):
                            # A guard can fail, so a guarded arm never dominates a
                            # later arm. Empty payloads and binder/wildcard-only payloads
                            # cover their complete constructor; literal and nested
                            # constructor payloads remain reachable separately.
                            guarded: bool = match arm.guard:
                                Expr.Invalid: false
                                Expr.Absent: false
                                _:            true
                            dominates_variant: mutable bool = true
                            for field in fields |dominates_variant|:
                                match field:
                                    Pattern.Wildcard:
                                        pass
                                    Pattern.Binding(binding_name):
                                        pass
                                    _:
                                        dominates_variant <- false
                            is_duplicate: bool = dominates_variant and any previous_path in seen_variants where previous_path == path
                            arm_line: u32 = statement_line(arm.body[0]) if arm.body.count > 0 else line
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnreachableMatchArm, name: path, line: arm_line, expected: "", actual: ""}) if is_duplicate
                            seen_variants.push(path) if dominates_variant and not is_duplicate and not guarded
                        _:
                            # Bindings, wildcards, and other composite patterns are ignored.
                            pass


    public:
        # Entry point: check all function bodies for duplicate literal match arms.
        def check_duplicate_match_arm(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_duplicate_match_arm_impl(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_duplicate_match_arm(body, table)
                        Decl.Scoped(body, line):
                            table <- check_duplicate_match_arm(body, table)
                        _:
                            pass


        # Helper to recurse into declaration bodies.
        def check_duplicate_match_arm_impl(body: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_duplicate_match_arm_statements(body, table)
