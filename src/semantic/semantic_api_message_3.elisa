# Stage1 semantic — `diagnostic_message` part 3 of 4 (`extend Semantic: private:`):
# the wording for type-mismatch, flow, and region diagnostics.
#
# One `match diagnostic.kind:` arm per kind does not fit in a 600-line file, so the arms
# are split across parts and each part reports through `handled`. A part that matches no
# arm leaves `handled` false and the dispatcher in semantic_api.elisa tries the next one,
# so an unmatched kind still reaches every part exactly as one flat match would.

extend Semantic:
    private:
        def diagnostic_message_part3(diagnostic: Diagnostic, buffer: mutable darray[u8]&, handled: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                handled <- true
                match diagnostic.kind:
                    DiagnosticKind.ReadonlyViewIndexAssign:
                        push_str(buffer, "cannot assign to read-only view index result")

                    DiagnosticKind.StringViewIndexAssign:
                        push_str(buffer, "cannot assign to string view index")

                    DiagnosticKind.StringIndexAssign:
                        push_str(buffer, "cannot assign to string index")

                    DiagnosticKind.MutableViewFromReadonlySource:
                        push_str(buffer, "cannot create a mutable view from a read-only source")

                    DiagnosticKind.MutableIterationReadonlyView:
                        push_str(buffer, "mutable iteration requires a writable view")

                    DiagnosticKind.UnknownRegionBacking:
                        buffer.extend(f"unknown region backing \"{diagnostic.name}\"")

                    DiagnosticKind.RegionLinearAllocation:
                        buffer.extend(f"cannot allocate a value containing linear handles into region \"{diagnostic.name}\": a region frees its contents in bulk (destroy/reset) without consuming them, so the linear value could never be consumed; keep it outside the region and store a borrow, or consume it explicitly")

                    DiagnosticKind.RegionAnnotationOnNonRegionLocal:
                        buffer.extend(f"region annotation `@{diagnostic.actual}` on local '{diagnostic.name}' is invalid; this type cannot carry a region")

                    DiagnosticKind.UnknownRegionQualifier:
                        buffer.extend(f"unknown region qualifier \"{diagnostic.actual}\"")

                    DiagnosticKind.RegionQualifierMismatch:
                        buffer.extend(f"variable \"{diagnostic.name}\" expects {diagnostic.detail}& @{diagnostic.expected}, got {diagnostic.detail}& @{diagnostic.actual}")

                    DiagnosticKind.LocalRegionReferenceEscape:
                        buffer.extend(f"cannot return reference: region dependency facts include local region \"{diagnostic.actual}\"")

                    DiagnosticKind.RegionParamInferenceFailure:
                        buffer.extend(f"value tied to region parameter \"__rg_{diagnostic.name}\" cannot be returned with a region-less type (its lifetime is the caller's \"__rg_{diagnostic.name}\" region); annotate the return type with `@__rg_{diagnostic.name}` (e.g. `-> view[u8] @__rg_{diagnostic.name}`) so the borrow stays tied to the caller's region") if diagnostic.name != ""
                        buffer.extend(f"value tied to region parameter \"{diagnostic.actual}\" cannot be returned with a region-less type") if diagnostic.name == ""

                    DiagnosticKind.EmptyArrayWithoutContext:
                        push_str(buffer, "empty list literal requires an expected array or darray type")

                    DiagnosticKind.LegacyCastCallSyntax:
                        push_str(buffer, "legacy cast syntax `.cast[T]()` is no longer supported")

                    DiagnosticKind.RemovedRefShorthand:
                        push_str(buffer, "`x.ref[T]` reference shorthand has been removed")

                    DiagnosticKind.RemovedPackedAbiAnnotation:
                        buffer.extend(f"@packed_abi on enum \"{diagnostic.name}\" has been removed; use @packed_profile(canonical|retained_reads|build_heavy) instead")

                    DiagnosticKind.RemovedPackedPrefixAnnotation:
                        buffer.extend(f"@packed_prefix on enum \"{diagnostic.name}\" has been removed; use @packed_profile(canonical|retained_reads|build_heavy) instead")

                    DiagnosticKind.RemovedCbindPrefixAnnotation:
                        buffer.extend("@c_bind_prefix has been removed; use @c_bind with a trailing `prefix` flag, e.g. @c_bind(header, name, prefix)")

                    DiagnosticKind.OptionalComparison:
                        buffer.extend(f"cannot compare {diagnostic.expected}? and {diagnostic.actual}?: unwrap the optional first (compare against null, or bind the value with `if EXPR is NAME:`)")

                    DiagnosticKind.ForwardingVariadic:
                        buffer.extend(f"call argument forwarding `..` is not supported for variadic function \"{diagnostic.name}\"")

                    DiagnosticKind.IdUnwrapNonId:
                        buffer.extend(f"id unwrap operator requires id[T] operand, got {diagnostic.actual}")

                    DiagnosticKind.ReadOnlyViewAssign:
                        buffer.extend("cannot assign to read-only view index result")

                    DiagnosticKind.RowIdNonSoa:
                        buffer.extend(f"RowId expects an soa type argument, got {diagnostic.actual}")

                    DiagnosticKind.SparseRequiresSoa:
                        buffer.extend(f"enum \"{diagnostic.name}\": `(sparse)` requires `layout(soa)` (variant-sparse payload columns)")

                    DiagnosticKind.IterCalleeMutableRef:
                        buffer.extend(f"cannot pass \"{diagnostic.name}\" by mutable reference while it is being iterated: the callee may push/clear/relocate its buffer out from under the loop. Iterate by index up to a saved count, or collect into a separate darray first")

                    DiagnosticKind.LawSubjectTypeMismatch:
                        buffer.extend(f"argument 1 to \"{diagnostic.name}\" expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.RefinementSubjectMismatch:
                        buffer.extend(f"refinement \"{diagnostic.name}\" expects a subject of type {diagnostic.expected}, but the refined type is {diagnostic.actual}")

                    DiagnosticKind.CBindRequiresCLayout:
                        buffer.extend(f"@c_bind on struct \"{diagnostic.name}\" requires `layout(c)` so Elisa and C agree on ABI layout rules")

                    DiagnosticKind.CopyRuntimeLength:
                        buffer.extend(f"copy requires a statically known size; darray[{diagnostic.actual}] has a runtime length — use clone to copy it into a region-owned darray")

                    DiagnosticKind.CopyScalarTarget:
                        buffer.extend(f"copy target must be a fixed-size array[T, N] stack owner with a compile-time size; got {diagnostic.actual}")

                    DiagnosticKind.CopySizeMismatch:
                        buffer.extend(f"copy cannot copy array[{diagnostic.actual}, ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f"] into array[{diagnostic.actual}, ")
                        push_int(buffer, diagnostic.actual_count.i64())
                        buffer.extend(f"] in v1")

                    DiagnosticKind.PackedStoreIndexAssign:
                        push_str(buffer, "cannot assign to packed store index result")

                    DiagnosticKind.PackedConstructorWithoutStore:
                        buffer.extend(f"packed enum constructor \"{diagnostic.name}.{diagnostic.expected}\" requires an active in {diagnostic.name}.Store: scope or explicit new[{diagnostic.name}.Store]")

                    DiagnosticKind.PackedFrozenStoreAllocation:
                        buffer.extend(f"packed enum allocation requires local store type \"{diagnostic.name}.Store[Local]\", got {diagnostic.name}.Store[Frozen]")

                    DiagnosticKind.PackedMatchMissingStore:
                        buffer.extend(f"packed enum match over \"{diagnostic.name}\" requires an in {diagnostic.name}.Store clause")

                    DiagnosticKind.PackedIfPatternMissingBinder:
                        push_str(buffer, "if pattern binder requires `as Enum.Variant(...)` after store expression")

                    DiagnosticKind.NonGenericSpecialization:
                        buffer.extend(f"function \"{diagnostic.name}\" is not generic")

                    DiagnosticKind.ReduceSumNonNumericCallback:
                        push_str(buffer, "reduce_sum callback must return a numeric accumulator")

                    DiagnosticKind.AtomicUnsafePayload:
                        buffer.extend(f"atomic payload type must satisfy atomic_safe(T), got {diagnostic.name}")

                    DiagnosticKind.AtomicRmwNonNumeric:
                        buffer.extend(f"argument to \"{diagnostic.name}\" requires atomic_numeric(T), got atomic[{diagnostic.actual}")
                        push_str(buffer, "&") if diagnostic.expected == "ref"
                        push_str(buffer, "]")

                    DiagnosticKind.OrdinaryMatchWithStore:
                        buffer.extend(f"ordinary enum match over \"{diagnostic.name}\" does not take an in-store clause")

                    DiagnosticKind.OrdinaryEnumBareVariantType:
                        buffer.extend(f"bare variant type \"{diagnostic.name}.{diagnostic.expected}\" requires a packed enum or tree category")

                    DiagnosticKind.NamedPatternOnUnnamedPayload:
                        buffer.extend(f"match arm \"{diagnostic.name}\" does not declare named payload fields")

                    DiagnosticKind.ErrorConstructorArgumentType:
                        buffer.extend("error constructor argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" to \"{diagnostic.actual}.{diagnostic.name}\" expects {diagnostic.expected}")

                    DiagnosticKind.AmbiguousBareRange:
                        push_str(buffer, "ambiguous bare `..` range: use `..<` for exclusive (e.g. `lo ..< hi`) or `..=` for inclusive (e.g. `lo ..= hi`)")

                    DiagnosticKind.WildcardArmNotFinal:
                        push_str(buffer, "wildcard match arm must be the final arm")

                    DiagnosticKind.DerivedStateRuleNotFieldBased:
                        buffer.extend(f"derived state rule for \"{diagnostic.name}\" must be a pure field-based expression over self")

                    DiagnosticKind.DarrayPushImmutableReceiver:
                        push_str(buffer, "darray push requires a mutable darray receiver")

                    DiagnosticKind.DarrayPushArenaRequired:
                        push_str(buffer, "darray push requires an active in <arena>: scope")

                    DiagnosticKind.CountingFillUnreserved:
                        buffer.extend(f"counting loop grows \"{diagnostic.name}\" without a matching immediately preceding reserve; add `{diagnostic.name}.reserve(...)` before the loop or keep the fresh darray declaration adjacent so auto-reserve can synthesize it")

                    DiagnosticKind.AssertProofHole:
                        push_str(buffer, "proof hole: assertion could not be proven")

                    DiagnosticKind.RegionParamUninferable:
                        buffer.extend(f"cannot infer region parameter \"__rg_{diagnostic.actual}\" for call to \"{diagnostic.name}\"")

                    DiagnosticKind.TupleIterableNotTuple:
                        buffer.extend(f"iterable for tuple pattern requires a tuple item, got {diagnostic.actual}")

                    DiagnosticKind.InvalidStructCast:
                        buffer.extend(f"invalid cast from {diagnostic.expected} to {diagnostic.actual}")

                    DiagnosticKind.BraceMembershipMisuse:
                        push_str(buffer, "brace membership set literals are only valid on the right-hand side of `in`")

                    DiagnosticKind.FreshShapeArgMismatch:
                        push_str(buffer, "return type") if diagnostic.name == "return"
                        buffer.extend(f"argument ") if diagnostic.name != "return"
                        push_int(buffer, diagnostic.expected_count.i64()) if diagnostic.name != "return"
                        buffer.extend(f" to \"{diagnostic.name}\"") if diagnostic.name != "return"
                        buffer.extend(f" expects darray[{diagnostic.expected}, {diagnostic.actual}], got darray[{diagnostic.expected}, {diagnostic.detail}")
                        push_str(buffer, "#") if diagnostic.actual_count != 0
                        push_int(buffer, diagnostic.actual_count.i64()) if diagnostic.actual_count != 0
                        push_str(buffer, "]")

                    DiagnosticKind.FreshShapeNote:
                        buffer.extend(f"note: {diagnostic.name} returns a fresh logical shape for {diagnostic.expected}")

                    DiagnosticKind.MatchArmsIncompatible:
                        buffer.extend(f"match expression arms are incompatible: {diagnostic.expected} and {diagnostic.actual}" if diagnostic.expected != "" else f"match expression arms are incompatible: <invalid> and {diagnostic.actual}")

                    DiagnosticKind.NonDecreasingMeasure:
                        buffer.extend(f"cannot prove the decreases measure strictly decreases at this recursive call to \"{diagnostic.name}\"; the function may not terminate (measure \"{diagnostic.expected}\" non-decreasing across the recursive call: {diagnostic.expected} -> {diagnostic.expected})")

                    DiagnosticKind.EnsureNotProven:
                        buffer.extend(f"postcondition of \"{diagnostic.name}\" is provably violated: ") if diagnostic.detail == "violated"
                        buffer.extend(f"ensure postcondition of \"{diagnostic.name}\" could not be proven statically at this point")

                    DiagnosticKind.ContractArgTypeMismatch:
                        push_str(buffer, "contract `")
                        buffer.extend(f"{diagnostic.name}` argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" ({diagnostic.detail}) expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.UsesPreconditionViolated:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" is violated: the argument provably does not satisfy `requires`")

                    DiagnosticKind.UncheckedIndexUngranted:
                        push_str(buffer, "unchecked index requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.UncheckedIndex or a surrounding can ...: block; missing required effect facts; for a checked access write `get ")
                        buffer.extend(f"{diagnostic.name}[i]` (propagates absence) or `{diagnostic.name}[i] else <fallback>` (handles it inline), or keep it unchecked with `trusted Unsafe.UncheckedIndex`")

                    DiagnosticKind.MutableAliasUngranted:
                        push_str(buffer, "mutable alias requires can[Unsafe] and has no explicit local effect grant; add can Unsafe.Alias or a surrounding can ...: block; missing required effect facts")

                    DiagnosticKind.PositionalConstruction:
                        buffer.extend(f"positional construction {diagnostic.name}(...) is not allowed; use the brace form {diagnostic.name}{{...}} for default field initialization, or define a constructor `def {diagnostic.name}(...) -> {diagnostic.name}`")

                    DiagnosticKind.EmptyListNeedsType:
                        push_str(buffer, "empty list literal requires an expected array or darray type")

                    DiagnosticKind.ZipMapSourceNotReadonly:
                        push_str(buffer, "zip_map requires source ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, " to be a readonly contiguous exact-extent view; wrap it with readonly(...)")

                    DiagnosticKind.FlowStrictBlockIf:
                        push_str(buffer, "strict flow [-Wflow-strict]: block `if` statement — every decision must be a value, an exit, an arm, or a transition (docs/125 §6b). Use a postfix guard (`STMT if COND`), a value selection (`x = A if c else B`, `when`), a `match` arm, or a `machine` state; or state the exception with `can ComplexFlow:`")

                    DiagnosticKind.RefinementReturnNotProven:
                        buffer.extend(f"refinement on the return of '{diagnostic.name}' could not be proven statically; return a provable value or accept the runtime check")

                    DiagnosticKind.RefinementArgNotProven:
                        push_str(buffer, "refinement on argument ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" of '{diagnostic.name}' could not be proven statically; pass a provable value or accept the runtime check")

                    DiagnosticKind.RefineAliasCycle:
                        buffer.extend(f"refine alias \"{diagnostic.name}\" has a recursive or mutually-recursive base (cycle through \"{diagnostic.name}\")")

                    DiagnosticKind.WhereRefinementReassignViolated:
                        push_str(buffer, "where refinement on reassignment is violated")

                    DiagnosticKind.PreconditionViolated:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" is violated: the argument provably does not satisfy `requires`")

                    DiagnosticKind.OwnedRegionNotConsumed:
                        buffer.extend(f"owned region \"{diagnostic.name}\" must be consumed before scope exit")

                    DiagnosticKind.OwnedRegionAlreadyDestroyed:
                        buffer.extend(f"region \"{diagnostic.name}\" has already been destroyed")

                    DiagnosticKind.OwnedRegionMoveOnly:
                        buffer.extend(f"owned region \"{diagnostic.name}\" is move-only: use `move {diagnostic.name}` to transfer ownership to \"{diagnostic.expected}\"")

                    DiagnosticKind.EnsuresArgNotEntailed:
                        buffer.extend(f"function \"{diagnostic.name}\" passed for parameter \"{diagnostic.expected}\" of \"{diagnostic.actual}\" does not satisfy its contract `ensures({diagnostic.expected}, ...)`: its declared `ensure` does not entail the required postcondition")

                    DiagnosticKind.EnsuresArgLambdaUnproven:
                        buffer.extend(f"lambda passed for parameter \"{diagnostic.expected}\" of \"{diagnostic.actual}\" does not satisfy its contract `ensures({diagnostic.expected}, ...)`: its result is not provably within the required postcondition")

                    DiagnosticKind.EnsuresTargetNotFn:
                        buffer.extend(f"ensures({diagnostic.name}, ...) names \"{diagnostic.name}\", which is not a function-typed parameter of \"{diagnostic.actual}\"")

                    DiagnosticKind.ProofBlockImpure:
                        push_str(buffer, "a proof block may contain only verification-only statements (lemma calls, nested `assert`s, `invariant`s); a statement with real effects is not allowed because the block is erased from code")

                    DiagnosticKind.DecreasesLoopNotDecreasing:
                        push_str(buffer, "loop `decreases` measure could not be proven to strictly decrease and stay >= 0 on every iteration; falling back to the runtime loop-progress check")

                    DiagnosticKind.OverlayFieldWidthMismatch:
                        buffer.extend(f"overlay-field-width-mismatch: field {diagnostic.expected}.{diagnostic.name} has ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, "-byte width, which has no MemoryManager_ReadU<N> form (expected 1, 2, 4, or 8)")

                    DiagnosticKind.OverlayFieldNeedsSizeGuard:
                        buffer.extend(f"overlay-field-needs-size-guard: field {diagnostic.expected}.{diagnostic.name} requires size >= ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        push_str(buffer, ", and this access has no dominating size guard")

                    DiagnosticKind.QuantifiedRefinementUnproven:
                        buffer.extend(f"quantified refinement \"{diagnostic.name}\" on \"{diagnostic.actual}\" could not be proven statically (it has no runtime check); enable -smt or strengthen the facts")

                    DiagnosticKind.RegionTiedReturn:
                        buffer.extend(f"value tied to region parameter \"{diagnostic.expected}\" cannot be returned with a region-less type (its lifetime is the caller's region for that parameter); declare the tie with a region-polymorphic signature (def f[@r](p: T& @r) -> R @r)") if diagnostic.expected != ""
                        buffer.extend(f"value tied to region parameter \"__rg_{diagnostic.name}\" cannot be returned with a region-less type (its lifetime is the caller's region for that parameter); declare the tie with a region-polymorphic signature (def f[@r](p: T& @r) -> R @r)") if diagnostic.expected == ""

                    DiagnosticKind.FunctionInvariantUnproven:
                        push_str(buffer, "invariant could not be proven statically at this point; keeping the debug runtime check but not using it as a release proof fact")

                    DiagnosticKind.LoopInvariantNotPreserved:
                        push_str(buffer, "loop invariant is established on entry but could not be proven preserved by the loop body; it is only checked at runtime")

                    DiagnosticKind.LemmaEnsureUnproven:
                        buffer.extend(f"lemma \"{diagnostic.name}\" does not prove its `ensure`: a lemma is erased from code, so every postcondition must follow statically from its `requires` and body (add intermediate `assert`s, call a helper lemma, or strengthen `requires`)")

                    DiagnosticKind.AssertByUnproven:
                        push_str(buffer, "`assert … by:` condition could not be proven from its proof block; the block's facts plus the caller's facts must entail it (add intermediate `assert`s or call a helper `lemma`)")

                    DiagnosticKind.LocalRefinementUnproven:
                        buffer.extend(f"refinement \"{diagnostic.name}\" on \"{diagnostic.actual}\" could not be proven statically")

                    DiagnosticKind.UnboundedStringErasure:
                        buffer.extend(f"casting an interior pointer of a sized darray to an unbounded string ({diagnostic.actual}) erases its length; a static_strlen / C-string scan can read past the darray into adjacent memory (out-of-bounds, nondeterministic). Prefer a length-bounded view (sview), or copy bounded bytes into a fresh allocation")

                    DiagnosticKind.InteriorPointerWiden:
                        buffer.extend(f"casting an interior pointer of a byte darray to {diagnostic.actual}& reinterprets the darray as a wider value; reading it accesses more bytes than the index bounds and can read past the darray (out-of-bounds, nondeterministic). Bounds-check the offset against the buffer length, or copy the bytes into a properly typed value")

                    DiagnosticKind.ConflictingImport:
                        buffer.extend(f"conflicting import: \"{diagnostic.name}\" is already imported from \"{diagnostic.expected}\", cannot also import it from \"{diagnostic.actual}\"; a name may be selectively imported from only one module")

                    DiagnosticKind.MeasureShapeLawInValueIs:
                        buffer.extend(f"\"{diagnostic.name}\" is a {diagnostic.actual} law; apply it to a function with `fulfills {diagnostic.name}`, not with `is` in a value position")

                    DiagnosticKind.DeferBodyReturns:
                        buffer.extend("defer body cannot return from the enclosing function")

                    DiagnosticKind.DeferFunctionNotOutermost:
                        buffer.extend("defer function is currently only supported in the outermost function scope")

                    DiagnosticKind.LawNeedsSubject:
                        buffer.extend(f"law \"{diagnostic.name}\" needs a subject: give it at least one value parameter (conventionally `self`)")

                    DiagnosticKind.EnumRefinesNonEnum:
                        buffer.extend(f"enum \"{diagnostic.name}\" can only refine another enum with `is`, but \"{diagnostic.actual}\" is {diagnostic.actual}")

                    DiagnosticKind.MutateWhileIterating:
                        buffer.extend(f"cannot mutate \"{diagnostic.name}\" while it is being iterated: darray {diagnostic.actual} of {diagnostic.name} would move its buffer out from under the loop. Iterate by index up to a saved count, collect into a separate darray, or back it with a stable region (reserve_commit/fixed)")

                    DiagnosticKind.IndexFallbackTypeMismatch:
                        buffer.extend(f"index fallback expects {diagnostic.expected}, got {diagnostic.actual}")

                    DiagnosticKind.CastConstantTruncated:
                        push_str(buffer, "constant ")
                        push_str(buffer, "-") if diagnostic.expected == "neg"
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" does not fit in {diagnostic.actual} and is truncated by this cast")

                    DiagnosticKind.StructuralDecreasesUnproven:
                        buffer.extend(f"cannot prove structural `decreases` for \"{diagnostic.name}\": recursive calls must pass values bound from a match on the decreasing enum parameter")

                    DiagnosticKind.AutoRegionStoreEscape:
                        push_str(buffer, "value escapes its `in auto:` scope via store into longer-lived storage; the inferred region is freed at scope exit. Give it an explicit lifetime — copy it into a caller-provided region param (def f[@r] ... -> ... @r) or a longer-lived region")

                    DiagnosticKind.ClosureCaptureEscape:
                        buffer.extend(f"the closure passed to \"{diagnostic.name}\" captures state that cannot outlive the task; move owned state into the task or capture only values")

                    DiagnosticKind.SentinelIndex:
                        buffer.extend(f"index \"{diagnostic.name}\" derives from a function that can return a negative not-found sentinel and is never bounds-checked here; casting a negative sentinel to an unsigned index reads far out of bounds. Guard it (e.g. `if {diagnostic.name} >= 0 ...`) or use `get coll[{diagnostic.name}] else ...`")

                    DiagnosticKind.UntypedEmptyBuilder:
                        buffer.extend(f"cannot infer element type for empty darray builder \"{diagnostic.name}\"; add a type declaration (for example `{diagnostic.name}: T[] = []` or `{diagnostic.name}: mutable darray[T] = []`) or push/extend typed values before type-dependent darray operations")

                    DiagnosticKind.CStrPointerCompare:
                        buffer.extend(f"{diagnostic.name} on two raw u8& C-string pointers compares addresses, not contents; use streq() or compare via cstr/sview/dstr for content equality")

                    DiagnosticKind.RegionStoreEscape:
                        buffer.extend(f"value in region \"{diagnostic.actual}\" is stored into longer-lived region \"{diagnostic.expected}\"; region \"{diagnostic.actual}\" is freed first, leaving a dangling reference. Copy it into region \"{diagnostic.expected}\" (or a region that outlives \"{diagnostic.expected}\") before storing")

                    DiagnosticKind.ArenaGrowEscape:
                        buffer.extend(f"darray {diagnostic.name} grows a non-local darray from local arena \"{diagnostic.expected}\"; its backing buffer is freed when \"{diagnostic.expected}\" goes out of scope (use-after-free). Allocate from a persistent arena instead (a global Arena, or an Arena& parameter owned by the caller)")

                    DiagnosticKind.OverlayUnknownField:
                        buffer.extend(f"overlay-unknown-field: field {diagnostic.name} is not declared in layout {diagnostic.expected}; add the field or correct the access")

                    DiagnosticKind.StructFieldWhereRefScope:
                        buffer.extend(f"struct field where refinement on \"{diagnostic.name}\" may only reference the field itself or earlier-declared fields; \"{diagnostic.actual}\" is not available here (later fields are not in scope at this point)")

                    DiagnosticKind.LocalWhereRefinementViolated:
                        push_str(buffer, "local where refinement is violated")

                    DiagnosticKind.StructFieldRefinementViolated:
                        of_phrase = f" of {diagnostic.expected}" if diagnostic.expected != "" else f""
                        buffer.extend(f"where refinement on field \"{diagnostic.name}\"{of_phrase} is violated")

                    DiagnosticKind.RegionReturnEscape:
                        buffer.extend(f"value allocated in region \"{diagnostic.actual}\" escapes via return; the region is freed at scope exit. Copy it into a caller-provided region param (def f[@r] ... -> ... @r) or a longer-lived region")

                    DiagnosticKind.DviewRemoved:
                        push_str(buffer, "`dview[T]` has been removed; use `view[T]`")

                    DiagnosticKind.NoallocArguments:
                        buffer.extend(f"@noalloc on function \"{diagnostic.name}\" does not take arguments")

                    DiagnosticKind.HotContract:
                        hot_reason = f"chases raw pointers or dispatches indirectly through a heap reference" if diagnostic.expected == "pointer" else f"allocates or frees on the hot path (via the `Memory.Allocate` effect)"
                        buffer.extend(f"@hot function \"{diagnostic.name}\" {hot_reason}")

                    DiagnosticKind.DecreasesStarReason:
                        push_str(buffer, "`decreases *` requires a non-empty reason string explaining why termination is unbounded")

                    DiagnosticKind.DecreasesRuntimeUnmodelable:
                        push_str(buffer, "warning: loop `decreases` measure could not be proven: the body has effects this analyzer cannot model (calls, non-arithmetic writes, or control flow); falling back to the runtime loop-progress check")

                    DiagnosticKind.ProgressNoEvidence:
                        push_str(buffer, "progress warning: while loop has no progress evidence; prove termination with `decreases <measure>`, add a Progress.Tick/Progress.Yield budget check, or — if progress is real but unprovable — `can Unsafe.AssumeProgress` to propagate the assumption upward (reach for `trusted` only at the boundary where propagation no longer helps); for a deliberately non-terminating loop, `can Unsafe.NonProgress`")

                    DiagnosticKind.ProgressRecursiveCycle:
                        buffer.extend(f"progress warning: recursive cycle {diagnostic.name} has no progress evidence; prove it with `decreases <measure>` or structural recursion, add Progress.EnterRecursion/Progress.Tick budget checks, or — if non-progress is intended — `can Unsafe.NonProgress` to propagate it upward (reach for `trusted` only at the boundary where propagation no longer helps)")

                    DiagnosticKind.GetFallbackVoidNonVoid:
                        buffer.extend(f"get fallback cannot use else void for non-void result {diagnostic.expected}")

                    DiagnosticKind.ExternNoContract:
                        buffer.extend(f"extern function \"{diagnostic.name}\" has no contract: under -strict-externs every extern must declare a `requires`/`ensure` boundary contract or be annotated `@trusted(\"reason\")` to document why the unverified native body is trusted")

                    DiagnosticKind.EnsuresUnknownParam:
                        buffer.extend(f"ensures on function \"{diagnostic.expected}\" references unknown parameter \"{diagnostic.name}\"")

                    DiagnosticKind.EnsuresReturnNeedsBool:
                        buffer.extend(f"ensures return true on function \"{diagnostic.name}\" requires a bool return type, got {diagnostic.expected}")

                    DiagnosticKind.ImplStrengthensPrecondition:
                        buffer.extend(f"impl method \"{diagnostic.name}\" for protocol \"{diagnostic.expected}\" on {diagnostic.actual} strengthens the precondition: {diagnostic.detail}")

                    DiagnosticKind.ImplWeakensPostcondition:
                        buffer.extend(f"impl method \"{diagnostic.name}\" for protocol \"{diagnostic.expected}\" on {diagnostic.actual} weakens the postcondition: it does not guarantee {diagnostic.detail}")

                    DiagnosticKind.EnsuresRefTarget:
                        buffer.extend(f"ensures on function \"{diagnostic.expected}\" requires \"{diagnostic.name}\" to resolve to a ref target for refstate effects")

                    DiagnosticKind.EnsuresArgCount:
                        buffer.extend(f"ensures \"{diagnostic.name}\" expects ")
                        push_int(buffer, diagnostic.expected_count.i64())
                        buffer.extend(f" argument(s), got ")
                        push_int(buffer, diagnostic.actual_count.i64())

                    DiagnosticKind.DeprecatedFunctionUse:
                        default_note = f"this function is deprecated" if diagnostic.actual == "" else f"{diagnostic.actual}"
                        buffer.extend(f"deprecated: call to \"{diagnostic.name}\" — {default_note}")

                    DiagnosticKind.InAutoDeprecated:
                        push_str(buffer, "`in auto:` is deprecated; remove the block and rely on region inference, or use `region NAME(size):` for an explicit scope")

                    DiagnosticKind.NewAutoDeprecated:
                        push_str(buffer, "`new[auto]` is deprecated; use `new` instead")

                    DiagnosticKind.ContradictoryRequires:
                        buffer.extend(f"the `requires` preconditions of \"{diagnostic.name}\" are contradictory (their conjunction is unsatisfiable); the function can never be called and its body can vacuously prove any `ensure`")

                    DiagnosticKind.PermissionReservedName:
                        buffer.extend(f"\"{diagnostic.name}\" is the reserved top permission and cannot be declared")

                    DiagnosticKind.HotArgument:
                        buffer.extend(f"@hot on function \"{diagnostic.name}\" only accepts the optional `alloc` argument")

                    DiagnosticKind.NoBoundsCheckUnproven:
                        buffer.extend(f"function \"{diagnostic.name}\" `fulfills NoBoundsChecks` but has an index access that is not statically proven in-bounds, so a runtime bounds check would be emitted")

                    DiagnosticKind.HotVectorize:
                        buffer.extend(f"@hot kernel \"{diagnostic.name}\" will not vectorize: its buffers are not provably disjoint, so LLVM keeps the runtime alias-guard around the element loop")

                    DiagnosticKind.IntrinsicNamePrefix:
                        buffer.extend(f"@intrinsic on extern function \"{diagnostic.name}\" expects an LLVM intrinsic name starting with \"llvm.\"")

                    DiagnosticKind.TrustedExternReason:
                        buffer.extend(f"@trusted on extern function \"{diagnostic.name}\" requires exactly one non-empty reason string explaining why the unverified native body is trusted")

                    DiagnosticKind.ExternLinkNameConflict:
                        buffer.extend(f"extern link_name \"{diagnostic.expected}\" for \"{diagnostic.name}\" has a signature that conflicts with a previous declaration sharing that link_name; use one shared declaration or matching wrapper to avoid native symbol splitting")

                    DiagnosticKind.LmutMutationNotReassignment:
                        buffer.extend(f"mutation of `lmut` value \"{diagnostic.name}\" must be a reassignment (docs/120 §10): write `{diagnostic.name} <- ...` (or a `rebind` binding) so the threaded value is claimed back")

                    DiagnosticKind.LmutFalseClaim:
                        buffer.extend(f"rebind target \"{diagnostic.name}\" claims a threaded slot, but \"{diagnostic.expected}\" neither declares lmut threading for it nor passes it to an `lmut` parameter")

                    DiagnosticKind.StaticGenerateInterpRuntime:
                        buffer.extend(f"static generate interpolation must evaluate at compile time")

                    DiagnosticKind.MutualDecreasesCycle:
                        buffer.extend(f"cannot prove the `decreases` measure strictly decreases across the mutually-recursive cycle containing \"{diagnostic.name}\"; the cycle may not terminate")

                    DiagnosticKind.PreconditionProvablyViolated:
                        buffer.extend(f"precondition of \"{diagnostic.name}\" is violated: the argument provably does not satisfy it")
                    _:
                        handled <- false
