# Static-function call context (stage0 static-evaluation). A `static def` function is compile-time
# only; calling it from ordinary runtime code is rejected ("static function X can only be called
# from a static context"). The parser records each static function's name (owner "__static_fn").
#
# SOUND subset: a call to a static function from a function that is NOT itself a static function is
# flagged. Calls from another static function are fine (both compile-time). Static-if/static-generate
# bodies inside a runtime function are a rarer static context left to the full evaluator.
extend Semantic:
    private:
        def is_static_function(static_fns: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any static_name in static_fns where static_name == name

        def static_call_check_expression(expression: Ast::Expr, static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticCallContext, name: callee_name, line: line, expected: "", actual: ""}) if callee_name != "" and is_static_function(static_fns, callee_name)
                        for argument in arguments |table| -> table:
                            table <- static_call_check_expression(argument, static_fns, table)
                    Expr.Binary(left, operator, right, line):
                        table <- static_call_check_expression(left, static_fns, table)
                        table <- static_call_check_expression(right, static_fns, table)
                    Expr.Unary(operator, operand, line):
                        table <- static_call_check_expression(operand, static_fns, table)
                    Expr.Paren(inner, line):
                        table <- static_call_check_expression(inner, static_fns, table)
                    _:
                        pass

        def static_call_check_statements(statements: darray[Ast::Stmt], static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- static_call_check_expression(expression, static_fns, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- static_call_check_expression(value, static_fns, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- static_call_check_expression(value, static_fns, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- static_call_check_expression(returned, static_fns, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- static_call_check_expression(condition, static_fns, table)
                            table <- static_call_check_statements(then_body, static_fns, table)
                            table <- static_call_check_statements(else_body, static_fns, table)
                        Stmt.While(condition, while_body, line):
                            table <- static_call_check_expression(condition, static_fns, table)
                            table <- static_call_check_statements(while_body, static_fns, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- static_call_check_statements(for_body, static_fns, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- static_call_check_statements(body, static_fns, table)
                        _:
                            pass

        def check_static_call_context_walk(declarations: darray[Ast::Decl], static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # A static function is itself a static context — its calls to statics are fine.
                            table <- static_call_check_statements(body, static_fns, table) if not is_static_function(static_fns, function_name)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_static_call_context_walk(module_body, static_fns, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_static_call_context_walk(scoped_body, static_fns, table)
                        _:
                            pass

        def check_static_call_context(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                static_fns: mutable darray[sview] = []
                for annotation in file.enum_annotations |static_fns|:
                    static_fns.push(annotation.name) if annotation.owner == "__static_fn"
                table <- check_static_call_context_walk(file.top_decls, static_fns, table) if static_fns.count > 0