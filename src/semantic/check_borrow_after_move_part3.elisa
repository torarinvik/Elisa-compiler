extend Semantic:
    private:
        # Owners inside an aggregate field are summarized at the containing field. The
        # recursive walk follows aggregate values and known lender calls so nested references
        # don't disappear from the summary.
        def bam_nested_value_owners(value: Ast::Expr, owners: darray[sview @source]&, borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, out: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Construct(_, fields, _):
                        for field in fields |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            table <- bam_nested_value_owners(field.value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.RecordUpdate(base, fields, _):
                        base_name: sview = ident_name_of(base)
                        if base_name != "":
                            table <- bam_value_owners(base, owners, borrow_names, borrow_fields, borrow_owners, out, table)
                            base_names: mutable darray[sview @source] = []
                            base_fields: mutable darray[sview @source] = []
                            bam_collect_borrow_keys(borrow_names, borrow_fields, base_name, base_names, base_fields)
                            for base_field in base_fields |base_names, base_name, borrow_names, borrow_fields, borrow_owners, fields, out|:
                                continue if base_field == "" or (base_field != "*" and (any update in fields where update.name == base_field or bam_field_path_within(base_field, update.name)))
                                bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, base_name, base_field, out)
                        else:
                            table <- bam_nested_value_owners(base, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                        update_index: mutable usize = 0
                        for field in fields |update_index, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            if not bam_update_has_later_field(fields, field.name, update_index):
                                table <- bam_nested_value_owners(field.value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                            update_index <- update_index + 1
                    Expr.Ident(source_name, _):
                        table <- bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, out, table)
                        field_names: mutable darray[sview @source] = []
                        field_keys: mutable darray[sview @source] = []
                        bam_collect_borrow_keys(borrow_names, borrow_fields, source_name, field_names, field_keys)
                        for field in field_keys |field_names, source_name, borrow_names, borrow_fields, borrow_owners, out|:
                            continue if field == ""
                            bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_name, field, out)
                    Expr.Field(field_object, _, _):
                        source_path: (root: sview, field: sview) = bam_expression_field_path(value, borrow_fields, table)
                        if source_path.root != "" and source_path.field != "":
                            bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_path.root, source_path.field, out)
                            field_names: mutable darray[sview @source] = []
                            field_keys: mutable darray[sview @source] = []
                            bam_collect_borrow_keys(borrow_names, borrow_fields, source_path.root, field_names, field_keys)
                            source_path_root: sview = source_path.root
                            source_path_field: sview = source_path.field
                            for source_field in field_keys |field_names, source_path_root, source_path_field, borrow_names, borrow_fields, borrow_owners, out|:
                                continue if source_field == source_path_field or not bam_field_path_within(source_field, source_path_field)
                                bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, source_path_root, source_field, out)
                        else:
                            table <- bam_nested_value_owners(field_object, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Paren(inner, _):
                        table <- bam_nested_value_owners(inner, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Move(inner, _):
                        table <- bam_nested_value_owners(inner, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            table <- bam_nested_value_owners(element, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            table <- bam_nested_value_owners(entry.key, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                            table <- bam_nested_value_owners(entry.value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.If(_, then_value, else_value, _):
                        table <- bam_nested_value_owners(then_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                        table <- bam_nested_value_owners(else_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Block(value: block_value, _):
                        table <- bam_nested_value_owners(block_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Match(_, arms, _) | Expr.Catch(_, arms, _):
                        for arm in arms |owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table|:
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(arm_value, _):
                                        table <- bam_nested_value_owners(arm_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                    Stmt.Return(arm_return_option, _):
                                        if arm_return_option is arm_return_value:
                                            table <- bam_nested_value_owners(arm_return_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                    _:
                                        pass
                    Expr.GetElse(guarded, recovery, _):
                        table <- bam_nested_value_owners(guarded, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                        if recovery.count > 0:
                            match recovery[recovery.count - 1]:
                                Stmt.Expr(recovery_value, _):
                                    table <- bam_nested_value_owners(recovery_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                Stmt.Return(recovery_return_option, _):
                                    if recovery_return_option is recovery_return_value:
                                        table <- bam_nested_value_owners(recovery_return_value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                                _:
                                    pass
                    Expr.Call(_, _, _, _):
                        table <- bam_lend_owners(value, owners, lend_names, lend_positions, lend_parameter_names, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    _:
                        table <- bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, out, table)

        # Keep aggregate provenance at its full field path. A summary attached only to the
        # immediate parent field would make reading an unrelated sibling look borrowed.
        def bam_bind_value_fields(destination: sview @source, prefix: sview @source, value: Ast::Expr, owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, out_names: mutable darray[sview @source]&, out_fields: mutable darray[sview @source]&, out_owners: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                direct_owners: mutable darray[sview @source] = []
                table <- bam_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, direct_owners, table)
                table <- bam_lend_owners(value, owners, lend_names, lend_positions, lend_parameter_names, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, direct_owners, table) if direct_owners.count == 0
                if prefix != "":
                    bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, prefix)
                    for owner in direct_owners |out_names, out_fields, out_owners, destination, prefix|:
                        bam_push_borrow(out_names, out_fields, out_owners, destination, prefix, owner)
                    if direct_owners.count > 0:
                        wildcard_path: sview = bam_join_field_key(prefix, "*", out_fields, table)
                        bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, wildcard_path)
                        for owner in direct_owners |out_names, out_fields, out_owners, destination, wildcard_path|:
                            bam_push_borrow(out_names, out_fields, out_owners, destination, wildcard_path, owner)
                match value:
                    Expr.Construct(_, fields, _):
                        for init in fields |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, destination, prefix, table|:
                            child_path: sview = bam_join_field_key(prefix, init.name, out_fields, table)
                            table <- bam_bind_value_fields(destination, child_path, init.value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.RecordUpdate(base, fields, _):
                        table <- bam_bind_value_fields(destination, prefix, base, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                        for init in fields |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, destination, prefix, table|:
                            child_path: sview = bam_join_field_key(prefix, init.name, out_fields, table)
                            table <- bam_clear_borrow_path(destination, child_path, out_names, out_fields, out_owners, table)
                            table <- bam_bind_value_fields(destination, child_path, init.value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.Ident(source_name, _):
                        table <- bam_copy_borrow_fields(destination, prefix, source_name, "", borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.Field(_, _, _):
                        source_path: (root: sview, field: sview) = bam_expression_field_path(value, borrow_fields, table)
                        table <- bam_copy_borrow_fields(destination, prefix, source_path.root, source_path.field, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table) if source_path.root != "" and source_path.field != ""
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        table <- bam_bind_value_fields(destination, prefix, inner, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, out_names, out_fields, out_owners, table)
                    Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _) | Expr.DictLit(_, _) | Expr.If(_, _, _, _) | Expr.Block(_, _, _, _):
                        nested_owners: mutable darray[sview @source] = []
                        table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, nested_owners, table)
                        if prefix != "" and nested_owners.count > 0:
                            bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, prefix)
                            for nested_owner in nested_owners |out_names, out_fields, out_owners, destination, prefix|:
                                bam_push_borrow(out_names, out_fields, out_owners, destination, prefix, nested_owner)
                            wildcard_path: sview = bam_join_field_key(prefix, "*", out_fields, table)
                            bam_force_reset_borrow_field(out_names, out_fields, out_owners, destination, wildcard_path)
                            for nested_owner in nested_owners |out_names, out_fields, out_owners, destination, wildcard_path|:
                                bam_push_borrow(out_names, out_fields, out_owners, destination, wildcard_path, nested_owner)
                    _:
                        pass

        # Append a scope binder without a linear duplicate check. The scope filter builds a
        # hash index after collecting the tree, so repeated spellings stay linear overall.
        def bam_append_scope_local(out: mutable darray[sview @source]&, name: sview @source) -> void:
            can Memory.Allocate, Abort.Panic:
                out.push(name) if name != "" and name != "_"

        def bam_collect_rhs_pattern_locals(pattern: Ast::Pattern, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name) | Pattern.Rest(name):
                        bam_append_scope_local(out, name)
                    Pattern.As(name, inner):
                        bam_append_scope_local(out, name)
                        for child in inner |out|:
                            bam_collect_rhs_pattern_locals(child, out)
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children) | Pattern.Or(children):
                        for child in children |out|:
                            bam_collect_rhs_pattern_locals(child, out)
                    _:
                        pass

        def bam_pattern_is_wildcard(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                return match pattern:
                    Pattern.Wildcard: true
                    _: false

        def bam_match_pattern_catches_all(pattern: Ast::Pattern, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match pattern:
                    Pattern.Wildcard | Pattern.Binding(_): true
                    Pattern.Tuple(elements): elements.count > 0 and not (any element in elements where not bam_pattern_is_wildcard(element))
                    Pattern.Struct(_, fields): struct_pattern_fields_are_irrefutable(fields)
                    Pattern.Variant(path, fields): path_names_declared_struct(path, table) and struct_pattern_fields_are_irrefutable(fields)
                    _: false

        # A scope filter owns only the declarations directly in its statement list. Nested
        # `if`/loop/match/block scopes restore their own binders at their own boundary; pulling
        # those names into the enclosing list would incorrectly restore an outer spelling from
        # the enclosing entry state and discard later assignments to that outer binding.
        def bam_collect_rhs_scope_stmt_locals(statements: darray[Ast::Stmt], binders: BorrowBinders&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |binders, out|:
                    match statement:
                        Stmt.VarDecl(name: name, _):
                            bam_append_scope_local(out, name)
                        Stmt.Assign(target, operator, _, _):
                            if operator == TokenKind.Assign:
                                match target:
                                    Expr.Ident(assigned_name, _):
                                        bam_append_scope_local(out, assigned_name)
                                    _:
                                        pass
                        _:
                            pass

        def bam_restore_borrow_name_state(local_names: darray[sview]&, names: mutable darray[sview @source]&, fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, base_names: darray[sview @source]&, base_fields: darray[sview @source]&, base_owners: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if local_names.count == 0
                local_fields: mutable darray[sview @source] = []
                capacity: mutable usize = 16
                while capacity < (local_names.count + 1) * 2 |capacity, local_names|:
                    capacity <- capacity * 2
                slots: mutable darray[usize] = []
                slots.reserve(capacity)
                for _ in 0..<capacity |slots|:
                    slots.push(0)
                for local_name in local_names |slots, local_fields|:
                    local_fields.push("")
                    slot, found = bam_borrow_key_probe(slots, local_names, local_fields, local_name, "")
                    slots[slot] <- local_fields.count if not found
                restored_names: mutable darray[sview @source] = []
                restored_fields: mutable darray[sview @source] = []
                restored_owners: mutable darray[sview @source] = []
                for row in 0..<names.count |row, restored_names, restored_fields, restored_owners, slots, local_names, local_fields, names, fields, borrow_owners|:
                    row_name: sview = names[row]
                    _, is_local = bam_borrow_key_probe(slots, local_names, local_fields, row_name, "")
                    if not is_local:
                        restored_names.push(row_name)
                        restored_fields.push(fields[row] if row < fields.count else "")
                        restored_owners.push(borrow_owners[row] if row < borrow_owners.count else "")
                for row in 0..<base_names.count |row, restored_names, restored_fields, restored_owners, slots, local_names, local_fields, base_names, base_fields, base_owners|:
                    row_name: sview = base_names[row]
                    _, is_local = bam_borrow_key_probe(slots, local_names, local_fields, row_name, "")
                    if is_local:
                        restored_names.push(row_name)
                        restored_fields.push(base_fields[row] if row < base_fields.count else "")
                        restored_owners.push(base_owners[row] if row < base_owners.count else "")
                names.truncate(0)
                fields.truncate(0)
                borrow_owners.truncate(0)
                names.extend(restored_names)
                fields.extend(restored_fields)
                borrow_owners.extend(restored_owners)

        def bam_filter_rhs_scope_borrow_state(statements: darray[Ast::Stmt], extra_locals: darray[sview @source]&, binders: BorrowBinders&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, base_names: darray[sview @source]&, base_fields: darray[sview @source]&, base_owners: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                locals: mutable darray[sview @source] = []
                bam_collect_rhs_scope_stmt_locals(statements, binders, locals)
                for extra_local in extra_locals |locals|:
                    bam_append_scope_local(locals, extra_local)
                bam_restore_borrow_name_state(locals, borrow_names, borrow_fields, borrow_owners, base_names, base_fields, base_owners)

        def bam_filter_borrow_state_locals(active_locals: darray[sview]&, extra_locals: darray[sview @source]&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, base_names: darray[sview @source]&, base_fields: darray[sview @source]&, base_owners: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                locals: mutable darray[sview @source] = []
                locals.extend(active_locals)
                for extra_local in extra_locals |locals|:
                    bam_append_scope_local(locals, extra_local)
                bam_restore_borrow_name_state(locals, borrow_names, borrow_fields, borrow_owners, base_names, base_fields, base_owners)

        # Abrupt paths can exit before later declarations in the same body. Filter each captured
        # path with only the locals reached at that exit, then rebuild the compatibility join used
        # by the ownership fixed point.
        def bam_filter_loop_exit_paths(exits: mutable BorrowLoopExitState&, extra_locals: darray[sview @source]&, base_names: darray[sview @source]&, base_fields: darray[sview @source]&, base_owners: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if exits.exit_paths.count == 0:
                    if exits.seen:
                        bam_filter_borrow_state_locals(exits.exit_active_locals, extra_locals, exits.names, exits.fields, exits.owners, base_names, base_fields, base_owners)
                else:
                    exits.names.truncate(0)
                    exits.fields.truncate(0)
                    exits.owners.truncate(0)
                    exits.kinds.truncate(0)
                    exits.details.truncate(0)
                    exits.seen <- false
                    for row in 0..<exits.exit_paths.count |row, exits, extra_locals, base_names, base_fields, base_owners|:
                        path: mutable BorrowLoopExitPath = exits.exit_paths[row]
                        bam_filter_borrow_state_locals(path.active_locals, extra_locals, path.names, path.fields, path.owners, base_names, base_fields, base_owners)
                        exits.exit_paths[row] <- path
                        if exits.seen:
                            bam_merge_borrow_state(exits.names, exits.fields, exits.owners, path.names, path.fields, path.owners)
                            bam_merge(exits.kinds, exits.details, path.kinds, path.details)
                        else:
                            bam_replace_borrow_state(exits.names, exits.fields, exits.owners, path.names, path.fields, path.owners)
                            exits.kinds.extend(path.kinds)
                            exits.details.extend(path.details)
                            exits.seen <- true
                if exits.continue_paths.count == 0:
                    if exits.continue_seen:
                        bam_filter_borrow_state_locals(exits.continue_active_locals, extra_locals, exits.continue_names, exits.continue_fields, exits.continue_owners, base_names, base_fields, base_owners)
                    return
                exits.continue_names.truncate(0)
                exits.continue_fields.truncate(0)
                exits.continue_owners.truncate(0)
                exits.continue_kinds.truncate(0)
                exits.continue_details.truncate(0)
                exits.continue_seen <- false
                for row in 0..<exits.continue_paths.count |row, exits, extra_locals, base_names, base_fields, base_owners|:
                    path: mutable BorrowLoopExitPath = exits.continue_paths[row]
                    bam_filter_borrow_state_locals(path.active_locals, extra_locals, path.names, path.fields, path.owners, base_names, base_fields, base_owners)
                    exits.continue_paths[row] <- path
                    if exits.continue_seen:
                        bam_merge_borrow_state(exits.continue_names, exits.continue_fields, exits.continue_owners, path.names, path.fields, path.owners)
                        bam_merge(exits.continue_kinds, exits.continue_details, path.kinds, path.details)
                    else:
                        bam_replace_borrow_state(exits.continue_names, exits.continue_fields, exits.continue_owners, path.names, path.fields, path.owners)
                        exits.continue_kinds.extend(path.kinds)
                        exits.continue_details.extend(path.details)
                        exits.continue_seen <- true
