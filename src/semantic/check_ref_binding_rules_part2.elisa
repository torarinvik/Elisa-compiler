extend Semantic:
    private:
        # Whether the receiver is a darray by its declared spelling (value or reference);
        # an inferred or unknown binding answers false.
        def rbm_receiver_is_darray(receiver: Ast::Expr, bindings: RefBindingScope&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                match receiver:
                    Expr.Paren(inner, paren_pos):
                        return rbm_receiver_is_darray(inner, bindings, table)
                    Expr.Ident(name, ident_pos):
                        binding: RefBinding = rbm_lookup(bindings, name, table)
                        return binding.mode != RBM_MODE_OPAQUE and rbm_is_darray_bare(binding.bare)
                    Expr.Field(object, field, field_pos):
                        row: u32 = rbm_field_row(bindings, rbm_expr_struct(object, bindings, table), field, table)
                        return false if row == RBM_NONE
                        field_type: Ast::Expr = table.private_field_types[row.usize()]
                        return rbm_is_darray_bare(bare_type_name_through_ref(field_type))
                    Expr.Index(object, index, index_pos):
                        return rbm_receiver_depth(receiver, bindings, table) > 0
                    _:
                        pass
                return false


        # The darray nesting left at a receiver path: a binding or field answers with its
        # declared spelling, each index peels one level. 0 = not a darray or unknown.
        def rbm_receiver_depth(receiver: Ast::Expr, bindings: RefBindingScope&, table: SymbolTable&) -> u32:
            can Abort.Panic:
                match receiver:
                    Expr.Paren(inner, paren_pos):
                        return rbm_receiver_depth(inner, bindings, table)
                    Expr.Ident(name, ident_pos):
                        binding: RefBinding = rbm_lookup(bindings, name, table)
                        return 0 if binding.mode == RBM_MODE_OPAQUE else binding.depth
                    Expr.Field(object, field, field_pos):
                        row: u32 = rbm_field_row(bindings, rbm_expr_struct(object, bindings, table), field, table)
                        return 0 if row == RBM_NONE
                        return rbm_darray_depth(table.private_field_types[row.usize()])
                    Expr.Index(object, index, index_pos):
                        outer: u32 = rbm_receiver_depth(object, bindings, table)
                        return outer - 1 if outer > 0 else 0
                    _:
                        pass
                return 0


        # `xs.push(v)` / `b.items.clear()` through a readonly reference or onto a field that
        # is not `mutable`: the builtin grows or shrinks storage the receiver may not write.
        # The push-only field wall in resolve_types_operators reports the same finding at the
        # same span when it can; this pass does not repeat it.
        def rbm_check_darray_receiver(callee: Ast::Expr, argument_count: usize, pos: Ast::Pos, bindings: RefBindingScope&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(receiver, method, method_pos):
                        arity: i64 = rbm_darray_mutating_arity(method)
                        return if arity < 0
                        if argument_count.i64() != arity:
                            # stage0 `darray push expects 1 argument, got 2`; only for a receiver
                            # this pass can type as a darray, so a user method named `push` is untouched.
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, line: pos.line, pos: pos, expected: "darray", actual: "", expected_count: arity.u32(), actual_count: argument_count.u32()}) if rbm_receiver_is_darray(receiver, bindings, table)
                            return
                        return if rbm_darray_receiver_writable(receiver, bindings, table) != 0
                        receiver_pos: Ast::Pos = Ast::expr_pos(receiver)
                        for existing in table.diagnostics:
                            return if existing.kind == DiagnosticKind.DarrayPushImmutableReceiver and existing.pos.line == receiver_pos.line and existing.pos.column == receiver_pos.column
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DarrayPushImmutableReceiver, name: method, pos: receiver_pos, line: pos.line, expected: "", actual: ""})
                    _:
                        pass
