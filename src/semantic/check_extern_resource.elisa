# `extern resource Name` (docs/127 §3.2): the parser desugared it into `Name__native` (an
# opaque extern at the same line, annotated `__extern_resource` owner=Name) plus the struct
# `Name{__handle}`. The two rules the sugar promises, with stage0's messages and ORDER (D3
# is reported while externs are declared, D2 after destructors are collected):
#   D3: an extern never returns a borrowed resource (`Name&`);
#   D2: a resource declares `__drop__` in its module.
extend Semantic:
    private:
        def resource_has_drop(declarations: darray[Ast::Decl], resource_name: sview) -> bool:
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, params, return_type, body, effects, decorators, line):
                            if function_name == "__drop__" and params.count == 1:
                                match params[0].type_expression:
                                    Expr.Ident(param_type_name, param_type_line):
                                        true return if param_type_name == resource_name
                                    _:
                                        pass
                        _:
                            pass
                return false

        def resource_name_declared(annotations: darray[Ast::EnumAnnotation]&, type_name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.name == "__extern_resource" and annotation.owner == type_name

        def check_extern_resource(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if callable and return_type_name != "" and resource_name_declared(annotations, return_type_name):
                                if extern_return_flag(annotations, "__extern_return_ptr", name, line.line) and not extern_return_flag(annotations, "__extern_return_optional", name, line.line):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternResourceBorrowedReturn, name: name, line: line.line, pos: line, expected: return_type_name, actual: ""})
                        _:
                            pass
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            if not callable:
                                for annotation in annotations |table| -> table:
                                    if annotation.name == "__extern_resource" and annotation.line == line.line and not resource_has_drop(declarations, annotation.owner):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternResourceNoDrop, name: annotation.owner, line: line.line, pos: line, expected: "", actual: ""})
                        _:
                            pass
