# Validate function decorators against stage0's separate ordinary/extern allowlists.
# Decorator arguments are intentionally outside this pass; the parser currently retains
# names only, which is sufficient to reject unknown annotations without guessing payloads.

extend Semantic:
    private:
        def supported_function_annotation(name: sview) -> bool:
            return name == "test" or name == "bench" or name == "property" or name == "differential" or name == "lockstep" or name == "fixture" or name == "skip" or name == "inline" or name == "fast_math" or name == "norecurse" or name == "hot" or name == "cold" or name == "callconv" or name == "guard_nonnull" or name == "guard_variant" or name == "internal" or name == "main_thread" or name == "init" or name == "async_entry" or name == "segment_agnostic" or name == "segment_establishing" or name == "segment_transition" or name == "reentrant_safe" or name == "deprecated" or name == "noalloc" or name == "inbounds" or name == "nolock" or name == "boundary_pointer_args"

        def supported_extern_function_annotation(name: sview) -> bool:
            return name == "borrows_return" or name == "link_name" or name == "intrinsic" or name == "callconv" or name == "internal" or name == "blocking" or name == "nonblocking" or name == "segment_transition" or name == "reentrant_safe" or name == "deprecated" or name == "trusted"

        def has_function_annotation(decorators: darray[sview], wanted: sview) -> bool:
            for decorator in decorators:
                true return if decorator == wanted
            return false

        def function_has_generic_params(line: u32, table: SymbolTable&) -> bool:
            for generic_line in table.generic_param_lines:
                true return if generic_line == line
            return false

        def check_function_annotation_contracts(name: sview, params: darray[Ast::ParamDecl], return_type: Ast::Expr?, decorators: darray[sview], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TestFunctionParameters, name: name, line: line, expected: "", actual: ""}) if has_function_annotation(decorators, "test") and params.count != 0
                if has_function_annotation(decorators, "bench") and return_type is return_type_expr:
                    return_name: sview = bare_type_name(return_type_expr)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BenchFunctionNonVoidReturn, name: name, line: line, expected: "void", actual: return_name}) if return_name != "" and return_name != "void"
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericFixtureFunction, name: name, line: line, expected: "", actual: ""}) if has_function_annotation(decorators, "fixture") and function_has_generic_params(line, table)

        def check_unknown_function_annotation_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for decorator in decorators |table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownFunctionAnnotation, name: decorator, line: line, expected: name, actual: ""}) if not supported_function_annotation(decorator)
                            table <- check_function_annotation_contracts(name, params, return_type, decorators, line, table)
                        Decl.Extern(name, arity, variadic, callable, decorators, line):
                            for decorator in decorators |table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownExternFunctionAnnotation, name: decorator, line: line, expected: name, actual: ""}) if callable and not supported_extern_function_annotation(decorator)
                        Decl.Module(module_name, body, line):
                            table <- check_unknown_function_annotation_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_unknown_function_annotation_declarations(body, table)
                        _:
                            pass

    public:
        def check_unknown_function_annotation(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_unknown_function_annotation_declarations(declarations, table)
