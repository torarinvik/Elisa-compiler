# Validate function decorators against stage0's separate ordinary/extern allowlists.
# Decorator arguments are intentionally outside this pass; the parser currently retains
# names only, which is sufficient to reject unknown annotations without guessing payloads.

extend Semantic:
    private:
        def supported_function_annotation(name: sview) -> bool:
            return name == "test" or name == "bench" or name == "property" or name == "differential" or name == "lockstep" or name == "fixture" or name == "skip" or name == "inline" or name == "fast_math" or name == "norecurse" or name == "hot" or name == "cold" or name == "callconv" or name == "guard_nonnull" or name == "guard_variant" or name == "internal" or name == "main_thread" or name == "init" or name == "async_entry" or name == "segment_agnostic" or name == "segment_establishing" or name == "segment_transition" or name == "reentrant_safe" or name == "deprecated" or name == "noalloc" or name == "inbounds" or name == "nolock" or name == "boundary_pointer_args"

        def supported_extern_function_annotation(name: sview) -> bool:
            return name == "borrows_return" or name == "link_name" or name == "intrinsic" or name == "callconv" or name == "internal" or name == "blocking" or name == "nonblocking" or name == "segment_transition" or name == "reentrant_safe" or name == "deprecated" or name == "trusted"

        def has_function_annotation(decorators: darray[Ast::Annotation], wanted: sview) -> bool:
            for decorator in decorators:
                true return if decorator.name == wanted
            return false

        def function_has_generic_params(line: u32, table: SymbolTable&) -> bool:
            for generic_line in table.generic_param_lines:
                true return if generic_line == line
            return false

        def annotation_path_root(path: sview) -> sview:
            for index in 0..<sview_len(path):
                path[0:index] return if path[index] == '.'
            return path

        def annotation_path_field(path: sview) -> sview:
            for index in 0..<sview_len(path):
                path[index + 1:sview_len(path)] return if path[index] == '.'
            return ""

        def provenance_container_name(name: sview) -> bool:
            return name in {"view", "dview", "sview", "darray", "dstr"}

        def struct_provenance_field(owner: sview, wanted_field: sview, table: SymbolTable&) -> bool:
            for index in 0..<table.struct_field_owner.count:
                if table.struct_field_owner[index] == owner and (wanted_field == "" or table.struct_field_name[index] == wanted_field):
                    field_kind: TypeKind = interned_kind(table.struct_field_type_id[index], table)
                    true return if field_kind in {TypeKind.Ref, TypeKind.Container} or provenance_container_name(table.struct_field_type[index])
            return false

        def check_function_annotation_contracts(name: sview, params: darray[Ast::ParamDecl], return_type: Ast::Expr?, decorators: darray[Ast::Annotation], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TestFunctionParameters, name: name, line: line, expected: "", actual: ""}) if has_function_annotation(decorators, "test") and params.count != 0
                if has_function_annotation(decorators, "bench") and return_type is return_type_expr:
                    return_name: sview = bare_type_name(return_type_expr)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BenchFunctionNonVoidReturn, name: name, line: line, expected: "void", actual: return_name}) if return_name != "" and return_name != "void"
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericFixtureFunction, name: name, line: line, expected: "", actual: ""}) if has_function_annotation(decorators, "fixture") and function_has_generic_params(line, table)

        def check_extern_borrow_annotation(name: sview, param_start: u32, arity: u32, params: darray[Ast::ExternParam], decorators: darray[Ast::Annotation], annotation_args: darray[sview], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for decorator in decorators |table| -> table:
                    if decorator.name == "borrows_return" and decorator.arg_count == 1:
                        arg_index: usize = decorator.arg_start.usize()
                        if arg_index < annotation_args.count:
                            source_name: sview = annotation_args[arg_index]
                            source_root: sview = annotation_path_root(source_name)
                            source_field: sview = annotation_path_field(source_name)
                            found: mutable bool = false
                            provenance: mutable bool = false
                            source_type: mutable sview = ""
                            for param_index in param_start.usize()..<(param_start + arity).usize() |found, provenance, source_type|:
                                break if param_index >= params.count
                                param: Ast::ExternParam = params[param_index]
                                if param.name == source_root:
                                    found <- true
                                    provenance <- param.provenance_bearing or struct_provenance_field(param.type_name, source_field, table)
                                    source_type <- param.type_name
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBorrowUnknownParam, name: source_name, line: line, expected: name, actual: ""}) if not found
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternBorrowNonProvenanceParam, name: source_name, line: line, expected: name, actual: source_type}) if found and source_field == "" and not provenance

        def check_unknown_function_annotation_declarations(declarations: darray[Ast::Decl], annotation_args: darray[sview], extern_params: darray[Ast::ExternParam], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for decorator in decorators |table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownFunctionAnnotation, name: decorator.name, line: line, expected: name, actual: ""}) if not supported_function_annotation(decorator.name)
                            table <- check_function_annotation_contracts(name, params, return_type, decorators, line, table)
                        Decl.Extern(name, param_start, arity, variadic, callable, decorators, line):
                            for decorator in decorators |table| -> table:
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownExternFunctionAnnotation, name: decorator.name, line: line, expected: name, actual: ""}) if callable and not supported_extern_function_annotation(decorator.name)
                            table <- check_extern_borrow_annotation(name, param_start, arity, extern_params, decorators, annotation_args, line, table) if callable
                        Decl.Module(module_name, body, line):
                            table <- check_unknown_function_annotation_declarations(body, annotation_args, extern_params, table)
                        Decl.Scoped(body, line):
                            table <- check_unknown_function_annotation_declarations(body, annotation_args, extern_params, table)
                        _:
                            pass

    public:
        def check_unknown_function_annotation(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_unknown_function_annotation_declarations(file.top_decls, file.annotation_args, file.extern_params, table)
