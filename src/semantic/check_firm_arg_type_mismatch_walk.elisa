extend Semantic:
    private:
        # Walk through statements, tracking variable types and checking for firm argument mismatches.
        def walk_statements_for_firm_arg_type_mismatch(statements: darray[Ast::Stmt] @source, table: lmut SymbolTable, var_types: mutable darray[sview @source]&, type_names: mutable darray[sview @source]&, state_names: mutable darray[sview @source]&, states: mutable darray[sview @source]&, declarations: darray[Ast::Decl]& @source, extern_params: darray[Ast::ExternParam]& @source) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(expression, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable BEFORE walking its value,
                            # so downstream expressions see the local's type.
                            type_name: sview = firm_local_type_name(type_expression, table) can Global{Read,Write}
                            note_local_type(var_types, type_names, name, type_name)
                            note_local_type_id(name, type_expression, table) can Global{Read,Write}
                            declared_state: sview = protocol_state_of_annotation(type_expression)
                            state_names.push(name) if declared_state != ""
                            states.push(declared_state) if declared_state != ""
                            table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(target, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            table <- walk_expression_for_firm_arg_type_mismatch(value, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            then_name_mark: usize = var_types.count
                            then_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(then_body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            close_firm_type_scope(then_name_mark, then_state_mark, var_types, type_names, state_names, states)
                            else_name_mark: usize = var_types.count
                            else_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(else_body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            close_firm_type_scope(else_name_mark, else_state_mark, var_types, type_names, state_names, states)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(condition, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            while_name_mark: usize = var_types.count
                            while_state_mark: usize = state_names.count
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            close_firm_type_scope(while_name_mark, while_state_mark, var_types, type_names, state_names, states)
                        Stmt.For(bind, variables, iterable, body, line):
                            for_name_mark: usize = var_types.count
                            for_state_mark: usize = state_names.count
                            table <- walk_expression_for_firm_arg_type_mismatch(iterable, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            # A loop binder is a new local even when this conservative check
                            # cannot infer the iterable's element type. Record a non-empty
                            # sentinel so infer_expression_type does not fall through to the
                            # file-wide structural table and resurrect an outer container with
                            # the same name. The sentinel is deliberately not a registered
                            # nominal type, so this check remains conservative for unknown
                            # iterable element types.
                            literal_element_type: sview = literal_array_element_type(iterable) if variables.count == 1 else ""
                            for variable in variables |var_types, type_names|:
                                note_local_type(var_types, type_names, variable, literal_element_type if literal_element_type != "" else "__firm_scope_binder__")
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            close_firm_type_scope(for_name_mark, for_state_mark, var_types, type_names, state_names, states)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_name_mark: usize = var_types.count
                            block_state_mark: usize = state_names.count
                            note_local_type(var_types, type_names, binding, "__firm_scope_binder__") if binding != ""
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            close_firm_type_scope(block_name_mark, block_state_mark, var_types, type_names, state_names, states)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(scrutinee, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                            match_type_id: u32 = structural_type_id_of(scrutinee, var_types, type_names, table)
                            for arm in arms |table|:
                                arm_name_mark: usize = var_types.count
                                arm_state_mark: usize = state_names.count
                                arm_type_id_mark: usize = table.local_type_names.count
                                arm_pattern: Ast::Pattern = arm.pattern
                                arm_binding_type_id: mutable u32 = match_type_id
                                arm_is_optional_payload_binding: bool = match arm_pattern:
                                    Pattern.Binding(_): true
                                    _: false
                                arm_binding_type_id <- interned_elem(match_type_id, 0, table) if arm_is_optional_payload_binding and interned_kind(match_type_id, table) == SemTypeKind.Optional and interned_elem_count(match_type_id, table) == 1
                                arm_bindings: mutable darray[sview @source] = []
                                collect_pattern_binding_names(arm_pattern, arm_bindings)
                                for arm_binding in arm_bindings |table, arm_pattern, arm_binding_type_id|:
                                    binding_type_id: u32 = pag_pattern_binding_type_id(arm_pattern, arm_binding_type_id, arm_binding, table)
                                    note_local_type_id_direct(arm_binding, binding_type_id, table)
                                    binding_type_name: sview = type_name_of_row(binding_type_id, table) if interned_kind(binding_type_id, table) == SemTypeKind.Named else ""
                                    note_local_type(var_types, type_names, arm_binding, "__firm_optional_payload__") if interned_kind(binding_type_id, table) == SemTypeKind.Optional
                                    note_local_type(var_types, type_names, arm_binding, binding_type_name) if binding_type_name != "" and interned_kind(binding_type_id, table) != SemTypeKind.Optional
                                table <- walk_expression_for_firm_arg_type_mismatch(arm.guard, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                                table <- walk_statements_for_firm_arg_type_mismatch(arm.body, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                                close_firm_type_scope(arm_name_mark, arm_state_mark, var_types, type_names, state_names, states)
                                table.local_type_names <- table.local_type_names.truncate(arm_type_id_mark)
                                table.local_type_ids <- table.local_type_ids.truncate(arm_type_id_mark)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_firm_arg_type_mismatch(return_value, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_firm_arg_type_mismatch(expression, table, var_types, type_names, state_names, states, declarations, extern_params) can Global{Read,Write}
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_firm_arg_type_mismatch_declarations(declarations: darray[Ast::Decl] @source, extern_params: darray[Ast::ExternParam]& @source, extern_declarations: darray[Ast::Decl]& @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            prior_function_id: DeclId = table.current_function_decl_id
                            table.current_function_decl_id <- function_declaration_id(table, name, line.offset)
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview @source] = []
                            type_names: mutable darray[sview @source] = []
                            state_names: mutable darray[sview @source] = []
                            states: mutable darray[sview @source] = []
                            # The structural fallback in infer_expression_type reads the
                            # file-wide local TypeId table, which otherwise still holds the
                            # LAST function resolved: a function declared after this one hid
                            # `text: u8[4]` and its `strlen(text[0])` went unchecked (fuzz F8).
                            # Rebuild it for this function, as check_pointer_arith_grant does.
                            table.local_type_names <- table.local_type_names.truncate(0)
                            table.local_type_ids <- table.local_type_ids.truncate(0)
                            table.local_const_enum_owner_names <- table.local_const_enum_owner_names.truncate(0)
                            table.local_const_enum_owner_modules <- table.local_const_enum_owner_modules.truncate(0)
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = firm_local_type_name(param.type_expression, table) can Global{Read,Write}
                                note_local_type(var_types, type_names, param.name, param_type)
                                note_local_type_id(param.name, param.type_expression, table) can Global{Read,Write}
                                declared_state: sview = protocol_state_of_annotation(param.type_expression)
                                state_names.push(param.name) if declared_state != ""
                                states.push(declared_state) if declared_state != ""
                            # Walk the function body
                            table <- walk_statements_for_firm_arg_type_mismatch(body, table, var_types, type_names, state_names, states, extern_declarations, extern_params) can Global{Read,Write}
                            table.current_function_decl_id <- prior_function_id
                        Decl.Module(module_name, body, line):
                            table <- check_firm_arg_type_mismatch_declarations(body, extern_params, extern_declarations, table) can Global{Read,Write}
                        Decl.Scoped(body, line):
                            table <- check_firm_arg_type_mismatch_declarations(body, extern_params, extern_declarations, table) can Global{Read,Write}
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_firm_arg_type_mismatch(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                extern_declarations: mutable darray[Ast::Decl] @source = []
                collect_extern_declarations(file.top_decls, extern_declarations)
                table <- index_firm_externs(extern_declarations, table) can Global{Read,Write}
                table <- check_firm_arg_type_mismatch_declarations(file.top_decls, file.extern_params, extern_declarations, table) can Global{Read,Write}
