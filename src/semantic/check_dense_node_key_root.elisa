# Dense NodeKey values are tied to one exact frozen packed-store root. A key made
# against `left` cannot index `right`, even when both stores have identical types or
# are sibling fields of the same carrier.
extend Semantic:
    private:
        def dense_store_path(expression: Ast::Expr, root: mutable sview&, member: mutable sview&) -> void:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        root <- name
                    Expr.Field(Expr.Ident(name, ident_line), field, field_line):
                        root <- name
                        member <- field
                    Expr.Paren(inner, line):
                        dense_store_path(inner, root, member)
                    _:
                        pass


        def dense_key_slot(names: darray[sview]&, wanted: sview) -> int:
            can Abort.Panic:
                while index > 0 |index: usize = names.count|:
                    index <- index - 1
                    index.int() return if names[index] == wanted
                return -1


        def dense_name_exists(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                for name in names:
                    true return if name == wanted
                return false


        def note_dense_key(name: sview, value: Ast::Expr, key_names: mutable darray[sview]&, store_roots: mutable darray[sview]&, store_members: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Ident(callee_name, _):
                                if callee_name == "dense_key" and arguments.count >= 2:
                                    root: mutable sview = ""
                                    member: mutable sview = ""
                                    dense_store_path(arguments[1], root, member)
                                    if root != "":
                                        key_names.push(name)
                                        store_roots.push(root)
                                        store_members.push(member)
                            _:
                                pass
                    _:
                        pass


        def dense_node_table_initializer(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(Expr.IndexN(Expr.Ident(name, ident_line), type_arguments, index_line), arguments, argument_names, line):
                        return name == "node_table_fill"
                    Expr.Call(Expr.Ident(name, ident_line), arguments, argument_names, line):
                        return name == "node_table_fill"
                    _:
                        return false


        def check_dense_key_expression(expression: Ast::Expr, key_names: darray[sview]&, store_roots: darray[sview]&, store_members: darray[sview]&, node_tables: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(store, Expr.Ident(key_name, key_line), line):
                        slot: int = dense_key_slot(key_names, key_name)
                        while has_key |has_key: bool = slot >= 0, table|:
                            root: mutable sview = ""
                            member: mutable sview = ""
                            dense_store_path(store, root, member)
                            mismatched: bool = root != store_roots[slot.usize()] or member != store_members[slot.usize()]
                            is_node_table: bool = dense_name_exists(node_tables, root) and member == ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DenseNodeKeyRootMismatch, name: key_name, line: line.line, expected: "", actual: ""}) if root != "" and mismatched and not is_node_table
                            has_key <- false
                        table <- check_dense_key_expression(store, key_names, store_roots, store_members, node_tables, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments |table|:
                            table <- check_dense_key_expression(argument, key_names, store_roots, store_members, node_tables, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_dense_key_expression(left, key_names, store_roots, store_members, node_tables, table)
                        table <- check_dense_key_expression(right, key_names, store_roots, store_members, node_tables, table)
                    Expr.Paren(inner, line) | Expr.Unary(_, inner, line):
                        table <- check_dense_key_expression(inner, key_names, store_roots, store_members, node_tables, table)
                    Expr.Field(object, field, line):
                        table <- check_dense_key_expression(object, key_names, store_roots, store_members, node_tables, table)
                    _:
                        pass


        def walk_dense_key_statements(statements: darray[Ast::Stmt], key_names: mutable darray[sview]&, store_roots: mutable darray[sview]&, store_members: mutable darray[sview]&, node_tables: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            note_dense_key(name, value, key_names, store_roots, store_members)
                            node_tables.push(name) if dense_node_table_initializer(value)
                            table <- check_dense_key_expression(value, key_names, store_roots, store_members, node_tables, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_dense_key_expression(target, key_names, store_roots, store_members, node_tables, table)
                            table <- check_dense_key_expression(value, key_names, store_roots, store_members, node_tables, table)
                        Stmt.Expr(expression, line):
                            table <- check_dense_key_expression(expression, key_names, store_roots, store_members, node_tables, table)
                        Stmt.Return(value, line):
                            table <- check_dense_key_expression(returned, key_names, store_roots, store_members, node_tables, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_dense_key_expression(condition, key_names, store_roots, store_members, node_tables, table)
                            table <- walk_dense_key_statements(then_body, key_names, store_roots, store_members, node_tables, table)
                            table <- walk_dense_key_statements(else_body, key_names, store_roots, store_members, node_tables, table)
                        Stmt.Block(_, _, _, body, line) | Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- walk_dense_key_statements(body, key_names, store_roots, store_members, node_tables, table)
                        _:
                            pass


        def check_dense_key_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            key_names: mutable darray[sview] = []
                            store_roots: mutable darray[sview] = []
                            store_members: mutable darray[sview] = []
                            node_tables: mutable darray[sview] = []
                            table <- walk_dense_key_statements(body, key_names, store_roots, store_members, node_tables, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_dense_key_declarations(body, table)
                        _:
                            pass

    public:
        def check_dense_node_key_root(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_dense_key_declarations(declarations, table)
