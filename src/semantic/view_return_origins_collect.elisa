extend Semantic:
    private:
        # Every returned value: `return EXPR` anywhere, plus the trailing expression statement.
        def vro_returns(statements: darray[Ast::Stmt]&, is_tail: bool, out: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                while statement_index < statements.count |statement_index: usize = 0, out|:
                    last: bool = is_tail and statement_index + 1 == statements.count
                    statement: Ast::Stmt = statements[statement_index]
                    statement_index <- statement_index + 1
                    match statement:
                        Stmt.Return(value, _):
                            if value is returned:
                                out.push(returned)
                        Stmt.Expr(expression, _):
                            out.push(expression) if last
                        Stmt.Block(body: body, _):
                            vro_returns(body, last, out)
                        Stmt.If(_, then_body, else_body, _):
                            vro_returns(then_body, last, out)
                            vro_returns(else_body, last, out)
                        Stmt.While(_, body, _):
                            vro_returns(body, false, out)
                        Stmt.For(body: body, _):
                            vro_returns(body, false, out)
                        Stmt.Match(_, arms, _):
                            for arm in arms |out, last|:
                                vro_returns(arm.body, last, out)
                        _:
                            pass

        def vro_function(name: sview @source, params: darray[Ast::ParamDecl]&, return_type: Ast::Expr, body: darray[Ast::Stmt]&, generics: darray[sview @source]&, view_enums: darray[sview @source]&, prior: darray[sview @source]&, prior_index: mutable VroPriorIndex&, mutables: darray[sview @source]&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                # A declared enum with a view payload carries a borrow too (stage0
                # storageViewDependencyForUserCall: EnumType + typeCarriesBorrowedStorage).
                returns_view_enum: bool = any view_enum in view_enums where view_enum == ident_name_of(return_type)
                # A result that cannot hold storage borrows nothing from any argument: a traceable
                # summary with no origin rows (stage0 ReturnBorrowedOwnerRefs empty).
                if not vro_borrow_return(return_type, generics) and not returns_view_enum and not vro_carries_return(return_type):
                    out.push(name)
                    out.push(vro_tag(params.count))
                    out.push("0")
                    out.push("known")
                    out.push("")
                    return
                arity: sview @source = vro_tag(params.count)
                return if arity == ""
                if vro_thread_return(return_type):
                    out.push(name)
                    out.push(arity)
                    out.push("0")
                    out.push("thread")
                    out.push("")
                    return
                param_names: mutable darray[sview @source] = []
                for param in params |param_names|:
                    param_names.push(param.name)
                names: mutable darray[sview @source] = []
                values: mutable darray[Ast::Expr] = []
                vro_collect_bindings(body, names, values, mutables)
                returned: mutable darray[Ast::Expr] = []
                vro_returns(body, true, returned)
                positions: mutable darray[usize] = []
                into: mutable darray[bool] = []
                fields: mutable darray[sview @source] = []
                known: mutable bool = true
                on_path: mutable OriginVisit = OriginVisit{indices: [], intos: [], fields: []}
                vro_index_bindings(names, on_path)
                for value in returned |known, positions, into, fields, param_names, names, values, view_enums, prior, prior_index, on_path|:
                    if not vro_origins(value, param_names, names, values, false, "", 0, positions, into, fields, view_enums, prior, prior_index, on_path):
                        known <- false
                        break
                if not known:
                    out.push(name)
                    out.push(arity)
                    out.push("0")
                    out.push("unknown")
                    out.push("")
                    return
                out.push(name)
                out.push(arity)
                out.push("0")
                out.push("known")
                out.push("")
                for index in 0..<positions.count |out, positions, into, fields, name, arity|:
                    is_into: bool = into[index]
                    out.push(name)
                    out.push(arity)
                    out.push(vro_tag(positions[index]))
                    out.push("into" if is_into else "carry")
                    out.push(fields[index])

        def vro_generics_of(line: u32, owner_offset: u32, generic_lines: darray[u32]&, generic_offsets: darray[u32]&, generic_names: darray[sview @source]&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if generic_names.count != generic_lines.count or generic_names.count != generic_offsets.count
                for index in 0..<generic_names.count |out, generic_lines, generic_offsets, generic_names, line, owner_offset|:
                    out.push(generic_names[index]) if generic_lines[index] == line and generic_offsets[index] == owner_offset

        # Declared non-generic enums with a payload field typed as a view (sview @source, cstr,
        # view[...], readonly[...]). Nested carriers stay unsummarised: callers keep today's behaviour.
        def vro_view_enums(declarations: darray[Ast::Decl]&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                no_generics: darray[sview @source] = []
                for declaration in declarations |out, no_generics|:
                    match declaration:
                        Decl.Enum(enum_name, variants, is_const, _, _):
                            if not is_const:
                                carries: mutable bool = false
                                for variant in variants |carries, no_generics|:
                                    for field_type in variant.fields |carries, no_generics|:
                                        carries <- true if vro_borrow_return(field_type, no_generics) and not vro_thread_return(field_type)
                                out.push(enum_name) if carries
                        Decl.Module(_, body, _):
                            vro_view_enums(body, out)
                        Decl.Scoped(body, _):
                            vro_view_enums(body, out)
                        _:
                            pass

        def vro_collect(declarations: darray[Ast::Decl]&, generic_lines: darray[u32]&, generic_offsets: darray[u32]&, generic_names: darray[sview @source]&, view_enums: darray[sview @source]&, prior: darray[sview @source]&, prior_index: mutable VroPriorIndex&, update_prior: bool, mutables: darray[sview @source]&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out, generic_lines, generic_offsets, generic_names, view_enums, prior, prior_index, update_prior|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, _, _, pos):
                            if return_type is declared_return:
                                generics: mutable darray[sview @source] = []
                                vro_generics_of(pos.line, pos.offset, generic_lines, generic_offsets, generic_names, generics)
                                before: usize = out.count
                                vro_function(name, params, declared_return, body, generics, view_enums, prior, prior_index, mutables, out) can Global{Read,Write}
                                if update_prior:
                                    row: mutable usize = before / VRO_ROW_WIDTH
                                    while row < out.count / VRO_ROW_WIDTH |row, out, prior_index|:
                                        hash: u64 = name_hash(out[row * VRO_ROW_WIDTH])
                                        prior_index.next.push(0)
                                        if prior_index.tails.get(hash) is tail_row:
                                            prior_index.next[tail_row - 1] <- row + 1
                                        else:
                                            prior_index.heads <- prior_index.heads.put(hash, row + 1) can Global{Read,Write}
                                        prior_index.tails <- prior_index.tails.put(hash, row + 1) can Global{Read,Write}
                                        row <- row + 1
                        Decl.Module(_, body, _):
                            vro_collect(body, generic_lines, generic_offsets, generic_names, view_enums, prior, prior_index, update_prior, mutables, out) can Global{Read,Write}
                        Decl.Scoped(body, _):
                            vro_collect(body, generic_lines, generic_offsets, generic_names, view_enums, prior, prior_index, update_prior, mutables, out) can Global{Read,Write}
                        _:
                            pass

        # Whether rows name a summarised function NAME of ARITY, and none of them is unknown.
        # 0 = not summarised, 1 = summarised and traceable, 2 = summarised but unknown.
        def vro_status(rows: darray[sview @source]&, name: sview @source, arity: usize) -> u8:
            can Abort.Panic:
                arity_tag: sview @source = vro_tag(arity)
                return 0 if arity_tag == "" or name == ""
                status: mutable u8 = 0
                sorted: bool = vro_rows_sorted(rows)
                row: mutable usize = vro_scan_start(rows, name, arity_tag)
                while row + VRO_ROW_FIELD_OFFSET < rows.count |row, status, rows, name, arity_tag, sorted|:
                    break if sorted and (rows[row] != name or rows[row + VRO_ROW_ARITY_OFFSET] != arity_tag)
                    candidate: sview = rows[row]
                    # The initial pass reads a growing, unsorted summary. Reject
                    # most nonmatching names without a full string comparison.
                    if candidate.len == name.len and candidate[0] == name[0] and candidate == name and rows[row + 1] == arity_tag:
                        status <- 2 if rows[row + 3] == "unknown" else (1 if status == 0 else status)
                    row <- row + vro_row()
                return status

