# Redundant continue check: detects a `continue` statement that is the LAST statement
# of a loop body (While or For), which is a no-op since the loop will continue anyway
# at the end of the body. Only flags when the continue is literally the final element
# of the loop's own body statement list — not inside nested if/match (those may skip code).

extend Semantic:
    private:
        # Check a list of statements for redundant continues.
        # Looks for While/For loops where the last statement in the body is a Continue.
        def check_redundant_continue_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.While(condition, body, line):
                            # Check if the loop body's last statement is a Continue
                            if body.count > 0:
                                last_stmt: Ast::Stmt = body[body.count - 1]
                                match last_stmt:
                                    Stmt.Continue:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantContinue, name: "", line: last_stmt.line, expected: "", actual: ""})
                                    _:
                                        pass
                            # Recurse into the loop body
                            table <- check_redundant_continue_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            # Check if the loop body's last statement is a Continue
                            if body.count > 0:
                                last_stmt: Ast::Stmt = body[body.count - 1]
                                match last_stmt:
                                    Stmt.Continue:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantContinue, name: "", line: last_stmt.line, expected: "", actual: ""})
                                    _:
                                        pass
                            # Recurse into the loop body
                            table <- check_redundant_continue_statements(body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_redundant_continue_statements(then_body, table)
                            table <- check_redundant_continue_statements(else_body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_redundant_continue_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_redundant_continue_statements(arm.body, table)
                        _:
                            pass


        # Entry point: check all declarations for redundant continues in function bodies.
        def check_redundant_continue(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_redundant_continue_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_redundant_continue(body, table)
                        Decl.Scoped(body, line):
                            table <- check_redundant_continue(body, table)
                        _:
                            pass
