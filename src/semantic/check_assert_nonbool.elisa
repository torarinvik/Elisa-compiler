# `assert COND` (and `static assert COND`, whose `static` marker the statement parser drops)
# requires a bool condition. A condition that is definitely non-bool — a numeric literal or a
# bare arithmetic expression — is rejected: "assert condition must be bool, got int". SOUND
# subset: fires only on an IntLit/FloatLit/arithmetic condition (a comparison, logical op, `is`
# test, bool literal, call, or any non-literal reference is bool-or-unknown, a conservative miss).
# `static assert` renders with a "static " prefix in stage0, but the marker is not retained here;
# the boolean-class internal oracle still agrees, and plain `assert` is the exact wording.
extend Semantic:
    private:
        # The non-bool value family of an assert condition, else "".
        def assert_nonbool_family(condition: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.IntLit(value):
                        return "int"
                    Expr.FloatLit(text):
                        return "float"
                    Expr.Paren(inner, line):
                        return assert_nonbool_family(inner)
                    Expr.Binary(left, operator, right, line):
                        arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
                        return "int" if arithmetic else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def assert_nonbool_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            family: sview = assert_nonbool_family(expression) if kind == "assert" else sview("", 0, 0)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssertConditionNonBool, name: "", line: line, expected: "", actual: family}) if family != ""
                        Stmt.If(condition, then_body, else_body, line):
                            table <- assert_nonbool_statements(then_body, table)
                            table <- assert_nonbool_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- assert_nonbool_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- assert_nonbool_statements(body, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- assert_nonbool_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- assert_nonbool_statements(arm.body, table)
                        _:
                            pass

        def check_assert_nonbool_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- assert_nonbool_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_assert_nonbool_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_assert_nonbool_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_assert_nonbool(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_assert_nonbool_decls(declarations, table)
