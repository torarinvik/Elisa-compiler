# Flow-sensitive derived typestate for state-qualified parameters and fields. Literal
# writes to fields used by `derive state` predicates reclassify the affected value;
# subsequent direct calls are checked against that post-write state.
extend Semantic:
    private:
        def derived_value_path(expression: Ast::Expr, root: mutable sview&, member: mutable sview&) -> void:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        root <- name
                    Expr.Field(Expr.Ident(name, ident_line), field, field_line):
                        root <- name
                        member <- field
                    Expr.Paren(inner, line) | Expr.Unary(_, inner, line):
                        derived_value_path(inner, root, member)
                    Expr.Index(Expr.Field(base, selector, field_line), target, index_line):
                        derived_value_path(base, root, member) if selector == "cast"
                    _:
                        pass


        def derived_track_slot(roots: darray[sview]&, members: darray[sview]&, root: sview, member: sview) -> int:
            can Abort.Panic:
                while index > 0 |index: usize = roots.count|:
                    index <- index - 1
                    index.int() return if roots[index] == root and members[index] == member
                return -1


        def note_derived_track(root: sview, member: sview, owner: sview, state: sview, changed: bool, roots: mutable darray[sview]&, members: mutable darray[sview]&, owners: mutable darray[sview]&, states: mutable darray[sview]&, changes: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if root == "" or owner == "" or state == ""
                slot: int = derived_track_slot(roots, members, root, member)
                if slot < 0:
                    roots.push(root)
                    members.push(member)
                    owners.push(owner)
                    states.push(state)
                    changes.push(changed)
                    return
                position: usize = slot.usize()
                owners[position] <- owner
                states[position] <- state
                changes[position] <- true if changed


        def derived_member_type(declarations: darray[Ast::Decl]&, struct_name: sview, field_name: sview, owner: mutable sview&, state: mutable sview&) -> void:
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(name, fields, affinity, has_named_states, has_derive, invariants, line):
                            if name == struct_name:
                                for field in fields:
                                    derived_type_owner_state(field.type_expression, owner, state) if field.name == field_name
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            derived_member_type(body, struct_name, field_name, owner, state)
                        _:
                            pass


        def derived_parameter_type(declarations: darray[Ast::Decl]&, function_name: sview, position: usize, owner: mutable sview&, state: mutable sview&) -> void:
            can Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            while matches |matches: bool = name == function_name and position < params.count|:
                                derived_type_owner_state(params[position].type_expression, owner, state)
                                matches <- false
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            derived_parameter_type(body, function_name, position, owner, state)
                        _:
                            pass


        def derived_state_for_literal(owner: sview, field: sview, value: Ast::Expr, rules: darray[Ast::DerivedStateRule]&) -> sview:
            can Abort.Panic:
                value_known: mutable bool = false
                literal: i64 = derived_literal_int(value, value_known)
                "" return if not value_known
                for rule in rules:
                    if rule.owner == owner and rule.condition is Expr.Binary(left, operator, right, line) and derived_self_field(left) == field:
                        rhs_known: mutable bool = false
                        rhs: i64 = derived_literal_int(right, rhs_known)
                        matches: bool = when operator:
                            TokenKind.EqEq -> literal == rhs
                            TokenKind.BangEq -> literal != rhs
                            TokenKind.Lt -> literal < rhs
                            TokenKind.Gt -> literal > rhs
                            TokenKind.LtEq -> literal <= rhs
                            TokenKind.GtEq -> literal >= rhs
                            _ -> false
                        rule.state return if rhs_known and matches
                return ""


        def check_derived_flow_call(expression: Ast::Expr, declarations: darray[Ast::Decl]&, roots: darray[sview]&, members: darray[sview]&, owners: darray[sview]&, states: darray[sview]&, changes: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if expression is Expr.Call(Expr.Ident(function_name, ident_line), arguments, argument_names, line):
                    while position < arguments.count |position: usize = 0, table|:
                        expected_owner: mutable sview = ""
                        expected_state: mutable sview = ""
                        derived_parameter_type(declarations, function_name, position, expected_owner, expected_state)
                        root: mutable sview = ""
                        member: mutable sview = ""
                        derived_value_path(arguments[position], root, member)
                        slot: int = derived_track_slot(roots, members, root, member)
                        while has_slot |has_slot: bool = slot >= 0, table|:
                            actual_owner: sview = owners[slot.usize()]
                            actual_state: sview = states[slot.usize()]
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DerivedStateArgumentMismatch, name: function_name, line: line, expected: expected_state, actual: actual_state, detail: expected_owner}) if changes[slot.usize()] and expected_owner != "" and expected_state != "" and actual_owner == expected_owner and actual_state != expected_state
                            has_slot <- false
                        position <- position + 1


        def apply_derived_postcondition(expression: Ast::Expr, declarations: darray[Ast::Decl]&, postconditions: darray[Ast::TypestatePostcondition]&, alias_names: darray[sview]&, alias_roots: darray[sview]&, alias_members: darray[sview]&, roots: mutable darray[sview]&, members: mutable darray[sview]&, owners: mutable darray[sview]&, states: mutable darray[sview]&, changes: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if expression is Expr.Call(Expr.Ident(function_name, ident_line), arguments, argument_names, line):
                    for postcondition in postconditions:
                        while applies |applies: bool = postcondition.function_name == function_name and postcondition.position.usize() < arguments.count|:
                            owner: mutable sview = ""
                            initial_state: mutable sview = ""
                            derived_parameter_type(declarations, function_name, postcondition.position.usize(), owner, initial_state)
                            root: mutable sview = ""
                            member: mutable sview = ""
                            derived_value_path(arguments[postcondition.position.usize()], root, member)
                            while alias_index < alias_names.count |alias_index: usize = 0, root, member|:
                                matched: bool = root == alias_names[alias_index] and member == ""
                                root <- alias_roots[alias_index] if matched else root
                                member <- alias_members[alias_index] if matched else member
                                alias_index <- alias_index + 1
                            note_derived_track(root, member, owner, postcondition.state, true, roots, members, owners, states, changes)
                            applies <- false


        def apply_derived_field_write(target: Ast::Expr, value: Ast::Expr, declarations: darray[Ast::Decl]&, rules: darray[Ast::DerivedStateRule]&, var_names: darray[sview]&, var_types: darray[sview]&, alias_names: darray[sview]&, alias_roots: darray[sview]&, alias_members: darray[sview]&, roots: mutable darray[sview]&, members: mutable darray[sview]&, owners: mutable darray[sview]&, states: mutable darray[sview]&, changes: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                base: mutable Ast::Expr = (Ast::Expr.Invalid)
                field: mutable sview = ""
                if target is Expr.Field(object, target_field, line):
                    base <- object
                    field <- target_field
                root: mutable sview = ""
                member: mutable sview = ""
                derived_value_path(base, root, member)
                while alias_index < alias_names.count |alias_index: usize = 0|:
                    if root == alias_names[alias_index] and member == "":
                        root <- alias_roots[alias_index]
                        member <- alias_members[alias_index]
                    alias_index <- alias_index + 1
                owner: mutable sview = ""
                current_state: mutable sview = ""
                slot: int = derived_track_slot(roots, members, root, member)
                if slot >= 0:
                    owner <- owners[slot.usize()]
                    current_state <- states[slot.usize()]
                elif member != "":
                    root_type: sview = local_type_of(var_names, var_types, root)
                    derived_member_type(declarations, root_type, member, owner, current_state)
                next_state: sview = derived_state_for_literal(owner, field, value, rules)
                note_derived_track(root, member, owner, current_state, false, roots, members, owners, states, changes) if slot < 0 and current_state != ""
                note_derived_track(root, member, owner, next_state, true, roots, members, owners, states, changes) if next_state != ""


        def walk_derived_flow_statements(statements: darray[Ast::Stmt], declarations: darray[Ast::Decl]&, rules: darray[Ast::DerivedStateRule]&, postconditions: darray[Ast::TypestatePostcondition]&, var_names: mutable darray[sview]&, var_types: mutable darray[sview]&, alias_names: mutable darray[sview]&, alias_roots: mutable darray[sview]&, alias_members: mutable darray[sview]&, roots: mutable darray[sview]&, members: mutable darray[sview]&, owners: mutable darray[sview]&, states: mutable darray[sview]&, changes: mutable darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            note_local_type(var_names, var_types, name, bare_type_name_through_ref(type_expression))
                            alias_root: mutable sview = ""
                            alias_member: mutable sview = ""
                            derived_value_path(value, alias_root, alias_member)
                            alias_slot: int = derived_track_slot(roots, members, alias_root, alias_member)
                            while has_alias |has_alias: bool = alias_slot >= 0|:
                                alias_names.push(name)
                                alias_roots.push(alias_root)
                                alias_members.push(alias_member)
                                note_derived_track(name, "", owners[alias_slot.usize()], states[alias_slot.usize()], changes[alias_slot.usize()], roots, members, owners, states, changes)
                                has_alias <- false
                            table <- check_derived_flow_call(value, declarations, roots, members, owners, states, changes, table)
                        Stmt.Assign(target, operator, value, line):
                            apply_derived_field_write(target, value, declarations, rules, var_names, var_types, alias_names, alias_roots, alias_members, roots, members, owners, states, changes)
                            table <- check_derived_flow_call(value, declarations, roots, members, owners, states, changes, table)
                        Stmt.Expr(expression, line):
                            table <- check_derived_flow_call(expression, declarations, roots, members, owners, states, changes, table)
                            apply_derived_postcondition(expression, declarations, postconditions, alias_names, alias_roots, alias_members, roots, members, owners, states, changes)
                        Stmt.Return(value, line):
                            table <- check_derived_flow_call(returned, declarations, roots, members, owners, states, changes, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_derived_flow_statements(then_body, declarations, rules, postconditions, var_names, var_types, alias_names, alias_roots, alias_members, roots, members, owners, states, changes, table)
                            table <- walk_derived_flow_statements(else_body, declarations, rules, postconditions, var_names, var_types, alias_names, alias_roots, alias_members, roots, members, owners, states, changes, table)
                        Stmt.Block(_, _, _, body, line) | Stmt.While(_, body, line) | Stmt.For(_, _, _, body, line):
                            table <- walk_derived_flow_statements(body, declarations, rules, postconditions, var_names, var_types, alias_names, alias_roots, alias_members, roots, members, owners, states, changes, table)
                        _:
                            pass


        def check_derived_flow_declarations(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl]&, rules: darray[Ast::DerivedStateRule]&, postconditions: darray[Ast::TypestatePostcondition]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_names: mutable darray[sview] = []
                            var_types: mutable darray[sview] = []
                            roots: mutable darray[sview] = []
                            members: mutable darray[sview] = []
                            alias_names: mutable darray[sview] = []
                            alias_roots: mutable darray[sview] = []
                            alias_members: mutable darray[sview] = []
                            owners: mutable darray[sview] = []
                            states: mutable darray[sview] = []
                            changes: mutable darray[bool] = []
                            for param in params:
                                note_local_type(var_names, var_types, param.name, bare_type_name_through_ref(param.type_expression))
                                owner: mutable sview = ""
                                state: mutable sview = ""
                                derived_type_owner_state(param.type_expression, owner, state)
                                note_derived_track(param.name, "", owner, state, false, roots, members, owners, states, changes)
                            table <- walk_derived_flow_statements(body, all_declarations, rules, postconditions, var_names, var_types, alias_names, alias_roots, alias_members, roots, members, owners, states, changes, table)
                            # A declared `ensures p => S` is VIOLATED when the flow (possibly
                            # through an alias) leaves p in a different derived state.
                            for param in params |table| -> table:
                                ensured: sview = fn_typestate_ensured_state(postconditions, name, param.name)
                                continue if ensured == ""
                                probe: mutable usize = 0
                                while probe < roots.count |probe, table| -> table:
                                    is_param_slot: bool = roots[probe] == param.name and members[probe] == ""
                                    violated: bool = is_param_slot and changes[probe] and states[probe] != "" and states[probe] != ensured
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypestateEnsuresUnproven, name: param.name, line: line, expected: ensured, actual: name}) if violated
                                    probe <- probe + 1
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- check_derived_flow_declarations(body, all_declarations, rules, postconditions, table)
                        _:
                            pass

        # The derived state a typestate PARAM is left in after the function's TOP-LEVEL body
        # (unconditional writes only — a nested/branch write is not guaranteed on every path,
        # so it is left to stage0's flow prover). Starts at the declared state and follows each
        # `param.FIELD <- literal` reclassification; out_line records the last such write.
        def typestate_param_final_state(body: darray[Ast::Stmt], param: sview, owner: sview, declared_state: sview, rules: darray[Ast::DerivedStateRule]&, out_line: mutable u32&) -> sview:
            can Memory.Allocate, Abort.Panic:
                final: mutable sview = declared_state
                for statement in body |final, out_line|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Field(Expr.Ident(root, ident_line), field, field_line):
                                if root == param:
                                    next_state: sview = derived_state_for_literal(owner, field, value, rules)
                                    if next_state != "":
                                        final <- next_state
                                        out_line <- line
                        _:
                            pass
                return final

        # After the body, a typestate param whose top-level writes leave it in a state OTHER
        # than its declared one — with no `ensures p => <state>` declaring the transition — is
        # not handed back as lent (stage0's "must be left in its declared state" balance error).
        def check_typestate_balance_declarations(declarations: darray[Ast::Decl], rules: darray[Ast::DerivedStateRule]&, postconditions: darray[Ast::TypestatePostcondition]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for param in params |table| -> table:
                                owner: mutable sview = ""
                                state: mutable sview = ""
                                derived_type_owner_state(param.type_expression, owner, state)
                                continue if owner == "" or state == ""
                                # Only a borrowed REFERENCE (`mutable T[S]&`) must be handed back
                                # in its lent state. A BY-VALUE typestate param (`mutable T[S]`)
                                # is owned by the function and may transition and be consumed
                                # freely (stage0 accepts a direct Pending->Ready consume).
                                continue if not type_marker_present(param.type_expression, TokenKind.Ampersand)
                                continue if fn_has_typestate_ensures(postconditions, name, param.name)
                                write_line: mutable u32 = 0
                                final_state: sview = typestate_param_final_state(body, param.name, owner, state, rules, write_line)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypestateNotRestored, name: param.name, line: write_line, expected: name, actual: final_state}) if final_state != state and write_line != 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_typestate_balance_declarations(module_body, rules, postconditions, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_typestate_balance_declarations(scoped_body, rules, postconditions, table)
                        _:
                            pass

    public:
        def check_derived_state_flow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_derived_flow_declarations(file.top_decls, file.top_decls, file.derived_state_rules, file.typestate_postconditions, table)
                table <- check_typestate_balance_declarations(file.top_decls, file.derived_state_rules, file.typestate_postconditions, table)
