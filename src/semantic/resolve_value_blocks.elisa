# docs/119 expression-unification semantic rules for value blocks:
# E4: value-block purity (no mutation of outer bindings without capture)
# E10: capture must name an existing outer binding
# E11: captured binding must be mutable
#
# Value blocks (Expr.Block) are pure over outer state by default: they cannot write
# back into a binding from an enclosing scope. Threading updates to outer mutables is
# `rebind`'s job (docs/119 §5), and `|capture|` headers (docs/119 §6) are sugar over
# that. This purity is what makes blocks safe to read locally — the header/binding site
# tells you everything the block can change.

extend Semantic:
    private:
        # Collect all names bound within a block's statement list (locals, loop variables,
        # pattern bindings). Nested value blocks run their own E4 pass; their bindings
        # are still swept up here so a write to them from an inner statement is never
        # mis-flagged.
        def collect_block_bound_names(statements: darray[Ast::Stmt], local: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |local|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            local.push(name)
                        Stmt.Assign(target, operator, value, line):
                            pass
                        Stmt.If(condition, then_body, else_body, line):
                            collect_block_bound_names(then_body, local)
                            collect_block_bound_names(else_body, local)
                        Stmt.While(condition, body, line):
                            collect_block_bound_names(body, local)
                        Stmt.For(bind, variables, iterable, body, line):
                            local.extend(variables)
                            collect_block_bound_names(body, local)
                        Stmt.Block(kind, clause, binding, body, line):
                            local.push(binding) if binding != ""
                            collect_block_bound_names(body, local)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                gather_pattern_names(arm.pattern, local)
                                collect_block_bound_names(arm.body, local)
                        # Other statements bind nothing.
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass


        # Gather names from a pattern (used by collect_block_bound_names).
        def gather_pattern_names(pattern: Ast::Pattern, local: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Binding(name):
                        local.push(name)
                    Ast::Pattern.Pin(name):
                        pass
                    Ast::Pattern.Tuple(elements):
                        for element in elements:
                            gather_pattern_names(element, local)
                    Ast::Pattern.Rest(name):
                        local.push(name) if name != ""
                    Ast::Pattern.Variant(path, fields):
                        for field in fields:
                            gather_pattern_names(field, local)
                    Ast::Pattern.Struct(path, fields):
                        for field in fields:
                            gather_pattern_names(field, local)
                    Ast::Pattern.Or(options):
                        for option in options:
                            gather_pattern_names(option, local)
                    Ast::Pattern.TypeBind(bound_type, binder):
                        local.push(binder)
                    Ast::Pattern.As(name, inner):
                        # docs/122 §5.4: the as-name plus the wrapped pattern's bindings.
                        local.push(name)
                        for inner_pattern in inner:
                            gather_pattern_names(inner_pattern, local)
                    # Other patterns (Wildcard, Literal, Range, Other) bind nothing.
                    Ast::Pattern.Wildcard:
                        pass
                    Ast::Pattern.Literal(text):
                        pass
                    Ast::Pattern.Range(lo, hi, inclusive):
                        pass
                    Ast::Pattern.Other(text):
                        pass


        # Check if a name is in the local set (for efficiency, since this is called often).
        def is_local(name: sview, locals: darray[sview]) -> bool:
            can Abort.Panic:
                return any local_name in locals where local_name == name


        # Find a symbol by name in the table's symbol array.
        def find_symbol(table: SymbolTable&, name: sview) -> Semantic::Symbol?:
            can Abort.Panic:
                for symbol in table.symbols:
                    symbol return if symbol.name == name
                return null


        # Mutability of the nearest in-scope binding for `name`. `bound` and
        # `bound_mutability` are parallel stacks maintained by the resolver; scanning
        # backward makes shadowing choose the innermost declaration.
        def bound_name_is_mutable(name: sview, bound: darray[sview]&, bound_mutability: darray[bool]&) -> bool:
            can Abort.Panic:
                index: mutable usize = bound.count
                while index > 0:
                    index <- index - 1
                    bound_mutability[index] return if bound[index] == name
                return false


        # Root identifier name of an assignment target expression (for mutation checks).
        # Returns true if the target is a simple identifier or a field/index chain rooted
        # at one; returns the name if so, empty otherwise.
        def target_root_ident(target: Ast::Expr) -> sview:
            can Abort.Panic:
                match target:
                    Ast::Expr.Ident(name, line):
                        return name
                    Ast::Expr.Field(object, field, line):
                        return target_root_ident(object)
                    Ast::Expr.Index(object, index, line):
                        return target_root_ident(object)
                    Ast::Expr.Slice(object, low, high, line):
                        return target_root_ident(object)
                    _:
                        return ""


        # Walk statements looking for direct assignments to outer bindings.
        def walk_value_block_mutations(statements: darray[Ast::Stmt], locals: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            name: sview = target_root_ident(target)
                            # An outer binding (exists in the symbol table, not a local) mutated
                            # inside a value block — excluding compiler-synthesized `__` names (E4).
                            if name != "" and not is_local(name, locals) and find_symbol(table, name) is symbol and not (sview_len(name) >= 2 and sview_at(name, 0) == '_' and sview_at(name, 1) == '_'):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ValueBlockMutation, name: name, line: line, expected: "", actual: ""})
                            table
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_value_block_mutations(then_body, locals, table)
                            table <- walk_value_block_mutations(else_body, locals, table)
                            table
                        Stmt.While(condition, body, line):
                            table <- walk_value_block_mutations(body, locals, table)
                            table
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_value_block_mutations(body, locals, table)
                            table
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_value_block_mutations(body, locals, table)
                            table
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- walk_value_block_mutations(arm.body, locals, table)
                        # Other statements have no assignment targets. Explicit (no wildcard)
                        # so a new Stmt variant forces a decision here.
                        Stmt.VarDecl(name, type_expression, value, line):
                            table
                        Stmt.Expr(expression, line):
                            table
                        Stmt.Return(value, line):
                            table
                        Stmt.Break(label, line):
                            table
                        Stmt.Continue(label, line):
                            table
                        Stmt.Contract(kind, expression, line):
                            table
                        Stmt.Invalid:
                            table


        # Check a value block (ExprBlock) for E4/E10/E11 violations (docs/119 §2/§6).
        # E4: direct assignments to outer bindings are illegal (unless captured).
        # E10/E11: every capture name must be an existing, mutable outer binding.
        def check_value_block(expr_block: Ast::Expr, table: lmut SymbolTable, bound: darray[sview]&, bound_mutability: darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expr_block:
                    Ast::Expr.Block(statements, value, captures, line):
                        # Collect all block-local bindings.
                        local: mutable darray[sview] = []
                        collect_block_bound_names(statements, local)

                        # Validate captures (E10/E11): every capture must name an existing,
                        # mutable outer binding.
                        for capture in captures |table, local| -> table:
                            if name_known(table, bound, capture):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CaptureImmutable, name: capture, line: line, expected: "", actual: ""}) if not bound_name_is_mutable(capture, bound, bound_mutability)
                                local.push(capture)
                                table
                            else:
                                # Binding not found in scope (E11).
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CaptureUndefined, name: capture, line: line, expected: "", actual: ""})
                                table

                        # Check E4: direct assignments to outer bindings (except captures
                        # and compiler-synthesized `__` names).
                        table <- walk_value_block_mutations(statements, local, table)
                    _:
                        pass
