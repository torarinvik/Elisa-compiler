# Mandatory direct-access and direct-call grants for explicitly mutable globals.
# Separate from the legacy optional all-global inference/checking dial.
extend Semantic:
    private:
        def mg_call_bind_local(bindings: mutable darray[StrictUnsafeCallEffectBinding]&, name: sview, type_expression: Ast::Expr, value: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                effects: mutable darray[sview] = []
                declared_effects: darray[sview] = strict_unsafe_effect_refs_for_type(type_expression, annotations)
                value_effects: darray[sview] = strict_unsafe_effect_refs_for_value(value, bindings, table)
                for effect in declared_effects |effects|:
                    add: bool = effect != "" and effect_ref_family(effect) == "Global" and not (any known in effects where known == effect)
                    effects.push(effect) if add
                for effect in value_effects |effects|:
                    add: bool = effect != "" and effect_ref_family(effect) == "Global" and not (any known in effects where known == effect)
                    effects.push(effect) if add
                original_count: usize = bindings.count
                read_index: mutable usize = 0
                write_index: mutable usize = 0
                while read_index < original_count |read_index, write_index, original_count, bindings, name|:
                    existing: StrictUnsafeCallEffectBinding = bindings[read_index]
                    if existing.name != name:
                        bindings[write_index] <- existing
                        write_index <- write_index + 1
                    read_index <- read_index + 1
                bindings <- bindings.truncate(write_index)
                bindings.push(StrictUnsafeCallEffectBinding{name: name, effect: ""})
                for effect in effects |bindings|:
                    bindings.push(StrictUnsafeCallEffectBinding{name: name, effect: effect})

        def mg_expression_reads(expression: Ast::Expr, globals: darray[sview]&, locals: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return gp_names_global(name, globals, locals)
                    Expr.Field(object, field, field_line):
                        return mg_expression_reads(object, globals, locals)
                    Expr.Paren(inner, paren_line):
                        return mg_expression_reads(inner, globals, locals)
                    Expr.Unary(operator, operand, unary_line):
                        return mg_expression_reads(operand, globals, locals)
                    Expr.Binary(left, operator, right, binary_line):
                        return mg_expression_reads(left, globals, locals) or mg_expression_reads(right, globals, locals)
                    Expr.Index(object, index_argument, index_line):
                        return mg_expression_reads(object, globals, locals) or mg_expression_reads(index_argument, globals, locals)
                    Expr.IndexN(object_n, arguments_n, index_n_line):
                        true return if mg_expression_reads(object_n, globals, locals)
                        for argument_n in arguments_n:
                            true return if mg_expression_reads(argument_n, globals, locals)
                        return false
                    Expr.Call(callee, arguments, argument_names, call_line):
                        true return if mg_expression_reads(callee, globals, locals)
                        for argument in arguments:
                            true return if mg_expression_reads(argument, globals, locals)
                        return false
                    Expr.Array(elements, array_line):
                        for element in elements:
                            true return if mg_expression_reads(element, globals, locals)
                        return false
                    Expr.Tuple(tuple_elements, tuple_line):
                        for tuple_element in tuple_elements:
                            true return if mg_expression_reads(tuple_element, globals, locals)
                        return false
                    Expr.SetLit(set_elements, set_line):
                        for set_element in set_elements:
                            true return if mg_expression_reads(set_element, globals, locals)
                        return false
                    Expr.If(condition, then_expr, else_expr, pos):
                        return mg_expression_reads(condition, globals, locals) or mg_expression_reads(then_expr, globals, locals) or mg_expression_reads(else_expr, globals, locals)
                    Expr.Move(operand, pos):
                        return mg_expression_reads(operand, globals, locals)
                    Expr.RegionNew(operand, region, pos):
                        return mg_expression_reads(operand, globals, locals)
                    Expr.Slice(object, low, high, pos):
                        return mg_expression_reads(object, globals, locals) or mg_expression_reads(low, globals, locals) or mg_expression_reads(high, globals, locals)
                    Expr.Construct(type_expression, fields, pos):
                        for field in fields:
                            true return if mg_expression_reads(field.value, globals, locals)
                        return false
                    Expr.RecordUpdate(base, fields, pos):
                        true return if mg_expression_reads(base, globals, locals)
                        for field in fields:
                            true return if mg_expression_reads(field.value, globals, locals)
                        return false
                    Expr.DictLit(entries, pos):
                        for entry in entries:
                            true return if mg_expression_reads(entry.key, globals, locals) or mg_expression_reads(entry.value, globals, locals)
                        return false
                    _:
                        return false

        def mg_body_calls(statements: darray[Ast::Stmt], want_write: bool, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Expr(expression, line):
                            mg_expression_calls(expression, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            mg_expression_calls(value, out)
                        Stmt.Assign(target, operator, value, line):
                            mg_expression_calls(value, out)
                        Stmt.Return(value, line):
                            if value is returned:
                                mg_expression_calls(returned, out)
                        Stmt.If(condition, then_body, else_body, line):
                            mg_expression_calls(condition, out)
                            mg_body_calls(then_body, want_write, out)
                            mg_body_calls(else_body, want_write, out)
                        Stmt.While(condition, while_body, line):
                            mg_expression_calls(condition, out)
                            mg_body_calls(while_body, want_write, out)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            mg_expression_calls(iterable, out)
                            mg_body_calls(for_body, want_write, out)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            block_kind: sview = kind
                            discharged: bool = block_kind == "trusted" and gp_clause_discharges(clause, want_write)
                            mg_body_calls(block_body, want_write, out) if not discharged
                        Stmt.Match(scrutinee, arms, line):
                            mg_expression_calls(scrutinee, out)
                            for arm in arms |out|:
                                mg_body_calls(arm.body, want_write, out)
                        _:
                            pass

        # Every direct callee inside an expression. `called_function_name` normalizes a
        # module-qualified call (`M::f()`) to the declaration registry's key (`f`).
        def mg_expression_calls(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = called_function_name(expression)
                        out.push(callee_name) if callee_name != ""
                        for argument in arguments |out|:
                            mg_expression_calls(argument, out)
                    Expr.Binary(left, operator, right, binary_line):
                        mg_expression_calls(left, out)
                        mg_expression_calls(right, out)
                    Expr.Unary(operator, operand, unary_line):
                        mg_expression_calls(operand, out)
                    Expr.Paren(inner, paren_line):
                        mg_expression_calls(inner, out)
                    Expr.Index(object, index_argument, index_line):
                        mg_expression_calls(object, out)
                        mg_expression_calls(index_argument, out)
                    Expr.If(condition, then_expr, else_expr, pos):
                        mg_expression_calls(condition, out)
                        mg_expression_calls(then_expr, out)
                        mg_expression_calls(else_expr, out)
                    Expr.Array(elements, pos) | Expr.Tuple(elements, pos) | Expr.SetLit(elements, pos):
                        for element in elements |out|:
                            mg_expression_calls(element, out)
                    Expr.Field(object, field, pos):
                        mg_expression_calls(object, out)
                    Expr.IndexN(object, arguments, pos):
                        mg_expression_calls(object, out)
                        for argument in arguments |out|:
                            mg_expression_calls(argument, out)
                    Expr.Slice(object, low, high, pos):
                        mg_expression_calls(object, out)
                        mg_expression_calls(low, out)
                        mg_expression_calls(high, out)
                    Expr.Move(operand, pos):
                        mg_expression_calls(operand, out)
                    Expr.RegionNew(operand, region, pos):
                        mg_expression_calls(operand, out)
                    Expr.Construct(type_expression, fields, pos):
                        for field in fields |out|:
                            mg_expression_calls(field.value, out)
                    Expr.RecordUpdate(base, fields, pos):
                        mg_expression_calls(base, out)
                        for field in fields |out|:
                            mg_expression_calls(field.value, out)
                    Expr.Block(statements, value, captures, pos):
                        mg_body_calls(statements, false, out)
                        mg_expression_calls(value, out)
                    Expr.DictLit(entries, pos):
                        for entry in entries |out|:
                            mg_expression_calls(entry.key, out)
                            mg_expression_calls(entry.value, out)
                    _:
                        pass

        def mg_expression_calls_require(expression: Ast::Expr, locals: darray[sview]&, want_write: bool, table: SymbolTable&, bindings: darray[StrictUnsafeCallEffectBinding]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                callees: mutable darray[sview] = []
                mg_expression_calls(expression, callees)
                member: sview = "Global.Write" if want_write else "Global.Read"
                for callee in callees:
                    local_binding: bool = any binding in bindings where binding.name == callee
                    if local_binding:
                        true return if any binding in bindings where binding.name == callee and (binding.effect == member or binding.effect == "Global")
                        continue
                    continue if any local in locals where local == callee
                    refs: darray[sview] = function_effect_refs(table, callee)
                    true return if any ref in refs where ref == member or ref == "Global"
                return false

        def mg_statement_calls_require(statement: Ast::Stmt, locals: darray[sview]&, want_write: bool, table: SymbolTable&, bindings: darray[StrictUnsafeCallEffectBinding]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, line):
                        return mg_expression_calls_require(expression, locals, want_write, table, bindings)
                    Stmt.VarDecl(name, type_expression, value, line):
                        return mg_expression_calls_require(value, locals, want_write, table, bindings)
                    Stmt.Assign(target, operator, value, line):
                        return mg_expression_calls_require(target, locals, want_write, table, bindings) or mg_expression_calls_require(value, locals, want_write, table, bindings)
                    Stmt.Return(value, line):
                        if value is returned:
                            return mg_expression_calls_require(returned, locals, want_write, table, bindings)
                    Stmt.If(condition, then_body, else_body, line):
                        return mg_expression_calls_require(condition, locals, want_write, table, bindings)
                    Stmt.While(condition, body, line):
                        return mg_expression_calls_require(condition, locals, want_write, table, bindings)
                    Stmt.For(bind, variables, iterable, body, line):
                        return mg_expression_calls_require(iterable, locals, want_write, table, bindings)
                    Stmt.Match(scrutinee, arms, line):
                        return mg_expression_calls_require(scrutinee, locals, want_write, table, bindings)
                    _:
                        pass
                return false

        def mg_body_reads(statements: darray[Ast::Stmt], globals: darray[sview]&, locals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, incoming: darray[StrictUnsafeCallEffectBinding]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                bound: mutable darray[sview] = [local for local in locals]
                bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(incoming)
                for statement in statements |bound, bindings|:
                    true return if mg_statement_calls_require(statement, bound, false, table, bindings)
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if mg_expression_reads(expression, globals, bound)
                        Stmt.VarDecl(name, type_expression, value, line):
                            true return if mg_expression_reads(value, globals, bound)
                            mg_call_bind_local(bindings, name, type_expression, value, annotations, table)
                            bound.push(name)
                        Stmt.Assign(target, operator, value, line):
                            true return if mg_expression_reads(value, globals, bound)
                            if target is Expr.Ident(name, pos):
                                if operator == TokenKind.Assign or any local in bound where local == name:
                                    mg_call_bind_local(bindings, name, Ast::Expr.Invalid, value, annotations, table)
                                    bound.push(name) if operator == TokenKind.Assign
                            true return if gp_is_compound_assign(operator) and gp_target_root_is_global(target, globals, bound)
                            true return if gp_target_reads(target, globals, bound)
                        Stmt.Return(value, line):
                            if value is returned:
                                true return if mg_expression_reads(returned, globals, bound)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if mg_expression_reads(condition, globals, bound)
                            true return if mg_body_reads(then_body, globals, bound, annotations, table, bindings)
                            true return if mg_body_reads(else_body, globals, bound, annotations, table, bindings)
                        Stmt.While(condition, while_body, line):
                            true return if mg_expression_reads(condition, globals, bound)
                            true return if mg_body_reads(while_body, globals, bound, annotations, table, bindings)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            true return if mg_expression_reads(iterable, globals, bound)
                            true return if mg_body_reads(for_body, globals, bound, annotations, table, bindings)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            block_kind: sview = kind
                            discharged: bool = (block_kind == "trusted" and clause.count == 0) or ((block_kind == "trusted" or block_kind == "can") and cov_ref_covered(annotations, clause, "Global.Read", 0))
                            true return if not discharged and mg_body_reads(block_body, globals, bound, annotations, table, bindings)
                        Stmt.Match(scrutinee, arms, line):
                            true return if mg_expression_reads(scrutinee, globals, bound)
                            for arm in arms:
                                true return if mg_body_reads(arm.body, globals, bound, annotations, table, bindings)
                        _:
                            pass
                return false

        # Whether a body STORES into a global outside any `trusted` block covering Global.Write.
        def mg_body_writes(statements: darray[Ast::Stmt], globals: darray[sview]&, locals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, incoming: darray[StrictUnsafeCallEffectBinding]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                bound: mutable darray[sview] = [local for local in locals]
                bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(incoming)
                for statement in statements |bound, bindings|:
                    true return if mg_statement_calls_require(statement, bound, true, table, bindings)
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            mg_call_bind_local(bindings, name, type_expression, value, annotations, table)
                            bound.push(name)
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Ident(name, pos):
                                if operator == TokenKind.Assign or any local in bound where local == name:
                                    mg_call_bind_local(bindings, name, Ast::Expr.Invalid, value, annotations, table)
                                    bound.push(name) if operator == TokenKind.Assign
                            true return if gp_target_root_is_global(target, globals, bound)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if mg_body_writes(then_body, globals, bound, annotations, table, bindings)
                            true return if mg_body_writes(else_body, globals, bound, annotations, table, bindings)
                        Stmt.While(condition, while_body, line):
                            true return if mg_body_writes(while_body, globals, bound, annotations, table, bindings)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            true return if mg_body_writes(for_body, globals, bound, annotations, table, bindings)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            block_kind: sview = kind
                            discharged: bool = (block_kind == "trusted" and clause.count == 0) or ((block_kind == "trusted" or block_kind == "can") and cov_ref_covered(annotations, clause, "Global.Write", 0))
                            true return if not discharged and mg_body_writes(block_body, globals, bound, annotations, table, bindings)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if mg_body_writes(arm.body, globals, bound, annotations, table, bindings)
                        _:
                            pass
                return false

        def mg_infer_body_reads(statements: darray[Ast::Stmt], globals: darray[sview]&, locals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, incoming: darray[StrictUnsafeCallEffectBinding]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                bound: mutable darray[sview] = [local for local in locals]
                bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(incoming)
                for statement in statements |bound, bindings|:
                    match statement:
                        Stmt.Expr(expression, line):
                            true return if mg_expression_reads(expression, globals, bound)
                        Stmt.VarDecl(name, type_expression, value, line):
                            true return if mg_expression_reads(value, globals, bound)
                            mg_call_bind_local(bindings, name, type_expression, value, annotations, table)
                            bound.push(name)
                        Stmt.Assign(target, operator, value, line):
                            true return if mg_expression_reads(value, globals, bound)
                            if target is Expr.Ident(name, pos):
                                if operator == TokenKind.Assign or any local in bound where local == name:
                                    mg_call_bind_local(bindings, name, Ast::Expr.Invalid, value, annotations, table)
                                    bound.push(name) if operator == TokenKind.Assign
                            true return if gp_is_compound_assign(operator) and gp_target_root_is_global(target, globals, bound)
                            true return if gp_target_reads(target, globals, bound)
                        Stmt.Return(value, line):
                            if value is returned:
                                true return if mg_expression_reads(returned, globals, bound)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if mg_expression_reads(condition, globals, bound)
                            true return if mg_infer_body_reads(then_body, globals, bound, annotations, table, bindings)
                            true return if mg_infer_body_reads(else_body, globals, bound, annotations, table, bindings)
                        Stmt.While(condition, while_body, line):
                            true return if mg_expression_reads(condition, globals, bound)
                            true return if mg_infer_body_reads(while_body, globals, bound, annotations, table, bindings)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            true return if mg_expression_reads(iterable, globals, bound)
                            true return if mg_infer_body_reads(for_body, globals, bound, annotations, table, bindings)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            block_kind: sview = kind
                            discharged: bool = (block_kind == "trusted" and clause.count == 0) or (block_kind == "trusted" and cov_ref_covered(annotations, clause, "Global.Read", 0))
                            true return if not discharged and mg_infer_body_reads(block_body, globals, bound, annotations, table, bindings)
                        Stmt.Match(scrutinee, arms, line):
                            true return if mg_expression_reads(scrutinee, globals, bound)
                            for arm in arms:
                                true return if mg_infer_body_reads(arm.body, globals, bound, annotations, table, bindings)
                        _:
                            pass
                return false

        # Whether a body STORES into a global outside any `trusted` block covering Global.Write.
        def mg_infer_body_writes(statements: darray[Ast::Stmt], globals: darray[sview]&, locals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&, incoming: darray[StrictUnsafeCallEffectBinding]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                bound: mutable darray[sview] = [local for local in locals]
                bindings: mutable darray[StrictUnsafeCallEffectBinding] = strict_unsafe_call_bindings_copy(incoming)
                for statement in statements |bound, bindings|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            mg_call_bind_local(bindings, name, type_expression, value, annotations, table)
                            bound.push(name)
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Ident(name, pos):
                                if operator == TokenKind.Assign or any local in bound where local == name:
                                    mg_call_bind_local(bindings, name, Ast::Expr.Invalid, value, annotations, table)
                                    bound.push(name) if operator == TokenKind.Assign
                            true return if gp_target_root_is_global(target, globals, bound)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if mg_infer_body_writes(then_body, globals, bound, annotations, table, bindings)
                            true return if mg_infer_body_writes(else_body, globals, bound, annotations, table, bindings)
                        Stmt.While(condition, while_body, line):
                            true return if mg_infer_body_writes(while_body, globals, bound, annotations, table, bindings)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            true return if mg_infer_body_writes(for_body, globals, bound, annotations, table, bindings)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            block_kind: sview = kind
                            discharged: bool = (block_kind == "trusted" and clause.count == 0) or (block_kind == "trusted" and cov_ref_covered(annotations, clause, "Global.Write", 0))
                            true return if not discharged and mg_infer_body_writes(block_body, globals, bound, annotations, table, bindings)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if mg_infer_body_writes(arm.body, globals, bound, annotations, table, bindings)
                        _:
                            pass
                return false

        def check_mutable_global_grants_decls(declarations: darray[Ast::Decl], globals: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            locals: mutable darray[sview] = []
                            bindings: mutable darray[StrictUnsafeCallEffectBinding] = []
                            for parameter in parameters |locals, bindings|:
                                locals.push(parameter.name)
                                mg_call_bind_local(bindings, parameter.name, parameter.type_expression, Ast::Expr.Invalid, annotations, table)
                            if not cov_ref_covered(annotations, effects, "Global.Read", 0) and mg_body_reads(body, globals, locals, annotations, table, bindings):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalGrantMissing, name: name, line: line.line, expected: "Global.Read", actual: ""})
                            if not cov_ref_covered(annotations, effects, "Global.Write", 0) and mg_body_writes(body, globals, locals, annotations, table, bindings):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableGlobalGrantMissing, name: name, line: line.line, expected: "Global.Write", actual: ""})
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_mutable_global_grants_decls(module_body, globals, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_mutable_global_grants_decls(scoped_body, globals, annotations, table)
                        _:
                            pass

        def mg_axis_facts(declarations: darray[Ast::Decl], globals: darray[sview]&, want_write: bool, out_names: mutable darray[sview]&, out_direct: mutable darray[bool]&, out_from: mutable darray[sview]&, out_to: mutable darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_names, out_direct, out_from, out_to|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            locals: mutable darray[sview] = []
                            bindings: mutable darray[StrictUnsafeCallEffectBinding] = []
                            for parameter in parameters |locals, bindings|:
                                locals.push(parameter.name)
                                mg_call_bind_local(bindings, parameter.name, parameter.type_expression, Ast::Expr.Invalid, annotations, table)
                            out_names.push(name)
                            out_direct.push(mg_infer_body_writes(body, globals, locals, annotations, table, bindings) if want_write else mg_infer_body_reads(body, globals, locals, annotations, table, bindings))
                            callees: mutable darray[sview] = []
                            mg_body_calls(body, want_write, callees)
                            for callee in callees |out_from, out_to|:
                                out_from.push(name)
                                out_to.push(callee)
                        Decl.Module(module_name, module_body, module_line):
                            mg_axis_facts(module_body, globals, want_write, out_names, out_direct, out_from, out_to, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            mg_axis_facts(scoped_body, globals, want_write, out_names, out_direct, out_from, out_to, annotations, table)
                        _:
                            pass

        def check_mutable_global_grants(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                all_globals: mutable darray[sview] = []
                collect_mutable_globals(file.top_decls, all_globals)
                writable: mutable darray[sview] = []
                collect_writable_globals(all_globals, file.enum_annotations, writable)
                return if writable.count == 0
                read_names: mutable darray[sview] = []
                read_direct: mutable darray[bool] = []
                read_from: mutable darray[sview] = []
                read_to: mutable darray[sview] = []
                mg_axis_facts(file.top_decls, writable, false, read_names, read_direct, read_from, read_to, file.enum_annotations, table)
                gp_close_axis(read_names, read_direct, read_from, read_to)
                write_names: mutable darray[sview] = []
                write_direct: mutable darray[bool] = []
                write_from: mutable darray[sview] = []
                write_to: mutable darray[sview] = []
                mg_axis_facts(file.top_decls, writable, true, write_names, write_direct, write_from, write_to, file.enum_annotations, table)
                gp_close_axis(write_names, write_direct, write_from, write_to)
                for index in 0..<read_names.count |table|:
                    table <- gp_push_source_row(read_names[index], "Global.Read", table) if read_direct[index]
                for index in 0..<write_names.count |table|:
                    table <- gp_push_source_row(write_names[index], "Global.Write", table) if write_direct[index]
                table <- check_mutable_global_grants_decls(file.top_decls, writable, file.enum_annotations, table)
