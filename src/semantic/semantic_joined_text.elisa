# Interned synthesised names (see SymbolTable.joined_text): the program-lived replacement for
# views into the growable `text_storage` buffer.
extend Semantic:
    public:
        const JOINED_TEXT_CHUNK: usize = 65536

        # The interned copy of BYTES: an existing equal row, or a new one appended to the
        # program-region store. Valid for the whole compilation.
        def intern_joined_text(bytes: darray[u8]&, table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                hash: mutable u64 = SEMANTIC_HASH_OFFSET
                for byte in bytes |hash|:
                    hash <- (hash ^ byte.u64()) * SEMANTIC_HASH_PRIME
                row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.joined_text_heads.get(hash) is head:
                    row <- head
                found: mutable u32 = SYMBOL_INDEX_ROW_NONE
                while row != SYMBOL_INDEX_ROW_NONE and found == SYMBOL_INDEX_ROW_NONE |row, found, table, bytes|:
                    candidate: sview @source = table.joined_text_rows[row.usize()]
                    if candidate.len == bytes.count:
                        same: mutable bool = true
                        for index in 0..<bytes.count |same, candidate, bytes|:
                            same <- false if candidate[index] != bytes[index]
                        found <- row if same
                    row <- table.joined_text_next[row.usize()]
                return table.joined_text_rows[found.usize()] if found != SYMBOL_INDEX_ROW_NONE
                text: sview @source = NameStore::append(&table.joined_text, bytes, JOINED_TEXT_CHUNK)
                next: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.joined_text_heads.get(hash) is previous:
                    next <- previous
                table.joined_text_heads[hash] <- table.joined_text_rows.count.u32()
                table.joined_text_rows <- table.joined_text_rows.push(text)
                table.joined_text_next <- table.joined_text_next.push(next)
                return text

        # Intern each row into the program-region store and publish it in
        # table.param_growth_rows (the rows themselves live in the caller's region).
        def intern_param_growth_rows(rows: darray[sview]&, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for row in rows |table|:
                    row_bytes: mutable darray[u8] = []
                    row_bytes.reserve(row.len)
                    for index in 0..<row.len |row_bytes, row|:
                        row_bytes.push(row[index])
                    interned: sview @source = intern_joined_text(row_bytes, table)
                    table.param_growth_rows <- table.param_growth_rows.push(interned)
