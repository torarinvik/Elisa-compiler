# Check for a FIRM PRIMITIVE value (literal or firm scalar) bound where the declared
# type is a registered STRUCT (`q: P = 5`, `return 3` from `-> P`). Struct targets only:
# enums are NEVER targeted (an enum may legally accept int-ish values) and unknown/named
# targets never fire (the type-inference engine's Unknown is bottom).

extend Semantic:
    private:
        # A declaration in the current module or one of its parents is lexically visible.
        # Compare the module separator too (`Ui` is not an ancestor of `UiKit::Widgets`).
        def named_type_owner_is_lexical(owner: sview, current: sview) -> bool:
            can Abort.Panic:
                true return if owner == ""
                true return if owner == current
                owner_length: usize = sview_len(owner)
                current_length: usize = sview_len(current)
                false return if owner_length + 2.usize() > current_length
                false return if sview_at(current, owner_length) != 58 or sview_at(current, owner_length + 1.usize()) != 58
                for index in 0..<owner_length |owner, current|:
                    false return if sview_at(owner, index) != sview_at(current, index)
                return true

        def named_type_owner_is_imported(owner: sview, type_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                true return if any imported in table.imported_modules where imported == owner
                true return if any brought in table.imported_members where brought == type_name
                return false

        # Whether `type_name` names a registered STRUCT. Use the declaration index rather
        # than scanning every field row. Resolve the nearest visible declaration kind rather
        # than treating any same-spelled struct elsewhere in the program as a nominal target.
        def named_struct_target(type_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if type_name == ""
                row: mutable u32 = symbol_chain_head(table, type_name)
                best_rank: mutable usize = 0
                best_kind: mutable SymbolKind = SymbolKind.Unknown
                best_found: mutable bool = false
                best_ambiguous: mutable bool = false
                while row != SYMBOL_INDEX_ROW_NONE |row, table, type_name|:
                    symbol: Semantic::Symbol = table.symbols[row.usize()]
                    if symbol.name == type_name and (symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Alias):
                        lexical: bool = named_type_owner_is_lexical(symbol.module_owner, table.current_module)
                        imported: bool = named_type_owner_is_imported(symbol.module_owner, type_name, table)
                        if lexical or imported:
                            # Longer lexical prefixes are nearer. Imported-only candidates
                            # rank below root/parent declarations; equal-rank conflicts stay
                            # unknown so this diagnostic wall cannot guess through ambiguity.
                            rank: usize = sview_len(symbol.module_owner) + 1.usize() if lexical else 0.usize()
                            if not best_found or best_rank < rank:
                                best_rank <- rank
                                best_kind <- symbol.kind
                                best_found <- true
                                best_ambiguous <- false
                            elif best_rank == rank and best_kind != symbol.kind:
                                best_ambiguous <- true
                    row <- table.symbol_name_next[row.usize()]
                return best_found and not best_ambiguous and best_kind == SymbolKind.Struct

        # The value's firm-primitive descriptor ("int"/"float"/"string"/"char"/"bool" from
        # a direct literal, or the inferred family for a firm scalar expression), "" if the
        # value is not a firm primitive (Construct/call/struct-typed ident/Unknown all yield
        # "" via the engine's Unknown bottom, by design — never flagged).
        def named_mismatch_value_kind(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                literal_kind: sview = literal_kind_of(value)
                literal_kind return if literal_kind != ""
                return infer_family(value, names, types, table)

        # Flag a value against a declared STRUCT type if the value is a firm primitive.
        def check_named_value_against(value: Ast::Expr, type_name: sview, declared_name: sview, report_pos: Ast::Pos, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                value_kind: sview = named_mismatch_value_kind(value, names, types, table)
                firm_primitive: bool = value_kind == "int" or value_kind == "float" or value_kind == "string" or value_kind == "char" or value_kind == "bool"
                # `value_kind` is the coarse FAMILY. It answers the gate question (is this a
                # firm primitive?) but it is NOT what stage0 prints: stage0 spells a string
                # literal `static u8&`, a float literal `f64`, and a firm scalar by its
                # DECLARED name (`u8`, `i32`, `cstr`) -- never the family. Measured
                # 2026-09-19 over 5 literal kinds and 5 firm scalars against a struct wall.
                reportable: bool = named_struct_target(type_name, table) and firm_primitive
                spelling: sview = stage0_expr_spelling(value, infer_expression_type(value, names, types, table)) if reportable else ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: declared_name, pos: report_pos, line: report_pos.line, expected: type_name, actual: spelling}) if reportable

        # Walk through statements, tracking variable types and checking for named-type
        # mismatches on var-decl initializers, `<-` reassignments, and returns.
        def walk_statements_for_named_type_mismatch(statements: darray[Ast::Stmt], return_type_name: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, var_types, type_names| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            table <- check_named_value_against(value, type_name, name, line, var_types, type_names, table)
                            note_local_type(var_types, type_names, name, type_name)
                            note_local_type_id(name, type_expression, table)
                        Stmt.Assign(target, operator, value, line):
                            # `q <- 5` for `q: P` is stage0's ASSIGN sentence -- `cannot assign
                            # int to P`, spanning the TARGET -- not this kind's declaration
                            # sentence at a column-less position, which is what reporting it
                            # here produced (measured 2026-09-19). check_assigned_value_against
                            # already owns that sentence and that span for the primitive walls;
                            # the struct wall lives beside them there.
                            pass
                        Stmt.Return(value, line):
                            table <- check_named_value_against(returned_value, return_type_name, "return", line, var_types, type_names, table) if value is returned_value
                        Stmt.If(condition, then_body, else_body, line):
                            scope_mark: usize = var_types.count
                            table <- note_unknown_field_is_binders(condition, var_types, type_names, table)
                            table <- walk_statements_for_named_type_mismatch(then_body, return_type_name, table, var_types, type_names)
                            table <- close_type_scope(scope_mark, var_types, type_names, table)
                            table <- walk_statements_for_named_type_mismatch(else_body, return_type_name, table, var_types, type_names)
                            table <- close_type_scope(scope_mark, var_types, type_names, table)
                        Stmt.While(condition, body, line):
                            scope_mark: usize = var_types.count
                            table <- note_unknown_field_is_binders(condition, var_types, type_names, table)
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                            table <- close_type_scope(scope_mark, var_types, type_names, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            scope_mark: usize = var_types.count
                            for variable in variables |table, var_types, type_names|:
                                note_local_type(var_types, type_names, variable, "__firm_scope_binder__")
                                note_local_type_id_direct(variable, 0, table)
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                            table <- close_type_scope(scope_mark, var_types, type_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            scope_mark: usize = var_types.count
                            if binding != "":
                                note_local_type(var_types, type_names, binding, "__firm_scope_binder__")
                                note_local_type_id_direct(binding, 0, table)
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                            table <- close_type_scope(scope_mark, var_types, type_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, var_types, type_names| -> table:
                                scope_mark: usize = var_types.count
                                table <- note_unknown_field_pattern_binders(arm.pattern, var_types, type_names, table)
                                table <- walk_statements_for_named_type_mismatch(arm.body, return_type_name, table, var_types, type_names)
                                table <- close_type_scope(scope_mark, var_types, type_names, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations, seeding a fresh local-type table + the
        # declared return type name per function.
        def check_named_type_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            seed_local_type_ids(params, table)
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |var_types, type_names|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            return_type_name: mutable sview = ""
                            if return_type is return_type_expr:
                                return_type_name <- bare_type_name(return_type_expr)
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            enclosing_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- check_named_type_mismatch_declarations(body, table)
                            table.current_module <- enclosing_module
                        Decl.Scoped(body, line):
                            table <- check_named_type_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_named_type_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_named_type_mismatch_declarations(declarations, table)
