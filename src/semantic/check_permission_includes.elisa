# Permission `includes` validation (stage0 analyzer_permissions). A `permission X: includes Q`
# must reference a declared permission (else "permission X includes unknown family Q"), and the
# `includes` graph must be acyclic (else "permission X has a cyclic `includes` chain through Y").
#
# The parser records declared permissions (owner "__permission_decl") and each include edge
# (owner=permission, name=included, sentinel 3900000007) on the side-table.
extend Semantic:
    private:
        def permission_declared(declared: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any declared_name in declared where declared_name == name

        # Whether `start` can reach `target` by following include edges (bounded DFS with a visited
        # list to terminate on cycles). Edges are the parallel (edge_from, edge_to) arrays.
        def permission_reaches(start: sview, target: sview, edge_from: darray[sview]&, edge_to: darray[sview]&, visited: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if any seen in visited where seen == start
                visited.push(start)
                found: mutable bool = false
                edge_index: mutable usize = 0
                while edge_index < edge_from.count |found, visited|:
                    if edge_from[edge_index] == start:
                        successor: sview = edge_to[edge_index]
                        found <- true if successor == target
                        found <- true if not found and permission_reaches(successor, target, edge_from, edge_to, visited)
                    edge_index <- edge_index + 1
                return found

        def check_permission_includes(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                declared: mutable darray[sview] = []
                edge_from: mutable darray[sview] = []
                edge_to: mutable darray[sview] = []
                for annotation in file.enum_annotations |declared, edge_from, edge_to|:
                    # `__permission_decl`: owner is the sentinel, name is the declared permission.
                    declared.push(annotation.name) if annotation.owner == "__permission_decl"
                    # include edge (sentinel 3900000007): owner = permission, name = included family.
                    if annotation.line == 3900000007:
                        edge_from.push(annotation.owner)
                        edge_to.push(annotation.name)
                edge_index: mutable usize = 0
                while edge_index < edge_from.count |table, edge_index| -> table:
                    from_name: sview = edge_from[edge_index]
                    to_name: sview = edge_to[edge_index]
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PermissionUnknownFamily, name: from_name, line: 0, expected: to_name, actual: ""}) if not permission_declared(declared, to_name)
                    reach_visited: mutable darray[sview] = []
                    is_cyclic: bool = permission_reaches(to_name, from_name, edge_from, edge_to, reach_visited)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PermissionCycle, name: from_name, line: 0, expected: to_name, actual: ""}) if is_cyclic
                    edge_index <- edge_index + 1
