extend Semantic:
    private:
        # Stage1 semantic layer — name resolution (internal helpers, module-private).
        #
        # Walks each function body's VALUE expressions and resolves every identifier reference
        # against the names in scope: the function's parameters, its local bindings (var-decls,
        # for-loop variables, match-arm pattern bindings, `is` refinements, comprehension
        # variables, prefix-clause bindings), and the file's global symbol table. References
        # that resolve to none of these are counted as unresolved. Type-position expressions
        # (param/return/var-declaration annotations) are deliberately NOT walked, so built-in type
        # names don't register as unresolved.


        # A name is in scope if it is a parameter/local (bound) or a global declaration. The
        # global half is an O(1) index probe (`name_indexed`) rather than a scan of every
        # symbol; `bound` (a function's locals) stays a linear scan since it is small.
        # Max recursive expression-analysis depth shared by the semantic expression walks.
        # Their frames retain substantial AST/type state, so this must stay well below the
        # native stack limit; exceeding it is diagnosed rather than silently skipping a subtree.
        const EXPRESSION_ANALYSIS_DEPTH_LIMIT: u32 = 128

        # Whether module `owner` declares a member named `name` — a walk of `name`'s own
        # member hash chain, the same chain name_indexed uses.
        def module_declares_member(table: SymbolTable&, owner: sview, name: sview) -> bool:
            can Abort.Panic:
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_row, table, owner, name|:
                    member_index: usize = member_row.usize()
                    return true if table.module_member_name[member_index] == name and table.module_member_owner[member_index] == owner
                    member_row <- table.member_name_next[member_index]
                return false


        def name_is_module(table: SymbolTable&, bound: darray[sview @source]&, name: sview) -> bool:
            can Abort.Panic:
                return false if any bound_name in bound where bound_name == name
                return true if semantic_possible_import_module_alias(table, name, table.current_module)
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, name|:
                    symbol: Symbol& = &table.symbols[row.usize()]
                    return true if symbol.name == name and symbol.kind == SymbolKind.Module
                    row <- table.symbol_name_next[row.usize()]
                return false


        # Does `head::tail` name a module? A module declared with a QUALIFIED name
        # (`module Outer::Inner:`) is recorded VERBATIM, separators and all, because the
        # parser captures the whole chain as one source span. A use of it therefore arrives
        # as a NESTED Scope — `Outer::Inner::f` is Scope(Scope(Ident, "Inner"), "f") — whose
        # base is not a bare Ident, so the qualifier test missed it and `Outer` was walked as
        # a VALUE and reported undefined.
        #
        # Compared piecewise against the recorded name rather than by building `head::tail`:
        # joining would mean allocating a name just to look one up.
        #
        # Only symbols NAMED `head::rest` can match, so probe that joined name's chain in the
        # symbol name index (binding_module_candidate_hash hashes the join without building
        # it) instead of scanning every symbol; each row is still compared in full.
        def two_part_names_module(table: SymbolTable&, head: sview, rest: sview) -> bool:
            can Abort.Panic:
                return false if head.len == 0
                row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                row <- chain_head if table.symbol_name_head.get(binding_module_candidate_hash(head, head.len, rest)) is chain_head
                while row != SYMBOL_INDEX_ROW_NONE |row, table, head, rest|:
                    symbol: Symbol& = &table.symbols[row.usize()]
                    return true if symbol.kind == SymbolKind.Module and qualified_name_matches(symbol.name, head, rest)
                    row <- table.symbol_name_next[row.usize()]
                return false


        # Recognize a module qualifier relative to any enclosing namespace.
        # Compare borrowed spans directly; no transient joined name escapes.
        def ancestor_names_module(table: SymbolTable&, rest: sview) -> bool:
            can Abort.Panic:
                enclosing: sview = table.current_module
                prefix: mutable usize = enclosing.len
                while prefix > 0 |prefix, enclosing, table, rest|:
                    # Candidates are named `enclosing[..prefix]::rest`: walk that name's chain.
                    row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    row <- chain_head if table.symbol_name_head.get(binding_module_candidate_hash(enclosing, prefix, rest)) is chain_head
                    while row != SYMBOL_INDEX_ROW_NONE |row, prefix, enclosing, rest, table|:
                        symbol: Symbol& = &table.symbols[row.usize()]
                        row <- table.symbol_name_next[row.usize()]
                        continue if symbol.kind != SymbolKind.Module
                        continue if symbol.name.len != prefix + 2.usize() + rest.len
                        matches: mutable bool = true
                        for index in 0..<prefix |matches, symbol, enclosing|:
                            matches <- false if symbol.name[index] != enclosing[index]
                        continue if not matches
                        continue if symbol.name[prefix] != 58 or symbol.name[prefix + 1.usize()] != 58
                        return true if sview_slice_equals(symbol.name, prefix + 2.usize(), rest)
                    parent: mutable usize = 0
                    for index in 0..<prefix |parent, enclosing|:
                        parent <- index if index + 1.usize() < prefix and enclosing[index] == 58 and enclosing[index + 1.usize()] == 58
                    prefix <- parent
                return false


        # `candidate == head ++ "::" ++ tail`, without building the join.
        def qualified_name_matches(candidate: sview, head: sview, rest: sview) -> bool:
            can Abort.Panic:
                head_length: usize = head.len
                rest_length: usize = rest.len
                return false if:
                    head_length == 0 or rest_length == 0
                    candidate.len != head_length + 2.usize() + rest_length
                for index in 0..<head_length |candidate, head|:
                    return false if candidate[index] != head[index]
                return false if:
                    candidate[head_length] != 58
                    candidate[head_length + 1.usize()] != 58
                for index in 0..<rest_length |candidate, rest, head_length|:
                    return false if candidate[head_length + 2.usize() + index] != rest[index]
                return true


        # Whether a VALUE-position object names a module: a bare identifier (module-only,
        # unshadowed -- the existing rule) or a pure `::` chain (`Pack::Sub`) that names a
        # declared module, absolutely or relative to the current module.
        def value_chain_is_module[@table, @session, @session_borrow, @request, @request_borrow](table: mutable SymbolTable& @table, bound: darray[sview @source]&, object: Ast::Expr, lookup_session: mutable IncrementalSemanticSession[session]&? @session_borrow, lookup_context: mutable IncrementalSemanticNameLookupContext[request]& @request_borrow) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match object:
                    Expr.Ident(chain_ident_name, chain_ident_pos):
                        classification: (known: bool, module_only: bool) = resolver_name_classification(table, bound, chain_ident_name, lookup_session, lookup_context)
                        return classification.known and classification.module_only
                    Expr.Scope(chain_scope_base, chain_scope_name, chain_scope_pos):
                        names: mutable darray[sview] = []
                        dotted: mutable darray[bool] = []
                        return false if:
                            not type_path_collect(object, names, dotted)
                            any was_dotted in dotted where was_dotted
                            any bound_name in bound where bound_name == names[0]
                        no_aliases: darray[sview] = []
                        no_alias_targets: darray[sview @source] = []
                        no_alias_scopes: darray[sview @source] = []
                        no_alias_uncertain: darray[bool] = []
                        enclosing: sview = table.current_module
                        return type_path_prefix_is_module(names, names.count, enclosing, no_aliases, no_alias_targets, no_alias_scopes, no_alias_uncertain, table)
                    _:
                        return false


        # The spelling stage0 quotes for such an object: the identifier itself, or the
        # chain re-joined with `::`.
        def value_chain_text(object: Ast::Expr, table: lmut SymbolTable) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match object:
                    Expr.Ident(text_ident_name, text_ident_pos):
                        return text_ident_name
                    _:
                        names: mutable darray[sview] = []
                        dotted: mutable darray[bool] = []
                        return sview("", 0, 0) if not type_path_collect(object, names, dotted)
                        rebind joined: sview @source, table = type_path_text(names, 0, names.count, dotted, names.count, table)
                        return joined


        def name_known(table: SymbolTable&, bound: darray[sview @source]&, name: sview) -> bool:
            can Abort.Panic:
                # `_` is the discard wildcard, never a real binding: it appears as a
                # thread-claim discard target (`parser, _ <- parser.advance()`,
                # docs/120 §11) and in destructures, and always "resolves".
                return true if:
                    name == "_"
                    # `old` is the contract-only pre-state operator (`ensure x > old(x)`,
                    # docs/87); stage0 resolves it as a spec builtin.
                    name == "old"
                    # `ensures(f, PRED)` is the higher-order contract predicate — asserts that
                    # callable `f` guarantees PRED of its result (stage0's
                    # analyzer_higher_order_contracts). Resolved as a spec builtin like `old`.
                    name == "ensures"
                # `variants(Enum)` / `fields(Struct)` — the compile-time REFLECTION
                # builtins (static_builders): stage0 resolves them in static contexts and
                # evaluates them during static execution. stage1 resolves them like the
                # other spec builtins; static bodies are compile-time-only and emit no
                # runtime code, so resolution is all the analyzer owes them.
                is_reflection_builtin: bool = match name:
                    "variants" | "fields": true
                    _: false
                return true if:
                    is_reflection_builtin
                    any bound_name in bound where bound_name == name
                return true if semantic_possible_import_name_visible(table, name, table.current_module)
                # `region r(4096):` BINDS `r` — it is passed to functions taking a region
                # (`build(r)`). The parser records each one as a `__region_name` annotation
                # and check_full already collects those into table.region_names; the block
                # itself carries no `binding`, so without this the name read as undefined.
                return true if any region_name in table.region_names where region_name == name
                return false if not name_indexed(table, name)
                # Both counts walk THIS name's hash chains (symbols and module members)
                # instead of every declaration in the program — this function runs once
                # per resolved identifier, and the two full scans under it were the
                # hottest sview-compare loops in the whole compile.
                symbol_count: mutable usize = 0
                symbol_row: mutable u32 = symbol_chain_head(table, name)
                while symbol_row != SYMBOL_INDEX_ROW_NONE |symbol_count, symbol_row, table, name|:
                    chain_symbol: Symbol& = &table.symbols[symbol_row.usize()]
                    symbol_count <- symbol_count + 1 if chain_symbol.name == name and chain_symbol.kind != SymbolKind.Module
                    symbol_row <- table.symbol_name_next[symbol_row.usize()]
                member_count: mutable usize = 0
                visible_member: mutable bool = false
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_count, visible_member, member_row, table, name|:
                    member_index: usize = member_row.usize()
                    if table.module_member_name[member_index] == name:
                        member_count <- member_count + 1
                        owner: sview = table.module_member_owner[member_index]
                        visible_member <- true if owner == table.current_module or (any imported in table.imported_modules where imported == owner) or (any brought in table.imported_members where brought == name)
                    member_row <- table.member_name_next[member_index]
                return visible_member or symbol_count > member_count or symbol_count == 0


        # Resolve the composite result used at expression-identifier read sites.
        # Unlike the general helpers above, this cold path fuses their work: the
        # symbol chain is traversed once to compute both name existence counts and
        # module-only classification. A true bound-membership-checked flag means
        # the caller already established that no local binding matches.
        def resolver_name_classification_cold(table: mutable SymbolTable&, bound: darray[sview @source]&, name: sview, bound_membership_checked: bool, region_membership_known: bool, region_name_present: bool) -> (known: bool, module_only: bool) can[Abort.Panic]:
            if not bound_membership_checked:
                return (true, false) if any bound_name in bound where bound_name == name
            return (true, false) if semantic_possible_import_name_visible(table, name, table.current_module)

            is_reflection_builtin: bool = match name:
                "variants" | "fields": true
                _: false
            forced_known: mutable bool = name == "_" or name == "old" or name == "ensures" or is_reflection_builtin
            if not forced_known:
                region_present: mutable bool = region_name_present
                if not region_membership_known:
                    region_present <- any region_name in table.region_names where region_name == name
                forced_known <- region_present

            return (false, false) if not forced_known and not name_indexed(table, name)

            nonmodule_count: mutable usize = 0
            saw_module: mutable bool = false
            symbol_row: mutable u32 = symbol_chain_head(table, name)
            while symbol_row != SYMBOL_INDEX_ROW_NONE |nonmodule_count, saw_module, symbol_row, table, name, forced_known|:
                table.incremental_name_lookup_chain_visits <- table.incremental_name_lookup_chain_visits + 1 if table.incremental_name_lookup_metrics_enabled and table.incremental_name_lookup_chain_visits < 18446744073709551615
                chain_symbol: Symbol& = &table.symbols[symbol_row.usize()]
                if chain_symbol.name == name:
                    if chain_symbol.kind == SymbolKind.Module:
                        saw_module <- true
                    elif forced_known:
                        return (true, false)
                    else:
                        nonmodule_count <- nonmodule_count + 1
                symbol_row <- table.symbol_name_next[symbol_row.usize()]

            known: mutable bool = forced_known
            if not forced_known:
                member_count: mutable usize = 0
                visible_member: mutable bool = false
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_count, visible_member, member_row, table, name|:
                    table.incremental_name_lookup_chain_visits <- table.incremental_name_lookup_chain_visits + 1 if table.incremental_name_lookup_metrics_enabled and table.incremental_name_lookup_chain_visits < 18446744073709551615
                    member_index: usize = member_row.usize()
                    if table.module_member_name[member_index] == name:
                        member_count <- member_count + 1
                        owner: sview = table.module_member_owner[member_index]
                        visible_member <- true if owner == table.current_module or (any imported in table.imported_modules where imported == owner) or (any brought in table.imported_members where brought == name)
                    member_row <- table.member_name_next[member_index]
                known <- visible_member or nonmodule_count > member_count or nonmodule_count == 0

            return (known, known and saw_module and nonmodule_count == 0)


        # Return the open-addressed surface slot for `name`, comparing the full spelling
        # after the hash probe. Call only when slots are non-empty.
        def resolver_name_surface_slot(table: SymbolTable&, name: sview) -> usize:
            can Abort.Panic:
                mask: usize = table.resolver_name_surface.slots.count - 1
                slot: mutable usize = name_hash(name).usize() & mask
                while table.resolver_name_surface.slots[slot] != SYMBOL_INDEX_ROW_NONE |slot, table, name, mask|:
                    row: usize = table.resolver_name_surface.slots[slot].usize()
                    return slot if table.resolver_name_surface.names[row] == name
                    slot <- (slot + 1) & mask
                return slot


        def resolver_name_surface_grow(table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < (table.resolver_name_surface.names.count + 1) * 2 |capacity, table|:
                    capacity <- capacity * 2
                table.resolver_name_surface.slots <- table.resolver_name_surface.slots.truncate(0)
                table.resolver_name_surface.slots <- table.resolver_name_surface.slots.reserve(capacity)
                for slot_index in 0..<capacity |table|:
                    table.resolver_name_surface.slots <- table.resolver_name_surface.slots.push(SYMBOL_INDEX_ROW_NONE)
                for row in 0..<table.resolver_name_surface.names.count |table|:
                    slot: usize = resolver_name_surface_slot(table, table.resolver_name_surface.names[row])
                    table.resolver_name_surface.slots[slot] <- row.u32()


        # Get or create the exact-name summary row. Row IDs reserve u32::MAX as empty.
        def resolver_name_surface_add(table: mutable SymbolTable&, name: sview @source) -> u32:
            can Memory.Allocate, Abort.Panic:
                if table.resolver_name_surface.slots.count < (table.resolver_name_surface.names.count + 1) * 2:
                    resolver_name_surface_grow(table)
                slot: usize = resolver_name_surface_slot(table, name)
                existing: u32 = table.resolver_name_surface.slots[slot]
                return existing if existing != SYMBOL_INDEX_ROW_NONE
                if table.resolver_name_surface.names.count >= 4294967295.usize():
                    table.resolver_name_surface.valid <- false
                    return SYMBOL_INDEX_ROW_NONE
                row: u32 = table.resolver_name_surface.names.count.u32()
                table.resolver_name_surface.names <- table.resolver_name_surface.names.push(name)
                table.resolver_name_surface.symbol_present <- table.resolver_name_surface.symbol_present.push(false)
                table.resolver_name_surface.nonmodule_counts <- table.resolver_name_surface.nonmodule_counts.push(0)
                table.resolver_name_surface.module_present <- table.resolver_name_surface.module_present.push(false)
                table.resolver_name_surface.member_counts <- table.resolver_name_surface.member_counts.push(0)
                table.resolver_name_surface.imported_visible <- table.resolver_name_surface.imported_visible.push(false)
                table.resolver_name_surface.region_present <- table.resolver_name_surface.region_present.push(false)
                table.resolver_name_surface.slots[slot] <- row
                return row


        def resolver_member_pair_hash(owner: sview, name: sview) -> u64:
            can Abort.Panic:
                return struct_field_pair_hash(owner, name)


        def resolver_member_pair_slot(table: SymbolTable&, owner: sview, name: sview) -> usize:
            can Abort.Panic:
                mask: usize = table.resolver_name_surface.member_pairs.slots.count - 1
                slot: mutable usize = resolver_member_pair_hash(owner, name).usize() & mask
                while table.resolver_name_surface.member_pairs.slots[slot] != SYMBOL_INDEX_ROW_NONE |slot, table, owner, name, mask|:
                    row: usize = table.resolver_name_surface.member_pairs.slots[slot].usize()
                    return slot if table.resolver_name_surface.member_pairs.owners[row] == owner and table.resolver_name_surface.member_pairs.names[row] == name
                    slot <- (slot + 1) & mask
                return slot


        def resolver_member_pair_grow(table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < (table.resolver_name_surface.member_pairs.names.count + 1) * 2 |capacity, table|:
                    capacity <- capacity * 2
                table.resolver_name_surface.member_pairs.slots <- table.resolver_name_surface.member_pairs.slots.truncate(0)
                table.resolver_name_surface.member_pairs.slots <- table.resolver_name_surface.member_pairs.slots.reserve(capacity)
                for slot_index in 0..<capacity |table|:
                    table.resolver_name_surface.member_pairs.slots <- table.resolver_name_surface.member_pairs.slots.push(SYMBOL_INDEX_ROW_NONE)
                for row in 0..<table.resolver_name_surface.member_pairs.names.count |table|:
                    slot: usize = resolver_member_pair_slot(table, table.resolver_name_surface.member_pairs.owners[row], table.resolver_name_surface.member_pairs.names[row])
                    table.resolver_name_surface.member_pairs.slots[slot] <- row.u32()


        def resolver_member_pair_add(table: mutable SymbolTable&, owner: sview @source, name: sview @source) -> bool:
            can Memory.Allocate, Abort.Panic:
                if table.resolver_name_surface.member_pairs.slots.count < (table.resolver_name_surface.member_pairs.names.count + 1) * 2:
                    resolver_member_pair_grow(table)
                slot: usize = resolver_member_pair_slot(table, owner, name)
                return true if table.resolver_name_surface.member_pairs.slots[slot] != SYMBOL_INDEX_ROW_NONE
                if table.resolver_name_surface.member_pairs.names.count >= 4294967295.usize():
                    return false
                row: u32 = table.resolver_name_surface.member_pairs.names.count.u32()
                table.resolver_name_surface.member_pairs.owners <- table.resolver_name_surface.member_pairs.owners.push(owner)
                table.resolver_name_surface.member_pairs.names <- table.resolver_name_surface.member_pairs.names.push(name)
                table.resolver_name_surface.member_pairs.slots[slot] <- row
                return true


        def resolver_member_pair_contains(table: SymbolTable&, owner: sview, name: sview) -> bool:
            can Abort.Panic:
                return false if not table.resolver_name_surface.member_pairs.valid or table.resolver_name_surface.member_pairs.slots.count == 0
                slot: usize = resolver_member_pair_slot(table, owner, name)
                return table.resolver_name_surface.member_pairs.slots[slot] != SYMBOL_INDEX_ROW_NONE


        # Build these summaries once after all declaration rows and visibility annotations
        # have been collected. Queries then validate one spelling and one module/member pair
        # without traversing the symbol, member, or region-name chains.
        def resolver_finalize_name_surface(table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                table.resolver_name_surface.valid <- false
                table.resolver_name_surface.member_pairs.valid <- false
                table.resolver_name_surface.names <- table.resolver_name_surface.names.truncate(0)
                table.resolver_name_surface.slots <- table.resolver_name_surface.slots.truncate(0)
                table.resolver_name_surface.symbol_present <- table.resolver_name_surface.symbol_present.truncate(0)
                table.resolver_name_surface.nonmodule_counts <- table.resolver_name_surface.nonmodule_counts.truncate(0)
                table.resolver_name_surface.module_present <- table.resolver_name_surface.module_present.truncate(0)
                table.resolver_name_surface.member_counts <- table.resolver_name_surface.member_counts.truncate(0)
                table.resolver_name_surface.imported_visible <- table.resolver_name_surface.imported_visible.truncate(0)
                table.resolver_name_surface.region_present <- table.resolver_name_surface.region_present.truncate(0)
                table.resolver_name_surface.member_pairs.owners <- table.resolver_name_surface.member_pairs.owners.truncate(0)
                table.resolver_name_surface.member_pairs.names <- table.resolver_name_surface.member_pairs.names.truncate(0)
                table.resolver_name_surface.member_pairs.slots <- table.resolver_name_surface.member_pairs.slots.truncate(0)
                return if:
                    not table.symbol_name_index_valid
                    table.symbol_name_next.count != table.symbols.count
                    table.module_member_owner.count != table.module_member_name.count
                    table.member_name_next.count != table.module_member_name.count
                imported_modules: mutable NameSet = empty_name_set()
                imported_members: mutable NameSet = empty_name_set()
                for imported_module in table.imported_modules:
                    name_set_add(&imported_modules, imported_module)
                for imported_member in table.imported_members:
                    name_set_add(&imported_members, imported_member)
                symbol_count: usize = table.symbols.count
                for symbol_index in 0..<symbol_count |table, imported_modules, imported_members|:
                    symbol_name: sview @source = table.symbols[symbol_index].name
                    symbol_kind: SymbolKind = table.symbols[symbol_index].kind
                    if not name_indexed(table, symbol_name):
                        return
                    surface_row: u32 = resolver_name_surface_add(table, symbol_name)
                    return if surface_row == SYMBOL_INDEX_ROW_NONE
                    row: usize = surface_row.usize()
                    table.resolver_name_surface.symbol_present[row] <- true
                    if symbol_kind == SymbolKind.Module:
                        table.resolver_name_surface.module_present[row] <- true
                    else:
                        return if table.resolver_name_surface.nonmodule_counts[row] == 4294967295
                        table.resolver_name_surface.nonmodule_counts[row] <- table.resolver_name_surface.nonmodule_counts[row] + 1
                for member_index in 0..<table.module_member_name.count |table, imported_modules, imported_members|:
                    member_name: sview = table.module_member_name[member_index]
                    member_owner: sview = table.module_member_owner[member_index]
                    surface_row: u32 = resolver_name_surface_add(table, member_name)
                    return if surface_row == SYMBOL_INDEX_ROW_NONE
                    row: usize = surface_row.usize()
                    return if table.resolver_name_surface.member_counts[row] == 4294967295
                    table.resolver_name_surface.member_counts[row] <- table.resolver_name_surface.member_counts[row] + 1
                    table.resolver_name_surface.imported_visible[row] <- true if name_set_contains(imported_modules, member_owner) or name_set_contains(imported_members, member_name)
                    return if not resolver_member_pair_add(table, member_owner, member_name)
                region_name_count: usize = table.region_names.count
                for region_index in 0..<region_name_count |table|:
                    region_name: sview @source = table.region_names[region_index]
                    surface_row: u32 = resolver_name_surface_add(table, region_name)
                    return if surface_row == SYMBOL_INDEX_ROW_NONE
                    table.resolver_name_surface.region_present[surface_row.usize()] <- true
                table.resolver_name_surface.member_pairs.valid <- true
                table.resolver_name_surface.valid <- true


        def resolver_name_surface_for_lookup(table: SymbolTable&, current_module: sview, name: sview) -> ResolverNameLookupSurface:
            can Abort.Panic:
                invalid: ResolverNameLookupSurface = ResolverNameLookupSurface{valid: false, name_indexed: false, nonmodule_symbol_count: 0, module_present: false, member_count: 0, imported_visible_member: false, current_module_member: false, region_name_present: false}
                return invalid if not table.resolver_name_surface.valid or not table.resolver_name_surface.member_pairs.valid
                symbol_present: mutable bool = false
                nonmodule_count: mutable u32 = 0
                module_present: mutable bool = false
                member_count: mutable u32 = 0
                imported_visible: mutable bool = false
                region_present: mutable bool = false
                if table.resolver_name_surface.slots.count > 0:
                    slot: usize = resolver_name_surface_slot(table, name)
                    surface_row: u32 = table.resolver_name_surface.slots[slot]
                    if surface_row != SYMBOL_INDEX_ROW_NONE:
                        row: usize = surface_row.usize()
                        symbol_present <- table.resolver_name_surface.symbol_present[row]
                        nonmodule_count <- table.resolver_name_surface.nonmodule_counts[row]
                        module_present <- table.resolver_name_surface.module_present[row]
                        member_count <- table.resolver_name_surface.member_counts[row]
                        imported_visible <- table.resolver_name_surface.imported_visible[row]
                        region_present <- table.resolver_name_surface.region_present[row]
                return ResolverNameLookupSurface{valid: true, name_indexed: symbol_present, nonmodule_symbol_count: nonmodule_count, module_present: module_present, member_count: member_count, imported_visible_member: imported_visible, current_module_member: resolver_member_pair_contains(table, current_module, name), region_name_present: region_present}


        # Equivalent to resolver_name_classification_cold after the lexical-bound
        # check, using only the exact finalized per-name surface. Keep this as a
        # separate A/B route so graph overhead can be compared without changing the
        # default graph path or cold fallback.
        def resolver_name_classification_from_surface(name: sview, surface: ResolverNameLookupSurface) -> (known: bool, module_only: bool):
            is_reflection_builtin: bool = match name:
                "variants" | "fields": true
                _: false
            forced: bool = name == "_" or name == "old" or name == "ensures" or is_reflection_builtin or surface.region_name_present
            return (false, false) if not forced and not surface.name_indexed
            known: bool = forced or surface.imported_visible_member or surface.current_module_member or surface.nonmodule_symbol_count > surface.member_count or surface.nonmodule_symbol_count == 0
            module_only: bool = known and surface.module_present and surface.nonmodule_symbol_count == 0
            return (known, module_only)


        # The expression resolver caches the composite classification used by an
        # Expr.Ident. Locals are already answered by the lexical bound set, so they
        # bypass the global query and retain the existing short-circuit behavior.
        def resolver_name_classification[@table, @session, @session_borrow, @request, @request_borrow](table: mutable SymbolTable& @table, bound: darray[sview @source]&, name: sview, lookup_session: mutable IncrementalSemanticSession[session]&? @session_borrow, lookup_context: mutable IncrementalSemanticNameLookupContext[request]& @request_borrow) -> (known: bool, module_only: bool) can[Memory.Allocate, Abort.Panic, Global{Read,Write}]:
            track_stats: bool = table.incremental_name_lookup_metrics_enabled
            if not incremental_semantic_name_lookup_context_is_active(lookup_context):
                # Avoid even reading the per-table counter on ordinary non-reporting
                # requests. The actual classification remains the same cold path.
                if not track_stats:
                    return resolver_name_classification_cold(table, bound, name, false, false, false)
                chain_visits_before: u64 = table.incremental_name_lookup_chain_visits
                result: (known: bool, module_only: bool) = resolver_name_classification_cold(table, bound, name, false, false, false)
                chain_visits_after: u64 = table.incremental_name_lookup_chain_visits
                incremental_semantic_name_lookup_record_chain_visits(lookup_context, chain_visits_after - chain_visits_before)
                return result
            return (true, false) if any bound_name in bound where bound_name == name
            return (true, false) if semantic_possible_import_name_visible(table, name, table.current_module)
            if incremental_semantic_name_lookup_context_begin_surface_build(lookup_context):
                resolver_finalize_name_surface(table)
            surface: ResolverNameLookupSurface = resolver_name_surface_for_lookup(table, table.current_module, name)
            if not surface.valid:
                # If the one-shot surface build was unavailable or failed its completeness
                # checks, preserve the cold classifier and avoid querying partial facts.
                chain_visits_before: u64 = table.incremental_name_lookup_chain_visits if track_stats else 0
                result: (known: bool, module_only: bool) = resolver_name_classification_cold(table, bound, name, true, false, false)
                if track_stats:
                    chain_visits_after: u64 = table.incremental_name_lookup_chain_visits
                    incremental_semantic_name_lookup_record_chain_visits(lookup_context, chain_visits_after - chain_visits_before)
                return result
            if incremental_semantic_name_lookup_context_uses_direct_surface_mode(lookup_context):
                incremental_semantic_name_lookup_record_direct_surface_classification(lookup_context)
                return resolver_name_classification_from_surface(name, surface)
            cached: mutable IncrementalSemanticNameLookupResult = IncrementalSemanticNameLookupResult{hit: false, known: false, module_only: false}
            can Unsafe.PointerCast:
                cached <- incremental_semantic_name_lookup_evaluate(lookup_context, lookup_session, table.current_module, name, surface) can Global{Read,Write}
            return (cached.known, cached.module_only) if cached.hit
            chain_visits_before: u64 = table.incremental_name_lookup_chain_visits if track_stats else 0
            result: (known: bool, module_only: bool) = resolver_name_classification_cold(table, bound, name, true, true, surface.region_name_present)
            if track_stats:
                chain_visits_after: u64 = table.incremental_name_lookup_chain_visits
                incremental_semantic_name_lookup_record_chain_visits(lookup_context, chain_visits_after - chain_visits_before)
            can Unsafe.PointerCast:
                _ = incremental_semantic_name_lookup_commit(lookup_context, lookup_session, result.known, result.module_only) can Global{Read,Write}
            return result


        # Allocate a lexical identity owned by the current function. The serial is
        # table-local and monotonic, so branch copies preserve identity while new
        # declarations, including same-named shadows, receive distinct values.
        def fresh_binding_id(owner: DeclId, serial: mutable u64&) -> BindingId:
            can Abort.Panic:
                id: BindingId = BindingId{owner: owner, serial: serial}
                serial <- serial + 1
                return id


        # Recover the identifier span for binders held only as names in Stmt.For.
        # Older/synthesized patterns without a source annotation retain a line-only
        # sentinel and are explicitly distinguishable from exact source occurrences.
        def source_binder_position(table: SymbolTable&, name: sview, line: u32, ordinal: usize, binder_kind: sview) -> Ast::Pos:
            if table.binder_annotations_indexed:
                can Abort.Panic:
                    # The chain is newest-first, so the ORDINAL-th match in stream order is the
                    # (matches - 1 - ordinal)-th one met walking it.
                    head: u32 = binder_annotation_head(table, local_binding_exact_hash(name, line, 0))
                    matches: mutable usize = 0
                    row: mutable u32 = head
                    while row != SYMBOL_INDEX_ROW_NONE |row, matches, table, name, line, binder_kind|:
                        candidate: Ast::EnumAnnotation = table.binder_annotations[row.usize()]
                        matches <- matches + 1 if candidate.owner == binder_kind and candidate.line == line and candidate.name == name
                        row <- table.binder_annotation_next[row.usize()]
                    if ordinal < matches:
                        wanted: usize = matches - 1 - ordinal
                        met: mutable usize = 0
                        row <- head
                        while row != SYMBOL_INDEX_ROW_NONE |row, met, table, name, line, binder_kind, wanted|:
                            candidate: Ast::EnumAnnotation = table.binder_annotations[row.usize()]
                            if candidate.owner == binder_kind and candidate.line == line and candidate.name == name:
                                return candidate.pos if met == wanted
                                met <- met + 1
                            row <- table.binder_annotation_next[row.usize()]
                    return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            seen: mutable usize = 0
            for annotation in table.protocol_annotations:
                if annotation.owner == binder_kind and annotation.line == line and (binder_kind == "__for_binder" or annotation.name == name) and annotation.pos.end_offset > annotation.pos.offset:
                    if seen == ordinal:
                        return Ast::pos_at_line(0) if annotation.name != name
                        return annotation.pos
                    seen <- seen + 1
            return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}


        # Record one param/local occurrence for tooling (the LSP's semantic-token
        # highlighter reads these). `is_param` selects kind 1 (parameter) over 2
        # (local); the ID links each use back to the resolved lexical declaration.
        def record_reference(table: lmut SymbolTable, position: Ast::Pos, name: sview @source, is_param: bool, binding_id: BindingId) -> void:
            can Memory.Allocate, Abort.Panic:
                reference_index: usize = table.ref_binding_ids.count
                table.ref_line <- table.ref_line.push(position.line)
                table.ref_name <- table.ref_name.push(name)
                table.ref_kind <- table.ref_kind.push(1 if is_param else 2)
                table.ref_pos <- table.ref_pos.push(position)
                table.ref_binding_ids <- table.ref_binding_ids.push(binding_id)
                table.ref_owner_next <- table.ref_owner_next.push(SYMBOL_INDEX_ROW_NONE)
                owner_index: usize = binding_id.owner.value.usize()
                if reference_index >= SYMBOL_INDEX_ROW_NONE.usize():
                    table.ref_owner_index_valid <- false
                elif owner_index < table.symbols.count:
                    while table.ref_owner_heads.count <= owner_index |owner_index, table|:
                        table.ref_owner_heads <- table.ref_owner_heads.push(SYMBOL_INDEX_ROW_NONE)
                        table.ref_owner_tails <- table.ref_owner_tails.push(SYMBOL_INDEX_ROW_NONE)
                        table.ref_owner_counts <- table.ref_owner_counts.push(0.u32())
                        table.ref_owner_observed_counts <- table.ref_owner_observed_counts.push(0.usize())
                    if table.ref_owner_heads[owner_index] == SYMBOL_INDEX_ROW_NONE:
                        table.ref_owner_tails[owner_index] <- reference_index.u32()
                    table.ref_owner_next[reference_index] <- table.ref_owner_heads[owner_index]
                    table.ref_owner_heads[owner_index] <- reference_index.u32()
                    table.ref_owner_counts[owner_index] <- table.ref_owner_counts[owner_index] + 1.u32()
                    table.ref_owner_observed_counts[owner_index] <- table.ref_owner_observed_counts[owner_index] + 1.usize()
                else:
                    # An owner row that is not present cannot be represented in this
                    # table's bucket array. Keep every consumer on its canonical scan
                    # rather than letting an incomplete index omit this occurrence.
                    table.ref_owner_index_valid <- false


        # Exact-name rows chained under a numeric hash keep these short-lived indexes
        # collision-safe without using runtime-backed dictionaries with sview keys.
        struct PatternBinderNameIndex:
            heads: mutable dict[u64, u32]
            names: mutable darray[sview]
            values: mutable darray[usize]
            next: mutable darray[u32]
