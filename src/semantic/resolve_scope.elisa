extend Semantic:
    private:
        # Stage1 semantic layer — name resolution (internal helpers, module-private).
        #
        # Walks each function body's VALUE expressions and resolves every identifier reference
        # against the names in scope: the function's parameters, its local bindings (var-decls,
        # for-loop variables, match-arm pattern bindings, `is` refinements, comprehension
        # variables, prefix-clause bindings), and the file's global symbol table. References
        # that resolve to none of these are counted as unresolved. Type-position expressions
        # (param/return/var-declaration annotations) are deliberately NOT walked, so built-in type
        # names don't register as unresolved.


        # A name is in scope if it is a parameter/local (bound) or a global declaration. The
        # global half is an O(1) index probe (`name_indexed`) rather than a scan of every
        # symbol; `bound` (a function's locals) stays a linear scan since it is small.
        # Max AST-walk recursion depth (see SymbolTable.walk_depth). Far above any
        # real expression nesting, well below the stack-overflow threshold.
        const WALK_DEPTH_LIMIT: u32 = 4000

        def name_known(table: SymbolTable&, bound: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                # `_` is the discard wildcard, never a real binding: it appears as a
                # thread-claim discard target (`parser, _ <- parser.advance()`,
                # docs/120 §11) and in destructures, and always "resolves".
                true return if name == "_"
                return (any bound_name in bound where bound_name == name) or name_indexed(table, name)


        # Record one param/local occurrence for tooling (the LSP's semantic-token
        # highlighter reads these). `is_param` selects kind 1 (parameter) over 2
        # (local). No effect on diagnostics — a pure side log.
        def record_reference(table: lmut SymbolTable, line: u32, name: sview, is_param: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                table.ref_line <- table.ref_line.push(line)
                table.ref_name <- table.ref_name.push(name)
                table.ref_kind <- table.ref_kind.push(1 if is_param else 2)


        # Index of the innermost `bound` entry named `name`, else -1. Scans from
        # the end so a later local correctly shadows an earlier param/local.
        def bound_last_index(bound: darray[sview]&, name: sview) -> int:
            can Abort.Panic:
                while binding_index >= 0 |binding_index: int = bound.count.int() - 1|:
                    binding_index return if bound[binding_index.usize()] == name
                    binding_index <- binding_index - 1
                return -1


        # Collect the names a match-arm pattern binds: a bare `Binding`, the binder of a
        # category arm (`Type s`), and any binding subpatterns nested inside variant,
        # struct, tuple, or or-pattern fields. Wildcards/literals/paths bind nothing.
        def gather_pattern(pattern: Ast::Pattern, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        bound.push(name)
                    Pattern.TypeBind(type, binder):
                        bound.push(binder)
                    Pattern.Variant(path, fields):
                        for field_pattern in fields:
                            gather_pattern(field_pattern, bound)
                    Pattern.Struct(path, fields):
                        for field_pattern in fields:
                            gather_pattern(field_pattern, bound)
                    Pattern.Tuple(elements):
                        for element_pattern in elements:
                            gather_pattern(element_pattern, bound)
                    Pattern.Or(options):
                        for option_pattern in options:
                            gather_pattern(option_pattern, bound)
                    Pattern.As(name, inner):
                        # docs/122 §5.4: the as-name binds the whole value, plus the
                        # wrapped pattern's own bindings.
                        bound.push(name)
                        for inner_pattern in inner:
                            gather_pattern(inner_pattern, bound)
                    _:
                        pass


        # A refinement test `EXPR is TARGET` introduces bindings on its right side: a bare
        # name (`x is mod`) binds that name; a variant form (`x is Variant(a, b)`) binds each
        # field name. A qualified constant test (`x is Enum.Const`) binds nothing.
        def gather_is_target(expression: Ast::Expr, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        bound.push(name)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments:
                            gather_is_target(argument, bound)
                    _:
                        pass


        # Walk an expression collecting the bindings introduced by any `is` refinement test or
        # comprehension inside it, so later uses of those names resolve. (`as` casts bind nothing.)
        def gather_expression_bindings(expression: Ast::Expr, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        gather_expression_bindings(left, bound)
                        if operator == TokenKind.Is:
                            gather_is_target(right, bound)
                        else:
                            gather_expression_bindings(right, bound)
                    Expr.Call(callee, arguments, argument_names, line):
                        gather_expression_bindings(callee, bound)
                        for argument in arguments:
                            gather_expression_bindings(argument, bound)
                    Expr.Field(receiver, field, line):
                        gather_expression_bindings(receiver, bound)
                    Expr.Scope(base, name, line):
                        gather_expression_bindings(base, bound)
                    Expr.Index(receiver, index, line):
                        gather_expression_bindings(receiver, bound)
                        gather_expression_bindings(index, bound)
                    Expr.Unary(operator, operand, line):
                        gather_expression_bindings(operand, bound)
                    Expr.Paren(inner, line):
                        gather_expression_bindings(inner, bound)
                    Expr.Array(elements, line):
                        for element in elements:
                            gather_expression_bindings(element, bound)
                    Expr.Tuple(elements, line):
                        for element in elements:
                            gather_expression_bindings(element, bound)
                    Expr.Slice(receiver, low, high, line):
                        gather_expression_bindings(receiver, bound)
                        gather_expression_bindings(low, bound)
                        gather_expression_bindings(high, bound)
                    Expr.IndexN(receiver, arguments, line):
                        gather_expression_bindings(receiver, bound)
                        for argument in arguments:
                            gather_expression_bindings(argument, bound)
                    Expr.SetLit(elements, line):
                        for element in elements:
                            gather_expression_bindings(element, bound)
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            gather_expression_bindings(entry.key, bound)
                            gather_expression_bindings(entry.value, bound)
                    Expr.Construct(type, fields, line):
                        for field in fields:
                            gather_expression_bindings(field.value, bound)
                    Expr.RecordUpdate(base, fields, line):
                        gather_expression_bindings(base, bound)
                        for field in fields:
                            gather_expression_bindings(field.value, bound)
                    Expr.If(condition, then_expression, else_expression, line):
                        gather_expression_bindings(condition, bound)
                        gather_expression_bindings(then_expression, bound)
                        gather_expression_bindings(else_expression, bound)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        bound.push(variable)
                        gather_expression_bindings(iterable, bound)
                        gather_expression_bindings(condition, bound)
                        gather_expression_bindings(body, bound)
                    Expr.Lambda(parameters, body, line):
                        # The lambda's params scope its body; add them to `bound` plus
                        # any locals the body introduces (mirrors Comprehension's var —
                        # over-permissive to the outer scope, but never a false unresolved).
                        bound.extend([parameter for parameter in parameters])
                        gather_locals(body, bound)
                    Expr.Match(scrutinee, arms, line):
                        # Match in expression position introduces its arms' pattern bindings
                        # and any bindings inside arm bodies (mirrors Stmt.Match in gather_locals).
                        gather_expression_bindings(scrutinee, bound)
                        for arm in arms:
                            gather_pattern(arm.pattern, bound)
                            gather_locals(arm.body, bound)
                    Expr.Block(statements, value, captures, line):
                        # A block expression's leading locals scope the block (mirrors Lambda —
                        # over-permissive to the outer scope, but never a false unresolved).
                        gather_locals(statements, bound)
                        # Captures bind as locals too (for scope-flattening purposes).
                        bound.extend(captures)
                        gather_expression_bindings(value, bound)
                    # Leaves and references bind nothing. Listed explicitly (no wildcard) so a
                    # new Expr variant is a compile error rather than a silently-missed binding.
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.ShorthandMember(parts, line):
                        pass


        # Gather the names a function binds: var-declaration names, for-loop variables, match-arm
        # pattern bindings, `is`/comprehension bindings, and prefix-clause bindings across the
        # body (block scoping is flattened — a first pass accepts forward references).
        def gather_locals(statements: darray[Ast::Stmt], bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                total: usize = bound.count + statements.count * 8
                bound.reserve(total)
                for statement_index in 0..<statements.count |bound|:
                    statement: Ast::Stmt = statements[statement_index]
                    match statement:
                        Stmt.Expr(expression, line):
                            gather_expression_bindings(expression, bound)
                        Stmt.VarDecl(name, type_expression, value, line):
                            bound.push(name)
                            gather_expression_bindings(value, bound)
                        Stmt.Assign(target, operator, value, line):
                            # Multi-target unpack `a, b = …` (target is an Array literal)
                            # introduces its bare-ident targets as new locals; a single
                            # bare-ident `x = …` DEFINES a local too (incl. the `_`
                            # discard). `<-` targets are already-declared names, so
                            # registering them again is harmless.
                            if target is Expr.Array(elements, array_line):
                                for element in elements |bound|:
                                    if element is Expr.Ident(element_name, ident_line):
                                        bound.push(element_name)
                            if target is Expr.Ident(single_name, single_line):
                                bound.push(single_name)
                            gather_expression_bindings(target, bound)
                            gather_expression_bindings(value, bound)
                        Stmt.For(bind, variables, iterable, body, line):
                            bound.extend(variables)
                            gather_expression_bindings(iterable, bound)
                            gather_locals(body, bound)
                        Stmt.If(condition, then_body, else_body, line):
                            gather_expression_bindings(condition, bound)
                            gather_locals(then_body, bound)
                            gather_locals(else_body, bound)
                        Stmt.While(condition, body, line):
                            gather_expression_bindings(condition, bound)
                            gather_locals(body, bound)
                        Stmt.Return(value, line):
                            if value is return_value:
                                gather_expression_bindings(return_value, bound)
                        Stmt.Block(kind, clause, binding, body, line):
                            bound.push(binding) if binding != ""
                            gather_locals(body, bound)
                        Stmt.Match(scrutinee, arms, line):
                            gather_expression_bindings(scrutinee, bound)
                            for arm in arms:
                                gather_pattern(arm.pattern, bound)
                                gather_locals(arm.body, bound)
                        Stmt.Contract(kind, expression, line):
                            # An `ensure` predicate may reference the function's `result`.
                            bound.push("result") if kind == "ensure" or kind == "ensures"
                            gather_expression_bindings(expression, bound)
                        # These introduce no bindings. Explicit (no wildcard) so a new Stmt
                        # variant forces a decision here.
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
