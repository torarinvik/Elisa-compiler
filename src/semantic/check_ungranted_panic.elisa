# First effect-system diagnostic (deep tier). Elisa gates effect operations on a LOCAL
# grant: `panic(...)` requires an enclosing `can Abort.Panic:` (or `can ...:` / `trusted ...:`)
# block — a signature `can[...]` clause propagates the requirement to callers but does NOT
# discharge the local obligation (verified against stage0: an ungranted panic warns even when
# the signature declares `can[Abort.Panic]`). The stage1 codebase reflects this: ~495 `can X:`
# block grants vs ~7 signature clauses, so the block grant is THE mechanism.
#
# v1 SOUNDNESS STANCE (deliberately a strict subset of stage0's warnings — zero false
# positives is the prime directive): flag a `panic(...)` statement ONLY when it is lexically
# enclosed by NO `can`/`trusted` grant block at all AND its function declares no signature
# effects. This over-grants (any grant block of any family — even an alias-based one we cannot
# yet resolve — suppresses the flag), so it can never fire where stage0 stays silent; it only
# fires on a genuinely un-granted panic (which stage0 also warns on). Precision toward stage0
# parity (requiring the grant to specifically cover `Abort`, call-site effect requirements,
# transitive inference) is deferred to later increments once an effect-family registry exists.
extend Semantic:
    private:
        # The bare-identifier callee of a statement-position `Expr.Call`, or "" if the
        # statement is not a direct `name(...)` call. Detected at statement position only (a
        # call buried inside a sub-expression is a sound miss, never a false fire).
        def called_function_name(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_line):
                    match callee:
                        Expr.Ident(callee_name, ident_line):
                            return callee_name
                        _:
                            return sview("", 0, 0)
                _:
                    return sview("", 0, 0)


        # Whether a statement list performs a `panic(...)` NOT enclosed by a `trusted` block.
        # A `can` block discharges the panic locally but STILL propagates the Abort effect to
        # the function's row (verified against stage0), so `can`-wrapped panics count here;
        # only `trusted` drops the effect. Pure (no table) — a reachability predicate.
        def body_has_untrusted_panic(statements: darray[Ast::Stmt], in_trusted: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            source_callee: sview = called_function_name(expression)
                            true return if not in_trusted and source_callee == "panic"
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            block_trusted: mutable bool = in_trusted
                            block_trusted <- true if block_kind == "trusted"
                            true return if body_has_untrusted_panic(body, block_trusted)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if body_has_untrusted_panic(then_body, in_trusted) or body_has_untrusted_panic(else_body, in_trusted)
                        Stmt.While(condition, body, line):
                            true return if body_has_untrusted_panic(body, in_trusted)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if body_has_untrusted_panic(body, in_trusted)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if body_has_untrusted_panic(arm.body, in_trusted)
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass
                return false


        def body_has_untrusted_effect_call(statements: darray[Ast::Stmt], in_trusted: bool, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            callee: sview = called_function_name(expression)
                            true return if not in_trusted and callee != "" and direct_function_count(table, callee) == 1 and function_has_effect(table, callee)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            nested_trusted: mutable bool = in_trusted
                            nested_trusted <- true if block_kind == "trusted"
                            true return if body_has_untrusted_effect_call(body, nested_trusted, table)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if body_has_untrusted_effect_call(then_body, in_trusted, table) or body_has_untrusted_effect_call(else_body, in_trusted, table)
                        Stmt.While(condition, body, line):
                            true return if body_has_untrusted_effect_call(body, in_trusted, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if body_has_untrusted_effect_call(body, in_trusted, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if body_has_untrusted_effect_call(arm.body, in_trusted, table)
                        _:
                            pass
                return false


        # The effect REF of the first untrusted effect source in `statements`:
        # "Abort.Panic" for a panic, the callee's own first effect ref for a
        # forwarded call. "" when the body has no untrusted source.
        def body_first_untrusted_effect_ref(statements: darray[Ast::Stmt], in_trusted: bool, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                "Abort.Panic" return if body_has_untrusted_panic(statements, in_trusted)
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            callee: sview = called_function_name(expression)
                            if not in_trusted and callee != "" and direct_function_count(table, callee) == 1 and function_has_effect(table, callee):
                                forwarded: sview = function_first_effect_ref(table, callee)
                                forwarded return if forwarded != ""
                        _:
                            pass
                return ""


        # Whether `family` appears among the granted refs of a block-grant clause.
        def clause_covers_family(clause: darray[sview]&, family: sview) -> bool:
            can Abort.Panic:
                for clause_ref in clause:
                    true return if effect_ref_family(clause_ref) == family
                return false

        # One-hop effect propagation (stage0 parity): a call inside a `can` BLOCK
        # whose clause omits one of the callee's declared families leaves that
        # family REQUIRED by the enclosing function — register it as a declared
        # effect row so caller-side grant checks see it (arena_free's Unsafe.Alias).
        def register_block_grant_gaps(owner: sview, statements: darray[Ast::Stmt], enclosing_clause: darray[sview], in_can_block: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- register_block_grant_gaps(owner, body, clause, true, table) if kind == "can"
                            table <- register_block_grant_gaps(owner, body, enclosing_clause, in_can_block, table) if kind != "can" and kind != "trusted"
                        Stmt.Expr(expression, line):
                            continue if not in_can_block
                            gap_callee: sview = called_function_name(expression)
                            continue if gap_callee == "" or gap_callee == owner or direct_function_count(table, gap_callee) != 1
                            # Snapshot the row count: pushes below grow the table and must
                            # not extend this scan (self-feeding loop).
                            row_count: usize = table.function_effect_owner.count
                            while ref_index < row_count |ref_index: usize = 0, table|:
                                if table.function_effect_owner[ref_index] == gap_callee:
                                    required_ref: sview = table.function_effect_name[ref_index]
                                    if not clause_covers_family(enclosing_clause, effect_ref_family(required_ref)):
                                        already_registered: bool =
                                            for known_index in 0..<table.function_effect_owner.count |already_registered: bool = false| -> already_registered:
                                                already_registered <- true if table.function_effect_owner[known_index] == owner and table.function_effect_name[known_index] == required_ref
                                        if not already_registered:
                                            table.function_effect_owner <- table.function_effect_owner.push(owner)
                                            table.function_effect_name <- table.function_effect_name.push(required_ref)
                                ref_index <- ref_index + 1
                        Stmt.Assign(target, operator, value, line):
                            # A reinterpret-assign (`x as ! <- v` / `x as & <- v`) is an
                            # Unsafe.Alias operation; inside a `can` block that omits the
                            # Unsafe family it leaves Unsafe.Alias required by the
                            # enclosing function (stage0's arena_free warning).
                            target_is_reinterpret: bool = match target:
                                Expr.Binary(as_left, as_operator, as_right, as_line): as_operator == TokenKind.As
                                _: false
                            if target_is_reinterpret and in_can_block and not clause_covers_family(enclosing_clause, "Unsafe"):
                                already: bool =
                                    for row_index in 0..<table.function_effect_owner.count |already: bool = false| -> already:
                                        already <- true if table.function_effect_owner[row_index] == owner and table.function_effect_name[row_index] == "Unsafe.Alias"
                                if not already:
                                    table.function_effect_owner <- table.function_effect_owner.push(owner)
                                    table.function_effect_name <- table.function_effect_name.push("Unsafe.Alias")
                        Stmt.If(condition, then_body, else_body, line):
                            table <- register_block_grant_gaps(owner, then_body, enclosing_clause, in_can_block, table)
                            table <- register_block_grant_gaps(owner, else_body, enclosing_clause, in_can_block, table)
                        Stmt.While(condition, body, line):
                            table <- register_block_grant_gaps(owner, body, enclosing_clause, in_can_block, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- register_block_grant_gaps(owner, body, enclosing_clause, in_can_block, table)
                        _:
                            pass


        # Populate the effect-source registry from untrusted panic operations and direct
        # calls to already-known effect-bearing functions. Runs before call-site checking.
        # Surface `can Unsafe.X:` block grants as the function's required effects.
        def register_unsafe_can_grants(owner: sview, statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            if block_kind == "can":
                                for grant in clause |table| -> table:
                                    surfaced: sview = "Unsafe.StaleRef" if grant == "StaleRef" or grant == "Unsafe.StaleRef" else sview("", 0, 0)
                                    continue if surfaced == ""
                                    already: mutable bool = false
                                    while row_index < table.function_effect_owner.count |row_index: usize = 0, already|:
                                        already <- true if table.function_effect_owner[row_index] == owner and table.function_effect_name[row_index] == surfaced
                                        row_index <- row_index + 1
                                    if not already:
                                        table.function_effect_owner <- table.function_effect_owner.push(owner)
                                        table.function_effect_name <- table.function_effect_name.push(surfaced)
                            table <- register_unsafe_can_grants(owner, body, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- register_unsafe_can_grants(owner, then_body, table)
                            table <- register_unsafe_can_grants(owner, else_body, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- register_unsafe_can_grants(owner, while_body, table)
                        _:
                            pass


        def collect_effect_sources(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- register_block_grant_gaps(name, body, [], false, table)
                            # A `can Unsafe.X:` GRANT block propagates the assumption
                            # upward: the function surfaces Unsafe.X and its callers need
                            # the grant (a `trusted` block is the firewall and does not).
                            table <- register_unsafe_can_grants(name, body, table)
                            inferred_source: bool = body_has_untrusted_panic(body, false) or body_has_untrusted_effect_call(body, false, table)
                            table.function_effect_source_owner <- table.function_effect_source_owner.push(name) if inferred_source
                            table.function_effect_source_ref <- table.function_effect_source_ref.push(body_first_untrusted_effect_ref(body, false, table)) if inferred_source
                        Decl.Module(name, body, line):
                            table <- collect_effect_sources(body, table)
                        Decl.Scoped(body, line):
                            table <- collect_effect_sources(body, table)
                        _:
                            pass


        # The `__extern_effect_ref` recorded for the extern on `line`, or "" when none.
        # Matched by LINE, not array adjacency: other extern side-table annotations
        # (`__extern_segment_owner`, `__extern_return_shape`) can be pushed between the
        # `__extern_effect` marker and its ref, so a next-index probe misses the ref and
        # falls back to the "Permission" placeholder (a spurious ungranted-call fire).
        def extern_effect_ref_on_line(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> sview:
            can Abort.Panic:
                while probe < annotations.count |probe: usize = 0|:
                    annotations[probe].name return if annotations[probe].owner == "__extern_effect_ref" and annotations[probe].line == line
                    probe <- probe + 1
                return ""

        def collect_extern_effects(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                while annotation_index < annotations.count |annotation_index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[annotation_index]
                    if annotation.name == "__extern_effect":
                        ref: sview = extern_effect_ref_on_line(annotations, annotation.line)
                        table.function_effect_owner <- table.function_effect_owner.push(annotation.owner)
                        table.function_effect_name <- table.function_effect_name.push(ref if ref != "" else "Permission")
                    annotation_index <- annotation_index + 1


        # Whether `target` is one of `names` (content equality on the copied spans). Used to
        # suppress the effect-call fire when the callee is shadowed by a local/param binder.
        def names_contains(names: darray[sview], target: sview) -> bool:
            for candidate in names:
                candidate_name: sview = candidate
                true return if candidate_name == target
            return false


        # Whether the postfix grant on `line` covers `family` (a required permission
        # family like "Unsafe"): any recorded granted ref on that line whose family
        # prefix matches. The bare "__inline_can" marker itself never matches.
        def line_inline_grant_covers(names: darray[sview]&, lines: darray[u32]&, line: u32, family: sview) -> bool:
            can Abort.Panic:
                false return if family == ""
                while index < lines.count |index: usize = 0|:
                    true return if lines[index] == line and names[index] != "__inline_can" and effect_ref_family(names[index]) == family
                    index <- index + 1
                return false

        # The first DECLARED effect ref of `owner` whose family is NOT covered by
        # the postfix grant on `line` ("" when every declared family is granted).
        def first_uncovered_declared_ref(table: SymbolTable&, owner: sview, names: darray[sview]&, lines: darray[u32]&, line: u32) -> sview:
            can Abort.Panic:
                while declared_index < table.function_effect_owner.count |declared_index: usize = 0|:
                    if table.function_effect_owner[declared_index] == owner:
                        candidate: sview = table.function_effect_name[declared_index]
                        candidate return if not line_inline_grant_covers(names, lines, line, effect_ref_family(candidate))
                    declared_index <- declared_index + 1
                return ""

        def line_has_inline_grant(names: darray[sview]&, lines: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                while index < lines.count |index: usize = 0|:
                    true return if names[index] == "__inline_can" and lines[index] == line
                    index <- index + 1
                return false


        def effect_param_on_line(annotations: darray[Ast::EnumAnnotation]&, name: sview, function_line: u32) -> bool:
            for annotation in annotations:
                true return if annotation.owner == "__effect_param" and annotation.name == name and annotation.line == function_line
            return false


        def line_has_annotation_owner(annotations: darray[Ast::EnumAnnotation]&, owner: sview, line: u32) -> bool:
            for annotation in annotations:
                true return if annotation.owner == owner and annotation.line == line
            return false


        def concrete_effect_wrapper_line(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> bool:
            return line_has_annotation_owner(annotations, "__effect_param", line) and not line_has_annotation_owner(annotations, "__permission_param_decl", line)


        def concrete_effect_wrapper_name(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            for symbol in table.symbols:
                true return if symbol.kind == SymbolKind.Func and symbol.name == name and concrete_effect_wrapper_line(annotations, symbol.line)
            return false


        def calls_concrete_effect_wrapper(expression: Ast::Expr, table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            callee_name: sview = called_function_name(expression)
            return callee_name != "" and concrete_effect_wrapper_name(table, annotations, callee_name)


        def unknown_permission_member_diagnostics(annotations: darray[Ast::EnumAnnotation]&) -> darray[Diagnostic]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[Diagnostic] = []
                for annotation in annotations |result|:
                    result.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: "Console", line: annotation.line, expected: "", actual: annotation.name}) if annotation.owner == "__invalid_console"
                    result.push(Diagnostic{kind: DiagnosticKind.PermissionParamMemberAccess, name: annotation.name, line: annotation.line, expected: "", actual: ""}) if annotation.owner == "__permission_param_member"
                return result


        # Collect every name a pattern binds (recursively), pushing into `names` in place.
        def pattern_bound_names(pattern: Ast::Pattern, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        names.push(name)
                    Pattern.TypeBind(type_name, binder):
                        names.push(binder)
                    Pattern.As(name, inner):
                        names.push(name)
                        for sub in inner:
                            pattern_bound_names(sub, names)
                    Pattern.Variant(path, fields):
                        for sub in fields:
                            pattern_bound_names(sub, names)
                    Pattern.Struct(path, fields):
                        for sub in fields:
                            pattern_bound_names(sub, names)
                    Pattern.Field(selector, inner):
                        for sub in inner:
                            pattern_bound_names(sub, names)
                    Pattern.Tuple(elements):
                        for sub in elements:
                            pattern_bound_names(sub, names)
                    Pattern.Or(options):
                        for sub in options:
                            pattern_bound_names(sub, names)
                    _:
                        pass


        # Collect every name bound anywhere in a statement list (params handled by the caller):
        # local var-decls, for-loop variables, block bindings, and match-arm pattern bindings.
        # Over-collection is sound here — it only ever SUPPRESSES the effect-call fire, so a name
        # bound in any scope of the function shadows the top-level callee for the whole function.
        def collect_bound_names(statements: darray[Ast::Stmt], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            names.push(name)
                        Stmt.For(bind, variables, iterable, body, line):
                            for loop_variable in variables:
                                names.push(loop_variable)
                            collect_bound_names(body, names)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_bound_names(then_body, names)
                            collect_bound_names(else_body, names)
                        Stmt.While(condition, body, line):
                            collect_bound_names(body, names)
                        Stmt.Block(kind, clause, binding, body, line):
                            names.push(binding)
                            collect_bound_names(body, names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                pattern_bound_names(arm.pattern, names)
                                collect_bound_names(arm.body, names)
                        _:
                            pass


        # Walk a statement list tracking whether a conservative enclosing grant is active.
        # Concrete effect-bearing callback parameters are the precision exception: invoking
        # one (or a wrapper carrying one) still requires a local grant, while permission-row
        # polymorphic callbacks retain Stage0's generic-context suppression.
        def check_ungranted_call_expression(expression: Ast::Expr, line: u32, function_line: u32, annotations: darray[Ast::EnumAnnotation]&, bound_names: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callee_name: sview = called_function_name(expression)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedPanic, name: "", line: line, expected: "", actual: ""}) if callee_name == "panic"
                return if callee_name == "panic" or callee_name == ""
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: callee_name, line: line, expected: function_first_effect_ref(table, callee_name), actual: effect_ref_family(function_first_effect_ref(table, callee_name))}) if effect_param_on_line(annotations, callee_name, function_line)
                return if effect_param_on_line(annotations, callee_name, function_line)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: callee_name, line: line, expected: function_first_effect_ref(table, callee_name), actual: effect_ref_family(function_first_effect_ref(table, callee_name))}) if not names_contains(bound_names, callee_name) and direct_function_count(table, callee_name) == 1 and function_has_effect(table, callee_name)


        # Recurse through compound expression shapes so a call NESTED in an
        # operand (`1 + emit(2)`) is checked like a top-level one. Unhandled
        # shapes stay un-walked (sound miss, never a false fire).
        def check_ungranted_expression_deep(expression: Ast::Expr, line: u32, function_line: u32, annotations: darray[Ast::EnumAnnotation]&, bound_names: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- check_ungranted_call_expression(expression, line, function_line, annotations, bound_names, table)
                        for argument in arguments |table| -> table:
                            table <- check_ungranted_expression_deep(argument, line, function_line, annotations, bound_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- check_ungranted_expression_deep(left, line, function_line, annotations, bound_names, table)
                        table <- check_ungranted_expression_deep(right, line, function_line, annotations, bound_names, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- check_ungranted_expression_deep(operand, line, function_line, annotations, bound_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- check_ungranted_expression_deep(inner, line, function_line, annotations, bound_names, table)
                    _:
                        pass


        def check_ungranted_panic_statements(statements: darray[Ast::Stmt], allocation_names: darray[sview]&, allocation_lines: darray[u32]&, annotations: darray[Ast::EnumAnnotation]&, function_line: u32, in_grant: bool, strict_unsafe: bool, bound_names: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            if not in_grant and not line_has_inline_grant(allocation_names, allocation_lines, line):
                                table <- check_ungranted_expression_deep(expression, line, function_line, annotations, bound_names, table)
                            # A postfix grant that OMITS a required family still leaves
                            # the call ungranted for that family (stage0 parity).
                            if not in_grant and line_has_inline_grant(allocation_names, allocation_lines, line):
                                grant_callee: sview = called_function_name(expression)
                                # A grant naming an UNKNOWN permission member (`can
                                # Console.Read`) does not cover anything (stage0 still
                                # warns with the callee's declared ref as the suggestion).
                                invalid_member_grant: bool = line_has_annotation_owner(annotations, "__invalid_console", line)
                                uncovered_ref: mutable sview = first_uncovered_declared_ref(table, grant_callee, allocation_names, allocation_lines, line) if grant_callee != "" else ""
                                uncovered_ref <- function_first_declared_effect_ref(table, grant_callee) if invalid_member_grant and grant_callee != ""
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: grant_callee, line: line, expected: uncovered_ref, actual: effect_ref_family(uncovered_ref)}) if uncovered_ref != "" and (strict_unsafe or effect_ref_family(uncovered_ref) != "Unsafe")
                        Stmt.Block(kind, clause, binding, body, line):
                            block_grant: bool = in_grant or kind == "can" or kind == "trusted"
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, annotations, function_line, block_grant, strict_unsafe, bound_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_ungranted_panic_statements(then_body, allocation_names, allocation_lines, annotations, function_line, in_grant, strict_unsafe, bound_names, table)
                            table <- check_ungranted_panic_statements(else_body, allocation_names, allocation_lines, annotations, function_line, in_grant, strict_unsafe, bound_names, table)
                        Stmt.While(condition, body, line):
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, annotations, function_line, in_grant, strict_unsafe, bound_names, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, annotations, function_line, in_grant, strict_unsafe, bound_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_ungranted_panic_statements(arm.body, allocation_names, allocation_lines, annotations, function_line, in_grant, strict_unsafe, bound_names, table)
                        Stmt.Return(value, line):
                            if value is return_expression:
                                needs_local_grant: bool = not in_grant or calls_concrete_effect_wrapper(return_expression, table, annotations)
                                table <- check_ungranted_expression_deep(return_expression, line, function_line, annotations, bound_names, table) if needs_local_grant and not line_has_inline_grant(allocation_names, allocation_lines, line)
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass


        # Recurse through every function body (descending Module/Scoped). Signature effects
        # remain a conservative grant except for concrete effect-bearing callback wrappers,
        # whose callback invocation participates in local authority checking.
        # A ref is a BARE permission (a whole-permission grant like `Disk`, `Net`) when it has no
        # `.member` suffix — i.e. it equals its own family. `Disk.Read` is a specific member.
        def cov_is_bare(ref: sview) -> bool:
            can Abort.Panic:
                return effect_ref_family(ref) == ref

        # Whether a single granted clause ref covers a specific required REF (member-granular),
        # resolving permission `includes` (sentinel 3900000007) and multi-ref alias expansion
        # (sentinel 3900000041). A bare-permission grant (`Disk`) covers every member of that
        # permission (`Disk.Read`); a specific member grant (`Cap.Read`) covers ONLY that member —
        # so `can Cap.Read:` does NOT satisfy a `can[Cap.Write]` requirement. Depth-bounded.
        def cov_grant_covers_ref(annotations: darray[Ast::EnumAnnotation]&, grant_ref: sview, required_ref: sview, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 16
                true return if grant_ref == "any" or grant_ref == required_ref
                grant_family: sview = effect_ref_family(grant_ref)
                # A BARE permission grant covers any member whose family is that permission.
                true return if cov_is_bare(grant_ref) and effect_ref_family(required_ref) == grant_ref
                # Permission `includes`: a bare grant of a permission that (transitively) includes
                # the required permission covers all its members.
                if cov_is_bare(grant_ref):
                    for annotation in annotations:
                        if annotation.line == 3900000007 and annotation.owner == grant_ref:
                            true return if cov_grant_covers_ref(annotations, annotation.name, required_ref, depth + 1)
                # Alias expansion: recurse into each expanded member of this alias family.
                for annotation in annotations:
                    if annotation.line == 3900000042 and annotation.owner == grant_family:
                        true return if cov_grant_covers_ref(annotations, annotation.name, required_ref, depth + 1)
                return false

        # Whether the accumulated block grants cover a required REF. `any` is covered by ANY
        # non-empty grant. An alias-valued requirement (`can[IO]`, IO an alias) is covered only when
        # EVERY expanded member is covered. Empty ref = covered (nothing required).
        def cov_ref_covered(annotations: darray[Ast::EnumAnnotation]&, granted: darray[sview]&, required_ref: sview, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if required_ref == "" or depth > 16
                # `can[any]` is satisfied ONLY by an explicit `any` grant (verified against stage0:
                # a `can Disk.Read:` / `trusted Disk.Read:` block does NOT cover it) — so it flows
                # through the normal ref-coverage path below, where only an `any` grant matches.
                required_family: sview = effect_ref_family(required_ref)
                # An alias-valued requirement expands to its members — all must be covered.
                has_alias_members: bool = any annotation in annotations where annotation.line == 3900000042 and annotation.owner == required_family
                if has_alias_members:
                    return all annotation in annotations where not (annotation.line == 3900000042 and annotation.owner == required_family) or cov_ref_covered(annotations, granted, annotation.name, depth + 1)
                return any grant in granted where cov_grant_covers_ref(annotations, grant, required_ref, 0)

        # The first declared required effect ref of `callee` NOT covered by the accumulated block
        # grants, else "". Only callees WITH declared effects contribute.
        def cov_call_uncovered_ref(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, callee: sview, granted: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                sview("", 0, 0) return if callee == ""
                while declared_index < table.function_effect_owner.count |declared_index: usize = 0|:
                    if table.function_effect_owner[declared_index] == callee:
                        candidate: sview = table.function_effect_name[declared_index]
                        candidate return if not cov_ref_covered(annotations, granted, candidate, 0)
                    declared_index <- declared_index + 1
                return ""

        # Fire UngrantedEffectCall for a call INSIDE a can/trusted block whose required effect
        # family is not covered by the enclosing block grants. Only fires when a grant is in scope
        # (granted.count > 0); top-level calls are owned by check_ungranted_expression_deep.
        # A family that is a `[permission P]` PARAMETER — recorded as `__permission_param_decl` but
        # NOT as a real `__permission_decl`. (The parser's file-wide `permission <Ident>` scan also
        # tags real `permission Disk:` declarations as `__permission_param_decl`, so the real-decl
        # exclusion is required to tell a polymorphic P from a concrete permission Disk.)
        def cov_is_permission_param(annotations: darray[Ast::EnumAnnotation]&, family: sview) -> bool:
            can Abort.Panic:
                false return if family == ""
                is_param_decl: bool = any annotation in annotations where annotation.owner == "__permission_param_decl" and annotation.name == family
                is_real_permission: bool = any annotation in annotations where annotation.owner == "__permission_decl" and annotation.name == family
                return is_param_decl and not is_real_permission

        def cov_check_call(expression: Ast::Expr, granted: darray[sview]&, function_has_signature: bool, line: u32, allocation_names: darray[sview]&, allocation_lines: darray[u32]&, annotations: darray[Ast::EnumAnnotation]&, bound_names: darray[sview], strict_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Fire when a block grant is in scope (granted.count>0), OR at top level of a
                # function that carries a signature effect — a signature `can[…]` clause does NOT
                # discharge the local obligation (stage0), yet the existing outside-grant walk
                # suppresses such functions entirely, so their uncovered calls are ours to flag.
                return if granted.count == 0 and not function_has_signature
                return if line_has_inline_grant(allocation_names, allocation_lines, line)
                callee: sview = called_function_name(expression)
                return if callee == "" or names_contains(bound_names, callee)
                uncovered: sview = cov_call_uncovered_ref(table, annotations, callee, granted)
                family: sview = effect_ref_family(uncovered)
                # A permission-PARAMETER effect (`invoke_writer[permission P] … can[P]`) is
                # permission-polymorphic: P binds to the caller's held permission, so it is never an
                # ungranted requirement (stage0 accepts). A genuinely-unsatisfied P is a conservative
                # MISS here — never an over-fire.
                # The Unsafe family is owned by the dedicated strict-unsafe checks (which carry the
                # runtime-std exemptions for internal `arena_*` helpers); this permission-coverage
                # walk handles only ordinary permission/effect families (Disk, Cap, Net, Blocking, …).
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: callee, line: line, expected: uncovered, actual: family}) if uncovered != "" and family != "Unsafe" and not cov_is_permission_param(annotations, family)

        # The first inline-`can`-granted ref on `line` that the accumulated block grants ALREADY
        # cover (so the postfix grant is redundant), else "". Inline-grant refs sit in
        # allocation_names on that line (the `__inline_can` marker itself excluded).
        def cov_redundant_inline_ref(allocation_names: darray[sview]&, allocation_lines: darray[u32]&, line: u32, granted: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                while index < allocation_lines.count |index: usize = 0|:
                    if allocation_lines[index] == line and allocation_names[index] != "__inline_can" and allocation_names[index] != "":
                        inline_ref: sview = allocation_names[index]
                        inline_ref return if any grant in granted where cov_grant_covers_ref(annotations, grant, inline_ref, 0)
                    index <- index + 1
                return sview("", 0, 0)

        # Fire RedundantInlineGrant when a statement's postfix inline grant duplicates an effect an
        # enclosing block already grants (only meaningful inside a grant block: granted.count > 0).
        def cov_check_redundant_inline(line: u32, granted: darray[sview]&, allocation_names: darray[sview]&, allocation_lines: darray[u32]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if granted.count == 0 or not line_has_inline_grant(allocation_names, allocation_lines, line)
                redundant: sview = cov_redundant_inline_ref(allocation_names, allocation_lines, line, granted, annotations)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantInlineGrant, name: redundant, line: line, expected: "", actual: ""}) if redundant != ""

        # Walk block-grant scopes, accumulating each can/trusted clause's granted refs, firing for
        # effect-calls whose required family the accumulated grants do not transitively cover.
        def cov_walk(statements: darray[Ast::Stmt], granted: darray[sview], function_has_signature: bool, allocation_names: darray[sview]&, allocation_lines: darray[u32]&, annotations: darray[Ast::EnumAnnotation]&, bound_names: darray[sview], strict_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "can" or kind == "trusted":
                                new_granted: mutable darray[sview] = [grant for grant in granted]
                                new_granted.extend(clause)
                                table <- cov_walk(body, new_granted, function_has_signature, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                            else:
                                table <- cov_walk(body, granted, function_has_signature, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                        Stmt.Expr(expression, line):
                            table <- cov_check_call(expression, granted, function_has_signature, line, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                            table <- cov_check_redundant_inline(line, granted, allocation_names, allocation_lines, annotations, table)
                        Stmt.Return(value, line):
                            if value is return_expression:
                                table <- cov_check_call(return_expression, granted, function_has_signature, line, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                            table <- cov_check_redundant_inline(line, granted, allocation_names, allocation_lines, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cov_walk(then_body, granted, function_has_signature, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                            table <- cov_walk(else_body, granted, function_has_signature, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                        Stmt.While(condition, while_body, line):
                            table <- cov_walk(while_body, granted, function_has_signature, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- cov_walk(for_body, granted, function_has_signature, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- cov_walk(arm.body, granted, function_has_signature, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                        _:
                            pass

        def check_ungranted_panic(declarations: darray[Ast::Decl], allocation_names: darray[sview]&, allocation_lines: darray[u32]&, annotations: darray[Ast::EnumAnnotation]&, strict_unsafe: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            signature_grant: bool = effects.count > 0 and not concrete_effect_wrapper_line(annotations, line)
                            bound_names: mutable darray[sview] = []
                            for parameter in parameters:
                                bound_names.push(parameter.name)
                            collect_bound_names(body, bound_names)
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, annotations, line, signature_grant, strict_unsafe, bound_names, table)
                            # Block-grant coverage: a `can NET:` / `trusted X:` block whose clause
                            # does not TRANSITIVELY cover a call's declared required effect family
                            # (resolving permission `includes` + multi-ref aliases) is ungranted for
                            # that family. Additive to the walk above (which only fires OUTSIDE grants).
                            no_grants: darray[sview] = []
                            table <- cov_walk(body, no_grants, signature_grant, allocation_names, allocation_lines, annotations, bound_names, strict_unsafe, table)
                        Decl.Module(name, body, line):
                            table <- check_ungranted_panic(body, allocation_names, allocation_lines, annotations, strict_unsafe, table)
                        Decl.Scoped(body, line):
                            table <- check_ungranted_panic(body, allocation_names, allocation_lines, annotations, strict_unsafe, table)
                        _:
                            pass
