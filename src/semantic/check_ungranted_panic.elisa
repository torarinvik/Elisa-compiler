# First effect-system diagnostic (deep tier). Elisa gates effect operations on a LOCAL
# grant: `panic(...)` requires an enclosing `can Abort.Panic:` (or `can ...:` / `trusted ...:`)
# block — a signature `can[...]` clause propagates the requirement to callers but does NOT
# discharge the local obligation (verified against stage0: an ungranted panic warns even when
# the signature declares `can[Abort.Panic]`). The stage1 codebase reflects this: ~495 `can X:`
# block grants vs ~7 signature clauses, so the block grant is THE mechanism.
#
# v1 SOUNDNESS STANCE (deliberately a strict subset of stage0's warnings — zero false
# positives is the prime directive): flag a `panic(...)` statement ONLY when it is lexically
# enclosed by NO `can`/`trusted` grant block at all AND its function declares no signature
# effects. This over-grants (any grant block of any family — even an alias-based one we cannot
# yet resolve — suppresses the flag), so it can never fire where stage0 stays silent; it only
# fires on a genuinely un-granted panic (which stage0 also warns on). Precision toward stage0
# parity (requiring the grant to specifically cover `Abort`, call-site effect requirements,
# transitive inference) is deferred to later increments once an effect-family registry exists.
extend Semantic:
    private:
        # The bare-identifier callee of a statement-position `Expr.Call`, or "" if the
        # statement is not a direct `name(...)` call. Detected at statement position only (a
        # call buried inside a sub-expression is a sound miss, never a false fire).
        def called_function_name(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_line):
                    match callee:
                        Expr.Ident(callee_name, ident_line):
                            return callee_name
                        _:
                            return sview("", 0, 0)
                _:
                    return sview("", 0, 0)


        # Whether a statement list performs a `panic(...)` NOT enclosed by a `trusted` block.
        # A `can` block discharges the panic locally but STILL propagates the Abort effect to
        # the function's row (verified against stage0), so `can`-wrapped panics count here;
        # only `trusted` drops the effect. Pure (no table) — a reachability predicate.
        def body_has_untrusted_panic(statements: darray[Ast::Stmt], in_trusted: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            source_callee: sview = called_function_name(expression)
                            true return if not in_trusted and source_callee == "panic"
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            block_trusted: mutable bool = in_trusted
                            block_trusted <- true if block_kind == "trusted"
                            true return if body_has_untrusted_panic(body, block_trusted)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if body_has_untrusted_panic(then_body, in_trusted) or body_has_untrusted_panic(else_body, in_trusted)
                        Stmt.While(condition, body, line):
                            true return if body_has_untrusted_panic(body, in_trusted)
                        Stmt.For(bind, variables, iterable, body, line):
                            true return if body_has_untrusted_panic(body, in_trusted)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                true return if body_has_untrusted_panic(arm.body, in_trusted)
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass
                return false


        # Populate the effect-source registry: record every function whose body performs an
        # untrusted panic (so it infers the Abort effect). Runs before check_ungranted_panic.
        def collect_effect_sources(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table.function_effect_source_owner <- table.function_effect_source_owner.push(name) if body_has_untrusted_panic(body, false)
                        Decl.Module(name, body, line):
                            table <- collect_effect_sources(body, table)
                        Decl.Scoped(body, line):
                            table <- collect_effect_sources(body, table)
                        _:
                            pass


        def collect_extern_effects(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |table|:
                    if annotation.name == "__extern_effect":
                        table.function_effect_owner <- table.function_effect_owner.push(annotation.owner)
                        table.function_effect_name <- table.function_effect_name.push("Permission")


        # Whether `target` is one of `names` (content equality on the copied spans). Used to
        # suppress the effect-call fire when the callee is shadowed by a local/param binder.
        def names_contains(names: darray[sview], target: sview) -> bool:
            for candidate in names:
                candidate_name: sview = candidate
                true return if candidate_name == target
            return false


        def line_has_inline_grant(names: darray[sview]&, lines: darray[u32]&, line: u32) -> bool:
            can Abort.Panic:
                while index < lines.count |index: usize = 0|:
                    true return if names[index] == "__inline_can" and lines[index] == line
                    index <- index + 1
                return false


        def unknown_permission_member_diagnostics(annotations: darray[Ast::EnumAnnotation]&) -> darray[Diagnostic]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[Diagnostic] = []
                for annotation in annotations |result|:
                    result.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: "Console", line: annotation.line, expected: "", actual: annotation.name}) if annotation.owner == "__invalid_console"
                return result


        # Collect every name a pattern binds (recursively), pushing into `names` in place.
        def pattern_bound_names(pattern: Ast::Pattern, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        names.push(name)
                    Pattern.TypeBind(type_name, binder):
                        names.push(binder)
                    Pattern.As(name, inner):
                        names.push(name)
                        for sub in inner:
                            pattern_bound_names(sub, names)
                    Pattern.Variant(path, fields):
                        for sub in fields:
                            pattern_bound_names(sub, names)
                    Pattern.Struct(path, fields):
                        for sub in fields:
                            pattern_bound_names(sub, names)
                    Pattern.Field(selector, inner):
                        for sub in inner:
                            pattern_bound_names(sub, names)
                    Pattern.Tuple(elements):
                        for sub in elements:
                            pattern_bound_names(sub, names)
                    Pattern.Or(options):
                        for sub in options:
                            pattern_bound_names(sub, names)
                    _:
                        pass


        # Collect every name bound anywhere in a statement list (params handled by the caller):
        # local var-decls, for-loop variables, block bindings, and match-arm pattern bindings.
        # Over-collection is sound here — it only ever SUPPRESSES the effect-call fire, so a name
        # bound in any scope of the function shadows the top-level callee for the whole function.
        def collect_bound_names(statements: darray[Ast::Stmt], names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            names.push(name)
                        Stmt.For(bind, variables, iterable, body, line):
                            for loop_variable in variables:
                                names.push(loop_variable)
                            collect_bound_names(body, names)
                        Stmt.If(condition, then_body, else_body, line):
                            collect_bound_names(then_body, names)
                            collect_bound_names(else_body, names)
                        Stmt.While(condition, body, line):
                            collect_bound_names(body, names)
                        Stmt.Block(kind, clause, binding, body, line):
                            names.push(binding)
                            collect_bound_names(body, names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                pattern_bound_names(arm.pattern, names)
                                collect_bound_names(arm.body, names)
                        _:
                            pass


        # Walk a statement list tracking whether any enclosing `can`/`trusted` grant block (or
        # a signature effect grant, folded in by the caller) is active. `can`/`trusted` blocks
        # set the grant for their body; all other block-bearing statements pass it through.
        def check_ungranted_panic_statements(statements: darray[Ast::Stmt], allocation_names: darray[sview]&, allocation_lines: darray[u32]&, in_grant: bool, bound_names: darray[sview], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            if not in_grant and not line_has_inline_grant(allocation_names, allocation_lines, line):
                                callee_name: sview = called_function_name(expression)
                                if callee_name == "panic":
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedPanic, name: "", line: line, expected: "", actual: ""})
                                elif callee_name != "" and not names_contains(bound_names, callee_name) and direct_function_count(table, callee_name) == 1 and function_has_effect(table, callee_name):
                                    # A call to a uniquely-resolved function that DECLARES
                                    # signature effects OR INFERS one (untrusted panic in its
                                    # body — one hop of stage0's transitive inference) requires
                                    # a local grant at the call site (strict subset of stage0:
                                    # over-grants on the grant side, only fires for an
                                    # unambiguous effect-bearing callee — never where stage0
                                    # is silent).
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UngrantedEffectCall, name: callee_name, line: line, expected: "", actual: ""})
                        Stmt.Block(kind, clause, binding, body, line):
                            block_grant: bool = in_grant or kind == "can" or kind == "trusted"
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, block_grant, bound_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_ungranted_panic_statements(then_body, allocation_names, allocation_lines, in_grant, bound_names, table)
                            table <- check_ungranted_panic_statements(else_body, allocation_names, allocation_lines, in_grant, bound_names, table)
                        Stmt.While(condition, body, line):
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, in_grant, bound_names, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, in_grant, bound_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_ungranted_panic_statements(arm.body, allocation_names, allocation_lines, in_grant, bound_names, table)
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass


        # Recurse through every function body (descending Module/Scoped). A function whose
        # signature declares ANY effect grant (`effects.count > 0`) has its whole body treated
        # as granted — a conservative over-grant that only ever suppresses, never adds, a fire.
        def check_ungranted_panic(declarations: darray[Ast::Decl], allocation_names: darray[sview]&, allocation_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            signature_grant: bool = effects.count > 0
                            bound_names: mutable darray[sview] = []
                            for parameter in parameters:
                                bound_names.push(parameter.name)
                            collect_bound_names(body, bound_names)
                            table <- check_ungranted_panic_statements(body, allocation_names, allocation_lines, signature_grant, bound_names, table)
                        Decl.Module(name, body, line):
                            table <- check_ungranted_panic(body, allocation_names, allocation_lines, table)
                        Decl.Scoped(body, line):
                            table <- check_ungranted_panic(body, allocation_names, allocation_lines, table)
                        _:
                            pass
