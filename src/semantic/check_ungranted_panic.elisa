# First effect-system diagnostic (deep tier). Elisa gates effect operations on a LOCAL
# grant: `panic(...)` requires an enclosing `can Abort.Panic:` (or `can ...:` / `trusted ...:`)
# block — a signature `can[...]` clause propagates the requirement to callers but does NOT
# discharge the local obligation (verified against stage0: an ungranted panic warns even when
# the signature declares `can[Abort.Panic]`). The stage1 codebase reflects this: ~495 `can X:`
# block grants vs ~7 signature clauses, so the block grant is THE mechanism.
#
# v1 SOUNDNESS STANCE (deliberately a strict subset of stage0's warnings — zero false
# positives is the prime directive): flag a `panic(...)` statement ONLY when it is lexically
# enclosed by NO `can`/`trusted` grant block at all AND its function declares no signature
# effects. This over-grants (any grant block of any family — even an alias-based one we cannot
# yet resolve — suppresses the flag), so it can never fire where stage0 stays silent; it only
# fires on a genuinely un-granted panic (which stage0 also warns on). Precision toward stage0
# parity (requiring the grant to specifically cover `Abort`, call-site effect requirements,
# transitive inference) is deferred to later increments once an effect-family registry exists.

extend Semantic:
    private:
        # The declaration name of a direct call. Module qualification does not change the
        # function registry key: both `build()` and `Boxes::build()` resolve to `build`.
        def called_function_name(expression: Ast::Expr) -> sview @source:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_line):
                    match callee:
                        Expr.Ident(callee_name, ident_line):
                            return callee_name
                        Expr.Scope(scope_base, scoped_name, scope_line):
                            return scoped_name
                        _:
                            return sview("", 0, 0)
                _:
                    return sview("", 0, 0)


        # Whether a statement list performs a `panic(...)` NOT enclosed by a `trusted` block.
        # A `can` block discharges the panic locally but STILL propagates the Abort effect to
        # the function's row (verified against stage0), so `can`-wrapped panics count here;
        # only `trusted` drops the effect. Pure (no table) — a reachability predicate.
        def body_has_untrusted_panic(statements: darray[Ast::Stmt], in_trusted: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            source_callee: sview = called_function_name(expression)
                            return true if not in_trusted and source_callee == "panic"
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            block_trusted: mutable bool = in_trusted
                            block_trusted <- true if block_kind == "trusted"
                            return true if body_has_untrusted_panic(body, block_trusted)
                        Stmt.If(condition, then_body, else_body, line):
                            return true if body_has_untrusted_panic(then_body, in_trusted) or body_has_untrusted_panic(else_body, in_trusted)
                        Stmt.While(condition, body, line):
                            return true if body_has_untrusted_panic(body, in_trusted)
                        Stmt.For(bind, variables, iterable, body, line):
                            return true if body_has_untrusted_panic(body, in_trusted)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                return true if body_has_untrusted_panic(arm.body, in_trusted)
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass
                return false


        def body_has_untrusted_effect_call(statements: darray[Ast::Stmt], in_trusted: bool, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            callee: sview = called_function_name(expression)
                            return true if not in_trusted and callee != "" and direct_function_count(table, callee) == 1 and function_has_effect(table, callee)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            nested_trusted: mutable bool = in_trusted
                            nested_trusted <- true if block_kind == "trusted"
                            return true if body_has_untrusted_effect_call(body, nested_trusted, table)
                        Stmt.If(condition, then_body, else_body, line):
                            return true if body_has_untrusted_effect_call(then_body, in_trusted, table) or body_has_untrusted_effect_call(else_body, in_trusted, table)
                        Stmt.While(condition, body, line):
                            return true if body_has_untrusted_effect_call(body, in_trusted, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            return true if body_has_untrusted_effect_call(body, in_trusted, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                return true if body_has_untrusted_effect_call(arm.body, in_trusted, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                callee: sview = called_function_name(returned)
                                return true if not in_trusted and callee != "" and direct_function_count(table, callee) == 1 and function_has_effect(table, callee)
                        _:
                            pass
                return false


        # The effect REF of the first untrusted effect source in `statements`:
        # "Abort.Panic" for a panic, the callee's own first effect ref for a
        # forwarded call. "" when the body has no untrusted source.
        def body_first_untrusted_effect_ref(statements: darray[Ast::Stmt], in_trusted: bool, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return "Abort.Panic" if body_has_untrusted_panic(statements, in_trusted)
                for statement in statements:
                    match statement:
                        Stmt.Expr(expression, line):
                            callee: sview = called_function_name(expression)
                            if not in_trusted and callee != "" and direct_function_count(table, callee) == 1 and function_has_effect(table, callee):
                                forwarded: sview = function_first_effect_ref(table, callee)
                                return forwarded if forwarded != ""
                        Stmt.Return(value, line):
                            if value is returned:
                                callee: sview = called_function_name(returned)
                                if not in_trusted and callee != "" and direct_function_count(table, callee) == 1 and function_has_effect(table, callee):
                                    forwarded: sview = function_first_effect_ref(table, callee)
                                    return forwarded if forwarded != ""
                        _:
                            pass
                return ""


        # Whether `family` appears among the granted refs of a block-grant clause.
        def clause_covers_family(clause: darray[sview]&, required_ref: sview) -> bool:
            can Abort.Panic:
                family: sview = effect_ref_family(required_ref)
                required_member: sview = effect_ref_member(required_ref)
                for clause_ref in clause:
                    if effect_ref_group_open(clause_ref) > 0:
                        return true if required_member != "" and effect_ref_family(clause_ref) == family and effect_ref_group_has_member(clause_ref, required_member)
                    else:
                        return true if effect_ref_family(clause_ref) == family
                return false

        # One-hop effect propagation (stage0 parity): a call inside a `can` BLOCK
        # whose clause omits one of the callee's declared families leaves that
        # family REQUIRED by the enclosing function — register it as a declared
        # effect row so caller-side grant checks see it (arena_free's Unsafe.Alias).
        def register_block_grant_gaps(owner: sview @source, statements: darray[Ast::Stmt], enclosing_clause: darray[sview], in_can_block: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- register_block_grant_gaps(owner, body, clause, true, table) can Global{Read,Write} if kind == "can"
                            table <- register_block_grant_gaps(owner, body, enclosing_clause, in_can_block, table) can Global{Read,Write} if kind != "can" and kind != "trusted"
                        Stmt.Expr(expression, line):
                            continue if not in_can_block
                            gap_callee: sview = called_function_name(expression)
                            continue if gap_callee == "" or gap_callee == owner or direct_function_count(table, gap_callee) != 1
                            # Snapshot the row count: pushes below grow the table and must
                            # not extend this scan (self-feeding loop).
                            row_count: usize = table.function_effect_owner.count
                            while ref_index < row_count |ref_index: usize = 0, table|:
                                if table.function_effect_owner[ref_index] == gap_callee:
                                    required_ref: sview = table.function_effect_name[ref_index]
                                    if not clause_covers_family(enclosing_clause, required_ref):
                                        already_registered: bool =
                                            for known_index in 0..<table.function_effect_owner.count |already_registered: bool = false| -> already_registered:
                                                already_registered <- true if table.function_effect_owner[known_index] == owner and table.function_effect_name[known_index] == required_ref
                                        if not already_registered:
                                            table.function_effect_owner <- table.function_effect_owner.push(owner)
                                            table.function_effect_name <- table.function_effect_name.push(required_ref)
                                            table <- index_effect_owner_rows(table) can Global{Read,Write}
                                ref_index <- ref_index + 1
                        Stmt.Assign(target, operator, value, line):
                            # A reinterpret-assign (`x as ! <- v` / `x as & <- v`) is an
                            # Unsafe.Alias operation; inside a `can` block that omits the
                            # Unsafe family it leaves Unsafe.Alias required by the
                            # enclosing function (stage0's arena_free warning).
                            target_is_reinterpret: bool = match target:
                                Expr.Binary(as_left, as_operator, as_right, as_line): as_operator == TokenKind.As
                                _: false
                            if target_is_reinterpret and in_can_block and not clause_covers_family(enclosing_clause, "Unsafe"):
                                already: bool =
                                    for row_index in 0..<table.function_effect_owner.count |already: bool = false| -> already:
                                        already <- true if table.function_effect_owner[row_index] == owner and table.function_effect_name[row_index] == "Unsafe.Alias"
                                if not already:
                                    table.function_effect_owner <- table.function_effect_owner.push(owner)
                                    table.function_effect_name <- table.function_effect_name.push("Unsafe.Alias")
                                    table <- index_effect_owner_rows(table) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, line):
                            table <- register_block_grant_gaps(owner, then_body, enclosing_clause, in_can_block, table) can Global{Read,Write}
                            table <- register_block_grant_gaps(owner, else_body, enclosing_clause, in_can_block, table) can Global{Read,Write}
                        Stmt.While(condition, body, line):
                            table <- register_block_grant_gaps(owner, body, enclosing_clause, in_can_block, table) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- register_block_grant_gaps(owner, body, enclosing_clause, in_can_block, table) can Global{Read,Write}
                        _:
                            pass


        # Populate the effect-source registry from untrusted panic operations and direct
        # calls to already-known effect-bearing functions. Runs before call-site checking.
        # Surface `can Unsafe.X:` block grants as the function's required effects.
        def register_unsafe_can_grants(owner: sview @source, statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            block_kind: sview = kind
                            if block_kind == "can":
                                for grant in clause |table| -> table:
                                    surfaced: sview = "Unsafe.StaleRef" if grant == "StaleRef" or grant == "Unsafe.StaleRef" else sview("", 0, 0)
                                    continue if surfaced == ""
                                    already: mutable bool = false
                                    while row_index < table.function_effect_owner.count |row_index: usize = 0, already|:
                                        already <- true if table.function_effect_owner[row_index] == owner and table.function_effect_name[row_index] == surfaced
                                        row_index <- row_index + 1
                                    if not already:
                                        table.function_effect_owner <- table.function_effect_owner.push(owner)
                                        table.function_effect_name <- table.function_effect_name.push(surfaced)
                                        table <- index_effect_owner_rows(table) can Global{Read,Write}
                            table <- register_unsafe_can_grants(owner, body, table) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- register_unsafe_can_grants(owner, then_body, table) can Global{Read,Write}
                            table <- register_unsafe_can_grants(owner, else_body, table) can Global{Read,Write}
                        Stmt.While(condition, while_body, while_line):
                            table <- register_unsafe_can_grants(owner, while_body, table) can Global{Read,Write}
                        _:
                            pass


        # A `signal Effect.Family` statement (parsed as an inert Block("signal", [ref], …)) is an
        # effect REQUIREMENT source, like a panic: the enclosing function surfaces the effect and its
        # callers must grant it. Recurse through blocks (the signal often sits inside its own grant).
        def body_has_untrusted_signal(statements: darray[Ast::Stmt], in_trusted: bool) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            return true if kind == "signal" and not in_trusted and clause.count > 0
                            nested_trusted: bool = in_trusted or kind == "trusted"
                            return true if body_has_untrusted_signal(body, nested_trusted)
                        Stmt.If(condition, then_body, else_body, line):
                            return true if body_has_untrusted_signal(then_body, in_trusted) or body_has_untrusted_signal(else_body, in_trusted)
                        Stmt.While(condition, body, line):
                            return true if body_has_untrusted_signal(body, in_trusted)
                        Stmt.For(bind, variables, iterable, body, line):
                            return true if body_has_untrusted_signal(body, in_trusted)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                return true if body_has_untrusted_signal(arm.body, in_trusted)
                        _:
                            pass
                return false

        # The effect ref of the first `signal` statement (recursing through blocks), or "".
        def body_first_signal_ref(statements: darray[Ast::Stmt]) -> sview:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            return clause[0] if kind == "signal" and clause.count > 0
                            nested: sview = body_first_signal_ref(body)
                            return nested if nested != ""
                        Stmt.If(condition, then_body, else_body, line):
                            then_ref: sview = body_first_signal_ref(then_body)
                            return then_ref if then_ref != ""
                            return body_first_signal_ref(else_body)
                        Stmt.While(condition, body, line):
                            return body_first_signal_ref(body)
                        Stmt.For(bind, variables, iterable, body, line):
                            return body_first_signal_ref(body)
                        _:
                            pass
                return sview("", 0, 0)


        # Preserve the call node's full source span when an effect warning is emitted. The
        # surrounding statement line is still used as a fallback for non-call expressions.
        def called_function_position(expression: Ast::Expr, fallback_line: u32) -> Ast::Pos:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_line):
                    return call_line
                _:
                    return Ast::pos_at_line(fallback_line)

        # Index current-source function anchors once so the recursive declaration walk
        # can find its exact body record without comparing every function to every
        # snapshot row. Duplicate offsets are marked with functions.count and fail closed.
        def incremental_effect_source_anchor_index[@snapshot_storage, @snapshot_borrow](snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow, offsets: mutable dict[u64, usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if snapshot.functions.count != snapshot.current_anchors.count
                missing: usize = snapshot.functions.count + 1
                for index in 0..<snapshot.functions.count |offsets, snapshot, index, missing|:
                    offset: u64 = snapshot.current_anchors[index].definition_offset.u64()
                    previous: usize = row if offsets.get(offset) is row else missing
                    if previous == missing:
                        offsets <- offsets.put(offset, index) can Global{Read,Write}
                    else:
                        offsets <- offsets.put(offset, snapshot.functions.count) can Global{Read,Write}


        # Current facts are freshly collected from this AST. A record is usable by
        # body-only passes only when its exact definition anchor has one supported
        # record whose complete fact span is well formed.
        def incremental_current_body_record_index[@snapshot_storage, @snapshot_borrow](at: Ast::Pos, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow, offsets: dict[u64, usize]&) -> usize:
            can Abort.Panic:
                count: usize = snapshot.functions.count
                return count if snapshot.functions.count != snapshot.current_anchors.count
                owner: usize = row if offsets.get(at.offset.u64()) is row else count
                return count if owner >= count
                return count if snapshot.current_anchors[owner].definition_offset != at.offset
                record: IncrementalFunctionFactRecord = snapshot.functions[owner]
                return count if not record.cacheable
                return count if record.direct_fact_start > snapshot.direct_facts.count
                return count if record.direct_fact_count > snapshot.direct_facts.count - record.direct_fact_start
                return owner


        def incremental_current_body_has_zero_direct_facts[@snapshot_storage, @snapshot_borrow](at: Ast::Pos, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow, offsets: dict[u64, usize]&) -> bool:
            can Abort.Panic:
                owner: usize = incremental_current_body_record_index(at, snapshot, offsets)
                return owner < snapshot.functions.count and snapshot.functions[owner].direct_fact_count == 0


        def collect_effect_sources[@snapshot_storage, @snapshot_borrow](declarations: darray[Ast::Decl], table: lmut SymbolTable, snapshot: IncrementalSemanticSnapshot[snapshot_storage]& @snapshot_borrow, offsets: dict[u64, usize]&, effect_source_bodies_skipped: mutable u64&, use_snapshot_facts: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, effect_source_bodies_skipped| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, at):
                            if use_snapshot_facts and incremental_current_body_has_zero_direct_facts(at, snapshot, offsets):
                                effect_source_bodies_skipped <- effect_source_bodies_skipped + 1
                            else:
                                table <- register_block_grant_gaps(name, body, [], false, table) can Global{Read,Write}
                                # A `can Unsafe.X:` GRANT block propagates the assumption
                                # upward: the function surfaces Unsafe.X and its callers need
                                # the grant (a `trusted` block is the firewall and does not).
                                table <- register_unsafe_can_grants(name, body, table) can Global{Read,Write}
                                has_signal: bool = body_has_untrusted_signal(body, false)
                                inferred_source: bool = body_has_untrusted_panic(body, false) or body_has_untrusted_effect_call(body, false, table) or has_signal
                                table.function_effect_source_owner <- table.function_effect_source_owner.push(name) if inferred_source
                                # The signal's own effect ref takes precedence so the surfaced family
                                # matches the signalled effect (Progress), not a panic default.
                                panic_ref: sview = body_first_untrusted_effect_ref(body, false, table)
                                signal_ref: sview = body_first_signal_ref(body)
                                source_ref: sview = signal_ref if panic_ref == "" and signal_ref != "" else panic_ref
                                table.function_effect_source_ref <- table.function_effect_source_ref.push(source_ref) if inferred_source
                            table <- index_effect_source_rows(table) can Global{Read,Write}
                        Decl.Module(name, body, line):
                            table <- collect_effect_sources(body, table, snapshot, offsets, effect_source_bodies_skipped, false) can Global{Read,Write}
                        Decl.Scoped(body, line):
                            table <- collect_effect_sources(body, table, snapshot, offsets, effect_source_bodies_skipped, false) can Global{Read,Write}
                        _:
                            pass


        # The `__extern_effect_ref` recorded for the extern at (`line`, `offset`), or "" when none.
        # Matched by declaration position, not array adjacency: other extern side-table annotations
        # (`__extern_segment_owner`, `__extern_return_shape`) can be pushed between the
        # `__extern_effect` marker and its ref, so a next-index probe misses the ref and
        # falls back to the "Permission" placeholder (a spurious ungranted-call fire). The
        # declaration offset also keeps a same-`#line` sibling from donating its effect.
        def extern_effect_ref_at(annotations: darray[Ast::EnumAnnotation]&, line: u32, offset: u32) -> sview:
            can Abort.Panic:
                while probe < annotations.count |probe: usize = 0|:
                    return annotations[probe].name if annotations[probe].owner == "__extern_effect_ref" and annotations[probe].line == line and annotations[probe].offset == offset
                    probe <- probe + 1
                return ""

        def collect_extern_effects(annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                while annotation_index < annotations.count |annotation_index: usize = 0|:
                    annotation: Ast::EnumAnnotation = annotations[annotation_index]
                    if annotation.name == "__extern_effect" or annotation.name == "__extern_effect_blocking":
                        ref: sview = "Blocking.RawExtern" if annotation.name == "__extern_effect_blocking" else extern_effect_ref_at(annotations, annotation.line, annotation.offset)
                        table.function_effect_owner <- table.function_effect_owner.push(annotation.owner)
                        table.function_effect_name <- table.function_effect_name.push(ref if ref != "" else "Permission")
                        table <- index_effect_owner_rows(table) can Global{Read,Write}
                    annotation_index <- annotation_index + 1
