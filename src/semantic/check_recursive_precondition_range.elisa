# A call `CALLEE(base - c, ...)` whose affine argument can drop BELOW the callee's `requires`
# lower bound, given the caller's own lower bound on `base`. The caller bound comes from its
# `requires base >= L` (or `> L`) PLUS the base-case early-exit guard (`if base == 0: return ...`
# raises a `>= 0` bound to `>= 1` on the fall-through). When the argument's minimum feasible value
# violates the callee precondition, stage0 reports "precondition ... could not be proven".
#
# SOUND subset: fires only when the caller's WHOLE constraint set on `base` is captured (its
# requires + the base-case guard) and the argument is a bare affine `base ± literal`, so the minimum
# is exact — a strict subset of "not provable". Anything else (other guards, non-affine args, no
# captured bound) declines.
extend Semantic:
    private:
        # The required-minimum a `requires` lower bound imposes on `name`: `name >= K` -> K,
        # `name > K` -> K+1, combined as the MAX across clauses. (found, value).
        def rpr_lower_bound(body: darray[Ast::Stmt], name: sview) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                found: mutable bool = false
                value: mutable i64 = 0
                for statement in body |found, value, name|:
                    match statement:
                        Stmt.Contract(kind, expression, contract_line):
                            if kind == "requires" and expression is Expr.Binary(left, operator, right, binary_line):
                                if ident_name_of(left) == name:
                                    literal: (found: bool, value: i64) = where_signed_literal(right)
                                    if literal.found:
                                        candidate: mutable i64 = literal.value
                                        applies: mutable bool = false
                                        applies <- true if operator == TokenKind.GtEq
                                        if operator == TokenKind.Gt:
                                            candidate <- literal.value + 1
                                            applies <- true
                                        if applies and (not found or candidate > value):
                                            found <- true
                                            value <- candidate
                        _:
                            pass
                return (found, value)

        # Raise a lower bound past a base-case early-exit guard: a top-level `if name == V: <return/raise>`
        # excludes V, so when the current bound equals V the fall-through bound is V+1.
        def rpr_basecase_bump(body: darray[Ast::Stmt], name: sview, current: i64) -> i64:
            can Memory.Allocate, Abort.Panic:
                bumped: mutable i64 = current
                for statement in body |bumped, name|:
                    match statement:
                        Stmt.If(condition, then_body, else_body, if_line):
                            if condition is Expr.Binary(left, operator, right, binary_line):
                                if operator == TokenKind.EqEq and ident_name_of(left) == name and statements_end_in_return(then_body):
                                    guard_value: (found: bool, value: i64) = where_signed_literal(right)
                                    bumped <- guard_value.value + 1 if guard_value.found and guard_value.value == bumped
                        _:
                            pass
                return bumped

        # An affine `base ± literal` (or bare `base`) over an identifier: (ok, base, offset).
        def rpr_affine(expression: Ast::Expr) -> (ok: bool, base: sview, offset: i64):
            can Memory.Allocate, Abort.Panic:
                direct: sview = ident_name_of(expression)
                (true, direct, 0) return if direct != ""
                match expression:
                    Expr.Paren(inner, paren_line):
                        return rpr_affine(inner)
                    Expr.Binary(left, operator, right, binary_line):
                        base: sview = ident_name_of(left)
                        if base != "":
                            literal: (found: bool, value: i64) = where_signed_literal(right)
                            (true, base, literal.value) return if literal.found and operator == TokenKind.Plus
                            (true, base, 0 - literal.value) return if literal.found and operator == TokenKind.Minus
                        return (false, sview("", 0, 0), 0)
                    _:
                        return (false, sview("", 0, 0), 0)

        # The last top-level `return` expression of a body (the fall-through return), else Absent.
        def rpr_tail_return(body: darray[Ast::Stmt]) -> Ast::Expr:
            can Abort.Panic:
                result: mutable Ast::Expr = Ast::Expr.Absent
                for statement in body |result|:
                    match statement:
                        Stmt.Return(value, line):
                            result <- returned if value is returned
                        _:
                            pass
                return result

        # Collect every call `CALLEE(args)` reachable in an expression.
        def rpr_collect_calls(expression: Ast::Expr, out_callees: mutable darray[sview]&, out_args: mutable darray[Ast::Expr]&, out_arg_starts: mutable darray[usize]&, out_arg_counts: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        if callee_name != "":
                            out_callees.push(callee_name)
                            out_arg_starts.push(out_args.count)
                            out_arg_counts.push(arguments.count)
                            for argument in arguments |out_args|:
                                out_args.push(argument)
                        for argument in arguments |out_callees, out_args, out_arg_starts, out_arg_counts|:
                            rpr_collect_calls(argument, out_callees, out_args, out_arg_starts, out_arg_counts)
                    Expr.Binary(left, operator, right, binary_line):
                        rpr_collect_calls(left, out_callees, out_args, out_arg_starts, out_arg_counts)
                        rpr_collect_calls(right, out_callees, out_args, out_arg_starts, out_arg_counts)
                    Expr.Paren(inner, paren_line):
                        rpr_collect_calls(inner, out_callees, out_args, out_arg_starts, out_arg_counts)
                    Expr.Unary(operator, operand, unary_line):
                        rpr_collect_calls(operand, out_callees, out_args, out_arg_starts, out_arg_counts)
                    _:
                        pass

        # The callee function's parameter names in order (for a top-level function `name`), else empty.
        def rpr_callee_params(declarations: darray[Ast::Decl], name: sview, out: mutable darray[sview]&, out_body: mutable darray[Ast::Stmt]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if function_name == name:
                                for parameter in parameters |out|:
                                    out.push(parameter.name)
                                for statement in body |out_body|:
                                    out_body.push(statement)
                                return true
                        Decl.Module(module_name, module_body, module_line):
                            true return if rpr_callee_params(module_body, name, out, out_body)
                        Decl.Scoped(scoped_body, scoped_line):
                            true return if rpr_callee_params(scoped_body, name, out, out_body)
                        _:
                            pass
                return false

        def rpr_check_declarations(declarations: darray[Ast::Decl], root_decls: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            tail_return: Ast::Expr = rpr_tail_return(body)
                            callees: mutable darray[sview] = []
                            call_args: mutable darray[Ast::Expr] = []
                            arg_starts: mutable darray[usize] = []
                            arg_counts: mutable darray[usize] = []
                            rpr_collect_calls(tail_return, callees, call_args, arg_starts, arg_counts)
                            call_index: mutable usize = 0
                            while call_index < callees.count |call_index, table| -> table:
                                callee_name: sview = callees[call_index]
                                callee_params: mutable darray[sview] = []
                                callee_body: mutable darray[Ast::Stmt] = []
                                resolved: bool = rpr_callee_params(root_decls, callee_name, callee_params, callee_body)
                                if resolved:
                                    arg_slot: mutable usize = 0
                                    while arg_slot < arg_counts[call_index] and arg_slot < callee_params.count |arg_slot, table| -> table:
                                        argument: Ast::Expr = call_args[arg_starts[call_index] + arg_slot]
                                        affine: (ok: bool, base: sview, offset: i64) = rpr_affine(argument)
                                        if affine.ok:
                                            caller_lb: (found: bool, value: i64) = rpr_lower_bound(body, affine.base)
                                            callee_param_name: sview = callee_params[arg_slot]
                                            callee_req: (found: bool, value: i64) = rpr_lower_bound(callee_body, callee_param_name)
                                            if caller_lb.found and callee_req.found:
                                                bumped_lb: i64 = rpr_basecase_bump(body, affine.base, caller_lb.value)
                                                arg_min: i64 = bumped_lb + affine.offset
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PreconditionUnproven, name: "requires", line: line, expected: "", actual: ""}) if arg_min < callee_req.value
                                        arg_slot <- arg_slot + 1
                                call_index <- call_index + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- rpr_check_declarations(module_body, root_decls, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- rpr_check_declarations(scoped_body, root_decls, table)
                        _:
                            pass

    public:
        def check_recursive_precondition_range(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- rpr_check_declarations(declarations, declarations, table)
