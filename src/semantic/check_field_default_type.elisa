# Struct field default-value type mismatch. A field with a bare literal default whose literal
# kind can never initialize the field type is rejected:
#
#   struct Bad:
#       flag: bool = 7      # error: default expects bool, got int
#
# The parser records a bare literal default as three same-line annotations — the field name
# (`__field_default_name`), the field's type head (`__field_default_type`), and the literal
# kind (`__field_default_kind`). Reuses the semantic impossible-pair matrix (literal_never_fits).
extend Semantic:
    private:
        def fdt_value_at(annotations: darray[Ast::EnumAnnotation]&, owner: sview, line: u32, owner_offset: u32) -> sview @source:
            can Abort.Panic:
                for annotation in annotations:
                    return annotation.name if annotation.owner == owner and annotation.line == line and annotation.offset == owner_offset
                return sview("", 0, 0)

    public:
        def check_field_default_type(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                annotations: darray[Ast::EnumAnnotation] = file.enum_annotations
                for index in 0..<annotations.count |table| -> table:
                    annotation: Ast::EnumAnnotation = annotations[index]
                    continue if annotation.owner != "__field_default_name"
                    field_type: mutable sview @source = ""
                    literal_kind: mutable sview @source = ""
                    adjacent: mutable bool = false
                    if annotations.count - index > 2:
                        type_row: Ast::EnumAnnotation = annotations[index + 1]
                        kind_row: Ast::EnumAnnotation = annotations[index + 2]
                        adjacent <- type_row.owner == "__field_default_type" and kind_row.owner == "__field_default_kind" and type_row.line == annotation.line and kind_row.line == annotation.line and type_row.offset == annotation.offset and kind_row.offset == annotation.offset
                        if adjacent:
                            field_type <- type_row.name
                            literal_kind <- kind_row.name
                    if not adjacent:
                        # Synthetic or transformed annotation streams can reorder rows.
                        field_type <- fdt_value_at(file.enum_annotations, "__field_default_type", annotation.line, annotation.offset)
                        literal_kind <- fdt_value_at(file.enum_annotations, "__field_default_kind", annotation.line, annotation.offset)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FieldDefaultTypeMismatch, name: annotation.name, line: annotation.line, expected: field_type, actual: literal_kind}) if literal_never_fits(literal_kind, field_type)
