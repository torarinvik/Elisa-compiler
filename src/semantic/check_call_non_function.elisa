# Check for a call whose callee is a bare identifier that infers to a firm
# scalar primitive (int/float/bool/char/string) — such a value has no call
# form, so `n()` on `n: i64 = 3` can never resolve. A real function name is
# never recorded in the local-type table, so it infers Unknown and is never
# flagged; a fn-typed local's bare type name is "" (Unknown) too, so it is
# also silent. Method/qualified callees (Field/Scope) are a different shape
# and are left untouched here.

extend Semantic:
    private:
        # Walk through expressions, checking for calls to non-function values.
        def walk_expression_for_call_non_function(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_call_non_function(left, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_type: InferType = infer_expression_type(callee, var_types, type_names, table)
                        actual: sview = stage0_value_spelling(callee_type)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallNonFunction, name: callee_name, line: line, expected: "", actual: actual}) if callee is Expr.Ident(callee_name, callee_line) and (callee_type.kind == TypeKind.Int or callee_type.kind == TypeKind.Float or callee_type.kind == TypeKind.Bool or callee_type.kind == TypeKind.Char or callee_type.kind == TypeKind.String)
                        table <- walk_expression_for_call_non_function(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_call_non_function(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_call_non_function(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_call_non_function(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_call_non_function(object, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_call_non_function(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_call_non_function(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_call_non_function(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_call_non_function(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_call_non_function(object, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(low, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_call_non_function(object, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_call_non_function(argument, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_call_non_function(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_call_non_function(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_call_non_function(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_call_non_function(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_call_non_function(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_call_non_function(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_call_non_function(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_call_non_function(condition, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_call_non_function(iterable, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(condition, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_call_non_function(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_call_non_function(statements, table, var_types, type_names)
                        table <- walk_expression_for_call_non_function(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_call_non_function(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_call_non_function(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for calls to non-functions.
        def walk_statements_for_call_non_function(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_call_non_function(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_call_non_function(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_call_non_function(target, table, var_types, type_names)
                            table <- walk_expression_for_call_non_function(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_call_non_function(condition, table, var_types, type_names)
                            table <- walk_statements_for_call_non_function(then_body, table, var_types, type_names)
                            table <- walk_statements_for_call_non_function(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_call_non_function(condition, table, var_types, type_names)
                            table <- walk_statements_for_call_non_function(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_call_non_function(iterable, table, var_types, type_names)
                            table <- walk_statements_for_call_non_function(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_call_non_function(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_call_non_function(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_call_non_function(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_call_non_function(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_call_non_function(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_call_non_function(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_call_non_function_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_call_non_function(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_call_non_function_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_call_non_function_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_call_non_function(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_call_non_function_declarations(declarations, table)
