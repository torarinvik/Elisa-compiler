# Check for assignment (`<-` or a compound op) to a struct field that was NOT declared
# `mutable`. In Elisa a struct field is immutable unless its declared type is wrapped
# `mutable T` (StructMember has no separate mutable flag — see `type_is_mutable`).
# Sound: fires ONLY when the object firmly infers to a REGISTERED struct (known, closed
# field set) AND the named field is itself registered on that struct AND recorded as
# NOT mutable. Unknown objects, unregistered structs, and unregistered fields never fire
# (those are the job of UnknownField / a Named-with-Unknown-field case, not this check).
# Plain `=` (define) is not a mutation of an existing field — only `<-` and compound ops.

extend Semantic:
    private:
        # Bare struct/type name behind a possibly-`mutable`/`lmut`/ref-wrapped type
        # expression. The shared `bare_type_name` only sees through `mutable`, so a
        # `mutable P&`/`P&` PARAMETER (the overwhelmingly common shape for a mutation
        # target — a bare-value `p: P` parameter can never be the target of `p.a <- v`
        # in the first place) would otherwise type as Unknown and this check could
        # never fire on realistic code. Local to this file; does not touch the shared
        # helper other checks rely on.
        def bare_type_name_through_ref(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, unary_line):
                        return "mutable_view" if operator == TokenKind.Mutable and bare_type_name_through_ref(operand) == "view"
                        return "mutable_darray" if operator == TokenKind.Mutable and bare_type_name_through_ref(operand) == "darray"
                        return "mutable_array" if operator == TokenKind.Mutable and bare_type_name_through_ref(operand) == "array"
                        return bare_type_name_through_ref(operand) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    Expr.Ident(name, ident_line):
                        return name
                    Expr.Index(object, argument, index_line):
                        match object:
                            Expr.Field(owner, field, field_line):
                                return "packed_store" if field == "Store" else ""
                            _:
                                return bare_type_name_through_ref(object)
                    Expr.IndexN(object, arguments, index_line):
                        match object:
                            Expr.Field(owner_n, field_n, field_line_n):
                                return "packed_store" if field_n == "Store" else ""
                            _:
                                return bare_type_name_through_ref(object)
                    _:
                        pass
                return ""

        # Whether an operator token is a mutating assignment: `<-` or any compound op.
        def is_mutating_assign_operator(operator: TokenKind) -> bool:
            can Abort.Panic:
                return when operator:
                    TokenKind.LArrow | TokenKind.PlusEq | TokenKind.MinusEq | TokenKind.StarEq | TokenKind.SlashEq | TokenKind.PercentEq | TokenKind.LShiftEq | TokenKind.RShiftEq | TokenKind.AmpEq | TokenKind.PipeEq | TokenKind.CaretEq -> true
                    _ -> false

        # Walk through expressions, recursing into sub-expressions (this check has no
        # expression-level logic of its own — the field-assign check lives in the
        # statement walker — but we still need a full expression walk for nested blocks/
        # lambdas/matches that may themselves contain field assignments).
        def walk_expression_for_field_immutable_assign(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl], return_type: Ast::Expr) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_field_immutable_assign(left, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(right, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write} if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_mutable_view_call_arguments(callee, arguments, argument_names, line.line, declarations, table.current_module, table, var_types, type_names, type_expressions, expression_names)
                        table <- walk_expression_for_field_immutable_assign(callee, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        for argument in arguments |table|:
                            table <- walk_expression_for_field_immutable_assign(argument, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_field_immutable_assign(object, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_field_immutable_assign(base, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_field_immutable_assign(object, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(index, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write} if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_field_immutable_assign(operand, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_field_immutable_assign(inner, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_field_immutable_assign(element, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_field_immutable_assign(element, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_field_immutable_assign(object, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(low, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(high, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_field_immutable_assign(object, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        for argument in arguments |table|:
                            table <- walk_expression_for_field_immutable_assign(argument, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write} if not index_receiver_is_type_application(object)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_field_immutable_assign(element, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_field_immutable_assign(entry.key, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            table <- walk_expression_for_field_immutable_assign(entry.value, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_field_immutable_assign(type_expression, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        construct_owner: (found: bool, name: sview, module_owner: sview) = mv_struct_owner(type_expression, table.current_module, table)
                        for field in fields |table|:
                            check_mutable_view_struct_field_source(field.name, field.value, line.line, construct_owner.name, construct_owner.module_owner, table.current_module, table, var_types, type_names, type_expressions, expression_names, declarations) if construct_owner.found
                            table <- walk_expression_for_field_immutable_assign(field.value, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_field_immutable_assign(base, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        base_type: InferType = infer_expression_type(base, var_types, type_names, table)
                        base_owner: (found: bool, name: sview, module_owner: sview) = mv_struct_owner(Expr.Ident(base_type.name, Ast::pos_at_line(0)), table.current_module, table) if base_type.kind == SemTypeKind.Named else (false, "", "")
                        for field in fields |table|:
                            check_mutable_view_struct_field_source(field.name, field.value, line.line, base_owner.name, base_owner.module_owner, table.current_module, table, var_types, type_names, type_expressions, expression_names, declarations) if base_type.kind == SemTypeKind.Named and base_owner.found
                            table <- walk_expression_for_field_immutable_assign(field.value, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_field_immutable_assign(condition, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(then_expr, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(else_expr, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        table <- walk_expression_for_field_immutable_assign(iterable, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        comprehension_scope_mark: usize = var_types.count
                        comprehension_expression_mark: usize = type_expressions.count
                        mv_note_iterable_element_binding(loop_variable, iterable, table.current_module, table, var_types, type_names, type_expressions, expression_names)
                        table <- walk_expression_for_field_immutable_assign(condition, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        close_type_scope(comprehension_scope_mark, var_types, type_names, table)
                        type_expressions.truncate(comprehension_expression_mark)
                        expression_names.truncate(comprehension_expression_mark)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_field_immutable_assign_lambda(parameters, body, table, var_types, type_names, type_expressions, expression_names, declarations) can Global{Read,Write}
                    Expr.Block(statements, value, captures, line):
                        block_scope_mark: usize = var_types.count
                        block_expression_mark: usize = type_expressions.count
                        table <- walk_statements_for_field_immutable_assign(statements, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        table <- walk_expression_for_field_immutable_assign(value, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        close_type_scope(block_scope_mark, var_types, type_names, table)
                        type_expressions.truncate(block_expression_mark)
                        expression_names.truncate(block_expression_mark)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- walk_expression_for_field_immutable_assign(scrutinee, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        for arm in arms |table|:
                            arm_mark: usize = var_types.count
                            arm_expression_mark: usize = type_expressions.count
                            bindings: mutable darray[sview @source] = []
                            collect_pattern_binding_names(arm.pattern, bindings)
                            for binding_name in bindings |table|:
                                note_local_type(var_types, type_names, binding_name, "__firm_scope_binder__")
                                type_expressions.push(Expr.Absent)
                                expression_names.push(binding_name)
                                note_local_type_id_direct(binding_name, 0, table)
                            table <- walk_expression_for_field_immutable_assign(arm.guard, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            table <- walk_field_immutable_assign_scope(arm.body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            close_type_scope(arm_mark, var_types, type_names, table)
                            type_expressions.truncate(arm_expression_mark)
                            expression_names.truncate(arm_expression_mark)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # A mutating assignment whose target is an immutable struct field. Extracted so the
        # statement walk's Assign arm dispatches once instead of pyramiding a
        # match-target + Named + registered/has-field + immutable chain (docs/121 flow).
        def check_field_immutable_target(target: Ast::Expr, line: u32, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Field(object, field, field_line):
                        object_type: Semantic::InferType = infer_expression_type(object, var_types, type_names, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FieldImmutableAssign, name: field, pos: field_line, line: line, expected: "", actual: ""}) if object_type.kind == SemTypeKind.Named and struct_is_registered(table, object_type.name) and struct_has_field(table, object_type.name, field) and not field_is_mutable(table, object_type.name, field)
                        is_string_size_field: bool = when field:
                            "len" | "length" -> true
                            _ -> false
                        if is_string_size_field:
                            string_type: mutable sview = object_type.name if object_type.kind == SemTypeKind.String else ""
                            if string_type == "":
                                match object:
                                    Expr.Ident(name, ident_line):
                                        string_type <- local_type_of(var_types, type_names, name)
                                    _:
                                        pass
                            is_readonly_string_field: bool = (field == "len" and (string_type == "cstr" or string_type == "dstr" or string_type == "sview")) or (field == "length" and string_type == "sview")
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FieldImmutableAssign, name: field, pos: field_line, line: line, expected: "", actual: ""}) if is_readonly_string_field
                    _:
                        pass


        def check_readonly_index_target(target: Ast::Expr, line: u32, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Index(object, index, index_line):
                        match object:
                            Expr.Ident(name, ident_line):
                                receiver_type: sview = local_type_of(var_types, type_names, name)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadonlyViewIndexAssign, name: name, line: line, expected: "", actual: ""}) if receiver_type == "view"
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StringViewIndexAssign, name: name, line: line, expected: "", actual: ""}) if receiver_type == "sview"
                                is_string_index_type: bool = when receiver_type:
                                    "cstr" | "dstr" -> true
                                    _ -> false
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StringIndexAssign, name: name, line: line, expected: "", actual: ""}) if is_string_index_type
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PackedStoreIndexAssign, name: name, line: line, expected: "", actual: ""}) if receiver_type == "packed_store"
                            _:
                                pass
                    _:
                        pass


        def check_mutable_iteration(bind: sview, iterable: Ast::Expr, line: u32, table: lmut SymbolTable, var_types: darray[sview]&, type_names: darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match iterable:
                    Expr.Ident(name, ident_line):
                        iterable_type: sview = local_type_of(var_types, type_names, name)
                        is_readonly_iteration_view: bool = when iterable_type:
                            "view" | "sview" -> true
                            _ -> false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableIterationReadonlyView, name: name, line: line, expected: "", actual: ""}) if bind == "mutable" and is_readonly_iteration_view
                    _:
                        pass

        # Walk through statements, tracking variable types and checking field assignments.
        def walk_statements_for_field_immutable_assign(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview @source]&, type_expressions: mutable darray[Ast::Expr]&, expression_names: mutable darray[sview]&, declarations: darray[Ast::Decl], return_type: Ast::Expr) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_field_immutable_assign(expression, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_mutable_view_initializer(name, type_expression, value, line.line, table.current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                            type_family: sview = mv_type_family(type_expression, table.current_module, table)
                            type_name: sview = type_family if type_family == "array" or type_family == "mutable_array" or type_family == "darray" or type_family == "mutable_darray" or type_family == "view" or type_family == "mutable_view" else bare_type_name_through_ref(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            type_expressions.push(type_expression)
                            expression_names.push(name)
                            note_field_assign_local_type_id(name, type_expression, table) can Global{Read,Write}
                            table <- walk_expression_for_field_immutable_assign(value, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        Stmt.Assign(target, operator, value, line):
                            table <- check_mutable_view_assignment(target, value, line.line, table.current_module, table, var_types, type_names, type_expressions, expression_names, declarations)
                            table <- check_field_immutable_target(target, line.line, table, var_types, type_names) if is_mutating_assign_operator(operator)
                            table <- check_readonly_index_target(target, line.line, table, var_types, type_names) if is_mutating_assign_operator(operator)
                            table <- walk_expression_for_field_immutable_assign(target, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            table <- walk_expression_for_field_immutable_assign(value, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_field_immutable_assign(condition, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            table <- walk_field_immutable_assign_scope(then_body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            table <- walk_field_immutable_assign_scope(else_body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_field_immutable_assign(condition, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            table <- walk_field_immutable_assign_scope(body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_mutable_iteration(bind, iterable, line.line, table, var_types, type_names)
                            table <- walk_expression_for_field_immutable_assign(iterable, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            loop_scope_mark: usize = var_types.count
                            loop_expression_mark: usize = type_expressions.count
                            if variables.count == 1:
                                mv_note_iterable_element_binding(variables[0], iterable, table.current_module, table, var_types, type_names, type_expressions, expression_names)
                            else:
                                for variable in variables |table|:
                                    note_local_type(var_types, type_names, variable, "__firm_scope_binder__")
                                    type_expressions.push(Expr.Absent)
                                    expression_names.push(variable)
                                    note_local_type_id_direct(variable, 0, table)
                            table <- walk_field_immutable_assign_scope(body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            close_type_scope(loop_scope_mark, var_types, type_names, table)
                            type_expressions.truncate(loop_expression_mark)
                            expression_names.truncate(loop_expression_mark)
                        Stmt.Block(kind, clause, binding, body, line):
                            scope_mark: usize = var_types.count
                            expression_mark: usize = type_expressions.count
                            if binding != "":
                                note_local_type(var_types, type_names, binding, "__firm_scope_binder__")
                                type_expressions.push(Expr.Absent)
                                expression_names.push(binding)
                                note_local_type_id_direct(binding, 0, table)
                            table <- walk_statements_for_field_immutable_assign(body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            close_type_scope(scope_mark, var_types, type_names, table)
                            type_expressions.truncate(expression_mark)
                            expression_names.truncate(expression_mark)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_field_immutable_assign(scrutinee, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                            for arm in arms |table|:
                                arm_mark: usize = var_types.count
                                arm_expression_mark: usize = type_expressions.count
                                bindings: mutable darray[sview @source] = []
                                collect_pattern_binding_names(arm.pattern, bindings)
                                for binding_name in bindings |table|:
                                    note_local_type(var_types, type_names, binding_name, "__firm_scope_binder__")
                                    type_expressions.push(Expr.Absent)
                                    expression_names.push(binding_name)
                                    note_local_type_id_direct(binding_name, 0, table)
                                table <- walk_expression_for_field_immutable_assign(arm.guard, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                                table <- walk_statements_for_field_immutable_assign(arm.body, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                                close_type_scope(arm_mark, var_types, type_names, table)
                                type_expressions.truncate(arm_expression_mark)
                                expression_names.truncate(arm_expression_mark)
                        Stmt.Return(value, line):
                            table <- check_mutable_view_value_against(return_type, return_value, "return", table.current_module, table.current_module, table, var_types, type_names, type_expressions, expression_names, declarations) if value is return_value
                            table <- walk_expression_for_field_immutable_assign(return_value, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write} if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_field_immutable_assign(expression, table, var_types, type_names, type_expressions, expression_names, declarations, return_type) can Global{Read,Write}
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # This walk has no block-exit truncation, so a re-declaration with a DIFFERENT
        # structural type degrades the name to unknown (0) rather than letting an inner
        # shadow outlive its block -- the same conservatism as the flat channel.
        def note_field_assign_local_type_id(name: sview @source, type_expression: Ast::Expr, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                type_id: u32 = annotation_type_id(type_expression, table) can Global{Read,Write}
                conflicting: bool = local_type_bound(name, table) and local_type_id_of(name, table) != type_id
                note_local_type_id_direct(name, 0 if conflicting else type_id, table)

        # Walk through function declarations.
        def check_field_immutable_assign_declarations(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl], table: lmut SymbolTable, current_module: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # The STRUCTURAL channel (table.local_type_names/ids) is what
                            # infer_expression_type reads for an indexed receiver such as
                            # `rows[i].f <- v`. Without a fresh seed here it still held the
                            # LAST function some earlier pass walked, so the check fired only
                            # when that happened to be this function (difffuzz 2026-10-04:
                            # `sa[0].f0 <- 5` was rejected in a file's last function, accepted
                            # in every other one).
                            outer_module: sview = table.current_module
                            table.current_module <- current_module
                            seed_local_type_ids(params, table) can Global{Read,Write}
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview @source] = []
                            type_expressions: mutable darray[Ast::Expr] = []
                            expression_names: mutable darray[sview] = []
                            for param in params |table|:
                                param_family: sview = mv_type_family(param.type_expression, table.current_module, table)
                                param_type: sview = param_family if param_family == "view" or param_family == "mutable_view" or param_family == "array" or param_family == "mutable_array" or param_family == "darray" or param_family == "mutable_darray" else bare_type_name_through_ref(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                                type_expressions.push(param.type_expression)
                                expression_names.push(param.name)
                            table <- walk_statements_for_field_immutable_assign(body, table, var_types, type_names, type_expressions, expression_names, all_declarations, return_type) can Global{Read,Write}
                            table.current_module <- outer_module
                        Decl.Module(module_name, body, line):
                            outer_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- check_field_immutable_assign_declarations(body, all_declarations, table, module_name) can Global{Read,Write}
                            table.current_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- check_field_immutable_assign_declarations(body, all_declarations, table, current_module) can Global{Read,Write}
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_field_immutable_assign(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_field_immutable_assign_declarations(declarations, declarations, table, table.current_module) can Global{Read,Write}
