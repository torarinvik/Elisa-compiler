# Struct-field `where` refinement scope. A field's `where` predicate may reference only the
# field itself or EARLIER-declared fields — a later field is not yet in scope at that point
# (`start: i64 where start < end` with `end` declared after `start`). SOUND + precise: we flag
# only an identifier that exactly matches a LATER field name; references to the field itself,
# earlier fields, globals, or type names never fire (a global/type ref is a different stage0
# diagnostic, not this one).
extend Semantic:
    private:
        # The first identifier in PREDICATE that names one of LATER_FIELDS, or "" if none.
        def struct_field_later_ref(predicate: Ast::Expr, later_fields: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Ident(name, line):
                        name return if (any later in later_fields where later == name)
                        return sview("", 0, 0)
                    Expr.Binary(left, operator, right, binary_line):
                        left_found: sview = struct_field_later_ref(left, later_fields)
                        left_found return if left_found != ""
                        return struct_field_later_ref(right, later_fields)
                    Expr.Unary(operator, operand, unary_line):
                        return struct_field_later_ref(operand, later_fields)
                    Expr.Paren(inner, paren_line):
                        return struct_field_later_ref(inner, later_fields)
                    Expr.Field(object, field, field_line):
                        # Only the receiver is an identifier reference; the field label is not.
                        return struct_field_later_ref(object, later_fields)
                    Expr.Index(head, argument, index_line):
                        head_found: sview = struct_field_later_ref(head, later_fields)
                        head_found return if head_found != ""
                        return struct_field_later_ref(argument, later_fields)
                    Expr.If(condition, then_expression, else_expression, if_line):
                        condition_found: sview = struct_field_later_ref(condition, later_fields)
                        condition_found return if condition_found != ""
                        then_found: sview = struct_field_later_ref(then_expression, later_fields)
                        then_found return if then_found != ""
                        return struct_field_later_ref(else_expression, later_fields)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_found: sview = struct_field_later_ref(callee, later_fields)
                        callee_found return if callee_found != ""
                        offender: mutable sview = sview("", 0, 0)
                        for argument in arguments |offender|:
                            candidate: sview = struct_field_later_ref(argument, later_fields)
                            offender <- candidate if offender == "" and candidate != ""
                        return offender
                    _:
                        return sview("", 0, 0)

        def check_struct_field_where_scope_members(members: darray[Ast::StructMember], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                field_names: mutable darray[sview] = []
                field_names.extend([member.name for member in members])
                member_index: mutable usize = 0
                while member_index < members.count |member_index, table| -> table:
                    predicate: Ast::Expr = where_predicate_of_type(members[member_index].type_expression)
                    later_fields: mutable darray[sview] = []
                    later_index: mutable usize = member_index + 1
                    while later_index < field_names.count |later_index, later_fields|:
                        later_fields.push(field_names[later_index])
                        later_index <- later_index + 1
                    offender: sview = struct_field_later_ref(predicate, later_fields)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructFieldWhereRefScope, name: members[member_index].name, line: line, expected: "", actual: offender}) if offender != ""
                    member_index <- member_index + 1

        def check_struct_field_where_scope(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            table <- check_struct_field_where_scope_members(members, struct_line.line, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_struct_field_where_scope(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_struct_field_where_scope(scoped_body, table)
                        _:
                            pass
