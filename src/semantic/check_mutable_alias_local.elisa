# Mutable aliasing through a LOCAL borrow (strict mode). `check_strict_unsafe_ops` catches a
# direct double mutable borrow (`mutate(x, x)`) and a one-level ref-returning wrapper
# (`mutate(get_ref(x), x)`); this catches the residual where the wrapper's result is bound to a
# local first: `r: mutable i32& = get_ref(x); mutate_pair(r, x)` — r aliases x, so passing both is
# two live mutable borrows of x and needs `can Unsafe.Alias`. SOUND subset: r must be a `mutable
# T&`-typed local bound to a call carrying a mutable-ref parameter (that call forwards the borrow);
# an alias is reported only when at least one of the colliding arguments is such a local (so the
# direct cases the other pass already handles are never double-reported).
extend Semantic:
    private:
        def mal_call_forwarded_param(value: Ast::Expr, mutable_params: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, line):
                        # A UFCS method call `box.identity()` forwards its RECEIVER (self); a free
                        # call forwards a mutable-param argument.
                        receiver_name: sview = match callee:
                            Expr.Field(receiver, method, field_line): ident_name_of(receiver)
                            _: sview("", 0, 0)
                        receiver_name return if receiver_name != "" and (any p in mutable_params where p == receiver_name)
                        found: mutable sview = sview("", 0, 0)
                        for argument in arguments |found|:
                            argument_name: sview = ident_name_of(argument)
                            found <- argument_name if found == "" and argument_name != "" and (any p in mutable_params where p == argument_name)
                        return found
                    Expr.Paren(inner, line):
                        return mal_call_forwarded_param(inner, mutable_params)
                    _:
                        return sview("", 0, 0)

        def mal_collect_local_aliases_expression(expression: Ast::Expr, mutable_params: darray[sview]&, out_names: mutable darray[sview]&, out_bases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        mal_collect_local_aliases_expression(callee, mutable_params, out_names, out_bases)
                        for argument in arguments |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(argument, mutable_params, out_names, out_bases)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for argument in arguments |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(argument, mutable_params, out_names, out_bases)
                        for candidate in candidates |mutable_params, out_names, out_bases|:
                            for capture in candidate.captures |mutable_params, out_names, out_bases|:
                                mal_collect_local_aliases_expression(capture, mutable_params, out_names, out_bases)
                    Expr.Field(object, field, line):
                        mal_collect_local_aliases_expression(object, mutable_params, out_names, out_bases)
                    Expr.Scope(base, name, line):
                        if base is not Expr.Ident(_, _):
                            mal_collect_local_aliases_expression(base, mutable_params, out_names, out_bases)
                    Expr.Index(object, index, line):
                        mal_collect_local_aliases_expression(object, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(index, mutable_params, out_names, out_bases)
                    Expr.Slice(object, low, high, line):
                        mal_collect_local_aliases_expression(object, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(low, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(high, mutable_params, out_names, out_bases)
                    Expr.IndexN(object, arguments, line):
                        mal_collect_local_aliases_expression(object, mutable_params, out_names, out_bases)
                        for argument in arguments |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(argument, mutable_params, out_names, out_bases)
                    Expr.Binary(left, operator, right, line):
                        mal_collect_local_aliases_expression(left, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(right, mutable_params, out_names, out_bases)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line) | Expr.Paren(operand, line):
                        mal_collect_local_aliases_expression(operand, mutable_params, out_names, out_bases)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(element, mutable_params, out_names, out_bases)
                    Expr.DictLit(entries, line):
                        for entry in entries |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(entry.key, mutable_params, out_names, out_bases)
                            mal_collect_local_aliases_expression(entry.value, mutable_params, out_names, out_bases)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(field.value, mutable_params, out_names, out_bases)
                    Expr.RecordUpdate(base, fields, line):
                        mal_collect_local_aliases_expression(base, mutable_params, out_names, out_bases)
                        for field in fields |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(field.value, mutable_params, out_names, out_bases)
                    Expr.If(condition, then_value, else_value, line):
                        mal_collect_local_aliases_expression(condition, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(then_value, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(else_value, mutable_params, out_names, out_bases)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        mal_collect_local_aliases_expression(scrutinee, mutable_params, out_names, out_bases)
                        for arm in arms |mutable_params, out_names, out_bases|:
                            mal_collect_local_aliases_expression(arm.guard, mutable_params, out_names, out_bases)
                            mal_collect_local_aliases(arm.body, mutable_params, out_names, out_bases)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        mal_collect_local_aliases_expression(iterable, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(condition, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(body, mutable_params, out_names, out_bases)
                    Expr.Refinement(base, predicate, line):
                        mal_collect_local_aliases_expression(base, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(predicate, mutable_params, out_names, out_bases)
                    Expr.GetElse(guarded, recovery, line):
                        mal_collect_local_aliases_expression(guarded, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases(recovery, mutable_params, out_names, out_bases)
                    Expr.Block(statements, value, captures, line):
                        mal_collect_local_aliases(statements, mutable_params, out_names, out_bases)
                        mal_collect_local_aliases_expression(value, mutable_params, out_names, out_bases)
                    Expr.Lambda(parameters, body, line):
                        mal_collect_local_aliases(body, mutable_params, out_names, out_bases)
                    _:
                        pass

        # Collect `r: mutable T& = <call carrying a mutable param>` local aliases (r -> that param).
        def mal_collect_local_aliases(statements: darray[Ast::Stmt], mutable_params: darray[sview]&, out_names: mutable darray[sview]&, out_bases: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_bases|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            base: sview = mal_call_forwarded_param(value, mutable_params) if type_marker_present_here(type_expression, TokenKind.Ampersand) else sview("", 0, 0)
                            if base != "":
                                out_names.push(name)
                                out_bases.push(base)
                            mal_collect_local_aliases_expression(value, mutable_params, out_names, out_bases)
                        Stmt.Expr(expression, line):
                            mal_collect_local_aliases_expression(expression, mutable_params, out_names, out_bases)
                        Stmt.Assign(target, operator, value, line):
                            mal_collect_local_aliases_expression(target, mutable_params, out_names, out_bases)
                            mal_collect_local_aliases_expression(value, mutable_params, out_names, out_bases)
                        Stmt.Return(value, line):
                            if value is returned:
                                mal_collect_local_aliases_expression(returned, mutable_params, out_names, out_bases)
                        Stmt.If(condition, then_body, else_body, line):
                            mal_collect_local_aliases_expression(condition, mutable_params, out_names, out_bases)
                            mal_collect_local_aliases(then_body, mutable_params, out_names, out_bases)
                            mal_collect_local_aliases(else_body, mutable_params, out_names, out_bases)
                        Stmt.While(condition, body, line):
                            mal_collect_local_aliases_expression(condition, mutable_params, out_names, out_bases)
                            mal_collect_local_aliases(body, mutable_params, out_names, out_bases)
                        Stmt.For(bind, variables, iterable, body, line):
                            mal_collect_local_aliases_expression(iterable, mutable_params, out_names, out_bases)
                            mal_collect_local_aliases(body, mutable_params, out_names, out_bases)
                        Stmt.Block(kind, clause, binding, body, line):
                            mal_collect_local_aliases(body, mutable_params, out_names, out_bases)
                        Stmt.Match(scrutinee, arms, line):
                            mal_collect_local_aliases_expression(scrutinee, mutable_params, out_names, out_bases)
                            for arm in arms |out_names, out_bases, mutable_params|:
                                mal_collect_local_aliases_expression(arm.guard, mutable_params, out_names, out_bases)
                                mal_collect_local_aliases(arm.body, mutable_params, out_names, out_bases)
                        Stmt.Contract(kind, expression, line):
                            mal_collect_local_aliases_expression(expression, mutable_params, out_names, out_bases)
                        _:
                            pass

        # Detect a call two of whose arguments alias the same mutable param, with at least one via a
        # local alias. Emits MutableAliasUngranted once per such call.
        def mal_check_call(arguments: darray[Ast::Expr], mutable_params: darray[sview]&, alias_names: darray[sview]&, alias_bases: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                seen_bases: mutable darray[sview] = []
                seen_local: mutable darray[bool] = []
                aliased: mutable bool = false
                for argument in arguments |seen_bases, seen_local, aliased|:
                    argument_name: sview = ident_name_of(argument)
                    local_base: sview = parallel_lookup_first(alias_names, alias_bases, argument_name)
                    direct_base: sview = argument_name if argument_name != "" and (any p in mutable_params where p == argument_name) else sview("", 0, 0)
                    base: sview = local_base if local_base != "" else direct_base
                    via_local: bool = local_base != ""
                    if base != "":
                        collide: bool =
                            for probe in 0..<seen_bases.count |hit: bool = false| -> hit:
                                hit <- true if seen_bases[probe] == base and (via_local or seen_local[probe])
                        aliased <- true if collide
                        seen_bases.push(base)
                        seen_local.push(via_local)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MutableAliasUngranted, name: "", line: line, expected: "", actual: ""}) if aliased

        def mal_walk(statements: darray[Ast::Stmt], mutable_params: darray[sview]&, alias_names: darray[sview]&, alias_bases: darray[sview]&, alias_granted: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- mal_expr(expression, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- mal_expr(value, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- mal_expr(target, mutable_params, alias_names, alias_bases, alias_granted, table)
                            table <- mal_expr(value, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- mal_expr(returned, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- mal_expr(condition, mutable_params, alias_names, alias_bases, alias_granted, table)
                            table <- mal_walk(then_body, mutable_params, alias_names, alias_bases, alias_granted, table)
                            table <- mal_walk(else_body, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.While(condition, body, line):
                            table <- mal_expr(condition, mutable_params, alias_names, alias_bases, alias_granted, table)
                            table <- mal_walk(body, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- mal_expr(iterable, mutable_params, alias_names, alias_bases, alias_granted, table)
                            table <- mal_walk(body, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- mal_expr(scrutinee, mutable_params, alias_names, alias_bases, alias_granted, table)
                            for arm in arms |table, line, mutable_params, alias_names, alias_bases, alias_granted|:
                                table <- mal_expr(arm.guard, mutable_params, alias_names, alias_bases, alias_granted, table)
                                table <- mal_walk(arm.body, mutable_params, alias_names, alias_bases, alias_granted, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            grant_here: bool = alias_granted or ((kind == "can" or kind == "trusted") and strict_unsafe_grant_covers(clause, "Unsafe.Alias"))
                            table <- mal_walk(body, mutable_params, alias_names, alias_bases, grant_here, table)
                        Stmt.Contract(kind, expression, line):
                            table <- mal_expr(expression, mutable_params, alias_names, alias_bases, alias_granted, table)
                        _:
                            pass

        def mal_expr(expression: Ast::Expr, mutable_params: darray[sview]&, alias_names: darray[sview]&, alias_bases: darray[sview]&, alias_granted: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        # A grant authorizes this call only. Keep traversing its children:
                        # in particular, a lambda created in an Unsafe.Alias block executes
                        # later and must be checked under its own (empty) grant set.
                        table <- mal_check_call(arguments, mutable_params, alias_names, alias_bases, line.line, table) if not alias_granted
                        table <- mal_expr(callee, mutable_params, alias_names, alias_bases, alias_granted, table)
                        for argument in arguments |table| -> table:
                            table <- mal_expr(argument, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for argument in arguments |table| -> table:
                            table <- mal_expr(argument, mutable_params, alias_names, alias_bases, alias_granted, table)
                        for candidate in candidates |table|:
                            for capture in candidate.captures |table| -> table:
                                table <- mal_expr(capture, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Field(object, field, line):
                        table <- mal_expr(object, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Scope(base, name, line):
                        if base is not Expr.Ident(_, _):
                            table <- mal_expr(base, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Index(object, index, line):
                        table <- mal_expr(object, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(index, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Slice(object, low, high, line):
                        table <- mal_expr(object, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(low, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(high, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.IndexN(object, arguments, line):
                        table <- mal_expr(object, mutable_params, alias_names, alias_bases, alias_granted, table)
                        for argument in arguments |table| -> table:
                            table <- mal_expr(argument, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Binary(left, operator, right, line):
                        table <- mal_expr(left, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(right, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.RegionNew(operand, _, line) | Expr.Paren(operand, line):
                        table <- mal_expr(operand, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- mal_expr(element, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- mal_expr(entry.key, mutable_params, alias_names, alias_bases, alias_granted, table)
                            table <- mal_expr(entry.value, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |table| -> table:
                            table <- mal_expr(field.value, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- mal_expr(base, mutable_params, alias_names, alias_bases, alias_granted, table)
                        for field in fields |table| -> table:
                            table <- mal_expr(field.value, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.If(condition, then_value, else_value, line):
                        table <- mal_expr(condition, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(then_value, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(else_value, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- mal_expr(scrutinee, mutable_params, alias_names, alias_bases, alias_granted, table)
                        for arm in arms |table, mutable_params, alias_names, alias_bases, alias_granted|:
                            table <- mal_expr(arm.guard, mutable_params, alias_names, alias_bases, alias_granted, table)
                            table <- mal_walk(arm.body, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        table <- mal_expr(iterable, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(condition, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(body, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Refinement(base, predicate, line):
                        table <- mal_expr(base, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(predicate, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- mal_expr(guarded, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_walk(recovery, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Block(statements, value, captures, line):
                        table <- mal_walk(statements, mutable_params, alias_names, alias_bases, alias_granted, table)
                        table <- mal_expr(value, mutable_params, alias_names, alias_bases, alias_granted, table)
                    Expr.Lambda(parameters, body, line):
                        table <- mal_walk(body, mutable_params, alias_names, alias_bases, false, table)
                    _:
                        pass

        def check_mutable_alias_local_decls(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            mutable_params: mutable darray[sview] = []
                            for parameter in parameters |mutable_params|:
                                mutable_params.push(parameter.name) if param_is_mutable_ref(parameter)
                            alias_names: mutable darray[sview] = []
                            alias_bases: mutable darray[sview] = []
                            mal_collect_local_aliases(body, mutable_params, alias_names, alias_bases)
                            table <- mal_walk(body, mutable_params, alias_names, alias_bases, false, table) if alias_names.count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_mutable_alias_local_decls(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_mutable_alias_local_decls(scoped_body, table)
                        _:
                            pass

    public:
        def check_mutable_alias_local(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_mutable_alias_local_decls(declarations, table)
