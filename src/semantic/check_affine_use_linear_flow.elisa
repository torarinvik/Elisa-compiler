                            if mapped.accepted and (not exact_only or (mapped.exact and not affine_call_declaration_is_generic(line.line, line.offset, annotations, table))) and affine_callable_symbol_visible(table, annotations, name, declaration_module, line.line, line.offset, selected_module, SymbolKind.Func):
