        def check_affine_uses(declarations: darray[Ast::Decl], current_module: sview @source, file: Ast::File&, linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, try_lines: darray[u32]&, table: lmut SymbolTable) -> void:
