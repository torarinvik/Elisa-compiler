        def affine_callable_symbol_visible(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview @source, candidate_module: sview @source, declaration_line: u32, declaration_offset: u32, lexical_module: sview @source, wanted_kind: SymbolKind) -> bool:
