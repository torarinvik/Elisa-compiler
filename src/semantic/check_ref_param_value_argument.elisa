extend Semantic:
    private:
        # A `T&` parameter borrows a PLACE. stage0 borrows a named one for the caller
        # (`first(local)`), but a computed scalar (`first(input + offset)`, `first(-n)`) is a
        # value: `argument 1 to "first" expects i64&, got i64`. stage1 materialized a temporary
        # and passed its address, so a port written with C pointer arithmetic compiled and
        # read one temporary instead of the buffer it meant (lamport_signature).
        def check_ref_param_value_argument(fn_name: sview @source, argument: Ast::Expr, position: usize, line: u32, var_types: darray[sview @source]&, type_names: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if argument is Expr.Slice(sliced, low, high, slice_pos):
                    table <- check_slice_ref_param_argument(fn_name, argument, position, line, table)
                    return
                return if not is_computed_scalar_expression(argument)
                row: u32 = function_parameter_row_at_firm(table, fn_name, position)
                return if row == 4294967295 or row.usize() >= table.function_param_type_id.count
                parameter_type_id: u32 = table.function_param_type_id[row.usize()]
                return if interned_kind(parameter_type_id, table) != SemTypeKind.Ref
                pointee: sview @source = interned_name(interned_elem(parameter_type_id, 0, table), table)
                return if not SemanticPrimitiveTypeName::is_builtin_scalar_type_name(pointee)
                value_spelling: sview = computed_scalar_spelling(argument, var_types, type_names, table)
                # stage0 reads `q + n` over a reference as the dereferenced value, EXCEPT on a
                # byte reference: `p + n` (p: u8&) is pointer arithmetic, a valid `u8&` (the
                # std's `src.cast[u8&] + lo`).
                return if value_spelling == "" and (pointee == "u8" or not (argument is Expr.Binary(left, operator, right, binary_pos)))
                actual: sview = pointee if value_spelling == "" else value_spelling
                mutable_ref: bool = row.usize() < table.function_param_mutable_ref.count and table.function_param_mutable_ref[row.usize()]
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ValueArgRefParam, name: fn_name, pos: Ast::expr_pos(argument), line: line, expected: pointee, actual: actual, expected_count: (position + 1).u32(), state_code: 1 if mutable_ref else 0})



        # A slice is a view {data, length}, not a place a `T&` parameter can borrow;
        # stage0 rejects it (`expects i64&, got view[i64]`), and stage1's backend built
        # the view into a plain pointer, which is invalid IR.
        def check_slice_ref_param_argument(fn_name: sview @source, argument: Ast::Expr, position: usize, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                row: u32 = function_parameter_row_at_firm(table, fn_name, position)
                return if row == 4294967295 or row.usize() >= table.function_param_type_id.count
                parameter_type_id: u32 = table.function_param_type_id[row.usize()]
                return if interned_kind(parameter_type_id, table) != SemTypeKind.Ref
                pointee: sview @source = interned_name(interned_elem(parameter_type_id, 0, table), table)
                mutable_ref: bool = row.usize() < table.function_param_mutable_ref.count and table.function_param_mutable_ref[row.usize()]
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ValueArgRefParam, name: fn_name, pos: Ast::expr_pos(argument), line: line, expected: pointee, actual: pointee, expected_count: (position + 1).u32(), state_code: 3 if mutable_ref else 2})



        # stage0's spelling of a computed scalar, or "" when its type is not inferred
        # (arithmetic over a reference operand).
        def computed_scalar_spelling(argument: Ast::Expr, var_types: darray[sview @source]&, type_names: darray[sview @source]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                whole: InferType = infer_expression_type(argument, var_types, type_names, table)
                return stage0_value_spelling(whole) if whole.kind == SemTypeKind.Int or whole.kind == SemTypeKind.Float or whole.kind == SemTypeKind.Bool
                return ""



        # An arithmetic, comparison or logical result: a value with no place to borrow.
        def is_computed_scalar_expression(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, binary_pos):
                        return true
                    Expr.Unary(operator, operand, unary_pos):
                        return operator == TokenKind.Minus or operator == TokenKind.Not or operator == TokenKind.Bang or operator == TokenKind.Tilde
                    Expr.Paren(inner, paren_pos):
                        return is_computed_scalar_expression(inner)
                    _:
                        return false



        # The parameter-table row of `function_name`'s parameter at `position`.
        def function_parameter_row_at_firm(table: SymbolTable&, function_name: sview, position: usize) -> u32:
            can Abort.Panic:
                seen: mutable usize = 0
                cur: mutable u32 = function_param_chain_head(table, function_name)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == function_name:
                        return cur if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return 4294967295
