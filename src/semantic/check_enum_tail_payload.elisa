extend Semantic:
    private:
        def enum_type_has_tail(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        true return if operator == TokenKind.Tail
                        return enum_type_has_tail(operand)
                    Expr.Paren(inner, line):
                        return enum_type_has_tail(inner)
                    _:
                        return false

        def enum_name_is_packed(name: sview, packed_names: darray[sview]&) -> bool:
            for packed_name in packed_names:
                true return if packed_name == name
            return false

        def check_enum_tail_payload_declarations(declarations: darray[Ast::Decl], packed_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Enum(name, variants, is_const, storage_type, line):
                            if not enum_name_is_packed(name, packed_names):
                                for variant in variants |table|:
                                    for field in variant.fields |table|:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrdinaryEnumTailPayload, name: variant.name, line: line, expected: name, actual: ""}) if enum_type_has_tail(field)
                        Decl.Module(name, body, line):
                            table <- check_enum_tail_payload_declarations(body, packed_names, table)
                        Decl.Scoped(body, line):
                            table <- check_enum_tail_payload_declarations(body, packed_names, table)
                        _:
                            pass

    public:
        def check_enum_tail_payload(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_enum_tail_payload_declarations(file.top_decls, file.packed_enum_names, table)
