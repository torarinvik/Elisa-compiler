# Select a named direct call's primary visible function before diagnosing its
# argument shape. Unknown static branches and ambiguous imports cannot justify
# choosing a declaration.
extend Semantic:
    private:
        def nca_unique_direct_variadic(name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if direct_function_count(table, name) != 1
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE:
                    symbol: Symbol = table.symbols[row.usize()]
                    return symbol.arity_max == SYMBOL_INDEX_ROW_NONE if symbol.name == name and symbol.kind == SymbolKind.Func
                    row <- table.symbol_name_next[row.usize()]
                return false

        def nca_selected_variadic(file: Ast::File&, name: sview @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if not forwarding_callee_is_variadic(table, name, SYMBOL_INDEX_ROW_NONE)
                return false if semantic_possible_import_name_visible(table, name, table.current_module)
                selected: mutable u32 = SYMBOL_INDEX_ROW_NONE
                selected_rank: mutable usize = 0
                ambiguous: mutable bool = false
                row: mutable u32 = symbol_chain_head(table, name)
                while row != SYMBOL_INDEX_ROW_NONE:
                    symbol: Symbol = table.symbols[row.usize()]
                    if symbol.name == name and symbol.kind == SymbolKind.Func:
                        local: bool = ewr_module_is_lexical_ancestor(symbol.module_owner, table.current_module)
                        imported: (visible: bool, scope_length: usize) = ewr_imported_callable_scope(table.definite_import_annotations, name, symbol.module_owner, table.current_module) if not local else (false, 0.usize())
                        if local or imported.visible:
                            branch: (known: bool, active: bool) = pma_static_if_function_branch_selection(file, name, symbol, table, 0)
                            return false if not branch.known
                            if branch.active:
                                rank: usize = ewr_local_scope_rank(symbol.module_owner, table.current_module) if local else imported.scope_length
                                if selected == SYMBOL_INDEX_ROW_NONE or rank > selected_rank:
                                    selected <- row
                                    selected_rank <- rank
                                    ambiguous <- false
                                elif rank == selected_rank:
                                    previous: Symbol = table.symbols[selected.usize()]
                                    ambiguous <- true if previous.module_owner != symbol.module_owner
                                    selected <- row if previous.module_owner == symbol.module_owner and symbol.offset < previous.offset
                    row <- table.symbol_name_next[row.usize()]
                return false if selected == SYMBOL_INDEX_ROW_NONE or ambiguous
                winner: Symbol = table.symbols[selected.usize()]
                return false if not ewr_callable_name_visible(table.protocol_annotations, name, winner.module_owner, table.current_module, winner.line, winner.offset)
                return winner.arity_max == SYMBOL_INDEX_ROW_NONE
