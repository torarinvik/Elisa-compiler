extend Semantic:
    private:
        def zeroed_collect_qualified_type_path(expression: Ast::Expr, names: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        names.push(name)
                        return true
                    Expr.Scope(base, name, _):
                        return false if not zeroed_collect_qualified_type_path(base, names)
                        names.push(name)
                        return true
                    _:
                        return false

        # Resolve storage-transparent wrappers and aliases once for every zero-validity
        # classifier. Optionality is preserved as the final expression so callers can
        # distinguish a valid absent value from an invalid non-null payload.
        # Zeroed type expansion must use the same analyzer-wide registration order as
        # possible-import and TypePath lookup; retaining a local comparator here risks
        # selecting a different module alias winner.
        def zeroed_alias_registration_precedes(left_index: usize, right_index: usize, table: SymbolTable&) -> (known: bool, precedes: bool):
            can Abort.Panic:
                return (false, false) if left_index >= table.protocol_annotations.count or right_index >= table.protocol_annotations.count
                left_alias: Ast::EnumAnnotation = table.protocol_annotations[left_index]
                right_alias: Ast::EnumAnnotation = table.protocol_annotations[right_index]
                return semantic_possible_import_alias_precedes(left_alias, right_alias, table)

        # Pair metadata by source offset as well as line; malformed/duplicate rows fail
        # closed. Possible aliases matter only when Core's registration order could select
        # them ahead of the definite winner.
        # Return the transformed borrowed descriptor by value, rather than taking
        # overlapping input and mutable-output arguments. No raw view fabrication.
        def zeroed_expand_using_module_path(module_path: mutable darray[sview]&, current_owner: sview, table: SymbolTable&, invalid: mutable bool&) -> sview:
            can Memory.Allocate, Abort.Panic:
                owner: mutable sview = current_owner
                steps: mutable usize = 0
                while steps <= 256.usize() |module_path, owner, table, invalid, steps|:
                    return owner if module_path.count == 0
                    # Only registered definite or possible aliases can affect this head.
                    # Most qualified paths are concrete modules, so avoid scanning all
                    # protocol annotations when neither registration set names it.
                    registered: mutable bool = false
                    for row in table.definite_import_annotations |registered, module_path|:
                        if row.name == "__using_alias" and row.owner == module_path[0]:
                            registered <- true
                            break
                    if not registered:
                        for row in table.possible_import_annotations |registered, module_path|:
                            if row.name == "__using_alias" and row.owner == module_path[0]:
                                registered <- true
                                break
                    return owner if not registered
                    selected_target: mutable sview = ""
                    selected_owner: mutable sview = owner
                    selected_order_index: mutable usize = 4294967295.usize()
                    selected_found: mutable bool = false
                    selected_ambiguous: mutable bool = false
                    selected_target_invalid: mutable bool = false
                    for alias_index in 0..<table.protocol_annotations.count |module_path, table, selected_target, selected_owner, selected_order_index, selected_found, selected_target_invalid|:
                        alias: Ast::EnumAnnotation = table.protocol_annotations[alias_index]
                        continue if alias.name != "__using_alias" or alias.owner != module_path[0]
                        is_definite: mutable bool = false
                        for row in table.definite_import_annotations |alias, is_definite|:
                            is_definite <- true if row.name == "__using_alias" and row.owner == alias.owner and row.module == alias.module and row.line == alias.line and row.offset == alias.offset
                        continue if not is_definite
                        target: mutable sview = ""
                        target_matches: mutable usize = 0.usize()
                        for target_row in table.definite_import_annotations |alias, target, target_matches|:
                            if target_row.name == "__using_alias_target" and target_row.line == alias.line and target_row.offset == alias.offset and target_row.module == alias.module:
                                target <- target_row.owner
                                target_matches <- target_matches + 1.usize()
                        if not selected_found:
                            selected_target <- target if target_matches == 1.usize() else ""
                            selected_owner <- alias.module
                            selected_order_index <- alias_index
                            selected_target_invalid <- target_matches != 1.usize() or target == ""
                            selected_found <- true
                        else:
                            order: (known: bool, precedes: bool) = zeroed_alias_registration_precedes(alias_index, selected_order_index, table)
                            if order.known and order.precedes:
                                selected_target <- target if target_matches == 1.usize() else ""
                                selected_owner <- alias.module
                                selected_order_index <- alias_index
                                selected_target_invalid <- target_matches != 1.usize() or target == ""
                    for alias_index in 0..<table.protocol_annotations.count |module_path, table, selected_order_index, selected_ambiguous|:
                        alias: Ast::EnumAnnotation = table.protocol_annotations[alias_index]
                        continue if alias_index == selected_order_index or alias.name != "__using_alias" or alias.owner != module_path[0]
                        is_definite: mutable bool = false
                        for row in table.definite_import_annotations |alias, is_definite|:
                            is_definite <- true if row.name == "__using_alias" and row.owner == alias.owner and row.module == alias.module and row.line == alias.line and row.offset == alias.offset
                        continue if not is_definite
                        order: (known: bool, precedes: bool) = zeroed_alias_registration_precedes(alias_index, selected_order_index, table)
                        selected_ambiguous <- true if not order.known or order.precedes
                    possible_can_shadow: mutable bool = false
                    for alias_index in 0..<table.protocol_annotations.count |module_path, table, selected_order_index, selected_found, possible_can_shadow|:
                        alias: Ast::EnumAnnotation = table.protocol_annotations[alias_index]
                        continue if alias.name != "__using_alias" or alias.owner != module_path[0]
                        is_possible: mutable bool = false
                        for row in table.possible_import_annotations |alias, is_possible|:
                            is_possible <- true if row.name == "__using_alias" and row.owner == alias.owner and row.module == alias.module and row.line == alias.line and row.offset == alias.offset
                        continue if not is_possible
                        if not selected_found:
                            possible_can_shadow <- true
                        else:
                            order: (known: bool, precedes: bool) = zeroed_alias_registration_precedes(alias_index, selected_order_index, table)
                            possible_can_shadow <- true if not order.known or order.precedes
                    if selected_ambiguous or possible_can_shadow:
                        invalid <- true
                        return owner
                    if selected_target_invalid:
                        invalid <- true
                        return owner
                    return owner if not selected_found
                    expanded: mutable darray[sview] = []
                    start: mutable usize = 0
                    offset: mutable usize = 0
                    while offset < selected_target.len |selected_target, start, offset, expanded|:
                        if offset + 1.usize() < selected_target.len and selected_target[offset] == ':' and selected_target[offset + 1.usize()] == ':':
                            expanded.push(string_view_slice(selected_target, start.i64(), offset.i64()))
                            offset <- offset + 2.usize()
                            start <- offset
                        else:
                            offset <- offset + 1.usize()
                    expanded.push(string_view_slice(selected_target, start.i64(), selected_target.len.i64()))
                    index: mutable usize = 1
                    while index < module_path.count |index, module_path, expanded|:
                        expanded.push(module_path[index])
                        index <- index + 1.usize()
                    module_path <- module_path.truncate(0)
                    for segment in expanded |module_path|:
                        module_path.push(segment)
                    owner <- selected_owner
                    steps <- steps + 1.usize()
                invalid <- true
                return owner
