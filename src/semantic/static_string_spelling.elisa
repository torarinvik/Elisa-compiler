# Closed spellings that can participate in the static-string branch join.
module StaticStringSpelling:
    public:
        def participates_in_static_join(spelling: sview) -> bool:
            ensure when spelling:
                "lit" | "mixed" | "static u8&" -> result == true
                _ -> result == false
            return when spelling:
                "lit" | "mixed" | "static u8&" -> true
                _ -> false
