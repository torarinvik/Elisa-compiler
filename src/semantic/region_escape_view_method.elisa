# Exact receiver methods whose results alias the receiver's region-backed storage.
module SemanticRegionEscapeViewMethod:
    public:
        def is_view_method(method: sview) -> bool:
            ensure result == (
                when method:
                    "as_sview" | "as_cstr" | "as_view" | "as_slice" | "as_str" -> true
                    _ -> false
            )
            return when method:
                "as_sview" | "as_cstr" | "as_view" | "as_slice" | "as_str" -> true
                _ -> false
