# Extern-function decorator argument validation.
#  - `@intrinsic(NAME)` requires NAME to be an LLVM intrinsic — it must start with "llvm.".
#  - `@trusted` on an extern requires exactly one non-empty reason string.
# Pure syntactic over the extern's decorators and their captured argument spans.
extend Semantic:
    private:
        # Whether TEXT begins with the ASCII bytes of PREFIX.
        def sview_starts_with(text: sview, prefix: sview) -> bool:
            can Abort.Panic:
                prefix_length: usize = sview_len(prefix)
                false return if sview_len(text) < prefix_length
                index: mutable usize = 0
                matches: mutable bool = true
                while index < prefix_length |index, matches|:
                    matches <- false if text[index] != prefix[index]
                    index <- index + 1
                return matches

        def check_extern_decorator(extern_name: sview, decorators: darray[Ast::Annotation], annotation_args: darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for decorator in decorators |table| -> table:
                    is_intrinsic: bool = decorator.name == "intrinsic"
                    has_arg: bool = decorator.arg_count > 0 and decorator.arg_start.usize() < annotation_args.count
                    intrinsic_bad: bool = is_intrinsic and has_arg and not sview_starts_with(annotation_args[decorator.arg_start.usize()], "llvm.")
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IntrinsicNamePrefix, name: extern_name, line: line, expected: "", actual: ""}) if intrinsic_bad
                    trusted_bad: bool = decorator.name == "trusted" and decorator.arg_count != 1
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TrustedExternReason, name: extern_name, line: line, expected: "", actual: ""}) if trusted_bad

        def check_extern_decorators(declarations: darray[Ast::Decl], annotation_args: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Extern(extern_name, param_start, arity, variadic, callable, extern_effects, decorators, extern_line):
                            table <- check_extern_decorator(extern_name, decorators, annotation_args, extern_line, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_extern_decorators(module_body, annotation_args, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_extern_decorators(scoped_body, annotation_args, table)
                        _:
                            pass
