extend Semantic:
    private:
        def walk_region_storage_stability(statements: darray[Ast::Stmt], annotations: darray[Ast::LocalRegionAnnotation]&, function_line: u32, view_fns: darray[sview @source]&, replace_names: darray[sview @source]&, value_names: darray[sview @source]&, field_elems: darray[sview]&, field_views: darray[sview @source]&, field_view_heads: darray[Ast::Expr]&, stable_regions: mutable darray[sview @source]&, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, invalidated: mutable darray[sview @source]&, invalidated_by: mutable darray[sview @source]&, exit_marks: mutable darray[sview @source]&, exit_marks_by: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                loop_entry: mutable darray[sview @source] = []
                loop_entry_by: mutable darray[sview @source] = []
                saved_invalidated: mutable darray[sview @source] = []
                saved_invalidated_by: mutable darray[sview @source] = []
                for index in 0..<invalidated.count |saved_invalidated, saved_invalidated_by, invalidated, invalidated_by|:
                    saved_invalidated.push(invalidated[index])
                    saved_invalidated_by.push(invalidated_by[index]) if index < invalidated_by.count
                for statement in statements |stable_regions, alias_names, alias_sources, alias_is_view, invalidated, table, exit_marks, exit_marks_by, loop_entry, loop_entry_by|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            has_stable_backing: bool = kind == "region" and (destroyed_region_contains(clause, "reserve_commit") or destroyed_region_contains(clause, "fixed"))
                            stable_region: mutable sview = binding
                            # Block-form regions keep the name in clause[0] and leave the
                            # generic binding slot empty; statement-form regions do the reverse.
                            stable_region <- clause[0] if stable_region == "" and has_stable_backing and clause.count > 0
                            stable_regions.push(stable_region) if stable_region != "" and has_stable_backing and not destroyed_region_contains(stable_regions, stable_region)
                            table <- walk_region_storage_stability(body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table) can Global{Read,Write}
                            # A view handed to a task stays live until the nursery/pool joins, so
                            # growing its backing anywhere later in the body (even after the
                            # submit) races the worker's read. Re-check every submitted operand
                            # against the state at the join and report at the submit site
                            # (stage0 analyzePoolStmt JoinedViews).
                            if kind == "nursery" or kind == "pool":
                                submitted: mutable darray[Ast::Expr] = []
                                submitted_lines: mutable darray[u32] = []
                                storage_view_collect_submits(body, submitted, submitted_lines)
                                for submit_index in 0..<submitted.count |table, submitted, submitted_lines|:
                                    stale: sview = invalidated_alias_in_expression(submitted[submit_index], invalidated)
                                    table <- diagnose_invalidated_alias(submitted[submit_index], alias_names, alias_sources, invalidated, invalidated_by, submitted_lines[submit_index], table) if stale != "" and not storage_view_already_reported(stale, submitted_lines[submit_index], table)
                                    table <- storage_view_check_submit_temps(submitted[submit_index], submitted_lines[submit_index], invalidated, invalidated_by, table)
                                storage_view_drop_submit_temps(alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- diagnose_invalidated_alias(value, alias_names, alias_sources, invalidated, invalidated_by, line.line, table)
                            invalidate_growth_aliases(growth_call_target(value), growth_call_target_field(value), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            invalidate_callee_relocations(value, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table) can Global{Read,Write}
                            invalidate_moved_containers(value, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            storage_view_forget_invalidated(name, invalidated, invalidated_by)
                            storage_view_record_typed_alias(name, type_expression, value, alias_names, alias_sources, alias_is_view, view_fns) if not storage_view_owned_overload_call(value, table) and not storage_view_owned_scoped_call(value, view_fns, table)
                            storage_view_inherit_held(name, value, alias_names, alias_sources, alias_is_view)
                        Stmt.Expr(expression, line):
                            table <- diagnose_invalidated_alias(expression, alias_names, alias_sources, invalidated, invalidated_by, line.line, table)
                            invalidate_growth_aliases(growth_call_target(expression), growth_call_target_field(expression), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            invalidate_callee_relocations(expression, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table) can Global{Read,Write}
                            invalidate_moved_containers(expression, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            storage_view_record_container_store(expression, alias_names, alias_sources, alias_is_view, view_fns)
                            storage_view_record_submit_temps(expression, line.line, alias_names, alias_sources, alias_is_view, view_fns)
                            match expression:
                                Expr.Block(statements, value, captures, block_line):
                                    table <- walk_region_storage_stability(statements, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table) can Global{Read,Write}
                                _:
                                    pass
                        Stmt.Assign(target, operator, value, line):
                            invalidate_growth_aliases(growth_call_target(target), growth_call_target_field(target), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            invalidate_growth_aliases(growth_call_target(value), growth_call_target_field(value), field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            invalidate_callee_relocations(value, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table) can Global{Read,Write}
                            if operator == TokenKind.PlusEq:
                                # The analysis-only push call has `target` as its receiver;
                                # derive the same root and direct field without constructing
                                # that wrapper twice and walking it twice.
                                append_target: sview = storage_view_place_root(target)
                                append_target_field: sview = storage_view_direct_field(target)
                                invalidate_growth_aliases(append_target, append_target_field, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            rebound: sview = storage_view_rebind_target(target, operator, value, alias_names, alias_sources, alias_is_view)
                            # `<-` into a local declared with a non-reference type (`name: mutable
                            # cstr`) always rebinds it: there is no referent to write through, so a
                            # stale old value is not used (`name <- fill(storage)` after growth).
                            value_rebound: sview = storage_view_value_rebind_target(target, operator, value_names)
                            table <- diagnose_invalidated_alias(target, alias_names, alias_sources, invalidated, invalidated_by, line.line, table) if rebound == "" and value_rebound == ""
                            table <- diagnose_invalidated_alias(value, alias_names, alias_sources, invalidated, invalidated_by, line.line, table)
                            invalidate_moved_containers(value, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            storage_view_forget_invalidated(rebound, invalidated, invalidated_by) if rebound != ""
                            storage_view_forget_invalidated(value_rebound, invalidated, invalidated_by) if value_rebound != "" and rebound == ""
                            invalidate_replaced_container_views(target, operator, value, replace_names, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if rebound == ""
                            invalidate_replaced_field_views(target, operator, value, field_elems, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if rebound == ""
                            invalidate_replaced_field_element_views(target, operator, field_views, field_view_heads, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) if rebound == ""
                            # `rebind n: i64, p = p.lgrow()` lowers to `[n, p] = call`: every bare
                            # target is REPLACED by the threaded result exactly as `p <- p.lgrow()`
                            # replaces `p`, so views into the old value die (fuzz F6). The
                            # replacement helpers key on a bare Ident target; feed them each one.
                            match target:
                                Expr.Array(rebind_targets, rebind_line):
                                    for rebind_target in rebind_targets |replace_names, field_elems, field_views, field_view_heads, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by|:
                                        invalidate_replaced_container_views(rebind_target, TokenKind.LArrow, value, replace_names, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                        invalidate_replaced_field_views(rebind_target, TokenKind.LArrow, value, field_elems, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                        invalidate_replaced_field_element_views(rebind_target, TokenKind.LArrow, field_views, field_view_heads, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                        # The threaded result mentions the target (`lgrow(p)`), which
                                        # the helpers above read as "the new value still borrows it"
                                        # and skip. An lmut call may reallocate every buffer of the old
                                        # value, so drop each view of it outright.
                                        storage_view_invalidate_rebound_views(ident_name_of(rebind_target), alias_names, alias_sources, alias_is_view, invalidated, invalidated_by)
                                _:
                                    pass
                            # `<-` of a plain value into a whole local (`t <- s`, `vs <- [s]`) re-aliases
                            # it; a field/element store is not a rebind of the root. A
                            # `<-` of a view-producing CALL is left untracked: the walk cannot tell a
                            # loop body from straight-line code, and stage0 skips loop-body rebinds.
                            # A `<-` whose value takes a fresh borrow of a local or a field path
                            # (`s <- buf.as_sview()`, `c <- (&buf[0]).cast[cstr]`, `name <-
                            # bytes_view_range(p.storage, ..)`) rebinds the view onto it. A field
                            # path carries a "[field]" marker so a sibling of another element
                            # type (`p.names.push`) does not invalidate it.
                            larrow_alias: bool = operator == TokenKind.LArrow and (target is Expr.Ident(_, _)) and (value is Expr.Ident(_, _) or value is Expr.Array(_, _) or value is Expr.Tuple(_, _) or (storage_view_borrow_is_local(value) and storage_view_expr_carries_borrow(value, alias_names, alias_sources, alias_is_view)))
                            storage_view_record_alias(storage_view_place_root(target), value, alias_names, alias_sources, alias_is_view, view_fns) if operator == TokenKind.Assign or larrow_alias
                            if operator == TokenKind.Assign or operator == TokenKind.LArrow:
                                match target:
                                    Expr.Ident(target_name, _):
                                        storage_view_inherit_held(target_name, value, alias_names, alias_sources, alias_is_view)
                                    _:
                                        storage_view_record_place_store(target, value, alias_names, alias_sources, alias_is_view, view_fns)
                        Stmt.Return(value, line):
                            table <- diagnose_invalidated_alias(returned, alias_names, alias_sources, invalidated, invalidated_by, line.line, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- diagnose_invalidated_alias(condition, alias_names, alias_sources, invalidated, invalidated_by, line.line, table)
                            storage_view_bind_payload_condition(condition, alias_names, alias_sources, alias_is_view, table)
                            table <- walk_region_storage_branch(then_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table) can Global{Read,Write}
                            table <- walk_region_storage_branch(else_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table) can Global{Read,Write}
                        Stmt.While(condition, while_body, line):
                            table <- diagnose_invalidated_alias(condition, alias_names, alias_sources, invalidated, invalidated_by, line.line, table)
                            storage_view_snapshot(invalidated, invalidated_by, loop_entry, loop_entry_by)
                            loop_exit: mutable darray[sview @source] = []
                            loop_exit_by: mutable darray[sview @source] = []
                            aliases_before: usize = alias_names.count
                            table <- walk_region_storage_stability(while_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, loop_exit, loop_exit_by, table) can Global{Read,Write}
                            table <- check_storage_view_loop_back_edge(while_body, condition, true, line.line, loop_entry, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            table <- storage_view_rewalk_loop_body(while_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, aliases_before, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table) can Global{Read,Write}
                            storage_view_restore_invalidated(loop_exit, loop_exit_by, invalidated, invalidated_by)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- diagnose_invalidated_alias(iterable, alias_names, alias_sources, invalidated, invalidated_by, line.line, table)
                            invalidate_moved_containers(iterable, field_elems, function_line, line.line, annotations, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by) can Global{Read,Write}
                            storage_view_snapshot(invalidated, invalidated_by, loop_entry, loop_entry_by)
                            loop_exit: mutable darray[sview @source] = []
                            loop_exit_by: mutable darray[sview @source] = []
                            aliases_before: usize = alias_names.count
                            table <- walk_region_storage_stability(for_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, loop_exit, loop_exit_by, table) can Global{Read,Write}
                            table <- check_storage_view_loop_back_edge(for_body, iterable, false, line.line, loop_entry, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table)
                            table <- storage_view_rewalk_loop_body(for_body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, aliases_before, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, table) can Global{Read,Write}
                            storage_view_restore_invalidated(loop_exit, loop_exit_by, invalidated, invalidated_by)
                        Stmt.Match(scrutinee, arms, line):
                            table <- diagnose_invalidated_alias(scrutinee, alias_names, alias_sources, invalidated, invalidated_by, line.line, table)
                            for arm in arms |table, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by| -> table:
                                storage_view_bind_payload_pattern(arm.pattern, storage_view_place_root(scrutinee), alias_names, alias_sources, alias_is_view, table)
                                table <- walk_region_storage_branch(arm.body, annotations, function_line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table) can Global{Read,Write}
                        _:
                            pass
                storage_view_restore_invalidated(saved_invalidated, saved_invalidated_by, invalidated, invalidated_by)

        def check_region_storage_stability_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::LocalRegionAnnotation]&, view_fns: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # These are per-function scratch tables. Reuse their backing buffers while
                # walking sibling declarations instead of allocating and freeing each one
                # for every function in a large source file.
                stable_regions: mutable darray[sview @source] = []
                alias_names: mutable darray[sview @source] = []
                alias_sources: mutable darray[sview @source] = []
                alias_is_view: mutable darray[bool] = []
                invalidated: mutable darray[sview @source] = []
                invalidated_by: mutable darray[sview @source] = []
                exit_marks: mutable darray[sview @source] = []
                exit_marks_by: mutable darray[sview @source] = []
                replace_names: mutable darray[sview @source] = []
                other_names: mutable darray[sview @source] = []
                local_names: mutable darray[sview @source] = []
                local_types: mutable darray[Ast::Expr] = []
                field_candidate_names: mutable darray[sview @source] = []
                field_candidate_values: mutable darray[Ast::Expr] = []
                value_names: mutable darray[sview @source] = []
                field_views: mutable darray[sview @source] = []
                field_view_heads: mutable darray[Ast::Expr] = []
                field_elems: mutable darray[sview] = []
                for declaration in declarations |table, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, replace_names, other_names, local_names, local_types, field_candidate_names, field_candidate_values, value_names, field_views, field_view_heads, field_elems|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            stable_regions <- stable_regions.truncate(0)
                            alias_names <- alias_names.truncate(0)
                            alias_sources <- alias_sources.truncate(0)
                            alias_is_view <- alias_is_view.truncate(0)
                            invalidated <- invalidated.truncate(0)
                            invalidated_by <- invalidated_by.truncate(0)
                            exit_marks <- exit_marks.truncate(0)
                            exit_marks_by <- exit_marks_by.truncate(0)
                            replace_names <- replace_names.truncate(0)
                            other_names <- other_names.truncate(0)
                            local_names <- local_names.truncate(0)
                            local_types <- local_types.truncate(0)
                            field_candidate_names <- field_candidate_names.truncate(0)
                            field_candidate_values <- field_candidate_values.truncate(0)
                            value_names <- value_names.truncate(0)
                            field_views <- field_views.truncate(0)
                            field_view_heads <- field_view_heads.truncate(0)
                            field_elems <- field_elems.truncate(0)
                            # ("[param]", name) marker rows: a call-derived view whose origin is a
                            # borrowed PARAMETER is not tracked (see storage_view_call_origin_sources).
                            for param in params |alias_names, alias_sources, alias_is_view, replace_names, other_names, local_names, local_types|:
                                alias_names.push("[param]")
                                alias_sources.push(param.name)
                                alias_is_view.push(false)
                                if not param.is_mutable and storage_view_type_is_replaceable(param.type_expression, true):
                                    replace_names.push(param.name)
                                else:
                                    other_names.push(param.name)
                                local_names.push(param.name)
                                local_types.push(param.type_expression)
                            storage_view_collect_declarations(body, replace_names, other_names, local_names, local_types, true, field_candidate_names, field_candidate_values)
                            storage_view_drop_shadowed(replace_names, other_names)
                            storage_view_collect_value_names(local_names, local_types, value_names)
                            storage_view_resolve_field_element_views(field_candidate_names, field_candidate_values, local_names, local_types, table, field_views, field_view_heads)
                            storage_view_collect_field_elems(local_names, local_types, table, field_elems) can Global{Read,Write}
                            table <- walk_region_storage_stability(body, annotations, line.line, view_fns, replace_names, value_names, field_elems, field_views, field_view_heads, stable_regions, alias_names, alias_sources, alias_is_view, invalidated, invalidated_by, exit_marks, exit_marks_by, table) can Global{Read,Write}
                        Decl.Module(name, body, line):
                            outer_module: sview = table.storage_owned_module
                            table.storage_owned_module <- module_last_segment(name)
                            table <- check_region_storage_stability_declarations(body, annotations, view_fns, table) can Global{Read,Write}
                            table.storage_owned_module <- outer_module
                        Decl.Scoped(body, line):
                            table <- check_region_storage_stability_declarations(body, annotations, view_fns, table) can Global{Read,Write}
                        _:
                            pass

    public:
        def check_region_storage_stability(file: Ast::File&, origin_rows: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # The fixpoint rows are computed once per unit (semantic_api) and shared with
                # check_local_view_return_escape; this pass extends its own copy.
                view_fns: mutable darray[sview @source] = []
                view_fns.reserve(origin_rows.count)
                for origin_row in origin_rows |view_fns|:
                    view_fns.push(origin_row)
                table <- storage_view_index_segments(table) can Global{Read,Write}
                # `[owned-fn]` rows: functions returning a fresh borrow-free value (not view summaries).
                table <- storage_owned_fn_rows(file, &view_fns, table)
                # Complete from here on: key-sort it so per-call lookups binary-search.
                view_fns <- vro_sort_rows(view_fns)
                table <- storage_owned_index_candidates(table) can Global{Read,Write}
                table <- storage_index_ref_pos(table) can Global{Read,Write}
                # The summary lives in this call's inferred region, so each row's bytes are
                # interned into the program-region name store (semantic_joined_text.elisa),
                # whose views never move.
                growth_rows: darray[sview @source] = param_growth_rows(file, table) can Global{Read,Write}
                intern_param_growth_rows(growth_rows, table)
                table <- pgs_index_published_rows(table) can Global{Read,Write}
                table <- check_region_storage_stability_declarations(file.top_decls, file.local_region_annotations, view_fns, table) can Global{Read,Write}
