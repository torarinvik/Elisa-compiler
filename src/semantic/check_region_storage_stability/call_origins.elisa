extend Semantic:
    private:
        def storage_view_lambda_statements(statements: darray[Ast::Stmt], bound_names: mutable darray[sview @source]&, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |bound_names, alias_names, alias_sources, out|:
                    match statement:
                        Stmt.Expr(expression, line):
                            storage_view_lambda_expression(expression, bound_names, alias_names, alias_sources, out)
                        Stmt.VarDecl(name, type_expression, value, line):
                            storage_view_lambda_expression(type_expression, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                            bound_names.push(name) if name != ""
                        Stmt.Assign(target, operator, value, line):
                            if operator == TokenKind.Assign:
                                storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                                assigned_name: sview = ident_name_of(target)
                                if assigned_name != "":
                                    bound_names.push(assigned_name)
                                else:
                                    storage_view_lambda_expression(target, bound_names, alias_names, alias_sources, out)
                            else:
                                storage_view_lambda_expression(target, bound_names, alias_names, alias_sources, out)
                                storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                        Stmt.Block(kind, clause, binding, body, line):
                            mark: usize = bound_names.count
                            bound_names.push(binding) if binding != ""
                            storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(mark) if bound_names.count > mark
                        Stmt.If(condition, then_body, else_body, line):
                            storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                            then_mark: usize = bound_names.count
                            storage_view_lambda_bind_condition(condition, bound_names)
                            storage_view_lambda_statements(then_body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(then_mark) if bound_names.count > then_mark
                            else_mark: usize = bound_names.count
                            storage_view_lambda_statements(else_body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(else_mark) if bound_names.count > else_mark
                        Stmt.While(condition, body, line):
                            storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                            loop_mark: usize = bound_names.count
                            storage_view_lambda_bind_condition(condition, bound_names)
                            storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(loop_mark) if bound_names.count > loop_mark
                        Stmt.For(bind, variables, iterable, body, line):
                            storage_view_lambda_expression(iterable, bound_names, alias_names, alias_sources, out)
                            loop_mark: usize = bound_names.count
                            for variable in variables |bound_names|:
                                bound_names.push(variable) if variable != ""
                            storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(loop_mark) if bound_names.count > loop_mark
                        Stmt.Return(value, line):
                            if value is returned:
                                storage_view_lambda_expression(returned, bound_names, alias_names, alias_sources, out)
                        Stmt.Match(scrutinee, arms, line):
                            storage_view_lambda_expression(scrutinee, bound_names, alias_names, alias_sources, out)
                            for arm in arms |bound_names, alias_names, alias_sources, out|:
                                arm_mark: usize = bound_names.count
                                storage_view_lambda_bind_pattern(arm.pattern, bound_names, alias_names, alias_sources, out)
                                storage_view_lambda_expression(arm.guard, bound_names, alias_names, alias_sources, out)
                                storage_view_lambda_statements(arm.body, bound_names, alias_names, alias_sources, out)
                                bound_names <- bound_names.truncate(arm_mark) if bound_names.count > arm_mark
                        Stmt.Contract(kind, expression, line):
                            storage_view_lambda_expression(expression, bound_names, alias_names, alias_sources, out)
                        _:
                            pass

        def storage_view_lambda_expression(expression: Ast::Expr, bound_names: mutable darray[sview @source]&, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        storage_view_lambda_capture_name(name, bound_names, alias_names, alias_sources, out)
                    Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Expr.Ident(callable_name, callable_line):
                                # A bare declaration call does not capture a value. A local
                                # callable can carry storage only when it has an alias row.
                                if any alias_name in alias_names where alias_name == callable_name:
                                    storage_view_lambda_capture_name(callable_name, bound_names, alias_names, alias_sources, out)
                            _:
                                storage_view_lambda_expression(callee, bound_names, alias_names, alias_sources, out)
                        for argument in arguments |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(argument, bound_names, alias_names, alias_sources, out)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        storage_view_lambda_expression(effect_type, bound_names, alias_names, alias_sources, out)
                        for argument in arguments |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(argument, bound_names, alias_names, alias_sources, out)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                    Expr.Index(object, index, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(index, bound_names, alias_names, alias_sources, out)
                    Expr.Slice(object, low, high, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(low, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(high, bound_names, alias_names, alias_sources, out)
                    Expr.IndexN(object, arguments, line):
                        storage_view_lambda_expression(object, bound_names, alias_names, alias_sources, out)
                        for argument in arguments |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(argument, bound_names, alias_names, alias_sources, out)
                    Expr.Binary(left, operator, right, line):
                        storage_view_lambda_expression(left, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(right, bound_names, alias_names, alias_sources, out)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line) | Expr.RegionNew(operand, _, line):
                        storage_view_lambda_expression(operand, bound_names, alias_names, alias_sources, out)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(element, bound_names, alias_names, alias_sources, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(entry.key, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_expression(entry.value, bound_names, alias_names, alias_sources, out)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        storage_view_lambda_expression(type_expression, bound_names, alias_names, alias_sources, out)
                        for field in fields |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_expression(field.value, bound_names, alias_names, alias_sources, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                        then_mark: usize = bound_names.count
                        storage_view_lambda_bind_condition(condition, bound_names)
                        storage_view_lambda_expression(then_value, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(then_mark) if bound_names.count > then_mark
                        else_mark: usize = bound_names.count
                        storage_view_lambda_expression(else_value, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(else_mark) if bound_names.count > else_mark
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        storage_view_lambda_expression(scrutinee, bound_names, alias_names, alias_sources, out)
                        for arm in arms |bound_names, alias_names, alias_sources, out|:
                            arm_mark: usize = bound_names.count
                            storage_view_lambda_bind_pattern(arm.pattern, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_expression(arm.guard, bound_names, alias_names, alias_sources, out)
                            storage_view_lambda_statements(arm.body, bound_names, alias_names, alias_sources, out)
                            bound_names <- bound_names.truncate(arm_mark) if bound_names.count > arm_mark
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        storage_view_lambda_expression(iterable, bound_names, alias_names, alias_sources, out)
                        comp_mark: usize = bound_names.count
                        bound_names.push(variable) if variable != ""
                        storage_view_lambda_expression(condition, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(body, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(comp_mark) if bound_names.count > comp_mark
                    Expr.Refinement(base, predicate, line):
                        storage_view_lambda_expression(base, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(predicate, bound_names, alias_names, alias_sources, out)
                    Expr.GetElse(guarded, recovery, line):
                        storage_view_lambda_expression(guarded, bound_names, alias_names, alias_sources, out)
                        recovery_mark: usize = bound_names.count
                        storage_view_lambda_statements(recovery, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(recovery_mark) if bound_names.count > recovery_mark
                    Expr.Lambda(parameters, body, line):
                        lambda_mark: usize = bound_names.count
                        for parameter in parameters |bound_names|:
                            bound_names.push(parameter) if parameter != ""
                        storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(lambda_mark) if bound_names.count > lambda_mark
                    Expr.Block(statements, value, captures, line):
                        block_mark: usize = bound_names.count
                        for capture in captures |bound_names, alias_names, alias_sources, out|:
                            storage_view_lambda_capture_name(capture, bound_names, alias_names, alias_sources, out)
                            bound_names.push(capture) if capture != ""
                        storage_view_lambda_statements(statements, bound_names, alias_names, alias_sources, out)
                        storage_view_lambda_expression(value, bound_names, alias_names, alias_sources, out)
                        bound_names <- bound_names.truncate(block_mark) if bound_names.count > block_mark
                    _:
                        pass

        # The call's sources through the callee's return-origin rows: an "into" origin depends on
        # the argument place itself, a "carry" origin on what the argument already borrows, and
        # a thread handle on every argument. Receiver form `h.name()` passes `h` as parameter 0;
        # the static form `T.name(x)` passes no receiver. Unknown or unsummarised: no sources.
        def storage_view_call_origin_sources(callee: Ast::Expr, arguments: darray[Ast::Expr]&, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                name: mutable sview = ident_name_of(callee)
                receiver: mutable Ast::Expr? = null
                shift: mutable usize = 0
                if name == "":
                    match callee:
                        Expr.Field(object, method, field_line):
                            if vro_status(view_fns, method, arguments.count + 1) != 0:
                                name <- method
                                receiver <- object
                                shift <- 1
                            elif vro_status(view_fns, method, arguments.count) != 0:
                                name <- method
                        _:
                            pass
                arity: usize = arguments.count + shift
                return if vro_status(view_fns, name, arity) != 1
                arity_tag: sview = vro_tag(arity)
                row: mutable usize = vro_scan_start(view_fns, name, arity_tag)
                while vro_scan_live(view_fns, row, name, arity_tag) |row, alias_names, alias_sources, alias_is_view, out|:
                    if view_fns[row] == name and view_fns[row + 1] == arity_tag:
                        mode: sview = view_fns[row + 3]
                        if mode == "thread":
                            if receiver is receiver_expression:
                                storage_view_collect_sources(receiver_expression, alias_names, alias_sources, alias_is_view, view_fns, out)
                            for argument in arguments |alias_names, alias_sources, alias_is_view, out|:
                                storage_view_collect_sources(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                        elif mode == "into" or mode == "carry":
                            position: mutable usize = 16
                            for candidate in 0..<16 |position, view_fns, row|:
                                position <- candidate if vro_tag(candidate) == view_fns[row + 2]
                            if position < arity:
                                plain_argument: Ast::Expr? = receiver if shift == 1 and position == 0 else arguments[position - shift]
                                if plain_argument is origin_argument:
                                    # A view a callee derives from a borrowed PARAMETER's storage is tracked
                                    # like a local's: growing that parameter in this frame relocates the
                                    # caller's buffer (stage0 rejects the same shape).
                                    # `return bytes_view_range(p.buf, ..)` views FIELD buf of the argument:
                                    # key it on that field so a sibling's growth stays harmless.
                                    field_name: sview = view_fns[row + 4]
                                    if field_name != "":
                                        # Evaluate the virtual Field directly: its place root is
                                        # the object's root, and its carried sources are the
                                        # object's sources. No packed AST allocation is needed.
                                        object: Ast::Expr = vro_strip_borrow(origin_argument)
                                        if mode == "into":
                                            root: sview = storage_view_place_root(object)
                                            storage_view_push_source(root, out) if root != ""
                                        storage_view_collect_sources(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                                    elif mode == "into":
                                        storage_view_sources_from_argument(origin_argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                                    else:
                                        storage_view_collect_sources(origin_argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                    row <- row + vro_row()

        def storage_view_collect_sources(expression: Ast::Expr, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&, view_fns: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        # A container's "[held]" rows (views stored INTO it) are not inherited by a
                        # copy of the container's place: they describe its elements, not its buffer.
                        for alias_index in 0..<alias_names.count |alias_names, alias_sources, name, out|:
                            held_row: bool = alias_index > 0 and alias_names[alias_index - 1] == name and alias_sources[alias_index - 1] == "[held]"
                            storage_view_push_source(alias_sources[alias_index], out) if alias_names[alias_index] == name and alias_index < alias_sources.count and not held_row and alias_sources[alias_index] != "[held]"
                    Expr.Paren(inner, line) | Expr.Move(inner, line):
                        storage_view_collect_sources(inner, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Unary(operator, operand, line):
                        borrowed_place: sview = interior_reference_place(operand) if operator == TokenKind.Ampersand else ""
                        storage_view_push_source(borrowed_place, out) if borrowed_place != ""
                        # `&r[0]` through a container reference `r = &b.items` also depends on
                        # what `r` borrows: growing `b.items` relocates the buffer `r` names.
                        if borrowed_place != "":
                            for alias_index in 0..<alias_names.count |alias_names, alias_sources, borrowed_place, out|:
                                storage_view_push_source(alias_sources[alias_index], out) if alias_names[alias_index] == borrowed_place and alias_index < alias_sources.count
                        storage_view_collect_sources(operand, alias_names, alias_sources, alias_is_view, view_fns, out) if borrowed_place == ""
                    Expr.Call(callee, arguments, argument_names, line):
                        called: sview = ident_name_of(callee)
                        # An enum payload holds its arguments by value: `Tok.Word(buf.as_sview())`
                        # carries the view, so it depends on what the view borrows (stage0:
                        # isEnumVariantConstructorCall).
                        if enum_variant_callee(callee):
                            for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                                storage_view_collect_sources(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                        # Match Stage0's explicit borrowed-storage contracts. Do not infer
                        # backing from every sview-returning user function: helpers such as
                        # Lexer.text_or_empty borrow the source argument, not every mutable
                        # parser argument supplied to the helper.
                        returns_view: bool = called in {"arena_dict_get", "arena_dict_get_mut", "arena_dict_get_cstr_view", "arena_dict_get_cstr_view_mut", "bytes_view", "bytes_view_range", "bytes_view_range_ref", "sview", "string_view_slice", "string_view_prefix", "string_view_suffix", "darray_view", "arena_da_view", "readonly", "arena_da_view_slice", "arena_da_view_prefix", "arena_da_view_suffix", "slice", "read_view", "split"}
                        if returns_view:
                            for argument in arguments |alias_names, alias_sources, alias_is_view, view_fns, out|:
                                storage_view_sources_from_argument(argument, alias_names, alias_sources, alias_is_view, view_fns, out)
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                # `m.get(k)` / `m.get_mut(k)` on a dict yield a reference into the
                                # bucket array, which an insert may rehash (stage0
                                # storageViewOriginsOfExpr arena_dict_get*).
                                is_view_method: bool = method == "view" or method == "as_sview" or method == "as_cstr" or ((method == "get" or method == "get_mut") and arguments.count == 1)
                                storage_view_sources_from_argument(receiver, alias_names, alias_sources, alias_is_view, view_fns, out) if is_view_method
                            _:
                                pass
                        # A user function whose result borrows from its parameters (stage0
                        # storageViewDependencyForUserCall): see view_return_origins.elisa.
                        storage_view_call_origin_sources(callee, arguments, alias_names, alias_sources, alias_is_view, view_fns, out) if not returns_view and not enum_variant_callee(callee)
                    Expr.Comprehension(variable, iterable, condition, body, line, _):
                        # Every element is a value of BODY: `[buf.as_sview() for i in r]` holds views of buf.
                        storage_view_collect_sources(body, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Slice(object, start, end, line):
                        storage_view_sources_from_argument(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Field(object, field, line) | Expr.Index(object, index, line) | Expr.IndexN(object, indices, line):
                        storage_view_collect_sources(object, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.If(condition, then_value, else_value, line):
                        storage_view_collect_sources(then_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                        storage_view_collect_sources(else_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Tuple(elements, line) | Expr.Array(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(element, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.DictLit(entries, line):
                        for entry in entries |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(entry.key, alias_names, alias_sources, alias_is_view, view_fns, out)
                            storage_view_collect_sources(entry.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.RecordUpdate(base, fields, line):
                        storage_view_collect_sources(base, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for field in fields |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            storage_view_collect_sources(field.value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Block(statements, value, captures, line):
                        for statement in statements |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                        storage_view_collect_sources(value, alias_names, alias_sources, alias_is_view, view_fns, out)
                    Expr.Match(scrutinee, arms, line):
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            for statement in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                            # The arm's value is its trailing expression (`v: sview = match n: 1: buf.as_sview()`).
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(arm_value, arm_value_line):
                                        storage_view_collect_sources(arm_value, alias_names, alias_sources, alias_is_view, view_fns, out)
                                    _:
                                        pass
                    Expr.Catch(guarded, arms, line):
                        storage_view_collect_sources(guarded, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for arm in arms |alias_names, alias_sources, alias_is_view, view_fns, out|:
                            for statement in arm.body |alias_names, alias_sources, alias_is_view, view_fns|:
                                storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                    Expr.GetElse(guarded, recovery, line):
                        storage_view_collect_sources(guarded, alias_names, alias_sources, alias_is_view, view_fns, out)
                        for statement in recovery |alias_names, alias_sources, alias_is_view, view_fns|:
                            storage_view_collect_statement(statement, alias_names, alias_sources, alias_is_view, view_fns)
                    Expr.Lambda(parameters, body, line):
                        bound_names: mutable darray[sview @source] = []
                        for parameter in parameters |bound_names|:
                            bound_names.push(parameter) if parameter != ""
                        storage_view_lambda_statements(body, bound_names, alias_names, alias_sources, out)
                    _:
                        pass

        def growth_call_target(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(callee, arguments, argument_names, line):
                    match callee:
                        Expr.Field(receiver, method, field_line):
                            root: sview = storage_view_place_root(receiver)
                            return root if method in {"push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop", "as_cstr", "put", "put_checked", "put_or_panic", "get_or_insert", "get_or_insert_with"} else ""
                        Expr.Ident(method, ident_line):
                            if method in {"darray_push", "darray_extend", "darray_append", "darray_append_many", "darray_insert", "darray_reserve", "darray_resize", "darray_clear", "darray_truncate", "darray_pop", "arena_dict_put", "arena_dict_put_checked", "arena_dict_put_or_panic", "arena_dict_get_or_insert", "arena_dict_reserve", "push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop"} and arguments.count > 0:
                                return storage_view_place_root(arguments[0])
                        _:
                            pass
                _:
                    pass
            return ""

        # The direct field `f` of a growth receiver `root.f` (`p.lines.push(x)`), or "".
        def growth_call_target_field(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Call(callee, arguments, argument_names, line):
                    match callee:
                        Expr.Field(receiver, method, field_line):
                            return storage_view_direct_field(receiver) if method in {"push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop", "as_cstr", "put", "put_checked", "put_or_panic", "get_or_insert", "get_or_insert_with"} else ""
                        Expr.Ident(method, ident_line):
                            if method in {"darray_push", "darray_extend", "darray_append", "darray_append_many", "darray_insert", "darray_reserve", "darray_resize", "darray_clear", "darray_truncate", "darray_pop", "arena_dict_put", "arena_dict_put_checked", "arena_dict_put_or_panic", "arena_dict_get_or_insert", "arena_dict_reserve", "push", "extend", "append", "append_many", "insert", "reserve", "resize", "clear", "truncate", "pop"} and arguments.count > 0:
                                return storage_view_direct_field(arguments[0])
                        _:
                            pass
                _:
                    pass
            return ""

        # `f` when PLACE is exactly `root.f` (through parens, `move` and `&`), else "".
        def storage_view_direct_field(place: Ast::Expr) -> sview:
            match place:
                Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Unary(TokenKind.Ampersand, inner, _):
                    return storage_view_direct_field(inner)
                Expr.Field(object, field, _):
                    return field if object is Expr.Ident(_, _) else ""
                _:
                    return ""

        # Field-path keys. Rows key on the root, so a view of `p.storage` is preceded by a
        # ("[field]", "storage") marker row when every mention of `p` in its value goes through
        # that one field. Growth through a sibling `p.lines` spares the view only when both
        # fields are darrays of DIFFERENT concrete element types: same-typed siblings may share
        # a buffer after a shallow copy (`P{storage: buf, lines: buf}`), so they still overlap
        # (stage0 storageViewSiblingSpare).
        def storage_view_row_spared(index: usize, target: sview, target_field: sview, field_elems: darray[sview]&, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&) -> bool:
            can Abort.Panic:
                return false if:
                    target_field == "" or index == 0 or index >= alias_sources.count or alias_sources[index] != target
                    alias_names[index - 1] != "[field]"
                view_field: sview = alias_sources[index - 1]
                return false if view_field == target_field
                target_elem: sview = storage_view_field_elem(target, target_field, field_elems)
                view_elem: sview = storage_view_field_elem(target, view_field, field_elems)
                return target_elem != "" and view_elem != "" and target_elem != view_elem

        def storage_view_field_elem(root: sview, field: sview, field_elems: darray[sview]&) -> sview:
            can Abort.Panic:
                index: mutable usize = 0
                while index + 2 < field_elems.count |index, field_elems, root, field|:
                    return field_elems[index + 2] if field_elems[index] == root and field_elems[index + 1] == field
                    index <- index + 3
                return ""

        # The single field through which VALUE mentions ROOT: "" when it never does, "[bare]"
        # when it mentions ROOT whole, through two different fields, through a known alias, or
        # in a shape this walk does not model.
        # A summarised call whose result views exactly one argument THROUGH a field
        # (`name(&h)` returning `bytes_view_range(self.buf, ..)`) is spelled as that field path
        # (`h.buf`) for field-origin keying, so growing a sibling field keeps the view.
        def storage_view_call_field_value(value: Ast::Expr, view_fns: darray[sview @source]&) -> StorageViewOriginProjection:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Paren(inner, _):
                        return storage_view_call_field_value(inner, view_fns)
                    Expr.Call(callee, arguments, _, _):
                        into_arguments: darray[Ast::Expr] = vro_origin_arguments(callee, arguments, view_fns, false)
                        carry_arguments: darray[Ast::Expr] = vro_origin_arguments(callee, arguments, view_fns, true)
                        if into_arguments.count + carry_arguments.count > 0:
                            into_fields: darray[sview @source] = vro_origin_fields(callee, arguments, view_fns, false)
                            carry_fields: darray[sview @source] = vro_origin_fields(callee, arguments, view_fns, true)
                            if into_fields.count == into_arguments.count and carry_fields.count == carry_arguments.count:
                                return StorageViewOriginProjection{value: value, into_arguments: into_arguments, carry_arguments: carry_arguments, into_fields: into_fields, carry_fields: carry_fields, projected: true}
                    _:
                        pass
                return StorageViewOriginProjection{value: value, into_arguments: [], carry_arguments: [], into_fields: [], carry_fields: [], projected: false}

        # Evaluate the same field-origin walk that a synthetic Field would receive.
        def storage_view_projected_field_origins(argument: Ast::Expr, field: sview @source, root: sview, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if field == "":
                    storage_view_field_origins(argument, root, alias_names, alias_sources, out)
                    return
                object: Ast::Expr = vro_strip_borrow(argument)
                match object:
                    Expr.Ident(name, _):
                        if name == root:
                            storage_view_add_origin(field, out)
                        elif any alias in alias_names where alias == name:
                            storage_view_add_origin("[bare]", out)
                    _:
                        storage_view_field_origins(object, root, alias_names, alias_sources, out)

        def storage_view_projected_origins(projection: StorageViewOriginProjection&, root: sview, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if not projection.projected:
                    storage_view_field_origins(projection.value, root, alias_names, alias_sources, out)
                    return
                # Multiple origins previously used Call(Ident(""), origins): retain the
                # empty callee's exact behavior, including unusual empty-name alias rows.
                if projection.into_arguments.count + projection.carry_arguments.count > 1:
                    if root == "":
                        storage_view_add_origin("[bare]", out)
                    else:
                        known: mutable bool = false
                        found: mutable bool = false
                        for i in 0..<alias_names.count |known, found, out, root, alias_names, alias_sources|:
                            if alias_names[i] == "":
                                known <- true
                                if alias_sources[i] == root:
                                    found <- true
                                    storage_view_add_origin(alias_sources[i - 1] if i > 0 and alias_names[i - 1] == "[field]" else "[bare]", out)
                        storage_view_add_origin("[bare]", out) if known and not found
                for index in 0..<projection.into_arguments.count |out, projection, root, alias_names, alias_sources|:
                    storage_view_projected_field_origins(projection.into_arguments[index], projection.into_fields[index], root, alias_names, alias_sources, out)
                for index in 0..<projection.carry_arguments.count |out, projection, root, alias_names, alias_sources|:
                    storage_view_projected_field_origins(projection.carry_arguments[index], projection.carry_fields[index], root, alias_names, alias_sources, out)

        # One (marker, alias) row pair per field through which VALUE mentions SOURCE, or a single
        # unmarked (whole-root) row. A view of `p.a` or `p.b` is two marked rows; growth or
        # replacement kills it when ANY of its rows is not spared, so this is exact, not wider.
        def storage_view_push_origin_rows(origin_value: StorageViewOriginProjection, name: sview @source, source: sview @source, is_view: bool, alias_names: mutable darray[sview @source]&, alias_sources: mutable darray[sview @source]&, alias_is_view: mutable darray[bool]&) -> void:
            can Memory.Allocate, Abort.Panic:
                origins: mutable darray[sview @source] = []
                storage_view_projected_origins(&origin_value, source, alias_names, alias_sources, origins)
                whole: bool = origins.count == 0 or any origin in origins where origin == "[bare]"
                if whole:
                    alias_names.push(name)
                    alias_sources.push(source)
                    alias_is_view.push(is_view)
                    return
                for origin in origins |alias_names, alias_sources, alias_is_view, name, source, is_view|:
                    alias_names.push("[field]")
                    alias_sources.push(origin)
                    alias_is_view.push(false)
                    alias_names.push(name)
                    alias_sources.push(source)
                    alias_is_view.push(is_view)

        def storage_view_add_origin(origin: sview @source, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if origin == "" or any existing in out where existing == origin
                out.push(origin)

        # Every field through which VALUE mentions ROOT ("[bare]" for a whole-root mention or a
        # shape the walk does not model); nothing when it never mentions ROOT. An alias
        # contributes the fields of its own rows against ROOT.
        def storage_view_field_origins(value: Ast::Expr, root: sview, alias_names: darray[sview @source]&, alias_sources: darray[sview @source]&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Absent:
                        pass
                    Expr.Ident(name, _):
                        if name == root:
                            storage_view_add_origin("[bare]", out)
                        else:
                            known: mutable bool = false
                            found: mutable bool = false
                            for i in 0..<alias_names.count |known, found, out, name, root, alias_names, alias_sources|:
                                if alias_names[i] == name:
                                    known <- true
                                    if alias_sources[i] == root:
                                        found <- true
                                        storage_view_add_origin(alias_sources[i - 1] if i > 0 and alias_names[i - 1] == "[field]" else "[bare]", out)
                            storage_view_add_origin("[bare]", out) if known and not found
                    Expr.Field(object, field, _):
                        match object:
                            Expr.Ident(name, _):
                                if name == root:
                                    storage_view_add_origin(field, out)
                                elif any alias in alias_names where alias == name:
                                    storage_view_add_origin("[bare]", out)
                            _:
                                storage_view_field_origins(object, root, alias_names, alias_sources, out)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Unary(_, inner, _):
                        storage_view_field_origins(inner, root, alias_names, alias_sources, out)
                    Expr.Binary(left, _, right, _):
                        storage_view_field_origins(left, root, alias_names, alias_sources, out)
                        storage_view_field_origins(right, root, alias_names, alias_sources, out)
                    Expr.Index(object, index, _):
                        storage_view_field_origins(object, root, alias_names, alias_sources, out)
                        storage_view_field_origins(index, root, alias_names, alias_sources, out)
                    Expr.Call(callee, arguments, _, _):
                        storage_view_field_origins(callee, root, alias_names, alias_sources, out)
                        for argument in arguments |out, root, alias_names, alias_sources|:
                            storage_view_field_origins(argument, root, alias_names, alias_sources, out)
                    _:
                        storage_view_add_origin("[bare]", out)

        # (root, field, element key) triples for every local or param whose declared struct
        # type is unambiguous, over each darray field with a concrete element type.
        def storage_view_collect_field_elems(local_names: darray[sview @source]&, local_types: darray[Ast::Expr]&, table: SymbolTable&, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                # Each local links to the previous local with the same name hash, so the
                # first-occurrence test and the ambiguity scan touch only same-hash locals.
                previous_heads: mutable dict[u64, u32] = {}
                previous_rows: mutable darray[u32] = []
                for index in 0..<local_names.count |local_names, previous_heads, previous_rows|:
                    hash: u64 = name_hash(local_names[index])
                    previous: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    if previous_heads.get(hash) is head:
                        previous <- head
                    previous_rows.push(previous)
                    previous_heads <- previous_heads.put(hash, index.u32()) can Global{Read,Write}
                for index in 0..<local_names.count |local_names, local_types, table, out, previous_heads, previous_rows|:
                    root: sview = local_names[index]
                    seen: mutable bool = false
                    earlier: mutable u32 = previous_rows[index]
                    while earlier != SYMBOL_INDEX_ROW_NONE and not seen |seen, earlier, local_names, previous_rows, root|:
                        seen <- true if local_names[earlier.usize()] == root
                        earlier <- previous_rows[earlier.usize()]
                    continue if seen
                    owner: mutable sview = ""
                    ambiguous: mutable bool = false
                    other_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    if previous_heads.get(name_hash(root)) is root_head:
                        other_row <- root_head
                    while other_row != SYMBOL_INDEX_ROW_NONE |other_row, owner, ambiguous, local_names, local_types, previous_rows, root|:
                        other: usize = other_row.usize()
                        if local_names[other] == root and other < local_types.count:
                            declared: sview = storage_view_declared_type_name(local_types[other])
                            ambiguous <- true if declared == "" or (owner != "" and owner != declared)
                            owner <- declared
                        other_row <- previous_rows[other]
                    continue if owner == "" or ambiguous
                    row_id: mutable u32 = struct_field_owner_head(table, owner)
                    while row_id != SYMBOL_INDEX_ROW_NONE |row_id, out, table, owner, root|:
                        row: usize = row_id.usize()
                        if table.struct_field_owner[row] == owner and row < table.struct_field_type_id.count and row < table.struct_field_name.count:
                            interned_elem_key: sview = storage_view_concrete_darray_elem(table.struct_field_type_id[row], table)
                            elem: sview = storage_view_qualified_darray_elem(table.private_field_types[row], table) if interned_elem_key == "" and row < table.private_field_types.count else interned_elem_key
                            if elem != "":
                                out.push(root)
                                out.push(table.struct_field_name[row])
                                out.push(elem)
                        row_id <- table.struct_field_owner_next[row]

        # The element of a `darray[E]` field type when E is a builtin scalar/string type or a
        # declared struct or non-generic enum, else "". Named rows key on their last `::` segment, so two structs
        # sharing a name compare equal: a collision only costs precision.
        def storage_view_concrete_darray_elem(type_id: u32, table: SymbolTable&) -> sview:
            can Abort.Panic:
                current: mutable u32 = type_id
                while current != 0 and interned_kind(current, table) == SemTypeKind.Ref |current, table|:
                    current <- interned_elem(current, 0, table)
                return "" if current == 0 or interned_kind(current, table) != SemTypeKind.Container or interned_name(current, table) != "darray" or interned_elem_count(current, table) != 1
                elem: u32 = interned_elem(current, 0, table)
                kind: SemTypeKind = interned_kind(elem, table)
                return interned_name(elem, table) if kind == SemTypeKind.Int or kind == SemTypeKind.Float or kind == SemTypeKind.Bool or kind == SemTypeKind.Char or kind == SemTypeKind.String
                return "" if kind != SemTypeKind.Named
                name: sview = storage_view_last_segment(interned_name(elem, table))
                return name if name != "" and storage_view_struct_segment_known(table, name)
                # A non-generic declared enum is as concrete as a struct: a darray of it can never
                # share a buffer with a darray[u8] (stage0 storageViewConcreteElemKey).
                return "" if name == "" or interned_elem_count(elem, table) != 0
                return name if storage_view_enum_segment_known(table, name)
                return ""
