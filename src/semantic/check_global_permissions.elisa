# Stage1 semantic — the `Global` permission family (`extend Semantic: private:`).
#
# stage0 registers Global{Read, Write} as a builtin family and INFERS it from the body:
# reading a `global` records Global.Read, storing into one records Global.Write, and a
# compound store records both. The refs union with whatever the signature declares and
# propagate to every caller, so a call to a global-touching function warns unless the call
# site carries a grant. stage0 keeps the requirement behind `-Wglobals` (implied by
# `-Wstrict`) because demanding the row everywhere would rewrite the `can` row of every
# existing program that touches a global; `enforce_global_permissions` is that same dial,
# replayed by the parity harness as a `# authority` header.
#
# Five behaviours were pinned against stage0 before this was written, and each is
# load-bearing here:
#   - a `const` is NOT a global: reading one carries no effect at all. `collect_mutable_globals`
#     already collects on Decl.Const's fourth field, which is `is_global`, not `is_mutable`
#     (see parser_types_aggregate) — so a `const` never enters `authority` and a plain
#     `global` (no `mutable`) correctly does;
#   - a `can Global.Read:` block discharges the obligation LOCALLY but still surfaces the
#     effect to callers, exactly as a `can`-wrapped panic does;
#   - `trusted` only drops Unsafe tracking. It never discharges Global access or suppresses
#     inferred Global rows; local Global access grants use `can` and still propagate upward;
#   - a plain store (`hot <- 1`) requires Global.Write ALONE; only a compound store
#     (`hot += 1`) or a right-hand side that mentions the global adds Global.Read;
#   - the requirement is TRANSITIVE: a function that merely calls a global-toucher requires
#     the same refs. That is why each axis is closed over the direct call graph below.
#
extend Semantic:
    private:
        # Resolve globals through the same module/import index as mandatory authority.
        # The effect row includes every global, while the separate authority checker
        # applies mandatory Global grants only to mutable globals.
        def gp_names_global(name: sview, authority: GlobalAuthority&, locals: darray[sview]&) -> bool:
            can Abort.Panic:
                for local in locals:
                    return false if local == name
                slot: usize = ga_resolve_global(name, authority.module_scope, false, authority)
                return slot < authority.globals.count

        def gp_expression_is_global(expression: Ast::Expr, authority: GlobalAuthority&, locals: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                slot: mutable usize = authority.globals.count
                match expression:
                    Expr.Ident(name, _):
                        return gp_names_global(name, authority, locals)
                    Expr.Scope(_, _, _):
                        return false if gp_namespace_root_is_local(expression, locals)
                        slot <- ga_global(expression, authority)
                    _:
                        pass
                return slot < authority.globals.count

        # The compound stores: `hot += 1` reads the target before writing it, `hot <- 1`
        # does not. Mirrors the parser's own isCompoundAssign, which is private to Parser.
        def gp_is_compound_assign(operator: TokenKind) -> bool:
            return when operator:
                TokenKind.PlusEq | TokenKind.MinusEq | TokenKind.StarEq | TokenKind.SlashEq | TokenKind.PercentEq | TokenKind.CaretEq | TokenKind.PipeEq | TokenKind.AmpEq | TokenKind.LShiftEq | TokenKind.RShiftEq | TokenKind.QAssign -> true
                _ -> false

        def gp_locals_copy(source: darray[sview]&, target: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for name in source |target|:
                    target.push(name)

        def gp_condition_target_bindings(expression: Ast::Expr, locals: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        locals.push(name)
                    Expr.Call(_, arguments, _, _) | Expr.Array(arguments, _):
                        for argument in arguments |locals|:
                            gp_condition_target_bindings(argument, locals)
                    Expr.Construct(_, fields, _):
                        for field in fields |locals|:
                            gp_condition_target_bindings(field.value, locals)
                    _:
                        pass

        # Match the resolver's truthy-condition bindings: both sides of `and` bind,
        # `or` only binds names present on both sides, and `is`/`as` bind their target.
        def gp_condition_bindings(condition: Ast::Expr, locals: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        gp_condition_bindings(inner, locals)
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And:
                            gp_condition_bindings(left, locals)
                            gp_condition_bindings(right, locals)
                        elif operator == TokenKind.Or:
                            left_names: mutable darray[sview] = []
                            right_names: mutable darray[sview] = []
                            gp_condition_bindings(left, left_names)
                            gp_condition_bindings(right, right_names)
                            for candidate in left_names |right_names, locals|:
                                locals.push(candidate) if any other in right_names where other == candidate
                        elif operator == TokenKind.Is or operator == TokenKind.As:
                            gp_condition_target_bindings(right, locals)
                    _:
                        pass

        # The parser stores extra comprehension/query binders in SymbolTable annotations
        # keyed by each clause's `for` token. Keep them in that expression's lexical scope;
        # the Comprehension position stays at the opener token for diagnostics.
        def gp_query_binders_add(query_scope_id: u32, table: SymbolTable&, locals: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                limit: mutable usize = table.query_binder_offsets.count
                limit <- table.query_binder_names.count if table.query_binder_names.count < limit
                for index in 0..<limit |table, locals|:
                    locals.push(table.query_binder_names[index]) if query_scope_id != 0 and Ast::query_scope_id_from_offset(table.query_binder_offsets[index]) == query_scope_id

        # Resolver's deliberately narrow filter-pattern rule: a dotted constructor call
        # with only bare identifier arguments is pattern syntax, so its argument names bind
        # instead of being value reads or calls.
        def gp_is_bare_pattern_filter(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        match callee:
                            Expr.Field(head, _, _):
                                match head:
                                    Expr.Ident(_, _):
                                        return false if arguments.count == 0
                                        for argument in arguments:
                                            match argument:
                                                Expr.Ident(_, _):
                                                    pass
                                                _:
                                                    return false
                                        return true
                                    _:
                                        pass
                            _:
                                pass
                    _:
                        pass
                return false

        # Walk condition operands with the same binder flow as the resolver: `and` exposes
        # left-side bindings to the right, `or` exposes only the intersection afterward,
        # and an `is`/`as` target is syntax that binds names rather than a value expression.
        def gp_condition_reads(condition: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        return gp_condition_reads(inner, authority, locals, table)
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And:
                            return true if gp_condition_reads(left, authority, locals, table)
                            return gp_condition_reads(right, authority, locals, table)
                        elif operator == TokenKind.Or:
                            left_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, left_locals)
                            left_reads: bool = gp_condition_reads(left, authority, left_locals, table)
                            right_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, right_locals)
                            right_reads: bool = gp_condition_reads(right, authority, right_locals, table)
                            gp_condition_bindings(condition, locals)
                            return left_reads or right_reads
                        elif operator == TokenKind.Is or operator == TokenKind.As:
                            return true if gp_expression_reads(left, authority, locals, table)
                            gp_condition_target_bindings(right, locals)
                            return false
                        else:
                            return gp_expression_reads(left, authority, locals, table) or gp_expression_reads(right, authority, locals, table)
                    _:
                        return gp_expression_reads(condition, authority, locals, table)

        def gp_filter_reads(condition: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And and gp_is_bare_pattern_filter(left):
                            gp_condition_target_bindings(left, locals)
                            return gp_condition_reads(right, authority, locals, table)
                    _:
                        pass
                if gp_is_bare_pattern_filter(condition):
                    gp_condition_target_bindings(condition, locals)
                    return false
                return gp_condition_reads(condition, authority, locals, table)

        def gp_condition_writes(condition: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        return gp_condition_writes(inner, authority, locals, table)
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And:
                            return true if gp_condition_writes(left, authority, locals, table)
                            return gp_condition_writes(right, authority, locals, table)
                        elif operator == TokenKind.Or:
                            left_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, left_locals)
                            left_writes: bool = gp_condition_writes(left, authority, left_locals, table)
                            right_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, right_locals)
                            right_writes: bool = gp_condition_writes(right, authority, right_locals, table)
                            gp_condition_bindings(condition, locals)
                            return left_writes or right_writes
                        elif operator == TokenKind.Is or operator == TokenKind.As:
                            return true if gp_expression_writes(left, authority, locals, table)
                            gp_condition_target_bindings(right, locals)
                            return false
                        else:
                            return gp_expression_writes(left, authority, locals, table) or gp_expression_writes(right, authority, locals, table)
                    _:
                        return gp_expression_writes(condition, authority, locals, table)

        def gp_filter_writes(condition: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And and gp_is_bare_pattern_filter(left):
                            gp_condition_target_bindings(left, locals)
                            return gp_condition_writes(right, authority, locals, table)
                    _:
                        pass
                if gp_is_bare_pattern_filter(condition):
                    gp_condition_target_bindings(condition, locals)
                    return false
                return gp_condition_writes(condition, authority, locals, table)

        def gp_condition_calls(condition: Ast::Expr, caller: usize, authority: GlobalAuthority&, locals: mutable darray[sview]&, out_from: mutable darray[usize]&, out_to: mutable darray[usize]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Paren(inner, _):
                        gp_condition_calls(inner, caller, authority, locals, out_from, out_to, table)
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And:
                            gp_condition_calls(left, caller, authority, locals, out_from, out_to, table)
                            gp_condition_calls(right, caller, authority, locals, out_from, out_to, table)
                        elif operator == TokenKind.Or:
                            left_locals: mutable darray[sview] = []
                            gp_call_locals_copy(locals, left_locals)
                            gp_condition_calls(left, caller, authority, left_locals, out_from, out_to, table)
                            right_locals: mutable darray[sview] = []
                            gp_call_locals_copy(locals, right_locals)
                            gp_condition_calls(right, caller, authority, right_locals, out_from, out_to, table)
                            gp_condition_bindings(condition, locals)
                        elif operator == TokenKind.Is or operator == TokenKind.As:
                            gp_expression_calls(left, caller, authority, locals, out_from, out_to, table)
                            gp_condition_target_bindings(right, locals)
                        else:
                            gp_expression_calls(left, caller, authority, locals, out_from, out_to, table)
                            gp_expression_calls(right, caller, authority, locals, out_from, out_to, table)
                    _:
                        gp_expression_calls(condition, caller, authority, locals, out_from, out_to, table)

        def gp_filter_calls(condition: Ast::Expr, caller: usize, authority: GlobalAuthority&, locals: mutable darray[sview]&, out_from: mutable darray[usize]&, out_to: mutable darray[usize]&, table: SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And and gp_is_bare_pattern_filter(left):
                            gp_condition_target_bindings(left, locals)
                            gp_condition_calls(right, caller, authority, locals, out_from, out_to, table)
                            return
                    _:
                        pass
                if gp_is_bare_pattern_filter(condition):
                    gp_condition_target_bindings(condition, locals)
                    return
                gp_condition_calls(condition, caller, authority, locals, out_from, out_to, table)

        # Whether EXPRESSION reads a global anywhere within it. The callee position is
        # walked too: a `global` holding a function value is read by calling it.
        def gp_expression_reads(expression: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, ident_line):
                        return gp_names_global(name, authority, locals)
                    Expr.Field(object, field, field_line):
                        return gp_expression_reads(object, authority, locals, table)
                    Expr.Scope(_, _, _):
                        return gp_expression_is_global(expression, authority, locals)
                    Expr.ShorthandMember(_, _):
                        return false
                    Expr.Paren(inner, paren_line):
                        return gp_expression_reads(inner, authority, locals, table)
                    Expr.Unary(operator, operand, unary_line):
                        return gp_expression_reads(operand, authority, locals, table)
                    Expr.Move(operand, _) | Expr.RegionNew(operand, _, _):
                        return gp_expression_reads(operand, authority, locals, table)
                    Expr.Binary(left, operator, right, binary_line):
                        condition_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, condition_locals)
                        return gp_condition_reads(expression, authority, condition_locals, table)
                    Expr.Index(object, index_argument, index_line):
                        return gp_expression_reads(object, authority, locals, table) or gp_expression_reads(index_argument, authority, locals, table)
                    Expr.Slice(object, low, high, _):
                        return gp_expression_reads(object, authority, locals, table) or gp_expression_reads(low, authority, locals, table) or gp_expression_reads(high, authority, locals, table)
                    Expr.IndexN(object_n, arguments_n, index_n_line):
                        return true if gp_expression_reads(object_n, authority, locals, table)
                        for argument_n in arguments_n:
                            return true if gp_expression_reads(argument_n, authority, locals, table)
                        return false
                    Expr.Call(callee, arguments, argument_names, call_line):
                        return true if gp_called_expression_reads(callee, authority, locals, table)
                        for argument in arguments:
                            return true if gp_callback_argument_reads(argument, authority, locals, table)
                        return false
                    Expr.StaticEffectCall(candidates: candidates, arguments: arguments, _):
                        for candidate in candidates:
                            for capture in candidate.captures:
                                return true if gp_expression_reads(capture, authority, locals, table)
                        for argument in arguments:
                            return true if gp_callback_argument_reads(argument, authority, locals, table)
                        return false
                    Expr.Array(elements, array_line):
                        for element in elements:
                            return true if gp_expression_reads(element, authority, locals, table)
                        return false
                    Expr.Tuple(tuple_elements, tuple_line):
                        for tuple_element in tuple_elements:
                            return true if gp_expression_reads(tuple_element, authority, locals, table)
                        return false
                    Expr.SetLit(set_elements, set_line):
                        for set_element in set_elements:
                            return true if gp_expression_reads(set_element, authority, locals, table)
                        return false
                    Expr.DictLit(entries, _):
                        for entry in entries:
                            return true if gp_expression_reads(entry.key, authority, locals, table) or gp_expression_reads(entry.value, authority, locals, table)
                        return false
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        match expression:
                            Expr.RecordUpdate(base, _, _):
                                return true if gp_expression_reads(base, authority, locals, table)
                            _:
                                pass
                        for field in fields:
                            return true if gp_expression_reads(field.value, authority, locals, table)
                        return false
                    Expr.If(condition, then_expression, else_expression, _):
                        then_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, then_locals)
                        return true if gp_condition_reads(condition, authority, then_locals, table)
                        return true if gp_expression_reads(then_expression, authority, then_locals, table)
                        else_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, else_locals)
                        return gp_expression_reads(else_expression, authority, else_locals, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        return true if gp_expression_reads(scrutinee, authority, locals, table)
                        for arm in arms |authority, locals|:
                            arm_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, arm_locals)
                            _ = gp_pattern_call_locals(arm.pattern, arm_locals)
                            return true if gp_condition_reads(arm.guard, authority, arm_locals, table) or gp_body_reads(arm.body, authority, arm_locals, table)
                        return false
                    Expr.GetElse(guarded, recovery, _):
                        return true if gp_expression_reads(guarded, authority, locals, table)
                        recovery_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, recovery_locals)
                        return gp_body_reads(recovery, authority, recovery_locals, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos, query_scope_id):
                        return true if gp_expression_reads(iterable, authority, locals, table)
                        body_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, body_locals)
                        body_locals.push(variable)
                        gp_query_binders_add(query_scope_id, table, body_locals)
                        return gp_filter_reads(condition, authority, body_locals, table) or gp_expression_reads(body, authority, body_locals, table)
                    Expr.Refinement(base, predicate, _):
                        return true if gp_expression_reads(base, authority, locals, table)
                        predicate_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, predicate_locals)
                        return gp_condition_reads(predicate, authority, predicate_locals, table)
                    # Creating a closure does not execute its body. The function-value
                    # effect analysis owns callback effects; charging the enclosing
                    # function here would make an unused lambda spuriously effectful.
                    Expr.Lambda(_, _, _):
                        return false
                    Expr.Block(statements, value, _, _):
                        block_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, block_locals)
                        return gp_body_reads(statements, authority, block_locals, table) or gp_expression_reads(value, authority, block_locals, table)
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.StringLit(_, _) | Expr.CharLit(_, _) | Expr.BoolLit(_, _) | Expr.Absent | Expr.Invalid:
                        return false
                    _:
                        # New expression variants stay conservative until their children
                        # are added to this walk.
                        return true

        # The root of an assignment target, looked through `.field`, `[i]` and parens —
        # `state.count <- 0` stores into the global `state`. stage0's globalStorageRoot.
        def gp_target_root_is_global(target: Ast::Expr, authority: GlobalAuthority&, locals: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Ident(name, ident_line):
                        return gp_names_global(name, authority, locals)
                    Expr.Scope(_, _, _):
                        return gp_expression_is_global(target, authority, locals)
                    Expr.Field(object, field, field_line):
                        return gp_target_root_is_global(object, authority, locals)
                    Expr.Index(object, index_argument, index_line):
                        return gp_target_root_is_global(object, authority, locals)
                    Expr.IndexN(object_n, arguments_n, index_n_line):
                        return gp_target_root_is_global(object_n, authority, locals)
                    Expr.Paren(inner, paren_line):
                        return gp_target_root_is_global(inner, authority, locals)
                    _:
                        return false

        # Reads that occur INSIDE an assignment target rather than at its root:
        # `table[hot] <- 0` writes `table` and reads `hot`. The root itself is a store
        # location, not a read, which is why it is skipped here.
        def gp_target_reads(target: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Index(object, index_argument, index_line):
                        return gp_expression_reads(index_argument, authority, locals, table) or gp_target_reads(object, authority, locals, table)
                    Expr.IndexN(object_n, arguments_n, index_n_line):
                        for argument_n in arguments_n:
                            return true if gp_expression_reads(argument_n, authority, locals, table)
                        return gp_target_reads(object_n, authority, locals, table)
                    Expr.Field(object_f, field, field_line):
                        return gp_target_reads(object_f, authority, locals, table)
                    Expr.Paren(inner, paren_line):
                        return gp_target_reads(inner, authority, locals, table)
                    _:
                        return false

        # Whether a body READS a mutable global. `trusted` only affects Unsafe tracking.
        def gp_body_reads(statements: darray[Ast::Stmt], authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |locals|:
                    match statement:
                        Stmt.Expr(expression, line):
                            return true if gp_expression_reads(expression, authority, locals, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            return true if gp_expression_reads(value, authority, locals, table)
                            locals.push(name)
                        Stmt.Assign(target, operator, value, line):
                            return true if:
                                gp_expression_reads(value, authority, locals, table)
                                gp_is_compound_assign(operator) and gp_target_root_is_global(target, authority, locals)
                            if operator == TokenKind.Assign and target is Expr.Ident(binding_name, _):
                                locals.push(binding_name) if not gp_names_global(binding_name, authority, locals) and not gp_call_name_is_local(binding_name, locals)
                            # A global read INSIDE the target (`slots[cursor] <- 1` reads
                            # `cursor`) is NOT Global.Read to stage0: measured 2026-09-05,
                            # `store_at` requires [Global.Write] alone while the same index in
                            # read position (`return slots[cursor]`) requires [Global.Read].
                            # stage0 is the oracle here even though the read is real; the
                            # under-report is recorded as an upstream item.
                        Stmt.Return(value, line):
                            if value is returned:
                                return true if gp_expression_reads(returned, authority, locals, table)
                        Stmt.If(condition, then_body, else_body, line):
                            then_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, then_locals)
                            return true if gp_condition_reads(condition, authority, then_locals, table)
                            return true if gp_body_reads(then_body, authority, then_locals, table)
                            else_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, else_locals)
                            return true if gp_body_reads(else_body, authority, else_locals, table)
                        Stmt.While(condition, while_body, line):
                            body_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, body_locals)
                            return true if gp_condition_reads(condition, authority, body_locals, table)
                            return true if gp_body_reads(while_body, authority, body_locals, table)
                        Stmt.For(_, variables, iterable, for_body, line):
                            base_expression: mutable Ast::Expr = iterable
                            filter_expression: mutable Ast::Expr? = null
                            filter_guard: mutable Ast::Expr? = null
                            match iterable:
                                Expr.Refinement(filter_base, filter_predicate, _):
                                    match filter_base:
                                        Expr.Refinement(inner_base, inner_predicate, _):
                                            base_expression <- inner_base
                                            filter_expression <- inner_predicate
                                            filter_guard <- filter_predicate
                                        _:
                                            base_expression <- filter_base
                                            filter_expression <- filter_predicate
                                _:
                                    pass
                            return true if gp_expression_reads(base_expression, authority, locals, table)
                            body_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, body_locals)
                            for variable in variables |body_locals|:
                                body_locals.push(variable)
                            if filter_expression is filter_value:
                                return true if gp_filter_reads(filter_value, authority, body_locals, table)
                            if filter_guard is guard_value:
                                guard_locals: mutable darray[sview] = []
                                gp_locals_copy(body_locals, guard_locals)
                                return true if gp_condition_reads(guard_value, authority, guard_locals, table)
                            return true if gp_body_reads(for_body, authority, body_locals, table)
                        Stmt.Contract(kind, expression, line):
                            return true if gp_expression_reads(expression, authority, locals, table)
                        Stmt.Block(binding: binding, body: block_body, _):
                            block_locals: mutable darray[sview] = []
                            gp_locals_copy(locals, block_locals)
                            block_locals.push(binding) if binding != ""
                            return true if gp_body_reads(block_body, authority, block_locals, table)
                        Stmt.Match(scrutinee, arms, line):
                            return true if gp_expression_reads(scrutinee, authority, locals, table)
                            for arm in arms |authority, locals|:
                                arm_locals: mutable darray[sview] = []
                                gp_locals_copy(locals, arm_locals)
                                _ = gp_pattern_call_locals(arm.pattern, arm_locals)
                                return true if gp_condition_reads(arm.guard, authority, arm_locals, table)
                                return true if gp_body_reads(arm.body, authority, arm_locals, table)
                        Stmt.Invalid | Stmt.Break(_, _) | Stmt.Continue(_, _):
                            pass
                        _:
                            return true
                return false

        # A direct lambda callee executes its body at this call site. A standalone
        # lambda expression remains inert in `gp_expression_reads` because closure
        # creation does not execute the body.
        def gp_called_expression_reads(callee: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Lambda(parameters, body, _):
                        lambda_locals: mutable darray[sview] = []
                        gp_locals_copy(locals, lambda_locals)
                        for parameter in parameters |lambda_locals|:
                            lambda_locals.push(parameter)
                        return gp_body_reads(body, authority, lambda_locals, table)
                    Expr.Paren(inner, _):
                        return gp_called_expression_reads(inner, authority, locals, table)
                    _:
                        if gp_direct_call_name(callee) != "" and not gp_namespace_root_is_local(callee, locals) and not gp_namespace_root_is_global(callee, authority, locals):
                            return gp_expression_reads(callee, authority, locals, table)
                        # An indirect or locally-bound callable may execute anonymous
                        # code whose Global effects are not represented by named edges.
                        return true

        def gp_callback_argument_reads(argument: Ast::Expr, authority: GlobalAuthority&, locals: mutable darray[sview]&, table: SymbolTable&) -> bool:
            match argument:
                Expr.Lambda(_, _, _) | Expr.Paren(_, _):
                    return gp_called_expression_reads(argument, authority, locals, table)
                _:
                    return gp_expression_reads(argument, authority, locals, table)
