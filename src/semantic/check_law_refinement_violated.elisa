# Law-refinement bound violation for a local. A local `x: T is Law[bounds] = V` where Law is a
# range/lower/upper-shaped law (`self >= lo and self <= hi`, `self >= k`, `self <= k`) and the
# constant V falls outside the bounds is rejected ("refinement Law is violated: x does not
# satisfy it"). Reuses check_refinement_return's law-shape machinery (law_shape, signed_int_literal)
# for the inclusive [lo, hi] window; a constant out of window is a provable violation (never
# overfires — non-constant V, non-range laws, or unresolved bounds are a sound miss).
extend Semantic:
    private:
        # The INCLUSIVE [lo, hi] window and law name of a `T is Law[bounds]` type: two-arg
        # `Law[a, b]`, inclusive range `Law[a..=b]` / exclusive `Law[a..b]`/`Law[a..<b]`, or a
        # single-bound `Law[k]` (lower/upper). found=false otherwise.
        def refinement_bound_spec(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, law_name: sview, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Binary(base, operator, right, line):
                        (false, sview("", 0, 0), 0, 0) return if operator != TokenKind.Is
                        return refinement_application_bounds(right, law_names, law_predicates)
                    _:
                        return (false, sview("", 0, 0), 0, 0)

        def refinement_application_bounds(application: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, law_name: sview, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match application:
                    Expr.IndexN(object, arguments, indexn_line):
                        law_name: sview = ident_name_of(object)
                        lo_literal: (found: bool, value: i64) = signed_int_literal(arguments[0]) if arguments.count == 2 else (false, 0)
                        hi_literal: (found: bool, value: i64) = signed_int_literal(arguments[1]) if arguments.count == 2 else (false, 0)
                        usable: bool = arguments.count == 2 and lo_literal.found and hi_literal.found and law_shape(law_name, law_names, law_predicates) == "range"
                        return (usable, law_name, lo_literal.value, hi_literal.value)
                    Expr.Index(single_object, single_index, single_line):
                        single_name: sview = ident_name_of(single_object)
                        return refinement_single_index_bounds(single_name, single_index, law_names, law_predicates)
                    _:
                        return (false, sview("", 0, 0), 0, 0)

        def refinement_single_index_bounds(law_name: sview, index_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, law_name: sview, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                shape: sview = law_shape(law_name, law_names, law_predicates)
                match index_expression:
                    Expr.Binary(range_low, range_operator, range_high, range_line):
                        low_literal: (found: bool, value: i64) = signed_int_literal(range_low)
                        high_literal: (found: bool, value: i64) = signed_int_literal(range_high)
                        is_inclusive: bool = range_operator == TokenKind.RangeLe
                        is_exclusive: bool = range_operator == TokenKind.Range or range_operator == TokenKind.RangeLt
                        inclusive_high: i64 = high_literal.value if is_inclusive else high_literal.value - 1
                        range_usable: bool = shape == "range" and low_literal.found and high_literal.found and (is_inclusive or is_exclusive)
                        return (range_usable, law_name, low_literal.value, inclusive_high)
                    _:
                        bound_literal: (found: bool, value: i64) = signed_int_literal(index_expression)
                        lower_usable: bool = shape == "lower" and bound_literal.found
                        upper_usable: bool = shape == "upper" and bound_literal.found
                        low: i64 = bound_literal.value if lower_usable else (-9223372036854775807 - 1)
                        high: i64 = bound_literal.value if upper_usable else 9223372036854775807
                        return (lower_usable or upper_usable, law_name, low, high)

        # The law name of a bare (no-argument) refinement type `T is Law`, or "".
        def bare_law_of_type(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Binary(base, operator, right, line):
                        return ident_name_of(right) if operator == TokenKind.Is else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def law_refinement_violated_statements(statements: darray[Ast::Stmt], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            spec: (found: bool, law_name: sview, lo: i64, hi: i64) = refinement_bound_spec(type_expression, law_names, law_predicates)
                            value_literal: (found: bool, value: i64) = fold_const_int(value)
                            out_of_window: bool = spec.found and value_literal.found and (value_literal.value < spec.lo or value_literal.value > spec.hi)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementBoundViolated, name: spec.law_name, line: line, expected: "", actual: name}) if out_of_window
                            # Bare no-argument law `x: T is Law = V` — evaluate the law body with self=V.
                            bare_law: sview = bare_law_of_type(type_expression)
                            bare_predicate: Ast::Expr = law_predicate_by_name(bare_law, law_names, law_predicates) if bare_law != "" else (Ast::Expr.Absent)
                            bare_has_predicate: bool = match bare_predicate:
                                Expr.Absent: false
                                _: true
                            bare_violated: bool = value_literal.found and bare_has_predicate and predicate_violated_by(bare_predicate, "self", value_literal.value)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementBoundViolated, name: bare_law, line: line, expected: "", actual: name}) if bare_violated and not spec.found
                        Stmt.If(condition, then_body, else_body, line):
                            table <- law_refinement_violated_statements(then_body, law_names, law_predicates, table)
                            table <- law_refinement_violated_statements(else_body, law_names, law_predicates, table)
                        Stmt.While(condition, while_body, line):
                            table <- law_refinement_violated_statements(while_body, law_names, law_predicates, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- law_refinement_violated_statements(for_body, law_names, law_predicates, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- law_refinement_violated_statements(block_body, law_names, law_predicates, table)
                        _:
                            pass

        # Flag `return V` (constant) violating a law-refined return type `-> T is Law[bounds]`
        # or `-> T is Law`. Bounds via refinement_bound_spec; bare law via predicate_violated_by.
        def law_refinement_return_statements(statements: darray[Ast::Stmt], spec: (found: bool, law_name: sview, lo: i64, hi: i64), bare_law: sview, bare_predicate: Ast::Expr, bare_has_predicate: bool, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                value_literal: (found: bool, value: i64) = fold_const_int(returned)
                                bounds_bad: bool = spec.found and value_literal.found and (value_literal.value < spec.lo or value_literal.value > spec.hi)
                                bare_bad: bool = value_literal.found and bare_has_predicate and not spec.found and predicate_violated_by(bare_predicate, "self", value_literal.value)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementBoundViolated, name: spec.law_name if spec.found else bare_law, line: line, expected: "return", actual: ""}) if bounds_bad or bare_bad
                        Stmt.If(condition, then_body, else_body, line):
                            table <- law_refinement_return_statements(then_body, spec, bare_law, bare_predicate, bare_has_predicate, law_names, law_predicates, table)
                            table <- law_refinement_return_statements(else_body, spec, bare_law, bare_predicate, bare_has_predicate, law_names, law_predicates, table)
                        Stmt.While(condition, while_body, line):
                            table <- law_refinement_return_statements(while_body, spec, bare_law, bare_predicate, bare_has_predicate, law_names, law_predicates, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- law_refinement_return_statements(block_body, spec, bare_law, bare_predicate, bare_has_predicate, law_names, law_predicates, table)
                        _:
                            pass

        def law_refinement_check_return(return_type: Ast::Expr?, body: darray[Ast::Stmt], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if return_type is declared_return:
                    spec: (found: bool, law_name: sview, lo: i64, hi: i64) = refinement_bound_spec(declared_return, law_names, law_predicates)
                    bare_law: sview = bare_law_of_type(declared_return)
                    bare_predicate: Ast::Expr = law_predicate_by_name(bare_law, law_names, law_predicates) if bare_law != "" else (Ast::Expr.Absent)
                    bare_has_predicate: bool = match bare_predicate:
                        Expr.Absent: false
                        _: true
                    table <- law_refinement_return_statements(body, spec, bare_law, bare_predicate, bare_has_predicate, law_names, law_predicates, table) if spec.found or bare_has_predicate

        def law_refinement_violated_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- law_refinement_violated_statements(body, law_names, law_predicates, table)
                            table <- law_refinement_check_return(return_type, body, law_names, law_predicates, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- law_refinement_violated_walk(module_body, law_names, law_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- law_refinement_violated_walk(scoped_body, law_names, law_predicates, table)
                        _:
                            pass

        def check_law_refinement_violated(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, law_names, law_predicates)
                table <- law_refinement_violated_walk(declarations, law_names, law_predicates, table)
