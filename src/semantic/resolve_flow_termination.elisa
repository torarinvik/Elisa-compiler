# Stage1 semantic layer — TERMINATION analysis: does this statement, or this statement list,
# necessarily leave the enclosing function (return/break/continue/raise, an aborting call, or a
# match whose arms all terminate)? Feeds both the missing-return and the unreachable-code
# findings. Continues resolve_flow.elisa.

extend Semantic:
    private:
        # Whether a statement is the parser's Invalid placeholder (a parse-error artifact,
        # never real code — so it must not be flagged as unreachable).
        def statement_is_invalid(statement: Ast::Stmt) -> bool:
            can Abort.Panic:
                return match statement:
                    Stmt.Invalid: true
                    _:            false




        # The source line of a statement (for locating a finding whose statement variant
        # is not otherwise destructured — e.g. the first unreachable statement).
        def statement_line(statement: Ast::Stmt) -> u32:
            can Abort.Panic:
                return match statement:
                    Stmt.Expr(expression, line):                 line.line
                    Stmt.Block(block_kind, block_clause, block_binding, block_body, line):   line.line
                    Stmt.VarDecl(declaration_name, declaration_type, declaration_value, line):     line.line
                    Stmt.Assign(assign_target, assign_operator, assign_value, line):      line.line
                    Stmt.If(if_condition, if_then_body, if_else_body, line):          line.line
                    Stmt.While(while_condition, while_body, line):           line.line
                    Stmt.For(for_bind, for_variables, for_iterable, for_body, line):    line.line
                    Stmt.Return(return_value, line):              line.line
                    Stmt.Break(break_label, line):               line.line
                    Stmt.Continue(continue_label, line):            line.line
                    Stmt.Match(match_scrutinee, match_arms, line):           line.line
                    Stmt.Contract(contract_kind, contract_expression, line):        line.line
                    Stmt.Invalid:                       0




        # Whether a statement unconditionally terminates execution (returns/breaks/continues/raises).
        # Used to determine if a function with non-void return type necessarily returns before
        # exiting, and to track which statement ends a block for unreachable code detection.
        # Conservative: loops and conditionals that don't cover all cases are NOT treated as
        # terminators, so code after them is never falsely flagged as unreachable. Only explicit
        # control-flow statements (return/break/continue) and match expressions that provably
        # terminate all arms are considered terminators.
        # Whether a `get … else …` recovery block itself returns/raises (so the enclosing
        # `return get X else <recovery>` is not a clean block terminator for unreachable detection).
        def flow_recovery_returns(recovery: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                for statement in recovery:
                    match statement:
                        Stmt.Return(recovery_value, recovery_line):
                            return true
                        _:
                            pass
                return false



        def statement_terminates(statement: Ast::Stmt, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match statement:
                    Stmt.Return(_, _):           true
                    Stmt.Break(_, _):            true
                    Stmt.Continue(_, _):         true
                    Stmt.Match(scrutinee, arms, line):
                        if statement_match_is_catch(table, line):
                            expression_catch_terminates(scrutinee, arms, table, line)
                        else:
                            expression_evaluation_aborts(scrutinee, table) or arms_all_terminate(scrutinee, arms, table)
                    Stmt.If(condition, then_body, else_body, _):
                        # An aborting condition never enters a branch; otherwise both branches
                        # must terminate for the conditional to be a terminator.
                        if expression_evaluation_aborts(condition, table):
                            true
                        else:
                            literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            if literal.known:
                                statements_terminate(then_body, table) if literal.value else statements_terminate(else_body, table)
                            else:
                                statements_terminate(then_body, table) and statements_terminate(else_body, table)
                    Stmt.Block(body: body, _):
                        statements_terminate(body, table)
                    Stmt.Expr(expression, _):             expression_aborts(expression, table)
                    Stmt.VarDecl(_, _, value, _):         expression_evaluation_aborts(value, table)
                    Stmt.Assign(target, _, value, _):     expression_evaluation_aborts(target, table) or expression_evaluation_aborts(value, table)
                    # Loops themselves are not terminators for stage0 parity, but their eager
                    # condition/iterable evaluation can abort before control reaches the body.
                    Stmt.While(condition, _, _): expression_evaluation_aborts(condition, table)
                    Stmt.For(_, _, iterable, _, _): expression_evaluation_aborts(iterable, table)
                    # Stage0 never treats a loop body as a terminator. Measured one feature at a
                    # time — `while true: pass`,
                    # `while true: return 1`, `while true: break` and an `if`-guarded break all
                    # get "function f may fall through without returning a value" from stage0.
                    # stage1 used to special-case `while true:` with no escaping break and claim
                    # "(matches stage0)"; it does not. The cost of the claim was rc=2 instead of
                    # rc=1: semantic analysis passed the function, then the BACKEND declined it
                    # ("backend emitted no functions for this unit"), reporting a compiler
                    # limitation where stage0 reports the user's actual defect.
                    _:                           false




        def expression_literal_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            can Abort.Panic:
                return match expression:
                    Ast::Expr.BoolLit(value, _): (true, value)
                    Ast::Expr.Paren(inner, _): expression_literal_bool(inner)
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        operand_literal: (known: bool, value: bool) = expression_literal_bool(operand)
                        (true, not operand_literal.value) if operand_literal.known else (false, false)
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        left_literal: (known: bool, value: bool) = expression_literal_bool(left)
                        if left_literal.known and not left_literal.value:
                            (true, false)
                        elif left_literal.known:
                            expression_literal_bool(right)
                        else:
                            right_literal: (known: bool, value: bool) = expression_literal_bool(right)
                            (true, false) if right_literal.known and not right_literal.value else (false, false)
                    Ast::Expr.Binary(left, TokenKind.Or, right, _):
                        left_literal: (known: bool, value: bool) = expression_literal_bool(left)
                        if left_literal.known and left_literal.value:
                            (true, true)
                        elif left_literal.known:
                            expression_literal_bool(right)
                        else:
                            right_literal: (known: bool, value: bool) = expression_literal_bool(right)
                            (true, true) if right_literal.known and right_literal.value else (false, false)
                    _: (false, false)



        # Whether invoking a callee is itself an unconditional abort. A bare name such as
        # `panic` is only a function value; the abort happens when that name is called.
        def expression_call_aborts(callee: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match callee:
                    Ast::Expr.Ident(name, _): name == "panic" or name == "raise" or name == "error"
                    _: expression_aborts(callee, table)

        # A catchable `raise` enters the Catch's error arms. `panic` and `error` stay
        # unconditional exits even when they appear as the guarded expression.
        def expression_directly_raises(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Ast::Expr.Call(Ast::Expr.Ident("raise", _), _, _, _): true
                    Ast::Expr.Paren(inner, _): expression_directly_raises(inner)
                    _: false

        # Whether a guaranteed-aborting expression has any reachable catchable-raise outcome.
        # A Catch around such a branch can continue through its handler even though the
        # guarded expression itself cannot complete normally.
        def flow_expression_sequence_may_raise_catchably(expressions: darray[Ast::Expr], table: SymbolTable&) -> (may_raise: bool, reaches_end: bool):
            can Memory.Allocate, Abort.Panic:
                for expression in expressions:
                    return (true, false) if expression_may_raise_catchably(expression, table)
                    return (false, false) if expression_evaluation_aborts(expression, table)
                return (false, true)

        def flow_iterable_is_provably_nonempty(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                return match expression:
                    Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _): elements.count > 0
                    Ast::Expr.DictLit(entries, _): entries.count > 0
                    Ast::Expr.StringLit(text, _): text.len > 0
                    Ast::Expr.Paren(inner, _): flow_iterable_is_provably_nonempty(inner)
                    _: false

        def flow_match_arms_may_raise_catchably(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], is_catch: bool, scrutinee_aborts: bool, scrutinee_may_raise: bool, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                arm_index: mutable usize = 0
                while arm_index < arms.count |arm_index, arms, is_catch, scrutinee, scrutinee_aborts, scrutinee_may_raise, table|:
                    arm: Ast::MatchArm = arms[arm_index]
                    arm_reachable: mutable bool = false
                    if is_catch:
                        arm_reachable <- (not scrutinee_aborts if arm_index == 0 else scrutinee_may_raise) and progress_catch_arm_reachable(arms, arm_index)
                    else:
                        arm_reachable <- not scrutinee_aborts and progress_match_arm_reachable(scrutinee, arms, arm_index)
                    if arm_reachable:
                        # A guard is evaluated before its truth value is known. In
                        # particular, `raise(E) and false` still has a catchable path.
                        return true if expression_may_raise_catchably(arm.guard, table)
                        guard_aborts: bool = expression_evaluation_aborts(arm.guard, table)
                        guard: (known: bool, value: bool) = expression_literal_bool(arm.guard)
                        if not guard_aborts and not (guard.known and not guard.value):
                            return true if flow_statements_may_raise_catchably(arm.body, table)
                    arm_index <- arm_index + 1
                return false

        def flow_callable_name(expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                return match expression:
                    Ast::Expr.Ident(name, _) | Ast::Expr.Scope(_, name, _): name
                    Ast::Expr.Paren(inner, _): flow_callable_name(inner)
                    _: ""

        def flow_callable_declares_error(callee_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if callee_name == ""
                declared_error: (known: bool, family: sview @source) = try_noncall_callable_error_family(callee_name, table.protocol_annotations)
                return declared_error.known and declared_error.family != ""

        def expression_may_raise_catchably(expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Ast::Expr.Call(callee, arguments, _, _):
                        callee_raises: bool = expression_may_raise_catchably(callee, table)
                        if callee_raises:
                            true
                        elif expression_evaluation_aborts(callee, table):
                            false
                        else:
                            argument_result: (may_raise: bool, reaches_end: bool) = flow_expression_sequence_may_raise_catchably(arguments, table)
                            argument_result.may_raise or (argument_result.reaches_end and (expression_directly_raises(expression) or flow_callable_declares_error(flow_callable_name(callee), table)))
                    Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        runtime_result: (may_raise: bool, reaches_end: bool) = flow_expression_sequence_may_raise_catchably(runtime_children, table)
                        if runtime_result.may_raise:
                            true
                        elif not runtime_result.reaches_end:
                            false
                        else:
                            any candidate in candidates where flow_callable_declares_error(candidate.callee, table)
                    Ast::Expr.Binary(left, operator, right, _):
                        left_raises: bool = expression_may_raise_catchably(left, table)
                        if left_raises:
                            true
                        elif expression_evaluation_aborts(left, table):
                            false
                        else:
                            right_is_required: mutable bool = true
                            if operator == TokenKind.And or operator == TokenKind.Or:
                                literal: (known: bool, value: bool) = expression_literal_bool(left)
                                right_is_required <- not literal.known or ((operator == TokenKind.And and literal.value) or (operator == TokenKind.Or and not literal.value))
                            expression_may_raise_catchably(right, table) if right_is_required else false
                    Ast::Expr.If(condition, then_value, else_value, _):
                        if expression_may_raise_catchably(condition, table):
                            true
                        elif expression_evaluation_aborts(condition, table):
                            false
                        else:
                            literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            if literal.known:
                                expression_may_raise_catchably(then_value, table) if literal.value else expression_may_raise_catchably(else_value, table)
                            else:
                                expression_may_raise_catchably(then_value, table) or expression_may_raise_catchably(else_value, table)
                    Ast::Expr.Match(scrutinee, arms, _):
                        scrutinee_raises: bool = expression_may_raise_catchably(scrutinee, table)
                        if scrutinee_raises:
                            true
                        elif expression_evaluation_aborts(scrutinee, table):
                            false
                        else:
                            flow_match_arms_may_raise_catchably(scrutinee, arms, false, false, false, table)
                    Ast::Expr.Catch(guarded, arms, _):
                        guarded_aborts: bool = expression_evaluation_aborts(guarded, table)
                        guarded_may_raise: bool = expression_may_raise_catchably(guarded, table)
                        if guarded_aborts and not guarded_may_raise:
                            false
                        else:
                            flow_match_arms_may_raise_catchably(guarded, arms, true, guarded_aborts, guarded_may_raise, table)
                    Ast::Expr.Block(statements, value, _, _):
                        if flow_statements_may_raise_catchably(statements, table):
                            true
                        elif statements_terminate(statements, table):
                            false
                        else:
                            expression_may_raise_catchably(value, table)
                    Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                        expression_may_raise_catchably(object, table)
                    Ast::Expr.Index(object, index, _):
                        children: darray[Ast::Expr] @source = [object, index]
                        flow_expression_sequence_may_raise_catchably(children, table).may_raise
                    Ast::Expr.IndexN(object, indices, _):
                        children: mutable darray[Ast::Expr] = [object]
                        children.extend(indices)
                        flow_expression_sequence_may_raise_catchably(children, table).may_raise
                    Ast::Expr.Slice(object, low, high, _):
                        children: darray[Ast::Expr] @source = [object, low, high]
                        flow_expression_sequence_may_raise_catchably(children, table).may_raise
                    Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                        flow_expression_sequence_may_raise_catchably(elements, table).may_raise
                    Ast::Expr.DictLit(entries, _):
                        for entry in entries:
                            key_raises: bool = expression_may_raise_catchably(entry.key, table)
                            return true if key_raises
                            return false if expression_evaluation_aborts(entry.key, table)
                            value_raises: bool = expression_may_raise_catchably(entry.value, table)
                            return true if value_raises
                            return false if expression_evaluation_aborts(entry.value, table)
                        false
                    Ast::Expr.Construct(type_expression, fields, _):
                        type_raises: bool = expression_may_raise_catchably(type_expression, table)
                        if type_raises:
                            true
                        elif expression_evaluation_aborts(type_expression, table):
                            false
                        else:
                            for field in fields:
                                field_raises: bool = expression_may_raise_catchably(field.value, table)
                                return true if field_raises
                                return false if expression_evaluation_aborts(field.value, table)
                            false
                    Ast::Expr.RecordUpdate(base, fields, _):
                        base_raises: bool = expression_may_raise_catchably(base, table)
                        if base_raises:
                            true
                        elif expression_evaluation_aborts(base, table):
                            false
                        else:
                            for field in fields:
                                field_raises: bool = expression_may_raise_catchably(field.value, table)
                                return true if field_raises
                                return false if expression_evaluation_aborts(field.value, table)
                            false
                    Ast::Expr.GetElse(guarded, recovery, _):
                        if expression_may_raise_catchably(guarded, table):
                            true
                        elif expression_evaluation_aborts(guarded, table):
                            false
                        else:
                            flow_statements_may_raise_catchably(recovery, table)
                    Ast::Expr.Comprehension(_, iterable, condition, body, _, _):
                        if expression_may_raise_catchably(iterable, table):
                            true
                        elif expression_evaluation_aborts(iterable, table) or progress_empty_iterable(iterable):
                            false
                        elif expression_may_raise_catchably(condition, table):
                            true
                        elif expression_evaluation_aborts(condition, table):
                            false
                        else:
                            condition_literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            expression_may_raise_catchably(body, table) if not (condition_literal.known and not condition_literal.value) else false
                    Ast::Expr.Refinement(base, predicate, _):
                        children: darray[Ast::Expr] @source = [base, predicate]
                        flow_expression_sequence_may_raise_catchably(children, table).may_raise
                    Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                        expression_may_raise_catchably(inner, table)
                    Ast::Expr.Lambda(_, _, _): false
                    _: false

        def flow_statements_may_raise_catchably(statements: darray[Ast::Stmt], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Ast::Stmt.Expr(expression, _):
                            return true if expression_may_raise_catchably(expression, table)
                        Ast::Stmt.Return(value, _):
                            if value is present_value:
                                return true if expression_may_raise_catchably(present_value, table)
                        Ast::Stmt.VarDecl(_, type_expression, value, _):
                            children: darray[Ast::Expr] @source = [type_expression, value]
                            return true if flow_expression_sequence_may_raise_catchably(children, table).may_raise
                        Ast::Stmt.Assign(target, _, value, _):
                            children: darray[Ast::Expr] @source = [target, value]
                            return true if flow_expression_sequence_may_raise_catchably(children, table).may_raise
                        Ast::Stmt.If(condition, then_body, else_body, _):
                            return true if expression_may_raise_catchably(condition, table)
                            return false if expression_evaluation_aborts(condition, table)
                            literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            if literal.known:
                                selected: darray[Ast::Stmt] = then_body if literal.value else else_body
                                return true if flow_statements_may_raise_catchably(selected, table)
                            else:
                                return true if flow_statements_may_raise_catchably(then_body, table) or flow_statements_may_raise_catchably(else_body, table)
                        Ast::Stmt.Block(body: body, _):
                            return true if flow_statements_may_raise_catchably(body, table)
                        Ast::Stmt.While(condition, body, _):
                            return true if expression_may_raise_catchably(condition, table)
                            return false if expression_evaluation_aborts(condition, table)
                            condition_literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            return true if not (condition_literal.known and not condition_literal.value) and flow_statements_may_raise_catchably(body, table)
                        Ast::Stmt.For(_, _, iterable, body, _):
                            return true if expression_may_raise_catchably(iterable, table)
                            return false if expression_evaluation_aborts(iterable, table) or progress_empty_iterable(iterable)
                            return true if flow_statements_may_raise_catchably(body, table)
                        Ast::Stmt.Match(scrutinee, arms, line):
                            is_catch: bool = statement_match_is_catch(table, line)
                            scrutinee_aborts: bool = expression_evaluation_aborts(scrutinee, table)
                            scrutinee_may_raise: bool = expression_may_raise_catchably(scrutinee, table)
                            return true if not is_catch and scrutinee_may_raise
                            return false if scrutinee_aborts and not (is_catch and scrutinee_may_raise)
                            return true if flow_match_arms_may_raise_catchably(scrutinee, arms, is_catch, scrutinee_aborts, scrutinee_may_raise, table)
                        Ast::Stmt.Contract(_, expression, _):
                            return true if expression_may_raise_catchably(expression, table)
                        _:
                            pass
                    return false if statement_terminates(statement, table)
                return false

        def catch_error_arms_terminate(arms: darray[Ast::MatchArm], table: SymbolTable&, line: Ast::Pos) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count < 2
                return false if not progress_catch_error_arms_total_at_offset(arms, table, line.line, line.offset, true, true)
                arm_index: mutable usize = 1
                while arm_index < arms.count |arm_index, arms, table|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = expression_literal_bool(arm.guard)
                    if progress_catch_arm_reachable(arms, arm_index) and not (guard.known and not guard.value):
                        return false if not expression_evaluation_aborts(arm.guard, table) and not statements_terminate(arm.body, table)
                    arm_index <- arm_index + 1
                return true

        def expression_catch_terminates(guarded: Ast::Expr, arms: darray[Ast::MatchArm], table: SymbolTable&, line: Ast::Pos) -> bool:
            can Memory.Allocate, Abort.Panic:
                guarded_aborts: bool = expression_evaluation_aborts(guarded, table)
                catchable_raise: bool = expression_may_raise_catchably(guarded, table)
                if guarded_aborts:
                    return true if not catchable_raise
                    return catch_error_arms_terminate(arms, table, line)
                return false if arms.count == 0 or not statements_terminate(arms[0].body, table)
                return catch_error_arms_terminate(arms, table, line)

        # Statement-position Catch is represented by Stmt.Match plus a parser marker. Keep
        # its catchable raise path separate from ordinary Match's eager scrutinee abort.
        def statement_match_is_catch(table: SymbolTable&, position: Ast::Pos) -> bool:
            can Abort.Panic:
                markers: darray[Ast::EnumAnnotation] = table.scoped_catch_annotations if table.scoped_catch_annotations_active else table.protocol_annotations
                return any marker in markers where marker.line == position.line and marker.offset == position.offset and marker.owner == "__catch_match" and marker.name == "__catch_match" and marker.module == table.current_module

        # Whether evaluating an expression cannot complete normally because a runtime child
        # aborts or a value block's statements terminate control flow. A bare function
        # identifier used as a value does not invoke it.
        def expression_evaluation_aborts(expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Ast::Expr.Ident(_, _): false
                    Ast::Expr.Call(callee, arguments, _, _):
                        callee_aborts: bool = expression_call_aborts(callee, table)
                        callee_aborts or (not callee_aborts and any argument in arguments where expression_evaluation_aborts(argument, table))
                    Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        any child in runtime_children where expression_evaluation_aborts(child, table)
                    Ast::Expr.Binary(left, operator, right, _):
                        right_is_required: mutable bool = operator != TokenKind.And and operator != TokenKind.Or
                        if operator == TokenKind.And or operator == TokenKind.Or:
                            literal: (known: bool, value: bool) = expression_literal_bool(left)
                            right_is_required <- literal.known and ((operator == TokenKind.And and literal.value) or (operator == TokenKind.Or and not literal.value))
                        expression_evaluation_aborts(left, table) or (right_is_required and expression_evaluation_aborts(right, table))
                    Ast::Expr.If(condition, then_value, else_value, _):
                        if expression_evaluation_aborts(condition, table):
                            true
                        else:
                            literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            if literal.known:
                                expression_evaluation_aborts(then_value, table) if literal.value else expression_evaluation_aborts(else_value, table)
                            else:
                                expression_evaluation_aborts(then_value, table) and expression_evaluation_aborts(else_value, table)
                    Ast::Expr.Match(scrutinee, arms, _):
                        expression_evaluation_aborts(scrutinee, table) or arms_all_terminate(scrutinee, arms, table)
                    Ast::Expr.Block(statements, value, _, _):
                        statements_terminate(statements, table) or expression_evaluation_aborts(value, table)
                    Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                        expression_evaluation_aborts(inner, table)
                    Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                        expression_evaluation_aborts(object, table)
                    Ast::Expr.Index(object, index, _):
                        expression_evaluation_aborts(object, table) or expression_evaluation_aborts(index, table)
                    Ast::Expr.IndexN(object, indices, _):
                        expression_evaluation_aborts(object, table) or any index in indices where expression_evaluation_aborts(index, table)
                    Ast::Expr.Slice(object, low, high, _):
                        expression_evaluation_aborts(object, table) or expression_evaluation_aborts(low, table) or expression_evaluation_aborts(high, table)
                    Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                        any element in elements where expression_evaluation_aborts(element, table)
                    Ast::Expr.Catch(guarded, arms, line):
                        expression_catch_terminates(guarded, arms, table, line)
                    Ast::Expr.GetElse(guarded, _, _):
                        expression_evaluation_aborts(guarded, table)
                    Ast::Expr.Comprehension(_, iterable, condition, body, _, _):
                        if expression_evaluation_aborts(iterable, table):
                            true
                        elif not flow_iterable_is_provably_nonempty(iterable):
                            false
                        elif expression_evaluation_aborts(condition, table):
                            true
                        else:
                            condition_literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            if condition_literal.known and not condition_literal.value:
                                false
                            elif condition is Ast::Expr.Absent or (condition_literal.known and condition_literal.value):
                                expression_evaluation_aborts(body, table)
                            else:
                                false
                    Ast::Expr.DictLit(entries, _):
                        any entry in entries where expression_evaluation_aborts(entry.key, table) or expression_evaluation_aborts(entry.value, table)
                    Ast::Expr.Construct(type_expression, fields, _):
                        expression_evaluation_aborts(type_expression, table) or any field in fields where expression_evaluation_aborts(field.value, table)
                    Ast::Expr.RecordUpdate(base, fields, _):
                        expression_evaluation_aborts(base, table) or any field in fields where expression_evaluation_aborts(field.value, table)
                    Ast::Expr.Refinement(base, predicate, _):
                        expression_evaluation_aborts(base, table) or expression_evaluation_aborts(predicate, table)
                    _: false


        # Whether an expression statement unconditionally terminates: a call to `panic`/`raise`,
        # or a nested expression that cannot complete normally.
        # Both abort names parse as Ident heads in stage1.
        def expression_aborts(expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Ast::Expr.Ident(_, _): false
                    Ast::Expr.Call(callee, arguments, _, _):
                        callee_aborts: bool = expression_call_aborts(callee, table)
                        callee_aborts or (not callee_aborts and any argument in arguments where expression_evaluation_aborts(argument, table))
                    Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        any child in runtime_children where expression_evaluation_aborts(child, table)
                    Ast::Expr.Binary(left, operator, right, _):
                        right_is_required: mutable bool = operator != TokenKind.And and operator != TokenKind.Or
                        if operator == TokenKind.And or operator == TokenKind.Or:
                            literal: (known: bool, value: bool) = expression_literal_bool(left)
                            right_is_required <- literal.known and ((operator == TokenKind.And and literal.value) or (operator == TokenKind.Or and not literal.value))
                        expression_evaluation_aborts(left, table) or (right_is_required and expression_evaluation_aborts(right, table))
                    Ast::Expr.If(condition, then_value, else_value, _):
                        if expression_evaluation_aborts(condition, table):
                            true
                        else:
                            literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            if literal.known:
                                expression_aborts(then_value, table) if literal.value else expression_aborts(else_value, table)
                            else:
                                expression_aborts(then_value, table) and expression_aborts(else_value, table)
                    Ast::Expr.Match(scrutinee, arms, _):
                        expression_evaluation_aborts(scrutinee, table) or arms_all_terminate(scrutinee, arms, table)
                    Ast::Expr.Block(statements, value, _, _):
                        statements_terminate(statements, table) or expression_aborts(value, table)
                    Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                        expression_evaluation_aborts(object, table)
                    Ast::Expr.Index(object, index, _):
                        expression_evaluation_aborts(object, table) or expression_evaluation_aborts(index, table)
                    Ast::Expr.IndexN(object, indices, _):
                        expression_evaluation_aborts(object, table) or any index in indices where expression_evaluation_aborts(index, table)
                    Ast::Expr.Slice(object, low, high, _):
                        expression_evaluation_aborts(object, table) or expression_evaluation_aborts(low, table) or expression_evaluation_aborts(high, table)
                    Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                        any element in elements where expression_evaluation_aborts(element, table)
                    Ast::Expr.Catch(guarded, arms, line):
                        expression_catch_terminates(guarded, arms, table, line)
                    Ast::Expr.GetElse(guarded, _, _):
                        expression_evaluation_aborts(guarded, table)
                    Ast::Expr.Comprehension(_, iterable, condition, body, _, _):
                        if expression_evaluation_aborts(iterable, table):
                            true
                        elif not flow_iterable_is_provably_nonempty(iterable):
                            false
                        elif expression_evaluation_aborts(condition, table):
                            true
                        else:
                            condition_literal: (known: bool, value: bool) = expression_literal_bool(condition)
                            if condition_literal.known and not condition_literal.value:
                                false
                            elif condition is Ast::Expr.Absent or (condition_literal.known and condition_literal.value):
                                expression_evaluation_aborts(body, table)
                            else:
                                false
                    Ast::Expr.DictLit(entries, _):
                        any entry in entries where expression_evaluation_aborts(entry.key, table) or expression_evaluation_aborts(entry.value, table)
                    Ast::Expr.Construct(type_expression, fields, _):
                        expression_evaluation_aborts(type_expression, table) or any field in fields where expression_evaluation_aborts(field.value, table)
                    Ast::Expr.RecordUpdate(base, fields, _):
                        expression_evaluation_aborts(base, table) or any field in fields where expression_evaluation_aborts(field.value, table)
                    Ast::Expr.Refinement(base, predicate, _):
                        expression_evaluation_aborts(base, table) or expression_evaluation_aborts(predicate, table)
                    Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                        expression_aborts(inner, table)
                    _:                              false






        # Whether all arms of a match terminate AND the match is exhaustive — parity with
        # stage0, which only treats a `match` as a terminator when every reachable case is
        # covered (see `match_arms_exhaustive`). A match whose arms all return but that
        # still has an uncovered case can fall through at runtime, so stage0 rejects the
        # enclosing function with "may fall through without returning a value".
        def arms_all_terminate(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if arms.count == 0 or not progress_match_is_total(scrutinee, arms, table)
                arm_index: mutable usize = 0
                while arm_index < arms.count |arm_index, arms, scrutinee, table|:
                    arm: Ast::MatchArm = arms[arm_index]
                    guard: (known: bool, value: bool) = expression_literal_bool(arm.guard)
                    if progress_match_arm_reachable(scrutinee, arms, arm_index) and not (guard.known and not guard.value):
                        return false if not expression_evaluation_aborts(arm.guard, table) and not statements_terminate(arm.body, table)
                    arm_index <- arm_index + 1
                return true
