# @segment_agnostic grant restriction (stage0 segment_safety). A function decorated
# @segment_agnostic runs in an unknown ambient segment, so it may NOT grant Segment.Host,
# Segment.Guest, or Unsafe.SegmentMutation (whether via a `can ...:` block in its body or a
# signature grant) — segment establishment must go through a @segment_establishing entry thunk.
extend Semantic:
    private:
        def is_forbidden_segment_grant(effect: sview) -> bool:
            can Abort.Panic:
                return effect == "Segment.Host" or effect == "Segment.Guest" or effect == "Unsafe.SegmentMutation"

        def clause_grants_segment(clause: darray[sview]&) -> bool:
            can Abort.Panic:
                return any effect in clause where is_forbidden_segment_grant(effect)

        # Walk a function body flagging every `can ...:` block that grants a forbidden segment effect.
        def segment_grant_walk(statements: darray[Ast::Stmt], function_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SegmentAgnosticGrant, name: "", line: line, expected: "", actual: ""}) if kind == "can" and clause_grants_segment(clause)
                            table <- segment_grant_walk(body, function_line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- segment_grant_walk(then_body, function_line, table)
                            table <- segment_grant_walk(else_body, function_line, table)
                        Stmt.While(condition, while_body, line):
                            table <- segment_grant_walk(while_body, function_line, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- segment_grant_walk(for_body, function_line, table)
                        _:
                            pass

        def check_segment_agnostic_grant_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            is_agnostic: bool = any decorator in decorators where decorator.name == "segment_agnostic"
                            if is_agnostic:
                                # Signature grant (`... can[Segment.Host]`) is also forbidden.
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SegmentAgnosticGrant, name: "", line: line, expected: "", actual: ""}) if any effect in effects where is_forbidden_segment_grant(effect)
                                table <- segment_grant_walk(body, line, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_segment_agnostic_grant_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_segment_agnostic_grant_walk(scoped_body, table)
                        _:
                            pass

        def check_segment_agnostic_grant(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_segment_agnostic_grant_walk(file.top_decls, table)
