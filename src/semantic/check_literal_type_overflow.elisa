# Integer-literal range overflow on a typed declaration. A local `x: uN/iN = LITERAL` whose
# literal does not fit the declared bit-int type's [min,max] window is rejected ("integer literal
# V does not fit in T"). Pure syntactic: parse the declared bit-int type window (reusing
# bit_int_window) and check the integer-literal initializer.
extend Semantic:
    private:
        def literal_overflow_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_struct_type(type_expression)
                            window: (found: bool, low: i64, high: i64) = bit_int_window(type_name)
                            value_literal: (found: bool, value: i64) = where_signed_literal(value)
                            out_of_range: bool = window.found and value_literal.found and (value_literal.value < window.low or value_literal.value > window.high)
                            sign: sview = "neg" if value_literal.value < 0 else ""
                            magnitude: (known: bool, value: i64) = (true, value_literal.value) if value_literal.value >= 0 else linear_sub_safe(0, value_literal.value)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IntegerLiteralOverflow, name: "", line: line.line, expected: sign, actual: type_name, expected_count: magnitude.value.u32()}) if out_of_range and magnitude.known
                        Stmt.If(condition, then_body, else_body, line):
                            table <- literal_overflow_statements(then_body, table)
                            table <- literal_overflow_statements(else_body, table)
                        Stmt.While(condition, while_body, line):
                            table <- literal_overflow_statements(while_body, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- literal_overflow_statements(for_body, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- literal_overflow_statements(block_body, table)
                        _:
                            pass

        def check_literal_type_overflow(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- literal_overflow_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_literal_type_overflow(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_literal_type_overflow(scoped_body, table)
                        _:
                            pass
