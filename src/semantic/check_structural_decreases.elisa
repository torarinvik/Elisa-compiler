# Structural `decreases` on an enum parameter. `decreases t` claims each recursive call
# receives a STRUCTURALLY SMALLER value; the decidable way to see that is that the argument
# was bound by a match on `t` (or, transitively, on something bound from `t`) — a payload
# binder is always a proper sub-term of what it was destructured from.
#
#     def size(t: Tree) -> i64:
#         decreases t
#         match t:
#             Tree.Leaf(value: v):  return 1
#             Tree.Node(child: c):  return size(c) + 1     # `c` came out of `t`: smaller
#
# Passing `t` itself back is the non-terminating case stage0 rejects. Rule pinned against
# stage0 in both directions: recursing on a match binder (nested included) is ACCEPTED,
# recursing on the parameter is REJECTED, and a function with no `decreases` clause — or a
# non-recursive one — is never checked.
#
# This is the STRUCTURAL half of the termination obligation only. A numeric measure
# (`decreases n` on an integer) needs the arithmetic prover and is left to stage0.
extend Semantic:
    private:
        # Names a pattern BINDS, including nested variant/struct/tuple subpatterns.
        def decreases_pattern_bindings(pattern: Ast::Pattern, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        out.push(name)
                    Pattern.As(name, inner):
                        out.push(name)
                        for sub in inner |out|:
                            decreases_pattern_bindings(sub, out)
                    Pattern.TypeBind(type_name, binder):
                        out.push(binder)
                    Pattern.Variant(path, fields):
                        for sub in fields |out|:
                            decreases_pattern_bindings(sub, out)
                    Pattern.Struct(path, fields):
                        for sub in fields |out|:
                            decreases_pattern_bindings(sub, out)
                    Pattern.Field(selector, inner):
                        for sub in inner |out|:
                            decreases_pattern_bindings(sub, out)
                    Pattern.Tuple(elements):
                        for sub in elements |out|:
                            decreases_pattern_bindings(sub, out)
                    Pattern.Or(options):
                        for sub in options |out|:
                            decreases_pattern_bindings(sub, out)
                    _:
                        pass


        # Grow `smaller` with every name bound by a match whose SCRUTINEE is already known
        # smaller-or-equal (the parameter itself, or an earlier binder). Runs to a fixpoint
        # over the body so a match nested inside another match's arm contributes too.
        def decreases_collect_smaller(statements: darray[Ast::Stmt], destructurable: mutable darray[sview]&, smaller: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |destructurable, smaller|:
                    match statement:
                        Stmt.Match(scrutinee, arms, line):
                            scrutinee_name: sview = ident_name_of(scrutinee)
                            # The SUBJECT is destructurable but is NOT itself smaller --
                            # `size(t)` inside `match t:` is the non-terminating case. Only
                            # names BOUND OUT of a destructurable value are smaller.
                            destructures_smaller: bool = scrutinee_name != "" and (any d in destructurable where d == scrutinee_name)
                            for arm in arms |destructurable, smaller, destructures_smaller|:
                                if destructures_smaller:
                                    decreases_pattern_bindings(arm.pattern, smaller)
                                    decreases_pattern_bindings(arm.pattern, destructurable)
                                decreases_collect_smaller(arm.body, destructurable, smaller)
                        Stmt.If(condition, then_body, else_body, if_line):
                            decreases_collect_smaller(then_body, destructurable, smaller)
                            decreases_collect_smaller(else_body, destructurable, smaller)
                        Stmt.While(while_condition, while_body, while_line):
                            decreases_collect_smaller(while_body, destructurable, smaller)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            decreases_collect_smaller(block_body, destructurable, smaller)
                        _:
                            pass


        # Whether any RECURSIVE call passes something not known smaller in the decreasing
        # parameter's position. `position` is that parameter's index.
        def decreases_call_is_unproven(expression: Ast::Expr, own_name: sview, position: usize, smaller: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        if ident_name_of(callee) == own_name and arguments.count > position:
                            argument_name: sview = ident_name_of(arguments[position])
                            true return if not (any s in smaller where s == argument_name)
                        for argument in arguments |own_name, position, smaller|:
                            true return if decreases_call_is_unproven(argument, own_name, position, smaller)
                        return false
                    Expr.Binary(left, operator, right, line):
                        return decreases_call_is_unproven(left, own_name, position, smaller) or decreases_call_is_unproven(right, own_name, position, smaller)
                    Expr.Paren(inner, line):
                        return decreases_call_is_unproven(inner, own_name, position, smaller)
                    Expr.Unary(operator, operand, line):
                        return decreases_call_is_unproven(operand, own_name, position, smaller)
                    _:
                        return false


        def decreases_body_is_unproven(statements: darray[Ast::Stmt], own_name: sview, position: usize, smaller: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                true return if decreases_call_is_unproven(returned, own_name, position, smaller)
                        Stmt.Expr(expression, line):
                            true return if decreases_call_is_unproven(expression, own_name, position, smaller)
                        Stmt.VarDecl(name, type_expression, value, line):
                            true return if decreases_call_is_unproven(value, own_name, position, smaller)
                        Stmt.Assign(target, operator, value, line):
                            true return if decreases_call_is_unproven(value, own_name, position, smaller)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |own_name, position, smaller|:
                                true return if decreases_body_is_unproven(arm.body, own_name, position, smaller)
                        Stmt.If(condition, then_body, else_body, if_line):
                            true return if decreases_body_is_unproven(then_body, own_name, position, smaller)
                            true return if decreases_body_is_unproven(else_body, own_name, position, smaller)
                        Stmt.While(while_condition, while_body, while_line):
                            true return if decreases_body_is_unproven(while_body, own_name, position, smaller)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            true return if decreases_body_is_unproven(block_body, own_name, position, smaller)
                        _:
                            pass
                return false


        # The `decreases X` clause's subject name, or "".
        def decreases_subject(statements: darray[Ast::Stmt]) -> sview:
            can Memory.Allocate, Abort.Panic:
                found: mutable sview = sview("", 0, 0)
                for statement in statements |found|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            contract_kind: sview = kind
                            found <- ident_name_of(expression) if contract_kind == "decreases" and found == ""
                        _:
                            pass
                return found


        def check_structural_decreases_walk(declarations: darray[Ast::Decl], enum_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            subject: sview = decreases_subject(body)
                            continue if subject == ""
                            # The subject must be a parameter of ENUM type: that is what makes
                            # "bound by a match on it" a proof. A numeric measure is the
                            # arithmetic prover's job, not this check's.
                            position: mutable i64 = -1
                            probe: mutable usize = 0
                            for parameter in parameters |position, probe, subject, enum_names|:
                                annotated: sview = bare_type_name(parameter.type_expression)
                                is_enum: bool = any enum_name in enum_names where enum_name == annotated
                                position <- probe.i64() if parameter.name == subject and is_enum and position < 0
                                probe <- probe + 1
                            continue if position < 0
                            destructurable: mutable darray[sview] = [subject]
                            smaller: mutable darray[sview] = []
                            decreases_collect_smaller(body, destructurable, smaller)
                            unproven: bool = decreases_body_is_unproven(body, name, position.usize(), smaller)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StructuralDecreasesUnproven, name: name, line: line.line, expected: "", actual: ""}) if unproven
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_structural_decreases_walk(module_body, enum_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_structural_decreases_walk(scoped_body, enum_names, table)
                        _:
                            pass


        # Names of all declared enums, so the subject's type can be recognised.
        def collect_enum_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Enum(name, variants, is_const, storage_type, line):
                            out.push(name)
                        Decl.Module(module_name, module_body, module_line):
                            collect_enum_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_enum_type_names(scoped_body, out)
                        _:
                            pass

    public:
        def check_structural_decreases(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                enum_names: mutable darray[sview] = []
                collect_enum_type_names(declarations, enum_names)
                return if enum_names.count == 0
                table <- check_structural_decreases_walk(declarations, enum_names, table)
