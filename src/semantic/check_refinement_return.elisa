# Refinement-on-return proof obligation (interval analysis, sound subset).
#
# Stage0's prover discharges a refined return type `-> T is Law[lo, hi]` by proving the
# returned value lies in [lo, hi]; when it cannot, it emits "refinement on the return
# could not be proven". It DOES reason about bitmask bounds — `x & 0x7f` proves `<= 127`
# (fits `InRange[0, 127]`), but `x & 0x1ff` yields [0, 511], which does NOT fit [0, 127].
#
# Stage1 has no prover, so it ports the DECIDABLE, SOUND slice: when the return value is a
# bitmask `EXPR & MASK` (optionally `(EXPR >> k) & MASK`), its range is EXACTLY [0, MASK].
# For a range-shaped law (`self >= lo and self <= hi`) with integer-literal bounds, emit
# iff that exact interval is NOT contained in [lo, hi] (MASK > hi, or lo > 0). This can
# only fire when the value provably escapes the refinement — never a false positive — so
# it strictly reduces the ensure/refinement underfire set without risking overfire. Return
# values the analysis cannot bound (calls, arithmetic, plain idents) are left unreported
# (a sound miss; a fuller interval engine would extend value_upper_bound / value_lower_bound).
extend Semantic:
    private:
        # Whether a law predicate has the range shape `self >= P and self <= Q` (the
        # `InRange`/`Bounded` convention), so its two call args are [lo, hi] positionally.
        # Whether an expression contains a VARIABLE * VARIABLE product (neither operand a
        # constant literal) — the shape stage0's default prover cannot bound.
        def return_expr_has_var_product(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Star:
                            left_const: (found: bool, value: i64) = signed_int_literal(left)
                            right_const: (found: bool, value: i64) = signed_int_literal(right)
                            true return if not left_const.found and not right_const.found
                        true return if return_expr_has_var_product(left)
                        return return_expr_has_var_product(right)
                    Expr.Unary(operator, operand, line):
                        return return_expr_has_var_product(operand)
                    Expr.Paren(inner, line):
                        return return_expr_has_var_product(inner)
                    Expr.If(condition, then_expression, else_expression, line):
                        true return if return_expr_has_var_product(then_expression)
                        return return_expr_has_var_product(else_expression)
                    _:
                        return false

        def law_predicate_is_range_shape(predicate: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match predicate:
                    Expr.Binary(left, operator, right, line):
                        conjunction: bool = operator == TokenKind.And
                        lower_ok: bool = comparison_on_self(left, TokenKind.GtEq)
                        upper_ok: bool = comparison_on_self(right, TokenKind.LtEq)
                        conjunction and lower_ok and upper_ok
                    _: false

        # Whether EXPRESSION is `self <op> _` — a bound on the refinement subject.
        def comparison_on_self(expression: Ast::Expr, operator_wanted: TokenKind) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Binary(left, operator, right, line):
                        left_is_self: bool = match left:
                            Expr.Ident(name, ident_line): name == "self"
                            _: false
                        operator == operator_wanted and left_is_self
                    _: false

        # The exact upper bound of a bitmask value `EXPR & MASK` (MASK an integer literal),
        # optionally through a shift/paren. Returns (found, mask). `x & MASK` is exactly
        # [0, MASK]; this is the only value form the sound subset bounds.
        def mask_upper_bound(expression: Ast::Expr) -> (found: bool, mask: i64):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, line):
                        return mask_upper_bound(inner)
                    Expr.Binary(left, operator, right, line):
                        is_and: bool = operator == TokenKind.Ampersand
                        right_mask: i64 = int_literal_or_negative(right) if is_and else (-1)
                        left_mask: i64 = int_literal_or_negative(left) if is_and else (-1)
                        chosen: i64 = right_mask if right_mask >= 0 else left_mask
                        usable_mask: i64 = chosen if chosen >= 0 else 0
                        return (chosen >= 0, usable_mask)
                    _:
                        return (false, 0)

        # The signed bit-width of the value a sign-extension idiom `(X << k) >> k` operates
        # on: from an explicit width cast (`.i32()`) or a width-typed parameter. 0 = unknown.
        def signext_width(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]) -> i64:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        return signext_width(inner, parameters)
                    Expr.Call(callee, call_arguments, call_argument_names, call_line):
                        if call_arguments.count == 0:
                            match callee:
                                Expr.Field(cast_receiver, cast_method, cast_line):
                                    8 return if cast_method == "i8" or cast_method == "u8"
                                    16 return if cast_method == "i16" or cast_method == "u16"
                                    32 return if cast_method == "i32" or cast_method == "u32"
                                    64 return if cast_method == "i64" or cast_method == "u64" or cast_method == "usize" or cast_method == "isize"
                                _:
                                    pass
                        return 0
                    Expr.Ident(name, ident_line):
                        for parameter in parameters |name|:
                            continue if parameter.name != name
                            return brp_int_width(bare_type_name_through_ref(parameter.type_expression))
                        return 0
                    _:
                        return 0

        # Strip enclosing parentheses from an expression.
        def signext_unwrap_paren(expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Paren(inner, paren_line): signext_unwrap_paren(inner)
                    _: expression

        # 2^exponent for 0 <= exponent < 63 (guarded caller keeps exponent small).
        def signext_pow2(exponent: i64) -> i64:
            can Abort.Panic:
                result: mutable i64 = 1
                step: mutable i64 = 0
                while step < exponent |result, step, exponent|:
                    result <- result * 2
                    step <- step + 1
                return result

        # The integer value of EXPRESSION, or -1 when it is not a non-negative integer
        # literal (masks in this corpus are non-negative hex/decimal constants).
        def int_literal_or_negative(expression: Ast::Expr) -> i64:
            can Abort.Panic:
                return match expression:
                    Expr.IntLit(value): value
                    _: (-1)

        # A SIGNED integer literal (`5`, or `-15` = Unary(Minus, IntLit)), with a found flag
        # so negative bounds/constants are distinguishable from non-literals.
        def signed_int_literal(expression: Ast::Expr) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.IntLit(value):
                        return (true, value)
                    Expr.Paren(inner, line):
                        return signed_int_literal(inner)
                    Expr.Unary(operator, operand, line):
                        inner_literal: (found: bool, value: i64) = signed_int_literal(operand)
                        return (inner_literal.found and operator == TokenKind.Minus, 0 - inner_literal.value)
                    _:
                        return (false, 0)

        # Extract a range-shaped refinement `T is Law[lo, hi]` on a return type: the law
        # name plus its two integer-literal bounds. Returns found=false otherwise.
        def return_refinement_bounds(return_type: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match return_type:
                    Expr.Binary(base, operator, right, line):
                        return refinement_index_bounds(right, law_names, law_predicates) if operator == TokenKind.Is else (false, 0, 0)
                    _:
                        return (false, 0, 0)

        # From the `Law[lo, hi]` application: confirm the law is range-shaped and both args
        # are integer literals, then return their values.
        def refinement_index_bounds(application: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match application:
                    Expr.IndexN(object, arguments, line):
                        law_name: sview = ident_name_of(object)
                        lo_literal: (found: bool, value: i64) = signed_int_literal(arguments[0]) if arguments.count == 2 else (false, 0)
                        hi_literal: (found: bool, value: i64) = signed_int_literal(arguments[1]) if arguments.count == 2 else (false, 0)
                        usable: bool = arguments.count == 2 and lo_literal.found and hi_literal.found and law_shape(law_name, law_names, law_predicates) == "range"
                        return (usable, lo_literal.value, hi_literal.value)
                    Expr.Index(single_object, single_index, single_line):
                        # A single-argument refinement `Law[k]` over a one-sided law:
                        # `self >= k` → [k, i64_max]; `self <= k` → [i64_min, k].
                        single_name: sview = ident_name_of(single_object)
                        shape: sview = law_shape(single_name, law_names, law_predicates)
                        bound_literal: (found: bool, value: i64) = signed_int_literal(single_index)
                        lower_usable: bool = shape == "lower" and bound_literal.found
                        upper_usable: bool = shape == "upper" and bound_literal.found
                        low: i64 = bound_literal.value if lower_usable else (-9223372036854775807 - 1)
                        high: i64 = bound_literal.value if upper_usable else 9223372036854775807
                        return (lower_usable or upper_usable, low, high)
                    _:
                        return (false, 0, 0)

        # The bound shape of a law PREDICATE: "range" (`self >= lo and self <= hi`), "lower"
        # (`self >= k`), "upper" (`self <= k`), or "" (unrecognized).
        def predicate_shape(predicate: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                "range" return if law_predicate_is_range_shape(predicate)
                "lower" return if comparison_on_self(predicate, TokenKind.GtEq)
                "upper" return if comparison_on_self(predicate, TokenKind.LtEq)
                return sview("", 0, 0)

        # The bound shape of the named law, or "" when unregistered/unrecognized.
        def law_shape(law_name: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                while probe < law_names.count |probe: usize = 0|:
                    predicate_shape(law_predicates[probe]) return if law_names[probe] == law_name
                    probe <- probe + 1
                return sview("", 0, 0)

        # Whether an expression contains a bitwise operator (`&` `|` `^` `<<` `>>`) — the
        # value shapes stage0's default prover declines to bound.
        def expression_has_bitwise(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        bitwise: bool = operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
                        return bitwise or expression_has_bitwise(left) or expression_has_bitwise(right)
                    Expr.Paren(inner, line):
                        return expression_has_bitwise(inner)
                    Expr.Unary(operator, operand, line):
                        return expression_has_bitwise(operand)
                    _:
                        return false

        # A DEPENDENT range window `Bounded[CONST, VAR]` (`-> i64 is Bounded[0, limit]`):
        # the lower bound is a constant, the upper a parameter. found=false otherwise.
        def dependent_return_window(return_type: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi_var: sview):
            can Memory.Allocate, Abort.Panic:
                match return_type:
                    Expr.Binary(base, operator, application, line):
                        (false, 0, sview("", 0, 0)) return if operator != TokenKind.Is
                        match application:
                            Expr.IndexN(law_object, law_arguments, law_line):
                                law_name: sview = ident_name_of(law_object)
                                (false, 0, sview("", 0, 0)) return if law_arguments.count != 2 or law_shape(law_name, law_names, law_predicates) != "range"
                                lo_literal: (found: bool, value: i64) = signed_int_literal(law_arguments[0])
                                hi_name: sview = ident_name_of(law_arguments[1])
                                (true, lo_literal.value, hi_name) return if lo_literal.found and hi_name != ""
                                return (false, 0, sview("", 0, 0))
                            _:
                                return (false, 0, sview("", 0, 0))
                    _:
                        return (false, 0, sview("", 0, 0))


        # The refinement window of a PARAM annotation, resolving named aliases
        # (`a: Small` with `type Small = i64 is Bounded[2, 10]`).
        def param_refinement_window(type_expression: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, ret_alias_names: darray[sview]&, ret_alias_bases: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                direct: (found: bool, lo: i64, hi: i64) = return_refinement_bounds(type_expression, law_names, law_predicates)
                direct return if direct.found
                alias_name: sview = ident_name_of(type_expression)
                (false, 0, 0) return if alias_name == ""
                slot: mutable i64 = -1
                probe: mutable usize = 0
                while probe < ret_alias_names.count |slot, probe, alias_name, ret_alias_names|:
                    slot <- probe.i64() if ret_alias_names[probe] == alias_name and slot < 0
                    probe <- probe + 1
                (false, 0, 0) return if slot < 0
                return return_refinement_bounds(ret_alias_bases[slot.usize()], law_names, law_predicates)


        # The RANGE of a return expression over the parameter windows: affine +/- combine,
        # products take corner extremes; a division, cast, call, or windowless leaf makes
        # the range UNKNOWN (kind 0). kind 1 = [lo, hi].
        def return_expr_range(expression: Ast::Expr, parameters: darray[Ast::ParamDecl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, ret_alias_names: darray[sview]&, ret_alias_bases: darray[Ast::Expr]&, rr_struct_names: darray[sview]&, rr_field_starts: darray[usize]&, rr_field_counts: darray[usize]&, rr_field_names: darray[sview]&, rr_field_types: darray[Ast::Expr]&, rr_fn_names: darray[sview]&, rr_fn_lo: darray[i64]&, rr_fn_hi: darray[i64]&, req_names: darray[sview]&, req_lo: darray[i64]&, req_hi: darray[i64]&, depth: u32) -> (kind: i64, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                (0, 0, 0) return if depth > 12
                match expression:
                    Expr.IntLit(value):
                        return (1, value, value)
                    Expr.Paren(inner, line):
                        return return_expr_range(inner, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, depth + 1)
                    Expr.Ident(name, line):
                        # A two-sided window in req_names (a requires-bounded param OR a
                        # carried local whose declared-init interval was recorded) — checked
                        # first so a non-parameter local (`r = a if c else b`) resolves.
                        ident_req_probe: mutable usize = 0
                        ident_req_slot: mutable i64 = -1
                        while ident_req_probe < req_names.count |ident_req_probe, ident_req_slot, name, req_names|:
                            ident_req_slot <- ident_req_probe.i64() if req_names[ident_req_probe] == name and ident_req_slot < 0
                            ident_req_probe <- ident_req_probe + 1
                        (1, req_lo[ident_req_slot.usize()], req_hi[ident_req_slot.usize()]) return if ident_req_slot >= 0
                        for parameter in parameters |name, law_names, law_predicates, ret_alias_names, ret_alias_bases, req_names, req_lo, req_hi|:
                            continue if parameter.name != name
                            window: (found: bool, lo: i64, hi: i64) = param_refinement_window(parameter.type_expression, law_names, law_predicates, ret_alias_names, ret_alias_bases)
                            (1, window.lo, window.hi) return if window.found
                            # An unrefined param may still be two-sided-bounded by the
                            # function's own `requires` clauses.
                            req_probe: mutable usize = 0
                            req_slot: mutable i64 = -1
                            while req_probe < req_names.count |req_probe, req_slot, name, req_names|:
                                req_slot <- req_probe.i64() if req_names[req_probe] == name and req_slot < 0
                                req_probe <- req_probe + 1
                            (1, req_lo[req_slot.usize()], req_hi[req_slot.usize()]) return if req_slot >= 0
                            return (0, 0, 0)
                        return (0, 0, 0)
                    Expr.Unary(operator, operand, line):
                        (0, 0, 0) return if operator != TokenKind.Minus
                        inner_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(operand, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, depth + 1)
                        (0, 0, 0) return if inner_range.kind != 1
                        return (1, 0 - inner_range.hi, 0 - inner_range.lo)
                    Expr.Binary(left, operator, right, line):
                        left_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(left, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, depth + 1)
                        right_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(right, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, depth + 1)
                        # BITMASK `X & MASK` (MASK a non-negative literal) is EXACTLY
                        # [0, MASK] regardless of X's own range — stage0's default prover
                        # bounds it the same way (`x & 0x7f` proves <= 127).
                        if operator == TokenKind.Ampersand:
                            left_mask_literal: (found: bool, value: i64) = signed_int_literal(left)
                            right_mask_literal: (found: bool, value: i64) = signed_int_literal(right)
                            (1, 0, right_mask_literal.value) return if right_mask_literal.found and right_mask_literal.value >= 0
                            (1, 0, left_mask_literal.value) return if left_mask_literal.found and left_mask_literal.value >= 0
                            return (0, 0, 0)
                        # SIGN-EXTENSION idiom `(X << k) >> k` on a W-bit signed value keeps the
                        # low (W-k) bits sign-extended: range [-2^(W-1-k), 2^(W-1-k)-1]. stage0
                        # proves this exactly; a bare/other shift stays kind 0 (unboundable).
                        if operator == TokenKind.RShift:
                            shift_amount: (found: bool, value: i64) = signed_int_literal(right)
                            if shift_amount.found and shift_amount.value > 0:
                                match signext_unwrap_paren(left):
                                    Expr.Binary(sx_left, sx_operator, sx_right, sx_line):
                                        if sx_operator == TokenKind.LShift:
                                            up_amount: (found: bool, value: i64) = signed_int_literal(sx_right)
                                            width: i64 = signext_width(sx_left, parameters) if up_amount.found and up_amount.value == shift_amount.value else 0
                                            if width > 0 and shift_amount.value < width:
                                                half: i64 = signext_pow2(width - 1 - shift_amount.value)
                                                return (1, 0 - half, half - 1)
                                    _:
                                        pass
                            return (0, 0, 0)
                        # MOD is decidable even with an unknown-but-unsigned base.
                        if operator == TokenKind.Percent:
                            mod_divisor0: (found: bool, value: i64) = signed_int_literal(right)
                            (0, 0, 0) return if not mod_divisor0.found or mod_divisor0.value <= 0
                            span0: i64 = mod_divisor0.value - 1
                            (1, 0, span0) return if left_range.kind == 1 and left_range.lo >= 0
                            (1, 0 - span0, span0) return if left_range.kind == 1
                            (1, 0, span0) return if return_base_is_unsigned_param(left, parameters)
                            return (0, 0, 0)
                        (0, 0, 0) return if left_range.kind != 1 or right_range.kind != 1
                        (1, left_range.lo + right_range.lo, left_range.hi + right_range.hi) return if operator == TokenKind.Plus
                        (1, left_range.lo - right_range.hi, left_range.hi - right_range.lo) return if operator == TokenKind.Minus
                        if operator == TokenKind.Star:
                            c1: i64 = left_range.lo * right_range.lo
                            c2: i64 = left_range.lo * right_range.hi
                            c3: i64 = left_range.hi * right_range.lo
                            c4: i64 = left_range.hi * right_range.hi
                            product_min: mutable i64 = c1
                            product_max: mutable i64 = c1
                            product_min <- c2 if c2 < product_min
                            product_min <- c3 if c3 < product_min
                            product_min <- c4 if c4 < product_min
                            product_max <- c2 if c2 > product_max
                            product_max <- c3 if c3 > product_max
                            product_max <- c4 if c4 > product_max
                            return (1, product_min, product_max)
                        # DIVISION by a positive constant is monotone under truncation.
                        if operator == TokenKind.Slash:
                            divisor_const: bool = right_range.lo == right_range.hi and right_range.lo > 0
                            (1, left_range.lo / right_range.lo, left_range.hi / right_range.lo) return if divisor_const
                            return (0, 0, 0)
                        return (0, 0, 0)
                    # A CALL to a function whose RETURN type is refined takes the
                    # callee's window (`return low_byte(x)` with `-> i64 is
                    # Bounded[0, 127]`); module-qualified callees resolve by tail name.
                    # A WIDENING unsigned cast (`rack.usize()`, `.u64()`) preserves the
                    # receiver's range.
                    Expr.Call(callee, arguments, argument_names, call_line):
                        if arguments.count == 0:
                            match callee:
                                Expr.Field(cast_receiver, cast_method, cast_line):
                                    widening: bool = cast_method == "usize" or cast_method == "u64"
                                    if widening:
                                        receiver_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(cast_receiver, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, depth + 1)
                                        (1, receiver_range.lo, receiver_range.hi) return if receiver_range.kind == 1 and receiver_range.lo >= 0
                                _:
                                    pass
                        called: sview = return_callee_tail_name(callee)
                        (0, 0, 0) return if called == ""
                        fn_probe: mutable usize = 0
                        fn_slot: mutable i64 = -1
                        while fn_probe < rr_fn_names.count |fn_probe, fn_slot, called, rr_fn_names|:
                            fn_slot <- fn_probe.i64() if rr_fn_names[fn_probe] == called and fn_slot < 0
                            fn_probe <- fn_probe + 1
                        (0, 0, 0) return if fn_slot < 0
                        return (1, rr_fn_lo[fn_slot.usize()], rr_fn_hi[fn_slot.usize()])
                    # INDEXING a container whose ELEMENT type is refined yields the
                    # element window (`xs[i]` with `darray[u32 is UB[0, 127]]`).
                    Expr.Index(container, index_argument, container_line):
                        container_name: sview = ident_name_of(container)
                        (0, 0, 0) return if container_name == ""
                        for parameter in parameters |container_name, law_names, law_predicates, ret_alias_names, ret_alias_bases|:
                            continue if parameter.name != container_name
                            element: Ast::Expr = container_element_annotation(parameter.type_expression)
                            element_window: (found: bool, lo: i64, hi: i64) = param_refinement_window(element, law_names, law_predicates, ret_alias_names, ret_alias_bases)
                            (1, element_window.lo, element_window.hi) return if element_window.found
                            return (0, 0, 0)
                        return (0, 0, 0)
                    # A struct FIELD access takes its window from the field's refined
                    # annotation (`d.sdst` with `sdst: mutable u32 is UB[0, 127]`).
                    Expr.Field(object, field, field_line):
                        base: sview = ident_name_of(object)
                        (0, 0, 0) return if base == ""
                        for parameter in parameters |base, field, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types|:
                            continue if parameter.name != base
                            struct_name: sview = erasure_base_type_name(parameter.type_expression)
                            member: (found: bool, annotation: Ast::Expr) = struct_field_annotation(struct_name, field, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types)
                            (0, 0, 0) return if not member.found
                            field_window: (found: bool, lo: i64, hi: i64) = param_refinement_window(field_annotation_base(member.annotation), law_names, law_predicates, ret_alias_names, ret_alias_bases)
                            (1, field_window.lo, field_window.hi) return if field_window.found
                            return (0, 0, 0)
                        return (0, 0, 0)
                    Expr.If(condition, then_expression, else_expression, if_line):
                        # A ternary `a if cond else b` is the UNION of its branch ranges: the
                        # result is one of them, so [min lo, max hi]. Both must be bounded.
                        then_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(then_expression, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, depth + 1)
                        else_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(else_expression, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, depth + 1)
                        u_lo: i64 = then_range.lo if then_range.lo < else_range.lo else else_range.lo
                        u_hi: i64 = then_range.hi if then_range.hi > else_range.hi else else_range.hi
                        (1, u_lo, u_hi) return if then_range.kind == 1 and else_range.kind == 1
                        return (0, 0, 0)
                    _:
                        return (0, 0, 0)


        # Carry top-level locals `r = <expr>` with a computable bounded range into req_names,
        # so a later `return r` (or refined-arg call) against a refined type is judged. Kept
        # in its own function so its scratch range does not overlap the caller's req-building
        # containers (region stack budget). Excludes `<-`-reassigned / address-taken locals.
        def collect_carried_locals(body: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, ret_alias_names: darray[sview]&, ret_alias_bases: darray[Ast::Expr]&, rr_struct_names: darray[sview]&, rr_field_starts: darray[usize]&, rr_field_counts: darray[usize]&, rr_field_names: darray[sview]&, rr_field_types: darray[Ast::Expr]&, rr_fn_names: darray[sview]&, rr_fn_lo: darray[i64]&, rr_fn_hi: darray[i64]&, req_names: mutable darray[sview]&, req_lo: mutable darray[i64]&, req_hi: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |req_names, req_lo, req_hi|:
                    match statement:
                        Stmt.VarDecl(carry_name, carry_type, carry_value, carry_line):
                            carry_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(carry_value, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, req_names, req_lo, req_hi, 0)
                            if carry_range.kind == 1 and not body_reassigns(body, carry_name):
                                req_names.push(carry_name)
                                req_lo.push(carry_range.lo)
                                req_hi.push(carry_range.hi)
                        _:
                            pass

        # Whether PARAM `name` has a signed-integer declared type (through &/mutable).
        def refret_param_is_signed(parameters: darray[Ast::ParamDecl], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |name|:
                    continue if parameter.name != name
                    return si_is_signed_int_name(bare_type_name_through_ref(parameter.type_expression))
                return false

        # `subject >= K` -> (true, K); `subject > K` -> (true, K+1); recurse through `and`/paren.
        def refret_lower_from_predicate(predicate: Ast::Expr, subject: sview) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                match predicate:
                    Expr.Paren(inner, paren_line):
                        return refret_lower_from_predicate(inner, subject)
                    Expr.Binary(left, operator, right, binary_line):
                        if operator == TokenKind.And:
                            left_fact: (found: bool, value: i64) = refret_lower_from_predicate(left, subject)
                            left_fact return if left_fact.found
                            return refret_lower_from_predicate(right, subject)
                        (false, 0) return if ident_name_of(left) != subject
                        bound_literal: (found: bool, value: i64) = signed_int_literal(right)
                        (false, 0) return if not bound_literal.found
                        (true, bound_literal.value) return if operator == TokenKind.GtEq
                        (true, bound_literal.value + 1) return if operator == TokenKind.Gt
                        return (false, 0)
                    _:
                        return (false, 0)

        # The tightest lower-bound fact `subject >= K` from a `requires`/`assert` contract in
        # BODY (the block that holds the return). found=false when no lower bound is stated.
        def refret_lower_fact(body: darray[Ast::Stmt], subject: sview) -> (found: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                best_found: mutable bool = false
                best_value: mutable i64 = 0
                for statement in body |best_found, best_value, subject|:
                    match statement:
                        Stmt.Contract(kind, expression, line):
                            continue if kind != "requires" and kind != "assert"
                            candidate: (found: bool, value: i64) = refret_lower_from_predicate(expression, subject)
                            if candidate.found and (not best_found or candidate.value > best_value):
                                best_found <- true
                                best_value <- candidate.value
                        _:
                            pass
                return (best_found, best_value)

        def check_refinement_return_function(return_type: Ast::Expr, parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt], function_name: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, ret_alias_names: darray[sview]&, ret_alias_bases: darray[Ast::Expr]&, rr_struct_names: darray[sview]&, rr_field_starts: darray[usize]&, rr_field_counts: darray[usize]&, rr_field_names: darray[sview]&, rr_field_types: darray[Ast::Expr]&, rr_fn_names: darray[sview]&, rr_fn_lo: darray[i64]&, rr_fn_hi: darray[i64]&, enable_smt: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Resolve the return refinement window THROUGH a refine-alias return type
                # (`-> Small` where `type Small = i64 is Bounded[2, 10]`), not only a direct
                # `i64 is Law` annotation — param_refinement_window handles both.
                # Window resolves through: parametric `Law[lo,hi]` + refine-alias
                # (param_refinement_window), else a NO-ARG single-bound law like `NonNeg`
                # (`self >= 0` -> [0, max]) / `Positive` (`self > 0` -> [1, max]) via
                # refined_param_bounds' subject_interval.
                alias_bounds: (found: bool, lo: i64, hi: i64) = param_refinement_window(return_type, law_names, law_predicates, ret_alias_names, ret_alias_bases)
                bounds: (found: bool, lo: i64, hi: i64) = alias_bounds if alias_bounds.found else refined_param_bounds(return_type, law_names, law_predicates)
                single_bound_window: bool = not alias_bounds.found and bounds.found
                dependent: (found: bool, lo: i64, hi_var: sview) = dependent_return_window(return_type, law_names, law_predicates) if not bounds.found else (false, 0, sview("", 0, 0))
                return if not bounds.found and not dependent.found
                # A SINGLE straight-line return is additionally judged by RANGE over the
                # parameter windows: an out-of-window or unboundable (division, cast,
                # windowless leaf) result is unproven. Branchy bodies may prove the
                # window via guards, so only the straight-line form is decided.
                # Requires-derived two-sided windows for unrefined params.
                req_all_names: mutable darray[sview] = []
                req_all_has_lo: mutable darray[bool] = []
                req_all_lo: mutable darray[i64] = []
                req_all_has_hi: mutable darray[bool] = []
                req_all_hi: mutable darray[i64] = []
                for parameter in parameters |req_all_names, req_all_has_lo, req_all_lo, req_all_has_hi, req_all_hi|:
                    req_all_names.push(parameter.name)
                    req_all_has_lo.push(false)
                    req_all_lo.push(0)
                    req_all_has_hi.push(false)
                    req_all_hi.push(0)
                for statement in body |req_all_names, req_all_has_lo, req_all_lo, req_all_has_hi, req_all_hi|:
                    match statement:
                        Stmt.Contract(req_kind, req_expression, req_line):
                            lin_collect_fact(req_expression, req_all_names, req_all_has_lo, req_all_lo, req_all_has_hi, req_all_hi) if req_kind == "requires"
                        _:
                            pass
                req_names: mutable darray[sview] = []
                req_lo: mutable darray[i64] = []
                req_hi: mutable darray[i64] = []
                floor_names: mutable darray[sview] = []
                floor_values: mutable darray[i64] = []
                req_index: mutable usize = 0
                while req_index < req_all_names.count |req_names, req_lo, req_hi, floor_names, floor_values, req_index, req_all_names, req_all_has_lo, req_all_lo, req_all_has_hi, req_all_hi|:
                    if req_all_has_lo[req_index] and req_all_has_hi[req_index]:
                        req_names.push(req_all_names[req_index])
                        req_lo.push(req_all_lo[req_index])
                        req_hi.push(req_all_hi[req_index])
                    if req_all_has_lo[req_index]:
                        floor_names.push(req_all_names[req_index])
                        floor_values.push(req_all_lo[req_index])
                    req_index <- req_index + 1
                # Carried-local intervals are EXACT (not requires-derived), so unlike req_*
                # windows they are consulted in DEFAULT mode too. Kept in their own arrays.
                carry_names: mutable darray[sview] = []
                carry_lo: mutable darray[i64] = []
                carry_hi: mutable darray[i64] = []
                collect_carried_locals(body, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, carry_names, carry_lo, carry_hi)
                straight_return: mutable Ast::Expr = Ast::Expr.Absent
                return_count: mutable usize = 0
                branchy: mutable bool = false
                for statement in body |straight_return, return_count, branchy|:
                    match statement:
                        Stmt.Return(value, straight_line):
                            return_count <- return_count + 1
                            straight_return <- returned2 if value is returned2
                        Stmt.If(condition, then_body, else_body, if_line):
                            branchy <- true
                        Stmt.While(condition, while_body, while_line):
                            branchy <- true
                        Stmt.Match(scrutinee, arms, match_line):
                            branchy <- true
                        Stmt.Block(kind2, clause2, binding2, block_body2, block_line2):
                            branchy <- true
                        _:
                            pass
                for statement in body |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                # Bitwise-valued returns are judged by the interval engine, not
                                # blanket-warned: `return_expr_range` bounds a mask (`x & MASK` =
                                # [0, MASK]) and the sign-extension idiom (`(x << k) >> k`) — both
                                # of which stage0's default prover proves — while a bare/other
                                # shift (`x >> k`, `x | 1`) stays kind 0 (unboundable) and fires
                                # through the kind-zero path below, matching stage0's warn.
                                range_unproven: mutable bool = false
                                # DEPENDENT window: only a constant return provably at or
                                # below the upper-bound variable's requires-derived floor
                                # fits (`return 0` into [0, limit] with limit > 0); any
                                # non-constant return is unproven.
                                if dependent.found and return_count == 1 and not branchy:
                                    dep_literal: (found: bool, value: i64) = signed_int_literal(returned)
                                    dep_floor_slot: mutable i64 = -1
                                    dep_probe: mutable usize = 0
                                    while dep_probe < floor_names.count |dep_probe, dep_floor_slot, floor_names|:
                                        dep_floor_slot <- dep_probe.i64() if floor_names[dep_probe] == dependent.hi_var and dep_floor_slot < 0
                                        dep_probe <- dep_probe + 1
                                    dep_floor_known: bool = dep_floor_slot >= 0
                                    dep_ok: bool = dep_literal.found and dep_literal.value >= dependent.lo and dep_floor_known and dep_literal.value <= floor_values[dep_floor_slot.usize()]
                                    range_unproven <- not dep_ok
                                if bounds.found and return_count == 1 and not branchy:
                                    # Requires-derived windows are an SMT-tier fact:
                                    # stage0's basic prover does not consume `requires`
                                    # bounds for the return refinement (a fitting product
                                    # over them is still flagged without -smt).
                                    smt_req_names: mutable darray[sview] = [cn for cn in carry_names]
                                    smt_req_lo: mutable darray[i64] = [cl for cl in carry_lo]
                                    smt_req_hi: mutable darray[i64] = [ch for ch in carry_hi]
                                    if enable_smt:
                                        smt_req_names.extend(req_names)
                                        smt_req_lo.extend(req_lo)
                                        smt_req_hi.extend(req_hi)
                                    value_range: (kind: i64, lo: i64, hi: i64) = return_expr_range(returned, parameters, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, smt_req_names, smt_req_lo, smt_req_hi, 0)
                                    out_of_window: bool = value_range.kind == 1 and (value_range.lo < bounds.lo or value_range.hi > bounds.hi)
                                    # Interval arithmetic is exact only when each variable
                                    # occurs ONCE; under -smt a correlated expression
                                    # (`a*(256-w) + b*w`) may be provable tighter, so a
                                    # loose out-of-window verdict is not reported there.
                                    repeated: bool = return_expr_repeats_variable(returned)
                                    # For a single-bound window, an un-computable (kind 0) leaf
                                    # is NOT reported (stage0 may prove a literal `.len` /
                                    # forall-guarded index against the half-open side); only a
                                    # computed out-of-window violation is.
                                    kind_zero_unproven: bool = value_range.kind == 0 and not single_bound_window
                                    range_unproven <- kind_zero_unproven or (out_of_window and not (enable_smt and repeated))
                                    # stage0's DEFAULT (non-SMT) prover cannot bound a
                                    # VARIABLE*VARIABLE product (only `x * const` scaling), so
                                    # it reports a fitting product-of-refined return as unproven
                                    # — the interval engine proves it, matching stage0 only with
                                    # -smt. Mirror the bitwise rule: warn in default mode.
                                    range_unproven <- true if not enable_smt and return_expr_has_var_product(returned)
                                    # A PLAIN unrefined-param return stays with the
                                    # dedicated requires-mention rule elsewhere.
                                    range_unproven <- false if ident_name_of(returned) != "" and value_range.kind == 0
                                    # EXCEPT: a plain SIGNED-int param returned into a law with a
                                    # non-negative lower bound (lo >= 0) is unprovable — a signed
                                    # value may be < lo — unless a requires/assert fact establishes
                                    # `p >= lo`. Unsigned params get lo=0 free, so signed only.
                                    # stage0 rejects (witness p=lo-1); the suppression above erased
                                    # this, so re-flag the definite lower-bound violation.
                                    # Gated to non-SMT: under -smt a boolean-hypothesis
                                    # (`implies`/disjunction) may entail the lower bound in a form
                                    # this crude `p >= K` fact-scan can't see; defer to that tier.
                                    signed_return_name: sview = ident_name_of(returned)
                                    if not enable_smt and signed_return_name != "" and value_range.kind == 0 and bounds.lo >= 0 and refret_param_is_signed(parameters, signed_return_name):
                                        signed_lower_fact: (found: bool, value: i64) = refret_lower_fact(body, signed_return_name)
                                        range_unproven <- true if not (signed_lower_fact.found and signed_lower_fact.value >= bounds.lo)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementReturnNotProven, name: function_name, line: line, expected: "", actual: ""}) if range_unproven
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- check_refinement_return_function(return_type, parameters, block_body, function_name, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, enable_smt, table)
                        _:
                            pass

        def collect_laws(declarations: darray[Ast::Decl], law_names: mutable darray[sview]&, law_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Law(name, predicate, line):
                            law_names.push(name)
                            law_predicates.push(predicate)
                        Decl.Module(module_name, module_body, module_line):
                            collect_laws(module_body, law_names, law_predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_laws(scoped_body, law_names, law_predicates)
                        _:
                            pass

        def check_refinement_return_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, ret_alias_names: darray[sview]&, ret_alias_bases: darray[Ast::Expr]&, rr_struct_names: darray[sview]&, rr_field_starts: darray[usize]&, rr_field_counts: darray[usize]&, rr_field_names: darray[sview]&, rr_field_types: darray[Ast::Expr]&, rr_fn_names: darray[sview]&, rr_fn_lo: darray[i64]&, rr_fn_hi: darray[i64]&, enable_smt: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- check_refinement_return_function(present_return_type, parameters, body, function_name, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, enable_smt, table) if return_type is present_return_type
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_refinement_return_walk(module_body, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, enable_smt, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_refinement_return_walk(scoped_body, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, enable_smt, table)
                        _:
                            pass

        # --- Argument-site refinement checking (sound interval containment) ---
        # For every refined function parameter, record (name, param-index, lo, hi). At a
        # call, an argument whose EXACT interval (a literal, or a refined local/param whose
        # bounds are known) provably escapes the target parameter's [lo, hi] cannot satisfy
        # the refinement — stage0 emits "refinement on argument N could not be proven". The
        # exact-interval requirement makes `escape ⇒ emit` sound (never a false positive);
        # arguments whose interval is unknown (arithmetic, calls, plain unrefined locals)
        # are left unreported (a sound miss the interval engine can later extend).
        def collect_refined_signatures(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, sig_names: mutable darray[sview]&, sig_index: mutable darray[usize]&, sig_lo: mutable darray[i64]&, sig_hi: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            while param_probe < parameters.count |param_probe: usize = 0, sig_names, sig_index, sig_lo, sig_hi|:
                                param_bounds: (found: bool, lo: i64, hi: i64) = return_refinement_bounds(parameters[param_probe].type_expression, law_names, law_predicates)
                                sig_names.push(function_name) if param_bounds.found
                                sig_index.push(param_probe) if param_bounds.found
                                sig_lo.push(param_bounds.lo) if param_bounds.found
                                sig_hi.push(param_bounds.hi) if param_bounds.found
                                param_probe <- param_probe + 1
                        Decl.Module(module_name, module_body, module_line):
                            collect_refined_signatures(module_body, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_refined_signatures(scoped_body, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi)
                        _:
                            pass

        # The exact interval of an argument expression, or found=false. Only literals and
        # refined locals/params (whose bounds are exact) qualify — keeping `escape ⇒ emit`
        # sound.
        def argument_interval(argument: Ast::Expr, local_names: darray[sview]&, local_lo: darray[i64]&, local_hi: darray[i64]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.IntLit(value):
                        return (true, value, value)
                    Expr.Ident(name, line):
                        found_local: mutable bool = false
                        result_lo: mutable i64 = 0
                        result_hi: mutable i64 = 0
                        while probe < local_names.count |probe: usize = 0, found_local, result_lo, result_hi|:
                            matched: bool = local_names[probe] == name
                            found_local <- true if matched
                            result_lo <- local_lo[probe] if matched
                            result_hi <- local_hi[probe] if matched
                            probe <- probe + 1
                        return (found_local, result_lo, result_hi)
                    Expr.Paren(inner, line):
                        return argument_interval(inner, local_names, local_lo, local_hi)
                    Expr.Binary(left, operator, right, line):
                        # Exact interval arithmetic over a constant: `x * c`, `c * x`,
                        # `x + c`, `x - c`. Keeps the interval exact so containment stays sound.
                        left_interval: (found: bool, lo: i64, hi: i64) = argument_interval(left, local_names, local_lo, local_hi)
                        right_interval: (found: bool, lo: i64, hi: i64) = argument_interval(right, local_names, local_lo, local_hi)
                        left_constant: (found: bool, value: i64) = signed_int_literal(left)
                        right_constant: (found: bool, value: i64) = signed_int_literal(right)
                        interval_times_const(left_interval.lo, left_interval.hi, right_constant.value) return if operator == TokenKind.Star and left_interval.found and right_constant.found
                        interval_times_const(right_interval.lo, right_interval.hi, left_constant.value) return if operator == TokenKind.Star and right_interval.found and left_constant.found
                        interval_shift(left_interval.lo, left_interval.hi, right_constant.value) return if operator == TokenKind.Plus and left_interval.found and right_constant.found
                        interval_shift(left_interval.lo, left_interval.hi, 0 - right_constant.value) return if operator == TokenKind.Minus and left_interval.found and right_constant.found
                        # Two-VARIABLE interval arithmetic (both operands have intervals):
                        # `a + b`, `a - b`, `a * b`. Exact, so containment stays sound.
                        interval_add(left_interval.lo, left_interval.hi, right_interval.lo, right_interval.hi) return if operator == TokenKind.Plus and left_interval.found and right_interval.found
                        interval_sub(left_interval.lo, left_interval.hi, right_interval.lo, right_interval.hi) return if operator == TokenKind.Minus and left_interval.found and right_interval.found
                        interval_mul(left_interval.lo, left_interval.hi, right_interval.lo, right_interval.hi) return if operator == TokenKind.Star and left_interval.found and right_interval.found
                        return (false, 0, 0)
                    Expr.Unary(operator, operand, line):
                        # `-x` negates the interval (endpoints swap): [lo, hi] -> [-hi, -lo].
                        operand_interval: (found: bool, lo: i64, hi: i64) = argument_interval(operand, local_names, local_lo, local_hi)
                        (true, 0 - operand_interval.hi, 0 - operand_interval.lo) return if operator == TokenKind.Minus and operand_interval.found
                        return (false, 0, 0)
                    Expr.If(condition, then_expression, else_expression, if_line):
                        # A ternary `a if cond else b` yields the UNION of both branches: the
                        # value is one of them, so its interval is [min lo, max hi]. Exact, so
                        # containment stays sound (only fires when BOTH branches are bounded).
                        then_interval: (found: bool, lo: i64, hi: i64) = argument_interval(then_expression, local_names, local_lo, local_hi)
                        else_interval: (found: bool, lo: i64, hi: i64) = argument_interval(else_expression, local_names, local_lo, local_hi)
                        union_lo: i64 = then_interval.lo if then_interval.lo < else_interval.lo else else_interval.lo
                        union_hi: i64 = then_interval.hi if then_interval.hi > else_interval.hi else else_interval.hi
                        (true, union_lo, union_hi) return if then_interval.found and else_interval.found
                        return (false, 0, 0)
                    _:
                        return (false, 0, 0)

        # Exact interval of `[lo, hi] * c` — reversed endpoints when c is negative.
        def interval_times_const(lo: i64, hi: i64, factor: i64) -> (found: bool, lo: i64, hi: i64):
            can Abort.Panic:
                return (true, lo * factor, hi * factor) if factor >= 0 else (true, hi * factor, lo * factor)

        # Exact interval of `[lo, hi] + delta`.
        def interval_shift(lo: i64, hi: i64, delta: i64) -> (found: bool, lo: i64, hi: i64):
            can Abort.Panic:
                return (true, lo + delta, hi + delta)

        # `[l1,h1] + [l2,h2]` = `[l1+l2, h1+h2]`.
        def interval_add(l1: i64, h1: i64, l2: i64, h2: i64) -> (found: bool, lo: i64, hi: i64):
            can Abort.Panic:
                return (true, l1 + l2, h1 + h2)

        # `[l1,h1] - [l2,h2]` = `[l1-h2, h1-l2]`.
        def interval_sub(l1: i64, h1: i64, l2: i64, h2: i64) -> (found: bool, lo: i64, hi: i64):
            can Abort.Panic:
                return (true, l1 - h2, h1 - l2)

        # `[l1,h1] * [l2,h2]` = [min, max] over the four corner products.
        def interval_mul(l1: i64, h1: i64, l2: i64, h2: i64) -> (found: bool, lo: i64, hi: i64):
            can Abort.Panic:
                p1: i64 = l1 * l2
                p2: i64 = l1 * h2
                p3: i64 = h1 * l2
                p4: i64 = h1 * h2
                low: mutable i64 = p1
                low <- p2 if p2 < low
                low <- p3 if p3 < low
                low <- p4 if p4 < low
                high: mutable i64 = p1
                high <- p2 if p2 > high
                high <- p3 if p3 > high
                high <- p4 if p4 > high
                return (true, low, high)

        # Report each call argument whose exact interval escapes the callee's refined param.
        # Whether signature row `probe` matches this call AND its argument's exact interval
        # escapes the parameter's [lo, hi]. Guarded so the argument access is in-bounds.
        def signature_argument_escapes(probe: usize, callee_name: sview, arguments: darray[Ast::Expr], sig_names: darray[sview]&, sig_index: darray[usize]&, sig_lo: darray[i64]&, sig_hi: darray[i64]&, local_names: darray[sview]&, local_lo: darray[i64]&, local_hi: darray[i64]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if sig_names[probe] != callee_name
                false return if sig_index[probe] >= arguments.count
                interval: (found: bool, lo: i64, hi: i64) = argument_interval(arguments[sig_index[probe]], local_names, local_lo, local_hi)
                return interval.found and (interval.lo > interval.hi or interval.lo < sig_lo[probe] or interval.hi > sig_hi[probe])

        def check_call_arguments(callee: Ast::Expr, arguments: darray[Ast::Expr], line: u32, sig_names: darray[sview]&, sig_index: darray[usize]&, sig_lo: darray[i64]&, sig_hi: darray[i64]&, local_names: darray[sview]&, local_lo: darray[i64]&, local_hi: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callee_name: sview = ident_name_of(callee)
                return if callee_name == ""
                while probe < sig_names.count |probe: usize = 0, table| -> table:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementArgNotProven, name: callee_name, line: line, expected: "", actual: "", expected_count: (sig_index[probe] + 1).u32()}) if signature_argument_escapes(probe, callee_name, arguments, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi)
                    probe <- probe + 1

        def check_arg_expression(expression: Ast::Expr, line: u32, sig_names: darray[sview]&, sig_index: darray[usize]&, sig_lo: darray[i64]&, sig_hi: darray[i64]&, local_names: darray[sview]&, local_lo: darray[i64]&, local_hi: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- check_call_arguments(callee, arguments, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        for argument in arguments |table| -> table:
                            table <- check_arg_expression(argument, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- check_arg_expression(left, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        table <- check_arg_expression(right, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                    Expr.Paren(inner, paren_line):
                        table <- check_arg_expression(inner, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                    _:
                        pass

        # The literal [lo, hi] window of an `is Law[lo, hi]` application (shape-blind:
        # any two-literal application narrows; the law's own predicate was validated at
        # its declaration).
        def narrow_application_window(application: Ast::Expr) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match application:
                    Expr.IndexN(law_object, law_arguments, law_line):
                        (false, 0, 0) return if law_arguments.count != 2
                        lo_literal: (found: bool, value: i64) = signed_int_literal(law_arguments[0])
                        hi_literal: (found: bool, value: i64) = signed_int_literal(law_arguments[1])
                        (true, lo_literal.value, hi_literal.value) return if lo_literal.found and hi_literal.found
                        return (false, 0, 0)
                    _:
                        return (false, 0, 0)


        # POISON a narrowed local when the branch reassigns it from an interval-less
        # source (an empty [1, 0] row shadows the narrow; last row wins).
        def poison_reassigned(statements: darray[Ast::Stmt], subject: sview, names: mutable darray[sview]&, lows: mutable darray[i64]&, highs: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, lows, highs, subject|:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            continue if ident_name_of(target) != subject
                            reassigned_literal: (found: bool, value: i64) = signed_int_literal(value)
                            if reassigned_literal.found:
                                names.push(subject)
                                lows.push(reassigned_literal.value)
                                highs.push(reassigned_literal.value)
                            else:
                                names.push(subject)
                                lows.push(1)
                                highs.push(0)
                        _:
                            pass


        def check_arg_statements(statements: darray[Ast::Stmt], sig_names: darray[sview]&, sig_index: darray[usize]&, sig_lo: darray[i64]&, sig_hi: darray[i64]&, local_names: darray[sview]&, local_lo: darray[i64]&, local_hi: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- check_arg_expression(expression, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_arg_expression(value, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_arg_expression(value, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- check_arg_expression(returned, line, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        Stmt.If(condition, then_body, else_body, line):
                            # `if X is Law[lo, hi]:` narrows X inside the THEN branch; a
                            # reassignment from an interval-less source POISONS it (the
                            # narrow no longer holds, so a refined call site warns).
                            narrowed_names: mutable darray[sview] = [entry_name for entry_name in local_names]
                            narrowed_lo: mutable darray[i64] = [entry_lo2 for entry_lo2 in local_lo]
                            narrowed_hi: mutable darray[i64] = [entry_hi2 for entry_hi2 in local_hi]
                            match condition:
                                Expr.Binary(narrow_subject, narrow_operator, narrow_application, narrow_line):
                                    if narrow_operator == TokenKind.Is:
                                        subject_name: sview = ident_name_of(narrow_subject)
                                        narrow_window: (found: bool, lo: i64, hi: i64) = narrow_application_window(narrow_application)
                                        if subject_name != "" and narrow_window.found:
                                            narrowed_names.push(subject_name)
                                            narrowed_lo.push(narrow_window.lo)
                                            narrowed_hi.push(narrow_window.hi)
                                            poison_reassigned(then_body, subject_name, narrowed_names, narrowed_lo, narrowed_hi)
                                _:
                                    pass
                            table <- check_arg_statements(then_body, sig_names, sig_index, sig_lo, sig_hi, narrowed_names, narrowed_lo, narrowed_hi, table)
                            table <- check_arg_statements(else_body, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        Stmt.While(condition, while_body, line):
                            table <- check_arg_statements(while_body, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            table <- check_arg_statements(block_body, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        # A RANGE loop binds its variable to a known interval:
                        # `for i in 0..<n` is [0, n-1] — unbounded above when n is not a
                        # literal (escapes every finite window, matching stage0's warn);
                        # `for i in 0..=9` is [0, 9].
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            loop_names: mutable darray[sview] = [entry for entry in local_names]
                            loop_lo: mutable darray[i64] = [entry_lo for entry_lo in local_lo]
                            loop_hi: mutable darray[i64] = [entry_hi for entry_hi in local_hi]
                            match iterable:
                                Expr.Binary(range_low, range_operator, range_high, range_line):
                                    is_range: bool = range_operator == TokenKind.Range or range_operator == TokenKind.RangeLt or range_operator == TokenKind.RangeLe
                                    low_literal: (found: bool, value: i64) = signed_int_literal(range_low)
                                    high_literal: (found: bool, value: i64) = signed_int_literal(range_high)
                                    if is_range and low_literal.found and variables.count > 0:
                                        loop_names.push(variables[0])
                                        loop_lo.push(low_literal.value)
                                        inclusive: bool = range_operator == TokenKind.RangeLe
                                        bounded_high: i64 = (high_literal.value if inclusive else high_literal.value - 1) if high_literal.found else 9223372036854775807
                                        loop_hi.push(bounded_high)
                                _:
                                    pass
                            table <- check_arg_statements(for_body, sig_names, sig_index, sig_lo, sig_hi, loop_names, loop_lo, loop_hi, table)
                        _:
                            pass

        # Whether an expression takes the ADDRESS of NAME (`&name`) — a mutable-ref pass that
        # can re-seed the local's range (e.g. an `ensures p is Law` out-param), invalidating
        # its declared-init interval.
        def expr_takes_address(expression: Ast::Expr, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        true return if operator == TokenKind.Ampersand and ident_name_of(operand) == name
                        return expr_takes_address(operand, name)
                    Expr.Paren(inner, line):
                        return expr_takes_address(inner, name)
                    Expr.Binary(left, op, right, line):
                        true return if expr_takes_address(left, name)
                        return expr_takes_address(right, name)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments:
                            true return if expr_takes_address(argument, name)
                        return false
                    Expr.If(condition, then_expression, else_expression, line):
                        true return if expr_takes_address(then_expression, name)
                        return expr_takes_address(else_expression, name)
                    _:
                        return false

        # Whether NAME is a `<-` reassignment target OR has its address taken (a reseed-capable
        # mutable-ref pass) anywhere in the body. Either invalidates a carried declared-init
        # interval, so the local is not carried (a sound MISS, never a false positive).
        def body_reassigns(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            true return if operator == TokenKind.LArrow and ident_name_of(target) == name
                            true return if expr_takes_address(value, name)
                        Stmt.Expr(expression, line):
                            true return if expr_takes_address(expression, name)
                        Stmt.VarDecl(vname, vtype, vvalue, vline):
                            true return if expr_takes_address(vvalue, name)
                        Stmt.Return(value, line):
                            if value is returned:
                                true return if expr_takes_address(returned, name)
                        Stmt.If(condition, then_body, else_body, line):
                            true return if body_reassigns(then_body, name)
                            true return if body_reassigns(else_body, name)
                        Stmt.While(condition, while_body, line):
                            true return if body_reassigns(while_body, name)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            true return if body_reassigns(for_body, name)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            true return if body_reassigns(block_body, name)
                        _:
                            pass
                return false

        def check_arg_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, sig_names: darray[sview]&, sig_index: darray[usize]&, sig_lo: darray[i64]&, sig_hi: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            local_names: mutable darray[sview] = []
                            local_lo: mutable darray[i64] = []
                            local_hi: mutable darray[i64] = []
                            for parameter in parameters |local_names, local_lo, local_hi|:
                                pbounds: (found: bool, lo: i64, hi: i64) = return_refinement_bounds(parameter.type_expression, law_names, law_predicates)
                                local_names.push(parameter.name) if pbounds.found
                                local_lo.push(pbounds.lo) if pbounds.found
                                local_hi.push(pbounds.hi) if pbounds.found
                            # A top-level local `r = <expr>` whose value has a computable exact
                            # interval (a refined-param arithmetic/ternary) carries that interval
                            # forward, so a later call passing `r` to a refined arg is checked.
                            # Flow-insensitive: only added if `r` is never reassigned (`<-`).
                            for statement in body |local_names, local_lo, local_hi|:
                                match statement:
                                    Stmt.VarDecl(local_name, local_type, local_value, local_line):
                                        local_iv: (found: bool, lo: i64, hi: i64) = argument_interval(local_value, local_names, local_lo, local_hi)
                                        if local_iv.found and not body_reassigns(body, local_name):
                                            local_names.push(local_name)
                                            local_lo.push(local_iv.lo)
                                            local_hi.push(local_iv.hi)
                                    _:
                                        pass
                            table <- check_arg_statements(body, sig_names, sig_index, sig_lo, sig_hi, local_names, local_lo, local_hi, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_arg_walk(module_body, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_arg_walk(scoped_body, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi, table)
                        _:
                            pass

        # The ELEMENT annotation of a container type (`darray[E]`, `array[E, N]`),
        # through `&`/`mutable`; Absent otherwise.
        def container_element_annotation(type_expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return container_element_annotation(operand)
                    Expr.Paren(inner, paren_line):
                        return container_element_annotation(inner)
                    Expr.Index(object, element, index_line):
                        head: sview = ident_name_of(object)
                        element return if head == "darray" or head == "dict"
                        return (Ast::Expr.Absent)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        (arguments_n[0]) return if (head_n == "array" or head_n == "darray") and arguments_n.count > 0
                        return (Ast::Expr.Absent)
                    _:
                        return (Ast::Expr.Absent)


        # Whether any identifier occurs more than once in the expression.
        def return_expr_repeats_variable(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                seen: mutable darray[sview] = []
                return return_expr_collect_repeats(expression, seen, 0)


        def return_expr_collect_repeats(expression: Ast::Expr, seen: mutable darray[sview]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 12
                match expression:
                    Expr.Ident(name, line):
                        true return if any s in seen where s == name
                        seen.push(name)
                        return false
                    Expr.Paren(inner, paren_line):
                        return return_expr_collect_repeats(inner, seen, depth + 1)
                    Expr.Unary(operator, operand, unary_line):
                        return return_expr_collect_repeats(operand, seen, depth + 1)
                    Expr.Binary(left, operator, right, binary_line):
                        true return if return_expr_collect_repeats(left, seen, depth + 1)
                        return return_expr_collect_repeats(right, seen, depth + 1)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |seen|:
                            true return if return_expr_collect_repeats(argument, seen, depth + 1)
                        return false
                    Expr.Field(object, field, field_line):
                        return return_expr_collect_repeats(object, seen, depth + 1)
                    Expr.Index(object, index_argument, index_line):
                        true return if return_expr_collect_repeats(object, seen, depth + 1)
                        return return_expr_collect_repeats(index_argument, seen, depth + 1)
                    _:
                        return false


        # Whether the mod base is an UNSIGNED integer parameter (its value is >= 0 by type).
        def return_base_is_unsigned_param(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]) -> bool:
            can Memory.Allocate, Abort.Panic:
                base: sview = ident_name_of(expression)
                false return if base == ""
                for parameter in parameters |base|:
                    continue if parameter.name != base
                    type_name: sview = bare_type_name(parameter.type_expression)
                    return type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uint"
                return false


        # The tail name of a callee (`M::clamp` -> "clamp", plain ident unchanged).
        def return_callee_tail_name(callee: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = ident_name_of(callee)
                direct return if direct != ""
                match callee:
                    Expr.Scope(base, name, line):
                        return name
                    Expr.Field(object, field, field_line):
                        return field
                    _:
                        return sview("", 0, 0)


        # Return-refinement windows of all functions (alias returns resolved).
        def collect_return_windows(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, ret_alias_names: darray[sview]&, ret_alias_bases: darray[Ast::Expr]&, out_names: mutable darray[sview]&, out_lo: mutable darray[i64]&, out_hi: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_names, out_lo, out_hi|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if return_type is present_return:
                                window: (found: bool, lo: i64, hi: i64) = param_refinement_window(present_return, law_names, law_predicates, ret_alias_names, ret_alias_bases)
                                if window.found:
                                    out_names.push(function_name)
                                    out_lo.push(window.lo)
                                    out_hi.push(window.hi)
                        Decl.Module(module_name, module_body, module_line):
                            collect_return_windows(module_body, law_names, law_predicates, ret_alias_names, ret_alias_bases, out_names, out_lo, out_hi)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_return_windows(scoped_body, law_names, law_predicates, ret_alias_names, ret_alias_bases, out_names, out_lo, out_hi)
                        _:
                            pass


        def collect_return_alias_bases(declarations: darray[Ast::Decl], out_names: mutable darray[sview]&, out_bases: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_names, out_bases|:
                    match declaration:
                        Decl.Alias(name, target, line):
                            out_names.push(name)
                            out_bases.push(target)
                        Decl.Module(module_name, module_body, module_line):
                            collect_return_alias_bases(module_body, out_names, out_bases)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_return_alias_bases(scoped_body, out_names, out_bases)
                        _:
                            pass


        def check_refinement_return(declarations: darray[Ast::Decl], enable_smt: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, law_names, law_predicates)
                # Named refinement aliases (`type Small = i64 is Bounded[2, 10]`) resolve
                # parameter windows for the return-range tier.
                ret_alias_names: mutable darray[sview] = []
                ret_alias_bases: mutable darray[Ast::Expr] = []
                collect_return_alias_bases(declarations, ret_alias_names, ret_alias_bases)
                rr_struct_names: mutable darray[sview] = []
                rr_field_starts: mutable darray[usize] = []
                rr_field_counts: mutable darray[usize] = []
                rr_field_names: mutable darray[sview] = []
                rr_field_types: mutable darray[Ast::Expr] = []
                collect_struct_member_tables(declarations, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types)
                rr_fn_names: mutable darray[sview] = []
                rr_fn_lo: mutable darray[i64] = []
                rr_fn_hi: mutable darray[i64] = []
                collect_return_windows(declarations, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_fn_names, rr_fn_lo, rr_fn_hi)
                table <- check_refinement_return_walk(declarations, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, enable_smt, table)
                sig_names: mutable darray[sview] = []
                sig_index: mutable darray[usize] = []
                sig_lo: mutable darray[i64] = []
                sig_hi: mutable darray[i64] = []
                collect_refined_signatures(declarations, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi)
                table <- check_arg_walk(declarations, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi, table)
