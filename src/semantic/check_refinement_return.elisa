# Refinement-on-return proof obligation (interval analysis, sound subset).
#
# Stage0's prover discharges a refined return type `-> T is Law[lo, hi]` by proving the
# returned value lies in [lo, hi]; when it cannot, it emits "refinement on the return
# could not be proven". It DOES reason about bitmask bounds — `x & 0x7f` proves `<= 127`
# (fits `InRange[0, 127]`), but `x & 0x1ff` yields [0, 511], which does NOT fit [0, 127].
#
# Stage1 has no prover, so it ports the DECIDABLE, SOUND slice: when the return value is a
# bitmask `EXPR & MASK` (optionally `(EXPR >> k) & MASK`), its range is EXACTLY [0, MASK].
# For a range-shaped law (`self >= lo and self <= hi`) with integer-literal bounds, emit
# iff that exact interval is NOT contained in [lo, hi] (MASK > hi, or lo > 0). This can
# only fire when the value provably escapes the refinement — never a false positive — so
# it strictly reduces the ensure/refinement underfire set without risking overfire. Return
# values the analysis cannot bound (calls, arithmetic, plain idents) are left unreported
# (a sound miss; a fuller interval engine would extend value_upper_bound / value_lower_bound).
extend Semantic:
    private:
        # Whether a law predicate has the range shape `self >= P and self <= Q` (the
        # `InRange`/`Bounded` convention), so its two call args are [lo, hi] positionally.
        def law_predicate_is_range_shape(predicate: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match predicate:
                    Expr.Binary(left, operator, right, line):
                        conjunction: bool = operator == TokenKind.And
                        lower_ok: bool = comparison_on_self(left, TokenKind.GtEq)
                        upper_ok: bool = comparison_on_self(right, TokenKind.LtEq)
                        conjunction and lower_ok and upper_ok
                    _: false

        # Whether EXPRESSION is `self <op> _` — a bound on the refinement subject.
        def comparison_on_self(expression: Ast::Expr, operator_wanted: TokenKind) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Binary(left, operator, right, line):
                        left_is_self: bool = match left:
                            Expr.Ident(name, ident_line): name == "self"
                            _: false
                        operator == operator_wanted and left_is_self
                    _: false

        # The exact upper bound of a bitmask value `EXPR & MASK` (MASK an integer literal),
        # optionally through a shift/paren. Returns (found, mask). `x & MASK` is exactly
        # [0, MASK]; this is the only value form the sound subset bounds.
        def mask_upper_bound(expression: Ast::Expr) -> (found: bool, mask: i64):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, line):
                        return mask_upper_bound(inner)
                    Expr.Binary(left, operator, right, line):
                        is_and: bool = operator == TokenKind.Ampersand
                        right_mask: i64 = int_literal_or_negative(right) if is_and else (-1)
                        left_mask: i64 = int_literal_or_negative(left) if is_and else (-1)
                        chosen: i64 = right_mask if right_mask >= 0 else left_mask
                        usable_mask: i64 = chosen if chosen >= 0 else 0
                        return (chosen >= 0, usable_mask)
                    _:
                        return (false, 0)

        # The integer value of EXPRESSION, or -1 when it is not a non-negative integer
        # literal (masks in this corpus are non-negative hex/decimal constants).
        def int_literal_or_negative(expression: Ast::Expr) -> i64:
            can Abort.Panic:
                return match expression:
                    Expr.IntLit(value): value
                    _: (-1)

        # Extract a range-shaped refinement `T is Law[lo, hi]` on a return type: the law
        # name plus its two integer-literal bounds. Returns found=false otherwise.
        def return_refinement_bounds(return_type: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match return_type:
                    Expr.Binary(base, operator, right, line):
                        return refinement_index_bounds(right, law_names, law_predicates) if operator == TokenKind.Is else (false, 0, 0)
                    _:
                        return (false, 0, 0)

        # From the `Law[lo, hi]` application: confirm the law is range-shaped and both args
        # are integer literals, then return their values.
        def refinement_index_bounds(application: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, lo: i64, hi: i64):
            can Memory.Allocate, Abort.Panic:
                match application:
                    Expr.IndexN(object, arguments, line):
                        law_name: sview = ident_name_of(object)
                        lo_value: i64 = int_literal_or_negative(arguments[0]) if arguments.count == 2 else (-1)
                        hi_value: i64 = int_literal_or_negative(arguments[1]) if arguments.count == 2 else (-1)
                        usable: bool = arguments.count == 2 and lo_value >= 0 and hi_value >= 0 and law_is_range_shaped(law_name, law_names, law_predicates)
                        return (usable, lo_value, hi_value)
                    _:
                        return (false, 0, 0)

        # Whether the named law is registered with a range-shaped predicate.
        def law_is_range_shaped(law_name: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                while probe < law_names.count |probe: usize = 0|:
                    true return if law_names[probe] == law_name and law_predicate_is_range_shape(law_predicates[probe])
                    probe <- probe + 1
                return false

        # Whether an expression contains a bitwise operator (`&` `|` `^` `<<` `>>`) — the
        # value shapes stage0's default prover declines to bound.
        def expression_has_bitwise(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        bitwise: bool = operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
                        return bitwise or expression_has_bitwise(left) or expression_has_bitwise(right)
                    Expr.Paren(inner, line):
                        return expression_has_bitwise(inner)
                    Expr.Unary(operator, operand, line):
                        return expression_has_bitwise(operand)
                    _:
                        return false

        def check_refinement_return_function(return_type: Ast::Expr, body: darray[Ast::Stmt], function_name: sview, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                bounds: (found: bool, lo: i64, hi: i64) = return_refinement_bounds(return_type, law_names, law_predicates)
                return if not bounds.found
                for statement in body |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                # Stage0's default (non-SMT) prover cannot bound a bitwise
                                # result, so it reports every bitwise-valued return of a
                                # refined type as unproven (SMT-proved cases are a separate
                                # fingerprint stage1 cannot match without a solver).
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RefinementReturnNotProven, name: function_name, line: line, expected: "", actual: ""}) if expression_has_bitwise(returned)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- check_refinement_return_function(return_type, block_body, function_name, law_names, law_predicates, table)
                        _:
                            pass

        def collect_laws(declarations: darray[Ast::Decl], law_names: mutable darray[sview]&, law_predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Law(name, predicate, line):
                            law_names.push(name)
                            law_predicates.push(predicate)
                        Decl.Module(module_name, module_body, module_line):
                            collect_laws(module_body, law_names, law_predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_laws(scoped_body, law_names, law_predicates)
                        _:
                            pass

        def check_refinement_return_walk(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- check_refinement_return_function(present_return_type, body, function_name, law_names, law_predicates, table) if return_type is present_return_type
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_refinement_return_walk(module_body, law_names, law_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_refinement_return_walk(scoped_body, law_names, law_predicates, table)
                        _:
                            pass

        def check_refinement_return(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, law_names, law_predicates)
                table <- check_refinement_return_walk(declarations, law_names, law_predicates, table)
