extend Semantic:
    private:
        # Binding identities come from the resolver's parallel reference rows. Matching both
        # owner and source position prevents a same-named shadow in another lexical scope from
        # proving a zeroed binding initialized (or from receiving its diagnostic). The owner
        # index is linked newest-to-oldest, so retain each match while walking: the final match
        # is the same earliest row selected by the original linear scan.
        def zeroed_binding_for_reference(table: SymbolTable&, owner: DeclId, line: u32, name: sview) -> BindingId:
            can Abort.Panic:
                owner_index: usize = owner.value.usize()
                if not table.ref_owner_index_valid or owner_index >= table.symbols.count:
                    return zeroed_scan_binding_for_reference(table, owner, line, name)
                if table.ref_line.count != table.ref_binding_ids.count or table.ref_name.count != table.ref_binding_ids.count or table.ref_kind.count != table.ref_binding_ids.count or table.ref_pos.count != table.ref_binding_ids.count or table.ref_owner_next.count != table.ref_binding_ids.count:
                    return zeroed_scan_binding_for_reference(table, owner, line, name)
                if table.ref_owner_heads.count != table.ref_owner_tails.count or table.ref_owner_heads.count != table.ref_owner_counts.count or table.ref_owner_heads.count != table.ref_owner_observed_counts.count or owner_index >= table.ref_owner_heads.count:
                    return zeroed_scan_binding_for_reference(table, owner, line, name)
                reference_index: mutable u32 = table.ref_owner_heads[owner_index]
                expected_count: usize = table.ref_owner_counts[owner_index].usize()
                expected_tail: u32 = table.ref_owner_tails[owner_index]
                if expected_count != table.ref_owner_observed_counts[owner_index]:
                    return zeroed_scan_binding_for_reference(table, owner, line, name)
                if expected_count == 0.usize():
                    if reference_index != SYMBOL_INDEX_ROW_NONE or expected_tail != SYMBOL_INDEX_ROW_NONE:
                        return zeroed_scan_binding_for_reference(table, owner, line, name)
                    return BindingId{owner: DeclId{value: SYMBOL_INDEX_ROW_NONE}, serial: 0}
                if reference_index == SYMBOL_INDEX_ROW_NONE or expected_tail == SYMBOL_INDEX_ROW_NONE:
                    return zeroed_scan_binding_for_reference(table, owner, line, name)
                reference_steps: mutable usize = 0
                found: mutable bool = false
                selected: mutable BindingId = BindingId{owner: DeclId{value: SYMBOL_INDEX_ROW_NONE}, serial: 0}
                previous_reference_index: mutable u32 = SYMBOL_INDEX_ROW_NONE
                last_reference_index: mutable u32 = SYMBOL_INDEX_ROW_NONE
                while reference_index != SYMBOL_INDEX_ROW_NONE |reference_index, table, owner, line, name, reference_steps, found, selected|:
                    reference_row: usize = reference_index.usize()
                    if reference_row >= table.ref_owner_next.count or reference_steps >= expected_count:
                        return zeroed_scan_binding_for_reference(table, owner, line, name)
                    if previous_reference_index != SYMBOL_INDEX_ROW_NONE and reference_index >= previous_reference_index:
                        return zeroed_scan_binding_for_reference(table, owner, line, name)
                    binding: BindingId = table.ref_binding_ids[reference_row]
                    if binding.owner.value != owner.value:
                        return zeroed_scan_binding_for_reference(table, owner, line, name)
                    if table.ref_line[reference_row] == line and table.ref_name[reference_row] == name and table.ref_kind[reference_row] == 2:
                        selected <- binding
                        found <- true
                    last_reference_index <- reference_index
                    previous_reference_index <- reference_index
                    reference_index <- table.ref_owner_next[reference_row]
                    reference_steps <- reference_steps + 1
                if reference_steps != expected_count or last_reference_index != expected_tail:
                    return zeroed_scan_binding_for_reference(table, owner, line, name)
                return selected if found
                return BindingId{owner: DeclId{value: SYMBOL_INDEX_ROW_NONE}, serial: 0}

        def zeroed_binding_equal(left: BindingId, right: BindingId) -> bool:
            can Abort.Panic:
                return left.owner.value == right.owner.value and left.serial == right.serial

        def zeroed_binding_present(bindings: darray[BindingId]&, wanted: BindingId) -> bool:
            can Abort.Panic:
                return any binding in bindings where zeroed_binding_equal(binding, wanted)

        def zeroed_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        def zeroed_candidate_matches(name: sview, binding: BindingId, candidate_names: darray[sview]&, candidates: darray[BindingId]&) -> bool:
            can Abort.Panic:
                unresolved_match: mutable bool = false
                for index in 0..<candidate_names.count:
                    if candidate_names[index] == name:
                        if index >= candidates.count or candidates[index].owner.value == SYMBOL_INDEX_ROW_NONE or binding.owner.value == SYMBOL_INDEX_ROW_NONE:
                            unresolved_match <- true
                        elif zeroed_binding_equal(candidates[index], binding):
                            return true
                return unresolved_match

        def zeroed_add_initialized(initialized: mutable darray[BindingId]&, binding: BindingId) -> void:
            can Memory.Allocate, Abort.Panic:
                if binding.owner.value != SYMBOL_INDEX_ROW_NONE and not zeroed_binding_present(initialized, binding):
                    initialized.push(binding)

        def zeroed_remove_initialized(initialized: mutable darray[BindingId]&, binding: BindingId) -> void:
            can Memory.Allocate, Abort.Panic:
                remaining: mutable darray[BindingId] = []
                for existing in initialized |remaining|:
                    remaining.push(existing) if not zeroed_binding_equal(existing, binding)
                initialized.truncate(0)
                for existing in remaining |initialized|:
                    initialized.push(existing)

        def zeroed_replace_initialized(destination: mutable darray[BindingId]&, source: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                destination.truncate(0)
                for binding in source |destination|:
                    destination.push(binding)

        def zeroed_intersect_initialized(initialized: mutable darray[BindingId]&, left: darray[BindingId]&, right: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                joined: mutable darray[BindingId] = []
                for binding in left |joined|:
                    joined.push(binding) if zeroed_binding_present(right, binding) and not zeroed_binding_present(joined, binding)
                initialized.truncate(0)
                for binding in joined |initialized|:
                    initialized.push(binding)

        # `initialized` = `initialized` ∩ `right`; the in-place form keeps the output and
        # the left operand from aliasing one `mutable` argument pair.
        def zeroed_intersect_initialized_in_place(initialized: mutable darray[BindingId]&, right: darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                kept: mutable darray[BindingId] = []
                for binding in initialized |kept|:
                    kept.push(binding) if zeroed_binding_present(right, binding) and not zeroed_binding_present(kept, binding)
                initialized.truncate(0)
                for binding in kept |initialized|:
                    initialized.push(binding)

        def zeroed_bool_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        # Only an unguarded wildcard or binding pattern proves that later match arms and the
        # unmatched path are impossible. Other patterns can be exhaustive in a known enum
        # family, but that requires resolved pattern coverage and is deliberately not guessed.
        def zeroed_match_is_unguarded_catchall(arm: Ast::MatchArm) -> bool:
            can Abort.Panic:
                return false if not (arm.guard is Ast::Expr.Absent)
                return match arm.pattern:
                    Ast::Pattern.Wildcard | Ast::Pattern.Binding(_): true
                    _: false

        # Check expression reads against the facts valid at this program point. Expression
        # sub-blocks are analyzed on a copy so they cannot unsafely export branch-local writes.
        def zeroed_check_read_expression(expression: Ast::Expr, read_value: bool, owner: DeclId, candidate_names: darray[sview]&, candidates: darray[BindingId]&, initialized: darray[BindingId]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        binding: BindingId = zeroed_binding_for_reference(table, owner, line.line, name)
                        is_candidate: bool = zeroed_candidate_matches(name, binding, candidate_names, candidates)
                        is_initialized: bool = zeroed_binding_present(initialized, binding) if binding.owner.value != SYMBOL_INDEX_ROW_NONE else false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UninitializedZeroedRead, name: name, line: line.line, expected: "", actual: ""}) if read_value and is_candidate and not is_initialized
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- zeroed_check_read_expression(callee, read_value, owner, candidate_names, candidates, initialized, table)
                        for argument in arguments |table|:
                            table <- zeroed_check_read_expression(argument, true, owner, candidate_names, candidates, initialized, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates_for_call, arguments, argument_names, line):
                        for argument in arguments |table|:
                            table <- zeroed_check_read_expression(argument, true, owner, candidate_names, candidates, initialized, table)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Index(object, index, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(index, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Slice(object, low, high, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(low, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(high, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.IndexN(object, arguments, line):
                        table <- zeroed_check_read_expression(object, read_value, owner, candidate_names, candidates, initialized, table)
                        for argument in arguments |table|:
                            table <- zeroed_check_read_expression(argument, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Binary(left, operator, right, line):
                        table <- zeroed_check_read_expression(left, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(right, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Unary(operator, operand, line):
                        table <- zeroed_check_read_expression(operand, read_value and operator != TokenKind.Ampersand, owner, candidate_names, candidates, initialized, table)
                    Expr.Move(operand, line) | Expr.Paren(operand, line):
                        table <- zeroed_check_read_expression(operand, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.RegionNew(operand, region, line):
                        table <- zeroed_check_read_expression(operand, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Refinement(base, predicate, line):
                        table <- zeroed_check_read_expression(base, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(predicate, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- zeroed_check_read_expression(element, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- zeroed_check_read_expression(entry.key, read_value, owner, candidate_names, candidates, initialized, table)
                            table <- zeroed_check_read_expression(entry.value, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Construct(type_expression, fields, line):
                        for field in fields |table|:
                            table <- zeroed_check_read_expression(field.value, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- zeroed_check_read_expression(base, read_value, owner, candidate_names, candidates, initialized, table)
                        for field in fields |table|:
                            table <- zeroed_check_read_expression(field.value, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.If(condition, then_expression, else_expression, line):
                        table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(then_expression, read_value, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(else_expression, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- zeroed_check_read_expression(scrutinee, true, owner, candidate_names, candidates, initialized, table)
                        for arm in arms |table|:
                            table <- zeroed_check_read_expression(arm.guard, true, owner, candidate_names, candidates, initialized, table)
                            arm_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                            arm_falls_through: mutable bool = true
                            table <- zeroed_check_read_statements(arm.body, owner, candidate_names, candidates, arm_initialized, arm_falls_through, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        table <- zeroed_check_read_expression(iterable, true, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                        table <- zeroed_check_read_expression(body, read_value, owner, candidate_names, candidates, initialized, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- zeroed_check_read_expression(guarded, true, owner, candidate_names, candidates, initialized, table)
                        recovery_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                        recovery_falls_through: mutable bool = true
                        table <- zeroed_check_read_statements(recovery, owner, candidate_names, candidates, recovery_initialized, recovery_falls_through, table)
                    Expr.Lambda(parameters, body, line):
                        lambda_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                        lambda_falls_through: mutable bool = true
                        table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, lambda_initialized, lambda_falls_through, table)
                    Expr.Block(statements, value, captures, line):
                        block_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                        block_falls_through: mutable bool = true
                        table <- zeroed_check_read_statements(statements, owner, candidate_names, candidates, block_initialized, block_falls_through, table)
                        table <- zeroed_check_read_expression(value, read_value, owner, candidate_names, candidates, block_initialized, table)
                    _:
                        pass

        # Process statements in source order. Branch facts are intersected across every path
        # that reaches the join; loops never establish facts outside the loop because they may
        # execute zero times. Match and expression-level joins remain conservative.
        def zeroed_check_read_statements(statements: darray[Ast::Stmt], owner: DeclId, candidate_names: darray[sview]&, candidates: darray[BindingId]&, initialized: mutable darray[BindingId]&, falls_through: mutable bool&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                falls_through <- true
                for statement in statements |table, initialized, falls_through|:
                    if zeroed_bool_value(falls_through):
                        match statement:
                            Stmt.Expr(expression, line):
                                table <- zeroed_check_read_expression(expression, true, owner, candidate_names, candidates, initialized, table)
                            Stmt.VarDecl(name, type_expression, value, line):
                                table <- zeroed_check_read_expression(value, true, owner, candidate_names, candidates, initialized, table)
                                binding: BindingId = zeroed_binding_for_reference(table, owner, line.line, name)
                                zeroed_remove_initialized(initialized, binding) if zeroed_candidate_matches(name, binding, candidate_names, candidates)
                            Stmt.Assign(target, operator, value, line):
                                if operator != TokenKind.LArrow and operator != TokenKind.Assign:
                                    table <- zeroed_check_read_expression(target, true, owner, candidate_names, candidates, initialized, table)
                                else:
                                    match target:
                                        Expr.Ident(target_name, target_line):
                                            pass
                                        _:
                                            table <- zeroed_check_read_expression(target, true, owner, candidate_names, candidates, initialized, table)
                                table <- zeroed_check_read_expression(value, true, owner, candidate_names, candidates, initialized, table)
                                match target:
                                    Expr.Ident(target_name, target_line):
                                        target_binding: BindingId = zeroed_binding_for_reference(table, owner, target_line.line, target_name)
                                        if operator == TokenKind.LArrow and zeroed_candidate_matches(target_name, target_binding, candidate_names, candidates):
                                            if zeroed_value_is_zeroed(value):
                                                zeroed_remove_initialized(initialized, target_binding)
                                            else:
                                                zeroed_add_initialized(initialized, target_binding)
                                    _:
                                        pass
                            Stmt.If(condition, then_body, else_body, line):
                                table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                                then_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                else_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                then_falls_through: mutable bool = true
                                else_falls_through: mutable bool = true
                                table <- zeroed_check_read_statements(then_body, owner, candidate_names, candidates, then_initialized, then_falls_through, table)
                                table <- zeroed_check_read_statements(else_body, owner, candidate_names, candidates, else_initialized, else_falls_through, table)
                                if then_falls_through and else_falls_through:
                                    zeroed_intersect_initialized(initialized, then_initialized, else_initialized)
                                elif then_falls_through:
                                    zeroed_replace_initialized(initialized, then_initialized)
                                elif else_falls_through:
                                    zeroed_replace_initialized(initialized, else_initialized)
                                else:
                                    falls_through <- false
                            Stmt.While(condition, body, line):
                                table <- zeroed_check_read_expression(condition, true, owner, candidate_names, candidates, initialized, table)
                                body_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                body_falls_through: mutable bool = true
                                table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, body_initialized, body_falls_through, table)
                            Stmt.For(bind, variables, iterable, body, line):
                                table <- zeroed_check_read_expression(iterable, true, owner, candidate_names, candidates, initialized, table)
                                body_initialized: mutable darray[BindingId] = [binding for binding in initialized]
                                body_falls_through: mutable bool = true
                                table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, body_initialized, body_falls_through, table)
                            Stmt.Block(kind, clause, binding, body, line):
                                table <- zeroed_check_read_statements(body, owner, candidate_names, candidates, initialized, falls_through, table)
                            Stmt.Match(scrutinee, arms, line):
                                table <- zeroed_check_read_expression(scrutinee, true, owner, candidate_names, candidates, initialized, table)
                                match_entry: mutable darray[BindingId] = [binding for binding in initialized]
                                has_joined_arm: mutable bool = false
                                has_catchall: mutable bool = false
                                for arm in arms |table, initialized, match_entry, has_joined_arm, has_catchall|:
                                    if not zeroed_bool_value(has_catchall):
                                        table <- zeroed_check_read_expression(arm.guard, true, owner, candidate_names, candidates, match_entry, table)
                                        arm_initialized: mutable darray[BindingId] = [binding for binding in match_entry]
                                        arm_falls_through: mutable bool = true
                                        table <- zeroed_check_read_statements(arm.body, owner, candidate_names, candidates, arm_initialized, arm_falls_through, table)
                                        if zeroed_bool_value(arm_falls_through):
                                            if zeroed_bool_value(has_joined_arm):
                                                zeroed_intersect_initialized_in_place(initialized, arm_initialized)
                                            else:
                                                zeroed_replace_initialized(initialized, arm_initialized)
                                                has_joined_arm <- true
                                        has_catchall <- true if zeroed_match_is_unguarded_catchall(arm)
                                if zeroed_bool_value(has_joined_arm):
                                    # Without an unguarded catch-all, the scrutinee may match no
                                    # arm (or a guard may fail), so the incoming state is another
                                    # possible continuation and must participate in the join.
                                    zeroed_intersect_initialized_in_place(initialized, match_entry) if not zeroed_bool_value(has_catchall)
                                elif zeroed_bool_value(has_catchall):
                                    # Every reachable arm exits without returning to this point.
                                    falls_through <- false
                            Stmt.Return(value, line):
                                table <- zeroed_check_read_expression(returned, true, owner, candidate_names, candidates, initialized, table) if value is returned
                                falls_through <- false
                            Stmt.Break(label, line) | Stmt.Continue(label, line):
                                falls_through <- false
                            Stmt.Contract(kind, expression, line):
                                table <- zeroed_check_read_expression(expression, true, owner, candidate_names, candidates, initialized, table)
                            _:
                                pass

        # Collect must-init `= zeroed` local declarations (recursively).
        def zeroed_collect_candidates(statements: darray[Ast::Stmt], owner: DeclId, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview @source, table: SymbolTable&, out_names: mutable darray[sview]&, out_bindings: mutable darray[BindingId]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_bindings|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            if zeroed_value_is_zeroed(value) and zeroed_invalid_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table) and not zeroed_is_sview_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table):
                                out_names.push(name)
                                out_bindings.push(zeroed_binding_for_reference(table, owner, line.line, name))
                        Stmt.If(condition, then_body, else_body, line):
                            zeroed_collect_candidates(then_body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                            zeroed_collect_candidates(else_body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.While(condition, body, line):
                            zeroed_collect_candidates(body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.For(bind, variables, iterable, body, line):
                            zeroed_collect_candidates(body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.Block(kind, clause, binding, body, line):
                            zeroed_collect_candidates(body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out_names, out_bindings|:
                                zeroed_collect_candidates(arm.body, owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, out_names, out_bindings)
                        _:
                            pass

        def check_uninitialized_zeroed_walk(declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview @source, inherited_alias_names: darray[sview @source]&, inherited_alias_values: darray[Ast::Expr]&, active_enum_index: mutable ZeroedActiveEnumIndex&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                alias_names: mutable darray[sview @source] = []
                alias_values: mutable darray[Ast::Expr] = []
                alias_names.extend(inherited_alias_names)
                alias_values.extend(inherited_alias_values)
                zeroed_collect_type_aliases(declarations, alias_names, alias_values)
                for declaration in declarations |table, active_enum_index| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, line.line, declarations, alias_declarations, active_enum_index, current_module, alias_names, alias_values, table)
                            function_owner: DeclId = function_declaration_id(table, function_name, line.offset)
                            candidate_names: mutable darray[sview] = []
                            candidates: mutable darray[BindingId] = []
                            zeroed_collect_candidates(body, function_owner, alias_names, alias_values, declarations, alias_declarations, current_module, table, candidate_names, candidates)
                            initialized: mutable darray[BindingId] = []
                            falls_through: mutable bool = true
                            # Every effect of the read walk (the diagnostic and the initialized
                            # set) is gated on a candidate match, so a function without a
                            # `= zeroed` candidate has nothing to report: skip resolving every
                            # identifier of its body against the owner's reference chain.
                            table <- zeroed_check_read_statements(body, function_owner, candidate_names, candidates, initialized, falls_through, table) if candidate_names.count > 0
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_uninitialized_zeroed_walk(module_body, alias_declarations, module_name, alias_names, alias_values, active_enum_index, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_uninitialized_zeroed_walk(scoped_body, alias_declarations, current_module, alias_names, alias_values, active_enum_index, table)
                        Decl.Const(name, type_expression, value, is_global, line):
                            table <- zeroed_reject_reference_initializer(name, type_expression, value, line, alias_names, alias_values, declarations, alias_declarations, active_enum_index, current_module, table) if is_global
                        _:
                            pass


        def check_uninitialized_zeroed(declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview @source, inherited_alias_names: darray[sview @source]&, inherited_alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                active_enum_index: mutable ZeroedActiveEnumIndex = ZeroedActiveEnumIndex{built: false, heads: {}, tails: {}, counts: {}, next: [], row_hashes: [], owners: [], names: [], payloads: []}
                table <- check_uninitialized_zeroed_walk(declarations, alias_declarations, current_module, inherited_alias_names, inherited_alias_values, active_enum_index, table)
