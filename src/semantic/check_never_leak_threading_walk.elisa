# never-leak lint, category VALUE_THREAD, part 2: the side-effect-only calls and the walk (see
# check_never_leak_threading.elisa for the category).
extend Semantic:
    private:
        # `mutable T&` -> T, or Absent.
        def nl_vt_lent_type(type_expression: Ast::Expr) -> Ast::Expr:
            if type_expression is Expr.Unary(outer_operator, outer_operand, _):
                if outer_operator == TokenKind.Mutable and outer_operand is Expr.Unary(inner_operator, inner_operand, _):
                    return inner_operand if inner_operator == TokenKind.Ampersand
            return (Ast::Expr.Absent)

        def nl_vt_void(return_type: Ast::Expr?) -> bool:
            if return_type is present_type:
                if present_type is Expr.Ident(type_name, _):
                    return type_name == "void"
                return false
            return true

        # The parameters of the first void function NAME with ARITY parameters, as a found flag.
        def nl_vt_find_void(declarations: darray[Ast::Decl]&, name: sview, arity: usize, params: mutable darray[Ast::ParamDecl]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |params|:
                    match declaration:
                        Decl.Func(function_name, function_params, return_type, _, _, _, _):
                            if function_name == name and function_params.count == arity and nl_vt_void(return_type):
                                params.extend(function_params)
                                return true
                        Decl.Module(_, module_body, _):
                            return true if nl_vt_find_void(module_body, name, arity, params)
                        Decl.Scoped(scoped_body, _):
                            return true if nl_vt_find_void(scoped_body, name, arity, params)
                        _:
                            pass
                return false

        # `f(.., &x, ..)` as a statement, with `f` a void function taking an owned local `x` as
        # `mutable T&`.
        def nl_vt_call(bindings: NlVtScope&, declarations: darray[Ast::Decl]&, callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview], line: u32, findings: mutable darray[NeverLeakFinding]&, names: mutable darray[sview]&, name_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if callee is Expr.Ident(function_name, _):
                    for argument_name in argument_names:
                        return if argument_name != ""
                    params: mutable darray[Ast::ParamDecl] = []
                    return if not nl_vt_find_void(declarations, function_name, arguments.count, &params)
                    for argument_index in 0..<arguments.count |findings, names, name_lines|:
                        if arguments[argument_index] is Expr.Unary(operator, place, _):
                            if operator == TokenKind.Ampersand and place is Expr.Ident(root, _):
                                lent: Ast::Expr = nl_vt_lent_type(params[argument_index].type_expression)
                                slot: i64 = nl_vt_slot(bindings, root)
                                if slot >= 0 and not (lent is Expr.Absent) and Ast::value_thread_owning_type(lent):
                                    index: usize = slot.usize()
                                    if bindings.kinds[index] != 1 and bindings.arenas[index] == "":
                                        call_text: mutable darray[u8] = []
                                        call_text.extend(function_name)
                                        call_text.push(40)
                                        for rendered_index in 0..<arguments.count |call_text|:
                                            call_text.extend(", ") if rendered_index > 0
                                            if rendered_index == argument_index:
                                                call_text.extend(root)
                                            else:
                                                vtc_render(arguments[rendered_index], &call_text)
                                        call_text.push(41)
                                        texts: u32 = nl_vt_push_texts(names, name_lines, (nl_vt_type_text(lent) can Global{Read,Write}), Parser::persist_name_bytes(&call_text, 0), params[argument_index].name)
                                        nl_vt_report(bindings, place, root, function_name, line, NEVER_LEAK_VT_EFFECT_ONLY, bindings.lines[index], texts, findings) can Global{Read,Write}
                                        return

        def nl_vt_declare(bindings: mutable NlVtScope&, name: sview, line: u32, type_expression: Ast::Expr, value: Ast::Expr, arena: sview, kind: u8) -> void:
            can Memory.Allocate, Abort.Panic:
                bindings.names.push(name)
                bindings.lines.push(line)
                bindings.types.push(type_expression)
                bindings.values.push(value)
                bindings.arenas.push(arena)
                bindings.kinds.push(kind)

        def nl_vt_block_arena(kind: sview, clause: darray[sview], binding: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                # A `region NAME:` block keeps NAME as its first clause entry.
                if kind == "region" and (binding != "" or clause.count > 0):
                    bytes: mutable darray[u8] = []
                    bytes.extend("region ")
                    if binding != "":
                        bytes.extend(binding)
                    else:
                        bytes.extend(clause[0])
                    return Parser::persist_name_bytes(&bytes, 0) can Global{Read,Write}
                if kind == "in" and clause.count > 0:
                    in_bytes: mutable darray[u8] = []
                    in_bytes.extend("in ")
                    in_bytes.extend(clause[0])
                    return Parser::persist_name_bytes(&in_bytes, 0) can Global{Read,Write}
                return sview("", 0, 0)

        def nl_vt_walk(statements: darray[Ast::Stmt], arena: sview, bindings: mutable NlVtScope&, declarations: darray[Ast::Decl]&, findings: mutable darray[NeverLeakFinding]&, names: mutable darray[sview]&, name_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |bindings, findings, names, name_lines|:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            if declared_value is Expr.Block(value_statements, _, _, _):
                                nl_vt_walk(value_statements, arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                            borrows: mutable bool = vtc_type_borrows(declared_type)
                            if declared_value is Expr.Unary(declared_operator, _, _):
                                borrows <- borrows or declared_operator == TokenKind.Ampersand
                            nl_vt_declare(bindings, declared_name, declared_pos.line, declared_type, declared_value, arena, 1 if borrows else 0)
                        Stmt.Expr(statement_expression, statement_pos):
                            match statement_expression:
                                Expr.Call(callee, arguments, argument_names, _):
                                    if callee is Expr.Field(receiver, method, _):
                                        nl_vt_method(bindings, receiver, method, arguments.count, statement_pos.line, findings, names, name_lines) can Global{Read,Write}
                                    else:
                                        nl_vt_call(bindings, declarations, callee, arguments, argument_names, statement_pos.line, findings, names, name_lines) can Global{Read,Write}
                                Expr.Block(expression_statements, _, _, _):
                                    nl_vt_walk(expression_statements, arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                                _:
                                    pass
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, _):
                            inner: sview = nl_vt_block_arena(block_kind, block_clause, block_binding) can Global{Read,Write}
                            nl_vt_walk(block_body, inner if inner != "" else arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                        Stmt.If(_, then_body, else_body, _):
                            nl_vt_walk(then_body, arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                            nl_vt_walk(else_body, arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                        Stmt.While(_, while_body, _):
                            nl_vt_walk(while_body, arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                        Stmt.For(_, _, _, for_body, _):
                            nl_vt_walk(for_body, arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                        Stmt.Match(_, arms, _):
                            for arm in arms |bindings, findings, names, name_lines|:
                                nl_vt_walk(arm.body, arena, bindings, declarations, findings, names, name_lines) can Global{Read,Write}
                        _:
                            pass

        def nl_vt_declarations(declarations: darray[Ast::Decl], top: darray[Ast::Decl]&, global_names: darray[sview]&, global_types: darray[Ast::Expr]&, findings: mutable darray[NeverLeakFinding]&, names: mutable darray[sview]&, name_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |findings, names, name_lines|:
                    match declaration:
                        Decl.Func(function_name, params, _, body, _, _, _):
                            bindings: mutable NlVtScope = NlVtScope{names: [], lines: [], types: [], values: [], arenas: [], kinds: [], global_names: [global_name for global_name in global_names], global_types: [global_type for global_type in global_types], function_name: function_name}
                            for param in params |bindings|:
                                nl_vt_declare(bindings, param.name, param.name_pos.line, param.type_expression, (Ast::Expr.Absent), "", 1 if vtc_type_borrows(param.type_expression) else 2)
                            nl_vt_walk(body, "", bindings, top, findings, names, name_lines) can Global{Read,Write}
                        Decl.Module(_, module_body, _):
                            nl_vt_declarations(module_body, top, global_names, global_types, findings, names, name_lines) can Global{Read,Write}
                        Decl.Scoped(scoped_body, _):
                            nl_vt_declarations(scoped_body, top, global_names, global_types, findings, names, name_lines) can Global{Read,Write}
                        _:
                            pass

        def nl_value_thread_findings(file: Ast::File&, findings: mutable darray[NeverLeakFinding]&, names: mutable darray[sview]&, name_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                global_names: mutable darray[sview] = []
                global_types: mutable darray[Ast::Expr] = []
                nl_vt_collect_globals(file.top_decls, &global_names, &global_types)
                nl_vt_declarations(file.top_decls, file.top_decls, global_names, global_types, findings, names, name_lines) can Global{Read,Write}
