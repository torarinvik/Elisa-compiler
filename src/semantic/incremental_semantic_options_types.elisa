# Pure record and constructor for the inputs that identify a semantic-analysis cache entry.
# Keeping this boundary separate makes the positional contract easy to replay on its own.
extend Semantic:
    public:
        struct IncrementalSemanticOptions:
            enforce_unsafe_permissions: bool
            flow_strict: bool
            runtime_std: bool
            flow_warn: bool
            enable_smt: bool
            warn_discarded: bool
            enforce_progress: bool
            enforce_extern_contracts: bool
            enforce_raw_unsafe: bool
            emit_proof_hole: bool
            region_stack_cap: i64
            enforce_global_permissions: bool
            enforce_mutable_global_grants: bool
            carrier_surface: bool

        # The argument order intentionally matches check_full_diagnostics,
        # including region_stack_cap between the tenth and eleventh booleans.
        def incremental_semantic_options_from_values(enforce_unsafe_permissions: bool, flow_strict: bool, runtime_std: bool, flow_warn: bool, enable_smt: bool, warn_discarded: bool, enforce_progress: bool, enforce_extern_contracts: bool, enforce_raw_unsafe: bool, emit_proof_hole: bool, region_stack_cap: i64, enforce_global_permissions: bool, enforce_mutable_global_grants: bool, carrier_surface: bool) -> IncrementalSemanticOptions:
            ensure result.enforce_unsafe_permissions == enforce_unsafe_permissions
            ensure result.flow_strict == flow_strict
            ensure result.runtime_std == runtime_std
            ensure result.flow_warn == flow_warn
            ensure result.enable_smt == enable_smt
            ensure result.warn_discarded == warn_discarded
            ensure result.enforce_progress == enforce_progress
            ensure result.enforce_extern_contracts == enforce_extern_contracts
            ensure result.enforce_raw_unsafe == enforce_raw_unsafe
            ensure result.emit_proof_hole == emit_proof_hole
            ensure result.region_stack_cap == region_stack_cap
            ensure result.enforce_global_permissions == enforce_global_permissions
            ensure result.enforce_mutable_global_grants == enforce_mutable_global_grants
            ensure result.carrier_surface == carrier_surface
            return IncrementalSemanticOptions{enforce_unsafe_permissions: enforce_unsafe_permissions, flow_strict: flow_strict, runtime_std: runtime_std, flow_warn: flow_warn, enable_smt: enable_smt, warn_discarded: warn_discarded, enforce_progress: enforce_progress, enforce_extern_contracts: enforce_extern_contracts, enforce_raw_unsafe: enforce_raw_unsafe, emit_proof_hole: emit_proof_hole, region_stack_cap: region_stack_cap, enforce_global_permissions: enforce_global_permissions, enforce_mutable_global_grants: enforce_mutable_global_grants, carrier_surface: carrier_surface}

        # The stable on-disk flag index for each boolean cache option.
        def incremental_semantic_options_flag(options: IncrementalSemanticOptions, index: usize) -> u8:
            ensure index < 13 or result == 0
            ensure index != 0 or result == (1 if options.enforce_unsafe_permissions else 0)
            ensure index != 1 or result == (1 if options.flow_strict else 0)
            ensure index != 2 or result == (1 if options.runtime_std else 0)
            ensure index != 3 or result == (1 if options.flow_warn else 0)
            ensure index != 4 or result == (1 if options.enable_smt else 0)
            ensure index != 5 or result == (1 if options.warn_discarded else 0)
            ensure index != 6 or result == (1 if options.enforce_progress else 0)
            ensure index != 7 or result == (1 if options.enforce_extern_contracts else 0)
            ensure index != 8 or result == (1 if options.enforce_raw_unsafe else 0)
            ensure index != 9 or result == (1 if options.emit_proof_hole else 0)
            ensure index != 10 or result == (1 if options.enforce_global_permissions else 0)
            ensure index != 11 or result == (1 if options.enforce_mutable_global_grants else 0)
            ensure index != 12 or result == (1 if options.carrier_surface else 0)
            if index == 0:
                return 1 if options.enforce_unsafe_permissions else 0
            if index == 1:
                return 1 if options.flow_strict else 0
            if index == 2:
                return 1 if options.runtime_std else 0
            if index == 3:
                return 1 if options.flow_warn else 0
            if index == 4:
                return 1 if options.enable_smt else 0
            if index == 5:
                return 1 if options.warn_discarded else 0
            if index == 6:
                return 1 if options.enforce_progress else 0
            if index == 7:
                return 1 if options.enforce_extern_contracts else 0
            if index == 8:
                return 1 if options.enforce_raw_unsafe else 0
            if index == 9:
                return 1 if options.emit_proof_hole else 0
            if index == 10:
                return 1 if options.enforce_global_permissions else 0
            if index == 11:
                return 1 if options.enforce_mutable_global_grants else 0
            if index == 12:
                return 1 if options.carrier_surface else 0
            return 0
