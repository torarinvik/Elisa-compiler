# Nominal const-enum identity for comparison checks. The ordinary expression type channel
# intentionally carries bare names, so this resolver restores declaration-module identity only
# when lexical, imported, or source-qualified evidence identifies one declaration.

extend Semantic:
    private:
        def operator_unknown_const_enum_owner() -> (known: bool, name: sview, module: sview):
            return (false, sview("", 0, 0), sview("", 0, 0))


        def operator_const_enum_owner_from_type_expr(type_expression: Ast::Expr,
                                                     table: SymbolTable&) -> (known: bool, name: sview, module: sview):
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                separators: mutable darray[bool] = []
                if type_path_collect(type_expression, names, separators) and names.count > 0:
                    last: usize = names.count - 1.usize()
                    module_count: usize = last
                    all_scope_separators: mutable bool = true
                    for separator_index in 0..<module_count |all_scope_separators, separators|:
                        all_scope_separators <- false if separators[separator_index]
                    if module_count > 0 and all_scope_separators:
                        enum_name: sview = names[last]
                        enum_index: i64 = operator_qualified_type_symbol(enum_name, names, module_count, SymbolKind.Enum, table)
                        if enum_index >= 0:
                            enum_symbol: Symbol = table.symbols[enum_index.usize()]
                            return (true, enum_symbol.name, enum_symbol.module_owner) if enum_symbol.is_const_enum
                            return operator_unknown_const_enum_owner()
                        alias_index: i64 = operator_qualified_alias_index(enum_name, names, module_count, table)
                        if alias_index >= 0:
                            alias_module: sview = table.type_alias_module[alias_index.usize()] if alias_index.usize() < table.type_alias_module.count else ""
                            alias_target: sview = table.type_alias_target[alias_index.usize()]
                            return operator_const_enum_owner_name(alias_target, alias_module, table)
                        return operator_unknown_const_enum_owner()
                    return operator_unknown_const_enum_owner() if module_count > 0
                    return operator_const_enum_owner_name(names[last], table.current_module, table)
                return operator_unknown_const_enum_owner()


        # Look up a source-annotated local's nominal owner. `bound` distinguishes an
        # unmodeled/non-enum local from a name that is not local: callers must never
        # reinterpret a local `Code` as an unrelated global enum named `Code`.
        def operator_local_const_enum_owner(name: sview, table: SymbolTable&) -> (bound: bool, known: bool, owner_name: sview, owner_module: sview):
            can Abort.Panic:
                while index > 0 |index: usize = table.local_type_names.count|:
                    index <- index - 1.usize()
                    if table.local_type_names[index] == name:
                        owner_name: sview = table.local_const_enum_owner_names[index] if index < table.local_const_enum_owner_names.count else ""
                        owner_module: sview = table.local_const_enum_owner_modules[index] if index < table.local_const_enum_owner_modules.count else ""
                        return (true, owner_name != "", owner_name, owner_module)
                return (false, false, "", "")


        # Select a uniquely named type symbol in the current module, an imported module, the
        # root namespace, or the whole file when exactly one declaration remains. Ambiguity is
        # kept explicit; never choose a same-spelled declaration merely because it was collected
        # first.
        def operator_named_type_symbol(name: sview, context_module: sview, kind: SymbolKind, table: SymbolTable&) -> i64:
            can Abort.Panic:
                selected: mutable i64 = -1
                matches: mutable usize = 0
                cursor: mutable u32 = symbol_chain_head(table, name)
                while cursor != 4294967295 |selected, matches, name, context_module, kind, table, cursor|:
                    symbol_index: usize = cursor.usize()
                    symbol: Symbol = table.symbols[symbol_index]
                    if symbol.kind == kind and symbol.name == name and symbol.module_owner == context_module:
                        selected <- symbol_index.i64()
                        matches <- matches + 1
                    cursor <- table.symbol_name_next[symbol_index]
                return selected if matches == 1
                return -1 if matches > 1
                imported_selected: mutable i64 = -1
                imported_matches: mutable usize = 0
                for imported in table.imported_modules |imported_selected, imported_matches, name, kind, table|:
                    cursor <- symbol_chain_head(table, name)
                    while cursor != 4294967295 |imported_selected, imported_matches, imported, name, kind, table, cursor|:
                        symbol_index: usize = cursor.usize()
                        symbol: Symbol = table.symbols[symbol_index]
                        if symbol.kind == kind and symbol.name == name and symbol.module_owner == imported:
                            imported_selected <- symbol_index.i64()
                            imported_matches <- imported_matches + 1
                        cursor <- table.symbol_name_next[symbol_index]
                return imported_selected if imported_matches == 1
                return -1 if imported_matches > 1
                if context_module != "":
                    selected <- -1
                    matches <- 0
                    cursor <- symbol_chain_head(table, name)
                    while cursor != 4294967295 |selected, matches, name, kind, table, cursor|:
                        symbol_index: usize = cursor.usize()
                        symbol: Symbol = table.symbols[symbol_index]
                        if symbol.kind == kind and symbol.name == name and symbol.module_owner == "":
                            selected <- symbol_index.i64()
                            matches <- matches + 1
                        cursor <- table.symbol_name_next[symbol_index]
                    return selected if matches == 1
                    return -1 if matches > 1
                selected <- -1
                matches <- 0
                cursor <- symbol_chain_head(table, name)
                while cursor != 4294967295 |selected, matches, name, kind, table, cursor|:
                    symbol_index: usize = cursor.usize()
                    symbol: Symbol = table.symbols[symbol_index]
                    if symbol.kind == kind and symbol.name == name:
                        selected <- symbol_index.i64()
                        matches <- matches + 1
                    cursor <- table.symbol_name_next[symbol_index]
                return selected if matches == 1
                return -1


        # Resolve a source-qualified enum/alias head (`Pack::State`) against declaration-module
        # rows. `names[0..module_count)` is the path to the module and the final name is supplied
        # separately. Relative paths are checked by the same rule used by type-path validation.
        def operator_qualified_type_symbol(name: sview, names: darray[sview]&, module_count: usize,
                                           kind: SymbolKind, table: SymbolTable&) -> i64:
            can Abort.Panic:
                selected: mutable i64 = -1
                matches: mutable usize = 0
                cursor: mutable u32 = symbol_chain_head(table, name)
                while cursor != 4294967295 |selected, matches, name, names, module_count, kind, table, cursor|:
                    symbol_index: usize = cursor.usize()
                    symbol: Symbol = table.symbols[symbol_index]
                    if symbol.kind == kind and symbol.name == name:
                        exact: bool = module_symbol_matches(symbol.module_owner, sview("", 0, 0), names, 0, module_count)
                        relative: bool = table.current_module != "" and module_symbol_matches_relative(symbol.module_owner, table.current_module, names, module_count)
                        if exact or relative:
                            selected <- symbol_index.i64()
                            matches <- matches + 1
                    cursor <- table.symbol_name_next[symbol_index]
                return selected if matches == 1
                return -1


        def operator_qualified_alias_index(name: sview, names: darray[sview]&, module_count: usize,
                                           table: SymbolTable&) -> i64:
            can Abort.Panic:
                selected: mutable i64 = -1
                matches: mutable usize = 0
                for alias_index in 0..<table.type_alias_name.count |selected, matches, name, names, module_count, table|:
                    alias_module: sview = table.type_alias_module[alias_index] if alias_index < table.type_alias_module.count else ""
                    exact: bool = module_symbol_matches(alias_module, sview("", 0, 0), names, 0, module_count)
                    relative: bool = table.current_module != "" and module_symbol_matches_relative(alias_module, table.current_module, names, module_count)
                    if table.type_alias_name[alias_index] == name and (exact or relative):
                        selected <- alias_index.i64()
                        matches <- matches + 1
                return selected if matches == 1
                return -1


        # Resolve an unqualified named type or alias in the lexical module context. Alias
        # targets are followed in the alias's declaring module, not the caller's module. The
        # step bound is derived from the finite alias table; cycles and non-bare targets fail
        # closed without a magic fixed-depth cutoff.
        def operator_const_enum_owner_name(type_name: sview, context_module: sview,
                                           table: SymbolTable&) -> (known: bool, name: sview, module: sview):
            can Abort.Panic:
                current_name: mutable sview = type_name
                current_module: mutable sview = context_module
                steps: mutable usize = 0
                while current_name != "" and steps <= table.type_alias_name.count |current_name, current_module, steps, table, type_name, context_module|:
                    enum_index: i64 = operator_named_type_symbol(current_name, current_module, SymbolKind.Enum, table)
                    if enum_index >= 0:
                        enum_symbol: Symbol = table.symbols[enum_index.usize()]
                        return (true, enum_symbol.name, enum_symbol.module_owner) if enum_symbol.is_const_enum
                        return operator_unknown_const_enum_owner()
                    alias_symbol_index: i64 = operator_named_type_symbol(current_name, current_module, SymbolKind.Alias, table)
                    return operator_unknown_const_enum_owner() if alias_symbol_index < 0
                    alias_symbol: Symbol = table.symbols[alias_symbol_index.usize()]
                    alias_index: mutable i64 = -1
                    alias_matches: mutable usize = 0
                    for index in 0..<table.type_alias_name.count |alias_index, alias_matches, current_name, alias_symbol, table|:
                        alias_module: sview = table.type_alias_module[index] if index < table.type_alias_module.count else ""
                        if table.type_alias_name[index] == current_name and alias_module == alias_symbol.module_owner:
                            alias_index <- index.i64()
                            alias_matches <- alias_matches + 1
                    return operator_unknown_const_enum_owner() if alias_matches != 1
                    current_name <- table.type_alias_target[alias_index.usize()]
                    current_module <- alias_symbol.module_owner
                    steps <- steps + 1
                return operator_unknown_const_enum_owner()


        def operator_const_enum_owner_qualified(head: Ast::Expr, member: sview,
                                                table: SymbolTable&) -> (known: bool, name: sview, module: sview):
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                separators: mutable darray[bool] = []
                return operator_unknown_const_enum_owner() if not type_path_collect(head, names, separators)
                return operator_unknown_const_enum_owner() if names.count < 2
                module_count: usize = names.count - 1.usize()
                # All separators before the enum name must be `::`; dotted value access is not
                # a module qualifier for an enum owner.
                for separator_index in 0..<module_count |separators|:
                    return operator_unknown_const_enum_owner() if separators[separator_index]
                enum_name: sview = names[names.count - 1.usize()]
                enum_index: i64 = operator_qualified_type_symbol(enum_name, names, module_count, SymbolKind.Enum, table)
                if enum_index >= 0:
                    enum_symbol: Symbol = table.symbols[enum_index.usize()]
                    return (true, enum_symbol.name, enum_symbol.module_owner) if enum_symbol.is_const_enum and operator_enum_has_variant(enum_symbol.name, enum_symbol.module_owner, member, table)
                    return operator_unknown_const_enum_owner()
                alias_index: i64 = operator_qualified_alias_index(enum_name, names, module_count, table)
                return operator_unknown_const_enum_owner() if alias_index < 0
                alias_module: sview = table.type_alias_module[alias_index.usize()] if alias_index.usize() < table.type_alias_module.count else ""
                alias_target: sview = table.type_alias_target[alias_index.usize()]
                alias_owner: (known: bool, name: sview, module: sview) = operator_const_enum_owner_name(alias_target, alias_module, table)
                return alias_owner if alias_owner.known and operator_enum_has_variant(alias_owner.name, alias_owner.module, member, table)
                return operator_unknown_const_enum_owner()


        def operator_enum_has_variant(enum_name: sview, enum_module: sview, member: sview,
                                      table: SymbolTable&) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < table.enum_variant_owner.count |index, enum_name, enum_module, member, table|:
                    module: sview = table.enum_variant_module[index] if index < table.enum_variant_module.count else ""
                    true return if table.enum_variant_owner[index] == enum_name and table.enum_variant_name[index] == member and module == enum_module
                    index <- index + 1.usize()
                return false


        def operator_const_enum_owner(expression: Ast::Expr, inferred: InferType,
                                      names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> (known: bool, name: sview, module: sview):
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(head, member, field_line):
                        match head:
                            Expr.Scope(_, _, _):
                                qualified_owner: (known: bool, name: sview, module: sview) = operator_const_enum_owner_qualified(head, member, table)
                                return qualified_owner if qualified_owner.known
                            Expr.Ident(enum_name, enum_line):
                                named_owner: (known: bool, name: sview, module: sview) = operator_const_enum_owner_name(enum_name, table.current_module, table)
                                return named_owner if named_owner.known and operator_enum_has_variant(named_owner.name, named_owner.module, member, table)
                            _:
                                pass
                    Expr.Ident(enum_name, enum_line):
                        local_owner: (bound: bool, known: bool, owner_name: sview, owner_module: sview) = operator_local_const_enum_owner(enum_name, table)
                        return (true, local_owner.owner_name, local_owner.owner_module) if local_owner.known
                        return operator_unknown_const_enum_owner() if local_owner.bound
                        named_owner: (known: bool, name: sview, module: sview) = operator_const_enum_owner_name(enum_name, table.current_module, table)
                        return named_owner if named_owner.known
                    _:
                        pass
                if inferred.kind == SemTypeKind.Named:
                    inferred_owner: (known: bool, name: sview, module: sview) = operator_const_enum_owner_name(inferred.name, table.current_module, table)
                    return inferred_owner if inferred_owner.known
                return operator_unknown_const_enum_owner()


        # A shorthand member is checked against the exact expected declaration, including
        # module ownership. A same-named variant from another enum/module cannot satisfy it.
        def operator_wrong_const_enum_shorthand(expression: Ast::Expr,
                                                expected_owner: (known: bool, name: sview, module: sview),
                                                table: SymbolTable&) -> sview:
            can Abort.Panic:
                return sview("", 0, 0) if not expected_owner.known
                match expression:
                    Expr.ShorthandMember(parts, shorthand_line):
                        if parts.count == 1 and not operator_enum_has_variant(expected_owner.name, expected_owner.module, parts[0], table):
                            return parts[0]
                    _:
                        pass
                return sview("", 0, 0)
