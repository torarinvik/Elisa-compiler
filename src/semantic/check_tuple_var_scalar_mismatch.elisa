# A tuple-typed local (or parameter) used where a scalar is expected — `x: i64 = t` with
# `t: (i64, i64)`. Complements the tuple-LITERAL mismatch (a `(a, b)` literal in a scalar
# slot): here the offending value is an identifier naming a tuple-typed binding. Reuses the
# existing NamedTypeMismatch diagnostic ("variable 'x' expects i64, got tuple").
#
# SOUNDNESS (zero false positives is the prime directive): a name is recorded as tuple-typed
# ONLY from a literal `(A, B, …)` type annotation (`Expr.Tuple`, read structurally from the
# AST — no type inference, no name-string sentinel). The mismatch fires only when the TARGET
# annotation is a primitive scalar AND the value is an identifier previously recorded as
# tuple-typed. Over-tracking a name across sibling scopes can only ever SUPPRESS via a later
# non-tuple shadow — verified against the whole frontend+stdlib corpus for 0 false positives.

extend Semantic:
    private:
        # Whether a type annotation is a literal tuple type `(A, B, …)` (through an optional
        # leading `mutable`).
        def is_tuple_type_annotation(type_expression: Ast::Expr) -> bool:
            match type_expression:
                Expr.Tuple(tuple_type_elements, tuple_type_line):
                    return true
                Expr.Unary(operator, operand, unary_line):
                    return is_tuple_type_annotation(operand) if operator == TokenKind.Mutable else false
                _:
                    return false

        # Whether `name` was recorded as a tuple-typed binding.
        def tuple_binding_known(name: sview, tuple_vars: darray[sview]&) -> bool:
            for candidate in tuple_vars:
                true return if candidate == name
            return false

        # The bound identifier name of an expression, or "" when it is not a bare identifier.
        def ident_name_of(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Ident(ident_value, ident_line):
                    return ident_value
                _:
                    return ""

        # Check every positional argument of a direct call: a tuple-typed-var argument passed
        # to a primitive-scalar parameter is a mismatch. Reuses FirmArgTypeMismatch (the same
        # kind used for tuple LITERAL args), so the message reads "argument to 'g' expects i64,
        # got tuple". No block-if (docs/125): value-ifs + a postfix guard.
        def check_tuple_call_args(fn_name: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], line: u32, tuple_vars: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                argument_index: mutable usize = 0
                while argument_index < arguments.count |table|:
                    arg_ident: sview = ident_name_of(arguments[argument_index]) if argument_names[argument_index] == "" else ""
                    is_tuple_arg: bool = arg_ident != "" and tuple_binding_known(arg_ident, tuple_vars)
                    param_type: sview = function_parameter_type_at_firm(table, fn_name, argument_index) if is_tuple_arg else ""
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, line: line, expected: param_type, actual: "tuple"}) if is_tuple_arg and is_primitive_type(param_type)
                    argument_index <- argument_index + 1

        # Compact expression walker: find direct calls and check their tuple-typed-var args.
        # Covers the common call-bearing positions; exotic nesting is a sound MISS, never a FP.
        # `tuple_vars` is read-only here (built by the statement walker).
        def walk_expr_for_tuple_call_args(expression: Ast::Expr, tuple_vars: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        table <- check_tuple_call_args(callee_name, arguments, argument_names, line, tuple_vars, table) if callee_name != "" and direct_function_count(table, callee_name) == 1
                        for argument in arguments |table|:
                            table <- walk_expr_for_tuple_call_args(argument, tuple_vars, table)
                    Expr.Binary(left, operator, right, line):
                        # An ordering comparison (`< > <= >=`) with a tuple-typed-var operand is
                        # non-numeric — the same finding the operator checks already emit for a
                        # tuple LITERAL operand (kind_is_firm_non_numeric), here for a tuple VAR
                        # (whose inferred type is Unknown, so those checks miss it).
                        is_ordering: bool = operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
                        ordering_has_tuple: bool = tuple_binding_known(ident_name_of(left), tuple_vars) or tuple_binding_known(ident_name_of(right), tuple_vars)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrderingNonNumeric, name: "", line: line, expected: "", actual: ""}) if is_ordering and ordering_has_tuple
                        table <- walk_expr_for_tuple_call_args(left, tuple_vars, table)
                        table <- walk_expr_for_tuple_call_args(right, tuple_vars, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Unary(operator, operand, line):
                        table <- walk_expr_for_tuple_call_args(operand, tuple_vars, table)
                    Expr.Paren(inner, line):
                        table <- walk_expr_for_tuple_call_args(inner, tuple_vars, table)
                    Expr.Field(object, field, line):
                        table <- walk_expr_for_tuple_call_args(object, tuple_vars, table)
                    Expr.Index(object, index, line):
                        table <- walk_expr_for_tuple_call_args(object, tuple_vars, table)
                        table <- walk_expr_for_tuple_call_args(index, tuple_vars, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expr_for_tuple_call_args(element, tuple_vars, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expr_for_tuple_call_args(element, tuple_vars, table)
                    _:
                        pass

        # Walk statements, tracking tuple-typed locals and flagging tuple→scalar var decls and
        # `return`s. `return_scalar` is the enclosing function's return type name when it is a
        # primitive scalar (else ""), used to flag `return t` with a tuple-typed `t`.
        def check_tuple_var_scalar_statements(statements: darray[Ast::Stmt], tuple_vars: mutable darray[sview]&, return_scalar: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            target_type: sview = bare_type_name(type_expression)
                            # Extract the value's identifier name via a helper (a sanctioned
                            # decision), "" when the value is not a bare identifier. Kept out of
                            # the postfix guard because stage1 does not carry an `is`-binding into
                            # the rest of the same boolean condition.
                            value_ident_name: sview = ident_name_of(value)
                            value_is_tuple: bool = value_ident_name != "" and tuple_binding_known(value_ident_name, tuple_vars)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: name, line: line, expected: target_type, actual: "tuple"}) if is_primitive_type(target_type) and value_is_tuple
                            table <- walk_expr_for_tuple_call_args(value, tuple_vars, table)
                            tuple_vars.push(name) if is_tuple_type_annotation(type_expression)
                        Stmt.Return(value, line):
                            return_ident_name: sview = ident_name_of(returned) if value is returned else ""
                            return_is_tuple: bool = return_ident_name != "" and tuple_binding_known(return_ident_name, tuple_vars)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: "return", line: line, expected: return_scalar, actual: "tuple"}) if return_scalar != "" and return_is_tuple
                            table <- walk_expr_for_tuple_call_args(returned, tuple_vars, table) if value is returned
                        Stmt.Expr(expression, line):
                            table <- walk_expr_for_tuple_call_args(expression, tuple_vars, table)
                        Stmt.Assign(assign_target, assign_operator, assign_value, line):
                            table <- walk_expr_for_tuple_call_args(assign_value, tuple_vars, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_tuple_var_scalar_statements(then_body, tuple_vars, return_scalar, table)
                            table <- check_tuple_var_scalar_statements(else_body, tuple_vars, return_scalar, table)
                        Stmt.While(condition, body, line):
                            table <- check_tuple_var_scalar_statements(body, tuple_vars, return_scalar, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_tuple_var_scalar_statements(body, tuple_vars, return_scalar, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_tuple_var_scalar_statements(body, tuple_vars, return_scalar, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_tuple_var_scalar_statements(arm.body, tuple_vars, return_scalar, table)
                        _:
                            pass

    public:
        # Entry point: per function, seed tuple-typed parameters then walk the body.
        def check_tuple_var_scalar_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            tuple_vars: mutable darray[sview] = []
                            for parameter in params:
                                tuple_vars.push(parameter.name) if is_tuple_type_annotation(parameter.type_expression)
                            # The function's return type name, but only when it is a primitive
                            # scalar (so `return t` with a tuple `t` flags; a tuple/named return
                            # type yields "" and never fires).
                            return_type_bare: sview = bare_type_name(return_type_expr) if return_type is return_type_expr else ""
                            return_scalar: sview = return_type_bare if is_primitive_type(return_type_bare) else ""
                            table <- check_tuple_var_scalar_statements(body, tuple_vars, return_scalar, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_tuple_var_scalar_mismatch(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_tuple_var_scalar_mismatch(scoped_body, table)
                        _:
                            pass
