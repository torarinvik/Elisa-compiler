# A NON-SCALAR-typed local (or parameter) used where a scalar is expected — e.g. `x: i64 = t`
# with `t: (a: i64, b: i64)` (a tuple), or `x: i64 = xs` with `xs: darray[i64]` (a container).
# Complements the LITERAL mismatches (a `(a, b)` literal in a scalar slot): here the offending
# value is an identifier naming a non-scalar-typed binding. Reuses existing diagnostics
# (NamedTypeMismatch / FirmArgTypeMismatch / the operator-operand kinds), tagging the finding
# with the binding's family ("tuple" or "container").
#
# SOUNDNESS (zero false positives is the prime directive): a name is recorded as non-scalar
# ONLY from a literal tuple annotation `(A, B, …)` (`Expr.Tuple`) or a container annotation
# `darray[..]`/`dict[..]`/`set[..]`/`list[..]` (`Expr.Index`/`IndexN` on those heads) — read
# structurally from the AST, no type inference, no name-string sentinel. A finding fires only
# when the target/parameter is a primitive scalar (mismatch checks) or the operator requires a
# numeric operand — a tuple/container is never a valid inhabitant of either. Verified against
# the whole frontend+stdlib corpus for 0 false positives.

extend Semantic:
    private:
        # The family of a NON-scalar type annotation: "tuple" for a literal tuple type, or
        # "container" for a darray/dict/set/list generic; "" for anything else (scalars, named
        # types, refs, …). Sees through a leading `mutable`.
        def annotation_family(type_expression: Ast::Expr) -> sview:
            match type_expression:
                Expr.Tuple(tuple_type_elements, tuple_type_line):
                    return "tuple"
                Expr.Unary(operator, operand, unary_line):
                    # Postfix `T?` (optional) parses to a Question unary (parser_expr_ops). An
                    # optional used where its base type is expected is an error — stage0 emits
                    # "expects T, got T?" (mandatory unwrap). Tagged family "optional".
                    "optional" return if operator == TokenKind.Question
                    "" return if operator != TokenKind.Mutable
                    return annotation_family(operand)
                Expr.Lambda(fn_type_parameters, fn_type_body, fn_type_line):
                    # A `fn(A) -> B` type ANNOTATION is an Expr.Lambda — the parser routes the
                    # type through the lambda reader and keeps the signature in side tables
                    # (fn_type_param_exprs, `__lambda_return`). Without a family here a
                    # `fn`-typed binding was invisible to every check in this file, so
                    # `return f` from an `-> i64` function was ACCEPTED where stage0 says
                    # "return type expects i64, got fn(i64) -> i64". The backend now declines
                    # that function rather than emitting `ret ptr` from an i64 body; this is
                    # the acceptance half.
                    return "fn"
                Expr.Index(object, index, line):
                    head_name: sview = ident_name_of(object)
                    "container" return if head_name == "darray" or head_name == "dict" or head_name == "set" or head_name == "list"
                    return ""
                Expr.IndexN(object, arguments, line):
                    head_name_n: sview = ident_name_of(object)
                    "container" return if head_name_n == "darray" or head_name_n == "dict" or head_name_n == "set" or head_name_n == "list"
                    return ""
                _:
                    return ""

        # The recorded family of binding `name` ("tuple"/"container"), or "" if it is not a
        # tracked non-scalar binding. `names` and `families` are parallel.
        def binding_family(name: sview, names: darray[sview]&, families: darray[sview]&) -> sview:
            while family_index < names.count |family_index: usize = 0|:
                families[family_index] return if names[family_index] == name
                family_index <- family_index + 1
            return ""

        # Record a binding as non-scalar iff its annotation has a family. Pushes name+family in
        # lockstep (both guarded on the same condition, so the parallel arrays stay aligned).
        def record_nonscalar(name: sview, type_expression: Ast::Expr, names: mutable darray[sview]&, families: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                fam: sview = annotation_family(type_expression)
                names.push(name) if fam != ""
                families.push(fam) if fam != ""

        # The bound identifier name of an expression, or "" when it is not a bare identifier.
        def ident_name_of(expression: Ast::Expr) -> sview:
            match expression:
                Expr.Ident(ident_value, ident_line):
                    return ident_value
                _:
                    return ""

        # Check every positional argument of a direct call: a non-scalar-var argument passed to
        # a primitive-scalar parameter is a mismatch (reuses FirmArgTypeMismatch).
        def check_nonscalar_call_args(fn_name: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], line: u32, names: darray[sview]&, families: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                argument_index: mutable usize = 0
                while argument_index < arguments.count |table|:
                    arg_ident: sview = ident_name_of(arguments[argument_index]) if argument_names[argument_index] == "" else ""
                    arg_family: sview = binding_family(arg_ident, names, families) if arg_ident != "" else ""
                    param_type: sview = function_parameter_type_at_firm(table, fn_name, argument_index) if arg_family != "" else ""
                    arg_tuple_row: i64 = tuple_binding_row_of(arg_ident, table) if arg_family == "tuple" else (-1)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TupleValueMismatch, name: fn_name, line: line, expected: param_type, actual: table.tuple_binding_l1[arg_tuple_row.usize()], detail: table.tuple_binding_t1[arg_tuple_row.usize()], detail2: table.tuple_binding_l2[arg_tuple_row.usize()], detail3: table.tuple_binding_t2[arg_tuple_row.usize()], expected_count: (argument_index + 1).u32()}) if arg_tuple_row >= 0 and is_primitive_type(param_type)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: fn_name, line: line, expected: param_type, actual: arg_family, expected_count: (argument_index + 1).u32()}) if arg_tuple_row < 0 and arg_family != "" and is_primitive_type(param_type)
                    argument_index <- argument_index + 1

        # Compact expression walker: find direct calls and operator misuse of non-scalar vars.
        # Covers common positions; exotic nesting is a sound MISS, never a FP. `names`/`families`
        # are read-only here (built by the statement walker).
        def walk_expr_for_nonscalar(expression: Ast::Expr, names: darray[sview]&, families: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        table <- check_nonscalar_call_args(callee_name, arguments, argument_names, line, names, families, table) if callee_name != "" and direct_function_count(table, callee_name) == 1
                        for argument in arguments |table|:
                            table <- walk_expr_for_nonscalar(argument, names, families, table)
                    Expr.Binary(left, operator, right, line):
                        # An operator requiring a numeric operand applied to a non-scalar-var
                        # operand — the tuple/container-VAR analogue of the existing operand
                        # checks for LITERALS (whose inferred type those checks can see).
                        left_family: sview = binding_family(ident_name_of(left), names, families)
                        right_family: sview = binding_family(ident_name_of(right), names, families)
                        operand_family: sview = left_family if left_family != "" else right_family
                        is_ordering: bool = operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrderingNonNumeric, name: "", line: line, expected: "", actual: ""}) if is_ordering and operand_family != ""
                        is_arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericOperand, name: token_text(operator), line: line, expected: "number", actual: operand_family}) if is_arithmetic and operand_family != ""
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NonNumericShiftOperand, name: "", line: line, expected: "", actual: ""}) if is_shift_or_bitwise_operator(operator) and operand_family != ""
                        table <- walk_expr_for_nonscalar(left, names, families, table)
                        table <- walk_expr_for_nonscalar(right, names, families, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Unary(operator, operand, line):
                        table <- walk_expr_for_nonscalar(operand, names, families, table)
                    Expr.Paren(inner, line):
                        table <- walk_expr_for_nonscalar(inner, names, families, table)
                    Expr.Field(object, field, line):
                        table <- walk_expr_for_nonscalar(object, names, families, table)
                    Expr.Index(object, index, line):
                        table <- walk_expr_for_nonscalar(object, names, families, table)
                        table <- walk_expr_for_nonscalar(index, names, families, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expr_for_nonscalar(element, names, families, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expr_for_nonscalar(element, names, families, table)
                    _:
                        pass

        # Walk statements, tracking non-scalar locals and flagging non-scalar→scalar var decls,
        # `return`s, and operator/argument misuse. `return_scalar` is the enclosing function's
        # return type name when it is a primitive scalar (else "").
        def check_nonscalar_var_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, families: mutable darray[sview]&, return_scalar: sview, checked_get_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            target_type: sview = bare_type_name(type_expression)
                            value_ident_name: sview = ident_name_of(value)
                            value_family: mutable sview = binding_family(value_ident_name, names, families) if value_ident_name != "" else ""
                            value_head: mutable sview = interned_name(local_type_id_of(value_ident_name, table), table) if value_family == "container" else value_family
                            value_elem: sview = type_name_of_row(interned_elem(local_type_id_of(value_ident_name, table), 0, table), table) if value_family == "container" else ""
                            # An optional binding prints its BASE type (stage0: T? mismatch
                            # reads "expects i64, got i64" — the wrapper is elided).
                            optional_base: sview = type_name_of_row(interned_elem(local_type_id_of(value_ident_name, table), 0, table), table) if value_family == "optional" else ""
                            value_head <- optional_base if value_family == "optional" and optional_base != ""
                            # `x: T = get o` — a mandatory unwrap that yields o's BASE type, so
                            # the optional-family mismatch must not fire (the value is no longer
                            # optional). The parser marks the get's line with `__checked_get`.
                            unwrapped_get: bool = value_family == "optional" and (any get_line in checked_get_lines where get_line == line)
                            value_family <- "" if unwrapped_get
                            var_tuple_row: i64 = tuple_binding_row_of(value_ident_name, table) if value_family == "tuple" else (-1)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TupleValueMismatch, name: name, line: line, expected: target_type, actual: table.tuple_binding_l1[var_tuple_row.usize()], detail: table.tuple_binding_t1[var_tuple_row.usize()], detail2: table.tuple_binding_l2[var_tuple_row.usize()], detail3: table.tuple_binding_t2[var_tuple_row.usize()], expected_count: 0}) if var_tuple_row >= 0 and is_primitive_type(target_type)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: name, line: line, expected: target_type, actual: value_head if value_head != "" else value_family, detail: value_elem}) if var_tuple_row < 0 and is_primitive_type(target_type) and value_family != ""
                            # (`n: bool = xs.count` is now owned by the type ENGINE — the
                            # Field arm of infer_expression_type types container size
                            # fields Int, so check_value_against flags the mismatch.)
                            table <- walk_expr_for_nonscalar(value, names, families, table)
                            record_nonscalar(name, type_expression, names, families)
                        Stmt.Return(value, line):
                            return_ident_name: sview = ident_name_of(returned) if value is returned else ""
                            # NOT extended to a struct LITERAL (`return P{x: 1}` from an
                            # `-> i64` function, which stage0 rejects with "got P"). Tried, and
                            # it is a FALSE POSITIVE generator without alias resolution: the
                            # std returns `StringView{...}` from functions declared `-> sview`,
                            # and `sview` IS `StringView`. It fired three times on the compiler's
                            # own source, broke the self-host, and failed 3 of the 574 stage0
                            # acceptance cases. Needs the alias table before it can be reinstated.
                            return_family: sview = binding_family(return_ident_name, names, families) if return_ident_name != "" else ""
                            return_tuple_row: i64 = tuple_binding_row_of(return_ident_name, table) if return_family == "tuple" else (-1)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TupleValueMismatch, name: "return", line: line, expected: return_scalar, actual: table.tuple_binding_l1[return_tuple_row.usize()], detail: table.tuple_binding_t1[return_tuple_row.usize()], detail2: table.tuple_binding_l2[return_tuple_row.usize()], detail3: table.tuple_binding_t2[return_tuple_row.usize()], expected_count: 0}) if return_tuple_row >= 0 and return_scalar != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: "return", line: line, expected: return_scalar, actual: return_family}) if return_tuple_row < 0 and return_scalar != "" and return_family != ""
                            table <- walk_expr_for_nonscalar(returned, names, families, table) if value is returned
                        Stmt.Expr(expression, line):
                            table <- walk_expr_for_nonscalar(expression, names, families, table)
                        Stmt.Assign(assign_target, assign_operator, assign_value, line):
                            target_family: sview = binding_family(ident_name_of(assign_target), names, families)
                            avalue_family: sview = binding_family(ident_name_of(assign_value), names, families)
                            assign_nonscalar: bool = target_family != "" or avalue_family != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CompoundAssignNonNumeric, name: "", line: line, expected: "", actual: ""}) if is_compound_assign_operator(assign_operator) and assign_nonscalar
                            table <- walk_expr_for_nonscalar(assign_value, names, families, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_nonscalar_var_statements(then_body, names, families, return_scalar, checked_get_lines, table)
                            table <- check_nonscalar_var_statements(else_body, names, families, return_scalar, checked_get_lines, table)
                        Stmt.While(condition, body, line):
                            table <- check_nonscalar_var_statements(body, names, families, return_scalar, checked_get_lines, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_nonscalar_var_statements(body, names, families, return_scalar, checked_get_lines, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_nonscalar_var_statements(body, names, families, return_scalar, checked_get_lines, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_nonscalar_var_statements(arm.body, names, families, return_scalar, checked_get_lines, table)
                        _:
                            pass

        # Record a two-field tuple annotation's (labels, types) for `binding` from
        # the parser's __tuple_label rows at the annotation's line.
        def record_tuple_binding_spelling(binding: sview, type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if type_expression is Expr.Tuple(tuple_elements, tuple_line):
                    return if tuple_elements.count != 2
                    label1: mutable sview = ""
                    label2: mutable sview = ""
                    for annotation in annotations |label1, label2|:
                        continue if annotation.owner != "__tuple_label" or annotation.line != tuple_line
                        label2 <- annotation.name if label1 != "" and label2 == ""
                        label1 <- annotation.name if label1 == ""
                    return if label1 == "" or label2 == ""
                    table.tuple_binding_names <- table.tuple_binding_names.push(binding)
                    table.tuple_binding_l1 <- table.tuple_binding_l1.push(label1)
                    table.tuple_binding_t1 <- table.tuple_binding_t1.push(ident_name_of(tuple_elements[0]))
                    table.tuple_binding_l2 <- table.tuple_binding_l2.push(label2)
                    table.tuple_binding_t2 <- table.tuple_binding_t2.push(ident_name_of(tuple_elements[1]))

        def collect_tuple_spellings_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- record_tuple_binding_spelling(name, type_expression, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- collect_tuple_spellings_statements(then_body, annotations, table)
                            table <- collect_tuple_spellings_statements(else_body, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- collect_tuple_spellings_statements(body, annotations, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- collect_tuple_spellings_statements(body, annotations, table)
                        _:
                            pass

        # The channel row index for `binding` (-1 when untracked).
        def tuple_binding_row_of(binding: sview, table: SymbolTable&) -> i64:
            can Abort.Panic:
                row: mutable usize = 0
                while row < table.tuple_binding_names.count |row|:
                    row.i64() return if table.tuple_binding_names[row] == binding
                    row <- row + 1
                return (-1)

    public:
        def collect_tuple_binding_spellings(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in file.top_decls |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for parameter in params |table|:
                                table <- record_tuple_binding_spelling(parameter.name, parameter.type_expression, file.enum_annotations, table)
                            table <- collect_tuple_spellings_statements(body, file.enum_annotations, table)
                        _:
                            pass

        # Entry point: per function, seed non-scalar parameters then walk the body.
        def tuple_var_scalar_walk(declarations: darray[Ast::Decl], checked_get_lines: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            ns_names: mutable darray[sview] = []
                            ns_families: mutable darray[sview] = []
                            for parameter in params |ns_names, ns_families|:
                                record_nonscalar(parameter.name, parameter.type_expression, ns_names, ns_families)
                            return_type_bare: sview = bare_type_name(return_type_expr) if return_type is return_type_expr else ""
                            return_scalar: sview = return_type_bare if is_primitive_type(return_type_bare) else ""
                            table <- check_nonscalar_var_statements(body, ns_names, ns_families, return_scalar, checked_get_lines, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- tuple_var_scalar_walk(module_body, checked_get_lines, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- tuple_var_scalar_walk(scoped_body, checked_get_lines, table)
                        _:
                            pass

        def check_tuple_var_scalar_mismatch(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # `get o` (mandatory unwrap) strips to a bare `Expr.Ident("o")` in the AST but
                # UNWRAPS o's optional type — the parser records a `__checked_get` marker at its
                # line. Collect those lines so the optional-family mismatch is suppressed for a
                # `x: T = get o` initializer (its value is non-optional).
                checked_get_lines: mutable darray[u32] = [annotation.line for annotation in file.enum_annotations if annotation.owner == "__checked_get"]
                table <- tuple_var_scalar_walk(file.top_decls, checked_get_lines, table)
