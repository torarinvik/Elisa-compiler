# `@boundary_pointer_args(p)` marks parameter p as an address-space pointer crossing the unsafe
# boundary; its type must be a typed carrier — GuestVAddr[T], HostPtr[T], NativeMappedGuestPtr[T].
# A plain pointer type is rejected. SOUND subset: the parameter type must resolve (through one
# level of type-alias) to a BARE named type (e.g. `uintptr`, or `VAddr = uintptr`) that is not a
# carrier — its source-backed name renders exactly. Compound spellings (`mutable void&?&?`) need a
# full type renderer and are a conservative miss; genuine carriers are `Index` types, never bare
# idents, so they are never flagged.
extend Semantic:
    private:
        def bp_collect_aliases(declarations: darray[Ast::Decl], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, alias_line):
                            names.push(alias_name)
                            values.push(alias_value)
                        Decl.Module(module_name, module_body, module_line):
                            bp_collect_aliases(module_body, names, values)
                        Decl.Scoped(scoped_body, scoped_line):
                            bp_collect_aliases(scoped_body, names, values)
                        _:
                            pass

        def bp_is_carrier(name: sview) -> bool:
            can Abort.Panic:
                return name == "GuestVAddr" or name == "HostPtr" or name == "NativeMappedGuestPtr"

        def bp_ident_name_of(expression: Ast::Expr) -> sview:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(ident_name, line): ident_name
                    Expr.Unary(operator, operand, unary_line): bp_ident_name_of(operand)
                    Expr.Paren(inner, paren_line): bp_ident_name_of(inner)
                    _: sview("", 0, 0)

        # The bare named type a parameter annotation resolves to (through one alias level), else "".
        # Non-bare-ident types (refs, optionals, generics) resolve to "" (conservative miss); an
        # alias to a compound type also resolves to "" (its rendered spelling is unavailable here).
        def bp_resolve_bare(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                name: sview = bp_ident_name_of(type_expression)
                "" return if name == ""
                index: mutable usize = 0
                resolved: mutable sview = name
                while index < alias_names.count |resolved, index|:
                    resolved <- bp_ident_name_of(alias_values[index]) if alias_names[index] == name
                    index <- index + 1
                return resolved

        # The parameter named NAME, and whether it was found, from a parameter list.
        def bp_param_type(parameters: darray[Ast::ParamDecl], name: sview) -> (found: bool, type_expression: Ast::Expr):
            can Abort.Panic:
                for parameter in parameters:
                    (true, parameter.type_expression) return if parameter.name == name
                return (false, (Ast::Expr.Absent))

        def bp_check_decorator_arg(function_name: sview, parameters: darray[Ast::ParamDecl], param_name: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                located: (found: bool, type_expression: Ast::Expr) = bp_param_type(parameters, param_name)
                return if not located.found
                bare: sview = bp_resolve_bare(located.type_expression, alias_names, alias_values)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BoundaryPointerArgsType, name: function_name, line: 0, expected: param_name, actual: bare}) if bare != "" and not bp_is_carrier(bare)

        def check_boundary_pointer_args_decls(declarations: darray[Ast::Decl], annotation_args: darray[sview]&, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            for decorator in decorators |table| -> table:
                                arg_index: mutable u32 = 0
                                for arg_offset in 0..<decorator.arg_count |table, arg_index| -> table:
                                    slot: usize = decorator.arg_start.usize() + arg_index.usize()
                                    param_name: sview = annotation_args[slot] if decorator.name == "boundary_pointer_args" and slot < annotation_args.count else sview("", 0, 0)
                                    table <- bp_check_decorator_arg(name, parameters, param_name, alias_names, alias_values, table) if param_name != ""
                                    arg_index <- arg_index + 1
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_boundary_pointer_args_decls(module_body, annotation_args, alias_names, alias_values, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_boundary_pointer_args_decls(scoped_body, annotation_args, alias_names, alias_values, table)
                        _:
                            pass

    public:
        def check_boundary_pointer_args(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_values: mutable darray[Ast::Expr] = []
                bp_collect_aliases(file.top_decls, alias_names, alias_values)
                table <- check_boundary_pointer_args_decls(file.top_decls, file.annotation_args, alias_names, alias_values, table)
