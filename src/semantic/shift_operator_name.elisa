# The integral-only operators diagnosed by the semantic shift operand checker.
module ShiftOperatorName:
    public:
        def is_shift_operator(operator: Lexer::TokenKind) -> bool:
            ensure result == (operator == Lexer::TokenKind.LShift or operator == Lexer::TokenKind.RShift)
            return when operator:
                Lexer::TokenKind.LShift | Lexer::TokenKind.RShift -> true
                _ -> false
