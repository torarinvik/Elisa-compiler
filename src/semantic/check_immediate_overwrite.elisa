# Immediate overwrite check: detects adjacent statements where a variable is written
# and then immediately overwritten without reading the first value.
# Only flags plain `<-` assignment when the second statement immediately follows
# the first in the same statement list.

extend Semantic:
    private:
        # Check a list of statements for immediate overwrites.
        # Looks for adjacent pairs where the first writes to a variable
        # and the second immediately overwrites it without reading the value.
        def check_immediate_overwrite_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # `index + 1 < count` (not `index < count - 1`): count is usize, so the
                # subtraction underflows on an EMPTY statement list and walks out of bounds.
                index: mutable usize = 0
                while index + 1 < statements.count:
                    current_stmt: Ast::Stmt = statements[index]
                    next_stmt: Ast::Stmt = statements[index + 1]

                    # Extract the name and line from the first statement
                    first_name: mutable sview = ""
                    first_line: mutable u32 = 0

                    match current_stmt:
                        Stmt.VarDecl(name, type_expression, value, line):
                            first_name <- name
                            first_line <- line
                        Stmt.Assign(target, operator, value, line):
                            if operator == TokenKind.LArrow:
                                if target is Expr.Ident(name, tl):
                                    first_name <- name
                                    first_line <- line
                        _:
                            pass

                    # Check if the next statement overwrites the same variable
                    # For now, we only flag the simple case where the second value
                    # is an integer literal or string literal (conservative check)
                    if first_name != "":
                        match next_stmt:
                            Stmt.Assign(target, operator, value2, line):
                                if operator == TokenKind.LArrow:
                                    if target is Expr.Ident(second_name, tl):
                                        if second_name == first_name:
                                            # Conservative: only flag if value2 is a simple literal
                                            # or doesn't contain Lambda/Block/Ident
                                            is_simple_literal: bool = match value2:
                                                Expr.IntLit(v): true
                                                Expr.FloatLit(t): true
                                                Expr.StringLit(t): true
                                                Expr.CharLit(t): true
                                                Expr.BoolLit(b): true
                                                _: false

                                            has_lambda_or_block: bool = match value2:
                                                Expr.Lambda(p, b, l): true
                                                Expr.Block(s, v, c, l): true
                                                _: false

                                            # Flag if it's a simple literal or if it doesn't have Lambda/Block
                                            # (but we're being conservative and only flagging simple literals for now
                                            # to avoid false positives)
                                            if is_simple_literal and not has_lambda_or_block:
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ImmediateOverwrite, name: first_name, line: first_line, expected: "", actual: ""})
                            _:
                                pass

                    index <- index + 1

                # Recursively walk nested statements
                for statement in statements |table|:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_immediate_overwrite_statements(then_body, table)
                            table <- check_immediate_overwrite_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_immediate_overwrite_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_immediate_overwrite_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_immediate_overwrite_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_immediate_overwrite_statements(arm.body, table)
                        _:
                            pass


        # Entry point: check all declarations for immediate overwrites in function bodies.
        def check_immediate_overwrite(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_immediate_overwrite_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_immediate_overwrite(body, table)
                        Decl.Scoped(body, line):
                            table <- check_immediate_overwrite(body, table)
                        _:
                            pass
