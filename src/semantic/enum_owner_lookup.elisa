# Resolve duplicate enum leaf names using the same lexical/import precedence as
# source type lookup. This path runs only when the leaf has multiple owners.
extend Semantic:
    private:
        def enum_ambiguous_owner(enum_name: sview, table: SymbolTable&) -> (known: bool, name: sview):
            can Abort.Panic:
                lexical: mutable sview = ""
                lexical_found: mutable bool = false
                cursor: mutable u32 = enum_owner_chain_head(table, enum_name)
                while cursor != SYMBOL_INDEX_ROW_NONE |cursor, lexical, lexical_found, enum_name, table|:
                    row: usize = cursor.usize()
                    module: sview = table.enum_variant_module[row]
                    if module != "" and semantic_import_scope_visible(module, table.current_module):
                        if not lexical_found or module.len > lexical.len:
                            lexical <- module
                            lexical_found <- true
                    cursor <- table.enum_owner_next[row]
                return (true, lexical) if lexical_found
                # An unresolved import can introduce an equally visible owner.
                return (false, "") if semantic_possible_import_name_visible(table, enum_name, table.current_module)
                wildcard: mutable sview = ""
                wildcard_scope: mutable usize = 0
                wildcard_line: mutable u32 = 0
                wildcard_offset: mutable u32 = 0
                wildcard_found: mutable bool = false
                wildcard_ambiguous: mutable bool = false
                for import_row in table.definite_import_annotations |wildcard, wildcard_scope, wildcard_line, wildcard_offset, wildcard_found, wildcard_ambiguous, enum_name, table|:
                    continue if import_row.name != "__binding_wildcard_import" or not semantic_import_scope_visible(import_row.module, table.current_module)
                    candidate: mutable u32 = enum_owner_chain_head(table, enum_name)
                    while candidate != SYMBOL_INDEX_ROW_NONE |candidate, wildcard, wildcard_scope, wildcard_line, wildcard_offset, wildcard_found, wildcard_ambiguous, import_row, table|:
                        row: usize = candidate.usize()
                        module: sview = table.enum_variant_module[row]
                        if semantic_import_module_path_matches(module, import_row.owner, import_row.module):
                            if not wildcard_found or import_row.module.len > wildcard_scope:
                                wildcard <- module
                                wildcard_scope <- import_row.module.len
                                wildcard_line <- import_row.line
                                wildcard_offset <- import_row.offset
                                wildcard_found <- true
                                wildcard_ambiguous <- false
                            elif import_row.module.len == wildcard_scope and wildcard != module:
                                # A relative path resolves through the closest lexical
                                # module before falling back to the same root spelling.
                                if wildcard_line != import_row.line or wildcard_offset != import_row.offset:
                                    wildcard_ambiguous <- true
                                elif module.len > wildcard.len:
                                    wildcard <- module
                                    wildcard_ambiguous <- false
                                elif module.len == wildcard.len:
                                    wildcard_ambiguous <- true
                        candidate <- table.enum_owner_next[row]
                return (not wildcard_ambiguous, wildcard) if wildcard_found
                selected: mutable sview = ""
                selected_found: mutable bool = false
                selected_ambiguous: mutable bool = false
                cursor <- enum_owner_chain_head(table, enum_name)
                while cursor != SYMBOL_INDEX_ROW_NONE |cursor, selected, selected_found, selected_ambiguous, enum_name, table|:
                    row: usize = cursor.usize()
                    module: sview = table.enum_variant_module[row]
                    if callable_program_selective_import_row(table.definite_import_annotations, enum_name, module):
                        selected_ambiguous <- true if selected_found and selected != module
                        selected <- module
                        selected_found <- true
                    cursor <- table.enum_owner_next[row]
                return (not selected_ambiguous, selected) if selected_found
                return (false, "")
