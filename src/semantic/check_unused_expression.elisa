# Unused-expression check: flag statements whose top-level expression is pure
# and side-effect-free (e.g., `x + 1` with no effect). Recurses into nested
# statement bodies (if/while/for/match arms) but does not descend into sub-expressions.

extend Semantic:
    private:
        # Whether an expression is pure and side-effect-free. Only specific variants
        # are flagged: literals, identifiers, field access, and operators (binary/unary).
        # Function calls, constructs, comprehensions, and control-flow expressions are
        # never flagged (they have side effects or produce values for control flow).
        def is_pure_unused_expr(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        return true
                    Expr.IntLit(value):
                        return true
                    Expr.FloatLit(text):
                        return true
                    Expr.StringLit(text):
                        return true
                    Expr.CharLit(text):
                        return true
                    Expr.BoolLit(value):
                        return true
                    Expr.Binary(left, operator, right, line):
                        return true
                    Expr.Unary(operator, operand, line):
                        return true
                    Expr.Paren(inner, line):
                        return true
                    Expr.Field(object, field, line):
                        return true
                    _:
                        return false


        # Check statements for unused expressions. Recurses into nested statement
        # bodies (if/while/for/match arms) but only inspects the top-level expression
        # of each Stmt.Expr node.
        def check_unused_expressions(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            if is_pure_unused_expr(expression):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnusedExpression, name: "", line: line, expected: "", actual: ""})
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_unused_expressions(then_body, table)
                            table <- check_unused_expressions(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_unused_expressions(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_unused_expressions(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_unused_expressions(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_unused_expressions(arm.body, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Entry point: check all function bodies and module bodies for unused expressions.
        def check_unused_expression(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for decl in declarations |table| -> table:
                    match decl:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_unused_expressions(body, table)
                        Decl.Module(name, body, line):
                            table <- check_unused_expression(body, table)
                        Decl.Scoped(body, line):
                            table <- check_unused_expression(body, table)
                        Decl.Struct(name, members, affinity, line):
                            pass
                        Decl.Enum(name, variants, line):
                            pass
                        Decl.Alias(name, target, line):
                            pass
                        Decl.Law(name, predicate, line):
                            pass
                        Decl.Const(name, type_expression, value, is_mutable, line):
                            pass
                        Decl.Extern(name, line):
                            pass
                        Decl.Import(module, line):
                            pass
                        Decl.Invalid:
                            pass
