# Every name a function binds, counted with repeats: parameters, declarations, untyped `x = v`
# bindings, loop variables, block bindings, match-arm and `is` binders, lambda parameters and
# comprehension variables. The reference checks (check_ref_value_copy, check_borrow_after_move)
# read a binding by NAME, so a name bound more than once is a shadow they cannot see through and
# they skip it. `*` marks a pattern this walk cannot read; a function holding one is skipped whole.
extend Semantic:
    private:
        struct BorrowBinders:
            names: mutable darray[sview]
            slots: mutable darray[u32] = []
            repeats: mutable darray[u32] = []
            # Direct binders of AST-owned variable-length payloads in an `is` pattern.
            ast_payload_slices: mutable darray[sview] = []
            ast_payload_subject_names: mutable darray[sview] = []
            ast_payload_subject_positions: mutable darray[Ast::Pos] = []
            ast_payload_subject_type_names: mutable darray[sview] = []

        def borrow_binders_pattern(pattern: Ast::Pattern, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(binding_name):
                        out.push(binding_name)
                    Pattern.Pin(pin_name):
                        out.push(pin_name)
                    Pattern.TypeBind(bound_type, bound_binder):
                        out.push(bound_binder)
                    Pattern.Rest(rest_name):
                        out.push(rest_name) if rest_name != ""
                    Pattern.As(as_name, as_inner):
                        out.push(as_name)
                        for as_pattern in as_inner |out|:
                            borrow_binders_pattern(as_pattern, out)
                    Pattern.Variant(variant_path, variant_fields):
                        for variant_pattern in variant_fields |out|:
                            borrow_binders_pattern(variant_pattern, out)
                    Pattern.Struct(struct_path, struct_fields):
                        for struct_pattern in struct_fields |out|:
                            borrow_binders_pattern(struct_pattern, out)
                    Pattern.Field(field_selector, field_inner):
                        for field_pattern in field_inner |out|:
                            borrow_binders_pattern(field_pattern, out)
                    Pattern.Tuple(tuple_elements):
                        for tuple_pattern in tuple_elements |out|:
                            borrow_binders_pattern(tuple_pattern, out)
                    Pattern.Or(or_options):
                        for or_pattern in or_options |out|:
                            borrow_binders_pattern(or_pattern, out)
                    Pattern.Other(other_text):
                        out.push("*")
                    _:
                        pass

        # The right side of `x is P(...)` is a pattern spelled as an expression; every name in it
        # may be a binder.
        def borrow_binders_all_names(expression: Ast::Expr, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(named, named_pos):
                        out.push(named)
                    Expr.Call(named_callee, named_arguments, named_labels, named_call_pos):
                        borrow_binders_all_names(named_callee, out)
                        for named_argument in named_arguments |out|:
                            borrow_binders_all_names(named_argument, out)
                    Expr.Field(named_object, named_field, named_field_pos):
                        borrow_binders_all_names(named_object, out)
                    Expr.Paren(named_inner, named_paren_pos) | Expr.Unary(_, named_inner, named_paren_pos) | Expr.Move(named_inner, named_paren_pos):
                        borrow_binders_all_names(named_inner, out)
                    Expr.Tuple(named_elements, named_tuple_pos) | Expr.Array(named_elements, named_tuple_pos):
                        for named_element in named_elements |out|:
                            borrow_binders_all_names(named_element, out)
                    Expr.Binary(named_left, named_operator, named_right, named_binary_pos):
                        borrow_binders_all_names(named_left, out)
                        borrow_binders_all_names(named_right, out)
                    Expr.Construct(named_type, named_fields, named_construct_pos):
                        for named_init in named_fields |out|:
                            borrow_binders_all_names(named_init.value, out)
                    _:
                        pass

        # Record only variable-length payloads of a direct `Expr.Call` constructor pattern.
        # The argument arrays are stored in the AST node and live with Ast::File backing.
        def borrow_binders_ast_call_payload(expression: Ast::Expr, subject_name: sview, subject_pos: Ast::Pos, out: mutable BorrowBinders&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if subject_name == ""
                match expression:
                    Expr.Call(Expr.Scope(Expr.Ident(type_name, _), variant_name, _), fields, labels, _):
                        return if type_name != "Expr" or variant_name != "Call" or any label in labels where label != ""
                        return if fields.count != 4.usize()
                        match fields[1]:
                            Expr.Ident(arguments_name, _):
                                if arguments_name != "" and arguments_name != "_":
                                    out.ast_payload_slices.push(arguments_name)
                                    out.ast_payload_subject_names.push(subject_name)
                                    out.ast_payload_subject_positions.push(subject_pos)
                                    out.ast_payload_subject_type_names.push("Expr")
                            _:
                                pass
                        match fields[2]:
                            Expr.Ident(names_name, _):
                                if names_name != "" and names_name != "_":
                                    out.ast_payload_slices.push(names_name)
                                    out.ast_payload_subject_names.push(subject_name)
                                    out.ast_payload_subject_positions.push(subject_pos)
                                    out.ast_payload_subject_type_names.push("Expr")
                            _:
                                pass
                    _:
                        pass

        # `match declaration: Decl.Func(..., body, ...)` binds the function body from
        # the AST node's darray payload. Record only a direct binding in that exact field.
        def borrow_binders_ast_decl_func_body(pattern: Ast::Pattern, subject: Ast::Expr, out: mutable BorrowBinders&) -> void:
            can Memory.Allocate, Abort.Panic:
                subject_name: mutable sview = ""
                subject_pos: mutable Ast::Pos = Ast::pos_at_line(0)
                match subject:
                    Expr.Ident(name, position):
                        subject_name <- name
                        subject_pos <- position
                    _:
                        return
                return if subject_name == ""
                match pattern:
                    Pattern.Variant(path, fields):
                        return if path != "Decl.Func" or fields.count != 7.usize()
                        match fields[3]:
                            Pattern.Binding(body_name):
                                if body_name != "" and body_name != "_":
                                    out.ast_payload_slices.push(body_name)
                                    out.ast_payload_subject_names.push(subject_name)
                                    out.ast_payload_subject_positions.push(subject_pos)
                                    out.ast_payload_subject_type_names.push("Decl")
                            _:
                                pass
                    _:
                        pass

        def borrow_binders_expression(expression: Ast::Expr, out: mutable BorrowBinders&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(binary_left, binary_operator, binary_right, binary_pos):
                        borrow_binders_expression(binary_left, out)
                        if binary_operator == TokenKind.Is:
                            borrow_binders_all_names(binary_right, out.names)
                            match binary_left:
                                Expr.Ident(subject_name, subject_pos):
                                    borrow_binders_ast_call_payload(binary_right, subject_name, subject_pos, out)
                                _:
                                    pass
                        borrow_binders_expression(binary_right, out) if binary_operator != TokenKind.Is
                    Expr.Call(call_callee, call_arguments, call_labels, call_pos):
                        borrow_binders_expression(call_callee, out)
                        for call_argument in call_arguments |out|:
                            borrow_binders_expression(call_argument, out)
                    Expr.StaticEffectCall(effect_type, effect_operation, effect_candidates, effect_arguments, effect_labels, effect_pos):
                        for effect_argument in effect_arguments |out|:
                            borrow_binders_expression(effect_argument, out)
                    Expr.Field(field_object, field_name, field_pos):
                        borrow_binders_expression(field_object, out)
                    Expr.Index(index_object, index_value, index_pos):
                        borrow_binders_expression(index_object, out)
                        borrow_binders_expression(index_value, out)
                    Expr.Slice(slice_object, slice_low, slice_high, slice_pos):
                        borrow_binders_expression(slice_object, out)
                        borrow_binders_expression(slice_low, out)
                        borrow_binders_expression(slice_high, out)
                    Expr.IndexN(indexn_object, indexn_arguments, indexn_pos):
                        borrow_binders_expression(indexn_object, out)
                        for indexn_argument in indexn_arguments |out|:
                            borrow_binders_expression(indexn_argument, out)
                    Expr.Unary(_, unary_operand, unary_pos) | Expr.Move(unary_operand, unary_pos) | Expr.Paren(unary_operand, unary_pos) | Expr.RegionNew(unary_operand, _, unary_pos):
                        borrow_binders_expression(unary_operand, out)
                    Expr.Array(list_elements, list_pos) | Expr.Tuple(list_elements, list_pos) | Expr.SetLit(list_elements, list_pos):
                        for list_element in list_elements |out|:
                            borrow_binders_expression(list_element, out)
                    Expr.DictLit(dict_entries, dict_pos):
                        for dict_entry in dict_entries |out|:
                            borrow_binders_expression(dict_entry.key, out)
                            borrow_binders_expression(dict_entry.value, out)
                    Expr.Construct(construct_head, construct_fields, construct_pos) | Expr.RecordUpdate(construct_head, construct_fields, construct_pos):
                        borrow_binders_expression(construct_head, out)
                        for construct_init in construct_fields |out|:
                            borrow_binders_expression(construct_init.value, out)
                    Expr.If(if_condition, if_then, if_else, if_pos):
                        borrow_binders_expression(if_condition, out)
                        borrow_binders_expression(if_then, out)
                        borrow_binders_expression(if_else, out)
                    Expr.Match(match_scrutinee, match_arms, match_pos) | Expr.Catch(match_scrutinee, match_arms, match_pos):
                        borrow_binders_expression(match_scrutinee, out)
                        for match_arm in match_arms |out|:
                            borrow_binders_pattern(match_arm.pattern, out.names)
                            borrow_binders_ast_decl_func_body(match_arm.pattern, match_scrutinee, out)
                            borrow_binders_expression(match_arm.guard, out)
                            borrow_binders_statements(match_arm.body, out)
                    Expr.Comprehension(comprehension_variable, comprehension_iterable, comprehension_condition, comprehension_body, comprehension_pos):
                        out.names.push(comprehension_variable)
                        borrow_binders_expression(comprehension_iterable, out)
                        borrow_binders_expression(comprehension_condition, out)
                        borrow_binders_expression(comprehension_body, out)
                    Expr.Refinement(refinement_base, refinement_predicate, refinement_pos):
                        borrow_binders_expression(refinement_base, out)
                        borrow_binders_expression(refinement_predicate, out)
                    Expr.GetElse(getelse_guarded, getelse_recovery, getelse_pos):
                        borrow_binders_expression(getelse_guarded, out)
                        borrow_binders_statements(getelse_recovery, out)
                    Expr.Lambda(lambda_parameters, lambda_body, lambda_pos):
                        for lambda_parameter in lambda_parameters |out|:
                            out.names.push(lambda_parameter)
                        borrow_binders_statements(lambda_body, out)
                    Expr.Block(block_statements, block_value, block_captures, block_pos):
                        borrow_binders_statements(block_statements, out)
                        borrow_binders_expression(block_value, out)
                    _:
                        pass

        def borrow_binders_statements(statements: darray[Ast::Stmt], out: mutable BorrowBinders&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Expr(statement_expression, statement_pos):
                            borrow_binders_expression(statement_expression, out)
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            out.names.push(declared_name)
                            borrow_binders_expression(declared_value, out)
                        Stmt.Assign(assigned_target, assigned_operator, assigned_value, assigned_pos):
                            # Only plain `=` introduces a fresh name. `<-` and compound
                            # assignments require an existing target in resolve_flow.
                            assigned_name: sview = ident_name_of(assigned_target)
                            out.names.push(assigned_name) if assigned_operator == TokenKind.Assign and assigned_name != ""
                            borrow_binders_expression(assigned_target, out)
                            borrow_binders_expression(assigned_value, out)
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            borrow_binders_expression(branch_condition, out)
                            borrow_binders_statements(branch_then, out)
                            borrow_binders_statements(branch_else, out)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            borrow_binders_expression(loop_condition, out)
                            borrow_binders_statements(loop_body, out)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            out.names.push(for_bind) if for_bind != ""
                            for for_variable in for_variables |out|:
                                out.names.push(for_variable)
                            borrow_binders_expression(for_iterable, out)
                            borrow_binders_statements(for_body, out)
                        Stmt.Return(returned_option, returned_pos):
                            if returned_option is returned_expression:
                                borrow_binders_expression(returned_expression, out)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_statement_pos):
                            out.names.push(block_binding) if block_binding != ""
                            borrow_binders_statements(block_body, out)
                        Stmt.Match(arms_scrutinee, statement_arms, arms_pos):
                            borrow_binders_expression(arms_scrutinee, out)
                            for statement_arm in statement_arms |out|:
                                borrow_binders_pattern(statement_arm.pattern, out.names)
                                borrow_binders_ast_decl_func_body(statement_arm.pattern, arms_scrutinee, out)
                                borrow_binders_expression(statement_arm.guard, out)
                                borrow_binders_statements(statement_arm.body, out)
                        Stmt.Contract(contract_kind, contract_expression, contract_pos):
                            borrow_binders_expression(contract_expression, out)
                        _:
                            pass

        # Whether `name` is bound exactly once in the function whose binders are `binders`.
        def borrow_bound_once(binders: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                false return if name == "" or name == "_"
                seen: mutable u32 = 0
                for binder in binders |seen|:
                    seen <- seen + 1 if binder == name
                return seen == 1

        # A function's binders with an open-addressed index over `names`: `slots` has a
        # power-of-two capacity of at least twice the binder count and holds, per slot,
        # BINDER_SLOT_EMPTY or the row of the FIRST binder with that spelling; `repeats[row]`
        # counts how many binders share row's spelling. binders_bound_once probes from the
        # name's hash and compares the real spelling at every occupied slot, so it is the same
        # predicate as borrow_bound_once over `names` -- without scanning every binder for
        # every statement of the function. A plain darray is used rather than a dict because
        # the index is rebuilt per function and dict growth is a runtime-wide cost
        # (arena.elisa's collection stacks).
        const BINDER_SLOT_EMPTY: u32 = 4294967295

        def empty_borrow_binders() -> BorrowBinders:
            can Memory.Allocate, Abort.Panic:
                return BorrowBinders{names: []}

        # The slot holding `name`'s first row, or the empty slot its probe ends at.
        def borrow_binder_slot(binders: BorrowBinders&, name: sview) -> usize:
            can Abort.Panic:
                mask: usize = binders.slots.count - 1
                slot: mutable usize = name_hash(name).usize() & mask
                while binders.slots[slot] != BINDER_SLOT_EMPTY |slot, binders, name, mask|:
                    return slot if binders.names[binders.slots[slot].usize()] == name
                    slot <- (slot + 1) & mask
                return slot

        # Rebuild the index over `binders.names` (call once after the names are complete).
        def index_borrow_binders(binders: mutable BorrowBinders&) -> void:
            can Memory.Allocate, Abort.Panic:
                capacity: mutable usize = 16
                while capacity < binders.names.count * 2 |capacity|:
                    capacity <- capacity * 2
                binders.slots.truncate(0)
                binders.slots.reserve(capacity)
                for slot_index in 0..<capacity |binders|:
                    binders.slots.push(BINDER_SLOT_EMPTY)
                binders.repeats.truncate(0)
                binders.repeats.reserve(binders.names.count)
                for repeat_index in 0..<binders.names.count |binders|:
                    binders.repeats.push(0)
                for row in 0..<binders.names.count |binders|:
                    slot: usize = borrow_binder_slot(binders, binders.names[row])
                    if binders.slots[slot] == BINDER_SLOT_EMPTY:
                        binders.slots[slot] <- row.u32()
                        binders.repeats[row] <- 1
                    else:
                        first: usize = binders.slots[slot].usize()
                        binders.repeats[first] <- binders.repeats[first] + 1

        # borrow_bound_once(binders.names, name), answered from the index.
        def binders_bound_once(binders: BorrowBinders&, name: sview) -> bool:
            can Abort.Panic:
                false return if name == "" or name == "_"
                return borrow_bound_once(binders.names, name) if binders.slots.count == 0
                slot: usize = borrow_binder_slot(binders, name)
                false return if binders.slots[slot] == BINDER_SLOT_EMPTY
                return binders.repeats[binders.slots[slot].usize()] == 1

        # Resolved local/parameter references indexed by (function declaration, source
        # offset). This distinguishes a shadowed call at its actual lexical site from a
        # same-spelled binder in another branch or later statement.
        struct BorrowLocalCallableGlobalStore:
            source_name: sview
            target_name: sview
            source_is_address: bool
            # When the source is a resolved local/parameter root, preserve lexical
            # identity through the call-site diagnostic instead of re-resolving its
            # spelling in the caller's scope.
            source_binding_id: BindingId
            source_binding_known: bool
            source_binding_kind: u8

        # A closure-local reference alias resolved back to the exact borrowed root.
        # BindingId, rather than spelling, keeps an alias from one lexical block from
        # being reused for a same-named binder in a sibling block.
        struct BorrowLocalCallableAliasRoot:
            alias_binding_id: BindingId
            root_binding_id: BindingId
            root_binding_kind: u8
            root_name: sview
            # False only for the conservative marker used when an alias-producing flow
            # cannot be resolved to one exact local or parameter.
            root_binding_known: bool

        const BORROW_LOCAL_ALIAS_UNKNOWN_ROOT_KIND: u8 = 3

        # Flow-insensitive assignment from one closure-local alias to another.
        struct BorrowLocalCallableAliasEdge:
            alias_binding_id: BindingId
            source_binding_id: BindingId

        # Temporary closure-local graph indexes. Hash chains retain the full IDs in
        # their rows, so a collision can slow a lookup but can never merge bindings.
        struct BorrowLocalCallableAliasGraph:
            roots: mutable darray[BorrowLocalCallableAliasRoot]
            root_next: mutable darray[u32]
            root_heads: mutable dict[u64, u32]
            edges: mutable darray[BorrowLocalCallableAliasEdge]
            # Source adjacency supports worklist traversal; pair chains deduplicate
            # repeated assignment edges without rescanning a source's whole adjacency.
            edge_next: mutable darray[u32]
            edge_heads: mutable dict[u64, u32]
            edge_pair_next: mutable darray[u32]
            edge_pair_heads: mutable dict[u64, u32]

        struct BorrowLocalCallable:
            # Exact lexical identity avoids confusing same-spelled binders in disjoint scopes.
            binding_id: BindingId
            # Branch/loop joins retain whether any reachable path can hold a closure.
            may_be_callable: bool
            # Possible outer bindings read by closures assigned to this local.
            capture_names: darray[sview]
            # File globals directly written by closures assigned to this local.
            global_targets: darray[sview]
            # Captured identifiers used as possible values written to each global.
            # Keeping the pair prevents unrelated captures from becoming false sources.
            global_stores: darray[BorrowLocalCallableGlobalStore]

        struct BorrowReferenceSites:
            # 1 = parameter, 2 = local. Retaining the binding class lets conservative
            # indirect-call handling distinguish an opaque callback parameter from a
            # closure value created in this function.
            # The value is the row in the parallel reference columns, keeping both the
            # binding kind and BindingId available without duplicating them in the index.
            # u32 matches the symbol indexes and uses half the payload of usize on 64-bit.
            # SYMBOL_INDEX_ROW_NONE marks duplicate or otherwise ambiguous start offsets.
            keys: mutable dict[u64, u32]
            local_callables: mutable darray[BorrowLocalCallable]
            initialized: bool = false
            # BindingDeclaredType rows are queried by exact BindingId while building
            # closure alias facts. Cache their chains once per reference-site index so
            # repeated aliases and loop binders do not rescan the whole type table.
            binding_type_heads: mutable dict[u64, u32] = {}
            binding_type_next: mutable darray[u32] = []
            binding_type_indexed_count: mutable usize = 0
            # Structural reference-freedom proofs are stable for interned TypeIds and
            # are reused across alias sources, call returns, and loop binders.
            type_reference_free: mutable dict[u32, bool] = {}
            # Unique nominal declaration kinds let the structural proof inspect only
            # unambiguous, non-generic structs/enums. Hash buckets retain exact names so
            # collisions stay conservative without rescanning the symbol table.
            named_type_kind_heads: mutable dict[u64, u32] = {}
            named_type_kind_names: mutable darray[sview] = []
            named_type_kind_values: mutable darray[u32] = []
            named_type_kind_next: mutable darray[u32] = []
            enum_payload_owner_heads: mutable dict[u64, u32] = {}
            enum_payload_owner_next: mutable darray[u32] = []
            enum_payload_owner_indexed_count: mutable usize = 0

        def borrow_reference_site_key(owner: DeclId, position: Ast::Pos) -> u64:
            can Abort.Panic:
                return owner.value.u64() * 4294967296 + position.offset.u64()

        def empty_borrow_reference_sites() -> BorrowReferenceSites:
            can Memory.Allocate, Abort.Panic:
                return BorrowReferenceSites{keys: {}, local_callables: []}

        def borrow_set_local_callable(sites: mutable BorrowReferenceSites&, binding_id: BindingId, may_be_callable: bool, capture_names: darray[sview], global_targets: darray[sview], global_stores: darray[BorrowLocalCallableGlobalStore]) -> void:
            can Memory.Allocate, Abort.Panic:
                slot: usize = borrow_local_callable_slot(sites.local_callables, binding_id)
                state: BorrowLocalCallable = BorrowLocalCallable{binding_id: binding_id, may_be_callable: may_be_callable, capture_names: capture_names, global_targets: global_targets, global_stores: global_stores}
                if slot < sites.local_callables.count:
                    sites.local_callables[slot] <- state
                    return
                # Resolver binding serials follow source traversal. Keep the common append
                # path allocation-free beyond darray growth; preserve the sorted invariant if
                # a future traversal records a binding out of order.
                if sites.local_callables.count == 0 or borrow_binding_id_precedes(sites.local_callables[sites.local_callables.count - 1].binding_id, binding_id):
                    sites.local_callables.push(state)
                    return
                ordered: mutable darray[BorrowLocalCallable] = []
                inserted: mutable bool = false
                for prior in sites.local_callables |ordered, inserted|:
                    if not inserted and borrow_binding_id_precedes(binding_id, prior.binding_id):
                        ordered.push(state)
                        inserted <- true
                    ordered.push(prior)
                ordered.push(state) if not inserted
                sites.local_callables <- ordered

        def borrow_binding_id_precedes(left: BindingId, right: BindingId) -> bool:
            can Abort.Panic:
                return left.owner.value < right.owner.value or (left.owner.value == right.owner.value and left.serial < right.serial)

        # Callable rows are kept sorted by BindingId so lookup and state joins do not
        # repeatedly scan the complete closure-state vector.
        def borrow_local_callable_slot(states: darray[BorrowLocalCallable]&, binding_id: BindingId) -> usize:
            can Abort.Panic:
                low: mutable usize = 0
                high: mutable usize = states.count
                while low < high |low, high, states, binding_id|:
                    middle: usize = low + (high - low) / 2
                    candidate: BindingId = states[middle].binding_id
                    if ownership_binding_ids_equal(candidate, binding_id):
                        return middle
                    if borrow_binding_id_precedes(candidate, binding_id):
                        low <- middle + 1
                    else:
                        high <- middle
                return states.count

        def borrow_local_callable_state(states: darray[BorrowLocalCallable]&, binding_id: BindingId) -> bool:
            can Abort.Panic:
                slot: usize = borrow_local_callable_slot(states, binding_id)
                return slot < states.count and states[slot].may_be_callable

        def borrow_local_callable_captures(states: darray[BorrowLocalCallable]&, binding_id: BindingId) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                slot: usize = borrow_local_callable_slot(states, binding_id)
                return states[slot].capture_names if slot < states.count
                return []

        def borrow_local_callable_global_targets(states: darray[BorrowLocalCallable]&, binding_id: BindingId) -> darray[sview]:
            can Memory.Allocate, Abort.Panic:
                slot: usize = borrow_local_callable_slot(states, binding_id)
                return states[slot].global_targets if slot < states.count
                return []

        def borrow_local_callable_global_stores(states: darray[BorrowLocalCallable]&, binding_id: BindingId) -> darray[BorrowLocalCallableGlobalStore]:
            can Memory.Allocate, Abort.Panic:
                slot: usize = borrow_local_callable_slot(states, binding_id)
                return states[slot].global_stores if slot < states.count
                return []

        def borrow_snapshot_local_callables(sites: BorrowReferenceSites&) -> darray[BorrowLocalCallable]:
            can Memory.Allocate, Abort.Panic:
                snapshot: mutable darray[BorrowLocalCallable] = []
                snapshot.extend(sites.local_callables)
                return snapshot

        def borrow_restore_local_callables(sites: mutable BorrowReferenceSites&, snapshot: darray[BorrowLocalCallable]&) -> void:
            can Memory.Allocate, Abort.Panic:
                sites.local_callables.truncate(0)
                sites.local_callables.extend(snapshot)

        def borrow_join_local_callable_states(left: darray[BorrowLocalCallable]&, right: darray[BorrowLocalCallable]&) -> darray[BorrowLocalCallable]:
            can Memory.Allocate, Abort.Panic:
                joined: mutable darray[BorrowLocalCallable] = []
                left_row: mutable usize = 0
                right_row: mutable usize = 0
                while left_row < left.count or right_row < right.count |joined, left_row, right_row, left, right|:
                    if left_row >= left.count:
                        joined.push(right[right_row])
                        right_row <- right_row + 1
                    elif right_row >= right.count:
                        joined.push(left[left_row])
                        left_row <- left_row + 1
                    elif ownership_binding_ids_equal(left[left_row].binding_id, right[right_row].binding_id):
                        callable: BorrowLocalCallable = left[left_row]
                        other: BorrowLocalCallable = right[right_row]
                        captures: mutable darray[sview] = []
                        for capture in callable.capture_names |captures|:
                            captures.push(capture) if not (any prior in captures where prior == capture)
                        for capture in other.capture_names |captures|:
                            captures.push(capture) if not (any prior in captures where prior == capture)
                        targets: mutable darray[sview] = []
                        for target in callable.global_targets |targets|:
                            targets.push(target) if not (any prior in targets where prior == target)
                        for target in other.global_targets |targets|:
                            targets.push(target) if not (any prior in targets where prior == target)
                        stores: mutable darray[BorrowLocalCallableGlobalStore] = []
                        for store in callable.global_stores |stores|:
                            stores.push(store) if not (any prior in stores where prior.source_name == store.source_name and prior.target_name == store.target_name and prior.source_is_address == store.source_is_address and prior.source_binding_known == store.source_binding_known and prior.source_binding_kind == store.source_binding_kind and (not prior.source_binding_known or ownership_binding_ids_equal(prior.source_binding_id, store.source_binding_id)))
                        for store in other.global_stores |stores|:
                            stores.push(store) if not (any prior in stores where prior.source_name == store.source_name and prior.target_name == store.target_name and prior.source_is_address == store.source_is_address and prior.source_binding_known == store.source_binding_known and prior.source_binding_kind == store.source_binding_kind and (not prior.source_binding_known or ownership_binding_ids_equal(prior.source_binding_id, store.source_binding_id)))
                        joined.push(BorrowLocalCallable{binding_id: callable.binding_id, may_be_callable: callable.may_be_callable or other.may_be_callable, capture_names: captures, global_targets: targets, global_stores: stores})
                        left_row <- left_row + 1
                        right_row <- right_row + 1
                    elif borrow_binding_id_precedes(left[left_row].binding_id, right[right_row].binding_id):
                        joined.push(left[left_row])
                        left_row <- left_row + 1
                    else:
                        joined.push(right[right_row])
                        right_row <- right_row + 1
                return joined

        def borrow_local_callable_states_equal(left: darray[BorrowLocalCallable]&, right: darray[BorrowLocalCallable]&) -> bool:
            can Abort.Panic:
                return false if left.count != right.count
                for row in 0..<left.count |right|:
                    callable: BorrowLocalCallable = left[row]
                    other: BorrowLocalCallable = right[row]
                    return false if not ownership_binding_ids_equal(callable.binding_id, other.binding_id) or callable.may_be_callable != other.may_be_callable or callable.capture_names.count != other.capture_names.count or callable.global_targets.count != other.global_targets.count or callable.global_stores.count != other.global_stores.count
                    for capture in callable.capture_names:
                        return false if not (any other_capture in other.capture_names where other_capture == capture)
                    for target in callable.global_targets:
                        return false if not (any other_target in other.global_targets where other_target == target)
                    for store in callable.global_stores:
                        return false if not (any other_store in other.global_stores where other_store.source_name == store.source_name and other_store.target_name == store.target_name and other_store.source_is_address == store.source_is_address and other_store.source_binding_known == store.source_binding_known and other_store.source_binding_kind == store.source_binding_kind and (not other_store.source_binding_known or ownership_binding_ids_equal(other_store.source_binding_id, store.source_binding_id)))
                return true

        def borrow_merge_local_callable_states(sites: mutable BorrowReferenceSites&, left: darray[BorrowLocalCallable]&, right: darray[BorrowLocalCallable]&) -> void:
            can Memory.Allocate, Abort.Panic:
                sites.local_callables <- borrow_join_local_callable_states(left, right)

        def borrow_reference_site_row(sites: mutable BorrowReferenceSites&, owner: DeclId, position: Ast::Pos, table: SymbolTable&) -> (known: bool, row: usize):
            can Memory.Allocate, Abort.Panic:
                return (false, 0) if position.end_offset <= position.offset
                if not sites.initialized:
                    if table.ref_pos.count == table.ref_binding_ids.count and table.ref_kind.count == table.ref_binding_ids.count:
                        for row in 0..<table.ref_binding_ids.count |sites, table|:
                            if table.ref_pos[row].end_offset > table.ref_pos[row].offset:
                                key: u64 = borrow_reference_site_key(table.ref_binding_ids[row].owner, table.ref_pos[row])
                                if sites.keys.get(key) is previous:
                                    previous_row: usize = previous.usize()
                                    if previous == SYMBOL_INDEX_ROW_NONE or previous_row >= table.ref_pos.count or previous_row >= table.ref_kind.count or previous_row >= table.ref_binding_ids.count:
                                        sites.keys <- sites.keys.put(key, SYMBOL_INDEX_ROW_NONE) can Global{Read,Write}
                                    else:
                                        previous_pos: Ast::Pos = table.ref_pos[previous_row]
                                        same_site: bool = previous_pos.offset == table.ref_pos[row].offset and previous_pos.end_offset == table.ref_pos[row].end_offset
                                        same_binding: bool = ownership_binding_ids_equal(table.ref_binding_ids[previous_row], table.ref_binding_ids[row])
                                        same_kind: bool = table.ref_kind[previous_row] == table.ref_kind[row]
                                        if not same_site or not same_binding or not same_kind:
                                            sites.keys <- sites.keys.put(key, SYMBOL_INDEX_ROW_NONE) can Global{Read,Write}
                                else:
                                    row_value: u32 = row.u32() if row < SYMBOL_INDEX_ROW_NONE.usize() else SYMBOL_INDEX_ROW_NONE
                                    sites.keys <- sites.keys.put(key, row_value) can Global{Read,Write}
                    sites.initialized <- true
                if sites.keys.get(borrow_reference_site_key(owner, position)) is indexed_row and indexed_row != SYMBOL_INDEX_ROW_NONE:
                    row: usize = indexed_row.usize()
                    if row < table.ref_pos.count and row < table.ref_binding_ids.count and row < table.ref_kind.count:
                        recorded: Ast::Pos = table.ref_pos[row]
                        if table.ref_binding_ids[row].owner.value == owner.value and recorded.offset == position.offset and recorded.end_offset == position.end_offset:
                            return (true, row)
                return (false, 0)

        # Return both properties together so indirect-call handling performs one cache
        # probe on its common path. Ambiguous cache entries fall back to an exact scan.
        def borrow_reference_site_lookup(sites: mutable BorrowReferenceSites&, owner: DeclId, position: Ast::Pos, table: SymbolTable&) -> (kind: u8, binding_known: bool, binding_id: BindingId):
            can Memory.Allocate, Abort.Panic:
                missing: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                return (0, false, missing) if:
                    position.end_offset <= position.offset
                    owner.value == INVALID_DECL_ID_VALUE or owner.value.usize() >= table.symbols.count
                    table.ref_pos.count != table.ref_binding_ids.count or table.ref_kind.count != table.ref_binding_ids.count
                row_known: mutable bool = false
                row: mutable usize = 0.usize()
                can Global{Read,Write}:
                    row_known, row = borrow_reference_site_row(sites, owner, position, table)
                if row_known:
                    kind: u8 = table.ref_kind[row]
                    return (kind, kind != 0, table.ref_binding_ids[row])
                found: mutable bool = false
                binding_ambiguous: mutable bool = false
                kind_ambiguous: mutable bool = false
                result_kind: mutable u8 = 0
                result_binding: mutable BindingId = missing
                for candidate in 0..<table.ref_binding_ids.count |candidate, found, binding_ambiguous, kind_ambiguous, result_kind, result_binding, table, owner, position|:
                    id: BindingId = table.ref_binding_ids[candidate]
                    recorded: Ast::Pos = table.ref_pos[candidate]
                    continue if id.owner.value != owner.value or recorded.offset != position.offset or recorded.end_offset != position.end_offset
                    if not found:
                        found <- true
                        result_kind <- table.ref_kind[candidate]
                        result_binding <- id
                    else:
                        binding_ambiguous <- true if not ownership_binding_ids_equal(result_binding, id)
                        kind_ambiguous <- true if result_kind != table.ref_kind[candidate]
                return (0, false, missing) if not found
                return (3, false, missing) if kind_ambiguous
                return (result_kind, not binding_ambiguous and result_kind != 0, result_binding if not binding_ambiguous else missing)

        def borrow_reference_site_kind(sites: mutable BorrowReferenceSites&, owner: DeclId, position: Ast::Pos, table: SymbolTable&) -> u8:
            can Memory.Allocate, Abort.Panic:
                missing: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                kind: mutable u8 = 0
                binding_known: mutable bool = false
                binding_id: mutable BindingId = missing
                can Global{Read,Write}:
                    kind, binding_known, binding_id = borrow_reference_site_lookup(sites, owner, position, table)
                return kind

        def borrow_reference_site_binding(sites: mutable BorrowReferenceSites&, owner: DeclId, position: Ast::Pos, table: SymbolTable&) -> (known: bool, binding_id: BindingId):
            can Memory.Allocate, Abort.Panic:
                missing: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                kind: mutable u8 = 0
                known: mutable bool = false
                binding_id: mutable BindingId = missing
                can Global{Read,Write}:
                    kind, known, binding_id = borrow_reference_site_lookup(sites, owner, position, table)
                return (known, binding_id)

        def borrow_reference_site_is_local_callable(sites: mutable BorrowReferenceSites&, owner: DeclId, position: Ast::Pos, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                known: mutable bool = false
                binding_id: mutable BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                can Global{Read,Write}:
                    known, binding_id = borrow_reference_site_binding(sites, owner, position, table)
                return known and borrow_local_callable_state(sites.local_callables, binding_id)

        def borrow_reference_site_is_local(sites: mutable BorrowReferenceSites&, owner: DeclId, position: Ast::Pos, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                kind: mutable u8 = 0
                can Global{Read,Write}:
                    kind <- borrow_reference_site_kind(sites, owner, position, table)
                return kind != 0

        # Every binder of a function, parameters first; `*` present when a pattern was unreadable.
        def borrow_function_binders(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], out: mutable BorrowBinders&) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |out|:
                    out.names.push(parameter.name)
                borrow_binders_statements(body, out)
                index_borrow_binders(out)

        # Store-through summaries only need to know whether an unreadable binder forces
        # conservative call handling. Avoid building the hash index used by other passes.
        def borrow_function_has_unreadable_binder(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                binders: mutable BorrowBinders = BorrowBinders{names: []}
                for parameter in parameters |binders|:
                    binders.names.push(parameter.name)
                borrow_binders_statements(body, binders)
                return any binder in binders.names where binder == "*"
