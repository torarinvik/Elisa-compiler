# Exact inclusive range check used when a signed integer literal initializes a
# fixed-width integer type.
module SemanticIntegerLiteral:
    public:
        def value_fits_signed_window(value: i64, low: i64, high: i64) -> bool:
            ensure result == (value >= low and value <= high)
            return value >= low and value <= high

        def value_is_outside_window_if_known(window_found: bool, value_found: bool, value: i64, low: i64, high: i64) -> bool:
            ensure result == (window_found and value_found and not value_fits_signed_window(value, low, high))
            return window_found and value_found and not value_fits_signed_window(value, low, high)
