# Local where-refinement init violation. A local `x: T where PRED = V` (inline) or `x: Alias = V`
# where `refine Alias = base where PRED` carries PRED over x; a constant init V that provably
# breaks PRED is rejected ("local where refinement is violated"). Decidable subset (reuses the
# check_where_reassign evaluator): PRED is a constant comparison / and-or on the bound variable
# (the local name for inline, `self` for a refine alias) and V is an integer literal. Non-const
# inits and richer predicates are a sound miss.
extend Semantic:
    private:
        # Collect `refine Alias = <type> where PRED` aliases as (name, predicate). The alias
        # target is a Refinement whose predicate references `self`.
        def collect_refine_aliases(declarations: darray[Ast::Decl], names: mutable darray[sview]&, predicates: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, predicates|:
                    match declaration:
                        Decl.Alias(alias_name, target, alias_line):
                            predicate: Ast::Expr = where_predicate_of_type(target)
                            has_predicate: bool = match predicate:
                                Expr.Absent: false
                                _: true
                            if has_predicate:
                                names.push(alias_name)
                                predicates.push(predicate)
                        Decl.Module(module_name, module_body, module_line):
                            collect_refine_aliases(module_body, names, predicates)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_refine_aliases(scoped_body, names, predicates)
                        _:
                            pass

        # The alias predicate for a bare type name, or Absent when the type is not a refine alias.
        def alias_predicate_of_type(type_expression: Ast::Expr, alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                type_name: sview = ident_name_of(type_expression)
                (Ast::Expr.Absent) return if type_name == ""
                probe: mutable usize = 0
                result: mutable Ast::Expr = (Ast::Expr.Absent)
                while probe < alias_names.count |probe, result|:
                    result <- alias_predicates[probe] if alias_names[probe] == type_name
                    probe <- probe + 1
                return result

        def local_where_violated_statements(statements: darray[Ast::Stmt], alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            value_literal: (found: bool, value: i64) = where_signed_literal(value)
                            if value_literal.found:
                                # Inline `x: T where PRED` — the predicate binds the local name.
                                inline_predicate: Ast::Expr = where_predicate_of_type(type_expression)
                                inline_violated: bool = match inline_predicate:
                                    Expr.Absent: false
                                    _: predicate_violated_by(inline_predicate, name, value_literal.value)
                                # `x: Alias` where Alias is a refine alias — the predicate binds `self`.
                                alias_predicate: Ast::Expr = alias_predicate_of_type(type_expression, alias_names, alias_predicates)
                                self_variable: sview = "self"
                                alias_violated: bool = match alias_predicate:
                                    Expr.Absent: false
                                    _: predicate_violated_by(alias_predicate, self_variable, value_literal.value)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalWhereRefinementViolated, name: name, line: line, expected: "", actual: ""}) if inline_violated or alias_violated
                        Stmt.If(condition, then_body, else_body, line):
                            table <- local_where_violated_statements(then_body, alias_names, alias_predicates, table)
                            table <- local_where_violated_statements(else_body, alias_names, alias_predicates, table)
                        Stmt.While(condition, while_body, line):
                            table <- local_where_violated_statements(while_body, alias_names, alias_predicates, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- local_where_violated_statements(for_body, alias_names, alias_predicates, table)
                        Stmt.Block(kind, clause, binding, block_body, block_line):
                            table <- local_where_violated_statements(block_body, alias_names, alias_predicates, table)
                        _:
                            pass

        def local_where_violated_walk(declarations: darray[Ast::Decl], alias_names: darray[sview]&, alias_predicates: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- local_where_violated_statements(body, alias_names, alias_predicates, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- local_where_violated_walk(module_body, alias_names, alias_predicates, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- local_where_violated_walk(scoped_body, alias_names, alias_predicates, table)
                        _:
                            pass

        def check_local_where_violated(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_predicates: mutable darray[Ast::Expr] = []
                collect_refine_aliases(declarations, alias_names, alias_predicates)
                table <- local_where_violated_walk(declarations, alias_names, alias_predicates, table)
