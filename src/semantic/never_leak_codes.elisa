# Shared never-leak categories and reason codes. Keeping stable codes separate from the analyzer
# lets the driver and source-linked proofs use the same names without numeric copies.
extend Semantic:
    public:
        const NEVER_LEAK_CHAIN: u8 = 1
        const NEVER_LEAK_PLAIN: u8 = 2
        const NEVER_LEAK_BORROW_EXEMPT: u8 = 3
        const NEVER_LEAK_OVERLAP: u8 = 4
        const NEVER_LEAK_LOOP: u8 = 5
        const NEVER_LEAK_ACCUMULATOR: u8 = 6
        const NEVER_LEAK_VALUE_THREAD: u8 = 7
        const NEVER_LEAK_PUSH_LOOP: u8 = 8
        const NEVER_LEAK_CATEGORY_UNKNOWN: u8 = 0

        # `acc_reason` codes: the loop-value rewrite applies at ACC_OK; SHAPE is decided by the
        # source-aware driver when the declaration or loop header spans several lines.
        const NEVER_LEAK_REASON_NONE: u8 = 0
        const NEVER_LEAK_ACC_OK: u8 = 0
        const NEVER_LEAK_ACC_READ_INSIDE: u8 = 1
        const NEVER_LEAK_ACC_WRITTEN_AFTER: u8 = 2
        const NEVER_LEAK_ACC_NOT_SCALAR: u8 = 3
        const NEVER_LEAK_ACC_ESCAPES: u8 = 4
        const NEVER_LEAK_ACC_SHAPE: u8 = 5

        # `acc_reason` is also reused for value-thread findings; SHAPE is again source-derived.
        const NEVER_LEAK_VT_OK: u8 = 0
        const NEVER_LEAK_VT_BORROW: u8 = 1
        const NEVER_LEAK_VT_BORROWED_FIELD: u8 = 2
        const NEVER_LEAK_VT_GLOBAL: u8 = 3
        const NEVER_LEAK_VT_ARENA: u8 = 4
        const NEVER_LEAK_VT_EFFECT_ONLY: u8 = 5
        const NEVER_LEAK_VT_SHAPE: u8 = 6
