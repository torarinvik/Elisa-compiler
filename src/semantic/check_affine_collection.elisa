# Affine-family diagnostic (registry-level, no dataflow). An affinity-disciplined struct
# (`linear`/`affine` — a single-use "linear handle") may not be a `dict` key or a `set`
# element: hashing/equality would duplicate the handle. stage0 rejects both; stage1 was silent.
# Purely a type-shape + registry lookup — sound without any move/use dataflow (which stage1
# lacks). Checked at declaration type-annotation positions: local VarDecls, function
# parameters, and struct fields.
extend Semantic:
    private:
        def addressed_affine_type(value: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match value:
                    Expr.Unary(address_operator, Expr.Ident(source_name, source_line), address_line):
                        return local_type_of(names, types, source_name) if address_operator == TokenKind.Ampersand else ""
                    Expr.Unary(address_operator, Expr.Field(Expr.Ident(owner_name, owner_line), field_name, field_line), address_line):
                        owner_type: sview = local_type_of(names, types, owner_name)
                        return interned_name(field_type_id_of(table, owner_type, field_name), table) if address_operator == TokenKind.Ampersand and owner_type != "" else ""
                    _:
                        return ""

        # stage0's isBorrowableAffineOwnerType: a struct DECLARED `linear`/`affine` (an `extern
        # resource` is one) may be borrowed (`T&`, `&value`), and the borrowed-owner flow analysis
        # keeps that sound; so may the builtin protocol owners ThreadPool and TaskGroup. `Pooled[T]`
        # stays unborrowable (docs/69): its interior-alias check only follows `ptr` read directly
        # off the owner, so a pointer read through a borrow would dangle.
        def struct_is_borrowable_owner(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return when name:
                    "" | "Pooled" -> false
                    "ThreadPool" | "TaskGroup" -> true
                    _ -> struct_is_declared_affine(table, name)

        # An affine struct stage0 refuses to borrow: `Pooled`, or a plain aggregate that is
        # affine only because a field is.
        def struct_is_unborrowable_affine(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return struct_is_affine(table, name) and not struct_is_borrowable_owner(table, name)

        # stage0 names a moved aggregate by what it holds: "value containing linear handles" for
        # a plain struct with an affine field, "linear value" for a declared owner.
        def affine_move_subject(table: SymbolTable&, type_name: sview) -> sview:
            can Abort.Panic:
                subject: sview = "container" if type_name != "Pooled" and struct_is_unborrowable_affine(table, type_name) else ""
                return subject

        # The pointee of a reference annotation, seen through `mutable` and an optional `?`
        # (`T&`, `mutable T&`, `T&?`), else null. A real Absent pointee stays present.
        def affine_ref_pointee(type_expression: Ast::Expr) -> Ast::Expr?:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return operand if operator == TokenKind.Ampersand
                        return affine_ref_pointee(operand) if operator == TokenKind.Mutable or operator == TokenKind.Question
                        return null
                    Expr.Paren(inner, paren_line):
                        return affine_ref_pointee(inner)
                    _:
                        return null

        def affine_annotation_is_ref(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                if affine_ref_pointee(type_expression) is pointee:
                    return not (pointee is Expr.Absent)
                return false

        # `M::T` -> "T" when module M itself declares an affine (or affine-containing) `T`,
        # else "". The affinity rows key on the bare member, so answering "T" for a plain
        # `M::T` would borrow another module's affine `T` (elisa-engine: a plain
        # `WorldHierarchy::Snapshot` beside an affine `RenderSnapshot::Snapshot`).
        def affine_qualified_member(qualifier: Ast::Expr, member: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                module: sview = match qualifier:
                    Expr.Ident(qualifier_name, qualifier_line): qualifier_name
                    Expr.Scope(outer, inner, outer_line): inner
                    _: sview("", 0, 0)
                while row < table.struct_affine_owner.count |row: usize = 0, member, module, table|:
                    row_module: sview = table.struct_affine_module[row] if row < table.struct_affine_module.count else ""
                    return member if table.struct_affine_owner[row] == member and row_module == module
                    row <- row + 1
                return sview("", 0, 0)

        # A type name spelled bare (`Token`) or module-qualified (`M::Token`, see
        # affine_qualified_member) -> "Token", else "".
        def affine_type_ident(expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                return match expression:
                    Expr.Ident(name, ident_line): name
                    Expr.Scope(qualifier, member, scope_line): affine_qualified_member(qualifier, member, table)
                    _: sview("", 0, 0)

        # bare_type_name_through_ref, also seeing through a module qualifier.
        def affine_owner_through_ref(expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Scope(qualifier, member, scope_line): return affine_qualified_member(qualifier, member, table)
                    Expr.Unary(operator, operand, unary_line):
                        return affine_owner_through_ref(operand, table) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    Expr.Index(object, argument, index_line):
                        object_member: sview = match object:
                            Expr.Scope(index_qualifier, index_member, index_scope_line): affine_qualified_member(index_qualifier, index_member, table)
                            _: sview("", 0, 0)
                        return object_member if object_member != ""
                    Expr.IndexN(object_n, arguments, index_n_line):
                        object_n_member: sview = match object_n:
                            Expr.Scope(index_n_qualifier, index_n_member, index_n_scope_line): affine_qualified_member(index_n_qualifier, index_n_member, table)
                            _: sview("", 0, 0)
                        return object_n_member if object_n_member != ""
                    _:
                        pass
                return bare_type_name_through_ref(expression)

        # The head name of a type (`Pooled[Node]` -> "Pooled", `Game` -> "Game",
        # `M::Game` -> "Game"), else "".
        def affine_type_head(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line): return name
                    Expr.Scope(qualifier, member, scope_line): return affine_qualified_member(qualifier, member, table)
                    Expr.Index(head, argument, index_line): return affine_type_ident(head, table)
                    # Two or more generic arguments (notably `Pool[T, @r]`) use a
                    # separate AST node. Preserve the owner name for affine checks.
                    Expr.IndexN(head, arguments, indexn_line): return affine_type_ident(head, table)
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Mutable or operator == TokenKind.Question:
                            return affine_type_head(operand, table)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)
                return sview("", 0, 0)

        # The single generic argument of `Head[Arg]` when it is a plain name, else "".
        def affine_type_argument(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match type_expression:
                    Expr.Index(head, argument, index_line): affine_type_ident(argument, table)
                    Expr.IndexN(head, arguments, indexn_line):
                        if arguments.count > 0:
                            return affine_type_ident(arguments[0], table)
                        return sview("", 0, 0)
                    _: sview("", 0, 0)

        # stage0 resolves every `T&` annotation, and refuses one whose pointee is an unborrowable
        # affine struct: "references to values containing linear handles are not supported;
        # got T&". `Pooled[Node]` renders its argument, so a generic pointee needs a plain one.
        def check_affine_reference_annotation(type_expression: Ast::Expr, name: sview @source, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if affine_ref_pointee(type_expression) is pointee:
                    head: sview = affine_type_head(pointee, table)
                    argument: sview = affine_type_argument(pointee, table)
                    generic_ok: bool = match pointee:
                        Expr.Index(index_head, index_argument, index_line): argument != ""
                        Expr.IndexN(indexn_head, indexn_arguments, indexn_line): argument != ""
                        _: true
                    if generic_ok and struct_is_unborrowable_affine(table, head):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineReference, name: name, line: line, expected: head, actual: "", detail: argument})
                        return
                    # A container, fixed array or generic instance holding linear handles
                    # (`darray[Handle]&`, `Handle[2]&`, `Box[Pair]&`): stage0's
                    # containsAffineHandleValues walks the pointee's element types. A declared owner
                    # (`linear struct Owner[T]`) stays borrowable whatever its arguments.
                    instance: bool = match pointee:
                        Expr.Index(index_head, index_argument, index_line): true
                        Expr.IndexN(indexn_head, indexn_arguments, indexn_line): true
                        _: false
                    # A fixed array (`Handle[2]`) is not its element: the owner exemption is for a
                    # generic owner instance only.
                    fixed_array: bool = match pointee:
                        Expr.Index(fixed_head, fixed_extent, fixed_line): affine_type_is_extent(fixed_extent)
                        _: false
                    if instance and (fixed_array or not struct_is_borrowable_owner(table, head)) and affine_type_contains_handles(pointee, table):
                        spelling: mutable darray[u8] = []
                        rendered: bool = affine_type_render(pointee, &spelling)
                        # A Diagnostic outlives the table's text_storage buffer (it rendered as other text,
                        # e.g. 'got set ele'), so the spelling goes to permanent storage.
                        text: sview = Parser::persist_name_bytes(&spelling, 0) can Global{Read,Write} if rendered and spelling.count > 0 else head
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineReference, name: name, line: line, expected: text, actual: "", detail: ""})

        def affine_type_is_extent(argument: Ast::Expr) -> bool:
            can Abort.Panic:
                return match argument:
                    Expr.IntLit(extent, extent_line): true
                    _: false

        # The `elems` entry for a local of `type_expression`: its handle element type, else
        # "<linear holder>" for any other container, optional or generic instance holding a
        # handle (`dict[i64, Handle]`, `darray[darray[Handle]]`, `Handle?`, `Box[Handle]`),
        # whose address stage0 refuses. A declared owner (`Pool[i64]`) stays borrowable.
        def affine_local_element(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                element: sview = affine_element_type(type_expression, table)
                return element if element != ""
                holder: mutable bool = false
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return affine_local_element(operand, table) if operator != TokenKind.Question and operator != TokenKind.Ampersand
                        holder <- operator == TokenKind.Question
                    Expr.Paren(inner, paren_line):
                        return affine_local_element(inner, table)
                    Expr.Index(head, argument, index_line):
                        holder <- affine_type_is_extent(argument) or not struct_is_borrowable_owner(table, affine_type_ident(head, table))
                    Expr.IndexN(head, arguments, indexn_line):
                        holder <- not struct_is_borrowable_owner(table, affine_type_ident(head, table))
                    _:
                        pass
                return "<linear holder>" if holder and affine_type_contains_handles(type_expression, table)
                return ""

        # Whether an interned type holds a linear handle: the TypeId twin of
        # affine_type_contains_handles, for struct fields. A reference holds none.
        def affine_interned_holds_handles(type_id: u32, depth: u32, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if type_id == 0 or depth > 32
                kind: SemTypeKind = interned_kind(type_id, table)
                return false if kind == SemTypeKind.Ref
                return struct_is_affine(table, interned_name(type_id, table)) if kind == SemTypeKind.Named
                return true if kind == SemTypeKind.Container and struct_is_affine(table, interned_name(type_id, table))
                while position < interned_elem_count(type_id, table) |position: u32 = 0|:
                    return true if affine_interned_holds_handles(interned_elem(type_id, position, table), depth + 1, table)
                    position <- position + 1
                return false

        # Whether `&o.f` addresses a field that holds handles without being a declared owner
        # (`o.xs: darray[Handle]`, `o.d: dict[i64, Handle]`). `o.h: Handle` is borrowable.
        def affine_field_is_holder(type_id: u32, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                kind: SemTypeKind = interned_kind(type_id, table)
                return false if kind != SemTypeKind.Container and kind != SemTypeKind.Optional and kind != SemTypeKind.Tuple
                head: sview = interned_name(type_id, table)
                return false if kind == SemTypeKind.Container and head != "array" and struct_is_borrowable_owner(table, head)
                return affine_interned_holds_handles(type_id, 0, table)

        # Whether values of `type_expression` hold a linear handle: an affine struct, or a
        # container, optional, fixed array or generic instance whose element type does. A
        # reference element (`darray[Handle&]`) borrows, so it holds none.
        def affine_type_contains_handles(type_expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, ident_line):
                        return struct_is_affine(table, type_name)
                    Expr.Paren(inner, paren_line):
                        return affine_type_contains_handles(inner, table)
                    Expr.Unary(operator, operand, unary_line):
                        return false if operator == TokenKind.Ampersand
                        return affine_type_contains_handles(operand, table)
                    Expr.Index(head, argument, index_line):
                        if argument is Expr.IntLit(extent, extent_line):
                            return affine_type_contains_handles(head, table)
                        return true if struct_is_affine(table, affine_type_ident(head, table))
                        return affine_type_contains_handles(argument, table)
                    Expr.IndexN(head, arguments, indexn_line):
                        return true if struct_is_affine(table, affine_type_ident(head, table))
                        for argument in arguments |table|:
                            return true if affine_type_contains_handles(argument, table)
                        return false
                    _:
                        return false
                return false

        # Appends stage0's spelling of `type_expression` (`dict[i64, Handle]`, `Handle[2]`,
        # `darray[Handle?]`) to `out`. false (a partial append) for a shape it cannot spell;
        # the caller then names the head alone.
        def affine_type_render(type_expression: Ast::Expr, out: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, ident_line):
                        for offset in 0..<type_name.len |out, type_name|:
                            out.push(type_name[offset])
                        return true
                    Expr.Paren(inner, paren_line):
                        return affine_type_render(inner, out)
                    Expr.IntLit(extent, extent_line):
                        value: i64 = extent
                        return false if value < 0
                        divisor: mutable i64 = 1
                        while divisor * 10 <= value |divisor, value|:
                            divisor <- divisor * 10
                        while divisor > 0 |divisor, value, out|:
                            out.push((48 + (value / divisor) % 10).u8())
                            divisor <- divisor / 10
                        return true
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Mutable:
                            return affine_type_render(operand, out)
                        return false if:
                            operator != TokenKind.Question and operator != TokenKind.Ampersand
                            not affine_type_render(operand, out)
                        out.push(63) if operator == TokenKind.Question
                        out.push(38) if operator == TokenKind.Ampersand
                        return true
                    Expr.Index(head, argument, index_line):
                        return false if not affine_type_render(head, out)
                        out.push(91)
                        return false if not affine_type_render(argument, out)
                        out.push(93)
                        return true
                    Expr.IndexN(head, arguments, indexn_line):
                        return false if not affine_type_render(head, out)
                        out.push(91)
                        spelled: mutable bool = true
                        index: mutable usize = 0
                        for argument in arguments |spelled, index, out|:
                            if spelled:
                                if index > 0:
                                    out.push(44)
                                    out.push(32)
                                spelled <- affine_type_render(argument, out)
                            index <- index + 1
                        return false if not spelled
                        out.push(93)
                        return true
                    _:
                        return false
                return false

        # The struct a binding holds, seen through a reference: `K`, `mutable K`, `K&` -> "K".
        def affine_binding_type(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                if affine_ref_pointee(type_expression) is pointee:
                    return affine_type_head(pointee, table) if not (pointee is Expr.Absent)
                return affine_type_head(type_expression, table)

        # Whether the innermost binding of `name` is a reference.
        def affine_local_is_ref(names: darray[sview]&, refs: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                while name_index > 0 |name_index: usize = names.count|:
                    name_index <- name_index - 1
                    return refs[name_index] if names[name_index] == name
                return false

        # The affine struct `value` names when it is a bare by-value local (`t` — not `move t`,
        # not a borrow), else "": the root-only case of stage0's lookupAffineValueKey.
        def affine_owned_local(value: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, elems: darray[sview]&, refs: darray[bool]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                if value is Expr.Ident(source_name, source_line):
                    source_type: sview = local_type_of(names, types, source_name)
                    return source_type if source_type != "" and struct_is_affine(table, source_type) and not affine_local_is_ref(names, refs, source_name)
                return ""

        # The element type indexing a local of `type_expression` yields, seen through a
        # reference or `mutable`: `darray[K]` / `view[K]` -> "K", a fixed `K[4]` or `K[N]`
        # (N a const) -> "K", else "".
        def affine_element_type(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        return affine_element_type(operand, table) if operator != TokenKind.Question
                    Expr.Paren(inner, paren_line):
                        return affine_element_type(inner, table)
                    Expr.Index(head, argument, index_line):
                        head_name: sview = ident_name_of(head)
                        return affine_type_ident(argument, table) if head_name == "darray" or head_name == "view"
                        match argument:
                            Expr.IntLit(extent, extent_line):
                                return head_name
                            Expr.Ident(extent_name, extent_line):
                                for const_name in table.const_int_names:
                                    return head_name if const_name == extent_name
                            _:
                                pass
                    Expr.IndexN(head, arguments, indexn_line):
                        head_name: sview = ident_name_of(head)
                        if arguments.count > 0 and (head_name == "darray" or head_name == "view"):
                            return affine_type_ident(arguments[0], table)
                    _:
                        pass
                return ""

        # The type of a by-value read out of a local's interior: `p`, `p.h`, `o.p.h` (a base
        # seen through a reference; a `T&` field records no type) or `xs[i]`. "" when unknown.
        def affine_path_type(value: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, elems: darray[sview @source]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        return local_type_of(names, types, name)
                    Expr.Field(object, field_name, field_line):
                        owner: sview = affine_path_type(object, names, types, elems, table)
                        if owner != "":
                            row: i64 = struct_field_row_for_type(table, owner, field_name)
                            if row >= 0:
                                return table.struct_field_type[row.usize()]
                    Expr.Index(object, index, index_line):
                        if object is Expr.Ident(indexed_name, indexed_line):
                            return local_type_of(names, elems, indexed_name)
                    _:
                        pass
                return ""

        # The affine struct a field or element read (`p.h`, `o.p.h`, `xs[i]`) copies out of a
        # local, else "": the non-root cases of stage0's lookupAffineValueKey. The base may be
        # a reference; reading through it still copies the value out.
        def affine_projection_type(value: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, elems: darray[sview @source]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                projected: mutable sview = ""
                match value:
                    Expr.Field(object, field_name, field_line):
                        projected <- affine_path_type(value, names, types, elems, table)
                    Expr.Index(object, index, index_line):
                        projected <- affine_path_type(value, names, types, elems, table)
                    _:
                        pass
                return projected if projected != "" and struct_is_affine(table, projected)
                return ""

        # Report a field or element copy at a move site. stage0 names a field path (`p.h`,
        # `o.p.h`) and an element `<value>`; a Diagnostic may only hold source sviews, so the
        # path travels as root + up to two segments (detail2/detail3) the renderer joins.
        # Deeper paths, and every path inside an enum payload (whose message already uses
        # detail2/detail3), fall back to `<value>`: same verdict, coarser name.
        def push_affine_projection_move(value: Ast::Expr, source_type: sview, context: sview @source, target: sview @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                root: mutable sview = "<value>"
                middle: mutable sview = ""
                leaf: mutable sview = ""
                at: mutable Ast::Pos = Ast::expr_pos(value)
                match value:
                    Expr.Field(object, field_name, field_line):
                        at <- field_line
                        match object:
                            Expr.Ident(object_name, object_line):
                                root <- object_name
                                middle <- field_name
                            Expr.Field(inner, inner_field, inner_line):
                                if inner is Expr.Ident(inner_name, inner_name_line):
                                    root <- inner_name
                                    middle <- inner_field
                                    leaf <- field_name
                            _:
                                pass
                    Expr.Index(object, index, index_line):
                        at <- index_line
                    _:
                        pass
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: root, pos: at, line: at.line, expected: context, actual: target, detail: affine_move_subject(table, source_type), detail2: middle, detail3: leaf})

        # stage0's consumeAffineValueExpr at a move site: an affine local placed there without
        # `move` "must be moved explicitly before <context>". `context` is a phrase with a
        # space so it can never collide with the type name the local-init site passes.
        def check_affine_move_site(value: Ast::Expr, context: sview @source, target: sview @source, names: darray[sview]&, types: darray[sview @source]&, elems: darray[sview @source]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if value is Expr.Ident(source_name, source_line):
                    source_type: sview = affine_owned_local(value, names, types, elems, refs, table)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: context, actual: target, detail: affine_move_subject(table, source_type)}) if source_type != ""
                projected_type: sview = affine_projection_type(value, names, types, elems, table)
                table <- push_affine_projection_move(value, projected_type, context, target, table) if projected_type != ""

        # stage0's unlabeled tuple element name. A Diagnostic may only carry static or source
        # sviews, so the spelling comes from a literal table.
        def affine_tuple_slot_name(index: usize) -> sview:
            can Abort.Panic:
                return match index:
                    0: "_0"
                    1: "_1"
                    2: "_2"
                    3: "_3"
                    4: "_4"
                    5: "_5"
                    6: "_6"
                    7: "_7"
                    8: "_8"
                    9: "_9"
                    _: "_"

        # `Box.Full(t)` / `Box.Tagged(h: t, n: 2)`: a by-value payload takes ownership, as in
        # stage0's variantConstructorMoveReason. The message names the payload label when the
        # variant declares one, else the 1-based argument position.
        def check_affine_enum_payload_moves(owner: sview @source, variant: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, names: darray[sview]&, types: darray[sview @source]&, elems: darray[sview @source]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                argument_index: mutable usize = 0
                for argument in arguments |argument_index, table| -> table:
                    argument_label: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    labeled_position: int = enum_payload_index(table, owner, variant, argument_label) if argument_label != "" else argument_index.int()
                    if labeled_position >= 0:
                        position: usize = labeled_position.usize()
                        payload_type_id: u32 = pag_enum_payload_type_id(owner, variant, position, table)
                        source_type: sview = affine_owned_local(argument, names, types, elems, refs, table)
                        if payload_type_id != 0 and interned_kind(payload_type_id, table) != SemTypeKind.Ref and source_type != "":
                            if argument is Expr.Ident(source_name, source_line):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: "enum payload", actual: owner, detail: affine_move_subject(table, source_type), detail2: variant, detail3: enum_payload_name_at(table, owner, variant, position), expected_count: (position + 1).u32()})
                        # A field or element copied into the payload. detail2/detail3 carry the
                        # variant and label here, so the path is named `<value>`.
                        projected_type: sview = affine_projection_type(argument, names, types, elems, table)
                        if payload_type_id != 0 and interned_kind(payload_type_id, table) != SemTypeKind.Ref and projected_type != "":
                            projected_pos: Ast::Pos = Ast::expr_pos(argument)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: "<value>", pos: projected_pos, line: projected_pos.line, expected: "enum payload", actual: owner, detail: affine_move_subject(table, projected_type), detail2: variant, detail3: enum_payload_name_at(table, owner, variant, position), expected_count: (position + 1).u32()})
                    argument_index <- argument_index + 1

        # The local a record-update base names: `p`, `move p` or `(move p)`, else "".
        def record_update_base_name(base: Ast::Expr) -> sview:
            can Abort.Panic:
                match base:
                    Expr.Ident(name, name_line):
                        return name
                    Expr.Move(moved, move_line):
                        return record_update_base_name(moved)
                    Expr.Paren(inner, paren_line):
                        return record_update_base_name(inner)
                    _:
                        return ""

        def check_affine_call_copy(value: Ast::Expr, names: darray[sview]&, types: darray[sview @source]&, elems: darray[sview @source]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_affine_moves(value, "array element", names, types, elems, refs, table)
