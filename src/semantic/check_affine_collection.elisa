# Affine-family diagnostic (registry-level, no dataflow). An affinity-disciplined struct
# (`linear`/`affine` — a single-use "linear handle") may not be a `dict` key or a `set`
# element: hashing/equality would duplicate the handle. stage0 rejects both; stage1 was silent.
# Purely a type-shape + registry lookup — sound without any move/use dataflow (which stage1
# lacks). Checked at declaration type-annotation positions: local VarDecls, function
# parameters, and struct fields.
extend Semantic:
    private:
        def addressed_affine_type(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match value:
                    Expr.Unary(address_operator, Expr.Ident(source_name, source_line), address_line):
                        return local_type_of(names, types, source_name) if address_operator == TokenKind.Ampersand else ""
                    Expr.Unary(address_operator, Expr.Field(Expr.Ident(owner_name, owner_line), field_name, field_line), address_line):
                        owner_type: sview = local_type_of(names, types, owner_name)
                        return interned_name(field_type_id_of(table, owner_type, field_name), table) if address_operator == TokenKind.Ampersand and owner_type != "" else ""
                    _:
                        return ""

        # stage0's isBorrowableAffineOwnerType: a struct DECLARED `linear`/`affine` (an `extern
        # resource` is one) may be borrowed (`T&`, `&value`), and the borrowed-owner flow analysis
        # keeps that sound; so may the builtin protocol owners ThreadPool and TaskGroup. `Pooled[T]`
        # stays unborrowable (docs/69): its interior-alias check only follows `ptr` read directly
        # off the owner, so a pointer read through a borrow would dangle.
        def struct_is_borrowable_owner(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                false return if name == "" or name == "Pooled"
                true return if name == "ThreadPool" or name == "TaskGroup"
                return struct_is_declared_affine(table, name)

        # An affine struct stage0 refuses to borrow: `Pooled`, or a plain aggregate that is
        # affine only because a field is.
        def struct_is_unborrowable_affine(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return struct_is_affine(table, name) and not struct_is_borrowable_owner(table, name)

        # stage0 names a moved aggregate by what it holds: "value containing linear handles" for
        # a plain struct with an affine field, "linear value" for a declared owner.
        def affine_move_subject(table: SymbolTable&, type_name: sview) -> sview:
            can Abort.Panic:
                subject: sview = "container" if type_name != "Pooled" and struct_is_unborrowable_affine(table, type_name) else ""
                return subject

        # The pointee of a reference annotation, seen through `mutable` and an optional `?`
        # (`T&`, `mutable T&`, `T&?`), else Absent.
        def affine_ref_pointee(type_expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        operand return if operator == TokenKind.Ampersand
                        affine_ref_pointee(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Question
                        return (Ast::Expr.Absent)
                    Expr.Paren(inner, paren_line):
                        return affine_ref_pointee(inner)
                    _:
                        return (Ast::Expr.Absent)

        def affine_annotation_is_ref(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match affine_ref_pointee(type_expression):
                    Expr.Absent: false
                    _: true

        # The head name of a type (`Pooled[Node]` -> "Pooled", `Game` -> "Game"), else "".
        def affine_type_head(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, ident_line): return name
                    Expr.Index(head, argument, index_line): return ident_name_of(head)
                    # Two or more generic arguments (notably `Pool[T, @r]`) use a
                    # separate AST node. Preserve the owner name for affine checks.
                    Expr.IndexN(head, arguments, indexn_line): return ident_name_of(head)
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Mutable or operator == TokenKind.Question:
                            return affine_type_head(operand)
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)
                return sview("", 0, 0)

        # The single generic argument of `Head[Arg]` when it is a plain name, else "".
        def affine_type_argument(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                return match type_expression:
                    Expr.Index(head, argument, index_line): ident_name_of(argument)
                    Expr.IndexN(head, arguments, indexn_line):
                        if arguments.count > 0:
                            return ident_name_of(arguments[0])
                        return sview("", 0, 0)
                    _: sview("", 0, 0)

        # stage0 resolves every `T&` annotation, and refuses one whose pointee is an unborrowable
        # affine struct: "references to values containing linear handles are not supported;
        # got T&". `Pooled[Node]` renders its argument, so a generic pointee needs a plain one.
        def check_affine_reference_annotation(type_expression: Ast::Expr, name: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                pointee: Ast::Expr = affine_ref_pointee(type_expression)
                head: sview = affine_type_head(pointee)
                argument: sview = affine_type_argument(pointee)
                generic_ok: bool = match pointee:
                    Expr.Index(index_head, index_argument, index_line): argument != ""
                    Expr.IndexN(indexn_head, indexn_arguments, indexn_line): argument != ""
                    _: true
                if generic_ok and struct_is_unborrowable_affine(table, head):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineReference, name: name, line: line, expected: head, actual: "", detail: argument})
                    return
                # A container, fixed array or generic instance holding linear handles
                # (`darray[Handle]&`, `Handle[2]&`, `Box[Pair]&`): stage0's
                # containsAffineHandleValues walks the pointee's element types. A declared owner
                # (`linear struct Owner[T]`) stays borrowable whatever its arguments.
                instance: bool = match pointee:
                    Expr.Index(index_head, index_argument, index_line): true
                    Expr.IndexN(indexn_head, indexn_arguments, indexn_line): true
                    _: false
                # A fixed array (`Handle[2]`) is not its element: the owner exemption is for a
                # generic owner instance only.
                fixed_array: bool = match pointee:
                    Expr.Index(fixed_head, fixed_extent, fixed_line): affine_type_is_extent(fixed_extent)
                    _: false
                if instance and (fixed_array or not struct_is_borrowable_owner(table, head)) and affine_type_contains_handles(pointee, table):
                    spelling: mutable darray[u8] = []
                    rendered: bool = affine_type_render(pointee, &spelling)
                    # text_storage never reallocates, so its bytes are a stable Diagnostic sview.
                    start: usize = table.text_storage.count
                    fits: bool = rendered and start + spelling.count <= 65536.usize()
                    for byte in spelling |table| -> table:
                        table.text_storage.push(byte) if fits
                    text: sview = bytes_view_range(table.text_storage, start, spelling.count) if fits else head
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineReference, name: name, line: line, expected: text, actual: "", detail: ""})

        def affine_type_is_extent(argument: Ast::Expr) -> bool:
            can Abort.Panic:
                return match argument:
                    Expr.IntLit(extent, extent_line): true
                    _: false

        # The `elems` entry for a local of `type_expression`: its handle element type, else
        # "<linear holder>" for any other container, optional or generic instance holding a
        # handle (`dict[i64, Handle]`, `darray[darray[Handle]]`, `Handle?`, `Box[Handle]`),
        # whose address stage0 refuses. A declared owner (`Pool[i64]`) stays borrowable.
        def affine_local_element(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                element: sview = affine_element_type(type_expression, table)
                element return if element != ""
                holder: mutable bool = false
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        affine_local_element(operand, table) return if operator != TokenKind.Question and operator != TokenKind.Ampersand
                        holder <- operator == TokenKind.Question
                    Expr.Paren(inner, paren_line):
                        return affine_local_element(inner, table)
                    Expr.Index(head, argument, index_line):
                        holder <- affine_type_is_extent(argument) or not struct_is_borrowable_owner(table, ident_name_of(head))
                    Expr.IndexN(head, arguments, indexn_line):
                        holder <- not struct_is_borrowable_owner(table, ident_name_of(head))
                    _:
                        pass
                "<linear holder>" return if holder and affine_type_contains_handles(type_expression, table)
                return ""

        # Whether an interned type holds a linear handle: the TypeId twin of
        # affine_type_contains_handles, for struct fields. A reference holds none.
        def affine_interned_holds_handles(type_id: u32, depth: u32, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if type_id == 0 or depth > 32
                kind: SemTypeKind = interned_kind(type_id, table)
                false return if kind == SemTypeKind.Ref
                struct_is_affine(table, interned_name(type_id, table)) return if kind == SemTypeKind.Named
                true return if kind == SemTypeKind.Container and struct_is_affine(table, interned_name(type_id, table))
                while position < interned_elem_count(type_id, table) |position: u32 = 0|:
                    true return if affine_interned_holds_handles(interned_elem(type_id, position, table), depth + 1, table)
                    position <- position + 1
                return false

        # Whether `&o.f` addresses a field that holds handles without being a declared owner
        # (`o.xs: darray[Handle]`, `o.d: dict[i64, Handle]`). `o.h: Handle` is borrowable.
        def affine_field_is_holder(type_id: u32, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                kind: SemTypeKind = interned_kind(type_id, table)
                false return if kind != SemTypeKind.Container and kind != SemTypeKind.Optional and kind != SemTypeKind.Tuple
                head: sview = interned_name(type_id, table)
                false return if kind == SemTypeKind.Container and head != "array" and struct_is_borrowable_owner(table, head)
                return affine_interned_holds_handles(type_id, 0, table)

        # Whether values of `type_expression` hold a linear handle: an affine struct, or a
        # container, optional, fixed array or generic instance whose element type does. A
        # reference element (`darray[Handle&]`) borrows, so it holds none.
        def affine_type_contains_handles(type_expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, ident_line):
                        return struct_is_affine(table, type_name)
                    Expr.Paren(inner, paren_line):
                        return affine_type_contains_handles(inner, table)
                    Expr.Unary(operator, operand, unary_line):
                        false return if operator == TokenKind.Ampersand
                        return affine_type_contains_handles(operand, table)
                    Expr.Index(head, argument, index_line):
                        if argument is Expr.IntLit(extent, extent_line):
                            return affine_type_contains_handles(head, table)
                        true return if struct_is_affine(table, ident_name_of(head))
                        return affine_type_contains_handles(argument, table)
                    Expr.IndexN(head, arguments, indexn_line):
                        true return if struct_is_affine(table, ident_name_of(head))
                        for argument in arguments |table|:
                            true return if affine_type_contains_handles(argument, table)
                        return false
                    _:
                        return false
                return false

        # Appends stage0's spelling of `type_expression` (`dict[i64, Handle]`, `Handle[2]`,
        # `darray[Handle?]`) to `out`. false (a partial append) for a shape it cannot spell;
        # the caller then names the head alone.
        def affine_type_render(type_expression: Ast::Expr, out: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, ident_line):
                        for offset in 0..<sview_len(type_name) |out, type_name|:
                            out.push(sview_at(type_name, offset))
                        return true
                    Expr.Paren(inner, paren_line):
                        return affine_type_render(inner, out)
                    Expr.IntLit(extent, extent_line):
                        value: i64 = extent
                        false return if value < 0
                        divisor: mutable i64 = 1
                        while divisor * 10 <= value |divisor, value|:
                            divisor <- divisor * 10
                        while divisor > 0 |divisor, value, out|:
                            out.push((48 + (value / divisor) % 10).u8())
                            divisor <- divisor / 10
                        return true
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Mutable:
                            return affine_type_render(operand, out)
                        false return if operator != TokenKind.Question and operator != TokenKind.Ampersand
                        false return if not affine_type_render(operand, out)
                        out.push(63) if operator == TokenKind.Question
                        out.push(38) if operator == TokenKind.Ampersand
                        return true
                    Expr.Index(head, argument, index_line):
                        false return if not affine_type_render(head, out)
                        out.push(91)
                        false return if not affine_type_render(argument, out)
                        out.push(93)
                        return true
                    Expr.IndexN(head, arguments, indexn_line):
                        false return if not affine_type_render(head, out)
                        out.push(91)
                        spelled: mutable bool = true
                        index: mutable usize = 0
                        for argument in arguments |spelled, index, out|:
                            if spelled:
                                if index > 0:
                                    out.push(44)
                                    out.push(32)
                                spelled <- affine_type_render(argument, out)
                            index <- index + 1
                        false return if not spelled
                        out.push(93)
                        return true
                    _:
                        return false
                return false

        # The struct a binding holds, seen through a reference: `K`, `mutable K`, `K&` -> "K".
        def affine_binding_type(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                pointee: Ast::Expr = affine_ref_pointee(type_expression)
                return match pointee:
                    Expr.Absent: affine_type_head(type_expression)
                    _: affine_type_head(pointee)

        # Whether the innermost binding of `name` is a reference.
        def affine_local_is_ref(names: darray[sview]&, refs: darray[bool]&, name: sview) -> bool:
            can Abort.Panic:
                while name_index > 0 |name_index: usize = names.count|:
                    name_index <- name_index - 1
                    refs[name_index] return if names[name_index] == name
                return false

        # The affine struct `value` names when it is a bare by-value local (`t` — not `move t`,
        # not a borrow), else "": the root-only case of stage0's lookupAffineValueKey.
        def affine_owned_local(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, refs: darray[bool]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                if value is Expr.Ident(source_name, source_line):
                    source_type: sview = local_type_of(names, types, source_name)
                    source_type return if source_type != "" and struct_is_affine(table, source_type) and not affine_local_is_ref(names, refs, source_name)
                return ""

        # The element type indexing a local of `type_expression` yields, seen through a
        # reference or `mutable`: `darray[K]` / `view[K]` -> "K", a fixed `K[4]` or `K[N]`
        # (N a const) -> "K", else "".
        def affine_element_type(type_expression: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        affine_element_type(operand, table) return if operator != TokenKind.Question
                    Expr.Paren(inner, paren_line):
                        return affine_element_type(inner, table)
                    Expr.Index(head, argument, index_line):
                        head_name: sview = ident_name_of(head)
                        ident_name_of(argument) return if head_name == "darray" or head_name == "view"
                        match argument:
                            Expr.IntLit(extent, extent_line):
                                return head_name
                            Expr.Ident(extent_name, extent_line):
                                for const_name in table.const_int_names:
                                    head_name return if const_name == extent_name
                            _:
                                pass
                    Expr.IndexN(head, arguments, indexn_line):
                        head_name: sview = ident_name_of(head)
                        if arguments.count > 0 and (head_name == "darray" or head_name == "view"):
                            return ident_name_of(arguments[0])
                    _:
                        pass
                return ""

        # The type of a by-value read out of a local's interior: `p`, `p.h`, `o.p.h` (a base
        # seen through a reference; a `T&` field records no type) or `xs[i]`. "" when unknown.
        def affine_path_type(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, ident_line):
                        return local_type_of(names, types, name)
                    Expr.Field(object, field_name, field_line):
                        owner: sview = affine_path_type(object, names, types, elems, table)
                        if owner != "":
                            row: i64 = struct_field_row_for_type(table, owner, field_name)
                            if row >= 0:
                                return table.struct_field_type[row.usize()]
                    Expr.Index(object, index, index_line):
                        if object is Expr.Ident(indexed_name, indexed_line):
                            return local_type_of(names, elems, indexed_name)
                    _:
                        pass
                return ""

        # The affine struct a field or element read (`p.h`, `o.p.h`, `xs[i]`) copies out of a
        # local, else "": the non-root cases of stage0's lookupAffineValueKey. The base may be
        # a reference; reading through it still copies the value out.
        def affine_projection_type(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, table: SymbolTable&) -> sview:
            can Abort.Panic:
                projected: mutable sview = ""
                match value:
                    Expr.Field(object, field_name, field_line):
                        projected <- affine_path_type(value, names, types, elems, table)
                    Expr.Index(object, index, index_line):
                        projected <- affine_path_type(value, names, types, elems, table)
                    _:
                        pass
                projected return if projected != "" and struct_is_affine(table, projected)
                return ""

        # Report a field or element copy at a move site. stage0 names a field path (`p.h`,
        # `o.p.h`) and an element `<value>`; a Diagnostic may only hold source sviews, so the
        # path travels as root + up to two segments (detail2/detail3) the renderer joins.
        # Deeper paths, and every path inside an enum payload (whose message already uses
        # detail2/detail3), fall back to `<value>`: same verdict, coarser name.
        def push_affine_projection_move(value: Ast::Expr, source_type: sview, context: sview, target: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                root: mutable sview = "<value>"
                middle: mutable sview = ""
                leaf: mutable sview = ""
                at: mutable Ast::Pos = Ast::expr_pos(value)
                match value:
                    Expr.Field(object, field_name, field_line):
                        at <- field_line
                        match object:
                            Expr.Ident(object_name, object_line):
                                root <- object_name
                                middle <- field_name
                            Expr.Field(inner, inner_field, inner_line):
                                if inner is Expr.Ident(inner_name, inner_name_line):
                                    root <- inner_name
                                    middle <- inner_field
                                    leaf <- field_name
                            _:
                                pass
                    Expr.Index(object, index, index_line):
                        at <- index_line
                    _:
                        pass
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: root, pos: at, line: at.line, expected: context, actual: target, detail: affine_move_subject(table, source_type), detail2: middle, detail3: leaf})

        # stage0's consumeAffineValueExpr at a move site: an affine local placed there without
        # `move` "must be moved explicitly before <context>". `context` is a phrase with a
        # space so it can never collide with the type name the local-init site passes.
        def check_affine_move_site(value: Ast::Expr, context: sview, target: sview, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if value is Expr.Ident(source_name, source_line):
                    source_type: sview = affine_owned_local(value, names, types, elems, refs, table)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: context, actual: target, detail: affine_move_subject(table, source_type)}) if source_type != ""
                projected_type: sview = affine_projection_type(value, names, types, elems, table)
                table <- push_affine_projection_move(value, projected_type, context, target, table) if projected_type != ""

        # stage0's unlabeled tuple element name. A Diagnostic may only carry static or source
        # sviews, so the spelling comes from a literal table.
        def affine_tuple_slot_name(index: usize) -> sview:
            can Abort.Panic:
                return match index:
                    0: "_0"
                    1: "_1"
                    2: "_2"
                    3: "_3"
                    4: "_4"
                    5: "_5"
                    6: "_6"
                    7: "_7"
                    8: "_8"
                    9: "_9"
                    _: "_"

        # `Box.Full(t)` / `Box.Tagged(h: t, n: 2)`: a by-value payload takes ownership, as in
        # stage0's variantConstructorMoveReason. The message names the payload label when the
        # variant declares one, else the 1-based argument position.
        def check_affine_enum_payload_moves(owner: sview, variant: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                argument_index: mutable usize = 0
                for argument in arguments |argument_index, table| -> table:
                    argument_label: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    labeled_position: int = enum_payload_index(table, owner, variant, argument_label) if argument_label != "" else argument_index.int()
                    if labeled_position >= 0:
                        position: usize = labeled_position.usize()
                        payload_type_id: u32 = pag_enum_payload_type_id(owner, variant, position, table)
                        source_type: sview = affine_owned_local(argument, names, types, elems, refs, table)
                        if payload_type_id != 0 and interned_kind(payload_type_id, table) != SemTypeKind.Ref and source_type != "":
                            if argument is Expr.Ident(source_name, source_line):
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: "enum payload", actual: owner, detail: affine_move_subject(table, source_type), detail2: variant, detail3: enum_payload_name_at(table, owner, variant, position), expected_count: (position + 1).u32()})
                        # A field or element copied into the payload. detail2/detail3 carry the
                        # variant and label here, so the path is named `<value>`.
                        projected_type: sview = affine_projection_type(argument, names, types, elems, table)
                        if payload_type_id != 0 and interned_kind(payload_type_id, table) != SemTypeKind.Ref and projected_type != "":
                            projected_pos: Ast::Pos = Ast::expr_pos(argument)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: "<value>", pos: projected_pos, line: projected_pos.line, expected: "enum payload", actual: owner, detail: affine_move_subject(table, projected_type), detail2: variant, detail3: enum_payload_name_at(table, owner, variant, position), expected_count: (position + 1).u32()})
                    argument_index <- argument_index + 1

        # The local a record-update base names: `p`, `move p` or `(move p)`, else "".
        def record_update_base_name(base: Ast::Expr) -> sview:
            can Abort.Panic:
                match base:
                    Expr.Ident(name, name_line):
                        return name
                    Expr.Move(moved, move_line):
                        return record_update_base_name(moved)
                    Expr.Paren(inner, paren_line):
                        return record_update_base_name(inner)
                    _:
                        return ""

        def check_affine_call_copy(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_affine_moves(value, "array element", names, types, elems, refs, table)

        # Every move site nested anywhere in `value` (stage0 checks them wherever the expression
        # sits: `(sink(t) + 1)`, `return Pair{a: t}`). `array_context` names the literal the
        # top-level expression initializes, since stage0 says "darray literal element" when the
        # expected type is a darray.
        def check_affine_moves(value: Ast::Expr, array_context: sview, names: darray[sview]&, types: darray[sview]&, elems: darray[sview]&, refs: darray[bool]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = match callee:
                            Expr.Ident(name, _): name
                            Expr.Scope(_, name, _): name
                            _: sview("", 0, 0)
                        if callee_name != "":
                            argument_index: mutable usize = 0
                            for argument in arguments |argument_index, table| -> table:
                                if argument is Expr.Ident(source_name, source_line):
                                    source_type: sview = local_type_of(names, types, source_name)
                                    parameter_type: sview = function_parameter_type_at_firm(table, callee_name, argument_index)
                                    # A reference argument lends, it does not copy: stage0 reports only the
                                    # parameter mismatch (`expects K, got K&`) when the parameter is by value.
                                    source_is_ref: bool = affine_local_is_ref(names, refs, source_name)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: "Call", actual: callee_name, detail: affine_move_subject(table, source_type)}) if source_type != "" and source_type == parameter_type and struct_is_affine(table, source_type) and not source_is_ref
                                # `sink(p.h)` / `sink(xs[0])` copies the field or element out.
                                projected_argument: sview = affine_projection_type(argument, names, types, elems, table)
                                if projected_argument != "" and projected_argument == function_parameter_type_at_firm(table, callee_name, argument_index):
                                    table <- push_affine_projection_move(argument, projected_argument, "Call", callee_name, table)
                                argument_index <- argument_index + 1
                        # `xs.push(t)` on a darray local moves `t` into the darray.
                        match callee:
                            Expr.Field(Expr.Ident(receiver_name, receiver_line), method_name, method_line):
                                if method_name == "push" and arguments.count == 1 and local_type_of(names, types, receiver_name) == "darray":
                                    table <- check_affine_move_site(arguments[0], "darray push", "", names, types, elems, refs, table)
                                if method_name == "put" and arguments.count == 2 and local_type_of(names, types, receiver_name) == "dict":
                                    table <- check_affine_move_site(arguments[1], "dict put", "", names, types, elems, refs, table)
                                if local_type_of(names, types, receiver_name) == "" and enum_has_variant(table, receiver_name, method_name):
                                    table <- check_affine_enum_payload_moves(receiver_name, method_name, arguments, argument_names, names, types, elems, refs, table)
                            _:
                                table <- check_affine_moves(callee, "array element", names, types, elems, refs, table)
                        for nested_argument in arguments |table| -> table:
                            table <- check_affine_moves(nested_argument, "array element", names, types, elems, refs, table)
                    Expr.Construct(construct_type, fields, construct_line):
                        struct_name: sview = affine_type_head(construct_type)
                        for field in fields |table| -> table:
                            # A by-value field takes ownership; a `T&` field only borrows.
                            field_id: u32 = field_type_id_of(table, struct_name, field.name) if struct_name != "" and field.name != "" else 0
                            if field_id != 0 and interned_kind(field_id, table) != SemTypeKind.Ref:
                                table <- check_affine_move_site(field.value, "struct field", field.name, names, types, elems, refs, table)
                            table <- check_affine_moves(field.value, "array element", names, types, elems, refs, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        # `base{f = v}` copies `base` and moves each override in (stage0's
                        # analyzeRecordUpdateExpr). A `T&` field only borrows.
                        base_struct: sview = local_type_of(names, types, record_update_base_name(base))
                        for field in fields |table| -> table:
                            field_id: u32 = field_type_id_of(table, base_struct, field.name) if base_struct != "" and field.name != "" else 0
                            if field_id != 0 and interned_kind(field_id, table) != SemTypeKind.Ref:
                                table <- check_affine_move_site(field.value, "record update field", field.name, names, types, elems, refs, table)
                            table <- check_affine_moves(field.value, "array element", names, types, elems, refs, table)
                        table <- check_affine_move_site(base, "record update", "", names, types, elems, refs, table)
                        table <- check_affine_moves(base, "array element", names, types, elems, refs, table)
                    Expr.Tuple(elements, tuple_line):
                        # The AST drops tuple labels, so this names elements the way stage0 does
                        # without an expected type (`_0`, `_1`, ...).
                        element_index: mutable usize = 0
                        for element in elements |element_index, table| -> table:
                            table <- check_affine_move_site(element, "tuple element", affine_tuple_slot_name(element_index), names, types, elems, refs, table)
                            table <- check_affine_moves(element, "array element", names, types, elems, refs, table)
                            element_index <- element_index + 1
                    Expr.Array(elements, array_line):
                        for element in elements |table| -> table:
                            table <- check_affine_move_site(element, array_context, "", names, types, elems, refs, table)
                            table <- check_affine_moves(element, "array element", names, types, elems, refs, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- check_affine_moves(left, "array element", names, types, elems, refs, table)
                        table <- check_affine_moves(right, "array element", names, types, elems, refs, table)
                    Expr.Unary(operator, operand, unary_line):
                        # `&xs` on a darray, view or fixed array of linear handles, wherever it
                        # sits (`f(&xs)`, `(&xs).cast`): stage0 refuses the address; an element
                        # borrow (`&xs[0]`) of a declared owner stays allowed.
                        if operator == TokenKind.Ampersand and operand is Expr.Ident(addressed_name, addressed_line):
                            addressed_element: sview = local_type_of(names, elems, addressed_name)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineAddress, name: "", line: addressed_line.line, expected: "", actual: "container"}) if addressed_element != "" and (addressed_element == "<linear holder>" or struct_is_affine(table, addressed_element)) and not affine_local_is_ref(names, refs, addressed_name)
                        if operator == TokenKind.Ampersand and operand is Expr.Field(field_object, addressed_field, addressed_field_line):
                            field_owner: sview = affine_path_type(field_object, names, types, elems, table)
                            field_type: u32 = field_type_id_of(table, field_owner, addressed_field) if field_owner != "" else 0
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineAddress, name: "", line: addressed_field_line.line, expected: "", actual: "container"}) if affine_field_is_holder(field_type, table)
                        table <- check_affine_moves(operand, "array element", names, types, elems, refs, table)
                    Expr.Move(operand, move_line):
                        table <- check_affine_moves(operand, "array element", names, types, elems, refs, table)
                    Expr.Paren(inner, paren_line):
                        table <- check_affine_moves(inner, array_context, names, types, elems, refs, table)
                    Expr.Field(object, field_name, field_line):
                        table <- check_affine_moves(object, "array element", names, types, elems, refs, table)
                    Expr.Index(object, index, index_line):
                        table <- check_affine_moves(object, "array element", names, types, elems, refs, table)
                        table <- check_affine_moves(index, "array element", names, types, elems, refs, table)
                    Expr.If(condition, then_expr, else_expr, if_line):
                        table <- check_affine_moves(condition, "array element", names, types, elems, refs, table)
                        table <- check_affine_moves(then_expr, array_context, names, types, elems, refs, table)
                        table <- check_affine_moves(else_expr, array_context, names, types, elems, refs, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, comprehension_line):
                        # `[f(x) for x in xs]` binds each element of `xs` by value: stage0 refuses
                        # it when the element holds a linear handle (`move xs` included).
                        iterated: sview = affine_iterated_local(iterable)
                        iterated_element: sview = local_type_of(names, elems, iterated) if iterated != "" else sview("", 0, 0)
                        if iterated_element == "<linear holder>":
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineComprehensionIteration, name: iterated, pos: comprehension_line, line: comprehension_line.line, expected: "", actual: ""})
                        elif iterated_element != "" and struct_is_affine(table, iterated_element):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineComprehensionIteration, name: iterated, pos: comprehension_line, line: comprehension_line.line, expected: "", actual: iterated_element})
                        # The element moves into the result; the loop variable itself is not an
                        # outer local, so a same-named shadow is skipped.
                        shadowed: bool = match body:
                            Expr.Ident(element_name, element_line): element_name == loop_variable
                            _: false
                        table <- check_affine_move_site(body, "list comprehension element", "", names, types, elems, refs, table) if not shadowed
                        table <- check_affine_moves(iterable, "array element", names, types, elems, refs, table)
                        table <- check_affine_moves(condition, "array element", names, types, elems, refs, table)
                        table <- check_affine_moves(body, "array element", names, types, elems, refs, table)
                    _:
                        pass


        # The local a comprehension iterates: `xs`, `move xs` or `(xs)`; "" otherwise.
        def affine_iterated_local(iterable: Ast::Expr) -> sview:
            can Abort.Panic:
                return match iterable:
                    Expr.Ident(iterated_name, iterated_line): iterated_name
                    Expr.Move(moved, moved_line): affine_iterated_local(moved)
                    Expr.Paren(inner, paren_line): affine_iterated_local(inner)
                    _: ""

        # Whether an initializer is a brace literal (`{}` / `{...}`) — after an
        # affine-key rejection stage0 stops seeing it as a dict/set initializer
        # and additionally reports the membership-set misuse.
        def initializer_is_brace_literal(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.DictLit(entries, dict_line):
                        return true
                    Expr.SetLit(elements, set_line):
                        return true
                    _:
                        return false

        # If `type_expression` is `set[T]` / `dict[K,V]` whose element/key holds a linear handle
        # (stage0's containsAffineHandleValues: an affine struct, `Handle?`, `darray[Handle]`,
        # an aggregate holding one), emit the corresponding diagnostic. `dict` checks the KEY
        # only (matching stage0).
        def check_affine_collection_type(type_expression: Ast::Expr, initializer: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, index_line):
                        head_name: sview = bare_type_name(object)
                        if head_name == "set" and affine_type_contains_handles(index, table):
                            spelling: mutable darray[u8] = []
                            rendered: bool = affine_type_render(index, &spelling)
                            # text_storage never reallocates, so its bytes are a stable Diagnostic sview.
                            start: usize = table.text_storage.count
                            fits: bool = rendered and start + spelling.count <= 65536.usize()
                            for byte in spelling |table| -> table:
                                table.text_storage.push(byte) if fits
                            element_name: sview = bytes_view_range(table.text_storage, start, spelling.count) if fits else bare_type_name(index)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SetElementAffine, name: "", pos: Ast::expr_pos(index), line: index_line.line, expected: "", actual: element_name})
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BraceMembershipMisuse, name: "", pos: Ast::expr_pos(initializer), line: Ast::expr_pos(initializer).line, expected: "", actual: ""}) if initializer_is_brace_literal(initializer)
                    Expr.IndexN(object, arguments, indexn_line):
                        head_name: sview = bare_type_name(object)
                        if head_name == "dict" and arguments.count >= 1:
                            if affine_type_contains_handles(arguments[0], table):
                                key_spelling: mutable darray[u8] = []
                                key_rendered: bool = affine_type_render(arguments[0], &key_spelling)
                                key_start: usize = table.text_storage.count
                                key_fits: bool = key_rendered and key_start + key_spelling.count <= 65536.usize()
                                for key_byte in key_spelling |table| -> table:
                                    table.text_storage.push(key_byte) if key_fits
                                key_name: sview = bytes_view_range(table.text_storage, key_start, key_spelling.count) if key_fits else bare_type_name(arguments[0])
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictKeyAffine, name: "", pos: Ast::expr_pos(arguments[0]), line: indexn_line.line, expected: "", actual: key_name})
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BraceMembershipMisuse, name: "", pos: Ast::expr_pos(initializer), line: Ast::expr_pos(initializer).line, expected: "", actual: ""}) if initializer_is_brace_literal(initializer)
                    _:
                        pass


        def check_affine_collection_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, types: mutable darray[sview]&, elems: mutable darray[sview]&, refs: mutable darray[bool]&, return_is_ref: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, names, types, elems, refs| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_affine_collection_type(type_expression, value, table)
                            table <- check_affine_reference_annotation(type_expression, name, line.line, table)
                            array_context: sview = "darray element" if affine_type_head(type_expression) == "darray" else "array element"
                            table <- check_affine_moves(value, array_context, names, types, elems, refs, table)
                            target_is_ref: bool = affine_annotation_is_ref(type_expression)
                            if value is Expr.Ident(source_name, source_line):
                                source_affine_type: sview = local_type_of(names, types, source_name)
                                # `r: K& = o` with `o: K&` copies the reference, not the owner.
                                ref_to_ref: bool = target_is_ref and affine_local_is_ref(names, refs, source_name)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: source_affine_type, actual: name, detail: affine_move_subject(table, source_affine_type)}) if source_affine_type != "" and struct_is_affine(table, source_affine_type) and not ref_to_ref
                            # `u: K = p.h` copies the field out; `u: K& = p.h` is a type error, not a move.
                            projected_init: sview = affine_projection_type(value, names, types, elems, table)
                            table <- push_affine_projection_move(value, projected_init, projected_init, name, table) if projected_init != "" and not target_is_ref
                            # `&xs` on a container of handles is check_affine_moves' to report.
                            addressed_container: mutable bool = false
                            if value is Expr.Unary(address_operator, address_operand, address_line):
                                if address_operand is Expr.Ident(container_name, container_line):
                                    addressed_container <- address_operator == TokenKind.Ampersand and local_type_of(names, elems, container_name) != ""
                            source_type: sview = "" if addressed_container else addressed_affine_type(value, names, types, table)
                            builtin_handle: bool = source_type in {"Thread", "Task", "MutexGuard", "ThreadPool", "TaskGroup"}
                            # A borrowable owner may be addressed; an aggregate that merely contains
                            # one may not, and stage0 words that case differently.
                            address_container: sview = "container" if source_type != "Pooled" else ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineAddress, name: "", line: line.line, expected: source_type, actual: address_container}) if source_type != "" and not builtin_handle and struct_is_unborrowable_affine(table, source_type)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineAddress, name: "", line: line.line, expected: source_type, actual: ""}) if source_type != "" and builtin_handle
                            target_type: sview = affine_type_head(type_expression)
                            copy_source: sview = affine_root(value) if target_type in {"ThreadPool", "TaskGroup"} else ""
                            copy_type: sview = local_type_of(names, types, copy_source) if copy_source != "" else ""
                            owner_copy: bool = copy_type == target_type and copy_type != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: copy_source, line: line.line, expected: copy_type, actual: name}) if owner_copy
                            names.push(name)
                            types.push(affine_binding_type(type_expression))
                            elems.push(affine_local_element(type_expression, table))
                            refs.push(target_is_ref)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_affine_call_copy(value, names, types, elems, refs, table)
                            if value is Expr.Ident(source_name, source_line):
                                source_affine_type: sview = local_type_of(names, types, source_name)
                                target_name: sview = ident_name_of(target)
                                source_is_ref: bool = affine_local_is_ref(names, refs, source_name)
                                # An untyped `y = r` binds another reference; `y <- r` into a value
                                # copies the owner out ("... before assignment").
                                assign_copies: bool = operator == TokenKind.LArrow and not (source_is_ref and affine_local_is_ref(names, refs, target_name))
                                assign_binds_owner: bool = operator != TokenKind.LArrow and not source_is_ref
                                move_context: mutable sview = source_affine_type
                                move_context <- "Assign" if operator == TokenKind.LArrow
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: move_context, actual: target_name, detail: affine_move_subject(table, source_affine_type)}) if source_affine_type != "" and struct_is_affine(table, source_affine_type) and (assign_copies or assign_binds_owner)
                                if operator == TokenKind.Assign and target_name != "":
                                    source_element: sview = local_type_of(names, elems, source_name)
                                    names.push(target_name)
                                    types.push(source_affine_type)
                                    elems.push(source_element)
                                    refs.push(source_is_ref)
                            # `u <- p.h` / `u = p.h` copies a field or element out.
                            projected_assign: sview = affine_projection_type(value, names, types, elems, table)
                            if projected_assign != "" and (operator == TokenKind.LArrow or operator == TokenKind.Assign):
                                assign_target: sview = ident_name_of(target)
                                assign_context: sview = "Assign" if operator == TokenKind.LArrow else projected_assign
                                table <- push_affine_projection_move(value, projected_assign, assign_context, assign_target, table)
                                if operator == TokenKind.Assign and assign_target != "":
                                    names.push(assign_target)
                                    types.push(projected_assign)
                                    elems.push("")
                                    refs.push(false)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- check_affine_call_copy(returned, names, types, elems, refs, table)
                                if returned is Expr.Ident(source_name, source_line):
                                    source_affine_type: sview = local_type_of(names, types, source_name)
                                    # Returning a borrow as a borrow (`-> K&`) moves nothing.
                                    lends: bool = return_is_ref and affine_local_is_ref(names, refs, source_name)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: source_name, pos: source_line, line: source_line.line, expected: "Return", actual: "", detail: affine_move_subject(table, source_affine_type)}) if source_affine_type != "" and struct_is_affine(table, source_affine_type) and not lends
                                # `-> K&` returning `p.h` is a type error in stage0, not a move.
                                projected_return: sview = affine_projection_type(returned, names, types, elems, table)
                                table <- push_affine_projection_move(returned, projected_return, "Return", "", table) if projected_return != "" and not return_is_ref
                        Stmt.Expr(expression, line):
                            table <- check_affine_call_copy(expression, names, types, elems, refs, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_affine_collection_statements(body, names, types, elems, refs, return_is_ref, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_affine_collection_statements(then_body, names, types, elems, refs, return_is_ref, table)
                            table <- check_affine_collection_statements(else_body, names, types, elems, refs, return_is_ref, table)
                        Stmt.While(condition, body, line):
                            table <- check_affine_collection_statements(body, names, types, elems, refs, return_is_ref, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_affine_collection_statements(body, names, types, elems, refs, return_is_ref, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, names, types, elems, refs| -> table:
                                table <- check_affine_collection_statements(arm.body, names, types, elems, refs, return_is_ref, table)
                        _:
                            pass


        def check_affine_collection(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            types: mutable darray[sview] = []
                            elems: mutable darray[sview] = []
                            refs: mutable darray[bool] = []
                            for parameter in parameters |table, names, types, elems, refs| -> table:
                                table <- check_affine_collection_type(parameter.type_expression, (Ast::Expr.Absent), table)
                                table <- check_affine_reference_annotation(parameter.type_expression, parameter.name, line.line, table)
                                names.push(parameter.name)
                                types.push(bare_type_name_through_ref(parameter.type_expression))
                                elems.push(affine_local_element(parameter.type_expression, table))
                                refs.push(affine_annotation_is_ref(parameter.type_expression))
                            return_is_ref: mutable bool = false
                            if return_type is declared_return:
                                table <- check_affine_reference_annotation(declared_return, name, line.line, table)
                                return_is_ref <- affine_annotation_is_ref(declared_return)
                            table <- check_affine_collection_statements(body, names, types, elems, refs, return_is_ref, table)
                        Decl.Struct(struct_name, members, affinity, _, _, _, struct_line):
                            for member in members |table| -> table:
                                table <- check_affine_collection_type(member.type_expression, (Ast::Expr.Absent), table)
                                table <- check_affine_reference_annotation(member.type_expression, member.name, Ast::expr_pos(member.type_expression).line, table)
                        Decl.Module(module_name, body, module_line):
                            previous_module: sview = table.current_module
                            table.current_module <- module_name
                            table <- check_affine_collection(body, table)
                            table.current_module <- previous_module
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_affine_collection(scoped_body, table)
                        Decl.Const(global_name, type_expression, value, is_mutable, line):
                            global_type: sview = bare_type_name_through_ref(type_expression)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineGlobal, name: global_name, line: line.line, expected: global_type, actual: ""}) if is_mutable and struct_is_affine(table, global_type)
                        _:
                            pass
