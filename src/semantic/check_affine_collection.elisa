# Affine-family diagnostic (registry-level, no dataflow). An affinity-disciplined struct
# (`linear`/`affine` — a single-use "linear handle") may not be a `dict` key or a `set`
# element: hashing/equality would duplicate the handle. stage0 rejects both; stage1 was silent.
# Purely a type-shape + registry lookup — sound without any move/use dataflow (which stage1
# lacks). Checked at declaration type-annotation positions: local VarDecls, function
# parameters, and struct fields.
extend Semantic:
    private:
        # If `type_expression` is `set[T]` / `dict[K,V]` whose element/key is an affine struct,
        # emit the corresponding diagnostic. `dict` checks the KEY only (matching stage0).
        def check_affine_collection_type(type_expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(object, index, index_line):
                        head_name: sview = bare_type_name(object)
                        element_name: sview = bare_type_name(index)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.SetElementAffine, name: "", line: index_line, expected: "", actual: element_name}) if head_name == "set" and struct_is_affine(table, element_name)
                    Expr.IndexN(object, arguments, indexn_line):
                        head_name: sview = bare_type_name(object)
                        if head_name == "dict":
                            if arguments.count >= 1:
                                key_name: sview = bare_type_name(arguments[0])
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DictKeyAffine, name: "", line: indexn_line, expected: "", actual: key_name}) if struct_is_affine(table, key_name)
                    _:
                        pass


        def check_affine_collection_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_affine_collection_type(type_expression, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_affine_collection_statements(body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_affine_collection_statements(then_body, table)
                            table <- check_affine_collection_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_affine_collection_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_affine_collection_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_affine_collection_statements(arm.body, table)
                        _:
                            pass


        def check_affine_collection(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            for parameter in parameters |table| -> table:
                                table <- check_affine_collection_type(parameter.type_expression, table)
                            table <- check_affine_collection_statements(body, table)
                        Decl.Struct(struct_name, members, affinity, _, _, _, struct_line):
                            for member in members |table| -> table:
                                table <- check_affine_collection_type(member.type_expression, table)
                        Decl.Module(module_name, body, module_line):
                            table <- check_affine_collection(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_affine_collection(scoped_body, table)
                        _:
                            pass
