extend Semantic:
    private:
        def pft_pattern(pattern: Ast::Pattern, value_type: PrivateFieldType, position: Ast::Pos, scope: sview, declarations: darray[Ast::Decl]&, table: lmut SymbolTable, bindings: mutable darray[PrivateFieldBinding]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        bindings.push(PrivateFieldBinding{name: name, value_type: value_type})
                    Pattern.Struct(_, fields):
                        for field in fields |table, bindings|:
                            if field is Pattern.Binding(name):
                                row: i64 = pft_field(value_type, name, declarations, table)
                                table <- pft_report(row, position, scope, table)
                                member_type: PrivateFieldType = PrivateFieldType{expression: table.private_field_types[row.usize()], owner: struct_field_module_at(table, row.usize())} if row >= 0 else pft_unknown()
                                bindings.push(PrivateFieldBinding{name: name, value_type: member_type})
                            else:
                                table <- pft_pattern(field, value_type, position, scope, declarations, table, bindings)
                    Pattern.Field(selector, inner):
                        row: i64 = pft_field(value_type, selector, declarations, table)
                        table <- pft_report(row, position, scope, table)
                        member_type: PrivateFieldType = PrivateFieldType{expression: table.private_field_types[row.usize()], owner: struct_field_module_at(table, row.usize())} if row >= 0 else pft_unknown()
                        for nested in inner |table, bindings|:
                            table <- pft_pattern(nested, member_type, position, scope, declarations, table, bindings)
                    Pattern.As(name, inner):
                        bindings.push(PrivateFieldBinding{name: name, value_type: value_type})
                        for nested in inner |table, bindings|:
                            table <- pft_pattern(nested, value_type, position, scope, declarations, table, bindings)
                    Pattern.Tuple(elements):
                        unwrapped: PrivateFieldType = pft_unwrap(value_type)
                        for index in 0..<elements.count |table, bindings|:
                            element_type: mutable PrivateFieldType = pft_unknown()
                            if unwrapped.expression is Expr.Tuple(types, _):
                                element_type <- PrivateFieldType{expression: types[index], owner: value_type.owner} if index < types.count
                            table <- pft_pattern(elements[index], element_type, position, scope, declarations, table, bindings)
                    _:
                        pass
