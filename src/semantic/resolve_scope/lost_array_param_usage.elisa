extend Semantic:
    private:
        # How a function body uses one array parameter: self-writes (`p[i] <- v`,
        # `p += v`), mentions anywhere else, and whether any binder reuses the name.
        struct ArrayParamUsage:
            writes: mutable usize
            observed: mutable usize
            rebound: mutable bool



        def array_param_usage_in(statements: darray[Ast::Stmt], name: sview, usage: mutable ArrayParamUsage) -> ArrayParamUsage:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |usage| -> usage:
                    match statement:
                        Stmt.VarDecl(declared_name, type_expression, value, line):
                            usage.rebound <- usage.rebound or declared_name == name
                            usage <- array_param_usage_in_value(value, name, usage)
                        Stmt.Assign(target, operator, value, line):
                            if operator != TokenKind.Assign and array_write_root(target) == name:
                                usage.writes <- usage.writes + 1
                            else:
                                usage.rebound <- usage.rebound or (operator == TokenKind.Assign and array_write_root(target) == name and target is Expr.Ident(assigned_name, assigned_line))
                                usage <- array_param_usage_in_value(target, name, usage)
                                usage <- array_param_usage_in_value(value, name, usage)
                        Stmt.If(condition, then_body, else_body, line):
                            usage <- array_param_usage_in_value(condition, name, usage)
                            usage <- array_param_usage_in(then_body, name, usage)
                            usage <- array_param_usage_in(else_body, name, usage)
                        Stmt.While(condition, body, line):
                            usage <- array_param_usage_in_value(condition, name, usage)
                            usage <- array_param_usage_in(body, name, usage)
                        Stmt.For(bind, variables, iterable, body, line):
                            usage.rebound <- usage.rebound or any variable in variables where variable == name
                            usage <- array_param_usage_in_value(iterable, name, usage)
                            usage <- array_param_usage_in(body, name, usage)
                        Stmt.Block(kind, clause, binding, body, line):
                            usage.rebound <- usage.rebound or binding == name
                            usage.observed <- usage.observed + count_name_mentions(clause, name)
                            usage <- array_param_usage_in(body, name, usage)
                        Stmt.Match(scrutinee, arms, line):
                            usage <- array_param_usage_in_value(scrutinee, name, usage)
                            for arm in arms |usage| -> usage:
                                arm_binders: mutable darray[sview] = []
                                collect_pattern_binding_names(arm.pattern, arm_binders)
                                usage.rebound <- usage.rebound or any arm_binder in arm_binders where arm_binder == name
                                usage <- array_param_usage_in_value(arm.guard, name, usage)
                                usage <- array_param_usage_in(arm.body, name, usage)
                        Stmt.Expr(expression, line):
                            usage <- array_param_usage_in_value(expression, name, usage)
                        Stmt.Return(value, line):
                            usage <- array_param_usage_in_value(returned, name, usage) if value is returned
                        Stmt.Contract(kind, expression, line):
                            usage <- array_param_usage_in_value(expression, name, usage)
                        _:
                            pass
                usage



        # A block expression's statements are walked like a body (its self-writes are
        # writes); any other expression only contributes mentions.
        def array_param_usage_in_value(expression: Ast::Expr, name: sview, usage: mutable ArrayParamUsage) -> ArrayParamUsage:
            can Memory.Allocate, Abort.Panic:
                if expression is Expr.Block(block_statements, block_tail, block_captures, block_line):
                    usage.observed <- usage.observed + count_name_mentions(block_captures, name)
                    usage <- array_param_usage_in(block_statements, name, usage)
                    return array_param_usage_in_value(block_tail, name, usage)
                mentions: mutable darray[sview] = []
                collect_expression_uses(expression, mentions)
                usage.observed <- usage.observed + count_name_mentions(mentions, name)
                usage



        def count_name_mentions(names: darray[sview]&, name: sview) -> usize:
            can Abort.Panic:
                total: mutable usize = 0
                for candidate in names |total|:
                    total <- total + 1 if candidate == name
                return total



        # The variable an assignment target writes through: `p`, `p[i]`, `p[i].x`.
        def array_write_root(target: Ast::Expr) -> sview:
            can Abort.Panic:
                match target:
                    Expr.Ident(root_name, root_line):
                        return root_name
                    Expr.Index(index_receiver, index_argument, index_line):
                        return array_write_root(index_receiver)
                    Expr.Field(field_receiver, field_name, field_line):
                        return array_write_root(field_receiver)
                    Expr.Paren(paren_inner, paren_line):
                        return array_write_root(paren_inner)
                    _:
                        return ""
