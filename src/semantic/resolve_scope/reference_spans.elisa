# Which source spans resolution bound to a parameter or local binding.
#
# Resolution logs every identifier occurrence that names a parameter or local (`ref_pos`,
# resolve_reference_identity.elisa). These helpers index that log by start offset so a later
# check can ask in O(1) whether an identifier -- typically a call's callee -- names a lexical
# binding. Such a binding shadows every same-named function, in this module or any other:
# `chrome(a, b)` through a local `chrome: fn(usize, usize) -> i64` is not a call to a
# function `chrome`, and nothing about that function's signature applies to it.

extend Semantic:
    private:
        # Whether resolution logged a reference at exactly SPAN, through the offset chains
        # while they are current.
        def reference_span_is_recorded(table: SymbolTable&, span: Ast::Pos) -> bool:
            can Abort.Panic:
                if table.reference_span_index_built and table.reference_spans_indexed == table.ref_pos.count:
                    row: mutable u32 = head if table.reference_span_heads.get(span.offset.u64()) is head else SYMBOL_INDEX_ROW_NONE
                    while row != SYMBOL_INDEX_ROW_NONE |row, table, span|:
                        candidate: Ast::Pos = table.ref_pos[row.usize()]
                        return true if candidate.offset == span.offset and candidate.end_offset == span.end_offset
                        row <- table.reference_span_next[row.usize()]
                    return false
                return any pos in table.ref_pos where pos.offset == span.offset and pos.end_offset == span.end_offset

        # Chain the logged references by start offset, unless the chains already cover them.
        def index_reference_spans(table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if table.reference_span_index_built and table.reference_spans_indexed == table.ref_pos.count
                table.reference_span_heads <- {}
                table.reference_span_next <- []
                for row in 0..<table.ref_pos.count |table|:
                    key: u64 = table.ref_pos[row].offset.u64()
                    previous: u32 = head if table.reference_span_heads.get(key) is head else SYMBOL_INDEX_ROW_NONE
                    table.reference_span_next <- table.reference_span_next.push(previous)
                    table.reference_span_heads <- table.reference_span_heads.put(key, row.u32()) can Global{Read,Write}
                table.reference_spans_indexed <- table.ref_pos.count
                table.reference_span_index_built <- true

        # Whether CALLEE is an identifier that resolved to a parameter or local binding, so
        # the call goes through that value rather than to a function of the same name.
        def callee_is_lexical_binding(callee: Ast::Expr, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return match callee:
                    Ast::Expr.Ident(_, position): position.end_offset > position.offset and reference_span_is_recorded(table, position)
                    _: false
