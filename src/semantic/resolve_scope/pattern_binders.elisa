extend Semantic:
    private:
        def pattern_binder_name_index_find(index: PatternBinderNameIndex&, name: sview, found_row: mutable u32&, found_value: mutable usize&) -> bool:
            can Abort.Panic, Global{Read,Write}:
                found_row <- SYMBOL_INDEX_ROW_NONE
                found_value <- 0.usize()
                return false if index.names.count != index.values.count or index.names.count != index.next.count
                hash: u64 = name_hash(name)
                row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if index.heads.get(hash) is head:
                    row <- head
                probes: mutable usize = 0.usize()
                while row != SYMBOL_INDEX_ROW_NONE and probes < index.names.count |row, probes, name, found_row, found_value, index|:
                    return false if row.usize() >= index.names.count or row.usize() >= index.values.count or row.usize() >= index.next.count
                    if index.names[row.usize()] == name:
                        found_row <- row
                        found_value <- index.values[row.usize()]
                        return true
                    row <- index.next[row.usize()]
                    probes <- probes + 1.usize()
                return false

        def pattern_binder_name_index_add(index: mutable PatternBinderNameIndex&, name: sview, value: usize) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return if index.names.count >= SYMBOL_INDEX_ROW_NONE.usize()
                hash: u64 = name_hash(name)
                head: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if index.heads.get(hash) is found_head:
                    head <- found_head
                row: u32 = index.names.count.u32()
                index.next <- index.next.push(head)
                index.names <- index.names.push(name)
                index.values <- index.values.push(value)
                index.heads <- index.heads.put(hash, row) can Global{Read,Write}

        # Build source positions once for every binder in an arm. The map traversal tracks
        # every parser binder token (including tokens in all Or alternatives), while its
        # output order follows gather_pattern's logical binding order. Each indexed
        # per-name annotation chain is visited twice at most (count, then fill), so repeated
        # names and wide flat patterns avoid rescanning the pattern and chain per binding.
        def arm_pattern_binder_positions(table: SymbolTable&, pattern: Ast::Pattern, arm_names: darray[sview]&, arm_start: usize, arm_position: Ast::Pos) -> darray[Ast::Pos]:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                if arm_start >= arm_names.count:
                    empty_positions: darray[Ast::Pos] = []
                    return empty_positions
                mapped_names: mutable darray[sview] = []
                mapped_ordinals: mutable darray[usize] = []
                source_counts: mutable PatternBinderNameIndex = PatternBinderNameIndex{heads: {}, names: [], values: [], next: []}
                pattern_binder_source_mappings(pattern, source_counts, mapped_names, mapped_ordinals)

                cached_bases: mutable darray[usize] = []
                cached_starts: mutable darray[usize] = []
                cached_lengths: mutable darray[usize] = []
                cached_name_slots: mutable PatternBinderNameIndex = PatternBinderNameIndex{heads: {}, names: [], values: [], next: []}
                source_positions: mutable darray[Ast::Pos] = []
                missing: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                for binder_name in mapped_names |table, arm_position, cached_bases, cached_starts, cached_lengths, cached_name_slots, source_positions, source_counts, missing|:
                    cached_slot: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    cached_value: mutable usize = 0.usize()
                    if not pattern_binder_name_index_find(cached_name_slots, binder_name, cached_slot, cached_value):
                        base: mutable usize = 0
                        total: mutable usize = 0
                        token_count: mutable usize = 0.usize()
                        source_count_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        token_count_value: mutable usize = 0.usize()
                        if pattern_binder_name_index_find(source_counts, binder_name, source_count_row, token_count_value):
                            token_count <- token_count_value
                        row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        if table.binder_annotations_indexed:
                            row <- binder_annotation_head(table, local_binding_exact_hash(binder_name, arm_position.line, 0))
                            while row != SYMBOL_INDEX_ROW_NONE |row, base, total, binder_name, arm_position, table|:
                                annotation: Ast::EnumAnnotation = table.binder_annotations[row.usize()]
                                if annotation.owner == "__pattern_binder" and annotation.line == arm_position.line and annotation.name == binder_name:
                                    total <- total + 1
                                    base <- base + 1 if annotation.pos.offset < arm_position.offset
                                row <- table.binder_annotation_next[row.usize()]
                        cached_slot <- cached_name_slots.names.count.u32()
                        pattern_binder_name_index_add(cached_name_slots, binder_name, cached_slot.usize())
                        cached_bases.push(base)
                        cached_starts.push(source_positions.count)
                        cached_lengths.push(token_count)
                        for token_index in 0..<token_count |source_positions, missing|:
                            source_positions.push(missing)
                        if table.binder_annotations_indexed:
                            chain_ordinal: mutable usize = 0
                            row <- binder_annotation_head(table, local_binding_exact_hash(binder_name, arm_position.line, 0))
                            while row != SYMBOL_INDEX_ROW_NONE |row, chain_ordinal, total, base, token_count, cached_starts, source_positions, cached_slot, binder_name, arm_position, table|:
                                annotation: Ast::EnumAnnotation = table.binder_annotations[row.usize()]
                                if annotation.owner == "__pattern_binder" and annotation.line == arm_position.line and annotation.name == binder_name:
                                    source_ordinal: usize = total - chain_ordinal - 1
                                    if source_ordinal >= base and source_ordinal - base < token_count:
                                        source_positions[cached_starts[cached_slot.usize()] + source_ordinal - base] <- annotation.pos
                                    chain_ordinal <- chain_ordinal + 1
                                row <- table.binder_annotation_next[row.usize()]

                if not table.binder_annotations_indexed:
                    fallback_ordinals: mutable PatternBinderNameIndex = PatternBinderNameIndex{heads: {}, names: [], values: [], next: []}
                    for annotation in table.protocol_annotations |annotation, fallback_ordinals, cached_name_slots, cached_bases, cached_starts, cached_lengths, source_positions, arm_position|:
                        if annotation.owner == "__pattern_binder" and annotation.line == arm_position.line and annotation.pos.end_offset > annotation.pos.offset:
                            cached_slot: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            cached_value: mutable usize = 0.usize()
                            if pattern_binder_name_index_find(cached_name_slots, annotation.name, cached_slot, cached_value):
                                source_ordinal: usize = pattern_binder_source_next_ordinal(annotation.name, fallback_ordinals)
                                base: usize = cached_bases[cached_slot.usize()]
                                if source_ordinal >= base and source_ordinal - base < cached_lengths[cached_slot.usize()]:
                                    source_positions[cached_starts[cached_slot.usize()] + source_ordinal - base] <- annotation.pos

                result: mutable darray[Ast::Pos] = []
                expected_count: usize = arm_names.count - arm_start
                position_index: mutable usize = 0
                while position_index < expected_count |position_index, result, mapped_names, mapped_ordinals, cached_name_slots, cached_starts, cached_lengths, source_positions, arm_names, arm_start, expected_count, arm_position, missing|:
                    binder_name: sview = arm_names[arm_start + position_index]
                    cache_slot: mutable u32 = SYMBOL_INDEX_ROW_NONE
                    cache_value: mutable usize = 0.usize()
                    if position_index < mapped_names.count and mapped_names[position_index] == binder_name and pattern_binder_name_index_find(cached_name_slots, binder_name, cache_slot, cache_value):
                        source_ordinal: usize = mapped_ordinals[position_index]
                        if source_ordinal < cached_lengths[cache_slot.usize()] and source_positions[cached_starts[cache_slot.usize()] + source_ordinal].end_offset > source_positions[cached_starts[cache_slot.usize()] + source_ordinal].offset:
                            result.push(source_positions[cached_starts[cache_slot.usize()] + source_ordinal])
                        else:
                            result.push(arm_position if expected_count == 1 else missing)
                    else:
                        result.push(missing)
                    position_index <- position_index + 1
                return result


        # Register declaration spans against the exact IDs assigned by gather_arm_pattern
        # and pad_bound_mutability. Borrow/provenance passes can then resolve arm binders by
        # the same source identity as ordinary local references.
        def record_arm_pattern_references(table: lmut SymbolTable, pattern: Ast::Pattern, arm_names: darray[sview @source]&, arm_ids: darray[BindingId]&, arm_start: usize, arm_position: Ast::Pos) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                binder_positions: darray[Ast::Pos] = arm_pattern_binder_positions(table, pattern, arm_names, arm_start, arm_position)
                pattern_index: mutable usize = arm_start
                while pattern_index < arm_names.count and pattern_index < arm_ids.count |pattern_index, table, arm_names, arm_ids, arm_start, binder_positions|:
                    binder_name: sview = arm_names[pattern_index]
                    binder_position: Ast::Pos = binder_positions[pattern_index - arm_start] if pattern_index - arm_start < binder_positions.count else Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    table <- record_reference(table, binder_position, binder_name, false, arm_ids[pattern_index]) if binder_position.end_offset > binder_position.offset
                    pattern_index <- pattern_index + 1


        # Return a source-function row only when an unqualified name has one exact
        # file-level function candidate. The semantic resolver's flat global index does
        # not choose among overloads or module members, so those cases are declined.
        def unique_top_level_function_index(table: SymbolTable&, name: sview) -> i64:
            can Abort.Panic:
                return -1 if table.current_module != ""
                symbol_count: mutable usize = 0
                candidate: mutable i64 = -1
                symbol_row: mutable u32 = symbol_chain_head(table, name)
                while symbol_row != SYMBOL_INDEX_ROW_NONE |symbol_count, candidate, symbol_row, table, name|:
                    index: usize = symbol_row.usize()
                    symbol: Symbol& = &table.symbols[index]
                    if symbol.name == name:
                        symbol_count <- symbol_count + 1
                        candidate <- index.i64()
                    symbol_row <- table.symbol_name_next[index]
                return -1 if symbol_count != 1 or candidate < 0
                target: Symbol& = &table.symbols[candidate.usize()]
                return -1 if:
                    target.kind != SymbolKind.Func or target.line == 0
                    target.name_pos.end_offset <= target.name_pos.offset
                # Any declared module member of this spelling makes an unqualified
                # occurrence ambiguous in this per-file contract, even if it is not
                # currently imported.
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_row, table, name|:
                    index: usize = member_row.usize()
                    return -1 if table.module_member_name[index] == name
                    member_row <- table.member_name_next[index]
                return candidate


        # Locate the canonical function declaration row for a resolver invocation.
        # Name alone is ambiguous for overloads; the declaration byte offset is unique
        # within the source file and is already retained by symbol collection.
        def function_declaration_id(table: SymbolTable&, name: sview, declaration_offset: u32) -> DeclId:
            can Abort.Panic:
                # The symbol name chain visits same-named rows in push order, so the first
                # match is the one the full scan found.
                if table.symbol_name_index_valid and table.symbol_name_indexed_rows == table.symbols.count and table.symbol_name_next.count == table.symbols.count:
                    row: mutable u32 = symbol_chain_head(table, name)
                    while row != SYMBOL_INDEX_ROW_NONE |row, name, declaration_offset, table|:
                        chained: Symbol& = &table.symbols[row.usize()]
                        return chained.id if chained.kind == SymbolKind.Func and chained.name == name and chained.offset == declaration_offset
                        row <- table.symbol_name_next[row.usize()]
                    return DeclId{value: SYMBOL_INDEX_ROW_NONE}
                for row in 0..<table.symbols.count |name, declaration_offset, table|:
                    symbol: Symbol& = &table.symbols[row]
                    return symbol.id if symbol.kind == SymbolKind.Func and symbol.name == name and symbol.offset == declaration_offset
                return DeclId{value: SYMBOL_INDEX_ROW_NONE}


        # Give a supported function declaration-name position its own self-edge, so a
        # definition request on the declaration resolves to the same exact Location.
        # This runs after all scopes have been collected and resolved, when overloads and
        # module-member name collisions can be rejected with the same conservative rule.
        def record_definition_declaration_sites(table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                i: mutable usize = 0
                while i < table.symbols.count:
                    if table.symbols[i].kind == SymbolKind.Func:
                        name: sview = table.symbols[i].name
                        name_pos: Ast::Pos = table.symbols[i].name_pos
                        if name_pos.end_offset > name_pos.offset and unique_top_level_function_index(table, name) == i.i64():
                            table.definition_references <- table.definition_references.push(DefinitionReference{pos: name_pos, declaration_id: table.symbols[i].id})
                    i <- i + 1


        # Index of the innermost `bound` entry named `name`, else -1. Scans from
        # the end so a later local correctly shadows an earlier param/local.
        def bound_last_index(bound: darray[sview @source]&, name: sview) -> int:
            can Abort.Panic:
                while binding_index >= 0 |binding_index: int = bound.count.int() - 1|:
                    return binding_index if bound[binding_index.usize()] == name
                    binding_index <- binding_index - 1
                return -1


        # Count how many Or alternatives bind each logical name. `first_names` is already
        # gathered by the caller (or produced by source mapping), so seed its names with
        # count one and gather each later option once. The last-seen option row prevents
        # duplicate binders from inflating a name's frequency without allocating a set per
        # alternative.
        def pattern_or_binding_name_counts(options: darray[Ast::Pattern]&, first_names: darray[sview]&, names: mutable NameSet&, frequencies: mutable darray[usize]&, last_seen_options: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic:
                first_tag: usize = 1.usize()
                for candidate in first_names |candidate, names, frequencies, last_seen_options, first_tag|:
                    row: mutable i64 = name_set_index(names, candidate)
                    if row < 0:
                        name_set_add(names, candidate)
                        frequencies.push(0.usize())
                        last_seen_options.push(0.usize())
                        row <- name_set_index(names, candidate)
                    if last_seen_options[row.usize()] != first_tag:
                        last_seen_options[row.usize()] <- first_tag
                        frequencies[row.usize()] <- frequencies[row.usize()] + 1.usize()

                option_names: mutable darray[sview @source] = []
                for option_index in 1..<options.count |option_index, options, names, frequencies, last_seen_options, option_names|:
                    option_names.truncate(0)
                    gather_pattern(options[option_index], option_names)
                    option_tag: usize = option_index + 1.usize()
                    for candidate in option_names |candidate, option_tag, names, frequencies, last_seen_options|:
                        row: mutable i64 = name_set_index(names, candidate)
                        if row < 0:
                            name_set_add(names, candidate)
                            frequencies.push(0.usize())
                            last_seen_options.push(0.usize())
                            row <- name_set_index(names, candidate)
                        if last_seen_options[row.usize()] != option_tag:
                            last_seen_options[row.usize()] <- option_tag
                            frequencies[row.usize()] <- frequencies[row.usize()] + 1.usize()


        # Whether PATTERN logically binds WANTED. Or-patterns use intersection semantics.
        def pattern_binds_name(pattern: Ast::Pattern, wanted: sview) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        return name == wanted
                    Pattern.Rest(name):
                        return name != "" and name != "_" and name == wanted
                    Pattern.As(name, inner):
                        return true if name == wanted
                        for child in inner:
                            return true if pattern_binds_name(child, wanted)
                        return false
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children):
                        for child in children:
                            return true if pattern_binds_name(child, wanted)
                        return false
                    Pattern.Or(options):
                        return false if options.count == 0
                        for option in options:
                            return false if not pattern_binds_name(option, wanted)
                        return true
                    _:
                        return false
                return false

        # Whether a pattern's logical bindings contain a non-wildcard name. Ordinary
        # composites short-circuit at the first binder; an Or uses the same intersection
        # counting as gather_pattern so nested alternatives with disjoint names stay empty.
        def pattern_has_named_binding(pattern: Ast::Pattern) -> bool:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        return name != "" and name != "_"
                    Pattern.Rest(name):
                        return name != "" and name != "_"
                    Pattern.As(name, inner):
                        return true if name != "" and name != "_"
                        for child in inner:
                            return true if pattern_has_named_binding(child)
                        return false
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children):
                        for child in children:
                            return true if pattern_has_named_binding(child)
                        return false
                    Pattern.Or(options):
                        return false if options.count == 0
                        first_names: mutable darray[sview @source] = []
                        gather_pattern(options[0], first_names)
                        if options.count == 1:
                            for candidate in first_names:
                                return true if candidate != "" and candidate != "_"
                            return false
                        if first_names.count == 1:
                            candidate: sview = first_names[0]
                            return false if candidate == "" or candidate == "_"
                            for option in options:
                                return false if not pattern_binds_name(option, candidate)
                            return true
                        counts: mutable NameSet = empty_name_set()
                        frequencies: mutable darray[usize] = []
                        last_seen_options: mutable darray[usize] = []
                        pattern_or_binding_name_counts(options, first_names, counts, frequencies, last_seen_options)
                        for candidate in first_names:
                            if candidate != "" and candidate != "_":
                                count_row: i64 = name_set_index(counts, candidate)
                                return true if count_row >= 0 and frequencies[count_row.usize()] == options.count
                        return false
                    _:
                        return false
                return false

        # Does an ARM-LEVEL or-pattern have an alternative that binds a name? stage0's
        # analyzeTopLevelOrPattern refuses such an arm ("top-level or-pattern alternatives
        # that bind names are not supported") because it cannot merge alias/borrow facts
        # across the alternatives — and having refused, it binds NOTHING and discharges no
        # coverage. `_` and the empty name are not bindings, so `A(_) or B(_):` stays legal,
        # exactly as stage0's matchPatternHasNamedBindings decides it.
        #
        # Only the WORD `or` can build an arm-level or-pattern: `|` separates sibling arms
        # and the parser fans it out (parse_top_level_patterns). A nested or-pattern is a
        # different rule entirely and keeps the intersection binding in gather_pattern.
        def arm_or_pattern_binds_names(pattern: Ast::Pattern) -> bool:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Or(options):
                        for option in options:
                            return true if pattern_has_named_binding(option)
                        return false
                    _:
                        return false
                return false

        # gather_pattern for a pattern in ARM position: an or-pattern that binds names
        # contributes nothing at all (see arm_or_pattern_binds_names). Everything else is
        # gathered normally.
        def gather_arm_pattern(pattern: Ast::Pattern, bound: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if arm_or_pattern_binds_names(pattern)
                gather_pattern(pattern, bound)

        def gather_pattern(pattern: Ast::Pattern, bound: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name):
                        bound.push(name)
                    Pattern.TypeBind(type, binder):
                        bound.push(binder)
                    Pattern.Rest(name):
                        bound.push(name) if name != "" and name != "_"
                    Pattern.Variant(path, fields):
                        field_handles: darray[Ast::Pattern] = [field_pattern for field_pattern in fields]
                        for field_handle in field_handles:
                            gather_pattern(field_handle, bound)
                    Pattern.Struct(path, fields):
                        field_handles: darray[Ast::Pattern] = [field_pattern for field_pattern in fields]
                        for field_handle in field_handles:
                            gather_pattern(field_handle, bound)
                    Pattern.Field(selector, inner):
                        inner_handles: darray[Ast::Pattern] = [inner_pattern for inner_pattern in inner]
                        for inner_handle in inner_handles:
                            gather_pattern(inner_handle, bound)
                    Pattern.Tuple(elements):
                        element_handles: darray[Ast::Pattern] = [element_pattern for element_pattern in elements]
                        for element_handle in element_handles:
                            gather_pattern(element_handle, bound)
                    Pattern.Or(options):
                        # stage0 scopes only the INTERSECTION of the alternatives'
                        # bindings: `Circle(r, tag) | Square(r)` binds `r` alone, and a
                        # body naming `tag` gets an ordinary `undefined identifier`.
                        # Nested-Or diagnostics are handled separately by the consistency
                        # checker; scope collection here uses only logical bindings.
                        #
                        # Pushes each surviving name individually: collecting into a local
                        # darray and `extend`-ing it into `bound` stores an auto-region
                        # value into the longer-lived `__rg_bound` and the region checker
                        # rejects it.
                        return if options.count == 0
                        first_names: mutable darray[sview @source] = []
                        gather_pattern(options[0], first_names)
                        if options.count == 1:
                            for candidate in first_names |bound|:
                                bound.push(candidate)
                        elif first_names.count == 1:
                            # With one candidate, probe each alternative directly. This
                            # preserves the old short-circuit path when the binder appears
                            # before a large binder-free tail.
                            candidate: sview = first_names[0]
                            in_every: mutable bool = true
                            for probe_index in 1..<options.count |options, candidate, in_every|:
                                in_every <- false if in_every and not pattern_binds_name(options[probe_index], candidate)
                            bound.push(candidate) if in_every
                        else:
                            counts: mutable NameSet = empty_name_set()
                            frequencies: mutable darray[usize] = []
                            last_seen_options: mutable darray[usize] = []
                            pattern_or_binding_name_counts(options, first_names, counts, frequencies, last_seen_options)
                            for candidate in first_names |bound, counts, frequencies, options|:
                                count_row: i64 = name_set_index(counts, candidate)
                                if count_row >= 0 and frequencies[count_row.usize()] == options.count:
                                    bound.push(candidate)
                    Pattern.As(name, inner):
                        # docs/122 §5.4: the as-name binds the whole value, plus the
                        # wrapped pattern's own bindings.
                        bound.push(name)
                        inner_handles: darray[Ast::Pattern] = [inner_pattern for inner_pattern in inner]
                        for inner_handle in inner_handles:
                            gather_pattern(inner_handle, bound)
                    _:
                        pass


        # Increment a name's source-token ordinal. `seen` is arm-local, so this is constant
        # expected time per binder instead of rescanning preceding pattern siblings.
        def pattern_binder_source_next_ordinal(name: sview, seen: mutable PatternBinderNameIndex&) -> usize:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return 0 if name == ""
                found_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                ordinal: mutable usize = 0.usize()
                if pattern_binder_name_index_find(seen, name, found_row, ordinal):
                    seen.values[found_row.usize()] <- ordinal + 1.usize()
                    return ordinal
                pattern_binder_name_index_add(seen, name, 1.usize())
                return 0.usize()


        # Count parser binder tokens in source order, including every Or alternative.
        # As-binders appear after the wrapped pattern in source, despite gather_pattern
        # returning the As name before its inner names.
        def pattern_binder_source_tokens(pattern: Ast::Pattern, seen: mutable PatternBinderNameIndex&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        pattern_binder_source_next_ordinal(name, seen)
                    Pattern.Rest(name):
                        pattern_binder_source_next_ordinal(name, seen) if name != "" and name != "_"
                    Pattern.As(name, inner):
                        children: darray[Ast::Pattern] = [child for child in inner]
                        for child in children |seen|:
                            pattern_binder_source_tokens(child, seen)
                        pattern_binder_source_next_ordinal(name, seen)
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children):
                        copied: darray[Ast::Pattern] = [child for child in children]
                        for child in copied |seen|:
                            pattern_binder_source_tokens(child, seen)
                    Pattern.Or(options):
                        copied: darray[Ast::Pattern] = [option for option in options]
                        for option in copied |seen|:
                            pattern_binder_source_tokens(option, seen)
                    _:
                        pass


        # Produce logical binder names plus the same-name source-token ordinal for each.
        # The arrays align with gather_pattern output; nested Or alternatives contribute
        # source ordinals without adding logical binders beyond the first-alternative
        # intersection, and As preserves gather_pattern's alias-first output order.
        def pattern_binder_source_mappings(pattern: Ast::Pattern, seen: mutable PatternBinderNameIndex&, names: mutable darray[sview]&, ordinals: mutable darray[usize]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        ordinal: usize = pattern_binder_source_next_ordinal(name, seen)
                        names.push(name)
                        ordinals.push(ordinal)
                    Pattern.Rest(name):
                        if name != "" and name != "_":
                            ordinal: usize = pattern_binder_source_next_ordinal(name, seen)
                            names.push(name)
                            ordinals.push(ordinal)
                    Pattern.As(name, inner):
                        inner_names: mutable darray[sview] = []
                        inner_ordinals: mutable darray[usize] = []
                        children: darray[Ast::Pattern] = [child for child in inner]
                        for child in children |seen, inner_names, inner_ordinals|:
                            pattern_binder_source_mappings(child, seen, inner_names, inner_ordinals)
                        ordinal: usize = pattern_binder_source_next_ordinal(name, seen)
                        names.push(name)
                        ordinals.push(ordinal)
                        for child_index in 0..<inner_names.count |names, ordinals, inner_names, inner_ordinals|:
                            names.push(inner_names[child_index])
                            ordinals.push(inner_ordinals[child_index])
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children):
                        copied: darray[Ast::Pattern] = [child for child in children]
                        for child in copied |seen, names, ordinals|:
                            pattern_binder_source_mappings(child, seen, names, ordinals)
                    Pattern.Or(options):
                        return if options.count == 0
                        first_names: mutable darray[sview @source] = []
                        first_ordinals: mutable darray[usize] = []
                        pattern_binder_source_mappings(options[0], seen, first_names, first_ordinals)
                        option_index: mutable usize = 1
                        while option_index < options.count |option_index, options, seen|:
                            pattern_binder_source_tokens(options[option_index], seen)
                            option_index <- option_index + 1
                        if options.count == 1:
                            for candidate_index in 0..<first_names.count |candidate_index, first_names, first_ordinals, names, ordinals|:
                                names.push(first_names[candidate_index])
                                ordinals.push(first_ordinals[candidate_index])
                        elif first_names.count == 1:
                            candidate: sview = first_names[0]
                            in_every: mutable bool = true
                            for probe_index in 1..<options.count |options, candidate, in_every|:
                                in_every <- false if in_every and not pattern_binds_name(options[probe_index], candidate)
                            if in_every:
                                names.push(candidate)
                                ordinals.push(first_ordinals[0])
                        else:
                            counts: mutable NameSet = empty_name_set()
                            frequencies: mutable darray[usize] = []
                            last_seen_options: mutable darray[usize] = []
                            pattern_or_binding_name_counts(options, first_names, counts, frequencies, last_seen_options)
                            for candidate_index in 0..<first_names.count |candidate_index, options, first_names, first_ordinals, names, ordinals, counts, frequencies|:
                                candidate: sview = first_names[candidate_index]
                                count_row: i64 = name_set_index(counts, candidate)
                                if count_row >= 0 and frequencies[count_row.usize()] == options.count:
                                    names.push(candidate)
                                    ordinals.push(first_ordinals[candidate_index])
                    _:
                        pass


        # A refinement test `EXPR is TARGET` introduces bindings on its right side: a bare
        # name (`x is mod`) binds that name; a variant form (`x is Variant(a, b)`) binds each
        # field name. A qualified constant test (`x is Enum.Const`) binds nothing.
        # `node is Expr.Pair as pair` — bring the alias into the scope the test guards. The
        # alias is recorded by LINE (the parser keeps the variant itself as the is-RHS, so the
        # test is real), and gather_is_target cannot see it: a Field target binds nothing.
        def gather_is_variant_aliases(expression: Ast::Expr, alias_lines: darray[u32]&, alias_names: darray[sview @source]&, bound: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(alias_left, alias_operator, alias_right, alias_binary_line):
                        gather_is_variant_aliases(alias_left, alias_lines, alias_names, bound)
                        if alias_operator == TokenKind.Is:
                            match alias_right:
                                Expr.Field(alias_head, alias_variant, alias_variant_line):
                                    paired: usize = alias_lines.count if alias_lines.count < alias_names.count else alias_names.count
                                    for probe in 0..<paired |bound, alias_lines, alias_names, alias_variant_line|:
                                        bound.push(alias_names[probe]) if alias_lines[probe].i64() == alias_variant_line.line
                                _:
                                    gather_is_variant_aliases(alias_right, alias_lines, alias_names, bound)
                        else:
                            gather_is_variant_aliases(alias_right, alias_lines, alias_names, bound)
                    Expr.Unary(alias_unary_operator, alias_operand, alias_unary_line):
                        gather_is_variant_aliases(alias_operand, alias_lines, alias_names, bound)
                    Expr.Paren(alias_inner, alias_paren_line):
                        gather_is_variant_aliases(alias_inner, alias_lines, alias_names, bound)
                    _:
                        pass


        def gather_is_target(expression: Ast::Expr, bound: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, line):
                        bound.push(name)
                    Expr.Call(callee, arguments, argument_names, line):
                        for argument in arguments:
                            gather_is_target(argument, bound)
                    # Array pattern `x is [1, value]` — element idents are payload binders
                    # (literals fall to the Ident-less no-op).
                    Expr.Array(elements, array_line):
                        for element in elements:
                            gather_is_target(element, bound)
                    # Struct pattern `x is Pair{left: 1, right: value}` — field-value idents
                    # are binders.
                    Expr.Construct(construct_type, fields, construct_line):
                        for field in fields:
                            gather_is_target(field.value, bound)
                    _:
                        pass
