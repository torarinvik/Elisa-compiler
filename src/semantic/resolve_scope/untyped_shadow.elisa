extend Semantic:
    private:
        # A nested-block `name = value` DECLARES a new local. When an enclosing block of
        # the same function already binds `name` as a declared local or a parameter, the
        # outer variable silently keeps its old value; code written with C or Python
        # habits almost always meant `name <- value`. Mirrors stage0's checkUntypedShadow.
        #
        # `outer` holds every name visible from the enclosing lists, innermost last, and
        # `outer_kinds` what each one is: "local", "parameter", or "" for a loop, pattern
        # or clause binder (stage0 finds that binder first and stays quiet). `here` is the
        # current list's own names: a same-list redefinition is `duplicate local`, not this.
        def check_untyped_shadow(statements: darray[Ast::Stmt], outer: darray[sview @source]&, outer_kinds: darray[sview]&, here: mutable darray[sview @source]&, here_kinds: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                no_binders: darray[sview @source] = []
                for statement in statements |table, here, here_kinds| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_untyped_shadow_in_value(value, outer, outer_kinds, here, here_kinds, table)
                            here.push(name)
                            here_kinds.push("local")
                        Stmt.Assign(target, operator, value, line):
                            table <- check_untyped_shadow_in_value(value, outer, outer_kinds, here, here_kinds, table)
                            if operator == TokenKind.Assign and target is Expr.Ident(name, ident_line):
                                if name != "_" and bound_last_index(here, name) < 0:
                                    outer_index: int = bound_last_index(outer, name)
                                    if outer_index >= 0 and outer_kinds[outer_index.usize()] != "":
                                        # A Diagnostic may only carry source or static sviews.
                                        outer_kind: sview = "parameter" if outer_kinds[outer_index.usize()] == "parameter" else "local"
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UntypedShadow, name: name, pos: line, line: line.line, expected: "", actual: outer_kind})
                                    here.push(name)
                                    here_kinds.push("local")
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_untyped_shadow_nested(then_body, no_binders, outer, outer_kinds, here, here_kinds, table)
                            table <- check_untyped_shadow_nested(else_body, no_binders, outer, outer_kinds, here, here_kinds, table)
                        Stmt.While(condition, body, line):
                            table <- check_untyped_shadow_nested(body, no_binders, outer, outer_kinds, here, here_kinds, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_untyped_shadow_nested(body, variables, outer, outer_kinds, here, here_kinds, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            clause_binders: mutable darray[sview @source] = []
                            clause_binders.push(binding) if binding != ""
                            table <- check_untyped_shadow_nested(body, clause_binders, outer, outer_kinds, here, here_kinds, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                arm_binders: mutable darray[sview @source] @source = []
                                region_escape_collect_pattern_binding_names(arm.pattern, arm_binders)
                                table <- check_untyped_shadow_nested(arm.body, arm_binders, outer, outer_kinds, here, here_kinds, table)
                        Stmt.Expr(expression, line):
                            table <- check_untyped_shadow_in_value(expression, outer, outer_kinds, here, here_kinds, table)
                        Stmt.Return(value, line):
                            table <- check_untyped_shadow_in_value(returned, outer, outer_kinds, here, here_kinds, table) if value is returned
                        _:
                            pass



        # A block expression is a nested list like any statement body.
        def check_untyped_shadow_in_value(value: Ast::Expr, outer: darray[sview @source]&, outer_kinds: darray[sview]&, here: darray[sview @source]&, here_kinds: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if value is Expr.Block(block_statements, block_tail, block_captures, block_line):
                    no_binders: darray[sview @source] = []
                    table <- check_untyped_shadow_nested(block_statements, no_binders, outer, outer_kinds, here, here_kinds, table)



        # Walk a nested list: everything visible here becomes `outer` for it, and the
        # list's own binders (loop variables, pattern names, a clause's `e`) sit innermost.
        def check_untyped_shadow_nested(body: darray[Ast::Stmt], binders: darray[sview @source]&, outer: darray[sview @source]&, outer_kinds: darray[sview]&, here: darray[sview @source]&, here_kinds: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                nested_outer: mutable darray[sview @source] = [name for name in outer]
                nested_kinds: mutable darray[sview] = [kind for kind in outer_kinds]
                for name in here |nested_outer|:
                    nested_outer.push(name)
                for kind in here_kinds |nested_kinds|:
                    nested_kinds.push(kind)
                for binder in binders |nested_outer, nested_kinds|:
                    nested_outer.push(binder)
                    nested_kinds.push("")
                nested_here: mutable darray[sview @source] = []
                nested_here_kinds: mutable darray[sview] = []
                table <- check_untyped_shadow(body, nested_outer, nested_kinds, nested_here, nested_here_kinds, table)
