extend Semantic:
    private:
        # A by-value `mutable T[N]` parameter is a COPY: writes to it vanish when the
        # function returns. Reject one that the body writes but never observes (no read
        # reaches anything except further writes to itself); code ported from C almost
        # always meant `p: mutable T[N]&` with `&array` at the call. A parameter that is
        # read, returned, passed on, iterated or captured is a legitimate scratch copy.
        # Mirrors stage0's checkLostArrayParamWrites.
        def check_lost_array_param_writes(parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for parameter in parameters |table| -> table:
                    if parameter.name != "" and parameter.name != "_" and is_by_value_mutable_array_param(parameter):
                        usage: mutable ArrayParamUsage = ArrayParamUsage{writes: 0, observed: 0, rebound: false}
                        usage <- array_param_usage_in(body, parameter.name, usage)
                        if not usage.rebound and usage.writes > 0 and usage.observed == 0:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LostArrayParamWrites, name: parameter.name, pos: parameter.name_pos, line: parameter.name_pos.line, expected: "", actual: ""})



        # `p: mutable T[N]` (or the legacy `mutable p: T[N]`) over a fixed-array element type.
        def is_by_value_mutable_array_param(parameter: Ast::ParamDecl) -> bool:
            can Abort.Panic:
                return true if local_declared_type_name(parameter.type_expression) == "mutable_array"
                return false if not parameter.is_mutable
                match parameter.type_expression:
                    Expr.Index(object, argument, index_line):
                        return is_fixed_array_element_name(bare_type_name_through_ref(parameter.type_expression))
                    Expr.IndexN(object_n, arguments, index_line_n):
                        return is_fixed_array_element_name(bare_type_name_through_ref(parameter.type_expression))
                    _:
                        return false
