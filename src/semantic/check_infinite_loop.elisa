extend Semantic:
    private:
        # Check if a statement list contains any Break or Return statement at any nesting depth.
        # Returns true if an exit statement is found (conservative approach: any exit keeps us silent).
        def has_exit_statement(statements: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    match statement:
                        Stmt.Break(label, line):
                            return true
                        Stmt.Return(value, line):
                            return true
                        Stmt.If(condition, then_body, else_body, line):
                            if has_exit_statement(then_body) or has_exit_statement(else_body):
                                return true
                        Stmt.While(condition, body, line):
                            if has_exit_statement(body):
                                return true
                        Stmt.For(bind, variables, iterable, body, line):
                            if has_exit_statement(body):
                                return true
                        Stmt.Block(kind, clause, binding, body, line):
                            if has_exit_statement(body):
                                return true
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                if has_exit_statement(arm.body):
                                    return true
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                return false


        # Check for while true loops that never exit (no break or return in body).
        def check_infinite_loop_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.While(condition, body, line):
                            # Check if this is a while true loop
                            if condition is Expr.BoolLit(value) and value == true:
                                # Check if the body contains any break or return
                                if not has_exit_statement(body):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InfiniteLoopNoExit, name: "", line: line, expected: "", actual: ""})
                            table <- check_infinite_loop_statements(body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_infinite_loop_statements(then_body, table)
                            table <- check_infinite_loop_statements(else_body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_infinite_loop_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_infinite_loop_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- check_infinite_loop_statements(arm.body, table)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.VarDecl(name, type_expression, value, line):
                            pass
                        Stmt.Assign(target, operator, value, line):
                            pass


        # Check for infinite loops in all declarations (recursing through Func/Module/Scoped).
        def check_infinite_loop(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_infinite_loop_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_infinite_loop(body, table)
                        Decl.Scoped(body, line):
                            table <- check_infinite_loop(body, table)
                        _:
                            pass
