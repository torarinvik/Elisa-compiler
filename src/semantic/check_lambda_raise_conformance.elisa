# Inline-lambda raise conformance. A lambda passed as a call argument must not
# raise an error family outside the callee's declared error set. The parameter's
# own set can be narrower, so this conservative check only rejects a family that
# is absent from the callee declaration altogether.
extend Semantic:
    private:
        def lrc_append_scope_path(expression: Ast::Expr, bytes: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Scope(base, name, _):
                        return false if not lrc_append_scope_path(base, bytes)
                        bytes.push(58)
                        bytes.push(58)
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Paren(inner, _):
                        return lrc_append_scope_path(inner, bytes)
                    _:
                        return false


        def lrc_callee_qualifier(callee: Ast::Expr, table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Scope(base, _, _):
                        path_bytes: mutable darray[u8] = []
                        return "" if not lrc_append_scope_path(base, path_bytes)
                        return intern_joined_text(path_bytes, table)
                    Expr.Paren(inner, _):
                        return lrc_callee_qualifier(inner, table)
                    _:
                        return ""


        def lrc_callee_declaration(callee: Ast::Expr, call_pos: Ast::Pos, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source):
            can Memory.Allocate, Abort.Panic:
                callee_name: sview @source = ident_name_of(callee)
                return (false, "", 0, 0, 0, "") if callee_name == ""
                explicit_module: sview @source = lrc_callee_qualifier(callee, table)
                declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32) = catch_error_declaration(annotations, callee_name, caller_module, explicit_module, call_pos.line, call_pos.offset)
                return (declaration.known, declaration.module, declaration.line, declaration.offset, declaration.identity_id, callee_name)


        def lrc_target_has_family(target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source), source_owner: sview, source_path: sview, source_tag: sview, source_module: (known: bool, module: sview @source), annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not target.known
                target_pos: Ast::Pos = Ast::Pos{line: target.line, column: 0, offset: target.offset, end_line: target.line, end_column: 0, end_offset: target.offset}
                return_occurrence_offset: u32 = raise_return_error_occurrence(annotations, target.function_name, target_pos, target.identity_id)
                for family_index in 0..<annotations.count:
                    family: Ast::EnumAnnotation = annotations[family_index]
                    continue if family.owner != "__error_set_family" or family.line != target.line or family.name != source_owner or family.occurrence_offset != return_occurrence_offset
                    continue if family.offset != target.offset
                    continue if target.identity_id != 0 and family.identity_id != target.identity_id
                    family_path: sview = raise_family_path(annotations, family_index, target_pos, target.identity_id, return_occurrence_offset)
                    continue if family_path == ""
                    destination_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, target.line, target.offset, target.identity_id, family.name, family_path, true, target.module, table)
                    family_matches: bool = raise_family_refs_match(source_owner, source_path, source_module.known, source_module.module, family.name, family_path, destination_module.known, destination_module.module)
                    if family_matches:
                        subset: (restricted: bool, allowed: bool, first_allowed: sview) = raise_family_subset_status(annotations, family_index, target_pos, target.identity_id, return_occurrence_offset, family.name, source_tag)
                        return true if not subset.restricted or subset.allowed
                return false


        def lrc_first_target_family(target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source), annotations: darray[Ast::EnumAnnotation]&) -> sview @source:
            can Abort.Panic:
                target_pos: Ast::Pos = Ast::Pos{line: target.line, column: 0, offset: target.offset, end_line: target.line, end_column: 0, end_offset: target.offset}
                return_occurrence_offset: u32 = raise_return_error_occurrence(annotations, target.function_name, target_pos, target.identity_id)
                for family in annotations:
                    if family.owner == "__error_set_family" and family.line == target.line and family.offset == target.offset and family.occurrence_offset == return_occurrence_offset and (target.identity_id == 0 or family.identity_id == target.identity_id):
                        return family.name
                return ""


        def lrc_check_raise(expression: Ast::Expr, line: u32, target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                source: (family: sview, path: sview, tag: sview) = raised_error_source(expression, table)
                return if source.family == "" or source.tag == "" or not target.known
                source_module: (known: bool, module: sview @source) = raise_error_family_module_for_declaration(annotations, caller_pos, caller_identity_id, source.family, source.path, caller_module_known, caller_module, table)
                accepted: bool = lrc_target_has_family(target, source.family, source.path, source.tag, source_module, annotations, table)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LambdaRaiseMismatch, name: source.family, line: line, expected: lrc_first_target_family(target, annotations), actual: source.tag}) if not accepted


        # Inspect expressions inside a lambda using the selected callee declaration's
        # family rows. Nested lambdas have their own expected type and are handled by the
        # ordinary call walker when they are passed as arguments.
        def lrc_check_lambda_expression(expression: Ast::Expr, line: u32, target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lrc_check_raise(expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                match expression:
                    Expr.GetElse(guarded, recovery, _):
                        table <- lrc_check_lambda_statements(recovery, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(guarded, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Call(callee, arguments, _, _):
                        for argument in arguments |table| -> table:
                            table <- lrc_check_lambda_expression(argument, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, _, _):
                        table <- lrc_check_lambda_expression(effect_type, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for candidate in candidates |table| -> table:
                            for capture in candidate.captures |table| -> table:
                                table <- lrc_check_lambda_expression(capture, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_check_lambda_expression(argument, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        table <- lrc_check_lambda_expression(object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        table <- lrc_check_lambda_expression(object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(index, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.IndexN(object, arguments, _):
                        table <- lrc_check_lambda_expression(object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_check_lambda_expression(argument, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Slice(object, low, high, _):
                        table <- lrc_check_lambda_expression(object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(low, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(high, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- lrc_check_lambda_expression(operand, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- lrc_check_lambda_expression(element, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- lrc_check_lambda_expression(entry.key, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_expression(entry.value, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        table <- lrc_check_lambda_expression(type_expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for field in fields |table| -> table:
                            table <- lrc_check_lambda_expression(field.value, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.If(condition, then_expression, else_expression, _):
                        table <- lrc_check_lambda_expression(condition, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(then_expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(else_expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- lrc_check_lambda_expression(scrutinee, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for arm in arms |table| -> table:
                            table <- lrc_check_lambda_expression(arm.guard, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(arm.body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        table <- lrc_check_lambda_expression(iterable, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(condition, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(body, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Refinement(base, predicate, _):
                        table <- lrc_check_lambda_expression(base, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(predicate, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Block(statements, value, _, _):
                        table <- lrc_check_lambda_statements(statements, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(value, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Lambda(_, body, _):
                        table <- lrc_walk_stmts(body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    _:
                        pass


        def lrc_check_lambda_statements(statements: darray[Ast::Stmt], target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, pos):
                            table <- lrc_check_lambda_expression(expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.VarDecl(_, type_expression, value, pos):
                            table <- lrc_check_lambda_expression(type_expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_expression(value, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Assign(target_expression, _, value, pos):
                            table <- lrc_check_lambda_expression(target_expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_expression(value, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, pos):
                            table <- lrc_check_lambda_expression(condition, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(then_body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(else_body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.While(condition, body, pos):
                            table <- lrc_check_lambda_expression(condition, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.For(_, _, iterable, body, pos):
                            table <- lrc_check_lambda_expression(iterable, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Block(_, _, _, body, _):
                            table <- lrc_check_lambda_statements(body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Match(scrutinee, arms, pos):
                            table <- lrc_check_lambda_expression(scrutinee, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            for arm in arms |table| -> table:
                                table <- lrc_check_lambda_expression(arm.guard, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                                table <- lrc_check_lambda_statements(arm.body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Return(value, pos):
                            table <- lrc_check_lambda_expression(returned, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table) if value is returned
                        Stmt.Contract(_, expression, pos):
                            table <- lrc_check_lambda_expression(expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        _:
                            pass


        def lrc_check_lambda_argument(argument: Ast::Expr, target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Lambda(_, body, _):
                        table <- lrc_check_lambda_statements(body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Paren(inner, _):
                        table <- lrc_check_lambda_argument(inner, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    _:
                        pass


        def lrc_walk_expr(expression: Ast::Expr, caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, _, call_pos):
                        target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source) = lrc_callee_declaration(callee, call_pos, caller_module, annotations, table)
                        if target.known:
                            for argument in arguments |table| -> table:
                                table <- lrc_check_lambda_argument(argument, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(callee, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_walk_expr(argument, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                        table <- lrc_walk_expr(effect_type, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for candidate in candidates |table| -> table:
                            for capture in candidate.captures |table| -> table:
                                table <- lrc_walk_expr(capture, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_walk_expr(argument, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        table <- lrc_walk_expr(object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        table <- lrc_walk_expr(object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(index, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.IndexN(object, arguments, _):
                        table <- lrc_walk_expr(object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_walk_expr(argument, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Slice(object, low, high, _):
                        table <- lrc_walk_expr(object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(low, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(high, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- lrc_walk_expr(operand, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- lrc_walk_expr(element, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- lrc_walk_expr(entry.key, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_expr(entry.value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        table <- lrc_walk_expr(type_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for field in fields |table| -> table:
                            table <- lrc_walk_expr(field.value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.If(condition, then_expression, else_expression, _):
                        table <- lrc_walk_expr(condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(then_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(else_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- lrc_walk_expr(scrutinee, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for arm in arms |table| -> table:
                            table <- lrc_walk_expr(arm.guard, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(arm.body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        table <- lrc_walk_expr(iterable, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Refinement(base, predicate, _):
                        table <- lrc_walk_expr(base, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(predicate, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.GetElse(guarded, recovery, _):
                        table <- lrc_walk_expr(guarded, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_stmts(recovery, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Block(statements, value, _, _):
                        table <- lrc_walk_stmts(statements, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Lambda(_, _, _):
                        pass
                    _:
                        pass


        def lrc_walk_stmts(statements: darray[Ast::Stmt], caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, _):
                            table <- lrc_walk_expr(expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.VarDecl(_, type_expression, value, _):
                            table <- lrc_walk_expr(type_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_expr(value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Assign(target, _, value, _):
                            table <- lrc_walk_expr(target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_expr(value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- lrc_walk_expr(condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(then_body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(else_body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.While(condition, body, _):
                            table <- lrc_walk_expr(condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.For(_, _, iterable, body, _):
                            table <- lrc_walk_expr(iterable, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Block(_, _, _, body, _):
                            table <- lrc_walk_stmts(body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Match(scrutinee, arms, _):
                            table <- lrc_walk_expr(scrutinee, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            for arm in arms |table| -> table:
                                table <- lrc_walk_expr(arm.guard, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                                table <- lrc_walk_stmts(arm.body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Return(value, _):
                            table <- lrc_walk_expr(returned, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table) if value is returned
                        Stmt.Contract(_, expression, _):
                            table <- lrc_walk_expr(expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        _:
                            pass


        def lrc_walk_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, _, _, body, _, _, function_pos):
                            function_identity: (identity: u32, occurrence: u32) = raise_function_identity_occurrence(annotations, name, function_pos)
                            identity_id: u32 = function_identity.identity
                            return_occurrence_offset: u32 = function_identity.occurrence
                            function_module: (known: bool, module: sview @source) = raise_function_module(annotations, function_pos, identity_id, return_occurrence_offset)
                            table <- lrc_walk_stmts(body, name, function_pos, identity_id, function_module.known, function_module.module, annotations, table)
                        Decl.Module(_, body, _):
                            table <- lrc_walk_declarations(body, annotations, table)
                        Decl.Scoped(body, _):
                            table <- lrc_walk_declarations(body, annotations, table)
                        _:
                            pass

    public:
        def check_lambda_raise_conformance(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lrc_walk_declarations(file.top_decls, file.enum_annotations, table)
