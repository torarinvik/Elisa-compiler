# Inline-lambda raise conformance. Compare each lambda argument with the error
# set of its corresponding callback parameter, preserving declaration identity.
extend Semantic:
    private:
        def lrc_append_scope_path(expression: Ast::Expr, bytes: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Scope(base, name, _):
                        return false if not lrc_append_scope_path(base, bytes)
                        bytes.push(58)
                        bytes.push(58)
                        for index in 0..<name.len |bytes, name|:
                            bytes.push(name[index])
                        return true
                    Expr.Paren(inner, _):
                        return lrc_append_scope_path(inner, bytes)
                    _:
                        return false


        def lrc_callee_qualifier(callee: Ast::Expr, table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Scope(base, _, _):
                        path_bytes: mutable darray[u8] = []
                        return "" if not lrc_append_scope_path(base, path_bytes)
                        return intern_joined_text(path_bytes, table)
                    Expr.Paren(inner, _):
                        return lrc_callee_qualifier(inner, table)
                    _:
                        return ""


        def lrc_callee_declaration(callee: Ast::Expr, call_pos: Ast::Pos, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32):
            can Memory.Allocate, Abort.Panic:
                callee_name: sview @source = cos_callee_name(callee)
                return (false, "", 0, 0, 0, "", 0) if callee_name == ""
                explicit_module: sview @source = lrc_callee_qualifier(callee, table)
                declaration: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32) = catch_error_declaration(annotations, callee_name, caller_module, explicit_module, call_pos.line, call_pos.offset)
                # Error-return annotations omit infallible overloads. A single
                # error-return row therefore does not establish a unique callable.
                # Leave overloaded names to argument-aware selection.
                if declaration.known:
                    candidate_count: mutable usize = 0
                    row: mutable u32 = symbol_chain_head(table, callee_name)
                    while row != SYMBOL_INDEX_ROW_NONE |row, candidate_count|:
                        symbol: Symbol = table.symbols[row.usize()]
                        candidate_count <- candidate_count + 1 if symbol.kind == SymbolKind.Func and symbol.name == callee_name and symbol.module_owner == declaration.module
                        row <- table.symbol_name_next[row.usize()]
                    return (false, "", 0, 0, 0, "", 0) if candidate_count > 1
                return (declaration.known, declaration.module, declaration.line, declaration.offset, declaration.identity_id, callee_name, 0)


        def lrc_target_has_family(target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32), source_owner: sview, source_path: sview, source_tag: sview, source_module: (known: bool, module: sview @source), annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if not target.known
                target_pos: Ast::Pos = Ast::Pos{line: target.line, column: 0, offset: target.offset, end_line: target.line, end_column: 0, end_offset: target.offset}
                return_occurrence_offset: u32 = target.occurrence_offset
                for family_index in 0..<annotations.count:
                    family: Ast::EnumAnnotation = annotations[family_index]
                    continue if family.owner != "__error_set_family" or family.line != target.line or family.name != source_owner or family.occurrence_offset != return_occurrence_offset
                    continue if family.offset != target.offset
                    continue if target.identity_id != 0 and family.identity_id != target.identity_id
                    family_path: sview = raise_family_path(annotations, family_index, target_pos, target.identity_id, return_occurrence_offset)
                    continue if family_path == ""
                    destination_module: (known: bool, module: sview @source) = catch_error_family_module_for_declaration(annotations, target.line, target.offset, target.identity_id, family.name, family_path, true, target.module, table)
                    family_matches: bool = raise_family_refs_match(source_owner, source_path, source_module.known, source_module.module, family.name, family_path, destination_module.known, destination_module.module)
                    if family_matches:
                        subset: (restricted: bool, allowed: bool, first_allowed: sview) = raise_family_subset_status(annotations, family_index, target_pos, target.identity_id, return_occurrence_offset, family.name, source_tag)
                        return true if not subset.restricted or subset.allowed
                return false


        def lrc_first_target_family(target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32), annotations: darray[Ast::EnumAnnotation]&) -> sview @source:
            can Abort.Panic:
                target_pos: Ast::Pos = Ast::Pos{line: target.line, column: 0, offset: target.offset, end_line: target.line, end_column: 0, end_offset: target.offset}
                return_occurrence_offset: u32 = target.occurrence_offset
                for family in annotations:
                    if family.owner == "__error_set_family" and family.line == target.line and family.offset == target.offset and family.occurrence_offset == return_occurrence_offset and (target.identity_id == 0 or family.identity_id == target.identity_id):
                        return family.name
                return ""


        def lrc_check_raise(expression: Ast::Expr, line: u32, target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                source: (family: sview, path: sview, tag: sview) = raised_error_source(expression, table)
                return if source.family == "" or source.tag == "" or not target.known
                if target.occurrence_offset == 0:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RaiseWithoutErrorSet, name: "", line: line, expected: "", actual: ""})
                    return
                source_module: (known: bool, module: sview @source) = raise_error_family_module_for_declaration(annotations, caller_pos, caller_identity_id, source.family, source.path, caller_module_known, caller_module, table)
                accepted: bool = lrc_target_has_family(target, source.family, source.path, source.tag, source_module, annotations, table)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LambdaRaiseMismatch, name: source.family, line: line, expected: lrc_first_target_family(target, annotations), actual: source.tag}) if not accepted


        # Inspect expressions inside a lambda using the selected callee declaration's
        # family rows. Nested lambdas have their own expected type and are handled by the
        # ordinary call walker when they are passed as arguments.
        def lrc_check_lambda_expression(file: Ast::File&, expression: Ast::Expr, line: u32, target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- lrc_check_raise(expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                match expression:
                    Expr.GetElse(guarded, recovery, _):
                        table <- lrc_check_lambda_statements(file, recovery, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, guarded, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Call(callee, arguments, _, _):
                        for argument in arguments |table| -> table:
                            table <- lrc_check_lambda_expression(file, argument, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, _, _):
                        table <- lrc_check_lambda_expression(file, effect_type, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for candidate in candidates |table| -> table:
                            for capture in candidate.captures |table| -> table:
                                table <- lrc_check_lambda_expression(file, capture, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_check_lambda_expression(file, argument, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        table <- lrc_check_lambda_expression(file, object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        table <- lrc_check_lambda_expression(file, object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, index, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.IndexN(object, arguments, _):
                        table <- lrc_check_lambda_expression(file, object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_check_lambda_expression(file, argument, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Slice(object, low, high, _):
                        table <- lrc_check_lambda_expression(file, object, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, low, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, high, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- lrc_check_lambda_expression(file, operand, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- lrc_check_lambda_expression(file, element, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- lrc_check_lambda_expression(file, entry.key, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_expression(file, entry.value, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        table <- lrc_check_lambda_expression(file, type_expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for field in fields |table| -> table:
                            table <- lrc_check_lambda_expression(file, field.value, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.If(condition, then_expression, else_expression, _):
                        table <- lrc_check_lambda_expression(file, condition, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, then_expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, else_expression, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- lrc_check_lambda_expression(file, scrutinee, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for arm in arms |table| -> table:
                            table <- lrc_check_lambda_expression(file, arm.guard, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(file, arm.body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        table <- lrc_check_lambda_expression(file, iterable, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, condition, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, body, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Refinement(base, predicate, _):
                        table <- lrc_check_lambda_expression(file, base, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, predicate, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Block(statements, value, _, _):
                        table <- lrc_check_lambda_statements(file, statements, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_check_lambda_expression(file, value, line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Lambda(_, body, _):
                        table <- lrc_walk_stmts(file, body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    _:
                        pass


        def lrc_check_lambda_statements(file: Ast::File&, statements: darray[Ast::Stmt], target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, pos):
                            table <- lrc_check_lambda_expression(file, expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.VarDecl(_, type_expression, value, pos):
                            table <- lrc_check_lambda_expression(file, type_expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_expression(file, value, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Assign(target_expression, _, value, pos):
                            table <- lrc_check_lambda_expression(file, target_expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_expression(file, value, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, pos):
                            table <- lrc_check_lambda_expression(file, condition, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(file, then_body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(file, else_body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.While(condition, body, pos):
                            table <- lrc_check_lambda_expression(file, condition, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(file, body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.For(_, _, iterable, body, pos):
                            table <- lrc_check_lambda_expression(file, iterable, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_check_lambda_statements(file, body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Block(_, _, _, body, _):
                            table <- lrc_check_lambda_statements(file, body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Match(scrutinee, arms, pos):
                            table <- lrc_check_lambda_expression(file, scrutinee, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            for arm in arms |table| -> table:
                                table <- lrc_check_lambda_expression(file, arm.guard, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                                table <- lrc_check_lambda_statements(file, arm.body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Return(value, pos):
                            table <- lrc_check_lambda_expression(file, returned, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table) if value is returned
                        Stmt.Contract(_, expression, pos):
                            table <- lrc_check_lambda_expression(file, expression, pos.line, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        _:
                            pass


        def lrc_check_lambda_argument(file: Ast::File&, argument: Ast::Expr, target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32), caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Lambda(_, body, _):
                        table <- lrc_check_lambda_statements(file, body, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Paren(inner, _):
                        table <- lrc_check_lambda_argument(file, inner, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    _:
                        pass


        # Mirrors the shapes lrc_check_lambda_argument acts on.
        def lrc_argument_is_lambda(argument: Ast::Expr) -> bool:
            can Abort.Panic:
                match argument:
                    Expr.Lambda(_, _, _):
                        return true
                    Expr.Paren(inner, _):
                        return lrc_argument_is_lambda(inner)
                    _:
                        return false

        def lrc_walk_expr(file: Ast::File&, expression: Ast::Expr, caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        # The callee's declaration only matters for lambda arguments, and
                        # resolving it scans the annotation table, so skip calls without one.
                        if any argument in arguments where lrc_argument_is_lambda(argument):
                            target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32) = lrc_callee_declaration(callee, call_pos, caller_module, annotations, table)
                            if target.known:
                                for argument_index in 0..<arguments.count |table| -> table:
                                    continue if not lrc_argument_is_lambda(arguments[argument_index])
                                    argument_target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source, occurrence_offset: u32) = lrc_argument_target(file, target, argument_index, argument_names, annotations, table)
                                    table <- lrc_check_lambda_argument(file, arguments[argument_index], argument_target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table) if argument_target.known
                        table <- lrc_walk_expr(file, callee, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_walk_expr(file, argument, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                        table <- lrc_walk_expr(file, effect_type, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for candidate in candidates |table| -> table:
                            for capture in candidate.captures |table| -> table:
                                table <- lrc_walk_expr(file, capture, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_walk_expr(file, argument, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        table <- lrc_walk_expr(file, object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        table <- lrc_walk_expr(file, object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, index, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.IndexN(object, arguments, _):
                        table <- lrc_walk_expr(file, object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- lrc_walk_expr(file, argument, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Slice(object, low, high, _):
                        table <- lrc_walk_expr(file, object, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, low, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, high, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.RegionNew(operand, _, _) | Expr.Paren(operand, _):
                        table <- lrc_walk_expr(file, operand, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- lrc_walk_expr(file, element, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- lrc_walk_expr(file, entry.key, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_expr(file, entry.value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Construct(type_expression, fields, _) | Expr.RecordUpdate(type_expression, fields, _):
                        table <- lrc_walk_expr(file, type_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for field in fields |table| -> table:
                            table <- lrc_walk_expr(file, field.value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.If(condition, then_expression, else_expression, _):
                        table <- lrc_walk_expr(file, condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, then_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, else_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- lrc_walk_expr(file, scrutinee, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        for arm in arms |table| -> table:
                            table <- lrc_walk_expr(file, arm.guard, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(file, arm.body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Comprehension(_, iterable, condition, body, _, _):
                        table <- lrc_walk_expr(file, iterable, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Refinement(base, predicate, _):
                        table <- lrc_walk_expr(file, base, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, predicate, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.GetElse(guarded, recovery, _):
                        table <- lrc_walk_expr(file, guarded, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_stmts(file, recovery, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Block(statements, value, _, _):
                        table <- lrc_walk_stmts(file, statements, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        table <- lrc_walk_expr(file, value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                    Expr.Lambda(_, _, _):
                        pass
                    _:
                        pass


        def lrc_walk_stmts(file: Ast::File&, statements: darray[Ast::Stmt], caller_name: sview, caller_pos: Ast::Pos, caller_identity_id: u32, caller_module_known: bool, caller_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, _):
                            table <- lrc_walk_expr(file, expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.VarDecl(_, type_expression, value, _):
                            table <- lrc_walk_expr(file, type_expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_expr(file, value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Assign(target, _, value, _):
                            table <- lrc_walk_expr(file, target, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_expr(file, value, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- lrc_walk_expr(file, condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(file, then_body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(file, else_body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.While(condition, body, _):
                            table <- lrc_walk_expr(file, condition, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(file, body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.For(_, _, iterable, body, _):
                            table <- lrc_walk_expr(file, iterable, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            table <- lrc_walk_stmts(file, body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Block(_, _, _, body, _):
                            table <- lrc_walk_stmts(file, body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Match(scrutinee, arms, _):
                            table <- lrc_walk_expr(file, scrutinee, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                            for arm in arms |table| -> table:
                                table <- lrc_walk_expr(file, arm.guard, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                                table <- lrc_walk_stmts(file, arm.body, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        Stmt.Return(value, _):
                            table <- lrc_walk_expr(file, returned, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table) if value is returned
                        Stmt.Contract(_, expression, _):
                            table <- lrc_walk_expr(file, expression, caller_name, caller_pos, caller_identity_id, caller_module_known, caller_module, annotations, table)
                        _:
                            pass


        def lrc_walk_declarations(file: Ast::File&, declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, metadata: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, _, _, body, _, _, function_pos):
                            function_identity: (identity: u32, occurrence: u32) = raise_function_identity_occurrence(metadata, name, function_pos)
                            identity_id: u32 = function_identity.identity
                            return_occurrence_offset: u32 = function_identity.occurrence
                            function_module: (known: bool, module: sview @source) = raise_function_module(metadata, function_pos, identity_id, return_occurrence_offset)
                            table <- lrc_walk_stmts(file, body, name, function_pos, identity_id, function_module.known, function_module.module, annotations, table)
                        Decl.Module(_, body, _):
                            table <- lrc_walk_declarations(file, body, annotations, metadata, table)
                        Decl.Scoped(body, _):
                            table <- lrc_walk_declarations(file, body, annotations, metadata, table)
                        _:
                            pass

    public:
        def check_lambda_raise_conformance(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Only these marker kinds participate in the two per-function
                # metadata lookups. Keep source order and retain the complete
                # annotation table for the actual error-family checks below.
                metadata: mutable darray[Ast::EnumAnnotation] = []
                for annotation in file.enum_annotations |metadata|:
                    metadata.push(annotation) if annotation.name == "__error_return" or annotation.owner == "__fn_module"
                table <- lrc_walk_declarations(file, file.top_decls, file.enum_annotations, metadata, table)
