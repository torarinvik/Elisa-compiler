# Check for duplicate dict literal keys — detects when a dict literal has two entries
# with the same literal key (IntLit, StringLit, or CharLit). Non-literal keys are ignored.

extend Semantic:
    private:
        # Check a single dict literal for duplicate literal keys.
        # Collect literal keys and flag the later occurrence.
        def check_duplicate_dict_key_dict_lit(entries: darray[Ast::DictEntry], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Collect (key_text, key_kind) pairs to detect duplicates
                # key_kind: 0 = intlit, 1 = stringlit, 2 = charlit
                seen_int: mutable darray[i64] = []
                seen_string: mutable darray[sview] = []
                seen_char: mutable darray[sview] = []

                for entry in entries |table, seen_int, seen_string, seen_char|:
                    match entry.key:
                        Expr.IntLit(value):
                            # Check if this int value was already seen
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateDictKey, name: "", line: line, expected: "", actual: ""}) if any previous_value in seen_int where previous_value == value
                            seen_int.push(value) if not (any previous_value in seen_int where previous_value == value)
                        Expr.StringLit(text):
                            # Check if this string literal text was already seen
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateDictKey, name: text, line: line, expected: "", actual: ""}) if any previous_text in seen_string where previous_text == text
                            seen_string.push(text) if not (any previous_text in seen_string where previous_text == text)
                        Expr.CharLit(text):
                            # Check if this char literal text was already seen
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateDictKey, name: text, line: line, expected: "", actual: ""}) if any previous_text in seen_char where previous_text == text
                            seen_char.push(text) if not (any previous_text in seen_char where previous_text == text)
                        _:
                            # Non-literal keys (Ident, Call, etc.) are ignored
                            pass


        # Walk through all expressions, checking for duplicate literal dict keys.
        def walk_expression_for_duplicate_dict_key(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.DictLit(entries, line):
                        # Check this dict literal for duplicate keys
                        table <- check_duplicate_dict_key_dict_lit(entries, line, table)
                        # Also walk the key/value expressions for nested dicts
                        for entry in entries |table| -> table:
                            table <- walk_expression_for_duplicate_dict_key(entry.key, table)
                            table <- walk_expression_for_duplicate_dict_key(entry.value, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_duplicate_dict_key(callee, table)
                        for argument in arguments |table| -> table:
                            table <- walk_expression_for_duplicate_dict_key(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_duplicate_dict_key(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_duplicate_dict_key(base, table)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_duplicate_dict_key(object, table)
                        table <- walk_expression_for_duplicate_dict_key(index, table) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_duplicate_dict_key(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_duplicate_dict_key(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_duplicate_dict_key(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_duplicate_dict_key(element, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_duplicate_dict_key(object, table)
                        table <- walk_expression_for_duplicate_dict_key(low, table)
                        table <- walk_expression_for_duplicate_dict_key(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_duplicate_dict_key(object, table)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table| -> table:
                                table <- walk_expression_for_duplicate_dict_key(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_duplicate_dict_key(left, table)
                        table <- walk_expression_for_duplicate_dict_key(right, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- walk_expression_for_duplicate_dict_key(element, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_duplicate_dict_key(type_expression, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_duplicate_dict_key(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_duplicate_dict_key(base, table)
                        for field in fields |table| -> table:
                            table <- walk_expression_for_duplicate_dict_key(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_duplicate_dict_key(condition, table)
                        table <- walk_expression_for_duplicate_dict_key(then_expr, table)
                        table <- walk_expression_for_duplicate_dict_key(else_expr, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_duplicate_dict_key(iterable, table)
                        table <- walk_expression_for_duplicate_dict_key(condition, table)
                        table <- walk_expression_for_duplicate_dict_key(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_duplicate_dict_key(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_duplicate_dict_key(statements, table)
                        table <- walk_expression_for_duplicate_dict_key(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_duplicate_dict_key(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- walk_statements_for_duplicate_dict_key(arm.body, table)
                    # Literals and other expression forms don't contain sub-expressions
                    _:
                        pass


        # Walk through statements, checking for duplicate dict keys in expressions.
        def walk_statements_for_duplicate_dict_key(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_duplicate_dict_key(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_expression_for_duplicate_dict_key(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_duplicate_dict_key(target, table)
                            table <- walk_expression_for_duplicate_dict_key(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_duplicate_dict_key(condition, table)
                            table <- walk_statements_for_duplicate_dict_key(then_body, table)
                            table <- walk_statements_for_duplicate_dict_key(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_duplicate_dict_key(condition, table)
                            table <- walk_statements_for_duplicate_dict_key(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_duplicate_dict_key(iterable, table)
                            table <- walk_statements_for_duplicate_dict_key(body, table)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_duplicate_dict_key(return_value, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_duplicate_dict_key(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_duplicate_dict_key(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_statements_for_duplicate_dict_key(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_duplicate_dict_key(expression, table)
                        # No expressions in these statements
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass
                        Stmt.Invalid:
                            pass


    public:
        # Entry point: check all function bodies for duplicate dict literal keys.
        def check_duplicate_dict_key(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_statements_for_duplicate_dict_key(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_duplicate_dict_key(body, table)
                        Decl.Scoped(body, line):
                            table <- check_duplicate_dict_key(body, table)
                        # Other declarations don't have bodies to check
                        _:
                            pass
