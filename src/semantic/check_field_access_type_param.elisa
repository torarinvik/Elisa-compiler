# Field/method access on a value whose type is an UNBOUNDED generic type parameter has no
# struct to resolve against: stage0 errors "field access requires struct type, got T"
# (`def f[T](a: T) -> T: return a.lt(a)` — `T` has no `lt`, and no free `lt` rescues it via
# UFCS). Reuses DiagnosticKind.FieldAccessOnPrimitive, whose message is exactly that text.
#
# SOUND subset (never over-fires vs stage0):
#  * the function has ≥1 generic param AND ZERO bound rows (every param is unbounded — a bound
#    `[T: Ord]` could legitimately supply methods, so any bound at all disables the whole fn);
#  * the receiver is a bare Ident naming a PARAMETER whose declared type is exactly one of those
#    type-param names, and is NOT shadowed by a same-named local;
#  * the accessed member is not `cast` (cast syntax, not a field) and is NOT the name of any
#    top-level function (which would resolve the call via UFCS).
# Any of these failing is a conservative MISS, never a false fire.
extend Semantic:
    private:
        # Names of every top-level (module/scoped-nested) function — the UFCS candidate set.
        def fatp_collect_function_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            out.push(name)
                        Decl.Module(module_name, module_body, module_line):
                            fatp_collect_function_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            fatp_collect_function_names(scoped_body, out)
                        _:
                            pass

        # The unbounded type-param names of the function declared at `line`: names recorded at
        # exactly `line`. Returns empty if the function has ANY bound row (line + 2^31), so a
        # partially-bounded generic function is skipped wholesale (sound).
        def fatp_unbounded_type_params(names: darray[sview]&, lines: darray[u32]&, line: u32, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                bound_marker: u32 = line + 2147483648
                has_bound: bool = any bl in lines where bl == bound_marker
                return if has_bound
                index: mutable usize = 0
                while index < lines.count |index, line, names, lines, out|:
                    out.push(names[index]) if lines[index] == line
                    index <- index + 1

        # Whether `name` is one of `type_params`.
        def fatp_is_type_param(type_params: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any tp in type_params where tp == name

        def fatp_close_scope(shadowed: mutable darray[sview]&, mark: usize) -> void:
            can Abort.Panic:
                shadowed.truncate(mark)

        def fatp_note_binders(names: darray[sview]&, shadowed: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for name in names |shadowed|:
                    shadowed.push(name)

        # `is` binders are lexical shadows only in the flow scope established by the
        # condition, never for the whole function. Share Stage0's condition-binder walk.
        def fatp_note_condition_binders(condition: Ast::Expr, shadowed: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                flow_collect_is_binds(condition, names)
                fatp_note_binders(names, shadowed)

        def fatp_walk_expr(expression: Ast::Expr, tp_param_names: darray[sview]&, tp_param_types: darray[sview]&, shadowed: mutable darray[sview]&, func_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(recv, method, field_line):
                                table <- fatp_fire_if_type_param(recv, method, field_line.line, tp_param_names, tp_param_types, shadowed, func_names, table)
                                table <- fatp_walk_expr(recv, tp_param_names, tp_param_types, shadowed, func_names, table)
                            _:
                                table <- fatp_walk_expr(callee, tp_param_names, tp_param_types, shadowed, func_names, table)
                        for argument in arguments |table, shadowed| -> table:
                            table <- fatp_walk_expr(argument, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, call_line):
                        table <- fatp_walk_expr(effect_type, tp_param_names, tp_param_types, shadowed, func_names, table)
                        for candidate in candidates |table, shadowed| -> table:
                            table <- fatp_walk_expr(candidate.effect_type, tp_param_names, tp_param_types, shadowed, func_names, table)
                            for capture in candidate.captures |table, shadowed| -> table:
                                table <- fatp_walk_expr(capture, tp_param_names, tp_param_types, shadowed, func_names, table)
                        for argument in arguments |table, shadowed| -> table:
                            table <- fatp_walk_expr(argument, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Field(object, field, field_line):
                        table <- fatp_fire_if_type_param(object, field, field_line.line, tp_param_names, tp_param_types, shadowed, func_names, table)
                        table <- fatp_walk_expr(object, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Scope(base, _, _):
                        table <- fatp_walk_expr(base, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Index(object, index, _):
                        table <- fatp_walk_expr(object, tp_param_names, tp_param_types, shadowed, func_names, table)
                        table <- fatp_walk_expr(index, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Slice(object, low, high, _):
                        table <- fatp_walk_expr(object, tp_param_names, tp_param_types, shadowed, func_names, table)
                        table <- fatp_walk_expr(low, tp_param_names, tp_param_types, shadowed, func_names, table)
                        table <- fatp_walk_expr(high, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.IndexN(object, arguments, _):
                        table <- fatp_walk_expr(object, tp_param_names, tp_param_types, shadowed, func_names, table)
                        for argument in arguments |table, shadowed| -> table:
                            table <- fatp_walk_expr(argument, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- fatp_walk_expr(left, tp_param_names, tp_param_types, shadowed, func_names, table)
                        if operator == TokenKind.And:
                            and_mark: usize = shadowed.count
                            fatp_note_condition_binders(left, shadowed)
                            table <- fatp_walk_expr(right, tp_param_names, tp_param_types, shadowed, func_names, table)
                            fatp_close_scope(shadowed, and_mark)
                        elif operator != TokenKind.Is and operator != TokenKind.As:
                            table <- fatp_walk_expr(right, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- fatp_walk_expr(operand, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Move(operand, _):
                        table <- fatp_walk_expr(operand, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.RegionNew(operand, _, _):
                        table <- fatp_walk_expr(operand, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- fatp_walk_expr(inner, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table, shadowed| -> table:
                            table <- fatp_walk_expr(element, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table, shadowed| -> table:
                            table <- fatp_walk_expr(entry.key, tp_param_names, tp_param_types, shadowed, func_names, table)
                            table <- fatp_walk_expr(entry.value, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Construct(type_expression, fields, _):
                        table <- fatp_walk_expr(type_expression, tp_param_names, tp_param_types, shadowed, func_names, table)
                        for field in fields |table, shadowed| -> table:
                            table <- fatp_walk_expr(field.value, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.RecordUpdate(base, fields, _):
                        table <- fatp_walk_expr(base, tp_param_names, tp_param_types, shadowed, func_names, table)
                        for field in fields |table, shadowed| -> table:
                            table <- fatp_walk_expr(field.value, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.If(condition, then_expr, else_expr, if_line):
                        table <- fatp_walk_expr(condition, tp_param_names, tp_param_types, shadowed, func_names, table)
                        if_mark: usize = shadowed.count
                        fatp_note_condition_binders(condition, shadowed)
                        table <- fatp_walk_expr(then_expr, tp_param_names, tp_param_types, shadowed, func_names, table)
                        fatp_close_scope(shadowed, if_mark)
                        table <- fatp_walk_expr(else_expr, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, comp_line):
                        table <- fatp_walk_expr(iterable, tp_param_names, tp_param_types, shadowed, func_names, table)
                        comp_mark: usize = shadowed.count
                        shadowed.push(loop_variable) if loop_variable != ""
                        table <- fatp_walk_expr(condition, tp_param_names, tp_param_types, shadowed, func_names, table)
                        fatp_note_condition_binders(condition, shadowed)
                        table <- fatp_walk_expr(body, tp_param_names, tp_param_types, shadowed, func_names, table)
                        fatp_close_scope(shadowed, comp_mark)
                    Expr.Lambda(parameters, body, lambda_line):
                        lambda_mark: usize = shadowed.count
                        for parameter in parameters |shadowed|:
                            shadowed.push(parameter)
                        table <- fatp_walk_stmts(body, tp_param_names, tp_param_types, shadowed, func_names, table)
                        fatp_close_scope(shadowed, lambda_mark)
                    Expr.Block(statements, value, captures, block_line):
                        block_mark: usize = shadowed.count
                        table <- fatp_walk_stmts(statements, tp_param_names, tp_param_types, shadowed, func_names, table)
                        table <- fatp_walk_expr(value, tp_param_names, tp_param_types, shadowed, func_names, table)
                        fatp_close_scope(shadowed, block_mark)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- fatp_walk_expr(scrutinee, tp_param_names, tp_param_types, shadowed, func_names, table)
                        for arm in arms |table, shadowed| -> table:
                            arm_mark: usize = shadowed.count
                            names: mutable darray[sview] = []
                            gather_pattern_names(arm.pattern, names)
                            fatp_note_binders(names, shadowed)
                            table <- fatp_walk_expr(arm.guard, tp_param_names, tp_param_types, shadowed, func_names, table)
                            table <- fatp_walk_stmts(arm.body, tp_param_names, tp_param_types, shadowed, func_names, table)
                            fatp_close_scope(shadowed, arm_mark)
                    Expr.Refinement(base, predicate, _):
                        table <- fatp_walk_expr(base, tp_param_names, tp_param_types, shadowed, func_names, table)
                        table <- fatp_walk_expr(predicate, tp_param_names, tp_param_types, shadowed, func_names, table)
                    Expr.GetElse(guarded, recovery, _):
                        table <- fatp_walk_expr(guarded, tp_param_names, tp_param_types, shadowed, func_names, table)
                        recovery_mark: usize = shadowed.count
                        table <- fatp_walk_stmts(recovery, tp_param_names, tp_param_types, shadowed, func_names, table)
                        fatp_close_scope(shadowed, recovery_mark)
                    _:
                        pass

        # Fire when `recv` is a bare Ident naming a type-param-typed, non-shadowed param and
        # `member` is neither `cast` nor a top-level function name (UFCS).
        def fatp_fire_if_type_param(recv: Ast::Expr, member: sview, line: u32, tp_param_names: darray[sview]&, tp_param_types: darray[sview]&, shadowed: darray[sview]&, func_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                recv_name: sview = ident_name_of(recv)
                # `cast` is cast syntax; a primitive-type-name member (`value.u64()`, `.usize()`)
                # is a builtin numeric/enum CONVERSION valid on a type param (resolved at
                # monomorphization) — stage0 accepts both, so neither is a struct field access.
                return if recv_name == "" or member == "cast" or is_primitive_type_name(member)
                slot: mutable i64 = -1
                probe: mutable usize = 0
                while probe < tp_param_names.count |slot, probe, recv_name, tp_param_names|:
                    slot <- probe.i64() if tp_param_names[probe] == recv_name and slot < 0
                    probe <- probe + 1
                return if slot < 0
                return if any s in shadowed where s == recv_name
                return if any fn in func_names where fn == member
                type_param: sview = tp_param_types[slot.usize()]
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FieldAccessOnPrimitive, name: "", line: line, expected: "", actual: type_param})

        def fatp_walk_stmts(statements: darray[Ast::Stmt], tp_param_names: darray[sview]&, tp_param_types: darray[sview]&, shadowed: mutable darray[sview]&, func_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, shadowed| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- fatp_walk_expr(expression, tp_param_names, tp_param_types, shadowed, func_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- fatp_walk_expr(value, tp_param_names, tp_param_types, shadowed, func_names, table)
                            shadowed.push(name)
                        Stmt.Assign(target, operator, value, line):
                            table <- fatp_walk_expr(target, tp_param_names, tp_param_types, shadowed, func_names, table)
                            table <- fatp_walk_expr(value, tp_param_names, tp_param_types, shadowed, func_names, table)
                            if operator == TokenKind.Assign and target is Expr.Ident(declared_name, declared_pos):
                                shadowed.push(declared_name)
                        Stmt.Return(value, line):
                            table <- fatp_walk_expr(returned, tp_param_names, tp_param_types, shadowed, func_names, table) if value is returned
                        Stmt.Contract(kind, expression, line):
                            table <- fatp_walk_expr(expression, tp_param_names, tp_param_types, shadowed, func_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- fatp_walk_expr(condition, tp_param_names, tp_param_types, shadowed, func_names, table)
                            then_mark: usize = shadowed.count
                            fatp_note_condition_binders(condition, shadowed)
                            table <- fatp_walk_stmts(then_body, tp_param_names, tp_param_types, shadowed, func_names, table)
                            fatp_close_scope(shadowed, then_mark)
                            else_mark: usize = shadowed.count
                            table <- fatp_walk_stmts(else_body, tp_param_names, tp_param_types, shadowed, func_names, table)
                            fatp_close_scope(shadowed, else_mark)
                        Stmt.While(condition, while_body, line):
                            table <- fatp_walk_expr(condition, tp_param_names, tp_param_types, shadowed, func_names, table)
                            while_mark: usize = shadowed.count
                            fatp_note_condition_binders(condition, shadowed)
                            table <- fatp_walk_stmts(while_body, tp_param_names, tp_param_types, shadowed, func_names, table)
                            fatp_close_scope(shadowed, while_mark)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- fatp_walk_expr(iterable, tp_param_names, tp_param_types, shadowed, func_names, table)
                            for_mark: usize = shadowed.count
                            for variable in variables |shadowed|:
                                shadowed.push(variable)
                            table <- fatp_walk_stmts(for_body, tp_param_names, tp_param_types, shadowed, func_names, table)
                            fatp_close_scope(shadowed, for_mark)
                        Stmt.Block(kind, clause, binding, block_body, line):
                            if kind == "let" or kind == "move" or kind == "expect":
                                table <- fatp_walk_stmts(block_body, tp_param_names, tp_param_types, shadowed, func_names, table)
                            else:
                                block_mark: usize = shadowed.count
                                shadowed.push(binding) if binding != ""
                                table <- fatp_walk_stmts(block_body, tp_param_names, tp_param_types, shadowed, func_names, table)
                                fatp_close_scope(shadowed, block_mark)
                        Stmt.Match(scrutinee, arms, line):
                            table <- fatp_walk_expr(scrutinee, tp_param_names, tp_param_types, shadowed, func_names, table)
                            for arm in arms |table, shadowed| -> table:
                                arm_mark: usize = shadowed.count
                                names: mutable darray[sview] = []
                                gather_pattern_names(arm.pattern, names)
                                fatp_note_binders(names, shadowed)
                                table <- fatp_walk_expr(arm.guard, tp_param_names, tp_param_types, shadowed, func_names, table)
                                table <- fatp_walk_stmts(arm.body, tp_param_names, tp_param_types, shadowed, func_names, table)
                                fatp_close_scope(shadowed, arm_mark)
                        _:
                            pass

        def fatp_walk_decls(declarations: darray[Ast::Decl], gp_names: darray[sview]&, gp_lines: darray[u32]&, func_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            type_params: mutable darray[sview] = []
                            fatp_unbounded_type_params(gp_names, gp_lines, line.line, type_params)
                            if type_params.count > 0:
                                # Params whose declared type is a type-param name, either by
                                # value or through a reference. An unbounded `T&` has no more
                                # statically known fields than `T`; Stage0 rejects both. Keep
                                # the same lexical-shadow tracking below so a local that
                                # shadows this parameter still receives its own inferred type.
                                tp_param_names: mutable darray[sview] = []
                                tp_param_types: mutable darray[sview] = []
                                for parameter in parameters |tp_param_names, tp_param_types, type_params|:
                                    param_type: sview = bare_type_name_through_ref(parameter.type_expression)
                                    if fatp_is_type_param(type_params, param_type):
                                        tp_param_names.push(parameter.name)
                                        tp_param_types.push(param_type)
                                if tp_param_names.count > 0:
                                    # Track only bindings active at each use; a local in a nested
                                    # branch must not suppress diagnostics for the outer param.
                                    shadowed: mutable darray[sview] = []
                                    table <- fatp_walk_stmts(body, tp_param_names, tp_param_types, shadowed, func_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- fatp_walk_decls(module_body, gp_names, gp_lines, func_names, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fatp_walk_decls(scoped_body, gp_names, gp_lines, func_names, table)
                        _:
                            pass

        def check_field_access_type_param(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                func_names: mutable darray[sview] = []
                fatp_collect_function_names(file.top_decls, func_names)
                table <- fatp_walk_decls(file.top_decls, file.generic_param_names, file.generic_param_lines, func_names, table)
