# The checkers' view of a file: statement-position captured loops made visible.
#
# A loop with a `|...|` header parses (wrap_loop_header) as
# `Stmt.Expr(Expr.Block([header decls.., While/For], yield, captures))`. Most checkers walk
# statements through Stmt.While/For/Block/If/Match and treat Stmt.Expr as a plain expression,
# so every statement inside a captured loop was invisible to them: `for x in xs |xs|:
# xs.push(x)` passed silently while the header-less loop was rejected. Rather than teach ~370
# walkers the Expr.Block shape one by one, the checkers read a copy of the file in which each
# such statement is a `Stmt.Block("loop", captures, "", statements)`, which every walker
# already descends. Positions are kept, so line-keyed side tables still match.
#
# Only the statement form (no yield value) is rewritten; a value-position block keeps its
# shape. Resolvers, collectors and the checkers that inspect the Expr.Block shape itself
# (discarded loop value, value-block jumps) keep reading the original file.
extend Semantic:
    private:
        def loop_view_statements(statements: darray[Ast::Stmt]) -> darray[Ast::Stmt]:
            can Memory.Allocate, Abort.Panic:
                rewritten: mutable darray[Ast::Stmt] = []
                for statement in statements |rewritten|:
                    rewritten.push(loop_view_statement(statement))
                return rewritten

        def loop_view_statement(statement: Ast::Stmt) -> Ast::Stmt:
            can Memory.Allocate, Abort.Panic:
                match statement:
                    Stmt.Expr(expression, position):
                        match expression:
                            Expr.Block(block_statements, block_value, block_captures, block_position):
                                if block_value is Ast::Expr.Invalid:
                                    return (Ast::Stmt.Block("loop", block_captures, "", loop_view_statements(block_statements), position))
                            _:
                                pass
                        return statement
                    Stmt.Block(kind, clause, binding, body, position):
                        return (Ast::Stmt.Block(kind, clause, binding, loop_view_statements(body), position))
                    Stmt.If(condition, then_body, else_body, position):
                        return (Ast::Stmt.If(condition, loop_view_statements(then_body), loop_view_statements(else_body), position))
                    Stmt.While(condition, body, position):
                        return (Ast::Stmt.While(condition, loop_view_statements(body), position))
                    Stmt.For(binding, variables, iterable, body, position):
                        return (Ast::Stmt.For(binding, variables, iterable, loop_view_statements(body), position))
                    Stmt.Match(scrutinee, arms, position):
                        view_arms: mutable darray[Ast::MatchArm] = []
                        for arm in arms |view_arms|:
                            view_arms.push(Ast::MatchArm{pattern: arm.pattern, body: loop_view_statements(arm.body), guard: arm.guard, pos: arm.pos})
                        return (Ast::Stmt.Match(scrutinee, view_arms, position))
                    _:
                        return statement

        def loop_view_declarations(declarations: darray[Ast::Decl]) -> darray[Ast::Decl]:
            can Memory.Allocate, Abort.Panic:
                rewritten: mutable darray[Ast::Decl] = []
                for declaration in declarations |rewritten|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, position):
                            rewritten.push(Ast::Decl.Func(name, params, return_type, loop_view_statements(body), effects, decorators, position))
                        Decl.Module(module_name, module_body, module_position):
                            rewritten.push(Ast::Decl.Module(module_name, loop_view_declarations(module_body), module_position))
                        Decl.Scoped(scoped_body, scoped_position):
                            rewritten.push(Ast::Decl.Scoped(loop_view_declarations(scoped_body), scoped_position))
                        _:
                            rewritten.push(declaration)
                return rewritten

    public:
        def semantic_loop_view(file: Ast::File&) -> Ast::File:
            can Memory.Allocate, Abort.Panic:
                return Ast::File{
                    top_decls: loop_view_declarations(file.top_decls),
                    effect_type_references: file.effect_type_references,
                    pymodule_type_name_bytes: file.pymodule_type_name_bytes,
                    pymodule_type_name_starts: file.pymodule_type_name_starts,
                    pymodule_type_name_lengths: file.pymodule_type_name_lengths,
                    protocol_default_methods: file.protocol_default_methods,
                    errors: file.errors,
                    error_set_func_lines: file.error_set_func_lines,
                    or_arm_binding_lines: file.or_arm_binding_lines,
                    or_arm_binding_columns: file.or_arm_binding_columns,
                    or_arm_binding_end_columns: file.or_arm_binding_end_columns,
                    wildcard_arm_lines: file.wildcard_arm_lines,
                    wildcard_arm_columns: file.wildcard_arm_columns,
                    wildcard_arm_end_columns: file.wildcard_arm_end_columns,
                    error_set_func_names: file.error_set_func_names,
                    error_set_decl_names: file.error_set_decl_names,
                    signature_contract_lines: file.signature_contract_lines,
                    signature_contract_kinds: file.signature_contract_kinds,
                    signature_contract_exprs: file.signature_contract_exprs,
                    numeric_suffix_names: file.numeric_suffix_names,
                    numeric_suffix_lines: file.numeric_suffix_lines,
                    machine_coverage: file.machine_coverage,
                    derived_state_rules: file.derived_state_rules,
                    state_families: file.state_families,
                    state_transition_edges: file.state_transition_edges,
                    typestate_postconditions: file.typestate_postconditions,
                    func_decl_lines: file.func_decl_lines,
                    func_decl_columns: file.func_decl_columns,
                    panic_lines: file.panic_lines,
                    panic_columns: file.panic_columns,
                    generic_param_lines: file.generic_param_lines,
                    generic_param_names: file.generic_param_names,
                    generic_struct_decls: file.generic_struct_decls,
                    generic_struct_decl_names: file.generic_struct_decl_names,
                    generic_struct_decl_owners: file.generic_struct_decl_owners,
                    generic_struct_decl_lines: file.generic_struct_decl_lines,
                    generic_func_decls: file.generic_func_decls,
                    generic_func_decl_names: file.generic_func_decl_names,
                    generic_func_decl_lines: file.generic_func_decl_lines,
                    generic_func_decl_owners: file.generic_func_decl_owners,
                    annotation_args: file.annotation_args,
                    extern_params: file.extern_params,
                    extern_global_type_names: file.extern_global_type_names,
                    extern_global_type_exprs: file.extern_global_type_exprs,
                    local_region_annotations: file.local_region_annotations,
                    ghost_local_lines: file.ghost_local_lines,
                    assert_hole_positions: file.assert_hole_positions,
                    static_assert_conds: file.static_assert_conds,
                    static_if_conds: file.static_if_conds,
                    static_if_lines: file.static_if_lines,
                    static_if_kinds: file.static_if_kinds,
                    static_if_depths: file.static_if_depths,
                    static_assert_msgs: file.static_assert_msgs,
                    static_assert_lines: file.static_assert_lines,
                    allocation_region_names: file.allocation_region_names,
                    allocation_region_lines: file.allocation_region_lines,
                    enum_annotations: file.enum_annotations,
                    fn_type_param_lines: file.fn_type_param_lines,
                    fn_type_param_exprs: file.fn_type_param_exprs,
                    fn_type_return_lines: file.fn_type_return_lines,
                    fn_type_return_exprs: file.fn_type_return_exprs,
                    tuple_type_elements: file.tuple_type_elements,
                    tuple_type_starts: file.tuple_type_starts,
                    tuple_type_counts: file.tuple_type_counts,
                    tuple_type_lines: file.tuple_type_lines,
                    tuple_type_label_offsets: file.tuple_type_label_offsets,
                    packed_enum_names: file.packed_enum_names,
                    alias_names: file.alias_names,
                    alias_targets: file.alias_targets,
                    alias_target_heads: file.alias_target_heads,
                    struct_names: file.struct_names,
                    struct_owners: file.struct_owners,
                    struct_member_rows: file.struct_member_rows,
                    struct_member_starts: file.struct_member_starts,
                    struct_member_counts: file.struct_member_counts,
                    enum_decl_names: file.enum_decl_names,
                    enum_decl_owners: file.enum_decl_owners,
                    enum_decl_storage_heads: file.enum_decl_storage_heads,
                    enum_decl_is_const: file.enum_decl_is_const,
                    enum_decl_variant_names: file.enum_decl_variant_names,
                    enum_decl_variant_values: file.enum_decl_variant_values,
                    enum_decl_variant_starts: file.enum_decl_variant_starts,
                    enum_decl_variant_counts: file.enum_decl_variant_counts,
                    payload_enum_names: file.payload_enum_names,
                    payload_enum_owners: file.payload_enum_owners,
                    payload_enum_is_const: file.payload_enum_is_const,
                    payload_enum_variant_starts: file.payload_enum_variant_starts,
                    payload_enum_variant_counts: file.payload_enum_variant_counts,
                    payload_enum_variant_names: file.payload_enum_variant_names,
                    payload_enum_variant_field_starts: file.payload_enum_variant_field_starts,
                    payload_enum_variant_field_counts: file.payload_enum_variant_field_counts,
                    payload_enum_variant_fields: file.payload_enum_variant_fields,
                    payload_enum_variant_field_names: file.payload_enum_variant_field_names,
                    enum_common_owners: file.enum_common_owners,
                    enum_common_modules: file.enum_common_modules,
                    enum_common_counts: file.enum_common_counts,
                    enum_common_starts: file.enum_common_starts,
                    enum_common_fields: file.enum_common_fields,
                    enum_common_field_names: file.enum_common_field_names
                }
