# Type and overload facts for mandatory mutable-global authority.
include "./global_authority_postfix_cast_name.elisa"

extend Semantic:
    private:
        def ga_module_child_key(parent: usize, segment: sview) -> u64:
            can Abort.Panic:
                return name_hash(segment) ^ (parent.u64() * 11400714819323198485)

        # Record module row `index` (just pushed) in the child index.
        def ga_index_module_child(state: mutable GlobalAuthority&, index: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                # Backfill rows a constructor seeded without indexing (e.g. the root module).
                while state.module_child_next.count <= index and state.module_child_next.count < state.modules.count and state.module_child_next.count < state.parents.count |state, index|:
                    row: usize = state.module_child_next.count
                    segment: sview = (state.modules[row])[state.module_starts[row]:state.module_starts[row] + state.module_lengths[row]]
                    key: u64 = ga_module_child_key(state.parents[row], segment)
                    state.module_child_next.push(head if state.module_child_heads.get(key) is head else GLOBAL_AUTHORITY_NONE)
                    state.module_child_heads <- state.module_child_heads.put(key, row) can Global{Read,Write}

        def ga_child_part(state: GlobalAuthority&, parent: usize, path: sview, start: usize, length: usize) -> usize:
            can Abort.Panic:
                if state.module_child_next.count == state.modules.count:
                    # Indexed: walk rows whose (parent, segment) hash matches; lowest index wins,
                    # as in the scan below.
                    best: mutable usize = state.modules.count
                    row: mutable usize = head if state.module_child_heads.get(ga_module_child_key(parent, path[start:start + length])) is head else GLOBAL_AUTHORITY_NONE
                    while row < state.modules.count |row, best, parent, path, start, length, state|:
                        if row > 0 and row < best and state.parents[row] == parent and state.module_lengths[row] == length:
                            same: mutable bool = true
                            for byte_index in 0..<length |same|:
                                same <- false if (state.modules[row])[state.module_starts[row] + byte_index] != path[start + byte_index]
                            best <- row if same
                        row <- state.module_child_next[row]
                    return best
                for index in 1..<state.modules.count:
                    continue if state.parents[index] != parent or state.module_lengths[index] != length
                    equal: mutable bool = true
                    for byte_index in 0..<length |equal|:
                        equal <- false if (state.modules[index])[state.module_starts[index] + byte_index] != path[start + byte_index]
                    return index if equal
                return state.modules.count

        def ga_child(state: GlobalAuthority&, parent: usize, name: sview) -> usize:
            can Abort.Panic:
                return ga_child_part(state, parent, name, 0, name.len)

        def ga_qualified_module_path(path: sview) -> bool:
            can Abort.Panic:
                for index in 0..<path.len:
                    return true if path[index] == 58
                return false

        def ga_module_path(parent_scope: usize, path: sview, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                parent: mutable usize = 0 if ga_qualified_module_path(path) else parent_scope
                start: mutable usize = 0
                while start < path.len |parent, start|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    child: usize = ga_child_part(state, parent, path, start, end - start)
                    return state.modules.count if child == state.modules.count
                    parent <- child
                    start <- end + 2
                return parent

        def ga_module_text(path: sview, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return ga_module_path(0, path, state)

        def ga_collect_module(parent_scope: usize, path: sview @source, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                parent: mutable usize = 0 if ga_qualified_module_path(path) else parent_scope
                start: mutable usize = 0
                while start < path.len |parent, start, state|:
                    end: mutable usize = start
                    while end < path.len and path[end] != 58 |end|:
                        end <- end + 1
                    child: usize = ga_child_part(state, parent, path, start, end - start)
                    if child == state.modules.count:
                        state.parents.push(parent)
                        state.modules.push(path)
                        state.module_starts.push(start)
                        state.module_lengths.push(end - start)
                        ga_index_module_child(state, state.modules.count - 1) can Global{Read,Write}
                    parent <- child
                    start <- end + 2
                return parent

        def ga_type_qualified(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Scope(_, _, _): return true
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Unary(_, base, _) | Expr.Paren(base, _): return ga_type_qualified(base)
                    _: return false

        def ga_type_scope(expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Scope(base, _, _): return ga_module_readonly(base, state)
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Unary(_, base, _) | Expr.Paren(base, _): return ga_type_scope(base, state)
                    _: return state.module_scope

        def ga_type_head(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _) | Expr.Scope(_, name, _):
                        return name
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _) | Expr.Index(operand, _, _) | Expr.IndexN(operand, _, _):
                        return ga_type_head(operand)
                    Expr.IntLit(_, _):
                        return "i64"
                    Expr.BoolLit(_, _):
                        return "bool"
                    Expr.FloatLit(_, _):
                        return "f64"
                    Expr.StringLit(_, _):
                        return "sview"
                    _:
                        return ""

        def ga_alias(type_expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return ga_resolve_indexed(name, state.module_scope, false, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                    Expr.Scope(base, name, _):
                        return ga_resolve_indexed(name, ga_module_readonly(base, state), true, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                    _:
                        return state.alias_names.count

        def ga_mutable_parameter(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32, origin: usize = GLOBAL_AUTHORITY_NONE) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if depth > 32
                lexical_scope: usize = state.module_scope if origin == GLOBAL_AUTHORITY_NONE else origin
                alias: usize = match type_expression:
                    Expr.Ident(name, _): ga_resolve_indexed(name, lexical_scope, false, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                    Expr.Scope(base, name, _): ga_resolve_indexed(name, ga_module_readonly(base, state, lexical_scope), true, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                    _: state.alias_names.count
                return ga_mutable_parameter(state.alias_types[alias], state, depth + 1, state.alias_scopes[alias]) if alias < state.alias_names.count
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        return true if operator == TokenKind.Lmut
                        return vtc_type_borrows(ga_type_alias_result(operand, lexical_scope, state, depth + 1)) if operator == TokenKind.Mutable
                        return ga_mutable_parameter(operand, state, depth + 1, lexical_scope) if operator == TokenKind.Question
                        return false
                    Expr.Paren(inner, _):
                        return ga_mutable_parameter(inner, state, depth + 1, lexical_scope)
                    _:
                        return false

        def ga_type_alias_result(expression: Ast::Expr, module_scope: usize, state: GlobalAuthority&, depth: u32) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                return expression if depth > 32
                match expression:
                    Expr.Ident(name, _):
                        slot: usize = ga_resolve_indexed(name, module_scope, false, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                        return ga_type_alias_result(state.alias_types[slot], state.alias_scopes[slot], state, depth + 1) if slot < state.alias_names.count
                    Expr.Scope(base, name, _):
                        owner: usize = ga_module_readonly(base, state, module_scope)
                        slot: usize = ga_resolve_indexed(name, owner, true, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                        return ga_type_alias_result(state.alias_types[slot], state.alias_scopes[slot], state, depth + 1) if slot < state.alias_names.count
                    _:
                        pass
                return expression

        # Resolve nominal identity in its declaration's lexical scope, preserving
        # genuinely unresolved generic candidates rather than guessing compatibility.
        def ga_known_struct(expression: Ast::Expr, lexical_scope: usize, state: GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                return state.struct_names.count if depth > 32
                match expression:
                    Expr.Unary(_, inner, _) | Expr.Paren(inner, _) | Expr.Index(inner, _, _) | Expr.IndexN(inner, _, _):
                        return ga_known_struct(inner, lexical_scope, state, depth + 1)
                    Expr.Ident(name, _):
                        hash: u64 = name_hash(name)
                        alias: usize = ga_resolve_hashed(name, hash, lexical_scope, false, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                        return ga_known_struct(state.alias_types[alias], state.alias_scopes[alias], state, depth + 1) if alias < state.alias_names.count
                        return ga_resolve_hashed(name, hash, lexical_scope, false, state.struct_names, state.struct_scopes, state.struct_heads, state.struct_next, state)
                    Expr.Scope(base, name, _):
                        module_scope: usize = ga_module_readonly(base, state, lexical_scope)
                        alias: usize = ga_resolve_indexed(name, module_scope, true, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                        return ga_known_struct(state.alias_types[alias], state.alias_scopes[alias], state, depth + 1) if alias < state.alias_names.count
                        return ga_resolve_indexed(name, module_scope, true, state.struct_names, state.struct_scopes, state.struct_heads, state.struct_next, state)
                    _:
                        return state.struct_names.count

        def ga_declared_global_members(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> (read: bool, write: bool):
            can Memory.Allocate, Abort.Panic:
                return (false, false) if depth > 32
                resolved: Ast::Expr = ga_type_alias_result(expression, state.module_scope, state, depth)
                match resolved:
                    Expr.Lambda(_, _, at):
                        read: mutable bool = false
                        write: mutable bool = false
                        for annotation in state.annotations |read, write|:
                            continue if annotation.owner != "__fn_type_effect" or annotation.offset != at.offset or annotation.line != at.line
                            read <- true if ga_ref_covers(annotation.name, "Global.Read", ga_module_text(annotation.module, state), 0, state, 0, annotation.offset, GLOBAL_AUTHORITY_OFFSET_NONE)
                            write <- true if ga_ref_covers(annotation.name, "Global.Write", ga_module_text(annotation.module, state), 0, state, 0, annotation.offset, GLOBAL_AUTHORITY_OFFSET_NONE)
                        return (read, write)
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _) | Expr.Refinement(inner, _, _):
                        return ga_declared_global_members(inner, state, depth + 1)
                    _:
                        return (false, false)

        # Generic metadata is used only to decline narrowing; collisions stay unknown.
        def ga_protocol_member_key(offset: u32, scope: usize) -> u64:
            can Abort.Panic:
                return (offset.u64() * SEMANTIC_HASH_PRIME) ^ scope.u64()

        def ga_protocol_bound_key(offset: u32, line: u32, scope: usize, generic: sview) -> u64:
            can Abort.Panic:
                hash: mutable u64 = name_hash(generic)
                hash <- (hash ^ offset.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ line.u64()) * SEMANTIC_HASH_PRIME
                return (hash ^ scope.u64()) * SEMANTIC_HASH_PRIME

        # Prepare these file-local indexes only after ga_collect has completed the module
        # tree. Their rows retain exact fields; hashes choose chains but never establish a
        # match. Protocol bounds append in source order because the first exact bound wins.
        def ga_index_protocol_metadata(state: mutable GlobalAuthority&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                generic_source_count: usize = min(state.generic_lines.count, state.generic_names.count)
                state.generic_head_source_count <- generic_source_count
                for index in 0..<generic_source_count |state|:
                    continue if state.generic_lines[index] >= 2147483648.u32()
                    name: sview = state.generic_names[index]
                    hash: u64 = name_hash(name)
                    previous: usize = head if state.generic_head_heads.get(hash) is head else GLOBAL_AUTHORITY_NONE
                    row: usize = state.generic_head_index_names.count
                    state.generic_head_next.push(previous)
                    state.generic_head_index_names.push(name)
                    state.generic_head_heads <- state.generic_head_heads.put(hash, row) can Global{Read,Write}
                state.generic_head_index_ready <- true

                for annotation_index in 0..<state.annotations.count |state|:
                    annotation: Ast::EnumAnnotation = state.annotations[annotation_index]
                    if annotation.owner == "__protocol_method_scope":
                        member_scope: usize = ga_module_text(annotation.module, state)
                        # No function scope can equal the unresolved sentinel, so omitting
                        # this row preserves the old exact comparison's false result.
                        if member_scope < state.modules.count:
                            member_hash: u64 = ga_protocol_member_key(annotation.offset, member_scope)
                            member_previous: usize = head if state.protocol_member_heads.get(member_hash) is head else GLOBAL_AUTHORITY_NONE
                            member_row: usize = state.protocol_member_names.count
                            state.protocol_member_next.push(member_previous)
                            state.protocol_member_offsets.push(annotation.offset)
                            state.protocol_member_scopes.push(member_scope)
                            state.protocol_member_names.push(annotation.name)
                            state.protocol_member_heads <- state.protocol_member_heads.put(member_hash, member_row) can Global{Read,Write}
                    if annotation.line == 3900000130:
                        bound_scope: usize = ga_module_text(annotation.module, state)
                        if bound_scope < state.modules.count:
                            bound_hash: u64 = ga_protocol_bound_key(annotation.offset, annotation.detail_line, bound_scope, annotation.owner)
                            previous_tail: usize = tail_row if state.protocol_bound_tails.get(bound_hash) is tail_row else GLOBAL_AUTHORITY_NONE
                            bound_row: usize = state.protocol_bound_names.count
                            state.protocol_bound_next.push(GLOBAL_AUTHORITY_NONE)
                            state.protocol_bound_offsets.push(annotation.offset)
                            state.protocol_bound_lines.push(annotation.detail_line)
                            state.protocol_bound_scopes.push(bound_scope)
                            state.protocol_bound_generics.push(annotation.owner)
                            state.protocol_bound_names.push(annotation.name)
                            if previous_tail != GLOBAL_AUTHORITY_NONE:
                                state.protocol_bound_next[previous_tail] <- bound_row
                            else:
                                state.protocol_bound_heads <- state.protocol_bound_heads.put(bound_hash, bound_row) can Global{Read,Write}
                            state.protocol_bound_tails <- state.protocol_bound_tails.put(bound_hash, bound_row) can Global{Read,Write}

                state.protocol_member_annotation_count <- state.annotations.count
                state.protocol_member_module_count <- state.modules.count
                state.protocol_bound_module_count <- state.modules.count
                state.protocol_bound_annotation_count <- state.annotations.count
                state.protocol_member_index_ready <- true
                state.protocol_bound_index_ready <- true

        def ga_generic_head(head: sview, state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                if state.generic_head_index_ready and state.generic_head_source_count == min(state.generic_lines.count, state.generic_names.count):
                    return false if state.generic_head_index_names.count == 0
                    candidate: mutable usize = row if state.generic_head_heads.get(name_hash(head)) is row else GLOBAL_AUTHORITY_NONE
                    while candidate != GLOBAL_AUTHORITY_NONE |candidate, state|:
                        return true if state.generic_head_index_names[candidate] == head
                        candidate <- state.generic_head_next[candidate]
                    return false
                for index in 0..<min(state.generic_lines.count, state.generic_names.count):
                    return true if state.generic_lines[index] < 2147483648.u32() and state.generic_names[index] == head
                return false

        def ga_builtin_head(head: sview) -> bool:
            return when head:
                "bool" | "char" | "cstr" | "sview" | "dstr" | "usize" | "isize" | "uintptr" | "int" | "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "f32" | "f64" -> true
                _ -> false

        def ga_closed_builtin(expression: Ast::Expr, origin: usize, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 32
                head: sview = ga_type_head(expression)
                return false if ga_generic_head(head, state)
                owner: usize = match expression:
                    Expr.Scope(base, _, _): ga_module_readonly(base, state, origin)
                    _: origin
                alias: usize = ga_resolve_indexed(head, owner, expression is Expr.Scope, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                if (expression is Expr.Ident or expression is Expr.Scope) and alias < state.alias_names.count:
                    return ga_closed_builtin(state.alias_types[alias], state.alias_scopes[alias], state, depth + 1)
                match expression:
                    Expr.Ident(name, _):
                        return false if:
                            not ga_builtin_head(name) or ga_generic_head(name, state)
                            ga_resolve_indexed(name, origin, false, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state) < state.enum_names.count
                        return ga_known_struct(expression, origin, state, 0) == state.struct_names.count
                    _:
                        return false

        def ga_builtin_unshadowed(expression: Ast::Expr, origin: usize, state: GlobalAuthority&) -> bool:
            return ga_closed_builtin(expression, origin, state, 0) can Memory.Allocate, Abort.Panic

        # Pointer, optional, container and unresolved annotations are not exact type
        # evidence. Every actual must be closed before a lower-scoring row is excluded.
        def ga_arguments_known(arguments: darray[Ast::Expr]&, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for argument in arguments:
                    annotation: Ast::Expr = get ga_annotation(argument, state, 0) else return false
                    return false if ga_generic_head(ga_type_head(annotation), state)
                    resolved: Ast::Expr = ga_type_alias_result(annotation, state.module_scope, state, 0)
                    match resolved:
                        Expr.Ident(head, _):
                            return false if ga_generic_head(head, state)
                            nominal: usize = ga_known_struct(annotation, state.module_scope, state, 0)
                            continue if nominal < state.struct_names.count
                            continue if ga_builtin_unshadowed(annotation, state.module_scope, state) and nominal == state.struct_names.count
                            return false
                        Expr.Scope(_, _, _):
                            continue if ga_known_struct(annotation, state.module_scope, state, 0) < state.struct_names.count
                            return false
                        Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.StringLit(_, _):
                            continue
                        _:
                            return false
                return true

        # Wrapped type syntax retains its declaration scope. Decline cross-scope
        # wrappers instead of reinterpreting nested nominal names in the caller.
        def ga_return_portable(expression: Ast::Expr, origin: usize, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 32
                head: sview = ga_type_head(expression)
                return false if ga_generic_head(head, state)
                qualified: bool = expression is Expr.Scope
                alias_owner: usize = match expression:
                    Expr.Scope(base, _, _): ga_module_readonly(base, state, origin)
                    _: origin
                alias: usize = ga_resolve_indexed(head, alias_owner, qualified, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                if (expression is Expr.Ident or expression is Expr.Scope) and alias < state.alias_names.count:
                    declared_alias: usize = ga_known_struct(expression, origin, state, depth)
                    caller_alias: usize = ga_known_struct(expression, state.module_scope, state, depth)
                    return true if declared_alias < state.struct_names.count and declared_alias == caller_alias
                    return false if origin != state.module_scope or state.alias_scopes[alias] != state.module_scope
                    return ga_return_portable(state.alias_types[alias], state.alias_scopes[alias], state, depth + 1)
                match expression:
                    Expr.Ident(name, _) | Expr.Scope(_, name, _):
                        return false if ga_generic_head(name, state)
                        declared: usize = ga_known_struct(expression, origin, state, depth)
                        caller: usize = ga_known_struct(expression, state.module_scope, state, depth)
                        return true if:
                            declared < state.struct_names.count and declared == caller
                            ga_builtin_unshadowed(expression, origin, state) and ga_builtin_unshadowed(expression, state.module_scope, state)
                        return origin == state.module_scope and declared == caller
                    Expr.Index(base, element, _):
                        return false if origin != state.module_scope
                        return ga_return_portable(base, origin, state, depth + 1) and ga_return_portable(element, origin, state, depth + 1)
                    Expr.IndexN(base, elements, _):
                        return false if:
                            origin != state.module_scope
                            not ga_return_portable(base, origin, state, depth + 1)
                        for element in elements:
                            return false if not ga_return_portable(element, origin, state, depth + 1)
                        return true
                    Expr.Unary(_, inner, _) | Expr.Refinement(inner, _, _) | Expr.Paren(inner, _):
                        return false if origin != state.module_scope
                        return ga_return_portable(inner, origin, state, depth + 1)
                    Expr.Lambda(_, _, _):
                        return true
                    _:
                        return origin == state.module_scope

        # A first best return cannot type a surrounding call when several callees
        # remain viable. Keep callback/reference facts for a unique callee, but do not
        # reinterpret a nominal return in a different lexical module.
        def ga_unique_call_return(slot: usize, arguments: darray[Ast::Expr], labels: darray[sview], state: GlobalAuthority&, method: bool = false) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                return null if slot >= state.functions.count
                selected_count: mutable usize = 0
                while next_candidate < state.functions.count |next_candidate: usize = ga_candidate_head(slot, state), selected_count|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    selected_count <- selected_count + 1 if ga_candidate_selected(candidate, slot, arguments, labels, state, method)
                    return null if selected_count > 1
                result_option: Ast::Expr? = state.function_return_types[slot]
                result: Ast::Expr = get result_option else return null
                origin: usize = state.function_scopes[slot]
                return null if not ga_return_portable(result, origin, state, 0)
                return result

        # Bound metadata preserves the complete protocol path and declaration identity.
        def ga_bound_protocol(receiver: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                annotation: Ast::Expr = get ga_annotation(receiver, state, 0) else return state.protocol_names.count
                return state.protocol_names.count if not (annotation is Expr.Ident)
                generic: sview = ga_type_head(annotation)
                return state.protocol_names.count if state.function >= state.function_offsets.count
                if state.protocol_bound_index_ready and state.protocol_bound_module_count == state.modules.count and state.protocol_bound_annotation_count == state.annotations.count:
                    offset: u32 = state.function_offsets[state.function]
                    line: u32 = state.function_lines[state.function]
                    bound_scope: usize = state.function_scopes[state.function]
                    hash: u64 = ga_protocol_bound_key(offset, line, bound_scope, generic)
                    bound: mutable usize = row if state.protocol_bound_heads.get(hash) is row else GLOBAL_AUTHORITY_NONE
                    while bound != GLOBAL_AUTHORITY_NONE |bound, state|:
                        if state.protocol_bound_offsets[bound] == offset and state.protocol_bound_lines[bound] == line and state.protocol_bound_scopes[bound] == bound_scope and state.protocol_bound_generics[bound] == generic:
                            return ga_resolve_bound_protocol(state.protocol_bound_names[bound], bound_scope, state) can Memory.Allocate, Abort.Panic
                        bound <- state.protocol_bound_next[bound]
                    return state.protocol_names.count
                for bound in state.annotations:
                    continue if bound.line != 3900000130 or bound.owner != generic or bound.offset != state.function_offsets[state.function] or bound.detail_line != state.function_lines[state.function] or ga_module_text(bound.module, state) != state.function_scopes[state.function]
                    return ga_resolve_bound_protocol(bound.name, state.function_scopes[state.function], state) can Memory.Allocate, Abort.Panic
                return state.protocol_names.count

        def ga_resolve_bound_protocol(name: sview, scope: usize, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                last_scope: mutable usize = name.len
                for index in 0..<name.len |last_scope|:
                    last_scope <- index if name[index] == 58 and index + 1 < name.len and name[index + 1] == 58
                if last_scope < name.len:
                    owner: usize = ga_text_module(name[0:last_scope], scope, state)
                    return ga_resolve(name[last_scope + 2:name.len], owner, true, state.protocol_names, state.protocol_scopes, state)
                return ga_resolve(name, scope, false, state.protocol_names, state.protocol_scopes, state)

        def ga_protocol_includes(protocol: usize, name: sview, scope: usize, state: GlobalAuthority&, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if:
                    depth > 32 or protocol >= state.protocol_names.count
                    state.protocol_names[protocol] == name and state.protocol_scopes[protocol] == scope
                for parent in state.annotations:
                    continue if parent.line != 3900000013 or parent.owner != state.protocol_names[protocol] or ga_module_text(parent.module, state) != state.protocol_scopes[protocol]
                    last_scope: mutable usize = parent.name.len
                    for index in 0..<parent.name.len |last_scope|:
                        last_scope <- index if parent.name[index] == 58 and index + 1 < parent.name.len and parent.name[index + 1] == 58
                    owner: mutable usize = state.protocol_scopes[protocol]
                    leaf: mutable sview = parent.name
                    if last_scope < parent.name.len:
                        owner <- ga_text_module(parent.name[0:last_scope], owner, state)
                        leaf <- parent.name[last_scope + 2:parent.name.len]
                    ancestor: usize = ga_resolve(leaf, owner, last_scope < parent.name.len, state.protocol_names, state.protocol_scopes, state)
                    return true if ga_protocol_includes(ancestor, name, scope, state, depth + 1)
                return false

        def ga_protocol_member(candidate: usize, protocol: usize, state: GlobalAuthority&) -> bool:
            can Abort.Panic:
                return false if candidate >= state.functions.count
                if state.protocol_member_index_ready and state.protocol_member_module_count == state.modules.count and state.protocol_member_annotation_count == state.annotations.count:
                    offset: u32 = state.function_offsets[candidate]
                    member_scope: usize = state.function_scopes[candidate]
                    hash: u64 = ga_protocol_member_key(offset, member_scope)
                    member: mutable usize = row if state.protocol_member_heads.get(hash) is row else GLOBAL_AUTHORITY_NONE
                    while member != GLOBAL_AUTHORITY_NONE |member, state|:
                        if state.protocol_member_offsets[member] == offset and state.protocol_member_scopes[member] == member_scope:
                            return true if protocol == state.protocol_names.count
                            return true if state.protocol_member_names[member] == state.protocol_names[protocol] and state.protocol_member_scopes[member] == state.protocol_scopes[protocol]
                        member <- state.protocol_member_next[member]
                    return false
                for member in state.annotations:
                    continue if member.owner != "__protocol_method_scope" or member.offset != state.function_offsets[candidate] or ga_module_text(member.module, state) != state.function_scopes[candidate]
                    return true if:
                        protocol == state.protocol_names.count
                        member.name == state.protocol_names[protocol] and ga_module_text(member.module, state) == state.protocol_scopes[protocol]
                return false

        # int/void are Core builtins too; ordinary overload scoring deliberately
        # keeps its prior closed-type set. These facts are only for cast hooks.
        def ga_cast_builtin(expression: Ast::Expr, origin: usize, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if ga_builtin_unshadowed(expression, origin, state)
                return false if not (expression is Expr.Ident)
                name: sview = ga_type_head(expression)
                return false if name != "int" and name != "void"
                return not ga_generic_head(name, state) and ga_known_struct(expression, origin, state, 0) == state.struct_names.count and ga_resolve_indexed(name, origin, false, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state) == state.enum_names.count and ga_resolve_indexed(name, origin, false, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state) == state.alias_names.count

        # A handle application is definitely not a plain builtin result. Follow
        # aliases in their defining namespace; do not compare unknown type args.
        def ga_nonbuiltin_cast_target(expression: Ast::Expr, origin: usize, state: GlobalAuthority&, depth: u32 = 0) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if depth > 32
                match expression:
                    Expr.Ident(name, _) | Expr.Scope(_, name, _):
                        return false if ga_generic_head(name, state) or ga_builtin_head(name) or name == "int" or name == "void" or name == "s8" or name == "s16" or name == "s32" or name == "s64"
                        owner: usize = match expression:
                            Expr.Scope(base, _, _): ga_module_readonly(base, state, origin)
                            _: origin
                        qualified: bool = expression is Expr.Scope
                        alias: usize = ga_resolve_indexed(name, owner, qualified, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state)
                        return ga_nonbuiltin_cast_target(state.alias_types[alias], state.alias_scopes[alias], state, depth + 1) if alias < state.alias_names.count
                        return true if ga_resolve_indexed(name, owner, qualified, state.struct_names, state.struct_scopes, state.struct_heads, state.struct_next, state) < state.struct_names.count
                        return ga_resolve_indexed(name, owner, qualified, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state) < state.enum_names.count
                    Expr.Index(Expr.Ident(head, _), _, _):
                        return false if:
                            head != "id" or ga_generic_head(head, state)
                            ga_resolve_indexed(head, origin, false, state.alias_names, state.alias_scopes, state.alias_heads, state.alias_next, state) < state.alias_names.count
                            ga_resolve_indexed(head, origin, false, state.struct_names, state.struct_scopes, state.struct_heads, state.struct_next, state) < state.struct_names.count
                        return ga_resolve_indexed(head, origin, false, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state) == state.enum_names.count
                    _:
                        return false

        def ga_cast_heads_match(first: sview, second: sview) -> bool:
            # Keep integer aliases conservative without guessing a target ABI.
            first_kind: sview = "i64" if first == "int" or first == "isize" else ("u64" if first == "usize" or first == "uintptr" else first)
            second_kind: sview = "i64" if second == "int" or second == "isize" else ("u64" if second == "usize" or second == "uintptr" else second)
            return first_kind == second_kind

        # Match Core's lexical postfix cast spelling, before semantic type probing.
        # dstr and arbitrary lowercase aliases remain ordinary methods.
        def ga_postfix_cast_name(name: sview) -> bool:
            can Abort.Panic:
                return GlobalAuthorityPostfixCastName::is_postfix_cast_name(name)

        def ga_postfix_callee(callee: Ast::Expr) -> Ast::Expr:
            match callee:
                Expr.Unary(operator, inner, _):
                    return inner if operator == TokenKind.Question and inner is Expr.Field else callee
                _:
                    return callee

        # Conversion recognition additionally requires a bare zero-argument Field
        # call at the consumer; wrapped callees and explicit arguments stay UFCS.
        def ga_target_conversion(callee: Ast::Expr, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match ga_postfix_callee(callee):
                    Expr.Field(_, target, at):
                        return false if not ga_postfix_cast_name(target)
                        raw: Ast::Expr = Ast::Expr.Ident(target, at)
                        return ga_builtin_head(target) or target == "void" or target == "int" or target == "s8" or target == "s16" or target == "s32" or target == "s64" or ga_generic_head(target, state) or ga_known_struct(raw, state.module_scope, state, 0) < state.struct_names.count or ga_resolve_indexed(target, state.module_scope, false, state.enum_names, state.enum_scopes, state.enum_heads, state.enum_next, state) < state.enum_names.count or ga_alias(raw, state) < state.alias_names.count
                    _:
                        return false

        def ga_tuple_field_type(tuple_type: Ast::Expr, field: sview, state: GlobalAuthority&) -> Ast::Expr?:
            can Abort.Panic:
                match tuple_type:
                    Expr.Tuple(elements, tuple_pos):
                        previous_end: mutable u32 = tuple_pos.offset
                        for element in elements |previous_end, field, state|:
                            element_pos: Ast::Pos = Ast::expr_pos(element)
                            if state.tuple_labels_ready:
                                # Binary search the first label at or after previous_end.
                                low: mutable usize = 0
                                high: mutable usize = state.tuple_label_offsets.count
                                while low < high |low, high, previous_end, state|:
                                    middle: usize = low + (high - low) / 2
                                    if state.tuple_label_offsets[middle] < previous_end:
                                        low <- middle + 1
                                    else:
                                        high <- middle
                                while low < state.tuple_label_offsets.count and state.tuple_label_offsets[low] < element_pos.offset |low, field, element_pos, state|:
                                    return element if state.tuple_label_names[low] == field
                                    low <- low + 1
                                previous_end <- element_pos.end_offset
                                continue
                            for annotation in state.annotations:
                                if annotation.owner == "__tuple_label" and annotation.name == field and annotation.offset >= previous_end and annotation.offset < element_pos.offset:
                                    return element
                            previous_end <- element_pos.end_offset
                        return null
                    _:
                        return null

include "./check_global_authority_types_references.elisa"
