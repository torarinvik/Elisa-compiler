# Type and overload facts for mandatory mutable-global authority.
extend Semantic:
    private:
        def ga_child_part(state: GlobalAuthority&, parent: usize, path: sview, start: usize, length: usize) -> usize:
            can Abort.Panic:
                for index in 1..<state.modules.count:
                    continue if state.parents[index] != parent or state.module_lengths[index] != length
                    equal: mutable bool = true
                    for byte_index in 0..<length |equal|:
                        equal <- false if sview_at(state.modules[index], state.module_starts[index] + byte_index) != sview_at(path, start + byte_index)
                    index return if equal
                return state.modules.count

        def ga_child(state: GlobalAuthority&, parent: usize, name: sview) -> usize:
            can Abort.Panic:
                return ga_child_part(state, parent, name, 0, sview_len(name))

        def ga_qualified_module_path(path: sview) -> bool:
            can Abort.Panic:
                for index in 0..<sview_len(path):
                    true return if sview_at(path, index) == 58
                return false

        def ga_module_path(parent_scope: usize, path: sview, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                parent: mutable usize = 0 if ga_qualified_module_path(path) else parent_scope
                start: mutable usize = 0
                while start < sview_len(path) |parent, start|:
                    end: mutable usize = start
                    while end < sview_len(path) and sview_at(path, end) != 58 |end|:
                        end <- end + 1
                    child: usize = ga_child_part(state, parent, path, start, end - start)
                    state.modules.count return if child == state.modules.count
                    parent <- child
                    start <- end + 2
                return parent

        def ga_module_text(path: sview, state: GlobalAuthority&) -> usize:
            can Abort.Panic:
                return ga_module_path(0, path, state)

        def ga_collect_module(parent_scope: usize, path: sview, state: mutable GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                parent: mutable usize = 0 if ga_qualified_module_path(path) else parent_scope
                start: mutable usize = 0
                while start < sview_len(path) |parent, start, state|:
                    end: mutable usize = start
                    while end < sview_len(path) and sview_at(path, end) != 58 |end|:
                        end <- end + 1
                    child: usize = ga_child_part(state, parent, path, start, end - start)
                    if child == state.modules.count:
                        state.parents.push(parent)
                        state.modules.push(path)
                        state.module_starts.push(start)
                        state.module_lengths.push(end - start)
                    parent <- child
                    start <- end + 2
                return parent

        def ga_type_qualified(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Scope(_, _, _): return true
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Unary(_, base, _) | Expr.Paren(base, _): return ga_type_qualified(base)
                    _: return false

        def ga_type_scope(expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Scope(base, _, _): return ga_module(base, state)
                    Expr.Index(base, _, _) | Expr.IndexN(base, _, _) | Expr.Unary(_, base, _) | Expr.Paren(base, _): return ga_type_scope(base, state)
                    _: return state.module_scope

        def ga_type_head(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _) | Expr.Scope(_, name, _):
                        return name
                    Expr.Unary(_, operand, _) | Expr.Paren(operand, _) | Expr.Index(operand, _, _) | Expr.IndexN(operand, _, _):
                        return ga_type_head(operand)
                    Expr.IntLit(_, _):
                        return "i64"
                    Expr.BoolLit(_, _):
                        return "bool"
                    Expr.FloatLit(_, _):
                        return "f64"
                    Expr.StringLit(_, _):
                        return "sview"
                    _:
                        return ""

        def ga_alias(type_expression: Ast::Expr, state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return ga_resolve(name, state.module_scope, false, state.alias_names, state.alias_scopes, state)
                    Expr.Scope(base, name, _):
                        return ga_resolve(name, ga_module(base, state), true, state.alias_names, state.alias_scopes, state)
                    _:
                        return state.alias_names.count

        def ga_mutable_parameter(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 32
                alias: usize = ga_alias(type_expression, state)
                ga_mutable_parameter(state.alias_types[alias], state, depth + 1) return if alias < state.alias_names.count
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        true return if operator == TokenKind.Lmut
                        return vtc_type_borrows(operand) if operator == TokenKind.Mutable
                        return ga_mutable_parameter(operand, state, depth + 1) if operator == TokenKind.Question
                        return false
                    Expr.Paren(inner, _):
                        return ga_mutable_parameter(inner, state, depth + 1)
                    _:
                        return false

        def ga_type_alias_result(expression: Ast::Expr, module_scope: usize, state: GlobalAuthority&, depth: u32) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                expression return if depth > 32
                name: sview = ga_type_head(expression)
                qualified: bool = expression is Expr.Scope
                owner: usize = match expression:
                    Expr.Scope(base, _, _): ga_module(base, state, module_scope)
                    _: module_scope
                slot: usize = ga_resolve(name, owner, qualified, state.alias_names, state.alias_scopes, state)
                match expression:
                    Expr.Ident(_, _) | Expr.Scope(_, _, _):
                        ga_type_alias_result(state.alias_types[slot], state.alias_scopes[slot], state, depth + 1) return if slot < state.alias_names.count
                    _:
                        pass
                return expression

        # Resolve nominal identity in its declaration's lexical scope, preserving
        # genuinely unresolved generic candidates rather than guessing compatibility.
        def ga_known_struct(expression: Ast::Expr, lexical_scope: usize, state: GlobalAuthority&, depth: u32) -> usize:
            can Memory.Allocate, Abort.Panic:
                state.struct_names.count return if depth > 32
                match expression:
                    Expr.Unary(_, inner, _) | Expr.Paren(inner, _) | Expr.Index(inner, _, _) | Expr.IndexN(inner, _, _):
                        return ga_known_struct(inner, lexical_scope, state, depth + 1)
                    Expr.Ident(name, _):
                        alias: usize = ga_resolve(name, lexical_scope, false, state.alias_names, state.alias_scopes, state)
                        ga_known_struct(state.alias_types[alias], state.alias_scopes[alias], state, depth + 1) return if alias < state.alias_names.count
                        return ga_resolve(name, lexical_scope, false, state.struct_names, state.struct_scopes, state)
                    Expr.Scope(base, name, _):
                        module_scope: usize = ga_module(base, state, lexical_scope)
                        alias: usize = ga_resolve(name, module_scope, true, state.alias_names, state.alias_scopes, state)
                        ga_known_struct(state.alias_types[alias], state.alias_scopes[alias], state, depth + 1) return if alias < state.alias_names.count
                        return ga_resolve(name, module_scope, true, state.struct_names, state.struct_scopes, state)
                    _:
                        return state.struct_names.count

        def ga_declared_global_members(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> (read: bool, write: bool):
            can Memory.Allocate, Abort.Panic:
                (false, false) return if depth > 32
                resolved: Ast::Expr = ga_type_alias_result(expression, state.module_scope, state, depth)
                match resolved:
                    Expr.Lambda(_, _, at):
                        read: mutable bool = false
                        write: mutable bool = false
                        for annotation in state.annotations |read, write|:
                            continue if annotation.owner != "__fn_type_effect" or annotation.offset != at.offset or annotation.line != at.line
                            read <- true if ga_ref_covers(annotation.name, "Global.Read", ga_module_text(annotation.module, state), 0, state, 0)
                            write <- true if ga_ref_covers(annotation.name, "Global.Write", ga_module_text(annotation.module, state), 0, state, 0)
                        return (read, write)
                    Expr.Paren(inner, _) | Expr.Unary(_, inner, _) | Expr.Refinement(inner, _, _):
                        return ga_declared_global_members(inner, state, depth + 1)
                    _:
                        return (false, false)

        def ga_annotation(expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                null return if depth > 32
                match expression:
                    Expr.Ident(name, _):
                        local_index: mutable usize = min(state.local_limit, state.locals.count)
                        while local_index > state.local_floor |local_index|:
                            local_index <- local_index - 1
                            state.local_types[local_index] return if state.locals[local_index] == name
                    Expr.Field(base, field, _):
                        base_type: Ast::Expr = get ga_annotation(base, state, depth + 1) else return null
                        owner: usize = ga_known_struct(base_type, state.module_scope, state, depth + 1)
                        null return if owner == state.struct_names.count
                        for index in 0..<state.field_owners.count:
                            state.field_types[index] return if state.field_owners[index] == state.struct_names[owner] and state.field_scopes[index] == state.struct_scopes[owner] and state.field_names[index] == field
                        return null
                    Expr.Call(callee, arguments, labels, _):
                        slot: mutable usize = ga_named_callee_slot(callee, state)
                        match ga_callable_core(callee):
                            Expr.Field(receiver, method, _):
                                if ga_annotation(receiver, state, depth + 1) is receiver_type:
                                    slot <- ga_resolve_function(method, ga_receiver_scope(receiver_type, state), false, state)
                                actuals: mutable darray[Ast::Expr] = [receiver]
                                actual_labels: mutable darray[sview] = [""]
                                actuals.extend(arguments)
                                actual_labels.extend(labels)
                                slot <- ga_select_function(slot, actuals, actual_labels, state)
                            _:
                                slot <- ga_select_function(slot, arguments, labels, state)
                        if slot < state.functions.count and state.function_return_types[slot] is return_type:
                            return ga_type_alias_result(return_type, state.function_scopes[slot], state, depth + 1)
                        return null
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Unary(_, inner, _):
                        return ga_annotation(inner, state, depth + 1)
                    Expr.Index(base, _, _):
                        base_type: Ast::Expr = get ga_annotation(base, state, depth + 1) else return null
                        match base_type:
                            Expr.Index(_, element, _):
                                return element
                            Expr.IndexN(head, elements, _):
                                null return if elements.count == 0
                                return elements[1] if ga_type_head(head) == "dict" and elements.count > 1 else elements[0]
                            _:
                                return null
                    Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _) | Expr.StringLit(_, _):
                        return expression
                    _:
                        pass
                global_slot: usize = ga_global(expression, state)
                return state.global_types[global_slot] if global_slot < state.globals.count else null

        def ga_builtin_collection(type_expression: Ast::Expr, state: GlobalAuthority&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 32
                alias: usize = ga_alias(type_expression, state)
                ga_builtin_collection(state.alias_types[alias], state, depth + 1) return if alias < state.alias_names.count
                head: sview = ga_type_head(type_expression)
                return head == "darray" or head == "dict" or head == "set"

        def ga_mutating_collection(receiver: Ast::Expr, method: sview, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                method_mutates: bool = method == "push" or method == "extend" or method == "reserve" or method == "resize" or method == "clear" or method == "truncate" or method == "insert" or method == "remove" or method == "set" or method == "put" or method == "add" or method == "get_or_insert"
                false return if not method_mutates
                annotation: Ast::Expr = get ga_annotation(receiver, state, 0) else return false
                return ga_builtin_collection(annotation, state, 0)

        def ga_argument_type(slot: usize, position: usize, label: sview, state: GlobalAuthority&) -> Ast::Expr?:
            can Abort.Panic:
                seen: mutable usize = 0
                end: usize = min(state.parameter_starts[slot] + state.parameter_counts[slot], state.parameter_types.count)
                for index in state.parameter_starts[slot]..<end |seen|:
                    selected: bool = state.parameter_names[index] == label if label != "" else seen == position
                    state.parameter_types[index] return if selected
                    seen <- seen + 1
                return null

        # Unresolved equal candidates must retain every possible mutable capability.
        def ga_candidate_score(candidate: usize, arguments: darray[Ast::Expr], labels: darray[sview], state: GlobalAuthority&) -> i64:
            can Memory.Allocate, Abort.Panic:
                -1 return if arguments.count < state.parameter_minimum[candidate] or arguments.count > state.parameter_counts[candidate]
                score: mutable i64 = 0
                fits: mutable bool = true
                for index in 0..<arguments.count |score, fits|:
                    label: sview = labels[index] if index < labels.count else sview("", 0, 0)
                    if ga_argument_type(candidate, index, label, state) is parameter_type:
                        if ga_annotation(arguments[index], state, 0) is argument_type:
                            parameter_struct: usize = ga_known_struct(parameter_type, state.function_scopes[candidate], state, 0)
                            argument_struct: usize = ga_known_struct(argument_type, state.module_scope, state, 0)
                            fits <- false if parameter_struct < state.struct_names.count and argument_struct < state.struct_names.count and parameter_struct != argument_struct
                            parameter_head: sview = ga_type_head(ga_type_alias_result(parameter_type, state.function_scopes[candidate], state, 0))
                            argument_head: sview = ga_type_head(ga_type_alias_result(argument_type, state.module_scope, state, 0))
                            if parameter_head == argument_head and parameter_head != "":
                                score <- score + 2
                            else:
                                literal_kind: sview = match argument_type:
                                    Expr.IntLit(_, _): "int"
                                    Expr.BoolLit(_, _): "bool"
                                    Expr.FloatLit(_, _): "float"
                                    Expr.StringLit(_, _): "string"
                                    _: ""
                                fits <- false if literal_kind != "" and literal_never_fits(literal_kind, parameter_head)
                                # Different nominal/generic/alias heads are unresolved here,
                                # not proof that the overload cannot run.
                                known_kind: sview = "bool" if argument_head == "bool" else ("int" if argument_head == "i64" or argument_head == "i32" or argument_head == "u32" or argument_head == "u64" else "")
                                fits <- false if literal_kind == "" and known_kind != "" and literal_never_fits(known_kind, parameter_head)
                    else:
                        fits <- false if state.functions[candidate] != ""
                return score if fits else -1

        def ga_select_function(first: usize, arguments: darray[Ast::Expr], labels: darray[sview], state: GlobalAuthority&) -> usize:
            can Memory.Allocate, Abort.Panic:
                state.functions.count return if first >= state.functions.count
                first return if state.functions[first] == ""
                selected: mutable usize = state.functions.count
                best_score: mutable i64 = -1
                while next_candidate < state.functions.count |next_candidate: usize = ga_function_head(state.functions[first], state), selected, best_score|:
                    candidate: usize = next_candidate
                    next_candidate <- state.function_next[candidate]
                    continue if state.functions[candidate] != state.functions[first] or state.function_scopes[candidate] != state.function_scopes[first]
                    score: i64 = ga_candidate_score(candidate, arguments, labels, state)
                    if score > best_score:
                        selected <- candidate
                        best_score <- score
                return selected

        def ga_candidate_selected(candidate: usize, selected: usize, arguments: darray[Ast::Expr], labels: darray[sview], state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if selected >= state.functions.count
                candidate == selected return if state.functions[selected] == ""
                false return if state.functions[candidate] != state.functions[selected] or state.function_scopes[candidate] != state.function_scopes[selected]
                return ga_candidate_score(candidate, arguments, labels, state) >= 0

        def ga_argument_mutates(slot: usize, position: usize, label: sview, state: GlobalAuthority&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if slot >= state.functions.count
                seen: mutable usize = 0
                end: usize = min(state.parameter_starts[slot] + state.parameter_counts[slot], state.parameter_types.count)
                for index in state.parameter_starts[slot]..<end |seen|:
                    selected: bool = state.parameter_names[index] == label if label != "" else seen == position
                    ga_mutable_parameter(state.parameter_types[index], state, 0) return if selected
                    seen <- seen + 1
                return false
