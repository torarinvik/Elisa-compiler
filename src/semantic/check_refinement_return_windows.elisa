# Stage1 semantic — return windows and the check entry point (`extend Semantic:
# private:`). Collects each function's declared return window and alias bases, then
# `check_refinement_return` drives the whole check. Continues
# check_refinement_return_args.elisa; split out to keep each part under 600 lines.

extend Semantic:
    private:
        # The ELEMENT annotation of a container type (`darray[E]`, `array[E, N]`),
        # through `&`/`mutable`; Absent otherwise.
        def container_element_annotation(type_expression: Ast::Expr) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return container_element_annotation(operand)
                    Expr.Paren(inner, paren_line):
                        return container_element_annotation(inner)
                    Expr.Index(object, element, index_line):
                        head: sview = ident_name_of(object)
                        element return if head == "darray" or head == "dict"
                        return (Ast::Expr.Absent)
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head_n: sview = ident_name_of(object_n)
                        (arguments_n[0]) return if (head_n == "array" or head_n == "darray") and arguments_n.count > 0
                        return (Ast::Expr.Absent)
                    _:
                        return (Ast::Expr.Absent)


        # Whether any identifier occurs more than once in the expression.
        def return_expr_repeats_variable(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                seen: mutable darray[sview] = []
                return return_expr_collect_repeats(expression, seen, 0)


        def return_expr_collect_repeats(expression: Ast::Expr, seen: mutable darray[sview]&, depth: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 12
                match expression:
                    Expr.Ident(name, line):
                        true return if any s in seen where s == name
                        seen.push(name)
                        return false
                    Expr.Paren(inner, paren_line):
                        return return_expr_collect_repeats(inner, seen, depth + 1)
                    Expr.Unary(operator, operand, unary_line):
                        return return_expr_collect_repeats(operand, seen, depth + 1)
                    Expr.Binary(left, operator, right, binary_line):
                        true return if return_expr_collect_repeats(left, seen, depth + 1)
                        return return_expr_collect_repeats(right, seen, depth + 1)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        for argument in arguments |seen|:
                            true return if return_expr_collect_repeats(argument, seen, depth + 1)
                        return false
                    Expr.Field(object, field, field_line):
                        return return_expr_collect_repeats(object, seen, depth + 1)
                    Expr.Index(object, index_argument, index_line):
                        true return if return_expr_collect_repeats(object, seen, depth + 1)
                        return return_expr_collect_repeats(index_argument, seen, depth + 1)
                    _:
                        return false


        # Whether the mod base is an UNSIGNED integer parameter (its value is >= 0 by type).
        def return_base_is_unsigned_param(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]) -> bool:
            can Memory.Allocate, Abort.Panic:
                base: sview = ident_name_of(expression)
                false return if base == ""
                for parameter in parameters |base|:
                    continue if parameter.name != base
                    type_name: sview = bare_type_name(parameter.type_expression)
                    return when type_name:
                        "u8" | "u16" | "u32" | "u64" | "usize" | "uint" -> true
                        _ -> false
                return false


        # The tail name of a callee (`M::clamp` -> "clamp", plain ident unchanged).
        def return_callee_tail_name(callee: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                direct: sview = ident_name_of(callee)
                direct return if direct != ""
                match callee:
                    Expr.Scope(base, name, line):
                        return name
                    Expr.Field(object, field, field_line):
                        return field
                    _:
                        return sview("", 0, 0)


        # Return-refinement windows of all functions (alias returns resolved).
        def collect_return_windows(declarations: darray[Ast::Decl], law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, ret_alias_names: darray[sview]&, ret_alias_bases: darray[Ast::Expr]&, out_names: mutable darray[sview]&, out_lo: mutable darray[i64]&, out_hi: mutable darray[i64]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_names, out_lo, out_hi|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            if return_type is present_return:
                                window: (found: bool, lo: i64, hi: i64) = param_refinement_window(present_return, law_names, law_predicates, ret_alias_names, ret_alias_bases)
                                if window.found:
                                    out_names.push(function_name)
                                    out_lo.push(window.lo)
                                    out_hi.push(window.hi)
                        Decl.Module(module_name, module_body, module_line):
                            collect_return_windows(module_body, law_names, law_predicates, ret_alias_names, ret_alias_bases, out_names, out_lo, out_hi)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_return_windows(scoped_body, law_names, law_predicates, ret_alias_names, ret_alias_bases, out_names, out_lo, out_hi)
                        _:
                            pass


        def collect_return_alias_bases(declarations: darray[Ast::Decl], out_names: mutable darray[sview]&, out_bases: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out_names, out_bases|:
                    match declaration:
                        Decl.Alias(name, target, line):
                            out_names.push(name)
                            out_bases.push(target)
                        Decl.Module(module_name, module_body, module_line):
                            collect_return_alias_bases(module_body, out_names, out_bases)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_return_alias_bases(scoped_body, out_names, out_bases)
                        _:
                            pass


        def check_refinement_return(declarations: darray[Ast::Decl], enable_smt: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                law_names: mutable darray[sview] = []
                law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(declarations, law_names, law_predicates)
                # Named refinement aliases (`type Small = i64 is Bounded[2, 10]`) resolve
                # parameter windows for the return-range tier.
                ret_alias_names: mutable darray[sview] = []
                ret_alias_bases: mutable darray[Ast::Expr] = []
                collect_return_alias_bases(declarations, ret_alias_names, ret_alias_bases)
                rr_struct_names: mutable darray[sview] = []
                rr_field_starts: mutable darray[usize] = []
                rr_field_counts: mutable darray[usize] = []
                rr_field_names: mutable darray[sview] = []
                rr_field_types: mutable darray[Ast::Expr] = []
                collect_struct_member_tables(declarations, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types)
                rr_fn_names: mutable darray[sview] = []
                rr_fn_lo: mutable darray[i64] = []
                rr_fn_hi: mutable darray[i64] = []
                collect_return_windows(declarations, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_fn_names, rr_fn_lo, rr_fn_hi)
                table <- check_refinement_return_walk(declarations, law_names, law_predicates, ret_alias_names, ret_alias_bases, rr_struct_names, rr_field_starts, rr_field_counts, rr_field_names, rr_field_types, rr_fn_names, rr_fn_lo, rr_fn_hi, enable_smt, table)
                sig_names: mutable darray[sview] = []
                sig_index: mutable darray[usize] = []
                sig_lo: mutable darray[i64] = []
                sig_hi: mutable darray[i64] = []
                collect_refined_signatures(declarations, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi)
                table <- check_arg_walk(declarations, law_names, law_predicates, sig_names, sig_index, sig_lo, sig_hi, table)
